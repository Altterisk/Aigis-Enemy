{"quest_id": 7500, "name": "名探偵アナベラ VS 怪盗サバル", "description": "紅牡丹一座、新春公演。怪盗サバルを捕ま\nえるため名探偵アナベラと助手の王子が推\n理を開始。キミは犯人を見つけられるか！？\n＜遠距離ユニット出撃不可＞", "modifier_notes": ["遠距離ユニット出撃不可"], "event": "ゴールドラッシュ30(2021)", "event_category": "Reproduce", "mission_id": 300333, "map_no": 4054, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [4], "expression": "IsVanguard();", "expression_human": "it is a melee unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII"], "fixture": true, "hp": 1500, "attack": 100, "base_hp": 1500, "base_attack": 100, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2132112, "special_effect_id": 910, "master_id": 34299, "global_id": 7916, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "tags": ["置物", "ステルスII"], "fixture": true, "hp": 57000, "base_hp": 57000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_range": 60, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130272, "race_id": 16, "special_effect_id": 910, "change_to": 2, "missile_id": 643, "missile": {"speed": 3.0}, "master_id": 34285, "global_id": 7902, "ranged": true, "to_global_id": 7903, "route_behaviour": {"calls_event": [2073, 2074]}, "spawn_sec": 44}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII"], "fixture": true, "hp": 57000, "base_hp": 57000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_range": 60, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2130272, "race_id": 16, "special_effect_id": 265, "missile_id": 643, "missile": {