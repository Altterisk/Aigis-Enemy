: 1, "form_count": 4, "tags": ["ステルスII"], "hp": 9000, "base_hp": 9000, "damage_type": "physical", "armor_defense": 140, "attack_range": 60, "attack_speed": 30, "attack_wait": 10, "attack_interval": 61, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132144, "race_id": 12, "special_effect_id": 910, "change_to": 14, "missile_id": 643, "missile": {"speed": 3.0}, "master_id": 34289, "global_id": 7906, "ranged": true, "to_global_id": 7907, "route_behaviour": {"transforms": [{"wait": 30}], "sets_flags": [[3, 1, -1]], "calls_event": [2095, 2096, 2097, 2098, 2099]}, "spawn_sec": 51}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルスII"], "hp": 9000, "base_hp": 9000, "damage_type": "physical", "armor_defense": 140, "attack_range": 60, "attack_speed": 30, "attack_wait": 10, "attack_interval": 61, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132144, "race_id": 12, "special_effect_id": 903, "change_to": 15, "missile_id": 643, "missile": {"speed": 3.0}, "master_id": 34290, "global_id": 7907, "ranged": true, "to_global_id": 7908}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["ステルスII"], "hp": 9000, "base_hp": 9000, "damage_type": "physical", "armor_defense": 140, "attack_speed": 30, "attack_wait": 10, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119744, "race_id": 12, "change_to": 16, "missile_id": 643, "missile": {"speed": 3.0}, "master_id": 34291, "global_id": 7908, "to_global_id": 7909}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["ステルスII"], "hp": 9000, "base_hp": 9000, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2132160, "race_id": 12, "special_effect_id": 903, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 34292, "global_id": 7909}], "dialogue": [{"trigger": "start", "lines": [{"name": "紅牡丹", "text": "――新年の王城、盗まれたデシウス人形、\n４人の容疑者、そこに現れるは名探偵！", "face": "u661"}, {"name": "紅牡丹", "text": "紅牡丹一座、新春公演！\n「名探偵アナベラｖｓ怪盗サバル」はじまりはじまり～♪", "face": "u661"}]}, {"trigger": "battle", "at_sec": 45, "lines": [{"name": "名探偵アナベラ", "text": "ここが怪盗サバルの犯行現場か……。\nまさかあの至宝、デシウス人形を盗み出すとは。", "face": "u1309a1"}, {"name": "アンナ警部", "text": "おお、来てくれましたか名探偵アナベラ！\nしかし今回の事件は難しいですよ……。\n何しろ容疑者が４人もいるのです……！", "face": "l358388ec71fe"}, {"name": "名探偵アナベラ", "text": "フフッ、怖れる必要はない。\nここには世界一の名探偵と、\n世界一の助手がいるのだからね！", "face": "u1309a1"}, {"name": "助手王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ警部", "text": "えぇ、頼りにしています！\nそれではさっそく、容疑者の証言を――"}, {"name": "名探偵アナベラ", "text": "――いや待て。先に伝えることがある。\n助手君、きみには容疑者の\n証言をしっかりと見極めてもらいたい。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "容疑者の中には、犯人をかばっている者がいてね、\n嘘の証言がまざっているはずなんだ。\n気をつけるべきは次のとおりだよ。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "ひとつ、「４人の容疑者の中に、\n怪盗サバルは必ず変装して潜んでいる」。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "ふたつ、「容疑者の内、真実を話すのは１人だけ」。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "みっつ、「容疑者の内、残る３人は必ず嘘をついている」。", "face": "u1309a1"}, {"name": "アンナ警部", "text": "むむっ、そんな複雑な条件が……。\n本当に怪盗サバルを見つけられるのですか！？", "face": "l358388ec71fe"}, {"name": "名探偵アナベラ", "text": "任せておきたまえよ。\nしかし、もし迷うようであれば、\nぼくのもとへ来れば「ヒント」を出そう。", "face": "u1309a1"}, {"name": "アンナ警部", "text": "それでは、私は「読み返し」を担当しましょう。\n条件や証言をもう一度お伝えします。", "face": "l358388ec71fe"}, {"name": "名探偵アナベラ", "text": "それでは、証言を聞くとしようか。", "face": "u1309a1"}, {"name": "アンナ警部", "text": "こちらが今回の容疑者、\nリュティエ殿、リエーフ殿、テティス殿、バシラ殿だ。", "face": "l358388ec71fe"}]}, {"trigger": "battle", "at_sec": 48, "lines": [{"name": "リュティエ", "text": "こんな取り調べ必要なんてないよ！\nだって「ボクが犯人」なんだから！！", "face": "u1273a1"}]}, {"trigger": "battle", "at_sec": 49, "lines": [{"name": "リエーフ", "text": "「リュティエは犯人ではありません」\n真犯人をかばっているんです。", "face": "u1178a1"}]}, {"trigger": "battle", "at_sec": 51, "lines": [{"name": "テティス", "text": "「バシラは絶対に犯人じゃないです」\n当然ですよね？", "face": "u37"}]}, {"trigger": "end", "lines": [{"name": "バシラ", "text": "「にゃはは、私は犯人じゃないですよ」\n疑うなんて酷いです！", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "名探偵アナベラ", "text": "フフッ、もう犯人は分かったよ。\nしかし助手君、答えを言う前に、\nきみの推理を聞くとしようか。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "少し考えてみるといい。\n先ほど言ったとおり、ぼくが「ヒント」を、\nアンナ警部が「読み返し」を助けてくれるぞ。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "では助手君、犯人が分かったら、\n「犯人の前に近接ユニットを配置」して、\n犯人はお前だと指名するんだ！", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "ただし、配置するユニットは\n「姿が見える者」でなければならないぞ！\n隠れていたらぼくらにも見えないからな！", "face": "u1309a1"}]}, {"trigger": "end", "lines": [{"name": "名探偵アナベラ", "text": "さて、逮捕はアンナ警部にまかせておこうか。\nもし捕まっても、また脱走するだろうけど。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "では行くぞ、助手君。\n次の事件が、ぼくらを待っているからね。", "face": "u1309a1"}, {"name": "紅牡丹", "text": "――こうして、ひとつの事件が終わる。\n次の事件は東か西か、北か南か！\n名探偵アナベラの推理劇はまだまだ続く！", "face": "u661"}, {"name": "紅牡丹", "text": "それでは皆さま、さよーぅならー。", "face": "u661"}]}, {"trigger": "route", "enemy_ids": [14], "lines": [{"name": "助手王子", "text": "――犯人は、お前だ！！", "face": "u1"}, {"name": "サバル", "text": "にゃーっはっはっは！\nバレてしまっては仕方にゃい！\nバシラに化けていたっていうのにさー！！", "face": "u536"}, {"name": "サバル", "text": "しかしここで捕まるわけにはいかない。\n名探偵アナベラ、そして助手王子！\nお前たちの顔は覚えておこーう！", "face": "u536"}]}, {"trigger": "route", "enemy_ids": [14], "lines": [{"name": "サバル", "text": "では、さらばだ諸君！\nにゃーっはっは、にゃーっはっはっは！！", "face": "u536"}, {"name": "アンナ警部", "text": "くっ、怪盗サバルが逃走する！\n追え！　追えーっ！！", "face": "l358388ec71fe"}]}, {"trigger": "route", "enemy_ids": [6], "lines": [{"name": "バシラ", "text": "えぇっ、わ、私ですか……？", "face": "u28"}, {"name": "名探偵アナベラ", "text": "ふふっ、そのとおり。\n推理が一致したようだね、助手君！", "face": "u1309a1"}]}, {"trigger": "route", "enemy_ids": [6], "lines": [{"name": "リュティエ", "text": "そうそう、ボクが犯人――", "face": "u1273a1"}, {"name": "名探偵アナベラ", "text": "――おっと、違うぞ助手君。\nリュティエは犯人をかばっている！", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "怪盗サバルは……バシラに変装しているッ！！", "face": "u1309a1"}]}, {"trigger": "route", "enemy_ids": [6], "lines": [{"name": "リエーフ", "text": "えっ……犯人、ですか……？", "face": "u1178a1"}, {"name": "名探偵アナベラ", "text": "うむ。助手君、焦ってしまったんだろうね。\nリエーフは犯人ではない。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "そう、怪盗サバルは……バシラに変装しているぞ！！", "face": "u1309a1"}]}, {"trigger": "route", "enemy_ids": [6], "lines": [{"name": "テティス", "text": "そうそう、私が犯人――", "face": "u37"}, {"name": "名探偵アナベラ", "text": "おっと、違うぞ助手君。\n焦ってしまったのかな？", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "そう、怪盗サバルは……バシラに変装しているのだ！！", "face": "u1309a1"}]}, {"trigger": "route", "enemy_ids": [6], "lines": [{"name": "名探偵アナベラ", "text": "助手君、悩みすぎは良くないぞ？", "face": "u1309a1"}, {"name": "バシラ", "text": "にゃっふっふ、そのとおり！\n隙だらけだぞ名探偵ども！", "face": "u28"}]}, {"trigger": "route", "enemy_ids": [7], "lines": [{"name": "名探偵アナベラ", "text": "おや、思ったより悩んでいるな……。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "助手君、詰まった時には基本に戻るんだ。\n証言をもう一度聞くと良い。", "face": "u1309a1"}]}, {"trigger": "route", "enemy_ids": [2], "lines": [{"name": "名探偵アナベラ", "text": "ふふっ、困っているのかい？\nそれじゃあヒントをあげよう。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "怪盗サバルは「にゃはは」と笑う癖がある。\nにゃはは……そういえばさっき聞いた気がするな。", "face": "u1309a1"}]}, {"trigger": "route", "enemy_ids": [4], "lines": [{"name": "アンナ警部", "text": "証言をもう一度聞くのですね。\n容疑者の方々はこう言っていました。", "face": "l358388ec71fe"}, {"name": "リュティエ", "text": "こんな取り調べ必要なんてないよ！\nだって「ボクが犯人」なんだから！！", "face": "u1273a1"}, {"name": "リエーフ", "text": "「リュティエは犯人ではありません」\n真犯人をかばっているんです。", "face": "u1178a1"}, {"name": "テティス", "text": "「バシラは絶対に犯人じゃないです」\n当然ですよね？", "face": "u37"}, {"name": "バシラ", "text": "「にゃはは、私は犯人じゃないですよ」\n疑うなんて酷いです！", "face": "u28"}]}], "active": true}