": 1179, "change_to": 1, "change_condition": 2, "master_id": 35805, "global_id": 9422, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 170}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 32000, "attack": 2400, "base_hp": 32000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "change_to": 10, "change_condition": 4, "master_id": 22186, "global_id": 2469, "to_condition": 4, "to_ticks": 3, "to_global_id": 2472, "spawn_sec": 187}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 32000, "attack": 1600, "base_hp": 32000, "base_attack": 1600, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 22189, "global_id": 2472, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 120000, "attack": 5000, "base_hp": 120000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 800, "attack_speed": 120, "attack_wait": 10, "attack_interval": 221, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2127520, "race_id": 10, "master_id": 36422, "global_id": 10039, "spawn_sec": 240}, {"enemy_id": 15, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 35000, "attack": 1000, "base_hp": 35000, "base_attack": 1000, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111888, "race_id": 12, "special_effect_id": 233, "master_id": 30630, "global_id": 4249, "spawn_sec": 266}], "popups": ["　　　　　【冥界】\n・味方ユニットのHPが徐々に減少\n\n※このダメージは風水使いなど\n　地形効果を軽減する能力を\n　もったユニットを配置することで\n　軽減可能です。", "タルタロスの残穢は、\nブロックされていない間は味方の\n遠距離攻撃の対象になりません。\n\nまたタルタロスの残穢は、\n倒されると黒炎に変化します。", "黒炎は以下の特性を持ちます。\n・撃破数にカウントされる\n・移動、攻撃を行わない\n・ブロック可能\n・黒炎がいる間、すべての味方\n　ユニットに継続ダメージを与える\n・黒炎自身のHPは徐々に減少する", "アンデッド系から\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "パルセ", "text": "――だいぶ狭くなってきましたね。\nそれに、計器の乱れが増大しています。", "face": "u2276a1"}, {"name": "ヴァルデ", "text": "ドーンブリンガーの計器まで？\nここ、本当に冥界なのか？\n観測データがまったく役に立ってないぞ。", "face": "u2403a1"}, {"name": "ヘカティエ", "text": "一応、まだ冥界ではあるわ。\nでも……このひりつくような魔力は……。", "face": "u1226a1"}, {"name": "カルペム", "text": "タルタロスの門が、開きつつある……。", "face": "u2401a1"}, {"name": "フローガ", "text": "肉眼で見える規模の魔力ですよ……？\nこれでまだ、完全開放ではないと？", "face": "u878"}, {"name": "カルペム", "text": "タルタロスを開いた者は、\n歴史上ひとりも存在しないから。\nいったい何が起こるのかすら……。", "face": "u2401a1"}, {"name": "ヘカティエ", "text": "門が開けば、物質界全土がタルタロスに呑み込まれる、\nなんて予想もしていたけれど、無意味だったわね。", "face": "u1226a1"}, {"name": "ヴィルデフラウ", "text": "こんな膨大な魔力にさらされたら、\n侵略とか、そういう段階すら踏むことなく、\n何もかもなくなってしまうかも。", "face": "u2407a1"}, {"name": "白の皇帝", "text": "……急ぐぞ。\nタルタロスの門まで、あとどれくらいだ。", "face": "u418"}, {"name": "カルペム", "text": "回廊が見えてきたわ。\nここから先は、飛空戦艦での移動は難しいと思う。", "face": "u2401a1"}, {"name": "白の皇帝", "text": "……分かった。", "face": "u418"}, {"name": "白の皇帝", "text": "ヴァルデ、着陸と同時にハッチを開け。\nすぐに戦闘になるはずだ、総員、覚悟を決めておけ。", "face": "u418"}, {"name": "ヴァルデ", "text": "了解！\n強行着陸に入る！　総員衝撃に備えろ！", "face": "u2403a1"}, {"name": "パルセ", "text": "こちらも着陸態勢に入ります！\n皆さん、出撃準備を！", "face": "u2276a1"}, {"name": "ヴァルデ", "text": "（……あっちはなんで衝撃があんなに少ないんだ。\nこれが僕との技術の差ってことか？\nはぁ……帰ったら、もっともっと強化してやるからな）", "face": "u2403a1"}, {"name": "パルセ", "text": "（見事な機体だと思いますよ？\nさすがは私のライバルを自称するだけあります）", "face": "u2276a1"}, {"name": "ヴァルデ", "text": "ひっ、独り言に通信で割り込んでくるな！\nあぁもう、やってやる、やってみせるさ！", "face": "u2403a1"}, {"name": "ヴァルデ", "text": "そのためにも、絶対生きて帰る！！", "face": "u2403a1"}]}, {"trigger": "start", "lines": [{"name": "メーア", "text": "――接敵！\n……で、でも、なんですかあれ！？", "face": "u2404a1"}, {"name": "ツザーネ", "text": "実体がない……？\nいえ、でもあちらが攻撃する瞬間にだけ、\n確かに実像が見えるような。", "face": "u2406a1"}, {"name": "ヘカティエ", "text": "冥界の魂がタルタロスの魔力を浴びたのね……。\n仮に、タルタロスの残穢とでも呼びましょう。", "face": "u1226a1"}, {"name": "メーア", "text": "名前はいいですから！　対策とか！", "face": "u2404a1"}, {"name": "ヘカティエ", "text": "殴らせてやりなさい。\nそうしたら、こちらも反撃できるから。", "face": "u1226a1"}, {"name": "メーア", "text": "この亜神脳筋なの忘れてましたー！！", "face": "u2404a1"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "――敵の勢いが弱まりました。", "face": "u311"}, {"name": "白の皇帝", "text": "行軍を開始する。\nカルペム、案内は任せる。\nダグマール、騎兵と共に道を拓け。", "face": "u418"}, {"name": "ダグマール", "text": "機竜の出番ですね。\n全力で薙ぎ払ってやりましょう！", "face": "u2402a1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "白の皇帝", "text": "ヘカティエ、先ほどのタルタロスの残穢、\n冥界の魂が魔力を浴びたものだと言っていたな。", "face": "u418"}, {"name": "ヘカティエ", "text": "…………？\nえぇ、仮説だけどね。", "face": "u1226a1"}, {"name": "白の皇帝", "text": "そうか。", "face": "u418"}, {"name": "ヘカティエ", "text": "何よ、最後まで言いなさい。", "face": "u1226a1"}, {"name": "白の皇帝", "text": "そうして動けるようになった霊魂に、\n生前の意思はあると思うか？", "face": "u418"}, {"name": "ヘカティエ", "text": "おそらく、欠片も残っていないと思うわ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "タルタロスの魔力は、私たちの知るものとは違う。\nどこまでも冷徹で、何もかもを奪い去る、\n虚無にも等しい性質のものだから。", "face": "u1226a1"}, {"name": "白の皇帝", "text": "…………そうか。", "face": "u418"}, {"name": "ヘカティエ", "text": "だから最後まで言いなさいって！", "face": "u1226a1"}, {"name": "白の皇帝", "text": "先を急ぐぞ。\nこれはただの……戦士の勘だ。", "face": "u418"}, {"name": "白の皇帝", "text": "――救ってやらねばならない者がいる。", "face": "u418"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 20]}, {"kind": "term", "influence": 20, "params": [250]}], "enemies": [{"enemy_id": 1, "hp": 4000, "attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2159904}, {"enemy_id": 1, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 3, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 3, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 7, "hp": 23000, "attack": 700, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2138576}, {"enemy_id": 8, "hp": 2000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 9, "hp": 3500, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2142464}, {"enemy_id": 10, "hp": 32000, "attack": 2400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127824}, {"enemy_id": 10, "form_index": 1, "hp": 32000, "attack": 1600, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127840}, {"enemy_id": 14, "hp": 120000, "attack": 5000, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2127520}, {"enemy_id": 15, "hp": 35000, "attack": 1000, "damage_type": "physical", "pattern_id": 2111888}]}, "active": true}