{"quest_id": 8519, "name": "第九陣 タルタロスの魔力", "description": "帝国軍はハイドースを討つべく、冥界に\nあるタルタロスの門へ進軍を開始する。\n＜冥界：HPに継続ダメージ＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["冥界：HPに継続ダメージ"], "event": "帝国九陣", "event_category": "Empire", "mission_id": 940009, "map_no": 9322, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 20]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 46, "form_count": 2, "tags": ["ステルス"], "hp": 4000, "attack": 750, "base_hp": 4000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 16, "attack_wait": 10, "attack_interval": 95, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159904, "change_to": 1, "change_condition": 2, "master_id": 38671, "global_id": 12288, "to_condition": 2, "to_global_id": 8712}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2, "spawned_on_death_by": [1, 7, 8, 9]}, {"enemy_id": 3, "source": "local", "count": 15, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127760, "race_id": 21, "change_to": 3, "change_condition": 4, "master_id": 33555, "global_id": 7172, "to_condition": 4, "to_ticks": 3, "to_global_id": 7175, "spawn_sec": 120}, {"enemy_id": 3, "source": "local", "count": 1, "fo