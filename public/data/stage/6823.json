0, "attack_wait": 5, "attack_interval": 71, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115088, "race_id": 11, "special_effect_id": 64, "master_id": 31843, "global_id": 5462, "spawn_sec": 44}, {"enemy_id": 5, "source": "local", "count": 12, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 53}, {"enemy_id": 6, "source": "local", "count": 7, "form_count": 1, "hp": 2000, "attack": 550, "base_hp": 2000, "base_attack": 550, "damage_type": "physical", "armor_defense": 800, "attack_speed": 60, "attack_wait": 10, "attack_interval": 116, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098496, "race_id": 12, "master_id": 100, "global_id": 99, "spawn_sec": 60}, {"enemy_id": 7, "source": "local", "count": 5, "form_count": 1, "hp": 3500, "attack": 550, "base_hp": 3500, "base_attack": 550, "damage_type": "physical", "armor_defense": 800, "attack_wait": 1, "attack_interval": 38, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098496, "race_id": 12, "special_effect_id": 64, "master_id": 31844, "global_id": 5463, "spawn_sec": 97}, {"enemy_id": 8, "source": "local", "count": 10, "form_count": 1, "hp": 2400, "attack": 250, "base_hp": 2400, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_wait": 5, "attack_interval": 51, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "special_effect_id": 64, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 31838, "global_id": 5457, "ranged": true, "spawn_sec": 122}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_wait": 1, "attack_interval": 19, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "special_effect_id": 64, "master_id": 31837, "global_id": 5456, "spawn_sec": 141}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 24000, "attack": 500, "base_hp": 24000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_wait": 1, "attack_interval": 49, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099024, "race_id": 13, "special_effect_id": 396, "change_to": 10, "change_condition": 3, "master_id": 31841, "global_id": 5460, "to_condition": 3, "to_global_id": 5461, "spawn_sec": 146}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 24000, "attack": 1100, "base_hp": 24000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_wait": 5, "attack_interval": 51, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099040, "race_id": 13, "special_effect_id": 64, "master_id": 31842, "global_id": 5461, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "森の奥に、こんな洞窟があったんですね……。", "face": "lb3fb7f0a421f"}, {"name": "シャディア", "text": "やけに魔力の濃い洞窟だな……。\n森の中もそうだったが、洞窟内部は段違いだ。\n――ピリカ、剣の様子はどうだ？", "face": "u713"}, {"name": "ピリカ", "text": "がう……剣に封印された魔獣が、\nこの奥へ進めって言ってる気がする。\n洞窟の奥に、どんどん引き寄せられてるみたいで……。", "face": "u843"}, {"name": "ラテリア", "text": "ふむふむ。\n獣が凶暴化している原因は、\nやっぱりこの奥にありそうだね。", "face": "u532"}, {"name": "ピリカ", "text": "――がうっ！\n王子のお兄ちゃん、\n奥から獣の唸り声が聞こえる……！！", "face": "u843"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ラテリア", "text": "僕の鎖も反応してるね。\nそれにこれは、ただの獣の類じゃないぞぅ……？", "face": "u532"}, {"name": "ラテリア", "text": "この気配、足音……人狼かな……。\nそれにさっきのゴブリンライダー達もいるみたいだ。\nあとは……何だろう、嫌な匂いがする……。", "face": "u532"}, {"name": "シャディア", "text": "この気配は……魔獣のものか。\nこんな人里近い洞窟にいるとは、不自然だな。", "face": "u713"}, {"name": "ピリカ", "text": "がう……お姉ちゃんたちすごい。\nそんなことまで分かるんだ……。", "face": "u843"}, {"name": "シャディア", "text": "魔界に長くいたからな……。\n何にせよ、ピリカの剣ほどではないさ。", "face": "u713"}, {"name": "ラテリア", "text": "僕もこれが専門分野だからね。\nさぁて、そろそろこっちにも気付かれる頃だ。\n王子、獣狩りの準備を頼むよ！", "face": "u532"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "ピリカ", "text": "がう……全部倒せた！", "face": "u843"}, {"name": "シャディア", "text": "この辺りの安全は確保出来たか。\nピリカ、魔剣はまだ反応しているのか？", "face": "u713"}, {"name": "ピリカ", "text": "うん。もっと奥へ向かえ、\nこの先に進めって言ってるように感じられる……。", "face": "u843"}, {"name": "アンナ", "text": "つまり、今の魔獣の群れに\n反応していたわけではないと……。", "face": "lb3fb7f0a421f"}, {"name": "ラテリア", "text": "洞窟の奥には、\nさっきの群れ以上の脅威が待ち構えてるってわけだ。", "face": "u532"}, {"name": "ピリカ", "text": "がう……ちょっと怖い……。", "face": "u843"}, {"name": "ラテリア", "text": "大丈夫さ。\nこっちには王子がついてるんだからね。", "face": "u532"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ピリカ", "text": "……がう！", "face": "u843"}, {"name": "アンナ", "text": "しかし、この先にはどんな危険が\n待ち構えているか分かりません。\n十分に準備を整えてから進軍しましょうね。", "face": "lb3fb7f0a421f"}]}], "active": true}