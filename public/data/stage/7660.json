{"quest_id": 7660, "name": "夏の夜の肝試し", "description": "子供たちを探すため、夜の不気味な川辺に\nやってきた……。ふと何者かの気配を感じ、\n恐る恐る水の中を覗き込むとそこには……。\n上級（★１獲得の目安：平均Lv10）", "event": "金魚姫と夏夜の肝試し", "event_category": "History", "mission_id": 920180, "map_no": 4132, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 1, "tags": ["アンデッド"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 161, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112288, "race_id": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30683, "global_id": 4302, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 17, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 100, "attack_speed": 180, "attack_wait": 60, "attack_interval": 181, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 961, "global_id": 960, "ranged": true, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 19, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 33}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 83}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 100, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108000, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 962, "global_id": 961, "ranged": true, "spawn_sec": 104}], "dialogue": [{"trigger": "start", "lines": [{"name": "スキュレ", "text": "怖い怖い怖い怖い……なんなのよここは！？\nこんなに不気味だなんて聞いてないんだけど！", "face": "u1539a1"}, {"name": "スキュレ", "text": "──っ！？　ああ、あっちに何かいなかった！？", "face": "u1539a1"}, {"name": "リアナ", "text": "まあまあ落ち着いてください、スキュレさん。\nあれは霧で、あれは枯葉、あれは柳ですよ。", "face": "u1540a1"}, {"name": "スキュレ", "text": "リアナはどうしてそんなに落ち着いてるのよ！？", "face": "u1539a1"}, {"name": "リアナ", "text": "そうですね……私の一族に伝わる癒しの至宝を求めて、\n地下迷宮で魔物と戦ったときに比べたらこの程度は別に。", "face": "u1540a1"}, {"name": "スキュレ", "text": "なんでそんなところに癒しの至宝があるのよ！\n大事な物ならちゃんと家に保管しときなさいよ！", "face": "u1539a1"}, {"name": "リアナ", "text": "怒るのはそこなのですね。\nいえ、私も同意見なのですが。", "face": "u1540a1"}, {"name": "スキュレ", "text": "だいたいねぇ──ひぃっ……！？\nいいい、いま……川に何か……！？", "face": "u1539a1"}, {"name": "王子", "text": "…………？（ちらり）", "face": "u1"}, {"name": "河童", "text": "──バアッ！", "face": "lc3cdb546668d"}, {"name": "スキュレ", "text": "きゃーーーーっ！？", "face": "u1539a1"}, {"name": "リアナ", "text": "（驚くと同時に王子への自然なボディタッチ、\n完璧です……中々にやりますね、スキュレさん）", "face": "u1540a1"}, {"name": "河童", "text": "ニンゲン、カエレ……。", "face": "lc3cdb546668d"}, {"name": "リアナ", "text": "生憎とこちらにも事情がありまして。\nおいそれと帰るわけにもいけないのです。", "face": "u1540a1"}, {"name": "スキュレ", "text": "うぅぅ……怖いぃぃ……！\n怖い……けど、戦わなきゃ！", "face": "u1539a1"}]}, {"trigger": "end", "lines": [{"name": "河童", "text": "グエーッ！？", "face": "lc3cdb546668d"}, {"name": "リアナ", "text": "なんとか倒せましたね。もう大丈夫ですよ。", "face": "u1540a1"}, {"name": "スキュレ", "text": "はぁ……怖かったぁ……。", "face": "u1539a1"}, {"name": "リアナ", "text": "それにしても妖怪だらけですね……\nこんなところにいては子供たちが危険です。", "face": "u1540a1"}, {"name": "スキュレ", "text": "は、早く見つけて、早く帰りましょ！　ね？", "face": "u1539a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "河童", "text": "………………。", "face": "lc3cdb546668d"}, {"name": "河童", "text": "ニンゲンメ……コンドハナニヲスルツモリダ？", "face": "lc3cdb546668d"}]}], "active": true}