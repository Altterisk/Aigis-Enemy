ace_id": 2, "special_effect_id": 1179, "master_id": 37570, "global_id": 11187, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 7, "source": "local", "count": 9, "form_count": 2, "hp": 18000, "base_hp": 18000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 76, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137648, "race_id": 2, "special_effect_id": 232, "change_to": 7, "change_condition": 4, "missile_id": 476, "master_id": 34986, "global_id": 8603, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 8604, "spawn_sec": 71}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137664, "race_id": 2, "master_id": 34987, "global_id": 8604, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "hp": 250000, "attack": 700, "base_hp": 250000, "base_attack": 700, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 60, "attack_interval": 221, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123808, "race_id": 2, "special_effect_id": 558, "change_to": 9, "change_condition": 4, "missile_id": 476, "master_id": 32693, "global_id": 6311, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6312, "route_behaviour": {"sets_flags": [[2, 1, 0], [1, 1, 0], [3, 1, 0], [5, 1, 0], [6, 1, 300], [7, 1, 300], [8, 1, 300], [9, 1, 300], [10, 1, 300], [4, 1, 0]]}, "spawn_sec": 120}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 250000, "attack": 3000, "base_hp": 250000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 247, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2123824, "race_id": 2, "master_id": 32694, "global_id": 6312, "from_condition": 4, "trigger_ticks": 1}], "popups": ["ドラコレックスは味方ユニットを\n発見すると、咆哮を行います。\n咆哮を受けた味方ユニットは\n麻痺状態になります。\n\nまた、咆哮後\n移動速度が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リタ", "text": "魔獣たち、スイカに釣られ順調に集まっています。\nもう間もなく接敵する予想です、各員迎撃の準備を。", "face": "u837"}, {"name": "ホルテウス", "text": "ご苦労。聞いたな皆の者、ここが正念場である。\n魔獣たちを叩き、このリゾート地を死守するのだ。", "face": "u1837a1"}, {"name": "トゥアン", "text": "ああ、任せとけよ。一か所に集まってくれんなら余裕だ。", "face": "u2189a1"}, {"name": "ティルト", "text": "もう走り回らなくてもいいのは助かるな。\n所詮は数だけの寄せ集め、容易い相手だ。", "face": "u2187a1"}, {"name": "コーネリア", "text": "グルメジャングルにも慣れたものだ。\nこれだけの面子が集まれば勝利は固い。", "face": "u2179a1"}, {"name": "ユッタ", "text": "あ、みなさん分かってるとは思いますけどー。\nグルメジャングルの魔獣たちは高級食材ですので、\n可能な限り綺麗に仕留めるようにお願いしますよー。", "face": "u2186a1"}, {"name": "リムリィ", "text": "……大丈夫ですの？\nなんだか急に不安になってきたのですけど。", "face": "u2188a1"}, {"name": "エマ", "text": "いえいえ、心配することはありませんよ。\n確かに何かの前振りのようにも聞こえますが──", "face": "u2180a1"}, {"name": "リタ", "text": "魔獣の大群、来ます！", "face": "u837"}, {"name": "エマ", "text": "──負けませんよ、私たちは。", "face": "u2180a1"}]}, {"trigger": "end", "lines": [{"name": "エマ", "text": "──ほら、ね？", "face": "u2180a1"}, {"name": "リムリィ", "text": "……まあ、そうなりますわよね。", "face": "u2188a1"}, {"name": "ラーワル", "text": "イエーイ！　圧倒的大勝利ぃ！", "face": "u2181a1"}, {"name": "トゥアン", "text": "……ったく、ようやく一息付けそうか？", "face": "u2189a1"}, {"name": "デーモンシェフ", "text": "うむ、これでようやく魔獣の侵攻も止むだろう。\n結局、諸君には最後まで迷惑を掛けてしまったな。", "face": "l993fb1fcf3bc"}, {"name": "トゥアン", "text": "そう思うんならこの後の待遇には期待してんぜ？\nどんだけ豪華なメシが出てくるんだろーなー。", "face": "u2189a1"}, {"name": "ユッタ", "text": "新鮮な高級食材もたんまりとありますからねー。\n魔界の寵児の手腕、とことん見せてもらいますよ？", "face": "u2186a1"}, {"name": "デーモンシェフ", "text": "うむ、我等も伊達にシェフを名乗っているわけではない。\n王国の料理人たちが優秀なのは既に聞き及んでいるが……。", "face": "l993fb1fcf3bc"}, {"name": "デーモンシェフ", "text": "グルメジャングルに適応した料理というものを教えよう。", "face": "l993fb1fcf3bc"}, {"name": "レギーナ", "text": "じゅるり。", "face": "u1045a1"}, {"name": "ユッタ", "text": "食べ過ぎ厳禁ですからねー。\nあなた減量終わってないでしょ？", "face": "u2186a1"}, {"name": "レギーナ", "text": "ゲン、リョウ……？", "face": "u1045a1"}, {"name": "ユッタ", "text": "アルティアさんのボディメイク教室に行け。", "face": "u2186a1"}, {"name": "ラーワル", "text": "ん……待って、何か聞こえない？", "face": "u2181a1"}, {"name": "コーネリア", "text": "これは……大地が、鳴いている……？", "face": "u2179a1"}, {"name": "アスバール", "text": "……大きな嵐の予感がします。\n皆さん、急いで拠点まで退避を！", "face": "u2184a1"}, {"name": "エマ", "text": "……ここで現れますか。", "face": "u2180a1"}, {"name": "エマ", "text": "グルメジャングルの、真の王が……。", "face": "u2180a1"}]}], "active": true}