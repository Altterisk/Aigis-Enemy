{"quest_id": 1914, "name": "より深い海の底へ", "description": "より強まった水圧に注意しつつ\n深海に蠢く魔物たちを撃退せよ！\n＜深海（強）：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海（強）：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション10", "event_category": "Story", "mission_id": 100010, "map_no": 1134, "level": 100, "multiplier": 1.0, "charisma": 52, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 6], "ext": "攻撃待ち増加=90,ダメージ開始待ち=900"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 117, "form_count": 1, "tags": ["水中"], "hp": 5500, "attack": 220, "base_hp": 5500, "base_attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126560, "race_id": 18, "special_effect_id": 660, "change_to": 1, "change_condition": 1, "master_id": 34525, "global_id": 8142, "variants": [{"tags": ["水中"], "hp": 5500, "attack": 220, "base_hp": 5500, "base_attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126576, "race_id": 18, "master_id": 34526, "global_id": 8143}], "spawn_sec": 29}, {"enemy_id": 3, "source": "local", "count": 15, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5250, "attack": 750, "base_hp": 5250, "base_attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 97, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123792, "race_id": 7, "missile_id": 45, "master_id": 32765, "global_id": 6383, "ranged": true, "spawn_sec": 72}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 60, "attack_range": 100, "attack_speed": 1, "attack_wait": 30, "attack_interval": 129, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124400, "race_id": 7, "special_effect_id": 220, "missile_id": 11, "master_id": 32767, "global_id": 6385, "ranged": true, "spawn_sec": 142}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 540000, "attack": 1200, "base_hp": 540000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 16000, "magic_defense": 50, "attack_range": 230, "attack_speed": 1, "attack_wait": 100, "attack_interval": 267, "move_speed": 50.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126480, "race_id": 7, "change_to": 5, "change_condition": 1, "missile_id": 473, "missile": {"speed": 4.0, "splash": 133, "on_hit": {"kind": "攻撃遅延", "duration_f": 200, "attack_interval_f": 200, "effect_name": "HitEffectSlow"}}, "master_id": 33055, "global_id": 6672, "ranged": true, "variants": [{"tags": ["アーマー"], "hp": 540000, "attack": 9000, "base_hp": 540000, "base_attack": 9000, "damage_type": "physical", "armor_defense": 16000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 125, "attack_interval": 313, "move_speed": 50.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126464, "race_id": 7, "master_id": 33056, "global_id": 6673}], "spawn_sec": 147}, {"enemy_id": 7, "source": "local", "count": 19, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 226, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126512, "race_id": 7, "change_to": 7, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 34527, "global_id": 8144, "ranged": true, "variants": [{"hp": 8000, "attack": 1050, "base_hp": 8000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 8000, "magic_defense": 40, "attack_speed": 1, "attack_wait": 60, "attack_interval": 179, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126496, "race_id": 7, "master_id": 34528, "global_id": 8145}], "spawn_sec": 152}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "tags": ["水中"], "hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 40, "attack_speed": 1, "attack_wait": 150, "attack_interval": 358, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126528, "race_id": 7, "master_id": 34524, "global_id": 8141, "spawn_sec": 295}], "popups": ["　　　【深海の水圧(強)】\n・味方の攻撃後待ち時間が大きく増加\n・ユニット配置後、一定時間経過で\n　継続ダメージが発生\n\n※これらは、風水使いなどがもつ\n　地形効果を軽減する能力では\n　軽減できません。", "異界の虫(深海種)は\nHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。", "サラタンの幼体(深海種)、\nサラタンの成体(深海種)から\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\nブロックされている間は、\n攻撃に遅延効果が無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ソーマ", "text": "うぅ、何だか暗くなってきてませんか……？", "face": "u23"}, {"name": "オーベッド", "text": "海底都市よりも深い場所だからな。\n地上の光はここにはわずかにしか届いていないのだ。", "face": "u1122a1"}, {"name": "デューオ", "text": "……沈没船の残骸を見ると、\nここが海の底なんだって思い知らされるね。", "face": "u594"}, {"name": "オーベッド", "text": "乾いた地の者からすれば死の世界だろうが、\n我らからすれば地上こそ水なき世界。\n何事も見るものの視点ひとつ、ということだ。", "face": "u1122a1"}, {"name": "ケイティ", "text": "……確かに。\n手を結んだ以上、これからは\n互いのことをよく知っていきたいものです。", "face": "u114"}, {"name": "オーベッド", "text": "ははっ、こちらも同意見だ。\nしかしまずは、\nギガエルの凶行を止める方が先決だな。", "face": "u1122a1"}, {"name": "モニカ", "text": "うぅ、だけどこの「水圧」は中々のものよ……。\n海底都市の辺りより、\nさらに身体が重くなってるしぃ……。", "face": "u87"}, {"name": "サブリナ", "text": "うーん、この状態で戦闘となると、\n結構な苦戦を強いられそうだね。", "face": "u332"}, {"name": "オーベッド", "text": "――おっと、弱音を吐いている暇はないぞ。\n水に伝わるこの振動……。\nどうやらギガエルの手勢の出迎えのようだ。", "face": "u1122a1"}, {"name": "ロヴィニア", "text": "……んっ？　あ、あれ？\nあの虫って……異界の虫じゃ……。", "face": "u662"}, {"name": "マーマン", "text": "――然り。\n我らが神の御使い、ギガエル様の手によって、\n深海に適応した溺れる地の虫どもだ。", "face": "l84dcfbcc054a"}, {"name": "オーベッド", "text": "乾いた地の生物を改造したのか！？\n何という……それは創造主の領分を侵す行為だぞ！", "face": "u1122a1"}, {"name": "マーマン", "text": "何、我らは海神たる御方の下僕。\nなれば神の赦しを得たも同然よ。", "face": "l84dcfbcc054a"}, {"name": "リバン", "text": "海神……？\nクラールフ様以外の、海の亜神が……？", "face": "u1062a1"}, {"name": "マーマン", "text": "貴様らにそれを知る権利があると思うのか。\nギガエル様の手を煩わせるまでもない、\nここで魚たちの餌にしてやろう。", "face": "l84dcfbcc054a"}, {"name": "ロヴィニア", "text": "王子、あの虫が深海の水圧に適応したっていうなら、\n地上の虫より強靭になってるはずだよ。\n絶対に油断しないようにね！", "face": "u662"}]}, {"trigger": "end", "lines": [{"name": "マーマン", "text": "……くっ、ここは深海だぞ。\nなぜ溺れる地の民が、これほどの力を……。\n急ぎ、ギガエル様に報告しなければ……！", "face": "l84dcfbcc054a"}, {"name": "オーベッド", "text": "王子殿、海溝神殿――\nバハムトの封印領域はもうすぐそこだ。\nおそらく、過酷な戦闘となることだろう。", "face": "u1122a1"}, {"name": "リーンベル", "text": "……いまさら、だな。\n過酷じゃない戦場なんて、\n王国のこれまでの戦いにあっただろうか。", "face": "u268"}, {"name": "オーベッド", "text": "レヴィアタンの体内にまで\n乗り込んだ軍は言うことが違うな……。\nよし、ならば先へ進むとしよう。", "face": "u1122a1"}, {"name": "アンナ", "text": "王子、バハムトの封印が破られれば、\n深海にも、地上にも甚大な被害が予想されます。\n必ずや、封印を守り抜きましょう！", "face": "l69e56a270b4d"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 50, "params": [50]}, {"kind": "term", "influence": 34, "params": [0, 10, 6], "ext": "攻撃待ち増加=90,ダメージ開始待ち=900"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 5500, "attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "pattern_id": 2126560}, {"enemy_id": 3, "hp": 5250, "attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "pattern_id": 2123792}, {"enemy_id": 4, "hp": 5000, "attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 60, "pattern_id": 2124400}, {"enemy_id": 5, "hp": 540000, "attack": 1200, "damage_type": "magical", "armor_defense": 16000, "magic_defense": 50, "pattern_id": 2126480}, {"enemy_id": 7, "hp": 8000, "attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "pattern_id": 2126512}, {"enemy_id": 9, "hp": 30000, "attack": 2000, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 40, "pattern_id": 2126528}]}, "active": true}