d": 2106496, "race_id": 8, "change_to": 11, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 387, "global_id": 386, "ranged": true, "to_condition": 3, "to_global_id": 387, "spawn_sec": 146}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106512, "race_id": 8, "special_effect_id": 234, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 388, "global_id": 387, "ranged": true, "from_condition": 3}, {"enemy_id": 13, "source": "local", "count": 1, "level": 60, "form_count": 1, "hp": 150000, "attack": 3000, "base_hp": 150000, "base_attack": 3000, "damage_type": "true", "armor_defense": 1000, "magic_defense": 60, "attack_range": 140, "attack_speed": 120, "attack_wait": 30, "attack_interval": 157, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "pattern_id": 2120240, "special_effect_id": 429, "missile_id": 324, "missile": {"speed": 9.0}, "master_id": 32030, "global_id": 5649, "ranged": true, "spawn_sec": 160}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 100, "base_hp": 3000, "base_attack": 100, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105584, "missile_id": 152, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30691, "global_id": 4310, "ranged": true, "spawn_sec": 228}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 120, "base_hp": 10000, "base_attack": 120, "damage_type": "magical", "armor_defense": 120, "attack_range": 130, "attack_speed": 120, "attack_wait": 60, "attack_interval": 221, "move_speed": 230.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100192, "missile_id": 28, "missile": {"speed": 6.0, "splash": 200}, "master_id": 30693, "global_id": 4312, "ranged": true, "spawn_sec": 264}], "popups": ["クロコと異界召喚士は\n拠点には向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。", "異界の虫はHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。", "魔王の影は攻撃力800以下の\nあらゆる攻撃を受け付けません。\n\n\n\n　　　　　　　　　　　(1/2)", "魔王の影の攻撃は\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。\n　　　　　　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "きゃぁっ！？\nな、なんですか、あの虫は……っ！？", "face": "u921"}, {"name": "白の皇帝", "text": "――逃げ遅れた市民か。\n……俺から離れるな、分かったか？", "face": "u418"}, {"name": "？？？", "text": "は、はい……。\nうぅぅ、どうして、どうしてこんなことに……。", "face": "u921"}, {"name": "異界召喚士", "text": "キヒヒッ！　尻尾を巻いて逃げれば良いものを、\nそんな小娘を守って死ぬ気とは！", "face": "l7b1f4704ba1a"}, {"name": "クロコ", "text": "愚かナ。ダガ、その武人としてのあり方、\n私の記憶ニ刻んでオコウ。", "face": "ld3f4651f95a1"}, {"name": "白の皇帝", "text": "……その必要はない。\nお前達はここで終わりだ。", "face": "u418"}, {"name": "異界召喚士", "text": "キヒッ？　何を言っている？\n増援を待っているなら見当違いだ。", "face": "l7b1f4704ba1a"}, {"name": "クロコ", "text": "東の国、北の大国デハ、他の幹部が\n随分と苦戦させられたようダガ、\n北の大国からここマデ、どれだけの距離がアルと――", "face": "ld3f4651f95a1"}, {"name": "白の皇帝", "text": "――だから、帝国の船を貸したのだ。\n遅いぞ王子。待ちくたびれた。", "face": "u418"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ルーテ", "text": "陛下、遊撃隊と連携し、\n市街の魔物の掃討を開始しました。\n市民の被害は軽微です！", "face": "u529"}, {"name": "クロコ", "text": "ホウ、国民に矛先が向かヌよう、\n皇帝自ら私達を引きつけていたというノカ……。", "face": "ld3f4651f95a1"}, {"name": "異界召喚士", "text": "キヒィー！！　それがどうした！？\n所詮は小規模な遊撃部隊。\nクロコよ、ここで潰してしまえェ！！", "face": "l7b1f4704ba1a"}, {"name": "クロコ", "text": "私ニ命令するナ……。\nソシテ魔王様の理想のタメ、お前も戦うのダ。", "face": "ld3f4651f95a1"}, {"name": "異界召喚士", "text": "致し方ない……。\n覚悟せよ、王子共め……！！", "face": "l7b1f4704ba1a"}, {"name": "白の皇帝", "text": "――行くぞ王子、お前の力を見せてやれ。", "face": "u418"}]}, {"trigger": "battle", "at_sec": 159, "lines": [{"name": "異界召喚士", "text": "（キヒィーッ！？　何じゃこの強さは！\n王子め、さらに強くなりおったな！？）", "face": "l7b1f4704ba1a"}, {"name": "異界召喚士", "text": "（こうなれば、魔王様の手を煩わせてしまうが、\n例の作戦を実行するしかあるまい……っ！！）", "face": "l7b1f4704ba1a"}, {"name": "異界召喚士", "text": "キヒィーッ！\n魔王様のお力の欠片をお借りしますぞ！\nいでよ、御姿の映し身よぉ……！！", "face": "l7b1f4704ba1a"}, {"name": "アンナ", "text": "王子、異界召喚士が魔王の影を召喚しました！", "face": "lae6f900356a5"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "――何が起きた？\n魔王軍が退いていくぞ……。", "face": "u311"}, {"name": "ディルク", "text": "ぐっ……レオナ、様……っ！\n伝令です……『破滅の力』が……っ！", "face": "u287"}, {"name": "レオナ", "text": "報告は正確にしろ。\n『破滅の力』がどうしたと言うんだ。", "face": "u311"}, {"name": "ディルク", "text": "城内に、魔王ガリウスが出現……っ！\n護衛部隊の被害甚大、『破滅の力』も\nガリウスの手に渡ってしまいました……っ！", "face": "u287"}, {"name": "白の皇帝", "text": "…………なるほどな。\n連中、撤退を装って俺達をここに引きつけたのか。", "face": "u418"}, {"name": "メフィスト", "text": "とはいえ『破滅の力』は七つ揃って、\n初めてその効果を発揮するのだろう？\nならば他の場所さえ守っていれば――", "face": "u526"}, {"name": "ラピス", "text": "……メフィスト、甘いぞ。\n感じないのか、この禍々しい魔力を。", "face": "u436"}, {"name": "異界召喚士", "text": "――キヒ。\n魔神共はさすがに気付くか……。\nだが、もはや手遅れというものよ。", "face": "l7b1f4704ba1a"}, {"name": "異界召喚士", "text": "さぁ弟子よ、お前はこの時の為に育ててきたのじゃ。\nその有り余る魔力の泉を、\nワシに捧げ、魔王様の礎になるのじゃ……！！", "face": "l7b1f4704ba1a"}, {"name": "異界召喚士の弟子", "text": "……えっ？　し、師匠？\nなにを……あっ、いやっ、いやぁぁぁぁぁッ！？", "face": "u942"}, {"name": "異界召喚士", "text": "キヒィ！　魔力量だけがお前の取り柄じゃからな！\n存分に絞り尽くし、同時召喚の贄にしてやろう！", "face": "l7b1f4704ba1a"}, {"name": "ユージェン", "text": "や、やめろっ！　その子が死んでしまうっ！", "face": "u906"}, {"name": "異界召喚士", "text": "知ったことかぁぁぁぁっ！！\nさぁ魔王様、あなた様の手足となって動く、\n無数の映し身を世界中に放ちましたぞ！！", "face": "l7b1f4704ba1a"}, {"name": "フローガ", "text": "『王子殿下！　『破滅の力』の護衛にあたっている\n各地の部隊から、魔王の影の出現報告が！』", "face": "u878"}, {"name": "フローガ", "text": "『殿下？　王子殿下！\nこのままでは魔王軍に\n『破滅の力』が奪われてしまいます……っ！！』", "face": "u878"}, {"name": "バルバストラフ", "text": "フローガよ……。\n手遅れやもしれぬぞ……。\n王子、今この場に近付いてくる魔力の波動は――", "face": "u63"}]}, {"trigger": "end", "lines": [{"name": "シャディア", "text": "――魔王ガリウス。\n全てお前の狙い通りということか。", "face": "u713"}, {"name": "ガリウス", "text": "――何度お前達の力を試したと思っている。\nこの物質界において、\n予に抗しうるのは王国、帝国の戦力のみ……。", "face": "ld52e97de0357"}, {"name": "ガリウス", "text": "なれば、お前達をここに釘付けにすれば、\n後は有象無象が蔓延るのみ……。", "face": "ld52e97de0357"}, {"name": "ガリウス", "text": "王子よ、かつてお前は予に、\nこの世界が予の物ではないと言ったな。", "face": "ld52e97de0357"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ガリウス", "text": "残念だったな。\nこの世界は、もはや予の物だ。", "face": "ld52e97de0357"}, {"name": "ガリウス", "text": "我が臣下共よ『破滅の力』を掲げよ。\nこれより物質界は消滅し、\n全てが魔界によって上書きされるのだ。", "face": "ld52e97de0357"}, {"name": "？？？", "text": "……ぁ……あぁ……。", "face": "u921"}, {"name": "ソラス", "text": "（サナラ！　何を怖がっているんですか！\nこのままじゃ王子君達まで全滅しちゃいますよ！？）", "face": "u904"}, {"name": "サナラ？", "text": "（……えっ？　あ、あなたは？　誰ですか？\nいったい何を言って……）", "face": "u921"}, {"name": "ソラス", "text": "（私が英傑の塔に自らを封じたように、\nあなたもその羅盤に己の記憶を封じているだけ）", "face": "u904"}, {"name": "ソラス", "text": "（魔界化なんて、星の力だけでは耐えきれません！\n早く目を覚ましてくださいよぉ！\nそれでも大地を紡ぐと謳われた英傑ですかっ！？）", "face": "u904"}, {"name": "サナラ？", "text": "（き、記憶……？　私の、記憶……。\nあっ、あぁぁぁっ！！　わ、私は――）", "face": "u921"}, {"name": "ガリウス", "text": "――さぁ、物質界の諸君、終焉の時だ。", "face": "ld52e97de0357"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "ゴライア", "text": "ウオオオオォォッ！！\n喰らいやがレ！　クロコォ！！", "face": "u385"}, {"name": "クロコ", "text": "――ゴライア、カ。\nそんナ不意打ちデ、私ヲ倒せると思わぬコトダ。", "face": "ld3f4651f95a1"}, {"name": "ゴライア", "text": "グァァァァッ！？　――なんてなァ！\nやれッ、ベルナァ！！", "face": "u385"}, {"name": "ベルナ", "text": "油断するとこ、全然学習してないね！\n喰らえぇぇぇっ！！", "face": "u46"}, {"name": "クロコ", "text": "グッ……！？\n私に傷を負わせるトハ……。\n良いだロウ、この勝負はお前タチに譲ろウ……。", "face": "ld3f4651f95a1"}]}, {"trigger": "route", "enemy_ids": [3], "lines": [{"name": "異界召喚士", "text": "キヒィッ！？\nワシは逃げるぞ！　弟子っ、付いてこい！！", "face": "l7b1f4704ba1a"}, {"name": "異界召喚士の弟子", "text": "……はぁ。\nはいはい、また逃げるんですね。", "face": "u942"}]}], "active": true}