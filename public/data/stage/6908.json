{"quest_id": 6908, "name": "魔王軍防衛線：白の帝国", "description": "帝国の飛空船で駆け付けた先、市民を守る\n皇帝の姿があった。クロコ、異界召喚士が\n率いる魔王軍を退けろ。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "英雄王を継ぐ者", "event_category": "History", "mission_id": 920186, "map_no": 5118, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 50000, "attack": 1200, "base_hp": 50000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 190, "attack_speed": 100, "attack_wait": 30, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114032, "race_id": 2, "special_effect_id": 83, "change_to": 1, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 31782, "global_id": 5401, "ranged": true, "variants": [{"hp": 50000, "attack": 3000, "base_hp": 50000, "base_attack": 3000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 100, "attack_wait": 20, "attack_interval": 203, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114048, "race_id": 2, "special_effect_id": 242, "master_id": 31783, "global_id": 5402}], "route_behaviour": {"calls_event": [2103, 2104, 2105, 2106, 2107]}}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "hp": 34000, "attack": 900, "base_hp": 34000, "base_attack": 900, "damage_type": "magical", "armor_defense": 200, "magic_defense": 50, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 141, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116416, "race_id": 3, "special_effect_id": 242, "change_to": 3, "change_condition": 3, "missile_id": 325, "missile": {"speed": 6.0}, "master_id": 32066, "global_id": 5685, "ranged": true, "to_condi