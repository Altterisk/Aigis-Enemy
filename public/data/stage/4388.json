nge_to": 11, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_condition": 0, "to_global_id": 534, "spawn_sec": 141}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 10, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534, "from_condition": 0}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "あれは……石碑……でしょうか？", "face": "l1813779fe06c"}, {"name": "リコラ", "text": "あの石碑は兵士たちの魂を鎮めるためのもの。\nそして、悪と戦う兵士たちに、\n勇気と力を与えてくれるものなの。", "face": "u289"}, {"name": "兵士", "text": "た、確かに……。不思議な力を感じます。", "face": "le4c54648adb1"}, {"name": "ヘクター", "text": "こう……体の中から力が湧き上がるような……。", "face": "u74"}, {"name": "リコラ", "text": "ここはソルジャーの戦士が眠る石碑。\n石碑に眠る彼らの魂が、ソルジャーに力を与えて\nくれてるんだと思う。", "face": "u289"}, {"name": "暗黒騎士デシウス", "text": "おや、あれは……。", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "あの石碑……。似ているが違うな。\nちっ、他を当たるしかないか。", "face": "ld336215cf73a"}, {"name": "オーク", "text": "おい、あそこにいるやつら強そうだな。俺は戦うぞ。\n強いやつと戦うことが俺のすべて……。\nお前に邪魔はさせん……っ！", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "わかったわかった！　そう怒らないでくれ！\n見えなかっただけなんだ！\nお前の好きに暴れていいさ！", "face": "ld336215cf73a"}, {"name": "オーク", "text": "いいぞ……ゾクゾクしてくる……。", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "お前は強いのだから前線に立ち好きに暴れるといい！\n我輩は後ろからこっそり……。\nあ、いや、なんでもない！　後方支援をしよう！！", "face": "ld336215cf73a"}, {"name": "オーク", "text": "……好きにしろ。俺は強いやつと戦うだけだ……！", "face": "l0632d7f6f22d"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士デシウス", "text": "全く……。オーク共にも困ったものだ。\nここは先に進み、目的の物を見つけるのが先か……。", "face": "ld336215cf73a"}, {"name": "オーク", "text": "ぐぁああ！！　俺は、まだ、まだ戦えるぞおおお！！", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "そう興奮するなオーク。\nこの先におびき寄せようではないか。", "face": "ld336215cf73a"}, {"name": "オーク", "text": "ぐ……っ。", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "はぁ……。\n先が思いやられるな……。", "face": "ld336215cf73a"}, {"name": "アンナ", "text": "王子、敵が逃げます！\n急ぎ私たちも追いかけましょう！", "face": "l1813779fe06c"}]}], "map": {"image": "Map920051_3616", "w": 960, "h": 640, "spots": [{"k": "b", "x": 27, "y": 122}, {"k": "b", "x": 25, "y": 424}, {"k": "m", "x": 168, "y": 136, "id": 200}, {"k": "m", "x": 285, "y": 151, "id": 201}, {"k": "m", "x": 383, "y": 204, "id": 202}, {"k": "m", "x": 411, "y": 318, "id": 203}, {"k": "m", "x": 426, "y": 420, "id": 204}, {"k": "m", "x": 296, "y": 450, "id": 205}, {"k": "m", "x": 167, "y": 451, "id": 206}, {"k": "m", "x": 519, "y": 135, "id": 207}, {"k": "m", "x": 608, "y": 211, "id": 208}, {"k": "m", "x": 701, "y": 284, "id": 209}, {"k": "m", "x": 799, "y": 347, "id": 210}, {"k": "m", "x": 873, "y": 258, "id": 211}, {"k": "m", "x": 735, "y": 431, "id": 212}, {"k": "m", "x": 642, "y": 489, "id": 213}, {"k": "m", "x": 529, "y": 467, "id": 214}, {"k": "r", "x": 674, "y": 154, "id": 300}, {"k": "r", "x": 780, "y": 229, "id": 301}, {"k": "r", "x": 902, "y": 342, "id": 302}, {"k": "r", "x": 854, "y": 412, "id": 303}, {"k": "r", "x": 795, "y": 486, "id": 304}, {"k": "r", "x": 105, "y": 211, "id": 305}, {"k": "r", "x": 285, "y": 235, "id": 306}, {"k": "r", "x": 187, "y": 361, "id": 307}, {"k": "r", "x": 457, "y": 187, "id": 308}, {"k": "r", "x": 480, "y": 295, "id": 309}]}, "active": true, "story_talk": true}