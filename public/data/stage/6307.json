{"quest_id": 6307, "name": "道阻む天よりの刺客", "description": "遺跡を進む王子たちの前に、\n天界からの刺客が襲い来る。\n迫る天使を撃退し、道を切り開け！\n上級（★１獲得の目安：平均Lv10）", "event": "神殺しの聖槍", "event_category": "History", "mission_id": 920185, "map_no": 5108, "level": 90, "multiplier": 0.9, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 1, "hp": 2700, "attack": 360, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 1, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 5560}]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 5400, "attack": 540, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 3, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 10400}]}, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 1, "hp": 2250, "attack": 270, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 5, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 5}, {"enemy_id": 7, "source": "local", "count": 10, "form_count": 1, "tags": ["アンデッド"], "hp": 3600, "attack": 270, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 37}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 2, "hp": 2250, "attack": 225, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 8, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 53}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2250, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "hp": 2250, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 67}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 2250, "attack": 270, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 77}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 9000, "attack": 450, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 161, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098304, "special_effect_id": 227, "master_id": 90, "global_id": 89, "spawn_sec": 117}], "dialogue": [{"trigger": "start", "lines": [{"name": "ネフティ", "text": "聖槍グングニルの眠る場所はこの先です。\n暗いので足下にお気をつけください。", "face": "u551"}, {"name": "デシウス", "text": "（くっ、この女に案内されては我輩の立場が……）", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "（だが、率直に言えば案内者がいて助かるのも事実。\n内部の道までは情報提供者も知らなかったからな）", "face": "l07c2a5a929a8"}, {"name": "ネフティ", "text": "――むっ、あれは……！", "face": "u551"}, {"name": "天使", "text": "愚かな人間たちよ……。\n神のご意志に逆らう者は、粛清します。", "face": "l21ccdd366010"}, {"name": "ソーマ", "text": "わわっ……天使さんたちが\n奥の方から大勢出てきました。\n一体何人いるんでしょう？", "face": "u23"}, {"name": "ネフティ", "text": "……天使だけではありません。\n開いた状態の棺には魔物も潜んでいます。\n空中ばかりに気を取られては、足元をすくわれますよ。", "face": "u551"}]}, {"trigger": "end", "lines": [{"name": "天使", "text": "……我らの役目はこれまでです。\nあとのことは先へ行った者たちに任せましょう。", "face": "l21ccdd366010"}, {"name": "ユリアン", "text": "……ずいぶん足止めを喰らっちまったな。\nだが、これで天使どもがピラミッドを破壊すんのを\nかなり遅らせられたんじゃねえか？", "face": "u7"}, {"name": "ネフティ", "text": "そう願います……が、\n天使たちの言っていたことが気になりますね……。", "face": "u551"}, {"name": "ネフティ", "text": "先へ行った者たち、とはどういうことでしょうか？\n天使たちの目的はピラミッドの破壊ではないのですか？", "face": "u551"}, {"name": "デシウス", "text": "違うな。天使たちの目的は聖槍を使えなくすることだ。\nおそらく主であるケラウノスに\nそう命じられているのだろう。", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "だが、聖槍グングニルはそう容易く持ち運んだり\n壊したりできるようなシロモノではないらしい。\nそれに奴らも聖槍の詳しい在り処までは知らんはずだ。", "face": "l07c2a5a929a8"}, {"name": "ネフティ", "text": "……だからピラミッド全体を破壊することによって、\n聖槍もろとも砂の中に埋めようとした、ということですか。", "face": "u551"}, {"name": "デシウス", "text": "だろうな。だが、もしも天使どもが\n我輩たちよりも先に聖槍の在り処に辿り着いたとすれば、\nその部屋を破壊する事で、奴らは目的を達することになる。", "face": "l07c2a5a929a8"}, {"name": "ネフティ", "text": "――こうしてはいられません！\n聖槍を守らなくては！", "face": "u551"}, {"name": "アンナ", "text": "ね、ネフティさん……あの、足下に……。", "face": "l4ee62bb76748"}, {"name": "ネフティ", "text": "え、足下？", "face": "u551"}, {"name": "ネフティ", "text": "――って……きゃああぁッ！？\nね、ネズミ嫌ぁあ～～～～っ！！", "face": "u551"}, {"name": "デシウス", "text": "フハハハハ！\nそんな猫のような恰好をしているくせに\nネズミごときを怖がるとはな！", "face": "l07c2a5a929a8"}, {"name": "ケイティ", "text": "……デシウスさん。\n案内役の座を奪われたからといって\nネフティさんに対抗意識を燃やさないでください。", "face": "u114"}, {"name": "デシウス", "text": "ば……馬鹿を言うな！\n下らんことを言っていると天使どもに先を越されるぞ！\n……おい女、腰を抜かしてないでさっさと案内をしろ！", "face": "l07c2a5a929a8"}]}], "active": true}