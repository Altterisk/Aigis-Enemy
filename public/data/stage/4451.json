k_wait": 30, "attack_interval": 205, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101248, "master_id": 227, "global_id": 226, "spawn_sec": 104}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 500, "base_hp": 2800, "base_attack": 500, "damage_type": "magical", "armor_defense": 700, "magic_defense": 40, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 241, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102800, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 397, "global_id": 396, "ranged": true, "spawn_sec": 171}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 260, "attack_speed": 70, "attack_wait": 60, "attack_interval": 162, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103808, "race_id": 16, "change_to": 10, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 339, "global_id": 338, "ranged": true, "to_global_id": 480, "spawn_sec": 186}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 70, "attack_wait": 60, "attack_interval": 232, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103808, "race_id": 16, "change_to": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 481, "global_id": 480}], "popups": ["　　　悪天候：猛吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇"], "dialogue": [{"trigger": "start", "lines": [{"name": "暗黒騎士デシウス", "text": "よしよし、\n王子たちはまんまとついてきているようだな。", "face": "l3211f683040c"}, {"name": "サラサ", "text": "この雪山ってあたしよく来るんだけど、\n結構強い吹雪がくるのよね。大丈夫なの？", "face": "u317"}, {"name": "サラサ", "text": "あたしは寒いのは平気だからいいけどさ。", "face": "u317"}, {"name": "暗黒騎士デシウス", "text": "案ずるな。\nこの雪山に慣れているやつらを\nてなずける予定だ。", "face": "l3211f683040c"}, {"name": "暗黒騎士デシウス", "text": "王子たちは雪山の戦いに慣れてないから、\nすぐに決着がつくだろう。", "face": "l3211f683040c"}, {"name": "暗黒騎士の手下", "text": "団長！\n王子たちの行軍が思ったより早く、\nすぐ後ろに迫っています！", "face": "lbdb050c1406c"}, {"name": "暗黒騎士デシウス", "text": "ぐぬぅ。仕方ない……。\n暗黒騎士たちよ、\n少しだけ王子の足止めをしておくのだ。", "face": "l3211f683040c"}, {"name": "暗黒騎士デシウス", "text": "その間に、我輩がやつらを手なずけておく。", "face": "l3211f683040c"}]}, {"trigger": "battle", "at_sec": 101, "lines": [{"name": "暗黒騎士デシウス", "text": "イエティよ！　あの人間どもが貴様らの\n住処を襲おうとしているぞ！", "face": "l3211f683040c"}, {"name": "イエティ", "text": "……！　ウキャキャキャッ！！\nオレたちノ、住ムトコロ……。", "face": "l0237f7c08e1f"}, {"name": "暗黒騎士デシウス", "text": "ほら見てみるのだ。\nもうすぐそばに来ているぞ！", "face": "l3211f683040c"}, {"name": "イエティ", "text": "ニンゲン、許サナイ！！\nニンゲン、タオス！", "face": "l0237f7c08e1f"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士デシウス", "text": "こんな場所までおびき寄せ、\n罠を張っても倒せぬとは。\nもはやここまでか……。", "face": "l3211f683040c"}, {"name": "サラサ", "text": "困ったわね。\nこのままじゃ、プレゼントを\nみんなに渡せなくなるわ。", "face": "u317"}, {"name": "サラサ", "text": "……諦めるわけにはいかないわ。\n次の作戦を考えてみるから、\nちょっと待って。", "face": "u317"}, {"name": "暗黒騎士デシウス", "text": "（愚かな女だな。\n我輩が約束を守ると、\n信じ切っているのだろうか……。）", "face": "l3211f683040c"}, {"name": "暗黒騎士デシウス", "text": "……もうよい。今日は疲れた。\n今回の作戦は終わりだ。", "face": "l3211f683040c"}, {"name": "暗黒騎士デシウス", "text": "プレゼントは返してやる。\n勝手に持って行くがいい。", "face": "l3211f683040c"}, {"name": "サラサ", "text": "えっ、本当に？　いいの？\n良かった～。\n早速プレゼントを詰め込まなきゃ！", "face": "u317"}]}, {"trigger": "end", "lines": [{"name": "サラサ", "text": "よし！\nこれで全部っと。", "face": "u317"}, {"name": "サラサ", "text": "じゃあ団長さん、あたしはもう行くね。\nみんながプレゼントを待ってるだろうから。", "face": "u317"}, {"name": "暗黒騎士デシウス", "text": "おい、まだ一つ残っているぞ。", "face": "l3211f683040c"}, {"name": "サラサ", "text": "それは、あんたへのプレゼントよ。\nあたしからのね！", "face": "u317"}, {"name": "暗黒騎士デシウス", "text": "なに？　我輩へのプレゼントだと？", "face": "l3211f683040c"}, {"name": "サラサ", "text": "あなたは卑怯でどうしようもない人間だわ。\n……っていうか、人間かすら怪しいけどね。", "face": "u317"}, {"name": "サラサ", "text": "でも、あたしが落としたプレゼントを\n手下全員使ってかき集めてくれたしね。", "face": "u317"}, {"name": "サラサ", "text": "それに、多分あたし一人じゃ\n集めきれなかったと思うわ。\nだから感謝してるのよ、一応はね。", "face": "u317"}, {"name": "暗黒騎士デシウス", "text": "か、感謝……だと……。", "face": "l3211f683040c"}, {"name": "サラサ", "text": "おかげで子供たちにプレゼントが\n配れるわけだし。結果的にあんたが\nしたことで、子供たちが喜んでくれるのよ。", "face": "u317"}, {"name": "暗黒騎士デシウス", "text": "ふ、ふざけるな！\n我輩がしたことが善い事だったとでもいうのか！\n馬鹿馬鹿しい！", "face": "l3211f683040c"}, {"name": "サラサ", "text": "あはは、じゃあね。\n次に会う時は敵同士かもしれないけれど。\nその時は手加減しないからね。", "face": "u317"}, {"name": "暗黒騎士デシウス", "text": "ふん、さっさと行け！", "face": "l3211f683040c"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士デシウス", "text": "うるさいのがいなくなったか。\n貴様たちが、どんなにがんばっても\nすでに世界の行く末は決まっている。", "face": "l3211f683040c"}, {"name": "暗黒騎士デシウス", "text": "いずれ世界は闇に包まれる。\n光では世界は救えぬ、本当に世界を救いたくば、\n闇の力を手に入れるしかないのだ。", "face": "l3211f683040c"}]}], "active": true}