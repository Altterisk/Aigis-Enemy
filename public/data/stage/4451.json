{"quest_id": 4451, "name": "雪山の共同戦線", "description": "吹雪の中で力を増したイエティと\n暗黒騎士団の波状攻撃を突破せよ！\n＜特定のタイミングで猛吹雪が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["特定のタイミングで猛吹雪が発生"], "event": "暗黒騎士団と聖夜の贈り物", "event_category": "History", "mission_id": 920057, "map_no": 3151, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 600, "base_hp": 2800, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097712, "master_id": 40, "global_id": 39, "spawn_sec": 20}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 22}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102704, "master_id": 393, "global_id": 392, "spawn_sec": 50}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "ass