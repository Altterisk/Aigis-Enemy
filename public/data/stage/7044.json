e": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31059, "global_id": 4678, "ranged": true, "spawn_sec": 99}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122480, "special_effect_id": 233, "change_to": 5, "change_condition": 1, "master_id": 32507, "global_id": 6126, "variants": [{"tags": ["アンデッド"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157}], "spawn_sec": 126}], "dialogue": [{"trigger": "start", "lines": [{"name": "エマ", "text": "――どうやらこの付近のようです。\nいびつな血の香りで気配が澱みきっています。", "face": "u582"}, {"name": "ヴィンセント", "text": "この先には洞窟があったはずだ。\nそこにさらった娘達を隠しているのかもしれないな。", "face": "u103"}, {"name": "エストリエ", "text": "城でなく洞窟に身を隠すなんて、\nお里が知れるというものね。\n早く助け出してあげましょ。", "face": "u791"}, {"name": "エマ", "text": "エストリエ、我ら血族の遠き子孫なら、\n油断と慢心は禁物ですよ。\nあちらを御覧なさい。", "face": "u582"}, {"name": "エデン", "text": "エストリエちゃん、\n向こうに真っ赤な狼みたいなのがいるよ？", "face": "u239"}, {"name": "エストリエ", "text": "な、なにあれ……。\nブラッドストーンと同じくらい濃い、\n血の香りがぷんぷん漂ってくるわ。", "face": "u791"}, {"name": "エマ", "text": "よく気付きました。\n――王子、奥に控えているのは血の使い魔、\nブラッドストーンの効果と同じ力を持つ者です。", "face": "u582"}, {"name": "ヒューナ", "text": "あいつの進路を塞いで確保しないと、\n矢も弾も当たらないってことね。", "face": "u627"}, {"name": "シルヴィア", "text": "そういうことですわ。\nさぁ王子様、ここを突破して、\n花嫁役の子たちを助けに行きますわよ！", "face": "u442"}]}, {"trigger": "end", "lines": [{"name": "ヒューナ", "text": "これで周囲の敵は片付いたかしら？", "face": "u627"}, {"name": "フーリ", "text": "血の使い魔の姿も見えませんね。\nあとはこの先の洞窟に向かうのみです！", "face": "u174"}, {"name": "ヴィンセント", "text": "ああ。新たな被害者が出る前に、\n一刻も早く乗り込むとしよう。", "face": "u103"}, {"name": "エデン", "text": "うんっ！　花嫁さんたちを助けにいこ！", "face": "u239"}, {"name": "アンナ", "text": "それでは王子、応急手当が終わり次第、\nこの先にあるという洞窟に突入しましょう！"}]}], "active": true}