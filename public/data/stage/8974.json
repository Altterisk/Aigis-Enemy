{"quest_id": 8974, "name": "水着を着たスライム", "description": "王子たちは水着を着たスライムを発見する。\n＜深海（弱）：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["深海（弱）：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "真夏のぷるぷるビーチ", "event_category": "Emergency", "mission_id": 200570, "map_no": 7448, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 6, 30], "ext": "攻撃待ち増加=30,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["スライム"], "hp": 40000, "attack": 420, "base_hp": 40000, "base_attack": 420, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 45, "attack_interval": 137, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171248, "special_effect_id": 242, "change_to": 1, "change_condition": 1, "missile_id": 1638, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 600, "attack_interval_f": 240, "effect_name": "HitEffectSlow"}}, "master_id": 40818, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 40000, "attack": 650, "base_hp": 40000, "base_attack": 650, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 40, "attack_speed": 1, "attack_wait": 72, "attack_interval": 199, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171264, "special_effect_id": 242, "missile_id": 1637, "missile": {"on_hit": {"kind": "攻撃遅延", "duration_f": 600, "attack_interval_f": 240, "effect_name": "HitEffectSlow"}}, "master_id": 40819, "ranged": true}]}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 1, "tags": ["スライム"], "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "physical",