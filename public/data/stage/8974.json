"attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112592, "missile_id": 11, "master_id": 30697, "global_id": 4316, "ranged": true, "spawn_sec": 156}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "tags": ["スライム"], "hp": 3300, "attack": 380, "base_hp": 3300, "base_attack": 380, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158496, "change_to": 8, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38491, "global_id": 12108, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 3300, "attack": 700, "base_hp": 3300, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158512, "master_id": 38492, "global_id": 12109}], "spawn_sec": 162}, {"enemy_id": 10, "source": "local", "count": 11, "form_count": 1, "tags": ["スライム"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100576, "master_id": 269, "global_id": 268, "spawn_sec": 236}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "tags": ["スライム"], "hp": 8500, "attack": 580, "base_hp": 8500, "base_attack": 580, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158528, "change_to": 11, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38493, "global_id": 12110, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 8500, "attack": 1050, "base_hp": 8500, "base_attack": 1050, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158544, "master_id": 38494, "global_id": 12111}], "spawn_sec": 255}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "tags": ["スライム"], "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "magical", "armor_defense": 2200, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112576, "missile_id": 11, "master_id": 30696, "global_id": 4315, "ranged": true, "spawn_sec": 278}], "popups": ["水着スライムから攻撃を受けると\n攻撃後の待ち時間が増加します。", "水着スライムは、\n拠点には向かわず\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。", "人型のスライムから\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\n\nブロックされている間は、\n攻撃に遅延効果が無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "クーコ", "text": "――スライムになった海の中って、こんな感じなのね。", "face": "u2837a1"}, {"name": "レミィ", "text": "ひんやりしてて、ぷるぷるで……。\n不謹慎かもだけど、ちょっと面白いわ。", "face": "u2837a1"}, {"name": "ホルミース", "text": "こうして得難い体験ができるのはいいですね。\n今日の事件を詩に書く際に、\nよりリアルな表現をすることができますから。", "face": "u2834a1"}, {"name": "ホルミース", "text": "あぁ……創作意欲が湧いてくる……。\n早くこの出来事を歌いたい……。", "face": "u2834a1"}, {"name": "ダグマール", "text": "さすがは元ディアス配下の人。\nなかなかにキマっていますね。", "face": "u2843a1"}, {"name": "ヘイズル", "text": "熱心な吟遊詩人もいいけど、\n今はもっと相手にすべき存在がいるよ。", "face": "u2836a1"}, {"name": "ハリンヘイム", "text": "ほら皆さん、あそこを見てください。", "face": "u2839a1"}, {"name": "水着スライム", "text": "ぷかぷか……。", "face": "l2f12797896ef"}, {"name": "ヴィディア", "text": "水着を着たスライムだ……。", "face": "u2841a1"}, {"name": "イムラウ", "text": "水着を着たスライムだね……。", "face": "u2842a1"}, {"name": "太上老君", "text": "探し人ならぬ探しスライムは見つかったようだね。\nとりあえず話しかけてみようか。", "face": "u2838a1"}, {"name": "ハリンヘイム", "text": "水着姿のスライムさん。\nあなたはここでなにをしているんですか？", "face": "u2839a1"}, {"name": "水着スライム", "text": "えっ……きゃあぁっ！？\nお、王国の人たちと、帝国の人たち……！？", "face": "l2f12797896ef"}, {"name": "水着スライム", "text": "なんで海底に……まさか、私を討伐しに来たの！？\nその、海をスライムにしちゃったし……！", "face": "l2f12797896ef"}, {"name": "アブグルント", "text": "どうやら悪いことをしたという自覚はあるみたいね。", "face": "u2840a1"}, {"name": "ハリンヘイム", "text": "えーと、いきなり倒したりするつもりはありませんから、\nまずは色々と話しを聞かせて――", "face": "u2839a1"}, {"name": "水着スライム", "text": "――しゅたっ！", "face": "l2f12797896ef"}, {"name": "レミィ", "text": "あっ、逃げたわよ！？", "face": "u2837a1"}, {"name": "ヴィラヘルム", "text": "説得できればよかったのですが、\nどうやら武力を行使するしかないようですね。", "face": "u2835a1"}, {"name": "水着スライム", "text": "なんだか怖いこと言ってるー！？\nた、助けてスライムー！！", "face": "l2f12797896ef"}, {"name": "太上老君", "text": "海の中からスライムが湧きだしてきたね。", "face": "u2838a1"}, {"name": "ヘイズル", "text": "まったく、君が威圧するからだよ。\nそのせいで水着スライムと\n敵対することになったじゃないか。", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "…………。", "face": "u2835a1"}, {"name": "ヘイズル", "text": "無言で私を睨まないでよ。", "face": "u2836a1"}, {"name": "ヴィディア", "text": "とにかく、スライムたちを倒して、\n水着スライムを追いかけるぞ！", "face": "u2841a1"}]}, {"trigger": "end", "lines": [{"name": "ヘイズル", "text": "――スライムたちは片付いたね。", "face": "u2836a1"}, {"name": "ハリンヘイム", "text": "肝心の水着スライムは逃がしてしまいましたが……。", "face": "u2839a1"}, {"name": "ヘイズル", "text": "まぁ、そう遠くには行っていないはずだ。\n探せばまた見つかると思うよ。", "face": "u2836a1"}, {"name": "ヘイズル", "text": "ところでだけど……。", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "…………。", "face": "u2835a1"}, {"name": "ヘイズル", "text": "君はいつまで拗ねてるんだい。", "face": "u2836a1"}, {"name": "クーコ", "text": "王子くんみたいに喋らなくなっちゃったわね。", "face": "u2837a1"}, {"name": "ヘイズル", "text": "はぁ……責めるようなことを言って悪かったよ。\nだから機嫌を直してくれないかな？", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "まったく、仕方がありませんね。\n別に全然拗ねたりなんてしていませんでしたが、\n謝られた以上はちゃんと許さなくては。", "face": "u2835a1"}, {"name": "ヘイズル", "text": "……今日はやけに陽気だね。\n夏の暑さにやられて、\n随分と浮かれているみたいじゃないか。", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "ふふっ、別にいいでしょう？\nあなたとの久々の夏休みなのですから。", "face": "u2835a1"}, {"name": "レミィ", "text": "ここのふたりって仲良いのね。", "face": "u2837a1"}, {"name": "クーコ", "text": "こんなに砕けた態度で接することができるんだから、\nそれだけ気心知れた関係なのね♪", "face": "u2837a1"}, {"name": "ヘイズル", "text": "……どうにもやり辛いな。\n私たちのことはいいから、\nさっさと水着スライムを追いかけるよ。", "face": "u2836a1"}, {"name": "ホルミース", "text": "えーと、初代騎士団長は照れ隠しするように、\n一行に声をかけて……。（メモメモ）", "face": "u2834a1"}, {"name": "ヘイズル", "text": "くだらないことを書かなくていいから！", "face": "u2836a1"}]}], "active": true}