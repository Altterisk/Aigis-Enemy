{"quest_id": 6139, "name": "万化の砂漠", "description": "強力な砂嵐が吹き荒れる未踏の地。\n謎多き未知の砂漠を調査せよ。\n＜出撃時の初期ＨＰ減少：小＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["出撃時の初期ＨＰ減少：小"], "event": "ゴールドラッシュ15(2017)", "event_category": "Reproduce", "mission_id": 300150, "map_no": 5454, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "level": 80, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098416, "race_id": 2, "master_id": 85, "global_id": 84, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 60, "attack_wait": 30, "attack_interval": 173, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098144, "master_id": 91, "global_id": 90, "spawn_sec": 51}, {"enemy_id": 3, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 133}], "popups": ["砂嵐が発生すると一部の道が\n塞がれ、その場に配置していた\nユニットは撤退します。\n撤退後は再出撃が可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アサル", "text": "――注意してください、この辺りは\n私達砂漠の民にとっても未踏の地、\n何があるか分かりません！", "face": "u172"}, {"name": "アンナ", "text": "砂塵で遠方がよく見えません……。", "face": "l9aa81a96d967"}, {"name": "ハシム", "text": "常に吹き荒れる砂嵐の影響で、\n今までこの先へはとても進めなかったが。\n先日、その砂嵐が弱まりを見せてな。", "face": "u170"}, {"name": "ベティ", "text": "それで足を踏み入る事が出来たって訳ね。\n人類未踏の地……何があるか興味深いな。", "face": "u35"}, {"name": "アサル", "text": "他の砂漠の民がいるのであれば、\nぜひ交流を取っていきたいものです。\n……あれは！　", "face": "u172"}, {"name": "ハシム", "text": "どうやら敵のお出ましのようだな。", "face": "u170"}, {"name": "アサル", "text": "王子、遠くに強力な砂嵐も見えます。\n通りやすそうな道を選び進んできましたが、\n砂嵐が来れば道はかき消えてしまいますのでご注意を。", "face": "u172"}, {"name": "ハシム", "text": "砂に埋もれてしまえば、命はないと思ったほうが良い。\n砂嵐が来た際には、速やかに後退する様、\n兵に伝えておくぞ、王子。", "face": "u170"}]}, {"trigger": "end", "lines": [{"name": "アサル", "text": "――なんとかやり過ごせたようです。", "face": "u172"}, {"name": "ハシム", "text": "だが、道が途絶えてしまったようだ。\nそれにこの風、遠くない内に\n一層強力な砂嵐に見舞われるだろう。", "face": "u170"}, {"name": "ベティ", "text": "……残念だけど、この地を調べるのは\nまた今度にした方が良さそうだな。", "face": "u35"}, {"name": "アンナ", "text": "その方が良さそうですね。\nここは一度戻りましょうか。アサルさん、\nすみませんがまた道案内を……アサルさん？", "face": "l4132eb27a3aa"}, {"name": "アサル", "text": "…………。", "face": "u172"}, {"name": "アンナ", "text": "……アサルさん、どうかしましたか？", "face": "l4132eb27a3aa"}, {"name": "アサル", "text": "あ、いえ……砂嵐が止んだ際、\n遠くに動物の巨像のようなものが\n見えた気がして。少し気になって……。", "face": "u172"}, {"name": "アンナ", "text": "動物の像、ですか……？", "face": "l4132eb27a3aa"}, {"name": "アサル", "text": "いえ、気にしないでください！\n見間違いかもしれませんので！", "face": "u172"}, {"name": "ベティ", "text": "人類未踏の地に謎の像……\nなんだかロマンがある話だな。", "face": "u35"}, {"name": "アンナ", "text": "そうですね。次にここを調べる際には、\n何か新しい発見があると期待しましょう。"}, {"name": "アサル", "text": "そうですね……と、いけません。\n砂嵐が来る前に帰還致しましょうか。\nどうぞこちらへ、ご案内いたします！", "face": "u172"}]}], "map": {"image": "Map5454", "w": 960, "h": 640, "spots": [{"k": "b", "x": 539, "y": -2}, {"k": "m", "x": 487, "y": 163, "id": 200}, {"k": "m", "x": 247, "y": 235, "id": 201}, {"k": "m", "x": 427, "y": 267, "id": 202}, {"k": "m", "x": 557, "y": 232, "id": 203}, 