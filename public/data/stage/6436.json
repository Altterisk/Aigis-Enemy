.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114320, "race_id": 16, "special_effect_id": 222, "missile_id": 271, "missile": {"splash": 80}, "master_id": 30968, "global_id": 4587, "ranged": true, "spawn_sec": 111}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 5, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 116}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "テンマ", "text": "かたじけない。我が修行の為に、\nこれほど多くの者が集まってくれるとは……。", "face": "u564"}, {"name": "コヨミ", "text": "んもぅ、水臭いわねぇ。\n気にしないでいいのよ、同じ国のよしみじゃない。", "face": "u471"}, {"name": "コノハ", "text": "うむ。それに我らが東の国は今、\n華の国の邪仙や一部の妖怪たちから\n民を守るための戦力を欲している。", "face": "u440"}, {"name": "コノハ", "text": "テンマ、我らには必要なのだ。\n堅牢な鎧に守られた敵を弱体化させる、其方の力が。", "face": "u440"}, {"name": "テンマ", "text": "――承知。\n此度の恩は、我が剣技の更なる冴えと、\n戦場を駆ける『甲破り』の斬撃を以て返すとしよう。", "face": "u564"}, {"name": "イナリ", "text": "『カブトヤブリ』って、テンマの武器のことなんだよね。\nカッコイイよねぇ～。", "face": "u243"}, {"name": "コヨミ", "text": "でも、お礼なら王子たちに言った方がいいわ。\nもうすぐ来る頃だと思うから。", "face": "u471"}, {"name": "テンマ", "text": "ああ、ありがたい話だ。\n遠征から帰る折だったというのに、\n修行のことを伝えたらすぐ協力しに来てくれるとはな。", "face": "u564"}, {"name": "テンマ", "text": "……しかし、これはあくまで修行。\n我が剣技を、さらなる境地へ昇華せんとするならば、\n馴れ合いなど言語道断、必殺の剣技を以て切り結ばねば。", "face": "u564"}, {"name": "テンマ", "text": "何より手加減などしては、\n王子たちの厚意を無駄にしてしまうからな。", "face": "u564"}, {"name": "イナリ", "text": "――あ。来た来た、王子たちだ。おーい！", "face": "u243"}, {"name": "アンナ", "text": "こんにちは、イナリさん。\n模擬戦の場所はこちらで合っていますか？"}, {"name": "テンマ", "text": "そうだ。\n王子、今日は宜しく頼むぞ。", "face": "u564"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "テンマ", "text": "いつでも来い、か。\nふふ……然らば、全力で行かせてもらおう！", "face": "u564"}, {"name": "テンマ", "text": "――甲破り砲撃戦モード、抜剣ッ！！", "face": "u564"}]}, {"trigger": "end", "lines": [{"name": "テンマ", "text": "……うむ、実に良き戦いだった。", "face": "u564"}, {"name": "テンマ", "text": "此度の修行を通じて、\n私はまたひとつ、己を覆う迷いの霧を斬り拓き、\n失っていた何かを取り戻したように思える。", "face": "u564"}, {"name": "アンナ", "text": "ふふ、どういたしまして。\n手応えを得られたようでなによりです。"}, {"name": "コノハ", "text": "今後も期待しているぞ、テンマ。", "face": "u440"}, {"name": "テンマ", "text": "ああ、任せてほしい。\nかねてより修練を重ねていた奥義も\nじきに実戦で披露できる日が来るだろう。", "face": "u564"}, {"name": "イナリ", "text": "え、奥義？\nなにそれ、見たい見たーい！", "face": "u243"}, {"name": "テンマ", "text": "こらこら、腕にぶら下がるな。\n物事には相応しき時というものがあるのだぞ。", "face": "u564"}, {"name": "テンマ", "text": "（……と、そういえばまだ技の名を決めていなかったな。\nうむ、今から奥義に相応しい名を考えておくとしよう）", "face": "u564"}]}], "story_talk": true, "active": true}