{"quest_id": 6436, "name": "テンマの武者修行", "description": "更なる力を求めんと、テンマから\n修行の申し出。全力の戦いを通じ、\n必殺の剣技に磨きをかけよ！\n上級（★１獲得の目安：平均Lv10）", "event": "アルケミスト・ドクトリン", "event_category": "History", "mission_id": 920107, "map_no": 5322, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "tags": ["サムライ"], "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100464, "race_id": 16, "master_id": 246, "global_id": 245, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 9, "form_count": 1, "tags": ["サムライ"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099952, "race_id": 16, "master_id": 207, "global_id": 206, "spawn_sec": 11}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 230, "attack_speed": 60, "attack_wait": 23, "attack_interval": 89, "move_speed": 900.