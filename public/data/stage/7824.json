: 137000, "attack": 4000, "base_hp": 137000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 30, "attack_interval": 172, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2141776, "race_id": 8, "change_to": 11, "change_condition": 3, "master_id": 35731, "global_id": 9348, "variants": [{"hp": 137000, "attack": 4000, "base_hp": 137000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 160, "attack_interval": 449, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2141824, "race_id": 8, "master_id": 35734, "global_id": 9351}], "to_condition": 3, "to_global_id": 9349, "sp_change_to": [35734], "route_behaviour": {"transforms": [{"to": 35734}]}, "spawn_sec": 148}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 137000, "attack": 1800, "base_hp": 137000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 500, "attack_range": 220, "attack_speed": 20, "attack_wait": 30, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2141792, "race_id": 8, "special_effect_id": 232, "change_to": 12, "change_condition": 4, "missile_id": 476, "master_id": 35732, "global_id": 9349, "ranged": true, "from_condition": 3, "to_condition": 4, "to_ticks": 1, "to_global_id": 9350}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 137000, "attack": 4000, "base_hp": 137000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 109, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2141808, "race_id": 8, "master_id": 35733, "global_id": 9350, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 15, "source": "local", "count": 4, "form_count": 1, "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105088, "race_id": 8, "special_effect_id": 252, "master_id": 30918, "global_id": 4537, "spawn_sec": 150}], "popups": ["巨躯のオーク勇者が登場する際に\nNPCのリノが生存していると、\n巨躯のオーク勇者が弱体化し\n動きが鈍くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "巨躯のオーク", "text": "――勇者殿！　敵です！\n王国軍が侵攻してきました！", "face": "l44436316ebf0"}, {"name": "巨躯のオーク勇者", "text": "ほほう、こちらから出向く手間が省けたわ。\nして、あちらの兵に名高き者はおるのか。", "face": "l93b740a72803"}, {"name": "巨躯のオーク", "text": "はっ、かの王子を始め、\nサラマンダーを従える召喚士、リノ嬢の姿も……。", "face": "l44436316ebf0"}, {"name": "巨躯のオーク勇者", "text": "グワッハッハッハ！　おぉ、それは重畳！\n召喚士とはぜひとも戦ってみたかったのだ！", "face": "l93b740a72803"}, {"name": "巨躯のオーク", "text": "はっ……しかし、あの名高いリノ嬢が、\n今はアイドルなどという軟弱なものに――", "face": "l44436316ebf0"}, {"name": "巨躯のオーク勇者", "text": "あいどる、とな……。\n気高き戦士が偶像如きにうつつを抜かすとは……。", "face": "l93b740a72803"}, {"name": "巨躯のオーク勇者", "text": "我らが、真の戦いというものを教えてやるぞ！\n全軍、王国軍を迎え撃てぇ！！", "face": "l93b740a72803"}, {"name": "リノ", "text": "――のんのん♪\nコワイ顔してちゃだめだぞ♪", "face": "u1683a1"}, {"name": "巨躯のオーク勇者", "text": "なっ、なに？", "face": "l93b740a72803"}, {"name": "リノ", "text": "千年先まで、輝く未来を！\nみんな、リノについてきてー！！", "face": "u1683a1"}]}, {"trigger": "end", "lines": [{"name": "巨躯のオーク勇者", "text": "これが……アイドル……歌……か……。", "face": "l93b740a72803"}, {"name": "リノ", "text": "リノの歌、届いたかな……？", "face": "u1683a1"}, {"name": "巨躯のオーク勇者", "text": "届いたとも……。\nくっ……なんだ、この感情の正体は……。", "face": "l93b740a72803"}, {"name": "巨躯のオーク勇者", "text": "恋でも、愛でもない……。\n戦場で好敵手に向けるそれでもない……。\nこの、ふわふわドキドキの感情は……。", "face": "l93b740a72803"}, {"name": "ミヤビ", "text": "どうやら、ファンになっちゃったみたいですね！", "face": "u496"}, {"name": "巨躯のオーク勇者", "text": "ふぁ、ん……？\nそうか、リノ嬢のファンになったのか、俺は……！", "face": "l93b740a72803"}, {"name": "巨躯のオーク勇者", "text": "強敵との戦いにも劣らぬ、\nなんと美しく、心踊る歌……！", "face": "l93b740a72803"}, {"name": "巨躯のオーク勇者", "text": "これが！　文化……ッ！！", "face": "l93b740a72803"}, {"name": "リノ", "text": "えへへ、ライブ大成功だね！！", "face": "u1683a1"}, {"name": "巨躯のオーク", "text": "くぅぅ、しかし、もっと聴きたい……。\nいったいどうすれば……。", "face": "l44436316ebf0"}, {"name": "ミヤビ", "text": "そういう時は、アンコールするんですよ。\nさぁ皆さんご一緒に♪", "face": "u496"}, {"name": "巨躯のオーク勇者", "text": "うぉぉぉぉアンコール！　アンコール！！", "face": "l93b740a72803"}]}, {"trigger": "end", "lines": [{"name": "リノ", "text": "（リノ、やったよ！\nリノもアイドルになれたよ！）", "face": "u1683a1"}, {"name": "リノ", "text": "（もっともっと輝きたい。\n伝説のアイドル、アンナさんみたいに！）", "face": "u1683a1"}, {"name": "リノ", "text": "みんな、アンコールありがとー！\n最後にもう一曲行くよ！\n千年先まで、リノと一緒についてきてー！", "face": "u1683a1"}]}, {"trigger": "route", "lines": [{"name": "巨躯のオーク勇者", "text": "――何だ、これは、この感情は！", "face": "l93b740a72803"}, {"name": "リノ", "text": "～～～～♪", "face": "u1683a1"}, {"name": "巨躯のオーク勇者", "text": "はっ……リノ嬢と目があって……くぅぅぅ！\nくそっ、戦士の誇り！　我が修行の日々を思い出せ！", "face": "l93b740a72803"}, {"name": "ミヤビ", "text": "――大好きになっちゃった人と戦うなんて、\nいくら強い戦士でもできないんですよ。", "face": "u496"}, {"name": "ケイティ", "text": "どうやら、歌に感動しすぎて、\n戦闘に集中できなくなっているようですね。\n兵たちに伝達！　彼らの武器を叩き落とすのは今です！", "face": "u114"}, {"name": "ミヤビ", "text": "リノさん、巨躯のオークたちにも、\nあなたの歌は届いています！\nこのまま、ゲリラライブを成功させちゃいましょう！", "face": "u496"}]}], "active": true}