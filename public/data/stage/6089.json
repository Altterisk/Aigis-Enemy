_resist": 1000, "transform_resist": 1000, "pattern_id": 2102240, "race_id": 8, "master_id": 367, "global_id": 366, "from_condition": 3}, {"enemy_id": 8, "source": "local", "count": 13, "form_count": 2, "hp": 3150, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102544, "race_id": 8, "change_to": 8, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 377, "global_id": 376, "ranged": true, "to_condition": 3, "to_global_id": 377, "spawn_sec": 1}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3150, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 378, "global_id": 377, "ranged": true, "from_condition": 3}, {"enemy_id": 10, "source": "local", "count": 8, "form_count": 2, "hp": 18900, "attack": 840, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102672, "race_id": 8, "change_to": 10, "change_condition": 3, "master_id": 385, "global_id": 384, "to_condition": 3, "to_global_id": 385, "spawn_sec": 1}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18900, "attack": 1680, "base_hp": 18000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 700, "attack_speed": 20, "attack_wait": 15, "attack_interval": 116, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "master_id": 386, "global_id": 385, "from_condition": 3}, {"enemy_id": 12, "source": "local", "count": 7, "form_count": 1, "hp": 1050, "attack": 158, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 23}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 2, "hp": 10500, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103376, "race_id": 8, "change_to": 13, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 442, "global_id": 441, "ranged": true, "to_condition": 3, "to_global_id": 442, "spawn_sec": 201}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10500, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 443, "global_id": 442, "ranged": true, "from_condition": 3}], "popups": ["NPCのベストラは倒されても\n★の評価には影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アナトリア", "text": "懲りないねぇ。何度戦っても、\nあんたじゃあたしには勝てないよ。\nそれでもやるのかい？", "face": "u522"}, {"name": "ベストラ", "text": "もちろんです、アナトリア。\n今度こそ、絶対に\nあなたに勝ってみせます！", "face": "u1474"}, {"name": "オーク", "text": "またベストラがアナトリアに挑戦してるのか。\nこりゃ面白そうだ。\nちょっと見ていくか。", "face": "lf344a4d6a0a1"}, {"name": "モモ", "text": "頑張って、ベストラ！　\nベストラなら絶対勝てるよ！", "face": "u1249"}, {"name": "ケイティ", "text": "私達に出来る事は彼女の勝利を信じ、\n見守る事のみですね。", "face": "u114"}, {"name": "オーク", "text": "……む、あれは王子か？\nこれは幸運だ。我々も\n熱き戦いに興じようではないか！", "face": "lf344a4d6a0a1"}, {"name": "ダン", "text": "お、おい、オークの連中\nこっちに向かって来てやがるぞ！", "face": "u204"}, {"name": "アンナ", "text": "見守るだけでも一苦労ですね。\n王子、戦闘のご準備を！", "face": "lcbb2e88ecc7a"}, {"name": "アナトリア", "text": "……なんだか周りも楽しそうだねぇ。\nそれじゃ、こっちも始めるとするかね。\n行くよ！", "face": "u522"}]}, {"trigger": "start", "lines": [{"name": "ベストラ", "text": "くっ………やっぱり強い……。\nたった一撃受けただけでこの衝撃……。", "face": "u1474"}, {"name": "アナトリア", "text": "少しはやるようになったみたいだね。\nでもまだまだだよ、その程度じゃ\nあたしは全然本気は出せないね！", "face": "u522"}, {"name": "ベストラ", "text": "くそ、やっぱり勝てないか……。\nでも、でも……最後まで、\n最後まで戦うんだ！", "face": "u1474"}, {"name": "モモ", "text": "王子、アンナさん！\nこのままじゃベストラ死んじゃうよ！", "face": "u1249"}, {"name": "ダン", "text": "……けどよ、手助けしたって\nベストラは喜ばないと思うぜ。いざって時は\nすぐに助けにいけるように準備しておこう。", "face": "u204"}, {"name": "アンナ", "text": "はい。ベストラさん……どうか\n心行くまで戦ってください……！\nもし倒れても、すぐ私達が救助しますので！！"}]}, {"trigger": "end", "lines": [{"name": "アナトリア", "text": "ぐッ！　……やるじゃないか。\n今のは良い一撃だったよ。けどまぁ、\n今回はこの辺で終いと行こうかね。", "face": "u522"}, {"name": "ベストラ", "text": "ま……まだ勝負はついて……ません……！", "face": "u1474"}, {"name": "アナトリア", "text": "負けず嫌いも程々にしな、\nそれ以上やったらほんとに死んじまうよ。\nあんた達、さっさとこいつを運ぶ用意をしてやんな！", "face": "u522"}, {"name": "アンナ", "text": "……！　は、はい！\n皆さん、救護の用意を！", "face": "lcbb2e88ecc7a"}, {"name": "ベストラ", "text": "くっ…………やはり……私ではオークの\n頂点になど立てないのでしょうか……\n……怒りの力も完全に使えない私などでは……。", "face": "u1474"}, {"name": "アナトリア", "text": "はん、そんな事あたしは知らないよ。怒りだの\nなんだの、そんなもん意識した事一度もないからね。\nでもま、確かにオークは持ってて当たり前なのかもねぇ。", "face": "u522"}, {"name": "ベストラ", "text": "…………。", "face": "u1474"}, {"name": "アナトリア", "text": "けど、そんなガタガタした御託や理屈なんて\nどうでも良いだろう。オークにとっては強さが全てだ。\n強さこそが正義だ。", "face": "u522"}, {"name": "アナトリア", "text": "久々に良い戦いが出来て楽しかった。\nあんたは強い、胸を張んな。", "face": "u522"}, {"name": "ベストラ", "text": "…………！　", "face": "u1474"}, {"name": "アナトリア", "text": "またいつでも挑戦してきな、\n最優先で受けて立ってやるよ。\n……まぁ勝つのはあたしだけどね。", "face": "u522"}, {"name": "ベストラ", "text": "は……はい！　いつか、いつかあなたを\n超える日まで頑張りますので！！　\nまた、よろしくお願いします！！", "face": "u1474"}, {"name": "アンナ", "text": "ベストラさん、何やら吹っ切れた様子ですね。\n悩みが解決できたようで何よりです。\nきっと今後も心強い力となってくれるでしょう。"}, {"name": "アンナ", "text": "王子も皆さんの特訓に付き合って\nさぞお疲れのことでしょう。ゆっくりと\n休まれてくださいね。お疲れ様でした。"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "アナトリア", "text": "いい感じだが、まだまだ力を使いこなせていない\nみたいだね……お前はそこで少し休んでな。", "face": "u522"}, {"name": "アナトリア", "text": "折角面白そうな相手もいることだ、\nオークの戦い方の手本、見ておくといい。", "face": "u522"}]}], "active": true}