d": 34093, "global_id": 7710}], "spawn_sec": 57}, {"enemy_id": 20, "source": "local", "count": 9, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098576, "race_id": 2, "master_id": 147, "global_id": 146, "spawn_sec": 58}, {"enemy_id": 21, "source": "local", "count": 13, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 90, "attack_interval": 222, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132944, "race_id": 2, "change_to": 21, "master_id": 34563, "global_id": 8180, "to_global_id": 8181, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 60}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_range": 180, "attack_speed": 1, "attack_wait": 90, "attack_interval": 221, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132944, "race_id": 2, "change_to": 20, "missile_id": 667, "missile": {"speed": 6.0}, "master_id": 34564, "global_id": 8181, "ranged": true}, {"enemy_id": 23, "source": "local", "count": 4, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098640, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 151, "global_id": 150, "ranged": true, "spawn_sec": 73}, {"enemy_id": 24, "source": "local", "count": 28, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 90}, {"enemy_id": 25, "source": "local", "count": 16, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 26, "global_id": 25, "spawn_sec": 94}, {"enemy_id": 26, "source": "local", "count": 8, "form_count": 1, "hp": 3200, "attack": 220, "base_hp": 3200, "base_attack": 220, "damage_type": "physical", "armor_defense": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 162, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 1, "spawn_sec": 109}], "popups": ["ソラスは長射程の\n遠距離攻撃を行います。\nまたHPが50％以下になると、\n攻撃対象が3体に増加します。", "トラムは一定時間が経過するたびに\n攻撃、防御がアップします。\n※最大で３倍までアップ\n\nまた、トラムは倒されると\nその場で復活します。\n２回まで復活し、２回目の復活後、\nHPがアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ソラス", "text": "――大人気でしたね、ホルテウス。\n何というのか、教団――いえ、ファンクラブですか？", "face": "u904"}, {"name": "ホルテウス", "text": "やれやれ、そういう\nソラスも疲れ切っているではないか。", "face": "u1373a1"}, {"name": "ソラス", "text": "あはは……自分でも忘れていたような、\n古い伝承を持ち出されて、\n昔話をするハメになっちゃいまして……。", "face": "u904"}, {"name": "トラム", "text": "竜人の、それも隠れ里となれば、\n古い伝承が、かつての形のまま残っていそうだものね。", "face": "u1110a1"}, {"name": "ホルテウス", "text": "ああ、それで他の連中も、\n握手会に手合わせに、伝承の講演会にと\n引っ張りだこになっていたのか……。", "face": "u1373a1"}, {"name": "トラム", "text": "その点、私は立場上\nあまり名乗らないようにしていましたし、\nそういう心配はないのですけどね。", "face": "u1110a1"}, {"name": "ホルテウス", "text": "神の名を物質界に残しすぎるのもよくない、\nと言っていたな、そういえば。", "face": "u1373a1"}, {"name": "ソラス", "text": "……あの、でも手遅れみたいですよ？\nほら、あの子たち、トラムを見ていますし。", "face": "u904"}, {"name": "訳知り竜人", "text": "おぉ、おぉ……こんなことがあっていいのか……。\n輝ける陽光の如き御髪、清浄なる銀の腕、\nあの御方は、嗚呼、嗚呼……！！", "face": "l734e530db973"}, {"name": "竜人の若者", "text": "どうしたッテんだよ！\n早く教えろヨ！！", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "我ら竜人の姫君、アーニャ様に、\n自らの輝剣を授けられた、\n偉大なる女神、銀の腕、我らが守護神トラム様ですぞ！", "face": "l734e530db973"}, {"name": "竜人の若者", "text": "はっ、えっ、トラム様ッテ実在したノカ！？\n女神トラム様ガァァァッ！？", "face": "lde256fd621cb"}, {"name": "ソラス", "text": "……ああ、トラムの剣は、\n竜人に授けていったのでしたね。", "face": "u904"}, {"name": "ホルテウス", "text": "なるほど、ゆえに今や信仰対象、と。\nトラム、何がそういう心配はない、なんだ？", "face": "u1373a1"}, {"name": "トラム", "text": "わ、わわ……えっと、えぇ……っ？\nどうしたらいいの！？", "face": "u1110a1"}, {"name": "ホルテウス", "text": "王国式に考えるなら、\n信者相手にファンサービス、というところか。", "face": "u1373a1"}, {"name": "ソラス", "text": "血気盛んな竜人たちですから、\n模擬戦の相手なんてしてあげてはどうでしょう？", "face": "u904"}, {"name": "訳知り竜人", "text": "ナニィ！？　トラム様が、女神トラム様がぁっ！\n我らと手合わせ、て、ててて、手合わせをぉ！？", "face": "l734e530db973"}, {"name": "兵士", "text": "何っ、トラム様との手合わせは\n我々王国軍兵士の方が先に――", "face": "u65"}, {"name": "竜人", "text": "我らの女神ダゾ！　我らが先に――", "face": "u95"}, {"name": "トラム", "text": "はぁ……。\nこらっ！　喧嘩は禁止！！", "face": "u1110a1"}, {"name": "トラム", "text": "私はそんな、偉大な女神ではないわ。\nただ物質界と共にあることを選んだだけなの。", "face": "u1110a1"}, {"name": "トラム", "text": "でも、皆が喜んでくれるなら、\n手合わせのひとつやふたつ、\n全員まとめて相手してあげるわね！", "face": "u1110a1"}, {"name": "ホルテウス", "text": "うむ、これぞファンサだ。\n先程学んだばかりの概念だがな。", "face": "u1373a1"}, {"name": "トラム", "text": "ホルテウスも、なに腕組みして見守ってるの？\nもちろんあなたたちも手合わせに参加するのよ？", "face": "u1110a1"}, {"name": "ソラス", "text": "えっ、わ、私もですか？\n今日はちょっと疲れちゃって――きゃぁっ！？", "face": "u904"}, {"name": "トラム", "text": "我が名は銀腕、亜神トラム！\n腕に覚えある強者たちよ、\n己の誇りと名誉にかけて、剣をとるがいい！", "face": "u1110a1"}, {"name": "ソラス", "text": "あー、もうっ、巻き込まれちゃいましたぁ！\nこうなったら本気で行きますよぉ！？", "face": "u904"}]}, {"trigger": "end", "lines": [{"name": "アクラ", "text": "――これが、英傑の力。\nいやはや、鬼刃姫様は\n大変な軍で戦っているのですね。", "face": "u1454a1"}, {"name": "鬼刃姫", "text": "……王国軍は化け物揃いだよ？\nアクラも今後はその一員になるんだけどね。", "face": "u435"}, {"name": "アクラ", "text": "おや、契約更新ありがとうございます？", "face": "u1454a1"}, {"name": "鬼刃姫", "text": "アクラ強すぎるから、傭兵業してても\n料金高すぎて中々雇ってもらえないって言ってたでしょ。\nその点、王国ならずーっと雇ってもらえるかなって。", "face": "u435"}, {"name": "アクラ", "text": "このアクラ、マブダチの優しさに泣いてしまいそうです。\nうぅ、ぐすぐす、うぇーん。", "face": "u1454a1"}, {"name": "鬼刃姫", "text": "うそなき禁止！\nそれと、マブダチっていうの恥ずかしいってば！", "face": "u435"}, {"name": "アクラ", "text": "ふふふ、バレましたか。\nところで鬼刃姫様、あちらで\n竜人が、気持ちよく空に打ち上げられていますが……。", "face": "u1454a1"}, {"name": "鬼刃姫", "text": "……トラムが打ち上げて、ソラスが撃ち落として、\nホルテウスのスフィンクスがお手玉してる……？", "face": "u435"}, {"name": "鬼刃姫", "text": "ま、まぁ、本人たちが楽しそうなら、\nこれも良いんじゃないかなぁ？", "face": "u435"}, {"name": "トラム", "text": "さぁ次は誰？\nリアファルの咆哮を聴かせてあげる！", "face": "u1110a1"}, {"name": "訳知り竜人", "text": "うぉぉぉっ、滞空時間更新！\nもうひと勝負お願いしマスぞー！！", "face": "l734e530db973"}, {"name": "ソラス", "text": "……良いんでしょうか、これで。", "face": "u904"}, {"name": "ホルテウス", "text": "ははっ、景気が良いじゃないか。\nスフィンクス、もっと高い高いしてやるがいい！", "face": "u1373a1"}]}], "active": true}