{"quest_id": 7574, "name": "古き伝承の英傑たち", "description": "パレードが続く中、竜人たちの視線は古い\n伝承に残る英傑に向かって……？　トラム、\nソラス、ホルテウスから勝利を勝ち取れ！\n神級（★１獲得の目安：平均Lv50）", "event": "人気闘兵凱旋パレード", "event_category": "History", "mission_id": 920174, "map_no": 4497, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 30000, "attack": 600, "base_hp": 30000, "base_attack": 600, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_range": 400, "attack_speed": 1, "attack_wait": 30, "attack_interval": 193, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120288, "special_effect_id": 229, "change_to": 1, "change_condition": 3, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 33110, "global_id": 6727, "ranged": true, "to_condition": 3, "to_global_id": 6728}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 600, "base_hp": 30000, "base_attack": 600, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_range": 400, "attack_speed": 1, "attack_wait": 30, "attack_interval": 193, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120288, "special_effect_id": 427, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 33111, "global_id": 6728, "ranged": true, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 32000, "attack": 750, "base_hp": 32000, "base_attack": 750, "damage_type": "magical", "armor_defense": 400, "magic_defense": 10, "attack_range": 280, "attack_speed": 1, "attack_wait": 60, "attack_interval": 173, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2131296, "race_id": 16, "missile_id": 620, "missile": {"speed": 8.0, "splash": 80}, "master_id": 34732, "glob