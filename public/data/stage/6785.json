{"quest_id": 6785, "name": "糸の値打ちと赤字冒険者", "description": "糸の出処と思われる迷宮に辿り着いた\n王子一行を、先客が出迎える。\n冒険者との争奪戦に勝利せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "赤き盗賊の花嫁", "event_category": "History", "mission_id": 920129, "map_no": 3361, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 1500, "attack": 500, "base_hp": 1500, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "special_effect_id": 130, "master_id": 31767, "global_id": 5386, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 368, "base_hp": 3000, "base_attack": 368, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 20016, "global_id": 1091, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 2000, "attack": 113, "base_hp": 2000, "base_attack": 113, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 20017, "global_id": 1092, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 11, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 3}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 13}, {"enemy_id": 6, "source": "local", "count": 9, "form_count": 1, "tags": ["スライム"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100576, "master_id": 269, "global_id": 268, "spawn_sec": 24}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 24}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 600, "base_hp": 5000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097808, "special_effect_id": 130, "master_id": 31768, "global_id": 5387, "spawn_sec": 50}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 60}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100624, "race_id": 18, "special_effect_id": 220, "master_id": 272, "global_id": 271, "spawn_sec": 66}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 322, "global_id": 321, "ranged": true, "spawn_sec": 86}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "tags": ["スライム"], "hp": 1600, "attack": 300, "base_hp": 1600, "base_attack": 300, "damage_type": "magical", "armor_defense": 1600, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097296, "master_id": 22, "global_id": 21, "spawn_sec": 118}], "dialogue": [{"trigger": "start", "lines": [{"name": "ポーラ", "text": "――倒された魔物に、空のポーション瓶。\nどうやら迷宮には、すでに先客がいるですね。", "face": "u253"}, {"name": "シャディア", "text": "まさか魔王軍の手の者が既に……？\nいや、だが魔王軍の者がポーションなど……。", "face": "u713"}, {"name": "ポーラ", "text": "こんなにポーションがぶ飲みするのは、\nパーティにヒーラーがいない証拠。\n先客はあの金欠冒険者達に間違いないのです。", "face": "u253"}, {"name": "冒険者", "text": "――誰が金欠だ誰が！！", "face": "lda348573d792"}, {"name": "ポーラ", "text": "ほら金欠冒険者です。\n――でも、ヒーラーがいなくても生き延びる程の、\n腕利きの彼らがここに来ているということは……。", "face": "u253"}, {"name": "ベルナ", "text": "『祝福の魔力糸』は、やっぱりここが\n出処で間違いなさそうってことだね。", "face": "u46"}, {"name": "冒険者", "text": "何だ、お前達も例の高級そうな魔法の糸を\nここに探しに来たってことか。", "face": "lda348573d792"}, {"name": "冒険者", "text": "だが、俺達も生活がかかっている。\nあの糸は仕立て屋に高く売れるに違いないんだ。\nはいどうぞと道を譲るわけにはいかない。", "face": "lda348573d792"}, {"name": "ベルナ", "text": "『祝福の魔力糸』はそんなお宝みたいな\n簡単なものじゃないんだよ？\n何しろ魔王軍もその糸を狙ってて――", "face": "u46"}, {"name": "冒険者", "text": "だが！　高く！　売れる！　そうだろう！？\n済まないが先に行かせるわけにはいかない！\n俺達のポーション代のため、ここで倒させてもらう！", "face": "lda348573d792"}, {"name": "シャディア", "text": "交渉をする気が全く無いな！\n仕方ない、王子、連中を迎撃しよう。", "face": "u713"}, {"name": "アンナ", "text": "王子、冒険者と魔物を同時に相手にする上、\n糸を持った魔物も紛れているはずです。\n十分に注意するようにお願いします！", "face": "l709026bf7534"}]}, {"trigger": "end", "lines": [{"name": "冒険者", "text": "……くっ、また赤字か。", "face": "lda348573d792"}, {"name": "ベルナ", "text": "ねぇねぇ、糸を持ってたみたいだけど、\nそれは何処から取ってきたのかな？", "face": "u46"}, {"name": "冒険者", "text": "糸を持った魔物を倒して奪っただけだ。\nおかげでポーションをかなり消費したがな。", "face": "lda348573d792"}, {"name": "ベルナ", "text": "本当に？　糸の在り処、実は知ってたりしない？\n嘘を吐くと、この怖ーいシャ――", "face": "u46"}, {"name": "シャディア", "text": "――怖いポーラ嬢が何をするか分からないぞ。", "face": "u713"}, {"name": "冒険者", "text": "ほ、本当だ！\n俺達もさっきここへ来たばかりなんだ！", "face": "lda348573d792"}, {"name": "ポーラ", "text": "じぃぃ……。", "face": "u253"}, {"name": "冒険者", "text": "ひぃっ！？　お、おおよその見当はついている！\n糸を持った魔物はあっちの方向から出てくる！\n糸の隠し場所は向こうで間違いないはずだ！！", "face": "lda348573d792"}, {"name": "ベルナ", "text": "……嘘じゃなさそう、かな。\n教えてくれてありがとね。\n王子、急いで奥を目指そう！", "face": "u46"}, {"name": "ポーラ", "text": "――あっ、怖がらせたお詫びです。\n傷くらい癒やしてあげるですよ。", "face": "u253"}, {"name": "冒険者", "text": "……い、いいのか？", "face": "lda348573d792"}, {"name": "ポーラ", "text": "困った時はお互い様です。\nでも、そろそろ腕のいいヒーラーを雇うですよ？", "face": "u253"}, {"name": "冒険者", "text": "ふん、俺達はポーションで十分なんだよ。\nだが、礼は言っておく。", "face": "lda348573d792"}, {"name": "ポーラ", "text": "まったく、素直じゃないです。", "face": "u253"}]}], "active": true}