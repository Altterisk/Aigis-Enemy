1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 209}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 1, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 60, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "spawn_sec": 240}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 2, "hp": 2000, "attack": 1500, "base_hp": 2000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 250, "magic_defense": 40, "attack_range": 160, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099504, "race_id": 4, "change_to": 8, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 106, "global_id": 105, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 106, "spawn_sec": 253}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 60, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "tags": ["式神"], "hp": 3600, "attack": 300, "base_hp": 3600, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 5, "attack_range": 180, "attack_speed": 70, "attack_wait": 80, "attack_interval": 215, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2166592, "race_id": 4, "special_effect_id": 2280, "missile_id": 1457, "missile": {"speed": 6.0, "splash": 107}, "master_id": 39545, "global_id": 13162, "ranged": true, "spawn_sec": 276}], "popups": ["白いクダギツネは、\n拠点には向かわず、\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。", "クダギツネの攻撃を受けた\n味方ユニットは3秒間、\n攻撃力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。", "錫杖を装備したカラス天狗は\n一度だけ攻撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "河童", "text": "ヒャッハァッ！　盗め盗めー！\n屋台から景品まで全部盗み出せー！\n河童だけになにもかもかっぱらってやらぁ！", "face": "lc3cdb546668d"}, {"name": "河童", "text": "人間の夏祭りは中止だァー！\n代わりに俺たちの夏祭りを開催してやるよォーッ！！", "face": "lc3cdb546668d"}, {"name": "マータン", "text": "おわー！？　マータンたちが必死に準備した会場が、\nめちゃくちゃになってるぞー！？", "face": "u2862a1"}, {"name": "エターナー", "text": "まだ人に迷惑をかける妖怪がいたのか……。\n最近は妖怪の総大将たちのおかげで、\n大人しくなってきたと思っていたのだがな。", "face": "u2864a1"}, {"name": "クダギツネ", "text": "――あら、誰もが総大将に従うわけではないのよ？", "face": "l5cf717ccfcdb"}, {"name": "エターナー", "text": "お前は……クダギツネ、だったか？", "face": "u2864a1"}, {"name": "クダギツネ", "text": "ええ、アタシはクダギツネ。\n陰陽師にコキ使われてる、\n妖怪の恥さらしみたいな種族よ。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "あぁ、最近は自由になったから、\n陰陽師にコキ使われていた、が正しいかしら？", "face": "l5cf717ccfcdb"}, {"name": "マータン", "text": "そんなことはどうでもいい！\nお前たちはなんでこんなことをしてるんだ！", "face": "u2862a1"}, {"name": "クダギツネ", "text": "なんでって、決まっているでしょう？\nアタシたちの夏祭りをするためよ。", "face": "l5cf717ccfcdb"}, {"name": "リッチ", "text": "……夏祭りをすることが目的なら、\nなぜあなたたちは暴れ回っているのですかな。", "face": "u2863a1"}, {"name": "クダギツネ", "text": "そうねぇ……色々と理由はあるけれど、\nその一つとしては、準備時間が足りないからかしら。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "これ、結構急にやるって決めたから。\n会場を確保する時間も、屋台を用意する時間もないのよね。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "それなら、既にあるものを拝借したほうが、\n遥かに手っ取り早いでしょう？", "face": "l5cf717ccfcdb"}, {"name": "エターナー", "text": "……ろくでもない奴だな。", "face": "u2864a1"}, {"name": "クダギツネ", "text": "妖怪なんてみんなそんなものよ。\n最近の子たちはお行儀がいいみたいだけどね。", "face": "l5cf717ccfcdb"}, {"name": "リッチ", "text": "対話が望める相手ではなさそうですな。\n致し方なし、妖怪退治といきましょうか。", "face": "u2863a1"}, {"name": "クダギツネ", "text": "ふふ、いいわね。\nアタシ、喧嘩は大好きよ。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "……と、その前に。\nそこの獣人の子、あなたがマータンかしら？", "face": "l5cf717ccfcdb"}, {"name": "マータン", "text": "なっ……お前、マータンを知っているのか！？", "face": "u2862a1"}, {"name": "クダギツネ", "text": "ええ、最近できたお友達があなたのことを教えてくれたの。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "お友達は、あなたに優しくするよう言っていたけれど……。\n立ち向かってくるなら、仕方ないわよねぇ？", "face": "l5cf717ccfcdb"}, {"name": "マータン", "text": "……聞きたいことは山ほどあるが、\n今は、お前を倒すことに集中する。", "face": "u2862a1"}, {"name": "マータン", "text": "その後で、お友達とやらについて聞かせてもらうぞ！", "face": "u2862a1"}]}, {"trigger": "end", "lines": [{"name": "クダギツネ", "text": "……こりゃ駄目ね。\nあなたたちを相手取るなら、\nもっと頭数が必要だったかしら。", "face": "l5cf717ccfcdb"}, {"name": "マータン", "text": "待て！　お前、逃げるつもりか！", "face": "u2862a1"}, {"name": "クダギツネ", "text": "必要な物資は十分盗めたもの。\nこれ以上ここに留まる意味はないわ。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "というわけでアタシは逃げるとするわ。\nええ……お友達のところまでね。", "face": "l5cf717ccfcdb"}, {"name": "リッチ", "text": "……ついてこいと誘っていますな。", "face": "u2863a1"}, {"name": "エターナー", "text": "だが、放っておくわけにいかないだろう。", "face": "u2864a1"}, {"name": "エターナー", "text": "クダギツネを退治するのもだが、\n私たちは盗まれた備品を取り戻す必要がある。", "face": "u2864a1"}, {"name": "マータン", "text": "お友達とやらのことも気になるからな！\nマータンはあいつを捕まえに行くぞ！", "face": "u2862a1"}, {"name": "リッチ", "text": "仕方ありませんな。\n我々で追跡するとしましょうか。", "face": "u2863a1"}, {"name": "エターナー", "text": "罠の可能性が高いからな。\n十分注意して進むとしよう。", "face": "u2864a1"}]}]}