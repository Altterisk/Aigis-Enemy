{"quest_id": 4290, "name": "古戦場での出会い", "description": "古戦場で女性が魔物に襲われていた。\n魔物を撃退し、女性を救出せよ！\n\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "魔王の迷宮", "event_category": "History", "mission_id": 920043, "map_no": 3563, "level": 95, "multiplier": 0.95, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 15, "form_count": 1, "hp": 608, "attack": 133, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "hp": 608, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 29}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 4750, "attack": 570, "base_hp": 5000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097808, "master_id": 43, "global_id": 42, "spawn_sec": 45}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "hp": 950, "attack": 142, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 60}, {"enemy_id": 5, "source": "local", "count": 8, "form_count": 1, "hp": 608, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 69}], "dialogue": [{"trigger": "start", "lines": [{"name": "魔物", "text": "ゲギャギャ……ッ！！", "face": "l34dbef4a9db2"}, {"name": "？？？", "text": "迷宮に行き着く前に……。\nここまでなのです……。", "face": "u253"}, {"name": "アンナ", "text": "王子！　魔物に襲われている方が……！\n急いで助けましょう！", "face": "l67e3c62cf227"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "助けていただいて、\nありがとう……なのです。\nあなたたち……強いのです……。", "face": "u253"}, {"name": "？？？", "text": "……その強さを見込んで、お願いがあるのです。\n私と一緒に魔王の迷宮に行ってほしいのです！", "face": "u253"}, {"name": "アンナ", "text": "魔王の迷宮！？", "face": "l67e3c62cf227"}, {"name": "アンナ", "text": "確かに現在魔物は復活していますが、\nその根源たる魔王は女神アイギス様の\n御力により封印されているはずです。", "face": "l67e3c62cf227"}, {"name": "アンナ", "text": "その魔王と何か関係が……？", "face": "l67e3c62cf227"}, {"name": "アイギス", "text": "それについてはきちんと私の口からお話しする\n必要がありますね……。", "face": "l0171787d73de"}, {"name": "アンナ", "text": "アイギス様……！", "face": "l67e3c62cf227"}, {"name": "アイギス", "text": "魔物が復活したのは、長い刻の中で私の力\nが弱まったことにあります。", "face": "l0171787d73de"}, {"name": "アイギス", "text": "今では魔王を封印した体からも引き離され、\n力はほとんど残っていない精神体……。\nあの時、魔王を封印したのは確かです。", "face": "l0171787d73de"}, {"name": "アイギス", "text": "しかしその封印がどうなってしまっているのかは\n今の私の力では……申し訳ありませんが\nわからないのです……。", "face": "l0171787d73de"}, {"name": "アンナ", "text": "封印された魔王と復活した魔物の関係が\nなにかわかるかもしれません。", "face": "l67e3c62cf227"}, {"name": "アンナ", "text": "旅のお方、私たちも魔王の迷宮の探索に\nご協力いたします。\nひとまず詳しい話は王城でお話ししましょう。", "face": "l67e3c62cf227"}]}], "active": true}