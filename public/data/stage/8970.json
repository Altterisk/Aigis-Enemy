{"quest_id": 8970, "name": "スライム化する海", "description": "合同演習が終わり海水浴を楽しむ王子たち。\nすると何やら海がピンク色に染まり始めて？\n＜広域戦闘：敵味方の射程減少＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "真夏のぷるぷるビーチ", "event_category": "Emergency", "mission_id": 200570, "map_no": 7444, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "tags": ["スライム"], "hp": 1600, "attack": 300, "base_hp": 1600, "base_attack": 300, "damage_type": "magical", "armor_defense": 1600, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097296, "master_id": 22, "global_id": 21, "spawn_sec": 28}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "tags": ["スライム"], "hp": 3300, "attack": 380, "base_hp": 3300, "base_attack": 380, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158496, "change_to": 2, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38491, "global_id": 12108, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 3300, "attack": 700, "base_hp": 3300, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158512, "master_id": 38492, "global_id": 12109}], "spawn_sec": 28},