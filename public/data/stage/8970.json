, "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38493, "global_id": 12110, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 8500, "attack": 1050, "base_hp": 8500, "base_attack": 1050, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158544, "master_id": 38494, "global_id": 12111}], "spawn_sec": 136}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["スライム"], "hp": 12200, "attack": 800, "base_hp": 12200, "base_attack": 800, "damage_type": "physical", "armor_defense": 550, "magic_defense": 30, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2166048, "change_to": 9, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 22973, "global_id": 3256, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 12200, "attack": 1300, "base_hp": 12200, "base_attack": 1300, "damage_type": "physical", "armor_defense": 550, "magic_defense": 30, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2166064, "master_id": 22974, "global_id": 3257}], "spawn_sec": 147}], "popups": ["発光するマスに配置した\nユニットは射程が\n上昇します。"], "dialogue": [{"trigger": "battle", "at_sec": 28, "lines": [{"name": "ヴィラヘルム", "text": "ふふっ、久しぶりの海遊びは楽しいですね♪", "face": "u2835a1"}, {"name": "ヴィラヘルム", "text": "……なぜか海がピンク色になっていますが。", "face": "u2835a1"}, {"name": "レミィ", "text": "そうね！　みんなで泳いだり、\n水をかけ合って遊ぶのは楽しいわ！", "face": "u2837a1"}, {"name": "レミィ", "text": "……なんかこの海、ねちゃねちゃしてるけど！", "face": "u2837a1"}, {"name": "ヘイズル", "text": "絶対海で遊んでる場合じゃないよ。\n見るからにおかしなことになってるし。", "face": "u2836a1"}, {"name": "ハリンヘイム", "text": "とりあえず、皆さん陸に上がってきてください。\n無理やり海水浴をするのは中止にしましょう。", "face": "u2839a1"}, {"name": "クーコ", "text": "せっかく海に来たんだから、\nめいっぱい楽しみたかったのになぁ……。", "face": "u2837a1"}, {"name": "ヴィラヘルム", "text": "復活してからはじめての海だったのですがね……。", "face": "u2835a1"}, {"name": "太上老君", "text": "みんながとぼとぼと上がってきたところで。\nなにが起きているのか真面目に考えるとしようか。", "face": "u2838a1"}, {"name": "ヴィディア", "text": "帝国の海事情には詳しくないのだが、\n普通に赤潮とかではないのか？", "face": "u2841a1"}, {"name": "ホルミース", "text": "いえ、おそらくこれは違います。\n実際に泳いでみたから分かるのですが――", "face": "u2834a1"}, {"name": "ホルミース", "text": "――海がスライム化しています。", "face": "u2834a1"}, {"name": "太上老君", "text": "……なんて？", "face": "u2838a1"}, {"name": "クーコ", "text": "にわかには信じられないけど、\n感触は完全にスライムだったわ。", "face": "u2837a1"}, {"name": "ヴィディア", "text": "じゃあなんだ、ピンク色の染まったこの海一帯が、\n全部スライムになっているということか……？", "face": "u2841a1"}, {"name": "アブグルント", "text": "そうなんじゃないかしら？\nその証拠にほら、海からスライムが大量に湧きだしてるわ。", "face": "u2840a1"}, {"name": "イムラウ", "text": "もしかして……大事件が起きてる……？", "face": "u2842a1"}, {"name": "ヴィディア", "text": "もしかしなくても大事件だ……！\nとにかく、湧いてきたスライムを倒すぞ！", "face": "u2841a1"}]}, {"trigger": "end", "lines": [{"name": "ダグマール", "text": "襲いかかってきたスライムたちはすべて倒せましたね。", "face": "u2843a1"}, {"name": "ヴィディア", "text": "海から増援がくる様子もない。\n一旦は落ち着いたと見ていいか。", "face": "u2841a1"}, {"name": "アブグルント", "text": "それにしても、海がスライムになっているなんて驚きね。", "face": "u2840a1"}, {"name": "レミィ", "text": "泳いでる時になんか痛い気がすると思ったら、\nそういうことだったのね！", "face": "u2837a1"}, {"name": "ハリンヘイム", "text": "異常を感じた時点で上がってきてくださいよ……。", "face": "u2839a1"}, {"name": "イムラウ", "text": "そもそも入らない方が良かったんじゃないかな……。", "face": "u2842a1"}, {"name": "ヘイズル", "text": "とりあえずなんで海がスライム化しているのかとか、\nここでなにが起きているのかは調査するとして……。", "face": "u2836a1"}, {"name": "ヘイズル", "text": "……まぁ、一度砦に戻ろうか。\nちょっと身体を洗いたいし。", "face": "u2836a1"}, {"name": "ホルミース", "text": "水着姿なのが仇になりましたね。\n素肌にスライムがまとわりついて、\nべとべとになっちゃいました……。", "face": "u2834a1"}, {"name": "太上老君", "text": "髪にも絡みついてるし……はぁ。\nこれ、ちゃんと取れるかな……。", "face": "u2838a1"}]}], "active": true}