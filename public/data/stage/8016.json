{"quest_id": 8016, "name": "華の国の創造者", "description": "ある日の崑崙、千年ぶりに目覚めた徐華の\n肩慣らしで戦う事になった王子一行。\n亜神たちを相手に磨き上げた技を披露せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "偽りの太陽、虚像の黄金", "event_category": "History", "mission_id": 920201, "map_no": 4765, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 84000, "attack": 1800, "base_hp": 84000, "base_attack": 1800, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 200, "attack_speed": 100, "attack_wait": 60, "attack_interval": 173, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2145792, "race_id": 19, "special_effect_id": 1435, "missile_id": 462, "missile": {"speed": 10.0}, "master_id": 36335, "global_id": 9952, "ranged": true, "spawn_sec": 39}, {"enemy_id": 2, "source": "local", "count": 9, "form_count": 1, "hp": 36000, "attack": 800, "base_hp": 36000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 15, "attack_range": 160, "attack_speed": 100, "attack_wait": 60, "attack_interval": 175, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2145808, "race_id": 19, "special_effect_id": 1437, "missile_id": 462, "missile": {"speed": 10.0}, "master_id": 36337, "global_id": 9954, "ranged": true, "spawn_sec": 42}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 1, "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112640, "master_id": 30705, "global_id": 4324, "spawn_sec": 123}, {"enemy_id": 4, "source": "local", "count": 16, "form_count": 1, "hp": 4000, "attack": 350, "base_hp": 4000