master_id": 36065, "global_id": 9682, "ranged": true, "from_condition": 4, "trigger_ticks": 4}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112816, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30725, "global_id": 4344, "ranged": true, "spawn_sec": 171}, {"enemy_id": 12, "source": "local", "count": 14, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142784, "race_id": 16, "missile_id": 831, "missile": {"speed": 4.0, "splash": 133}, "master_id": 35836, "global_id": 9453, "ranged": true, "spawn_sec": 176}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112832, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30726, "global_id": 4345, "ranged": true, "spawn_sec": 187}, {"enemy_id": 14, "source": "local", "count": 9, "form_count": 1, "hp": 6000, "attack": 550, "base_hp": 6000, "base_attack": 550, "damage_type": "magical", "armor_defense": 350, "magic_defense": 5, "attack_speed": 80, "attack_wait": 60, "attack_interval": 249, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142832, "race_id": 16, "master_id": 35839, "global_id": 9456, "spawn_sec": 202}, {"enemy_id": 15, "source": "local", "count": 10, "form_count": 1, "hp": 6500, "attack": 750, "base_hp": 6500, "base_attack": 750, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112656, "master_id": 30724, "global_id": 4343, "spawn_sec": 248}, {"enemy_id": 16, "source": "local", "count": 9, "form_count": 1, "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112848, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30727, "global_id": 4346, "ranged": true, "spawn_sec": 256}], "popups": ["\n\n\n　　　――少し前のこと、\n　　　第二層「崑崙」にて", "徐華は一定範囲内のユニットから\nダメージを受けると\n攻撃したユニットへ反撃を行います。\n\n反撃のダメージは徐華が\n受けたダメージに比例します。", "徐華の分身は\n一定範囲内のユニットから\nダメージを受けると\n受けたダメージの30%のダメージで\n攻撃したユニットへ反撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――少し前のこと、第２層「崑崙」にて"}, {"name": "？？？", "text": "――出迎えが遅すぎんか？", "face": "u1895a1"}, {"name": "元始天尊", "text": "そうは言いますが、\n復活するなら復活すると言ってもらわないと。", "face": "u1801a1"}, {"name": "？？？", "text": "儂とていつ復活するかなどわからぬからな。\nで、元始天尊、こやつらが英雄王の――息子？　孫か？", "face": "u1895a1"}, {"name": "元始天尊", "text": "もっと後です。\nあなた何年寝てたか把握してます？", "face": "u1801a1"}, {"name": "？？？", "text": "ざっと……んー、百年くらいかの？", "face": "u1895a1"}, {"name": "元始天尊", "text": "ざっと十倍ですかね。", "face": "u1801a1"}, {"name": "？？？", "text": "なんじゃとー！？", "face": "u1895a1"}, {"name": "アンナ", "text": "あ、あの、この方はいったい……？", "face": "l39bb2aa5a71a"}, {"name": "？？？", "text": "不敬ぞ小娘。\n儂を知らんとか、一晩もみくちゃの刑に処すが？", "face": "u1895a1"}, {"name": "サナラ", "text": "あっ、誰かと思えば徐華ちゃんじゃないですかー。\n今までいったいどこにいたんです？", "face": "u921"}, {"name": "徐華", "text": "おぉ、サナラ！　今日も不敬じゃな！\nじゃが可愛いから許す！", "face": "u1895a1"}, {"name": "サナラ", "text": "王子ちゃん、このちんまい可愛い子は、\n一緒に千年戦争を戦った徐華ちゃんで――", "face": "u921"}, {"name": "徐華", "text": "やめんかサナラ！　儂の格が下がる！！", "face": "u1895a1"}, {"name": "徐華", "text": "コホン……。\n儂は崑崙の真の主にして、\n華の国の創造者たる亜神、徐華である。", "face": "u1895a1"}, {"name": "フェイ", "text": "は、華の国の……創造、者ぁ！？", "face": "u434"}, {"name": "元始天尊", "text": "正確には設計者、くらいでしょうか。\nこの後に向かう第四層が砂漠の国の原型であるように、\n崑崙もまた、華の国の原型となった場所ですから。", "face": "u1801a1"}, {"name": "ソラス", "text": "ただ困ったことに、その設計者自ら、\n神の座を捨ててまで千年戦争に駆けつけ、\n思いっきり人類に肩入れしていったと。", "face": "u904"}, {"name": "トラム", "text": "……ね、ねぇソラス？\nその言い方だと私にも刺さるのだけれど……。", "face": "u1110a1"}, {"name": "徐華", "text": "おぉトラム！　神の座捨て仲間じゃ！　久しいのう！", "face": "u1895a1"}, {"name": "徐華", "text": "ともあれあの後は、さすがにやり過ぎと\n仙人連中に叱られたし、儂も反省してな。", "face": "u1895a1"}, {"name": "徐華", "text": "ひとまず大地の再生を最優先にしようと、\n崑崙と同化し、ちまちまと\n世界の修復をして過ごしておったというわけじゃ。", "face": "u1895a1"}, {"name": "アンナ", "text": "それはありがたいことですが……。\nで、ではその、これからのご予定は……？"}, {"name": "徐華", "text": "うむ、ずーっと同化しておったせいか、\nどうにも身体に違和感があってなー。", "face": "u1895a1"}, {"name": "徐華", "text": "そういうわけで、王子といったか？\nちょいと儂の肩慣らしの相手をしてくれんか？", "face": "u1895a1"}, {"name": "サナラ", "text": "寝起きで運動とか、身体に悪いですよ？", "face": "u921"}, {"name": "徐華", "text": "儂をお婆ちゃん扱いするでない！\nいたわり過ぎも傷つくぞ！", "face": "u1895a1"}, {"name": "徐華", "text": "それにほれ、王子もやる気のようじゃ。\nさっそく始めるとしようかのう！！", "face": "u1895a1"}]}, {"trigger": "end", "lines": [{"name": "徐華", "text": "――おぉおぉ！　調子が戻ってきたぞ！\nふっふん、これならすぐにでも現役に戻れそうじゃ。", "face": "u1895a1"}, {"name": "元始天尊", "text": "調子に乗るとぎっくり腰やりますよ？", "face": "u1801a1"}, {"name": "徐華", "text": "お主まで年寄り扱いするでない！\nはぁ……まったく……。", "face": "u1895a1"}, {"name": "徐華", "text": "で、王子よ、この後はどうするつもりじゃ？\n第四層に乗り込むのか？", "face": "u1895a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "徐華", "text": "ほうほう、ほーう……。\nよし、儂もついていくとしよう。", "face": "u1895a1"}, {"name": "アンナ", "text": "よろしいのですか？"}, {"name": "徐華", "text": "管理者の元始天尊が好き勝手しておるのだ、\n儂が付いていったって良いじゃろ？", "face": "u1895a1"}, {"name": "徐華", "text": "――ただ、少し準備がいるな。\n王子よ、お主らは先行しておるがよい。\n儂は準備を整え次第、追いかけるとしよう。", "face": "u1895a1"}, {"name": "アンナ", "text": "えぇと……そういうことなら、分かりました。\nでは王子、我々は上層を目指しましょうか。"}, {"name": "徐華", "text": "うむ、よきはかよ。\nではまたな！", "face": "u1895a1"}, {"name": "徐華", "text": "…………。", "face": "u1895a1"}, {"name": "徐華", "text": "………………さて。\nで、お主も後を追うのか？\nどこかで見た顔じゃが……。", "face": "u1895a1"}, {"name": "イコル", "text": "…………ああ。\n気付いていたのに、連中になぜ教えなかった？", "face": "l9b32f94301f4"}, {"name": "徐華", "text": "隠れたがっているのに、それを教えるとか無粋じゃろ。\nそれに……。", "face": "u1895a1"}, {"name": "徐華", "text": "覚悟を決めた顔した小娘の、\n足を引っ張るとか、儂の趣味じゃないからのう！", "face": "u1895a1"}]}], "active": true}