hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 9, "source": "local", "count": 16, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 68}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103360, "race_id": 9, "master_id": 441, "global_id": 440, "spawn_sec": 80}, {"enemy_id": 11, "source": "local", "count": 5, "level": 80, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 125}, {"enemy_id": 12, "source": "local", "count": 3, "level": 80, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 600, "attack_speed": 45, "attack_wait": 10, "attack_interval": 113, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122096, "race_id": 9, "master_id": 32439, "global_id": 6058, "spawn_sec": 138}], "popups": ["メカゴブリンクイーンは\n拠点には向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 "], "dialogue": [{"trigger": "enemy_death", "enemy_id": 1, "lines": [{"name": "メカゴブリンクイーン", "text": "やっぱり、私の目に狂いはなかったわ。\n強くたくましく、物質界の頂点に立つオ・ト・コ……♪", "face": "l3d387609bcc7"}, {"name": "メカゴブリンクイーン", "text": "でもそろそろ衣装合わせの時間なのよ。\n王子、本番で会いましょうねぇ♪　オーッホッホッホ！", "face": "l3d387609bcc7"}]}, {"trigger": "start", "lines": [{"name": "メカゴブリンクイーン", "text": "――それではお前たち、\n王国の民にも招待状を届けるのよ？\nくれぐれも失礼の無いようにね。", "face": "l3d387609bcc7"}, {"name": "ゴブリン", "text": "ギャギャ！\nオテガミ　オトドケ！　イッテクル！", "face": "l4bf042579e8b"}, {"name": "メカゴブリンクイーン", "text": "……長く戦ってきたけれど、\nまさかこんな日が来るとは思ってもみなかったわね。", "face": "l3d387609bcc7"}, {"name": "ゴブリン博士", "text": "……ハッ。\nしかしメカゴブリンクイーンさま、\nドウカ、ドウカいま一度再考ヲ……。", "face": "l7590e38ca391"}, {"name": "メカゴブリンクイーン", "text": "――いいえ、これもゴブリン族のため。\nさらには物質界の平穏のために必要なことよ。", "face": "l3d387609bcc7"}, {"name": "メカゴブリンクイーン", "text": "それより博士、\nちゃんと王子の同意は得てきたのでしょうねぇ？", "face": "l3d387609bcc7"}, {"name": "ゴブリン博士", "text": "はっ……いえ、ソノ……。\n宝石探索用ミミックの配置に手間取っておりましテ……。", "face": "l7590e38ca391"}, {"name": "メカゴブリンクイーン", "text": "ウフフ、あなたらしくもない。\n王子だってこれが最適な選択だと\nすぐに分かってくれるはずよ。早く行ってきなさい。", "face": "l3d387609bcc7"}, {"name": "メカゴブリンクイーン", "text": "……それにしても、これまでよく仕えてくれたわね。\nあなたには、本当に感謝しているわ。", "face": "l3d387609bcc7"}, {"name": "ゴブリン博士", "text": "メ、メカゴブリンクイーンさま……！\nそんなもったいないお言葉ヲ……！！", "face": "l7590e38ca391"}, {"name": "メカゴブリンクイーン", "text": "一度命を落としかけて気付いたのよ。\n私の覇道を支えてくれていたのは、\nただひとり、あなただけだったのだとね……。", "face": "l3d387609bcc7"}, {"name": "メカゴブリンクイーン", "text": "だから、この婚礼も最後まで見届けてちょうだい。\n他ならぬ、あなたが祝ってくれたなら、\n種族を超えた結婚も乗り越えられるはずよ。", "face": "l3d387609bcc7"}, {"name": "ゴブリン博士", "text": "くっ……メカゴブリンクイーンさま……。\nワタクシは……ワタクシは……ッ！！", "face": "l7590e38ca391"}, {"name": "メリュジアナ", "text": "――おや……？\nあそこにいるのはメカゴブリンクイーンでは？", "face": "u1218a1"}, {"name": "ナナリー", "text": "……ミミックもいるみたい。\nやっぱり宝石泥棒の主犯は、\nメカゴブリンクイーン……？", "face": "u1217a1"}, {"name": "シルセス", "text": "彼女とは、天界との戦いの間は\n物質界連合の仲間だと思っていたのですが……。\nともあれ、まずは事情を聞いてみるべきでしょう。", "face": "u451"}, {"name": "メカゴブリンクイーン", "text": "――あら？　大変よゴブリン博士、\nもう王子たちが来てしまったわ？", "face": "l3d387609bcc7"}, {"name": "メカゴブリンクイーン", "text": "ウフフ、手紙を出すより早くやってくるなんて、\nやっぱり王子もその気だったということねぇ。", "face": "l3d387609bcc7"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "メカゴブリンクイーン", "text": "ウフッ♪　でもダメダメ、せっかちさぁん♪\nドレスの仕上げが終わっていないから、\n今日のところは帰ってもらわないとねぇ。", "face": "l3d387609bcc7"}, {"name": "シルセス", "text": "えぇと……メカゴブリンクイーンが\n戦闘態勢にはいりまし、た……？", "face": "u451"}, {"name": "シルセス", "text": "いったい何を企んでいるのか分かりませんが、\n王子、急いで迎撃の準備をお願いします！", "face": "u451"}]}, {"trigger": "end", "lines": [{"name": "シルセス", "text": "ゴブリン軍団、撤退していきましたが……。\nなんだか様子がおかしかったですね。", "face": "u451"}, {"name": "ゴブリン", "text": "ギャギャ！　王子！　王子！\nオテガミ！　ゴブリン族カラ！", "face": "l4bf042579e8b"}, {"name": "メリュジアナ", "text": "ふむ、この手紙を王子に？\nなになに……むっ……読めないな……。", "face": "u1218a1"}, {"name": "リーナ", "text": "……あっ、では私にお任せください。\nゴブリン族の文字はお手の物です！", "face": "u521"}, {"name": "シルセス", "text": "ではリーナさん、\n手紙の内容を王子に伝えてあげてください。\n不穏な内容じゃないと良いのですが……。", "face": "u451"}, {"name": "リーナ", "text": "えーっと……こほん！\n――王国、ゴブリン族の同盟をより強固にして、\n永遠なるものにすべく……んー……えっ、えぇー！？", "face": "u521"}, {"name": "リーナ", "text": "大変ですご主人さまぁ！！\nどうしましょうっ、ご主人さまとっ！\nお母さ――め、メカゴブリンクイーン様がー！？", "face": "u521"}, {"name": "シルセス", "text": "落ち着いてください、リーナさん。\nいったい何が書いてあったのですか？", "face": "u451"}, {"name": "リーナ", "text": "こ、これは……ゴブリン族と王国の、\n正式な同盟の打診です……！！\nしかもそれだけじゃなくて、その、えっとぉ！", "face": "u521"}, {"name": "リーナ", "text": "――ご主人さまとメカゴブリンクイーン様の、\n婚礼をもって同盟を\n確固たるものにしたいと書いてあるんですー！！", "face": "u521"}, {"name": "シルセス", "text": "……は？", "face": "u451"}, {"name": "メリュジアナ", "text": "なるほど、国家戦略としては妥当、\nだが、いや、待て、そんな、えぇ……。", "face": "u1218a1"}, {"name": "ナナリー", "text": "王子が……けっこん……？", "face": "u1217a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "……ともかく、勝手に話を進められても困ります。\n急いでメカゴブリンクイーンを追いかけましょう。"}, {"name": "シルセス", "text": "そのとおりです。\n異議を申し立てなければ！\nさぁ王子、行きましょうっ！！", "face": "u451"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "メカゴブリンクイーン", "text": "ウフフ、そろそろ衣装合わせの時間ね。\n王子、本番で会いましょうねぇ。", "face": "l3d387609bcc7"}, {"name": "シルセス", "text": "……メカゴブリンクイーン、撤退していきます。\nいったい何だったのでしょうか……？", "face": "u451"}]}], "story_talk": true, "active": true}