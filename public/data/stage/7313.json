{"quest_id": 7313, "name": "女王からの招待状", "description": "引き続き、宝石泥棒の足取りを追う一行。\n手がかりを辿った先には、何やら準備に\n勤しむメカゴブリンクイーンの姿が……？\n上級（★１獲得の目安：平均Lv10）", "event": "クイーンズ・ウェディング", "event_category": "History", "mission_id": 920160, "map_no": 5939, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 13000, "attack": 400, "base_hp": 13000, "base_attack": 400, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 400, "attack_wait": 60, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114624, "race_id": 9, "special_effect_id": 442, "change_to": 1, "change_condition": 1, "missile_id": 26, "master_id": 32062, "global_id": 5681, "ranged": true, "variants": [{"tags": ["アーマー", "機械"], "hp": 13000, "attack": 1500, "base_hp": 13000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 800, "magic_defense": 10, "attack_wait": 80, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114640, "race_id": 9, "special_effect_id": 242, "master_id": 32063, "global_id": 5682}], "commands": {"raw": "CallEvent(2112, 2113);"}, "route_behaviour": {"calls_event": [2110, 2111]}}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 3, "hp": 1, "attack": 150, "base_hp": 1, "base_attack": 150, "damage_type": "physical", "armor_defense": 370, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "attack_interval": 58, "move_speed": 4500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128560, "change_to": 3, "master_id": 33695, "global_id": 7312, "to_global_id": 7307, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "