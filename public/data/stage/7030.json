cal", "armor_defense": 1500, "magic_defense": 20, "attack_interval": 48, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2120192, "special_effect_id": 433, "master_id": 32038, "global_id": 5657, "from_condition": 2}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102752, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 394, "global_id": 393, "ranged": true, "spawn_sec": 143}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 500, "base_hp": 2800, "base_attack": 500, "damage_type": "magical", "armor_defense": 700, "magic_defense": 40, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 241, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102800, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 397, "global_id": 396, "ranged": true, "spawn_sec": 158}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー"], "hp": 3500, "attack": 550, "base_hp": 3500, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 200, "attack_speed": 90, "attack_wait": 60, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103824, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 480, "global_id": 479, "ranged": true, "spawn_sec": 201}], "popups": ["\n\n\n　――王国近郊、とある村にて。", "デシウスは倒されると、\nその場で変身します。\n変身は2回まで行われます。\n\nまた第2、第3形態のデシウスから\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "村長", "text": "――デシウスさんや、\n今日も畑仕事に精が出ますなぁ！", "face": "le94a1db3a36e"}, {"name": "デシウス", "text": "おぉ、村長殿！\n畑も野菜も気合十分、今年はきっと豊作だぞ！", "face": "le61e6e079a9f"}, {"name": "村長", "text": "デシウスさんと暗黒騎士団の皆さんが\n色々と手伝ってくれているおかげですとも。", "face": "le94a1db3a36e"}, {"name": "デシウス", "text": "いやいや、これも記憶を失った我輩を、\n受け入れてくれた村の皆への恩返しなのだ。\nどんどん頼ってくれて良いのだぞ！", "face": "le61e6e079a9f"}, {"name": "デシウス", "text": "しかし、何か大切なことを\n忘れているような気がするのだがなぁ……。\nお前、何か思い出してはいないか？", "face": "le61e6e079a9f"}, {"name": "暗黒騎士の手下", "text": "いえいえ、我らも記憶喪失のままですので。\nそれより畑の手入れを済ませてしまいましょう。\n午後からは森で山菜の採集ですよ！", "face": "l36df77641c8e"}, {"name": "デシウス", "text": "うむ、そうだな！\nふふふ、村の皆の喜ぶ顔が目に浮かぶようだ！", "face": "le61e6e079a9f"}, {"name": "暗黒騎士の手下", "text": "（以前のデシウス様は、\nずっと死に場所を求めているかのようでした。\n使命を果たし、目的を失ってしまったかのように）", "face": "l36df77641c8e"}, {"name": "暗黒騎士の手下", "text": "（それを思えば、こんな日常が終着地点というのも、\nデシウス様の言う星の導きなのかもしれませんよ）", "face": "l36df77641c8e"}, {"name": "村人", "text": "――た、大変だ！！\n村の男達が突然暴れだしたぞ！！", "face": "lc529526688e7"}, {"name": "村長", "text": "何じゃと！？　いったいどうしたんじゃ！？", "face": "le94a1db3a36e"}, {"name": "デシウス", "text": "ヌゥ……っ。\n我輩が止めに――\nいや待て、向こうに見えるのはいったい何だ？", "face": "le61e6e079a9f"}, {"name": "暗黒騎士の手下", "text": "向こうに……？　おや、あの顔ぶれは。\nデシウス様、あれは王国軍の部隊ですよ。", "face": "l36df77641c8e"}, {"name": "デシウス", "text": "王国……軍？\nはっ、まさかあの軍が、\n村の男達に毒か何かを盛ったのではないか！？", "face": "le61e6e079a9f"}, {"name": "デシウス", "text": "おのれ、謎の軍隊め！\n我輩が真相を問い詰めてくれよう！\n暗黒騎士団、抜剣！　突撃用意……ッ！！", "face": "le61e6e079a9f"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、この付近でも女王アリが目撃されたようです。\nフェロモンの影響がないか、一応確認を――"}, {"name": "シャディア", "text": "――い、いや待てアンナ！\n向こうから突撃してくるのは――デシウスじゃないか！？", "face": "u713"}, {"name": "アンナ", "text": "確かにそう見えますが……。\nお、王子、このままでは激突します！\n急ぎ迎撃の準備をお願いします！", "face": "l434746a66b00"}]}, {"trigger": "end", "lines": [{"name": "デシウス", "text": "――なるほど、村人が暴れだしたのは、\n魔界アリの女王が放つフェロモンのせいだったか。", "face": "le61e6e079a9f"}, {"name": "デシウス", "text": "ヌゥ、それは済まないことをした。\nその上、村人を元に戻すポーションを分けてくれるとは、\nどれだけ感謝してもしたりないな。", "face": "le61e6e079a9f"}, {"name": "ヘイオス", "text": "……デシウス、生きていたんですね。", "face": "u915"}, {"name": "デシウス", "text": "ヌ……我輩を知っているのか？\nすまない、記憶が無くてな……。", "face": "le61e6e079a9f"}, {"name": "ミーティア", "text": "……そっか。\n今は、あの村にいるの？", "face": "u280"}, {"name": "デシウス", "text": "うむ、皆働き者で、心の温かな良い村だ。\n畑仕事も随分と上達したが、\nさてはかつての我輩、腕利き農夫だったのか？", "face": "le61e6e079a9f"}, {"name": "シャディア", "text": "……ふふ、お前にしては、上手い冗談だ。\nだが、そうだな。腕利き農夫だったのだろう、きっと。", "face": "u713"}, {"name": "デシウス", "text": "おぉ、やはりそうか！\nではかつての我輩に恥じぬよう、\n気合をいれて畑の世話をせねばならんな！", "face": "le61e6e079a9f"}, {"name": "デシウス", "text": "――そして、王子……殿下……？\nいや、王子と呼ぶ不敬を許してはもらえまいか。\nどうにもその方が馴染み深く思えてな。", "face": "le61e6e079a9f"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "デシウス", "text": "おぉ、ありがたい！\nそれでは王子と呼ばせてもらおう！", "face": "le61e6e079a9f"}, {"name": "デシウス", "text": "王子、嗚呼、王子よ。\n記憶は無いが、この呼び名には何故か、\nひどく強い心の昂りを感じる。", "face": "le61e6e079a9f"}, {"name": "デシウス", "text": "きっと、王子とはいつか、\nどこかで会ったことがあるのだろう。\nかつての我輩に代わり、武運長久を祈ろう。", "face": "le61e6e079a9f"}, {"name": "アンナ", "text": "……王子、そろそろ先を急ぎましょう。\nそれではデシウス、\n村の皆さんによろしくお伝えください。"}, {"name": "デシウス", "text": "うむ、任された。\nそれでは達者でな、王国軍の皆よ。", "face": "le61e6e079a9f"}, {"name": "ミーティア", "text": "あっ、最後にひとつだけ良い？\nデシウス、星の声は、聞こえる？", "face": "u280"}, {"name": "デシウス", "text": "――うむ。実に美しい調べだ。\nきっと、かつての我輩からの贈り物なのだろうなぁ。", "face": "le61e6e079a9f"}]}], "active": true}