300, "damage_type": "physical", "armor_defense": 100, "attack_range": 40, "attack_speed": 60, "attack_wait": 15, "attack_interval": 71, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111744, "race_id": 13, "special_effect_id": 191, "missile_id": 45, "master_id": 30621, "global_id": 4240, "ranged": true, "spawn_sec": 98}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 2, "hp": 21000, "attack": 1200, "base_hp": 21000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 350.0, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118480, "race_id": 18, "change_to": 5, "change_condition": 2, "master_id": 31715, "global_id": 5334, "to_condition": 2, "to_global_id": 5335, "spawn_sec": 147}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10500, "attack": 800, "base_hp": 10500, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_range": 260, "attack_speed": 1, "attack_wait": 20, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118496, "race_id": 18, "missile_id": 351, "missile": {"speed": 10.0}, "master_id": 31716, "global_id": 5335, "ranged": true, "from_condition": 2}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 200, "base_hp": 6000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2116704, "race_id": 18, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 31399, "global_id": 5018, "ranged": true, "spawn_sec": 168}], "popups": ["アルラウネがいる間、\n全ての味方ユニットは\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フローガ", "text": "もう少しで森を抜けますね……。\nやはり魔力の乱れの中心は、\nこの方向で間違いなさそうです。", "face": "u878"}, {"name": "シュシュ", "text": "うっ……でもこの先に見えるのは……。", "face": "u656"}, {"name": "クゥイル", "text": "……さっきと同じ、世界樹の魔物みたいですね。\nもしかして、魔力の乱れと関係があるのでしょうか？", "face": "u702"}, {"name": "フローガ", "text": "魔力が乱れて、魔物がその影響を\n受けている可能性は大いにありますね……。\nそもそも――", "face": "u878"}, {"name": "バルバストラフ", "text": "魔王の魔力に影響されて、\n魔物達が活発になっておるわけじゃからな。", "face": "u63"}, {"name": "サイラス", "text": "大きな魔力の乱れが生じれば、\nこの辺りにいるはずのない魔物が、\nこうして姿を見せてもおかしくはないだろう。", "face": "u13"}, {"name": "フローガ", "text": "――先生方、私のセリフを取らないでくださいよ！", "face": "u878"}, {"name": "フローガ", "text": "とにかく、ここを通らないと目的地には向かえません。\n王子殿下、戦闘の指揮をお願いしますね！", "face": "u878"}]}, {"trigger": "battle", "at_sec": 58, "lines": [{"name": "シュシュ", "text": "わー！？　アルラウネまで出てきましたー！！", "face": "u656"}, {"name": "フローガ", "text": "あれがアルラウネですか！？\nマイコニドと同じく、\n身体を蝕む胞子をばらまくという！？", "face": "u878"}, {"name": "シュシュ", "text": "研究熱心なのは結構ですけどー！\nメモする暇があったら手伝ってくださいー！！\n早く倒さないと大変なんですからー！", "face": "u656"}, {"name": "フローガ", "text": "はっ、そうでした……！！\n王子殿下、こちらの敵はおまかせしますね。\nシュシュちゃん、私達はあちらの敵を！", "face": "u878"}]}, {"trigger": "end", "lines": [{"name": "フローガ", "text": "……ふぅ。\nちょっと実戦にも慣れてきましたよー。", "face": "u878"}, {"name": "サイラス", "text": "フローガ、魔力の乱れはどうなっている？", "face": "u13"}, {"name": "フローガ", "text": "えーっと……さっきの魔物を倒したおかげで、\nよりはっきりと方向が分かりましたよ！\nやはりこの森を抜けた先ですね！", "face": "u878"}, {"name": "フローガ", "text": "王子殿下、これも研究と平和のため。\nこの先もぐいぐい進んでいきましょう！", "face": "u878"}, {"name": "アンナ", "text": "……フローガさん、段々打ち解けてきたというか、\n化けの皮が剥がれてきましたね……。"}, {"name": "アンナ", "text": "ともかく、準備を整え次第、\n魔力の乱れを目指して進みましょう！"}, {"name": "ガード", "text": "――あれが我らの宿敵。\nあの姿を見て、何か思い出したことはあるか？", "face": "lee9399c5ee8f"}, {"name": "？？？", "text": "…………。", "face": "u908"}, {"name": "ガード", "text": "ふむ……まぁ良い……。\nでは、行くとしようか。", "face": "lee9399c5ee8f"}, {"name": "？？？", "text": "…………。", "face": "u908"}]}], "story_talk": true, "active": true}