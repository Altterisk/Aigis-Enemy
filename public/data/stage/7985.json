{"quest_id": 7985, "name": "策謀を巡らせ滅びを招く者", "description": "再び動き出したスルトと共に襲い来る\n亜神イコルを倒し、滅びの炎を打ち砕け！\n＜HPに継続ダメージ：大＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["HPに継続ダメージ：大"], "event": "神話の笛の音は、ただ遠く", "event_category": "History", "mission_id": 920198, "map_no": 4746, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ブロック不可"], "fixture": true, "hp": 40000, "attack": 3000, "base_hp": 40000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_range": 2000, "attack_speed": 1, "attack_wait": 30, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2137216, "special_effect_id": 1393, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 36243, "global_id": 9860, "ranged": true, "commands": {"raw": "DeleteMapEffectObject(\"obj_00\", 0); CreateMapEffectObject2(\"obj_01\", \"Laevateinn_stop\", 5, 0, 15, 490, 89);"}}, {"enemy_id": 2, "source": "local", "count": 17, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 2, "change_condition": 5, "master_id": 780, "global_id": 779, "to_condition": 5, "to_global_id": 780}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.299999952316284