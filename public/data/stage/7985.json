magic_defense": 20, "attack_range": 160, "attack_speed": 1, "attack_wait": 60, "attack_interval": 183, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133568, "race_id": 2, "change_to": 7, "missile_id": 685, "missile": {"speed": 8.0, "on_hit": {"kind": "DOT", "duration_f": 360, "interval_f": 30, "flat": 20, "expire_duration_only": true, "effect_name": "DebuffEffectMagma"}}, "master_id": 21325, "global_id": 1618, "ranged": true, "to_global_id": 1617, "spawn_sec": 135}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "attack": 250, "base_hp": 10000, "base_attack": 250, "damage_type": "magical", "armor_defense": 400, "magic_defense": 40, "attack_range": 160, "attack_speed": 1, "attack_wait": 60, "attack_interval": 185, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133552, "race_id": 2, "change_to": 6, "missile_id": 685, "missile": {"speed": 8.0, "on_hit": {"kind": "DOT", "duration_f": 360, "interval_f": 30, "flat": 20, "expire_duration_only": true, "effect_name": "DebuffEffectMagma"}}, "master_id": 21324, "global_id": 1617, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 13, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 9, "change_condition": 5, "master_id": 782, "global_id": 781, "to_condition": 5, "to_global_id": 782, "spawn_sec": 199}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 783, "global_id": 782, "ranged": true, "from_condition": 5}], "popups": ["亜神イコルは、\n一定範囲内のユニットから\nダメージを受けると\n攻撃したユニットへ反撃を行います。\n\n\n\n　　　　　　(1/2)", "亜神イコルの攻撃、反撃を受けた\n味方ユニットは3秒間、攻撃力と\n防御力と魔法耐性が0になります。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。\n　　　　　　(2/2)"], "dialogue": [{"trigger": "battle", "at_sec": 9, "lines": [{"name": "イコル", "text": "さぁ立て、スルト。\nお前の怒りはこんなものか。\nぼくを殺したいと、世界を焼滅したいと叫ぶがいい！", "face": "lc6dd7d706e77"}, {"name": "フローガ", "text": "王子、スルトの魔力が増大していきます！\nせっかく削った魔力は、また元通りに……！", "face": "u878"}, {"name": "イコル", "text": "炎の剣の灯火は、まだ消えていない。\nさぁ王子、滅びの炎を砕いてみせるがいい。", "face": "lc6dd7d706e77"}, {"name": "トラム", "text": "亜神イコル、あなたまで前線に出るつもり？", "face": "u1110a1"}, {"name": "イコル", "text": "常に最前線にいる戦神に言われたくはない。\n余興だろうと、手を抜くのは良くないだろう？", "face": "lc6dd7d706e77"}, {"name": "トラム", "text": "アスガルドの亜神は冗談が下手なのかしら。\nどこにあっても、謀略を巡らせるあなたの言葉を、\n誰が信じられるというの。", "face": "u1110a1"}, {"name": "イコル", "text": "…………信じた者も、いたさ。", "face": "lc6dd7d706e77"}, {"name": "ハリンヘイム", "text": "…………。", "face": "u1854a1"}, {"name": "トラム", "text": "……そうね。\n今のあなたは、昔とは違うと思っておきましょう。", "face": "u1110a1"}, {"name": "ハリンヘイム", "text": "何も、変わっていないじゃないですか。\nイタズラばかりして、誰かを困らせて、\nそれが滅びのきっかけを作ったというのに。", "face": "u1854a1"}, {"name": "トラム", "text": "……ハリンヘイム、彼女は――", "face": "u1110a1"}, {"name": "イコル", "text": "――銀腕、何も言うな。\n彼女のいうとおりだ。", "face": "lc6dd7d706e77"}, {"name": "イコル", "text": "ぼくは滅びを招いた大罪人で、\n世界に策謀を巡らす者で、今もなお、滅びの底から\n世界を引きずり落とさんとする者なのだから。", "face": "lc6dd7d706e77"}, {"name": "ハリンヘイム", "text": "王子、物質界の英雄、さん？\nイコルと戦うのなら、覚えておいてください。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "あの反撃の魔法陣は、一定距離までの攻撃に\n自動的に反撃を放つ術式です。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "そして彼女の魔術は、\n心を乱し、魂を惑わせ、あらゆる敵意への\n抵抗力を失わせる惑乱の術。", "face": "u1854a1"}, {"name": "ライノー", "text": "敵意への抵抗力……？\nまさか魔法への耐性まで？", "face": "u1086a1"}, {"name": "ハリンヘイム", "text": "えぇ、彼女の術はすべての防護の力を砕くのです。\nどうか、気をつけてください。", "face": "u1854a1"}]}, {"trigger": "end", "lines": [{"name": "イコル", "text": "――消えた、か。\nあれほど神々に怖れられた炎の剣も、\n本来解放すべき運命でない時に抜けばもろいものだ。", "face": "lc6dd7d706e77"}, {"name": "ハリンヘイム", "text": "イコル、私たちの勝ちです。\n抵抗をやめて――", "face": "u1854a1"}, {"name": "イコル", "text": "誰が、誰に勝ったと？", "face": "lc6dd7d706e77"}, {"name": "イコル", "text": "残念だよ、ハリンヘイム。\nアスガルドでも、きみの目は曇っていない方だと\nぼくは評価していたのだけどね。", "face": "lc6dd7d706e77"}, {"name": "イコル", "text": "勝ったのは、ぼくだ。", "face": "lc6dd7d706e77"}, {"name": "ハリンヘイム", "text": "……何を言って。", "face": "u1854a1"}, {"name": "イコル", "text": "人が神の座に至るにあたって、\n何が必要か、知っているかな。", "face": "lc6dd7d706e77"}, {"name": "アラン", "text": "…………神の試練。\nそれを乗り越えることが、神の座へ至る条件。", "face": "u1511a1"}, {"name": "イルドナ", "text": "あるいは神の命と共に、\n権能そのものを受け継ぐこと。", "face": "u1645a1"}, {"name": "イコル", "text": "ふふ、ああ、愉快だ。\nさぁ王子、共に神を殺しにいこう。", "face": "lc6dd7d706e77"}, {"name": "イコル", "text": "きみか、ぼくか、どちらが神を殺すのか。\nああ、今から楽しみだね、まったく。", "face": "lc6dd7d706e77"}, {"name": "イコル", "text": "それじゃあ、また会おう。\n次はもっと苛烈な試練を用意しておくよ。", "face": "lc6dd7d706e77"}]}], "active": true}