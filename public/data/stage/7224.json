: true, "spawn_sec": 76}, {"enemy_id": 8, "source": "local", "count": 5, "form_count": 2, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "change_to": 8, "master_id": 33304, "global_id": 6921, "to_global_id": 6922, "spawn_sec": 93}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["変異"], "hp": 15200, "attack": 1800, "base_hp": 15200, "base_attack": 1800, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 171, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115776, "special_effect_id": 704, "master_id": 33305, "global_id": 6922}, {"enemy_id": 10, "source": "local", "count": 12, "form_count": 1, "tags": ["忍者"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098896, "race_id": 16, "master_id": 436, "global_id": 435, "spawn_sec": 142}, {"enemy_id": 11, "source": "local", "count": 5, "form_count": 4, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 11, "master_id": 33300, "global_id": 6917, "to_global_id": 6918, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 145}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["変異", "狙う", "ブロック不可", "水面"], "hp": 15000, "base_hp": 15000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2115728, "race_id": 7, "special_effect_id": 702, "change_to": 12, "master_id": 33301, "global_id": 6918, "to_global_id": 4861}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["変異"], "hp": 15000, "attack": 1100, "base_hp": 15000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2115712, "race_id": 7, "special_effect_id": 309, "change_to": 13, "master_id": 31242, "global_id": 4861, "to_global_id": 4862}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["変異", "狙う", "ブロック不可", "水面"], "hp": 15000, "base_hp": 15000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2115728, "race_id": 7, "special_effect_id": 309, "change_to": 12, "master_id": 31243, "global_id": 4862}], "popups": ["絡繰り忍者は攻撃力300以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ソーマ", "text": "――ここが、温泉のお湯が\n湧き出している場所なんですね。", "face": "u23"}, {"name": "サオシュ", "text": "わっ……温泉宿より、\nここの方がお湯があつあつです……！\nどうして温度が違うんでしょう？", "face": "u968"}, {"name": "エマ", "text": "ふふっ、温泉宿に至るまでの道中で、\nお湯を心地よい温度まで冷ましているのです。\n人の子が編み出した知恵のひとつですね。", "face": "u1137a1"}, {"name": "ソーマ", "text": "……んっ、あれ？\nあっちのお湯、色がおかしくありませんか？", "face": "u23"}, {"name": "リズリー", "text": "むっ……この緑色、\n温泉宿に流れ込んでたのと同じ色だね。", "face": "u716"}, {"name": "レアン", "text": "つまり、そろそろ異物混入犯の\n居場所に近づいてきたってことだな。", "face": "u50"}, {"name": "カゲロウ", "text": "――待て。あれに見えるは、\n鋼の都にて相対した、絡繰り忍者ではないか？", "face": "u139"}, {"name": "ソーマ", "text": "身体をくぐつに置き換えた、\n腕利きの忍者でしたっけ……。", "face": "u23"}, {"name": "リズリー", "text": "奴が鋼の都から盗んだのは、\nゴブリン博士の「変異種」を生み出す研究資料。\nそしてこのお湯に触れた魔物が変異するってことは――", "face": "u716"}, {"name": "サオシュ", "text": "……こらしめましょう。\n絶対に関係あり、です。", "face": "u968"}, {"name": "レアン", "text": "さすがはガオレオンの部下だ、\n肝が据わっているな、サオシュ。\nさぁ王子、私たちも戦闘準備だ！", "face": "u50"}]}, {"trigger": "end", "lines": [{"name": "絡繰り忍者", "text": "――ほう。\nあの爆発を生き延びるとは、称賛に値する。", "face": "l2e284737c971"}, {"name": "ソーマ", "text": "あなたが、温泉に薬品を混入していたんですね？\nいったいどうしてこんな事を！", "face": "u23"}, {"name": "絡繰り忍者", "text": "そこなおなごよ、どうやら育ちが良いようだ。\nどんな相手でも質問すれば答えてくれる、\nそんな環境に生まれたのでござろうな。", "face": "l2e284737c971"}, {"name": "絡繰り忍者", "text": "それに比べ、そこな女将の冷酷なことよ。\n如何に拙者を破壊するか、\n先程よりずっと考えておるようだ。", "face": "l2e284737c971"}, {"name": "エマ", "text": "……若女将たち、油断してはいけませんよ。\nこの忍、並々ならぬ使い手のようです。", "face": "u1137a1"}, {"name": "サオシュ", "text": "は、はい……っ。\n油断禁物……ですねっ。", "face": "u968"}, {"name": "絡繰り忍者", "text": "――ふむ。\n並の戦士ではないと思っておったが……。\nもしや貴公らが、魔王殺しの王国軍にござるか。", "face": "l2e284737c971"}, {"name": "ソーマ", "text": "ず、ずいぶんと育ちがいいんですね！\n私だって、質問されても答えませんから！", "face": "u23"}, {"name": "絡繰り忍者", "text": "――笑止。\nこれは愉快な娘に一本とられた。\n褒美に拙者の術を、ひとつご覧にいれよう。", "face": "l2e284737c971"}]}, {"trigger": "route", "enemy_ids": [5], "lines": [{"name": "絡繰り忍者", "text": "――その顔、鋼の都にいた連中か。\nなるほど、良い戦士たちにござる。", "face": "l2e284737c971"}, {"name": "絡繰り忍者", "text": "だが、無意味にて候。\n貴公らの末路は爆死なり。", "face": "l2e284737c971"}, {"name": "レアン", "text": "なっ……消えた！？", "face": "u50"}, {"name": "リズリー", "text": "気をつけて、あいつ爆弾と入れ替わっていったよ！\nすぐにその辺りから退避してー！！", "face": "u716"}]}], "story_talk": true, "active": true}