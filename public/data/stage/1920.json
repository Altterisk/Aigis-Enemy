 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 171, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101136, "race_id": 7, "change_to": 19, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 828, "global_id": 827, "ranged": true, "to_global_id": 826, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 170}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "change_to": 18, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 827, "global_id": 826, "ranged": true}, {"enemy_id": 21, "source": "local", "count": 3, "form_count": 2, "tags": ["水棲", "狙う", "ブロック不可", "水面"], "hp": 230000, "attack": 1000, "base_hp": 230000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 800, "magic_defense": 10, "attack_range": 330, "attack_speed": 1, "attack_wait": 45, "attack_interval": 135, "move_speed": 1300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2132336, "race_id": 2, "special_effect_id": 623, "change_to": 21, "missile_id": 227, "missile": {"speed": 4.0}, "master_id": 34457, "global_id": 8074, "ranged": true, "to_global_id": 8075, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 213}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 230000, "attack": 3200, "base_hp": 230000, "base_attack": 3200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 162, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2132352, "race_id": 2, "change_to": 20, "master_id": 34458, "global_id": 8075}], "dialogue": [{"trigger": "start", "lines": [{"name": "ジョヴァンニ", "text": "――こいつぁひでぇ。\n急な水位上昇とは聞いてたが、街が沈んじまってるぞ。", "face": "u123"}, {"name": "デューオ", "text": "潮には満ち引きがあるものだけど、\nここまでの被害は初めて見たよ。\nこれじゃあ住民が避難しようにも逃げ場が……。", "face": "u594"}, {"name": "リーンベル", "text": "驚いている暇はないぞ、海賊。\n何のために自慢の船をここまで持ってきたんだ。\n――それでリバン殿、避難民がいる建物は？", "face": "u268"}, {"name": "リバン", "text": "こちらですわ！\n王国軍に先立って、海巫女の先輩が、\n背の高い建物に避難誘導をしてくれたそうですの。", "face": "u1062a1"}, {"name": "？？？", "text": "――その声は……。\nリバン！　良かった、無事にたどり着けたのですね。", "face": "u1419a1"}, {"name": "リバン", "text": "ムイル姉様、お久しぶりですわ♪\nあっ、王子様、こちらはムイル姉様で、私の先輩で――", "face": "u1062a1"}, {"name": "ムイル", "text": "リバン、自己紹介は後にしましょう。\nそれでいいですよね、王子殿下？\n今は緊急事態ですから。", "face": "u1419a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ムイル", "text": "逃げ遅れた方々はあちらの建物にいます。\n案内しますから、急いで船を――", "face": "u1419a1"}, {"name": "デューオ", "text": "おっと、ちょっと待ってムイル。\nこの水音は……波じゃないな……。\n王子！　魔物の群れがこちらに向かってるよ！", "face": "u594"}, {"name": "カリナ", "text": "上等！　皆、ここで魔物を迎撃するわよ！\n海軍なんかに後れを取らないようにね！", "face": "u1305a1"}, {"name": "リーンベル", "text": "競っている場合か！\n王子、逃げ遅れた民を守るためにも、\n後に引くことはできない。指揮は任せたぞ！", "face": "u268"}]}, {"trigger": "end", "lines": [{"name": "リーンベル", "text": "水位の上昇に魔物の群れ、か……。\nどうやらこれは、自然現象ではなさそうだな。", "face": "u268"}, {"name": "サブリナ", "text": "被害地域が局地的過ぎるしね。\nそのあたり、専門家の海巫女としてはどう？", "face": "u332"}, {"name": "ムイル", "text": "確かに、潮流に魔力を感じます。\nしかしとても微弱で、\nほとんど感知も出来ないような規模で……。", "face": "u1419a1"}, {"name": "ムイル", "text": "……あら？　あらあら？\n違う……これは微弱なのではなく、\nもしかして、高度な魔力操作で隠されているだけ……？", "face": "u1419a1"}, {"name": "ヴァレリー", "text": "これだけの水量を、魔力を隠しながら操作するだって？\nそんな芸当ができるのは、\n最高位の魔術師か、あるいは――", "face": "u12"}, {"name": "パレス", "text": "――亜神、くらいですよね。\nできれば外れて欲しい予想でしたが、\nやはりこの事件、亜神ポセイオスが……。", "face": "u129"}, {"name": "ポセイオス", "text": "グワッハッハッハ！　然り！\n待ちくたびれたぞ王子、未来の我が愛玩物よ。\n溺れる民どもは、存外足が遅いようじゃなぁ。", "face": "l7d6479df1740"}, {"name": "アンナ", "text": "……王子はあなたのものではありません。\n亜神ポセイオス、やはりあなたが関与していたのですね。", "face": "lb760d417b733"}, {"name": "ポセイオス", "text": "他の何者が、これほどの美しい景色を作るというのだ。\nそして、いずれ王子は我が配下となるのだぞ？\n結果が同じならば、既に我が所有物も同然じゃろう。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "しかしどうせなら、\n最初からこの光景を見せてやりたかったぞ。\n溺れる民の街が、より美しくなっていく様をなぁ。", "face": "l7d6479df1740"}, {"name": "王子", "text": "…………！", "face": "u1"}, {"name": "ポセイオス", "text": "グワッハハハッ！\nそうだ、その反抗的な目つきが実に良い！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "物質界を手に入れるついでと思っていたが、\nますます興味が湧いてきた。\nメシナよ、お前のつがいにどうだ？", "face": "l7d6479df1740"}, {"name": "メシナ", "text": "……お父さま、戯れがすぎますわ。\nこれは海の民のための、正義の戦いなのでしょう？", "face": "lf21ed14aa0fd"}, {"name": "メシナ", "text": "王子、乾いた地の――いえ、\n溺れる民の長たるあなたに、降伏勧告を。", "face": "lf21ed14aa0fd"}, {"name": "メシナ", "text": "決断の時ですわよ、王子。\n――我々がまだ、寛容である内に。", "face": "lf21ed14aa0fd"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 51, "params": [50]}, {"kind": "term", "influence": 48, "params": [50]}], "enemies": [{"enemy_id": 1, "hp": 5500, "damage_type": "physical", "armor_defense": 400, "pattern_id": 2132416}, {"enemy_id": 2, "hp": 13000, "attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132208}, {"enemy_id": 2, "form_index": 1, "hp": 13000, "attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132240}, {"enemy_id": 4, "hp": 24000, "attack": 900, "damage_type": "magical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132448}, {"enemy_id": 4, "form_index": 1, "hp": 24000, "attack": 1300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132464}, {"enemy_id": 6, "hp": 13000, "attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132208}, {"enemy_id": 6, "form_index": 1, "hp": 13000, "attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132240}, {"enemy_id": 6, "form_index": 2, "hp": 13000, "attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132208}, {"enemy_id": 6, "form_index": 3, "hp": 13000, "attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132240}, {"enemy_id": 12, "hp": 24000, "attack": 900, "damage_type": "magical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132448}, {"enemy_id": 12, "form_index": 1, "hp": 24000, "attack": 1300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132464}, {"enemy_id": 12, "form_index": 2, "hp": 24000, "attack": 900, "damage_type": "magical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132448}, {"enemy_id": 12, "form_index": 3, "hp": 24000, "attack": 1300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132464}, {"enemy_id": 18, "hp": 9000, "damage_type": "physical", "armor_defense": 600, "pattern_id": 2132432}, {"enemy_id": 19, "hp": 4200, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2101136}, {"enemy_id": 19, "form_index": 1, "hp": 4200, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2101920}, {"enemy_id": 21, "hp": 230000, "attack": 1000, "damage_type": "magical", "armor_defense": 800, "magic_defense": 10, "pattern_id": 2132336}, {"enemy_id": 21, "form_index": 1, "hp": 230000, "attack": 3200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "pattern_id": 2132352}]}, "active": true}