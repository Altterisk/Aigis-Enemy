{"quest_id": 1920, "name": "水没した街", "description": "急激な水位上昇に襲われ、水没した街。\n逃げ遅れた住民の救助に向かう王子たちに\n魔物の群れが牙を剥く。\n少ない足場を活用し、敵を撃退せよ！", "event": "ストーリーミッション11", "event_category": "Story", "mission_id": 100011, "map_no": 1140, "level": 100, "multiplier": 1.0, "charisma": 53, "capacity": 10, "enemies": [{"enemy_id": 1, "source": "local", "count": 32, "form_count": 1, "tags": ["鳥", "水棲"], "hp": 5500, "base_hp": 5500, "damage_type": "physical", "armor_defense": 400, "attack_speed": 1, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132416, "race_id": 11, "master_id": 34504, "global_id": 8121, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 30, "form_count": 2, "tags": ["水棲"], "hp": 13000, "attack": 750, "base_hp": 13000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132208, "race_id": 2, "change_to": 2, "master_id": 34429, "global_id": 8046, "to_global_id": 8048, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 10}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 13000, "attack": 750, "base_hp": 13000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132240, "race_id": 2, "change_to": 1, "master_id": 34431, "global_id": 8048}, {"enemy_id": 4, "source": "local", "count": 16, "form_count": 2, "tags": ["水棲", "ブロック不可"], "hp": 24000, "attack": 900, "base_hp": 24000, "base_attack": 900, "damage_type": "magical", "armor_defense": 200, "magic_defense": 5, "attack_range"