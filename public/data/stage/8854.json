{"quest_id": 8854, "name": "タルタロスの呪い", "description": "呪いの元凶を討つべく帝国軍は冥界を進む。\n＜白の皇帝の攻撃力、出撃時の初期\nHP減少＞＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["白の皇帝の攻撃力、出撃時の初期\nHP減少", "広域戦闘：敵味方の射程減少"], "event": "帝国タルタロス編", "event_category": "Empire", "mission_id": 940011, "map_no": 7375, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 2, "tags": ["アンデッド"], "hp": 3500, "base_hp": 3500, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_interval": 50, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142464, "special_effect_id": 1179, "change_to": 1, "change_condition": 2, "master_id": 35805, "global_id": 9422, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 118}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2, "spawned_on_death_by": [1, 6]}, {"enemy_id": 3, "source": "local", "count": 27, "form_count": 1, "tags": ["ステルス"], "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 40015, "global_id": 13632, "spawn_sec": 167}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 1, "tags": ["タルタロスの呪縛", "置物"], "fixture": true, "hp": 30000, "attack": 100, "base_hp": 30000, "base_attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "attack_speed": 1, "attack_wait": 90, "attack_interval": 222, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2168544, "special_effect_id": 2345, "master_id": 40011, "global_id": 13628, "spawn_sec": 175}, {"enemy_id": 5, "source": "local", "count": 16, "form_count": 1, "tags": ["タルタロスの呪縛"], "hp": 62000, "attack": 350, "base_hp": 62000, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 75, "attack_interval": 199, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2168528, "special_effect_id": 2344, "missile_id": 11, "master_id": 40010, "global_id": 13627, "ranged": true, "spawn_sec": 206}, {"enemy_id": 6, "source": "local", "count": 21, "form_count": 2, "tags": ["ステルス"], "hp": 35000, "attack": 750, "base_hp": 35000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 16, "attack_wait": 10, "attack_interval": 95, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159904, "change_to": 1, "change_condition": 2, "master_id": 40014, "global_id": 13631, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 206}, {"enemy_id": 7, "source": "local", "count": 9, "form_count": 1, "tags": ["ステルス"], "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113920, "master_id": 40016, "global_id": 13633, "spawn_sec": 237}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "tags": ["ステルス"], "hp": 360000, "attack": 2000, "base_hp": 360000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 80, "attack_speed": 20, "attack_wait": 60, "attack_interval": 211, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "pattern_id": 2122112, "special_effect_id": 259, "change_to": 8, "change_condition": 1, "missile_id": 39, "missile": {"splash": 133}, "master_id": 32446, "global_id": 6065, "variants": [{"tags": ["ステルス"], "hp": 360000, "attack": 2000, "base_hp": 360000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 80, "attack_range": 120, "attack_speed": 20, "attack_wait": 60, "attack_interval": 191, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "pattern_id": 2122128, "special_effect_id": 259, "missile_id": 39, "missile": {"splash": 133}, "master_id": 32447, "global_id": 6066, "ranged": true}], "spawn_sec": 239}], "popups": ["\n\n\n\n　――タルタロスの門へ続く道", "前線拠点は倒されると\n★の評価に影響します。", "発光するマスに配置した\nユニットは射程が\n上昇します。", "冥界のゴーストは、\n倒されると黒炎に変化します。", "深淵のシャドーはブロックされると、\n周囲の味方ユニットに\n範囲魔法攻撃を行います。\n\nまた、ブロックされていない時は\n遠距離攻撃の対象になりません。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――タルタロスの門へ続く道"}, {"name": "レオナ", "text": "……きりがないな。\nあれから何度、呪いの泥を討伐した？", "face": "u2600a1"}, {"name": "レオラ", "text": "呪いの泥って、無限に湧くのかしらねぇ？", "face": "u2601a1"}, {"name": "フルス", "text": "まるで、陛下をタルタロスへ近づけまいと、\n足止めをしているかのようですね……。", "face": "u2738a1"}, {"name": "白の皇帝", "text": "……すまん。\n足手まといになっているな。", "face": "u418"}, {"name": "ディアナ", "text": "――はぁ。\n陛下らしくもない。\nそんな顔をしないでください。", "face": "u624"}, {"name": "ディアナ", "text": "油断していると皇帝の座、簒奪しますよ。", "face": "u624"}, {"name": "白の皇帝", "text": "フッ……こんな状況の玉座でよければくれてやるが。", "face": "u418"}, {"name": "ディアナ", "text": "冗談が言えるならまだ大丈夫そうですね。\n――アネット、この先の状況は？", "face": "u624"}, {"name": "アネット", "text": "……泥が、また集まってくる。", "face": "u2740a1"}, {"name": "アネット", "text": "言葉はわからないけど、\n何かを叫んでいるように見える。", "face": "u2740a1"}, {"name": "白の皇帝", "text": "邪魔をするなら蹴散らすまでだ。", "face": "u418"}, {"name": "白の皇帝", "text": "全軍、俺に続け。\nこのまま一気に突破する。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "敵の勢いが収まったな。\n今のうちに、タルタロスの門まで一気に抜けるぞ。", "face": "u2600a1"}, {"name": "アネット", "text": "ルー、お疲れ様。\n泥だらけになっちゃったね。\nあとで綺麗にしてあげるから。", "face": "u2740a1"}, {"name": "フルス", "text": "私も服が泥だらけです……。\n帰ったら絶対にお風呂に長時間浸かりますからね……。", "face": "u2738a1"}, {"name": "ディアナ", "text": "ふたりとも、気を抜かないように。\nここから先は、何が起こるかわかりません。", "face": "u624"}, {"name": "カルペム", "text": "……やっぱり、タルタロスの\n門の方から魔力が漏れ出してる。", "face": "u2401a1"}, {"name": "ヘカティエ", "text": "以前、ハイドースが門を一瞬だけ開いた影響が\nまだ残っているのかしら。", "face": "u1226a1"}, {"name": "カルペム", "text": "うぅん、あの時よりも、魔力が濃くなってる。\n何かが明確に、冥界――そして物質界に\n手を伸ばそうとしているんだと思うわ。", "face": "u2401a1"}, {"name": "白の皇帝", "text": "向こうから姿を見せてくれれば話は簡単だが……。", "face": "u418"}, {"name": "サザンカ", "text": "まぁまぁ、門なんてドカンと叩き壊せば、\n黒幕のところまで一直線に――", "face": "u1347a1"}, {"name": "？？？", "text": "――それは、おやめなさい。", "face": "u2739a1"}, {"name": "アネット", "text": "……！　ルー、下がって。\n誰か、いる……この先に……。", "face": "u2740a1"}, {"name": "？？？", "text": "（私が目覚めたのは、偶然ではなかったらしい。\nまさか、タルタロスの門が開く日が来るとは）", "face": "u2739a1"}, {"name": "？？？", "text": "（しかし、連中は何者なのか……。\n永遠の牢獄を暴かんとするのなら、この手で――）", "face": "u2739a1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 20, "params": [150]}, {"kind": "term", "influence": 12, "params": [200]}, {"kind": "term", "influence": 21, "params": [0, 60]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "hp": 3500, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2142464}, {"enemy_id": 1, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 3, "hp": 5000, "attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "pattern_id": 2097856}, {"enemy_id": 4, "hp": 30000, "attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "pattern_id": 2168544}, {"enemy_id": 5, "hp": 62000, "attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2168528}, {"enemy_id": 6, "hp": 35000, "attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2159904}, {"enemy_id": 7, "hp": 12000, "attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "pattern_id": 2113920}, {"enemy_id": 8, "hp": 360000, "attack": 2000, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 80, "pattern_id": 2122112}]}, "active": true}