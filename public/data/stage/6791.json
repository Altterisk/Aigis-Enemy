90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "master_id": 423, "global_id": 422}], "spawn_sec": 198}], "popups": ["ダークエルフナイトは\nダメージを受けると\n攻撃したユニットへ反撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オリヴィエ", "text": "――アリシアさん、ベルナさん、\n会場はこちらですよ。", "face": "u827"}, {"name": "アリシア", "text": "わぁ……きらきらしていて、\nとっても素敵ですね……！", "face": "u828"}, {"name": "ベルナ", "text": "アリシアのきらきらっぷりも、\n中々負けてないけどね？", "face": "u826"}, {"name": "オリヴィエ", "text": "ふふふ、お二人とも、とっても可愛いですよ？\nそれより、急に妖精郷のお祭りに、\nお二人を呼び出してしまって本当にすみません……。", "face": "u827"}, {"name": "オリヴィエ", "text": "妖精郷と王国の友好のために、\nぜひ合同でお祭りをと、\n妖精郷の人々が言って聞かなくてですね……。", "face": "u827"}, {"name": "アリシア", "text": "いえいえ、おかげでこんな\n素敵なお祭りに参加できましたから。", "face": "u828"}, {"name": "ベルナ", "text": "そうそう。普段はなかなか、\n女の子らしい可愛い格好って、\n縁遠いものだからねぇ……。", "face": "u826"}, {"name": "アリシア", "text": "ふふ、武器を振り回して戦うのが、\n私達の本分みたいなものですからね。", "face": "u828"}, {"name": "オリヴィエ", "text": "お二人とも戦士である前に、\n可愛い女の子なんですよ？\nですから今日は、武器は置いて――", "face": "u827"}, {"name": "スプラ", "text": "――た、大変です！\nダークエルフ達が襲撃してきました……！！", "face": "u355"}, {"name": "オリヴィエ", "text": "……武器は、置けそうにないですね。\nドレスを汚さないように戦わないと……。", "face": "u827"}, {"name": "アリシア", "text": "そう、みたいですね。\n王子にドレスの裾を汚しているところを、\n見せるわけにはいきませんから！", "face": "u828"}, {"name": "ベルナ", "text": "うんうん。可愛いドレスには、\n可愛いドレスなりの戦い方があるって見せてあげよう。\n私はあっちを抑えるから、ここはお願いね！！", "face": "u826"}, {"name": "ダークエルフ", "text": "――『祝福の魔力糸』はどこだ！！\n我らに『祝福の魔力糸』をよこせ……！！", "face": "l36d443ad9979"}, {"name": "アリシア", "text": "王子、こちらの道は私が抑えます。\nこのドレスは、絶対に渡しません！！", "face": "u828"}, {"name": "オリヴィエ", "text": "では、こちらの道は私が。\n王子、適宜私達にも指示をくださいね！", "face": "u827"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "なんだ……何故この女達はこんなに強いんだ！？\nはっ、まさかそのドレスは魔力糸で編まれ――", "face": "l36d443ad9979"}, {"name": "アリシア", "text": "――恋する乙女は強いんです！", "face": "u828"}, {"name": "オリヴィエ", "text": "えぇ、簡単にこのドレスを奪えるなどと、\n決して思わないことですね。", "face": "u827"}, {"name": "ダークエルフ", "text": "くそっ、そんな理屈は聞いたことがないぞ！\nえぇい、撤退！　撤退だ！！", "face": "l36d443ad9979"}, {"name": "ベルナ", "text": "――ふぅ、あっちのダークエルフも\n大方撤退していったよ。\nこれで一段落かな？", "face": "u826"}, {"name": "オリヴィエ", "text": "すみません、王国の皆さんを、\nダークエルフとの戦いに巻き込んでしまって……。", "face": "u827"}, {"name": "アリシア", "text": "これで妖精郷とお祭りを守れたのですから、\n謝る必要なんてありませんよ？", "face": "u828"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "オリヴィエ", "text": "……ふふ、ありがとうございます。\nそれでは、お祭りの続きをしましょうか。", "face": "u827"}, {"name": "オリヴィエ", "text": "めいっぱい、楽しんでいってくださいね？", "face": "u827"}]}], "active": true}