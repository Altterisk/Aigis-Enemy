esist": 1000, "transform_resist": 1000, "pattern_id": 2103824, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 480, "global_id": 479, "ranged": true, "spawn_sec": 112}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102704, "master_id": 393, "global_id": 392, "spawn_sec": 123}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102752, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 394, "global_id": 393, "ranged": true, "spawn_sec": 123}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 500, "base_hp": 2800, "base_attack": 500, "damage_type": "magical", "armor_defense": 700, "magic_defense": 40, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 241, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102800, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 397, "global_id": 396, "ranged": true, "spawn_sec": 135}], "dialogue": [{"trigger": "start", "lines": [{"name": "グレーターデーモン", "text": "うぅむ、困ったものだねぇ。\n折角新たな暗黒騎士達を作り出したというのに、\n彼らを率いてくれる者が中々いないねぇ。", "face": "l75b6090fa7ae"}, {"name": "グレーターデーモン", "text": "どこかに、程よく絶望に染まった\n心地良い魂の持ち主はいないものかね……おや？", "face": "l75b6090fa7ae"}, {"name": "？？？", "text": "――水霊達よ、我が呼び声に応え、\n豊穣たる祈りの雨となりて……あ、蝶ちょ……\n……あ、あぁ！？", "face": "u502"}, {"name": "？？？", "text": "あぁ……お水さん帰っていっちゃったぁ。\nうーん、もっと精神力を保たないと……\n……よぉっしもう一回！　頑張りますよー！", "face": "u502"}, {"name": "グレーターデーモン", "text": "……ふむ、そこのお嬢さん。何やら\n力を求めているようだね？　どうだい、\nワシと共に来れば君の望む力を……", "face": "l75b6090fa7ae"}, {"name": "？？？", "text": "……ひゃ、ひゃあっ！？　ま、魔物！？", "face": "u502"}, {"name": "グレーターデーモン", "text": "如何にも。人間の言葉だとワシは「魔物」だね。\n同時に、力を与える事ができる神だと呼ぶ者もいる。", "face": "l75b6090fa7ae"}, {"name": "グレーターデーモン", "text": "ワシが力を与えれば、\n君の大好きなお水さんも、操り放題。\nウン、楽しい未来が待っているよ。", "face": "l75b6090fa7ae"}, {"name": "？？？", "text": "い、嫌です……そんな力、要りません！\n水霊はお話をして、心をつなげて初めて力を\n貸してくれるんです！　操るなんて、絶対しません！", "face": "u502"}, {"name": "グレーターデーモン", "text": "ふぅむ。\n素材は悪くないと思ったけど、\n君には絶望が足りないみたいだね。", "face": "l75b6090fa7ae"}, {"name": "グレーターデーモン", "text": "よし、暗黒騎士達よ。\nあのお嬢さんをなぶって差し上げなさい。\n「絶望」を感じるくらいにね。", "face": "l75b6090fa7ae"}, {"name": "？？？", "text": "…………な、なぶる……？\nそ、そんな……。", "face": "u502"}, {"name": "グレーターデーモン", "text": "さて、ワシは引き続き良い素材でも探すべく、\n辺りを散歩でもしておこうかね。", "face": "l75b6090fa7ae"}, {"name": "？？？", "text": "だ、だれか……誰か助けて……――", "face": "u502"}, {"name": "ケイティ", "text": "―――王子、こちらです！\nデーモンの姿を見かけたと報告があったのは！", "face": "u114"}, {"name": "アンナ", "text": "……！？　王子、どうやら\n女の子が襲われているようです！\n急いで助けましょう！", "face": "lfeb669e7258e"}, {"name": "？？？", "text": "……え？　王子……さま……？\nふ……ふぇ……良かったぁ……。\nもう、駄目かと思いました……。", "face": "u502"}, {"name": "アンナ", "text": "もう心配ありません。\nここは我々にお任せください。"}, {"name": "？？？", "text": "あ、あの……わ、私も……私も戦わせてください！\nこう見えて、お水さんの力をかりる事が出来るんです！\n少しは……お役に立てるはずです！", "face": "u502"}, {"name": "？？？", "text": "硬い鎧も、私のお水さんなら\n貫く事ができるはずですので……王子さま、\nお水さんの力を使う時は、私にご指示をください！", "face": "u502"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "よかった、なんとか退ける事ができました。\nありがとうございました！", "face": "u502"}, {"name": "セノーテ", "text": "っと、す、すみません、\n自己紹介が遅れてしまいました。\n私、セノーテって言います！　", "face": "u502"}, {"name": "アンナ", "text": "セノーテさん、よろしくお願いします。\nそれにしてもすごい力ですね！\nまるで、水が意思を持っている様でした。"}, {"name": "セノーテ", "text": "ありがとうございます。まだまだ\n未熟ではあるのですが、お水さんと交信して\nちょっとだけ力をかりる事が出来るんです。", "face": "u502"}, {"name": "ケイティ", "text": "セノーテさんは、一体ここで何を？", "face": "u114"}, {"name": "セノーテ", "text": "あの……実は、平和の為に戦う王子さま達を、\nずっと探していたんです……皆さんが、そうですよね？\n助けに来てくれた時、絶対そうだと思いました！", "face": "u502"}, {"name": "ケイティ", "text": "はい、確かに我々は王国の者ですが。\n何か、ご用事でも？", "face": "u114"}, {"name": "セノーテ", "text": "わたし、王子さま達の事をお水さん達からきいて、\nいつかは王子さまのお役に立てればと、\nずっと思ってたんです……。", "face": "u502"}, {"name": "セノーテ", "text": "今はまだ特訓中の身ではありますが、もっともっと\n頑張りますので……どうかその時が来たら、\nわたしも共に、戦わせて頂けないでしょうか……！", "face": "u502"}, {"name": "アンナ", "text": "そのお気持ち、大変嬉しく思います。\nはい、その際にはぜひセノーテさんの御力を\n貸していただければと。"}, {"name": "セノーテ", "text": "……は、はい！　ありがとうございます！\n私、もっともっと精進してまいりますので！\n……ぜひ、よろしくお願いします！", "face": "u502"}]}], "active": true}