{"quest_id": 6153, "name": "水の声を聞く者", "description": "デーモン出現の報を受け赴く王子たち。\nデーモンに襲われる水霊使いと共に、\n迫る暗黒騎士とデーモンを討伐せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "スカイ・レーサー", "event_category": "History", "mission_id": 920092, "map_no": 3994, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "hp": 52000, "attack": 5000, "base_hp": 52000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 40, "attack_speed": 50, "attack_wait": 50, "attack_interval": 245, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2098736, "race_id": 3, "master_id": 30369, "global_id": 3988, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 12, "form_count": 1, "tags": ["アーマー"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 20, "attack_interval": 166, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104576, "master_id": 803, "global_id": 802, "spawn_sec": 19}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 24}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 10