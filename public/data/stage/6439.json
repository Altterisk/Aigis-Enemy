n": 2, "master_id": 30972, "global_id": 4591, "to_condition": 2, "to_global_id": 403, "spawn_sec": 111}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 2, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "change_to": 1, "change_condition": 2, "master_id": 30983, "global_id": 4602, "to_condition": 2, "to_global_id": 403, "spawn_sec": 141}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 2, "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "magical", "armor_defense": 500, "attack_speed": 90, "attack_wait": 10, "attack_interval": 181, "move_speed": 350.0, "dot_rate": 1.75, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098560, "race_id": 2, "change_to": 1, "change_condition": 2, "master_id": 30986, "global_id": 4605, "to_condition": 2, "to_global_id": 403, "spawn_sec": 146}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "magical", "armor_defense": 20, "attack_range": 200, "attack_speed": 70, "attack_wait": 50, "attack_interval": 161, "move_speed": 450.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102352, "race_id": 16, "change_to": 1, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30989, "global_id": 4608, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 148}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "……王子、敵の姿が見えました。", "face": "l0a243861aec8"}, {"name": "ケイティ", "text": "砦が魔物によって攻囲されているという報告は\n本当だったのですね。", "face": "u114"}, {"name": "レーレン", "text": "ゴブリンに竜人の兵、それと巨人族か。\nなかなか珍しい取り合わせだなー。", "face": "u614"}, {"name": "メーリス", "text": "あれ、レーレン先生？\nどうしてここに？", "face": "u78"}, {"name": "レーレン", "text": "にひひ、今日は授業がない日だから\n可愛い生徒たちの勇姿を見に来ちゃったぜ。", "face": "u614"}, {"name": "ネーニャ", "text": "えへへ、なら頑張っていいとこ見せなくちゃね！", "face": "u135"}, {"name": "兵士", "text": "――王子、報告がございます。　", "face": "u6"}, {"name": "兵士", "text": "先ほど敵と交戦した斥候たちによると、\n倒したゴブリンが別の魔物に変化したとのこと。", "face": "u6"}, {"name": "レーレン", "text": "なにっ！？\nじゃあ、別の魔物がゴブリンに化けてたってことか？", "face": "u614"}, {"name": "ケイティ", "text": "別の魔物に化ける魔物……まさか！", "face": "u114"}, {"name": "アンナ", "text": "王子、敵が攻めてきます！\n砦の門に攻め寄られる前に撃退しましょう！", "face": "l0a243861aec8"}]}, {"trigger": "end", "lines": [{"name": "ドッペルゲンガー", "text": "くそ……やっとギガースに化けられたというのに、\nこの程度の砦も占拠できずに終わるとは……。", "face": "l9a64529fd65d"}, {"name": "ケイティ", "text": "……やはり、ドッペルゲンガーでしたか。", "face": "u114"}, {"name": "ロイ", "text": "しかし、ギガースに化けるようになるとは。\nいよいよ厄介な敵になってきましたな。", "face": "u11"}, {"name": "レーレン", "text": "おいおいおいおい、聞いてねーぜ！\nみんな、いつもあんな強そうなヤツらと戦ってたのかよ！", "face": "u614"}, {"name": "アンナ", "text": "……魔物たちは日々、その強さを増しています。", "face": "l0a243861aec8"}, {"name": "アンナ", "text": "だからこそ、\n魔物と戦うことを決意した私たちもまた\n常に向上していかなければなりません。", "face": "l0a243861aec8"}, {"name": "アンナ", "text": "軍学校の創設も、そのための施策のひとつなのです。"}, {"name": "レーレン", "text": "……そっか。\nへへ……責任重大だな、先生って。", "face": "u614"}, {"name": "レーレン", "text": "……あたしの国もさ、魔物に滅ぼされたんだ。\n科学技術と経済の発展ばっかにかまけて、\n国防がスッカスカになっちまってね。", "face": "u614"}, {"name": "メーリス", "text": "先生……。", "face": "u78"}, {"name": "レーレン", "text": "ま、過ぎたことを悔やんでもしょうがないさ。\nそれに、故郷を離れたおかげで\nこうして可愛い教え子たちと出会えたしな♪", "face": "u614"}, {"name": "ジョヴァンニ", "text": "ちょ、先生……頭撫でんのはやめてくれよ。\nセットが崩れちまうだろ。", "face": "u123"}, {"name": "レーレン", "text": "あはは、ホントに可愛いなぁ。\n講師って立場とはいえ、先生になって正解だったぜ。", "face": "u614"}, {"name": "レーレン", "text": "だが、そうなるとやっぱり\n可愛い教え子ばっかを危険な戦場に立たせて\n自分だけ引きこもってるわけにはいかねーな。", "face": "u614"}, {"name": "レーレン", "text": "ってわけで王子、\n授業がない日はあたしも戦場に連れてってくれよな！", "face": "u614"}]}], "story_talk": true, "active": true}