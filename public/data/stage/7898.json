ssile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 35967, "global_id": 9584, "spawn_sec": 132}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 154}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 717, "global_id": 716, "spawn_sec": 155}, {"enemy_id": 19, "source": "local", "count": 5, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 157}, {"enemy_id": 20, "source": "local", "count": 5, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 159}, {"enemy_id": 21, "source": "local", "count": 5, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 160}, {"enemy_id": 22, "source": "local", "count": 5, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 162}], "popups": ["\n\n\n　　　――少し前のこと。", "サテラの攻撃は、\n人間系の味方ユニットに対する\nダメージが30％アップします。\n\nまたサテラの攻撃を受けた\n味方ユニットは\n5秒間、防御力が減少します。\n　　　　　　(1/2)", "この効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。\n\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "おぉ、王子よ！　来てくれタか！\n……頼むッ！　ドウカ助けてクレ……！！", "face": "l2bdcef4785ee"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "ソーマ", "text": "一体何があったのですか？", "face": "u23"}, {"name": "ゴブリン博士", "text": "メカゴブリンクイーン様が、\n異世界の娘……サテラ殿を食客として迎えたノダが……。", "face": "l2bdcef4785ee"}, {"name": "ゴブリン博士", "text": "……意気投合してしまってナ。", "face": "l2bdcef4785ee"}, {"name": "ソーマ", "text": "意気投合、ですか……。", "face": "u23"}, {"name": "ゴブリン博士", "text": "問題は、サテラ殿がガーディアンナル\n強力なゴーレムの一種を所持していたコト……。", "face": "l2bdcef4785ee"}, {"name": "ゴブリン博士", "text": "以来、ワタクシに、\nガーディアンの技術を用いた\n「ゴブリンガーディアン」を開発セヨと……！", "face": "l2bdcef4785ee"}, {"name": "ゴブリン", "text": "ギャギャ……フミンフキュー……。", "face": "l6c227aea162d"}, {"name": "サテラ", "text": "ふむ、ゴブリンたちも中々筋がいい。\nこれなら十分使い物にな――ん？　何だ？", "face": "u1760a1"}, {"name": "シィル", "text": "サテラさん！\nもう、探したんですよ！", "face": "u581"}, {"name": "サテラ", "text": "それはこっちのセリフだ。\nゴブリンの人海戦術で、\nランスたちを探してもらっていたんだ。", "face": "u1760a1"}, {"name": "アンナ", "text": "どうやら、すれ違っていたみたいですね。\nではサテラさん、こちらに合流して――", "face": "lfe3fe8d5cb21"}, {"name": "メカゴブリンクイーン", "text": "――おーっほっほっほ！\n王子、良いところに来たわねぇ！", "face": "l1b2a07496142"}, {"name": "メカゴブリンクイーン", "text": "この新型ゴブリンガーディアン、\n試してみたくはなぁい？", "face": "l1b2a07496142"}, {"name": "メカゴブリンクイーン", "text": "サテラの世界のガーディアンを、\nこの世界の技術で再現した新型よぉ！", "face": "l1b2a07496142"}, {"name": "ソーマ", "text": "あ、あのぉ、今はそれどころでは……。", "face": "u23"}, {"name": "ゴブリン", "text": "ギャギャ、ソージューカイシ！\nガコンガコーン！", "face": "l6c227aea162d"}, {"name": "ゴブリン博士", "text": "アァッ、コラ！\n操縦席に勝手に乗るんじゃナイ！", "face": "l2bdcef4785ee"}, {"name": "メカゴブリンクイーン", "text": "ふふふ、いいじゃない。\nさぁこのまま模擬戦よぉ！", "face": "l1b2a07496142"}, {"name": "サテラ", "text": "ん、なんだ、戦闘か？\nよし、サテラも手伝ってやろう。", "face": "u1760a1"}, {"name": "サテラ", "text": "硬くて強い、ゴブリンガーディアンfeat,サテラ！\n――発進だ！　ふはははははははは！", "face": "u1760a1"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン", "text": "プスン……ガーディアントマッタ……。", "face": "l6c227aea162d"}, {"name": "メカゴブリンクイーン", "text": "試作型でここまでやるなんて、\nサテラ、あなたの技術はなかなかのものねぇ。", "face": "l1b2a07496142"}, {"name": "メカゴブリンクイーン", "text": "どうかしら、このまま盟友として、\nゴブリン軍団に与する気はなぁい？", "face": "l1b2a07496142"}, {"name": "サテラ", "text": "いや、それはできない。\n使徒たるランスを放ってはおけないしな。", "face": "u1760a1"}, {"name": "メカゴブリンクイーン", "text": "そう……。\nでもこの世界を訪れた時には、遊びにいらっしゃいな。\nお茶とお菓子くらいはごちそうするわよ？", "face": "l1b2a07496142"}, {"name": "サテラ", "text": "うむ、約束しよう。\nゴブリンガーディアンの開発、励むといい。", "face": "u1760a1"}, {"name": "ゴブリン博士", "text": "……か、開発は、続く、ノカ……。", "face": "l2bdcef4785ee"}]}], "active": true}