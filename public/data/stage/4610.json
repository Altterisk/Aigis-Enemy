08, "race_id": 8, "change_to": 11, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 444, "global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "spawn_sec": 6}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 13, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 102}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "で、伝令ッ！\nオークの本隊が到着した模様！\nその規模……先の部隊とは比較になりません！", "face": "lfcf030e255fb"}, {"name": "アンナ", "text": "……王子。\nオーク軍本隊は、予想をはるかに超える戦力を\n有しているようです。撤退なさいますか……？", "face": "l878f496a6c7b"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "アンナ", "text": "撤退はしない……ですか。\n王子ならそう言うと思っていました。\n私も、最後までお供させていただきます。", "face": "l878f496a6c7b"}, {"name": "ユリアン", "text": "そもそもオークの狙いが王子なんだ。\nここで逃げても、いつかは戦わなきゃならねえ。\nっつーわけで、俺様も付き合ってやるぜ、王子。", "face": "u7"}, {"name": "ケイティ", "text": "レーゼルさん……オーク本隊の襲来を\n報告しに帝国へと戻って頂けますか？\nもしかしたら援軍が望めるかも知れません。", "face": "u114"}, {"name": "レーゼル", "text": "私をここから逃がそうという心遣いは不要だ。\n今さら援軍要請をしたところで間に合わない\nことくらい、貴方達なら分かるはずだ。", "face": "u371"}, {"name": "レーゼル", "text": "それに……最後まで戦いたいんだ。\n独りだった私の為に力を貸してくれた、\n貴方達と共に、戦い抜きたいんだ……。", "face": "u371"}, {"name": "？？？", "text": "――少し会わない間に、\n随分と優しい目をするように\nなったのですね、レーゼルさん。", "face": "u373"}, {"name": "レーゼル", "text": "え、エリアス！？\nなぜ帝国の治癒士がこんな場所に……？\nまさか……ついに、援軍が到着したのか！？", "face": "u371"}, {"name": "エリアス", "text": "お待たせして、本当にすみませんでした。\n既に、後陣の準備は完了しています。\nこれより帝国によるオーク討伐を再開します！", "face": "u373"}, {"name": "兵士", "text": "伝令！\nオーク軍団の接近を確認しました！\n皆さん、臨戦態勢をとってください！", "face": "lfcf030e255fb"}, {"name": "ユリアン", "text": "絶好のタイミングだぜ、まったく。\nっしゃあ！　こっからが本番だぜ。\n王子、レーゼル！　オークをぶっ倒すぞ！", "face": "u7"}]}, {"trigger": "end", "lines": [{"name": "エリアス", "text": "敵の掃滅を確認しました。\nレーゼルさん、そして王子軍の皆さん、\nお疲れ様でした。", "face": "u373"}, {"name": "アンナ", "text": "えっと、エリアスさん……でしたよね？\nご助力いただき、ありがとうございます。\nこのまま共にオークと戦って頂けるのですか？", "face": "l878f496a6c7b"}, {"name": "エリアス", "text": "申し訳ありません。\n王子軍との共闘は、我ら帝国兵にとっては\nあまり好ましいことではないのです。", "face": "u373"}, {"name": "エリアス", "text": "見たところ、王子軍の皆さんはかなり疲弊\nしているようですし……悪いことはいいません。\nこのままこの地から撤退して頂けませんか？", "face": "u373"}, {"name": "ユリアン", "text": "バカ言ってんじゃねえ！　今さらのこのこ\nやってきた帝国なんかに任せておけるかよ！\n王子、さっさとオークの本陣へ行くぞ！", "face": "u7"}, {"name": "アンナ", "text": "あ、あの……。\nレーゼルさんは、どうなさるつもりですか？", "face": "l878f496a6c7b"}, {"name": "エリアス", "text": "レーゼルさんは先の戦いで腕を負傷しています。\n既に猟銃を握ることすらできない状態です。\nこれ以上の戦闘は私が許可しません。", "face": "u373"}, {"name": "レーゼル", "text": "と、いうわけだ……。\nすまない、最後まで共に戦うつもりでいたが、\nこのままでは足手まといになるのは明白だ。", "face": "u371"}, {"name": "レーゼル", "text": "……だが、これからも貴方達が\n困った時には駆けつけるつもりでいる。\n私の力が必要ならいつでも呼んでくれ……。", "face": "u371"}, {"name": "エリアス", "text": "何をこそこそ話しているのですか……？\nレーゼルさんには早急な治療が必要なのです。\n早く医療班のテントまで来て下さい。", "face": "u373"}, {"name": "レーゼル", "text": "すまない、もう行かなくてはいけないようだ。\nみんな、今まで本当にありがとう……。\n王子……絶対に生きて帰ってくるんだぞ。", "face": "u371"}]}], "active": true}