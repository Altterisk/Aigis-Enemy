l", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 30}, {"enemy_id": 5, "source": "local", "count": 7, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 83}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 99}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 35000, "attack": 1800, "base_hp": 35000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 84, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111568, "master_id": 30601, "global_id": 4220, "spawn_sec": 99}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 900, "base_hp": 40000, "base_attack": 900, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 190, "attack_speed": 50, "attack_wait": 10, "attack_interval": 86, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103488, "race_id": 3, "special_effect_id": 232, "change_to": 8, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 449, "global_id": 448, "ranged": true, "variants": [{"hp": 40000, "attack": 2200, "base_hp": 40000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 70, "attack_speed": 50, "attack_wait": 30, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103504, "race_id": 3, "master_id": 450, "global_id": 449}], "spawn_sec": 101}], "dialogue": [{"trigger": "start", "lines": [{"name": "ユリアン", "text": "だいぶメダルも集まってきたな。\n結構良いペースなんじゃねーか？", "face": "u7"}, {"name": "バシラ", "text": "そうですね。このまま行けばきっと優勝できます！\n優勝目指して頑張りましょう！\n……あれ？　崖の上に……人影？", "face": "u28"}, {"name": "？？？", "text": "……。", "face": "u713"}, {"name": "ケイティ", "text": "バシラさん、どうかされたのですか？", "face": "u114"}, {"name": "バシラ", "text": "あ、いえ。崖の上に人影らしきものが……\n……いませんね。すみません、\nどうやら気のせいだったみたいです。", "face": "u28"}, {"name": "兵士", "text": "報告！　デーモン達がこちらに向かってる模様！", "face": "l4517b1f200b9"}, {"name": "ユリアン", "text": "次の相手はデーモンの連中か。\n上等じゃねーか、かかってきな！", "face": "u7"}, {"name": "バシラ", "text": "防御力の低いデーモン相手でしたら、\n私達弓兵にお任せ下さい！\nどんどん射抜いちゃいますよ！", "face": "u28"}, {"name": "ケイティ", "text": "あの緑色の半身をした個体は、\n麻痺を使うデーモンです。\n王子、慎重な指示をお願いします。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "（くっ……物質界の人間とは言え、\nやはり一筋縄ではいかないようだな。\n優勝するには別の方法を考えた方が得策か……）", "face": "u713"}, {"name": "ユリアン", "text": "――お、連中どうやら引いていくようだぜ。", "face": "u7"}, {"name": "バシラ", "text": "ふぅ、何とか乗り切る事が出来ました。\nそれにしても……あの女性は一体。", "face": "u28"}, {"name": "ケイティ", "text": "バシラさんも気づきましたか。\nデーモンと共に、何やら女性の姿が見えました。\n共闘していたように見えましたが……。", "face": "u114"}, {"name": "バシラ", "text": "……もしかして、デーモンの\n奴隷にされているのではないでしょうか！", "face": "u28"}, {"name": "ケイティ", "text": "事情が判らない限り何とも言えませんが、\nその可能性もありえるかと。", "face": "u114"}, {"name": "アンナ", "text": "……もしそうだとすれば、\n見過ごす事はできませんね。", "face": "l831eb29f1552"}, {"name": "アンナ", "text": "次に出会った時は、\n何か事情が聞ければよいのですが。", "face": "l831eb29f1552"}, {"name": "ケイティ", "text": "そうですね……ひとまず、\n周囲に敵影は見当たらないようです。\n次の戦いに備え、態勢を整えましょうか。", "face": "u114"}]}], "story_talk": true, "active": true}