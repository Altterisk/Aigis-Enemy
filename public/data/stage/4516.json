0, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105136, "race_id": 14, "master_id": 603, "global_id": 602, "from_condition": 5}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 150, "attack_speed": 70, "attack_wait": 80, "attack_interval": 206, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104064, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 496, "global_id": 495, "ranged": true, "spawn_sec": 132}], "dialogue": [{"trigger": "start", "lines": [{"name": "バシラ", "text": "あんなところに虎が……！？\nきっと何処からか迷い込んだんだわ。\nあんなに沢山だなんて、どうしよう……。", "face": "u28"}, {"name": "ルナール", "text": "そんなに慌ててどうしたの、バシラ？\n……あーなるほど、迷い虎かぁ。\n大丈夫、虎狩りならあたしに任せてちょうだい！", "face": "u300"}, {"name": "ルナール", "text": "ここにこうしてエサをまいてっと……。\nうん！　これで準備はオーケーだよ！\nうまく時間を稼いで、虎を各個撃破するんだ。", "face": "u300"}, {"name": "ベラ", "text": "おおっ！？\nなんだか面白そうなことしてるなっ？\n魔物倒すのか？　いいぞっ、力貸してやるっ！", "face": "u16"}, {"name": "バシラ", "text": "皆さん、ありがとうございます！\nこれなら勝てる気がします。\nですが気を抜かぬように。さあ、行きますよ！", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "バシラ", "text": "ここら一帯の虎を全て討伐できたようですね。\nご助力、本当にありがとうございました！", "face": "u28"}, {"name": "ルナール", "text": "どうってことないよ、こんなの。\nそれに、ベラなんかは自分から協力して、\nむしろ遊びに来たような感じですらあるもんね。", "face": "u300"}, {"name": "ベラ", "text": "うーん、狩った狩ったぁ♪\nさーて、こいつらどうしようかなー。", "face": "u16"}, {"name": "バシラ", "text": "どうしようって、\nどうするつもりなのですか……？", "face": "u28"}, {"name": "ベラ", "text": "そうだなー。\nルナールみたいな、かっこいい感じの\nかぶり物にするのもいいな！", "face": "u16"}, {"name": "バシラ", "text": "え……そ、そうですか。\nそれは……いいかも、しれないですね。\nあはは……。", "face": "u28"}, {"name": "ベラ", "text": "そうか、ならバシラの分も作ってやるぞ！\nお揃いはいいぞ。仲間だ！　そしたら、\nもっともっといっぱい狩りをするぞっ！", "face": "u16"}, {"name": "ルナール", "text": "よかったね、バシラ。\n出来たらちゃんとあたしにも\n見せてよね？　それじゃあねぇ。", "face": "u300"}, {"name": "バシラ", "text": "え、ちょっと、ルナールさんッ！？\n待って下さい、私も一緒に行きます。\nお願いです、行かせてくださいぃ～！！", "face": "u28"}, {"name": "ベラ", "text": "んー？\nなんだ、バシラのやつ、\n自分の取り分も置いて行っちゃったぞ？", "face": "u16"}, {"name": "ベラ", "text": "まあいいや。これぜーんぶアタシのだ。\nにしし、王子にも毛皮で何か作って\nやろう。今日は良い日だぞぉ～♪", "face": "u16"}]}], "map": {"image": "Map920062_3668", "w": 960, "h": 640, "spots": [{"k": "b", "x": 936, "y": 423}, {"k": "b", "x": 24, "y": 156}, {"k": "m", "x": 138, "y": 156, "id": 200}, {"k": "m", "x": 236, "y": 182, "id": 201}, {"k": "m", "x": 329, "y": 207, "id": 202}, {"k": "m", "x": 519, "y": 175, "id": 203}, {"k": "m", "x": 300, "y": 276, "id": 204}, {"k": "m", "x": 424, "y": 389, "id": 205}, {"k": "m", "x": 522, "y": 395, "id": 206}, {"k": "m", "x": 425, "y": 173, "id": 207}, {"k": "m", "x": 421, "y": 70, "id": 208}, {"k": "m", "x": 642, "y": 297, "id": 209}, {"k": "m", "x": 613, "y": 367, "id": 210}, {"k": "m", "x": 745, "y": 328, "id": 211}, {"k": "m", "x": 843, "y": 360, "id": 212}, {"k": "m", "x": 421, "y": 481, "id": 213}, {"k": "m", "x": 518, "y": 71, "id": 214}, {"k": "m", "x": 519, "y": 484, "id": 215}, {"k": "m", "x": 109, "y": 216, "id": 216}, {"k": "m", "x": 205, "y": 246, "id": 217}, {"k": "m", "x": 714, "y": 395, "id": 218}, {"k": "m", "x": 816, "y": 423, "id": 219}, {"k": "m", "x": 337, "y": 350, "id": 220}, {"k": "m", "x": 611, "y": 215, "id": 221}, {"k": "r", "x": 330, "y": 104, "id": 300}, {"k": "r", "x": 262, "y": 139, "id": 301}, {"k": "r", "x": 626, "y": 111, "id": 302}, {"k": "r", "x": 897, "y": 308, "id": 303}, {"k": "r", "x": 734, "y": 251, "id": 304}, {"k": "r", "x": 661, "y": 428, "id": 305}, {"k": "r", "x": 611, "y": 468, "id": 306}, {"k": "r", "x": 178, "y": 104, "id": 307}, {"k": "r", "x": 106, "y": 277, "id": 308}, {"k": "r", "x": 228, "y": 378, "id": 309}, {"k": "r", "x": 8