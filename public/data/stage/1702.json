{"quest_id": 1702, "name": "魔界都市", "description": "魔界都市で待ち構えるオークと\nダークエルフの狙いとは……。\n＜魔界：味方の攻撃力と防御力が半減＞\n＜時間経過によるコスト回復量が低下＞", "modifier_notes": ["魔界：味方の攻撃力と防御力が半減", "時間経過によるコスト回復量が低下"], "event": "ストーリーミッション7", "event_category": "Story", "mission_id": 100007, "map_no": 1109, "level": 100, "multiplier": 1.0, "charisma": 41, "capacity": 10, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 2, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 30, "attack_speed": 30, "attack_wait": 50, "attack_interval": 196, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106704, "race_id": 8, "change_to": 1, "change_condition": 3, "master_id": 389, "global_id": 388, "to_condition": 3, "to_global_id": 389, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 120, "attack_speed": 10, "attack_wait": 10, "attack_interval": 111, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106720, "race_id": 8, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 390, "global_id": 389, "ranged": true, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 12, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1