ion": 3, "to_global_id": 385, "spawn_sec": 127}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1600, "base_hp": 18000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 700, "attack_speed": 20, "attack_wait": 15, "attack_interval": 116, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "master_id": 386, "global_id": 385, "from_condition": 3}, {"enemy_id": 19, "source": "local", "count": 3, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 236, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103248, "change_to": 19, "change_condition": 1, "missile_id": 6, "master_id": 424, "global_id": 423, "ranged": true, "variants": [{"hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "master_id": 423, "global_id": 422}], "spawn_sec": 147}, {"enemy_id": 21, "source": "local", "count": 4, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 151}, {"enemy_id": 22, "source": "local", "count": 5, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 162}, {"enemy_id": 23, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 177}, {"enemy_id": 24, "source": "local", "count": 10, "form_count": 1, "hp": 30000, "attack": 1100, "base_hp": 30000, "base_attack": 1100, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103568, "race_id": 12, "master_id": 456, "global_id": 455, "spawn_sec": 177}], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "おい、ダークエルフ。\n地上で抵抗を続けている猛者どもが、\nここへやってくるというのは本当だろうな？", "face": "l84be1726be60"}, {"name": "？？？", "text": "焦るなってオークのおっさん。\n俺が魔界の掟を破るとでも思ってんのかよ？", "face": "u407"}, {"name": "オーク", "text": "ふん……。\nこの区域は、お前らダークエルフの本拠地に近い。\n俺達オークを謀り、不意を討つこともできる。", "face": "l84be1726be60"}, {"name": "？？？", "text": "おいおい、確かにダークエルフとオークは仲が\nいいわけじゃないが、今アンタ達オークと争って、\n俺らに何の得があるって言うんだ？", "face": "u407"}, {"name": "？？？", "text": "アンタが地上界の猛者を倒せば、種族内で昇格。\n俺はそいつらの力を見定めたい。\nばっちりギブアンドテイク、成立してるだろ？", "face": "u407"}, {"name": "オーク", "text": "喰えないヤツめ……。\n俺の大嫌いな輩だ……。", "face": "l84be1726be60"}, {"name": "？？？", "text": "――っと。見ろよ、オークのおっさん。\nどうやら奴さん、現れたようだぜ。", "face": "u407"}, {"name": "アンナ", "text": "ここが魔界都市ですか……。", "face": "l712fde1e615d"}, {"name": "モーティマ", "text": "しっかし、陰気臭い都市だな……。\n見ろよ、あれ。骸骨のモニュメントだぜ？\n……たく、悪趣味にしても程があるぜ。", "face": "u14"}, {"name": "ソーマ", "text": "どなたか、私たちの話を聞いてくれる方が\nいるといいのですが……。\nあっ！　見て下さい王子、オークさんです！", "face": "u23"}, {"name": "オーク", "text": "ほう……確かに地上界の人間のようだな。\nここまで辿り着くとは、相当の手練れと見える。\n面白いッ！　早速その力、試させてもらうぞ！", "face": "l84be1726be60"}, {"name": "ソーマ", "text": "そ、そんなぁ……。\nやっぱり、戦いになってしまうのですね……。", "face": "u23"}]}, {"trigger": "battle", "at_sec": 146, "lines": [{"name": "オーク", "text": "くっ……強い！！　\n今は引くしかないが、次は必ず……！\n全軍撤退……！", "face": "l84be1726be60"}, {"name": "？？？", "text": "（こりゃすげぇや……！\nまさか、あの戦闘狂のオーク達を退けるとはな。\nへへっ。こりゃ面白くなってきたぞ）", "face": "u407"}]}, {"trigger": "end", "lines": [{"name": "ネヴィン", "text": "はは……本当に強いなアンタら。降参だよ。\nもう抵抗はしない。俺はネヴィンだ。\nここは一つ話合いといこうじゃないか。", "face": "u407"}, {"name": "アリサ", "text": "は、話合い！？\n急に襲ってきたのはそちらの方だというのに、\n一体どういうつもりですか……！？", "face": "u24"}, {"name": "ネヴィン", "text": "おいおい、そんな怖い顔するなって。\nアンタらは、地上で魔界のデーモン達に\n抵抗を続けている人間達だろ？", "face": "u407"}, {"name": "アンナ", "text": "……。", "face": "l712fde1e615d"}, {"name": "ネヴィン", "text": "まぁ、答えなくてもいいさ。\nさっきの強さを見て、確証は得た訳だしな。", "face": "u407"}, {"name": "ネヴィン", "text": "そうだな……それじゃあ、アンタらが\n欲しがってるであろう情報を教えてやるよ。\nそう、魔神レヴィアタンの情報をな。", "face": "u407"}, {"name": "ケイティ", "text": "魔神レヴィアタン！？\nご存じなのですか……？", "face": "u114"}, {"name": "ネヴィン", "text": "そりゃそうだ。\nなんせ魔神レヴィアタンは、ほら……。\nアンタらの足元にいるんだからな。", "face": "u407"}, {"name": "ソーマ", "text": "――えッ！？", "face": "u23"}, {"name": "ネヴィン", "text": "いちいち武器を構えんなって。\nつまりは、この地面こそがレヴィアタンだって事さ。\n魔界ってのはな、レヴィアタンの背中にあるんだ。", "face": "u407"}, {"name": "ゼンメル", "text": "なんじゃと……。だが、それが真実なら理屈が通る。\n魔神レヴィアタンの活動が始まったことで、\n魔界が地上界に近づいているという事じゃからな。", "face": "u284"}, {"name": "ネヴィン", "text": "とりあえずこの先にあるダークエルフの\n居住区へ来いよ。\nそこで俺達の女王から詳しい話を聞いたらいい。", "face": "u407"}, {"name": "ケイティ", "text": "……。", "face": "u114"}, {"name": "ネヴィン", "text": "警戒するのもいいが、度が過ぎると機を逃すぞ。\nここは魔界だ。地上とは勝手が違う。当てもなく\n行動してたらデーモン共に取り囲まれて命を落とすぜ。", "face": "u407"}, {"name": "アンナ", "text": "……分かりました。\n王子、ここは彼を信じることにしましょう。\nそれではネヴィンさん、私たちを案内してください。", "face": "l712fde1e615d"}]}], "hard": {"level": 170, "multiplier": 1.7, "modifiers": [{"kind": "term", "influence": 12, "params": [250]}, {"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}], "enemies": [{"enemy_id": 1, "hp": 20400, "attack": 1700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 30, "pattern_id": 2106704}, {"enemy_id": 1, "form_index": 1, "hp": 20400, "attack": 550, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "pattern_id": 2106720}, {"enemy_id": 3, "hp": 2040, "attack": 510, "damage_type": "physical", "armor_defense": 80, "pattern_id": 2106320}, {"enemy_id": 3, "form_index": 1, "hp": 2040, "attack": 850, "damage_type": "physical", "armor_defense": 130, "pattern_id": 2106336}, {"enemy_id": 5, "hp": 6800, "attack": 680, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102224}, {"enemy_id": 5, "form_index": 1, "hp": 6800, "attack": 1020, "damage_type": "physical", "armor_defense": 450, "pattern_id": 2102240}, {"enemy_id": 7, "hp": 5100, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102544}, {"enemy_id": 7, "form_index": 1, "hp": 5100, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102560}, {"enemy_id": 9, "hp": 4250, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102576}, {"enemy_id": 9, "form_index": 1, "hp": 4250, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102592}, {"enemy_id": 11, "hp": 13600, "attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2103408}, {"enemy_id": 11, "form_index": 1, "hp": 13600, "attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2103424}, {"enemy_id": 13, "hp": 17000, "attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2103376}, {"enemy_id": 13, "form_index": 1, "hp": 17000, "attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2103392}, {"enemy_id": 15, "hp": 42500, "attack": 4250, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "pattern_id": 2102928}, {"enemy_id": 15, "form_index": 1, "hp": 42500, "attack": 4250, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "pattern_id": 2102944}, {"enemy_id": 17, "hp": 30600, "attack": 1360, "damage_type": "physical", "armor_defense": 500, "pattern_id": 2102672}, {"enemy_id": 17, "form_index": 1, "hp": 30600, "attack": 2720, "damage_type": "physical", "armor_defense": 700, "pattern_id": 2102688}, {"enemy_id": 19, "hp": 15300, "attack": 400, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "pattern_id": 2103248}, {"enemy_id": 21, "hp": 2040, "attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "pattern_id": 2098976}, {"enemy_id": 22, "hp": 3400, "attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "pattern_id": 2098992}, {"enemy_id": 23, "hp": 10200, "attack": 510, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "pattern_id": 2099008}, {"enemy_id": 24, "hp": 51000, "attack": 1870, "damage_type": "physical", "pattern_id": 2103568}]}, "active": true}