attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110064, "race_id": 12, "special_effect_id": 168, "master_id": 30315, "global_id": 3934, "spawn_sec": 103}, {"enemy_id": 7, "source": "local", "count": 5, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 5000, "base_hp": 5000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2106560, "race_id": 7, "change_to": 7, "master_id": 30344, "global_id": 3963, "to_global_id": 3962, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 137}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "change_to": 6, "master_id": 30343, "global_id": 3962}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 9, "master_id": 30346, "global_id": 3965, "to_global_id": 3964, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 147}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 8, "master_id": 30345, "global_id": 3964}, {"enemy_id": 11, "source": "local", "count": 1, "level": 70, "form_count": 1, "hp": 100000, "attack": 4500, "base_hp": 100000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 115, "attack_wait": 100, "attack_interval": 401, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109424, "race_id": 13, "master_id": 30314, "global_id": 3933, "spawn_sec": 167}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349, "spawn_sec": 180}], "popups": ["ダークエレメンタルの攻撃は\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "カタラ", "text": "――ここが最後の\n『破滅の力』が隠されている孤島よ。", "face": "u912"}, {"name": "ミネルバ", "text": "この海域に、こんな島があったなんてね。\nデューオ、あなたは知っていたかしら？", "face": "u91"}, {"name": "デューオ", "text": "いいや、アタシも知らなかったよ。\nむしろこの海域には、\n生半可な船じゃ入れなかったしね。", "face": "u594"}, {"name": "カタラ", "text": "ふふっ、当然よ。\n『破滅の力』を隠すために、呪術で何重にも\nあたしのご先祖様が隠していたんだから。", "face": "u912"}, {"name": "デューオ", "text": "なるほどね……。\n海流と呪術、二重の障害で、\nこの島への接近を阻んでいたってわけだ。", "face": "u594"}, {"name": "フローガ", "text": "――うっ……。\nあ、あれ……？　この感じは……。", "face": "u878"}, {"name": "イブキ", "text": "フローガ？　どうかしたのか？", "face": "u511"}, {"name": "フローガ", "text": "『破滅の力』とは違う、もうひとつの魔力の乱れが……。\nこの感じはアトナテスさんの時の……。", "face": "u878"}, {"name": "アトナテス", "text": "……へぇ、魔界と物質界の間に、\n空間の亀裂が生じ始めてるってことか。", "face": "u908"}, {"name": "フローガ", "text": "それも一個や二個じゃありません。\nこの島の周囲全体に、亀裂が発生しそうになってます！\n時間が経過すると、どんどん増えていくかと！", "face": "u878"}, {"name": "アトナテス", "text": "へぇ……だがどうやら、\n俺達の方が先手を打てたようだ。\n向こうの出現を察知できたんだからな。", "face": "u908"}, {"name": "アトナテス", "text": "王子、空間の亀裂から魔物が出てくるぞ。\n残さず迎え撃ってやろうぜ！", "face": "u908"}]}, {"trigger": "end", "lines": [{"name": "ユージェン", "text": "――魔物の気配はなさそうだな。\nこれで亀裂から飛び出した魔物も、\n海の魔物も討伐できたようだ。", "face": "u906"}, {"name": "カタラ", "text": "最後の『破滅の力』も回収できたわ。\n魔王軍に奪われる前にこの島に到着できて何よりね。", "face": "u912"}, {"name": "フローガ", "text": "カタラさんのおかげで、\n『破滅の力』が集まったことによる魔力の乱れも、\nほとんどが制御された状態にあります。", "face": "u878"}, {"name": "フローガ", "text": "あとはこれらを、どうやって防衛するかですが……。", "face": "u878"}, {"name": "カタラ", "text": "そうね……。\n『破滅の力』自体が魔力を放っている以上、\n今みたいに魔王軍も感知してくるだろうし……。", "face": "u912"}, {"name": "ミネルバ", "text": "カタラの術で、\n完全に隠してしまうことはできないのかしら？", "face": "u91"}, {"name": "カタラ", "text": "それができるなら、最初からご先祖様も、\n秘境に分散して『破滅の力』を隠したりしないわ。", "face": "u912"}, {"name": "シビラ", "text": "――となれば、私達の出番じゃない？", "face": "u39"}, {"name": "ティニー", "text": "王子に助けられてばかりっていうのもね。\nドワーフの国の底力を見せてあげるわ。", "face": "u523"}, {"name": "カタラ", "text": "――なるほど。\n国家規模で守っちゃうってわけか。\nよーし、そうと決まれば作戦会議ね！", "face": "u912"}]}], "story_talk": true, "active": true}