"attack_interval": 211, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102752, "special_effect_id": 53, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 725, "global_id": 724, "ranged": true, "spawn_sec": 134}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 3500, "attack": 700, "base_hp": 3500, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101280, "master_id": 267, "global_id": 266, "spawn_sec": 159}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 3500, "attack": 400, "base_hp": 3500, "base_attack": 400, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 200, "attack_speed": 90, "attack_wait": 60, "attack_interval": 183, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105712, "special_effect_id": 81, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 730, "global_id": 729, "ranged": true, "spawn_sec": 163}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 150, "base_hp": 2800, "base_attack": 150, "damage_type": "magical", "armor_defense": 700, "magic_defense": 40, "attack_range": 110, "attack_speed": 90, "attack_wait": 10, "attack_interval": 59, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105728, "special_effect_id": 222, "missile_id": 158, "missile": {"speed": 6.0, "splash": 93}, "master_id": 731, "global_id": 730, "ranged": true, "spawn_sec": 166}], "dialogue": [{"trigger": "start", "lines": [{"name": "暗黒騎士デシウス", "text": "ようやく……この手に収めることができた……。\n探し求めていた魂が……。", "face": "l84dc0540de08"}, {"name": "暗黒騎士デシウス", "text": "我が師の魂が、この手にあるのだ……！", "face": "l84dc0540de08"}, {"name": "師匠", "text": "……デシウス……か？\nお前の事は案じておったが、その漆黒の鎧……。\n暗黒騎士に成り果てたか……。", "face": "l41f531cae041"}, {"name": "暗黒騎士デシウス", "text": "……案じていた……？\n何をおっしゃるのですか……。\n貴方に奪われた未来の影がこの姿なのです。", "face": "l84dc0540de08"}, {"name": "暗黒騎士デシウス", "text": "何故……なぜ、このデシウスに\n奥義を伝授しなかったのですか？", "face": "l84dc0540de08"}, {"name": "師匠", "text": "お前は大切な者を失い、復讐心に駆られていた。\nその念が消えぬ者にとってあの奥義は諸刃……。\nお前を想っての選択だと、何故分からぬのだ？", "face": "l41f531cae041"}, {"name": "暗黒騎士デシウス", "text": "……そんなこと、信じられるか！\n貴方は、我輩の力を恐れていただけだ！", "face": "l84dc0540de08"}, {"name": "暗黒騎士デシウス", "text": "我輩は、自らの力で、\n貴方の奥義を今から自分のものにします。", "face": "l84dc0540de08"}, {"name": "師匠", "text": "吸魂の力か……？\n仮初の必殺剣を得てどうする？\nデシウス、本当にこれがお前の求めた答えか？", "face": "l41f531cae041"}, {"name": "暗黒騎士デシウス", "text": "……う、うるさい！　もう騙されぬぞ！\n我輩は我輩のやり方で最強となるのだ！\nもう二度と、大切なモノを失ったりなどしない！", "face": "l84dc0540de08"}]}, {"trigger": "start", "lines": [{"name": "レシア", "text": "デシウス！　既に包囲は盤石だ！\n大人しく降れ！", "face": "u358"}, {"name": "暗黒騎士デシウス", "text": "――……グ、グフフフ……フハハハハッ！！\n遂に、我輩は必殺剣を会得したのだ！\nもはやこの身に、敗北の二文字は無いッ！！", "face": "l84dc0540de08"}, {"name": "ミーティア", "text": "必殺剣……そうか、師匠の魂を宿したんだね？\nだけど、星の心を解さない君では、\n奥義をうまく操る事など出来ないよ！", "face": "u280"}, {"name": "暗黒騎士デシウス", "text": "グフフ……何をバカなことを言っている？\n我輩の必殺剣は完璧だ！\n貴様の父と同じ力を我輩は手に入れたのだ！", "face": "l84dc0540de08"}, {"name": "ミーティア", "text": "人の心を完全に捨ててしまったようだね……。\nいいよ……同門のボクが終わらせてあげる。\n君の苦しみも悲しみも、全て斬ってみせるよ。", "face": "u280"}, {"name": "アンナ", "text": "ミーティアさん……。\n王子、ここでデシウスとの決着をつけましょう。", "face": "l9aa58d4440c1"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士デシウス", "text": "――ぐッ、ガ……はぁッ……ハァ……。\n我輩の必殺剣が……敗れる、だと……？", "face": "l84dc0540de08"}, {"name": "ミーティア", "text": "今の君には、敗北の理由も、\n強さの意味も、何も理解はできないだろうね。", "face": "u280"}, {"name": "ミーティア", "text": "星の心と己を重ね、互いを受け入れなくては\n必殺の剣に至ることはできないんだ。\n心を捨てた君は、最初から負けていたんだよ。", "face": "u280"}, {"name": "暗黒騎士デシウス", "text": "黙れ……黙れ黙れ黙れぇェェえええ――ッ！\n我輩は間違わない……もう間違わんのだ！", "face": "l84dc0540de08"}, {"name": "ミーティア", "text": "待て、デシウス！\nいったい何処に行こうっていうんだ！？", "face": "u280"}, {"name": "アンナ", "text": "……逃げられて、しまいましたね……。", "face": "l9aa58d4440c1"}, {"name": "レシア", "text": "虚構といえど、あの暴威を止めることは\n容易いことではないだろう。あの力を前に、\nこれだけの被害で済んだのは奇跡だ。", "face": "u358"}, {"name": "レシア", "text": "だが、すまないことをした、ミーティア。\n貴方の師の魂を救うことはできなかった……。", "face": "u358"}, {"name": "ミーティア", "text": "いいんです。これはボクの責任ですから。\nいつか必ず、この手で取り返してみせます。", "face": "u280"}, {"name": "レシア", "text": "そう言ってもらえるのは嬉しいが、\nそれでは英霊の守り手の名折れだ。", "face": "u358"}, {"name": "レシア", "text": "王子、貴方に申し出たいことがある。\n英霊の守り手として、一人の武人として、\n私に同行の許可を与えて欲しい。", "face": "u358"}, {"name": "レシア", "text": "今回のことで私は自分の不甲斐なさを痛感した。\n奪われた魂を取り返すのは勿論だが、\nより強くなる為に、王子の武を学びたいのだ。", "face": "u358"}, {"name": "アンナ", "text": "レシアさんが共に来ていただけるのは、\nこちらとしても大変喜ばしいことです。\nこれから、どうぞ宜しくお願いします！"}, {"name": "アンナ", "text": "取り戻せた森の安寧と、\nレシアさんとの出会いを喜びましょう！\n王子、この度は本当にお疲れ様でした。"}]}], "active": true}