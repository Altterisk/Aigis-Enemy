1, "form_count": 1, "tags": ["女性"], "hp": 8000, "attack": 220, "base_hp": 8000, "base_attack": 220, "damage_type": "magical", "armor_defense": 50, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099584, "race_id": 16, "special_effect_id": 222, "missile_id": 57, "missile": {"speed": 12.0}, "master_id": 38428, "global_id": 12045, "ranged": true, "spawn_sec": 44}, {"enemy_id": 41, "source": "local", "count": 10, "form_count": 1, "tags": ["女性"], "hp": 3000, "attack": 1000, "base_hp": 3000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097840, "race_id": 16, "master_id": 31270, "global_id": 4889, "spawn_sec": 123}, {"enemy_id": 42, "source": "local", "count": 12, "form_count": 1, "tags": ["女性"], "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 31269, "global_id": 4888, "spawn_sec": 165}, {"enemy_id": 43, "source": "local", "count": 6, "form_count": 1, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 32, "global_id": 31, "ranged": true, "spawn_sec": 174}, {"enemy_id": 44, "source": "local", "count": 4, "form_count": 1, "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104640, "race_id": 16, "change_to": 44, "change_condition": 2, "master_id": 561, "global_id": 560, "spawn_sec": 195}], "popups": ["\n\n\n　　──東の国、温泉街。", "トラムは一定時間が経過するたびに\n攻撃、防御がアップします。\n※最大で４倍までアップ\n\nまた、トラムは倒されると\nその場で復活します。\n２回まで復活し、２回目の復活後、\nHPがアップします。", "アランは\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ\n\nまた、アランは倒されると\nその場で復活します。\n復活は３回まで行われます。"], "dialogue": [{"trigger": "battle", "at_sec": 45, "lines": [{"text": "──東の国、温泉街。"}, {"name": "ヨシノ", "text": "やあやあ、ハイデマリー殿。\n無理を言って悪かったねぇ。", "face": "u1104a1"}, {"name": "ハイデマリー", "text": "ヨシノさま。いえいえ、とんでもないです。\n大役を任せて頂いてむしろ光栄でした。", "face": "u2340a1"}, {"name": "ハイデマリー", "text": "まあ、人気闘兵参加者たちの東の国慰安旅行、\nどうして幹事が私なのかとは思いましたが……。", "face": "u2340a1"}, {"name": "ヨシノ", "text": "君が世界各地の温泉街に詳しいと聞いてね、\n任せてみたら面白いんじゃないかと思ってさ。", "face": "u1104a1"}, {"name": "シズカ", "text": "私たちも地元の温泉のことなら分かるんだけど、\n他国の人の客観的な意見が欲しかったのよね。", "face": "u101"}, {"name": "ヨシノ", "text": "（あとはまあ、各方面からの頼みもあったけど）", "face": "u1104a1"}, {"name": "トラム", "text": "──ふぅ、良いお湯だったわね。", "face": "u1110a1"}, {"name": "ヨシノ", "text": "おっと、噂をすれば。", "face": "u1104a1"}, {"name": "シビラ", "text": "あらヨシノ、先に入らせてもらってるわ。\n素敵な温泉街に招待してくれてありがとう。", "face": "u39"}, {"name": "ヨシノ", "text": "お礼ならこっちのハイデマリー殿に。\nこの会場を選んだのは彼女だからね。", "face": "u1104a1"}, {"name": "シズカ", "text": "シビラたちはどの温泉に入ってたの？", "face": "u101"}, {"name": "アラン", "text": "美肌の湯、だそうです。\n心なしか肌が潤った気がしますね。", "face": "u1511a1"}, {"name": "トラム", "text": "気のせいじゃないわよ？\nほら、こんなにモチモチ。", "face": "u1110a1"}, {"name": "アラン", "text": "ふぇ、ふぇえふぁま！？", "face": "u1511a1"}, {"name": "ヨシノ", "text": "うーん、温泉の効能は確かみたいだねぇ。\nさすがハイデマリー殿の推薦なだけはある。", "face": "u1104a1"}, {"name": "ハイデマリー", "text": "いえ、すごいのは私ではなく温泉ですので。", "face": "u2340a1"}, {"name": "シビラ", "text": "良いものを知っているというのは誇るべきことよ。\nあなたのおかげで、日頃のストレスも吹き飛んだわ。", "face": "u39"}, {"name": "アラン", "text": "ええ、これで明日からのパレードでも\n良いパフォーマンスを出せるかと。", "face": "u1511a1"}, {"name": "ハイデマリー", "text": "あ、ありがたいお言葉です……。", "face": "u2340a1"}, {"name": "ヨシノ", "text": "そうだ、凱旋パレードといえばさ、\n温泉でリフレッシュできたみたいだし、\n今からちょっと予行演習でもしてみる？", "face": "u1104a1"}, {"name": "アラン", "text": "良い案ですね、私は構いませんよ。", "face": "u1511a1"}, {"name": "シビラ", "text": "今なら身体も軽いし、悪くないんじゃないかしら。", "face": "u39"}, {"name": "ヨシノ", "text": "よし、それじゃあハイデマリー殿よろしく！", "face": "u1104a1"}, {"name": "ハイデマリー", "text": "えっ。", "face": "u2340a1"}, {"name": "トラム", "text": "さあ、肩慣らしと行きましょうか！", "face": "u1110a1"}, {"name": "ハイデマリー", "text": "えーっ！？", "face": "u2340a1"}]}, {"trigger": "end", "lines": [{"name": "トラム", "text": "──よし、ここまでね。", "face": "u1110a1"}, {"name": "ハイデマリー", "text": "ぜーっ、ぜーっ、ぜーっ。", "face": "u2340a1"}, {"name": "シズカ", "text": "おつかれさま、良い動きだったわよ。", "face": "u101"}, {"name": "ハイデマリー", "text": "きょ、恐縮です……。", "face": "u2340a1"}, {"name": "アラン", "text": "ふむ、当たり前ですがまた汗をかいてしまいましたね。", "face": "u1511a1"}, {"name": "ヨシノ", "text": "それならもう一回流しちゃえばいいよ。\n温泉なんて何回入っても良いからね。", "face": "u1104a1"}, {"name": "シズカ", "text": "あなた……みんなで温泉に入りたかっただけでしょ？", "face": "u101"}, {"name": "ヨシノ", "text": "あ、バレた？", "face": "u1104a1"}, {"name": "シビラ", "text": "ふふっ、次は違う温泉に入ろうかしら。", "face": "u39"}, {"name": "トラム", "text": "美肌の湯だけでも数種類あったような……。", "face": "u1110a1"}, {"name": "ヨシノ", "text": "おー、それは制覇するしかないねぇ。", "face": "u1104a1"}, {"name": "アラン", "text": "姉様、向こうに特製温泉まんじゅうがあるようです。", "face": "u1511a1"}, {"name": "トラム", "text": "ほんと！？　早く行きましょ！", "face": "u1110a1"}, {"name": "ヨシノ", "text": "ほらほら、ハイデマリー殿も。", "face": "u1104a1"}, {"name": "ハイデマリー", "text": "えっ、あっ……はい。", "face": "u2340a1"}, {"name": "ハイデマリー", "text": "（うぅ、周りが高貴すぎて緊張する……）", "face": "u2340a1"}, {"name": "ハイデマリー", "text": "（でも……ちょっと楽しい、かも？）", "face": "u2340a1"}]}], "active": true}