{"quest_id": 8138, "name": "仙薬湯の効能", "description": "王子一行を尾行していたマズゥが仙薬湯を\n独占しようと小人と共に襲い来る。\nモモと協力して敵を撃退せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "魔女と闘士と温泉郷", "event_category": "History", "mission_id": 920208, "map_no": 4830, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 750, "base_hp": 20000, "base_attack": 750, "damage_type": "physical", "armor_defense": 40, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 120, "attack_interval": 305, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2137152, "race_id": 16, "special_effect_id": 993, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 37005, "global_id": 10622, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 12, "form_count": 3, "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149584, "race_id": 14, "change_to": 2, "master_id": 36992, "global_id": 10609, "to_global_id": 10610, "route_behaviour": {"transforms": [{"wait": 2}]}, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 141, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149520, "race_id": 14, "special_effect_id": 1610, "change_to": 3, "missile_id": 974, "missile": {"speed": 12.0}, "master_id":