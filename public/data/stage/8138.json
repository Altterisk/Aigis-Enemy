, "pattern_id": 2149536, "race_id": 14, "special_effect_id": 1610, "change_to": 14, "missile_id": 974, "missile": {"speed": 12.0}, "master_id": 36996, "global_id": 10613, "ranged": true, "to_global_id": 10614}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 8000, "attack": 1100, "base_hp": 8000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149600, "race_id": 14, "special_effect_id": 1615, "master_id": 36997, "global_id": 10614}, {"enemy_id": 16, "source": "local", "count": 6, "form_count": 1, "hp": 7000, "attack": 650, "base_hp": 7000, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114512, "race_id": 14, "change_to": 16, "change_condition": 3, "master_id": 31002, "global_id": 4621, "spawn_sec": 194}, {"enemy_id": 18, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 800, "base_hp": 9000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114592, "race_id": 14, "change_to": 18, "change_condition": 3, "master_id": 31017, "global_id": 4636, "spawn_sec": 209}, {"enemy_id": 20, "source": "local", "count": 2, "form_count": 2, "tags": ["鳥"], "hp": 9000, "attack": 1500, "base_hp": 9000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 20, "magic_defense": 10, "attack_range": 10, "attack_speed": 65, "attack_wait": 60, "attack_interval": 175, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2135808, "race_id": 11, "special_effect_id": 229, "change_to": 20, "change_condition": 4, "missile_id": 692, "missile": {"speed": 1.0}, "master_id": 34781, "global_id": 8398, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 8399, "spawn_sec": 257}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 9000, "base_hp": 9000, "damage_type": "physical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2135824, "race_id": 11, "master_id": 34782, "global_id": 8399, "from_condition": 4, "trigger_ticks": 1}], "popups": ["敵ユニットが\n温泉に入っている間、\nHPが徐々に回復します。\n\n温泉から上がった敵ユニットは\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。", "大魔女マズゥは、自身の攻撃力の値で\n自身を含む周囲の敵を回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "モモ", "text": "ちょっとー！　わたしの体、元に戻してよー！", "face": "u597"}, {"name": "マズゥ", "text": "あははははは！　戻すわけがないじゃないか！\n魔術の発展のため、尊い犠牲になってもらうよ！", "face": "l0987680c7080"}, {"name": "ミカ", "text": "どうせその成果を社会に寄与する気もないくせにー。\n『尊い犠牲とかどの口で言ってるん？』って話ですよ。", "face": "u2045a1"}, {"name": "マズゥ", "text": "うるさいね！\n軽そうな頭してるくせに、\n正論ばっか言わないでおくれ！", "face": "l0987680c7080"}, {"name": "マズゥ", "text": "さあ、行きな小人たち！　\nあのチビを温泉に入れるんじゃないよ！", "face": "l0987680c7080"}, {"name": "小人A", "text": "了解！", "face": "l9dd45a6f4c93"}, {"name": "アカネ", "text": "どうやら目の前の温泉が、\nお目当ての仙薬湯のようですが……。", "face": "u1678a1"}, {"name": "モモ", "text": "うぅ、警戒されて入れないよぉ。", "face": "u597"}, {"name": "アカネ", "text": "……仙薬湯の影響か、小人に力が漲ってますね。\n手早く倒さねば体力を回復されてしまうでしょう。", "face": "u1678a1"}, {"name": "モモ", "text": "この体じゃ、さすがにパワーが足りないかも……。", "face": "u597"}, {"name": "マズゥ", "text": "いい気味さね、小人の数に圧し潰されちまいな！", "face": "l0987680c7080"}]}, {"trigger": "battle", "at_sec": 99, "lines": [{"name": "小人A", "text": "浸透戦術！　波状攻撃！", "face": "l9dd45a6f4c93"}, {"name": "モモ", "text": "わわわわっ！？　こっ、このままじゃ──", "face": "u597"}, {"name": "フィーヌ", "text": "モモさん！　こっちです！", "face": "u1415a1"}, {"name": "モモ", "text": "フィーヌちゃん！？", "face": "u597"}, {"name": "マズゥ", "text": "──ッ！　何をする気だい！", "face": "l0987680c7080"}, {"name": "フィーヌ", "text": "こうするつもりですよ！　尾びれビターン！", "face": "u1415a1"}, {"name": "アカネ", "text": "温泉の水飛沫が……モモさんに……。", "face": "u1678a1"}]}, {"trigger": "battle", "at_sec": 102, "lines": [{"name": "モモ", "text": "変☆身！", "face": "u2043a1"}, {"name": "マズゥ", "text": "なんだってぇぇぇ！？", "face": "l0987680c7080"}, {"name": "モモ", "text": "よーし！　全力全開！　くらえ、必殺の──", "face": "u2043a1"}, {"name": "モモ", "text": "温泉鉄甲！　モモパーンチ！", "face": "u2043a1"}]}, {"trigger": "end", "lines": [{"name": "モモ", "text": "せいっ！　はぁっ！　ちょいやーっ！", "face": "u2043a1"}, {"name": "小人A", "text": "戦略的撤退！　戦略的撤退！", "face": "l9dd45a6f4c93"}, {"name": "マズゥ", "text": "あっ、こら！　逃げるんじゃないよ！", "face": "l0987680c7080"}, {"name": "小人B", "text": "未来への進軍！", "face": "l9dd45a6f4c93"}, {"name": "マズゥ", "text": "言い方を変えても同じさね！\n何のために金を払ってると思ってるんだい！", "face": "l0987680c7080"}, {"name": "小人C", "text": "過剰労働！　低賃金！　ストライキ！", "face": "l9dd45a6f4c93"}, {"name": "マズゥ", "text": "ええい、じゃあ二倍！　二倍出そうじゃないか！", "face": "l0987680c7080"}, {"name": "小人A", "text": "労使交渉成立！", "face": "l9dd45a6f4c93"}, {"name": "マズゥ", "text": "最近妙な知恵ばっかりつけてからに！\nどこでそんな言葉を覚えてきたんだい！", "face": "l0987680c7080"}, {"name": "小人B", "text": "ディエーラ商会？", "face": "l9dd45a6f4c93"}, {"name": "アカネ", "text": "（そういえば一時ディエーラ商会で働いていた小人が、\n界隈に商売の知識を広めているという噂がありましたね）", "face": "u1678a1"}, {"name": "マズゥ", "text": "ったく、持ってきなドロボー！", "face": "l0987680c7080"}, {"name": "マズゥ", "text": "（……出費は痛いけど、ここは退けないねぇ。\n今のでようやく、仙薬湯の効能を理解できたよ。\nこの温泉の本質は治癒や解呪なんて代物じゃない）", "face": "l0987680c7080"}, {"name": "マズゥ", "text": "（時魔術にも似た、巻き戻しさ。\n肉体をあるべき姿へと回帰させる力、\nこれをあたしの魔術と組み合わせれば──）", "face": "l0987680c7080"}, {"name": "アカネ", "text": "──ッ！　待ちなさい！　何をする気ですか！？", "face": "u1678a1"}, {"name": "マズゥ", "text": "小人たち！　時間を稼ぎな！", "face": "l0987680c7080"}, {"name": "小人たち", "text": "ディーフェンス！　ディーフェンス！", "face": "l9dd45a6f4c93"}, {"name": "ミカ", "text": "ちょちょちょ、邪魔だってー！", "face": "u2045a1"}, {"name": "フィーヌ", "text": "小人さんで前が見えませーん！", "face": "u1415a1"}, {"name": "モモ", "text": "──てりゃてりゃてりゃー！", "face": "u2043a1"}, {"name": "ミカ", "text": "やば、モモちーが無双してる！", "face": "u2045a1"}, {"name": "モモ", "text": "あと……少しっ──", "face": "u2043a1"}, {"name": "マズゥ", "text": "遅いよ！　若いくせに判断が遅いねぇ！", "face": "l0987680c7080"}, {"name": "ミカ", "text": "隙あらば若者批判。", "face": "u2045a1"}, {"name": "フィーヌ", "text": "モモさん！　まっじぃ予感がします！　一旦退却を！", "face": "u1415a1"}]}], "active": true}