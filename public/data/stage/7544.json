{"quest_id": 7544, "name": "第三陣 蘇りし白の王国兵", "description": "蘇った白の王国の戦士が参戦した反乱軍\nとの苛烈な戦いを制し、勝利を掴み取れ！！\n＜広域戦闘：敵味方の射程減少＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国三陣", "event_category": "Empire", "mission_id": 940005, "map_no": 4590, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [45]}, {"kind": "term", "influence": 20, "params": [45]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 18, "form_count": 1, "tags": ["帝国"], "hp": 20000, "attack": 450, "base_hp": 20000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 121, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133424, "race_id": 16, "special_effect_id": 768, "master_id": 34637, "global_id": 8254, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 49, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 121, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133408, "race_id": 16, "special_effect_id": 768, "master_id": 34636, "global_id": 8253, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 1, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133440, "race_id": 16, "special_effect_id": 768, "master_id": 34638, "global_id": 8255, "spawn_sec": 3}, {