ssile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34618, "global_id": 8235, "ranged": true, "to_global_id": 8236}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["機械", "帝国"], "hp": 40000, "attack": 800, "base_hp": 40000, "base_attack": 800, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 181, "move_speed": 250.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133248, "race_id": 16, "special_effect_id": 957, "change_to": 14, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34619, "global_id": 8236, "ranged": true, "to_global_id": 8237}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["機械", "帝国"], "hp": 40000, "attack": 800, "base_hp": 40000, "base_attack": 800, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2133104, "race_id": 16, "special_effect_id": 957, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34620, "global_id": 8237, "ranged": true}, {"enemy_id": 16, "source": "local", "count": 10, "form_count": 1, "tags": ["帝国"], "hp": 46000, "attack": 650, "base_hp": 46000, "base_attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 210, "attack_speed": 1, "attack_wait": 10, "attack_interval": 53, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133376, "race_id": 16, "special_effect_id": 797, "change_to": 16, "change_condition": 1, "missile_id": 26, "master_id": 34634, "global_id": 8251, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 46000, "attack": 1800, "base_hp": 46000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 156, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133392, "race_id": 16, "special_effect_id": 797, "master_id": 34635, "global_id": 8252}], "spawn_sec": 194}, {"enemy_id": 18, "source": "local", "count": 16, "form_count": 1, "tags": ["帝国"], "hp": 18000, "attack": 500, "base_hp": 18000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 10, "attack_interval": 53, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133344, "race_id": 16, "special_effect_id": 769, "change_to": 18, "change_condition": 1, "missile_id": 26, "master_id": 34632, "global_id": 8249, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 156, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133360, "race_id": 16, "special_effect_id": 769, "master_id": 34633, "global_id": 8250}], "spawn_sec": 194}], "popups": ["蘇った帝国兵は体力が\n徐々に減少していきます。", "ベラートがいる間は\n全ての敵の攻撃力と\n防御力がアップします。", "このミッションでは、\n飛空戦艦は拠点に進行し、\n撃破数にカウントされます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ハイドース", "text": "――ベラート伯爵、善戦しているようだな。", "face": "le4066daa294e"}, {"name": "ベラート", "text": "おぉ、ハイドース殿。\nお見苦しいところを見せてしまいましたな。", "face": "l21787b277675"}, {"name": "ベラート", "text": "こちらの戦力も、随分と失われてしまった。\n此度の戦、勝利したとしても、\n我が領地は大きな痛手を被ることでしょう。", "face": "l21787b277675"}, {"name": "ハイドース", "text": "いや、その被害は、祖国を思う者たちの血そのものだ。\n被害を忘れてはならないが、\n流れた血を恥じ入ってもならぬ。", "face": "le4066daa294e"}, {"name": "ベラート", "text": "……確かに、そうですな。\n白の王国を取り戻す、その理想のために、\n歩みを共にしてくれた者の、誇りを背負っていかねば。", "face": "l21787b277675"}, {"name": "ハイドース", "text": "――そして、今やその理想に呼応する者は、\nこの物質界だけに留まらないのだよ。", "face": "le4066daa294e"}, {"name": "ベラート", "text": "……と、申しますと？\nまさか……先日のオークたちのように……！", "face": "l21787b277675"}, {"name": "ハイドース", "text": "白の帝国建国の折、あるいはそれ以前の、\n国を守るための戦いで散っていった、\n白の王国の兵たちが、冥界で叫んでいるのだ。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "いま一度、子孫らのために、\n国を取り戻す戦いに駆けつけたいと。", "face": "le4066daa294e"}, {"name": "ベラート", "text": "おぉ、おぉ……！\n我らが先達が、白の王国の戦士たちが……！！", "face": "l21787b277675"}, {"name": "ハイドース", "text": "――集え、かつて白の王国を守護せし者たちよ。\n父祖の地を、数多の子らの大地を、\nその手で取り戻すのだ。", "face": "le4066daa294e"}]}, {"trigger": "start", "lines": [{"name": "ベラート", "text": "……ハイドース殿、恩に着ますぞ。\n兵たちよ、白の皇帝を討て！\n己が手で白の王国を取り戻すのだッ！！", "face": "l21787b277675"}, {"name": "メルアビス", "text": "……冥界から蘇った者たち、ね。\nでも力は不安定みたい。", "face": "u675"}, {"name": "メルアビス", "text": "力は増しているけど、\n少しずつ、生命力が失われていっているわ。", "face": "u675"}, {"name": "メルアビス", "text": "かつてこの地を守った戦士たちよ。\n王子、絶対に気を抜かないようにね。", "face": "u675"}]}, {"trigger": "battle", "at_sec": 195, "lines": [{"name": "ハイドース", "text": "ハハハッ！　白の王国兵は大したものだな。\n次から次へと、この戦いに馳せ参じたいと集まってくる。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "望みを叶えよう、かつての強者たちよ。\n冥界と物質界の壁を超えるがよい。", "face": "le4066daa294e"}, {"name": "メルアビス", "text": "まだ喚び出すの……！？\nはぁ、やるしかないわね……！", "face": "u675"}]}, {"trigger": "end", "lines": [{"name": "ベラート", "text": "…………敗北、ですかな。", "face": "l21787b277675"}, {"name": "ベラート", "text": "だが、それでも……。\nこの命、祖国に捧げるのであれば惜しくはない。", "face": "l21787b277675"}, {"name": "貴族騎士", "text": "伯爵、それはなりません。\n国とは治める者がいなければ破綻するのです。", "face": "l36511b202f8c"}, {"name": "貴族騎士", "text": "アンジェリーネ様があちらについた以上、\n白の王国を取り戻すのは、\nあなたの背負うべき使命なのですから……！", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "……しかし、戦を長引かせれば、\n我らを支える民の生活が……。", "face": "l21787b277675"}, {"name": "貴族騎士", "text": "何をいまさら！\n退廃の限りをつくし、享楽の夜を味わい、\n祖国の危機には剣を取る！　それが貴族でしょう！", "face": "l36511b202f8c"}, {"name": "貴族騎士", "text": "今こそ、祖国の危機だと、\nそう仰ったのはあなたではありませんか。", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "……そうか、そうだったな。\nこのまま亜神との戦いを続ければ、\n白の帝国は、必ず破綻すると、確かに言ったな……。", "face": "l21787b277675"}, {"name": "ハイドース", "text": "――覚悟は決まったようだな。\nもはや領地に戻ることはできまい。\n冥界に拠点を用意してやろう。", "face": "le4066daa294e"}, {"name": "ベラート", "text": "おぉ、ありがたい……！\n白の王国を想う者たちよ！　今は撤退の時だ！", "face": "l21787b277675"}, {"name": "ベラート", "text": "――必ず、この国が崩壊するより前に、\n祖国をこの歪みきった体制から解放するのだッ！！", "face": "l21787b277675"}, {"name": "アンナ", "text": "……ベラート伯爵、ハイドースと共に撤退していきます。", "face": "l91db55a83012"}, {"name": "ケイティ", "text": "勝利は掴みましたが……。\n状況はむしろ悪化しているのではないでしょうか。", "face": "u114"}, {"name": "アンナ", "text": "ベラート伯爵は、\nもとより手段を選ばない方でしたからね。\nこれより先は……。", "face": "l91db55a83012"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "アンナ", "text": "……そうですね、私たちは、\n亜神ハイドースの企みを砕くためにここにいるのです。", "face": "l91db55a83012"}, {"name": "アンナ", "text": "王子、ハイドースとの戦いはまだ続きます。\n気を抜かず、警戒を続けていきましょう。", "face": "l91db55a83012"}]}], "active": true}