{"quest_id": 20038, "name": "教授の罠", "description": "真相を追い沼地へ至った王子たちを、\n事件の黒幕『教授』と刺客が待ち受ける！\n＜超猛毒：HPに継続ダメージ＞\n神級EX（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["超猛毒：HPに継続ダメージ"], "event": "ノットトリック・トリートケース", "event_category": "Emergency", "mission_id": 200583, "map_no": 7504, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 75, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 452000, "attack": 2850, "base_hp": 452000, "base_attack": 2850, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 240, "attack_speed": 20, "attack_wait": 60, "attack_interval": 144, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173200, "race_id": 16, "special_effect_id": 2120, "change_to": 1, "change_condition": 1, "missile_id": 11, "master_id": 41186, "ranged": true, "variants": [{"hp": 452000, "attack": 3000, "base_hp": 452000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 27, "attack_interval": 107, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173120, "race_id": 16, "special_effect_id": 2120, "master_id": 41187}], "sp_change_to": [41201], "route_behaviour": {"transforms": [{"to": 41201}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ブロック不可"], "hp": 452000, "attack": 2850, "base_hp": 452000, "base_attack": 2850, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 60, "attack_interval": 164, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173200, "race_id": 16, "special_effect_id": 2519, "master_id": 41201, "from_condition": "sp_change"}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 414000, "attack": 3200, "base_hp": 414000, "base_attack": 3200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 240, "attack_speed": 300, "attack_wait": 50, "attack_interval": 137, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173136, "race_id": 16, "change_to": 4, "change_condition": 1, "missile_id": 11, "master_id": 41188, "ranged": true, "variants": [{"hp": 414000, "attack": 2650, "base_hp": 414000, "base_attack": 2650, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 116, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173152, "race_id": 16, "master_id": 41189}]}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 2, "hp": 357000, "attack": 2650, "base_hp": 357000, "base_attack": 2650, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 25, "attack_interval": 91, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2158464, "race_id": 16, "special_effect_id": 1982, "change_to": 6, "change_condition": 1, "missile_id": 1214, "missile": {"speed": 10.0}, "master_id": 41193, "ranged": true, "variants": [{"hp": 357000, "attack": 4000, "base_hp": 357000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 1, "attack_wait": 5, "attack_interval": 52, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2158480, "race_id": 16, "special_effect_id": 1980, "master_id": 41194}, {"hp": 357000, "attack": 2650, "base_hp": 357000, "base_attack": 2650, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 25, "attack_interval": 91, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2158464, "race_id": 16, "special_effect_id": 1982, "change_to": 8, "change_condition": 1, "missile_id": 1214, "missile": {"speed": 10.0}, "master_id": 41195, "ranged": true}], "sp_change_to": [41195, 41196]}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 357000, "attack": 4000, "base_hp": 357000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 1, "attack_wait": 5, "attack_interval": 52, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2158480, "race_id": 16, "special_effect_id": 1981, "master_id": 41196, "from_condition": "sp_change"}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 8000, "attack": 420, "base_hp": 8000, "base_attack": 420, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 40681, "global_id": 14298, "spawn_sec": 57}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 1, "hp": 15000, "attack": 650, "base_hp": 15000, "base_attack": 650, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 40872, "spawn_sec": 59}, {"enemy_id": 12, "source": "local", "count": 10, "form_count": 1, "hp": 14800, "attack": 650, "base_hp": 14800, "base_attack": 650, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 235, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158560, "race_id": 16, "master_id": 41192, "spawn_sec": 90}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 350, "base_hp": 6000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 60, "attack_interval": 235, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158400, "race_id": 16, "master_id": 41190, "spawn_sec": 92}, {"enemy_id": 14, "source": "local", "count": 36, "form_count": 1, "hp": 20000, "attack": 900, "base_hp": 20000, "base_attack": 900, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115152, "race_id": 16, "special_effect_id": 54, "master_id": 40873, "spawn_sec": 102}, {"enemy_id": 15, "source": "local", "count": 12, "form_count": 1, "hp": 27000, "attack": 1000, "base_hp": 27000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 200, "attack_speed": 70, "attack_wait": 75, "attack_interval": 273, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158416, "race_id": 16, "master_id": 41191, "spawn_sec": 144}, {"enemy_id": 16, "source": "local", "count": 12, "form_count": 1, "hp": 15500, "attack": 300, "base_hp": 15500, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_range": 40, "attack_speed": 1, "attack_wait": 20, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2116736, "special_effect_id": 336, "missile_id": 11, "master_id": 40558, "global_id": 14175, "ranged": true, "spawn_sec": 164}, {"enemy_id": 17, "source": "local", "count": 4, "form_count": 1, "hp": 22000, "attack": 10, "base_hp": 22000, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_speed": 30, "attack_interval": 61, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098352, "special_effect_id": 220, "master_id": 40557, "global_id": 14174, "spawn_sec": 167}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 1, "tags": ["スライム"], "hp": 32000, "attack": 750, "base_hp": 32000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 60, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112592, "missile_id": 11, "master_id": 39888, "global_id": 13505, "ranged": true, "spawn_sec": 296}, {"enemy_id": 19, "source": "local", "count": 3, "form_count": 1, "tags": ["スライム"], "hp": 32000, "attack": 600, "base_hp": 32000, "base_attack": 600, "damage_type": "magical", "armor_defense": 2200, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112576, "missile_id": 11, "master_id": 40827, "ranged": true, "spawn_sec": 296}, {"enemy_id": 20, "source": "local", "count": 4, "form_count": 1, "tags": ["スライム"], "hp": 70000, "attack": 1500, "base_hp": 70000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 800, "magic_defense": 60, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112608, "missile_id": 11, "master_id": 39887, "global_id": 13504, "ranged": true, "spawn_sec": 298}], "popups": ["モリアがいる間は、\n受けるダメージが\n１．２倍になります。", "マスターローグは一定確率で\n物理攻撃を回避します。", "ローパー系の敵から\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レストレイン", "text": "沼地に到着したわけだが……。", "face": "u2690a1"}, {"name": "ヴェルティ", "text": "……見知った顔がいるわね。", "face": "u2906a1"}, {"name": "怪しい男", "text": "おや、また会ったね。", "face": "l77139d921a13"}, {"name": "怪しい男", "text": "ここに来たということは、\nかの少女から事件の真相を聞くことができたのかな？", "face": "l77139d921a13"}, {"name": "イロハ", "text": "……ッ！　どうしてそのことを知って……！？", "face": "u2909a1"}, {"name": "怪しい男", "text": "館で起きたあの痛ましい事件については、\nはじめからすべて知っていたからね。", "face": "l77139d921a13"}, {"name": "怪しい男", "text": "たとえば、犯人がどこに消えたのかも知っているとも。", "face": "l77139d921a13"}, {"name": "怪しい男", "text": "あれは良心の呵責に耐えられなかったようでね。\n自ら沼に沈むことを選択したよ。", "face": "l77139d921a13"}, {"name": "怪しい男", "text": "ここの沼は底なしだと聞く。\n残念ながら、死体を拝むことは叶わないだろうね。", "face": "l77139d921a13"}, {"name": "レストレイン", "text": "……お前は、何者だ？", "face": "u2690a1"}, {"name": "怪しい男", "text": "その問いは、そこにいる探偵殿にしたまえ。", "face": "l77139d921a13"}, {"name": "怪しい男", "text": "かの名高き諮問探偵殿のことだ。\n私の正体に見当はついているのだろう？", "face": "l77139d921a13"}, {"name": "シェリンフォード", "text": "なるほど……想像していたよりも、\n君は無礼な人間のようだね。", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "いや、犯罪者に礼節を求めるのも酷な話か。", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "部下をこき使うのはやめたのかい――『教授』？", "face": "lb0d6c51e3e62"}, {"name": "怪しい男", "text": "正解だよ、探偵殿。\n教え子から君たちの話を聞いて、\n直接会ってみたくなったものでね。", "face": "l77139d921a13"}, {"name": "怪しい男", "text": "さて、改めて名乗ろうか。", "face": "l77139d921a13"}, {"name": "モリア", "text": "我が名はモリア。数学教師の傍ら、\n犯罪コンサルタントを務める、しがない市民だとも。", "face": "l77139d921a13"}, {"name": "レストレイン", "text": "この男が、『教授』……！", "face": "u2690a1"}, {"name": "シェリンフォード", "text": "ふむ……館の事件の犯人も、\n君の教え子だったということかな？", "face": "lb0d6c51e3e62"}, {"name": "モリア", "text": "いいや、あれはただの顧客だったよ。\n犯罪を成し遂げたいと言うから、\n少しばかり力添えをしてやっただけだとも。", "face": "l77139d921a13"}, {"name": "モリア", "text": "そうだ、真相にたどり着いたご褒美に、\n私のほうから事件の補足をしてあげよう。", "face": "l77139d921a13"}, {"name": "モリア", "text": "館の事件の犯人は、ムアなる少女と同じでね。\n先代当主の隠し子だったのだよ。", "face": "l77139d921a13"}, {"name": "モリア", "text": "自分が貴族の血筋だと知ってからは、その地位と財産を\n手に入れたいと思うようになったようでね。", "face": "l77139d921a13"}, {"name": "モリア", "text": "本家筋の者が全員いなくなれば、全部自分のものになると。\nそう考えるようになるのに時間はかからなかったそうだ。", "face": "l77139d921a13"}, {"name": "モリア", "text": "まぁ、館の主人の関係者諸共始末したいと言っていたから、\n恵まれた者への嫉妬もあったのだろうがね。", "face": "l77139d921a13"}, {"name": "モリア", "text": "ああ、魔獣に死体を喰わせるのも、\nそのオーダーを汲んでのことだよ。", "face": "l77139d921a13"}, {"name": "モリア", "text": "本来であれば、死体の損壊を利用して、\nさらに事件の真相を覆い隠すトリックを\n仕掛ける手筈だったのだが……。", "face": "l77139d921a13"}, {"name": "モリア", "text": "その前に自死を選ぶあたり、\nあれは犯罪に向いていなかったようだね。", "face": "l77139d921a13"}, {"name": "モリア", "text": "黒冠の力も与えてあげたというのに。\nいやはや、顧客が一人いなくなって残念だよ。", "face": "l77139d921a13"}, {"name": "シェリンフォード", "text": "……犯人に繋がる証拠だけが\nあまりに見つからないと思ったら、\nあの妙な力が悪さしていたわけか。", "face": "lb0d6c51e3e62"}, {"name": "レストレイン", "text": "犯罪者という人種は、本当になんでも利用するな。\nそこまでして罪から逃れたいのか。", "face": "u2690a1"}, {"name": "モリア", "text": "しっかりと罪を背負えるような者は、\n私を訪ねてきたりはしてこないものでね。", "face": "l77139d921a13"}, {"name": "モリア", "text": "しかしだ……結果的にではあるが、\n今回の事件はハロウィンにぴったりだったと思わないかい？", "face": "l77139d921a13"}, {"name": "モリア", "text": "君たちは真実に至るまで、\n死者に仮装していたわけだからね。", "face": "l77139d921a13"}, {"name": "ヴェルティ", "text": "……おかげさまで、最悪なハロウィンになったわ。", "face": "u2906a1"}, {"name": "ベルナ", "text": "こんなことなら、チェインソン男と\nはしゃいでたほうが百万倍マシだったよ！", "face": "u2908a1"}, {"name": "モリア", "text": "それはそれは、すまないことをしたね。", "face": "l77139d921a13"}, {"name": "モリア", "text": "さて、君たちに嫌われてしまったようだし、\nそろそろお暇するとしようか。", "face": "l77139d921a13"}, {"name": "レストレイン", "text": "私たちが貴様を逃がすと思っているのか？", "face": "u2690a1"}, {"name": "モリア", "text": "ふむ、そちらがその気なら仕方がない。", "face": "l77139d921a13"}, {"name": "モリア", "text": "セバスティア大佐。それからリッパー君。\n君たちの出番が来たようだよ。", "face": "l77139d921a13"}, {"name": "ザ・リッパ―", "text": "待ちくたびれたぜ、先生。\nこっからは、普通に殺し合いでいいんだよなァ？", "face": "l6219dcd0cdc2"}, {"name": "セバスティア大佐", "text": "程々にしておけ。\n目的はあくまで撤退なのだからな。", "face": "l692a26ea2f21"}, {"name": "レストレイン", "text": "当然のように部下も連れて来ていたか。\nだがそれなら、全員まとめて捕まえてやるだけだ……！", "face": "u2690a1"}]}, {"trigger": "end", "lines": [{"name": "レストレイン", "text": "くっ、逃がしたか……！", "face": "u2690a1"}, {"name": "シェリンフォード", "text": "逃走経路は最初から確保していたようだね。\nこれだと追うことは難しそうだ。", "face": "lb0d6c51e3e62"}, {"name": "ベルナ", "text": "なんか、おちょくられたような気分……。", "face": "u2908a1"}, {"name": "ヴェルティ", "text": "本当に、次から次へと、\n厄介な敵が出てくるわね。", "face": "u2906a1"}, {"name": "アンナ", "text": "教授については、今後話し合う必要がありそうですね。"}, {"name": "シェリンフォード", "text": "少々後味の悪い結末にはなってしまったが……。", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "改めて、王子たちにお礼を言わせてもらおう。", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "君たちの協力のおかげで、事件を解決することができた。\n祝祭の準備で忙しいはずなのに手伝ってくれてありがとう。", "face": "lb0d6c51e3e62"}, {"name": "ベルナ", "text": "えへへ、どういたしまして！", "face": "u2908a1"}, {"name": "ベルナ", "text": "……ってそうじゃん！\nこれからハロウィンの準備をしなきゃじゃん！", "face": "u2908a1"}, {"name": "イロハ", "text": "色々あって忘れていましたが、\n私たちはまだまだ、やることがあるのでしたね。", "face": "u2909a1"}, {"name": "ヴェルティ", "text": "でも、殺人事件だとか犯罪者だとかと向き合うよりは、\nよっぽど建設的で、楽しいことだと思うわ。", "face": "u2906a1"}, {"name": "ヴェルティ", "text": "今回の一件で、ムアという少女を助けることはできた。\nだけど同時に、嫌な思いもしたのだもの。", "face": "u2906a1"}, {"name": "ヴェルティ", "text": "――その分だけ、めいっぱいハロウィンを楽しみましょ♪", "face": "u2906a1"}]}]}