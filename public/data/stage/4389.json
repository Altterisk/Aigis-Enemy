n_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102544, "race_id": 8, "change_to": 7, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 377, "global_id": 376, "ranged": true, "phases": [{"hp": 3150, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 378, "global_id": 377, "ranged": true, "condition": 3}], "spawn_sec": 36}], "dialogue": [{"trigger": "start", "lines": [{"name": "暗黒騎士デシウス", "text": "ここも外れか……。もっと奥の方を探さねば。", "face": "ld336215cf73a"}, {"name": "オーク", "text": "あれは……さっきの強いやつら……っ！！　\nふはははっ……また戦えるぞ……、\n戦えるぞおおおッ！！", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "ちぃっ。もう追いついてきたのか。", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "下手にこそこそ行くよりも、\nオーク共の進軍に紛れた方が早いかもしれんな。\n連中は獲物を見つけて躍起になっていることだし……。", "face": "ld336215cf73a"}, {"name": "アンナ", "text": "王子！　オークたちを発見しました！\n急ぎ戦闘の準備を！", "face": "l1813779fe06c"}, {"name": "アルス", "text": "なんだかここにいると、力が湧いてくる気が……。", "face": "u73"}, {"name": "バシラ", "text": "どうやらあの石碑は、\nアーチャーに力を与えてくれるみたいです！", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士デシウス", "text": "くそ……。これじゃまともに探すこともできぬ。\nオーク共なんぞ放っておいて\n一旦引きたいところだが……。", "face": "ld336215cf73a"}, {"name": "オーク", "text": "逃がさぬぞ……！　お前らぁああ！！", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "アレは一体どこにあるのだ……っ。\n森の奥にあるやもしれんが、この状態で行くのは……。", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "ぐぬぬ……。\nアレさえあればこのような野蛮なヤツらを利用する\n必要などないというのに……！！", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "オーク、森の奥にもっと強い奴らがいるようだ。\nそっちへ行こうじゃないか？", "face": "ld336215cf73a"}, {"name": "オーク", "text": "うるさい！　俺に指図するな！！\n……ちっ、この森の奥に行けば\n強い奴がいるんだな！？", "face": "l0632d7f6f22d"}, {"name": "アンナ", "text": "王子！　敵が森の奥へ向かいます！\n私たちも追いかけましょう！", "face": "l1813779fe06c"}]}], "map": {"image": "Map920051_3617", "w": 960, "h": 640, "spots": [{"k": "b", "x": 653, "y": 15}, {"k": "m", "x": 208, "y": 473, "id": 200}, {"k": "m", "x": 328, "y": 462, "id": 201}, {"k": "m", "x": 453, "y": 454, "id": 202}, {"k": "m", "x": 582, "y": 483, "id": 203}, {"k": "m", "x": 84, "y": 460, "id": 204}, {"k": "m", "x": 85, "y": 246, "id": 205}, {"k": "m", "x": 191, "y": 289, "id": 206}, {"k": "m", "x": 300, "y": 334, "id": 207}, {"k": "m", "x": 371, "y": 268, "id": 208}, {"k": "m", "x": 362, "y": 174, "id": 209}, {"k": "m", "x": 274, "y": 113, "id": 210}, {"k": "m", "x": 484, "y": 104, "id": 211}, {"k": "m", "x": 546, "y": 192, "id": 212}, {"k": "m", "x": 625, "y": 259, "id": 213}, {"k": "m", "x": 730, "y": 307, "id": 214}, {"k": "m", "x": 850, "y": 336, "id": 215}, {"k": "m", "x": 846, "y": 142, "id": 216}, {"k": "m", "x": 732, "y": 109, "id": 217}, {"k": "r", "x": 519, "y": 277, "id": 300}, {"k": "r", "x": 289, "y": 402, "id": 301}, {"k": "r", "x": 126, "y": 178, "id": 302}, {"k": "r", "x": 417, "y": 138, "id": 303}, {"k": "r", "x": 642, "y": 349, "id": 304}, {"k": "r", "x": 113, "y": 323, "id": 305}, {"k": "r", "x": 804, "y": 266, "id": 306}, {"k": "r", "x": 613, "y": 171, "id": 307}, {"k": "r", "x": 195, "y": 209, "id": 308}, {"k": "r", "x": 891, "y": 273, "id": 309}]}, "start_cost": 10, "active": true, "story_talk": true, "name_en": "Berserker's Battle Line", "description_en": "Stop the Orc formation and the advancing Dark Knight Decius hidden among them!\n<Attack and defense up for Archer-type>\nExtreme (★1 target: average Lv25)"}