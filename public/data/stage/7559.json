pawn_sec": 116}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["女性"], "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099584, "race_id": 16, "special_effect_id": 222, "missile_id": 57, "missile": {"speed": 12.0}, "master_id": 179, "global_id": 178, "ranged": true, "spawn_sec": 142}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 40000, "attack": 780, "base_hp": 40000, "base_attack": 780, "damage_type": "physical", "armor_defense": 400, "attack_range": 310, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2126112, "race_id": 16, "special_effect_id": 129, "missile_id": 507, "missile": {"speed": 16.0}, "master_id": 32966, "global_id": 6583, "ranged": true, "spawn_sec": 168}], "popups": ["ケイティがいる間、\n全ての敵の攻撃力と\n防御力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シビラ", "text": "――どうして、こんなことになっているのかしら。", "face": "u39"}, {"name": "ベルニス", "text": "えぇとぉ、学園の視察ついでに、\n学生気分でお茶会とかしていたはずですよね？", "face": "u41"}, {"name": "ナナリー", "text": "そこで……王子の魅力を語っていたら……。\nいつの間にか、周囲に人が集まってきて……。", "face": "u29"}, {"name": "学生", "text": "シビラ殿下主催！\n王子ファンクラブ、\n王子の魅力を語る会の会場はこちらでーす！", "face": "l8a3b29587dd5"}, {"name": "シビラ", "text": "……いつの間にか、主催になっていたようね。\nところで、王子ファンクラブというのは？", "face": "u39"}, {"name": "学生", "text": "はいっ、シビラ殿下！\nつい先程設立したばかりの、\n王子殿下の魅力を語り合う部活です！", "face": "l8a3b29587dd5"}, {"name": "ナナリー", "text": "……なるほど？", "face": "u29"}, {"name": "シビラ", "text": "国からの強制ではなく、民が自主的に\n王子を慕っているというのなら、\nそれを止める権利はないわね……。", "face": "u39"}, {"name": "ベルニス", "text": "えっと、でもどんどん人が増えてますよ？\n大丈夫なんでしょうか……？", "face": "u41"}, {"name": "学生", "text": "はいっ！　実は他の部活からも、\n部費を持ち寄って次々に転部希望者が――", "face": "l8a3b29587dd5"}, {"name": "クレア", "text": "――こらー！\n他の部活から部費を巻き上げるなんて許しませんよー！\n……って、あれ？　悪の秘密部活の会合は？　演説は？", "face": "u1444a1"}, {"name": "シビラ", "text": "いいえクレア、ここは王子を慕う者の集い。\n部費は自主的に、生徒たちが持ち寄っているだけよ？", "face": "u39"}, {"name": "クレア", "text": "えっ、そうなんですか？\nじゃあ普通にファンクラブ活動しているだけ……？", "face": "u1444a1"}, {"name": "ナナリー", "text": "です……。\nただちょっと、規模が大きいですけど……。", "face": "u29"}, {"name": "クレア", "text": "そっか、普通のファンクラブ……。\nそれなら……私も入っちゃおうかなぁ……？", "face": "u1444a1"}, {"name": "ケイティ", "text": "こらっ！　流されてどうするのですか！", "face": "u1442a1"}, {"name": "クレア", "text": "えぇっ、でもケイティ先生も王子のこと好きでしょ！？\n一緒にファンクラブ入っちゃいましょうよ！", "face": "u1444a1"}, {"name": "ケイティ", "text": "えっ……あの、それは、えっと……。", "face": "u1442a1"}, {"name": "コーネリア", "text": "（ファンクラブ、かぁ……。\nちょっといいなぁ……）", "face": "u1441a1"}, {"name": "アンナ", "text": "……あの、王子？\n学生どころか、軍関係者まで\nファンクラブに入ってしまいそうなのですが……。", "face": "l87479ab4701a"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "このままでは部費が一箇所に集中してしまいます。\n王子、健全な部活運営のため、\nファンクラブの暴走を止めますよ！", "face": "l87479ab4701a"}]}, {"trigger": "end", "lines": [{"name": "学生", "text": "ああ……王子殿下の戦いを間近で……。\nやっぱり、俺たちの殿下はカッコイイ……ガクッ……。", "face": "l8a3b29587dd5"}, {"name": "シビラ", "text": "ふふっ、遅かったじゃない。\nでも盛り上がりを見ると、\nちょうどいいタイミングだったのかしら？", "face": "u39"}, {"name": "ベルニス", "text": "……あれ、もしかしてシビラ殿下、\nこうなるの見越して遊んでいたんですか？", "face": "u41"}, {"name": "シビラ", "text": "せっかく王国の学園に入ったんだもの、\n生徒だって、王子の戦いを見てみたいでしょう？", "face": "u39"}, {"name": "クレア", "text": "ああ……それで私たちまで巻き込んだんですね……。\nふふふ、でも皆嬉しそうです。", "face": "u1444a1"}, {"name": "クレア", "text": "いま学園に入ってくるような子たちは、\n魔物復活と、王子の魔王討伐を\nずっと見続けてきた人ばかりですからねー。", "face": "u1444a1"}, {"name": "シビラ", "text": "憧ればかり抱いて、現実を見ないと毒になるから。\n現実の王子も見せてあげて、\n時々憧れとのズレを調整してあげないとね。", "face": "u39"}, {"name": "クレア", "text": "あ、分かります。\n想うばかりだと、相手を美化しすぎたりしますよね。", "face": "u1444a1"}, {"name": "クレア", "text": "でも……えへへっ。\nやっぱり戦ってる時の王子はかっこいいですよ。", "face": "u1444a1"}, {"name": "クレア", "text": "普段は頼りないところも、かわいいところもあるけれど、\nいざという時に一番頼りになる人ですからね！", "face": "u1444a1"}, {"name": "ケイティ", "text": "――はい、そろそろ落ち着きましたか？\n全員で教室の片付けをしますよ！", "face": "u1442a1"}, {"name": "アンナ", "text": "……一時はどうなることかと思いましたが、\n無事に騒動もおさまりましたね。"}, {"name": "アンナ", "text": "王子、此度の……事件？　いえ、視察ですね。\n此度の視察、お疲れさまでした！"}]}], "map": {"image": "Map920173_4091", "w": 960, "h": 640, "spots": [{"k": "b", "x": 955, "y": 257}, {"k": "b", "x": 955, "y": 470}, {"k": "b", "x": 955, "y": 371}, {"k": "m", "x": 155, "y": 192, "id": 200}, {"k": "m", "x": 155, "y": 313, "id": 201}, {"k": "m", "x": 365, "y": 313, "id": 202}, {"k": "m", "x": 225, "y": 192, "id": 203}, {"k": "m", "x": 225, "y": 313, "id": 204}, {"k": "m", "x": 295, "y": 192, "id": 205}, {"k": "m", "x": 295, "y": 313, "id": 206}, {"k": "m", "x": 365, "y": 192, "id": 207}, {"k": "m", "x": 585, "y": 254, "id": 208}, {"k": "m", "x": 585, "y": 192, "id": 209}, {"k": "m", "x": 655, "y": 192, "id": 210}, {"k": "m", "x": 725, "y": 192, "id": 211}, {"k": "m", "x": 365, "y": 465, "id": 212}, {"k": "m", "x": 440, "y": 465, "id": 213}, {"k": "m", "x": 585, "y": 465, "id": 214}, {"k": "m", "x": 655, "y": 465, "id": 215}, {"k": "m", "x": 725, "y": 465, "id": 216}, {"k": "m", "x": 585, "y": 313, "id": 217}, {"k": "m", "x": 655, "y": 313, "id": 218}, {"k": "m", "x": 725, "y": 313, "id": 219}, {"k": "m", "x": 795, "y": 254, "id": 220}, {"k": "m", "x": 258, "y": 372, "id": 221}, {"k": "m", "x": 479, "y": 374, "id": 222}, {"k": "m", "x": 701, "y": 375, "id": 223}, {"k": "m", "x": 440, "y": 213, "id": 224}, {"k": "m", "x": 510, "y": 213, "id": 225}, {"k": "m", "x": 510, "y": 465, "id": 226}, {"k": "m", "x": 295, "y": 476, "id": 227}, {"k": "m", "x": 155, "y": 254, "id": 228}, {"k": "m", "x": 365, "y": 254, "id": 229}, {"k": "m", "x": 795, "y": 192, "id": 230}, {"k": "m", "x": 795, "y": 313, "id": 231}, {"k": "m", "x": 865, "y": 254, "id": 232}, {"k": "m", "x": 795, "y": 465, "id": 233}, {"k": "m", "x": 865, "y": 465, "id": 234}, {"k": "m", "x": 225, "y": 476, "id": 235}, {"k": "m", "x": 155, "y": 476, "id": 236}, {"k": "r", "x": 83, "y": 159, "id": 300}, {"k": "r", "x": 226, "y": 235, "id": 301}, {"k": "r", "x": 299, "y": 244, "id": 302}, {"k": "r", "x": 440, "y": 257, "id": 303}, {"k": "r", "x": 511, "y": 267, "id": 304}, {"k": "r", "x": 702, "y": 236, "id": 305}, {"k": "r", "x": 866, "y": 171, "id": 306}, {"k": "r", "x": 869, "y": 305, "id": 307}, {"k": "r", "x": 421, "y": 505, "id": 308}, {"k": "r", "x": 494, "y": 505, "id": 309}, {"k": "r", "x": 644, "y": 506, "id": 310}, {"k": "r", "x": 716, "y": 506, "id": 311}, {"k": "r", "x": 868, "y": 508, "id": 312}]}, "start_cost": 10, "active": true, "name_en": "Prince Fan Club", "description_en": "The strongest force standing in the way at the end is the Prince Fan\nClub! To ensure healthy club operations,\nthe Prince must stop the club's rampage with his own hands!\nDivine Rank (Guide for 1★: Avg Lv50)"}