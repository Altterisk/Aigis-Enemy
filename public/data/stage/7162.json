{"quest_id": 7162, "name": "転生の英傑", "description": "転生の英傑アンブローズの頼みを聞き入れ、\nフレイムドラゴンが生息する封印の地から\n英傑の神器を回収せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "縛られた空、解放の戦端", "event_category": "History", "mission_id": 920151, "map_no": 3479, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "hp": 250000, "base_hp": 250000, "damage_type": "magical", "armor_defense": 1200, "magic_defense": 40, "attack_speed": 1, "attack_wait": 1, "move_speed": 2400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2121456, "race_id": 2, "special_effect_id": 275, "change_to": 1, "master_id": 32311, "global_id": 5930, "to_global_id": 5931, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 250000, "base_hp": 250000, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_speed": 1, "attack_wait": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2121472, "race_id": 2, "special_effect_id": 275, "change_to": 2, "master_id": 32312, "global_id": 5931, "to_global_id": 5932}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 250000, "base_hp": 250000, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_speed": 1, "attack_wait": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2121488, "race_id": 2, "special_effect_id": 475, "master_id": 32313, "global_id": 5932}, {"enemy_id": 4, "source": "local", "count": 15, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 4, "master_id": 485, "glo