6, "race_id": 18, "change_to": 5, "master_id": 486, "global_id": 485, "to_global_id": 626, "spawn_sec": 59}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 900, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105248, "race_id": 18, "change_to": 6, "master_id": 627, "global_id": 626}, {"enemy_id": 10, "source": "local", "count": 10, "form_count": 1, "hp": 6000, "attack": 900, "base_hp": 6000, "base_attack": 900, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112544, "race_id": 18, "master_id": 30694, "global_id": 4313, "spawn_sec": 91}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 7, "master_id": 625, "global_id": 624, "to_global_id": 483, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 98}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 8, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 1, "hp": 12000, "attack": 1300, "base_hp": 12000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112560, "race_id": 18, "master_id": 30695, "global_id": 4314, "spawn_sec": 121}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "hp": 4000, "attack": 700, "base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 15, "attack_interval": 79, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122272, "race_id": 18, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 32482, "global_id": 6101, "ranged": true, "spawn_sec": 139}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "hp": 5000, "attack": 1200, "base_hp": 5000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103936, "race_id": 18, "master_id": 987, "global_id": 986, "spawn_sec": 169}], "dialogue": [{"trigger": "start", "lines": [{"name": "サナラ", "text": "――あのぉ、本当にアンブローズさんなんですか？\n英傑で、私たちと一緒に戦った、\nあの妙齢美人のアンブローズさん……？", "face": "u921"}, {"name": "アンブローズ？", "text": "何度も言ってるじゃないですかぁ。\nサナラちゃんは本当に心配性なんですからぁ。", "face": "u1088a1"}, {"name": "アトナテス", "text": "……仕方ないだろ？\n最後にお前に会った時は、\nもっと大人っぽい容姿だっただろ。", "face": "u908"}, {"name": "アンブローズ？", "text": "むぅぅぅぅ。\nアトナテスちゃんも信じてないんですかぁ？", "face": "u1088a1"}, {"name": "アンブローズ", "text": "あたしこそ、歴史に寄り添い未来を守る！\n偉大なる転生魔導士のアンブローズちゃんですよ？", "face": "u1088a1"}, {"name": "トゥアン", "text": "転生ってただの肩書じゃなかったのか？\nこんな小さくなって現れると、\nどうしても別人か子孫だと思うものだろう。", "face": "u1006a1"}, {"name": "アンブローズ", "text": "小さくなっちゃったのは！　あたしも想定外なのぉ！", "face": "u1088a1"}, {"name": "アンブローズ", "text": "肉体生成魔導装置が壊れちゃってて、\n成長が中途半端になっちゃったんですよねぇ。", "face": "u1088a1"}, {"name": "アトナテス", "text": "……魔法で身体を生成して、\n魂を移して永遠に生きてるって本当だったのか。\nてっきり酒飲みの戯言だと思ってたぜ。", "face": "u908"}, {"name": "アンブローズ", "text": "おかげで魔王との決戦にも間に合わなかったし……。\nごめんねぇ、英雄王の子孫ちゃん。", "face": "u1088a1"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "アンブローズ", "text": "やっぱり器おっきいなぁ♪\n英雄王ちゃんの血かな？\n教育係が良かったんですかねぇ♪", "face": "u1088a1"}, {"name": "アンブローズ", "text": "まぁそういうわけで、\nこれからの天界での戦いを助けるべく、\nあたしも戦力に加わってあげたいんだけど……。", "face": "u1088a1"}, {"name": "ソラス", "text": "――神器を封印しておいた場所に、\n魔界アリとフレイムドラゴンが住み着いていて、\n自分ひとりでは取りにいけなくなってしまったと。", "face": "u904"}, {"name": "アンブローズ", "text": "そうなんですよぉ♪\nなので子孫ちゃんの実力を見るついでに、\n一緒に神器回収デートをしちゃおうかなーって♪", "face": "u1088a1"}, {"name": "アトナテス", "text": "……はぁ。\nまぁ、お前の実力はよく知ってるしな。\n手伝ってやるとするか。", "face": "u908"}, {"name": "トゥアン", "text": "それにこんな人里近くの渓谷に\nフレイムドラゴンがいるっていうのも問題だしな。\n麓に被害が出る前に討伐してしまおう。", "face": "u1006a1"}, {"name": "クローディア", "text": "――と言っている間に、巣の近くまで来たようですよ。\nここからでも、フレイムドラゴンの\n強力な魔力が感じられます。", "face": "u163"}, {"name": "アンブローズ", "text": "それじゃあ子孫ちゃん、\nはりきってドラゴン退治しちゃいましょうねぇ♪", "face": "u1088a1"}]}, {"trigger": "end", "lines": [{"name": "アンブローズ", "text": "ふっふっふ、神器奪取成功ですぅ♪", "face": "u1088a1"}, {"name": "アンブローズ", "text": "これで全盛期の、パーフェクトな\nアンブローズちゃん復活ですよぉ！", "face": "u1088a1"}, {"name": "トゥアン", "text": "…………？\nパーフェクトというには身長が低いぞ？", "face": "u1006a1"}, {"name": "アンブローズ", "text": "うっ……それはもう、どうしようもないというか……。\n魔導装置が壊れちゃった以上、\nしばらくはこの身体で我慢するしかないというか……。", "face": "u1088a1"}, {"name": "アトナテス", "text": "自前で永遠に生きられるからぁ、\n神さまパワーで永遠にしなくても大丈夫ですぅ♪\n――なんて言ってたんだから、自業自得だな。", "face": "u908"}, {"name": "アンブローズ", "text": "なんで覚えてるんですかぁぁぁっ！！", "face": "u1088a1"}, {"name": "アトナテス", "text": "お前の言葉遣いは脳にこびりつくんだよ！！", "face": "u908"}, {"name": "アンナ", "text": "……と、ともあれ、\n心強い味方が……増えました、ね？"}, {"name": "アンナ", "text": "それでは、王国へ帰還しましょうか。\n此度のフレイムドラゴン討伐、お疲れさまでした！"}]}], "active": true}