{"quest_id": 7662, "name": "これならノーカン", "description": "くじや射的の屋台を出した鬼刃衆。しかし\n王国の精鋭に景品を乱獲されてしまい……\nかくなる上は、これを使うしかあるまい。\n神級（★１獲得の目安：平均Lv50）", "event": "金魚姫と夏夜の肝試し", "event_category": "History", "mission_id": 920180, "map_no": 4134, "level": 80, "multiplier": 0.8, "charisma": 65, "exp": 300, "gold": 1500, "drops": [{"card": 12, "c": 1}, {"card": 24, "c": 1}, {"card": 133, "c": 1}, {"item": 1002, "c": 1}, {"item": 5003, "c": 2}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 13, "form_index": 0, "form_count": 1, "hp": 10400, "attack": 360, "base_hp": 13000, "base_attack": 450, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_interval": 82, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2138256, "race_id": 16, "special_effect_id": 54, "change_to": 1, "change_condition": 1, "master_id": 35049, "global_id": 8666, "variants": [{"hp": 10400, "attack": 360, "base_hp": 13000, "base_attack": 450, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_interval": 82, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2138320, "race_id": 16, "special_effect_id": 1075, "master_id": 35050, "global_id": 8667}], "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "hp": 720, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 40}, {"enemy_id": 4, "source": "local", "count": 31, "form_index": 0, "form_count": 1, "tags": ["忍者"], "hp": 3600, "attack": 480, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098896, "race_id": 16, "master_id": 436, "global_id": 435, "spawn_sec": 73}, {"enemy_id": 5, "source": "local", "count": 39, "form_index": 0, "form_count": 1, "hp": 6400, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 160, "attack_speed": 40, "attack_wait": 40, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101856, "race_id": 16, "special_effect_id": 54, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 432, "global_id": 431, "ranged": true, "spawn_sec": 88}, {"enemy_id": 6, "source": "local", "count": 17, "form_index": 0, "form_count": 1, "tags": ["忍者"], "hp": 2400, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_interval": 76, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099968, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 208, "global_id": 207, "ranged": true, "spawn_sec": 122}, {"enemy_id": 7, "source": "local", "count": 9, "form_index": 0, "form_count": 1, "hp": 22400, "attack": 800, "base_hp": 28000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_interval": 34, "move_speed": 2500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2138272, "race_id": 16, "special_effect_id": 827, "change_to": 7, "change_condition": 1, "master_id": 35051, "global_id": 8668, "variants": [{"hp": 22400, "attack": 800, "base_hp": 28000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_interval": 26, "move_speed": 2500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2138336, "race_id": 16, "special_effect_id": 1076, "master_id": 35052, "global_id": 8669}], "spawn_sec": 156}], "popups": ["鬼刃衆は一定確率で\n物理攻撃を回避します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "鬼刃衆", "text": "──そんな馬鹿なぁああああ！\nこれで十回連続でアタリくじだと！？\nこ、こんなことがあってたまるか！", "face": "l23d644149b06"}, {"name": "ラトゥール", "text": "う～ん、今日の私ってばツイてるわね♪\nあ、王子に誓ってイカサマはしてないわよ？", "face": "u1541a1"}, {"name": "下忍", "text": "射的の景品が、全部……全部持って行かれた……。", "face": "l5c27f86cde42"}, {"name": "ダニエラ", "text": "あら、店員さん？　景品の補充、お願いね♪", "face": "u518"}, {"name": "ナナリー", "text": "鬼刃衆のおじさん。\n型抜き、全部終わりました。\n換金の方をお願いします。", "face": "u657"}, {"name": "鬼刃衆", "text": "ぬぉおおおお！？　全て完璧にくり貫かれている！\nこれでは今日の売り上げが！　売上がぁああああッ！", "face": "l23d644149b06"}, {"name": "下忍", "text": "くじと射的で景品を根こそぎ奪われ、\n型抜きで挑戦料を全て回収されています！\nこのままでは大赤字！　姫様に合わせる顔が……。", "face": "l5c27f86cde42"}, {"name": "鬼刃衆", "text": "……かくなる上は、これを使うしかあるまい。", "face": "l23d644149b06"}, {"name": "下忍", "text": "そっ、それは『アンモナイトクラーケン』の骨片！", "face": "l5c27f86cde42"}, {"name": "下忍", "text": "しかし……もし姫様にバレたら、\nまた『めっ』されてしまうのでは！？", "face": "l5c27f86cde42"}, {"name": "鬼刃衆", "text": "魔神の欠片ではないからノーカンだ！\nそれよりもこれだけの損失を出しておきながら、\nおめおめと鬼刃姫様のもとに戻れるものか！", "face": "l23d644149b06"}, {"name": "鬼刃衆", "text": "覚悟を決めよ、行くぞ！　──ごくり。", "face": "l23d644149b06"}, {"name": "下忍", "text": "ええい、ままよ！　──ごくりごくり。", "face": "l5c27f86cde42"}, {"name": "鬼刃衆", "text": "うぉおおおおッ！　みなぎってきたぁ！\n覚悟しろ縁日荒らしめ！　これぞ我らの新必殺！\nアンモナイトクラーケン式回転殺法だーッ！！", "face": "l23d644149b06"}, {"name": "ラトゥール", "text": "へぇ……尋常な勝負の結果に異を唱えるんだ。\nこれは王国の公認賭博師として見逃せないわね。", "face": "u1541a1"}, {"name": "ラトゥール", "text": "いいわ、裸になるまでむしり取ってあげる♪", "face": "u1541a1"}]}, {"trigger": "end", "lines": [{"name": "鬼刃姫", "text": "──こらー！！　何やってるのー！？", "face": "u435"}, {"name": "鬼刃衆", "text": "ひっ、姫様！　こっ、これはその──", "face": "l23d644149b06"}, {"name": "鬼刃姫", "text": "お祭りの日に暴れちゃダメでしょ！\nアンモナイトクラーケンの真似なんかして、\nお客さんたちが怪我したらどうするの！？", "face": "u435"}, {"name": "鬼刃衆", "text": "……面目次第もございませぬ。", "face": "l23d644149b06"}, {"name": "下忍", "text": "折角の夏祭り、今日の屋台の売り上げで、\n鬼刃姫に豪遊してもらいたかったのです……。", "face": "l5c27f86cde42"}, {"name": "鬼刃姫", "text": "その気持ちは嬉しいけど、\n公平な勝負の結果なんでしょう？\n負けを認めない方が格好悪いよ。", "face": "u435"}, {"name": "鬼刃姫", "text": "それにお金がなくたって、\n鬼刃衆のみんなが一緒だったら、\nそれがあてにとって一番のお祭りだよ。", "face": "u435"}, {"name": "鬼刃衆", "text": "うっうっ……鬼刃姫様……\nそれほどまでに我らのことを……。", "face": "l23d644149b06"}, {"name": "ダニエラ", "text": "あー、えっと……取った景品、返すわね？", "face": "u518"}, {"name": "ラトゥール", "text": "私も少し調子に乗りすぎちゃったかも……。", "face": "u1541a1"}, {"name": "鬼刃姫", "text": "ううん、返さなくて大丈夫だよ。\nそれは二人が実力で勝ち取った景品だし。\n他の屋台では手加減してあげてほしいけど。", "face": "u435"}, {"name": "ナナリー", "text": "それなら……型抜きでもらったお金、\nみんなでパーッと使っちゃいませんか？", "face": "u657"}, {"name": "鬼刃姫", "text": "……あてたちも一緒で良いの？", "face": "u435"}, {"name": "ナナリー", "text": "はい、宵越しのお金は持ちません。\nきっとその方が楽しいと思いますから。", "face": "u657"}, {"name": "鬼刃姫", "text": "ありがと……それじゃあみんな！\n今年の夏も、お祭りを楽しむよー！", "face": "u435"}, {"name": "鬼刃衆", "text": "うぉおおおおおおおおお！！", "face": "l23d644149b06"}, {"name": "鬼刃姫", "text": "あ、お祭りが終わったら『めっ』だからね？", "face": "u435"}, {"name": "鬼刃衆", "text": "──え。", "face": "l23d644149b06"}]}], "map": {"image": "Map920180_4134", "w": 960, "h": 640, "spots": [{"k": "b", "x": 7, "y": 315}, {"k": "m", "x": 129, "y": 319, "id": 200}, {"k": "m", "x": 129, "y": 254, "id": 201}, {"k": "m", "x": 130, "y": 385, "id": 202}, {"k": "m", "x": 210, "y": 385, "id": 203}, {"k": "m", "x": 212, "y": 319, "id": 204}, {"k": "m", "x": 212, "y": 254, "id": 205}, {"k": "m", "x": 294, "y": 255, "id": 206}, {"k": "m", "x": 294, "y": 318, "id": 207}, {"k": "m", "x": 294, "y": 385, "id": 208}, {"k": "m", "x": 379, "y": 255, "id": 209}, {"k": "m", "x": 381, "y": 318, "id": 210}, {"k": "m", "x": 381, "y": 385, "id": 211}, {"k": "m", "x": 470, "y": 387, "id": 212}, {"k": "m", "x": 470, "y": 318, "id": 213}, {"k": "m", "x": 468, "y": 253, "id": 214}, {"k": "m", "x": 555, "y": 252, "id": 215}, {"k": "m", "x": 556, "y": 319, "id": 216}, {"k": "m", "x": 557, "y": 387, "id": 217}, {"k": "m", "x": 641, "y": 253, "id": 218}, {"k": "m", "x": 642, "y": 318, "id": 219}, {"k": "m", "x": 643, "y": 388, "id": 220}, {"k": "m", "x": 732, "y": 252, "id": 221}, {"k": "m", "x": 734, "y": 318, "id": 222}, {"k": "m", "x": 735, "y": 390, "id": 223}, {"k": "r", "x": 85, "y": 189, "id": 300}, {"k": "r", "x": 143, "y": 189, "id": 301}, {"k": "r", "x": 275, "y": 189, "id": 302}, {"k": "r", "x": 605, "y": 189, "id": 303}, {"k": "r", "x": 93, "y": 475, "id": 304}, {"k": "r", "x": 162, "y": 474, "id": 305}, {"k": "r", "x": 354, "y": 477, "id": 306}, {"k": "r", "x": 607, "y": 478, "id": 307}, {"k": "r", "x": 507, "y": 191, "id": 308}]}, "start_cost": 15, "active": true}