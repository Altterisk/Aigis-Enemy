2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 63}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 5250, "attack": 630, "base_hp": 5000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097808, "master_id": 43, "global_id": 42, "spawn_sec": 90}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "何が起こったのでしょうか！？", "face": "l3b5e59a6cf4b"}, {"name": "ピピン", "text": "気を付けてください！\nあの人の体から恐ろしいくらいの魔の力を感じる……。", "face": "u275"}, {"name": "魔神ロノベ", "text": "……我が忠実なる下僕よ。お前の願い、叶えよう……。\nこの者たちの命を一片も残さずに冥府へ送ろうぞ！！", "face": "l5b6da4a97ede"}, {"name": "アンナ", "text": "どうやら魔神に乗っ取られてしまったようです。\nお気を付けください！", "face": "l3b5e59a6cf4b"}]}, {"trigger": "end", "lines": [{"name": "魔神ロノベ", "text": "ふむ。この体ではこれが限界か……。\nふはは、命拾いしたな。\n再び会えるのを楽しみにしていよう……！！", "face": "l5b6da4a97ede"}, {"name": "ピピン", "text": "二度と会いたくないわ！！", "face": "u275"}, {"name": "ミトラ", "text": "どうやら助けてもらったらしいな。\nあたしの名はミトラ。\nこの地で魔神の骨片を護っていたんだが……。", "face": "u276"}, {"name": "ミトラ", "text": "突如あいつらがやってきて、この土地の民を\n人質に骨片を要求して来よってな……。", "face": "u276"}, {"name": "ミトラ", "text": "まさか魔神をひょう依させるとは……。\n恐ろしい執念だ。悔しいが、魔神の骨片は\nあたしらの力じゃ護り切れん。", "face": "u276"}, {"name": "ミトラ", "text": "おぬしたち、すまんがこれを\n預かってはもらえぬか？", "face": "u276"}, {"name": "アンナ", "text": "ミトラさん……。わかりました。\n私たちがこの魔神の骨片を魔物たちから\n護ってみせます。魔神復活など絶対にさせません。", "face": "l3b5e59a6cf4b"}, {"name": "ミトラ", "text": "大きな借りができてしまったな。\nだが、いずれこの恩は必ず返す。", "face": "u276"}, {"name": "アンナ", "text": "ふふ。ではその時にまたお会いできますね。"}, {"name": "アンナ", "text": "それにしても、困りましたね。\nこの骨片を王子が持っている限り\n魔神の完全復活は防げますが……。", "face": "l3b5e59a6cf4b"}, {"name": "アンナ", "text": "先ほどのように骨片だけでも\n魔神をひょう依させる力があるとは……。\n侮れませんね。", "face": "l3b5e59a6cf4b"}]}], "active": true}