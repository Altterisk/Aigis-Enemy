"count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 230, "attack_speed": 1, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30402, "global_id": 4021, "ranged": true, "from_condition": 5}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 2, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 70, "attack_wait": 33, "attack_interval": 197, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 70, "change_to": 13, "change_condition": 5, "master_id": 30403, "global_id": 4022, "to_condition": 5, "to_global_id": 4023, "spawn_sec": 154}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 220, "attack_speed": 70, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30404, "global_id": 4023, "ranged": true, "from_condition": 5}, {"enemy_id": 15, "source": "local", "count": 3, "form_count": 1, "tags": ["スライム"], "hp": 30000, "attack": 800, "base_hp": 30000, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 60, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112608, "missile_id": 11, "master_id": 30698, "global_id": 4317, "ranged": true, "spawn_sec": 163}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "あの……リエーレさん？\nご案内には感謝しますが、\nこの、暗くて生暖かい場所は、もしかして……。", "face": "l8531607319ce"}, {"name": "リエーレ", "text": "ん、見りゃわかるだろ？　レヴィアタンの口の中だよ。\nほら、あのでっかくて白い柱みたいなのがヤツの歯な。", "face": "u490"}, {"name": "ロイ", "text": "なんと！？　魔神の口の中……ですと！？\n……………………うーむ（ばったり）。", "face": "u11"}, {"name": "ケイティ", "text": "リエーレさん！\nどうして先に言ってくださらないのですか？\nロイさん、驚いて倒れてしまったじゃないですか。", "face": "u114"}, {"name": "リエーレ", "text": "いまさらなに驚いてんのさ？\nレヴィアタンの体内に通じる入口に\n案内してやるって、ちゃんと言っただろ？", "face": "u490"}, {"name": "アンナ", "text": "ですが、いくらなんでも口だなんて……。\nこれではレヴィアタンに\n食べられてしまったようなものではないですか。", "face": "l4d8299da26e8"}, {"name": "リエーレ", "text": "しょうがないだろ？　入口はここしかないんだから。\nヤツの活動を止めたいなら、ここから体内に侵入して\n心臓を止めるしか方法はないんだぞ？", "face": "u490"}, {"name": "リエーレ", "text": "それに、慣れれば外より居心地はいいと思うぜ？\nヘンゼルが言ってたけど、コイツの体内は\n魔界の瘴気の影響が及ばないらしいんだ。", "face": "u490"}, {"name": "ソーマ", "text": "あ、本当です！\nさっきより身体が軽くなった気がします。", "face": "u23"}, {"name": "モーティマ", "text": "けどよぉ、歯ぁ一本ですら俺よりデカいんだぜ？\n魔神の心臓を止めるなんて、本当にできんのかよ？", "face": "u14"}, {"name": "リエーレ", "text": "なんだよおっさん、もしかしてビビってんの？\nははっ、見かけによらず可愛い性格してんねぇ。", "face": "u490"}, {"name": "モーティマ", "text": "び……ビビってねぇし！\nこんなでけえだけの歯なんざ、\n引っこ抜いて商人にでも売りさばいて――", "face": "u14"}, {"name": "モーティマ", "text": "――って、うわぁあッ！？　お、おいッ！　\n涎が溜まってる場所になんか潜んでやがるぞ！", "face": "u14"}, {"name": "アンナ", "text": "なッ……なんですか、あの奇怪な魔物は？\nなぜ……スライムの中に、人の死骸が……？", "face": "l8531607319ce"}, {"name": "リエーレ", "text": "あぁ。ヤツは酸で人を溶かして食うスライムだ。\nうっかり迷い込んだ人間の多くはヤツの餌食になる。", "face": "u490"}, {"name": "リエーレ", "text": "気をつけなよ？　レヴィアタンの体内は\nこの通り魔物の巣窟になってるらしいぜ？", "face": "u490"}, {"name": "ケイティ", "text": "それを先に言ってください！\n王子、敵襲です。応戦しましょう！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "ふぅ……なんとか敵を撃退することができましたね。"}, {"name": "モーティマ", "text": "……ったく。\nなんで魔神の身体の中に魔物どもがいやがんだよ？", "face": "u14"}, {"name": "ロイ", "text": "ふむ……ひょっとするとレヴィアタン自身が\n体内に魔物を棲まわせているのかもしれませんぞ。\n我々のような侵入者を排除するために。", "face": "u11"}, {"name": "アリサ", "text": "病原体に対する抗体みたいなもの\n……ということでしょうか？", "face": "u24"}, {"name": "ケイティ", "text": "なるほど。\n無敵にすら思える魔神レヴィアタンであっても、\n体内で暴れられては困るということですね。", "face": "u114"}, {"name": "アンナ", "text": "……つまり、\nレヴィアタンの活動を止めたい私たちにとっては、\nこのまま先へ進むのが正解――というわけですか。", "face": "l8531607319ce"}, {"name": "リエーレ", "text": "どのみち進むしかないと思うぜ？\nさっきも言ったけど、入口はここしかないんだ。", "face": "u490"}, {"name": "リエーレ", "text": "それに、ヤツの復活を止められなきゃ\nアンタらが守ってきた世界も滅ぼされちまうんだからな。", "face": "u490"}, {"name": "アンナ", "text": "……そうですね。\nリエーレさん、ここまで案内してくださって\nありがとうございます。"}, {"name": "リエーレ", "text": "あはは、気にすんなって。\n他でもないヘンゼルの頼みでもあるしな。", "face": "u490"}, {"name": "リエーレ", "text": "それに、しがない元傭兵のアタシが\n世界を救う英雄を導く役目を果たせたんだ。\n歴史に名を刻めて光栄だぜ！　なんつってな♪", "face": "u490"}, {"name": "リエーレ", "text": "……頼むぜ、王子。\nなんとしてもレヴィアタンの心臓を止めてくれ。\nヤツが復活して世界を滅ぼす前にな。", "face": "u490"}, {"name": "アンナ", "text": "任せてください。\n王子、レヴィアタンの心臓はこの先と思われます。\n急ぎ進軍し、ヤツの復活を阻止しましょう！", "face": "l8531607319ce"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 19, "params": [150]}, {"kind": "term", "influence": 18, "params": [130]}, {"kind": "term", "influence": 11, "params": [140]}, {"kind": "term", "influence": 12, "params": [130]}, {"kind": "term", "influence": 20, "params": [130]}, {"kind": "term", "influence": 21, "params": [120]}], "enemies": [{"enemy_id": 1, "hp": 12000, "attack": 450, "damage_type": "physical", "armor_defense": 500, "magic_defense": 60, "pattern_id": 2112592}, {"enemy_id": 2, "hp": 4500, "attack": 120, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "pattern_id": 2110960}, {"enemy_id": 2, "form_index": 1, "hp": 4500, "attack": 80, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "pattern_id": 2110960}, {"enemy_id": 4, "hp": 12000, "attack": 350, "damage_type": "magical", "armor_defense": 2200, "pattern_id": 2112576}, {"enemy_i