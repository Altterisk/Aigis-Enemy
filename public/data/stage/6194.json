": 2450, "attack": 490, "base_hp": 3500, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101280, "master_id": 267, "global_id": 266, "spawn_sec": 158}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 2450, "attack": 100, "base_hp": 3500, "base_attack": 100, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 200, "attack_speed": 90, "attack_wait": 60, "attack_interval": 183, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105712, "special_effect_id": 81, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30478, "global_id": 4097, "ranged": true, "spawn_sec": 162}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 1960, "attack": 50, "base_hp": 2800, "base_attack": 50, "damage_type": "magical", "armor_defense": 700, "magic_defense": 40, "attack_range": 110, "attack_speed": 90, "attack_wait": 10, "attack_interval": 59, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105728, "special_effect_id": 222, "missile_id": 158, "missile": {"speed": 6.0, "splash": 93}, "master_id": 30479, "global_id": 4098, "ranged": true, "spawn_sec": 165}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー"], "hp": 1960, "attack": 280, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "change_to": 11, "change_condition": 2, "master_id": 30456, "global_id": 4075, "to_condition": 2, "to_global_id": 4054, "spawn_sec": 172}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4410, "attack": 224, "base_hp": 6300, "base_attack": 320, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30435, "global_id": 4054, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "サヨ", "text": "王子の戦いを語るうえで、\n暗黒騎士団の存在は良くも悪くも外せないわね。", "face": "u510"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "サヨ", "text": "そうね。団長が今のデシウスに変わった後も、\n暗黒騎士団とその団長は彼らなりの考えから\n戦いに臨んでいたのよね。", "face": "u510"}, {"name": "デシウス", "text": "――ようやく、この手に収めることができた……。\n探し求めていた魂が……。\nわが師の魂が、この手にあるのだ……！", "face": "l5d57eaa443e7"}, {"name": "師匠", "text": "……デシウス……か？\nお前の事は案じておったが、その漆黒の鎧、\n暗黒騎士に成り果てたか……。", "face": "l78e5ae19fe96"}, {"name": "デシウス", "text": "わが師よ……。\n何故……なぜ、このデシウスに\n奥義を伝授しなかったのですか？", "face": "l5d57eaa443e7"}, {"name": "師匠", "text": "デシウス、お前は大切な者を失い、\n復讐心に駆られていた。その念が消えぬ者にとって\nあの奥義は諸刃……。お前を想っての事なのだ。", "face": "l78e5ae19fe96"}, {"name": "デシウス", "text": "……そんなこと、信じられるか！\n貴方は、我輩の力を恐れていただけだ！　我輩は、\n自らの力で、今から貴方の奥義を自分のものにします。", "face": "l5d57eaa443e7"}, {"name": "師匠", "text": "吸魂の力……死した魂の力を我が物とする外法か。\nそれで仮初の必殺剣を得てどうする？\nデシウス、本当にこれがお前の求めた答えか？", "face": "l78e5ae19fe96"}, {"name": "デシウス", "text": "……う、うるさい！　もう騙されぬぞ！\n我輩は我輩のやり方で最強となるのだ！\nもう二度と、大切なモノを失ったりなどしない！", "face": "l5d57eaa443e7"}, {"name": "デシウス", "text": "――……グ、グフフフ……フハハハハッ！！\n遂に、我輩は必殺剣を会得したのだ！\nもはやこの身に、敗北の二文字は無いッ！！", "face": "l5d57eaa443e7"}, {"name": "ミーティア", "text": "必殺剣……そうか、師匠の魂を宿したんだね？\nだけど、星の心を解さない君では、\n奥義をうまく操る事など出来ないよ！", "face": "u280"}, {"name": "デシウス", "text": "グフフ……何をバカなことを言っている？\n我輩の必殺剣は完璧だ！\n貴様の父と同じ力を我輩は手に入れたのだ！", "face": "l5d57eaa443e7"}, {"name": "ミーティア", "text": "人の心を完全に捨ててしまったようだね……。\nいいよ……同門のボクが終わらせてあげる。\n君の苦しみも悲しみも、全て斬ってみせるよ。", "face": "u280"}, {"name": "レシア", "text": "ミーティア、必ず貴方の師匠の魂を救おう。\n王子、ここでデシウスとの決着をつけるぞ。", "face": "u358"}]}, {"trigger": "end", "lines": [{"name": "デシウス", "text": "――ぐッ、ガ……はぁッ……ハァ……。\n我輩の必殺剣が……敗れる、だと……？", "face": "l5d57eaa443e7"}, {"name": "ミーティア", "text": "今の君には、敗北の理由も、\n強さの意味も、何も理解はできないだろうね。", "face": "u280"}, {"name": "デシウス", "text": "黙れ……黙れ黙れ黙れぇェェえええ――ッ！\n我輩は間違わない……もう間違わんのだ！", "face": "l5d57eaa443e7"}, {"name": "レシア", "text": "待て、デシウス！\n……くっ、逃げられたか……！", "face": "u358"}, {"name": "サヨ", "text": "あの時、わたしは暗黒騎士に変装……と言うか、\n一体を言いくるめて中に入ってただけ、なんだけど。\nわたしはデシウスの想いも聞いたよ。", "face": "u510"}, {"name": "サヨ", "text": "デシウスの選んだ道は間違ってる。\n大切なモノを守るためであったとしても、\nそれ以外を犠牲にするような選択は。", "face": "u510"}, {"name": "サヨ", "text": "……王子は、そんな道は選ばないと信じてる。\n王子の戦いと選択をずっと見てきたから、そう思うの。", "face": "u510"}]}], "active": true}