{"quest_id": 8271, "name": "鳥人の花嫁", "description": "天界でラシティたち鳥人を相手に武を示せ！\n＜天界：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["天界：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復"], "event": "バトルハネムーン", "event_category": "History", "mission_id": 920216, "map_no": 7138, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -70]}, {"kind": "term", "influence": 41, "params": [0, 60, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 10, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["鳥"], "hp": 56000, "base_hp": 56000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 1, "attack_wait": 3, "attack_interval": 38, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126256, "race_id": 12, "special_effect_id": 551, "change_to": 1, "missile_id": 45, "master_id": 33278, "global_id": 6895, "to_global_id": 6896, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 56000, "base_hp": 56000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "attack_interval": 37, "move_speed": 3000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126272, "race_id": 12, "special_effect_id": 697, "missile_id": 45, "master_id": 33279, "global_id": 6896, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["鳥"], "hp": 1000