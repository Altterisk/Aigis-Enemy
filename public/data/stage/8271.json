"change_to": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 37483, "global_id": 11100, "ranged": true, "to_global_id": 11137, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 4}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥", "ジューンブライド"], "hp": 90000, "attack": 1500, "base_hp": 90000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 400, "attack_range": 260, "attack_speed": 1, "attack_wait": 45, "attack_interval": 121, "move_speed": 1250.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2153216, "race_id": 12, "special_effect_id": 1726, "change_to": 5, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 37520, "global_id": 11137, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 14, "form_count": 1, "tags": ["鳥"], "hp": 3200, "attack": 300, "base_hp": 3200, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_range": 130, "attack_speed": 1, "attack_wait": 3, "attack_interval": 49, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123008, "race_id": 12, "special_effect_id": 234, "missile_id": 474, "missile": {"speed": 10.0}, "master_id": 32635, "global_id": 6253, "ranged": true, "spawn_sec": 56}, {"enemy_id": 9, "source": "local", "count": 21, "form_count": 2, "tags": ["鳥"], "hp": 1500, "base_hp": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 3, "move_speed": 1250.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2125728, "race_id": 12, "special_effect_id": 70, "change_to": 9, "master_id": 32911, "global_id": 6528, "to_global_id": 6529, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 96}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 1500, "base_hp": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2125744, "race_id": 12, "special_effect_id": 613, "change_to": 8, "master_id": 32912, "global_id": 6529, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 14, "form_count": 1, "tags": ["鳥"], "hp": 2000, "attack": 400, "base_hp": 2000, "base_attack": 400, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 160, "attack_speed": 1, "attack_wait": 60, "attack_interval": 166, "move_speed": 1250.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2125760, "race_id": 12, "special_effect_id": 229, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 32913, "global_id": 6530, "ranged": true, "spawn_sec": 126}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "tags": ["鳥"], "hp": 7000, "attack": 850, "base_hp": 7000, "base_attack": 850, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_range": 160, "attack_speed": 1, "attack_wait": 60, "attack_interval": 166, "move_speed": 1250.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2125776, "race_id": 12, "special_effect_id": 229, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 32914, "global_id": 6531, "ranged": true, "spawn_sec": 153}], "popups": ["ラシティがいる間は、\n全ての敵ユニットの\n攻撃がアップします。"], "dialogue": [{"trigger": "battle", "at_sec": 6, "lines": [{"name": "ラシティ", "text": "──やあ王子さま。あなたの花嫁、ラシティだよ♪", "face": "u2167a1"}, {"name": "カーニア", "text": "開幕から絶好チョーだね！？", "face": "u1685a1"}, {"name": "パリオス", "text": "ラシティってば大胆だー！", "face": "u1109a1"}, {"name": "ラシティ", "text": "二人とも、こういうのは勢いが大事なんだよ。", "face": "u2167a1"}, {"name": "ラシティ", "text": "こんな綺麗なドレス、そうそう着れるものではないからね。\nチャンスは積極的に活かさないともったいないだろう？", "face": "u2167a1"}, {"name": "パリオス", "text": "オトナだ！", "face": "u1109a1"}, {"name": "カーニア", "text": "鳥ギャグばっか言ってる自分が恥ずかしくなるよー！", "face": "u1685a1"}, {"name": "ラシティ", "text": "あはは、それはやめた方が良いかもね。", "face": "u2167a1"}, {"name": "カーニア", "text": "え……。", "face": "u1685a1"}, {"name": "ライノー", "text": "（分かる）", "face": "u1086a1"}, {"name": "アエロ", "text": "（同じく）", "face": "u1094a1"}, {"name": "ラシティ", "text": "さぁて、それじゃあ演武の時間と行くとしよう。", "face": "u2167a1"}, {"name": "ラシティ", "text": "たとえ花嫁『役』だったとしても、\n王子さまにはこの姿のぼくのことを、\n綺麗でかっこいいと思ってほしいからね。", "face": "u2167a1"}, {"name": "ラシティ", "text": "全力で、射止めに行かせてもらうよ。", "face": "u2167a1"}, {"name": "パリオス", "text": "アダルティック！！！！", "face": "u1109a1"}, {"name": "ラシティ", "text": "あなたのハート、外しはしないさ♪", "face": "u2167a1"}, {"name": "カーニア", "text": "…………え？", "face": "u1685a1"}, {"name": "ヤハール", "text": "（……やっぱり天界ってピリピリするー）", "face": "u2171a1"}]}, {"trigger": "end", "lines": [{"name": "ラシティ", "text": "──ふぅ、どうだったかな？", "face": "u2167a1"}, {"name": "パリオス", "text": "ラシティ、すっごくかっこよかったー！", "face": "u1109a1"}, {"name": "ライノー", "text": "前々から綺麗な黒とは思っていたが、\n白もよく似合うんだな、驚かされたよ。", "face": "u1086a1"}, {"name": "ラシティ", "text": "ふふっ、お褒めに預かり光栄だね。", "face": "u2167a1"}, {"name": "ラシティ", "text": "王子さまは……って、聞くまでもないようだね。\n詳しい感想は二人きりのときにお願いできるかい？", "face": "u2167a1"}, {"name": "オーキュ", "text": "あら、ラシティってばズルいですわね。\n今日だけでなくこの後の約束も取り付けるなんて。", "face": "u1101a1"}, {"name": "ラシティ", "text": "さっきも言ったろう？　大事なのは勢いだって。\n遠慮なんてするだけ置いて行かれてしまうからね。", "face": "u2167a1"}, {"name": "ラシティ", "text": "亜神マレスの提案は性急すぎるにしても、\nいずれそのときが来ることは間違いないんだ。\n今のうちに優位を取っておくに越したことはない。", "face": "u2167a1"}, {"name": "パリオス", "text": "ほえー、なんだか難しいねー。", "face": "u1109a1"}, {"name": "ラシティ", "text": "恋は戦争ってことさ、パリオス。", "face": "u2167a1"}, {"name": "ラシティ", "text": "さ、ぼくたちも次の舞台に移るとしようか。\nヤハールがそろそろ限界みたいだしね。", "face": "u2167a1"}, {"name": "ヤハール", "text": "ピリピリする―。", "face": "u2171a1"}, {"name": "カーニア", "text": "次は華の国だよ！　出発進行、コケコッコー！", "face": "u1685a1"}, {"name": "ウルカノ", "text": "立ち直り早ぇなコイツ。", "face": "u1669a1"}]}], "active": true}