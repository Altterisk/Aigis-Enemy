[2, 1, 0], [1, 0, 0], [1, 1, 0], [4, 0, 0], [4, 1, 0]]}, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 21, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 32}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 3, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 55}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}], "popups": ["クラマは、カラス天狗赤武者が\n倒されると特定のタイミングで能力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フドウ", "text": "この場所を越えれば、\n目的地の村までは、あと少しですぞ。", "face": "u238"}, {"name": "バシラ", "text": "王子、前方に人影が……、\nあ、あれ？　空を飛んでいるような……。", "face": "u28"}, {"name": "？？？", "text": "なにゆえここに人間が……？", "face": "u572"}, {"name": "コノハ", "text": "――むむ？　あの姿、見覚えが……。", "face": "u440"}, {"name": "アオバ", "text": "コノハ様、ご存知なのですか？", "face": "u441"}, {"name": "コノハ", "text": "うむ。あやつはクラマ、古い知己の娘だ。\n治める地は異なるが、天狗の長の一族よ。", "face": "u440"}, {"name": "クラマ", "text": "コノハめ、人間を従えてくるとは……、\nまさかこの里を侵略するつもりか……？", "face": "u572"}, {"name": "アオバ", "text": "…………コノハ様、お知り合いだったのでは？", "face": "u441"}, {"name": "コノハ", "text": "…………あやつは昔から、\n早とちりをするのが、悪い癖でな……。", "face": "u440"}, {"name": "クラマ", "text": "まずはその実力、見極めてやろうかの。", "face": "u572"}, {"name": "クラマ", "text": "若衆の天狗武者達を倒せたなら、\n本気で相手をしてやろうぞ……！！", "face": "u572"}, {"name": "コノハ", "text": "聞く耳は持ちそうにないな……。\n迎え撃つぞ、王子！！", "face": "u440"}]}, {"trigger": "end", "lines": [{"name": "コノハ", "text": "待て、クラマよ！\n我らは敵ではないぞ！", "face": "u440"}, {"name": "クラマ", "text": "何……？　ではまさか、\nただの通りすがりだとでも？", "face": "u572"}, {"name": "フドウ", "text": "拙僧らは、物の怪に悩まされておる村へ、\n救援に向かう最中であったのだ。\nここを通してもらえぬだろうか。", "face": "u238"}, {"name": "クラマ", "text": "何と……そういう事だったか。\nそれは済まないことをした。", "face": "u572"}, {"name": "クラマ", "text": "せめてもの詫びだ、\nおい、お前達、麓まで道案内をしてやるのだ。", "face": "u572"}, {"name": "コノハ", "text": "道案内とは、恩に着るぞ、クラマよ。\nさて王子、先を急ぐとしよう。", "face": "u440"}, {"name": "クラマ", "text": "…………行ってしまったか。", "face": "u572"}, {"name": "クラマ", "text": "王子……と言ったか。\nあれ程の好漢が、人間にもいるとはのう……。", "face": "u572"}]}, {"trigger": "route", "lines": [{"name": "クラマ", "text": "何と、若衆を倒してしまうとは。\n約束通り、余が本気で相手をしてやろうぞ！！", "face": "u572"}, {"name": "コノハ", "text": "クラマめ、力を隠しておったか！\n気をつけろ王子、来るぞ！！", "face": "u440"}]}, {"trigger": "route", "lines": [{"name": "クラマ", "text": "若衆すら倒せぬか。\nこれならば余が真の力を見せるまでもなかろうて。", "face": "u572"}, {"name": "コノハ", "text": "油断か慢心か……どうやら本気は出さぬようだな。\nしかし王子、しっかり用心してかかるのだぞ。", "face": "u440"}]}], "story_talk": true, "active": true}