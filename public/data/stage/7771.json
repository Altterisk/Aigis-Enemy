id": 15, "source": "local", "count": 7, "form_count": 2, "hp": 5000, "attack": 560, "base_hp": 5000, "base_attack": 560, "damage_type": "physical", "armor_defense": 240, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124096, "race_id": 20, "change_to": 15, "change_condition": 4, "master_id": 33356, "global_id": 6973, "to_condition": 4, "to_ticks": 3, "to_global_id": 6976, "spawn_sec": 163}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1120, "base_hp": 5000, "base_attack": 1120, "damage_type": "true", "armor_defense": 240, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 33359, "global_id": 6976, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 19, "source": "local", "count": 4, "form_count": 1, "hp": 8000, "attack": 650, "base_hp": 8000, "base_attack": 650, "damage_type": "magical", "armor_defense": 250, "magic_defense": 20, "attack_range": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 51, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2140160, "race_id": 20, "special_effect_id": 232, "missile_id": 45, "master_id": 35350, "global_id": 8967, "ranged": true, "spawn_sec": 195}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 3, "tags": ["アーマー"], "hp": 6400, "attack": 500, "base_hp": 6400, "base_attack": 500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126928, "race_id": 20, "change_to": 20, "master_id": 33346, "global_id": 6963, "to_global_id": 6964, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 214}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 6400, "attack": 1500, "base_hp": 6400, "base_attack": 1500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126944, "race_id": 20, "change_to": 21, "change_condition": 4, "master_id": 33347, "global_id": 6964, "to_condition": 4, "to_ticks": 1, "to_global_id": 6965}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 6400, "attack": 500, "base_hp": 6400, "base_attack": 500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126928, "race_id": 20, "master_id": 33348, "global_id": 6965, "from_condition": 4, "trigger_ticks": 1}], "popups": ["イルドナは攻撃力400以下の\nあらゆる攻撃を受け付けません。\n\nまた味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。", "イルドナの幻影には、\nダメージを与える事ができません。\n以下の条件を満たすと消滅します。\n\n・本体を倒す\n・本体が拠点に到達する"], "dialogue": [{"trigger": "start", "lines": [{"name": "フローガ", "text": "………これは。\n王子殿下、亜神ディアスの魔力がより強くなりました。", "face": "u878"}, {"name": "アスバール", "text": "儀式の段階が進んだ――いえ、\n亜神イルドナが時間を稼いでいてくれたのですから、\nおそらく、彼はもう……。", "face": "u1668a1"}, {"name": "ラーワル", "text": "…………。", "face": "u1369a1"}, {"name": "アスバール", "text": "すみません、軽率でした。\n数多の伝説を残す彼が、\nそう簡単に負けるはずもありませんでしたね。", "face": "u1668a1"}, {"name": "アトナテス", "text": "あいつのことだ、限界が来たからって、\nどこかで身体を休めているんだろうさ。", "face": "u908"}, {"name": "ラーワル", "text": "……だいじょぶ、気にしないで。\nこんなことで僕の正義の心は折れないし！", "face": "u1369a1"}, {"name": "イルドナ", "text": "――さすがは我が娘です。\nこれくらいで心折れてしまっては、\nこの後の戦いを任せられませんからね。", "face": "u1645a1"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "ルキファ", "text": "イルドナ！　無事だったか。\n済まなかったな、私が操られていなければ、\nもっと早く駆けつけられたのだが……。", "face": "u1621a1"}, {"name": "イルドナ", "text": "いえ、あなたが合流してくれたのですから、\nこの身を犠牲に、\n時間を稼いだ価値は十分にありました。", "face": "u1645a1"}, {"name": "イルドナ", "text": "……しかし、もう時間の余裕はありません。\nそろそろ、最後の仕上げにかからなければ。", "face": "u1645a1"}, {"name": "エスネア", "text": "……ね、ねぇ王子、\nどうしてイルドナは、こっちに剣を向けてるの？", "face": "u997"}, {"name": "エフネ", "text": "敵対しようとしてるから、じゃないです？\n最後の仕上げって、いったい何をするつもりですか！", "face": "u969"}, {"name": "イルドナ", "text": "今の物質界連合軍の力では、\n亜神ディアスに、未だ及びません。", "face": "u1645a1"}, {"name": "イルドナ", "text": "されど、神殺しを成した王子という存在に、\n神たる力を重ねたなら、そこに可能性も見えてくる。", "face": "u1645a1"}, {"name": "イルドナ", "text": "――王子、我が力を継承しましょう。\nこの命をもって、私は誓いを果たします。", "face": "u1645a1"}, {"name": "バロウス", "text": "……どうするの？\nあの亜神サマ、自分を殺せって言ってきてるけど。", "face": "u448"}, {"name": "山ン本五郎左衛門", "text": "あいつが決意したってんなら、\nそれを咎めるのもお門違いってェもんだが……。\nでも、気に入らねぇなぁ。", "face": "u1617a1"}, {"name": "リヴン", "text": "イルドナは昔から、勝手に行動しては、\n勝手に戦果を上げてくる困った男だったからな。\n今回もまた、困らせてくるものだ。", "face": "u1619a1"}, {"name": "イルドナ", "text": "……迷うな、という方が、無理のある話ですね。\nでは、こちらから挑むしかなさそうです。", "face": "u1645a1"}, {"name": "イルドナ", "text": "英雄王の意志と名を継ぐ者、人類種の英雄、\n魔王を討ちし神殺しにして、世界を担う者の実力、\n我が最後の戦いにて見せてもらいましょう！", "face": "u1645a1"}]}, {"trigger": "battle", "at_sec": 125, "lines": [{"name": "エスネア", "text": "なっ……イルドナが分身したぁ！？", "face": "u997"}, {"name": "アトナテス", "text": "あいつは光の亜神だからな……。\nただの幻影だ。戦える幻影だけどな。\nこのままだと次々に数が増えていくぜ。", "face": "u908"}, {"name": "アルタ", "text": "あの幻影は、お父さまを止めなければ消えません。\n王子、我がマスター、\n亜神イルドナに火力を集中してください！", "face": "u1403a1"}]}, {"trigger": "end", "lines": [{"name": "イルドナ", "text": "…………さぁ、トドメを。", "face": "u1645a1"}, {"name": "ラーワル", "text": "お、王子、だめっ！　だめだよ！\n待って！　パパ、ねぇ、一緒に戦おうよ！？", "face": "u1369a1"}, {"name": "アルタ", "text": "お姉さま、止めてはいけません。\nこれはマスターと、お父さまが決めることです。", "face": "u1403a1"}, {"name": "イルドナ", "text": "世界の未来と、亜神一柱の命……。\n簡単な選択でしょう。", "face": "u1645a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "シビラ", "text": "……王子、もう答えは決まっているでしょ？", "face": "u39"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "シビラ", "text": "さぁみんな、このまま儀式の間へ。\nそれから、亜神イルドナ様、\nあなたも回復したらすぐに追いかけてきて。", "face": "u39"}, {"name": "イルドナ", "text": "…………そう、ですか。\n神の力を継承することなく、\nあの亜神ディアスを倒すつもりだと？", "face": "u1645a1"}, {"name": "シビラ", "text": "イルドナ様、私たちの先祖に、\nフラガラッハを託してくださった偉大なるお方。", "face": "u39"}, {"name": "シビラ", "text": "あなたは選択を間違えてしまったの。\n誰かを犠牲になんてこと、\n王子に一番聞かせちゃいけない言葉だもの。", "face": "u39"}, {"name": "シビラ", "text": "ちょっとだけ、\n人間の勉強が足りていなかったみたいね？\n――さぁみんな、急いで！", "face": "u39"}, {"name": "山ン本五郎左衛門", "text": "……やれやれ、また勝手に突っ走ったせいだぞ？\n短い付き合いだが、あの王子ってのは、\n誰かを犠牲にって言葉が一番嫌いなんだそうだ。", "face": "u1617a1"}, {"name": "リヴン", "text": "お前は自分の優先順位が低すぎるんだ。\nあのルキファといい勝負だぞ。\nこれに懲りたら、生きて追いかけてこい。", "face": "u1619a1"}, {"name": "ルキファ", "text": "なっ、リヴンに言われたくないぞ。\n……はぁ。待っているからな、イルドナ。\n光の亜神らしく、ちゃんと正義の味方をしろ！", "face": "u1621a1"}, {"name": "イルドナ", "text": "…………ああ、まったく。\nこれも、あなたの血筋なのでしょうか。\nそうは思いませんか、我が剣を継ぎし姫君よ。", "face": "u1645a1"}, {"name": "シビラ", "text": "……そうね。\nでもきっと、英雄王が意地っ張りになったのは、\nあなたたちと共に生き延びたかったからよ。", "face": "u39"}, {"name": "シビラ", "text": "英傑も、今の時代に生きる民も、\n王子にとっては等しく、\n共に戦う仲間で、守るべき民なのだから。", "face": "u39"}, {"name": "イルドナ", "text": "なるほど、ようやく理解できました。\nでは、その共に戦う仲間として、\nひとつ頼まれごとをしてくれますか？", "face": "u1645a1"}, {"name": "シビラ", "text": "…………？", "face": "u39"}]}], "active": true}