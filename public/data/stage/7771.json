{"quest_id": 7771, "name": "光の亜神の決意", "description": "魔王城を進む最中、これまで以上の魔力を\n感じ取った王子たち。それは亜神ディアス\nによる儀式の進行を意味していた……。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "千の誓い、千の約束", "event_category": "History", "mission_id": 920184, "map_no": 4173, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 16000, "attack": 850, "base_hp": 16000, "base_attack": 850, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 122, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2140496, "race_id": 19, "special_effect_id": 230, "master_id": 35359, "global_id": 8976, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 47000, "attack": 1450, "base_hp": 47000, "base_attack": 1450, "damage_type": "physical", "armor_defense": 450, "magic_defense": 25, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 121, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2140480, "race_id": 19, "special_effect_id": 1175, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 35358, "global_id": 8975, "ranged": true, "commands": {"raw": "SetStageFlag(0, 1, 1);", "sets_flags": [[0, 1]]}, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124128, "race_id": 20, "change_to": 3, "change_condition": 4, "master_id": 32919, "global_id": 6536, "to_condition": 4, "to_ticks": 3, "to_global_id": 6539, "spawn_sec": 42}, {"enemy_id": 3, "source": "l