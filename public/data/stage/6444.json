ocal", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_speed": 24, "attack_interval": 55, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.850000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099424, "special_effect_id": 222, "master_id": 163, "global_id": 162, "from_condition": 3}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099456, "change_to": 16, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 300, "global_id": 299, "ranged": true, "to_condition": 3, "to_global_id": 300, "spawn_sec": 127}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099456, "special_effect_id": 248, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 301, "global_id": 300, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "ラミィ", "text": "いたた……うぅ、\n邪仙たちのヤツ、倒しても倒しても出てくるよぉ……。", "face": "u480"}, {"name": "フーコ", "text": "はぁ、はぁ……頑張って、ラミィ。\nもうすぐ王子たちが来てくれるはずだから……。", "face": "u493"}]}, {"trigger": "start", "lines": [{"name": "妖天君", "text": "――ホゥ、驚いたヨ。\nたかが山ひとつがなぜ陥落しないのかと思ったら、\nキミたちが守っていたとはネェ。", "face": "l62a39c6cbcf7"}, {"name": "ラミィ", "text": "お前は――妖天君！\nそっか、わかったぞ！　\nお前らの狙いはこの山を覆う大地の気だな！", "face": "u480"}, {"name": "フーコ", "text": "だったら、なおさら邪仙たちには渡さない！\nこの山は昔、みんなで遊んだ思い出の場所だから……！", "face": "u493"}, {"name": "妖天君", "text": "フフ、これを見た後でも\n同じことが言えるかナ……ホホイッ！", "face": "l62a39c6cbcf7"}]}, {"trigger": "start", "lines": [{"name": "雷神", "text": "――グオオオオオオオオオオオオッ！！", "face": "l8ba330ad79df"}, {"name": "ラミィ", "text": "なッ……！？\nと、とーちゃんッ！？", "face": "u480"}, {"name": "風神", "text": "ゲハハッ！　ゲハッ、ゲハハハハハハッ！！", "face": "l07902300b9d8"}, {"name": "フーコ", "text": "そんな……死した父様たちの魂パクが\nまた操られるなんて……。\n今の私たちに父様たちを止めるなんて、無理だよ……。", "face": "u493"}, {"name": "妖天君", "text": "ホホッ、完全に心が折れたみたいだネェ。\n安心するといい。そのまま大人しくしていれば\nキミたちの父親と同じ所に送ってやるからサ……。", "face": "l62a39c6cbcf7"}]}, {"trigger": "battle", "at_sec": 5, "lines": [{"name": "？？？", "text": "――させるかああああああッ！！", "face": "u616"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "妖天君", "text": "ホッ！？　\nい、いまの雷は……！？", "face": "l62a39c6cbcf7"}, {"name": "ラミィ", "text": "レミィねーちゃん！？\nそれに、そっちは――", "face": "u480"}, {"name": "フーコ", "text": "クーコ姉様！\n今までどこに行って――", "face": "u493"}, {"name": "クーコ", "text": "話は後。二人とも、よく頑張ったね。\nあとはお姉ちゃんたちに任せなさい。", "face": "u617"}, {"name": "レミィ", "text": "父ちゃんたち、覚悟してよね！\n可愛い妹たちをいじめるヤツは\nたとえ父親でも許さないんだから！", "face": "u616"}, {"name": "アンナ", "text": "あれは……フーコさんとラミィさん？\n……いえ、よく似ていますが別人のようです。\nひとまずここは彼女たちに加勢いたしましょう！", "face": "l53980a73cb6a"}]}, {"trigger": "end", "lines": [{"name": "妖天君", "text": "うぐッ……そ、想定外だヨ。\n風神と雷神の娘に姉がいたとはネ……。", "face": "l62a39c6cbcf7"}, {"name": "妖天君", "text": "この地に拠点のひとつを設けるつもりだったけど、\nいまは一旦退くのが賢明のようだネ……。", "face": "l62a39c6cbcf7"}, {"name": "ラミィ", "text": "う……うわーんっ！\nレミィねーちゃぁあ～んっ！！", "face": "u480"}, {"name": "レミィ", "text": "ていッ！", "face": "u616"}, {"name": "ラミィ", "text": "ふぎゃッ！\nふぇぇ……どうしてぶつのさぁ。", "face": "u480"}, {"name": "レミィ", "text": "姉ちゃんに一言も告げずに\n勝手に家を飛び出した罰だ！\n……すっごく心配したんだからね？", "face": "u616"}, {"name": "ラミィ", "text": "うぅ……ぐひゅっ……。\nごめんらさい、ねーひゃん……。", "face": "u480"}, {"name": "フーコ", "text": "クーコ姉様……。", "face": "u493"}, {"name": "クーコ", "text": "ふふっ、なに遠慮してるの？\nほら……おいで、フーコ。\n久しぶりにギュ～ッてしてあげる。", "face": "u617"}, {"name": "フーコ", "text": "うん……お帰り、姉様。\n……えへへ。姉様の匂い、久しぶり……。", "face": "u493"}, {"name": "クーコ", "text": "よしよし……ただいま、フーコ。\n……さて、私が家を出て旅をしてた間に\nいろんなことが変わったみたいだね。", "face": "u617"}, {"name": "フーコ", "text": "うん、紹介するね。\nこの人たちが王子とその軍の人たち。\n私とラミィがお世話になってる人間たちだよ。", "face": "u493"}, {"name": "アンナ", "text": "いえ、私たちの方こそ……。\nお二人はラミィさんとフーコさんの\nお姉さまでいらしたのですね。"}, {"name": "レミィ", "text": "そうよ。私とクーコもそれぞれ雷神と風神の娘ってわけ。\n……でも、聞けば父ちゃんたちは\nさっきの妖天君ってヤツに……。", "face": "u616"}, {"name": "ラミィ", "text": "うん……悪いのはもちろん妖天君だけど、\nとーちゃんが人間たちの忠告を聞いて\n邪仙の襲撃に備えてれば……。", "face": "u480"}, {"name": "フーコ", "text": "……人間は敵だって、私たちは教わってきた。\nでも、今はそれどころじゃないと思う。", "face": "u493"}, {"name": "クーコ", "text": "この国がなくなるかもしれないって時だもんね。\nわかった。私たちも人間たちに手を貸すよ。\n父様たちの仇を討つためにも。", "face": "u617"}, {"name": "アンナ", "text": "お二人とも……ありがとうございます。\nそれでは、まずはこの地が邪仙の手に落ちないよう、\n引き続き守りに注力して頂ければと思います。"}]}], "active": true}