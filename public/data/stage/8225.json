{"quest_id": 8225, "name": "叡智の園の無限書庫", "description": "王子たちは里長の案内で叡智の園にある\n無限書庫の探索を開始。すると何処からか\n空を飛ぶ魔導書がやってきて……？\n上級（★１獲得の目安：平均Lv10）", "event": "封鎖領域アヴァロン", "event_category": "History", "mission_id": 920213, "map_no": 4874, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 13, "form_count": 1, "hp": 3500, "attack": 650, "base_hp": 3500, "base_attack": 650, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 160, "attack_speed": 70, "attack_wait": 60, "attack_interval": 185, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2151952, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 37340, "global_id": 10957, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 12}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 13}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 4, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 22}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 6, "source": "local", "count": 14, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103360, "race_id": 9, "master_id": 441, "global_id": 440, "spawn_sec": 35}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 221, "move_speed": 230.0, "gain_cost": 1, "dot_rate": 0.699999988079071, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100192, "missile_id": 52, "missile": {"speed": 6.0, "splash": 107}, "master_id": 282, "global_id": 281, "ranged": true, "spawn_sec": 36}, {"enemy_id": 8, "source": "local", "count": 5, "form_count": 1, "hp": 4500, "attack": 150, "base_hp": 4500, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105584, "missile_id": 152, "missile": {"speed": 6.0, "splash": 133}, "master_id": 702, "global_id": 701, "ranged": true, "spawn_sec": 46}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 550, "base_hp": 15000, "base_attack": 550, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 180, "attack_speed": 70, "attack_wait": 20, "attack_interval": 111, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100672, "race_id": 13, "change_to": 9, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 277, "global_id": 276, "ranged": true, "variants": [{"hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100688, "race_id": 13, "master_id": 278, "global_id": 277}], "spawn_sec": 94}], "dialogue": [{"trigger": "start", "lines": [{"name": "エステル", "text": "――これは、もしかして\n魔法都市と同じ建築様式でしょうか……？", "face": "u245"}, {"name": "プリニース", "text": "おっ、分かる？\n最初期の魔法都市の建築には、\n私たち叡智の園のご先祖が関わってるからね。", "face": "l7d110560bf2e"}, {"name": "プリニース", "text": "ここは、有限の土地に魔法を刻み、\n擬似的に無限拡張を続けることで、\nあらゆる知識を収蔵するのが目的の施設。", "face": "l7d110560bf2e"}, {"name": "プリニース", "text": "まぁ問題は、今も成長し続けてるから、\n正直私も内部構造が把握しきれないってところかな。", "face": "l7d110560bf2e"}, {"name": "エステル", "text": "それは、大変というか……。\n資料を探す時に苦労しませんか？", "face": "u245"}, {"name": "プリニース", "text": "いいんだよ、ここは立ち入り禁止なんだから。\n里の賢者にも入館許可を出すのはごく一握りだけ。\nたまーに私がメンテナンスで入るくらいさ。", "face": "l7d110560bf2e"}, {"name": "アナベラ", "text": "メンテナンスと言いながら、\nどっぷり数ヶ月こもって読書三昧してるけどね。", "face": "u1309a1"}, {"name": "プリニース", "text": "あはは……えっと、ごめん。\nまぁそういうわけだから、\n私から離れないように気をつけてね。", "face": "l7d110560bf2e"}, {"name": "プリニース", "text": "迷子になるくらいならともかく、\nほら、あぁいうヤバイ本もいるからさ。", "face": "l7d110560bf2e"}, {"name": "オーシェン", "text": "やばい本、というと……。\nなっ……魔導書が飛んでいるような……？", "face": "u2133a1"}, {"name": "プリニース", "text": "魔導書には魔力が宿る。\n魔力はやがて偽りの意思を生じさせ、生ける本となる。", "face": "l7d110560bf2e"}, {"name": "プリニース", "text": "中には魔術師が、絶対に読ませないために\n攻撃魔術を仕込んだ魔導書まで存在したりする。\nつまりあいつら、普通に魔法を撃ってくるんだ。", "face": "l7d110560bf2e"}, {"name": "プリニース", "text": "あれはあれで見てて可愛いけど、\nあのままじゃ読めない！\nさぁ王子くん、さくっとわからせてやって！", "face": "l7d110560bf2e"}, {"name": "王子", "text": "…………！？", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "プリニース", "text": "うーん……この辺りはやっぱり、\n千年戦争以降の知識しかないか……。", "face": "l7d110560bf2e"}, {"name": "エステル", "text": "それはそれで貴重な知識ではありますが……。", "face": "u245"}, {"name": "アナベラ", "text": "ぼくらの求めている知識には程遠いね。", "face": "u1309a1"}, {"name": "プリニース", "text": "やっぱり、深奥に向かうしかないね。\nここから先は、私も未知の領域だ。", "face": "l7d110560bf2e"}, {"name": "プリニース", "text": "おばあちゃん、なんて言ってたかなぁ……。\n確か本当に危険な知識の境界には、\n無限書庫の守護者がいるとかなんとか……。", "face": "l7d110560bf2e"}, {"name": "ハーニィ", "text": "門番……でっかいゴーレムとか……？", "face": "u856"}, {"name": "リノ", "text": "召喚獣とか……。", "face": "u350"}, {"name": "フィグネリア", "text": "大きな生ける魔導書という可能性も……。", "face": "u18"}, {"name": "オーシェン", "text": "魔法で使役されている魔物、というのも……？", "face": "u2133a1"}, {"name": "ティファ", "text": "あるいは、かっこいいドラゴンだったり。", "face": "u476"}, {"name": "プリニース", "text": "ま、何が来ても慌てず対処しよう。\n案外話のできるやつかもしれないしさ。", "face": "l7d110560bf2e"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "――くしゅんっ。", "face": "u2135a1"}, {"name": "？？？", "text": "……久しいな。人の、気配だ。", "face": "u2135a1"}]}], "active": true}