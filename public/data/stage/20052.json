ck_speed": 70, "attack_wait": 40, "attack_interval": 191, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2173776, "race_id": 24, "special_effect_id": 2536, "master_id": 41230, "condition": 5}], "spawn_sec": 33}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 20, "base_hp": 1500, "base_attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 35, "attack_speed": 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 633, "global_id": 632, "ranged": true, "spawn_sec": 190}, {"enemy_id": 6, "source": "local", "count": 27, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 600, "base_hp": 15000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "attack_speed": 20, "attack_wait": 60, "attack_interval": 181, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2174608, "race_id": 12, "master_id": 41285, "spawn_sec": 216}, {"enemy_id": 7, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 10, "base_hp": 1500, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 23761, "spawn_sec": 219}, {"enemy_id": 8, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 40000, "attack": 10, "base_hp": 40000, "base_attack": 10, "damage_type": "physical", "armor_defense": 400, "magic_defense": 40, "attack_speed": 70, "attack_wait": 40, "attack_interval": 191, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2170608, "race_id": 24, "special_effect_id": 2433, "change_to": 8, "change_condition": 5, "master_id": 40656, "global_id": 14273, "phases": [{"tags": ["アーマー"], "hp": 40000, "attack": 10, "base_hp": 40000, "base_attack": 10, "damage_type": "physical", "armor_defense": 400, "magic_defense": 40, "attack_speed": 70, "attack_wait": 40, "attack_interval": 191, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2170624, "race_id": 24, "special_effect_id": 2432, "master_id": 40657, "global_id": 14274, "condition": 5}], "spawn_sec": 223}], "popups": ["天眼のヴィマーナの子機は\nダメージを受けると\n一定範囲内のユニットに\n継続ダメージを\n与えるようになります。\n\n\n　　　　　　(1/2)", "天眼のヴィマーナの子機は\n味方ユニットから受ける\n全てのダメージを30％軽減します。\n\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "プリヤンカ", "text": "――うっひゃー！\nすっごいよ！　完全未発見の遺跡だー！", "face": "u2808a1"}, {"name": "カーヴィヤ", "text": "はいはい、慌てるとまた転ぶよプリヤンカ。", "face": "u2870a1"}, {"name": "プリヤンカ", "text": "だって姐さん！\n誰も入ってない遺跡だよ！？", "face": "u2808a1"}, {"name": "カーヴィヤ", "text": "あーあー、舞い上がっちゃって……。", "face": "u2870a1"}, {"name": "アルレット", "text": "竜ノ国が発見してはいたけど、\n調査はしていなかった遺跡かぁ……。", "face": "u1453a1"}, {"name": "レクテ", "text": "ふっふっふ、どんな謎遺物があるか楽しみー！", "face": "u2047a1"}, {"name": "アルレット", "text": "天眼ノ国とも手を結んだし、\n竜ノ国との戦いも終結したし、\nまぁ、厄介な事情は抱えたままだけど――", "face": "u1453a1"}, {"name": "アルレット", "text": "やっと未知の世界を存分に探索できるね！！", "face": "u1453a1"}, {"name": "王子", "text": "………（うずうずわくわく）", "face": "u1"}, {"name": "プリヤンカ", "text": "そういえば、あのすっごい空飛ぶ船は？", "face": "u2808a1"}, {"name": "ニハラ", "text": "ドーンブリンガー……アカツキ様とパルセ様ですね。\nあの方々は相当な無理をした様子で、\n現在、元の世界に戻るための修理中です。", "face": "u2888a1"}, {"name": "プリヤンカ", "text": "あらら……。\nじゃあお空の旅はお預けかぁ……。", "face": "u2808a1"}, {"name": "アンウェン", "text": "そうでなくても、竜ノ国にですら\nその侵入を許さぬ結界を張っておる国もある。\n好き放題に飛んでいると結界に激突するぞ？", "face": "u2934a1"}, {"name": "プリヤンカ", "text": "まぁっ、それならそれで！\n今日はこの遺跡の遺物あさりを――", "face": "u2808a1"}, {"name": "ニハラ", "text": "…………？\nおや？　今なにか物音が……。", "face": "u2888a1"}, {"name": "？？？", "text": "ちゅっちゅちゅー♪\nこの遺跡には何が眠って――", "face": "ld8c9f64f461d"}, {"name": "プリヤンカ", "text": "…………。", "face": "u2808a1"}, {"name": "？？？", "text": "…………。", "face": "ld8c9f64f461d"}, {"name": "プリヤンカ", "text": "きゃー！！　かわいいー！！", "face": "u2808a1"}, {"name": "？？？", "text": "きゃー！！　ドラゴン！？　ドラゴンと遭遇ー！？", "face": "ld8c9f64f461d"}, {"name": "？？？", "text": "みんな！　全力逃走用意！\nよーいっ！　ちゅーっ！！", "face": "ld8c9f64f461d"}, {"name": "プリヤンカ", "text": "わっ、わっ、わー！？", "face": "u2808a1"}]}, {"trigger": "end", "lines": [{"name": "カーヴィヤ", "text": "――な、なんだったんだ？", "face": "u2870a1"}, {"name": "アルレット", "text": "すごい勢いで逃げていったねぇ……。", "face": "u1453a1"}, {"name": "アンウェン", "text": "あれはネズミたちの国の民だな。", "face": "u2934a1"}, {"name": "アンウェン", "text": "美しい都を築き、密かに暮らしておる者たちだ。\n竜ノ国とは……まぁ、国交は一切結んでおらぬ。", "face": "u2934a1"}, {"name": "サフレア", "text": "むしろ怯えられていますから。\nただ、王国が接触するのであれば、\n良い関係を結べる筆頭候補かもしれません。", "face": "u2935a1"}, {"name": "アンナ", "text": "……次の目的地が、決まりましたね？"}, {"name": "王子", "text": "…………（わくわく）", "face": "u1"}]}], "map": {"image": "Map7528", "w": 960, "h": 640, "spots": [{"k": "b", "x": 480, "y": 365}, {"k": "m", "x": 580, "y": 167, "id": 200}, {"k": "m", "x": 657, "y": 211, "id": 201}, {"k": "m", "x": 661, "y": 289, "id": 202}, {"k": "m", "x": 603, "y": 319, "id": 203}, {"k": "m", "x": 616, "y": 399, "id": 204}, {"k": "m", "x": 677, "y": 431, "id": 205}, {"k": "m", "x": 342, "y": 399, "id": 206}, {"k": "m", "x": 284, "y": 431, "id": 207}, {"k": "m", "x": 298, "y": 211, "id": 208}, {"k": "m", "x": 378, "y": 169, "id": 209}, {"k": "m", "x": 303, "y": 290, "id": 210}, {"k": "m", "x": 359, "y": 319, "id": 211}, {"k": "m", "x": 116, "y": 192, "id": 212}, {"k": "m", "x": 844, "y": 192, "id": 213}, {"k": "r", "x": 295, "y": 126, "id": 300}, {"k": "r", "x": 179, "y": 131, "id": 301}, {"k": "r", "x": 424, "y": 229, "id": 302}, {"k": "r", "x": 541, "y": 229, "id": 303}, {"k": "r", "x": 695, "y": 141, "id": 304}, {"k": "r", "x": 699, "y": 349, "id": 305}, {"k": "r", "x": 485, "y": 464, "id": 306}, {"k": "r", "x": 264, "y": 353, "id": 307}]}, "active": true}