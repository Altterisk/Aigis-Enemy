50, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 10, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534, "from_condition": 0}, {"enemy_id": 13, "source": "local", "count": 13, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 70, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104096, "race_id": 3, "master_id": 498, "global_id": 497, "spawn_sec": 94}, {"enemy_id": 14, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 112}], "dialogue": [{"trigger": "start", "lines": [{"name": "ベルニス", "text": "あ、あのギャレットさん……、\n大変申し上げにくいのですが、もう少し慎重に\n戦われた方が良いのではないでしょうか。", "face": "u41"}, {"name": "ギャレット", "text": "ははは、これは痛いところを突かれたな。\nどうも俺は守るよりも攻めることが好きなようだ。\n重装歩兵に向いていないのかもしれないな。", "face": "u9"}, {"name": "ディーネ", "text": "ふふふ、そうですね。実は私もなんです。\n頭に血が上ると守りが\nおろそかになってしまって……。", "face": "u223"}, {"name": "ギャレット", "text": "あんたを怒らせたヤツには同情するよ。\n戦っているあんたを見ていると、人間というよりも\nサイクロプスなんじゃないかと思ってしまう。", "face": "u9"}, {"name": "ディーネ", "text": "サイ……クロプス……。\nそ、それは、どういう意味でしょうか！", "face": "u223"}, {"name": "ギャレット", "text": "（ま、まずい）", "face": "u9"}, {"name": "兵士", "text": "敵襲！　狼と魔物たちの奇襲部隊です。", "face": "l2b2417eb171c"}, {"name": "ギャレット", "text": "おしゃべりは終わりだ。\nここは頼んだ。俺は後方を支援する。\n（……助かった）", "face": "u9"}, {"name": "ディーネ", "text": "そうですね。迎え撃ちましょう。\n先ほどの続きは戦いの後で、\nじっ……くりお話いたしましょうね。", "face": "u223"}]}, {"trigger": "end", "lines": [{"name": "ギャレット", "text": "なんとか勝てたな。\nさっきは、その……悪かった。\n女性に対して配慮が足りなかったようだ。", "face": "u9"}, {"name": "ギャレット", "text": "詫びが足りないのなら、思いっきりぶん殴ってくれ。\nさあ、遠慮はいらん。\n例え死んでもあんたを恨んだりしないさ。", "face": "u9"}, {"name": "ディーネ", "text": "それで、謝っているつもりなんですか。\n誰が殴り殺したりするもんですか。", "face": "u223"}, {"name": "ベルニス", "text": "よ、よかった……。", "face": "u41"}, {"name": "ギャレット", "text": "すまない。\nもう俺は口を開かぬほうがよさそうだ。", "face": "u9"}, {"name": "ディーネ", "text": "それはそれで、話し相手がいなくなって寂しいです。\n大丈夫です。もう怒っていませんよ。", "face": "u223"}, {"name": "ベルニス", "text": "それにしても、\n最後に出現した地中を進む\nワーム型デーモンはいったい……。", "face": "u41"}, {"name": "ギャレット", "text": "今まで見たことがないから、\n新種の魔物だろうな。\nまだ戦いはこれからだということだろう。", "face": "u9"}]}], "map": {"image": "Map5413", "w": 960, "h": 640, "spots": [{"k": "b", "x": 99, "y": 384}, {"k": "b", "x": 840, "y": 430}, {"k": "m", "x": 483, "y": 138, "id": 200}, {"k": "m", "x": 367, "y": 135, "id": 201}, {"k": "m", "x": 234, "y": 136, "id": 202}, {"k": "m", "x": 161, "y": 227, "id": 203}, {"k": "m", "x": 243, "y": 291, "id": 204}, {"k": "m", "x": 378, "y": 298, "id": 205}, {"k": "m", "x": 575, "y": 320, "id": 206}, {"k": "m", "x": 689, "y": 336, "id": 207}, {"k": "m", "x": 763, "y": 276, "id": 208}, {"k": "m", "x": 680, "y": 200, "id": 209}, {"k": "m", "x": 568, "y": 151, "id": 210}, {"k": "m", "x": 469, "y": 382, "id": 211}, {"k": "m", "x": 215, "y": 421, "id": 212}, {"k": "m", "x": 332, "y": 427, "id": 213}, {"k": "m", "x": 594, "y": 437, "id": 214}, {"k": "m", "x": 735, "y": 454, "id": 215}, {"k": "r", "x": 444, "y": 62, "id": 300}, {"k": "r", "x": 640, "y": 109, "id": 301}, {"k": "r", "x": 765, "y": 145, "id": 302}, {"k": "r", "x": 683, "y": 260, "id": 303}, {"k": "r", 