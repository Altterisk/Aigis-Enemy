source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 42, "global_id": 41, "ranged": true, "spawn_sec": 183}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 6000, "attack": 110, "base_hp": 6000, "base_attack": 110, "damage_type": "magical", "armor_defense": 200, "magic_defense": 70, "attack_range": 180, "attack_speed": 60, "attack_wait": 50, "attack_interval": 243, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100896, "race_id": 2, "special_effect_id": 228, "change_to": 12, "change_condition": 2, "missile_id": 201, "missile": {"speed": 2.0}, "master_id": 287, "global_id": 286, "ranged": true, "to_condition": 2, "to_global_id": 287, "spawn_sec": 194}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 13000, "attack": 110, "base_hp": 13000, "base_attack": 110, "damage_type": "magical", "armor_defense": 300, "magic_defense": 70, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 203, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100912, "race_id": 2, "special_effect_id": 228, "missile_id": 202, "missile": {"speed": 2.0}, "master_id": 288, "global_id": 287, "ranged": true, "from_condition": 2}], "popups": ["特定の位置に火炎弾が着弾し、\n着弾した火炎弾の\n一定範囲内のユニットは\n強力な継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "……あれが、竜ノ国。\nラージヴィール卿、\nリヴァイアサンというのはいったい……。"}, {"name": "ラージヴィール", "text": "我らが知るのは今の姿のみ。\n連中が最強の戦力を誇る戦闘国家であり、\n国そのものが空を飛ぶことくらいだ。", "face": "l4ebe7bd5270c"}, {"name": "ラージヴィール", "text": "――ケルドラ嬢、そなたの方が\n竜ノ国には詳しいと見たが？", "face": "l4ebe7bd5270c"}, {"name": "ケルドラ", "text": "……あの飛竜が如き大地は、リヴァイアサン。\n世界を壊し、作り、大地を生み出す、\n原初の神造兵器のひとつです。", "face": "u2869a1"}, {"name": "アルレット", "text": "これはまた、大きく出たねぇ。\n世界を壊して作るって、\n天地創造みたいなこと言い出したじゃん。", "face": "u1453a1"}, {"name": "ケルドラ", "text": "まさに天地創造そのもの、ですな。\n天使が尖兵、神獣が戦術兵器なのだとすれば、\nあれらは戦略兵器。世界の形を作り変えるもの。", "face": "u2869a1"}, {"name": "ケルドラ", "text": "すなわち大地を生み出すために建造された――", "face": "u2869a1"}, {"name": "コレット", "text": "ん……あれらって言いました？\nあんなものがいっぱいあるんですか！？", "face": "u1615a1"}, {"name": "ケルドラ", "text": "はい。おそらく皆さんが知っているものだと、\nヴィマーナという巨人型の個体に――", "face": "u2869a1"}, {"name": "ケルドラ", "text": "――魔神レヴィアタンでしょうか？\nあれはリヴァイアサンの原型となったもので、\n世界そのものを内包することを目指した個体です。", "face": "u2869a1"}, {"name": "ケルドラ", "text": "とはいえ、私の情報も、伝聞でしかありませんが……。", "face": "u2869a1"}, {"name": "コレット", "text": "…………。", "face": "u1615a1"}, {"name": "レクテ", "text": "うわっ、コレットが目を輝かせながら\nにやにやうめきつつ頭かかえてる！？", "face": "u2047a1"}, {"name": "ラージヴィール", "text": "ともあれ、相手がなんであろうと\nその侵攻を止めねばならん。", "face": "l4ebe7bd5270c"}, {"name": "アナーニャ", "text": "問題は……いえ、問題だらけなのですが、\n特に兵数よりも民の守護に回す人員が足りません。\nこの男の娘もそちらの支援をしてくれていますが……。", "face": "u2873a1"}, {"name": "アンナ", "text": "そのことでしたら、こちらへお任せを。\nすでに我々の世界から、\n多数の援軍が到着しています。"}, {"name": "リーナ", "text": "わっ……！　こんなに早くですか？\nいったいどこの国が……白の帝国でしょうか？\nそれとも北の大国か、華の国、東の国か――", "face": "u521"}, {"name": "アンナ", "text": "ゴブリン軍団ですよ、リーナさん。\n各国も部隊の派遣を急いでくれていますが、\n最初に来てくれたのは、ゴブリン軍団です。"}, {"name": "リーナ", "text": "…………！！", "face": "u521"}, {"name": "王子", "text": "…………（ぽふぽふ）", "face": "u1"}]}, {"trigger": "start", "lines": [{"name": "一般兵Ａ", "text": "――報告！\n王子、敵ドラゴンが外壁を突破した模様！", "face": "u6"}, {"name": "アンナ", "text": "行きましょう、王子。\n何度も、国が落ちる様は見たくありませんから。"}, {"name": "王子", "text": "…………！！", "face": "u1"}]}, {"trigger": "battle", "at_sec": 120, "lines": [{"name": "ウェンディ", "text": "――リヴァイアサンから、何か発射された？\nアルレット！　そっちから見える！？", "face": "u401"}, {"name": "アルレット", "text": "見えた！　砲弾……いや、\nドラゴンブレスみたいなものかも！\n火炎弾がばらまかれてる！", "face": "u1453a1"}, {"name": "アルレット", "text": "王子さまー！　そっちにも一発飛んでくよ！\n気をつけて！！", "face": "u1453a1"}]}, {"trigger": "end", "lines": [{"name": "アナーニャ", "text": "……攻勢が止まったようですね。", "face": "u2873a1"}, {"name": "ケイティ", "text": "あちらも体勢を整えているのでしょう。\nおそらく、間を空けずに次の攻勢が来ます。", "face": "u2433a1"}, {"name": "ユリクセス", "text": "あるいは……何か大掛かりな準備をしているか、だ。", "face": "u2193a1"}, {"name": "ユリクセス", "text": "あれがレヴィアタンの小型版だというのなら、\n正直、嫌な予感しかしない。", "face": "u2193a1"}, {"name": "ラピス", "text": "……魔界、か。", "face": "u436"}, {"name": "ユリクセス", "text": "こんな民間人だらけの場所で、\n高濃度の瘴気なんか散布されてみろ。\n勝率は大幅に下がるだろうな。被害も計算不能だ。", "face": "u2193a1"}, {"name": "フローガ", "text": "…………っ！\nリヴァイアサンの中心で、魔力の大規模な乱れが……。", "face": "u878"}, {"name": "ユリクセス", "text": "くっ……悪い予感は当たるものか。\nフローガ、魔界の瘴気で間違いないか！？", "face": "u2193a1"}, {"name": "フローガ", "text": "違います！\n完全な魔界の瘴気の逆位相です！！", "face": "u878"}, {"name": "フローガ", "text": "こんなの見たことありません……。\nあれが放たれたら、この地域一帯がどうなるか……。", "face": "u878"}, {"name": "ユリクセス", "text": "まったく、つくづく未知の世界というのは厄介だな……！", "face": "u2193a1"}, {"name": "アイシャ", "text": "先手を打つしかないよ。\n魔界の逆位相をぶつけてくるなら、\nこっちだって、切り札を切るしかないんじゃない？", "face": "u181"}, {"name": "リーナ", "text": "……きりふだ？", "face": "u521"}]}], "map": {"image": "Map7521", "w": 960, "h": 640, "spots": [{"k": "b", "x": 816, "y": 127}, {"k": "m", "x": 609, "y": 161, "id": 200}, {"k": "m", "x": 668, "y": 132, "id": 201}, {"k": "m", "x": 680, "y": 209, "id": 202}, {"k": "m", "x": 747, "y": 167, "id": 203}, {"k": "m", "x": 758, "y": 251, "id": 204}, {"k": "m", "x": 820, "y": 207, "id": 205}, {"k": "m", "x": 526, "y": 207, "id": 206}, {"k": "m", "x": 458, "y": 250, "id": 207}, {"k": "m", "x": 393, "y": 287, "id": 208}, {"k": "m", "x": 330, "y": 320, "id": 209}, {"k": "m", "x": 268, "y": 356, "id": 210}, {"k": "m", "x": 180, "y": 391, "id": 211}, {"k": "m", "x": 85, "y": 357, "id": 212}, {"k": "m", "x": 422, "y": 375, "id": 213}, {"k": "m", "x": 490, "y": 333, "id": 214}, {"k": "m", "x": 495, "y": 412, "id": 215}, {"k": "m", "x": 568, "y": 378, "id": 216}, {"k": "m", "x": 642, "y": 421, "id": 217}, {"k": "m", "x": 700, "y": 452, "id": 218}, {"k": "r", "x": 374, "y": 163, "id": 300}, {"k": "r", "x": 285, "y": 246, "id": 301}, {"k": "r", "x": 233, "y": 275, "id": 302}, {"k": "r", "x": 355, "y": 428, "id": 303}, {"k": "r", "x": 596, "y": 271, "id": 304}, {"k": "r", "x": 767, "y": 319, "id": 305}, {"k": "r", "x": 723, "y": 348, "id": 306}], "events": [{"t": 0, "when": "time", "ops": [{"op": "+fx", "name": "obj_99", "fx": "BlackOut3", "x": 480, "y": 301}]}, {"t": 115.7, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "RockFall3", "x": 261, "y": 347}]}, {"t": 120.2, "when": "time", "ops": [{"op": "-fx", "name": "obj_00"}]}]}, "start_cost": 10, "active": true}