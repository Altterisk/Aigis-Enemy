ource": "local", "count": 3, "level": 90, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098448, "race_id": 18, "special_effect_id": 220, "master_id": 96, "global_id": 95, "spawn_sec": 94}, {"enemy_id": 10, "source": "local", "count": 7, "level": 90, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 10, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 100}]}, "spawn_sec": 105}, {"enemy_id": 12, "source": "local", "count": 1, "level": 90, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109328, "race_id": 6, "special_effect_id": 232, "change_to": 12, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30177, "global_id": 3796, "ranged": true, "route_behaviour": {"transforms": [{"wait": 1400}]}, "spawn_sec": 139}, {"enemy_id": 14, "source": "local", "count": 1, "level": 90, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 14, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 1300}]}, "spawn_sec": 139}], "popups": ["オリハルコンゴーレムの\nHPを減らすと、\n強烈な遠距離攻撃をしてきます。\n拠点には向かわず、しばらくすると\n戦場からいなくなります。\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "天使", "text": "……これが神殺しの聖槍、グングニルですか。\n忌々しい……可能ならば破壊したいところですが、\nこの大きさと材質では難しそうですね。", "face": "l21ccdd366010"}, {"name": "天使", "text": "ここは予定通り、この部屋を破壊して埋めるしか……。\n……おや、あれは……？", "face": "l21ccdd366010"}]}, {"trigger": "battle", "at_sec": 15, "lines": [{"name": "天使", "text": "あれは……ゴーレム。\n聖槍グングニルの守護者というわけですか。\n……くだらない浅知恵を。", "face": "l21ccdd366010"}, {"name": "ネフティ", "text": "……そ、そんな……。\n天使たちがもう聖槍の座に……。", "face": "u551"}, {"name": "モーティマ", "text": "おいおいおいおい！\nそれどころじゃねえだろ！\nなんなんだよ、あのデカブツは！？", "face": "u14"}, {"name": "バルバストラフ", "text": "ほぅ……オリハルコンゴーレムか。\nこんなところで見かけることになるとはのぅ。", "face": "u63"}, {"name": "ネフティ", "text": "おりはる、こむ……？\n言い伝えでは、聖槍が危機に晒された際に\n不滅の怪物が目を醒ますと聞いていましたが……。", "face": "u551"}, {"name": "サイラス", "text": "うむ。倒せるなどとは思わぬべきだな。\n奴は攻撃されると反撃してくるが、\n刺激しなければ向こうから襲ってくることはない。", "face": "u13"}, {"name": "バルバストラフ", "text": "無論、無闇に刺激しない方が賢明というものじゃ。\n奴の一撃は山をも砕くというからのぅ。", "face": "u63"}, {"name": "天使", "text": "……この状況では部屋を破壊して\n聖槍を埋めるのは難しそうですね。", "face": "l21ccdd366010"}, {"name": "天使", "text": "ここは方針を変え、人間たちの殲滅を優先しましょう。\n彼らにゴーレムを刺激させ、\n自滅させるというのも一興です。", "face": "l21ccdd366010"}, {"name": "兵士", "text": "――天使たち、向かってきます！", "face": "u6"}, {"name": "アンナ", "text": "王子……ここはなんとしても\n天使たちを退け、聖槍を守り抜きましょう！", "face": "l27c32c63c21e"}]}, {"trigger": "end", "lines": [{"name": "天使", "text": "ぐっ……ば、馬鹿な……。\n主よ、お許し下さい……。", "face": "l21ccdd366010"}, {"name": "ネフティ", "text": "すごい……本当に天使たちを撃退するなんて。\nこれが王子たちの実力ですか。", "face": "u551"}, {"name": "デシウス", "text": "王子、聖槍の座に向かうがいい。\n我輩はケラウノスを葬れればそれでいいのだ。\n聖槍は貴様に使わせてやる。", "face": "l07c2a5a929a8"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "デシウス", "text": "……なに、我輩が使うべきだと？", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "……フッ、そうかもしれんな。\n神殺しの汚名を受けるのは、\n暗黒騎士となった我輩こそが相応しい……。", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "王子……本当によろしいのですか？", "face": "l27c32c63c21e"}, {"name": "ユリアン", "text": "心配すんなって。\n闇に染まったとはいえ、ヤツも騎士だ。\nここで裏切るような真似は死んでもしねえさ。", "face": "u7"}, {"name": "デシウス", "text": "ついに……ついに辿り着いたぞ。\n聖槍グングニル……これさえあれば我が宿敵、\nケラウノスを完全に葬り去ることができるのだ！", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "聞け！　そして記憶しろ！\n我が名はデシウス！\n女神ケラウノスを屠る者なり！", "face": "l07c2a5a929a8"}]}], "active": true}