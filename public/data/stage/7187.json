{"quest_id": 7187, "name": "感謝ノ隊列クンレン", "description": "ゴブリンたちによる\n一糸乱れぬ隊列訓練は\nさらなる進化を遂げる！？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "新たなる千年戦争", "event_category": "History", "mission_id": 920187, "map_no": 5131, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 269, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 13, "form_count": 2, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "change_to": 2, "master_id": 33008, "global_id": 6625, "to_global_id": 6626, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 216}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "special_effect_id": 651, "master_id": 33009, "global_id": 6626}, {"enemy_id": 4, "source": "local", "count": 42, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 252}, {"enemy_id": 5, "source": "local", "count": 1, "level": 8, "form_count": 2, "tags": ["鳥"], "hp": 20000, "base_hp": 20000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 3, "attack_interval": 38, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123344, "race_id": 12, "special_effect_id": 551, "change_to": 5, "missile_id": 45, "master_id": 32629, "global_id": 6247, "to_global_id": 6248, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 265}, {"enemy_id": 5, "source": "local", "count": 1, "level": 8, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 20000, "base_hp": 20000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "attack_interval": 31, "move_speed": 3000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123360, "race_id": 12, "special_effect_id": 549, "change_to": 4, "missile_id": 45, "master_id": 32630, "global_id": 6248, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "――諸君、７周年でアル！！", "face": "l59bd89a97217"}, {"name": "ゴブリン博士", "text": "魔物の復活ヨリ、早７年！\nゴブリン族の躍進ハ留まるところを知らナイ！", "face": "l59bd89a97217"}, {"name": "ゴブリン", "text": "ギャギャ！　ヤクシン！　ヤクシン！", "face": "l89c89fcc4ec1"}, {"name": "ゴブリン博士", "text": "魔王ガリウス様は敗北シタ！\nだが、我らゴブリン族は未だ隆盛を誇ってイル！", "face": "l59bd89a97217"}, {"name": "ゴブリン博士", "text": "そして！　とうとう宿敵タル王子までモ！\n我らに助力を求めてくるに至っタのでアル！！", "face": "l59bd89a97217"}, {"name": "ゴブリン", "text": "ゴブリンバンザイ！\nメカゴブリンクイーン様！　バンザイ！", "face": "l89c89fcc4ec1"}, {"name": "ゴブリン博士", "text": "さらには！　驚くなかレ！\n我らゴブリン族が、\n天界にすら進軍スル日が来たノダ！！", "face": "l59bd89a97217"}, {"name": "ゴブリン博士", "text": "――シカシ、ここで気を抜けバ、\n凡百の魔物ト変わらヌ末路が待ってイル……。", "face": "l59bd89a97217"}, {"name": "ゴブリン博士", "text": "我らゴブリン族は最弱にシテ最強ニ至る種族！\n決戦の直前マデ、訓練ヲ怠ることナカレ！！", "face": "l59bd89a97217"}, {"name": "ゴブリン", "text": "クンレン！　クンレン！\nマイニチクンレン！！", "face": "l89c89fcc4ec1"}, {"name": "ゴブリン博士", "text": "その意気やヨシ！\n総員整列！　去年を超えル行進を見せるノダ！！", "face": "l59bd89a97217"}]}, {"trigger": "end", "lines": [{"name": "パリオス", "text": "――急停止ー！！\nあっ！　ゴブリン博士いた！！\nそろそろ出陣だってアンナさんが言ってたよ！", "face": "u1109a1"}, {"name": "ゴブリン博士", "text": "ムッ、パリオスとやら、伝令ご苦労でアル。\nクククク、ようやくゴブリン軍団による\n天界蹂躙の始まりダナ！！", "face": "l59bd89a97217"}, {"name": "パリオス", "text": "それにしても、出撃直前まで訓練なんて、\nゴブリン族ってすごい種族だね。", "face": "u1109a1"}, {"name": "ゴブリン博士", "text": "ゴブリン族は弱いと７年間デ思い知ったからナ、\nゆえに常に努力を怠ってはならないノダ。\n知識と日々の訓練コソ、窮地ニテ己を救うのダゾ。", "face": "l59bd89a97217"}, {"name": "パリオス", "text": "……うん、ぼくも気をつけなきゃ。\nもう操られないように！\n大切なものを、二度と奪われないように！", "face": "u1109a1"}, {"name": "ゴブリン博士", "text": "ウムウム。パタパタしている割に\n良い心がけではナイか！", "face": "l59bd89a97217"}, {"name": "ゴブリン博士", "text": "――さぁ栄光のゴブリン軍団ヨ！\n目指すは天界！　総員、進撃開始デアル！！", "face": "l59bd89a97217"}]}], "active": true}