"magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 32751, "global_id": 6369, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124160, "race_id": 20, "change_to": 13, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32915, "global_id": 6532, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6535, "spawn_sec": 113}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 800, "base_hp": 5500, "base_attack": 800, "damage_type": "true", "armor_defense": 600, "magic_defense": 15, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124176, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32918, "global_id": 6535, "ranged": true, "from_condition": 4, "trigger_ticks": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "ユージェン", "text": "――王子、何か変な音が聞こえないか？", "face": "u906"}, {"name": "レアン", "text": "……ほう。\nユージェン、これは重装歩兵の行軍の音だな。\n鎧と足音が重なって、重い響きになっているんだ。", "face": "u50"}, {"name": "天使", "text": "如何に強き英雄と言えど、\n押し寄せる軍勢に抗うことはできないでしょう。", "face": "l5acdfefcd897"}, {"name": "天使", "text": "神の愛を受け入れ、その身を捧げるならば\nこれが最後の機会ですよ。\n王子よ、人の子としての運命を受け入れなさい。", "face": "l5acdfefcd897"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "天使", "text": "……嫌な表情ですね。\n自信に満ちた、迷いなき表情です。", "face": "l5acdfefcd897"}, {"name": "天使", "text": "覚悟を決めたというのなら、\nこのまま浄化の波に押しつぶされるが良いでしょう。", "face": "l5acdfefcd897"}, {"name": "パリオス", "text": "お、おおお、王子さまぁっ！\nすごい重装の天界兵が\n集落の方に向かってくるよぉ！？", "face": "u1109a1"}, {"name": "アトナテス", "text": "重装だろうと軽装だろうと、\nやることは同じだぜ？\n王子、物質界のやり方を見せてやりな。", "face": "u908"}, {"name": "サナラ", "text": "魔王城の方がよっぽど大変でしたからね。\n王子ちゃん、指揮をお願いしますよー！", "face": "u921"}]}, {"trigger": "end", "lines": [{"name": "天使", "text": "――くっ……。\n計算ではこれで王国軍など壊滅できるはず……。", "face": "l5acdfefcd897"}, {"name": "天使", "text": "人間ごときが、\nより強くなっているとでも言うのですか……？", "face": "l5acdfefcd897"}, {"name": "ノーマ", "text": "誰にそそのかされたかは知らないけど、\n人間って種族の強さを見誤ったみたいね。", "face": "u1047a1"}, {"name": "ノーマ", "text": "こいつら、すっごく努力するし、\nすぐ成長するし、数日見ないだけで\nすっごくカッコよくなるんだから！", "face": "u1047a1"}, {"name": "天使", "text": "……戯言を。\nこうなればアラエル様の力を借りるしかありませんね。", "face": "l5acdfefcd897"}, {"name": "ライノー", "text": "……アラエル、様、だと？", "face": "u1086a1"}, {"name": "ソラス", "text": "ライノーさん、ご存知なのですか？", "face": "u904"}, {"name": "ライノー", "text": "いや、聞き間違いだろう。\nアラエルとは、私たちの創造主が生み出した、\n空を飛ぶ者を守護する天使様の名なのだ。", "face": "u1086a1"}, {"name": "ライノー", "text": "創造主を助け、被造物たる空を飛ぶ者を慈しむ、\n心優しきアラエル様が、こんな所業に手を貸すなど――", "face": "u1086a1"}, {"name": "アラエル", "text": "――こんな所業に手を貸すはずがない。\nそう思っているようですね、ライノー。", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "その通り、僕が残虐な行いに手を貸すことはありません。\nそう、これは非道ではなく、\n聖なる神の思し召しであり、僕が望んだことなのですよ。", "face": "l7c04f1b6c641"}]}], "active": true}