{"quest_id": 8474, "name": "加工方法を求めて", "description": "調理方法を求め栽培地にやってきた一行は、\n暴走する魔界カカオと魔物を発見する。\n有識者から話を聞くため敵を討伐せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "不思議なカカオクッキング", "event_category": "History", "mission_id": 920226, "map_no": 9295, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142080, "special_effect_id": 1224, "change_to": 1, "master_id": 35757, "global_id": 9374, "to_global_id": 9375, "route_behaviour": {"transforms": [{"wait": 50}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 5, "tags": ["植物", "バレンタイン", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142096, "change_to": 2, "master_id": 35758, "global_id": 9375, "to_global_id": 9376}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142112, "special_effect_id": 1225, "change_to": 3, "master_id": 35759, "global_id": 9376, "to_global_id": 9377}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 3, "form_count": 5, "tags": ["植物", "バレンタイン", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142128, "change_to": 4, "master_id": 35760, "global_id": 9377, "to_global_id": 9378}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 4, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142144, "special_effect_id": 1226, "master_id": 35761, "global_id": 9378}, {"enemy_id": 6, "source": "local", "count": 19, "form_count": 1, "tags": ["バレンタイン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 350, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121296, "race_id": 3, "change_to": 6, "master_id": 32292, "global_id": 5911, "spawn_sec": 41}, {"enemy_id": 8, "source": "local", "count": 15, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 308, "change_to": 8, "master_id": 32290, "global_id": 5909, "to_global_id": 5920, "spawn_sec": 100}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 275, "change_to": 7, "master_id": 32301, "global_id": 5920}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "tags": ["バレンタイン"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121328, "race_id": 3, "change_to": 10, "master_id": 32294, "global_id": 5913, "spawn_sec": 125}, {"enemy_id": 12, "source": "local", "count": 6, "form_count": 1, "tags": ["バレンタイン"], "hp": 1600, "attack": 500, "base_hp": 1600, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "attack_range": 100, "attack_speed": 70, "attack_wait": 50, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113952, "missile_id": 257, "missile": {"speed": 2.0}, "master_id": 30905, "global_id": 4524, "ranged": true, "spawn_sec": 155}], "popups": ["魔界カカオがいる間は、\n女性、バレンタイン属性の\n敵の攻撃と防御がアップします。\n\nまた魔界カカオは、\n時間経過で成長します。\n成長するたびに攻撃と防御の\n上昇する値がアップします。", "チョコマイコニドがいる間、\n全ての味方ユニットは\n継続ダメージを受けます。\n\nまた、チョコマイコニドの数に応じて\n効果が重複します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "エレイン", "text": "どうしたらカカオ豆ってチョコになるのよ！！", "face": "u2365a1"}, {"name": "マツリ", "text": "王国の厨房で色々と試してみましたが……。\nカカオ豆の魔物と普通のカカオ豆は違うのでしょうね。\nまったく調理することができませんでした。", "face": "u2363a1"}, {"name": "ノストラ", "text": "で、どうすればいいか、\n有識者に聞きに来たわけだけど……。\nここは、カカオの栽培地かしら？", "face": "u2364a1"}, {"name": "アデライド", "text": "あぁ。\nこの時期は魔界カカオの栽培をしているらしいからな。", "face": "u2362a1"}, {"name": "ミア", "text": "噂をすれば来ましたよっ。\nグレーターデーモンさーん！", "face": "u2361a1"}, {"name": "グレーターデーモン", "text": "おや？　キミたちは王国の……。", "face": "lb9ecc9a377f0"}, {"name": "マツリ", "text": "魔界カカオを栽培しているあなたに、\n聞きたいことがあるんです。\n急ではありますが、よろしいでしょうか？", "face": "u2363a1"}, {"name": "グレーターデーモン", "text": "ふむ。それは構わないが、\n今は少し取り込んでいてね。", "face": "lb9ecc9a377f0"}, {"name": "グレーターデーモン", "text": "実は、魔界カカオが暴走してしまっているんだ。\n栽培がなかなかどうして難しくてね。", "face": "lb9ecc9a377f0"}, {"name": "エレイン", "text": "大変じゃない！\nよく見たら魔界カカオだけじゃなくて、\nチョコの魔物も暴れてるし！", "face": "u2365a1"}, {"name": "ミア", "text": "い、急いで魔界カカオを倒しましょう！\nこのまま栽培地がめちゃくちゃになったら、\nグレーターデーモンさんがかわいそうです！", "face": "u2361a1"}, {"name": "グレーターデーモン", "text": "ありがとう、とても助かるよ。\nそうそう、魔界カカオについて注意だがね。", "face": "lb9ecc9a377f0"}, {"name": "グレーターデーモン", "text": "魔界カカオの木は成長するほどに、\n周囲のカカオたちに力を与えてしまう。\n実が成る前に倒したほうがいいだろうね。", "face": "lb9ecc9a377f0"}, {"name": "アデライド", "text": "助言、感謝する！\nでは魔界カカオを討伐するぞ！", "face": "u2362a1"}]}, {"trigger": "end", "lines": [{"name": "グレーターデーモン", "text": "魔界カカオは落ち着いたようだね。\nつくづく、王国には頭が上がらないよ。", "face": "lb9ecc9a377f0"}, {"name": "アデライド", "text": "気にするな、グレータデーモン。\n王子や私たちが好きでやっているだけだ。", "face": "u2362a1"}, {"name": "ノストラ", "text": "それに、こちらも聞きたいことがあるのだし。\nギブアンドテイクよ。", "face": "u2364a1"}, {"name": "マツリ", "text": "そうですね。\nそれで、カカオ豆の魔物の調理方法について、\nグレーターデーモンさんに聞きたいのですが……。", "face": "u2363a1"}, {"name": "エレイン", "text": "普通の調理じゃチョコにできなかったの！\nカカオ豆の魔物ってどうすればチョコになるの！？", "face": "u2365a1"}, {"name": "グレーターデーモン", "text": "カカオ豆の魔物というのは初めて見たが、そうだね……。", "face": "lb9ecc9a377f0"}, {"name": "グレーターデーモン", "text": "普通の調理で駄目なら、\n並大抵ではない調理をすれば良いのではないかな。", "face": "lb9ecc9a377f0"}, {"name": "マツリ", "text": "なるほど。\nとても参考になりました。", "face": "u2363a1"}, {"name": "カカオ豆の魔物", "text": "えっと、私ってどうすればいいのかな……？", "face": "le1ad1420c9f0"}, {"name": "ノストラ", "text": "要するに尋常じゃない火力で焙煎したり、\nとんでもない力で砕いて磨り潰す必要があるってことよ。", "face": "u2364a1"}, {"name": "マツリ", "text": "となるとそうですね。\nまず向かうべきは――", "face": "u2363a1"}, {"name": "マツリ", "text": "――溶岩地帯ですね。", "face": "u2363a1"}]}], "active": true}