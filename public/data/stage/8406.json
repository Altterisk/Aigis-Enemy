"speed": 3.0}, "master_id": 652, "global_id": 651, "ranged": true, "spawn_sec": 482}, {"enemy_id": 44, "source": "local", "count": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000000, "base_hp": 1000000, "damage_type": "magical", "armor_defense": 3000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "pattern_id": 2148336, "race_id": 19, "special_effect_id": 1900, "change_to": 44, "master_id": 38062, "global_id": 11679, "to_global_id": 11661, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_StandMotion\"); FlagCheckCommandOrder(116, 1, 127, 1, \"DoEnemy_ModeChange();\");", "mode_changes": 1, "flag_checks": ["116, 1, 127, 1, \"DoEnemy_ModeChange("]}, "spawn_sec": 489}, {"enemy_id": 44, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000000, "attack": 1, "base_hp": 1000000, "base_attack": 1, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 80, "attack_speed": 1, "attack_wait": 60, "attack_interval": 222, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "pattern_id": 2157072, "race_id": 19, "special_effect_id": 1900, "master_id": 38044, "global_id": 11661}, {"enemy_id": 46, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000000, "attack": 1, "base_hp": 1000000, "base_attack": 1, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 80, "attack_speed": 20, "attack_wait": 110, "attack_interval": 301, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2157088, "race_id": 19, "special_effect_id": 1176, "master_id": 38045, "global_id": 11662, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 492}], "popups": ["女神ケラウノスの祈りによって\n力が集まりました。\n\n光を放つマスに配置したユニットは\n女神の力により\nHP、攻撃、防御、魔法耐性が\n大幅に上昇します。", "上位天使を倒すと\n対応した属性の\nアークエレメンタルが出現します。", "水のアークエレメンタルがいる間、\n全ての敵のHPが徐々に回復します。\n\n倒さなくても★の評価には\n影響しません。 ", "風のアークエレメンタルは、\n一定時間が経過するたびに\n攻撃性能が変化します。\n\n倒さなくても★の評価には\n影響しません。 ", "雷のアークエレメンタルがいる間、\n大神ディアスは攻撃力50000以下の\nあらゆる攻撃を受け付けません。\nまた大神ディアスの\n攻撃と防御が大幅にアップします。\n\n倒さなくても★の評価には\n影響しません。 ", "ギガエルがいる間は、\n魚人を含む水棲の魔物の\n攻撃と防御がアップします。", "アラエルがいる間は、\n鳥人系の敵の攻撃と防御が\nアップします。", "アラエルが使役する霊鳥は\nあらゆる攻撃を受け付けません。\n\nアラエルの撃破、もしくは\nアラエルが拠点を通過すると\n消滅します。", "三神器を装備した大神ディアスは\n攻撃力5000以下の\nあらゆる攻撃を受け付けません。\n\nまた三神器を装備した\n大神ディアスは攻撃を受けると\n攻撃したユニットへ反撃を行います。", "大神降臨　真ディアスが\n解放されました。\n\nホーム画面左側の\nミッションクエストにある、\n魔神降臨のメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーヴ", "text": "――終焉要塞ゼウス……聞いたことのない響きです。\n歴史書にも、そんな名前は残されていません。", "face": "u454"}, {"name": "エフトラ", "text": "当然です。\nこの要塞が目覚めるのは、時代の終焉の時。\n滅びた世界に、記録は残りませんから。", "face": "u1468a1"}, {"name": "エフトラ", "text": "ただ、何度も滅びを繰り返した大地には、\n地表全てを焼き尽くした雷霆の痕跡だけが、\n幾重にも折り重なって、刻まれています。", "face": "u1468a1"}, {"name": "プリニース", "text": "記録すら残さないほどに、\n大地を焼き尽くし、すべてをやり直す兵器、か。", "face": "u2173a1"}, {"name": "アルレット", "text": "じゃあ対抗策は――", "face": "u1453a1"}, {"name": "レクテ", "text": "もちろん、誰も知らない！", "face": "u2047a1"}, {"name": "オーガスタ", "text": "皆さん、ケラウノス様が残してくださった、\n雷神の祈りが周囲に展開されています。", "face": "u960"}, {"name": "オーガスタ", "text": "光の上に立てば、\nケラウノス様が力を貸してくださるはず……。\nどうか、この戦いに、勝利を！", "face": "u960"}]}, {"trigger": "battle", "at_sec": 50, "lines": [{"name": "ギガエル", "text": "――これは、終焉の雷をもたらす最終兵器だ。", "face": "l9e059edf3ba8"}, {"name": "リバン", "text": "ギガエル様！？\nご無事でしたのね！", "face": "u1062a1"}, {"name": "ギガエル", "text": "だが、まだその発動には至っていない。\n星を焼き尽くすには、\n異なる星の力が必要となるのだ。", "face": "l9e059edf3ba8"}, {"name": "ギガエル", "text": "我ら天使は、神の力を分け与えられた、\nいわば力の結晶たる存在……。", "face": "l9e059edf3ba8"}, {"name": "ギガエル", "text": "我らの死をもって、\n新たな星は生み出され――ゼウスの鍵となる。", "face": "l9e059edf3ba8"}, {"name": "ギガエル", "text": "王子よ、我ら天使の命は、既に炉に焚べられた……。\nお前の手で、我らを終わらせてくれ。", "face": "l9e059edf3ba8"}]}, {"trigger": "battle", "at_sec": 294, "lines": [{"name": "アラエル", "text": "……神は、もういない。\n鳥神様は……もう、いないんだ。", "face": "le51e4155e428"}, {"name": "アラエル", "text": "もう、この世界に存在する理由がない。\nここにいる、理由がない。", "face": "le51e4155e428"}, {"name": "パリオス", "text": "――そんなこと！　ないよ！\nアラエル様！　アラエル様はぼくたちの天使様だもん！", "face": "u1109a1"}, {"name": "パリオス", "text": "鳥神様がいなくても、ぼくたちがついてる！\nだから――", "face": "u1109a1"}, {"name": "アラエル", "text": "……パリオス。", "face": "le51e4155e428"}, {"name": "アラエル", "text": "うぅん、もう、だめみたいだ。\n僕の魂は……炉に焚べられてしまった。", "face": "le51e4155e428"}]}, {"trigger": "enemy_spawn", "enemy_id": 30, "lines": [{"name": "フローガ", "text": "――ッ！！\nラムイエルの星が……雷の星が、\n周囲の魔力を増幅していきます！", "face": "u878"}, {"name": "フローガ", "text": "これは……そうか、\n雷の星の魔力がディアスへと流れ込んでいます！\n力を増幅しようとしているんです！", "face": "u878"}]}, {"trigger": "battle", "at_sec": 396, "lines": [{"name": "ラムイエル", "text": "……どちらの道を進むのか。\nその答えは、\nこの世界に生を受けた時より決まっています。", "face": "lb985f043290b"}, {"name": "ラムイエル", "text": "我が存在理由は、ディアスさまただおひとり。", "face": "lb985f043290b"}, {"name": "ラムイエル", "text": "人間を理解しようとしたのも、\nただ、ディアス様がそう願っておられたから。", "face": "lb985f043290b"}, {"name": "ラムイエル", "text": "今ここに、最後の星となりましょう。\n終焉の星よ、神なる雷霆よ、我が身を捧げん。", "face": "lb985f043290b"}]}, {"trigger": "battle", "at_sec": 418, "lines": [{"name": "ディアス", "text": "――これで、舞台は整った。\n王子よ、これでもはや、世界の変革は避けられぬ。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "余が勝利し、地上の悪しき者を焼き払い、\n諦観と停滞の世界が始まるか……。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "あるいは、貴様が勝利し、\n次なる世界を歩み始めるか、だ。", "face": "l7b4853f3269d"}, {"name": "王子", "text": "――大神ディアス。", "face": "u1"}, {"name": "ディアス", "text": "…………何だ？", "face": "l7b4853f3269d"}, {"name": "王子", "text": "神も、変わることができる。\nもう気付いているはずだ。", "face": "u1"}, {"name": "ディアス", "text": "ありえぬ話をするものだ。\nだが、余を討った後、貴様がそう願うのは自由だ。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "神の物語を終え、人の歴史を始めんとするならば、\n貴様の力を見せてみよ。\n人の力で終焉を乗り越えられると、証明してみせよ！", "face": "l7b4853f3269d"}]}, {"trigger": "battle", "at_sec": 490, "lines": [{"name": "王子", "text": "――大神ディアス、ここで神話は終わりだ。", "face": "u1"}, {"name": "ディアス", "text": "見事、だ……。\nもはや、悔いはない……。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "王子よ、世界の行く末は……貴様に託す……。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "その手を零れ落ちる悲しみも、\n遥かな未来に待つ終焉も……。\n王子よ、全ては……貴様の選択に、かかって――", "face": "l7b4853f3269d"}, {"name": "王子", "text": "…………ああ。", "face": "u1"}, {"name": "王子", "text": "ディアス、お前の願いも、俺が背負っていく。\n共に、未来を見に行こう。", "face": "u1"}, {"name": "パルセ", "text": "――『……ですか。みなさん、ご無事ですか！？』", "face": "u2276a1"}, {"name": "フローガ", "text": "パルセさん！\nドーンブリンガーは大丈夫ですか！？", "face": "u878"}, {"name": "パルセ", "text": "『応急修復は完了しました。\n現在、要塞宮殿へ向けて自動航行中です』", "face": "u2276a1"}, {"name": "パルセ", "text": "『ただ、急いで伝えないといけないことが……』", "face": "u2276a1"}, {"name": "フローガ", "text": "急いで伝えないと、いけないこと……？\n……はい。はい……えっ、えっと、えぇっ！？", "face": "u878"}, {"name": "パルセ", "text": "『そうです、はい、確かに。\n――要塞宮殿から、無数の流れ星が！』", "face": "u2276a1"}, {"name": "エフトラ", "text": "終焉要塞ゼウスは、星の力そのものを内包しています。\nこの、降り注ぐ流星は……。", "face": "u1468a1"}, {"name": "プリニース", "text": "新たに生まれた、星の概念そのもの……？", "face": "u2173a1"}, {"name": "ユリクセス", "text": "……ディアスからの祝福だと、思いたいな。", "face": "u2193a1"}, {"name": "アキレア", "text": "莫大な魔力の結晶が降り注いでるんだ。\nそれに、ひい爺さんの仕込みだぞ？\nどうせ、ろくなもんじゃないさ。", "face": "u1972a1"}, {"name": "アイシャ", "text": "でも……。", "face": "u181"}, {"name": "ユリクセス", "text": "ああ、この眺めは……何というのか――", "face": "u2193a1"}, {"name": "アキレア", "text": "素直じゃねぇな、うちの軍師どもは。\nこういう時は、一言でいいんだよ。", "face": "u1972a1"}, {"name": "シビラ", "text": "――とても、綺麗ね。", "face": "u1981a1"}]}, {"trigger": "end", "lines": [{"name": "ケラウノス", "text": "……お疲れ様です、ディアス。", "face": "l4e9b178011e4"}, {"name": "ディアス", "text": "貴様、魂すべてを王子に委ねたと思っていたが、\nまだ動けるだけの余力があったのか。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "……余を、嘲笑いに来たのか？", "face": "l7b4853f3269d"}, {"name": "ケラウノス", "text": "そんなこと、しませんよ。\n互いに世界のやり直しを、失敗した仲ではありませんか。", "face": "l4e9b178011e4"}, {"name": "ディアス", "text": "……そして、そのどちらも、\n人間たる王子に敗北した神、か。", "face": "l7b4853f3269d"}, {"name": "ケラウノス", "text": "そして、神が己の法に従うだけではない、\n変わることのできる存在だと、\n王子に教えられた者、でもありますね。", "face": "l4e9b178011e4"}, {"name": "ケラウノス", "text": "考えたことは、ありますか？\n創造神が、なぜ世界を悲劇で満たしたのか。", "face": "l4e9b178011e4"}, {"name": "ディアス", "text": "そして人は、なぜ愚かな存在なのか、か。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "常に考え続けていたとも。\n王子が世界を、わずかながらも書き換えた、あの時から。", "face": "l7b4853f3269d"}, {"name": "ケラウノス", "text": "きっと、私たちと同じなのでしょう。", "face": "l4e9b178011e4"}, {"name": "ディアス", "text": "ああ、きっと、そうに違いない。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "そうでなければ、ここまで心晴れやかに、\n最後の瞬間を迎えられたりするものか。", "face": "l7b4853f3269d"}, {"name": "ケラウノス", "text": "……大神ディアス、我が雷霆の、最初の担い手。\n何か王子に伝えておくことはありますか？", "face": "l4e9b178011e4"}, {"name": "ディアス", "text": "全て、伝わっているはずだ。\nこれ以上は、何を言っても無意味だろう。", "face": "l7b4853f3269d"}, {"name": "ケラウノス", "text": "では、これでお別れですね。", "face": "l4e9b178011e4"}, {"name": "ディアス", "text": "ああ、さようならだ。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "――だが、少しくらいは、手を貸してやっても良いか。\n新たな時代を、新たな夜明けを歩む者らへ、\n古き神話の最後の頁から、ひとかけらの祝福を。", "face": "l7b4853f3269d"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "ギガエル", "text": "クラールフ様を、信じ続けていたなら、\n今もあの御方の隣に、いられたのだろうか……。", "face": "l9e059edf3ba8"}, {"name": "ギガエル", "text": "なぜ私は、あの御方の真意を疑い、\n異境の神に頭をたれてしまったのか。", "face": "l9e059edf3ba8"}, {"name": "ハルフゥ", "text": "ギガエル様、クラールフ様に伝えることは――", "face": "u1118a1"}, {"name": "ギガエル", "text": "……いや、あの御方なら、\nきっと我が真意も、この想いも、ご存知でおられる。", "face": "l9e059edf3ba8"}, {"name": "ギガエル", "text": "さらばだ、我が……愛しき海よ――", "face": "l9e059edf3ba8"}, {"name": "ムイル", "text": "ギガエル様の魔力が、球体に……。\n星の形となっていきます。", "face": "u1419a1"}, {"name": "イリス", "text": "水の星……なのでしょうか……？\n強い癒しの力を感じます。\nどうやら、敵の傷を癒しているようです。", "face": "u17"}]}, {"trigger": "route", "enemy_ids": [12], "lines": [{"name": "アラエル", "text": "さようならだ、みんな。\nどうか――自由なる空を――", "face": "le51e4155e428"}, {"name": "パリオス", "text": "アラエルさま……ぐすっ、うぅぅッ、\n空は……青空は、ぼくらが守るからぁ……っ！", "face": "u1109a1"}, {"name": "ライノー", "text": "渦巻く風が、星になっていく。\n風の星、ということか。", "face": "u1086a1"}, {"name": "ライノー", "text": "王子、時間が経つと暴風が勢いを増していくようだ。\nこの風は刃も同然。気をつけろ！", "face": "u1086a1"}]}, {"trigger": "route", "enemy_ids": [36], "lines": [{"name": "ディアス", "text": "まだだ……まだ神話は終わらぬ……。\n人の可能性を、貴様の輝きを余に見せよ！！", "face": "l7b4853f3269d"}, {"name": "フローガ", "text": "ディアスが宙に浮かんで――\nみ、みなさん！　急いで防御姿勢を……！！", "face": "u878"}, {"name": "アキレア", "text": "いや、こいつは防ぐとか、そういうのは無理だ。\nひい爺さん、楽しそうに笑ってやがる。\nあんな顔、初めて見たぜ。", "face": "u1972a1"}, {"name": "ペルセナス", "text": "これは神の雷霆……。\n魔力障壁も、防具も関係ない。\nすべてに平等に降り注ぐ、審判の雷。", "face": "u1982a1"}, {"name": "ペルセナス", "text": "えーっと……対応策は……。", "face": "u1982a1"}, {"name": "アキレア", "text": "そんなの、真正面から受け止めるしかないだろ！\n人間のこと大嫌いなくせに、\n大好きになっちまった雷神の最後の猛攻なんだぜ！", "face": "u1972a1"}]}], "active": true}