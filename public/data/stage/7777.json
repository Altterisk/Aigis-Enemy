ce": "local", "count": 8, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 79}, {"enemy_id": 17, "source": "local", "count": 5, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 717, "global_id": 716, "spawn_sec": 108}, {"enemy_id": 18, "source": "local", "count": 8, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 600, "attack_speed": 45, "attack_wait": 10, "attack_interval": 113, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122096, "race_id": 9, "master_id": 32439, "global_id": 6058, "spawn_sec": 110}, {"enemy_id": 19, "source": "local", "count": 5, "form_count": 2, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "special_effect_id": 229, "change_to": 15, "missile_id": 6, "master_id": 35474, "global_id": 9091, "ranged": true, "to_global_id": 72, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 112}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "ブレリア", "text": "ブレリアお姉さんのスケート教室♪", "face": "u1117a1"}, {"name": "メープル", "text": "はーじまーるよー♪", "face": "u370"}, {"name": "ミネット", "text": "にゃんにゃかにゃーん♪", "face": "u749"}, {"name": "ブレリア", "text": "はい、皆さん元気が良くて結構ですわね。\nそれでは早速、スケートリンクに──あら？", "face": "u1117a1"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "ゴブリン博士", "text": "悪いナ、紅の踊り子ヨ。\nこのスケートリンクは貸し切りダ、\n今日のところは他を当たってもらおウ。", "face": "l017e26659755"}, {"name": "ブレリア", "text": "なっ……！　この時間は私たちが予約していたはずです！", "face": "u1117a1"}, {"name": "メカゴブリンクイーン", "text": "──氷上とは選ばれし者に用意された自己表現の舞台。\n美しき者たちが、より美しくあるために存在するのよぉ？", "face": "l58c383e26d18"}, {"name": "メカゴブリンクイーン", "text": "お子ちゃまたちは怪我をする前にお家に帰って、\n暖炉の前でママとケーキでも食べたらどうかしら？", "face": "l58c383e26d18"}, {"name": "シュシュ", "text": "メッ、メカゴブリンクイーンさんですぅ！？", "face": "u656"}, {"name": "ブレリア", "text": "……いいえ、スケートリンクとは、\n万人に開かれた場所であるべきです。", "face": "u1117a1"}, {"name": "ブレリア", "text": "たとえ拙かろうと、自己表現の自由は誰にでもあるもの。\n冷たく固い氷の上で転んだ数だけ人は成長するのですから。", "face": "u1117a1"}, {"name": "ブレリア", "text": "スケートは才能ある者だけの特権ではありません！\nメカゴブリンクイーン、私とスケートで勝負ですわ！", "face": "u1117a1"}, {"name": "メカゴブリンクイーン", "text": "紅の踊り子ブレリア、美貌と才覚に恵まれ、\n舞台の上に立つことを運命付けられた者同士、\nあなたとは分かり合えると思ったのだけど──", "face": "l58c383e26d18"}, {"name": "メカゴブリンクイーン", "text": "──どうやらただの甘っちょろい小娘だったようね。\n私の超絶技巧を前にしても、同じことが言えるかしら？", "face": "l58c383e26d18"}, {"name": "ブレリア", "text": "スケートは技術のみで決まりませんのよ。\n私が本当のアイスダンスをお教えしますわ！", "face": "u1117a1"}]}, {"trigger": "end", "lines": [{"name": "ブレリア", "text": "──これがぁ！　私のぉ！　スケートですわぁ！", "face": "u1117a1"}, {"name": "メカゴブリンクイーン", "text": "なんて美しいステップとスケーティング……！\nこの私が、敗北を認めざるを得ないなんて……ッ！", "face": "l58c383e26d18"}, {"name": "ゴブリン博士", "text": "ソンナ……メカゴブリンクイーンさまが、\nメカゴブリンクイーンさまが負けるナド……ッ！", "face": "l017e26659755"}, {"name": "メカゴブリンクイーン", "text": "……博士、相手の美を認めることも美しき者の務めよ。\n確かに私は美しかったけれど、美しいだけだったのね。", "face": "l58c383e26d18"}, {"name": "メカゴブリンクイーン", "text": "それに比べてあの子は情熱的で、なにより楽しそうだった。\n思わず恋してしまいそうになるぐらい、ときめかされたわ。", "face": "l58c383e26d18"}, {"name": "ブレリア", "text": "お褒めに預かり光栄です、クイーン。\n私には真似できない高難易度技の数々、\nそちらも素晴らしいプログラムでしたわ。", "face": "u1117a1"}, {"name": "メカゴブリンクイーン", "text": "敗者に慰めは不要よ、踊り子さん。\n約束通り私たちはすぐに退散するわ。", "face": "l58c383e26d18"}, {"name": "ブレリア", "text": "……いいえ、それには及びません。\nあなたも、スケート教室の講師をしませんか？", "face": "u1117a1"}, {"name": "メカゴブリンクイーン", "text": "冗談はよしてちょうだい。\n私とあなたは相容れぬ存在なのよ？\nそもそも誰が私に教えを乞いたいと──", "face": "l58c383e26d18"}, {"name": "メープル", "text": "はいはーい！　さっきの大技、教えてほしいなっ！", "face": "u370"}, {"name": "ミネット", "text": "ミネットもですー！", "face": "u749"}, {"name": "ブレリア", "text": "ふふっ、あれだけの超絶技巧を披露したのです。\n子供たちもクイーンの演技に夢中みたいですわね。", "face": "u1117a1"}, {"name": "メカゴブリンクイーン", "text": "……でも、だからって、ねぇ？", "face": "l58c383e26d18"}, {"name": "リーナ", "text": "あっ、あの……その、\n私もメカゴブリンクイーン様に、\nスケートを、教えてほしくて……。", "face": "u521"}, {"name": "ブレリア", "text": "ほら、リーナさんもこう言っていることですし♪", "face": "u1117a1"}, {"name": "メカゴブリンクイーン", "text": "…………ハァ、仕方ないわね。\n怪我にだけは気を付けるのよぉ？", "face": "l58c383e26d18"}, {"name": "シュシュ", "text": "はーい！", "face": "u656"}, {"name": "ブレリア", "text": "──これにて一件落着、ですわね？", "face": "u1117a1"}]}], "active": true}