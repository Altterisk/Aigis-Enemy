{"quest_id": 7777, "name": "アイス・ダンス・バトル", "description": "メカゴブリンクイーンとスケートリンクの\n使用権を賭けて熾烈な戦いが始まる！\n＜特定のタイミングで吹雪が発生＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "聖樹の森とおかしな家の魔女", "event_category": "History", "mission_id": 920188, "map_no": 4646, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["クリスマス", "アーマー", "機械"], "hp": 90000, "attack": 950, "base_hp": 90000, "base_attack": 950, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 240, "attack_speed": 80, "attack_interval": 81, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2140656, "race_id": 9, "special_effect_id": 1180, "change_to": 1, "missile_id": 26, "master_id": 35469, "global_id": 9086, "ranged": true, "to_global_id": 9085, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["クリスマス", "アーマー", "機械"], "hp": 90000, "attack": 950, "base_hp": 90000, "base_attack": 950, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 240, "attack_wait": 60, "attack_interval": 191, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2140624, "race_id": 9, "special_effect_id": 1181, "missile_id": 26, "master_id": 35468, "global_id": 9085, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 8}, {"enemy_id": 4, "source": "local", "count": 13, "form_count": 3, "hp": 1300, "attack