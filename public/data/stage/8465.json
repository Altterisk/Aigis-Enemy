{"quest_id": 8465, "name": "叶えられた願い", "description": "ついに鋼の都の上層へ辿り着く王子一行。\n殺人者ザ・リッパーの凶行を阻止せよ！！\n＜特定のタイミングで霧が発生＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで霧が発生"], "event": "スティールシティ・マーダーズ", "event_category": "History", "mission_id": 920225, "map_no": 9292, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 128000, "attack": 2650, "base_hp": 128000, "base_attack": 2650, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 480, "attack_speed": 1, "attack_wait": 1, "attack_interval": 27, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2158448, "race_id": 16, "special_effect_id": 64, "change_to": 1, "change_condition": 2, "missile_id": 1214, "missile": {"speed": 10.0}, "master_id": 38486, "global_id": 12103, "ranged": true, "to_condition": 2, "to_global_id": 12104, "commands": {"raw": "DoEnemy_RegistCommand(\"OnModeChanged\", \"SetStageFlag(0, 1); \nCallEvent(2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2200,2201,2202,2203,2204);\nDoEnemy_RemoveCommand( \"OnModeChanged\" );\");", "sets_flags": [[0, 1]], "on_mode_changed": true}, "route_behaviour": {"transforms": [{"flag": 1, "val": 1, "to": 38489}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 147000, "attack": 2650, "base_hp": 147000, "base_attack": 2650, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 25, "attack_interval": 91, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2158464, "race_id": 16, "special_effect_id": 1982, "change_to": 4, "change_condition": 1, "missile_id": 1214, "missile": {"speed": 10.0}, "master_id": 38487, "global_id": 12104, "ranged": true, "from_condition": 2, "variants": [{"hp": 147000, "attack": 4000, "base_hp": 147000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 1, "attack_wait": 5, "attack_interval": 52, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2158480, "race_id": 16, "special_effect_id": 1980, "master_id": 38488, "global_id": 12105}]}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2097200, "special_effect_id": 902, "master_id": 36265, "global_id": 9882, "route_behaviour": {"reroutes": ["Route=998"]}, "spawn_sec": 1}, {"enemy_id": 7, "source": "local", "count": 16, "form_count": 1, "hp": 2500, "attack": 350, "base_hp": 2500, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 60, "attack_interval": 235, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158400, "race_id": 16, "master_id": 38483, "global_id": 12100, "spawn_sec": 48}, {"enemy_id": 8, "source": "local", "count": 19, "form_count": 1, "hp": 3800, "attack": 550, "base_hp": 3800, "base_attack": 550, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 235, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158560, "race_id": 16, "master_id": 38495, "global_id": 12112, "spawn_sec": 107}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 1, "tags": ["スライム"], "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097456, "master_id": 10, "spawn_sec": 112}, {"enemy_id": 10, "source": "local", "count": 13, "form_count": 1, "tags": ["スライム"], "hp": 3300, "attack": 380, "base_hp": 3300, "base_attack": 380, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158496, "change_to": 10, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38491, "global_id": 12108, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 3300, "attack": 700, "base_hp": 3300, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158512, "master_id": 38492, "global_id": 12109}], "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 150}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "tags": ["スライム"], "hp": 1600, "attack": 300, "base_hp": 1600, "base_attack": 300, "damage_type": "magical", "armor_defense": 1600, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097296, "master_id": 22, "global_id": 21, "spawn_sec": 152}, {"enemy_id": 13, "source": "local", "count": 18, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 200, "attack_speed": 70, "attack_wait": 75, "attack_interval": 273, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158416, "race_id": 16, "master_id": 38484, "global_id": 12101, "spawn_sec": 156}, {"enemy_id": 14, "source": "local", "count": 9, "form_count": 1, "tags": ["スライム"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100576, "master_id": 269, "global_id": 268, "spawn_sec": 172}, {"enemy_id": 15, "source": "local", "count": 15, "form_count": 1, "tags": ["スライム"], "hp": 8500, "attack": 580, "base_hp": 8500, "base_attack": 580, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158528, "change_to": 15, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38493, "global_id": 12110, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 8500, "attack": 1050, "base_hp": 8500, "base_attack": 1050, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158544, "master_id": 38494, "global_id": 12111}], "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 192}], "popups": ["覚醒したザ・リッパーは、\n範囲内の味方ユニット三体に\n二連射の遠距離攻撃を行います。\nまたブロックされている間は、\n二連撃の近接攻撃を行い\n攻撃のたびにHPを回復します。\n一定時間経過すると\n回復効果は無くなります。", " 　　　悪天候：霧\n\n・敵味方の『射程』減少\n・一部の味方は影響を受けない"], "dialogue": [{"trigger": "start", "lines": [{"name": "ザ・リッパー", "text": "――どうしてだ。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "黒き導きよ、俺に目覚めを与えた輝きよ、\nどうしてあの日から、返事をしてくれない。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "もっと力をくれよ。\n死ぬまで死ぬほど\n切り刻んでいいって言っただろうがよぉ！", "face": "l6219dcd0cdc2"}, {"name": "囚人", "text": "――あ、あの、リッパー様……。", "face": "lc095775b72d4"}, {"name": "ザ・リッパー", "text": "あァ！？", "face": "l6219dcd0cdc2"}, {"name": "囚人", "text": "ひぃぃっ！？\nあ、あのっ、王国軍が……。", "face": "lc095775b72d4"}, {"name": "ザ・リッパー", "text": "へへっ、来たか……。\n先に街の連中を\n切り刻もうかと思っていたが、存外早い到着だ。", "face": "l6219dcd0cdc2"}, {"name": "アイゼルフ", "text": "――王子様、いました！\nザ・リッパーです！　すぐそこにいます！", "face": "u2343a1"}, {"name": "ザ・リッパー", "text": "よぉ、門を突破したとは聞いてないが、\nいったいどこから侵入したんだ？", "face": "l6219dcd0cdc2"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ザ・リッパー", "text": "へっ、悪党と話すつもりはないってか。\n王族ってのはいつだって高慢だよなァ。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "なぁ王子サマよ、お前に願いはあるか？", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "俺は、黒き導きの音色に、願いを叶えてもらった。\nずっとずっと、心の中で育ててきた、\nでっかい夢を叶える力をもらったんだよ。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "誰も俺を救ってくれなかった。\nただ、俺の願いだけが、俺を救ってくれた。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "さぁ王子ィ、殺し合おうか。\n王族の血の色、どんな色なのか見せてくれよなァ！！", "face": "l6219dcd0cdc2"}, {"name": "アイリーン", "text": "王子、この「霧」の中では視界が通りません。\n敵味方共に、\n長射程の攻撃は狙いがつけにくくなるはずです。", "face": "u315"}, {"name": "アイリーン", "text": "敵戦力だけでなく、\nこちらの兵への指示にも注意を払ってください。", "face": "u315"}]}, {"trigger": "enemy_spawn", "enemy_id": 1, "lines": [{"name": "ザ・リッパー", "text": "――なァ王子サマよ、\nお前、神を殺して、世界を救ったんだろ？", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "不思議だろ、そんな英雄サマ相手に、\n俺みたいな名も無い小悪党が噛みつくのがよォ。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "何故か分かるか？", "face": "l6219dcd0cdc2"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ザ・リッパー", "text": "お前じゃ救えないからだよ。\nお前の手は届かない。\n俺を救ってくれたのは、俺のでっかい夢だけだ。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "願いってのはなァ、叶うもんなんだよ。\n願って、想って、磨き続ければさァ！！", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "見せてやるよ、俺がもらった力を。\n願いを叶えてくれた、この力を。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "さぁ！　世界中の愛しい犠牲者ども！\n俺に死ぬまで死ぬほど切り刻まれてくれよォ！！", "face": "l6219dcd0cdc2"}, {"name": "ミスリア", "text": "わっわっ、何あの赤いナイフ！？", "face": "u846"}, {"name": "アキレア", "text": "あァ？　ミスリア、あれ知ってんのか？", "face": "u1972a1"}, {"name": "ミスリア", "text": "全然知らない！\nでも……魔剣じゃないのに、\n何だか変な力が宿ってるみたい！", "face": "u846"}, {"name": "リヴン", "text": "なるほど、あれは我が血族の真似事だろう。\n切り裂いた者の命を啜り、己の命に変えるものだ。", "face": "u1619a1"}, {"name": "アキレア", "text": "近付けば生命力を吸収されて、\n距離を取ればナイフが飛んでくるんだろ？\nおい頭脳労働担当！　何か策出せ！", "face": "u1972a1"}, {"name": "ユリクセス", "text": "はぁ……あの力の根源も分からないというのに……。\nしかし、対処法はある。\n接近戦を避け、遠距離攻撃もどうにかするには――", "face": "u2193a1"}, {"name": "アイシャ", "text": "……うん。それしかない、か。\n以前は隕石すら受け止めた\n逸材が複数いるのが王国軍だし。", "face": "u181"}, {"name": "ユリクセス", "text": "軍師の意見が一致したな、\nよし、王子！　体力自慢の兵を出せ！\n三人もいれば飛んでくるナイフもさばききれる！", "face": "u2193a1"}, {"name": "アイシャ", "text": "その隙に遠距離攻撃を叩き込んで。\nこの戦法なら、\n接近戦も、飛来するナイフも避けられる！", "face": "u181"}]}, {"trigger": "end", "lines": [{"name": "ザ・リッパー", "text": "……あァ……気持ちいい……。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "切られるのもイイな……。\nなんだ、犠牲者どものこと、少しは哀れに思ってたが、\n血がどくどく流れ出すの、最高じゃねぇかよォ。", "face": "l6219dcd0cdc2"}, {"name": "王子", "text": "……ザ・リッパー。", "face": "u1"}, {"name": "ザ・リッパー", "text": "王子サマよぉ、最期のショウがお前相手で、\n本当に良かったぜェ……。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "だが、お前に俺は救えない。\n王子サマよぉ、お前にも救えないものがあるんだよ。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "最後はどう死のうかなァ！\n今まで殺した奴の名前を順番に――\nいや、ひとりも覚えてねぇや！", "face": "l6219dcd0cdc2"}, {"name": "アンナ", "text": "……王子、耳を傾けないでください。\n王子が気に病む必要は――"}, {"name": "アイゼルフ", "text": "――ん……何でしょう、\n何だか周囲が暗くなってきたような。", "face": "u2343a1"}]}, {"trigger": "end", "lines": [{"name": "ピッキー", "text": "これは……霧……？\n排煙にしても、こんなに暗くなるのは……。", "face": "u671"}, {"name": "ザ・リッパー", "text": "――あ、ああ。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "聞こえた。", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "だが黒き導きの音色じゃねぇ。\n誰だ、あんた何者だ！？", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "まぁいいや！　連れて行ってくれ！\n俺はもっと切り裂きたい！\n切って、切られて、鮮血を浴び続けたい！！", "face": "l6219dcd0cdc2"}, {"name": "ザ・リッパー", "text": "――契約するぜ、あんたと！！", "face": "l6219dcd0cdc2"}, {"name": "ユリクセス", "text": "くっ……誰と話している！？\nアキレア！　リッパーを押さえろ！", "face": "u2193a1"}, {"name": "アキレア", "text": "ちっ、遅かった！\nリッパーの野郎、どこに消えた！？", "face": "u1972a1"}]}, {"trigger": "end", "lines": [{"name": "アイゼルフ", "text": "……あっ、霧が晴れて……あれ？\nリッパーがいません！", "face": "u2343a1"}, {"name": "アイシャ", "text": "やられた……。\nでも、この周囲は王国軍が制圧してるはず。\nいったいどんな手段で……。", "face": "u181"}, {"name": "アンナ", "text": "ひとまず、負傷者の救助を進めましょう。\n同時に斥候部隊は周辺の捜索を。"}, {"name": "ユリクセス", "text": "またひとつ、悩みの種が増えたな……。", "face": "u2193a1"}]}], "active": true}