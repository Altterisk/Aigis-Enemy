"local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 5, "missile_id": 6, "master_id": 32304, "global_id": 5923, "from_condition": 0}, {"enemy_id": 8, "source": "local", "count": 44, "form_index": 0, "form_count": 1, "tags": ["アーマー", "バレンタイン", "チョコレート騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132720, "master_id": 34530, "global_id": 8147, "spawn_sec": 27}], "dialogue": [{"trigger": "start", "lines": [{"name": "警備兵", "text": "な、なんだこいつらは！\nやめろ、そのチョコは娘が持たせてくれた――ぐわー！！", "face": "lce2aca21906e"}, {"name": "チョコレート騎士", "text": "ムッ、これは誤回収か？\nモテではなく、娘さんからの贈り物だったか。", "face": "l9b0d03368f5f"}, {"name": "チョコ騎士団長", "text": "だが、モテる者たちは、\nあらゆるルートでチョコを贈られるはず。\n僅かな可能性も摘むべく、すべてのチョコを回収するのだ。", "face": "lcf3df6b5c323"}, {"name": "チョコレート騎士", "text": "はっ、騎士団長殿！\nさぁ、この砦には商隊がいるはずだ。\n荷馬車からもチョコを回収するぞ！", "face": "l9b0d03368f5f"}, {"name": "ポミエ", "text": "チョコをー！　返しなさーい！\n嫌がらせばかりしてるからモテないんですよー！", "face": "u1422a1"}, {"name": "チョコ騎士団長", "text": "くっ……心無い言葉が、\nワガハイたちの繊細なチョコハートを抉ってくる……。", "face": "lcf3df6b5c323"}, {"name": "チョコ騎士団長", "text": "だが、ワガハイたちに命を吹き込んでくださった、\n大いなる創造主の方々のため、\nどれだけ憎まれようと、チョコ回収をやり遂げねば……！", "face": "lcf3df6b5c323"}, {"name": "ポミエ", "text": "……大いなる、創造主の方々？\nもしかして、誰かに命じられてこんなことを？", "face": "u1422a1"}, {"name": "チョコ騎士団長", "text": "答える必要はないだろう。\n未だカカオ濃度が十分ではないが、\n強者が相手だというのなら、我が剣技を見せるしかあるまい。", "face": "lcf3df6b5c323"}, {"name": "チョコレート騎士", "text": "おぉ、もしや騎士団長殿の、\n板チョコ流星剣を、この目で見られる日がくるとは……！", "face": "l9b0d03368f5f"}, {"name": "ポミエ", "text": "い、いたちょこ、りゅうせいけん！？\nいったい何をするつもりなんですか！？", "face": "u1422a1"}, {"name": "ソフィー", "text": "聞いても答えてはくれないでしょう。\n王子さま、チョコ騎士団が来ます。\n迎撃の指揮をお願いしますね。", "face": "u746"}]}, {"trigger": "end", "lines": [{"name": "チョコ騎士団長", "text": "ほう……強い……。\nモテオーラが、その武技を\n研ぎ澄ましているとでも言うのか……？", "face": "lcf3df6b5c323"}, {"name": "チョコ騎士団長", "text": "団員に告げよ、このモテ軍と戦うのは危険だ。\n今はチョコの回収に全力を注ぐのだ、と。", "face": "lcf3df6b5c323"}, {"name": "チョコレート騎士", "text": "はっ！　団長殿！\n――全軍撤退！　次なるチョコ襲撃地点へ向かえ！", "face": "l9b0d03368f5f"}, {"name": "チョコ従士", "text": "すべてのモテる者に鉄槌を！\nすべてのチョコを回収するであります！", "face": "l9b0d03368f5f"}, {"name": "ポミエ", "text": "はぁ……はぁ……。\nいったいどこから、あんなに大量に湧いてくるんですかぁ。", "face": "u1422a1"}, {"name": "マーニー", "text": "倒しても倒してもキリがないですねぇ……。\nあっ、チョコが原料だから、\n壊れても復活できちゃったりするんでしょうか。", "face": "u745"}, {"name": "ポミエ", "text": "あぁっ！　確かに！？\n溶かして固めたら元通りですよね……。", "face": "u1422a1"}, {"name": "リーフ", "text": "ということは……。\n元凶を止めるしかないと……。", "face": "u747"}, {"name": "ポミエ", "text": "そういえば、大いなる創造主が\nなんとかって言ってましたよね。", "face": "u1422a1"}, {"name": "フローガ", "text": "なるほど、それならチョコ騎士団の魔力を追跡して、\n黒幕の位置を特定できるかもしれません。\nちょっと時間はかかるかもしれませんが……。", "face": "u878"}, {"name": "アンナ", "text": "では、我々はその間に、\nチョコ騎士団の勢力を少しでも削いでいきましょう。", "face": "ld160abf81d9d"}, {"name": "アンナ", "text": "王子、バレンタインの祝祭を守るため、\n奪われたチョコを取り戻しましょうね！"}]}], "map": {"image": "Map920172_4067", "w": 960, "h": 640, "spots": [{"k": "b", "x": 20, "y": 103}, {"k": "b", "x": 18, "y": 283}, {"k": "m", "x": 120, "y": 109, "id": 200}, {"k": "m", "x": 202, "y": 115, "id": 201}, {"k": "m", "x": 287, "y": 130, "id": 202}, {"k": "m", "x": 365, "y": 162, "id": 203}, {"k": "m", "x": 435, "y": 210, "id": 204}, {"k": "m", "x": 496, "y": 259, "id": 205}, {"k": "m", "x": 559, "y": 306, "id": 206}, {"k": "m", "x": 631, "y": 344, "id": 207}, {"k": "m", "x": 724, "y": 312, "id": 208}, {"k": "m", "x": 821, "y": 318, "id": 209}, {"k": "m", "x": 623, "y": 190, "id": 210}, {"k": "m", "x": 531, "y": 194, "id": 211}, {"k": "m", "x": 36