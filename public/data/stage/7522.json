{"quest_id": 7522, "name": "チョコ騎士団長の剣技", "description": "チョコ騎士団を追って砦に辿り着いた王子\nたちの前に、板チョコ流星剣なる剣技を\n使いこなすチョコ騎士団長が立ちはだかる。\n極級（★１獲得の目安：平均Lv25）", "event": "恋と欲望のチョコレートナイツ", "event_category": "History", "mission_id": 920172, "map_no": 4067, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 21, "form_index": 0, "form_count": 2, "tags": ["バレンタイン", "置物", "ステルス", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 10000, "attack": 2400, "base_hp": 10000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 87, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "pattern_id": 2132768, "special_effect_id": 949, "change_to": 1, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 34535, "global_id": 8152, "ranged": true, "to_condition": 0, "to_global_id": 8153, "route_behaviour": {"hold": {"routes": 21, "held": 21}, "transforms": [{"wait": -1}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["バレンタイン", "置物", "ステルス", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 10000, "attack": 2400, "base_hp": 10000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 88, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "pattern_id": 2132768, "special_effect_id": 230, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 34536, "global_id": 8153, "from_condition": 0}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アーマー", "バレンタイン", "チョコレート騎士団"], "hp": 17000, "attack": 1000, "base_hp": 17000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_range": 250, "attac