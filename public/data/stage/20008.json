eed": 50, "attack_wait": 30, "attack_interval": 173, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106992, "master_id": 40948, "spawn_sec": 240}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 120000, "attack": 5000, "base_hp": 120000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 800, "attack_speed": 120, "attack_wait": 10, "attack_interval": 221, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2127520, "race_id": 10, "master_id": 36422, "global_id": 10039, "spawn_sec": 240}, {"enemy_id": 17, "source": "local", "count": 10, "form_count": 1, "tags": ["アンデッド"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 21139, "global_id": 1433, "ranged": true, "spawn_sec": 242}, {"enemy_id": 18, "source": "local", "count": 8, "form_count": 1, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31059, "global_id": 4678, "ranged": true, "spawn_sec": 247}, {"enemy_id": 19, "source": "local", "count": 8, "form_count": 1, "tags": ["アンデッド"], "hp": 9500, "attack": 800, "base_hp": 9500, "base_attack": 800, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 21141, "global_id": 1435, "spawn_sec": 259}, {"enemy_id": 20, "source": "local", "count": 18, "form_count": 1, "tags": ["アンデッド"], "hp": 7800, "attack": 750, "base_hp": 7800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 40953, "spawn_sec": 265}, {"enemy_id": 21, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 27000, "attack": 900, "base_hp": 27000, "base_attack": 900, "damage_type": "physical", "armor_defense": 400, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102160, "master_id": 40954, "spawn_sec": 287}], "popups": ["浴衣姿のエターナーの攻撃は、\nアンデッド系の\n味方ユニットに対する\nダメージが80％アップします。", "浴衣姿のリッチがいる間は、\n全てのアンデッドの\n攻撃と防御がアップします。", "三味線の付喪神がいる間、\n敵の妖怪の\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "エターナー", "text": "――なんとか夏祭りに間に合ったな。", "face": "u2864a1"}, {"name": "マータン", "text": "これで開催できなかったら目も当てられないからな。\nどうにかなってマータンも一安心だ。", "face": "u2862a1"}, {"name": "リッチ", "text": "マータン殿たちもありがとうございました。\n雪枝の皆さまが手伝ってくれて助かりましたぞ。", "face": "u2863a1"}, {"name": "マータン", "text": "里のみんなは責任を果たしただけだ。\nだから感謝されるわけにはいかない。", "face": "u2862a1"}, {"name": "マータン", "text": "むしろ、これで許してくれて感謝している。\n本当にありがとう、ぺこり。", "face": "u2862a1"}, {"name": "エターナー", "text": "王国と里の親睦を深める、か。\n結果だけを見ると大成功だったのかもな。", "face": "u2864a1"}, {"name": "リッチ", "text": "ぶつかることで強固になる絆というのも、\nこの世には確かにありますからなぁ。", "face": "u2863a1"}, {"name": "リッチ", "text": "まぁ、真面目な話はこれくらいでいいでしょう。\n今は夏祭りの時間ですからな。", "face": "u2863a1"}, {"name": "エターナー", "text": "では我々も祭りに本格参戦するとしようか。\nたくさん準備を頑張ったのだから、その分楽しまなくては。", "face": "u2864a1"}, {"name": "マータン", "text": "そうだな！\nところで、これからなにがはじまるんだ？\nみんなやぐらの近くに集まってるみたいだが。", "face": "u2862a1"}, {"name": "リッチ", "text": "模擬戦音頭ですぞ。", "face": "u2863a1"}, {"name": "マータン", "text": "模擬戦音頭……？", "face": "u2862a1"}, {"name": "リッチ", "text": "みんなで模擬戦をして祭りを盛り上げるみたいな、\nそんな感じのあれらしいですぞ。", "face": "u2863a1"}, {"name": "マータン", "text": "そうか！　王国はやばいな！", "face": "u2862a1"}, {"name": "エターナー", "text": "違いないな。", "face": "u2864a1"}, {"name": "リッチ", "text": "……おや？　会場になにか、見知らぬ者がいるような……？", "face": "u2863a1"}, {"name": "妖怪", "text": "――おお、これが王国の夏祭りか！\n中々に賑やかじゃあないか！", "face": "lc3cdb546668d"}, {"name": "エターナー", "text": "妖怪……！？　まさか、クダギツネの仲間か！？", "face": "u2864a1"}, {"name": "妖怪", "text": "クダギツネ？　いやいや違う違う。\n俺たちはあれとは関係ない、普通の妖怪たちだとも。", "face": "lc3cdb546668d"}, {"name": "妖怪", "text": "ただまぁ、クダギツネの奴が迷惑かけて悪かったなぁ。\n同じ妖怪として謝らせてもらうぜ。", "face": "lc3cdb546668d"}, {"name": "エターナー", "text": "そ、そうなのか……。\nいや、身構えてしまって悪かった。", "face": "u2864a1"}, {"name": "リッチ", "text": "ところで、無関係の妖怪の皆さまはどうしてここに？", "face": "u2863a1"}, {"name": "妖怪", "text": "なに、俺たちは祭りが好きでなぁ。\nできれば参加させてもらいてぇって思ってよぉ。", "face": "lc3cdb546668d"}, {"name": "マータン", "text": "なんかいいやつそうだし、\n参加してもいいんじゃないのか？", "face": "u2862a1"}, {"name": "リッチ", "text": "そうですなぁ……。\n害意がないのなら追い返す必要もありませんか。", "face": "u2863a1"}, {"name": "リッチ", "text": "それに、そろそろ模擬戦音頭もはじまりますからな。\n大勢で戦うのは、さぞ楽しいことでしょう。", "face": "u2863a1"}, {"name": "妖怪", "text": "おお、ありがとうなお嬢ちゃんたち！\n模擬戦音頭とやらは知らねぇが、\n夏祭りを楽しませてもらうぜ！", "face": "lc3cdb546668d"}, {"name": "リッチ", "text": "では、妖怪も交えてはじめましょうか。\n賑やかな夏祭りを、楽しみますぞ。", "face": "u2863a1"}]}, {"trigger": "end", "lines": [{"name": "妖怪", "text": "すげぇ！　これが模擬戦音頭か！\n面白い祭りだなぁ！", "face": "lc3cdb546668d"}, {"name": "マータン", "text": "聞いたときはやばいと思ったが、\nいざやってみると楽しいな！", "face": "u2862a1"}, {"name": "エターナー", "text": "どうやら楽しんでもらえたみたいだな。", "face": "u2864a1"}, {"name": "妖怪", "text": "いやはや、参加させてくれてありがとうな！\nおかげで懐かしい気分になれたぜ！", "face": "lc3cdb546668d"}, {"name": "リッチ", "text": "懐かしい気分？", "face": "u2863a1"}, {"name": "妖怪", "text": "実は俺たち、大昔に祭りにまぜてもらったことがあってな。", "face": "lc3cdb546668d"}, {"name": "妖怪", "text": "今日の祭りが、あのときのそれとそっくりだったから、\nなんだか懐かしくて暖かい気分になったんだぜ！", "face": "lc3cdb546668d"}, {"name": "マータン", "text": "そっくりって……。\nその祭りでも模擬戦音頭とかやってたのか？", "face": "u2862a1"}, {"name": "妖怪", "text": "いやいや、こんなへんてこなのは初めてだよ。\nそもそも俺たちが参加した祭りは東の国のやつだし。", "face": "lc3cdb546668d"}, {"name": "マータン", "text": "なら、そっくりなんかじゃないのでは……？", "face": "u2862a1"}, {"name": "妖怪", "text": "確かにやってることとか、ここにいる人とか、\nそういうのは俺たちの祭りのそれとは全然違ぇよ。", "face": "lc3cdb546668d"}, {"name": "妖怪", "text": "でも、祭りは祭りだ。\n人が笑ってて、賑やかで、楽しげで……。\nそれは、おんなじだからよぉ。", "face": "lc3cdb546668d"}, {"name": "妖怪", "text": "だから、なんにも変わらないんだ。\nこれも俺たちの大好きな、いつもの祭りなんだよ。", "face": "lc3cdb546668d"}, {"name": "マータン", "text": "…………そうか。", "face": "u2862a1"}, {"name": "マータン", "text": "ああ……そうだよな。", "face": "u2862a1"}, {"name": "妖怪", "text": "じゃ、俺たちは屋台を回らせてもらうぜ！\n迷惑はかけねぇから、許してくれよな！", "face": "lc3cdb546668d"}, {"name": "リッチ", "text": "今更妖怪に怯える民は王国にはいませんぞ。\nなのでまぁ、よい夏祭りを。", "face": "u2863a1"}, {"name": "エターナー", "text": "では、私たちも行こうか。\n色々と買い食いするだろう？", "face": "u2864a1"}, {"name": "マータン", "text": "マータンはお腹ぺこぺこだ！\n王子からもらったお小遣いで豪遊するぞ！", "face": "u2862a1"}, {"name": "リッチ", "text": "いいですな、せっかくの機会ですし、\n私も羽目を外させてもらいましょうか。", "face": "u2863a1"}, {"name": "リッチ", "text": "ええ……みんなで一緒に、\n夏祭りを楽しみ尽くすとしましょう♪", "face": "u2863a1"}]}], "active": true}