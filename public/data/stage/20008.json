{"quest_id": 20008, "name": "祭りは祭り", "description": "夏祭り当日。賑やかな様子に誘われて\n祭りへやってきた妖怪たちも加わり、\nメインイベントの模擬戦音頭が始まる……！\n神級EX（★１獲得の目安：平均覚醒Lv25）", "event": "雪の枝に花火が咲く", "event_category": "Emergency", "mission_id": 200574, "map_no": 7469, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 512000, "attack": 2880, "base_hp": 512000, "base_attack": 2880, "damage_type": "physical", "armor_defense": 400, "magic_defense": 5, "attack_speed": 1, "attack_wait": 5, "attack_interval": 52, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171792, "race_id": 12, "special_effect_id": 621, "master_id": 40943}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "hp": 447000, "attack": 2500, "base_hp": 447000, "base_attack": 2500, "damage_type": "magical", "armor_defense": 350, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 60, "attack_interval": 191, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171952, "race_id": 16, "special_effect_id": 2488, "change_to": 2, "change_condition": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 40941, "ranged": true, "to_condition": 4, "to_ticks": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 447000, "attack": 4500, "base_hp": 447000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 90, "attack_interval": 251, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171952, "race_id": 16, "special_effect_id": 2489, "change_to": 1, "change_condition": 4, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 40942, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 432000, "attack": 2000, "base_hp": 432000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_range": 300, "attack_speed": 50, "attack_wait": 20, "attack_interval": 95, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171936, "special_effect_id": 2487, "missile_id": 6, "master_id": 40940, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 14000, "base_hp": 14000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 45, "attack_wait": 50, "attack_interval": 226, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2141520, "race_id": 4, "special_effect_id": 1211, "master_id": 35700, "global_id": 9317}, {"enemy_id": 6, "source": "local", "count": 10, "form_count": 1, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 40906, "spawn_sec": 154}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 1, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 40904, "spawn_sec": 154}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 6400, "attack": 460, "base_hp": 6400, "base_attack": 460, "damage_type": "phy