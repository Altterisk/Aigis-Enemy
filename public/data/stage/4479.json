, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 5, "source": "local", "count": 9, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 4}, {"enemy_id": 6, "source": "local", "count": 9, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 8}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 200, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104480, "race_id": 16, "missile_id": 6, "master_id": 536, "global_id": 535, "ranged": true, "spawn_sec": 97}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ようやく追い詰めました。", "face": "l1abcef41a141"}, {"name": "ケイティ", "text": "もう逃げられません！", "face": "u114"}, {"name": "レヴィ", "text": "おいつめたのは、こっちだよ……みんな今だよ。", "face": "u328"}, {"name": "ゴブリン", "text": "ギャギャッ……！\n……イマダ！　イマダ！", "face": "la13f277f1f6e"}, {"name": "兵士", "text": "弓兵を多数確認！", "face": "l33933de3794d"}, {"name": "フィリス", "text": "なっ……、待ち伏せか！", "face": "u40"}, {"name": "ゴブリンクイーン", "text": "……ウフフ。\nこんなにあっさりひっかかるなんてね。\n人間は相変わらず単純ねぇ。", "face": "l0cbd72e5092a"}, {"name": "ロイ", "text": "あれは……まさかゴブリンクイーンか！？", "face": "u11"}, {"name": "ゴブリンクイーン", "text": "あらご明察……さあレヴィ。\nワタシの術でアナタを更に強くしてあげる。\nママの眼を見なさい……。", "face": "l0cbd72e5092a"}, {"name": "レヴィ", "text": "あ、ぅッ……！　マ、マ……。\nうん。わたし、がんばるから……。\nもっと……がんばるからね！", "face": "u328"}, {"name": "フィリス", "text": "……！　これまで以上にっ、\n力が抜けていく感覚が強まってる……！\n剣が、こんなに重いだなんて……。", "face": "u40"}, {"name": "ミトラ", "text": "どうやらあのゴブリンクイーンってのが、\nレヴィを操っているようだ。\nこれですべての謎が解けたな。", "face": "u276"}, {"name": "アンナ", "text": "どういうことですか？", "face": "l1abcef41a141"}, {"name": "ミトラ", "text": "ゴブリンクイーンの催眠術によって、\nレヴィは自身の限界以上の能力を、\nむりやり引き出されているのさ。", "face": "u276"}, {"name": "ケイティ", "text": "そんな……。", "face": "u114"}, {"name": "ミトラ", "text": "あれ程の呪言を酷使させられちゃ術者の身体は\nすぐに摩耗するぞ。『呪い』の能力ってのは\n使い方を誤れば自らの命を削る諸刃だ。", "face": "u276"}, {"name": "フィリス", "text": "このままだとレヴィの命が危ないってこと？\n……なんて惨い。\n必ず報いを受けさせてやる！", "face": "u40"}, {"name": "アンナ", "text": "王子、急ぎ敵を倒しましょう！", "face": "l1abcef41a141"}]}, {"trigger": "end", "lines": [{"name": "レヴィ", "text": "……はぁ、はぁ……まだ……負けない。\nママは……わたしが、守る……。", "face": "u328"}, {"name": "兵士", "text": "敵陣、前線をさらに下げていきます！", "face": "l33933de3794d"}, {"name": "アンナ", "text": "罠の危険はありますが、レヴィさんが心配です。\n王子、追いかけましょう！", "face": "l1abcef41a141"}]}], "active": true}