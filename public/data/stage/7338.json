_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349, "spawn_sec": 77}, {"enemy_id": 7, "source": "local", "count": 10, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中", "アンデッド"], "hp": 2250, "attack": 370, "base_hp": 2250, "base_attack": 370, "damage_type": "physical", "armor_defense": 20, "magic_defense": 10, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2129264, "race_id": 7, "special_effect_id": 708, "missile_id": 232, "master_id": 33781, "global_id": 7398, "ranged": true, "spawn_sec": 83}, {"enemy_id": 8, "source": "local", "count": 10, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 60, "attack_range": 100, "attack_speed": 1, "attack_wait": 30, "attack_interval": 129, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124400, "race_id": 7, "special_effect_id": 220, "missile_id": 11, "master_id": 32767, "global_id": 6385, "ranged": true, "spawn_sec": 101}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中", "アンデッド", "置物"], "fixture": true, "hp": 36000, "attack": 900, "base_hp": 36000, "base_attack": 900, "damage_type": "physical", "armor_defense": 230, "magic_defense": 5, "attack_range": 80, "attack_speed": 1, "attack_wait": 180, "attack_interval": 404, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2129280, "race_id": 7, "special_effect_id": 242, "missile_id": 232, "master_id": 33800, "global_id": 7417, "ranged": true, "spawn_sec": 184}], "dialogue": [{"trigger": "battle", "at_sec": 7, "lines": [{"name": "メルアビス", "text": "──いい加減サメの相手も飽きたわ。\nそろそろ……決着ってのを付けましょうか。", "face": "u1252a1"}, {"name": "セーラ", "text": "そうですね……これ以上の日程の遅延は、\nメイドとして看過できるものではありません。", "face": "u1249a1"}, {"name": "アリーセ", "text": "本国の皆も心配していることでしょうし、\n手早く片付けて早く帰ってあげませんとね。", "face": "u1255a1"}, {"name": "マーガレット", "text": "私も孤児院の子どもたちが気がかりですわ、\n寂しがって泣いていないとよいのですが……。", "face": "u1254a1"}, {"name": "クリスタ", "text": "国の工房でくぐつの本格的なメンテナンスを……、\n潮と海に晒し過ぎると錆が気になってしまいます。", "face": "u1257a1"}, {"name": "クゥイル", "text": "グリフィンも海中は苦手みたいなんですよねぇ。", "face": "u1256a1"}, {"name": "アレイダ", "text": "(まだお兄ちゃんと一緒にいたいなーとか、\nこれはちょっと言えない雰囲気ですね……？)", "face": "u1251a1"}, {"name": "アレイダ", "text": "私も領地の皆が待っていますので、\n邪魔する相手は誰でも許しませんよ！", "face": "u1251a1"}, {"name": "ツキコ", "text": "ツキコは、王子さまを導くだけだけど、\nみんなのために、ちょっと頑張る、よ？", "face": "u1253a1"}, {"name": "アナトリア", "text": "全員、気合は十分みたいだねぇ……！\n最後の大一番だ、派手に行こうじゃないか！", "face": "u1250a1"}, {"name": "メルアビス", "text": "さあ王子、みんなに号令をお願い。\nここで全部、終わらせてやりましょう？", "face": "u1252a1"}]}, {"trigger": "end", "lines": [{"name": "メルアビス", "text": "一匹、取り逃しちゃったみたいね。\nまったく、逃げ足だけは速いんだから。", "face": "u1252a1"}, {"name": "アリーセ", "text": "しかし二度も返り討ちに遭った上で、\n群れは壊滅、支配下のアンデッドたちもほぼ全滅です。\nこれに懲りたならもう歯向かっては来ないでしょう。", "face": "u1255a1"}, {"name": "アナトリア", "text": "オークだったら喜び勇んで再戦を挑むんだけどねぇ。", "face": "u1250a1"}, {"name": "メルアビス", "text": "それはオークがおかしいのよ。本当に戦闘種族ね。", "face": "u1252a1"}, {"name": "アナトリア", "text": "そうかい？　どんなに強いやつが相手でも、\n絶対にへこたれない人間がすぐ近くにいるだろう？", "face": "u1250a1"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "メルアビス", "text": "まあ……確かにね──って、\n今回の場合それだと困るって言ってんの！\nほら、みんなさっさと船に戻るわよ。", "face": "u1252a1"}, {"name": "メルアビス", "text": "──はぁ、サメはもうこりごりね。", "face": "u1252a1"}]}], "active": true}