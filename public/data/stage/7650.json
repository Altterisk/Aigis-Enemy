142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132208, "race_id": 2, "master_id": 34429, "global_id": 8046, "to_global_id": 8048}, {"enemy_id": 5, "source": "local", "count": 1, "level": 80, "form_index": 3, "form_count": 4, "tags": ["水棲"], "hp": 13000, "attack": 750, "base_hp": 13000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132240, "race_id": 2, "change_to": 1, "master_id": 34431, "global_id": 8048}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "hp": 18000, "base_hp": 18000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 76, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137648, "race_id": 2, "special_effect_id": 232, "change_to": 11, "change_condition": 4, "missile_id": 476, "master_id": 34986, "global_id": 8603, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 8604, "spawn_sec": 108}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137664, "race_id": 2, "master_id": 34987, "global_id": 8604, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 2, "source": "local", "count": 1, "level": 80, "form_count": 2, "tags": ["水棲"], "hp": 13000, "attack": 750, "base_hp": 13000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132208, "race_id": 2, "master_id": 34429, "global_id": 8046, "to_global_id": 8048, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 126}, {"enemy_id": 2, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 13000, "attack": 750, "base_hp": 13000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132240, "race_id": 2, "change_to": 1, "master_id": 34431, "global_id": 8048}], "popups": ["ドラコラプトルは味方ユニットを\n発見すると、咆哮を行います。\n咆哮後、移動速度が上昇します。", "ドラコトプスは味方ユニットを\n発見すると、咆哮を行います。\n咆哮後、移動速度が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーヴ", "text": "――太古の生命が息づく、幻の孤島。\n嵐の海をこえ、海賊の襲撃をやり過ごし、\n我々王国軍調査隊が砂浜で見たものとは！？　っと。", "face": "u454"}, {"name": "レオーネ", "text": "わっ、噂のレーヴちゃん日誌だ！\nすごいすごい！　もうスケッチもしてある！", "face": "u1523a1"}, {"name": "レーヴ", "text": "地図にも載っていない幻の島ですからね！\nぜひとも記録を残しておこうと思いまして。", "face": "u454"}, {"name": "清源妙道真君", "text": "記録をこまめに付けるのは良い習慣ですね。\n最近の仙人たちは、\nそういった基本ができていない者も多く――", "face": "u1527a1"}, {"name": "ヘカティエ", "text": "あら、お小言が過ぎると\n弟子や新人に嫌われるわよ？", "face": "u1526a1"}, {"name": "清源妙道真君", "text": "そのままお返ししますよ、亜神殿。\nというか、私にやけにつっかかりますね？", "face": "u1527a1"}, {"name": "ヘカティエ", "text": "ふふ、あなたの気にし過ぎじゃないかしら？\n今後のためにも、\n今から善行は積んでおいた方がいいわよ？", "face": "u1526a1"}, {"name": "清源妙道真君", "text": "太公望みたいなことを言いますね……！！\n私はよかれと思ってお説教をしているんです！", "face": "u1527a1"}, {"name": "パトリシア", "text": "（……このふたり、よく喧嘩してますよねぇ。\nよっぽど反りが合わないんでしょうか？）", "face": "u1532a1"}, {"name": "ハリナ", "text": "（自分を客観視しているようで恥ずかしいのだろう。\n似た者同士、同類嫌悪、そんなところか）", "face": "u1525a1"}, {"name": "マリカ", "text": "（こういうふたりに限って、\nちょっとしたキッカケで大親友になったりするんですよ？）", "face": "u1531a1"}, {"name": "パトリシア", "text": "（なるほどぉ……奥深い……。\n女の友情って難しいですねぇ）", "face": "u1532a1"}, {"name": "マリカ", "text": "んっ、難しいも何も、\nパトリシアには私がいるでしょうがー！\nこのっ、このこのーっ！", "face": "u1531a1"}, {"name": "パトリシア", "text": "きゃぁあっ！？\nたすっ、助けてください～！？", "face": "u1532a1"}, {"name": "清源妙道真君", "text": "…………何をしているのでしょう、彼女らは。", "face": "u1527a1"}, {"name": "ヘカティエ", "text": "さぁ……？\nそれより、この島の探索が先じゃない？", "face": "u1526a1"}, {"name": "ハツネ", "text": "――ふぅ、というわけでちょっと見てきました。\n見てきたんです、けどぉ……えっとぉ……。", "face": "u1530a1"}, {"name": "アルティア", "text": "……私も一緒に見てきたのですが、\nなんというのか、報告しにくくてですね。", "face": "u1524a1"}, {"name": "アルティア", "text": "王子、端的に言えば、\nここは本当に古代生物たちの島だったようなのです。", "face": "u1524a1"}, {"name": "アンナ", "text": "……あ、あれは、ドラコラプトルに、ドラコリザード！？\n王子、大変です！　急いで戦闘準備をお願いします！"}]}, {"trigger": "battle", "at_sec": 110, "lines": [{"name": "ハツネ", "text": "わぁっ、角が３本も生えた恐竜さんですよ！", "face": "u1530a1"}, {"name": "フェリシア", "text": "あぁ、古代生物図鑑で見たことがあるわ。\nあれはドラコトプス、角が特徴的な草食恐竜ね。", "face": "u1394a1"}, {"name": "ハツネ", "text": "そうしょく……ということは\nおとなしい子なんですね！\nわーい、なでなでしに――", "face": "u1530a1"}, {"name": "フェリシア", "text": "主食は草だけれど、縄張り意識が極めて強く、\n侵入者には容赦ない突撃をするし、\n走り出したら止まらないらしいわよ。", "face": "u1394a1"}, {"name": "ハツネ", "text": "なでなでストップ！　ハツネ戻りますぅぅぅ！！", "face": "u1530a1"}, {"name": "アルティア", "text": "つまり可能なら近付かず、\n遠距離から仕留めた方が良さそうということですね。\n王子、遠距離戦の得意な者に指示をお願いします！", "face": "u1524a1"}]}, {"trigger": "end", "lines": [{"name": "レオーネ", "text": "ふぅ……なんとかなったねぇ……。", "face": "u1523a1"}, {"name": "デューオ", "text": "太古の生命が息づく島……。\nまさかそのまま、恐竜の島だとはねぇ。", "face": "u594"}, {"name": "レオーネ", "text": "グルメジャングルでも遭遇したけど、\nやっぱり恐竜って強いしカッコイイよねぇ。", "face": "u1523a1"}, {"name": "スリー", "text": "――そう、恐竜はクール＆ミステリアス……。\n漢のロマンと乙女のトキメキ！\n見てヨシ、食べてヨシ、売ってヨシだぜ！！", "face": "l72f964fbb940"}, {"name": "レオーネ", "text": "なっ……もう追いついてきたぁ！？", "face": "u1523a1"}, {"name": "スリー", "text": "オーマイハニー。\nお嬢さんのためなら嵐の海も、\n渦潮も落雷も何のその、遅ればせながら到着だァ！！", "face": "l72f964fbb940"}, {"name": "アイリーン", "text": "……はぁ。\nあなたは昔から変わりませんね。\nそれで、今回はどんな悪事を働くつもりなのですか。", "face": "u315"}, {"name": "スリー", "text": "あ、あ、アイリーンお嬢がァ！\nおい聞いたかトロワ！\n丁寧語しゃべってるぜェ……！？", "face": "l72f964fbb940"}, {"name": "トロワ", "text": "デスマス！　デスマス！", "face": "ld77cc91b0683"}, {"name": "アイリーン", "text": "…………。", "face": "u315"}, {"name": "スリー", "text": "ひょぉー！！\n懐かしいぜその視線！　闇ギルドを思い出すッ！", "face": "l72f964fbb940"}, {"name": "レオーネ", "text": "アイリーンさん、あいつと知り合いなの？", "face": "u1523a1"}, {"name": "アイリーン", "text": "えぇ、ただの昔なじみですが。\nしかし、面倒な男に絡まれましたね……。", "face": "u315"}, {"name": "アイリーン", "text": "スリーは根っからの海賊気質。\nロマンと冒険と、富と名声が大好物で、\nそのためなら一切の手段を選ばない男なのです。", "face": "u315"}, {"name": "スリー", "text": "そのとおりだぜ、アイリーン……。\nだが！　漢に生まれた以上！\nロマンと冒険からは逃げられねェんだなァ！！", "face": "l72f964fbb940"}, {"name": "トロワ", "text": "ニゲラレナイ！　ニガサナイ！", "face": "ld77cc91b0683"}, {"name": "スリー", "text": "そういうわけだ、\nこの島の恐竜は、根こそぎオレたちがいただくぜェ！！", "face": "l72f964fbb940"}]}], "active": true}