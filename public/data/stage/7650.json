{"quest_id": 7650, "name": "太古の生命が息づく孤島", "description": "遂に伝説の孤島に辿り着いた王子たち。\n一行は島に潜む驚くべき脅威を目撃する！！\n\n上級（★１獲得の目安：平均Lv10）", "event": "幻のシャークアイランド", "event_category": "History", "mission_id": 920179, "map_no": 4108, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "level": 80, "form_count": 2, "tags": ["水棲"], "hp": 13000, "attack": 750, "base_hp": 13000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132240, "race_id": 2, "change_to": 1, "master_id": 34431, "global_id": 8048, "to_global_id": 8046, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 1, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 13000, "attack": 750, "base_hp": 13000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132208, "race_id": 2, "master_id": 34429, "global_id": 8046}, {"enemy_id": 3, "source": "local", "count": 12, "level": 80, "form_count": 2, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123904, "race_id": 2, "special_effect_id": 232, "change_to": 3, "change_condition": 4, "missile_id": 476, "master_id": 32700, "global_id": 6318, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6319, "spawn_sec": 4}, 