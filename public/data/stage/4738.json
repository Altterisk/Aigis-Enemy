efense": 40, "attack_range": 160, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099504, "race_id": 4, "change_to": 5, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 106, "global_id": 105, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 106, "spawn_sec": 96}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 60, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 9, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 1250, "base_hp": 10000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 650, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099360, "race_id": 4, "master_id": 104, "global_id": 103, "spawn_sec": 130}], "dialogue": [{"trigger": "start", "lines": [{"name": "シノ", "text": "ついに見つけたぞ……酒呑童子。\n今こそ、父の無念、晴らさせてもらう……。", "face": "u403"}, {"name": "酒呑童子", "text": "父の無念、だとぉ？\n……その妖気は……そうか！？　\nお前、ぬらりひょんの娘だな。", "face": "ld252d9e10d35"}, {"name": "酒呑童子", "text": "ったく、妖怪ってのは何奴も此奴も馬鹿ばっかりだぜ。\n俺に敵うわきゃねえのに正面からやってくるとはよ……。\nお前もあのクソジジイ同様ぶち殺して――", "face": "ld252d9e10d35"}, {"name": "シノ", "text": "――黙れ、鬼風情が……。", "face": "u403"}, {"name": "酒呑童子", "text": "なッ！？　奴の姿が見えねぇ！？\n気配もない……。\n一体どういう――", "face": "ld252d9e10d35"}, {"name": "シノ", "text": "……さらばだ。", "face": "u403"}, {"name": "酒呑童子", "text": "グ……ァ……ァァ……。\nい、いつの間に……俺の懐に……。", "face": "ld252d9e10d35"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "シノさん！！\n……よかった、どうやら無事のようですね。"}, {"name": "ヒエン", "text": "ん……！？\nシノ殿の足下に転がっているのは……ま、まさか！", "face": "u112"}, {"name": "シノ", "text": "……先行してしまい申し訳ありません、王子。\nですが、この通り酒呑童子の首級は取りました。", "face": "u403"}, {"name": "シノ", "text": "後は、鬼の残党を退治すれば終わりです。\n王子、どうか最後まで貴方の力をお貸し下さい！", "face": "u403"}, {"name": "酒呑童子の首", "text": "…………。", "face": "le5075654c776"}]}, {"trigger": "battle", "at_sec": 120, "lines": [{"name": "酒呑童子の首", "text": "くっくっくっ……。", "face": "le5075654c776"}, {"name": "酒呑童子の首", "text": "首を落とした程度で、\n俺を殺したつもりかぁぁぁッ！？", "face": "le5075654c776"}, {"name": "アンナ", "text": "ヒッ……！\nく、首が……酒呑童子の首が、喋っています……！", "face": "l05dac6b81758"}, {"name": "酒呑童子の首", "text": "お前らァ……絶対に許さんぞぉぉぉぉッ……！！", "face": "le5075654c776"}]}, {"trigger": "end", "lines": [{"name": "酒呑童子の首", "text": "チクショウ……。\nやはり身体と切り離されたままでは、\n本気は出せそうにないぜ……。", "face": "le5075654c776"}, {"name": "酒呑童子の首", "text": "仕方ねぇ……。\nよく聞け、四天王達よッ！　ここは一度退くぞ！　", "face": "le5075654c776"}, {"name": "重水の四天王", "text": "は、はいィッ、酒呑童子様！\nた、ただちに撤退いたします！", "face": "la79444c5489c"}, {"name": "酒呑童子の首", "text": "おいっ！！　馬鹿野郎ッ！！\n俺の首も持って行かんかァッ！\nこちとら今は身体がねぇんだ、それぐらい察しろ！", "face": "le5075654c776"}, {"name": "重水の四天王", "text": "ヒ、ヒィィッ……！？\nも、申し訳ありません！！", "face": "la79444c5489c"}, {"name": "アンナ", "text": "鬼たちが退いていきます……。\n何とか、勝てたようですね。"}, {"name": "シノ", "text": "まさか首だけでも生きながらえる事が出来るとは……。\n奴は、不死身だとでもいうのですか……？", "face": "u403"}, {"name": "ケイティ", "text": "致命傷を与えたのは間違いないと思います。\n身体のみの酒呑童子は明らかに弱っていましたから……。\nそれに、首だけとなった今では何もできないでしょう。", "face": "u114"}, {"name": "シノ", "text": "だといいのですが……。\n", "face": "u403"}, {"name": "シノの配下の河童", "text": "シノ様ー！　血判状、だいぶ集まりましたぜぇ！\nこれだけの数の仲間がいりゃあ百鬼夜行も作れますぜ！！", "face": "l29a109438aea"}, {"name": "シノ", "text": "おぉ、本当か……！\nここまでこれたのも、すべて王子のおかげです。\n本当に、感謝の言葉もありません……。", "face": "u403"}, {"name": "シノ", "text": "人間と妖怪の隔たりはあるにせよ、恩義に報いぬは\n一族の恥……。王子、今後なにか困ったことがあれば、\n是非とも私を頼って下さい。", "face": "u403"}, {"name": "シノ", "text": "それでは皆さん。\n我ら妖怪は在るべき場所へと帰ります。\n今度は、妖怪の総大将としてお目にかかりましょう！", "face": "u403"}]}], "map": {"image": "Map920077_3749", "w": 960, "h": 640, "spots": [{"k": "b", "x": 310, "y": 19}, {"k": "b", "x": 693, "y": 19}, {"k": "m", "x": 413, "y": 195, "id": 200}, {"k": "m", "x": 257, "y": 416, "id": 201}, {"k": "m", "x": 750, "y": 301, "id": 202}, {"k": "m", "x": 763, "y": 170, "id": 203}, {"k": "m", "x": 668, "y": 251, "id": 204}, {"k": "m", "x": 506, "y": 141, "id": 205}, {"k": "m", "x": 340, "y": 466, "id": 206}, {"k": "m", "x": 510, "y": 354, "id": 207}, {"k": "m", "x": 686, "y": 466, "id": 208}, {"k": "m", "x": 338, "y": 250, "id": 209}, {"k": "m", "x": 241, "y": 172, "id": 210}, {"k": "m", "x": 171, "y": 356, "id": 211}, {"k": "m", "x": 260, "y": 301, "id": 212}, {"k": "m", "x": 423, "y": 300, "id": 213}, {"k": "m", "x": 599, "y": 410, "id": 214}, {"k": "m", "x": 591, "y": 301, "id": 215}, {"k": "m", "x": 585, "y": 194, "id": 216}, {"k": "m", "x": 425, "y": 411, "id": 217}, {"k": "m", "x": 837, "y": 360, "id": 218}, {"k": "m", "x": 767, "y": 409, "id": 219}, {"k": "r", "x": 308, "y": 355, "id": 300}, {"k": "r", "x": 373, "y": 355, "id": 301}, {"k": "r", "x": 642, "y": 353, "id": 302}, {"k": "r", "x": 705, "y": 356, "id": 303}, {"k": "r", "x": 495, "y": 221, "id": 304}, {"k": "r", "x": 508, "y": 265, "id": 305}, {"k": "r", "x": 513, "y": 437, "id": 306}, {"k": "r", "x": 515, "y": 486, "id": 307}, {"k": "r", "x": 830, "y": 462, "id": 308}, {"k": "r", "x": 183, "y": 460, "id": 309}]}, "start_cost": 10, "active": true, "story_talk": true, "name_en": "Nemesis, Wine Cellar Boy", "description_en": "Chasing Shino, who went ahead of the Wine Cellar Boy, the princes rush forward and witness...\nWhat they see...\nDivine (★1 target: Avg Lv50)"}