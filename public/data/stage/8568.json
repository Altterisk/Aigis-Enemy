800, "base_attack": 400, "damage_type": "magical", "armor_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 40, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 2074, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38774, "global_id": 12391, "ranged": true, "from_condition": 2}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 2, "tags": ["黒輪"], "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_speed": 50, "attack_wait": 30, "attack_interval": 165, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "special_effect_id": 2075, "change_to": 13, "change_condition": 2, "master_id": 38779, "global_id": 12396, "to_condition": 2, "to_global_id": 12397, "spawn_sec": 61}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "attack_speed": 50, "attack_wait": 20, "attack_interval": 145, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "special_effect_id": 2076, "master_id": 38780, "global_id": 12397, "from_condition": 2}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 2, "tags": ["黒輪"], "hp": 3000, "attack": 240, "base_hp": 3000, "base_attack": 240, "damage_type": "magical", "armor_defense": 50, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 2075, "change_to": 15, "change_condition": 2, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38777, "global_id": 12394, "ranged": true, "to_condition": 2, "to_global_id": 12395, "spawn_sec": 61}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 4500, "attack": 480, "base_hp": 4500, "base_attack": 480, "damage_type": "magical", "armor_defense": 100, "attack_range": 120, "attack_speed": 30, "attack_wait": 40, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 2076, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38778, "global_id": 12395, "ranged": true, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "アトナテス", "text": "――懐かしいな。", "face": "u908"}, {"name": "ソラス", "text": "そういえば、この辺りの出身でしたっけ。", "face": "u904"}, {"name": "アトナテス", "text": "ガキの頃のことなんて、\nほとんど覚えてねぇけどな。", "face": "u908"}, {"name": "アトナテス", "text": "それに、千年も前の話だ。\n北部戦線なんてものが成立するより、ずっと昔のな。\nどこが故郷かなんて分かりゃしねぇよ。", "face": "u908"}, {"name": "ソラス", "text": "へぇ……ふぅーん。", "face": "u904"}, {"name": "アトナテス", "text": "なんだよ、変な顔しやがって。", "face": "u908"}, {"name": "ソラス", "text": "変な顔とは失礼な。\nミステリアスな微笑みと言ってください。", "face": "u904"}, {"name": "アトナテス", "text": "したり顔の憎たらしい笑顔だったぜ？", "face": "u908"}, {"name": "ソラス", "text": "はぁ、いつまで経っても素直じゃないですねぇ。", "face": "u904"}, {"name": "トレシア", "text": "あ、あの、横から失礼します。\nアトナテス様は、やはり北の出身だったのですね。", "face": "u2314a1"}, {"name": "トレシア", "text": "騎竜を従えているのを見て、\nもしやと思っていたのですが……。", "face": "u2314a1"}, {"name": "アトナテス", "text": "……昔の話だ。\nそれから、北部城塞の姫君が、\n俺なんかに様付けする必要はないぜ。", "face": "u908"}, {"name": "トレシア", "text": "むむ……そういうわけには……。", "face": "u2314a1"}, {"name": "アトナテス", "text": "それより、また魔物の群れが来たぜ。\nどうする、やり過ごすか？", "face": "u908"}, {"name": "トレシア", "text": "はっ……。\nいえ、ここはまだ北部城塞から近い場所ですから、\n可能な限り殲滅しておきます。", "face": "u2314a1"}, {"name": "トレシア", "text": "王子殿下、シビラ殿下、魔物の群れが来ます！\n総員、周辺警戒を！　戦闘に入ります！", "face": "u2314a1"}]}, {"trigger": "end", "lines": [{"name": "シビラ", "text": "ふぅ……。\nやっぱり、黒冠の魔物が増えているみたいね。", "face": "u39"}, {"name": "シビラ", "text": "王子、上空からの調査結果はどう？\nドーンブリンガーを飛ばしているんでしょう？", "face": "u39"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "パルセ", "text": "上空に待機させてはいますが、\n地上の様子が一切観測できない状況です。", "face": "u2276a1"}, {"name": "パルセ", "text": "魔力の嵐に阻まれており、\n北限全域に渡って、光学的にも、\n魔力的にもジャミングがかかっているようなものです。", "face": "u2276a1"}, {"name": "レクテ", "text": "思いっきり高度をあげてついていくか、\n思いっきり高度を下げて、\n地表ギリギリを進むしかないって感じだねー。", "face": "u2047a1"}, {"name": "アマツ", "text": "いわふね……ぐるぐるする……。\nきもちわるいー。", "face": "u2234a1"}, {"name": "レクテ", "text": "わわっ、アマツちゃん大丈夫！？", "face": "u2047a1"}, {"name": "アマツ", "text": "きゅぅー。", "face": "u2234a1"}, {"name": "レーヴ", "text": "……伝承のとおり、ですね。", "face": "u454"}, {"name": "レーヴ", "text": "魔力の嵐と氷に閉ざされた、\n人類の生存を認めぬ極寒の大地。\n魔物たちの領域、北の雪原……。", "face": "u454"}, {"name": "シビラ", "text": "それでも、進むしかないわ。\n北部戦線を超えたこの先に、\nエンキドゥたちがいるはずなのだから。", "face": "u39"}]}], "active": true}