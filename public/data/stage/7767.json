{"quest_id": 7767, "name": "英雄と恩人", "description": "魔王城の上層へ向かう王子たちの前に、\n恩人のため覚悟を決めたヘンゼルと\n魔界の戦士たちが立ち塞がる。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "千の誓い、千の約束", "event_category": "History", "mission_id": 920184, "map_no": 4169, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 1, "change_condition": 3, "master_id": 800, "global_id": 799, "to_condition": 3, "to_global_id": 800, "spawn_sec": 9}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 500, "base_hp": 1200, "base_attack": 500, "damage_type": "physical", "armor_defense": 130, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 14}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "