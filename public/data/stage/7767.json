k_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 378, "global_id": 377, "ranged": true, "from_condition": 3}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106496, "race_id": 8, "change_to": 12, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 387, "global_id": 386, "ranged": true, "to_condition": 3, "to_global_id": 387, "spawn_sec": 158}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106512, "race_id": 8, "special_effect_id": 234, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 388, "global_id": 387, "ranged": true, "from_condition": 3}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 11000, "attack": 450, "base_hp": 11000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "magic_defense": 30, "attack_speed": 1, "attack_wait": 15, "attack_interval": 70, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110080, "master_id": 35351, "global_id": 8968, "spawn_sec": 185}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 500000, "base_hp": 500000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 10, "attack_wait": 20, "attack_interval": 89, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2140064, "race_id": 6, "master_id": 35347, "global_id": 8964, "spawn_sec": 218}], "popups": ["ダークエルフドルイドから攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。"], "dialogue": [{"trigger": "battle", "at_sec": 19, "lines": [{"name": "オーク", "text": "――王子たちが、来たか。", "face": "l9f9d81e5ea50"}, {"name": "ダークエルフ", "text": "ああ……魔界を救った英雄、\n俺たちの恩人が、ここへ来る。", "face": "l0e68ae181da5"}, {"name": "オーク", "text": "これは……我々のしようとしていることは、\n彼らへの裏切りなのだろうな。", "face": "l9f9d81e5ea50"}, {"name": "ダークエルフ", "text": "だが、礎となれるはずだ。\nダークエルフとオークが亜神ディアスに弓引くよりも、\n俺たちを捨て石として、王子が神に挑んだ方が――", "face": "l0e68ae181da5"}, {"name": "オーク", "text": "――あの御方を救出できる可能性が高い、か。\nならば、華々しく散るのもまた、\n我らの最期に相応しいあり方だな。", "face": "l9f9d81e5ea50"}, {"name": "ヘンゼル", "text": "……すまない、お前たちまで巻き込んでしまった。", "face": "u1622a1"}, {"name": "ダークエルフ", "text": "いいんだ、ヘンゼル。\nルキファ様は、俺たちにとっても恩人だからな。", "face": "l0e68ae181da5"}, {"name": "オーク", "text": "魔界と物質界の往来が絶たれた後、\n王子たちの目の届かぬこの地は、\n再び動乱の時代を迎えようとしていた。", "face": "l9f9d81e5ea50"}, {"name": "オーク", "text": "それを救ってくれたのが、為政者たるアスバール様と、\n正義の執行者たるルキファ様だった。", "face": "l9f9d81e5ea50"}, {"name": "ダークエルフ", "text": "あのおふたりがいなければ、\n多くの血が流れていたはずだ。\nだからこそ、俺たちはその恩を返さなければ。", "face": "l0e68ae181da5"}, {"name": "オーク", "text": "我らの子を、愛する者を、戦いから救った王子と、\nルキファ様に、我らの最後の戦いを捧げよう。", "face": "l9f9d81e5ea50"}, {"name": "ヘンゼル", "text": "――ああ。\n行くぞ、魔界の戦士たちよ！", "face": "u1622a1"}]}, {"trigger": "battle", "at_sec": 211, "lines": [{"name": "オーク", "text": "やるな……。\nさすがは王子、魔界武術大会の覇者だ……！", "face": "l9f9d81e5ea50"}, {"name": "ダークエルフ", "text": "王子と戦ったという、この事実だけで、\n末代までの武勇伝とできるだろうな。", "face": "l0e68ae181da5"}, {"name": "ダークエルフ", "text": "……そろそろ、諦めてもいい頃合いだろう？\n俺たちは、十分に戦った。", "face": "l0e68ae181da5"}, {"name": "オーク", "text": "ああ、そうだな……。\nルキファ様が人質でさえなければ、\nこんな戦いではなく、全力の戦いをしたかったものだ。", "face": "l9f9d81e5ea50"}, {"name": "ヘンゼル", "text": "オークの誇りまで、曲げさせてしまったな。\n後悔は、していないか？", "face": "u1622a1"}, {"name": "オーク", "text": "もう十分に戦った。\nだが、ああ、もし叶うのならば……。", "face": "l9f9d81e5ea50"}, {"name": "オーク", "text": "永遠のチャンプ、アナトリア様、\n現チャンプ、王子の戦いを、もう一度見てから死に――", "face": "l9f9d81e5ea50"}, {"name": "ルキファ", "text": "――何を甘えたことを言っている。", "face": "u1621a1"}]}, {"trigger": "end", "lines": [{"name": "ヘンゼル", "text": "なっ……ルキファ、さま？\nなぜここに……！？", "face": "u1622a1"}, {"name": "ルキファ", "text": "民を救うのが――ぐっ……くぁ……っ！\n亜神、ディアス様の儀式完遂まで、\n魔王城を防衛、するのが……我らの役割、だろう……。", "face": "u1621a1"}, {"name": "ソラス", "text": "ルキファ、あなた、\n操られていてもなお、自分の意識が……。", "face": "u904"}, {"name": "シャルロット", "text": "で、でも、それってまずいですわよ……？\n精神支配されたままでありながら、\n本来の力を、全力を出せるってことですもの。", "face": "u128"}, {"name": "トゥアン", "text": "いいじゃないか、\nどっちにせよ、あいつを解放するには、\n戦って無力化するしかないんだからな。", "face": "u1006a1"}, {"name": "ルキファ", "text": "……お前たちが、魔界の民を苦しめる者だな。\nその罪、ここで浄化してやろう。", "face": "u1621a1"}, {"name": "山ン本五郎左衛門", "text": "おいおい、お前の目的は魔界の民じゃなく、\n亜神ディアスの守護じゃなかったか？\nどれだけ意志が強いんだ、精神支配も歪めやがって。", "face": "u1617a1"}, {"name": "ルキファ", "text": "黙れ。我が翼は、我が力は、\n罪なき者たちのために振るわれる。", "face": "u1621a1"}, {"name": "ルキファ", "text": "ここで、汝らの罪を裁いてやろう！", "face": "u1621a1"}]}], "active": true}