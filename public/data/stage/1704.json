{"quest_id": 1704, "name": "魔界の深層", "description": "魔界を進む王子達にデーモン達が襲い来る。\n＜魔界深層：味方の攻撃、防御が半減＞\n＜魔界で能力低下しない味方の攻防1.3倍＞\n＜時間経過によるコスト回復量が低下＞", "modifier_notes": ["魔界深層：味方の攻撃、防御が半減", "魔界で能力低下しない味方の攻防1.3倍", "時間経過によるコスト回復量が低下"], "event": "ストーリーミッション7", "event_category": "Story", "mission_id": 100007, "map_no": 1111, "level": 100, "multiplier": 1.0, "charisma": 43, "capacity": 10, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}, {"kind": "term", "influence": 31, "params": [130]}, {"kind": "term", "influence": 32, "params": [130]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 35, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "true", "armor_defense": 50, "attack_range": 200, "attack_speed": 1, "attack_wait": 20, "attack_interval": 101, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109376, "missile_id": 204, "missile": {"speed": 8.0, "splash": 120}, "master_id": 30312, "global_id": 3931, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 16, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 30}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 70, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104096, "race_id": 3, "master_id": 498, "global_id": 497, "spawn_sec": 92}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 100000, "attack": 4500, "base_hp": 100000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 115, "attack_wait": 100, "attack_interval": 401, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109424, "race_id": 13, "master_id": 30314, "global_id": 3933, "spawn_sec": 111}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 10, "attack_interval": 76, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100224, "race_id": 3, "change_to": 5, "change_condition": 4, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 233, "global_id": 232, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 231, "spawn_sec": 113}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108304, "race_id": 3, "master_id": 30018, "global_id": 3637, "spawn_sec": 138}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 138}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 209}], "popups": ["ダークエレメンタルの攻撃は\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ネヴィン", "text": "――ここが協力者と落ち合う予定の\n奴隷地区なんだが……おい、どうした。\nもたもたしてるとデーモンに見つかるぞ。", "face": "u407"}, {"name": "アンナ", "text": "す、すみません、少しお待ち頂ければ。\n先ほどから、進めば進むほど\n身体が重くなってきてるような……。", "face": "l59eb7526d805"}, {"name": "ネヴィン", "text": "あぁ、アンタ等にはこの瘴気は少しキツいか。\nこっから先はさっきまでの表層とは違う、\nなんせ魔界の深層だからな。", "face": "u407"}, {"name": "ゼンメル", "text": "なるほど、ここが魔法都市の文献にあった……\n……ふむ、ではせん越ながら『魔界深層』について\nわしから――", "face": "u284"}, {"name": "テルマ", "text": "文献によれば、魔界の奥深く、\n魔界の深層では表層よりも遥かに\n瘴気が濃くなっているという事でしたね。", "face": "u296"}, {"name": "ネヴィン", "text": "へぇ、物質界の人間にしては良く知ってるな。\nその通り、こっから先の深層じゃ、魔界の瘴気が\nさっきまでと比べ物にならないくらい強くなってくる。", "face": "u407"}, {"name": "ネヴィン", "text": "とは言えアンタらには神器の力がある。\n王子の傍にいる限り、大きな影響もないだろう。\n直に身体も慣れるだろうさ。", "face": "u407"}, {"name": "ゼンメル", "text": "……こほん。魔界の深層ではただ瘴気が\n濃くなるだけではないぞ。なんでも――", "face": "u284"}, {"name": "シャロン", "text": "なんでも表層では現れなかった、\n強力な魔物達が住まうとも……。", "face": "u283"}, {"name": "ネヴィン", "text": "そうだな……この辺りで言えば\n高い攻撃力を持つ『魔界ボア』には注意だな。\n半端な防御じゃ一撃で潰されちまう。", "face": "u407"}, {"name": "ネヴィン", "text": "あとは『ダークエレメンタル』とかもだな。\n奴らの攻撃には装甲も魔法への耐性も意味がない、\nやられる前にやっちまった方が……っと、まずいな。", "face": "u407"}, {"name": "アンナ", "text": "……！　王子、向こうからデーモン達が！", "face": "l85cfbe6033b6"}, {"name": "ネヴィン", "text": "連中自らこんな奴隷地区に見回りに来るとはな。\nすまねぇ、アンタらと一緒にいるのを見られる訳には\nいかねぇんでな、俺の案内はここまでだ。", "face": "u407"}, {"name": "アンナ", "text": "ま、待ってください！　私達はこの地で\n一体どなたに会えば良いのでしょう！", "face": "l85cfbe6033b6"}, {"name": "ネヴィン", "text": "安心しな、話は既につけてある。\nあとはこのメモの場所に向かってくれ。\nそれじゃ、あとは頑張ってくれよ！", "face": "u407"}, {"name": "アンナ", "text": "行ってしまいました。\n……っ！　王子、デーモン達が\nこちらに気付いたようです！", "face": "l85cfbe6033b6"}, {"name": "ゼンメル", "text": "王子、魔界の瘴気に適応する者達であれば、\n濃い瘴気の影響で物質界以上の力を発揮する\nそうじゃ。彼らの力に頼ってみることも勧めておくぞ！", "face": "u284"}, {"name": "ゼンメル", "text": "……やれやれ、やっとわしの出番が来たわい。\nさぁ王子、戦闘の指示を頼むぞい！", "face": "u284"}]}, {"trigger": "end", "lines": [{"name": "テルマ", "text": "――ひとまず、敵は退けたようですが……。", "face": "u296"}, {"name": "シャロン", "text": "いつデーモン達の追撃があるかもわかりません。\nこのままここに留まり続けるのは危険そうです。", "face": "u283"}, {"name": "アンナ", "text": "はい、ネヴィンさんの案内が受けられないのは\n不安ではありますが……ひとまず\n先へと進みましょうか。", "face": "l59eb7526d805"}, {"name": "ゼンメル", "text": "奴隷地区……デーモン達に\n奴隷にされた者の住まう地区か。", "face": "u284"}, {"name": "アンナ", "text": "何が待ち受けているか判りません。\nくれぐれも慎重に進みましょう。", "face": "l85cfbe6033b6"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}, {"kind": "term", "influence": 31, "params": [130]}, {"kind": "term", "influence": 32, "params": [130]}, {"kind": "term", "influence": 24, "params": [4], "expression": "IsVanguard() || IsClassType(102,302);", "expression_human": "it is a melee unit or its class type is one of 102 / 302"}], "enemies": [{"enemy_id": 1, "hp": 3000, "attack": 250, "damage_type": "true", "armor_defense": 50, "pattern_id": 2109376}, {"enemy_id": 2, "hp": 2000, "attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "pattern_id": 2107936}, {"enemy_id": 3, "hp": 3000, "attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 70, "pattern_id": 2104096}, {"enemy_id": 4, "hp": 100000, "attack": 4500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "pattern_id": 2109424}, {"enemy_id": 5, "hp": 2000, "attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2100224}, {"enemy_id": 5, "form_index": 1, "hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2100208}, {"enemy_id": 7, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "pattern_id": 2108304}, {"enemy_id": 8, "hp": 15000, "attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "pattern_id": 2098288}, {"enemy_id": 9, "hp": 10000, "attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "pattern_id": 2100352}]}, "active": true}