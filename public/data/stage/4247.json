{"quest_id": 4247, "name": "吸血鬼の少女", "description": "襲い来る魔物たちの中に\n吸血鬼の少女が一人。\n彼女の正体と目的とは？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ヴァンパイアの逆襲", "event_category": "History", "mission_id": 920039, "map_no": 3547, "level": 95, "multiplier": 0.95, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 6650, "attack": 285, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 9, "form_count": 1, "hp": 950, "attack": 142, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 9, "form_count": 1, "hp": 494, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 31}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 9500, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_range": 30, "attack_speed": 35, "attack_wait": 50, "attack_interval": 136, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099088, "special_effect_id": 240, "missile_id": 45, "master_id": 159, "global_id": 158, "ranged": true, "spawn_sec": 35}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 1900, "attack": 522, "base_hp": 2000, "base_attack": 550, "damage_type": "physical", "armor_defense": 800, "attack_speed": 60, "attack_wait": 10, "attack_interval": 116, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098496, "race_id": 12, "master_id": 100, "global_id": 99, "spawn_sec": 67}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "報告！　神殿前に魔物が出現！", "face": "le481bf745813"}, {"name": "アンナ", "text": "敵の狙いは何なのでしょう……。\nここで神殿を失うわけにはいきません。\n王子、急ぎ戦闘の準備を！", "face": "ladee8649bf68"}]}, {"trigger": "battle", "at_sec": 37, "lines": [{"name": "エデン", "text": "まったく、まだ来ないの～？\n岩の塊だから足が遅いのかなー。", "face": "u239"}, {"name": "エデン", "text": "こんなに美味しそうな人間が目の前にいるのに……。\nもう待てなーい！", "face": "u239"}, {"name": "エデン", "text": "私の名はエデン。いい名前でしょ？\n言っておくけど、私の攻撃は\nそこらのヴァンパイアと一味ちがうよ？", "face": "u239"}, {"name": "エデン", "text": "ひと噛みで麻痺させてあーげる♪", "face": "u239"}]}, {"trigger": "end", "lines": [{"name": "エデン", "text": "ふふっ。なかなかやるじゃん。人間さん♪", "face": "u239"}, {"name": "エデン", "text": "ごほーびに私のお父様からのメッセージを伝えるね。", "face": "u239"}, {"name": "エデン", "text": "『住民を救いたくば、我が根城にこい』", "face": "u239"}, {"name": "エデン", "text": "『吸血鬼の王である我を倒せば、\n吸血鬼化の進行は止まる』", "face": "u239"}, {"name": "エデン", "text": "『ただし時間はない。\n住民が吸血鬼化すれば、\n打つ手はなくなるだろう』", "face": "u239"}, {"name": "エデン", "text": "それじゃ、確かに伝えたからね～。\nせいぜい頑張ってね？", "face": "u239"}, {"name": "アンナ", "text": "行ってしまいました……。\n王子、これは罠かもしれません。", "face": "ladee8649bf68"}, {"name": "アンナ", "text": "しかし情報がない以上、住民を救うには\n誘いに乗るしか手がなさそうですね。\n王子、行きましょう……！", "face": "ladee8649bf68"}]}], "active": true}