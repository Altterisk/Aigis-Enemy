{"quest_id": 8641, "name": "獣人戦士の人さらい", "description": "襲撃を受けた雪枝の里を守るべく、\n王子たちは獣人の軍勢に戦いを挑む……。\n＜特定のタイミングで吹雪が発生＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "導きの白狼", "event_category": "History", "mission_id": 920236, "map_no": 9389, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 4, "hp": 60000, "attack": 1200, "base_hp": 60000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 75, "attack_interval": 220, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2162128, "race_id": 12, "special_effect_id": 2152, "change_to": 1, "change_condition": 2, "master_id": 39012, "global_id": 12629, "to_condition": 2, "to_global_id": 12630, "route_behaviour": {"sets_flags": [[120, 1, 0]], "calls_event": [2239, 2240, 2241, 2242, 2243, 2244]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["黒輪"], "hp": 72000, "attack": 1500, "base_hp": 72000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 5, "attack_wait": 55, "attack_interval": 180, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2162128, "race_id": 12, "special_effect_id": 2153, "change_to": 2, "change_condition": 2, "master_id": 39013, "global_id": 12630, "from_condition": 2, "to_condition": 2, "to_global_id": 12631}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["黒輪"], "hp": 144000, "attack": 3000, "base_hp": 144000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 20, "attack_speed": 5, "attack_wait": 20, "attack_interval": 88, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist":