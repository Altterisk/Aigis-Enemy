 {"speed": 6.0}, "master_id": 38793, "global_id": 12410, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 18, "source": "local", "count": 6, "form_count": 1, "hp": 30000, "attack": 1100, "base_hp": 30000, "base_attack": 1100, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103568, "race_id": 12, "master_id": 456, "global_id": 455, "spawn_sec": 214}, {"enemy_id": 19, "source": "local", "count": 4, "form_count": 2, "tags": ["黒輪"], "hp": 9500, "attack": 550, "base_hp": 9500, "base_attack": 550, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 100, "attack_speed": 300, "attack_wait": 90, "attack_interval": 343, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155568, "race_id": 5, "special_effect_id": 2071, "change_to": 19, "change_condition": 2, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 38781, "global_id": 12398, "ranged": true, "to_condition": 2, "to_global_id": 12399, "spawn_sec": 230}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 14250, "attack": 1100, "base_hp": 14250, "base_attack": 1100, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_range": 100, "attack_speed": 300, "attack_wait": 70, "attack_interval": 303, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155568, "race_id": 5, "special_effect_id": 2072, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 38782, "global_id": 12399, "ranged": true, "from_condition": 2}, {"enemy_id": 21, "source": "local", "count": 7, "form_count": 2, "tags": ["黒輪"], "hp": 6000, "attack": 820, "base_hp": 6000, "base_attack": 820, "damage_type": "physical", "armor_defense": 220, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 205, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101248, "special_effect_id": 2073, "change_to": 21, "change_condition": 2, "master_id": 38086, "global_id": 11703, "to_condition": 2, "to_global_id": 11704, "spawn_sec": 236}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 9000, "attack": 1640, "base_hp": 9000, "base_attack": 1640, "damage_type": "physical", "armor_defense": 440, "magic_defense": 40, "attack_speed": 90, "attack_wait": 20, "attack_interval": 185, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101248, "special_effect_id": 2074, "master_id": 38087, "global_id": 11704, "from_condition": 2}, {"enemy_id": 23, "source": "local", "count": 3, "form_count": 1, "hp": 7000, "attack": 1000, "base_hp": 7000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 2200, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099136, "race_id": 12, "change_to": 23, "master_id": 38143, "global_id": 11760, "spawn_sec": 251}, {"enemy_id": 25, "source": "local", "count": 2, "form_count": 1, "hp": 70000, "attack": 2500, "base_hp": 70000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108064, "race_id": 12, "master_id": 972, "global_id": 971, "spawn_sec": 280}], "popups": ["獣人の騎士？は倒されると\n黒い光冠を纏い\nその場で強くなって復活します。\n復活は2回まで行われます。\n\n\n\n　　　　　　(1/2)", "2回復活した後の獣人の騎士？は、\n攻撃を受けると\n即座に麻痺状態になる\n物理の近接攻撃と、\n高威力の物理の近接攻撃を\n交互に行います。\n\n　　　　　　(2/2)", "黒い光冠の魔物は倒されると、\nその場で強くなって復活します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "獣人の騎士？", "text": "大人は皆殺しにしろ！\nガキは全員連れていけ！！", "face": "le9911ed05ac8"}, {"name": "オーシェン", "text": "シビラ殿下、すでに包囲されています。", "face": "u2133a1"}, {"name": "シビラ", "text": "獣人戦士の軍勢……？\nこの規模、野盗の類ではなさそうね。", "face": "u39"}, {"name": "マータン", "text": "なっ……貴様ら何者だ！\nここを雪枝の里と知っての狼藉かー！", "face": "u2524a1"}, {"name": "獣人の騎士？", "text": "ちびがキャンキャン吠えるんじゃねぇ！\n子犬は黙って震えてやがれ！", "face": "le9911ed05ac8"}, {"name": "マータン", "text": "マータンは子犬ではない！\n誇り高き白熊の獣人だ！", "face": "u2524a1"}, {"name": "マータン", "text": "戦士たちよ、剣をとれ！\n賊をギッタギタのバッキバキにするぞ！", "face": "u2524a1"}, {"name": "ユリクセス", "text": "マータン！　こちらも加勢する！\n負傷者は下げて構わない！", "face": "u2193a1"}, {"name": "マータン", "text": "恩に着る！\nファオル、長老たちに伝令を頼む！", "face": "u2524a1"}, {"name": "ファオル", "text": "わ、分かった！\nマータンも、みんなも、無理はしないで！", "face": "u2513a1"}, {"name": "メーリス", "text": "王子、あの獣人たちから\n嫌な魔力の匂いがするわ。\nただの賊だって油断しちゃだめよ！", "face": "u78"}]}, {"trigger": "end", "lines": [{"name": "獣人の騎士？", "text": "グハァァッ……。\n獣人でもねぇ、ただの人間が……何だ、その力は……。", "face": "le9911ed05ac8"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "獣人の騎士？", "text": "畜生、負け猫にはかける言葉すらねぇってことかよ。", "face": "le9911ed05ac8"}, {"name": "ユリクセス", "text": "おい、聞きたいことがある。\nお前たち、その黒冠の力をどうやって手に入れた。", "face": "u2193a1"}, {"name": "獣人の騎士？", "text": "けっ……誰が話すかよ。", "face": "le9911ed05ac8"}, {"name": "ユリクセス", "text": "マータン、狭間の雪原の取り決めが\nどうなっているかは知らないが、\nこいつらの処遇はこちらが決めてもいいか？", "face": "u2193a1"}, {"name": "マータン", "text": "うむ。\nその妙な黒いやつの力、\nお前たちが追っている何かなんだろう？", "face": "u2524a1"}, {"name": "マータン", "text": "少しでも情報が得られると――", "face": "u2524a1"}, {"name": "アキレア", "text": "ん、何だこの感じ……。\nおい、ユリクセス離れろ！！", "face": "u1972a1"}, {"name": "ユリクセス", "text": "…………ッ！？", "face": "u2193a1"}]}, {"trigger": "end", "lines": [{"name": "アキレア", "text": "ちっ……あの獣人たち、消えやがった。\nまた黒冠の転移魔法か。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "……どうにも、気が急いてしまうな。\n手がかりが掴めそうなのに、いつも一歩届かない。", "face": "u2193a1"}, {"name": "ファオル", "text": "――うぅん、一歩進んだと思うよ。", "face": "u2513a1"}, {"name": "マータン", "text": "ん？　どゆことだ？", "face": "u2524a1"}, {"name": "ファオル", "text": "長老たちがね、里を守ってくれたお礼がしたいって。\nそれからここに、活動拠点を作る許可と、\nあたしやマータンが雪原を案内する許可ももらったよ。", "face": "u2513a1"}, {"name": "ファオル", "text": "あとは……あたしが、世界を旅する許可も。", "face": "u2513a1"}, {"name": "マータン", "text": "……もしかして、\nファオルってマータンより交渉つよつよか？", "face": "u2524a1"}, {"name": "ファオル", "text": "マータンが力で押しすぎなんだってば。\nさっ、みんな里の中へどうぞ。\n歓迎の宴を開きたいらしいからさ♪", "face": "u2513a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "獣人の騎士？", "text": "南の蛮族の手を借りたのか、\n雪枝の子犬ちゃんたちよォ。", "face": "le9911ed05ac8"}, {"name": "マータン", "text": "何が蛮族か！\nお前たちの方がよっぽど蛮族だ！", "face": "u2524a1"}, {"name": "獣人の騎士？", "text": "聞き分けの悪い犬は嫌いだ。\n犬は犬らしく、強者にひれ伏しなァ！！", "face": "le9911ed05ac8"}, {"name": "フローガ", "text": "王子、あの獣人の魔力が膨れ上がっていきます！\nこれは……間違いありません、\n黒冠の魔力の反応です！！", "face": "u878"}, {"name": "獣人の騎士？", "text": "俺たちはようやく手に入れた。\n永久の吹雪にも、南の蛮族にも負けない力だ。", "face": "le9911ed05ac8"}, {"name": "獣人の騎士？", "text": "手始めに貴様らを全員肉塊にしてやる。\n死にてぇ奴から出てきやがれ！\nグオァァァァァァァッグ！！", "face": "le9911ed05ac8"}]}], "active": true}