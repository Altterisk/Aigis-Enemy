{"quest_id": 7291, "name": "第七回天界〇×クイズ大会", "description": "恒例〇×クイズ大会。今回は天界で\nトラム、パリオスから天界に関するクイズ\nが出題される。目指そう全問正解！\n<遠距離ユニット出撃不可>", "modifier_notes": ["遠距離ユニット出撃不可"], "event": "ゴールドラッシュ29(2021)", "event_category": "Reproduce", "mission_id": 300307, "map_no": 4046, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [4], "expression": "IsVanguard();", "expression_human": "it is a melee unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 4, "tags": ["ヌアザ", "ステルス"], "hp": 23000, "attack": 1200, "base_hp": 23000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_speed": 1, "attack_wait": 30, "attack_interval": 123, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126224, "race_id": 19, "special_effect_id": 434, "change_to": 1, "master_id": 33634, "global_id": 7251, "to_global_id": 7252, "route_behaviour": {"sets_flags": [[0, 0, 160], [1, 0, 160], [2, 0, 160], [3, 0, 160], [4, 0, 160], [5, 0, 160], [6, 0, 160], [8, 0, 160], [13, 0, 160], [14, 0, 160], [70, 0, 160], [71, 0, 160], [80, 0, 160], [81, 0, 160], [82, 0, 160], [90, 0, 160], [91, 0, 160], [92, 0, 160], [100, 0, 160], [101, 0, 160], [102, 0, 160], [103, 0, 160]], "calls_event": [2301, 2302, 2303, 2304], "reroutes": ["Route=51"]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ヌアザ"], "hp": 23000, "attack": 1200, "base_hp": 23000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_speed": 1, "attack_wait": 30, "attack_interval": 97, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2128240, "race_id": 19, "special_effect_id": 242, "change_to": 2, "change_condition": 2, "master_id": 33635, "global_id": 7252, "to_condition": 2, "to_global_id": 7253}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["ヌア