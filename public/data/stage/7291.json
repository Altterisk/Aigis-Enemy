 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 630, "change_to": 26, "master_id": 33644, "global_id": 7261, "to_global_id": 7262}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 7, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 631, "change_to": 27, "master_id": 33645, "global_id": 7262, "to_global_id": 7263}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 8, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 632, "change_to": 28, "master_id": 33646, "global_id": 7263, "to_global_id": 7264}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 9, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 633, "master_id": 33647, "global_id": 7264}], "popups": ["トラム、パリオス\nオーキュは倒さなくても\n★の評価には影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リズリー", "text": "――はい、満員御礼、拍手喝采、くらうそらす♪\nさぁトラムさま、元気よくどうぞ！", "face": "u716"}, {"name": "トラム", "text": "えっ、えっと、これを読めばいいのね。\n――コホン。\nそれでは王国クイズ大会天界編、スタートよ！", "face": "u1110a1"}, {"name": "トラム", "text": "クイズ大会の司会進行は、\n人類大好き最強にカワイイ亜神さま♪\nトラムがつとめ――って、何なのこの台本！？", "face": "u1110a1"}, {"name": "パリオス", "text": "もうひとりの司会はこのぼく！\n白い翼はかわいさの証！\nパリオスがつとめちゃうよー！", "face": "u1109a1"}, {"name": "トラム", "text": "パ、パリオス、あなたはこの台本恥ずかしくないの！？", "face": "u1110a1"}, {"name": "パリオス", "text": "んん？　ぜんぜん？\nトラムさまもぼくも、すっごくカワイイからね！", "face": "u1109a1"}, {"name": "オーキュ", "text": "ふふ、困っているトラムさまが見たくて、\nこっそり台本を書き加えたかいがありましたわ♪\n王子さま、ヒントはまかせてくださいな♪", "face": "u1101a1"}, {"name": "リズリー", "text": "よしよしよしよし、みーんなカワイイ！\nじゃあルール説明行ってみよう♪", "face": "u716"}, {"name": "トラム", "text": "クイズは全部で３問。\n全部『○か×か』で答えられる問題よ。", "face": "u1110a1"}, {"name": "パリオス", "text": "地面に大きく、○と×が描いてあるよね。\n答える時は、これが正解だー！\nって思う方の『近接マス』に仲間を配置してね。", "face": "u1109a1"}, {"name": "トラム", "text": "でも、解答者が姿を隠していると\nどちらの答えを選んだか分からないわ。\nちゃんと姿が見えてる子を配置するのよ？", "face": "u1110a1"}, {"name": "パリオス", "text": "かくれんぼはまた後でね！", "face": "u1109a1"}, {"name": "トラム", "text": "それから制限時間にも注意よ。\n解答ボタンの看板を支えている、\n兵士さんの体力が無くなる前に解答してね♪", "face": "u1110a1"}, {"name": "リズリー", "text": "んー！　ナイス説明！\nそれから今回も、豪華な賞品を用意したよー！", "face": "u716"}, {"name": "オーキュ", "text": "人類とは縁深くもあり、因縁深くもあるあの女神さまを、\nその身に受け入れていた現代の聖女！", "face": "u1101a1"}, {"name": "オーキュ", "text": "日々裏方で王都を支えるその姿に、\n隠れファンも多いというケラウノスさまの依代さん！\nその等身大人形ですわよー！", "face": "u1101a1"}, {"name": "ケラウノスの依代", "text": "えぇと……本当に私の像で良いのでしょうか……？\nもっと相応しい方がいるかと思うのですが……。", "face": "l98cb85cedcda"}, {"name": "王国の民", "text": "謙虚なところが可愛いです！\n市民一同、とっても感謝しています！", "face": "l363953d95f06"}, {"name": "リズリー", "text": "依代である重責を負いながらも、\n最近は教会で炊き出しや病人の看護をしているのだとか。\nすごいぞ依代ちゃん！", "face": "u716"}, {"name": "リズリー", "text": "最後に大事なルールを伝えよう。\nトラムさま、\nズルして両方選んだらどうなるか教えてあげて！", "face": "u716"}, {"name": "トラム", "text": "もちろん、亜神トラムの鉄拳――ではなく、\nちょっぴり全力の私がお相手するわ！", "face": "u1110a1"}, {"name": "オーキュ", "text": "トラムさまと戦いたいならともかく、\n分からない時には\n私の前に兵を配置してくださいな♪", "face": "u1101a1"}, {"name": "オーキュ", "text": "今回は天界編ですから、\n天界在住の私のヒントは重要ですのよー？", "face": "u1101a1"}, {"name": "トラム", "text": "それでは、まずは練習問題。\nいくわよ、王子！", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 48, "lines": [{"name": "トラム", "text": "まずは小手調べよ。\nアイギス教徒の基礎教養、慎重にね。", "face": "u1110a1"}, {"name": "パリオス", "text": "あっ、でも間違えると「カミナリ」が\n頭の上に降ってくるからね！", "face": "u1109a1"}]}, {"trigger": "battle", "at_sec": 61, "lines": [{"name": "トラム", "text": "そこまで！　パリオス、正解は？", "face": "u1110a1"}, {"name": "パリオス", "text": "もちろん、【○】だよー！", "face": "u1109a1"}]}, {"trigger": "battle", "at_sec": 64, "lines": [{"name": "トラム", "text": "ふふ、簡単すぎたかしら？\nでもこれは例題だから、次からは難しいわよ？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 64, "lines": [{"name": "トラム", "text": "わざと間違えたのかしら？\nあ、あの、でもね、例題のカミナリはびりびりだけど、\n本番のカミナリはずどーんだから気をつけてね？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 64, "lines": [{"name": "トラム", "text": "……王子？\nもしかして、私と模擬戦がしたいのかしら？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 68, "lines": [{"name": "トラム", "text": "コホン。それではさっそく、第１問！\nどどん！", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 82, "lines": [{"name": "トラム", "text": "もしかして、簡単すぎて迷っているのかしら。\n大丈夫、ゆっくり考えてね。", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 95, "lines": [{"name": "トラム", "text": "はい、そこまで！\nパリオス、正解は――", "face": "u1110a1"}, {"name": "パリオス", "text": "どどーん！　【○】だよ！！", "face": "u1109a1"}]}, {"trigger": "battle", "at_sec": 98, "lines": [{"name": "トラム", "text": "常に最前線で戦う王子なら、\n戦った相手のことは当然覚えていたわよね。\n次はもう少し難しい問題にしようかしら？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 98, "lines": [{"name": "トラム", "text": "あらら、もしかして勘ぐりすぎちゃった？\n王子、引っ掛け問題なんて出さないわよ？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 98, "lines": [{"name": "パリオス", "text": "みーちゃった♪\n不正行為は禁止だよー！", "face": "u1109a1"}]}, {"trigger": "battle", "at_sec": 102, "lines": [{"name": "トラム", "text": "続いて第２問！\n次の問題は……これよ！", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 117, "lines": [{"name": "トラム", "text": "ちくたく♪　ちくたく♪\n迷う王子というのも、うん、悪くないわね……。", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 129, "lines": [{"name": "トラム", "text": "そこまで！\nパリオス、答えは？", "face": "u1110a1"}, {"name": "パリオス", "text": "ばばん！　【×】だよー。", "face": "u1109a1"}]}, {"trigger": "battle", "at_sec": 133, "lines": [{"name": "トラム", "text": "これくらいの問題なら、\n簡単に乗り越えてくるのね。\nさすがは私の――じゃなかった、皆の王子ね♪", "face": "u1110a1"}, {"name": "パリオス", "text": "トラムさま、王子は譲らないよー？", "face": "u1109a1"}, {"name": "トラム", "text": "こういうものに身分は関係ありませんからね。\n私も負けませんよ？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 133, "lines": [{"name": "トラム", "text": "あらら、さすがに宝玉の色は難しかったかしら？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 133, "lines": [{"name": "トラム", "text": "王子、不正行為をはたらくなんて、\nそんなに私の剣を見たいのかしら？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 137, "lines": [{"name": "トラム", "text": "とうとう最後の第３問よ。\n王子に、輝ける銀腕の加護があらんことを！", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 151, "lines": [{"name": "トラム", "text": "王子ならきっと大丈夫よ。\n慎重に、慎重に……。", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 164, "lines": [{"name": "トラム", "text": "さぁ正解は……！", "face": "u1110a1"}, {"name": "パリオス", "text": "とーう！　【○】だよー！", "face": "u1109a1"}]}, {"trigger": "battle", "at_sec": 167, "lines": [{"name": "トラム", "text": "やっぱり王子はすごいわ。\n知識の面でも類まれな才を持っているのね！", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 167, "lines": [{"name": "トラム", "text": "気を落とさないで。\n私が隣で、王子を支えていくから！", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 167, "lines": [{"name": "トラム", "text": "ね、ねぇ、本当に銀腕じゃなくて、\n私の剣でおしおきしちゃうわよ？\n大丈夫！？　すっごい威力なのよ！？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 170, "lines": [{"name": "トラム", "text": "全問正解なんて、すごいわ王子！\n私じきじきに、花まるを進呈しちゃう♪", "face": "u1110a1"}, {"name": "パリオス", "text": "結構難しい問題もあったのにね。\nぼくも迷っちゃったし……。", "face": "u1109a1"}]}, {"trigger": "battle", "at_sec": 170, "lines": [{"name": "トラム", "text": "あら、１問不正解ね。\nでもあえて間違えるのも、こういうお祭りには必要よね？", "face": "u1110a1"}]}, {"trigger": "battle", "at_sec": 170, "lines": [{"name": "トラム", "text": "あらら……。\n王子、これから天界との戦いは激化していくわ。\nあらためて、一緒に勉強しましょうね！", "face": "u1110a1"}]}, {"trigger": "route", "enemy_ids": [15], "lines": [{"name": "オーキュ", "text": "ケラウノスさまは一番のお姉さんですわよ。\n面倒見も良くて、神話ではアイギスさま、\nアダマスさまにとっても慕われていたのだとか♪", "face": "u1101a1"}, {"name": "オーガスタ", "text": "長女の余裕、と言うべきでしょうか。\nけれど食いしん坊なところもあって、\nとっても可愛らしい方なのですよ？", "face": "u960"}]}, {"trigger": "route", "enemy_ids": [15], "lines": [{"name": "オーキュ", "text": "神聖騎士団……かつては敬虔な騎士修道会だったとか。\nそれが今や、信者を生ける鎧に作り変える、\n邪教の集団になってしまったそうですわ。", "face": "u1101a1"}, {"name": "アレクシア", "text": "彼らもきっと、本当に信ずるべきものが分からないだけ。\nドゥマルデ審問官とともに、\nいつかはかつての友たちを救いたいものです……。", "face": "u1168a1"}]}, {"trigger": "route", "enemy_ids": [15], "lines": [{"name": "オーキュ", "text": "聖域の盗掘――じゃなかった、発掘に危険はつきもの。\n宝玉が「赤く」光った時には、\nとにかく迅速に逃げないと危険なのですわよ。", "face": "u1101a1"}, {"name": "パリオス", "text": "へぇ、乙女像の宝玉が赤く光ってるとどうなるの？", "face": "u1109a1"}, {"name": "オーキュ", "text": "……今度、試してみます？\nすっごい攻撃が始まりますわよ！", "face": "u1101a1"}]}, {"trigger": "route", "enemy_ids": [15], "lines": [{"name": "オーキュ", "text": "人の身で、亜神に立ち向かうお姿。\n携えし神砕く槍の輝き……。\n忘れることはありませんわ。", "face": "u1101a1"}, {"name": "スルーズ", "text": "人間があの槍を使いこなすなんて、\nやっぱり殿下は普通じゃないですよね……。", "face": "u1143a1"}, {"name": "パリオス", "text": "――あの槍、グングニルって\nスルーズのお父さんの槍なんでしょ？\n返してほしいとか思わないの？", "face": "u1109a1"}, {"name": "スルーズ", "text": "ふふ、今はなき父も、\n王子殿下ほどの英雄が槍を担うなら、\nきっと喜んでくれるはずですよ。", "face": "u1143a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "リズリー", "text": "それでは次のクイズ大会でお会いしましょう♪\nトラムさま、最後にひとことどうぞ！", "face": "u716"}, {"name": "トラム", "text": "すべての民に、銀なる輝きの加護あれ！\nそして王子には、その、えっと……。", "face": "u1110a1"}, {"name": "パリオス", "text": "トラムさま、司会者特権だよ！\n元気よく！　せーの！", "face": "u1109a1"}, {"name": "トラム", "text": "お、王子には、私の加護あれっ！", "face": "u1110a1"}]}, {"trigger": "route", "lines": [{"name": "パリオス", "text": "あーあ、不正はだめって言ったのに……。\nトラムさま、お仕置きのじかんだ！", "face": "u1109a1"}, {"name": "トラム", "text": "えぇ、そんなに私の剣を見たいなら――\n輝ける我が宝剣、見せてあげるわ！！", "face": "u1110a1"}]}], "story_talk": true, "active": true}