 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 117}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 322, "global_id": 321, "ranged": true, "spawn_sec": 124}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 550, "base_hp": 15000, "base_attack": 550, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 180, "attack_speed": 70, "attack_wait": 20, "attack_interval": 111, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100672, "race_id": 13, "change_to": 10, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 277, "global_id": 276, "ranged": true, "variants": [{"hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100688, "race_id": 13, "master_id": 278, "global_id": 277}], "spawn_sec": 169}], "popups": [" 　　　悪天候：霧\n\n・敵味方の『射程』減少\n・一部の味方は影響を受けない"], "dialogue": [{"trigger": "start", "lines": [{"name": "セレイナ", "text": "はぁ……ハァ……だめです……。\nどうやら、完全に王子達を\n見失ってしまったようです。", "face": "u375"}, {"name": "天使", "text": "……そうですか。\n残念ですねセレイナ……我らは……\nここで撤退するしかないようです……。", "face": "l78025fce4bde"}, {"name": "アンナ", "text": "（王子、どうやら私達がこの草陰に\n隠れていることには気づいていないようですね。\nこのまま彼女達をやり過ごしましょう）", "face": "l7321c8eb4085"}, {"name": "ゴブリン", "text": "ギャギャッ！？\n人間ミツケタ！　倒セ、倒セッ！", "face": "l783399d1d9b4"}, {"name": "セレイナ", "text": "魔物！？\nそんな……こんな時に……。", "face": "u375"}, {"name": "セレイナ", "text": "天使様、ここは共に力を合わせて\nこの窮地を脱しましょう！\n神は必ず私達を――", "face": "u375"}, {"name": "天使", "text": "――我らは先に撤退します。", "face": "l78025fce4bde"}, {"name": "セレイナ", "text": "……え？\n先に……撤退するって……。\n冗談、ですよね……？", "face": "u375"}, {"name": "天使", "text": "貴方の身を守るという\n指令は神から受けていません。", "face": "l78025fce4bde"}, {"name": "セレイナ", "text": "そんな、待って……待って下さいッ！\n私だけでは、魔物の群を相手になどできません！", "face": "u375"}, {"name": "セレイナ", "text": "お願いです、天使様……私を見捨てないで下さい！", "face": "u375"}, {"name": "ユリアン", "text": "（信じられねぇ……。\n天使のヤツ、仲間のはずのセレイナを\n本当に見捨てやがったぞ！）", "face": "u7"}, {"name": "アンナ", "text": "このままセレイナさんを放っておけば、\n魔物の手にかかってしまいます！\n王子、すぐに助けに行きましょう！", "face": "l7321c8eb4085"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "何とか魔物を一掃できたようですね。\nセレイナさん、お怪我はありませんか？", "face": "l7321c8eb4085"}, {"name": "セレイナ", "text": "……は、はい。\n特に……大した怪我は、していませんが……。", "face": "u375"}, {"name": "セレイナ", "text": "それよりも……何故ですか……？\n何故、貴方達は\n敵である私を助けたのですか……？", "face": "u375"}, {"name": "ユリアン", "text": "なぜって……あのなぁ。\n人が死にそうだって時に\n見過ごせるヤツの方がおかしいだろ！", "face": "u7"}, {"name": "ユリアン", "text": "それにさっきまで仲良くやってたはずの\n天使達は何だって急にお前を見捨てたんだ？", "face": "u7"}, {"name": "セレイナ", "text": "見捨てた……。\nそう、ですよね……私は、天使に……。\n神に、見捨てられたのですね……。", "face": "u375"}, {"name": "ユリアン", "text": "……お、おい。\n何もそんなに落ち込むことないだろ……？", "face": "u7"}, {"name": "アンナ", "text": "あの、セレイナさん……。\nもしよかったら、これまでの経緯を\n私達に話して頂けませんか？", "face": "l7321c8eb4085"}, {"name": "セレイナ", "text": "……わかりました。\n貴方達に救って頂いた身です。\n全てを、お話しましょう……。", "face": "u375"}]}], "active": true}