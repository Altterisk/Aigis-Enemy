{"quest_id": 8218, "name": "イケてるコンテストの前哨戦", "description": "文化祭のコンテスト前哨戦と称し、\n各グループが乱闘を開始。さらにそれを\n止めようとした生徒や先生も加わって……？\n神級（★１獲得の目安：平均Lv50）", "event": "王国ナナイロ文化祭", "event_category": "History", "mission_id": 920212, "map_no": 4867, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 17, "form_count": 1, "hp": 2000, "attack": 380, "base_hp": 2000, "base_attack": 380, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127936, "race_id": 16, "master_id": 33579, "global_id": 7196}, {"enemy_id": 2, "source": "local", "count": 35, "form_count": 1, "hp": 5400, "attack": 540, "base_hp": 5400, "base_attack": 540, "damage_type": "physical", "armor_defense": 210, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127952, "race_id": 16, "master_id": 33580, "global_id": 7197}, {"enemy_id": 3, "source": "local", "count": 17, "form_count": 1, "hp": 1600, "attack": 320, "base_hp": 1600, "base_attack": 320, "damage_type": "physical", "armor_defense": 90, "attack_range": 100, "attack_speed": 1, "attack_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127968, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 33581, "global_id": 7198, "ranged": true, "spawn_sec": 32}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 80, "attack_speed": 90, "attack_wait": 30, "attack_interval": 191, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_re