16, "special_effect_id": 222, "missile_id": 681, "missile": {"speed": 8.0}, "master_id": 37321, "global_id": 10938, "ranged": true, "spawn_sec": 114}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 64000, "attack": 1750, "base_hp": 64000, "base_attack": 1750, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_range": 240, "attack_speed": 1, "attack_wait": 25, "attack_interval": 87, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 100, "pattern_id": 2128080, "race_id": 16, "special_effect_id": 224, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 37323, "global_id": 10940, "ranged": true, "spawn_sec": 129}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 128000, "attack": 950, "base_hp": 128000, "base_attack": 950, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 100, "pattern_id": 2133808, "race_id": 16, "special_effect_id": 476, "master_id": 37322, "global_id": 10939, "spawn_sec": 162}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 88000, "attack": 1400, "base_hp": 88000, "base_attack": 1400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 240, "attack_speed": 1, "attack_wait": 4, "attack_interval": 63, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 100, "pattern_id": 2121888, "race_id": 16, "special_effect_id": 264, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 37324, "global_id": 10941, "ranged": true, "spawn_sec": 162}], "popups": ["レティシアは倒されると\n自身の周囲にダメージを与えます。", "コーネリアが味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nスキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "サクヤ", "text": "にゃんにゃか親衛隊、ホムラっち愚連隊、\nリーゼント海賊団、小悪魔ガールズを見守り隊が、\n乱闘しはじめてます！", "face": "u1774a1"}, {"name": "レティシア", "text": "駄目です！　気持ちは分かりますが、\n争わないでくださいー！！", "face": "u1779a1"}, {"name": "トワ", "text": "これはなんの騒ぎですか！？\nいったいなにがあったというのです！？", "face": "u785"}, {"name": "サクヤ", "text": "文化祭の、イケてるコンテストの前哨戦だそうで、\n何故か、勝手に戦いはじめたみたいです。", "face": "u1774a1"}, {"name": "サクヤ", "text": "これは……新たな王国学園七不思議でしょうか……？", "face": "u1774a1"}, {"name": "トワ", "text": "七不思議じゃなくて、\nただの暴力ではないでしょうか……？", "face": "u785"}, {"name": "小悪魔ガールズ見守り隊の学生", "text": "エスネアちゃんとエフネちゃんが、\n一番イケてるに決まってるだろォン！！\nお前らエス★エフのライブ聞いてねぇのかァア！？", "face": "l3dd401cd420e"}, {"name": "ホムラっち愚連隊の学生", "text": "なにがライブだボケナスが！！\n学生の本分は勉強だって知らねぇのかよォォ！！", "face": "l3dd401cd420e"}, {"name": "リーゼント海賊団の学生", "text": "そういうお前らはちゃんと勉強してんのかァ！？\nこっちは毎日しっかり授業聞いて宿題もやってんだぞ！！", "face": "lb43f93b5e4c3"}, {"name": "にゃんにゃか親衛隊の学生", "text": "ミネットちゃんかわいい。", "face": "l3dd401cd420e"}, {"name": "クレア", "text": "いいぞー！　やれやれー！", "face": "u1444a1"}, {"name": "リカルド", "text": "誰だ煽っているのは！？\nこのままだと暴動に発展するぞ！？", "face": "u787"}, {"name": "コーネリア", "text": "（これだ……これが青春……！\nいや本当にそうか？　本当にこれが青春でいいのか？）", "face": "u1441a1"}, {"name": "ミーシャ", "text": "み、皆さんっ、落ち着いてください！\nああっ、駄目です！　\nもはや力でしか解決できないというのですか……！", "face": "u786"}, {"name": "レティシア", "text": "どうして……皆、いい生徒だったのに……。\nこうなれば実戦で指導してあげます……！", "face": "u1779a1"}, {"name": "トワ", "text": "じ、地獄絵図じゃないですか……！\nとにかく止めなければ……！", "face": "u785"}, {"name": "アンナ", "text": "皆さん、もうめちゃくちゃです。\nこのままではただの乱闘になってしまいます。", "face": "l7faba9398726"}, {"name": "アンナ", "text": "元気なのはいいことですが、\nそろそろ止めてあげたほうが良さそうです。", "face": "lb05944df0172"}, {"name": "アンナ", "text": "いきましょう、王子。", "face": "l7faba9398726"}, {"name": "王子", "text": "…………（こくり）。", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "にゃんにゃか親衛隊、ホムラっち愚連隊、\nリーゼント海賊団、小悪魔ガールズを見守り隊、\nその他の皆さんも、全員大人しくなったようです。", "face": "lb05944df0172"}, {"name": "トワ", "text": "失敗しました……。止めるつもりが、\nまさか王子を攻撃してしまうなんて……。", "face": "u785"}, {"name": "コーネリア", "text": "私もだ……。\n乱戦だったとはいえ、\n王子に殴りかかってしまうとは……。", "face": "u1441a1"}, {"name": "王子", "text": "…………（ふるふる）。", "face": "u1"}, {"name": "アンナ", "text": "ふふ。気にしなくていいそうですよ。\nむしろ、喧嘩を止めようとしてくれたことを、\n王子は感謝しているようです。"}, {"name": "クレア", "text": "さすが王子！　器が違いますね！", "face": "u1444a1"}, {"name": "レティシア", "text": "乱闘を煽ったクレアさんは反省してください。", "face": "u1779a1"}, {"name": "レティシア", "text": "もちろん、他の生徒たちもですよ？\nいくら文化祭の前とはいえ、\n最低限は節度を守ってくださいね。", "face": "u1779a1"}, {"name": "学生たち", "text": "……はい、気をつけます。", "face": "l3dd401cd420e"}, {"name": "ミーシャ", "text": "よかった。みんな反省しているみたいですね。", "face": "u786"}, {"name": "リカルド", "text": "じゃなきゃ困る。\n噂で聞いたが、光るローパーが現れたとかで、\n大変なことになっているんだろ？", "face": "u787"}, {"name": "リカルド", "text": "これ以上事件が起きたら、\nそれこそこの学園がめちゃくちゃになっちまう。", "face": "u787"}, {"name": "アンナ", "text": "王子、我々も見回りを続けましょう。\n今回の文化祭は、一波乱が起きるかもしれません。", "face": "l7faba9398726"}, {"name": "王子", "text": "…………（こくり）。", "face": "u1"}, {"name": "コーネリア", "text": "私たちも、なにか手がかりを見つけたら報告しよう。\n文化祭は、皆で作り、皆で楽しむものだからな。", "face": "u1441a1"}, {"name": "アンナ", "text": "ありがとうございます、コーネリアさん。"}, {"name": "アンナ", "text": "ところで、その眼帯はどうしたんですか？\nもし怪我でもしているなら、ちゃんと医務室に――"}, {"name": "コーネリア", "text": "この眼帯は……放っておいてくれ。", "face": "u1441a1"}]}], "active": true}