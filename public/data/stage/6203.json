": 2, "form_count": 2, "hp": 900, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 6, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 118}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 2700, "attack": 675, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 146}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 630, "attack": 135, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "change_to": 10, "change_condition": 2, "master_id": 30491, "global_id": 4110, "to_condition": 2, "to_global_id": 4054, "spawn_sec": 170}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5670, "attack": 288, "base_hp": 6300, "base_attack": 320, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30435, "global_id": 4054, "from_condition": 2}], "popups": ["ぬらりひょんがいる間は\n全ての妖怪の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "サヨ", "text": "暗黒騎士団や妖虎仙のように、\nお互いに決戦に臨む事もあれば、\n思わぬ戦いで命を落とす事もある。", "face": "u510"}, {"name": "サヨ", "text": "妖怪総大将、ぬらりひょんを討ったのは、\nそんな戦いでの事だったよね。", "face": "u510"}, {"name": "ヒエン", "text": "――ぬらりひょん率いる妖怪軍団は\nこの都に進軍したとの事。また、鬼の大将である\n酒呑童子も都にいるとの事でござる。", "face": "u112"}, {"name": "ヒバリ", "text": "……その割には、やけに静かね。\n都に妖怪が集まっているのは\n間違いないのに……。", "face": "u389"}, {"name": "ぬらりひょん", "text": "飛んで火にいる夏の虫……。\nまさに、お前たちのことだと思わんか？\nのう王子。そして「鬼切」の担い手、ヒバリよ。", "face": "l6f94a454d720"}, {"name": "ぬらりひょん", "text": "覚悟しておけェ！！\n全員まとめて切り刻んでくれるわ！！\n出ろ！　妖怪ども！　百鬼夜行じゃあああ！！", "face": "l6f94a454d720"}]}, {"trigger": "end", "lines": [{"name": "ぬらりひょん", "text": "わしが……こんなところで……逝くことになるとは……。\nだれか居らぬか……この気配、餓鬼……か？\nわしの、妖怪総大将、最後の頼み、聞いてくれるか……。", "face": "l6f94a454d720"}, {"name": "サヨ", "text": "餓鬼？　変装はもう解けてるんだけど……？\n……あなた。もう、目が……。", "face": "u510"}, {"name": "ぬらりひょん", "text": "シノに、我が娘に……この長ドスを渡してくれんか……。\n一言……。夢の道半ばで逝くわしを許してくれ、と……。\n……頼む……。", "face": "l6f94a454d720"}, {"name": "サヨ", "text": "……こんな状況じゃ、断れないでしょ。\n……わかったわ。", "face": "u510"}, {"name": "ぬらりひょん", "text": "カスミ……姉であるシノに……、\nお前の事を伝えてやれぬ父を、許せ……。", "face": "l6f94a454d720"}, {"name": "ヒバリ", "text": "王子、こっちだ！\n妖怪総大将、ぬらりひょん。\n……何か、言い残す事はある？", "face": "u389"}, {"name": "ぬらりひょん", "text": "くちおしや……。くちおしや……。\n妖怪の総大将たるわしが……。\n鬼なんぞに……。裏切られるとは……。", "face": "l6f94a454d720"}, {"name": "ヒエン", "text": "力を使い果たしたか。\nこれではもう助からぬ。\n年貢の納め時でござるな。", "face": "u112"}, {"name": "ぬらりひょん", "text": "人間ふぜいが……畜生……\n妖怪の……理想郷をつくる……。\nわしの夢……ここで終わり……か……。", "face": "l6f94a454d720"}, {"name": "ぬらりひょん", "text": "……。", "face": "l6f94a454d720"}, {"name": "サヨ", "text": "――この戦いで妖怪の総大将、ぬらりひょんは戦死。\nそしてぬらりひょんを罠に陥れた酒呑童子たち鬼を\n封印するため、ヒバリさんは先行したのよね。", "face": "u510"}, {"name": "サヨ", "text": "わたしはこの後、シノさんを探し出して、長ドスを届けて、\nそれからヒバリさんと王子たちを追いかけて。\n……追いつくのは、それはもう大変だったわ。", "face": "u510"}, {"name": "サヨ", "text": "まぁ、王子の戦いを見届けるってきめたから。\n一度決めた以上、意地でも付いて行くんだから。\nこの次、酒呑童子との戦いにもね。", "face": "u510"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "ぬらりひょん", "text": "ぐっ……鬼の奴らは何をしておるんじゃ？\nこれ以上はさすがのわしも……！", "face": "l6f94a454d720"}, {"name": "四天王", "text": "どうした、ぬらりひょん？\nまだ鬼が助けにくるとでも思っておるのか？", "face": "l9347a43a4c93"}, {"name": "ぬらりひょん", "text": "――なッ、ど、どういうことじゃ！？\n鬼の援軍と王子軍を攻める手はずじゃろうが！", "face": "l625ab46cdc97"}, {"name": "四天王", "text": "オマエはここで死ぬんだよ、ぬらりひょん。\nそうすれば酒呑童子様が妖怪の頂点に君臨される。\nククク……最初からこうなる運命だったのよ。", "face": "l9347a43a4c93"}, {"name": "四天王", "text": "我ら四天王が復活を果たした今、\nお前はもう用済みなのじゃ！\nガーーッハッハッハッハ！", "face": "l9347a43a4c93"}, {"name": "ぬらりひょん", "text": "裏切った……だと？\nおのれ……。\nおのれェェェェェェェェェェェェェぇええ！！", "face": "l625ab46cdc97"}]}], "active": true}