{"quest_id": 6238, "name": "決戦のバトルロイヤル", "description": "決戦の地に優勝を奪わんと暗躍する影。\n決闘を邪魔する者たちを撃退せよ！\n＜魔界審判がいる間敵の攻防80%減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["魔界審判がいる間敵の攻防80%減少"], "event": "王者達のバトルロイヤル", "event_category": "History", "mission_id": 920095, "map_no": 5207, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 1250, "base_hp": 3000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 118, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111376, "special_effect_id": 185, "master_id": 30567, "global_id": 4186, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "hp": 20000, "attack": 1750, "base_hp": 20000, "base_attack": 1750, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2108976, "race_id": 8, "change_to": 2, "change_condition": 3, "master_id": 30607, "global_id": 4226, "to_condition": 3, "to_global_id": 4227, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 3500, "base_hp": 20000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108992, "race_id": 8, "special_effect_id": 222, "master_id": 30608, "global_id": 4227, "from_condition": 3}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 1000, "base_hp": 40000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 350, "magic_defense": 60, "attack_range": 230, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100720, "race_id": 2, "special_effect_id": 232, "missile_id": 6, "master_id": 280, "global_id": 279, "ranged": true, "spawn_sec": 17}, {"enemy_id": 5, "source": "local", "count": 8, "form_count": 1, "hp": 15000, "attack": 1750, "base_hp": 15000, "base_attack": 1750, "damage_type": "physical", "armor_defense": 750, "magic_defense": 30, "attack_speed": 50, "attack_interval": 111, "move_speed": 400.0, "dot_rate": 1.5, "pattern_id": 2104256, "race_id": 14, "special_effect_id": 230, "master_id": 30575, "global_id": 4194, "spawn_sec": 47}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 3000, "base_hp": 30000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 50, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104224, "race_id": 14, "special_effect_id": 186, "master_id": 30574, "global_id": 4193, "spawn_sec": 74}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 1850, "base_hp": 9000, "base_attack": 1850, "damage_type": "physical", "armor_defense": 450, "magic_defense": 30, "attack_speed": 50, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104208, "race_id": 14, "special_effect_id": 127, "master_id": 30572, "global_id": 4191, "spawn_sec": 79}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 35000, "attack": 1800, "base_hp": 35000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 84, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111568, "master_id": 30601, "global_id": 4220, "spawn_sec": 89}, {"enemy_id": 9, "source": "local", "count": 10, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 92}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 900, "base_hp": 40000, "base_attack": 900, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 190, "attack_speed": 50, "attack_wait": 10, "attack_interval": 86, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103488, "race_id": 3, "special_effect_id": 232, "change_to": 10, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 449, "global_id": 448, "ranged": true, "variants": [{"hp": 40000, "attack": 2200, "base_hp": 40000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 70, "attack_speed": 50, "attack_wait": 30, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103504, "race_id": 3, "master_id": 450, "global_id": 449}], "spawn_sec": 104}], "dialogue": [{"trigger": "start", "lines": [{"name": "アナトリア", "text": "……いよいよだね。こんなに\nワクワクするのは、随分久しぶりだよ。", "face": "u522"}, {"name": "アナトリア", "text": "「魔界武術大会」で剣を交えて以来、\nあんたとはずっと戦ってみたいって思ってたのさ。", "face": "u522"}, {"name": "アンナ", "text": "……はい！\n私たちも全力で行きます！"}, {"name": "アナトリア", "text": "仲間達もいい気迫だね。\n遠慮せず、何人だろうとかかってきな！\n……それじゃあ、行くよッ！", "face": "u522"}]}, {"trigger": "battle", "at_sec": 22, "lines": [{"name": "大長老", "text": "人間め、見つけたぞ。\n今度こそ、貴様等を始末してくれる！", "face": "l0fc1d2d22ea2"}, {"name": "牛頭の魔物（兄）", "text": "オレが他の種族に負けるハズなど無いのだ……！\n邪魔するヤツは全部潰ス！　ブッ潰シテヤル！", "face": "lc2a50ebae7ce"}, {"name": "大長老", "text": "試合中結託し相手を襲う事は禁じられてはおらん。\n我らで手を組めば、人間など造作もないわ。\n後ろは任せたぞ、シャディア！", "face": "l0fc1d2d22ea2"}, {"name": "シャディア", "text": "……あぁ、任せておけ。", "face": "u713"}]}, {"trigger": "end", "lines": [{"name": "大長老", "text": "――く、くそっ、ぬかったか……。\nこの傷では満足に戦えぬ、\n一度退き態勢を整えようぞ……。", "face": "l0fc1d2d22ea2"}, {"name": "牛頭の魔物（兄）", "text": "グモモモ、一度ならず二度までも。\nこの俺が……この俺があんな奴らに、\n負けるわけが……！", "face": "lc2a50ebae7ce"}, {"name": "アナトリア", "text": "……ったく別チーム同士で手を組むなんて、\nセコい事考えるもんだね。あんた等それでも男かい。　\n素直に負けを認めて出直してきな！", "face": "u522"}, {"name": "シャディア", "text": "……。", "face": "u713"}, {"name": "大長老", "text": "……む？　シャディア。\n剣をとりだしてどうするつもりだ。\nここは退いたほうが得策ぞ。", "face": "l0fc1d2d22ea2"}, {"name": "大長老", "text": "とりあえず撤退――……グハァッ！？　", "face": "l0fc1d2d22ea2"}, {"name": "牛頭の魔物（兄）", "text": "しゃ、シャディア！？！\n貴様、俺達を裏切り……ブフォァッ！？", "face": "lc2a50ebae7ce"}, {"name": "アンナ", "text": "そんな……味方に剣を突き立てるなんて。", "face": "l3cef686ba4a9"}, {"name": "シャディア", "text": "これでメダルが1800枚。\n……わたしの優勝だ。", "face": "u713"}, {"name": "ガード", "text": "――勝負あり、竜族、牛頭チーム代表の絶命を確認。\nよって、二名を殺害した者に\n勝利メダル1800枚を付与……優勝とする！", "face": "l719e661baad6"}, {"name": "ガード", "text": "……優勝者には褒美を取らせよう。\n勝者よ、願いを言うが良い。", "face": "l719e661baad6"}, {"name": "シャディア", "text": "ガード様、ありがたき光栄です……然らば、\n私めをガード様同様、魔王様の側近へと\n取り立てて頂きたく思います。", "face": "u713"}, {"name": "ガード", "text": "ほう、魔王様の親衛隊にか……技術は申し分ない、\n目的の為であれば、ためらいなく相手を殺すその覚悟……\n……なるほど面白い。", "face": "l719e661baad6"}, {"name": "ガード", "text": "今大会は、魔王様の側近たりえる実力者の\n選出も兼ねていたところだ。志願すると言うのであれば\n手間も省けよう。良かろう、我について来い！", "face": "l719e661baad6"}, {"name": "アナトリア", "text": "――……魔王親衛隊たちは去ったようだね。\n今世の強者達との純粋な戦いを期待していたが……\n……ま、終わったもんはしょうがないか。あたしも行くよ。", "face": "u522"}, {"name": "ラクシャーサ", "text": "アナトリアの気配を感じて来たものの、\n既に優勝は決まってしまっていたか。", "face": "u306"}, {"name": "メフィスト", "text": "私の知識を越えた想定外の事態に\n絶望を感じている……。\nだが、運命は受け入れるしかあるまい。", "face": "u526"}, {"name": "メフィスト", "text": "さて、大会が終わったとなればここに用はないな。\n物質界にでも戻るとするか。", "face": "u526"}, {"name": "メフィスト", "text": "物質界の知識はまだまだ探求のしがいがある。それに\n長い間軍団長が軍を離れるのは良くないようだしな。\n久しぶりに、あの仏頂面でも拝みに行くとしよう。", "face": "u526"}, {"name": "アンナ", "text": "大会が終わり、皆さん帰ってしまわれましたね。\nアナトリアさんとの戦いも有耶無耶に\n終わってしまい残念です……あれ？　この手紙は……？", "face": "l3cef686ba4a9"}]}], "story_talk": true, "active": true}