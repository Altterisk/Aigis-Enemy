00, "base_hp": 13000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_range": 170, "attack_speed": 60, "attack_wait": 80, "attack_interval": 261, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101472, "race_id": 3, "special_effect_id": 232, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 305, "global_id": 304, "ranged": true, "spawn_sec": 147}, {"enemy_id": 27, "source": "local", "count": 5, "level": 130, "form_count": 1, "hp": 100000, "attack": 2500, "base_hp": 100000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 100, "attack_speed": 20, "attack_wait": 80, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105024, "special_effect_id": 67, "missile_id": 58, "master_id": 592, "global_id": 591, "ranged": true, "spawn_sec": 155}, {"enemy_id": 28, "source": "local", "count": 4, "form_count": 1, "hp": 9000, "attack": 800, "base_hp": 9000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114592, "race_id": 14, "change_to": 28, "change_condition": 3, "master_id": 31017, "global_id": 4636, "spawn_sec": 195}], "popups": ["ワーラットの\n一定範囲内のユニットは\n継続ダメージを受けます。", "ベビートロル、トロル、\nエルダートロルは、\nHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "トットン", "text": "ドンドコドンドコ！\nドンドコドンドコ！！", "face": "u2405a1"}, {"name": "アミー", "text": "ジャンジャカジャカジャン！\nジャカジャカジャーン！", "face": "u2260a1"}, {"name": "市民Ａ", "text": "すげぇ、吟遊詩人なのに、\nあいつら全然吟遊しねぇ……！", "face": "l908d2b1ccc74"}, {"name": "市民Ｂ", "text": "音だけで聴かせるあの技術……。\nまだ若いのに大したもんだ。", "face": "l459a625f9814"}, {"name": "アミー", "text": "みんなー！　ありがとー！\n帝国式ドラムとのコラボでしたー！", "face": "u2260a1"}, {"name": "トットン", "text": "はぁ、はぁ……。\nなるほど、いいギターでした。\nでも私の本気はここからですからね！", "face": "u2405a1"}, {"name": "コハル", "text": "いやぁ、すごい熱狂だ。\nどうだいホルミース、\n混ざりたくなってきたんじゃないかい？", "face": "u450"}, {"name": "ホルミース", "text": "御冗談を。\nあなたを差し置いて飛び入り参加など。", "face": "u2292a1"}, {"name": "コハル", "text": "おっと、高く買われたのか、\nはたまた言い訳に使われたのか。", "face": "u450"}, {"name": "コハル", "text": "でも確かに、今日の主役はあたしらじゃない。", "face": "u450"}, {"name": "ホルミース", "text": "えぇ、あの子の演奏、\n最近のお気に入りなんですよ。", "face": "u2292a1"}, {"name": "コハル", "text": "王国にも、まだまだいい音楽家がいる。\nさぁ、聴かせてもらおうかな。", "face": "u450"}, {"name": "アミー", "text": "よし、本日の主役の到着でーす！\n王国在住、酒場の花！\nぽわぽわ系吟遊詩人、プルーシア！", "face": "u2260a1"}, {"name": "プルーシア", "text": "えぇと……よろしくお願いします？", "face": "u2514a1"}, {"name": "フィリス", "text": "ところで、何か騒がしくないか？", "face": "u40"}, {"name": "キャリー", "text": "えっ？　あれ？　確かに？\n――って、どこからか魔物が！？", "face": "u26"}, {"name": "コハル", "text": "いい音楽は種族の壁すらも超える、か。\nでも、ステージへの乱入はいただけない。", "face": "u450"}, {"name": "ホルミース", "text": "皆さん、今日の主役たちと、音楽を守りますよ。\n戦闘――いえ、ダンスの準備を。", "face": "u2292a1"}]}, {"trigger": "end", "lines": [{"name": "アミー", "text": "いえーい！　みなさーん！\nありがとうございましたー！", "face": "u2260a1"}, {"name": "トットン", "text": "さぁ次ですよ次！\n王国の大地をドンドコさせましょう！", "face": "u2405a1"}, {"name": "アミー", "text": "ねぇ、どうでした？\nセッションも楽しいですよね？", "face": "u2260a1"}, {"name": "プルーシア", "text": "えぇ、とても。\nでも……私なんかが、\nこんな大きなステージで歌って良いのでしょうか……？", "face": "u2514a1"}, {"name": "アミー", "text": "何をいまさらー。", "face": "u2260a1"}, {"name": "トットン", "text": "王子様だって聴きに来てるんだから、\nもうほんといまさらですねー。", "face": "u2405a1"}, {"name": "プルーシア", "text": "えっ、えぇっ！？\n王子様って……王国の、王子の……。", "face": "u2514a1"}, {"name": "アミー", "text": "うん。", "face": "u2260a1"}, {"name": "トットン", "text": "そう。", "face": "u2405a1"}, {"name": "ホルミース", "text": "その王子ですね。", "face": "u2292a1"}, {"name": "コハル", "text": "べべん♪", "face": "u450"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "コハル", "text": "さぁプルーシア、\n観客たる王子が次の曲をご所望だよ。", "face": "u450"}, {"name": "プルーシア", "text": "は、はい！\nでは……聴いてください。次の曲は――", "face": "u2514a1"}]}], "active": true}