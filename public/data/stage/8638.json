{"quest_id": 8638, "name": "音楽家の宴", "description": "酒場でセッションする吟遊詩人たち。\nすると音楽に誘われる様に魔物が現れて！？\n＜敵の移動速度アップ＞\n神級EX（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["敵の移動速度アップ"], "event": "導きの白狼", "event_category": "History", "mission_id": 920236, "map_no": 9386, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "modifiers": [{"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 45, "attack_interval": 245, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2162560, "race_id": 9, "master_id": 39003, "global_id": 12620, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 45, "attack_interval": 245, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2162416, "race_id": 16, "master_id": 39004, "global_id": 12621, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 45, "attack_interval": 245, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2162432, "race_id": 16, "master_id": 39005, "global_id": 12622, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}}, {"en