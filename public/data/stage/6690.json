{"quest_id": 6690, "name": "惑わされし獣たち", "description": "事件の黒幕、女王アリに誘惑された\n獣たちが押し寄せる！　更には怪力を誇る\n白い魔物の姿も目撃されていて……？\n神級（★１獲得の目安：平均Lv50）", "event": "誘惑のバレンタイン戦線", "event_category": "History", "mission_id": 920122, "map_no": 3347, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 19, "form_count": 1, "hp": 2000, "attack": 550, "base_hp": 2000, "base_attack": 550, "damage_type": "physical", "armor_defense": 800, "attack_speed": 60, "attack_wait": 10, "attack_interval": 116, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098496, "race_id": 12, "master_id": 100, "global_id": 99, "spawn_sec": 29}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "hp": 12000, "attack": 3900, "base_hp": 12000, "base_attack": 3900, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2117264, "race_id": 9, "master_id": 31497, "global_id": 5116, "spawn_sec": 53}, {"enemy_id": 4, "source": "local", "count": 15, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 65}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 30000, "attack": 1100, "base_hp": 30000, "base_attack": 1100, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103568, "race_id": 12, "master_id": 456, "global_id": 455, "spawn_sec": 102}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 48, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112016, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30612, "global_id": 4231, "ranged": true, "spawn_sec": 109}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 70000, "attack": 2500, "base_hp": 70000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108064, "race_id": 12, "master_id": 972, "global_id": 971, "spawn_sec": 149}, {"enemy_id": 8, "source": "local", "count": 5, "form_count": 1, "hp": 2400, "attack": 650, "base_hp": 2400, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "master_id": 24, "global_id": 23, "spawn_sec": 158}], "dialogue": [{"trigger": "start", "lines": [{"name": "ラテリア", "text": "――皆、こっちだよ。\nもうここまで臭ってくる……獣の臭いだ……。", "face": "u532"}, {"name": "ケイティ", "text": "どうやら報告どおり、雄の獣や獣人ばかりのようです。\n種族に関係なくあらゆる男性を虜にする、\n女王アリのフェロモン……やはり厄介な能力ですね。", "face": "u114"}, {"name": "ラテリア", "text": "ほんとにね。ミノタウロスにケンタウロスみたいな、\n本来この場所には棲息していない連中まで混じってる。", "face": "u532"}, {"name": "フィリス", "text": "雄なら見境なしってことか……。\nちょっと強力過ぎないか、フェロモンとやら。", "face": "u40"}, {"name": "レアン", "text": "それに報告では、\n獣達までチョコレートを狙っているらしいじゃないか。\n獣の本能じゃなく、女王アリの命令が優先ってことか。", "face": "u50"}, {"name": "ケイティ", "text": "操られた獣も厄介ですが、魔物の中に\n恐ろしい剛腕を誇る白い魔物もいたとのことです。\n詳細は不明ですが、注意が必要でしょう。", "face": "u114"}, {"name": "レアン", "text": "剛腕の、白い魔物……？\n報告にあった獣人、ワーウルフじゃないのか？", "face": "u50"}, {"name": "ケイティ", "text": "偵察兵の話ではずっと小柄な魔物で、\n油断から応戦しようと試み、敗走したとの事です。\n緊急治療となった為、詳細は聞けなかったのですが……。", "face": "u114"}, {"name": "ケイティ", "text": "ともあれ、魔物の群れには件の白い魔物に加え、\nミノタウロスのような膂力を誇る個体が多いようです。\n近接戦闘は避け、遠距離戦を主体にするのが良いかと。", "face": "u114"}, {"name": "ラテリア", "text": "――おっと、話している内に\n獣達が近付いてきたみたいだ。\n正体不明の魔物もいるはず、十分に警戒するんだよ。", "face": "u532"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "女王アリに操られていた白い魔物とは、\nあなた達だったのですね。"}, {"name": "気弱な魔物", "text": "アリガトウ。胸ノドキドキ、治ッタ。\nマタ、助ケテモラッタ。襲ッテゴメン、アリガトウ。", "face": "l36790e5b895d"}, {"name": "フィリス", "text": "胸の、どきどき？\nひょっとして、女王アリに恋させられてたってことかな？", "face": "u40"}, {"name": "気弱な魔物", "text": "ムリヤリ、ヒドイ。\n王子タチ、助ケテクレタ、ヤッパリイイヒト！\nオ礼、シタイ。イツカ、チョコレート作ッテ、オクル！", "face": "l36790e5b895d"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "気弱な魔物", "text": "オ礼、イラナイ？", "face": "l36790e5b895d"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "気弱な魔物", "text": "スバラシク、ケンキョ……ッ！", "face": "l36790e5b895d"}, {"name": "アンナ", "text": "さぁ、気をつけて家まで帰るんですよ？\nもう女王アリに見つからないように。"}, {"name": "気弱な魔物", "text": "アリガトウ！　ゴ恩、忘レナイ！　バイバイ！", "face": "l36790e5b895d"}, {"name": "アンナ", "text": "無害な魔物まで尖兵にするとは、\nやはり女王アリを捨て置くことは出来ませんね。\n急ぎ、反撃の準備を整えましょう。", "face": "l307fe93ca6aa"}]}], "story_talk": true, "active": true}