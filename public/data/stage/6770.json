0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 98}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "――我らが前線基地に、\n自らやってくるとは……！！\nそれほどまでに闘争を求めていたのだな、王子よ！！", "face": "l6ab6d1d5f357"}, {"name": "セブン", "text": "……まさかオークの\n前線基地に行き当たるなんてなぁ。", "face": "u449"}, {"name": "バシラ", "text": "近道をしようとしたのが、\n裏目に出ちゃいましたね……。", "face": "u28"}, {"name": "アイリーン", "text": "残念ながら、ここへ来たのは\n先へ進むための近道としてなのです。\nどうか道を開けてはいただけませんか？", "face": "u315"}, {"name": "オーク", "text": "む……そうなのか……。\n我らと同じく、\n強者との戦いを求めていたとばかり……。", "face": "l6ab6d1d5f357"}, {"name": "オーク", "text": "だが！　王子と戦えるというこの好機、\n決して逃すわけにはいかぬ……！！", "face": "l6ab6d1d5f357"}, {"name": "セブン", "text": "ちっ、これだから頭まで\n筋肉で出来てる奴は嫌なんだ。", "face": "u449"}, {"name": "アンナ", "text": "仕方ありません……。\n時間はありませんが、応戦するしかなさそうですね。\n王子、急ぎ戦闘の準備をお願いします！", "face": "l48eabfbe0a77"}]}, {"trigger": "end", "lines": [{"name": "オーク", "text": "嗚呼……良き闘争であった……ぐふっ……。", "face": "l6ab6d1d5f357"}, {"name": "セブン", "text": "ふぃー……まったく困った連中だ。\nおい、この辺で怪しい奴を見かけなかったか？", "face": "u449"}, {"name": "オーク", "text": "怪しい連中……？\nそうだな、白い獣人と、それを追う集団がいたと、\n警備に出ていた戦士達が言っていたな……。", "face": "l6ab6d1d5f357"}, {"name": "セブン", "text": "よし、ここに来たのも無駄足じゃなさそうだな。\n王子、急ごうぜ！", "face": "u449"}, {"name": "オーク", "text": "……待たれよ。\nならばあちらの道を行け、強き者達よ。\nおそらくかなりの距離を詰められるはずだ。", "face": "l6ab6d1d5f357"}, {"name": "バシラ", "text": "……なぜそんなことを教えてくれるんです？", "face": "u28"}, {"name": "オーク", "text": "勝者には報酬があるべきだ。\n良き闘争への感謝と思え。\nだが、次は負けぬぞ、王子よ……！！", "face": "l6ab6d1d5f357"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}