ense": 15, "attack_range": 240, "attack_speed": 60, "attack_wait": 20, "attack_interval": 97, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2154736, "race_id": 16, "special_effect_id": 1762, "missile_id": 1122, "missile": {"speed": 8.0}, "master_id": 37797, "global_id": 11414, "ranged": true, "spawn_sec": 113}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5250, "attack": 750, "base_hp": 5250, "base_attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 97, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123792, "race_id": 7, "missile_id": 45, "master_id": 32765, "global_id": 6383, "ranged": true, "spawn_sec": 133}, {"enemy_id": 15, "source": "local", "count": 6, "form_count": 2, "tags": ["水棲", "ブロック不可"], "hp": 24000, "attack": 1300, "base_hp": 24000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132528, "race_id": 2, "change_to": 15, "master_id": 37795, "global_id": 11412, "to_global_id": 11413, "route_behaviour": {"transforms": [{"wait": 100}]}, "spawn_sec": 201}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 24000, "attack": 900, "base_hp": 24000, "base_attack": 900, "damage_type": "magical", "armor_defense": 200, "magic_defense": 5, "attack_range": 240, "attack_speed": 1, "attack_wait": 42, "attack_interval": 131, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132448, "race_id": 2, "special_effect_id": 947, "change_to": 14, "missile_id": 227, "missile": {"speed": 4.0}, "master_id": 37796, "global_id": 11413, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "アトランティスの巨人兵", "text": "――アトランティス、全機能の３０％が正常動作。\n現在、巡航速度にて浮上中です。", "face": "l6b6d860e92b3"}, {"name": "ヴェロッテ", "text": "がぼぼごぼぼぼぼっ！？\nげほっ、けほっ、巡航！？　この速さで巡航速度！？", "face": "u150"}, {"name": "モーレット", "text": "外に顔出しちゃダメだよぉ！？\nここで投げ出されたら絶対助からないって！！", "face": "u231"}, {"name": "ミネルバ", "text": "……まったく、\nアトランティスの実在にも驚いたけど。", "face": "u91"}, {"name": "ベアトリカ", "text": "そいつが今でも、マトモに動くだなんてなァ。", "face": "u157"}, {"name": "ティマ", "text": "私たちが守ってきたんですから、当たり前です！\nそれもこれも、すべては正当後継者たる、\nデューオさまがご帰還なさる日のために……！！", "face": "u2172a1"}, {"name": "デューオ", "text": "わ、分かったから！\nそんなに畏まらないでって！", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "――警告。\n直上より急速接近する魔力反応あり。", "face": "l6b6d860e92b3"}, {"name": "エフトラ", "text": "魔力反応……？　個体識別はできますか？", "face": "u1468a1"}, {"name": "アトランティスの巨人兵", "text": "不明。敵味方識別コードも確認できません。\nこのまま浮上を継続しますか？", "face": "l6b6d860e92b3"}, {"name": "イブキ", "text": "いや、それはまずい。\nあの巨体……あいつは――！！", "face": "u511"}, {"name": "ジーラトス", "text": "ヌゥゥゥゥゥゥゥゥンッ！！\nウォォォッ、ヌゥゥゥオオォォォォォォッ！！", "face": "lffd1d707545a"}, {"name": "ジーラトス", "text": "王子ぃぃぃぃぃッ！！\n見ぃつけたぁぁぁぁッ！！\nメシナ様を返してもらうぞぉぉぉぉッ！！", "face": "lffd1d707545a"}, {"name": "メシナ", "text": "ジーラトス！？\nあなた……いったいどうしましたの！？", "face": "u1506a1"}, {"name": "フローガ", "text": "完全に魔力が暴走しています！\nあれでは……もう自我もほとんど残っていないはず……。", "face": "u878"}, {"name": "デューオ", "text": "……アトランティス、減速！　速度落として！！\nあいつを乗せたまま浮上なんて危険すぎる！！", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "了解しました。\nアトランティス、速度減少します。\n――デューオ様、ご武運を。", "face": "l6b6d860e92b3"}, {"name": "リーンベル", "text": "水圧の影響は深海より軽いですが、ここはまだ海の中。\n王子、兵への指示には十分に注意を！", "face": "u268"}]}, {"trigger": "end", "lines": [{"name": "ジーラトス", "text": "ヌゥゥゥゥン……ッ！！\nそれがしは……それがしはぁ……深海の民を守る、\n正義の……戦士にぃ……ッ！！", "face": "lffd1d707545a"}, {"name": "ジーラトス", "text": "メシナさまぁ……どうかお戻りを……。\nそれで全てがァ……元通りに……ヌゥッ、ヌォォッ！", "face": "lffd1d707545a"}, {"name": "メシナ", "text": "酷い……お父さまに、無理やり枷を外されましたのね。", "face": "u1506a1"}, {"name": "ポセイオス", "text": "ふむ……何が無理やりなものか。\n荒ぶる神、破壊と憤怒こそジーラトスの本性。\nそれを少しばかり、解放してやったにすぎぬ。", "face": "la5e61108d315"}, {"name": "デューオ", "text": "ポセイオス……！\nふんっ、もうお前の好きにはさせないからね！", "face": "u594"}, {"name": "デューオ", "text": "アトランティスは浮上中だ！\n海の創造者たるお前も、\n深海を離れれば本来の力が出せないだろ！", "face": "u594"}, {"name": "ポセイオス", "text": "グワッハッハッハ！！\nなるほど、アトランティス浮上は\n貴様の計略か、アトランティスの生き残りが！", "face": "la5e61108d315"}, {"name": "ポセイオス", "text": "やはりあの時、皆殺しにしておくべきだったか……。\nしかし、まぁよい……。\nここで貴様らの命は散るのだからのう。", "face": "la5e61108d315"}, {"name": "ティマ", "text": "…………っ。\nえっと、アトランティスの巨人兵さん？\n海面はまだ？　どれくらい耐えれば……。", "face": "u2172a1"}, {"name": "アトランティスの巨人兵", "text": "減速中のため、まだ全行程の８０％程度です。\n加速する場合にはデューオ様の命令が必要です。", "face": "l6b6d860e92b3"}, {"name": "リーンベル", "text": "いや……だめだ。\nこのままポセイオスと戦闘になるのなら、\n不安定な戦場ではこちらが不利になる。", "face": "u268"}, {"name": "キュステ", "text": "うぅぅ、こんなことなら\n潜水鎧を量産してもらえばぁ……！", "face": "u1248a1"}, {"name": "ヴィアベル", "text": "そんな簡単に量産できる鎧ではないから……。\nそれよりキュステ、覚悟はできてる？", "face": "u1247a1"}, {"name": "キュステ", "text": "か、かくご……？", "face": "u1248a1"}, {"name": "ヴィアベル", "text": "……おーけい、分かった。\nキュステ、あなたは魚人と協力して王子を逃がして！", "face": "u1247a1"}, {"name": "ヴィアベル", "text": "アトランティスが完全浮上すれば、\n勝機は王子さまの方にある。\nここは――潜水騎士の誇りにかけて、私が止める！！", "face": "u1247a1"}, {"name": "オーベッド", "text": "乾いた地の民だけに、命をかけさせるわけにはいくまい。\n背中は任せてもらおう。", "face": "u1122a1"}, {"name": "リバン", "text": "そのとおりですわ。\nこの戦いこそ、未来の海の運命がかかった決戦ですもの。", "face": "u1062a1"}, {"name": "キュステ", "text": "なっ、なっ、何言ってるんですかー！\n殿下！　王子殿下！　みんなを止めてください！！", "face": "u1248a1"}, {"name": "王子", "text": "……………。", "face": "u1"}, {"name": "リトヴァ", "text": "わっ、お、王子さま……？", "face": "u1308a1"}, {"name": "ムイル", "text": "下がるどころか……ふふっ、あらまぁ。\n誰より前に出てくるなんて。", "face": "u1419a1"}, {"name": "ポセイオス", "text": "我が前に立つか、王子よ！\nそれでこそ我が愛玩物に加わるにふさわしい男よ！", "face": "la5e61108d315"}]}], "hard": {"level": 140, "multiplier": 1.4, "modifiers": [{"kind": "term", "influence": 18, "params": [160]}, {"kind": "term", "influence": 20, "params": [200]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 8400, "attack": 840, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 2, "hp": 630000, "attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128896}, {"enemy_id": 2, "form_index": 1, "hp": 630000, "attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128912}, {"enemy_id": 2, "form_index": 2, "hp": 630000, "attack": 10000, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128928}, {"enemy_id": 2, "form_index": 3, "hp": 630000, "attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128880}, {"enemy_id": 2, "form_index": 4, "hp": 630000, "attack": 5000, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128880}, {"enemy_id": 7, "hp": 630000, "attack": 1, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2128944}, {"enemy_id": 7, "form_index": 1, "hp": 630000, "attack": 1, "damage_type": "physical", "armor_defense": 800, "magic_defense": 40, "pattern_id": 2128960}, {"enemy_id": 9, "hp": 8400, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 9, "form_index": 1, "hp": 8400, "attack": 840, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 10, "hp": 14000, "attack": 800, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "pattern_id": 2153376}, {"enemy_id": 10, "form_index": 1, "hp": 14000, "attack": 800, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "pattern_id": 2153376}, {"enemy_id": 12, "hp": 182000, "attack": 5040, "da