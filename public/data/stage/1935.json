{"quest_id": 1935, "name": "浮上するアトランティス", "description": "アトランティスの浮上を阻むように現れた\n荒ぶる亜神ジーラトスを打ち破れ！\n＜深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション11", "event_category": "Story", "mission_id": 100011, "map_no": 1155, "level": 100, "multiplier": 1.0, "charisma": 58, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 5, "tags": ["水中", "ジーラトス"], "hp": 450000, "attack": 1, "base_hp": 450000, "base_attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "attack_interval": 69, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2128896, "race_id": 19, "special_effect_id": 799, "change_to": 2, "missile_id": 542, "missile": {"speed": 17.0}, "master_id": 33730, "global_id": 7347, "to_global_id": 7348, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \" if( IsStageFlag( 27) == 0 ){ SetStageFlag(27, 1);}\");", "sets_flags": [[27, 1]], "on_destroy": true}, "route_behaviour": {"sets_flags": [[20, 1, 0]]}, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 5, "tags": ["水中", "ジーラトス"], "hp": 450000, "attack": 1, "base_hp": 450000, "base_attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "attack_interval": 69,