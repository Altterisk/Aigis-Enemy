37854, "global_id": 11471, "from_condition": 3, "to_condition": 6, "to_global_id": 11472}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 28000, "attack": 1000, "base_hp": 28000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 98, "move_speed": 3000.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2155616, "race_id": 11, "special_effect_id": 1795, "master_id": 37855, "global_id": 11472, "from_condition": 6}, {"enemy_id": 5, "source": "local", "count": 23, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110064, "race_id": 12, "special_effect_id": 168, "master_id": 37856, "global_id": 11473, "spawn_sec": 7}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 115, "attack_wait": 100, "attack_interval": 401, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109424, "race_id": 13, "master_id": 37857, "global_id": 11474, "spawn_sec": 72}, {"enemy_id": 7, "source": "local", "count": 16, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 90}, {"enemy_id": 8, "source": "local", "count": 9, "form_count": 1, "tags": ["ステルス"], "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "physical", "armor_defense": 550, "magic_defense": 10, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099568, "master_id": 11, "spawn_sec": 124}], "popups": ["ワーラットの\n一定範囲内のユニットは\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アイネ", "text": "──二試合目の挑戦者を発表しましょう。", "face": "u2262a1"}, {"name": "アイネ", "text": "魔界より現れたるは漆黒の肉食獣。\n強靭な肉体から繰り出される鋭い爪は、\n鋼鉄の鎧をなますのように切り裂きます。", "face": "u2262a1"}, {"name": "アイネ", "text": "彼らは自らをこう名乗りました。\n偉大なるイタチ、摩訶イタチと──", "face": "u2262a1"}, {"name": "ヨシノ", "text": "魔界のイタチでまかいたち？\nそれならこっちはかまいたちだー。\n物質界の力を見せてやれ、群青姉妹！　", "face": "u1104a1"}, {"name": "群青姉妹 トキ", "text": "偉い人からのご指名だよお姉ちゃん。", "face": "l2ae70660f3f1"}, {"name": "群青姉妹 ユキ", "text": "王子様に良いところ見せるチャンスだよお姉ちゃん！", "face": "lcd1598aeedaf"}, {"name": "群青姉妹 ヤエ", "text": "おおおおお姉ちゃんに任せなさい──って、\nどうして私が一人で戦う流れになってるのよ！？", "face": "u1448a1"}, {"name": "群青姉妹 トキ", "text": "お姉ちゃんは最強だから一人で大丈夫だよー。", "face": "l2ae70660f3f1"}, {"name": "群青姉妹 ユキ", "text": "姉より優れた妹は存在しないんだよお姉ちゃん！", "face": "lcd1598aeedaf"}, {"name": "群青姉妹 ヤエ", "text": "かまいたちは三人揃ってこそでしょうが！", "face": "u1448a1"}, {"name": "シズカ", "text": "ちょっと！　敵の前で姉妹漫才してる暇ないわよ！", "face": "u101"}]}, {"trigger": "start", "lines": [{"name": "群青姉妹 ユキ", "text": "ぎゃー！？　このイタチ二本足で走ってるー！？", "face": "lcd1598aeedaf"}, {"name": "群青姉妹 ヤエ", "text": "それは私たちもだけどね！？", "face": "u1448a1"}, {"name": "群青姉妹 トキ", "text": "たーすーけーてー。", "face": "l2ae70660f3f1"}, {"name": "シノ", "text": "………………。", "face": "u403"}, {"name": "ヨユキ", "text": "……金糸雀か紫苑呼んでこよっか？", "face": "u1325a1"}, {"name": "アイネ", "text": "（さて、お手並み拝見といったところですね）", "face": "u2262a1"}, {"name": "アイネ", "text": "（摩訶イタチは傷つくほどに凶暴性を増し、\n疾風のような速さで戦場を駆け抜ける難敵──）", "face": "u2262a1"}, {"name": "アイネ", "text": "王子、あなたは風にどう立ち向かいますか？", "face": "u2262a1"}]}, {"trigger": "end", "lines": [{"name": "アイネ", "text": "ふむ、摩訶イタチを破るとは本物ですね。", "face": "u2262a1"}, {"name": "アイネ", "text": "これは私もさすがに認めざるを得ませんね、\n王国は戦神の加護を得るに相応しい存在だと。", "face": "u2262a1"}, {"name": "ウルカノ", "text": "逆に今まで認めてなかったのかよ。", "face": "u1669a1"}, {"name": "アイネ", "text": "当然、物の真贋は自らの目で判断する主義です。", "face": "u2262a1"}, {"name": "アイネ", "text": "あなた方とて市井の流れる噂や伝聞だけで、\n己という存在を理解されたくはないでしょう？", "face": "u2262a1"}, {"name": "コレット", "text": "（ぐふっ！？）", "face": "u1615a1"}, {"name": "ウルカノ", "text": "まあ、それはその通りなんだがなぁ。", "face": "u1669a1"}, {"name": "プロエ", "text": "すまない、彼女はこういうところがある。", "face": "u1768a1"}, {"name": "アイネ", "text": "こういうところとはなんですか。\n他者への評価は先入観を含まず適切にすること。\n偉大なる戦神に仕える者としての義務です。", "face": "u2262a1"}, {"name": "アイネ", "text": "さあ、次の会場へ向かいましょう。\nそこに最後の挑戦者が待っています。", "face": "u2262a1"}]}, {"trigger": "end", "lines": [{"name": "ヨシノ", "text": "……そういえば群青姉妹は？", "face": "u1104a1"}, {"name": "シズカ", "text": "向こうでシノにお説教されてる。", "face": "u101"}]}], "active": true}