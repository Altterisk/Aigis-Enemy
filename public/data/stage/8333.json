{"quest_id": 8333, "name": "天の磐船", "description": "天の磐船を危険視する月神に、\n実力を示すべく王子たちは戦いを挑む。\nツクヨミの手勢を相手に勝利を掴め！\n神級（★１獲得の目安：平均Lv50）", "event": "天墜の神と天翔の船", "event_category": "History", "mission_id": 920219, "map_no": 4930, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 8, "form_count": 2, "tags": ["アンデッド"], "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 60, "attack_wait": 40, "attack_interval": 201, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099376, "change_to": 2, "change_condition": 3, "master_id": 143, "global_id": 142, "to_condition": 3, "to_global_id": 143, "spawn_sec": 23}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 24, "attack_interval": 49, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099392, "special_effect_id": 222, "master_id": 144, "global_id": 143, "from_condition": 3}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "