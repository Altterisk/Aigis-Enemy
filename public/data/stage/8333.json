11424, "spawn_sec": 70}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 60, "attack_range": 30, "attack_speed": 1, "attack_wait": 90, "attack_interval": 234, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2149168, "race_id": 4, "special_effect_id": 72, "missile_id": 275, "missile": {"speed": 7.0}, "master_id": 37807, "global_id": 11424, "ranged": true, "from_condition": 5}, {"enemy_id": 9, "source": "local", "count": 9, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 15, "attack_speed": 60, "attack_wait": 40, "attack_interval": 201, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.850000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099408, "change_to": 9, "change_condition": 3, "master_id": 162, "global_id": 161, "to_condition": 3, "to_global_id": 162, "spawn_sec": 72}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_speed": 24, "attack_interval": 55, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.850000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099424, "special_effect_id": 222, "master_id": 163, "global_id": 162, "from_condition": 3}, {"enemy_id": 11, "source": "local", "count": 22, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 152, "global_id": 151, "spawn_sec": 74}, {"enemy_id": 12, "source": "local", "count": 8, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099456, "change_to": 12, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 300, "global_id": 299, "ranged": true, "to_condition": 3, "to_global_id": 300, "spawn_sec": 103}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099456, "special_effect_id": 248, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 301, "global_id": 300, "ranged": true, "from_condition": 3}, {"enemy_id": 14, "source": "local", "count": 20, "form_count": 1, "tags": ["ステルス"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113920, "master_id": 30917, "global_id": 4536, "spawn_sec": 159}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――来たか、侵入者ども。", "face": "l180b882679b6"}, {"name": "イヨ", "text": "ツクヨミ様……ですよね？\nお願いします、力を貸してください！", "face": "u1948a1"}, {"name": "ツクヨミ", "text": "……そう素直にお願いされると、\nさすがに拍子抜けしてしまうな。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "しかし、神代の遺物を人類に託すことはできない。\n「天の磐船」は、今の時代であってもなお、\n人類の手に余る存在なのだ。", "face": "l180b882679b6"}, {"name": "アラン", "text": "ツクヨミ、物質界の現状は把握しているのでしょう？\nあなたの愛する人類の成長、ディアスの目論見が\n成功すれば、永遠に失われるのですよ？", "face": "u1511a1"}, {"name": "ツクヨミ", "text": "アランか……。\n同じ月の神と言えど、肯定することはできない。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "これは空を征く船や、軍勢を運ぶ木馬とは、\nその本質からして異なるものなのだ。", "face": "l180b882679b6"}, {"name": "アラン", "text": "……破壊神の手によるもの、ということですか？", "face": "u1511a1"}, {"name": "ツクヨミ", "text": "――答えぬことを、答えと思ってくれて構わない。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "これはいわば、世界の壁を破壊するもの。\n女神ケラウノスが施した障壁どころか、\n物質界と天界の境界すら貫く船だ。", "face": "l180b882679b6"}, {"name": "レクテ", "text": "……それだ！　まさにそれが欲しいんだよー！", "face": "u2047a1"}, {"name": "プロメ", "text": "要塞宮殿は天界の超高空に存在するもの。\nあの場所に到達するには、\n高度と、世界の壁を同時に打ち破る船が必要ですからね。", "face": "u2150a1"}, {"name": "ツクヨミ", "text": "……プロメ、お前は私と\n同じ考え方をしていると思っていたが？", "face": "l180b882679b6"}, {"name": "プロメ", "text": "人類にはまだ早い、自分たちのその脚で、\n同じ技術の高みに至るまで待つべきだ、ですよね？", "face": "u2150a1"}, {"name": "プロメ", "text": "その考えは、今も変わりません。\nけれど――", "face": "u2150a1"}, {"name": "ツクヨミ", "text": "見守ると、決めたのか。", "face": "l180b882679b6"}, {"name": "プロメ", "text": "……はい。", "face": "u2150a1"}, {"name": "ツクヨミ", "text": "……困ったものだ、誰も彼も、人類に夢ばかり見て。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "良いだろう。\nならば最後に、その実力を我が前にて示せ。", "face": "l180b882679b6"}, {"name": "アラン", "text": "王子、気をつけてください。\nツクヨミはああ言っていますが、\nおそらく手加減するつもりはありません。", "face": "u1511a1"}, {"name": "アラン", "text": "人類の力、あの月神に見せてやってください。", "face": "u1511a1"}]}, {"trigger": "end", "lines": [{"name": "ツクヨミ", "text": "なるほど。\n決意を感じる戦い方だ。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "――しかし、天の磐船を譲ることはできない。", "face": "l180b882679b6"}, {"name": "ユリクセス", "text": "なっ……僕らの勝ちだろう！？\n素直に渡せ！　契約違反だぞ！", "face": "u2193a1"}, {"name": "アキレア", "text": "お前、こういう話の通じないやつ苦手だよな。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "うるさい！　理性と知性が通じないやつは嫌いなんだ！", "face": "u2193a1"}, {"name": "ツクヨミ", "text": "まぁ待て。\n貸さないとは言ってない。", "face": "l180b882679b6"}, {"name": "ユリクセス", "text": "……ほう？", "face": "u2193a1"}, {"name": "ツクヨミ", "text": "こちらから、管理者をひとり送り込む。\n人類への貸与ではなく、\n天の磐船を持った亜神を、そちらへ派遣するのだ。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "プロメ、私はお前ほど、\nすべての人類を信じることはできない。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "人は人と争うことで、切磋琢磨し、\n次なる時代を築いていくものだ。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "人の手に余る遺物など、\nいびつな進歩をもたらすだけだ。", "face": "l180b882679b6"}, {"name": "プロメ", "text": "……それでも信じたいというのだから、\n結論は、私と同じみたいですね？", "face": "u2150a1"}, {"name": "ツクヨミ", "text": "タカマガハラの神には、建前というものが必要なのだ。\n他の階層よりも、契約を重視するゆえな。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "さて、ちょうどタカマガハラに\n力を消耗して眠りこけているやつがいたな。\nかつての敵というものは、こういう時に使うものだ。", "face": "l180b882679b6"}, {"name": "イヨ", "text": "わっ、あのっ、ツクヨミさま！\nもう少しお話を……！", "face": "u1948a1"}, {"name": "ツクヨミ", "text": "……そのうちな。\n今は雑談に興じる時間も惜しかろう。", "face": "l180b882679b6"}, {"name": "イヨ", "text": "わっ……転送！？　どこかに飛ばされ――きゃー！？", "face": "u1948a1"}, {"name": "ツクヨミ", "text": "…………さて。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "王子よ、なにかと面倒をかけるな。", "face": "l180b882679b6"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ツクヨミ", "text": "神の片付けるべき問題を、\n人の手に委ねてしまっているだろう？", "face": "l180b882679b6"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ツクヨミ", "text": "ほう。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "しっかりと、理解しているようだな。\nお前にならば、神代の遺物も託せよう。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "人類には、世界を譲ったのだ。\n見事守り抜き、その未来を築き上げよ。", "face": "l180b882679b6"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ツクヨミ", "text": "…………。\n……………………。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "やはり、我らの選択は間違っていなかったぞ。\nタカマガハラの諸君。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "人の子らは、立派に己の道を選び、\nその両脚で歩み続けている。", "face": "l180b882679b6"}, {"name": "ツクヨミ", "text": "もう、我らの想像しえない未来にまで、\n人類は進んでいたのだな。", "face": "l180b882679b6"}]}], "active": true}