anged": true, "to_global_id": 533, "spawn_sec": 158}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 11, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117344, "race_id": 9, "special_effect_id": 349, "missile_id": 6, "master_id": 31516, "global_id": 5135, "ranged": true, "spawn_sec": 179}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117328, "race_id": 9, "special_effect_id": 349, "missile_id": 6, "master_id": 31515, "global_id": 5134, "ranged": true, "spawn_sec": 208}, {"enemy_id": 16, "source": "local", "count": 2, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 213}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 15, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}], "popups": ["ゴブリン騎獣楽団がいる間は\n敵のゴブリンの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "――はっ、あ、アイドルですか？", "face": "l453d6a10cf56"}, {"name": "ゴブリンプリンセス長女", "text": "えぇ、今や世界は超アイドル時代！\nトップアイドルを極めた者が、\n物質界のトップを制したも同然なのよ！", "face": "lbfcc255c30a8"}, {"name": "ゴブリンプリンセス次女", "text": "一番イケてるオンナが、\n一番イケてるアイドルに\nならなくてどうするのという話よ。", "face": "l8dd96367d320"}, {"name": "ゴブリンプリンセス三女", "text": "――つまり、ゴブリン族の物質界での\n地位を向上させようと日々努力している、\nお母様の一助になるべく頑張ろう、ということです。", "face": "l55d1da39a5a9"}, {"name": "ゴブリンプリンセス長女", "text": "おだまり三女！\nこれは打算じゃないのよ！", "face": "lbfcc255c30a8"}, {"name": "ゴブリンプリンセス次女", "text": "えぇ、世界はゴブリンアイドルが輝くためにあると！\n天界魔界冥界に物質界の果てまで響かせてやるのよ！！", "face": "l8dd96367d320"}, {"name": "ゴブリン博士", "text": "おぉ……なるホド……！！\nメカゴブリンクイーン様を想ってのその決意、\nグスッ……ワタクシ、受け止めましたゾ……！！", "face": "l453d6a10cf56"}, {"name": "ゴブリン博士", "text": "シカシ、フェスの出演は招待制……。\nワレワレには、ツテもコネも――", "face": "l453d6a10cf56"}, {"name": "ゴブリンプリンセス長女", "text": "ウフン、あるじゃない。\n王子に直接売り込みにいけばいいのよ……！！", "face": "lbfcc255c30a8"}]}, {"trigger": "start", "lines": [{"name": "ケイティ", "text": "――なるほど、それでこんなゲリラライブを。", "face": "u114"}, {"name": "ゴブリン博士", "text": "王子ヨ、プリンセスたちの魅力ヲ！\n直接王国へ届けにきたゾ……！！", "face": "l453d6a10cf56"}, {"name": "ゴブリン博士", "text": "ゴブリン軍団！\nプリンセス親衛隊の舞を見セヨ！！", "face": "l453d6a10cf56"}, {"name": "ゴブリン", "text": "ギャ！　ギャ！　ウォー！　ギャギャ！！", "face": "lc0766ec38378"}, {"name": "ゴブリンプリンセス長女", "text": "さぁ王子、ゴブリンのオンナに酔いしれなさァい！！\n――アイドルは、色香！！", "face": "lbfcc255c30a8"}, {"name": "ゴブリンプリンセス次女", "text": "アイドルは、火力！！", "face": "l8dd96367d320"}, {"name": "ゴブリンプリンセス三女", "text": "アイドルは……ゴブリンプリンセス！！", "face": "l55d1da39a5a9"}, {"name": "ゴブリンプリンセス長女", "text": "我らゴブリンプリンセス三姉妹！\n――あなたを、ゴブリンにしてあげる♪", "face": "lbfcc255c30a8"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンプリンセス三女", "text": "ぐすん……負けちゃいました……。", "face": "l55d1da39a5a9"}, {"name": "ゴブリンプリンセス次女", "text": "まさか、色香が足りなかったというの……？", "face": "l8dd96367d320"}, {"name": "ゴブリンプリンセス長女", "text": "……いいえ、足りなかったもの、\nそれはわかりきっているじゃない。\n見なさい、あのアイドルたちの輝きを……。", "face": "lbfcc255c30a8"}, {"name": "リノ", "text": "みんな、怪我はない！？\nあぁもう、擦り傷もケガに違いないでしょ！\nほら、消毒するから！", "face": "u1683a1"}, {"name": "エフネ", "text": "ざこざこのくせに最前線に出るから……。\nそんなにボクにイイトコ見せたかったんですかぁ？", "face": "u1682a1"}, {"name": "エスネア", "text": "ゴブリンさんたちもこっち来てー！\n早く手当てしないと跡が残っちゃうよ！", "face": "u1682a1"}, {"name": "ゴブリン博士", "text": "あ、アイドルたちが……兵の手当てヲ……！？", "face": "l453d6a10cf56"}, {"name": "ゴブリンプリンセス三女", "text": "アイドルは……君臨するものではないのですね。", "face": "l55d1da39a5a9"}, {"name": "ゴブリンプリンセス次女", "text": "ただそこにあるだけで、輝かずにはいられない。\n魂そのものが視線を引き付ける存在。\nそれが……それがアイドル……。", "face": "l8dd96367d320"}, {"name": "ゴブリンプリンセス長女", "text": "そう、アイドルは――輝き。\nこうしてはいられないわ！\n次のフェスに向けて、今から特訓開始よ！！", "face": "lbfcc255c30a8"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "……嵐のように去っていきましたね。", "face": "u114"}, {"name": "ミヤビ", "text": "でも、フェス本番前に良いリハーサルができました。\nリノさんに足りないのは場数だけですから、\nライバルとの接触回数を稼げたのは儲けものですよ。", "face": "u496"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ケイティ", "text": "なるほど、それはたしかに……？\n人前に立つ事の多かったアンナさ――アンナちゃんが、\nトップアイドルになれた理由にも通じますね。", "face": "u114"}, {"name": "ミヤビ", "text": "さぁ、本番まであと少し！\n王子プロデューサー、\n最後まで油断せずに駆け抜けますよ！！", "face": "u496"}]}], "active": true}