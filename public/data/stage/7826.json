{"quest_id": 7826, "name": "ゴブリンアイドル", "description": "フェスに向けて準備をする王子たちの前に、\nゴブリンプリンセス三姉妹とゴブリン博士\nが売り込みをするため押しかけてくる。\n上級（★１獲得の目安：平均Lv10）", "event": "AIGIS Idol Project", "event_category": "History", "mission_id": 920191, "map_no": 4674, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "level": 70, "form_count": 1, "hp": 27000, "attack": 1800, "base_hp": 27000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 100, "attack_speed": 150, "attack_wait": 50, "attack_interval": 316, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2116304, "race_id": 9, "special_effect_id": 326, "master_id": 31345, "global_id": 4964, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 650, "base_hp": 9000, "base_attack": 650, "damage_type": "physical", "armor_defense": 200, "attack_range": 280, "attack_speed": 1, "attack_wait": 30, "attack_interval": 121, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2133728, "race_id": 9, "missile_id": 680, "missile": {"speed": 2.0}, "master_id": 34702, "global_id": 8319, "ranged": true, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin