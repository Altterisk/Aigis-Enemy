{"quest_id": 6124, "name": "狙われた封印剣", "description": "伝承にあった剣を狙い、\n襲い来る天使たち。猛攻を凌ぎ、\n封印剣を守りぬけ！\n上級（★１獲得の目安：平均Lv10）", "event": "巨人殺しの剣", "event_category": "History", "mission_id": 920090, "map_no": 3976, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107024, "race_id": 6, "master_id": 697, "global_id": 696, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 26, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 2, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 4}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 4, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 41}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 6, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 81}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_range": 400, "attack_speed": 70, "attack_wait": 35, "attack_interval": 130, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105472, "race_id": 6, "missile_id": 151, "missile": {"speed": 3.0}, "master_id": 30080, "global_id": 3699, "ranged": true, "spawn_sec": 142}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 9, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 150}], "dialogue": [{"trigger": "start", "lines": [{"name": "エレーヌ", "text": "――……急いで、こっち。\n街中を走るより、ここを通った方が早い。", "face": "u481"}, {"name": "ケイティ", "text": "まさか街の地下にこのような道があったとは。", "face": "u114"}, {"name": "エレーヌ", "text": "……伝承にあった剣、ここで保管してる。\n……あれがその剣。この国の兵達の剣は、\nあれを模して作ってる。", "face": "u481"}, {"name": "ロイ", "text": "なるほど……ふむ、\n特に魔力等は感じませぬな。\nあの剣に何か特殊な力が？", "face": "u11"}, {"name": "エレーヌ", "text": "知らない……そういう伝承があるだけ。\n使われた事なんて、一度もない。", "face": "u481"}, {"name": "エレーヌ", "text": "……昔は色々研究したりもしてた。\nでも、結局はただの剣でしかないって。\n今では研究する人もいなくなって、放置されてる。", "face": "u481"}, {"name": "アンナ", "text": "巨人達に対する切り札になるかもと\n思いましたが……残念ですね。", "face": "lcdcde36c4f9d"}, {"name": "天使", "text": "――見つけた。\nあの剣、間違いないようですね。", "face": "l4348e8fe0a0e"}, {"name": "アンナ", "text": "……あれは！", "face": "l4680010083c3"}, {"name": "天使", "text": "人間達よ、そこを退きなさい。\n我らが神に、その剣を献上するのです。", "face": "l4348e8fe0a0e"}, {"name": "ニエル", "text": "……狙いはこの剣のようだね。", "face": "u206"}, {"name": "ケイティ", "text": "天使が欲するとは、やはりこの剣には、\n何らかの力があるのでしょうか……。", "face": "u114"}, {"name": "エレーヌ", "text": "……力があってもなくても、\nこの剣は私の国にとって大事なもの。\nやすやすと、渡せない。", "face": "u481"}, {"name": "天使", "text": "神の意思に逆らうとは、愚かな人間達です。\n退かぬというなら仕方ありません。\nその身を以て、神の裁きを知ると良い。", "face": "l4348e8fe0a0e"}, {"name": "アンナ", "text": "剣を奪われる訳には参りません。\n王子、迎撃の準備をお願いします！", "face": "l4680010083c3"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "――天使達は全て撤退したようです。", "face": "u114"}, {"name": "ロイ", "text": "……戦闘の最中であれば、何かしら\n反応があるのではと思っておりましたが……\n特に何の変化も見られませんでしたな。", "face": "u11"}, {"name": "エレーヌ", "text": "色々試したって聞いてる。\n煮たり、焼いたり、食べ……てはないけど。\nでも、何の成果も得られなかった。", "face": "u481"}, {"name": "アンナ", "text": "そうですか……いえ、ここで\n落ち込んでいる場合ではありませんね。", "face": "l4680010083c3"}, {"name": "アンナ", "text": "こうしている間にも街に危機が迫っています。\n王子、巨人達のもとへと急ぎましょう！", "face": "l4680010083c3"}]}], "active": true}