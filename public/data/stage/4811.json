{"quest_id": 4811, "name": "姫達の初参り", "description": "強力な姫達の力に立ち向かい、\n東の国の風習を知った姫達の\n思わぬ行動を阻止せよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ13(2016)", "event_category": "Reproduce", "mission_id": 300130, "map_no": 5438, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "magical", "magic_defense": 30, "attack_speed": 1, "attack_wait": 1, "attack_interval": 29, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108656, "special_effect_id": 120, "master_id": 30068, "global_id": 3687, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 900, "base_hp": 12000, "base_attack": 900, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105072, "race_id": 16, "special_effect_id": 121, "master_id": 30071, "global_id": 3690, "spawn_sec": 3}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099584, "race_id": 16, "special_effect_id": 222, "missile_id": 57, "missile": {"speed": 12.0}, "master_id": 179, "global_id": 178, "ranged": true, "spawn_sec": 3}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 4, "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105056, "race_id": 16, "change_to": 6, "master_id": 30072, "global_id": 3691, "to_global_id": 3692, "route_behaviour": {"transforms": [{"wait": 600}]}, "spawn_sec": 5}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "hp": 8000, "base_hp": 8000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108752, "race_id": 16, "special_effect_id": 222, "change_to": 7, "master_id": 30073, "global_id": 3692, "to_global_id": 3693}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105056, "race_id": 16, "change_to": 8, "master_id": 30074, "global_id": 3693, "to_global_id": 3694}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 100, "attack_interval": 236, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108768, "race_id": 16, "special_effect_id": 248, "change_to": 5, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30075, "global_id": 3694, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 1000, "base_hp": 13000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 650, "magic_defense": 20, "attack_range": 60, "attack_speed": 1, "attack_wait": 100, "attack_interval": 243, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108720, "race_id": 2, "special_effect_id": 248, "missile_id": 45, "master_id": 30069, "global_id": 3688, "ranged": true, "spawn_sec": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "フィリス", "text": "王子！　アンナさん！\nまずいぞ、このままでは大変なことになってしまう！", "face": "u40"}, {"name": "フィリス", "text": "一刻も早く『ハツモーデ』というものを、\n止めるように仲間たちに通達するんだ！", "face": "u40"}, {"name": "アンナ", "text": "フィリスさん、そんなに慌てて一体どうしたのですか！？\nイロハさん達に教わった風習に、一番興味を\n持っていたのはフィリスさんではないですか。", "face": "l7cc338a3983c"}, {"name": "フィリス", "text": "それはそうなんだが、あの時はまさか\n『オサイセン』という恐ろしい風習があるなんて\n私は知らなかったんだ！", "face": "u40"}, {"name": "アンナ", "text": "……オサイセン？\n何ですか、それは？", "face": "l7cc338a3983c"}, {"name": "フィリス", "text": "それがどうやら、\nゴールドを神への感謝の印として捧げる風習らしい……。", "face": "u40"}, {"name": "フィリス", "text": "そして今まさに、\nその風習に則ってプリンセスの面々が、\n王国軍のゴールドを大量に箱に投げ込んでいるんだ！", "face": "u40"}, {"name": "アンナ", "text": "――ええっ！？\nこ、このまま続けさせてしまっては、\n軍備を整えるゴールドが無くなってしまうのでは……！", "face": "l7cc338a3983c"}, {"name": "アンナ", "text": "王子、急いでプリンセスの方々を止めましょう！", "face": "l7cc338a3983c"}, {"name": "王子", "text": "……。（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "お願いします、プリンセスの皆さん！\nもうこれ以上はゴールドを\nオサイセン箱に投げ込まないでください！", "face": "l7cc338a3983c"}, {"name": "シェリー", "text": "――え？　\nでもこれは神様への感謝を示す為の\n東方の国の風習だと聞いたのですが……。", "face": "u1027"}, {"name": "リリア", "text": "私もそう聞きました。だから神への感謝をここで示し、\nより大きな加護を王子に与えて頂こうと\n私たちはゴールドを投げていたのですけど……。", "face": "u1020"}, {"name": "アンナ", "text": "気持ちは分かりますが、このままでは\nゴールドが無くなって王国の軍備を\n整えられなくなるかもしれません……。", "face": "l371405d5f1ee"}, {"name": "シェリー", "text": "そんな……！！\nもし、そうなったら王子の身が危険に……。", "face": "u1027"}, {"name": "テミス", "text": "ごめんなさい、王子。\n王子の身を案じるあまりに余計なことを……。", "face": "u38"}, {"name": "アンナ", "text": "皆さんが善意から行ったことだと分かってます。\nそれに、本当に加護があるかもしれませんしね！"}, {"name": "リリア", "text": "それならばいいのですが……。\n本当にすみませんでした、王子。\n箱に入れてしまったゴールドは働いてお返しします！", "face": "u20"}, {"name": "アンナ", "text": "分かりました。\nでは、今後も王子の身をお守りください。\nそして、力を合わせて魔物との戦いを終わらせましょう。"}]}], "active": true}