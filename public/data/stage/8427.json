00, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131872, "race_id": 16, "special_effect_id": 891, "change_to": 16, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 34219, "global_id": 7836, "ranged": true}, {"enemy_id": 19, "source": "local", "count": 8, "form_count": 1, "hp": 7000, "attack": 650, "base_hp": 7000, "base_attack": 650, "damage_type": "physical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 50, "attack_interval": 143, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137376, "race_id": 12, "change_to": 19, "change_condition": 1, "missile_id": 725, "missile": {"speed": 7.0, "splash": 120}, "master_id": 34963, "global_id": 8580, "ranged": true, "variants": [{"hp": 7000, "attack": 550, "base_hp": 7000, "base_attack": 550, "damage_type": "physical", "armor_defense": 150, "attack_speed": 20, "attack_wait": 10, "attack_interval": 83, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137520, "race_id": 12, "master_id": 34964, "global_id": 8581}], "spawn_sec": 121}, {"enemy_id": 21, "source": "local", "count": 14, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109072, "race_id": 16, "special_effect_id": 61, "change_to": 21, "master_id": 34222, "global_id": 7839, "to_global_id": 7838, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 131}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 331, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131888, "race_id": 16, "special_effect_id": 891, "change_to": 20, "missile_id": 26, "master_id": 34221, "global_id": 7838, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "スリー", "text": "――ヤーハーッ！\n密猟の時間だぜェー！！", "face": "le4f4702567ad"}, {"name": "ルチア", "text": "しまった！　一番面倒な奴が乱入してきたぞ！", "face": "u2318a1"}, {"name": "セーラ", "text": "森の守護獣の様子は……！？", "face": "u2317a1"}, {"name": "森の守護獣", "text": "密猟の時間だって……！\nでも優しい人もいるから……。\n人間は善……それともやっぱり悪……？", "face": "lcddc14d06801"}, {"name": "ルチア", "text": "よし！　まだ判断がついていないようだ！", "face": "u2318a1"}, {"name": "スリー", "text": "ついに見つけたぜ、森の守護獣！\nこれを仕留めちまえば、\nあとは動物も狩り放題に売り放題だァ！", "face": "le4f4702567ad"}, {"name": "森の守護獣", "text": "人間は悪！　密猟者から森を守るために、\n全てを滅ぼさなきゃダメ！", "face": "lcddc14d06801"}, {"name": "メープル", "text": "あぁ！？　守護獣さんが\n悪い方向に振り切っちゃったよぉ！", "face": "u2315a1"}, {"name": "スリー", "text": "頭を抱えてどうしたんだい、お嬢さん？\nオレを止めたいなら無駄だぜ？\nロマンからは逃げられねェんだからなァ！", "face": "le4f4702567ad"}, {"name": "森の守護獣", "text": "ロマンだって……！？\nそんなもののために密猟して、\n人間はなんて愚かなんだ！", "face": "lcddc14d06801"}, {"name": "森の守護獣", "text": "もうッ、こんなに愚かならさァ！\n散らすしかないよね！　命！", "face": "lcddc14d06801"}, {"name": "スリー", "text": "獰猛なトナカイだなァ！\nこいつは高値で売れそうだぜェ！", "face": "le4f4702567ad"}, {"name": "ルチア", "text": "スリーと守護獣で勝手に戦えと言いたいところだが、\n万が一にも狩られては寝覚めが悪いな。", "face": "u2318a1"}, {"name": "メープル", "text": "守護獣さんはメープルたちにも敵意を向けてるけど、\nそれでも放っておけないよ！", "face": "u2315a1"}, {"name": "ルチア", "text": "……そうだな。\n仕方がない、助けてやるか。", "face": "u2318a1"}, {"name": "ルチア", "text": "その後で、人間は悪人だけではなく、\n心が綺麗な者もいると、\n世間知らずなトナカイに教えてやろう。", "face": "u2318a1"}]}, {"trigger": "end", "lines": [{"name": "スリー", "text": "ち、ちくしょう！\nやっぱり海の漢は森じゃ分が悪いのか……！？", "face": "lf22fd75638c7"}, {"name": "スリー", "text": "くっ、次こそ大儲けしてやる！\n覚えてろよォーー！", "face": "lf22fd75638c7"}, {"name": "セーラ", "text": "スリーが凍った川を滑って、\nどこかへ消えていきました……。", "face": "u2317a1"}, {"name": "ルチア", "text": "これで少しは静かになったな。\n守護獣の方はどうだ？", "face": "u2318a1"}, {"name": "森の守護獣", "text": "キミたちは……密猟者を倒してくれた。\nもしかして本当にいい人間なの……？", "face": "lcddc14d06801"}, {"name": "ルチア", "text": "こっちもかなり大人しくなったようだな。", "face": "u2318a1"}, {"name": "森の守護獣", "text": "そっか、キミたちは悪くないんだ……。\n襲っちゃってごめんね。", "face": "lcddc14d06801"}, {"name": "森の守護獣", "text": "お詫びになにか……。\nえっと、ドングリいる？", "face": "lcddc14d06801"}, {"name": "ラピス", "text": "いらん。", "face": "u2316a1"}, {"name": "メープル", "text": "森の動物たちが無事なら、それが一番だよ！\nだからドングリは、守護獣さんが友達と分け合って♪", "face": "u2315a1"}, {"name": "森の守護獣", "text": "なんて優しい人たちなんだ……！\n捨てたものじゃないんだね、世の中って！", "face": "lcddc14d06801"}, {"name": "ルチア", "text": "守護獣は思い込みが激しいところもあるが、\nなんだかんだでいいトナカイだったな。", "face": "u2318a1"}, {"name": "セーラ", "text": "そうですね。またひょんなことで\n暴走しそうではありますが……。\nともかく、一件落着でございます。", "face": "u2317a1"}, {"name": "ラピス", "text": "一件落着とはいうが、本番はこれからだろう。\nプレゼントを配らなければいけないのだからな。", "face": "u2316a1"}, {"name": "ルチア", "text": "そうでしたね。\nでは、もうひと頑張りしましょうか。", "face": "u2318a1"}, {"name": "メープル", "text": "うんっ。力を合わせて、\nいい子のみんなに、プレゼントを配ろうね♪", "face": "u2315a1"}]}, {"trigger": "route", "lines": [{"name": "スリー", "text": "おっと、川があるじゃねェか！\n水があるならこっちのもんだぜ！", "face": "lf22fd75638c7"}, {"name": "メープル", "text": "あっ、変な人が川に飛び込もうとしてるよ！", "face": "u2315a1"}, {"name": "スリー", "text": "オレは海賊、海の漢！\n水の中でこそ輝けるのさ！\n今から泳いでそっちに向かうぜェ！", "face": "lf22fd75638c7"}]}, {"trigger": "route", "lines": [{"name": "スリー", "text": "グワーッ！？　川が凍ってるじゃねェか！", "face": "lf22fd75638c7"}, {"name": "ルチア", "text": "こんなに寒いんだから当たり前だろ。", "face": "u2318a1"}, {"name": "スリー", "text": "お嬢さんの目が今日の気温くらい冷たいぜ……。\nでもオレはめげない！\n泳げないなら滑って行きゃいいよなァ！", "face": "lf22fd75638c7"}, {"name": "セーラ", "text": "スリーが凍った川を滑って向かってきます！\n皆様、ご注意を！", "face": "u2317a1"}]}], "active": true}