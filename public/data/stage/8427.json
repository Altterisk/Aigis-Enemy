{"quest_id": 8427, "name": "人間の善悪", "description": "説得も虚しく暴れる森の守護獣と闇の組織。\n混迷とする場を収め、森の平穏を取り戻せ！\n＜特定のタイミングで吹雪が発生＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "聖なる森と闇の組織", "event_category": "History", "mission_id": 920223, "map_no": 4986, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 32, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 3, "hp": 85000, "attack": 2750, "base_hp": 85000, "base_attack": 2750, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 70, "attack_wait": 70, "attack_interval": 261, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157552, "race_id": 11, "special_effect_id": 1912, "change_to": 2, "change_condition": 3, "master_id": 38134, "global_id": 11751, "to_condition": 3, "to_global_id": 11752, "sp_change_to": [38136], "commands": {"raw": "SetStageFlag(0, 0); DoEnemy_RegistCommand(\"OnModeChanged\", \"SetStageFlag(0, 1); DoEnemy_RemoveCommand( \"OnModeChanged\" );\");", "sets_flags": [[0, 0], [0, 1]], "on_mode_changed": true}, "route_behaviour": {"transforms": [{"to": 38136}, {}]}, "spawn_sec": 48}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 85000, "attack": 3000, "base_hp": 85000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_range": 240, "attack_speed": 70, "attack_wait": 70, "attack_interval": 19