{"quest_id": 8971, "name": "元凶と思しき二人組", "description": "王子たちはローパー博士と助手スライムを\n発見。話を聞こうとしていると、\n何を勘違いしたのか闘争心を燃やし始めて？\n極級（★１獲得の目安：平均Lv25）", "event": "真夏のぷるぷるビーチ", "event_category": "Emergency", "mission_id": 200570, "map_no": 7445, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 1, "tags": ["スライム"], "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097456, "master_id": 10, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 13, "form_count": 1, "tags": ["スライム"], "hp": 1600, "attack": 300, "base_hp": 1600, "base_attack": 300, "damage_type": "magical", "armor_defense": 1600, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097296, "master_id": 22, "global_id": 21, "spawn_sec": 38}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["スライム"], "hp": 3300, "attack": 380, "base_hp": 3300, "base_attack": 380, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158496, "change_to": 3, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38491, "global_id": 12108, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 3300, "attack": 700, "base_hp": 3300, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158512, "master_id": 38492, "global_id": 12109}], "spawn_sec": 46}, {"enemy_id": 5, "source": "local", "count": 14, "form_count": 2, "hp": 4000, "attack": 1500, "base_hp": 4000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 154, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2171200, "special_effect_id": 789, "change_to": 5, "change_condition": 4, "master_id": 40781, "to_condition": 4, "to_ticks": 1, "spawn_sec": 92}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルスII", "ブロック不可"], "hp": 4000, "attack": 10, "base_hp": 4000, "base_attack": 10, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "attack_wait": 1, "attack_interval": 36, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2171200, "special_effect_id": 1069, "master_id": 40782, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["スライム"], "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "magical", "armor_defense": 2200, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112576, "missile_id": 11, "master_id": 30696, "global_id": 4315, "ranged": true, "spawn_sec": 117}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 100000, "attack": 5000, "base_hp": 100000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_range": 180, "attack_speed": 20, "attack_wait": 30, "attack_interval": 109, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2144960, "special_effect_id": 1408, "change_to": 8, "change_condition": 1, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 36266, "global_id": 9883, "ranged": true, "variants": [{"hp": 100000, "attack": 10, "base_hp": 100000, "base_attack": 10, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 10, "attack_wait": 40, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2144944, "special_effect_id": 220, "master_id": 36267, "global_id": 9884}], "spawn_sec": 135}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 3, "hp": 16000, "attack": 150, "base_hp": 16000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "attack_range": 260, "attack_wait": 60, "attack_interval": 195, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2144752, "special_effect_id": 1403, "change_to": 10, "missile_id": 883, "missile": {"speed": 5.0}, "master_id": 36257, "global_id": 9874, "ranged": true, "to_global_id": 9875, "spawn_sec": 137}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 16000, "attack": 250, "base_hp": 16000, "base_attack": 250, "damage_type": "magical", "armor_defense": 100, "attack_range": 260, "attack_wait": 60, "attack_interval": 195, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2144768, "special_effect_id": 1404, "change_to": 11, "missile_id": 884, "missile": {"speed": 5.0}, "master_id": 36258, "global_id": 9875, "ranged": true, "to_global_id": 9876}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 16000, "attack": 500, "base_hp": 16000, "base_attack": 500, "damage_type": "magical", "armor_defense": 200, "attack_range": 260, "attack_wait": 60, "attack_interval": 195, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2144784, "special_effect_id": 1405, "missile_id": 885, "missile": {"speed": 5.0}, "master_id": 36259, "global_id": 9876, "ranged": true}, {"enemy_id": 13, "source": "local", "count": 5, "form_count": 1, "tags": ["スライム"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100576, "master_id": 269, "global_id": 268, "spawn_sec": 231}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["スライム"], "hp": 8500, "attack": 580, "base_hp": 8500, "base_attack": 580, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158528, "change_to": 14, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38493, "global_id": 12110, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 8500, "attack": 1050, "base_hp": 8500, "base_attack": 1050, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158544, "master_id": 38494, "global_id": 12111}], "spawn_sec": 247}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "tags": ["スライム"], "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "physical", "armor_defense": 500, "magic_defense": 60, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112592, "missile_id": 11, "master_id": 30697, "global_id": 4316, "ranged": true, "spawn_sec": 260}], "popups": ["人型のスライムから\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\n\nブロックされている間は、\n攻撃に遅延効果が無くなります。", "ローパー博士から\n攻撃を複数回受けると、\n麻痺状態になります。", "助手スライムから攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "助手スライム", "text": "――どうする、博士。\n海がスライムになっちまったけど。", "face": "l7074446b91f8"}, {"name": "ローパー博士", "text": "どうしましょうね、助手スライムくん。\nもはや私たちだけで解決することは不可能ですが。", "face": "lca0a1294f2b4"}, {"name": "助手スライム", "text": "ここで黄昏ててもしょうがねぇけど、\n全然ナイスなアイデアとか思い浮かばねぇしな。", "face": "l7074446b91f8"}, {"name": "ローパー博士", "text": "実験でたくさん失敗してきた私ですが、\nこの規模のミスははじめてなので、\n途方にくれることしかできませんね。", "face": "lca0a1294f2b4"}, {"name": "ハリンヘイム", "text": "――その発言から察するに、\n海がこうなった原因はあなたたちにあるようですね。", "face": "u2839a1"}, {"name": "ローパー博士", "text": "げぇっ！？　王国軍！？", "face": "lca0a1294f2b4"}, {"name": "ヴィラヘルム", "text": "帝国軍もいますよ。\nさて、色々と話を聞かせてもらいましょうか。", "face": "u2835a1"}, {"name": "助手スライム", "text": "やばいぜ博士！　あの初代皇帝、\n完全に俺たちを殺る気だぜ！？", "face": "l7074446b91f8"}, {"name": "ヘイズル", "text": "そこまで殺気立ってるわけではないだろうけど、\n君たちは帝国で好き放題してくれたみたいだからね。", "face": "u2836a1"}, {"name": "ヘイズル", "text": "多少の制裁は覚悟してもらおうかな。", "face": "u2836a1"}, {"name": "ローパー博士", "text": "くっ、身から出た錆というやつですかね！\n全面的に悪いのは私たちですが、\nそれでもまだまだ死にたくはありませんからねぇ！！", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "いきますよ助手スライムくん！\n正直、王国軍と帝国軍を同時に相手取るのは、\n絶望的どころの話ではありませんが！！", "face": "lca0a1294f2b4"}, {"name": "助手スライム", "text": "ああ！　やるぜ博士！\n予定調和みたいにぶっ倒される未来しか見えねぇが、\n諦めたらそこで終わりだもんなぁッ！！", "face": "l7074446b91f8"}, {"name": "ホルミース", "text": "なんだか変な覚悟を決めちゃったようですね。\nあちらは完全にやる気みたいですよ。", "face": "u2834a1"}, {"name": "太上老君", "text": "こうなったら仕方がない。\nとりあえずしばき倒して、\nなにをやらかしたのかを問い詰めようか。", "face": "u2838a1"}]}, {"trigger": "end", "lines": [{"name": "助手スライム", "text": "ぐわぁぁー！？　博士ー！？", "face": "l7074446b91f8"}, {"name": "ローパー博士", "text": "助手スライムくーん！？", "face": "lca0a1294f2b4"}, {"name": "ヴィラヘルム", "text": "大袈裟ですね。\n峰打ちで済ませてあげたので、\n命に別状はないはずですよ。", "face": "u2835a1"}, {"name": "助手スライム", "text": "なにが峰打ちだよ！？\n俺の身体、真っ二つになってんだけど！？", "face": "l7074446b91f8"}, {"name": "ローパー博士", "text": "私も胴体が分離してしまったのですが……。", "face": "lca0a1294f2b4"}, {"name": "ヘイズル", "text": "そんな状態でよく生きていられるね……。", "face": "u2836a1"}, {"name": "太上老君", "text": "彼らの生態に多少興味が湧いてきたけど、\nそれより今はスライム化した海についてだ。", "face": "u2838a1"}, {"name": "イムラウ", "text": "海がこんなになるなんて、\nいったいなにをやっちゃったの？", "face": "u2842a1"}, {"name": "ローパー博士", "text": "ふむ……今更言い訳をしても意味がありませんね。\n観念して、すべてを話すとしましょう。", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "結論から話しますと、\n海がこうなってしまったのは、私の発明品が原因です。", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "ああ、待ってください。武器を構えないで。\n私が装置を暴走させたとかではありませんから。", "face": "lca0a1294f2b4"}, {"name": "レミィ", "text": "じゃあなんで海がスライムになってるのよ。", "face": "u2837a1"}, {"name": "クーコ", "text": "そもそもだけど、あなたはなにを作ったの？", "face": "u2837a1"}, {"name": "ローパー博士", "text": "順を追って説明しますね。\nまず私が作ったのは、水をスライムに変える装置。\n名付けてスライム増産装置です。", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "そのスライム増産装置が先日、\nスライムのお嬢さんに盗まれましてね。\nそれで気づいたら海がこうなっていたというわけです。", "face": "lca0a1294f2b4"}, {"name": "ヴィディア", "text": "そちらの管理ミスについて言いたいことは山ほどあるが、\nスライムのお嬢さんというのはなんなんだ？", "face": "u2841a1"}, {"name": "ローパー博士", "text": "文字通りスライムのお嬢さんですよ。\n水着を着た、可愛らしいスライムです。", "face": "lca0a1294f2b4"}, {"name": "ダグマール", "text": "また胡乱な存在が増えましたね……。\nというかスライムって水着とか着るのですか？", "face": "u2843a1"}, {"name": "助手スライム", "text": "魔物だってお洒落くらいするぜ。\n俺も帽子を被ってるわけだし。", "face": "l7074446b91f8"}, {"name": "ローパー博士", "text": "ともかく、海を元に戻すには、\nスライムのお嬢さん……水着スライムと呼びましょうか。", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "水着スライムを見つけ出し、\n彼女が持っているであろう装置を停止、\nもしくは破壊する必要があります。", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "我々は彼女を探すことができませんでしたが、\n王国軍と帝国軍の力があれば、きっと解決できるでしょう。", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "というか解決をお願いします……！\n本来ならこちらでしなければならないことですが、\nもはや自分たちでは処理ができませんから……！", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "誠に申し訳ありませんが、何卒……！！", "face": "lca0a1294f2b4"}, {"name": "アブグルント", "text": "やることは決まったかしら。", "face": "u2840a1"}, {"name": "ヴィラヘルム", "text": "問題はどうやって水着スライムとやらを\n捜索するかですが――", "face": "u2835a1"}, {"name": "バカンス満喫一般市民", "text": "――う、うわぁぁあああっ！！\n海から大量の魔物が上がってきてるぞッ！？", "face": "l40d8ed2b6eaa"}, {"name": "ヴィラヘルム", "text": "先に解決しなければならない問題が発生したようですね。", "face": "u2835a1"}, {"name": "ヘイズル", "text": "そうだね、被害が出る前に、\n魔物たちの対処をしよう。\nスライムのことはその後だ。", "face": "u2836a1"}]}]}