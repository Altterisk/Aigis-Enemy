terval": 75, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2115648, "special_effect_id": 130, "change_to": 11, "master_id": 31230, "global_id": 4849, "route_behaviour": {"transforms": [{"wait": 1400}]}, "spawn_sec": 160}, {"enemy_id": 13, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "magical", "armor_defense": 700, "magic_defense": 15, "attack_speed": 25, "attack_wait": 1, "attack_interval": 75, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111696, "special_effect_id": 54, "master_id": 30620, "global_id": 4239, "spawn_sec": 167}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 28000, "attack": 800, "base_hp": 28000, "base_attack": 800, "damage_type": "magical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 25, "attack_wait": 15, "attack_interval": 103, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118192, "special_effect_id": 222, "master_id": 31676, "global_id": 5295, "spawn_sec": 167}], "popups": ["エマ(本体)は\nHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "エストリエ", "text": "……んんん。\nんぅ……んー……上手くいかないわね。", "face": "u791"}, {"name": "エデン", "text": "――何してるの？\nエストリエちゃん♪", "face": "u239"}, {"name": "エストリエ", "text": "わっ、わぁっ！？\nい、いきなり抱きつかないでよエデンちゃん！", "face": "u791"}, {"name": "エストリエ", "text": "ただ、打ち直してもらった剣が、\n中々しっくり来ないなぁって思って……。", "face": "u791"}, {"name": "エデン", "text": "あっ、『魔剣』の力が戻ってきてるね。\nそれで、しっくり来ないっていうのは？", "face": "u239"}, {"name": "エストリエ", "text": "私の手に合わせて\n打ち直してもらったばかりだからかしら、\nまだあまり馴染んでいないのよ。", "face": "u791"}, {"name": "エデン", "text": "……当主として、\nその『魔剣』を使いこなせないと、\nパパに顔向け出来ないとか思ってる？", "face": "u239"}, {"name": "エストリエ", "text": "……エデンちゃんは、何もかもお見通しね。\nでも大丈夫、そのうち慣れるだろうし、\nそれにこんなこと、誰かに聞かれたら――", "face": "u791"}, {"name": "シルヴィア", "text": "――残念、聞いちゃいましたわ♪\n若いヴァンパイアは悩みも可愛いのですわね♪", "face": "u442"}, {"name": "エマ", "text": "えぇ、えぇ。実に甘く尊い、小さな輝きを感じます。\n姫よ、王国の流儀は私も知るところにございます。\nここはやはり、荒療治こそ相応しいのでは？", "face": "u582"}, {"name": "シルヴィア", "text": "あなたもそう思います？\nやっぱり後の世代が悩んでいると、\n口を出したくなっちゃいますものね？", "face": "u1442"}, {"name": "デスピア", "text": "そうね、じゃあエデンちゃん、\n皆を呼んできてくれる？　悪ぅいお姉さん達が、\nエストリエちゃんを焚き付けてるって。", "face": "u49"}, {"name": "エデン", "text": "荒療治……あっ、歓迎会だね！\nよぉーし、エストリエちゃん、\n準備運動して待っててね♪", "face": "u239"}, {"name": "エストリエ", "text": "えっ、えぇっ？\nいったいどういうことなの……？", "face": "u791"}, {"name": "エマ", "text": "……ふふふ。\nいと楽しき、武の饗宴にございます。", "face": "u1582"}]}, {"trigger": "end", "lines": [{"name": "エストリエ", "text": "……人間って、歓迎会にこんなことするの？\nちょっと想像の範囲を超えていたわ……。", "face": "u791"}, {"name": "エデン", "text": "あはは……。たぶんエストリエちゃんが\n剣のことで悩んでたから、\nこういう手段を選んだんだと思うよ？", "face": "u239"}, {"name": "エマ", "text": "そういう事もあるでしょう。\nあるいは唯、永き生の慰みかもしれません。\nどう捉えるかは若き血族に任せましょうとも。", "face": "u582"}, {"name": "シルヴィア", "text": "そうですわ。\nもしかしたら、ただエストリエちゃんと\n遊びたかっただけかもしれませんのよ？", "face": "u442"}, {"name": "エストリエ", "text": "……気にかけてくださったこと、\n感謝いたしますわ。\nいと永き時を過ごす、偉大なる先達の方々。", "face": "u791"}, {"name": "デスピア", "text": "……私もその『永き時』の括りに入れられると、\nちょっと悲しいものがあるのだけれど。", "face": "u49"}, {"name": "エストリエ", "text": "ひゃっ、わっ、ご、ごめんなさい……。\nあなたは人間だったのね。", "face": "u791"}, {"name": "アンナ", "text": "……王子、どうやらエストリエさんとは\n上手くやっていけそうですね。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "エストリエ", "text": "ちょっと、小声で話しても聞こえてるのよ？\n……ほ、ほら、こっち来なさい。\n仲間はずれにしてるみたいじゃない！", "face": "u791"}, {"name": "エストリエ", "text": "我が氏族は優雅にして寛容で、\nたとえ人間という卑小な存在が相手でも、\n少しは慈悲の心も備えてるんだから！", "face": "u791"}]}], "map": {"image": "Map920126_5494", "w": 960, "h": 640, "spots": [{"k": "b", "x": 27, "y": 161}, {"k": "m", "x": 601, "y": 180, "id": 200}, {"k": "m", "x": 541, "y": 146, "id": 201}, {"k": "m", "x": 481, "y": 110, "id": 202}, {"k": "m", "x": 422, "y": 143, "id": 203}, {"k": "m", "x": 360, "y": 180, "id": 204}, {"k": "m", "x"