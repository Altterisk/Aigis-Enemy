k_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103376, "race_id": 8, "change_to": 22, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 442, "global_id": 441, "ranged": true, "to_condition": 3, "to_global_id": 442, "spawn_sec": 185}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 443, "global_id": 442, "ranged": true, "from_condition": 3}, {"enemy_id": 24, "source": "local", "count": 5, "form_index": 0, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103408, "race_id": 8, "change_to": 24, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 444, "global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "spawn_sec": 195}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}], "popups": ["　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇", "オーク旗手がいる間は\n敵の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――オークの王よ、なぜこの地に留まる。", "face": "u1705a1"}, {"name": "オークロード", "text": "む……おぉ、騎士殿か。\nなに、帝国軍に一泡吹かせてやろうかと思ってな。", "face": "l7abef6f2023c"}, {"name": "？？？", "text": "ハイドース様は、全軍に冥界への撤退を命じた。\n……命を捨てる必要はない。\nこれは誇りを取り戻すための戦いだろう？", "face": "u1705a1"}, {"name": "オークロード", "text": "死んでしまっては誇りもなにもない、と？\nはははっ、騎士殿、それは順序が逆だ。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "誇りのために、命を捨てることだってある。\nオークとは戦いに生きる種族。\n戦場で散るのは誉れだぞ？", "face": "l7abef6f2023c"}, {"name": "？？？", "text": "……そんな考えだから、\nオークの死者は冥界で、\nいつもヘカティエ様にお説教されるんだ。", "face": "u1705a1"}, {"name": "オークロード", "text": "そのヘカティエ様も、今は冥界にいない。\nならば、今日は死ぬには良い日だろう。", "face": "l7abef6f2023c"}, {"name": "？？？", "text": "減らず口を……。\nまぁいい、無理強いはしない。", "face": "u1705a1"}, {"name": "？？？", "text": "だが、死ぬために戦うな。\n……親父殿に誇れるような死に方をしろ。", "face": "u1705a1"}, {"name": "オークロード", "text": "心得た。\n騎士殿も、悔いなき選択をするがいい。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "先日の手合わせで感じた。\n騎士殿の迷いが、剣筋に出ていたからな。", "face": "l7abef6f2023c"}, {"name": "？？？", "text": "……何を。", "face": "u1705a1"}, {"name": "オークロード", "text": "ヘカティエ様に捨てられたと思っているのだろう？\nその腹いせに戦争に出るとは、\nそれこそ自暴自棄というものだ。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "騎士殿、死ぬために戦うな。\n己の迷いを断ち切るために、戦え。", "face": "l7abef6f2023c"}, {"name": "？？？", "text": "…………覚えておく。", "face": "u1705a1"}, {"name": "オークロード", "text": "ああ。\n――死した後、魂となって冥界でまた会おう。", "face": "l7abef6f2023c"}, {"name": "ハイオーク", "text": "…………死んだ後というのは、\nいったいどんな感覚なのでしょうね。", "face": "l7bf980320ebd"}, {"name": "オークロード", "text": "知るか、そんなこと。\nだが親父殿や、先祖代々の勇者たちが待っている。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "土産話のひとつやふたつ、持っていかないと、\n胸を張って凱旋はできないだろうな。", "face": "l7abef6f2023c"}, {"name": "ハイオーク", "text": "……ははっ、それなら\n帝国軍を俺たちだけで蹴散らしてやりましょう。", "face": "l7bf980320ebd"}, {"name": "オークロード", "text": "その意気だ。\nオレより多くの首級を上げれば、\n次代のオークロードになれるかもしれんぞ。", "face": "l7abef6f2023c"}, {"name": "ハイオーク", "text": "そいつは魅力的だ！\n我が王よ、玉座を磨いておいてくださいよ！", "face": "l7bf980320ebd"}, {"name": "オークロード", "text": "ああ、白の皇帝の生き血で真っ赤に磨いておいてやろう。\n――さて、そろそろ、か。", "face": "l7abef6f2023c"}, {"name": "ハイオーク", "text": "空が、我らオークの味方をしています。\n吹雪が近付いてきました。\n敵の弓矢は狙いをつけづらいことでしょう。", "face": "l7bf980320ebd"}, {"name": "オーク", "text": "……こちらも雪山では、進軍速度が落ちるのでは？", "face": "le8d3f3acf4c9"}, {"name": "ハイオーク", "text": "歩む速度が落ちるのなら、\n堂々と胸を張って進めばいい。\nそれが我ら、勇者に連なるオークの戦士だ！", "face": "l7bf980320ebd"}, {"name": "オークロード", "text": "オレたちに、迷いはない。\n誓いも、後悔もない。\nさぁ、誉れ高き戦いに向かうぞッ！！", "face": "l7abef6f2023c"}]}, {"trigger": "end", "lines": [{"name": "オークロード", "text": "……後少し、もう少し、\nほんの一歩が足りないというのか。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "だが、まだだ。\nオークの戦士たちよ、散開せよ！\nここで、オレたちが白の帝国を討つ！！", "face": "l7abef6f2023c"}, {"name": "レオナ", "text": "くっ……山岳に退いたか！\n陛下、このまま行軍すれば、包囲されるやも――", "face": "u311"}, {"name": "白の皇帝", "text": "いや、進軍を止めるな。", "face": "u418"}, {"name": "白の皇帝", "text": "連中の目的は時間稼ぎだ。\nその命をかけてまで、仲間のために\nわずかな時間を稼ごうというのだ。", "face": "u418"}, {"name": "白の皇帝", "text": "正面から蹴散らせ。\n彼らもそれを望んでいるはずだ。", "face": "u418"}, {"name": "レオナ", "text": "……はっ。\n全軍、周囲の警戒を厳とせよ！\nこのまま山岳地帯を進むぞ！", "face": "u311"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [265]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 15000, "attack": 2000, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102640}, {"enemy_id": 1, "form_index": 1, "hp": 15000, "attack": 2000, "damage_type": "physical", "armor_defense": 450, "pattern_id": 2102656}, {"enemy_id": 3, "form_index": 0, "hp": 1200, "attack": 300, "damage_type": "physical", "armor_defense": 80, "pattern_id": 2106320}, {"enemy_id": 3, "form_index": 1, "hp": 1200, "attack": 500, "damage_type": "physical", "armor_defense": 130, "pattern_id": 2106336}, {"enemy_id": 5, "form_index": 0, "hp": 900, "attack": 150, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2106496}, {"enemy_id": 5, "form_index": 1, "hp": 900, "attack": 150, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2106512}, {"enemy_id": 7, "form_index": 0, "hp": 4000, "attack": 400, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102224}, {"enemy_id": 7, "form_index": 1, "hp": 4000, "attack": 600, "damage_type": "physical", "armor_defense": 450, "pattern_id": 2102240}, {"enemy_id": 9, "form_index": 0, "hp": 5000, "attack": 250, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2102608}, {"enemy_id": 10, "form_index": 0, "hp": 3000, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102544}, {"enemy_id": 10, "form_index": 1, "hp": 3000, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102560}, {"enemy_id": 12, "form_index": 0, "hp": 2500, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102576}, {"enemy_id": 12, "form_index": 1, "hp": 2500, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102592}, {"enemy_id": 14, "form_index": 0, "hp": 10, "attack": 550, "damage_type": "physical", "pattern_id": 2142304}, {"enemy_id": 19, "form_index": 0, "hp": 18000, "attack": 800, "damage_type": "physical", "armor_defense": 500, "pattern_id": 2102672}, {"enemy_id": 19, "form_index": 1, "hp": 18000, "attack": 1600, "damage_type": "physical", "armor_defense": 700, "pattern_id": 2102688}, {"enemy_id": 21, "form_index": 0, "hp": 20000, "attack": 400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "pattern_id": 2105088}, {"enemy_id": 22, "form_index": 0, "hp": 10000, "attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2103376}, {"enemy_id": 22, "form_index": 1, "hp": 10000, "attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2103392}, {"enemy_id": 24, "form_index": 0, "hp": 8000, "attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2103408}, {"enemy_id": 24, "form_index": 1, "hp": 8000, "attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2103424}]}, "active": true}