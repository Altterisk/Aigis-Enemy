{"quest_id": 7855, "name": "第五陣 冥界への道", "description": "攻勢に転じた帝国軍は冥界侵攻を開始する。\n＜特定のタイミングで吹雪が発生＞\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで吹雪が発生", "広域戦闘：敵味方の射程減少"], "event": "帝国五陣", "event_category": "Empire", "mission_id": 940003, "map_no": 4687, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102640, "race_id": 8, "change_to": 1, "change_condition": 3, "master_id": 383, "global_id": 382, "to_condition": 3, "to_global_id": 383, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 450, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102656, "race_id": 8, "master_id": 384, "global_id": 383, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 5, "form_index": 0, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 3, "change_condition": 3, "master_id": 800, "global_id": 799, "to_condition": 3, 