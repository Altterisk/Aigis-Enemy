{"quest_id": 6907, "name": "魔王軍防衛線：北の大国", "description": "メカゴブリンクイーン、ガオレオンの侵攻\nによって、北の大国に危機が訪れていた。\nシビラと共に、この窮地を乗り越えろ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "英雄王を継ぐ者", "event_category": "History", "mission_id": 920186, "map_no": 5117, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 13000, "attack": 400, "base_hp": 13000, "base_attack": 400, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 400, "attack_wait": 60, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114624, "race_id": 9, "special_effect_id": 442, "change_to": 1, "change_condition": 1, "missile_id": 26, "master_id": 32062, "global_id": 5681, "ranged": true, "variants": [{"tags": ["アーマー", "機械"], "hp": 13000, "attack": 1500, "base_hp": 13000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 800, "magic_defense": 10, "attack_wait": 80, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114640, "race_id": 9, "special_effect_id": 242, "master_id": 32063, "global_id": 5682}], "route_behaviour": {"calls_event": [2066, 2067]}}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 56, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117648, "race_id": 12, "special_effect_id": 443, "change_to": 3, "change_condition": 1, "master_id": 32064, "global_id": 5683, "variants": [{"hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "