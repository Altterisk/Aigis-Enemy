emy_id": 9, "source": "local", "count": 11, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 130}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 154}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 200}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 233}], "popups": ["メカゴブリンクイーンは\n拠点には向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 ", "ガオレオンはダメージを受けません。\nまた味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nブロックされている間、\nガオレオンは全ての効果を失います。\n　　　　　　　　　　　(1/3)", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n　　　　　　　　　　　(2/3)", "ガオレオンは拠点には向かわず、\nしばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 \n　　　　　　　　　　　(3/3)"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "（――王国と共に歩みし、北の大国）", "face": "u921"}, {"name": "？？？", "text": "（此方、答えをもたらす剣の担い手が率いる者達。\n彼方、ゴブリンの女王と、獣の王）", "face": "u921"}, {"name": "？？？", "text": "（そして空より来る船、\n王国を率いる王子の仲間達――）", "face": "u921"}, {"name": "メカゴブリンクイーン", "text": "けなげなものねぇ……。\n東の国へ向かった王子達が、\n助けに来てくれると信じているのかしら。", "face": "le10a6d9788ec"}, {"name": "シビラ", "text": "……王子は、必ず来てくれる。\nだからそれまで、膝をつくわけにはいかないの。", "face": "u39"}, {"name": "ガオレオン", "text": "その意気や良しッ！！\n流石は王国に並び立つ、北の大国の姫君よッ！！", "face": "lc0efcabbf44a"}, {"name": "メカゴブリンクイーン", "text": "でも、もう時間切れじゃないかしら。\nさぁ『破滅の力』の隠し場所、\nそろそろ教えてもらうわよ。", "face": "le10a6d9788ec"}]}, {"trigger": "start", "lines": [{"name": "ユージェン", "text": "――そこまでだ！\n王子、早くシビラのもとへ！", "face": "u906"}, {"name": "メカゴブリンクイーン", "text": "なっ……どうして王子達がここにいるのよ！？\n東の国へ向かったのではないの！？", "face": "le10a6d9788ec"}, {"name": "ガオレオン", "text": "なるほど、帝国の飛空船を使ったなッ！\nだがこれも好機、我が闘志を\n振り下ろす先に困っていたところだからなッ！！", "face": "lc0efcabbf44a"}, {"name": "ユリアン", "text": "いつまで軽口を叩いていられるかな。\n城壁内の魔物は駆逐中だ。\nそれから王子、市民の避難誘導も順調だぜ！", "face": "u7"}, {"name": "クレイブ", "text": "……ふふ、兵士長ぶりが板についてきましたね。\n避難民の警護は我々にお任せを。\n王子はシビラ様の方へ！", "face": "u8"}, {"name": "シビラ", "text": "――王子、来てくれるって信じてた。\nこれで、私達に敗北はなくなった。", "face": "u39"}, {"name": "シビラ", "text": "かつて王国の危機に私達が駆けつけたように、\n王子はこうして、私の国を助けにきてくれた。", "face": "u39"}, {"name": "シビラ", "text": "絶対に勝ちましょう。\nもう誰も、泣かなくて済むように。", "face": "u39"}, {"name": "王子", "text": "…………！！", "face": "u1"}]}, {"trigger": "battle", "at_sec": 188, "lines": [{"name": "アンナ", "text": "王子、ガオレオンが前線に現れました！", "face": "lae6f900356a5"}, {"name": "ガオレオン", "text": "フハハハッ！！　良いぞ、心が躍るッ！！\nだが、覇者たる我を差し置いて、\nファイナルマッチは始まらぬッ！！", "face": "lc0efcabbf44a"}, {"name": "ガオレオン", "text": "卑怯なる遠距離の凶器は我が引きつけてやろうッ！\n鍛え抜かれし肉体にて、\n百獣のチャンピオンたる我に挑んでくるが良いッ！！", "face": "lc0efcabbf44a"}, {"name": "マンモン", "text": "がおがおちゃん、相変わらずですね……。\nでも真正面から足止めすれば、戦いに夢中になって\n遠距離攻撃の妨害は、してこなくなるはずですよ！", "face": "u767"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "メカゴブリンクイーン、\nガオレオン、撤退していきます！", "face": "lae6f900356a5"}, {"name": "カタラ", "text": "この感じ……そうか、魔界の亀裂を使って、\n別の場所へ移動していったのね。", "face": "u912"}, {"name": "アンナ", "text": "とはいえ、こちらにも\n追撃するだけの余力はありません。\n何しろ飛空船による遊撃部隊ですからね。", "face": "l02c049a18483"}, {"name": "フローガ", "text": "――『……こえますか？　聞こえますか！？\nこちら魔術師ギルドです！　聞こえますかー！？』", "face": "u878"}, {"name": "ケイティ", "text": "フローガさん、大丈夫です、聞こえています。\nまた魔王軍が現れましたか？", "face": "u114"}, {"name": "フローガ", "text": "『はいっ、そ、それも予想外の所に！\n現在、帝国が魔王軍幹部の襲撃を受けています！』", "face": "u878"}, {"name": "イングリッド", "text": "魔王軍め、あっちこっちと\n引っ掻き回してきますね……。", "face": "u323"}, {"name": "シビラ", "text": "王子、白の皇帝を助けに行ってあげて。\n大事な戦友、なんでしょう？", "face": "u39"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "シビラ", "text": "ふふっ、さぁ、いってらっしゃい。\nここは私達に任せてね。", "face": "u39"}, {"name": "？？？", "text": "（……だめ、ついていってあげて。\nこの先に待つのは……嗚呼……）", "face": "u921"}, {"name": "？？？", "text": "（世界が……終わってしまう……。\n大地の嘆きが……世界の歪みが……）", "face": "u921"}, {"name": "？？？", "text": "（……物質界が、終わりを迎えてしまう）", "face": "u921"}, {"name": "ソラス", "text": "（いったいどこに居るのですか？\n――いえ、この力の流れは……。\nそう、そこにいるのですね、サナラ！）", "face": "u904"}, {"name": "ソラス", "text": "（とても嫌な予感がするんです。\nきっと、あなたの力が必要になります。\nだから、今叩き起こしに行きますからね……！！）", "face": "u904"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "メカゴブリンクイーン", "text": "ウフフッ、やはり王子率いる軍勢は、\n一筋縄ではいかないわねぇ……っ！！", "face": "le10a6d9788ec"}, {"name": "メカゴブリンクイーン", "text": "ここは一度退かせてもらうわ。\nまた会いましょう王子、ウフフフッ！", "face": "le10a6d9788ec"}]}, {"trigger": "route", "enemy_ids": [3], "lines": [{"name": "ガオレオン", "text": "くぅぅッ！！　やるではないかッ！！\n我を打ち破るとは、何たる蛮勇かッ！！", "face": "lc0efcabbf44a"}, {"name": "ガオレオン", "text": "まさかこれ程の抵抗を見せてくるとは……ッ！！\nこのマッチの勝利は、お前に譲るとしようッ！！\n良き戦いであったぞッ！　フハハハハッ！！", "face": "lc0efcabbf44a"}]}], "active": true}