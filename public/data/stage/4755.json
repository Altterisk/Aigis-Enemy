agic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 398, "global_id": 397, "spawn_sec": 119}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 400, "global_id": 399, "ranged": true, "spawn_sec": 147}], "dialogue": [{"trigger": "start", "lines": [{"name": "パンプキンキング", "text": "ハイハーイ！　カボチャ達ー！\n今回は絶対に王子の魂を奪わないとダメだからね！\n気合入れていくカボー！", "face": "l215dcaca6d0c"}, {"name": "カボチャの魔物", "text": "でもキング様……。\nドウシテ今回はコンナニ焦らナイといけないカボ？\nコキ使ワレルのもう嫌カボ……。", "face": "l127852b34ebb"}, {"name": "パンプキンキング", "text": "カボチャ魂を出すカボ！　あの方の復活には、\n王子の魂が必要カボ。人間の数も随分減ってるしね。\n今は量より質の時代カボ。", "face": "l215dcaca6d0c"}, {"name": "カボチャの魔物", "text": "フッカツー！？\n王子の魂であの方がフッカツするカボー！？\nクヒヒィッ！！　頑張るカボーッ！", "face": "l127852b34ebb"}, {"name": "パンプキンキング", "text": "その調子カボ！\n王子の魂は活きが良いカボ。絶対に奪うカボ！\n今回は、総力戦で戦うカボ！　おい、お前も戦え！", "face": "l215dcaca6d0c"}, {"name": "エーリカ", "text": "カボッ！！", "face": "u409"}, {"name": "ケイティ", "text": "王子！　\nあそこにカボチャの魔物が！\nエーリカさんの姿も見えます……！", "face": "u114"}, {"name": "兵士", "text": "報告！\nカボチャの魔物、及びスケルトンが現れました！\nこちらへ進攻を開始した模様です！", "face": "l8c4c9afdcef3"}]}, {"trigger": "end", "lines": [{"name": "パンプキンキング", "text": "フシュゥ……。\n……さすが、王子カボ。", "face": "l215dcaca6d0c"}, {"name": "パンプキンキング", "text": "このままじゃ刈り取られて食用にされるカボ……。\nいったん退却して助けを借りるしかないカボ。\nカボチャ達、一時撤退カボ！", "face": "l215dcaca6d0c"}, {"name": "エーリカ", "text": "カボ！", "face": "u409"}, {"name": "カボチャの魔物", "text": "カボ！", "face": "l127852b34ebb"}, {"name": "アンナ", "text": "王子、カボチャ達が撤退していきます！\nエーリカさんも一緒です！", "face": "lc39be04f4aa5"}, {"name": "ユユ", "text": "そんなぁ……。\nあのカボチャ達の中からエーリカさんを\n助け出すのは難しそうです……。", "face": "u110"}, {"name": "ケイティ", "text": "王子、彼らの後を追いましょう。\n王子の魂が狙いのようですし、\nこのまま終わるとも思えません。", "face": "u114"}]}], "active": true}