90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 28}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 2200, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 33}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "tags": ["植物"], "hp": 8800, "attack": 990, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 280, "attack_speed": 100, "attack_wait": 10, "attack_interval": 211, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098960, "special_effect_id": 114, "master_id": 20014, "global_id": 1089, "spawn_sec": 52}, {"enemy_id": 7, "source": "local", "count": 12, "form_count": 1, "hp": 1760, "attack": 440, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 87}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここが神樹のようですね。\n神樹の周りに木の魔物が集まっているようです。\n巫女姫は大丈夫でしょうか……。", "face": "l4762418036dc"}, {"name": "兵士", "text": "敵！　こちらに向かってきます！", "face": "leae7fc43b0f3"}, {"name": "アンナ", "text": "ひとまずここは迎え撃つしかなさそうですね。", "face": "l4762418036dc"}]}, {"trigger": "battle", "at_sec": 56, "lines": [{"name": "アンナ", "text": "くっ……。\n自身の体力を徐々に回復する上にあの巨体……。\nかなりタフそうですね。", "face": "l4762418036dc"}, {"name": "ププル", "text": "あやつの回復力は時間が経てば\n減っていくはずじゃ。", "face": "u225"}, {"name": "アンナ", "text": "どこからか声が……？\nと、とにかく木の魔物の回復効果は有限のようです。", "face": "l4762418036dc"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "なんとか追い払えましたね。\n……それにしても、神樹の元に巫女姫が眠っていると\n聞きましたが、それらしき姿がどこにも……。", "face": "l4762418036dc"}, {"name": "ププル", "text": "巫女姫はわしじゃ。", "face": "u225"}, {"name": "アンナ", "text": "あなたは？\n私たちはここに巫女姫が眠っていると聞いて\nやってきたのですが。"}, {"name": "ププル", "text": "だーかーらー。お主らが捜している、\nドルイドの美少女巫女姫ププルとは\nわしのことじゃ。", "face": "u225"}, {"name": "アンナ", "text": "あ……あなたが巫女姫なんですね。\nププルさん、今回の事件について、\nなにかお心当たりはありませんか？"}, {"name": "ププル", "text": "原因としてはわしの持つ「神樹の枝杖」\nが奪われたからじゃろうな。", "face": "u225"}, {"name": "ププル", "text": "なんせこの杖を持つ者は、\n妖精郷の木々をトレントとして\n操ることができるのじゃ。", "face": "u225"}, {"name": "ププル", "text": "あ、トレントとはお主らが木の魔物と\n呼んでいたやつらのことじゃ。", "face": "u225"}, {"name": "ププル", "text": "そもそも本来トレントはドルイドと\n共に妖精郷の木々を護る存在。", "face": "u225"}, {"name": "ププル", "text": "なのにダークエルフが\n突然わしを起こして……。", "face": "u225"}, {"name": "ププル", "text": "目覚めたわしは恐怖のあまり\n逃げ出すのに精いっぱいじゃった。\nあまりに突然で杖を置いてきてしもうた……。", "face": "u225"}, {"name": "ププル", "text": "ふぇえ……っ、わ、わしのせいじゃぁ～！\nぐすっ、うっ、うわぁああああんっ……！！\nあれがないと大変なのに～っ！！", "face": "u225"}, {"name": "アンナ", "text": "ちょ……ちょっと。\n泣き止みそうにありませんね……。\nまいりましたね……。", "face": "l4762418036dc"}, {"name": "アンナ", "text": "そ、そうだ！\n王子、神樹の枝杖を一緒に探してあげませんか？"}, {"name": "ププル", "text": "本当か！！　よし、良い返事じゃな！\nでは、神樹の枝杖の奪還に向けて作戦会議を\n始めようぞ！", "face": "u225"}, {"name": "アンナ", "text": "は……謀られたのでしょうか……。", "face": "l03758d39a514"}]}], "active": true}