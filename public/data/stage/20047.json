count": 15, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 21}, {"enemy_id": 5, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "spawn_sec": 61}, {"enemy_id": 6, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 91}, {"enemy_id": 7, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 448, "global_id": 447, "ranged": true, "spawn_sec": 98}, {"enemy_id": 8, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110064, "race_id": 12, "special_effect_id": 168, "master_id": 30315, "global_id": 3934, "spawn_sec": 133}, {"enemy_id": 9, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 169}], "popups": ["ワーラットの\n一定範囲内のユニットは\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "グリム", "text": "――魔界、とうちゃくでーす。", "face": "u942"}, {"name": "ラピス", "text": "ここは……魔界闘技場か？", "face": "u436"}, {"name": "グリム", "text": "塔の管理頭脳ちゃんに、\n自動人形の身体を\n与えるのとは仕組みが違いますからねー。", "face": "u942"}, {"name": "レライエ", "text": "本質的には召喚儀式に近い形を取ります。\nなので念のために広い場所を……。", "face": "u1355a1"}, {"name": "アスバール", "text": "――おや？　皆さんお揃いで。\n今は天眼ノ国の助力に向かっているのでは……。", "face": "u1668a1"}, {"name": "グリム", "text": "それがですねー、\n急遽レヴィアタンの協力が必要になりそうで。", "face": "u942"}, {"name": "ラピス", "text": "……敵側が、世界を逆位相の魔界に変える、\n大規模な兵器を持ち出した。\nレヴィアタンの同系統の魔神……神造兵器だそうだ。", "face": "u436"}, {"name": "アスバール", "text": "…………！\nそれは……そんなものを地上で用いたら……。", "face": "u1668a1"}, {"name": "ラピス", "text": "魔王ガリウスが引き起こしかけた、\n破滅の力による物質界の魔界化の再演だ。\nおそらく、被害は甚大なものになる。", "face": "u436"}, {"name": "アスバール", "text": "なるほど、それでは儀式を前倒ししましょう。\n幸い、こちらに専念していたおかげで、\nレヴィアタンの受肉儀式の準備は整っています。", "face": "u1668a1"}, {"name": "レライエ", "text": "問題があるとすれば、\n儀式を開始すると、とんでもない魔力が漏れ出すので、\nたぶん魔物がやまほど襲いかかってくることですが……。", "face": "u1355a1"}, {"name": "アスバール", "text": "…………（にこにこ）", "face": "u1668a1"}, {"name": "ラピス", "text": "…………（ふんっ）", "face": "u436"}, {"name": "レライエ", "text": "これなら大丈夫そうですね。", "face": "u1355a1"}, {"name": "アスバール", "text": "それでは、儀式を始めます。\n皆さん、心の準備はよろしいですね？", "face": "u1668a1"}]}, {"trigger": "end", "lines": [{"name": "アスバール", "text": "……儀式は成功です。\nあとは、レヴィアタンが外に出る意志を固めてくれれば。", "face": "u1668a1"}, {"name": "グリム", "text": "器は用意しなくて良いのですか？", "face": "u942"}, {"name": "アスバール", "text": "管理頭脳を移すのとは根本の仕組みが異なりますから。\nレヴィアタンの魔力で肉体を作ってもらって、\nそこに対話可能な人格を移してもらうのが正解です。", "face": "u1668a1"}, {"name": "アスバール", "text": "あとは、眠っている彼女を起こすだけ。", "face": "u1668a1"}, {"name": "ラピス", "text": "…………任せろ。", "face": "u436"}]}, {"trigger": "end", "lines": [{"name": "ラピス", "text": "――魔神レヴィアタン。\n聞こえるか？", "face": "u436"}, {"name": "？？？", "text": "……あれ、あなたは？", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "ラピスだ。\nお前の背中で長年暮らしていた。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "ああ、あの――白い神官の子に逃げられてた。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "あれは逃がしたんだ。誤解するな。\nそれに、ちゃんと仲直りした。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "ふふっ、そうなんですね。\nそれで、私を起こしに来たのはなぜ？", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "お前の力が必要だ。\n敵はリヴァイアサン、お前の同型の存在と聞いている。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "ああ、あの偽物……？\n破壊神が作った、ちっちゃい私ですね。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "……やはり破壊神絡みだったか。まぁいい。\nともかく、お前なら奴の逆位相の瘴気を打ち消せるか？", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "私だけじゃ、無理ですねぇ……。\n最近やけに流れ込んでくる魔力のおかげで、\n人格部分だけが目覚めましたけど、本体は……。", "face": "lfe7a12f0fc1b"}, {"name": "レヴィアタンの化身", "text": "ほら、私の本体が目覚めたら、\n私の身体に住んでるみんなも、\n物質界も、ひっくり返っちゃいますし。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "受肉の儀式は、先程完了した。\nお前には、人の形でついてきてもらう。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "わっ……それなら、大丈夫そうですね。\nでも、今度は別の問題がありますよ？", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "なんだ。言え。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "リヴァイアサンの、環境改造機能を打ち消すなら、\n私本体の魔力をぶつければいい。\nでも、私の人格だけでは、それだけの出力はない。", "face": "lfe7a12f0fc1b"}, {"name": "レヴィアタンの化身", "text": "私が開く門から、\n魔界の魔力を引っ張り出す役割が必要です。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "わたしがやる。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "話は最後まで聞きましょうよ。\nたぶん――死にますよ？", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "……かまわない。\nわたしはデーモンだ。いつかまた、復活できる。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "……すごく痛いだろうし、苦しいはずなのに。\nそんなにしてまで、助けてあげたい人がいるんですね。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "…………否定はしない。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "ふふっ、では力を貸しましょう。\n――我が契約者、名を。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "ラピスだ。", "face": "u436"}, {"name": "レヴィアタンの化身", "text": "ラピス。\nでは、私もあなたに求めます。\n此度の戦いが終わったら、私に名前をくださいね。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "いいだろう。\n最高の名前をつけてやる。", "face": "u436"}]}], "map": {"image": "Map7523", "w": 960, "h": 640, "spots": [{"k": "b", "x": 555, "y": 533}, {"k": "b", "x": 925, "y": 265}, {"k": "b", "x": 555, "y": 12}, {"k": "m", "x": 550, "y": 97, "id": 200}, {"k": "m", "x": 550, "y": 470, "id": 201}, {"k": "m", "x": 310, "y": 470, "id": 202}, {"k": "m", "x": 430, "y": 470, "id": 203}, {"k": "m", "x": 670, "y": 470, "id": 204}, {"k": "m", "x": 400, "y": 97, "id": 205}, {"k": "m", "x": 160, "y": 175, "id": 206}, {"k": "m", "x": 160, "y": 345, "id": 207}, {"k": "m", "x": 290, "y": 265, "id": 208}, {"k": "m", "x": 735, "y": 265, "id": 209}, {"k": "m", "x": 700, "y": 97, "id": 210}, {"k": "m", "x": 190, "y": 470, "id": 211}, {"k": "m", "x": 250, "y": 97, "id": 212}, {"k": "m", "x": 405, "y": 265, "id": 213}, {"k": "m", "x": 790, "y": 470, "id": 214}, {"k": "m", "x": 597, "y": 264, "id": 215}, {"k": "m", "x": 123, "y": 99, "id": 216}, {"k": "m", "x": 812, "y": 97, "id": 217}, {"k": "m", "x": 883, "y": 470, "id": 218}, {"k": "r", "x": 290, "y": 155, "id": 300}, {"k": "r", "x": 255, "y": 345, "id": 301}, {"k": "r", "x": 340, "y": 345, "id": 302}, {"k": "r", "x": 615, "y": 140, "id": 303}, {"k": "r", "x": 570, "y": 425, "id": 304}, {"k": "r", "x": 825, "y": 425, "id": 305}, {"k": "r", "x": 200, "y": 425, "id": 306}], "events": [{"t": 183.2, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "WhiteOut3", "x": 480, "y": 320}]}]}, "active": true}