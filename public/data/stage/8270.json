ed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "change_to": 14, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31912, "global_id": 5531, "to_global_id": 5532, "spawn_sec": 202}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 4, "special_effect_id": 415, "change_to": 15, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31913, "global_id": 5532, "ranged": true, "to_global_id": 5533}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 9000, "attack": 450, "base_hp": 9000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 16, "master_id": 31914, "global_id": 5533, "to_global_id": 5534}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31915, "global_id": 5534, "ranged": true}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 2, "hp": 10, "base_hp": 10, "damage_type": "physical", "attack_speed": 1, "attack_wait": 30, "attack_interval": 72, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2141504, "race_id": 4, "change_to": 4, "change_condition": 2, "master_id": 35699, "global_id": 9316, "to_condition": 2, "to_global_id": 9317, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 231}], "popups": ["エンジュがいる間は\n全ての敵の攻撃と防御が\nアップします。\n\nまた、敵のジューンブライド属性\nユニットはさらに攻撃と防御が\nアップします。\n　　　　　　(1/2)", "エンジュは、自身の攻撃力の値で\n自身を含む周囲の敵を回復します。\n\n\n\n\n\n　　　　　　(2/2)", "猫又コハルがいる間は\n味方の攻撃力と防御力が\n『25％』低下し、\n敵の攻撃力と防御力が\n『10％』低下します。", "三味線の付喪神が\n動き出すと敵の妖怪の\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "チャムチャム", "text": "とうちゃくー！！！！", "face": "u2146a1"}, {"name": "ヨシノ", "text": "やあやあ、ようこそ東の国へ。待ってたよー。", "face": "u1104a1"}, {"name": "シノ", "text": "皆様、長旅ご苦労様でした。\nエンジュ殿、今日はよろしくお願いしますね。", "face": "u403"}, {"name": "エンジュ", "text": "ぬらりひょんの娘か。ううむ、やはりやらねばならんかの？", "face": "u2170a1"}, {"name": "シノ", "text": "もちろんです、エンジュ殿。\n今日は我ら妖怪にとっても重要な日。\nどうか貴方のお力添えを賜りたく。", "face": "u403"}, {"name": "エンジュ", "text": "祭りの縁起物として呼ばれたかと思えば、\nまさか我自身が花嫁役になるとはなぁ……。", "face": "u2170a1"}, {"name": "エンジュ", "text": "我、座敷わらしぞ？\nこの国の者は『わらし』の意味を知らんのか？", "face": "u2170a1"}, {"name": "シノ", "text": "人間と妖怪の共存に必要なことです。", "face": "u403"}, {"name": "ヨシノ", "text": "まあまあ、コマちゃんもやったんだしさ。", "face": "u1104a1"}, {"name": "エンジュ", "text": "全国のわらしたちー！\n『誰々もやったんだからさ』とか言ってくる、\n悪い大人の誘いに乗ってはならぬぞー！", "face": "u2170a1"}, {"name": "コハル", "text": "落ち着きなよ、大妖怪の威厳が台無しだぜ？", "face": "u450"}, {"name": "コハル", "text": "せっかくそんな立派な衣裳を着てるんだ。\nあんたの舞いで、ここにいる連中の視線を奪っちまおう。", "face": "u450"}, {"name": "コハル", "text": "なぁに、吟遊詩人さんもいるし、\nあたしだって手伝ってやるからさ。", "face": "u450"}, {"name": "エンジュ", "text": "……ふん、そこまで言うのなら仕方がない。\n引き受けた手前、逃げるのも性に合わんしな。", "face": "u2170a1"}, {"name": "エンジュ", "text": "──猫又、合わせろよ？", "face": "u2170a1"}, {"name": "コハル", "text": "にゃふ、誰に言ってんのさ。", "face": "u450"}, {"name": "エンジュ", "text": "みゅーじっく。", "face": "u2170a1"}, {"name": "コハル", "text": "すたーと。(べべん)", "face": "u450"}]}, {"trigger": "end", "lines": [{"name": "シノ", "text": "──見事な演舞でした、エンジュ殿。", "face": "u403"}, {"name": "エンジュ", "text": "うむ、我は偉大にして至高の大妖怪なれば、\nこの程度のたわむれなどは造作もないことよ。", "face": "u2170a1"}, {"name": "コハル", "text": "『ぎたぁ』と合わせるのは初めてだったけど、\n悪くない『せっしょん』ができたんじゃないかい？", "face": "u450"}, {"name": "ヨシノ", "text": "いやぁ、ひとまず大成功ってところかな。\n見た感じ、お客さんの反応も上々みたいだし──", "face": "u1104a1"}, {"name": "青年", "text": "（妖怪って怖いイメージだったけど、\nそれ以上に神秘的で雅やかなんだな……）", "face": "l39d391838529"}, {"name": "おじさん", "text": "（妻と行けなかった新婚旅行……\n今からでも遅くはないかもしれんな……）", "face": "l65de89a60cda"}, {"name": "ヨシノ", "text": "うん、経済が回る予感がするねぇ！\nいやー、エンジュちゃん様々だなー！", "face": "u1104a1"}, {"name": "シノ", "text": "妖怪への『畏れ』と『憧憬』の強まりを感じます。\nこれでまた一歩、共存共栄の未来に前進ですね。", "face": "u403"}, {"name": "エンジュ", "text": "我は疲れた。茶とせんべえを要求する。", "face": "u2170a1"}, {"name": "ヨシノ", "text": "誰かおせんべい買ってきてー！　駆け足！", "face": "u1104a1"}, {"name": "コウメ", "text": "こんなこともあろうかと用意してあります！", "face": "u1312a1"}, {"name": "コマ", "text": "（コマのおやつ……！？）", "face": "u1515a1"}, {"name": "ヨシノ", "text": "でかした！　マレスのお金で百年無税！", "face": "u1104a1"}, {"name": "コウメ", "text": "ひゅー！　神様ってやつぁ太っ腹だぜぇぃ！\nコマちゃん！　今日はお饅頭買って帰りますよ！", "face": "u1312a1"}, {"name": "コマ", "text": "わーい♪", "face": "u1515a1"}, {"name": "シズカ", "text": "やめときなさいな、後が怖いわよ。", "face": "u101"}, {"name": "プロエ", "text": "む、そのマレス様は何処へ……？", "face": "u1768a1"}, {"name": "ウルカノ", "text": "自分がいたら邪魔だろうからって、裏に引っ込んでるぜ。", "face": "u1669a1"}, {"name": "プロエ", "text": "（馬鹿な、マレス様にそんな気遣いできるはずが……！？）", "face": "u1768a1"}, {"name": "チャムチャム", "text": "次は天界だよー！　遅れないでねー！", "face": "u2146a1"}]}], "active": true}