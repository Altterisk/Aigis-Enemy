id": 262, "global_id": 261, "spawn_sec": 94}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 13000, "attack": 400, "base_hp": 13000, "base_attack": 400, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 400, "attack_wait": 60, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114624, "race_id": 9, "special_effect_id": 293, "change_to": 17, "change_condition": 1, "missile_id": 26, "master_id": 31048, "global_id": 4667, "ranged": true, "variants": [{"tags": ["アーマー", "機械"], "hp": 13000, "attack": 1500, "base_hp": 13000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 800, "magic_defense": 10, "attack_wait": 80, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114640, "race_id": 9, "master_id": 31049, "global_id": 4668}], "spawn_sec": 136}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 156}, {"enemy_id": 20, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 163}], "dialogue": [{"trigger": "start", "lines": [{"name": "メカゴブリンクイーン", "text": "ウフフ、存外早かったわね。\nもう追いついてきたなんて。", "face": "l6b9b31c94450"}, {"name": "マイン", "text": "やいやい！　ゴブリンども！\nてめぇら『浮遊石』を返しやがれ！", "face": "u672"}, {"name": "メカゴブリンクイーン", "text": "クチの悪い娘ね……。\nでも勝ち気なところは嫌いじゃないわ。\nちょっと相手をしてあげてもいいけれど――", "face": "l6b9b31c94450"}, {"name": "メカゴブリンクイーン", "text": "――でも、もう手遅れなのよ。\nオォ～ホッホッホ！！", "face": "l6b9b31c94450"}, {"name": "マイン", "text": "手遅れ……手遅れだって？", "face": "u672"}, {"name": "グスタフ", "text": "ひぃ、ひぃ……ふぃぃ、やっと追いついたわい。\nそれより、おいマイン、王子、大変じゃ！", "face": "u153"}, {"name": "マイン", "text": "なんだよ、いったいどうしたんだジジィ。\n今この高笑い女を問い詰めてるトコで――", "face": "u672"}, {"name": "グスタフ", "text": "ゴブリン共、あの鉱脈だけじゃなく、\n周辺の『浮遊石』を殆ど盗掘しておったんじゃ！", "face": "u153"}, {"name": "メカゴブリンクイーン", "text": "ウフフ、そういうことよ。\n既に十分な量の『浮遊石』は確保したのよ。\nだからこの場所にもう用はないのよ……！！", "face": "l6b9b31c94450"}, {"name": "グスタフ", "text": "ぐぬっ、ゴブリンの手にそんな大量の\n『浮遊石』が渡ったら、\nどんな悪用をされるかわからんぞ……！？", "face": "u153"}, {"name": "マイン", "text": "渡しゃしねぇよ！\nぜーんぶ取り戻してやる！！", "face": "u672"}, {"name": "アンナ", "text": "ええ、そうですね……！\n王子、マインさん、何としてでも、\nメカゴブリンクイーンたちの逃走を防ぎましょう！", "face": "ldbe7f0a6cdf4"}]}, {"trigger": "end", "lines": [{"name": "メカゴブリンクイーン", "text": "ウフ……やるようになったわね。\nでもこれで終わりよ！", "face": "l6b9b31c94450"}, {"name": "マイン", "text": "あぁん！？　そりゃいったいどういうことだ！", "face": "u672"}, {"name": "メカゴブリンクイーン", "text": "この通路、ゴブリン博士特製の爆薬で、\n爆破してやったらどうなるかしらねぇ！", "face": "l6b9b31c94450"}, {"name": "グスタフ", "text": "しまった……！！\nこのあたりの岩石は崩れやすいんじゃ！\nこんなところで、あれだけの爆薬に着火したら……ッ！", "face": "u153"}, {"name": "メカゴブリンクイーン", "text": "ウフフ！　無様にあがくがいいわぁ！\nそーれポチッとぉ！", "face": "l6b9b31c94450"}, {"name": "ソーマ", "text": "きゃぁぁ！？\nか、壁が崩れて……けほっ、\n通路が塞がれてしまいました……！！", "face": "u23"}, {"name": "マイン", "text": "けほっ、けほっ。\nあんにゃろう、この狭い空間に\nなんて量の爆薬を仕掛けてやがんだ……！", "face": "u672"}, {"name": "ケイティ", "text": "後退して他の出口を\n探すしかないのでしょうか……。", "face": "u114"}, {"name": "グスタフ", "text": "いや、それでは時間が足らんじゃろう。\nどれ、ならばワシが壁を発破して――", "face": "u153"}, {"name": "マイン", "text": "――アタシにまかせてくれ。", "face": "u672"}, {"name": "マイン", "text": "行きの道中じゃ失敗しちまったけど、\nその埋め合わせをさせてほしい。\n今度は無事に大穴をあけてやるぜ！", "face": "u672"}, {"name": "ケイティ", "text": "マインさん……。\n王子、どうなさいますか？", "face": "u114"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "マイン", "text": "へへっ、ありがとな！\nそれじゃあ皆、少し下がってくれ。\n爆薬よし、距離よし、いくぜ――発破ァ！！", "face": "u672"}, {"name": "アンナ", "text": "すごい……壁に大きな穴が！\n王子、通路が確保されました。\n急いでメカゴブリンクイーンを追いましょう！！", "face": "ldbe7f0a6cdf4"}]}], "active": true}