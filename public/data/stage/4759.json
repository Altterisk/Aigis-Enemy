160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 62}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "special_effect_id": 499, "master_id": 682, "global_id": 681, "spawn_sec": 79}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "missile_id": 6, "master_id": 355, "global_id": 354, "ranged": true, "spawn_sec": 90}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 210, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106576, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 836, "global_id": 835, "ranged": true, "spawn_sec": 131}, {"enemy_id": 12, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 144}], "dialogue": [{"trigger": "start", "lines": [{"name": "パンプキンキング", "text": "全てのカボチャ達……！\nこれより、このカボチャ魂をビフロンス様の元に戻し、\nビフロンス様を再召喚するカボ！！", "face": "l215dcaca6d0c"}, {"name": "パンプキンキング", "text": "元よりビフロンス様に頂いたこの命、\n惜しくはないカボッ！", "face": "l215dcaca6d0c"}, {"name": "パンプキンキング", "text": "ボク達の魂を全て使えば……\nビフロンス様は必ずや再び姿を現してくれるカボ！！", "face": "l215dcaca6d0c"}, {"name": "カボチャの魔物", "text": "カボーーーーーーー！", "face": "l127852b34ebb"}, {"name": "エーリカ", "text": "カボーーーーーーー！", "face": "u409"}, {"name": "アンナ", "text": "カボチャ達がどんどん消えていく！？\nこれは一体……？", "face": "ld51aa19f5fed"}, {"name": "ケイティ", "text": "先ほどビフロンスの精神体が現れた時も、\n数体のカボチャが消えていくのを確認しました。\n今度は全員の魂を供物とする気なのでは……！", "face": "u114"}, {"name": "ユユ", "text": "じ、じゃあエーリカさんも！？\n一体どうなっちゃうの……？", "face": "u110"}, {"name": "兵士", "text": "――ほ、報告ッ！\n魔神ビフロンスが現れました！！", "face": "l8c4c9afdcef3"}, {"name": "ケイティ", "text": "王子、ビフロンスです。いまだ精神体のようですが、\n以前よりも明らかに禍々しい力を感じます。\nお気を付け下さい！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "魔神ビフロンスの姿が消えた……。\nどうやら、精神体は魔界へと還っていったようですね。", "face": "u114"}, {"name": "アンナ", "text": "王子、エーリカさんが倒れています……！\n良かった……生きていたんですね……。"}, {"name": "エーリカ", "text": "……ん、ぅぅ…………あれ？\nここは？　それに私、今まで何を……？", "face": "u409"}, {"name": "ユリアン", "text": "……そうか、エーリカは結局人間だから、\nビフロンスに創られた魔物達と違って、魂を\n魔神に捧げることは出来なかったって事か……。", "face": "u7"}, {"name": "エーリカ", "text": "ビフロンス……？\n魔物……？", "face": "u409"}, {"name": "アンナ", "text": "まさか、今までのことは全部覚えていないのでしょうか？", "face": "ld51aa19f5fed"}, {"name": "ユリアン", "text": "……カボチャ達に操られていた事なんて、\nむしろ覚えていない方が本人にとっちゃいいのかもな。", "face": "u7"}, {"name": "エーリカ", "text": "……カボチャ？\nうっ……何だかすごく懐かしい響き……だけど、\nよく思い出せないな……。", "face": "u409"}, {"name": "エーリカ", "text": "――あッ！？\nあなたのことは知ってるよ！\nえっと……そう、王子！　王子の魂が私は欲しいの！", "face": "u409"}, {"name": "ケイティ", "text": "……！　まだ、完全に操りが解けてない……！？\n王子、ご注意を……！", "face": "u114"}, {"name": "エーリカ", "text": "……あれ？　魂？\nあれ？　何でそんなものを欲しがってたんだろう……。", "face": "u409"}, {"name": "エーリカ", "text": "とにかく、今は王子の傍にいさせてください……。\n……それに、魔物から助けてくれたお礼とかも……、\nちゃんと、しないと……ダメ、だもん…………ね……。", "face": "u409"}, {"name": "ユリアン", "text": "おいおい！？\nエーリカのやつ、また気を失っちまったみたいだぞ？", "face": "u7"}, {"name": "アンナ", "text": "まだ心身が疲弊しているのでしょう。\n彼女との話の続きはきちんと養生してからですね。\nそれでは王子、帰還しましょう。", "face": "ld51aa19f5fed"}]}], "active": true}