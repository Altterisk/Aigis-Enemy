ge_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30238, "global_id": 3857, "ranged": true, "from_condition": 0}, {"enemy_id": 12, "source": "local", "count": 9, "form_index": 0, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 10, "master_id": 31734, "global_id": 5353, "to_condition": 0, "to_global_id": 3857, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 99}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30238, "global_id": 3857, "ranged": true, "from_condition": 0}], "dialogue": [{"trigger": "start", "lines": [{"name": "シャルキー", "text": "――こ、これは……！\n街が魔界アリで溢れかえってますよぉ……！？", "face": "u965"}, {"name": "エイル", "text": "工場長――もといデーモンシェフが、\n私達を足止めするために魔界アリを放ったのでしょうか？", "face": "u804"}, {"name": "オーガスタ", "text": "確かにその可能性も――っと、\nおやや？　すんすん、この甘い香りは……。", "face": "u960"}, {"name": "シャルキー", "text": "わっ、甘い香りがしますね！\nチョコレートに、お砂糖に、果物の香りも！", "face": "u965"}, {"name": "メーリス", "text": "もしかして、魔界アリ達は\nチョコレート工場の甘い香りに\n引き寄せられたんじゃない？", "face": "u78"}, {"name": "キャンディ", "text": "うんうん、甘いものは正義ですからね。\nしかしこのままでは、魔物が落としていった\n砂糖やチョコと一緒に街がかじられちゃいますよ！", "face": "u691"}, {"name": "ケイティ", "text": "この街を魔物から取り戻した後のためにも、\nここで魔界アリは駆除しておいた方が良いでしょうね。", "face": "u114"}, {"name": "アンナ", "text": "王子、魔界アリは群れで向かってくるかと思います。\n慎重な指揮をお願いします！", "face": "lff330ed655d9"}]}, {"trigger": "end", "lines": [{"name": "エイル", "text": "物音がしなくなりましたね……。\nどうやら、大半の魔界アリは駆除できたようです。", "face": "u804"}, {"name": "シャルキー", "text": "よぉし、寄り道しちゃいましたが、\n早く工場内の捜索に戻りましょう！", "face": "u965"}, {"name": "キャンディ", "text": "原因であるお菓子工場をどうにかしないと、\nまた魔界アリが集まってくる可能性もありますからね。", "face": "u691"}, {"name": "シャルキー", "text": "チョコを悪事に使うし、材料をこぼして\n魔界アリまで呼び寄せちゃうし、\nデーモンシェフ、絶対許しませんからねー！", "face": "u965"}]}], "map": {"image": "Map920138_3489", "w": 960, "h": 640, "spots": [{"k": "b", "x": 43, "y": 315}, {"k": "m", "x": 320, "y": 285, "id": 200}, {"k": "m", "x": 310, "y": 365, "id": 201}, {"k": "m", "x": 190, "y": 285, "id": 202}, {"k": "m", "x": 450, "y": 275, "id": 203}, {"k": "m", "x": 555, "y": 350, "id": 204}, {"k": "m", "x": 695, "y": 255, "id": 205}, {"k": "m", "x": 685, "y": 335, "id": 206}, {"k": "m", "x": 825, "y": 250, "id": 207}, {"k": "m", "x": 335, "y": 191, "id": 208}, {"k": "m", "x": 699, "y": 175, "id": 209}, {"k": "m", "x": 565, "y": 270, "id": 210}, {"k": "m", "x": 440, "y": 355, "id": 211}, {"k": "m", "x": 290, "y": 450, "id": 212}, {"k": "m", "x": 716, "y": 429, "id": 213}, {"k": "m", "x": 180, "y": 365, "id": 214}, {"k": "m", "x": 815, "y": 330, "id": 215}, {"k": "r", "x": 617, "y": 180, "id": 300}, {"k": "r", "x": 411, "y": 189, "id": 301}, {"k": "r", "x": 638, "y": 415, "id": 302}, {"k": "r", "x": 363, "y": 427, "id": 303}, {"k": "r", "x": 240, "y": 203, "id": 304}, {"k": "r", "x": 784, "y": 167, "id": 305}, {"k": "r", "x": 805, "y": 387, "id": 306}, {"k": "r", "x": 214, "y": 417, "id": 307}]}, "start_cost": 10, "active": true, "story_talk": true}