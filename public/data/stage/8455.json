: 12058, "to_global_id": 12059}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 24000, "attack": 800, "base_hp": 24000, "base_attack": 800, "damage_type": "magical", "armor_defense": 250, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127232, "race_id": 4, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 38442, "global_id": 12059, "ranged": true}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 300, "base_hp": 30000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 10, "attack_wait": 60, "attack_interval": 176, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2153104, "race_id": 4, "special_effect_id": 1718, "master_id": 38438, "global_id": 12055, "spawn_sec": 165}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 2, "tags": ["置物", "雪の聖霊"], "fixture": true, "hp": 4000, "attack": 10, "base_hp": 4000, "base_attack": 10, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 60, "attack_interval": 162, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2158288, "special_effect_id": 1961, "change_to": 20, "master_id": 38450, "global_id": 12067, "to_global_id": 12068, "spawn_sec": 265}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "雪の聖霊"], "fixture": true, "hp": 4000, "attack": 10, "base_hp": 4000, "base_attack": 10, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 60, "attack_interval": 162, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2158288, "special_effect_id": 1962, "change_to": 19, "master_id": 38451, "global_id": 12068}, {"enemy_id": 22, "source": "local", "count": 1, "form_count": 1, "tags": ["雪娘"], "hp": 16000, "attack": 400, "base_hp": 16000, "base_attack": 400, "damage_type": "magical", "armor_defense": 100, "attack_range": 250, "attack_speed": 1, "attack_wait": 45, "attack_interval": 145, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2158272, "special_effect_id": 1960, "missile_id": 1207, "missile": {"speed": 6.0, "slow": [100, 60], "on_hit": {"kind": "攻撃遅延", "duration_f": 120, "attack_interval_f": 90, "effect_name": "HitEffectSlow"}}, "master_id": 38449, "global_id": 12066, "ranged": true, "commands": {"raw": "RegisterDisposalEnemyElement(\"雪の聖霊\");"}, "spawn_sec": 265}], "popups": ["あかなめから\n攻撃を受けると\n攻撃後の待ち時間が増加します。", "カゴメは攻撃を受けると\n受けたダメージの50%のダメージで\n攻撃したユニットへ反撃を行います。", "雪の聖霊がいる間は、\n味方の攻撃力がダウンします。\n\nまた雪の聖霊がいる間は、\nしづりの攻撃力がアップします。", "しづりの攻撃を受けた\n味方ユニットは3秒間、\n防御力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ハイデマリー", "text": "ええと、ここは妖力向上の温泉だったかな？", "face": "u2340a1"}, {"name": "カゴメ", "text": "──頑張れ！　頑張れ！　頑張れ！", "face": "u2061a1"}, {"name": "ヤシマ", "text": "も、もう無理だぽ～ん！", "face": "u1019a1"}, {"name": "カゴメ", "text": "どうしてそこで諦めるんですか！\nヤシマさんなら絶ッ対にできます！\n頑張りましょう！　頑張るんですよ！", "face": "u2061a1"}, {"name": "ハイデマリー", "text": "え、地獄？", "face": "u2340a1"}, {"name": "しづり", "text": "む、そなたはハイデマリーだったか。\n確かこの温泉を見つけ出したとかいう。", "face": "u2049a1"}, {"name": "ハイデマリー", "text": "そ、そうです。あなたは雪妖の……しづり、さま？", "face": "u2340a1"}, {"name": "しづり", "text": "うむ、わらわこそが次代冬将軍しづりである。\nこの素晴らしい温泉を教えてくれた礼に、\n特別にわらわがこの状況を説明してやろう。", "face": "u2049a1"}, {"name": "しづり", "text": "この温泉は我々にとって楽園でな。\nどれだけ強力な妖術を連続で行使しようとも、\n使う先から妖力を補充してくれる夢のような場所だ。", "face": "u2049a1"}, {"name": "しづり", "text": "するとそこで追い回されている妖狸が言い出した。\n人気闘兵凱旋パレードに向けて妖術の練習をするぽん。\nこの温泉に入りながらやれば無限に頑張れるぽん──とな。", "face": "u2049a1"}, {"name": "しづり", "text": "中々に殊勝な考え方だったが、言葉選びが悪かったな。\n無限に頑張るという単語に反応して『あれ』が出てきた。", "face": "u2049a1"}, {"name": "カゴメ", "text": "できる！　できる！　絶対にできる！　負けないで！", "face": "u2061a1"}, {"name": "ハイデマリー", "text": "そういう妖怪ですか？", "face": "u2340a1"}, {"name": "しづり", "text": "妖怪だが？", "face": "u2049a1"}, {"name": "ヤシマ", "text": "怖いぽ～ん！　しづりさん助けてぽ～ん！", "face": "u1019a1"}, {"name": "ハイデマリー", "text": "……あの、助けないんですか？", "face": "u2340a1"}, {"name": "しづり", "text": "一つ助言しておこう、ぬり壁に関わるのはやめておけ。\nある種の災害だ、自ら死地に踏み込むこともないだろう。", "face": "u2049a1"}, {"name": "ハイデマリー", "text": "（東の国こわぁ……）", "face": "u2340a1"}, {"name": "ヤシマ", "text": "ハイデマリーざぁん！　たずげでぼ～ん！", "face": "u1019a1"}, {"name": "ハイデマリー", "text": "うわこっち来たぁ！？", "face": "u2340a1"}, {"name": "カゴメ", "text": "むっ、新しい頑張り人ですか！？　頑張り人ですね！？\n頑張りますか？　頑張りますね？　では頑張りましょう！！", "face": "u2061a1"}, {"name": "カゴメ", "text": "頑張れッ！！　私も頑張りますッ！！", "face": "u2061a1"}, {"name": "ハイデマリー", "text": "こっ、こっち来ないでぇーッ！？", "face": "u2340a1"}, {"name": "しづり", "text": "……まったく、やれやれ。", "face": "u2049a1"}]}, {"trigger": "end", "lines": [{"name": "しづり", "text": "──そのあたりでやめておけ、\nさもなくばこの一帯を凍らせる。", "face": "u2049a1"}, {"name": "カゴメ", "text": "むむむ、それは困っちゃいますね。\n凍ってしまったら頑張れませんから。", "face": "u2061a1"}, {"name": "ヤシマ", "text": "つ、疲れたぽん……。", "face": "u1019a1"}, {"name": "ハイデマリー", "text": "どうして、私まで……。", "face": "u2340a1"}, {"name": "しづり", "text": "ふむ、悪かったなハイデマリーよ。\n妖が迷惑をかけたこと、謝罪しよう。", "face": "u2049a1"}, {"name": "しづり", "text": "あれもあれで、有用なところはあるのだがな……。", "face": "u2049a1"}, {"name": "しづり", "text": "まあ、そなたもこれから長く王国にいるのなら、\n今後は妖怪との付き合いも増えることだろう。", "face": "u2049a1"}, {"name": "しづり", "text": "思考が極端な者も多いが基本は気の良い奴らだ。\nこれを機に程良い距離感を学んでいってほしい。", "face": "u2049a1"}, {"name": "ハイデマリー", "text": "わ、分かりました……。", "face": "u2340a1"}, {"name": "しづり", "text": "そなたも疲れているだろう、後始末はわらわに任せよ。\nそろそろ食事時だ、旅館に戻ってゆっくりするといい。", "face": "u2049a1"}, {"name": "ハイデマリー", "text": "……ありがとうございます、そうさせてもらいます。", "face": "u2340a1"}, {"name": "ヤシマ", "text": "王子たちによろしくぽ～ん……。", "face": "u1019a1"}, {"name": "カゴメ", "text": "ハイデマリーさん！　今度は一緒に頑張りましょうね！", "face": "u2061a1"}, {"name": "ハイデマリー", "text": "あははは……ちょっと遠慮したいかなー？", "face": "u2340a1"}]}], "active": true}