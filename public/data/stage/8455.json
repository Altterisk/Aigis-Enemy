{"quest_id": 8455, "name": "妖怪たちの楽園", "description": "妖力向上の湯では、カゴメに応援される\nヤシマとそれを眺めるしづりがいて……。\n＜温泉効果：敵のHPが徐々に回復＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["温泉効果：敵のHPが徐々に回復"], "event": "人気闘兵凱旋パレードV", "event_category": "History", "mission_id": 920224, "map_no": 4968, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 29, "params": [0, 60, 10]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 10, "base_hp": 10, "damage_type": "physical", "attack_speed": 1, "attack_wait": 30, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158304, "race_id": 4, "special_effect_id": 1293, "change_to": 1, "change_condition": 2, "master_id": 38459, "global_id": 12076, "to_condition": 2, "to_global_id": 12070}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4500, "attack": 350, "base_hp": 4500, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 45, "attack_wait": 80, "attack_interval": 248, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158320, "race_id": 4, "master_id": 38453, "global_id": 12070, "from_condition": 2, "spawned_on_death_by": [1, 3]}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 2, "hp": 10, "base_hp": 10, "damage_type": "physical", "attack_speed": 1, "attack_wait": 30, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158304, "race_id": 4, "change_to": 1, "change_condition": 2, "master_id": 38452, "global_id": 12069, "to_condition": 2, "to_global_id": 12070, "route_behaviour": {"transforms": [{"wait": 60}]}}, {"enemy_id": 4, "source": "local", "count": 19, "form_count": 1, "hp": 6000, "attack": 550, "base_hp": 6000, "base_attack": 550, "damage_type": "physical", "ar