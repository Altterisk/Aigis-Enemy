{"quest_id": 20002, "name": "外部交流を拒む者", "description": "王子たちは逃げたクダギツネに追いつくも、\n待ち伏せしていた妖怪と獣人が現れて……？\n襲い来る敵を打ち払え！\n極級（★１獲得の目安：平均Lv25）", "event": "雪の枝に花火が咲く", "event_category": "Emergency", "mission_id": 200574, "map_no": 7463, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 11}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 20}, {"enemy_id": 4, "source": "local", "count": 10, "form_count": 1, "tags": ["式神"], "hp": 3600, "attack": 300, "base_hp": 3600, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 5, "attack_range": 180, "attack_speed": 70, "attack_wait": 80, "attack_interval": 215, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2166592, "race_id": 4, "special_effect_id": 2280, "missile_id": 1457, "missile": {"speed": 6.0, "splash": 107}, "master_id": 39545, "global_id": 13162, "ranged": true, "spawn_sec": 40}, {"enemy_id": 5, "source": "local", "count": 19, "form_count": 1, "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 40, "attack_speed": 1, "attack_wait": 1, "attack_interval": 20, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2145712, "race_id": 12, "special_effect_id": 621, "master_id": 36329, "global_id": 9946, "spawn_sec": 42}, {"enemy_id": 6, "source": "local", "count": 8, "form_count": 1, "hp": 3200, "attack": 200, "base_hp": 3200, "base_attack": 200, "damage_type": "physical", "armor_defense": 80, "attack_range": 210, "attack_speed": 37, "attack_wait": 35, "attack_interval": 139, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2165136, "race_id": 12, "special_effect_id": 234, "missile_id": 1411, "missile": {"speed": 5.0}, "master_id": 39287, "global_id": 12904, "ranged": true, "spawn_sec": 55}, {"enemy_id": 7, "source": "local", "count": 10, "form_count": 1, "hp": 7000, "attack": 550, "base_hp": 7000, "base_attack": 550, "damage_type": "physical", "armor_defense": 240, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 45, "attack_interval": 139, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2162368, "race_id": 12, "special_effect_id": 1415, "change_to": 7, "change_condition": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 39000, "global_id": 12617, "ranged": true, "variants": [{"hp": 7000, "attack": 750, "base_hp": 7000, "base_attack": 750, "damage_type": "physical", "armor_defense": 240, "magic_defense": 10, "attack_speed": 5, "attack_wait": 20, "attack_interval": 76, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2162384, "race_id": 12, "master_id": 39001, "global_id": 12618}], "spawn_sec": 62}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 1, "hp": 7000, "attack": 450, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 120, "magic_defense": 10, "attack_range": 120, "attack_wait": 60, "attack_interval": 207, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2171824, "race_id": 4, "special_effect_id": 2484, "missile_id": 11, "master_id": 40914, "ranged": true, "spawn_sec": 105}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "attack_interval": 164, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100016, "race_id": 4, "master_id": 863, "global_id": 862, "spawn_sec": 126}], "dialogue": [{"trigger": "start", "lines": [{"name": "マータン", "text": "――とうとう追いついたぞ！", "face": "u2862a1"}, {"name": "クダギツネ", "text": "あら、逃げ足には自信があったのだけれど、\n流石の王国軍には敵わないみたいねぇ。", "face": "l5cf717ccfcdb"}, {"name": "リッチ", "text": "くだらない芝居は結構。\n逃げるふりをして我々を誘い込んだつもりなのでしょう。", "face": "u2863a1"}, {"name": "エターナー", "text": "……周囲からいくつかの気配がするな。\nなるほど、待ち伏せを狙っていたわけか。", "face": "u2864a1"}, {"name": "クダギツネ", "text": "なんだ、バレバレだったのね。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "それじゃあいいわ、引っ張る意味もないし、\n待ち伏せの皆様に登場してもらおうかしら。", "face": "l5cf717ccfcdb"}, {"name": "エターナー", "text": "現れたのは妖怪と……獣人？", "face": "u2864a1"}, {"name": "マータン", "text": "この獣人たちは、まさか……雪枝の戦士たちか！？", "face": "u2862a1"}, {"name": "エターナー", "text": "な、なんだと……！？", "face": "u2864a1"}, {"name": "クダギツネ", "text": "ご名答。彼らはあなたと同じ、雪枝の里の者たちよ。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "そこの獣人の子は話してないんでしょうけど、\n王国の祭りのために里の者を派遣するってなったとき、\n一部の者たちはその話を拒否しようとしたそうよ。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "まぁ、結局お手伝いはすることになったんだけど、\n断固拒否した一部の者たちは、\nその後行方をくらませたらしくってねぇ。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "なんだったかしら……昨年、里で夏祭りが開かれて、\nそれがきっかけで外への警戒が強まったとかなんだとか。", "face": "l5cf717ccfcdb"}, {"name": "マータン", "text": "っ……！！", "face": "u2862a1"}, {"name": "リッチ", "text": "……ここにいる獣人たちは、\nその一部の者たちということですかな。", "face": "u2863a1"}, {"name": "クダギツネ", "text": "ええ、彼らも王国の夏祭りを中止させたいみたいだから、\n利害の一致でお友達になった、というわけよ。", "face": "l5cf717ccfcdb"}, {"name": "マータン", "text": "ええい、分からん！　全っ然、分からないぞ！", "face": "u2862a1"}, {"name": "マータン", "text": "雪枝の戦士たちよ！\nなぜお前たちはこんなことをするんだ！\n王国の祭りをめちゃくちゃにして、なんの意味がある！？", "face": "u2862a1"}, {"name": "クダギツネ", "text": "……獣人たちは答えたくないみたいね。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "でもまぁ、あなたなら分かるんじゃないのかしら？\n異文化に……外の世界に触れたくないっていう気持ちが。", "face": "l5cf717ccfcdb"}, {"name": "クダギツネ", "text": "なんて、会話はもう十分よね。\nそれじゃあさっさと喧嘩の続きをはじめましょうか。", "face": "l5cf717ccfcdb"}, {"name": "エターナー", "text": "……大丈夫か、マータン。", "face": "u2864a1"}, {"name": "マータン", "text": "ああ……マータンはなにも問題ない。\nむしろ、やる気が出てきたところだ。", "face": "u2862a1"}, {"name": "マータン", "text": "里の仲間たちが悪さをしているのなら――", "face": "u2862a1"}, {"name": "マータン", "text": "――マータンが止めないといけないからな！", "face": "u2862a1"}]}, {"trigger": "end", "lines": [{"name": "エターナー", "text": "返り討ちにはできたが、\nクダギツネと雪枝の者たちは逃してしまったな。", "face": "u2864a1"}, {"name": "マータン", "text": "…………。", "face": "u2862a1"}, {"name": "エターナー", "text": "マータン……本当に大丈夫なのか？", "face": "u2864a1"}, {"name": "マータン", "text": "……大丈夫だ。\nちょっと考え事をしてた。", "face": "u2862a1"}, {"name": "リッチ", "text": "考え事……？", "face": "u2863a1"}, {"name": "マータン", "text": "雪枝の里の、マータンより頭が固いやつら。\nそのリーダー格のやつも、里から姿を消しててな。\nそいつが主導しているのかとか、考えてた。", "face": "u2862a1"}, {"name": "エターナー", "text": "質問だが、それは里長――オヴィーにも\n反発している連中ということか？", "face": "u2864a1"}, {"name": "マータン", "text": "長は外の世界に歩み寄る方針だからな。\nどうにも反りが合わなかったんだろう。", "face": "u2862a1"}, {"name": "マータン", "text": "でもって、そういう連中で集まって、\n今回の事件を起こしたんだと思うが……。", "face": "u2862a1"}, {"name": "リッチ", "text": "さっき言っていたリーダー格の者が、裏にいると。", "face": "u2863a1"}, {"name": "マータン", "text": "おそらくはな。", "face": "u2862a1"}, {"name": "マータン", "text": "なんにせよ、これは雪枝の里の問題だ。\nマータンはやつらを追いかけさせてもらうぞ。", "face": "u2862a1"}, {"name": "リッチ", "text": "であれば、我々もご一緒しますぞ。", "face": "u2863a1"}, {"name": "エターナー", "text": "ああ、ここまできて知らんぷりはできないからな。", "face": "u2864a1"}, {"name": "マータン", "text": "……すまない。\n里のごたごたに巻き込んでしまって。", "face": "u2862a1"}, {"name": "エターナー", "text": "そんな申し訳なさそうにしないでくれ。\n結局私たちはクダギツネを\n倒さないといけないのだからな。", "face": "u2864a1"}, {"name": "マータン", "text": "……ありがとう。", "face": "u2862a1"}, {"name": "マータン", "text": "では、いくぞ！　うおおー！\nマータンスーパーダッシュ！", "face": "u2862a1"}]}]}