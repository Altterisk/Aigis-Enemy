{"quest_id": 6435, "name": "飽くなき探求心", "description": "初めて見る魔法都市の光景に、探求心を\n抑えきれぬレーレン。そんな彼女の前に、\n停止した数多のゴーレムの姿が……。\n神級（★１獲得の目安：平均Lv50）", "event": "アルケミスト・ドクトリン", "event_category": "History", "mission_id": 920107, "map_no": 5321, "level": 100, "multiplier": 1.0, "charisma": 75, "exp": 350, "gold": 2000, "drops": [{"card": 129, "c": 1}, {"card": 296, "c": 1}, {"card": 58, "c": 1}, {"item": 2002, "c": 1}, {"item": 5003, "c": 3}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 60000, "attack": 4000, "base_hp": 60000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 711, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099712, "race_id": 5, "change_to": 1, "change_condition": 5, "master_id": 329, "global_id": 328, "phases": [{"hp": 60000, "attack": 3500, "base_hp": 60000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_range": 200, "attack_speed": 300, "attack_wait": 120, "attack_interval": 406, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099728, "race_id": 5, "change_to": 2, "change_condition": 1, "missile_id": 76, "missile": {"speed": 3.0, "splash": 133}, "master_id": 330, "global_id": 329, "ranged": true, "condition": 5, "variants": [{"hp": 60000, "attack": 4000, "base_hp": 60000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 711, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099712, "race_id": 5, "missile_id": 58, "master_id": 331, "global_id": 330}]}], "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "hp": 30000, "attack": 2500, "base_hp": 30000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 60, "attack_interval": 566, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102320, "race_id": 5, "master_id": 373, "global_id": 372, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 30000, "attack": 3000, "base_hp": 30000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 50, "attack_range": 120, "attack_speed": 300, "attack_wait": 120, "attack_interval": 386, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2102432, "race_id": 5, "change_to": 5, "change_condition": 1, "missile_id": 110, "missile": {"speed": 2.0}, "master_id": 328, "global_id": 327, "ranged": true, "variants": [{"hp": 30000, "attack": 4000, "base_hp": 30000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 686, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2102416, "race_id": 5, "master_id": 327, "global_id": 326}], "spawn_sec": 1}, {"enemy_id": 7, "source": "local", "count": 21, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 70, "attack_wait": 40, "attack_interval": 176, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102336, "race_id": 5, "master_id": 374, "global_id": 373, "spawn_sec": 20}, {"enemy_id": 8, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 70, "attack_wait": 40, "attack_interval": 231, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105856, "special_effect_id": 229, "change_to": 8, "change_condition": 5, "master_id": 923, "global_id": 922, "phases": [{"hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 40, "attack_interval": 161, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102288, "special_effect_id": 229, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 924, "global_id": 923, "ranged": true, "condition": 5}], "spawn_sec": 130}], "popups": ["アイアンゴーレムのHPを\n少しでも減らすと、強烈な\n遠距離攻撃をしてきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーレン", "text": "うひょーっ！　すっげー、ここが魔法都市かー！\n面白そうな物がいっぱいでワクワクが止まんねーぜ！", "face": "u614"}, {"name": "テルマ", "text": "気に入っていただけて光栄です。\nお招きした甲斐がありました。", "face": "u296"}, {"name": "テルマ", "text": "学問は社会の礎。\n王国に新設された軍学校の講師となられる御方に、\n少しでもご協力できれば、と思いまして――きゃッ！", "face": "u296"}, {"name": "レーレン", "text": "おいおい、ちゃんと前見て歩けよな？\nあたしが支えてやらなきゃ転ぶところだったぞ？", "face": "u614"}, {"name": "テルマ", "text": "あ、ありがとうございます……。\n（小さな人……でも、意外としっかりしているのね）", "face": "u296"}, {"name": "テルマ", "text": "……とにかく、私ども魔法都市の人間も\n可能な限りのサポートをさせていただく所存で――", "face": "u296"}, {"name": "レーレン", "text": "おーい、テルマー。\nこいつって、どうやったら動くんだ？", "face": "u614"}, {"name": "テルマ", "text": "――って、レーレン様！？\nいつの間にゴーレムの上に？", "face": "u296"}, {"name": "レーレン", "text": "お、なんだこりゃ？\nゴーレムを動かすための術式みたいなもんか？", "face": "u614"}, {"name": "テルマ", "text": "あぁッ！　それはダメですッ！\nお願いします、早く離れて――", "face": "u296"}, {"name": "レーレン", "text": "うわわわわわッ！　こいつ、動くぞ！", "face": "u614"}, {"name": "カシス", "text": "ちょッ――あなたたち、なにしてるのよ！？\n今の反応で近くにいたゴーレムたちが\n一斉に起動しちゃったじゃない！", "face": "u282"}, {"name": "テルマ", "text": "とにかく鎮めないと……！\n皆さん、ご協力をお願いします！", "face": "u296"}]}, {"trigger": "end", "lines": [{"name": "カシス", "text": "し、死ぬかと思ったぁ～。", "face": "u282"}, {"name": "レーレン", "text": "う……す、すまねぇ……っ！\nゴーレムって、本物を見たのは初めてで……、\nぐすっ……興奮が抑えられなかったんだぁあ～ッ！", "face": "u614"}, {"name": "テルマ", "text": "な、泣かないでください。\n今後は軽率な行動を控えて頂ければ結構ですから。", "face": "u296"}, {"name": "テルマ", "text": "……それはそうと、\nレーレンさんは学園で講師をしながらも\n錬金術の研究をお続けになるおつもりなのですか？", "face": "u296"}, {"name": "レーレン", "text": "……うん。そりゃもちろん。\n研究は好きだし、それに――", "face": "u614"}, {"name": "レーレン", "text": "学ぶことを止めたヤツが\n他人になにかを教えるなんて、カッコつかないだろ？", "face": "u614"}, {"name": "テルマ", "text": "…………。", "face": "u296"}, {"name": "テルマ", "text": "……ふふっ、そうですね。", "face": "u296"}, {"name": "レーレン", "text": "な、なんで笑うんだよ？", "face": "u614"}, {"name": "テルマ", "text": "すみません。\nただ、私ももっと頑張ろうって思いまして。", "face": "u296"}, {"name": "カシス", "text": "……ふふっ、私も頑張ろうっと。\nどこかの誰かさんが、またうっかりゴーレムを\n起動しないように、しっかり見張っておかなくちゃね。", "face": "u282"}, {"name": "レーレン", "text": "だ、だからゴメンってばぁー。", "face": "u614"}, {"name": "テルマ", "text": "ぷっ……ふふっ♪", "face": "u296"}, {"name": "レーレン", "text": "わ～ら～う～なぁ～～っ！", "face": "u614"}]}], "map": {"image": "Map920107_5321", "w": 960, "h": 640, "spots": [{"k": "b", "x": 79, "y": 509}, {"k": "b", "x": 22, "y": 81}, {"k": "m", "x": 134, "y": 135, "id": 200}, {"k": "m", "x": 648, "y": 369, "id": 201}, {"k": "m", "x": 748, "y": 414, "id": 202}, {"k": "m", "x": 240, "y": 185, "id": 203}, {"k": "m", "x": 508, "y": 385, "id": 204}, {"k": "m", "x": 847, "y": 460, "id": 205}, {"k": "m", "x": 370, "y": 365, "id": 206}, {"k": "m", "x": 356, "y": 237, "id": 207}, {"k": "m", "x": 501, "y": 207, "id": 208}, {"k": "m", "x": 655, "y": 229, "id": 209}, {"k": "m", "x": 718, "y": 300, "id": 210}, {"k": "m", "x": 301, "y": 300, "id": 211}, {"k": "m", "x": 162, "y": 468, "id": 212}, {"k": "m", "x": 267, "y": 415, "id": 213}, {"k": "m", "x": 505, "y": 296, "id": 214}, {"k": "r", "x": 193, "y": 260, "id": 300}, {"k": "r", "x": 198, "y": 333, "id": 301}, {"k": "r", "x": 824, "y": 342, "id": 302}, {"k": "r", "x": 897, "y": 378, "id": 303}, {"k": "r", "x": 617, "y": 451, "id": 304}, {"k": "r", "x": 519, "y": 460, "id": 305}, {"k": "r", "x": 413, "y": 453, "id": 306}, {"k": "r", "x": 119, "y": 375, "id": 307}, {"k": "r", "x": 119, "y": 223, "id": 308}, {"k": "r", "x": 386, "y": 125, "id": 309}, {"k": "r", "x": 302, "y": 91, "id": 310}]}, "start_cost": 10, "active": true, "story_talk": true, "name_en": "Unquenchable Curiosity", "description_en": "Lehren cannot suppress her curiosity at the sight of the magical city. Before her stands... a multitude of stopped Golems. Divine (★1 target: Avg Lv50)"}