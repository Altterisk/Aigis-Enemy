{"quest_id": 6435, "name": "飽くなき探求心", "description": "初めて見る魔法都市の光景に、探求心を\n抑えきれぬレーレン。そんな彼女の前に、\n停止した数多のゴーレムの姿が……。\n神級（★１獲得の目安：平均Lv50）", "event": "アルケミスト・ドクトリン", "event_category": "History", "mission_id": 920107, "map_no": 5321, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 60000, "attack": 4000, "base_hp": 60000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 711, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099712, "race_id": 5, "change_to": 1, "change_condition": 5, "master_id": 329, "global_id": 328, "to_condition": 5, "to_global_id": 329, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 60000, "attack": 3500, "base_hp": 60000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_range": 200, "attack_speed": 300, "attack_wait": 120, "attack_interval": 406, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099728, "race_id": 5, "change_to": 2, "change_condition": 1, "missile_id": 76, "missile": {"speed": 3.0, "splash": 133}, "master_id": 330, "global_id": 329, "ranged": true, "from_condition": 5, "variants": [{"hp": 60000, "attack": 4000, "base_hp": 60000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 711, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099712, "race_id": 5, "missile_id": 58, "master_id": 331, "global_id": 330}]}, {"enemy_id": 4, "source": "local", "count": 7, "form_count": 1, "hp": 30000, "attack": 2500, "base_hp": 30000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 60, "attack_interval": 566, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102320, "race_id": 5, "master_id": 373, "global_id": 372, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 3000, "base_hp": 30000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 50, "attack_range": 120, "attack_speed": 300, "attack_wait": 120, "attack_interval": 386, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2102432, "race_id": 5, "change_to": 5, "change_condition": 1, "missile_id": 110, "missile": {"speed": 2.0}, "master_id": 328, "global_id": 327, "ranged": true, "variants": [{"hp": 30000, "attack": 4000, "base_hp": 30000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 686, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2102416, "race_id": 5, "master_id": 327, "global_id": 326}], "spawn_sec": 1}, {"enemy_id": 7, "source": "local", "count": 21, "form_count": 1, "hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 70, "attack_wait": 40, "attack_interval": 176, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102336, "race_id": 5, "master_id": 374, "global_id": 373, "spawn_sec": 20}, {"enemy_id": 8, "source": "local", "count": 10, "form_count": 2, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 70, "attack_wait": 40, "attack_interval": 231, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105856, "special_effect_id": 229, "change_to": 8, "change_condition": 5, "master_id": 923, "global_id": 922, "to_condition": 5, "to_global_id": 923, "spawn_sec": 130}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 40, "attack_interval": 161, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102288, "special_effect_id": 229, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 924, "global_id": 923, "ranged": true, "from_condition": 5}], "popups": ["アイアンゴーレムのHPを\n少しでも減らすと、強烈な\n遠距離攻撃をしてきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーレン", "text": "うひょーっ！　すっげー、ここが魔法都市かー！\n面白そうな物がいっぱいでワクワクが止まんねーぜ！", "face": "u614"}, {"name": "テルマ", "text": "気に入っていただけて光栄です。\nお招きした甲斐がありました。", "face": "u296"}, {"name": "テルマ", "text": "学問は社会の礎。\n王国に新設された軍学校の講師となられる御方に、\n少しでもご協力できれば、と思いまして――きゃッ！", "face": "u296"}, {"name": "レーレン", "text": "おいおい、ちゃんと前見て歩けよな？\nあたしが支えてやらなきゃ転ぶところだったぞ？", "face": "u614"}, {"name": "テルマ", "text": "あ、ありがとうございます……。\n（小さな人……でも、意外としっかりしているのね）", "face": "u296"}, {"name": "テルマ", "text": "……とにかく、私ども魔法都市の人間も\n可能な限りのサポートをさせていただく所存で――", "face": "u296"}, {"name": "レーレン", "text": "おーい、テルマー。\nこいつって、どうやったら動くんだ？", "face": "u614"}, {"name": "テルマ", "text": "――って、レーレン様！？\nいつの間にゴーレムの上に？", "face": "u296"}, {"name": "レーレン", "text": "お、なんだこりゃ？\nゴーレムを動かすための術式みたいなもんか？", "face": "u614"}, {"name": "テルマ", "text": "あぁッ！　それはダメですッ！\nお願いします、早く離れて――", "face": "u296"}, {"name": "レーレン", "text": "うわわわわわッ！　こいつ、動くぞ！", "face": "u614"}, {"name": "カシス", "text": "ちょッ――あなたたち、なにしてるのよ！？\n今の反応で近くにいたゴーレムたちが\n一斉に起動しちゃったじゃない！", "face": "u282"}, {"name": "テルマ", "text": "とにかく鎮めないと……！\n皆さん、ご協力をお願いします！", "face": "u296"}]}, {"trigger": "end", "lines": [{"name": "カシス", "text": "し、死ぬかと思ったぁ～。", "face": "u282"}, {"name": "レーレン", "text": "う……す、すまねぇ……っ！\nゴーレムって、本物を見たのは初めてで……、\nぐすっ……興奮が抑えられなかったんだぁあ～ッ！", "face": "u614"}, {"name": "テルマ", "text": "な、泣かないでください。\n今後は軽率な行動を控えて頂ければ結構ですから。", "face": "u296"}, {"name": "テルマ", "text": "……それはそうと、\nレーレンさんは学園で講師をしながらも\n錬金術の研究をお続けになるおつもりなのですか？", "face": "u296"}, {"name": "レーレン", "text": "……うん。そりゃもちろん。\n研究は好きだし、それに――", "face": "u614"}, {"name": "レーレン", "text": "学ぶことを止めたヤツが\n他人になにかを教えるなんて、カッコつかないだろ？", "face": "u614"}, {"name": "テルマ", "text": "…………。", "face": "u296"}, {"name": "テルマ", "text": "……ふふっ、そうですね。", "face": "u296"}, {"name": "レーレン", "text": "な、なんで笑うんだよ？", "face": "u614"}, {"name": "テルマ", "text": "すみません。\nただ、私ももっと頑張ろうって思いまして。", "face": "u296"}, {"name": "カシス", "text": "……ふふっ、私も頑張ろうっと。\nどこかの誰かさんが、またうっかりゴーレムを\n起動しないように、しっかり見張っておかなくちゃね。", "face": "u282"}, {"name": "レーレン", "text": "だ、だからゴメンってばぁー。", "face": "u614"}, {"name": "テルマ", "text": "ぷっ……ふふっ♪", "face": "u296"}, {"name": "レーレン", "text": "わ～ら～う～なぁ～～っ！", "face": "u614"}]}], "story_talk": true, "active": true}