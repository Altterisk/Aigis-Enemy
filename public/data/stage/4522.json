{"quest_id": 4522, "name": "ヴァンパイアを追う者", "description": "ヒールの力により\n倒れても再び立ち上がる\n聖職者に注意せよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ヴァンパイアと聖なる復讐者", "event_category": "History", "mission_id": 920063, "map_no": 3174, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 26, "global_id": 25, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 14, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 32, "global_id": 31, "ranged": true, "spawn_sec": 37}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 140, "base_hp": 4500, "base_attack": 140, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 66, "move_speed": 350.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105392, "race_id": 16, "special_effect_id": 72, "change_to": 4, "change_condition": 2, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 637, "global_id": 636, "ranged": true, "spawn_sec": 85}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 93}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 109}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30, "global_id": 29, "ranged": true, "spawn_sec": 119}], "dialogue": [{"trigger": "start", "lines": [{"name": "ラキュア", "text": "予は、支配派のリーダーを探す。\n先ほど追ってきた人間は支配派の差し向けた\n刺客だが、予は人間と戦いたくない。", "face": "u344"}, {"name": "ラキュア", "text": "ヴァンパイアは人間がいてこそ存在できる。\n一方的な搾取は互いに不利益しか生まない。\n予は双方の為に、人間を守るつもりだ。", "face": "u344"}, {"name": "アンナ", "text": "そういうことなら私達も同行しましょう。\n先程の女性も心配ですし、彼女ならば支配派の\nリーダーの居場所を知っているはずですからね。", "face": "lcbd0debec38a"}, {"name": "フーリ", "text": "ヴァンパイアハンターがヴァンパイアと手を組\nむなんて……今はそんなこと言ってられないか。\n目的が同じなら一緒に戦うのが最善だしね。", "face": "u174"}, {"name": "ラキュア", "text": "其方たち……っふ、どうやら我ら共存派のよき\n理解者となってくれる数少ない人間の様だな。\nこれから、よろしく頼むぞ。", "face": "u344"}, {"name": "ルマリア", "text": "――見つけましたよ、ラキュア。\nやはり復活を果たしたようですね……。\n今度こそ、私の手によってトドメをさしてみせます！", "face": "u343"}, {"name": "アンナ", "text": "王子、ラキュアさんが……！\n話は後です！\nいそぎ助けましょう！", "face": "lcbd0debec38a"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "ようやく、撤退してくれました。\nしかし、話を聞いてもらえそうにないですね……。", "face": "l073d7617901b"}, {"name": "ラキュア", "text": "彼奴らは騙されているのだ。支配派のリーダーは\n人間社会で「公爵」という立場を持っている。\nその立場を利用し、人間達を操っているのだ。", "face": "u344"}, {"name": "ラキュア", "text": "予は許せぬ。支配派のヴァンパイア達は、\n人を餌と断じ、あまつさえ自らの都合の良い\n現実を作り、思考や言動すら思いのままだ。", "face": "u344"}, {"name": "アンナ", "text": "敵が人間社会に溶け込んでいるとなれば、\n事態は一筋縄ではいきませんが、\nこのままでは彼らは公爵の餌食に……。", "face": "l073d7617901b"}, {"name": "アンナ", "text": "王子、彼らがまた現れたら、\nもう一度話をしてみましょう。", "face": "lcbd0debec38a"}]}], "active": true}