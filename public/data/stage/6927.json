{"quest_id": 6927, "name": "恩義の真相", "description": "スズネの里は鬼の軍勢に支配されていた。\n天狗に化ける妖狸たちを退け、\n大嶽丸を撃破せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "あやかし狸大合戦", "event_category": "History", "mission_id": 920137, "map_no": 5521, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "change_to": 2, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 32174, "global_id": 5793, "to_global_id": 5794, "spawn_sec": 30}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 60, "attack_wait": 30, "attack_interval": 163, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108800, "race_id": 4, "special_effect_id": 415, "change_to": 3, "missile_id": 77, "missile": {"speed": 2.0}, "master_id": 32175, "global_id": 5794, "to_global_id": 5795}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 8000, "attack": 400, "base_hp": 8000, "ba