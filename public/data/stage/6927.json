d": 32169, "global_id": 5788, "ranged": true}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 96, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117280, "race_id": 4, "master_id": 31493, "global_id": 5112, "spawn_sec": 119}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 4, "hp": 5000, "attack": 350, "base_hp": 5000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_range": 180, "attack_speed": 1, "attack_wait": 45, "attack_interval": 123, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120832, "race_id": 4, "special_effect_id": 222, "change_to": 13, "missile_id": 418, "missile": {"speed": 7.0}, "master_id": 32148, "global_id": 5767, "ranged": true, "to_global_id": 5768, "spawn_sec": 145}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 25000, "attack": 800, "base_hp": 25000, "base_attack": 800, "damage_type": "physical", "attack_speed": 60, "attack_wait": 23, "attack_interval": 149, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113504, "race_id": 4, "special_effect_id": 415, "change_to": 14, "missile_id": 77, "missile": {"speed": 2.0}, "master_id": 32149, "global_id": 5768, "to_global_id": 5769}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 25000, "attack": 800, "base_hp": 25000, "base_attack": 800, "damage_type": "physical", "attack_speed": 60, "attack_wait": 23, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 15, "missile_id": 77, "missile": {"speed": 2.0}, "master_id": 32150, "global_id": 5769, "to_global_id": 5770}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 25000, "attack": 800, "base_hp": 25000, "base_attack": 800, "damage_type": "physical", "attack_range": 230, "attack_speed": 60, "attack_wait": 23, "attack_interval": 89, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113504, "race_id": 4, "special_effect_id": 92, "missile_id": 77, "missile": {"speed": 2.0}, "master_id": 32151, "global_id": 5770, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "ヒエン", "text": "――主よ、こちらにござる。\nどうやらこの里は、\n既に鬼どもの手に落ちているようですぞ。", "face": "u112"}, {"name": "カナメ", "text": "む……あれは重水の四天王と……大嶽丸か……？", "face": "u314"}]}, {"trigger": "start", "lines": [{"name": "大嶽丸", "text": "――クク……。\n妖狸の娘め、王国よりも鬼を信じたか……。", "face": "l0b112079124f"}, {"name": "豪風の四天王", "text": "然り。あちらの里の妖狸の時とは違い、\n此度は手間を掛けて騙してやったのだ。\n簡単に王国になびかれては困るというもの。", "face": "l40af28ef9fae"}, {"name": "迅雷の四天王", "text": "豪風が起こした風で、\n魔王の瘴気を妖狸の里に流し込んだとは、\nまさか夢にも思うまいて！　グハハハ！！", "face": "lf7e694dcc756"}, {"name": "重水の四天王", "text": "声が大きいですよ。\n妖狸の里に流れた瘴気が我らの仕業だと、\nたぬき共に知られたらどうするのですか。", "face": "l7fdf3d471bc6"}, {"name": "重水の四天王", "text": "あらゆる者に変身する妖狸の能力は、\n人間ども相手の戦にて大いに役立つはず。\n今は存分に利用し、搾り取ってやりましょう。", "face": "l7fdf3d471bc6"}, {"name": "大嶽丸", "text": "からめ手は好かぬ……が、\n力を付けた今の人間ども相手の戦となれば、\nこちらも手勢が多いに越したことはない……。", "face": "l0b112079124f"}, {"name": "迅雷の四天王", "text": "もし裏切ったならば、\n狸鍋にしてやれば良いからな。グハハハハッ！！", "face": "lf7e694dcc756"}, {"name": "大嶽丸", "text": "クク……然り、然り……！\n俺達の戦の為に、お前達は更に手勢を集めるのだ。\nさぁ行け、次なる戦のためにな……。", "face": "l0b112079124f"}, {"name": "重水の四天王", "text": "鬼と人との戦……。\n実に楽しみですねぇ……。", "face": "l7fdf3d471bc6"}, {"name": "ホムラ", "text": "……なるほどな。\n鬼が妖狸の里を救うとは思っていなかったが……。", "face": "u739"}, {"name": "たぬきの里の長", "text": "自分の手で魔王の瘴気をスズネちゃんの里に誘導して、\n困ってる妖狸たちをその手で救ったぽん……！？", "face": "u1019a1"}, {"name": "マオ", "text": "あいつらのやりそうな事ですね。\nでもこの事実を伝えれば、\nこの里の妖狸さんたちも――", "face": "u361"}, {"name": "妖狸", "text": "――ぽぽーん！！\nおーたけまる様！　侵入者だぽーん！！", "face": "l29774d5d3d78"}, {"name": "大嶽丸", "text": "クク……流石は王子達、か……。\nスズネよ、助けてやった恩を返す時だ。\n存分にその変化の力で戦うが良い……。", "face": "l0b112079124f"}, {"name": "スズネ", "text": "ぽぽん……わ、わかりましたぽん。\nあたし様たちは、\n助けてもらった恩をちゃんと返すぽん！", "face": "u936"}, {"name": "大嶽丸", "text": "俺を打ち破るほどの猛者が、\nまた戦うためにここへ来てくれたか……。\nククク……さぁ出てこい、王子よ……！", "face": "l0b112079124f"}, {"name": "ホムラ", "text": "王子、大嶽丸のヤツ、宝剣を抜かないつもりらしい。\nまずは小手調べとでも言いたいんだろうな。", "face": "u739"}, {"name": "ホムラ", "text": "だが、あいつの炎を帯びた棍棒からは、\n強い妖力が感じられる。油断するんじゃねぇぞ！", "face": "u739"}]}, {"trigger": "end", "lines": [{"name": "大嶽丸", "text": "ククク……ッ！\nやはり強い……人の成長は早いものだ……！", "face": "l0b112079124f"}, {"name": "ホムラ", "text": "ちっ……全然堪えてないな……。\nスズネ！　そいつに騙されるな！\n妖狸の里に瘴気を流し込んだのは鬼達だ！！", "face": "u739"}, {"name": "スズネ", "text": "ぽぽん……！？\nそんなはずないですぽん！\n大嶽丸さまはあたし様たちを助けて――", "face": "u936"}, {"name": "たぬきの里の長", "text": "スズネちゃん、ボクさまの言葉を信じてほしいぽん！\nボクさまはスズネちゃんを化かすことはあっても、\n絶対に嘘をついたりしないぽーん！！", "face": "u1019a1"}, {"name": "スズネ", "text": "でも……うぅぅ……。\n大嶽丸さま、本当なんですかぽん……？", "face": "u936"}, {"name": "大嶽丸", "text": "情にほだされるとは、向こうの里の連中といい、\n妖狸は使いにくいものだな……。", "face": "l0b112079124f"}, {"name": "大嶽丸", "text": "とはいえ、将を疑う兵など、次の戦には不要だ……。\n此度の戦いに花を添える端役として、\n哀れに舞い踊るが良いだろう……。", "face": "l0b112079124f"}, {"name": "大嶽丸", "text": "さぁ王子よ……。\n人の身で俺を破ったお前の力を、\nもう一度味わわせて見せるがいい……。", "face": "l0b112079124f"}]}], "active": true}