ect_id": 1109, "master_id": 35123, "global_id": 8740, "commands": {"raw": "SetStageFlag(7, 0);", "sets_flags": [[7, 0]]}, "route_behaviour": {"reroutes": ["Route=998"]}, "spawn_sec": 173}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 50000, "base_hp": 50000, "damage_type": "physical", "attack_wait": 60, "attack_interval": 169, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2138928, "special_effect_id": 1110, "master_id": 35124, "global_id": 8741, "commands": {"raw": "SetStageFlag(8, 0);", "sets_flags": [[8, 0]]}, "route_behaviour": {"reroutes": ["Route=998"]}, "spawn_sec": 191}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 50000, "base_hp": 50000, "damage_type": "physical", "attack_wait": 60, "attack_interval": 169, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2138928, "special_effect_id": 1111, "master_id": 35125, "global_id": 8742, "commands": {"raw": "SetStageFlag(9, 0);", "sets_flags": [[9, 0]]}, "route_behaviour": {"reroutes": ["Route=998"]}, "spawn_sec": 210}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 50000, "base_hp": 50000, "damage_type": "physical", "attack_wait": 60, "attack_interval": 169, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2138928, "special_effect_id": 1112, "master_id": 35126, "global_id": 8743, "commands": {"raw": "SetStageFlag(10, 0);", "sets_flags": [[10, 0]]}, "route_behaviour": {"reroutes": ["Route=998"]}, "spawn_sec": 228}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 50000, "base_hp": 50000, "damage_type": "physical", "attack_wait": 60, "attack_interval": 169, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2138928, "special_effect_id": 1113, "master_id": 35127, "global_id": 8744, "commands": {"raw": "SetStageFlag(11, 0);", "sets_flags": [[11, 0]]}, "route_behaviour": {"reroutes": ["Route=998"]}, "spawn_sec": 248}], "popups": ["亜神ヒュープは攻撃を行いませんが、\n亜神ヒュープがいる間は\n味方の攻撃、防御がダウンします。\n\nまた一定時間が経過するたびに\nステータスダウン効果が強化され\n最大90％までダウンします。", "亜神ヒュープの眷属(泡沫型)が\nいる間は、全ての敵のHPが\n徐々に回復します。\n\nまた亜神ヒュープの眷属(泡沫型)は\n攻撃を行いません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヒュープ", "text": "ふぁ……あふ……。\n戦場に立つなんて、千年ぶりかな……。", "face": "l08302fbc4106"}, {"name": "モーティマ", "text": "なんだあいつ、うとうとしはじめやがったぞ？", "face": "u14"}, {"name": "トゥアン", "text": "ちっ……面倒な。\n王子、時間がないからよく聞け。", "face": "u1006a1"}, {"name": "トゥアン", "text": "亜神ヒュープの微睡みこそ、奴の権能だ。\n奴が眠りに近付くほど、\n敵対者――つまりこっちの力が出せなくなっていく。", "face": "u1006a1"}, {"name": "モーティマ", "text": "へっ、その前にぶっ飛ばせばいいんだな！\n――って、うおおっ！？\n泡の眷属がわんさか出てきたぞ！？", "face": "u14"}, {"name": "トゥアン", "text": "……だから時間がないんだ。\nあの泡沫の眷属は癒しの力を持ってやがるんだ。", "face": "u1006a1"}, {"name": "ヒュープ", "text": "……ちっ……勝手に僕の権能を明かさないでほしいな。\nまぁいいさ……人の身で、\n僕の微睡みに……届くはずもないのだから……。", "face": "l08302fbc4106"}, {"name": "アトナテス", "text": "じゃあ、この手は届くって教えてやろうぜ。\nいくぞ王子、短期決戦であいつをぶっ飛ばすぞ！", "face": "u908"}]}, {"trigger": "end", "lines": [{"name": "ヒュープ", "text": "――届いた、のか。\n人の刃が、僕の身にまで。", "face": "l08302fbc4106"}, {"name": "ヒュープ", "text": "……夢を、現実が超えるだと？\nありえない、そんなことが――", "face": "l08302fbc4106"}, {"name": "トラム", "text": "夢を英雄王に破られ、王子に破られ、\nそして現実でも負けたのよ。\nそろそろ、目覚めてみたらどうかしら。", "face": "u1110a1"}, {"name": "ヒュープ", "text": "……考えておこう。\nトラム、お前が変われたのなら、\n僕もまた、変われるかもしれないからね。", "face": "l08302fbc4106"}, {"name": "ヒュープ", "text": "――だが、その状態で\n本当に第二層へ進むつもりかい？", "face": "l08302fbc4106"}, {"name": "王子", "text": "…………っ。", "face": "u1"}, {"name": "ヒュープ", "text": "君の夢は、本当に深く、\n君の奥深くに根ざしたものだったんだね。", "face": "l08302fbc4106"}, {"name": "ヒュープ", "text": "その後悔が君を強くしたのだろうけれど、\n同時に、自らその夢を描き出してしまったことで、\n心が肉体から分離しかけているじゃないか。", "face": "l08302fbc4106"}, {"name": "レーヴ", "text": "あ、あ、あなたのせいじゃないですか！\n王子をこんな目に――", "face": "u454"}, {"name": "ヒュープ", "text": "あの夢を見ることを、望んだのは彼自身だよ。", "face": "l08302fbc4106"}, {"name": "ヒュープ", "text": "……僕は君たちに負けた。\nもう第一層が、君たちに牙を剥くことはない。", "face": "l08302fbc4106"}, {"name": "ヒュープ", "text": "一度、物質界へ戻り給えよ。\n彼には休息が必要だろう？\nそして君たちは、彼なしに戦えないはずだ。", "face": "l08302fbc4106"}, {"name": "サナラ", "text": "王子ちゃん、一度退きましょう。\nもしこのまま勝ち進めても、\n王子ちゃんの命が、このままじゃ……。", "face": "u921"}, {"name": "王子", "text": "…………。\n…………（こくり）", "face": "u1"}, {"name": "サナラ", "text": "わっ、わぁあっ！？　王子ちゃん！　王子ちゃん！？\n大変です、意識を失ってますよー！？", "face": "u921"}, {"name": "ラタトスク", "text": "天界の門経由では遠すぎる……。\nビフロストまで急いで運ぶんじゃー！", "face": "u1375a1"}, {"name": "レフカ", "text": "あ、あの……そういうことでしたら、\nわたくしの翼をお貸ししますわ……！", "face": "u1559a1"}, {"name": "ラシティ", "text": "助けてもらったお礼もしたいしね。\n癒し手のおかげで傷も治ったばかりだし。", "face": "u1560a1"}, {"name": "オーキュ", "text": "わ、私もついていきますわよ！\n王子さま！　しっかりしてくださいなー！！", "face": "u1101a1"}, {"name": "ヒュープ", "text": "…………行った、か。\n力を取り戻してから、もう一度登ってくるといいさ。", "face": "l08302fbc4106"}, {"name": "ヒュープ", "text": "偽りでは満足できない、強欲な人のあり方。\n現実で叶える夢の形を、楽しみにしているよ。", "face": "l08302fbc4106"}, {"name": "ヒュープ", "text": "亜神ディアス、彼らは愚かな被造物なんかじゃない。\n何しろ、理想の夢を捨ててでも、\n不確かな未来なんかのために戦える連中なんだから。", "face": "l08302fbc4106"}]}], "active": true}