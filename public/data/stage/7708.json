{"quest_id": 7708, "name": "微睡む亜神", "description": "ついに亜神ヒュープが戦場に姿を現す。\n敵対者の力を抑える眠りの権能を打ち破れ！\n\n神級（★１獲得の目安：平均Lv50）", "event": "見果てぬ未来と叶わぬ夢", "event_category": "History", "mission_id": 920181, "map_no": 4147, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["ヒュープ"], "hp": 140000, "base_hp": 140000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_wait": 60, "attack_interval": 169, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2138944, "race_id": 19, "special_effect_id": 1102, "master_id": 35116, "global_id": 8733, "commands": {"raw": "SetStageFlag(0, 0);", "sets_flags": [[0, 0]]}, "route_behaviour": {"sets_flags": [[0, 1, 0]]}, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 50000, "base_hp": 50000, "damage_type": "physical", "attack_wait": 60, "attack_interval": 169, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2138928, "special_effect_id": 1103, "master_id": 35117, "global_id": 8734, "commands": {"raw": "SetStageFlag(1, 0); SetStageFlag(2, 1); SetStageFlag(3, 1); SetStageFlag(4, 1); SetStageFlag(5, 1); SetStageFlag(6, 1); SetStageFlag(7, 1); SetStageFlag(8, 1); SetStageFlag(9, 1); SetStageFlag(10, 1); SetStageFlag(11, 1); SetStageFlag(12, 1);", "sets_flags": [[1, 0], [2, 1], [3, 1], [4, 1], [5, 1], [6, 1], [7, 1], [8, 1], [9, 1], [10, 1], [11, 1], [12, 1]]}, "route_behaviour": {"reroutes": ["Route=999"]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 33, "form_count": 1, "hp": 3500, "attack": 500, "base_hp": 3500, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 122, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "p