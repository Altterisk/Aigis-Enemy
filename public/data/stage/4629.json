, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106576, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 836, "global_id": 835, "ranged": true, "spawn_sec": 124}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、敵船に接着されてしまいました！\n続々と船内に敵が押し寄せてきています……！", "face": "l7321c8eb4085"}, {"name": "セレイナ", "text": "海路を使えば逃げられると思ったのですか？\n甘いですね……実に浅はかな考えです！", "face": "u375"}, {"name": "セレイナ", "text": "神官戦士の皆さん！　そして天使様！\n共に神に仕える者として、\n王子たちを討ち滅ぼしましょう！", "face": "u375"}, {"name": "天使", "text": "……浄化、開始です。", "face": "l78025fce4bde"}, {"name": "ニエル", "text": "そんな……また、天使たちが\n一緒にいるだなんて……！？", "face": "u206"}]}, {"trigger": "end", "lines": [{"name": "ジョヴァンニ", "text": "よし、一通りの敵は倒したな！\nこのまま一気にヤツらの船を引き離すぞ！", "face": "u123"}, {"name": "セレイナ", "text": "二度も浄化の機を逸するとは……。\n申し訳ございません、天使様……。", "face": "u375"}, {"name": "天使", "text": "聖なる徒よ……気に病むことはありません。\n次なる好機を待つのです。", "face": "l78025fce4bde"}, {"name": "セレイナ", "text": "はい天使様。\nその限りない慈悲に報いるため、\n必ずや、主の命を果たしてみせます。", "face": "u375"}, {"name": "天使", "text": "期待していますよ、セレイナ。", "face": "l78025fce4bde"}]}], "active": true}