{"quest_id": 8336, "name": "狙われたアマツ", "description": "記憶喪失の亜神を連れて帰路を進む一行に\n大天使長率いる天使部隊が襲い来る……。\n襲い来る敵を退け、勝利を掴め！\n極級（★１獲得の目安：平均Lv25）", "event": "天墜の神と天翔の船", "event_category": "History", "mission_id": 920219, "map_no": 4933, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 1000, "base_hp": 20000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 40, "attack_range": 300, "attack_speed": 200, "attack_wait": 80, "attack_interval": 281, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105504, "race_id": 6, "special_effect_id": 89, "change_to": 1, "change_condition": 1, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 33982, "global_id": 7599, "ranged": true, "variants": [{"hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 40, "attack_speed": 50, "attack_wait": 10, "attack_interval": 151, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105552, "race_id": 6, "special_effect_id": 86, "master_id": 33983, "global_id": 7600}]}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "base_hp": 1500, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_wait": 30, "move_speed": 500.0, "dot_rate": 1.2000000476837158, "assassin_resist": 1