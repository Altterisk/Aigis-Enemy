wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109312, "race_id": 6, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30176, "global_id": 3795, "ranged": true, "spawn_sec": 136}, {"enemy_id": 10, "source": "local", "count": 13, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 10, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 141}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 120000, "attack": 1, "base_hp": 120000, "base_attack": 1, "damage_type": "magical", "armor_defense": 800, "magic_defense": 50, "attack_speed": 1, "attack_wait": 60, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2148064, "race_id": 6, "change_to": 12, "master_id": 37816, "global_id": 11433, "route_behaviour": {"transforms": [{"wait": 80}]}, "spawn_sec": 192}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "magical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2155056, "special_effect_id": 230, "missile_id": 508, "missile": {"speed": 12.0}, "master_id": 37809, "global_id": 11426, "spawn_sec": 195}], "popups": ["ラッパを吹く天使がいる間は\n敵の天使の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "イヨ", "text": "あまつ……アマツ……うーん。", "face": "u1948a1"}, {"name": "アマツ", "text": "イヨなやみごと？\nアマツ、相談のるよ？", "face": "u2234a1"}, {"name": "イヨ", "text": "はっ、お気になさらず！\nでもやっぱり、\nうーん……あまつ……みかぼ……うーん？", "face": "u1948a1"}, {"name": "アマツ", "text": "うーん？　うーん？", "face": "u2234a1"}, {"name": "アキレア", "text": "ははっ、すっかり懐かれてんな。\nそれにしても、亜神も記憶喪失とかなるんだなぁ。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "君はやたらと頑丈だから経験がないだろうが、\n亜神もまた、ひとつの生物には違いない。\n何らかのショックがあれば記憶も失うさ。", "face": "u2193a1"}, {"name": "アンナ", "text": "もう少しで王国ですし、\n到着したら癒し手の方々に診てもらいましょう。\nずっと記憶がないままというのも可哀想ですし。"}, {"name": "アマツ", "text": "アマツ、かわいそう？", "face": "u2234a1"}, {"name": "アキレア", "text": "うっ……やめろ、何かその純粋な目つき、心にくる……。", "face": "u1972a1"}, {"name": "レクテ", "text": "アマツちゃんは可哀想じゃなくて、\nとっても可愛いだよねー♪", "face": "u2047a1"}, {"name": "ユリクセス", "text": "アキレアは心が蛮族だからな。\n純粋な視線には耐えられないんだ。", "face": "u2193a1"}, {"name": "アキレア", "text": "てめぇ！？", "face": "u1972a1"}, {"name": "セリド", "text": "け、喧嘩はだめですよぉ！？\nせめてもっと知的な争いをぉ……。", "face": "u2136a1"}, {"name": "アキレア", "text": "…………ん。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "…………ああ。", "face": "u2193a1"}, {"name": "セリド", "text": "ん？　えっ、どうしました？", "face": "u2136a1"}, {"name": "アキレア", "text": "じゃあ、知的に解決しようぜ。\nぶっ倒した数の多い方が勝ちだ。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "知性への冒涜だぞ、アキレア。\nとはいえ、この状況では戦わない選択肢はないか。", "face": "u2193a1"}, {"name": "セリド", "text": "あ、あのぉ……？", "face": "u2136a1"}, {"name": "アキレア", "text": "王子、包囲されてんぞ。\n総員戦闘準備！　武器を構えろ！！", "face": "u1972a1"}, {"name": "セリド", "text": "えええええええっ！？　いつの間に！？\nっていうかどうして気付けるんです！？", "face": "u2136a1"}, {"name": "大天使長", "text": "――奇襲は、失敗しましたか。\nしかし、その少女はここで処分しなければなりません。", "face": "l1322e5a9d961"}, {"name": "アマツ", "text": "ひっ……。", "face": "u2234a1"}, {"name": "アキレア", "text": "天使部隊で王国軍本隊を殲滅する気とは、\nさすがにテメェらを過大評価しすぎだぜ？", "face": "u1972a1"}, {"name": "ユリクセス", "text": "いや……狙いはアマツだけのようだ。\n記憶を失い、権能の発動ができない彼女は、\n人間の子どもと大差ない状況だろう？", "face": "u2193a1"}, {"name": "アキレア", "text": "記憶のない小娘を殺すために派遣されてきたってか。\n不意打ちで暗殺とは、ちょっとやり口が汚ねぇなァ！", "face": "u1972a1"}, {"name": "イヨ", "text": "アマツミカ……じゃなかった、\nアマツちゃん、後ろに隠れててくださいね！", "face": "u1948a1"}, {"name": "アマツ", "text": "う、うん、わかった……。", "face": "u2234a1"}, {"name": "アキレア", "text": "よっし、ぶちかますぞテメェら！！", "face": "u1972a1"}]}, {"trigger": "battle", "at_sec": 192, "lines": [{"name": "ユリクセス", "text": "よし、このまま天使部隊を突破するぞ。\n周囲の警戒を怠るな！", "face": "u2193a1"}, {"name": "ラムイエル", "text": "――いいえ。その行動は、許可されていません。", "face": "l084aacb6acf1"}, {"name": "アキレア", "text": "なっ……この声、どこから――", "face": "u1972a1"}, {"name": "ユリクセス", "text": "上だ、アキレア！！", "face": "u2193a1"}]}, {"trigger": "battle", "at_sec": 194, "lines": [{"name": "ラムイエル", "text": "――雷雲をここに。\n不敬なる罪人たちに、神なる雷霆の神罰を。", "face": "l084aacb6acf1"}]}, {"trigger": "end", "lines": [{"name": "アキレア", "text": "……おい、何か考えろユリクセス。\nあいつ、雷雲で辺り一帯薙ぎ払うつもりだぞ。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "今考えてる！\n王子、とにかく距離をとれ！\n雷雲の包囲が完成する前に突破だ！", "face": "u2193a1"}, {"name": "アキレア", "text": "それが作戦かよ！", "face": "u1972a1"}, {"name": "ユリクセス", "text": "あの天使は……ラムイエルは！\n亜神ディアスの雷霆を借りている！\nただの天使の雷だと思うな！", "face": "u2193a1"}, {"name": "キャリー", "text": "前線、騎兵隊で突破します！\n付いてきてください！", "face": "u2233a1"}]}], "active": true}