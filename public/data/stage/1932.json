 "armor_defense": 1200, "magic_defense": 30, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126560, "race_id": 18, "special_effect_id": 660, "change_to": 3, "change_condition": 1, "master_id": 34525, "global_id": 8142, "variants": [{"tags": ["水中"], "hp": 5500, "attack": 220, "base_hp": 5500, "base_attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126576, "race_id": 18, "master_id": 34526, "global_id": 8143}], "spawn_sec": 4}, {"enemy_id": 5, "source": "local", "count": 18, "form_count": 1, "tags": ["水棲", "ブロック不可", "狙う", "水中"], "hp": 14000, "attack": 1000, "base_hp": 14000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_range": 220, "attack_speed": 1, "attack_wait": 60, "attack_interval": 163, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2153392, "missile_id": 1080, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 200, "attack_interval_f": 200, "effect_name": "HitEffectSlow"}}, "master_id": 37561, "global_id": 11178, "ranged": true, "spawn_sec": 140}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 226, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126512, "race_id": 7, "change_to": 6, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 34527, "global_id": 8144, "ranged": true, "variants": [{"hp": 8000, "attack": 1050, "base_hp": 8000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 8000, "magic_defense": 40, "attack_speed": 1, "attack_wait": 60, "attack_interval": 179, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126496, "race_id": 7, "master_id": 34528, "global_id": 8145}], "spawn_sec": 308}], "popups": ["クリオネの魔物は\n攻撃力1500以下の\nあらゆる攻撃を受け付けません。", "異界の虫はHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。", "ナマコの魔物から攻撃を受けると\n攻撃後の待ち時間が増加します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デューオ", "text": "──ここが、アトランティス。", "face": "u594"}, {"name": "イブキ", "text": "その外縁だな、あの橋が都市内部に通じる道だろう。", "face": "u511"}, {"name": "フローガ", "text": "……とんでもない水深ですね。\nおおよそ人間が生存できる場所ではありません。\n海巫女の加護がなければぺしゃんこでしたよ。", "face": "u878"}, {"name": "ヴィアベル", "text": "とは言っても、私たちみたいに、\n日頃から海にいるような人たちならともかく、\nそうでない人には変わらず厳しい水圧だね。", "face": "u1247a1"}, {"name": "リーンベル", "text": "……水中戦の陣形を整えたいところだが、\nあまり悠長に構えている暇はなさそうだな。", "face": "u268"}, {"name": "ムルーア", "text": "──敵襲！　敵襲だよー！\n前方からポセイオスの眷属多数！", "face": "u1568a1"}, {"name": "フィーヌ", "text": "数えるのも馬鹿らしくなるやっべぇ大軍ですよー！", "face": "u1262a1"}, {"name": "イヴリール", "text": "喚くな、所詮は数だけの雑魚の群れだ。", "face": "u1959a1"}, {"name": "イヴリール", "text": "有象無象はおれの船で受け持つ！\nお前たちはデューオと王子の道を拓け！", "face": "u1959a1"}, {"name": "カウリオ", "text": "ひゃっほー！　出番だー！", "face": "u2081a1"}, {"name": "スカー", "text": "シャァァァァクッ！　オレサマ、参ッ上ォ！", "face": "u1396a1"}, {"name": "デューオ", "text": "よーし！　全員、暴れちゃえー！", "face": "u594"}]}, {"trigger": "end", "lines": [{"name": "デューオ", "text": "全っ然、数だけの雑魚じゃないんだけど！？", "face": "u594"}, {"name": "ジャクリーヌ", "text": "敵の本拠地だけあって警備も厳重ですね……。", "face": "u766"}, {"name": "イヴリール", "text": "泣き言を言っている暇があったら早く立て。\nあんなものアトランティスの防衛装置の末端に過ぎん。\n都市中の兵士が集まる前に目標に辿り着かねば詰みだぞ。", "face": "u1959a1"}, {"name": "デューオ", "text": "ひー！　急げ急げー！", "face": "u594"}, {"name": "リーンベル", "text": "工作兵は急ぎ橋を渡れ！　都市の門を打ち破るぞ！", "face": "u268"}, {"name": "ミネルバ", "text": "さて、ここからが本番ね……。", "face": "u91"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 6], "ext": "攻撃待ち増加=90,ダメージ開始待ち=900"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}, {"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "hp": 12000, "attack": 800, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "pattern_id": 2153376}, {"enemy_id": 1, "form_index": 1, "hp": 12000, "attack": 800, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "pattern_id": 2153376}, {"enemy_id": 3, "hp": 6600, "attack": 264, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "pattern_id": 2126560}, {"enemy_id": 5, "hp": 16800, "attack": 1000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "pattern_id": 2153392}, {"enemy_id": 6, "hp": 9600, "attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "pattern_id": 2126512}]}, "active": true}