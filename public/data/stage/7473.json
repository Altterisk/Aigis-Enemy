{"quest_id": 7473, "name": "真冬の寒稽古", "description": "ルチアの提案により真冬の海で水着に\nなって模擬戦を行うことになった王子たち。\nしかし、当の本人は何やら荒れており……。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "グルメジャングルは夏のち鮫", "event_category": "History", "mission_id": 920169, "map_no": 5948, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131696, "race_id": 16, "change_to": 2, "change_condition": 2, "master_id": 34190, "global_id": 7807, "spawn_sec": 29}, {"enemy_id": 5, "source": "local", "count": 13, "form_count": 1, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 31}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 120, "base_hp": 5000, "base_attack": 120, "damage_type": "physical", "armor_defense": 65, "attack_range": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 106, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115200, "race_id": 16, "special_effect_id": 72, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 31827, "global_id": 5446, "ranged": true, "spawn_sec": 70}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 500, "base_hp": 6500, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115168, "race_id": 16, "master_id": 31108, "global_id": 4727, "spawn_sec": 114}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105328, "race_id": 16, "change_to": 8, "change_condition": 2, "master_id": 646, "global_id": 645, "spawn_sec": 139}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104640, "race_id": 16, "change_to": 10, "change_condition": 2, "master_id": 561, "global_id": 560, "spawn_sec": 141}], "popups": ["ルチアは倒されると\nその場で復活します。\n復活は2回まで行われます。", "エーテルとニコラウスは倒されると、\nその場で一度だけ復活します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "メーア", "text": "冬だ！　海だ！　寒稽古だー！", "face": "u1038a1"}, {"name": "メーア", "text": "──って、ちょっとおかしくないですかぁ！？\n冬ですよ！？　真冬ですよ！？　なぜに水着ぃ！？", "face": "u1038a1"}, {"name": "クリスタ", "text": "私のわんわんもそうだそうだと言ってますわ！", "face": "u1257a1"}, {"name": "ルチア", "text": "そこぉ！　文句を言うんじゃない！\nお前たちが最近弛んでいると報告があったから、\nわざわざこうして精神を鍛えてやっているんだぞ！", "face": "u1395a1"}, {"name": "メーア", "text": "そんなぁ！？　確かに身に覚えはありますけど！", "face": "u1038a1"}, {"name": "ルチア", "text": "嘘でも否定しろ馬鹿！\n今から二つの部隊に分かれて摸擬戦だ、\n負けた方は海に浸かって素振り千回ッ！", "face": "u1395a1"}, {"name": "メーア", "text": "いやそれは死にますって！？", "face": "u1038a1"}, {"name": "キャリー", "text": "……ルチアさん、荒れてますね。", "face": "u646"}, {"name": "レオナ", "text": "悪いな王子、お前たちを巻き込んで。\nルチアのやつ、この前の夏の合同演習に、\n不参加だったのがよほど悔しかったらしくてな。", "face": "u1027a1"}, {"name": "レオナ", "text": "他にもストレスを溜め込んでいたんだろう。\n参加組の自慢話を散々聞かされているうちに、\nついには爆発してああなってしまったんだ。", "face": "u1027a1"}, {"name": "フーリ", "text": "ルチアさんは確か海に出発する直前で、\n緊急の任務が入ってしまったんですよね……。", "face": "u658"}, {"name": "レオナ", "text": "ああ。だから大目に、というわけでもないが、\n再度気を引き締める意味でも悪くないと思う。\n手間をかけるが、少し稽古の相手をしてやってくれ。", "face": "u1027a1"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "フーリ", "text": "ええと、では私とキャリーさんは\nルチアさんの部隊に参加しますね？", "face": "u658"}, {"name": "キャリー", "text": "王子、正々堂々よろしくお願いします！", "face": "u646"}, {"name": "ルチア", "text": "摸擬戦！　開始だー！！", "face": "u1395a1"}]}, {"trigger": "end", "lines": [{"name": "メーア", "text": "ぜーはー、ぜーはー！\nこっ、殺されるかと思いました……！", "face": "u1038a1"}, {"name": "ルチア", "text": "くっ、私たちの負けだ！\nこうなったら約束通り海に入って──", "face": "u1395a1"}, {"name": "エリアス", "text": "そこまでにしましょう、ルチア。\nこの時期の海水浴は推奨できません、\n精神を鍛える前に病気になってしまいます。", "face": "u1039a1"}, {"name": "ルチア", "text": "うっ……いや、その通りだエリアス。\nすまない、少し頭を冷やしてくるとしよう。", "face": "u1395a1"}, {"name": "キャリー", "text": "だっ、大丈夫でしょうかルチアさん。", "face": "u646"}, {"name": "レオナ", "text": "……どうしたものかな。", "face": "u1027a1"}]}, {"trigger": "end", "lines": [{"name": "レギーナ", "text": "…………ふむ。", "face": "u405"}]}], "active": true}