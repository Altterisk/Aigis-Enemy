 "race_id": 7, "change_to": 11, "change_condition": 4, "master_id": 33189, "global_id": 6806, "to_condition": 4, "to_ticks": 1, "to_global_id": 6807, "spawn_sec": 232}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "hp": 35000, "attack": 1200, "base_hp": 35000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 1, "attack_wait": 85, "attack_interval": 238, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123600, "race_id": 7, "special_effect_id": 222, "change_to": 12, "change_condition": 4, "master_id": 33190, "global_id": 6807, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 6808}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 35000, "attack": 1800, "base_hp": 35000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 1, "attack_wait": 85, "attack_interval": 238, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123600, "race_id": 7, "special_effect_id": 509, "change_to": 13, "change_condition": 4, "master_id": 33191, "global_id": 6808, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 6809}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 35000, "attack": 2700, "base_hp": 35000, "base_attack": 2700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 1, "attack_wait": 85, "attack_interval": 238, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123600, "race_id": 7, "special_effect_id": 127, "master_id": 33192, "global_id": 6809, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 15, "source": "local", "count": 4, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "spawn_sec": 261}, {"enemy_id": 16, "source": "local", "count": 2, "form_count": 2, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104832, "race_id": 7, "change_to": 14, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 576, "global_id": 575, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 576, "spawn_sec": 265}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "from_condition": 4, "trigger_ticks": 1}], "popups": ["イナリ、イズナ、堕姫は\n一定確率で\n物理攻撃を回避します。", "イズナがいる間は、\n敵の妖怪の\n攻撃力と防御力がアップします。", "ハルフゥ、ムイル、\nリバンがいる間は、\n全ての敵のHPが徐々に回復します。\n\nまた、ハルフゥは自身を含む\n範囲内の敵の\n防御力をアップさせます。", "スカーは攻撃を行うたびに、\n攻撃力がアップしていきます。\n\n３回目の攻撃後、\n攻撃力が最大になります。\n※４回目以降の攻撃力が最大"], "dialogue": [{"trigger": "start", "lines": [{"name": "メシナ", "text": "――初詣、いい心がけですわよね。\n新年の最初に、神に祈りを捧げるのですもの。", "face": "u1671a1"}, {"name": "カヨウ", "text": "メシナよ、亜神であるお主まで、\n初詣に来て大丈夫なのか？\n一応は異教の神の神殿にあたると思うのじゃが。", "face": "u1670a1"}, {"name": "メシナ", "text": "問題ありませんわ♪\n私からすると、\nお隣さんに挨拶しにいく感じですわね。", "face": "u1671a1"}, {"name": "メシナ", "text": "言うなれば、ほら、トラムやアランを誘って\n甘味屋さんに行くのと変わりませんもの。", "face": "u1671a1"}, {"name": "メシナ", "text": "それにカヨウだって大妖怪でしょう？\n地域によっては信仰対象だったりしませんの？", "face": "u1671a1"}, {"name": "カヨウ", "text": "ふむ、言われてみればそうじゃな。\nなればわらわも、東の国の神に挨拶してやるかのう♪", "face": "u1670a1"}, {"name": "スカー", "text": "――シャァァァァァァック！\nヒレが凍っちまうぜェ！", "face": "u1396a1"}, {"name": "ハルフゥ", "text": "さむい！　でもすごい！　これが雪！　真っ白ですー！", "face": "u1118a1"}, {"name": "リバン", "text": "東の国観光に来たかいがありましたわ。\n流氷とはまた違う趣がありますもの♪", "face": "u1062a1"}, {"name": "イナリ", "text": "ふっふっふ。\n雪だけでびっくりしてたらもったいないよ？", "face": "u243"}, {"name": "イズナ", "text": "東の国は名所だらけ！\nイズナの観光ガイドにお任せあれです！", "face": "u738"}, {"name": "スカー", "text": "クゥゥゥッ、ありがとよ、狐と狸の嬢ちゃんたち！\nオレサマのハートが滾ってきたぜェェェ！！", "face": "u1396a1"}, {"name": "カヨウ", "text": "――ふむ、あちらにおるのは深海御一行か。\n妖怪に観光案内を任せるとは、\nなかなかに強気じゃのう……。", "face": "u1670a1"}, {"name": "メシナ", "text": "……化かされないか、少し心配ですわね。\n――と言っている間に、少し様子がおかしいような？", "face": "u1671a1"}, {"name": "イナリ", "text": "ぐーるぐーる。\nほーら、参道が無限に続いてるよー。", "face": "u243"}, {"name": "イズナ", "text": "ふっふっふ、王子様をびっくりさせるために、\n日々練習してきた妖術！　とくとご覧あれ！", "face": "u738"}, {"name": "堕姫", "text": "むぅぅぅ、なんでじゃぁ……。\n王子と一緒に初詣に行くのはわらわのはずなのにぃ。\nこうなったらそこのサメに八つ当たりじゃあ！", "face": "u547"}, {"name": "スカー", "text": "シャァァァァック！\nどうなってやがる！　目がまわるぜェ！？", "face": "u1396a1"}, {"name": "メシナ", "text": "……さすがに、他の観光客に迷惑ですわよね。\n一緒にあの子たち、止めますわよ！", "face": "u1671a1"}, {"name": "カヨウ", "text": "そうじゃなぁ。\n化かすのは妖怪の嗜みではあれど、\nこの場は少々懲らしめてやらねばなるまいて。", "face": "u1670a1"}, {"name": "メシナ", "text": "王子、新年早々だけれど、\nびしっと指揮をお願いしますわ！", "face": "u1671a1"}]}, {"trigger": "end", "lines": [{"name": "スカー", "text": "――はっ、オレサマはいったい何を……。", "face": "u1396a1"}, {"name": "ムイル", "text": "ふわわぁ……目が回りますぅ……。", "face": "u1419a1"}, {"name": "スズネ", "text": "あたし様、悪いことしてないですぽん……くすん。", "face": "u936"}, {"name": "メシナ", "text": "楽しくなってしまうのは分かります。\nけれど、東の国の民から見たら、\n皆さまは王国の代表なのですわよ？", "face": "u1671a1"}, {"name": "カヨウ", "text": "王子の顔に泥を塗らぬよう、\n化かすならばもっと盛大に、気合を入れねばならぬのじゃ。\nその辺り、よーく理解しておくようにのう？", "face": "u1670a1"}, {"name": "メシナ", "text": "……それはそれで、何か違うような。", "face": "u1671a1"}, {"name": "メシナ", "text": "まぁ、ともかく、\nせっかく合流したのですし、\n一緒に神社まで初詣に行きませんこと？", "face": "u1671a1"}, {"name": "イナリ", "text": "王子と一緒にはつもーで？\nんふふー、いいかも♪", "face": "u243"}, {"name": "ハルフゥ", "text": "しかし、メシナ様のお邪魔をするわけには……。", "face": "u1118a1"}, {"name": "メシナ", "text": "亜神も魚人も関係ありませんわ。\nここは異郷、よその神殿に参拝するのですから、\n私たちは等しくまれびとのようなモノですわよ。", "face": "u1671a1"}, {"name": "カヨウ", "text": "それに、王子とのでぇとの権利は、\n皆に等しくあるべきじゃからなぁ♪", "face": "u1670a1"}, {"name": "スズネ", "text": "王子さまと！　でぇと！\nこれが噂に聞く初詣でーとだぽん！？", "face": "u936"}, {"name": "スカー", "text": "シャァァァァァァク！\nでーとが何かは知らねェが、\n王子との一騎打ちならオレサマの出番だろうがァ！", "face": "u1396a1"}, {"name": "メシナ", "text": "……後で、騒がしくしてごめんなさいと、\nこの地の神殿に謝っておきませんと。\n――さぁて王子、初詣デートの続きですわよ♪", "face": "u1671a1"}]}], "story_talk": true, "active": true}