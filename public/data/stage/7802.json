{"quest_id": 7802, "name": "深海からの初参り", "description": "東の国へ初詣に行く王子たち。その途中で\n妖怪に化かされて騒ぎを起こす一行がいて？\nメシナとカヨウと協力し、騒動を鎮めよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ31(2022)", "event_category": "Reproduce", "mission_id": 300377, "map_no": 4202, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 22000, "attack": 800, "base_hp": 22000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127280, "race_id": 4, "special_effect_id": 736, "master_id": 33472, "global_id": 7089, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 450, "base_hp": 12000, "base_attack": 450, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112784, "race_id": 4, "special_effect_id": 54, "master_id": 30723, "global_id": 4342, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 400, "base_hp": 25000, "base_attack": 400, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107248, "race_id": 4, "special_effect_id": 103, "master_id": 526, "global_id": 525, "spawn_sec": 6}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["水中"], "hp": 9000, "attack": 550, "base_hp": 9000, "base_attack": 550, "damage_type": "magical", "armor_defense": 180, "magic_defense": 25, "attack_range": 200, "attack_spe