{"quest_id": 4579, "name": "合体デーモン", "description": "突如現れた魔界の門！\n悪魔ハンターと共にデーモンを退けろ！\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ10(2016)", "event_category": "Reproduce", "mission_id": 300100, "map_no": 5416, "level": 90, "multiplier": 0.9, "charisma": 75, "exp": 300, "gold": 1200, "drops": [{"card": 133, "c": 1}, {"card": 58, "c": 2}, {"item": 1003, "c": 1}, {"card": 228}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 5400, "attack": 450, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 1800, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "spawn_sec": 68}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 13500, "attack": 900, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 99}, {"enemy_id": 4, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 5400, "attack": 450, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 102}, {"enemy_id": 5, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 2430, "attack": 315, "base_hp": 2700, "base_attack": 350, "damage_type": "physical", "armor_defense": 70, "magic_defense": 40, "attack_speed": 40, "attack_wait": 3, "attack_interval": 89, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098704, "race_id": 3, "special_effect_id": 42, "master_id": 111, "global_id": 110, "spawn_sec": 108}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "やっぱり魔界の門が開くのはここだったのね……。", "face": "u359"}, {"name": "？？？", "text": "場所を抑えてしまえばこっちのものよ……ふふ。\nさて、仕事開始っと！", "face": "u359"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、気をつけて下さい、\nこの地にて多数のデーモンの出現が\n確認されたとの報告を受けています。", "face": "l15bcf247e4c0"}, {"name": "？？？", "text": "（……誰？　\nこんな危険なところに来て……何者なの？）", "face": "u359"}, {"name": "モーティマ", "text": "おい！　そこのお嬢ちゃん、早くこっちへ来いよ！\nデーモンにやられちまうぜ！", "face": "u14"}, {"name": "？？？", "text": "あなた誰？　素人の助けなんて無い方がマシよ。\n言っておくけど、デーモンを倒した数は、\nあんたたちよりも多いはずよ。", "face": "u359"}, {"name": "フウカ", "text": "よっぽど腕に覚えがあるようね……。\nでもあの数のデーモンを一人でさばけるとは\n思えないわ……王子、加勢するわよ！", "face": "u228"}, {"name": "？？？", "text": "デーモン退治の専門家の\n私と張り合おうってわけね？\nいいわ、どっちが多く倒せるか勝負よ！", "face": "u359"}]}, {"trigger": "battle", "at_sec": 105, "lines": [{"name": "合体デーモン", "text": "おお……この体……素晴らしい……ッ！\nこの合体を繰り返せば他のデーモン達の\n力をすべて取り込めるぞ……。", "face": "l6843f0a4409f"}, {"name": "？？？", "text": "――えッ！？\nな、何よ……あれ？\nデーモンが合体している……？", "face": "u359"}, {"name": "？？？", "text": "一体どういう事なの？", "face": "u359"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "何とか敵を一掃できたみたいね。\nふぅ。今回はちょっとだけ苦戦しちゃったわ。", "face": "u359"}, {"name": "アンナ", "text": "あの……お怪我はありませんか？"}, {"name": "？？？", "text": "大丈夫よ、これくらい。かすり傷だわ。\n……でも、助けてくれてありがと。\nほんのちょっとだけだけどね。", "face": "u359"}, {"name": "ドルチェ", "text": "自己紹介を忘れていたわね。\n私の名前はドルチェ。\nデーモン専門のモンスタースレイヤーよ。", "face": "u359"}, {"name": "アンナ", "text": "デーモン専門……？\nプロとして活動してるという事ですか？"}, {"name": "ドルチェ", "text": "うーん、まぁそんなとこね。\nにしても、さっきの合体したデーモンには、\nあなた達も気をつけておいた方がいいわ。", "face": "u359"}, {"name": "ドルチェ", "text": "もし、デーモン同士で合体して新たな力を\n得る事が出来るようになったとしたら……。\n後はわかるわよね？", "face": "u359"}, {"name": "ドルチェ", "text": "さて、私はもう行くわ。\n武器の調整も必要だし、\nデーモンのことも調べないといけないしね。", "face": "u359"}, {"name": "ドルチェ", "text": "それじゃあね、王子。\nあなた達との戦い、悪くなかったわよ。", "face": "u359"}, {"name": "アンナ", "text": "分かりました。\nドルチェさん、お気をつけて。\nまた機会があればご一緒しましょう。", "face": "l15bcf247e4c0"}]}], "map": {"image": "Map5416", "w": 960, "h": 640, "spots": [{"k": "b", "x": 948, "y": 185}, {"k": "b", "x": 948, "y": 390}, {"k": "m", "x": 216, "y": 153, "id": 200}, {"k": "m", "x": 296, "y": 433, "id": 201}, {"k": "m", "x": 254, "y": 291, "id": 202}, {"k": "m", "x": 238, "y": 228, "id": 203}, {"k": "m", "x": 271, "y": 358, "id": 204}, {"k": "m", "x": 616, "y": 151, "id": 205}, {"k": "m", "x": 695, "y": 425, "id": 206}, {"k": "m", "x": 658, "y": 293, "id": 207}, {"k": "m", "x": 642, "y": 225, "id": 208}, {"k": "m", "x": 674, "y": 354, "id": 209}, {"k": "m", "x": 412, "y": 157, "id": 210}, {"k": "m", "x": 500, "y": 420, "id": 211}, {"k": "m", "x": 478, "y": 363, "id": 212}, {"k": "m", "x": 435, "y": 220, "id": 213}, {"k": "m", "x": 778, "y": 188, "id": 214}, {"k": "m", "x": 828, "y": 389, "id": 215}, {"k": "r", "x": 268, "y": 104, "id": 300}, {"k": "r", "x": 540, "y": 105, "id": 301}, {"k": "r", "x": 670, "y": 101, "id": 302}, {"k": "r", "x": 731, "y": 288, "id": 303}, {"k": "r", "x": 639, "y": 463, "id": 304}, {"k": "r", "x": 368, "y": 465, "id": 305}, {"k": "r", "x": 241, "y": 467, "id": 306}, {"k": "r", "x": 317, "y": 292, "id": 307}, {"k": "r", "x": 411, "y": 293, "id": 308}, {"k": "r", "x": 505, "y": 291, "id": 309}, {"k": "r", "x": 601, "y": 291, "id": 310}, {"k": "r", "x": 188, "y": 292, "id": 311}]}, "start_cost": 10, "active": true, "name_en": "Combined Demon"}