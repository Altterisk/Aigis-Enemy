00.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104320, "race_id": 14, "change_to": 6, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 518, "global_id": 517, "ranged": true, "from_condition": 0}, {"enemy_id": 9, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105152, "race_id": 14, "change_to": 9, "change_condition": 5, "master_id": 604, "global_id": 603, "phases": [{"hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "master_id": 605, "global_id": 604, "condition": 5}], "spawn_sec": 131}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 800, "base_hp": 9000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114592, "race_id": 14, "change_to": 11, "change_condition": 3, "master_id": 31017, "global_id": 4636, "spawn_sec": 149}], "popups": ["清源妙道真君(本体)のいる間は、\n味方ユニットの攻撃力と防御力、\n魔法耐性が『20%』低下します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――この辺りの魔物は、\n一掃できたようですね。"}, {"name": "ナタク", "text": "悪いね王子、\n魔物討伐まで手伝ってもらっちゃって。", "face": "u297"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ナタク", "text": "それじゃあ拠点に戻るとしよ――", "face": "u297"}, {"name": "？？？", "text": "――いいえ、剣を収めるにはまだ早い。\nここでひとつ、お手合わせ願えますか？", "face": "u866"}, {"name": "ケイティ", "text": "何者ですか！？", "face": "u114"}, {"name": "清源妙道真君", "text": "我が名は清源妙道真君。\n故あってあなた方の実力を試させて――", "face": "u866"}, {"name": "ナタク", "text": "――王子、こいつは極めて悪い仙人だ！", "face": "u297"}, {"name": "清源妙道真君", "text": "……えっ？", "face": "u866"}, {"name": "太公望", "text": "はい、何でも出来る完璧超人なのに、\nそれを鼻にかけたりしないのが\nむしろ厭味ったらしい悪い仙人です。", "face": "u603"}, {"name": "清源妙道真君", "text": "いや、待って、打ち合わせと違いま――", "face": "u866"}, {"name": "ナタク", "text": "つまり悪いやつだから、\n一切遠慮なく全力をぶつけていい、\nということだよ、王子。", "face": "u297"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "清源妙道真君", "text": "……くっ。\nふたりとも、私が王国に\n与するのを渋っていた腹いせのつもりですね！？", "face": "u866"}, {"name": "清源妙道真君", "text": "良いでしょう。\n私をここまで焚き付けた以上、\nちょっとは覚悟をしてもらいましょうか！", "face": "u866"}, {"name": "清源妙道真君", "text": "飛びますよ、哮天犬！\nそして虎たちよ、遠慮なく噛み付いてやりなさい！", "face": "u866"}, {"name": "ナタク", "text": "ふぅ……そういうわけだ、王子。\nちょっとあの子の相手をしてもらっていいかな？", "face": "u297"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "ナタク", "text": "ふふ、からかって悪かったね妙道。\nでも約束どおり、\n王子の実力を試す機会は用意してあげただろう？", "face": "u297"}, {"name": "清源妙道真君", "text": "確かに、お膳立ては頼みましたが……。\nこれでは第一印象が最悪ではありませんか？", "face": "u866"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ナタク", "text": "王子は気に入ったみたいだよ？", "face": "u297"}, {"name": "清源妙道真君", "text": "ふむぅ……。", "face": "u866"}, {"name": "太公望", "text": "それで、妙道から見た\n王国軍の実力はいかがでしょう？", "face": "u603"}, {"name": "清源妙道真君", "text": "……あなたたちが心酔するのも分かります。\n人の身でありながら、\nこれほどの実力を備えているとは。", "face": "u866"}, {"name": "清源妙道真君", "text": "時代が時代なら、仙人としての道を歩むよう、\n説得したくなる程の人格者でもあるようですし……。", "face": "u866"}, {"name": "ナタク", "text": "つまり？", "face": "u297"}, {"name": "清源妙道真君", "text": "……合格です。\nこの清源妙道真君、\n王国に協力することを約束しましょう。", "face": "u866"}, {"name": "アンナ", "text": "……えぇと、つまりこの戦いは……？"}, {"name": "太公望", "text": "妙道は私達と同じく、神仙郷に属する仙人なのです。\n王国と共に、世界を救うための戦いに赴いてほしいと、\n以前からずっと口説いていたのですが……。", "face": "u603"}, {"name": "ナタク", "text": "中々首を縦に振ってくれなくてね。\nそこで出た条件が、直接手合わせをして、\n認めるに値する男だったら、というものだったのさ。", "face": "u297"}, {"name": "清源妙道真君", "text": "……でも、あくまで私の使命の合間にですからね。\n私は元始天尊様に仕える者なれば、\n常に王国を助けるというわけにもいかないので。", "face": "u866"}, {"name": "清源妙道真君", "text": "それでもよろしければ、\n手を結ぶとしましょうか。", "face": "u866"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "清源妙道真君", "text": "それでは、また近い内にお会いしましょう。\n――翔けよ、哮天犬！", "face": "u866"}, {"name": "アンナ", "text": "……どうやら、心強い味方が増えたようですね。\nそれでは王子、我々も王国へ帰還しましょう！"}]}], "map": {"image": "Map920132_5509", "w": 960, "h": 640, "spots": [{"k": "b", "x": 492, "y": 23}, {"k": "m", "x": 695, "y": 137, "id": 200}, {"k": "m", "x": 284, "y": 147, "id": 201}, {"k": "m", "x": 194, "y": 306, "id": 202}, {"k": "m", "x": 581, "y": 448, "id": 203}, {"k": "m", "x": 812, "y": 275, "id": 204}, {"k": "m", "x": 464, "y": 449, "id": 205}, {"k": "m", "x": 761, "y": 478, "id": 206}, {"k": "m", "x": 244, "y": 468, "id": 207}, {"k": "m", "x": 236, "y": 223, "id": 208}, {"k": "m", "x": 110, "y": 367, "id": 209}, {"k": "m", "x": 277, "y": 365, "id": 210}, {"k": "m", "x": 757, "y": 204, "id": 211}, {"k": "m", "x": 756, "y": 341, "id": 212}, {"k": "m", "x": 684, "y": 408, "id": 213}, {"k": "m", "x": 347, "y": 439, "id": 214}, {"k": "m", "x": 121, "y": 466, "id": 215}, {"k": "m", "x": 604, "y": 170, "id": 216}, {"k": "m", "x": 395, "y": 176, "id": 217}, {"k": "m", "x": 491, "y": 147, "id": 218}, {"k": "r", "x": 137, "y": 213, "id": 300}, {"k": "r", "x": 181, "y": 411, "id": 301}, {"k": "r", "x": 334, "y": 250, "id": 302}, {"k": "r", "x": 445, "y": 323, "id": 303}, {"k": "r", "x": 548, "y": 247, "id": 304}, {"k": "r", "x": 669, "y": 311, "id": 305}, {"k": "r", "x": 842, "y": 409, "id": 306}]}, "start_cost": 10, "active": true, "name_en": "Duel with Erlang Shen", "description_en": "Defeat Erlang Shen, who leads the Yōko! <Erlang Shen reduces ally attack, defense, and magic resistance> Divine (★1 acquisition guideline: Avg Lv50)"}