erval": 501, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 0.800000011920929, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133072, "special_effect_id": 955, "missile_id": 670, "missile": {"speed": 4.0}, "master_id": 37012, "global_id": 10629, "ranged": true, "spawn_sec": 83}, {"enemy_id": 7, "source": "local", "count": 9, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 89}, {"enemy_id": 8, "source": "local", "count": 8, "form_count": 1, "tags": ["機械"], "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 500, "attack_wait": 60, "attack_interval": 159, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118960, "special_effect_id": 389, "master_id": 31791, "global_id": 5410, "spawn_sec": 118}, {"enemy_id": 9, "source": "local", "count": 19, "form_count": 1, "tags": ["機械"], "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "attack_range": 150, "attack_wait": 30, "attack_interval": 88, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118928, "special_effect_id": 449, "missile_id": 26, "master_id": 34005, "global_id": 7622, "ranged": true, "spawn_sec": 123}], "popups": ["マナスパーク発生装置は\n一定時間おきに\n起動と停止を繰り返します。\n\nマナスパーク発生装置が\n起動している間は\n一定範囲内のユニットに\n継続ダメージを与えます。", "レクテの\n一定範囲内のユニットは\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レクテ", "text": "――うー。\nこんな所まで追ってくるなんて。\nもしかして王国軍も「あいつら」の仲間！？", "face": "u2047a1"}, {"name": "レクテ", "text": "魔王軍の頃は発明なんてさせてもらえなかったし。\nようやく見つけた、好き勝手に研究できるこの場所を、\nぜーったいに、失うわけにはいかないんだから！", "face": "u2047a1"}, {"name": "アンナ", "text": "はぁ、はぁ……。\nレクテさん！　お願いです、話を聞いてください！", "face": "lf1bb7406398f"}, {"name": "レクテ", "text": "ことわーる！", "face": "u2047a1"}, {"name": "レクテ", "text": "せっかく手にした安住の地、\n奪わせはしないんだから！", "face": "u2047a1"}, {"name": "レクテ", "text": "あたしの最新発明品、\nマナスパーク発生装置で、一網打尽にしてあげる！", "face": "u2047a1"}, {"name": "タバサ", "text": "うっわー！　なんですかあれ！\nすごいですよ、魔導と科学が融合しちゃってますよ！", "face": "u1064a1"}, {"name": "レクテ", "text": "ふふん、分かる人には分かっちゃうみたいね！\nこれは魔力を雷撃に変換する装置！！", "face": "u2047a1"}, {"name": "レクテ", "text": "チャージと放出を繰り返し、\n外敵を薙ぎ払う秘密兵器だよ！！", "face": "u2047a1"}, {"name": "クレール", "text": "……王子様、あの子の行動はアホっぽいけど、\n本物の天才で、しかも努力しちゃう天才なんです。", "face": "u1046a1"}, {"name": "クレール", "text": "たぶんあの装置もおもちゃじゃなくて、\n立派に兵器と名乗れる威力をしているんじゃないかと。", "face": "u1046a1"}, {"name": "レクテ", "text": "うぅ、クレールまであたしの敵になるなんて。\n友よ、この手で引導を渡してあげる！！", "face": "u2047a1"}]}, {"trigger": "end", "lines": [{"name": "レクテ", "text": "…………すみませんごめんなさい負けました。", "face": "u2047a1"}, {"name": "クレール", "text": "切り替えが早いのはいいことです。\nほら、立ってください。\n本当に危害を加えるつもりはないので。", "face": "u1046a1"}, {"name": "レクテ", "text": "……ほんとに？\n「あいつら」の仲間じゃないの？", "face": "u2047a1"}, {"name": "アンナ", "text": "あいつらとは、白の帝国のことですか？\n帝国とは協力関係ですが――", "face": "lf1bb7406398f"}, {"name": "レクテ", "text": "違う違う。\n帝国も怖いけど、あたしを追い回してるのは、\n神聖騎士団ってやつらだよ。", "face": "u2047a1"}, {"name": "ドゥマルデ", "text": "…………ほほう？", "face": "u1266a1"}, {"name": "レクテ", "text": "前にね、古代文明の遺跡を調査しに行った時に\n連中に目をつけられちゃったみたいで……。", "face": "u2047a1"}, {"name": "レクテ", "text": "あいつらは碑文とか言ってたけど、\nあたしはただ、古代の調理器具の\n取扱説明書を読んでただけなんだよ？", "face": "u2047a1"}, {"name": "アルレット", "text": "あー……。\n読めちゃうわけか、古代の文字。", "face": "u1453a1"}, {"name": "レクテ", "text": "そりゃね。\n残ってる文献は少ないけど、少ないだけで、\n頑張れば言語くらい習得できるでしょ。", "face": "u2047a1"}, {"name": "アルレット", "text": "王子さま、たぶん神聖騎士団は、\n亜神ディアスに手を届かせるあらゆる手段を、\n根こそぎ物質界から消し去るつもりなんだよ。", "face": "u1453a1"}, {"name": "アルレット", "text": "たとえば、解析もできていないような、\n古代の何らかの兵器とか、\nそういう小さな可能性すらね。", "face": "u1453a1"}, {"name": "レクテ", "text": "えぇぇ、それであたし、狙われてるの！？", "face": "u2047a1"}, {"name": "アルレット", "text": "レクテの場合はもっとヤバイ。\n何しろ一目みただけの飛空戦艦を再現できて、\n新設計の動力機関も作れちゃう発明家なんだから。", "face": "u1453a1"}, {"name": "アルレット", "text": "こいつ、放置したら\nすごい飛空戦艦作るなって思われたんじゃないかな？", "face": "u1453a1"}, {"name": "レクテ", "text": "そんな予算ないのにー！？", "face": "u2047a1"}, {"name": "デーモンシェフ", "text": "――となれば、ここからは商売の時間だな。", "face": "l044068c02ece"}, {"name": "レクテ", "text": "あれ、あなたは確か、前に魔王軍で……。", "face": "u2047a1"}, {"name": "デーモンシェフ", "text": "今は飲食業界を中心に、\n手広く新規事業を立ち上げる商売人でな。\n互いに魔王軍にいた頃より活き活きしている仲間だとも。", "face": "l044068c02ece"}, {"name": "デーモンシェフ", "text": "レクテよ、研究予算はデモシェフ商会が出そう。\nその知性、物質界連合軍で発揮してみる気はないか！？", "face": "l044068c02ece"}, {"name": "レクテ", "text": "えっ、えっ？", "face": "u2047a1"}, {"name": "アンナ", "text": "研究環境は王国が用意しましょう。\nあなたの慧眼は、放置しておくには惜しいものです。"}, {"name": "レクテ", "text": "なに？　もしかして今、あたし求められてる！？", "face": "u2047a1"}, {"name": "アリシア", "text": "それから、神聖騎士団からの護衛も。\nこれは契約を交わすか否かを問わず、\n必ずあなたを守るとお約束します。", "face": "u372"}, {"name": "ケイティ", "text": "神聖騎士団は、\n王国としても最大級の警戒対象ですからね。", "face": "u114"}, {"name": "レクテ", "text": "あ、あ、あ……。", "face": "u2047a1"}, {"name": "レクテ", "text": "ありがとうございますぅぅぅぅぅ。", "face": "u2047a1"}, {"name": "レクテ", "text": "あ、あたし！　頑張る！\nすっごい頑張って、なんかすごい物作るね！！", "face": "u2047a1"}]}], "active": true}