{"quest_id": 8150, "name": "マナスパーク発生装置", "description": "最新発明品のマナスパーク発生装置を使い、\n王子たちを一網打尽にしようとする\nレクテの暴走を止めよ！\n神級（★１獲得の目安：平均Lv50）", "event": "遥かな空を目指すには？", "event_category": "History", "mission_id": 920209, "map_no": 4836, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 2, "tags": ["置物"], "fixture": true, "hp": 50000, "base_hp": 50000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 90, "attack_interval": 222, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "pattern_id": 2149712, "special_effect_id": 1617, "change_to": 1, "missile_id": 780, "missile": {"slow": [99, 0]}, "master_id": 37010, "global_id": 10627, "to_global_id": 10628, "to_flag": [1, 1], "route_behaviour": {"transforms": [{"flag": 1, "val": 1}, {"flag": 11, "val": 1}, {"flag": 21, "val": 1}, {"flag": 31, "val": 1}, {"flag": 41, "val": 1}, {"flag": 51, "val": 1}, {"flag": 61, "val": 1}, {"flag": 71, "val": 1}, {"flag": 81, "val": 1}, {"flag": 91, "val": 1}, {"flag": 101, "val": 1}, {"flag": 111, "val": 1}, {"flag": 2, "val": 1}, {"flag": 12, "val": 1}, {"flag": 22, "val": 1}, {"flag": 32, "val": 1}, {"flag": 42, "val": 1}, {"flag": 52, "val": 1}, {"flag": 62, "val": 1}, {"flag": 72, "val": 1}, {"flag": 82, "val": 1}, {"flag": 92, "val": 1}, {"flag": 102, "val": 1}, {"flag": 112, "val": 1}, {"flag": 3, "val": 1}, {"flag": 13, "val": 1}, {"flag": 23, "val": 1}, {"flag": 33, "val": 1}, {"flag": 43, "val": 1}, {"flag": 53, "val": 1}, {"flag": 63, "val": 1}, {"flag": 73, "val": 1}, {"flag": 83, "val": 1}, {"flag": 93, "val": 1}, {"flag": 103, "val": 1}, {"flag": 113, "val": 1}, {"flag": 4, "val": 1}, {"flag": 14, "val": 1}, {"flag": 24, "val": 1}, {"flag": 34, "val": 1}, {"flag": 44, "val": 1}, {"flag": 54, "val": 1}, {"flag": 64, "val": 1}, {"flag": 74, "val": 1}, {"flag": 84, "val": 1}, {"flag": 94, "val": 1}, {"flag": 104, "val": 1}, {"flag