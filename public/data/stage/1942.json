_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2172784, "race_id": 3, "master_id": 23594, "spawn_sec": 59}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110064, "race_id": 12, "special_effect_id": 168, "master_id": 30315, "global_id": 3934, "spawn_sec": 91}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 15000, "attack": 600, "base_hp": 15000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "attack_speed": 40, "attack_wait": 30, "attack_interval": 156, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 100, "pattern_id": 2172880, "race_id": 8, "master_id": 23588, "spawn_sec": 130}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 15000, "attack": 600, "base_hp": 15000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2172864, "race_id": 8, "master_id": 23589, "spawn_sec": 130}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 15000, "base_hp": 15000, "damage_type": "physical", "armor_defense": 550, "magic_defense": 10, "attack_speed": 1, "attack_wait": 17, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120976, "race_id": 16, "change_to": 11, "master_id": 23598, "route_behaviour": {"transforms": [{"wait": -1}]}, "spawn_sec": 130}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "attack_interval": 231, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112512, "race_id": 3, "master_id": 23590, "spawn_sec": 130}], "dialogue": [{"trigger": "start", "lines": [{"name": "ベルゼビュートの眷属", "text": "──ブブブブブブ。", "face": "l60231936c46a"}, {"name": "オークの部族長", "text": "空と大地が、黒に染まっていく……。", "face": "l8d34cd20d0f1"}, {"name": "オーク", "text": "なんだこれは、世界は滅んでしまったのか……？", "face": "l63166045e5e7"}, {"name": "オークの子供", "text": "とうちゃ、怖い……。", "face": "l6a0602e06176"}, {"name": "オークの父親", "text": "怯えるな、息子よ。お前も勇敢なるオークの戦士。\nハッタリだろうとも構わん、恐怖に立ち向かうのだ。", "face": "l63166045e5e7"}, {"name": "オークの父親", "text": "安心しろ、父がお前を守ってやる。", "face": "l63166045e5e7"}, {"name": "オークの子供", "text": "うん……。", "face": "l6a0602e06176"}, {"name": "アルティア", "text": "──皆さん、無事ですか！？", "face": "u261"}, {"name": "オークの部族長", "text": "おお！　そなたは王国の！", "face": "l8d34cd20d0f1"}, {"name": "アルティア", "text": "挨拶は後程改めて。\n魔神ベルゼビュートの軍勢が迫っています。\n今すぐに避難してください。", "face": "u261"}, {"name": "オーク", "text": "魔神ベルゼビュートだと！？", "face": "l63166045e5e7"}, {"name": "オークの部族長", "text": "なるほど、道理で禍々しい気配をしているわけだ。", "face": "l8d34cd20d0f1"}, {"name": "オークの部族長", "text": "だがしかし、ここはオーク族父祖伝来の土地。", "face": "l8d34cd20d0f1"}, {"name": "オークの部族長", "text": "易々と侵略者に明け渡すことも、\n戦わずして逃げ出すこともできん。", "face": "l8d34cd20d0f1"}, {"name": "オークの部族長", "text": "そなたらはあれと戦うつもりなのだろう？\nであれば、我らも戦列に加えてもらおうか。\n無論、非戦闘員は他の集落に避難させる。", "face": "l8d34cd20d0f1"}, {"name": "遠征部隊", "text": "（相手はオークです。説得はするだけ無駄かと）", "face": "u64"}, {"name": "アルティア", "text": "……分かりました。ですが、指示には従ってもらいます。", "face": "u261"}, {"name": "オークの部族長", "text": "足並みを乱すわけにはいかぬからな、了解した。", "face": "l8d34cd20d0f1"}, {"name": "アルティア", "text": "我々の目的は援軍到着までの時間稼ぎです。\nくれぐれも、無茶だけはしないようお願いします。", "face": "u261"}, {"name": "オークの部族長", "text": "善処しよう。", "face": "l8d34cd20d0f1"}, {"name": "遠征部隊", "text": "（不安）", "face": "u64"}, {"name": "アルティア", "text": "総員、迎撃態勢！　会敵します！", "face": "u261"}]}, {"trigger": "end", "lines": [{"name": "遠征部隊", "text": "──第二波、来ます！", "face": "u64"}, {"name": "ベルゼビュートの眷属", "text": "ブブブブブブブブ。", "face": "l60231936c46a"}, {"name": "アルティア", "text": "（想定よりも圧が強い、ここは戦線を少し下げて──）", "face": "u261"}, {"name": "アルティア", "text": "──ッ！？", "face": "u261"}, {"name": "オークの子供", "text": "とうちゃ！！　とうちゃ！！", "face": "l6a0602e06176"}, {"name": "オークの父親", "text": "息子よ、早く逃げるのだ。父のことは置いて行け。", "face": "l63166045e5e7"}, {"name": "オークの子供", "text": "やだ、やだよぅ！　どうしてそんなこと言うの！", "face": "l6a0602e06176"}, {"name": "アルティア", "text": "（子供！？　なんで、助け、いや、間に合わ──！）", "face": "u261"}, {"name": "オークの父親", "text": "お前も分かっているはずだ、\nオークの戦士は死と隣り合わせ。\n父にも順番が回ってきたのだ。", "face": "l63166045e5e7"}, {"name": "オークの父親", "text": "だが、お前にはまだ未来がある。\n逃げて生き延びよ、そして強くなれ。", "face": "l63166045e5e7"}, {"name": "オークの父親", "text": "我らの意志を継ぎ、誇り高き戦士に──", "face": "l63166045e5e7"}, {"name": "オークの子供", "text": "わかんない！　わかんないよ！", "face": "l6a0602e06176"}, {"name": "ベルゼビュートの眷属", "text": "ブブブブブブブブ。", "face": "l60231936c46a"}, {"name": "オークの子供", "text": "怖くない……怖くないぞ。\nお前なんか、ちっとも怖くあるもんか！", "face": "l6a0602e06176"}, {"name": "オークの父親", "text": "待て、息子よ。行ってはならん、行っては──", "face": "l63166045e5e7"}, {"name": "ベルゼビュートの眷属", "text": "ブッ──ブブブ、ブ、ブッ！？", "face": "l60231936c46a"}, {"name": "オークの子供", "text": "……え？", "face": "l6a0602e06176"}]}, {"trigger": "end", "lines": [{"name": "アルティア", "text": "（愚かな真似をお許しください、ヴィディア様）", "face": "u261"}, {"name": "アルティア", "text": "（指揮官が敵の包囲のど真ん中に突撃するなど、\n今まで私は書物から何を学んできたのでしょうか……）", "face": "u261"}, {"name": "アルティア", "text": "（それも、戦力にならない負傷兵と子供を救うために）", "face": "u261"}, {"name": "アルティア", "text": "（愚行、無謀、暴挙、短慮、軽率、失策、悪手──）", "face": "u261"}, {"name": "アルティア", "text": "（それでも、だとしても──）", "face": "u261"}, {"name": "アルティア", "text": "（ここで前に出られないようでは、\n私はもう胸を張って王子の隣に立てない）", "face": "u261"}, {"name": "アルティア", "text": "（なぜだか、そんな確信があるのです）", "face": "u261"}, {"name": "オークの子供", "text": "王国の、おねえちゃ……。", "face": "l6a0602e06176"}, {"name": "アルティア", "text": "下がっていてください。", "face": "u261"}, {"name": "ベルゼビュートの眷属", "text": "ブブブブブブブブ。", "face": "l60231936c46a"}, {"name": "アルティア", "text": "（援軍の到着までこの命が保つかどうか……）", "face": "u261"}, {"name": "アルティア", "text": "（王子、もしも私が死んでしまったなら。\nそのときは、どうか花と涙を手向けてください）", "face": "u261"}, {"name": "アルティア", "text": "来いッ！　王国の剣が貴様らの相手になる！", "face": "u261"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "──汝、人の子よ。全てを投げ出すにはまだ早い。", "face": "lfb8eaf80f0f2"}, {"name": "アルティア", "text": "こ、この声、は……？", "face": "u261"}, {"name": "？？？", "text": "あなたには二つの道がある。", "face": "lfb8eaf80f0f2"}, {"name": "？？？", "text": "運命を前にして膝を突くか、\n回天の試練へと立ち向かうか。", "face": "lfb8eaf80f0f2"}, {"name": "？？？", "text": "もしも抗うことを選ぶのであれば、剣を掲げなさい。", "face": "lfb8eaf80f0f2"}, {"name": "アルティア", "text": "わ、私、は──ッ！", "face": "u261"}]}], "active": true}