_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 41213, "spawn_sec": 320}, {"enemy_id": 7, "source": "local", "count": 12, "form_count": 1, "tags": ["タルタロスの呪縛", "置物"], "fixture": true, "hp": 30000, "attack": 100, "base_hp": 30000, "base_attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "attack_speed": 1, "attack_wait": 90, "attack_interval": 222, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2168544, "special_effect_id": 2345, "master_id": 40011, "global_id": 13628, "spawn_sec": 335}, {"enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "tags": ["ステルス"], "hp": 30000, "attack": 800, "base_hp": 30000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113920, "master_id": 40554, "global_id": 14171, "spawn_sec": 342}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["帝国", "置物"], "fixture": true, "hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "attack_range": 160, "attack_speed": 1, "attack_wait": 35, "attack_interval": 87, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173536, "race_id": 16, "change_to": 9, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 41207, "ranged": true, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 535}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "tags": ["影の帝国", "置物"], "fixture": true, "hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "attack_range": 220, "attack_speed": 1, "attack_wait": 35, "attack_interval": 121, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2173456, "race_id": 16, "special_effect_id": 2520, "change_to": 11, "missile_id": 1723, "missile": {"speed": 10.0, "on_hit": {"kind": "DOT", "duration_f": 180, "interval_f": 30, "pct_hp": 30, "uses_atk": true, "effect_name": "DebuffEffectPoison3"}}, "master_id": 41204, "ranged": true, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 535}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["影の帝国", "置物"], "fixture": true, "hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "attack_range": 160, "attack_speed": 1, "attack_wait": 35, "attack_interval": 121, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2173520, "race_id": 16, "special_effect_id": 2521, "change_to": 10, "missile_id": 1723, "missile": {"speed": 10.0, "on_hit": {"kind": "DOT", "duration_f": 180, "interval_f": 30, "pct_hp": 30, "uses_atk": true, "effect_name": "DebuffEffectPoison3"}}, "master_id": 41205, "ranged": true}], "popups": ["\n\n\n\n　　――帝都にて", "影の帝国騎士、影の帝国巨兵は、\n戦場にいる呪いの泥の総数に応じて\n攻撃と防御がアップします。", "影の帝国巨兵の\n攻撃を受けると、\n即座に麻痺状態になります。", "？？？は\n攻撃力1500以下の\nあらゆる攻撃を受け付けません。\n\n？？？から攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n　　　　　　(1/3)", "？？？の\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。\n\n\n　　　　　　(2/3)", "？？？は、\n戦場にいる呪いの泥の総数に応じて\n攻撃と防御がアップします。\n\n\n\n\n　　　　　　(3/3)"], "dialogue": [{"trigger": "start", "lines": [{"text": "――帝都にて"}, {"name": "ディアナ", "text": "ふぅ……剣で片付かない仕事というのも、\nなかなか大変なものですね……。", "face": "u624"}, {"name": "ローザ", "text": "ディアナ様？\nもしかして、帝都の視察ですか？", "face": "u2916a1"}, {"name": "ディアナ", "text": "ああ、ローザ。\nいいえ、借り物の玉座で、\nそんな皇帝の真似事までするつもりはありませんよ。", "face": "u624"}, {"name": "ディアナ", "text": "ただ、執務の息抜きに、\n街で食事でも取ろうかと思っただけです。", "face": "u624"}, {"name": "ローザ", "text": "皇帝陛下不在の間だけとはいえ、\n帝国の運営の大部分を任せられているのですよね。\n本当にお疲れ様です、ディアナ様。", "face": "u2916a1"}, {"name": "ディアナ", "text": "これもある意味では予行演習。\nいつか役に立つ日も来ることでしょう。\n――それでローザ、そちらの子は？", "face": "u624"}, {"name": "サスキア", "text": "さ、サスキアです！\n今はローザさんと一緒に、帝都の警備を！", "face": "u2918a1"}, {"name": "ローザ", "text": "中々に腕利きの兵でして。\n最近は警備にも同行してもらっているんです。", "face": "u2916a1"}, {"name": "ディアナ", "text": "ふふっ、ローザが気に入るなんて。\nこれは将来有望ですね。", "face": "u624"}, {"name": "サスキア", "text": "はっ！", "face": "u2918a1"}]}, {"trigger": "battle", "at_sec": 53, "lines": [{"name": "ディアナ", "text": "――ところで……。", "face": "u624"}, {"name": "ローザ", "text": "はい。どうやら、囲まれているようです。", "face": "u2916a1"}, {"name": "サスキア", "text": "まさか……。\nこの帝都に襲撃してくる者が……？", "face": "u2918a1"}, {"name": "ディアナ", "text": "今や珍しくもないことです。\n――何者ですか！　姿を見せなさい！", "face": "u624"}]}, {"trigger": "battle", "at_sec": 56, "lines": [{"name": "？？？", "text": "……借り物の玉座に陶酔し、\n腑抜けになっているのではないかと思っていましたが。\nどうやら、勘は衰えていないようですね。", "face": "u2914a1"}, {"name": "サスキア", "text": "えっ……？　でぃ、ディアナ様が、ふたり！？", "face": "u2918a1"}, {"name": "ディアナ", "text": "幻術……いえ、以前も出現した、\nタルタロスの魔力による偽物……？", "face": "u624"}, {"name": "？？？", "text": "私が偽物かどうかは、剣を交えれば分かることでしょう。", "face": "u2914a1"}, {"name": "ディアナ", "text": "いいでしょう。\nローザ、サスキア、手を貸してくれますか？", "face": "u624"}, {"name": "ディアナ", "text": "もちろんです。後ろはお任せを。", "face": "u624"}, {"name": "サスキア", "text": "が、がんばります……！", "face": "u2918a1"}]}, {"trigger": "end", "lines": [{"name": "ディアナ", "text": "――同じ剣技、同じ力……。\n戦い方こそ違えど、その奥底にあるものは同じ。", "face": "u624"}, {"name": "ディアナ", "text": "ドッペルゲンガーのように、私に化けた存在でもない。\n何者ですか、あなたは。", "face": "u624"}, {"name": "？？？", "text": "……私は、あなたです。", "face": "u2914a1"}, {"name": "ディアナ", "text": "私……？", "face": "u624"}, {"name": "？？？", "text": "力による闘争に翻弄される無力な民、\n平和を望みながらも戦わねば生きていけない者たち、\n故郷を失い、絶望に嘆く者たち……。", "face": "u2914a1"}, {"name": "影のディアナ", "text": "彼らを見捨ててはおけない、\nそのために皇帝に剣すら向けた、あなたの影です。", "face": "u2914a1"}, {"name": "ディアナ", "text": "……私の影が、何を望むと？", "face": "u624"}, {"name": "影のディアナ", "text": "この身の破滅を。", "face": "u2914a1"}, {"name": "ディアナ", "text": "なにゆえ。", "face": "u624"}, {"name": "影のディアナ", "text": "この命ひとつによる闘争。\nその先の結末によって、\n「影の帝国」の民をあなたに庇護させます。", "face": "u2914a1"}, {"name": "ディアナ", "text": "……まわりくどいことを。", "face": "u624"}, {"name": "影のディアナ", "text": "それでは、私の帝国でお待ちしています。", "face": "u2914a1"}]}, {"trigger": "end", "lines": [{"name": "サスキア", "text": "き、消えちゃいました……。", "face": "u2918a1"}, {"name": "ローザ", "text": "いったい、彼女は何を言っていたのですか？", "face": "u2916a1"}, {"name": "ディアナ", "text": "簡単なことです。", "face": "u624"}, {"name": "ディアナ", "text": "あれは……おそらくタルタロスの魔力によって、\n私の欲望から作られたあの女は――", "face": "u624"}, {"name": "ディアナ", "text": "――宣戦布告をしてきたのですよ。\nそれも、勝っても負けても、\nあの女が利益を総取りしていく戦いを。", "face": "u624"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 23, "params": [50]}, {"kind": "term", "influence": 22, "params": [50]}, {"kind": "term", "influence": 9, "params": [50], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "hp": 14000, "attack": 1700, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "pattern_id": 2173488}, {"enemy_id": 2, "hp": 200000, "attack": 3500, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2173504}, {"enemy_id": 3, "hp": 62000, "attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2168528}, {"enemy_id": 4, "hp": 300000, "attack": 2200, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2173456}, {"enemy_id": 4, "form_index": 1, "hp": 300000, "attack": 2200, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2173456}, {"enemy_id": 6