{"quest_id": 20041, "name": "潜入商人と服従の呪い", "description": "都市外へ逃れる竜の軍勢を追う王子ら。\nこちらへ寝返った商人とともに、\n立ち塞がる竜の軍勢を退けよ！\n極級（★１獲得の目安：平均Lv25）", "event": "竜姫襲来", "event_category": "Emergency", "mission_id": 200588, "map_no": 7513, "level": 80, "multiplier": 0.8, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 31200, "attack": 1200, "base_hp": 39000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 800, "attack_speed": 1, "attack_wait": 45, "attack_interval": 134, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173744, "race_id": 2, "special_effect_id": 952, "master_id": 41227}, {"enemy_id": 2, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 4800, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100256, "race_id": 2, "change_to": 2, "change_condition": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 712, "global_id": 711, "ranged": true, "to_condition": 2, "to_global_id": 712, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 9600, "attack": 400, "base_hp": 12000, "base_attack": 400, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100272, "race_id": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 713, "global_id": 712, "ranged": true, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 16, "form_index": 0, "form_count": 2, "hp": 1600, "attack": 240, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 90, "attack_interval": 222, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132944, "race_id": 2, "change_to": 4, "master_id": 34563, "global_id": 8180, "to_condition": 0, "to_global_id": 8181, "spawn_sec": 4}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1600, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_range": 180, "attack_speed": 1, "attack_wait": 90, "attack_interval": 221, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132944, "race_id": 2, "change_to": 3, "missile_id": 667, "missile": {"speed": 6.0}, "master_id": 34564, "global_id": 8181, "ranged": true, "from_condition": 0}, {"enemy_id": 6, "source": "local", "count": 9, "form_index": 0, "form_count": 1, "hp": 2240, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 50}, {"enemy_id": 7, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "hp": 4800, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100864, "race_id": 2, "change_to": 7, "change_condition": 2, "missile_id": 33, "missile": {"speed": 5.0}, "master_id": 285, "global_id": 284, "ranged": true, "to_condition": 2, "to_global_id": 285, "spawn_sec": 84}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100880, "race_id": 2, "missile_id": 34, "missile": {"speed": 5.0}, "master_id": 286, "global_id": 285, "ranged": true, "from_condition": 2}, {"enemy_id": 9, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 3200, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 42, "global_id": 41, "ranged": true, "spawn_sec": 89}], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴァニカ", "text": "アンウェン様、そろそろ抜けてもよろしいですか？", "face": "u2931a1"}, {"name": "アンウェン", "text": "おぉヴァニカ。\n抜けるとは――ああ、おぬしスパイだったな！", "face": "l9c5e016ae569"}, {"name": "ヴァニカ", "text": "最初に見抜かれた時は、\nさてどうやって逃げようかと思ったものでしたが。\nアンウェン様だけでしたよ、気付いたの。", "face": "u2931a1"}, {"name": "アンウェン", "text": "わらわの配下でもなし、\n我が軍を天眼ノ国へ招き入れた貴族院の馬鹿どもが\n慌てふためく程度なら何にも構わん。", "face": "l9c5e016ae569"}, {"name": "ヴァニカ", "text": "おや、一応協力関係だと思ったのですが？", "face": "u2931a1"}, {"name": "貴族院議員", "text": "な、な、な、何を！\nヴァニカの裏切りだけでなく、\nアンウェン様まで何を仰せか！", "face": "ld27c976377a6"}, {"name": "アンウェン", "text": "事前に伝えたはずだが？\nわらわとそなたは、同じ敵がいるというだけ。\n協力ではなく競争の関係だと。", "face": "l9c5e016ae569"}, {"name": "アンウェン", "text": "それでもよいと、わらわの軍を\n天眼ノ国へ招き入れたのはそなたであろう。", "face": "l9c5e016ae569"}, {"name": "サフレア", "text": "（姫様、いつの間にか腹芸までできるようになって……。\nサフレア、感激にございます）", "face": "l91ed24334c6e"}, {"name": "アンウェン", "text": "さ、はよう行け。\n――そなたの傭兵団とも戦ってみたいと、\n隣で見ていて思っておったのだ。", "face": "l9c5e016ae569"}, {"name": "ヴァニカ", "text": "おぉ怖い。ではあちらで、\n正々堂々お相手しましょう。", "face": "u2931a1"}, {"name": "アキレア", "text": "ん……？　おい、商人の姉ちゃんがこっちくるぞ？\n斬っていいのか？", "face": "u1972a1"}, {"name": "アナーニャ", "text": "待って！　あの子は味方だから！", "face": "u2873a1"}, {"name": "アキレア", "text": "あぁ？　さっきはこっちに殴りかかって――\nああ、なるほど……スパイってことか。", "face": "u1972a1"}, {"name": "ヴァニカ", "text": "ひぃ、ふぅ、はぁ……。\nね、寝返ります。こっちにいれてくださいっ！", "face": "u2931a1"}, {"name": "アナーニャ", "text": "もう演技は止めていいですよ。\nヴァニカ、よく貴族院連中を探ってくれました。\n外患誘致計画なんてもう有罪確定！　お手柄！", "face": "u2873a1"}, {"name": "ヴァニカ", "text": "えへへ。ではお代の方は期待させていただきますね。", "face": "u2931a1"}, {"name": "ラージヴィール", "text": "（……恐ろしい女だ。\n王子よ、伴侶に選ぶなら\n我が娘のような愛らしい乙女にするのだぞ）", "face": "l4ebe7bd5270c"}, {"name": "三つ目の従者", "text": "（ニハラ様もすでに片鱗がありますけどね。\n父君殿が愚直な熱血漢であるせいで）", "face": "l5ca89d5d54d4"}, {"name": "アンウェン", "text": "――では、始めるか。", "face": "l9c5e016ae569"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "サフレア", "text": "（これは……どうあがいても届かない……）", "face": "l91ed24334c6e"}, {"name": "サフレア", "text": "（姫様は強い。本来のドラゴンの姿でなく、\n人の身で戦うことを選んだことを考えても、\nそれでも、姫様が負けるところは殆ど見たことがない）", "face": "l91ed24334c6e"}, {"name": "サフレア", "text": "それなのに……。\n姫様、どうかご無事で……！", "face": "l91ed24334c6e"}, {"name": "アンウェン", "text": "……このまま押せば、わらわの勝ちだ。", "face": "l9c5e016ae569"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンウェン", "text": "だが、そうだな……。\nこんな小さな勝利ひとつを競り合っても、無意味か。", "face": "l9c5e016ae569"}, {"name": "アンウェン", "text": "すでに大勢は決した。\nそなたのもとまで駆け抜けたはいいが、\n我が配下はすでに劣勢となりつつある。", "face": "l9c5e016ae569"}, {"name": "アンウェン", "text": "……異世界の王子よ、なぜこの地へ来た。\nそなたには何の縁もない世界の戦に、\nなにゆえ首を突っ込むのだ。", "face": "l9c5e016ae569"}, {"name": "王子", "text": "…………追っている者がいる。", "face": "u1"}, {"name": "アンウェン", "text": "追っている者……？", "face": "l9c5e016ae569"}, {"name": "王子", "text": "モードリオン、ギルガメッシュ、\n……ガルヴェイン。", "face": "u1"}, {"name": "アンウェン", "text": "なに……？　ではそなた、まさか――むぐっ！？", "face": "l9c5e016ae569"}, {"name": "シャルロット", "text": "服従の呪い……。\nこんなの、もう答えを言っているようなものですわ！", "face": "u2827a1"}, {"name": "アンウェン", "text": "ああもう！　なんと不便な！\n王子よ、王位継承者同士、\n次で正々堂々決着をつけようぞ！", "face": "l9c5e016ae569"}]}]}