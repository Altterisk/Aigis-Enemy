{"quest_id": 8533, "name": "成長するキャスパリーグ", "description": "成長しても王子たちに懐き、\n遊び相手とばかりに大はしゃぎする\nキャスパリーグを落ち着かせよ！\n極級（★１獲得の目安：平均Lv25）", "event": "ぴょんぴょんキャットパニック", "event_category": "History", "mission_id": 920229, "map_no": 9327, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 7400, "attack": 620, "base_hp": 7400, "base_attack": 620, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 260, "attack_speed": 1, "attack_wait": 70, "attack_interval": 213, "move_speed": 1250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2160176, "race_id": 12, "special_effect_id": 1095, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 38707, "global_id": 12324, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "tags": ["猫", "ステルス"], "hp": 23000, "attack": 400, "base_hp": 23000, "base_attack": 400, "damage_type": "true", "armor_defense": 800, "magic_defense": 30, "attack_speed": 45, "attack_wait": 70, "attack_interval": 244, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160160, "race_id": 13, "special_effect_id": 2051, "change_to": 2, "master_id": 38706, "global_id": 12323, "to_global_id": 12322, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["猫"], "hp": 23000, "attack": 400, "base_hp": 23000, "base_attack": 400, "damage_type": "true", "armor_defense": 800, "magic_defense": 30, "attack_speed": 45, "attack_wait": 70, "attack_interval": 244, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160144, "race_id": 13, "special_effect_id": 2050, "change_to": 1, "master_id": 38705, "global_id": 12322}, {"enemy_id": 4, "source": "local", "count": 2, "fo