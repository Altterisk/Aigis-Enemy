00, "transform_resist": 100, "pattern_id": 2160048, "race_id": 13, "master_id": 38698, "global_id": 12315}, {"enemy_id": 8, "source": "local", "count": 34, "form_count": 2, "tags": ["猫"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160048, "race_id": 13, "change_to": 6, "change_condition": 5, "master_id": 38697, "global_id": 12314, "sp_change_to": [38699], "route_behaviour": {"transforms": [{"wait": 300}]}}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["猫", "ステルス"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160064, "race_id": 13, "special_effect_id": 2052, "change_to": 6, "master_id": 38699, "global_id": 12316, "from_condition": "sp_change"}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 2, "hp": 7500, "base_hp": 7500, "damage_type": "magical", "armor_defense": 100, "magic_defense": 5, "attack_speed": 70, "attack_wait": 70, "attack_interval": 261, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2144656, "race_id": 11, "special_effect_id": 1179, "change_to": 9, "change_condition": 5, "master_id": 36234, "global_id": 9851, "to_condition": 5, "to_global_id": 9852, "spawn_sec": 118}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 7500, "attack": 700, "base_hp": 7500, "base_attack": 700, "damage_type": "magical", "armor_defense": 100, "magic_defense": 5, "attack_range": 300, "attack_speed": 70, "attack_wait": 70, "attack_interval": 191, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2144672, "race_id": 11, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 36235, "global_id": 9852, "ranged": true, "from_condition": 5}, {"enemy_id": 11, "source": "local", "count": 32, "form_count": 2, "tags": ["猫"], "hp": 7000, "attack": 500, "base_hp": 7000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160080, "race_id": 13, "change_to": 4, "change_condition": 5, "master_id": 38700, "global_id": 12317, "sp_change_to": [38702], "spawn_sec": 171}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["猫", "ステルス"], "hp": 7000, "attack": 500, "base_hp": 7000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160096, "race_id": 13, "special_effect_id": 2053, "change_to": 4, "master_id": 38702, "global_id": 12319, "from_condition": "sp_change"}], "popups": ["眠っている成体のキャスパリーグは\nブロックされていない間は味方の\n遠距離攻撃の対象になりません。\n\nまた眠っている\n成体のキャスパリーグがいる間は、\n全ての敵のHPが徐々に回復します。", "キャスパリーグがいる間は\n猫属性の敵の攻撃と防御が\nアップします。", "エイクシュニルのHPを減らすと、\n遠距離攻撃をしてきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "キャスパリーグ", "text": "クルル♪　クルルルル……♪", "face": "l0ef8479eba19"}, {"name": "エクス", "text": "追いついてみたはいいですが……。\nキャスパリーグが大きくなっていませんか？", "face": "u2417a1"}, {"name": "ジタリス", "text": "み、皆様……。\nどうやら、この子は成体になったみたいです……。\nその、ちょうど成長期だったようなので……。", "face": "u2416a1"}, {"name": "エクス", "text": "ジタリスさん！　無事だったのですね！", "face": "u2417a1"}, {"name": "ジタリス", "text": "は、はい……じゃれつかれて、\nちょっとふらふらしますけど……。", "face": "u2416a1"}, {"name": "キャスパリーグ", "text": "ニャァーーッ♪", "face": "l0ef8479eba19"}, {"name": "リュティエ", "text": "キャスパリーグは大はしゃぎだね。\nこれはボクたちのことを、完全に遊び相手だと思ってるよ！", "face": "u2418a1"}, {"name": "エクス", "text": "落ち着かせるためには、\n遊び疲れるまで付き合うしかなさそうですね……！", "face": "u2417a1"}, {"name": "リュティエ", "text": "それでジタリスは……。", "face": "u2418a1"}, {"name": "キャスパリーグ", "text": "クルルルゥ♪", "face": "l0ef8479eba19"}, {"name": "ジタリス", "text": "も、もう、そんなに身を寄せなくても、\nどこかに行ったりしませんから……！", "face": "u2416a1"}, {"name": "エクス", "text": "尋常じゃなく懐かれていますね。\nあの調子だと、キャスパリーグから離すのは無理でしょう。", "face": "u2417a1"}, {"name": "リュティエ", "text": "……もふもふもこもこで、ちょっと羨ましいかも。", "face": "u2418a1"}, {"name": "ジタリス", "text": "で、でしたら後で撫でてみてはいかがでしょう……？\nこの子も、皆様のことを気に入ったみたいですのでっ。\n簡単に撫でさせてくれるはずですよっ！", "face": "u2416a1"}, {"name": "リュティエ", "text": "……キャスパリーグ、\n無邪気だしもこもこだし、無理に倒さなくていいかも。", "face": "u2418a1"}, {"name": "アナベラ", "text": "……確かに、そうかもしれないな。\nまぁ、倒すべきだと提言した手前、\n意見を変えるのはよろしくないとは自覚しているが……。", "face": "u1309a1"}, {"name": "アナベラ", "text": "これだけ人に懐ているなら、\n無理に討伐する必要もないのかもしれないな。\nもちろん、注意して面倒を見る必要はあるが。", "face": "u1309a1"}, {"name": "ジタリス", "text": "あ、アナベラさん……！\nありがとうございますっ！", "face": "u2416a1"}, {"name": "エクス", "text": "ですが、どのみち落ち着かせる必要はありますわ！\n遊びたがりなキャスパリーグが来ますよ！", "face": "u2417a1"}, {"name": "キャスパリーグ", "text": "ンニャッ♪　ニャアーーッ♪", "face": "l0ef8479eba19"}]}, {"trigger": "end", "lines": [{"name": "キャスパリーグ", "text": "スゥ、スゥ……。", "face": "l0ef8479eba19"}, {"name": "リュティエ", "text": "キャスパリーグ、遊び疲れたのか寝ちゃったね。", "face": "u2418a1"}, {"name": "ジタリス", "text": "怪我が治るまで安静にさせていましたから。\n完治したとはいえ、体力がついてこなかったのでしょう。", "face": "u2416a1"}, {"name": "ジタリス", "text": "というか、自然にこの子と一緒に戦ってしまいました……！\nみ、皆様っ、大丈夫でしたか……！？", "face": "u2416a1"}, {"name": "エクス", "text": "ふふ、大丈夫ですよ。\n誰も怪我なんてしていませんし。", "face": "u2417a1"}, {"name": "リュティエ", "text": "それに、キャスパリーグも\nジタリスと一緒に遊べて嬉しそうだったよ！\nだから良かったんじゃないかな！", "face": "u2418a1"}, {"name": "ジタリス", "text": "あ、ありがとうございますっ。\nそう言っていただけると、助かります……！", "face": "u2416a1"}, {"name": "リュティエ", "text": "それじゃあ、卵飾り持って会場に戻ろうか！\nエッグパーティの準備をしなきゃだもんね！", "face": "u2418a1"}, {"name": "リュティエ", "text": "それと、お手入れ道具を貸すよ。\nほら、キャスパリーグにじゃれつかれて、\nつやつやの羽が乱れちゃってるし。", "face": "u2418a1"}, {"name": "ジタリス", "text": "あぁ、本当ですね……。\nでは落ち着いたら、手入れをお願いしちゃいましょうか。", "face": "u2416a1"}, {"name": "リュティエ", "text": "えっ、ボクが触っちゃっていいの！？", "face": "u2418a1"}, {"name": "ジタリス", "text": "えっ、はい。\nリュティエさんは上手そうですし、\n私も人に梳いてもらう方が好きですから。", "face": "u2416a1"}, {"name": "リュティエ", "text": "ほ、本当に触っちゃっていいの？\n鳥人さんの羽に触るなんて恐れ多すぎるんだけど！", "face": "u2418a1"}, {"name": "ジタリス", "text": "別に私の羽なんて大したものではありませんよ……？", "face": "u2416a1"}, {"name": "リュティエ", "text": "そんなことないって！\nつやつやでぴかぴかだし、とっても綺麗だし！\nなんていうかこう……すごく尊いよ！", "face": "u2418a1"}, {"name": "ジタリス", "text": "……ここまで褒められると、照れてしまいますね。\nうふふっ、ありがとうございます、リュティエさん。", "face": "u2416a1"}, {"name": "ジタリス", "text": "リュティエさんほど素敵な人なら、\nあの子のブラッシングもお願いしちゃいましょうか。\n撫でてみてはとおすすめしましたしね♪", "face": "u2416a1"}, {"name": "リュティエ", "text": "キャスパリーグも！？\nもふもふに触れるのは嬉しいけど、\n嬉しすぎて感情が爆発しちゃうよー！", "face": "u2418a1"}]}], "active": true}