fense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 18, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109328, "race_id": 6, "special_effect_id": 232, "change_to": 10, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30177, "global_id": 3796, "ranged": true, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 167}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 30000, "attack": 600, "base_hp": 30000, "base_attack": 600, "damage_type": "magical", "armor_defense": 4000, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 120, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113008, "race_id": 6, "missile_id": 171, "missile": {"speed": 6.0, "splash": 267}, "master_id": 30755, "global_id": 4374, "ranged": true, "spawn_sec": 243}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "hp": 8000, "attack": 550, "base_hp": 8000, "base_attack": 550, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105488, "race_id": 6, "special_effect_id": 74, "master_id": 651, "global_id": 650, "spawn_sec": 243}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 1500, "base_hp": 60000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 40, "attack_range": 300, "attack_speed": 200, "attack_wait": 80, "attack_interval": 281, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105504, "race_id": 6, "special_effect_id": 273, "change_to": 14, "change_condition": 1, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 30928, "global_id": 4547, "ranged": true, "variants": [{"hp": 60000, "attack": 2000, "base_hp": 60000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 40, "attack_speed": 50, "attack_wait": 10, "attack_interval": 151, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105552, "race_id": 6, "special_effect_id": 274, "master_id": 30929, "global_id": 4548}], "spawn_sec": 269}, {"enemy_id": 16, "source": "local", "count": 14, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 16, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 321}], "popups": ["　　  【魔界の瘴気(特大)】\n攻撃力と防御力、時間経過による\nコスト回復量が70％低下します。\n王子【神器装備】王子【ケラウノス】\n皇帝を配置すると攻撃と防御の低下に\nついて無効化することができます。\n一部ユニットは能力の低下を無効化し\n攻撃と防御が上昇します。", "上位天使(戦斧)がいる間は\n全ての天使のHPが\n徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シャルキー", "text": "心臓への道はこっちです！\n……って、どうしたんですか、皆さん？", "face": "u596"}, {"name": "アンナ", "text": "……すみません。\nさっきからなぜか、妙に身体が重くて……。", "face": "l61ec8c4d825e"}, {"name": "シャルキー", "text": "あ、そういえば確かデーモン様たちが、\nレヴィアタンの肺には特に濃い瘴気が\n充満しているとおっしゃっていたような……。", "face": "u596"}, {"name": "バルバストラフ", "text": "ヤツが吸った魔界の大気に混じる瘴気が\n此処――肺で濃縮されているというのか？\nだとすると……ん、あれは――天使たちか！", "face": "u63"}, {"name": "大天使長", "text": "……来ましたか。不浄なる人間たちよ。", "face": "lf603150abf45"}, {"name": "アンナ", "text": "貴方は――大天使長！？\nなぜ、このような場所に？", "face": "lab64724fd72f"}, {"name": "大天使長", "text": "レヴィアタンを復活させ、物質界を滅ぼさせること。\nそれが神の御意思だからです……そして、\n神意に逆らう愚か者を粛清することが、我らの使命。", "face": "lf603150abf45"}, {"name": "モーティマ", "text": "ケッ。神意だかなんだか知らねえが、\nレヴィアタンの復活を止めなきゃ明日はねえんだ。\n邪魔すんなら容赦しねえぜ？", "face": "u14"}, {"name": "大天使長", "text": "無駄なあがきはやめなさい。\nレヴィアタンの復活を阻止することなど、\nもはや不可能なのですから。", "face": "lf603150abf45"}, {"name": "大天使長", "text": "レヴィアタンの心臓の中枢に神の力を捧げてから\n既に十分な時間が経過しました。\n間もなく、かの魔神は目覚め、全てを滅ぼすでしょう。", "face": "lf603150abf45"}, {"name": "バシラ", "text": "う……嘘ですよね？\nレヴィアタンがもうすぐ目覚めるなんて……。", "face": "u28"}, {"name": "大天使長", "text": "私が嘘を言うと思いますか？\nこの肺において瘴気の濃度が上昇していることが、\nかの魔神が復活する前兆でなくて何なのです？", "face": "lf603150abf45"}, {"name": "バルバストラフ", "text": "ぬぅ……認めたくはなかったが、\nそう考えぬ道理はあるまい……。", "face": "u63"}, {"name": "ケイティ", "text": "そんな……間に合わなかったというのですか……。", "face": "u114"}, {"name": "大天使長", "text": "そう、それでいいのです。\n諦め――それは神に運命を委ねるということ。\n降伏するなら、束の間の余生を享受させてあげ――。", "face": "lf603150abf45"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "大天使長", "text": "……愚かな。\nこの期に及んで我らに剣を向けるというのですか？", "face": "lf603150abf45"}, {"name": "ソーマ", "text": "お……王子！\n……私も、最後までお傍で戦わせてください！", "face": "u23"}, {"name": "アリサ", "text": "いえ、最後なんかじゃありません！\n神様が諦めろと仰っても、王子が諦めないのなら、\n私は……王子を信じます！", "face": "u24"}, {"name": "大天使長", "text": "無駄な足掻きを……。\nですが、ここで気を抜くべきではありませんね。\n忠勇なる神の下僕たちよ、今こそ彼らを滅ぼすのです！", "face": "lf603150abf45"}]}, {"trigger": "end", "lines": [{"name": "天使", "text": "う、ぐぅッ……！！\nも……申し訳ありません、大天使長様……。", "face": "l44ee8ec78304"}, {"name": "大天使長", "text": "なぜ……時間は十分に稼いだはず。\nそれなのに、なぜレヴィアタンが復活しない……？", "face": "lf603150abf45"}, {"name": "ベルゼビュートの配下", "text": "――ブブッ……感謝するぞ、天使たちよ。\n我らが主、ベルゼビュート様の復活に\n必要な時間を稼いでくれてな……。", "face": "lce4dbb20c921"}, {"name": "大天使長", "text": "お、お前は――魔神ベルゼビュートの眷属！？\n我々が……お前たちの主の為に時間を稼いだだと？", "face": "lf603150abf45"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……お前たちがレヴィアタンに捧げた、\n女神アダマスの肉体に宿る力……その一部を奪い、\nベルゼビュート様は完全復活を遂げられたのだ……。", "face": "lce4dbb20c921"}, {"name": "アンナ", "text": "女神アダマス……？\nレヴィアタンが糧としていたのは\nアダマス様の肉体だったというのですか！？", "face": "lab64724fd72f"}, {"name": "大天使長", "text": "そんな……ベルゼビュートの復活のために\n我らの計画が利用されるとは……。\nおぉ、神よ……お赦し……くだ、さい…………。", "face": "lf603150abf45"}, {"name": "ケイティ", "text": "……天使たちの予想よりも復活が遅くなったのは、\nレヴィアタンが糧としていたアダマス様の力が\nベルゼビュートに横取りされていたためだった、と？", "face": "u114"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……残り僅かとなったアダマスの力を吸って、\nレヴィアタンもじきに復活するだろうがな。\nベルゼビュート様が蘇られた今、我々には関係ない話だ。", "face": "lce4dbb20c921"}, {"name": "アリサ", "text": "あ、アダマス様はご存命なのですね！\nでしたら――。", "face": "u24"}, {"name": "ロイ", "text": "急ぎ救出に向かいましょう！\nレヴィアタンがアダマス様の力を吸い尽くして\n復活を果たすまで、もう幾ばくもありますまい！", "face": "u11"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……せいぜい足掻くがいい。\n貴様らが心臓に辿り着いた暁には、ベルゼビュート様の\n完全復活を祝う生贄となってもらうがな……。", "face": "lce4dbb20c921"}, {"name": "ケイティ", "text": "…………ようやく光明が見えてきましたね。\nレヴィアタンに糧として捧げられたアダマス様の肉体を\n心臓から切り離せば、ヤツの復活を阻止できるはず。", "face": "u114"}, {"name": "ユリアン", "text": "逆に言えば、それができなきゃ物質界は終わりだ。\nま、完全復活したベルゼビュートとその配下どもが\n邪魔してくるのは明白だけどな。", "face": "u7"}, {"name": "バシラ", "text": "でしたら、尚のこと迷っている暇はありません！\nこうしているうちにもレヴィアタンは\nアダマス様の力を奪って蘇ろうとしてるんですから！", "face": "u28"}, {"name": "アンナ", "text": "ええ、急ぎ参りましょう！\n世界の存亡を賭けた決戦の地へ！", "face": "lab64724fd72f"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 26, "params": [30]}, {"kind": "term", "influence": 27, "params": [30]}, {"kind": "term", "influence": 30, "params": [30]}, {"kind": "term", "influence": 31, "params": [130]}, {"kind": "term", "influence": 32, "params": [130]}, {"kind": "term", "influence": 20, "params": [300]}], "enemies": [{"enemy_id": 1, "hp": 25000, "attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 25, "pattern_id": 2105472}, {"enemy_id": 2, "hp": 20000, "attack": 300, "damage_type": "magical", "armor_defense": 500, "magic_defense": 50, "pattern_id": 2110096}, {"enemy_id": 3, "hp": 2500, "attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "pattern_id": 2105520}, {"enemy_id": 5, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2107584}, {"enemy_id": 7, "hp": 30000, "attack": 2800, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 10, "pattern_id": 2107408}, {"enemy_id": 8, "hp": 2500, "attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "pattern_id": 2105536}, {"enemy_id": 8, "form_index": 1, "hp": 2500, "attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "pattern_id": 2105456}, {"enemy_id": 10, "hp": 4000, "attack": 350, "damage_type": "magical", "armor_defense": 500, "pattern_id": 2109328}, {"enemy_id": 12, "hp": 30000, "attack": 600, "damage_type": "magical", "armor_defense": 4000, "magic_defense": 10, "pattern_id": 2113008}, {"enemy_id": 13, "hp": 8000, "attack": 550, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "pattern_id": 2105488}, {"enemy_id": 14, "hp": 60000, "attack": 1500, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 40, "pattern_id": 2105504}, {"enemy_id": 16, "hp": 10000, "attack": 1000, "damage_type": "physical", "armor_defense": 900, "pattern_id": 2107616}]}, "active": true}