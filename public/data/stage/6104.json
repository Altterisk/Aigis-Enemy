te": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 5, "master_id": 988, "global_id": 987, "from_condition": 0}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 14000, "attack": 700, "base_hp": 20000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 40, "attack_speed": 10, "attack_wait": 15, "attack_interval": 96, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 0.8999999761581421, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106304, "race_id": 18, "master_id": 990, "global_id": 989, "spawn_sec": 136}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 840, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30238, "global_id": 3857, "ranged": true, "spawn_sec": 153}], "popups": ["魔神フェネクスがいる間は、\n全ての敵のHPが回復していきます。\n\nまた、魔神フェネクスは体力が\n徐々に減少していきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ケイティ", "text": "戦線を維持して頂きありがとうございます。\n戦況はどうなっていますか？", "face": "u114"}, {"name": "兵士", "text": "だ、ダメです！　我々の攻撃程度では\n普通の魔物でさえ傷が瞬時に再生され\n倒す事ができません！", "face": "l63164b0e7903"}, {"name": "コンラッド", "text": "しょうがねぇな……ちょっとどいてな！　\n俺の捨て身の力で\n回復する間もなくぶっ飛ばしてやる！", "face": "u61"}, {"name": "ケイティ", "text": "なるほど。\n強い一撃を放つ事が出来れば、\n確かに、すぐに敵を倒す事が出来ますね！", "face": "u114"}, {"name": "ケイティ", "text": "王子、攻撃力の高い兵の\nご采配をお願いいたします！", "face": "u114"}]}, {"trigger": "route", "lines": [{"name": "ケイティ", "text": "くっ！　フェネクスの再生の力が\n更に強力に……っ！", "face": "u114"}, {"name": "ファルネ", "text": "ここからが正念場ね。\n……皆、全力で行くわよ！", "face": "u158"}]}], "m