0, "damage_type": "physical", "armor_defense": 150, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "special_effect_id": 232, "change_to": 15, "master_id": 31944, "global_id": 5563, "to_global_id": 5564}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 10000, "attack": 200, "base_hp": 10000, "base_attack": 200, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106976, "race_id": 4, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 31945, "global_id": 5564, "ranged": true}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 86}, {"enemy_id": 18, "source": "local", "count": 21, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 90}, {"enemy_id": 19, "source": "local", "count": 3, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 143}, {"enemy_id": 20, "source": "local", "count": 2, "form_count": 1, "hp": 10000, "attack": 1250, "base_hp": 10000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 650, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099360, "race_id": 4, "master_id": 104, "global_id": 103, "spawn_sec": 183}], "popups": ["大嶽丸は大通連がいる間\nダメージを受けません。\n以下の条件を満たすと弱体化し\nダメージを与える事ができます。\n\n・大通連を倒す\n・大通連が拠点に到達する"], "dialogue": [{"trigger": "start", "lines": [{"name": "たぬきの里の長", "text": "たぬぬぬっ！！\n大通連が……ご先祖様が封印した鬼の剣の封印が！\n解けてしまうぽん……っ！！", "face": "u1019a1"}, {"name": "大嶽丸", "text": "陽炎の如き炎のゆらめき……。\n今にも破裂せんとする妖気……。\n懐かしや、我が宝剣、大通連よ……。", "face": "l5667c09dfe35"}, {"name": "大嶽丸", "text": "……俺のかつての力には遠く及ばないが、\nそれなりに楽しませてはやれるだろう。\nクク……さぁ、誰が俺の相手をしてくれる……？", "face": "l5667c09dfe35"}, {"name": "ケイティ", "text": "――王子、里の周辺が\n鬼の手勢によって包囲されています。", "face": "u114"}, {"name": "マオ", "text": "戦うしか道はない、ということですね……。\nでも元より、ここで退く選択肢はありませんよね？", "face": "u867"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "たぬきの里の長", "text": "ぽんっ！　ボクさまもお手伝いするぽん！", "face": "u1019a1"}, {"name": "マオ", "text": "それじゃあ私達は、\n里を包囲している鬼を蹴散らしましょう。\nついてきてくれますか？", "face": "u867"}, {"name": "たぬきの里の長", "text": "もちろんだぽん！！\n――あっ！！　それから王子さま、\n大嶽丸の大通連には気をつけるぽん！", "face": "u1019a1"}, {"name": "たぬきの里の長", "text": "大通連を伴った大嶽丸は、\n決して傷つかない存在になると伝わっているぽん！", "face": "u1019a1"}, {"name": "マオ", "text": "先にあの剣をどうにかしないと、\n大嶽丸を倒せない……ということでしょうか。", "face": "u867"}, {"name": "大嶽丸", "text": "クク……別れの言葉は交わし終わったか……？", "face": "l5667c09dfe35"}, {"name": "大嶽丸", "text": "ならば、我が大通連の斬撃にて、\n爆裂した末に散るがいい……。\n行くぞ、人間の王子よ……！！", "face": "l5667c09dfe35"}]}, {"trigger": "end", "lines": [{"name": "大嶽丸", "text": "クク……負けた！　大通連をもってしても！\nそれでもなお俺に打ち勝つ猛者か……！！", "face": "l5667c09dfe35"}, {"name": "大嶽丸", "text": "三振りの宝剣を揃え、俺の力を取り戻したその時に、\nどちらが強いか確かめるのが楽しみだ……。\nククッ、ククク……ッ！！", "face": "l5667c09dfe35"}, {"name": "アンナ", "text": "――大嶽丸、鬼の軍勢、撤退していきます。"}, {"name": "マオ", "text": "王子っ！　ご無事ですか！？\n里を包囲していた鬼達も、殆ど撃退できました！", "face": "u867"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ケイティ", "text": "それにしても、宝剣を一本失った状態で、\nあれほどの力を発揮するとは……。\n大嶽丸……なんと恐ろしい存在なのでしょうか……。", "face": "u114"}, {"name": "マオ", "text": "今後も気を抜けませんね……。\n敵は強くなるばかり。\nならば私達も鍛錬を続けないと……。", "face": "u867"}, {"name": "たぬきの里の長", "text": "ぽぽんっ！\nボクさま達も協力させてほしいぽん！\nお世話になった恩返しをしなきゃだぽん！", "face": "u1019a1"}, {"name": "妖狸", "text": "ぽぽんっ！\nボク達もお手伝いするぽん！", "face": "lb11a98406858"}, {"name": "マオ", "text": "ありがとうございます。\n――でもまずは、里の復興から頑張りましょう！\n私もお手伝いしますよ！", "face": "u867"}, {"name": "たぬきの里の長", "text": "ぽぽーん♪\nマオさまありがとうぽん～♪", "face": "u1019a1"}, {"name": "アンナ", "text": "――我々も、復興のお手伝いをしましょうか。\n王子、此度の討伐、お疲れさまでした！"}]}], "active": true}