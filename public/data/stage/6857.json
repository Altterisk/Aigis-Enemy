{"quest_id": 6857, "name": "二振り目の宝剣", "description": "『宝剣・大通連』を携えし大嶽丸が\n立ちふさがる。宝剣に護られし鬼神を\n退け、鬼の支配より村を救いだせ！\n神級（★１獲得の目安：平均Lv50）", "event": "あやかし狸と浴衣の拳士", "event_category": "History", "mission_id": 920132, "map_no": 5512, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 30000, "attack": 2500, "base_hp": 30000, "base_attack": 2500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 96, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117296, "race_id": 4, "special_effect_id": 230, "change_to": 1, "change_condition": 2, "master_id": 31494, "global_id": 5113, "to_condition": 2, "to_global_id": 5112}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 96, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117280, "race_id": 4, "master_id": 31493, "global_id": 5112, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 50000, "attack": 800, "base_hp": 50000, "base_attack": 800, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 30, "attack_range": 200, "attack_speed": 100, "attack_wait": 60, "attack_interval": 186, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119808, "special_effect_id": 231, "missile_id": 378, "missile": {"speed": 10.0, "splash": 160}, "master_id": 31946, "global_id": 5565, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "ph