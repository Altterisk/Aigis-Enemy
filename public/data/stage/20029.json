5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113120, "race_id": 16, "master_id": 41125}], "spawn_sec": 221}, {"enemy_id": 12, "source": "local", "count": 18, "form_count": 1, "tags": ["帝国"], "hp": 45000, "attack": 500, "base_hp": 45000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133056, "race_id": 16, "change_to": 12, "change_condition": 1, "missile_id": 26, "master_id": 41127, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 45000, "attack": 1200, "base_hp": 45000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133264, "race_id": 16, "master_id": 41128}], "spawn_sec": 232}, {"enemy_id": 14, "source": "local", "count": 8, "form_count": 2, "tags": ["帝国"], "hp": 36000, "attack": 1850, "base_hp": 36000, "base_attack": 1850, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 75, "attack_interval": 226, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2164544, "race_id": 16, "change_to": 14, "change_condition": 3, "master_id": 41130, "to_condition": 3, "spawn_sec": 241}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["帝国"], "hp": 36000, "attack": 1050, "base_hp": 36000, "base_attack": 1050, "damage_type": "true", "armor_defense": 1500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 85, "attack_interval": 246, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2164560, "race_id": 16, "master_id": 41131, "from_condition": 3}, {"enemy_id": 16, "source": "local", "count": 15, "form_count": 1, "tags": ["機械", "帝国"], "hp": 55000, "attack": 560, "base_hp": 55000, "base_attack": 560, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 185, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2132992, "race_id": 16, "special_effect_id": 957, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 41126, "ranged": true, "spawn_sec": 336}], "popups": ["\n\n\n\n――魔神セーレ討伐、出陣前のこと", "魔想志津香は、\n一定範囲内の\nユニットの魔法耐性を\n20％ダウンさせます。\n\n\n\n　　　　　　(1/2)", "魔想志津香は\n拠点には向かわず\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。\n　　　　　　(2/2)", "帝国戦槌兵は\n体力が50％以下になると\n攻撃性能が変化します。", "オーラをまとった魔想志津香は\n味方ユニットから受ける\n魔法ダメージを40％軽減します"], "dialogue": [{"trigger": "battle", "at_sec": 52, "lines": [{"text": "――魔神セーレ討伐、出陣前のこと"}, {"name": "志津香", "text": "……ふぅん。あなた、すごい魔力ね。", "face": "u1759a1"}, {"name": "アウローラ", "text": "何か御用ですか、異世界の魔法使い殿。", "face": "u711"}, {"name": "志津香", "text": "志津香でいいわ。\n白の帝国の帝国治癒士長さんだっけ？", "face": "u1759a1"}, {"name": "アウローラ", "text": "肩書も長いですし、アウローラと呼んでください。", "face": "u711"}, {"name": "志津香", "text": "じゃあアウローラ、その魔力、\n治癒にしか使ってないの？　もったいない。", "face": "u1759a1"}, {"name": "アウローラ", "text": "私は治癒士です。\n攻撃魔法を使う必要はありません。", "face": "u711"}, {"name": "志津香", "text": "必要はあるわよ。相手は魔神。\n回復役が狙われたら、誰が治すの？\nそれに今後、必要になる場面だって出てくるでしょ？", "face": "u1759a1"}, {"name": "アウローラ", "text": "…………。", "face": "u711"}, {"name": "志津香", "text": "決戦の間だけでいいわ。\n魔力の出し方だけ教えてあげる。", "face": "u1759a1"}, {"name": "アウローラ", "text": "教わる、と決めたわけではありません。\nですが、話は聞きましょう。", "face": "u711"}, {"name": "志津香", "text": "素直じゃないわね。……ま、いいけど。", "face": "u1759a1"}, {"name": "志津香", "text": "それと、はい、これ。\n着替えてきなさい。", "face": "u1759a1"}, {"name": "アウローラ", "text": "……はい？　これは貴女の衣装、ですか？", "face": "u711"}, {"name": "志津香", "text": "私の予備よ。汚したくないでしょ、その白い服。\nそれに、魔法使いを教わるなら形から入るものよ。", "face": "u1759a1"}, {"name": "アウローラ", "text": "……理屈になっていませんが。", "face": "u711"}, {"name": "志津香", "text": "なってるわよ。教えるって決めた相手に、\n半端な格好でいてほしくないだけ。ほら、早く。", "face": "u1759a1"}, {"name": "アウローラ", "text": "…………分かりました。少々お待ちを。", "face": "u711"}]}, {"trigger": "battle", "at_sec": 53, "lines": [{"name": "グリム", "text": "わー、志津香さんが誰かに魔法を教えてる。\n珍しいですねー。", "face": "u942"}, {"name": "アンナ", "text": "帝国から派遣されている方々も、\n今回の決戦には参加してくださるそうです。"}, {"name": "アンナ", "text": "せっかくですし、模擬戦で連携を確認しましょう。", "face": "lab0e64136ede"}, {"name": "志津香", "text": "あら、ちょうどいいわ。\n現地弟子のデビュー戦ね。", "face": "u1759a1"}]}, {"trigger": "battle", "at_sec": 54, "lines": [{"name": "アウローラ", "text": "――お待たせしました。", "face": "u2899a1"}, {"name": "グリム", "text": "おー、志津香さんがふたりになりました。", "face": "u942"}, {"name": "アウローラ", "text": "……もしかして似合ってませんか？", "face": "u2899a1"}, {"name": "志津香", "text": "うぅん、似合ってる。\nそれじゃアウローラ、さっそく実践よ。", "face": "u1759a1"}, {"name": "アウローラ", "text": "……は？", "face": "u2899a1"}, {"name": "志津香", "text": "私が敵役をやるわ。\n教えてあげるから、練習代わりに撃ってみなさい。", "face": "u1759a1"}, {"name": "アウローラ", "text": "……いいでしょう。\n手加減はしませんよ。", "face": "u2899a1"}, {"name": "志津香", "text": "誰に言ってるのよ。", "face": "u1759a1"}, {"name": "アウローラ", "text": "ふふっ。", "face": "u2899a1"}]}, {"trigger": "enemy_death", "enemy_id": 6, "lines": [{"name": "志津香", "text": "……やるじゃない。まさか私を退けるなんて。\nなら、こっちも本気よ。", "face": "u1759a1"}, {"name": "志津香", "text": "私の全力、見せてあげる。", "face": "u1759a1"}, {"name": "アウローラ", "text": "いいでしょう、受けて立ちます。", "face": "u2899a1"}]}, {"trigger": "end", "lines": [{"name": "志津香", "text": "……ふぅ。はい、そこまで。", "face": "u1759a1"}, {"name": "アウローラ", "text": "はぁ……はぁ……。\n……どうでしたか？", "face": "u2899a1"}, {"name": "志津香", "text": "上出来。というか、あなた、\n本当は元から使えたでしょ。攻撃魔法。", "face": "u1759a1"}, {"name": "アウローラ", "text": "そんなことはありませんが。", "face": "u2899a1"}, {"name": "志津香", "text": "魔力の使い方に慣れすぎなのよ。\n今まで隠してたわね？", "face": "u1759a1"}, {"name": "アウローラ", "text": "隠していたのではなく、\n使う機会がなかっただけです。", "face": "u2899a1"}, {"name": "志津香", "text": "それを隠してたって言うの。", "face": "u1759a1"}, {"name": "アウローラ", "text": "教え方が厳しいのは、\n貴女の元の世界の流儀ですか？", "face": "u2899a1"}, {"name": "志津香", "text": "私が厳しいのは相手を見込んでる時だけよ。\n……あ、今のは聞かなかったことにして。", "face": "u1759a1"}, {"name": "アウローラ", "text": "ふふっ。\nでは、そういうことにしておきます。", "face": "u2899a1"}, {"name": "グリム", "text": "なんか、似た者同士って感じですねー。", "face": "u942"}, {"name": "アンナ", "text": "良い連携が組めそうで何よりです。\nそれでは皆さん。決戦の準備を！"}]}, {"trigger": "route", "lines": [{"name": "志津香", "text": "……ふぅん。悪くないじゃない。\nそれじゃ、こっちも本気を出そうかしら。", "face": "u1759a1"}, {"name": "志津香", "text": "私の全力、見せてあげる。", "face": "u1759a1"}, {"name": "アウローラ", "text": "いいでしょう、受けて立ちます。", "face": "u2899a1"}]}], "active": true}