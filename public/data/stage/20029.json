{"quest_id": 20029, "name": "四魔女の弟子アウローラ", "description": "ある日、アウローラは魔想志津香から\n攻撃魔法の手解きを受ける事になって……？\n＜敵の魔法耐性が上昇＞\n神級（★１獲得の目安：平均CCLv50）", "modifier_notes": ["敵の魔法耐性が上昇"], "event": "ランス1000　鬼畜戦士の降臨", "event_category": "Emergency", "mission_id": 200582, "map_no": 7495, "level": 100, "multiplier": 1.0, "charisma": 70, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 423000, "attack": 2620, "base_hp": 423000, "base_attack": 2620, "damage_type": "magical", "armor_defense": 650, "magic_defense": 10, "attack_range": 280, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2172752, "race_id": 16, "special_effect_id": 2511, "change_to": 1, "change_condition": 6, "missile_id": 1700, "missile": {"speed": 15.0, "splash": 80}, "master_id": 41117, "ranged": true, "to_condition": 6, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "route_behaviour": {"reroutes": ["Route=102"]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 423000, "attack": 3020, "base_hp": 423000, "base_attack": 3020, "damage_type": "magical", "armor_defense": 650, "magic_defense": 10, "attack_range": 320, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2172896, "race_id": 16, "special_effect_id": 2512, "missile_id": 1699, "missile": {"speed": 13.0, "splash": 133}, "master_id": 41118, "ranged": true, "from_condition": 6}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["帝国"], "hp": 30000, "attack": 550, "base_hp": 30000, "base_attack": 550, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "tr