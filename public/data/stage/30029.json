se": 500, "attack_speed": 60, "attack_wait": 10, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097728, "master_id": 23763, "spawn_sec": 763}, {"enemy_id": 43, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 75000, "attack": 3600, "base_hp": 25000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 23711, "spawn_sec": 784}], "popups": ["ゴースト騎士が\n特定の地点に到達すると\n拠点に向かって強力な遠距離貫通\n攻撃を行います。\n\n\n\n　　　　　　(1/3)", "ゴースト騎士が行う\n遠距離貫通攻撃は味方ユニットが\n一度受けると消滅します。\n\nまた、遠距離貫通攻撃を受けた\n味方ユニットは3秒間、\n攻撃力と防御力が減少します。\n　　　　　　(2/3)", "ゴースト騎士は\n撃破数に含まれません。\n\nまた、撃破するとその時点で\nミッションクリアになります。\n※討伐数は最大数で\n　カウントされます。\n　　　　　　(3/3)", "ゴースト村少年は\n撃破数に含まれません。\n\nゴースト村少年がいる間は、\n全てのアンデッドの攻撃と防御が\nアップします。", "ゴースト村娘は\n撃破数に含まれません。\n\nゴースト村娘がいる間\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ソーマ", "text": "……王子、村があります。\nでも、地図ではこの辺りには何もないはずでは……。", "face": "u2178a1"}, {"name": "ケイティ", "text": "道を間違えたのでしょうか？\n今の地図と、周囲の地形は合っているのですが。", "face": "u2433a1"}, {"name": "アルティア", "text": "少々お待ちを。\n……ああ、こちらの地図には載っていますね。", "face": "u2891a1"}, {"name": "リカルド", "text": "おっと……やけに古い地図だな。\nいったいいつの時代のものなんだ？", "face": "u205"}, {"name": "アルティア", "text": "倉庫で見つけた、千年戦争の頃の地図の写しです。\nこの写し自体もかなり古いものですけどね。", "face": "u2891a1"}, {"name": "アンナ", "text": "ということは、千年も前の村が、今も……？\n廃村というには、家々がきれいすぎるような。"}, {"name": "ソーマ", "text": "はい。でも……静かすぎませんか？\n家はこんなにあるのに、\n話し声も、誰かが働く音も聞こえません。", "face": "u2178a1"}, {"name": "アルティア", "text": "……誰も暮らしていないのでしょうか。\n王子、慎重に調べた方がよさそうです。", "face": "u2891a1"}]}, {"trigger": "start", "lines": [{"name": "ソーマ", "text": "あっ、あそこに人が！\n――って、大変です！　ゴブリンに囲まれています！", "face": "u2178a1"}, {"name": "リカルド", "text": "助けに……いや、これは、幻か……？", "face": "u205"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "ソーマ", "text": "……そんな。\n村の人たちが、みんな魔物に……。", "face": "u2178a1"}, {"name": "アルティア", "text": "あの騎士が駆けつけたときには、\nもう手遅れだった、ということですか……。", "face": "u2891a1"}, {"name": "アンナ", "text": "あの騎士の身体も、透けています。\n先ほど襲われた人たちも、\n皆、亡霊だったのですね……。"}, {"name": "アリシア", "text": "……同じ騎士なら、言葉を交わせるかもしれません。\n意思の残滓があれば、ですが。", "face": "u2558a1"}, {"name": "アリシア", "text": "問おう！　貴殿は何者か！\nこちらは王国軍です！　返答は如何に！", "face": "u2558a1"}, {"name": "アリサ", "text": "……だめ、みたいです。\n言葉が通じていません。", "face": "u24"}, {"name": "アルティア", "text": "王子、戦うほかありません。\nこの騎士を、ここで止めましょう。", "face": "u2891a1"}, {"name": "シャルロット", "text": "おそらく、あの騎士がこの幻を生み出した元凶ですわ。\n彼を止めればこの事件も終息するはず……。", "face": "u2827a1"}, {"name": "アンナ", "text": "王子、彼の妄執を、ここで終わらせてあげましょう。"}]}, {"trigger": "end", "lines": [{"name": "シンディ", "text": "……騎士の姿が、消えていきます。", "face": "u1098a1"}, {"name": "アルティア", "text": "……あっ……思い出しました。\nあの地図と一緒に見つけた書物に、\n滅びた村を守っていた騎士の記録があったんです。", "face": "u2891a1"}, {"name": "ソーマ", "text": "村を守っていた……。\nでは、あの騎士が……？", "face": "u2178a1"}, {"name": "アルティア", "text": "千年戦争の頃、この地に偶然、魔界への門が開いた。\nそこからあふれた魔物に襲われ、\n村は一人の生存者もなく滅ぼされたそうです。", "face": "u2891a1"}, {"name": "アルティア", "text": "村を守っていた名高い騎士は、\n魔王軍との戦いで村を離れていたそうです。\n異変を知って駆け戻った時には、もう……。", "face": "u2891a1"}, {"name": "ソーマ", "text": "……さっき私たちが見たのは、\nその時の出来事だったんですね。", "face": "u2178a1"}, {"name": "アルティア", "text": "村人たちを失った騎士は、悲嘆のあまり、\n自ら命を絶った……と、記されていました。", "face": "u2891a1"}, {"name": "アンナ", "text": "それで、守れなかった村で、\nあの日を繰り返していたのでしょうか……。"}, {"name": "ソーマ", "text": "あの方も、きっと誰かを守りたくて、\n剣を取ったんですよね。", "face": "u2178a1"}, {"name": "ミレイユ", "text": "王子、散り際の彼の目を見ましたか？", "face": "u2626a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ミレイユ", "text": "きっと、彼なりに整理がついたのでしょう。\nもしかしたら、王子が英雄王の末裔だと、\nあの短い戦いの中で気付いたのかもしれません。", "face": "u2626a1"}, {"name": "アンナ", "text": "…………。"}, {"name": "アンナ", "text": "王子、村が少しずつ、消えていきます。"}, {"name": "ソーマ", "text": "あっ、向こうに倒れてる人が。\nもしかして、行方不明になっていた方でしょうか？", "face": "u2178a1"}, {"name": "アリサ", "text": "…………！\nまだ息があります！\n他の方も急いで捜索しましょう！", "face": "u24"}, {"name": "アリシア", "text": "……どういうことだと思いますか？", "face": "u2558a1"}, {"name": "ミレイユ", "text": "彼も人々を殺したかったわけではないのでしょう。\n守るべき村に、外部からやってきた者がいたから、\n仕方なく閉じ込めていた、とか。", "face": "u2626a1"}, {"name": "アルティア", "text": "急ぎ捜索部隊の編成を！\n手分けをして、辺り一帯を探りましょう。", "face": "u2891a1"}, {"name": "アルティア", "text": "それから……全部終わって、\n城へ戻ったら、あの書物を読み直そうと思います。\n村を失った日のことだけではなくて。", "face": "u2891a1"}, {"name": "アルティア", "text": "あの騎士が、どんなふうに人々を守っていたのか。\nそれも、残っているかもしれませんから。", "face": "u2891a1"}]}], "active": true}