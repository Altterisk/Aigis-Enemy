{"quest_id": 6207, "name": "付与魔術師と妖魔の女王（記憶）", "description": "付与魔術師メレディスの魔導書がゴブリン軍\nに奪われた。魔法が付与された妖魔の軍勢と\nクイーン搭乗の騎獣戦車を撃退せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "戦場の記憶～追憶の章～", "event_category": "History", "mission_id": 920094, "map_no": 5242, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "missile_id": 187, "missile": {"speed": 3.0}, "master_id": 910, "global_id": 909, "ranged": true, "spawn_sec": 19}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 50000, "attack": 600, "base_hp": 50000, "base_attack": 600, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 110, "attack_interval": 273, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2107824, "race_id": 9, "change_to": 2, "change_condition": 1, "missile_id": 6, "master_id": 30496, "global_id": 4115, "ranged": true, "variants": [{"hp": 50000, "attack": 3500, "base_hp": 50000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 30, "attack_speed": 215, "attack_wait": 50, "attack_interval": 401, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2107808, "race_id": 9, "master_id": 30497, "global_id": 4116}], "spawn_sec": 21}, {"enemy_id": 4, "source": "local", "count": 16, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "magical", "attack_speed": 40, "attack_wai