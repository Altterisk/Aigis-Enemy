ssassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30436, "global_id": 4055, "from_condition": 2}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 918, "global_id": 917, "ranged": true, "spawn_sec": 120}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "magical", "armor_defense": 120, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097312, "race_id": 9, "master_id": 915, "global_id": 914, "spawn_sec": 151}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 430, "base_hp": 6500, "base_attack": 430, "damage_type": "magical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "master_id": 916, "global_id": 915, "spawn_sec": 151}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 912, "global_id": 911, "spawn_sec": 160}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 913, "global_id": 912, "spawn_sec": 161}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "magical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 919, "global_id": 918, "ranged": true, "spawn_sec": 174}], "popups": ["武器に魔法が付与された\nゴブリンたちの攻撃は、\n防御を無視します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン（サヨ）", "text": "――ギャギャ！　……と、こんなものかしら。\nゴブリンたちは細かい事を気にしないから、\n変装も紛れ込むのも楽で良いわ。", "face": "le2c5c8732e67"}, {"name": "ゴブリン（サヨ）", "text": "魔法都市の付与魔術師、メレディスさんの\n魔導書をゴブリンクイーンが強奪したのよね。", "face": "le2c5c8732e67"}, {"name": "ゴブリン（サヨ）", "text": "王子の戦いを見届けるのとは別に、\n盗られた物を取り返すのは義賊としての使命だわ。\n魔導書を取り戻すため、まずクイーンを探さないと。", "face": "le2c5c8732e67"}, {"name": "ゴブリン博士", "text": "うム、なんとか予算の範囲内に収まったナ。\n今回はクイーン様の唐突な提案もなク、\nなんとか予算に余裕も出来そうダ。", "face": "l420cf1f31ccb"}, {"name": "ゴブリン博士", "text": "流石ワタクシ。早速、クイーン様に報告ヲ……。\nン？　そこのゴブリン兵士。\nお前……何か大きくナイカ？", "face": "l420cf1f31ccb"}, {"name": "ゴブリン（サヨ）", "text": "ギクッ！\n……ギャギャ！\nニンゲンタベタ！", "face": "le2c5c8732e67"}, {"name": "ゴブリン博士", "text": "……ふム、人間を食べテ大きくなるとは、\nゴブリンの鑑だナ。この戦いの後、\nリーダーに昇格させてやろウ。", "face": "l420cf1f31ccb"}, {"name": "ゴブリン（サヨ）", "text": "ギャギャ！　ショウカク！　ショウカク！\n（鋭い観察眼だわ……。さすがゴブリン博士。\n彼をごまかし続けるのは無理そうね……）", "face": "le2c5c8732e67"}, {"name": "ゴブリンクイーン", "text": "あら、博士。王子軍を殺す支度はできたのかしらぁ？", "face": "l7bab13fc887b"}, {"name": "ゴブリン博士", "text": "ハッ、ゴブリンクイーン様。\n騎獣戦車の準備が出来ましタ。ゴブリンたちにハ、\n魔法が付与された武器を持たせておりまス。", "face": "l420cf1f31ccb"}, {"name": "ゴブリンクイーン", "text": "いいタイミングじゃない。ほら、そこのゴブリンも、\n何をコソコソとワタシの魔導書に近づいているの？\n早く出撃なさい。……でないと、処刑するわよぉ？", "face": "l7bab13fc887b"}, {"name": "ゴブリン（サヨ）", "text": "ギャ、ギャギャ！\n（……悔しいけど、ここは一旦言う事を聞くフリをして、\nまたチャンスを狙うしかないわね）", "face": "le2c5c8732e67"}, {"name": "ゴブリンクイーン", "text": "さぁ、出撃よぉ。", "face": "l7bab13fc887b"}, {"name": "メレディス", "text": "――な、なんですか、あのクイーンの乗り物は！？", "face": "u1400"}, {"name": "ゴブリン博士", "text": "ふふふ。アレこそ騎獣戦車のパワーに\nクイーン様の遠距離魔法が備わった\n最強の騎獣戦車ダ！", "face": "l420cf1f31ccb"}, {"name": "メレディス", "text": "強そうな相手ですけど……、\n絶対、私の研究成果である魔導書を\nゴブリンクイーンから取り戻すんだから！", "face": "u1400"}]}, {"trigger": "end", "lines": [{"name": "メレディス", "text": "王子、やりました！\n魔導書を取り戻しましたよ！", "face": "u1400"}, {"name": "ゴブリン", "text": "クイーンサマ！\nマホウガキエタ！　マホウガキエタ！", "face": "le2c5c8732e67"}, {"name": "ゴブリンクイーン", "text": "あんな面倒な術は魔導書を見なければ使えないわ。\nゴブリン軍の強化の為に、また新たな手を考えなくちゃ。", "face": "l7bab13fc887b"}, {"name": "ゴブリン博士", "text": "ご心配には及びませン。あの様な魔術などなくとも、\nゴブリンクイーン様には私の頭脳がありまス。\n貴方様はただ私に命じて下さるダケでいいのでス。", "face": "l420cf1f31ccb"}, {"name": "ゴブリンクイーン", "text": "頼もしいわねぇ♪　それじゃあすぐに新たな\n武器を造りなさい。それもとびきり凶悪なヤツをね。", "face": "l7bab13fc887b"}, {"name": "ゴブリン博士", "text": "ハッ！　……あの、クイーン様。\n新たな武器を作るにあたってなのですガ、\nもう少し予算を上げて頂く事等ハ……。", "face": "l420cf1f31ccb"}, {"name": "ゴブリンクイーン", "text": "追加予算？　そうねぇ。\nじゃあ、魔法都市に来る途中の沼地で手に入れた\nこの黄金の鎧を一つあげるわぁ。", "face": "l7bab13fc887b"}, {"name": "ゴブリン博士", "text": "ハッ……。あノ、これだけでございますカ？", "face": "l420cf1f31ccb"}, {"name": "ゴブリンクイーン", "text": "ウフフ。予算を抑えるのも貴方の使命よ。\n次に作るのはとびきり凶悪な武器、でお願いね？\nさぁゴブリン達、帰るわよ。", "face": "l7bab13fc887b"}, {"name": "ゴブリン博士", "text": "……ガンバリマス。", "face": "l420cf1f31ccb"}, {"name": "サヨ", "text": "――結局、わたしが魔導書を盗み出すより、\n王子たちがクイーンを倒して取り返したのよね。\nわたしは力になれなかったけど、結果的に良かったわ。", "face": "u510"}, {"name": "サヨ", "text": "この時、わたしなんかが力を貸そうとしなくても、\n王子は大丈夫なんだな、\nって思ったら、少し寂しい気持ちになっちゃった。", "face": "u510"}, {"name": "サヨ", "text": "この頃から、王子は悪い人じゃない、一緒に\n魔物を倒さないといけないんだって感じてたけど……。", "face": "u510"}, {"name": "サヨ", "text": "わたしに出来る事と言えば変装くらい。\nそんなわたしが、今更、姿を現して協力するとは\n言い出せなかった。", "face": "u510"}, {"name": "サヨ", "text": "だから、陰から王子を支えようと思って、\n王子たちを追いかけるようになって……そんな頃、\n鬼の大将、酒呑童子と再戦したのよね。", "face": "u510"}]}], "active": true}