.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 47, "global_id": 46, "spawn_sec": 60}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 250, "base_hp": 6000, "base_attack": 250, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 20, "attack_interval": 77, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100400, "race_id": 16, "special_effect_id": 224, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 20178, "global_id": 1253, "ranged": true, "spawn_sec": 87}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "もう戦うのはやめてください！\nこれ以上私たちが争う意味はないはずです！", "face": "lc2f00ec74cd9"}, {"name": "ホルエス", "text": "戦いをやめる訳にはいきません！\n祖国で私の帰りを待つ民のためにも！", "face": "u149"}, {"name": "ホルエス", "text": "今回の戦いは私も出陣します。", "face": "u149"}, {"name": "ホルエス", "text": "絶対に負けるわけにはいきません。\n王子の命を頂きます！　覚悟……！", "face": "u149"}, {"name": "アンナ", "text": "帰りを待つ民のため……？\nやはり、訳ありのようですね。"}, {"name": "アンナ", "text": "この戦いに勝ち、お話を聞き出しましょう！", "face": "lc2f00ec74cd9"}]}, {"trigger": "end", "lines": [{"name": "ホルエス", "text": "負けてしまったというのですか……。", "face": "u149"}, {"name": "アンナ", "text": "魔法剣士さん……。", "face": "lc2f00ec74cd9"}, {"name": "アンナ", "text": "あなたの国は魔物たちに滅ぼされたと\n聞いています。\nなぜその国の方が王子を？", "face": "lc2f00ec74cd9"}, {"name": "ホルエス", "text": "今は無き砂漠の王国。\n私はその王族の一人なのです。", "face": "u149"}, {"name": "ホルエス", "text": "位が高い王族はすべて魔物に殺され、\n私は唯一生き残った存在です。", "face": "u149"}, {"name": "ホルエス", "text": "王国を占領した魔物に、\n『王子を倒す事ができれば王国を返す』と\n言われ、海を渡ってやってきました。", "face": "u149"}, {"name": "アンナ", "text": "魔物がそんな約束を守るとは……。", "face": "lc2f00ec74cd9"}, {"name": "ホルエス", "text": "分かっています……！\nしかし、王国の民が人質にとられている以上、\n従う事しかできないのです……。", "face": "u149"}, {"name": "ホルエス", "text": "……今回は退きます。\nしかし、次は強力な援軍が来るはずです。", "face": "u149"}, {"name": "ホルエス", "text": "次の戦いの時こそは……。\n王子の命を必ずやもらいうけます。", "face": "u149"}, {"name": "アンナ", "text": "……行ってしまいましたね。"}, {"name": "アンナ", "text": "王子、砂漠の国の方たちをなんとか\n救う方法はないのでしょうか……？"}, {"name": "アンナ", "text": "滅ぼされた国の人間同士が戦うなんて、\nあまりにも悲しいです……。", "face": "lb155c96cc247"}]}], "active": true}