t": 19, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 7}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 31}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 48}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 106}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 4, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 111}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "風神", "text": "ゲハハハハハ！\nそうだ！　もっと人間を恐怖させろ！\n殺してしまっても構わんぞぉッ！", "face": "l9284c6289f1c"}, {"name": "風神", "text": "――ん？\n何じゃおぬしは？\nどこかで見たことのあるような……？", "face": "l9284c6289f1c"}, {"name": "シノ", "text": "……やはり風神様でしたか。\nお久しぶりですね。覚えていませんか？\n私です。ぬらりひょんの娘の、シノです。", "face": "u403"}, {"name": "風神", "text": "シノ……？　おっ、おぉう！？　シノかぁ！\nずいぶんと久しぶりじゃのう！　\nまぁ、なんだ……父上の事は、残念だったのう……。", "face": "l9284c6289f1c"}, {"name": "シノ", "text": "今は悲しみに暮れている暇などありません。\nなぜなら私は、妖怪の未来の為、\n妖怪の総大将になろうと決心したのですから。", "face": "u403"}, {"name": "風神", "text": "ほう……おぬしが妖怪の総大将に、か……。\nしかし、連れておるのは人間ばかりの様に見えるが……。", "face": "l9284c6289f1c"}, {"name": "シノ", "text": "私はまだ妖怪総大将の器ではありませんが、\n人間と話をする事は出来ます。\n目的のために手段は問うつもりはございません。", "face": "u403"}, {"name": "風神", "text": "ゲハハハハハハ！　それは結構！\n読めたぞ、わしに「血判状」を書かせる気だな？\nさすが、ぬらりひょんの娘じゃ、血は争えんな。", "face": "l9284c6289f1c"}, {"name": "風神", "text": "貴様の覚悟がどれほどのものか、\n今ここで見せてもらおうぞ！", "face": "l9284c6289f1c"}]}, {"trigger": "end", "lines": [{"name": "風神", "text": "……ゲハァッ！！\nシノよ、認めてやろう。\n「血判状」を受け取れ。", "face": "l9284c6289f1c"}, {"name": "風神", "text": "ほら、おめえらも「血判状」を書いてシノに渡せ。", "face": "l9284c6289f1c"}, {"name": "シノ", "text": "風神様……。\nかまいたちまで……！？\nありがとうございます。", "face": "u403"}, {"name": "風神", "text": "ゲハハハハハ！　今日は気分が良い！\nわしは酒でも飲みに行くかのう！\nシノ！　父上を悲しませぬよう、励めよ。", "face": "l9284c6289f1c"}, {"name": "シノ", "text": "はい。\n風神様も、どうかお達者で。", "face": "u403"}, {"name": "アンナ", "text": "シノさん、これで「血判状」が沢山集まりましたね。"}, {"name": "シノ", "text": "はい。名高き物の怪の風神様の「血判状」が\n揃ったことで、妖怪総大将への座に\nまた一歩近づくことができました。", "face": "u403"}, {"name": "シノ", "text": "ですが、まだ気を抜くことはできません。\n王子、しばしの休息の後、\n次の地へと向かうこととしましょう。", "face": "u403"}]}], "story_talk": true, "active": true}