, "to_condition": 0, "to_global_id": 8702, "route_behaviour": {"hold": {"routes": 1, "held": 1}, "transforms": [{"wait": -1}], "calls_event": [2844, 2845, 2846, 2847, 2848], "creates_obj": 1, "creates_guest": 1}, "spawn_sec": 316}, {"enemy_id": 33, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 550000, "attack": 5500, "base_hp": 550000, "base_attack": 5500, "damage_type": "magical", "armor_defense": 1700, "magic_defense": 55, "attack_range": 1200, "attack_wait": 54, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2138512, "race_id": 19, "special_effect_id": 1039, "change_to": 32, "missile_id": 736, "missile": {"speed": 7.0}, "master_id": 35085, "global_id": 8702, "ranged": true, "from_condition": 0}, {"enemy_id": 35, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["帝国", "置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 300000, "attack": 1500, "base_hp": 300000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 97, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2138528, "race_id": 16, "master_id": 35089, "global_id": 8706, "spawn_sec": 326}], "popups": ["オークロードは\nHPが50％以下になると\n攻撃速度が上昇し、\n遠距離攻撃を行うようになります。", "黒炎のセグナンドとオークロードは\n自身が通過したマスを占領します。\n\nまた黒炎のセグナンドは、\n特定の地点に到達すると\n攻撃と同時に周囲のマスを\n一気に占領します。\n　　　　　　(1/3)", "占領されたマスに配置していた\nユニットは、撤退をしますが\n再出撃が可能です。\n\n\n\n\n　　　　　　(2/3)", "敵に占領されているマスは、\n占領している敵を倒すことで、\n使用可能になります。\nマスを占領している敵には、\n旗のマークがついています。\n\n\n　　　　　　(3/3)"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "……はぁ、はぁ。\n補給が追いついてないなぁ……。\n他に支援が欲しい前線は！？", "face": "u1555a1"}, {"name": "トゥーダ", "text": "支援が欲しいのは全部の前線かなぁ。\nロミルダ、ちょっと休んでいってください！\n魔力が尽きたら戦えないですよ！", "face": "u1554a1"}, {"name": "グラティア", "text": "……でも、これまずい状況だろ？\n即応できてるのは良いとしてもだ、\n防衛線に隙間ができ始めてる。", "face": "u1551a1"}, {"name": "白の皇帝", "text": "……ほう。\n鍛冶職人をやめて、軍師になるか？", "face": "u418"}, {"name": "グラティア", "text": "へ、陛下ぁっ！？\nいや、アタシはそんな器じゃないから……。", "face": "u1551a1"}, {"name": "白の皇帝", "text": "……謙遜するな。\nその着眼点は、間違っていない。\n敵の動きは、最初から奇妙だったからな。", "face": "u418"}, {"name": "レオナ", "text": "陛下、各前線より伝令が。\nダークエルフ、オークの部隊により、\n各重要地点が占領されています。", "face": "u311"}, {"name": "レオナ", "text": "セグナンド、オークロードを倒さねば、\n各地の解放は難しいかと……。", "face": "u311"}, {"name": "グラティア", "text": "各地の占拠、わざと即応させる配置……。\n……って、陛下、もしかして！\n危ないのは前線じゃなくて、むしろ――", "face": "u1551a1"}, {"name": "白の皇帝", "text": "ああ、ここだ。\n敵の目標は最初から、俺をここに引きずりだすことにある。", "face": "u418"}, {"name": "白の皇帝", "text": "レオナ、前線に出るぞ。\n敵の策に乗るのは気に入らないが。", "face": "u418"}, {"name": "レオナ", "text": "しかし、陛下……！", "face": "u311"}, {"name": "白の皇帝", "text": "民を守るのが、俺の役目だ。\nあいつなら、同じ選択をするだろう。", "face": "u418"}]}, {"trigger": "battle", "at_sec": 315, "lines": [{"name": "白の皇帝", "text": "――これで終わりか、冥界軍。\n皇帝の首はここだぞ。", "face": "u418"}]}, {"trigger": "battle", "at_sec": 324, "lines": [{"name": "ハイドース", "text": "冥界に至った後、お前の話を聞いてみたいものだ。\n守るべきものを守るために、\nその生命の灯火を捧げるがいい。", "face": "le4066daa294e"}, {"name": "ロミルダ", "text": "……ッ！！\n陛下、下がって！\nこの魔力は――人が受け止められるものじゃないよ！！", "face": "u1555a1"}, {"name": "白の皇帝", "text": "……俺が退けば、民が死ぬ、か。\n――女神アダマス、力を借りるぞ。", "face": "u418"}, {"name": "ハイドース", "text": "その覚悟、見事なものだ。\nせめて苦しまず、冥界の民となるがいい。", "face": "le4066daa294e"}]}, {"trigger": "battle", "at_sec": 324, "lines": [{"name": "白の皇帝", "text": "亜神の魔力如き、斬り裂いて見せろ！\n女神の神器、その真価を――ッ！！", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "…………陛、下？", "face": "u311"}, {"name": "ハイドース", "text": "……命までは、届かなかったか。\nしかしもう、その灯火も尽きかけている。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "別れの時を邪魔するつもりはない。\n大切な者に、最期の言葉を告げてくるがいい。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "……アダマスの、神器め。\nこんなことで……砕けるとはな……。", "face": "u418"}, {"name": "レオナ", "text": "陛下、しゃべらないでください！\n早くヒーラーを……っ。\nトゥーダ！　神官戦士にも招集をかけろ！", "face": "u311"}, {"name": "白の皇帝", "text": "…………やめろ、レオナ。\nもう、手遅れだ……前線の戦力を……無駄に使うな。", "face": "u418"}, {"name": "レオナ", "text": "しかし、陛下……このままでは、あなたが……ッ！！", "face": "u311"}, {"name": "アウローラ", "text": "……はぁ。\n軍師が取り乱してどうするのですか。\nロミルダ、この軍師どこかに連れて行ってください。", "face": "u711"}, {"name": "ロミルダ", "text": "はっ、えっと、はい。\nでもアウローラ、いったい何を……？", "face": "u1555a1"}, {"name": "アウローラ", "text": "治療するに決まってるでしょう。\nトゥーダ、ここにいる癒し手だけで、\n陛下の命をつなぎとめますよ。", "face": "u711"}, {"name": "トゥーダ", "text": "……そうですね、陛下の命令によれば、\n他の前線に影響が出ないなら問題ないわけですから。", "face": "u1554a1"}, {"name": "白の皇帝", "text": "…………馬鹿な、臣下ばかりを、持ったな。\n………………。\n…………。", "face": "u418"}, {"name": "アウローラ", "text": "死んで楽になんて、させませんから。\n自分の始めたことなら、\n最後まで責任を取ってもらわないと。", "face": "u711"}, {"name": "アウローラ", "text": "それからグラティア、\nアダマス様の神器、拾い集めてくれますか？", "face": "u711"}, {"name": "グラティア", "text": "えっ……えぇと、分かった。\nでも砕けた剣なんて、いったい何に使うんだ。", "face": "u1551a1"}, {"name": "アウローラ", "text": "それは鍛冶職人が考えること！\nさぁトゥーダ、陛下を運びますよ！", "face": "u711"}, {"name": "トゥーダ", "text": "はいっ！　グラティア、ここは任せましたよ！", "face": "u1554a1"}, {"name": "グラティア", "text": "って、おい！　アタシに何ができるって――\nあぁ、もうっ！！", "face": "u1551a1"}]}, {"trigger": "route", "enemy_ids": [33], "lines": [{"name": "ハイドース", "text": "ならば、誘いに乗ってやろう。\nこうして前線で相対するのは初めてだったか。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "神像では何度も見ている。\n亜神ハイドース、ここで決着をつけるとしよう。", "face": "u418"}, {"name": "ハイドース", "text": "……惜しい戦士だ。\nなぜお前ほどの実力を備えた男が、\n国家の長などに収まっているのか。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "……守るべきものがあるからだ。", "face": "u418"}, {"name": "ハイドース", "text": "人とは、美しくも愚かなものだな。\n短いその生を、誇りと使命、愛と愚行で\n火花のように燃やし尽くして散っていく。", "face": "le4066daa294e"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 117000, "attack": 2600, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 35, "pattern_id": 2128688}, {"enemy_id": 1, "form_index": 1, "hp": 117000, "attack":