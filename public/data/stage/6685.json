"source": "local", "count": 8, "form_count": 1, "hp": 20000, "attack": 2000, "base_hp": 20000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 321, "global_id": 320, "spawn_sec": 46}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097824, "master_id": 44, "global_id": 43, "spawn_sec": 122}, {"enemy_id": 7, "source": "local", "count": 10, "form_count": 1, "hp": 1400, "base_hp": 1400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 60, "attack_wait": 10, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097728, "master_id": 41, "global_id": 40, "spawn_sec": 139}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 120000, "attack": 3500, "base_hp": 120000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 10, "attack_speed": 150, "attack_wait": 10, "attack_interval": 291, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110176, "race_id": 10, "master_id": 30267, "global_id": 3886, "spawn_sec": 143}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 108000, "attack": 1160, "base_hp": 108000, "base_attack": 1160, "damage_type": "physical", "armor_defense": 10, "attack_range": 300, "attack_speed": 250, "attack_wait": 70, "attack_interval": 241, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110224, "race_id": 10, "change_to": 9, "change_condition": 1, "missile_id": 200, "missile": {"speed": 8.0}, "master_id": 30281, "global_id": 3900, "ranged": true, "variants": [{"hp": 108000, "attack": 4000, "base_hp": 108000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 10, "attack_speed": 250, "attack_wait": 90, "attack_interval": 541, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110240, "race_id": 10, "master_id": 30282, "global_id": 3901}], "spawn_sec": 161}], "dialogue": [{"trigger": "start", "lines": [{"name": "エレーヌ", "text": "――この熱、どうやら目的地は近そうね……。", "face": "u481"}, {"name": "アンナ", "text": "炎の巨人がこの付近に現れたとのことですが、\nもしやまた、巨人族が何かを企んでいるのでしょうか。", "face": "lfe3fe8d5cb21"}, {"name": "エレーヌ", "text": "ん……この気配……間違いない。\nこの先にファイアージャイアントがいる……。", "face": "u481"}, {"name": "ソーマ", "text": "……あれ？\nあ、あのっ、巨人の目の前に女の子がいませんか！？", "face": "u23"}]}, {"trigger": "start", "lines": [{"name": "？？？", "text": "――もうっ、どうして私がこんな目に……。\nあつっ、熱いってば！\n近付いてこないでよぉ……！！", "face": "u742"}, {"name": "エレーヌ", "text": "……大変。\n王子、あの子を助けないと……。", "face": "u481"}, {"name": "レアン", "text": "くっ、なんて熱だ……！\nおいっ、大丈夫か？　早くこっちへ来るんだ！！", "face": "u50"}, {"name": "？？？", "text": "あ、ありがと……。\nって、あぁ！　あなた達！！\nあなた達を心配して追いかけてきたんだけどっ！？", "face": "u742"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "？？？", "text": "あなた達が巨人の潜む洞窟に入っていったから、\n危ないわよって止めるために追ってきたの！\nそしたら炎の巨人が突然現れて……。", "face": "u742"}, {"name": "レアン", "text": "なるほど……巻き込んでしまったわけか。\nわかった、守ってやるから後ろに下がるんだ。\nこれから私達は、こいつと戦うんだからな。", "face": "u50"}, {"name": "？？？", "text": "――嫌よ。", "face": "u742"}, {"name": "？？？", "text": "あなた達を心配してついてきたのに、\n私の知らないところで死なれちゃ\n貴族の誇りに傷がついちゃうじゃない。", "face": "u742"}, {"name": "？？？", "text": "だから、私も戦うわ。\n私は誰かの負った傷を、周囲に分散することが出来るの。\n前線に立つ人の助けくらいにはなるでしょう？", "face": "u742"}, {"name": "ケイティ", "text": "……王子、どうやら押し問答を\nしている余裕はなさそうです。\n巨人たちの足音が大きくなっています！", "face": "u114"}, {"name": "アンナ", "text": "王子、ファイアージャイアントは魔法の炎を纏っており、\n周囲にいるだけでも被害を受けてしまいます。\n十分に警戒した上での采配をお願いします！", "face": "lfe3fe8d5cb21"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "……ファイアージャイアント、討伐完了です。\n他の巨人達も逃げ出していきます。", "face": "u114"}, {"name": "？？？", "text": "……驚いた。あなた達、強かったのね。\nどこかの国の軍隊なのかしら？", "face": "u742"}, {"name": "アンナ", "text": "我々は王国の者です。\nあなたも先程、貴族だと仰っていたようですが……。"}, {"name": "？？？", "text": "……まぁ、そこは忘れて。元貴族ってだけの話よ。\nそれより助けてくれてありがとう。\nあなたが、あの「お人好し王子」なのね？", "face": "u742"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "？？？", "text": "ふふっ、近くの村で噂されていたわ。\nあちこち人助けをして回っている、\n変わった王子が王国にいるって噂。", "face": "u742"}, {"name": "スピリア", "text": "――私はスピリア。\nあなたのこと、ちょっと気に入ったわ。\n気が向いたら王国に遊びに行くわね？", "face": "u742"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "…………！", "face": "lfe3fe8d5cb21"}, {"name": "スピリア", "text": "それじゃあ私は、まだ用事があるから。\nここでお別れしましょうか。\n改めて、本当に助けてくれてありがとう。王子様？", "face": "u742"}, {"name": "アンナ", "text": "……不思議な力を持った方でしたね。\n王子、ひとまず巨人退治も終わりましたし、\n王国へ帰還しましょうか。"}]}], "active": true}