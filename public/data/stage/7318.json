{"quest_id": 7318, "name": "第一陣 魔神副団長マレブランケ", "description": "王子たちは孤立した黒の軍団副団長\nマレブランケの救出作戦に臨む。\n<広域戦闘：敵味方の射程減少>\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国一陣", "event_category": "Empire", "mission_id": 940007, "map_no": 4563, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [75]}, {"kind": "term", "influence": 20, "params": [75]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "level": 80, "form_index": 0, "form_count": 1, "tags": ["鳥"], "hp": 3200, "attack": 300, "base_hp": 3200, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_range": 130, "attack_speed": 1, "attack_wait": 3, "attack_interval": 49, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123008, "race_id": 12, "special_effect_id": 234, "missile_id": 474, "missile": {"speed": 10.0}, "master_id": 32635, "global_id": 6253, "ranged": true, "spawn_sec": 28}, {"enemy_id": 2, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128624, "race_id": 21, "change_to": 2, "change_condition": 4, "master_id": 33702, "global_id": 7319, "to_condition": 4, "to_ticks": 3, "to_global_id": 7322, "spawn_sec": 32}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 700, "base_hp": 20000, "base_attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait"