 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127776, "race_id": 21, "special_effect_id": 222, "master_id": 33558, "global_id": 7175, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 12, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 8000, "attack": 1400, "base_hp": 8000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "change_to": 12, "change_condition": 4, "master_id": 33563, "global_id": 7180, "to_condition": 4, "to_ticks": 3, "to_global_id": 7183, "spawn_sec": 148}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 16, "source": "local", "count": 8, "form_index": 0, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127792, "race_id": 21, "change_to": 16, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 33559, "global_id": 7176, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 7179, "spawn_sec": 168}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127808, "race_id": 21, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 33562, "global_id": 7179, "ranged": true, "from_condition": 4, "trigger_ticks": 3}], "popups": ["発光するマスに配置した\nユニットは射程が\n上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マレブランケ", "text": "はぁ……参ったな……。\nどうにか部下は逃したけど、\n完全に囲まれてしまったようだね。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "しかし私を捜索している間、\n敵部隊の一部をこちらに\n釘付けにしていると思えば悪くない。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "……ここで稼いだ時間を、\nどうか上手く使っておくれよ、メフィスト団長。\nこの作戦の成功率は１０００％だ！　とか言ってね。", "face": "u1225a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "マレブランケ", "text": "ああ、せめて恋くらいしてから死にたかった。\n軍人になった以上望めないことだけど！", "face": "u1225a1"}, {"name": "マレブランケ", "text": "ああ、こんな状況で、例えば――\n――そう、例えばどこかの王子様が、\n颯爽と私を助けに駆けつけてくれたりしたら……。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "その興奮度、１００００％！\n……って、あっ、あれ？　おや？", "face": "u1225a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "チヨメ", "text": "マレブランケ副団長ですね？\nお怪我はありませんかー？", "face": "u1144a1"}, {"name": "マレブランケ", "text": "あっ、な、ないですー。\nど、どうしよう、本当に王子様が現れてしまった……！", "face": "u1225a1"}, {"name": "ハツネ", "text": "ここまでは上手く潜入できましたけど……。\nうぅ、さっきより敵が増えてますし、\n戦闘は避けられそうにないですね……。", "face": "u810"}, {"name": "アザミ", "text": "もとより戦闘の発生を踏まえた部隊編成だ。\n王子の指揮があれば、突破も難しくはあるまい。", "face": "u160"}, {"name": "ヒナ", "text": "で、でも敵にはハーピーもいるみたいだよ？\nこんな広い戦場で空を飛ぶ相手なんて、大丈夫かな？", "face": "u94"}, {"name": "ケイティ", "text": "ハーピーとの戦いには、遠隔攻撃が必要でしょう。\n山頂を確保できれば、\n広い射程を確保できるかもしれません。", "face": "u114"}, {"name": "マレブランケ", "text": "王国の王子よ、私も戦うぞ！\n共にこの戦線を突破し、帝国軍と合流しよう！", "face": "u1225a1"}]}, {"trigger": "end", "lines": [{"name": "マレブランケ", "text": "申し遅れた、メフィスト団長の部下、マレブランケだ。\n……本当に助かった、この礼は必ずしよう。", "face": "u1225a1"}, {"name": "アンナ", "text": "ご無事で何よりです。\nそろそろ冥界軍も\n動き出すでしょうから、危ないところでしたね。", "face": "l91db55a83012"}, {"name": "マレブランケ", "text": "はっ、そうだ！\nまさにその情報を伝えようと思っていたのだった！", "face": "u1225a1"}, {"name": "マレブランケ", "text": "敵軍は冥界人と思しき連中だけではない。\n遠方より、獣人の部隊が接近しているのだ。", "face": "u1225a1"}, {"name": "リエーフ", "text": "獣人……？\n冥界軍で、獣人……まさか……。", "face": "u1178a1"}, {"name": "マレブランケ", "text": "何だ、心当たりがあるのかお嬢さん？", "face": "u1225a1"}, {"name": "リエーフ", "text": "……冥界の亜神、ハイドースに与した者の中に、\n私の友人がいるんです。\nその子が部隊を率いているのかもしれません。", "face": "u1178a1"}, {"name": "マレブランケ", "text": "なるほど……友が敵に……。\nそれは辛かろう、お嬢さん。", "face": "u1225a1"}, {"name": "リエーフ", "text": "あっ、あの、なぜ抱っこを……？\nでも……はい、ありがとうございます。\nちょっと落ち着きました。", "face": "u1178a1"}, {"name": "レオーネ", "text": "（……リエーフ、その友人って、\nもしかしてリンクスのこと？\nあの子の部族が冥界軍についてるの？）", "face": "u926"}, {"name": "リエーフ", "text": "（……はい、姉さん。\n今回の襲撃に関わっているかどうかは不明ですが、\n確実に、ハイドースという亜神と共にいるはずです）", "face": "u1178a1"}, {"name": "レオーネ", "text": "（そっか……リンクスは、\nアタシたちの部族のこと嫌ってたもんね。\n獣人の誇りがどうとか言ってさ）", "face": "u926"}, {"name": "リエーフ", "text": "（仕方ありません。\n魔王の配下となり、次は人間に与する。\nそんな父の真意を、彼女は知らないのですから）", "face": "u1178a1"}, {"name": "レオーネ", "text": "（……でも、あの子はリエーフの友だちでしょ。\nどうにかして、仲直りさせてあげなくっちゃね）", "face": "u926"}, {"name": "リエーフ", "text": "（それは自分でがんばりますから！\n姉さんが口出しするといつも大変なことになるんですよ！）", "face": "u1178a1"}, {"name": "レオーネ", "text": "（あはは、分かった分かった。\nそれじゃあ、王子たちに報告しておこう。\n敵の獣人は――かなりの強敵だってさ）", "face": "u926"}]}], "active": true}