id": 2119744, "race_id": 16, "change_to": 55, "master_id": 34263, "global_id": 7880, "to_global_id": 7881}, {"enemy_id": 53, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 40000, "attack": 780, "base_hp": 40000, "base_attack": 780, "damage_type": "physical", "armor_defense": 400, "attack_range": 310, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2126112, "race_id": 16, "special_effect_id": 129, "missile_id": 507, "missile": {"speed": 16.0}, "master_id": 34264, "global_id": 7881, "ranged": true}, {"enemy_id": 57, "source": "local", "count": 12, "form_count": 1, "hp": 5000, "attack": 800, "base_hp": 5000, "base_attack": 800, "damage_type": "physical", "armor_defense": 350, "magic_defense": 5, "attack_speed": 70, "attack_wait": 60, "attack_interval": 260, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097776, "race_id": 16, "master_id": 65, "global_id": 64, "spawn_sec": 169}, {"enemy_id": 58, "source": "local", "count": 18, "form_count": 1, "tags": ["アーマー"], "hp": 7000, "attack": 850, "base_hp": 7000, "base_attack": 850, "damage_type": "physical", "armor_defense": 1000, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097872, "race_id": 16, "master_id": 86, "global_id": 85, "spawn_sec": 174}], "dialogue": [{"trigger": "start", "lines": [{"name": "リズリー", "text": "――どんどん、ぱふぱふ、にゃんにゃかにゃーん♪\n第１回、王国紅白大合戦、開催だよーっと♪", "face": "u716"}, {"name": "ガオレオン", "text": "うむっ、解説のガオレオンであるッ！\n熱く激しく輝きに満ちた戦いを期待するッ！！", "face": "l2611935806d8"}, {"name": "リズリー", "text": "それじゃあ早速ルール説明だよ。\n聞き流してると大変なことになるから、\nちゃーんと集中してねー？", "face": "u716"}, {"name": "リズリー", "text": "紅白大合戦は、ふたつのチームに\n分かれて戦う、大規模な模擬戦だよ。", "face": "u716"}, {"name": "リズリー", "text": "王子様には、事前に\nどちらかのチームを選んでもらうからね。", "face": "u716"}, {"name": "ガオレオン", "text": "では王子よ、あちらの戦士たちを見るがよいッ！", "face": "l2611935806d8"}, {"name": "ナナリー", "text": "（ぱたぱた）", "face": "u29"}, {"name": "シビラ", "text": "（にっこり）", "face": "u39"}, {"name": "リズリー", "text": "ふたりがそれぞれのチームのリーダーだから、\n王子はどちらかの前に兵を配置してね。\nもちろん、選ばなかった方と戦うことになるよ。", "face": "u716"}, {"name": "リズリー", "text": "それと、配置する兵は\nちゃんと姿が見える子じゃないとだめだぞ～？\n隠れるのがうまい子だと見えないからね！", "face": "u716"}, {"name": "ガオレオン", "text": "うむむ、これは迷ってしまうな……。\nどちらとも戦いたいッ、その気持ちは分かるぞッ！", "face": "l2611935806d8"}, {"name": "ガオレオン", "text": "――ゆえに、どうしても第三勢力になりたいなら、\nどちらも選ばず制限時間を待つという手も用意したッ！", "face": "l2611935806d8"}, {"name": "リズリー", "text": "にひひ、決めるのは王子様だからね、\n誰と一緒に戦いたいか、誰と刃を交えたいか、\n慎重に考えて決めてほしいな♪", "face": "u716"}, {"name": "リズリー", "text": "それじゃあ選択タイム、行ってみよう♪", "face": "u716"}]}, {"trigger": "start", "lines": [{"name": "ミコト", "text": "ふふ、王子もこちらのチームなのですね。\n模擬戦とはいえ、\nこれは負けるわけにはいかなくなりました。", "face": "u130"}, {"name": "ナナリー", "text": "うん……絶対に勝ちましょう。\n王子と一緒に、目指せ優勝です。", "face": "u29"}, {"name": "リズリー", "text": "王国紅白大合戦、\n双方の準備が整ったようだー！", "face": "u716"}, {"name": "ガオレオン", "text": "諸君ッ、日頃の実力を存分に発揮せよッ！\nこれより、合戦開始であるッ！！", "face": "l2611935806d8"}]}, {"trigger": "start", "lines": [{"name": "シビラ", "text": "王子、観客席の方を見てみて？\nほら、街の子どもたちが手を振ってる。", "face": "u39"}, {"name": "ディーネ", "text": "これはますます、勝たねばなりませんね。\nカッコイイところ、見せてあげるとしましょうか。", "face": "u223"}, {"name": "リズリー", "text": "王国紅白大合戦、\n双方の準備が整ったようだー！", "face": "u716"}, {"name": "ガオレオン", "text": "諸君ッ、日頃の実力を存分に発揮せよッ！\nこれより、合戦開始であるッ！！", "face": "l2611935806d8"}]}, {"trigger": "start", "lines": [{"name": "ナナリー", "text": "えっと……それでは、全力でいきますね？", "face": "u29"}, {"name": "シビラ", "text": "王子、手加減はしないからね。\nだって、全力の方がいいでしょう？", "face": "u39"}, {"name": "リズリー", "text": "開戦前からバチバチだー！\nこれは熱い戦いが期待できちゃうね！", "face": "u716"}, {"name": "ガオレオン", "text": "諸君ッ、日頃の実力を存分に発揮せよッ！\nこれより、合戦開始であるッ！！", "face": "l2611935806d8"}]}, {"trigger": "end", "lines": [{"name": "リズリー", "text": "――そこまで！\nこの戦い、勝者は……ッ！", "face": "u716"}, {"name": "ガオレオン", "text": "ナナリーチームの勝利だッ！\n素晴らしい輝きをありがとうッ！\n熱き戦士たちに惜しみない拍手を送るのだッ！！", "face": "l2611935806d8"}, {"name": "ナナリー", "text": "ふふっ、やりましたね……♪", "face": "u29"}, {"name": "ナナリー", "text": "王子と一緒だったので、のびのびと戦えました。\nなんというのか……えぇと……\n王子の隣にいると、負ける気がしないんです。", "face": "u29"}, {"name": "リズリー", "text": "王国紅白大合戦、\n第一回の勝者はナナリーチームとなりました！", "face": "u716"}, {"name": "リズリー", "text": "皆さま、最後にもう一度大きな拍手を！\n第２回の開催をお楽しみにー？\nそれでは皆さま……まったねー♪", "face": "u716"}]}, {"trigger": "end", "lines": [{"name": "リズリー", "text": "――そこまで！\nこの戦い、勝者は……ッ！", "face": "u716"}, {"name": "ガオレオン", "text": "シビラチームの勝利だッ！\n素晴らしい輝きをありがとうッ！\n熱き戦士たちに惜しみない拍手を送るのだッ！！", "face": "l2611935806d8"}, {"name": "シビラ", "text": "こういう戦いも悪くない、かな。\nいつもは命をかけた戦いばかりだけれど、\nこれなら、皆を楽しませることができるもの。", "face": "u39"}, {"name": "シビラ", "text": "ほら王子、こっちに来て？\n一緒に手を振ってあげましょう。", "face": "u39"}, {"name": "リズリー", "text": "王国紅白大合戦、\n第一回の勝者はシビラチームとなりました！", "face": "u716"}, {"name": "リズリー", "text": "皆さま、最後にもう一度大きな拍手を！\n第２回の開催をお楽しみにー？\nそれでは皆さま……まったねー♪", "face": "u716"}]}, {"trigger": "end", "lines": [{"name": "リズリー", "text": "――そこまで！\nこの戦い、勝者は……ッ！", "face": "u716"}, {"name": "ガオレオン", "text": "王子チームの勝利だッ！\n素晴らしい輝きをありがとうッ！\n歴戦の猛者たちに惜しみない拍手を送るのだッ！！", "face": "l2611935806d8"}, {"name": "アンナ", "text": "王子、やりましたね！\n最初はどうなることかと思いましたが……。"}, {"name": "王子", "text": "…………（ふんす！）", "face": "u1"}, {"name": "リズリー", "text": "王国紅白大合戦、\n第一回の勝者は王子チームとなりました！", "face": "u716"}, {"name": "リズリー", "text": "皆さま、最後にもう一度大きな拍手を！\n第２回の開催をお楽しみにー？\nそれでは皆さま……まったねー♪", "face": "u716"}]}, {"trigger": "route", "enemy_ids": [2], "lines": [{"name": "シビラ", "text": "こちらを選んで良かったの？\nふふっ。だって、\nこのチームなら負ける気がしないもの。", "face": "u39"}, {"name": "ガオレオン", "text": "王子はシビラチームを選んだようだなッ！\n北の大国と王国の絆を見せつけるのかッ！\nあるいは激しい矢の雨に挑みたくなったのかッ！", "face": "l2611935806d8"}]}, {"trigger": "route", "enemy_ids": [4], "lines": [{"name": "ナナリー", "text": "王子と一緒のチーム……。\nえへへ、頑張りましょうね。\n目指せ勝利……ですっ。", "face": "u29"}, {"name": "ガオレオン", "text": "王子はナナリーチームを選んだかッ！\n鋭き矢の連射を間近で見たいのかッ！？\nあるいは姫君と斬り結んでみたいのかッ！？", "face": "l2611935806d8"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "ガオレオン", "text": "熱いッ！　何と熱い男かッ！\nふたつの勢力を前にして、どちらも相手にしようとはッ！", "face": "l2611935806d8"}, {"name": "リズリー", "text": "その選択が吉と出るか凶と出るか。\n王国紅白大合戦は、三つ巴の戦いとなってしまったー！", "face": "u716"}]}], "active": true}