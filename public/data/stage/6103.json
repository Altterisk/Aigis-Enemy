{"quest_id": 6103, "name": "聖銀竜の騎士", "description": "強大なる力を持つ聖銀竜の卵を狙い、\n竜人族の魔の手が迫る。聖銀竜の騎士と\n力を合わせ、聖銀竜の卵を守り抜け！\n神級（★１獲得の目安：平均Lv50）", "event": "奪われたグリモワール", "event_category": "History", "mission_id": 920089, "map_no": 3970, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 1000, "base_hp": 40000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 350, "magic_defense": 60, "attack_range": 230, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100720, "race_id": 2, "special_effect_id": 232, "missile_id": 6, "master_id": 280, "global_id": 279, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 114, "global_id": 113, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 44, "form_count": 1, "hp": 1000, "attack": 400, "base_hp": 1000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "attack_speed": 20, "attack_wait": 10, "attack_interval": 86, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098592, "race_id": 2, "master_id": 148, "global_id": 147, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 4000, "attack": 700, "base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098528, "race_id": 2, "master_id": 113, "global_id": 112, "spawn_sec": 45}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100864, "race_id": 2, "change_to": 5, "change_condition": 2, "missile_id": 33, "missile": {"speed": 5.0}, "master_id": 285, "global_id": 284, "ranged": true, "to_condition": 2, "to_global_id": 285, "spawn_sec": 64}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100880, "race_id": 2, "missile_id": 34, "missile": {"speed": 5.0}, "master_id": 286, "global_id": 285, "ranged": true, "from_condition": 2}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "physical", "armor_defense": 400, "attack_speed": 90, "attack_wait": 10, "attack_interval": 181, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098560, "race_id": 2, "master_id": 30223, "global_id": 3842, "spawn_sec": 152}], "dialogue": [{"trigger": "start", "lines": [{"name": "大長老", "text": "――ええい邪魔な人間め。\nそのミスリルドラゴンの卵を、\n大人しくこちらに渡さぬか！！", "face": "le3ab2a7f52ef"}, {"name": "？？？", "text": "駄目です！　この卵は私の大事な家族……。\nあなた達に、渡すわけには絶対にいきません！", "face": "u1476"}, {"name": "幼聖銀竜", "text": "ギュイッ！", "face": "l2946f7394279"}, {"name": "大長老", "text": "ミスリルドラゴンの連中め。竜族でありながら\n我ら竜人ではなく人間の下僕として使われるとは。\n竜族としての誇りはどこにいったのじゃ！", "face": "le3ab2a7f52ef"}, {"name": "？？？", "text": "この子達は下僕なんかじゃありません！\n大切な家族です……その言葉、\n撤回してください！！", "face": "u1476"}, {"name": "大長老", "text": "ふん、人間に手を貸すのであれば\n同じ事じゃろうて。", "face": "le3ab2a7f52ef"}, {"name": "大長老", "text": "幼少の頃より育て上げれば我らに力を貸すだろうと\n卵を奪いに来たが……えぇい、退かぬというなら\n力づくで奪うまで！", "face": "le3ab2a7f52ef"}, {"name": "大長老", "text": "行くがいい、皆の者！", "face": "le3ab2a7f52ef"}, {"name": "？？？", "text": "……っ！　凄い数……とても私一人じゃ……\nううん、そんな事言ってられない……\nこの命が尽きたとしても、卵は絶対守らなきゃ……！", "face": "u1476"}, {"name": "ルシル", "text": "――王子、こっちだ！\n急がないと、聖銀竜の卵が\n竜人の手に……む、あれは！", "face": "u222"}, {"name": "アンナ", "text": "どうやら竜人達に襲われているようですね。\nあのままでは彼女が危険です。\n急ぎ助けましょう！", "face": "l546252706e34"}]}, {"trigger": "end", "lines": [{"name": "大長老", "text": "ぐっ、人間共め……皆の者、撤退じゃ！！", "face": "le3ab2a7f52ef"}, {"name": "アンナ", "text": "……ひとまず竜人の方々は去ったようですね。\nあの、大丈夫ですか？"}, {"name": "ティファ", "text": "だ、大丈夫です。危ない所を助けて頂き\nありがとうございます。私はティファと言います。", "face": "u1476"}, {"name": "ティファ", "text": "私一人じゃ、この子の家族を\n守り切る事が出来なかったと思います。\n本当に助かりました。", "face": "u1476"}, {"name": "アンナ", "text": "ご無事で何よりです。\n家族とは……この卵でしょうか？"}, {"name": "ティファ", "text": "はい。この卵は竜族の中でも個体が非常に\n少ない聖銀竜、その卵です。", "face": "u1476"}, {"name": "ティファ", "text": "皆さんが来てくれなければ\nどうなっていた事か……。\nありがとうございます！", "face": "u1476"}, {"name": "幼聖銀竜", "text": "ギュイギュイ！", "face": "l092b45f10fd2"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "幼聖銀竜", "text": "……ギュイッ！？", "face": "l092b45f10fd2"}, {"name": "幼聖銀竜", "text": "ギュイ～～～♪", "face": "l8a98024e217d"}, {"name": "ティファ", "text": "この子が私以外の人に懐くなんて珍しい……\nあ、ちょっと！　こ、こらっ！\n頭の上に乗っちゃダメっ！　降りなさい！！", "face": "u1476"}, {"name": "幼聖銀竜", "text": "～～～～～～♪", "face": "l8a98024e217d"}, {"name": "アンナ", "text": "なんだか王子、すっかり気に入られて\nしまったようですね。……あの、つかぬ事を\nお伺いしますがこの子の性別は？"}, {"name": "ティファ", "text": "え？　えっと、女の子ですが。", "face": "u1476"}, {"name": "アンナ", "text": "……そうですか。", "face": "l546252706e34"}, {"name": "ティファ", "text": "……？　と、此度の件本当に感謝致します。\nしばらくはまだここを離れられないですが、\nいずれ改めて皆さんにお礼に参ろうと思いますので。", "face": "u1476"}, {"name": "ティファ", "text": "その時には何卒よろしくお願いします。", "face": "u1476"}]}], "active": true}