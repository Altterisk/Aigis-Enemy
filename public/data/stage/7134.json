t": 1, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2125408, "race_id": 3, "special_effect_id": 608, "master_id": 32849, "global_id": 6467, "spawn_sec": 116}, {"enemy_id": 9, "source": "local", "count": 7, "level": 70, "form_index": 0, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 122}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "リヴル", "text": "――はろうぃん？", "face": "u398"}, {"name": "アリサ", "text": "えぇ、ハロウィンの祝祭です！\nもうそろそろ準備をしないとなーって、\n軍の女の子たちと話していたんですよ。", "face": "u24"}, {"name": "リヴル", "text": "いや待てアリサ、ハロウィンって確か\n季節の節目のお祭りで、\n死者が帰ってくるっていうあれだろ……？", "face": "u398"}, {"name": "リヴル", "text": "怖がるならともかく、\nどうしてそんなに楽しそうなんだ？", "face": "u398"}, {"name": "ソーマ", "text": "リヴル様ちゃん、\nもしかして王国のハロウィンは初めてですか？", "face": "u23"}, {"name": "リヴル", "text": "うっ……何だよ、悪いかよ。\nどうせわたしは友だちが――って、\nわたしをリヴル様ちゃんって呼ぶなぁ！", "face": "u398"}, {"name": "アリサ", "text": "そっか、リヴル様ちゃんの\n初めてのハロウィンなら、\n今年はめいっぱい気合をいれないといけませんね♪", "face": "u24"}, {"name": "ケイティ", "text": "はい、雑談はそこまでです。\n模擬戦の最中だということを忘れないでくださいね？", "face": "u114"}, {"name": "ソーマ", "text": "ご、ごめんなさいー！\nリヴル様ちゃん、ハロウィンの祝祭のことは、\nこの模擬戦が終わったら教えてあげますね！", "face": "u23"}, {"name": "リヴル", "text": "お、おい！　気になるじゃないか！\n――はぁ、仕方ない。\nこうなったらすぐに模擬戦を終わらせてやるぞ！", "face": "u398"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "――そこまで！\n本日の模擬戦は終了です！", "face": "u114"}, {"name": "リヴル", "text": "そ、それでソーマ、アリサ、\nハロウィンの祝祭ってどんな祭りなんだ？", "face": "u398"}, {"name": "アリサ", "text": "地方によって色々と内容が違うのですが、\nたいていの場合は――", "face": "u24"}, {"name": "ソーマ", "text": "子どもたちがオバケの仮装をして、\n大人にこう言うんです。\nお菓子をくれなきゃいたずらしちゃうぞ♪　って。", "face": "u23"}, {"name": "リヴル", "text": "い、いたずら！？\nそんな事したら怒られちゃうだろ！？", "face": "u398"}, {"name": "ソーマ", "text": "ふふふ、ところがハロウィンの夜には、\n大人は喜んで子どもたちに\nお菓子を配ってあげるんですよ。", "face": "u23"}, {"name": "アリサ", "text": "王国では大人や子供に限らず、\nお菓子をプレゼントしあったりしていますけどね。", "face": "u24"}, {"name": "リヴル", "text": "そっか、お菓子をプレゼントするお祭りかぁ……。\nお菓子……お菓子は好きだけど、\nわたしは立派な大人だからな……。", "face": "u398"}, {"name": "リヴル", "text": "アリサやソーマがイタズラしに来たら、\n美味しいお菓子をあげなきゃいけないのか……。", "face": "u398"}, {"name": "リヴル", "text": "ふっふっふ、ちょっと楽しそうだぞ。\nハロウィンがこんなに楽しみなのは初めてだ！\nソーマ、アリサ、楽しみに待っていろよ！", "face": "u398"}]}], "map": {"image": "Map920150_5770", "w": 960, "h": 640, "spots": [{"k": "b", "x": 25, "y": 398}, {"k": "m", "x": 506, "y": 279, "id": 200}, {"k": "m", "x": 541, "y": 318, "id": 201}, {"k": "m", "x": 417, "y": 298, "id": 202}, {"k": "m", "x": 446, "y": 332, "id": 203}, {"k": "m", "x": 320, "y": 307, "id": 204}, {"k": "m", "x": 340, "y": 343, "id": 205}, {"k": "m", "x": 216, "y": 319, "id": 206}, {"k": "m", "x": 248, "y": 367, "id": 207}, {"k": "m", "x": 146, "y": 363, "id": 208}, {"k": "m", "x": 363, "y": 147, "id": 209}, {"k": "m", "x": 281, "y": 173, "id": 210}, {"k": "m", "x": 225, "y": 231, "id": 211}, {"k": "m", "x": 319, "y": 463, "id": 212}, {"k": "m", "x": 438, "y": 505, "id": 213}, {"k": "m", "x": 543, "y": 475, "id": 214}, {"k": "m", "x": 629, "y": 450, "id": 215}, {"k": "r", "x": 277, "y": 261, "id": 301}, {"k": "r", "x": 323, "y": 209, "id": 302}, {"k": "r", "x": 412, "y"