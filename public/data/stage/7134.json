{"quest_id": 7134, "name": "リヴル、はじめてのハロウィン", "description": "ハロウィンを前に、徐々に盛り上がる\n王国軍。しかし、ハロウィンを知らない\nリヴルは乗り切れずにいた。\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "悪魔召喚士とパンプキンパレード", "event_category": "History", "mission_id": 920150, "map_no": 5770, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 150, "gold": 700, "drops": [{"card": 70, "c": 2}, {"card": 55, "c": 1}, {"item": 1005, "c": 1}, {"item": 5002, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 3500, "attack": 100, "base_hp": 3500, "base_attack": 100, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 17, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110992, "race_id": 16, "master_id": 30410, "global_id": 4029, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 12, "level": 70, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 1600, "attack": 300, "base_hp": 1600, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1600.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107296, "race_id": 16, "master_id": 32372, "global_id": 5991, "spawn_sec": 55}, {"enemy_id": 4, "source": "local", "count": 4, "level": 70, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_typ