: 6400, "attack": 1500, "base_hp": 6400, "base_attack": 1500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126944, "race_id": 19, "special_effect_id": 1039, "change_to": 31, "change_condition": 4, "master_id": 37942, "global_id": 11559, "to_condition": 4, "to_ticks": 1, "to_global_id": 11560}, {"enemy_id": 30, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 6400, "attack": 500, "base_hp": 6400, "base_attack": 500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126928, "race_id": 19, "special_effect_id": 1039, "master_id": 37943, "global_id": 11560, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 33, "source": "local", "count": 4, "form_count": 1, "tags": ["ステルス"], "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "physical", "armor_defense": 550, "magic_defense": 10, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099568, "master_id": 11, "spawn_sec": 159}, {"enemy_id": 34, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2097200, "special_effect_id": 902, "master_id": 36265, "global_id": 9882, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "route_behaviour": {"sets_flags": [[6, 1, 60], [7, 1, 60]]}, "spawn_sec": 218}], "popups": ["？？？の影響により\n各種天界兵の\n攻撃と防御がアップします。\n\nこの効果はミッションの\n時間が経過するほど\n強力になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ホルエス", "text": "――皆さん、ご無事でしたか！", "face": "u149"}, {"name": "ハシム", "text": "すまんな、遺跡内部まで救援に行きたかったが、\nこっちも天界兵に包囲されちまった。", "face": "u170"}, {"name": "アサル", "text": "どうにか第一波は抑えましたが、\n敵は転移魔法を使っているようです。\nおそらく、間を置かずに第二波が来ます！", "face": "u2163a1"}, {"name": "パルセ", "text": "……なぜ、こちらに？\n私の破壊が目的なら、\n手薄な飛空戦艦本体を狙ってくるのでは。", "face": "u2276a1"}, {"name": "ケイティ", "text": "むしろあちらの戦力を考えれば、\n同時襲撃もありえるはずですが……。", "face": "u114"}, {"name": "ユリクセス", "text": "――これは、本当に時間稼ぎなんだろうさ。", "face": "u2193a1"}, {"name": "ユリクセス", "text": "ガレアは飛空戦艦の完成は防げないと読んだんだ。\nだからこそ、破壊できないのなら、\n対抗策が整うまで時間を稼げばいいと判断した。", "face": "u2193a1"}, {"name": "アキレア", "text": "だから初手でヘラクレイアなんざ出してきたのか。\nあいつ、自分から神の試練を乗り越えまくって\n半神になった化け物女だからなぁ……。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "ともあれ、今は無事にパーツを\n飛空戦艦まで持ち帰るのが先決だ。", "face": "u2193a1"}, {"name": "アキレア", "text": "よっしゃ、じゃあ包囲する気で来る敵さんを、\nがっつり返り討ちにしてやろうか！", "face": "u1972a1"}]}, {"trigger": "start", "lines": [{"name": "フローガ", "text": "転移魔法を感知！\n敵が来ます！！", "face": "u878"}, {"name": "アキレア", "text": "……なんだァ、あれ？\nただの天界兵だってのに、「神」の気配がするぜ。", "face": "u1972a1"}, {"name": "オラティル", "text": "神の加護を受けている……？\nいや、もっと異質な……。", "face": "u2149a1"}, {"name": "オラティル", "text": "これは、伝承に謳われる者だけがまとう気配だ。\nこんなにわらわらと、出てきていい類のものじゃない。", "face": "u2149a1"}, {"name": "ホリー", "text": "彼らが、一騎当千の強者ってことですか！？", "face": "u647"}, {"name": "オラティル", "text": "いや、それなら多少なりとも\n見覚えのある戦士がいるはずだ。\n連中の顔なんて、ひとりも見たことがない。", "face": "u2149a1"}, {"name": "オラティル", "text": "何者かが、あの戦士たちに神の力を与えているんだ。\n放っておけばさらに力を増してくるだろう。", "face": "u2149a1"}, {"name": "アキレア", "text": "さっさと倒せばいいんだな！\n行くぞ王子、全員なぎ倒す！！", "face": "u1972a1"}]}, {"trigger": "end", "lines": [{"name": "アイシャ", "text": "天界兵の増援が途切れた。\n王子、今が好機だよ。", "face": "u181"}, {"name": "レン", "text": "この隙が意図的なものだという可能性は？\n敵は転移魔法を持っています。\nこちらの移動にあわせて強襲してくる可能性も……。", "face": "u127"}, {"name": "アイシャ", "text": "その可能性も織り込み済みで、\nここは進軍するしかないかな。", "face": "u181"}, {"name": "レン", "text": "……なるほど。あちらは時間稼ぎが目的。\nだとしたら、ここでの足踏みは\n相手の利にしかなりませんね。", "face": "u127"}, {"name": "アサル", "text": "殿軍はお任せを。\n我々砂漠の民には、地の利がありますから。", "face": "u2163a1"}, {"name": "アリア", "text": "よし、それじゃあ――全軍、行軍開始！\n敵は転移魔法を仕掛けてくるはず。\n魔術師は魔力の乱れを見逃すな！", "face": "u75"}, {"name": "パルセ", "text": "……あとは、私の役割。", "face": "u2276a1"}, {"name": "パルセ", "text": "今度こそ、「私」を起動させてみせます。", "face": "u2276a1"}, {"name": "エピウス", "text": "だ、大丈夫、です……。\n設計中に、何度も確認しました……。", "face": "u2194a1"}, {"name": "エピウス", "text": "あなたは、とてもいい船です。\nきっと、応えてくれます……。", "face": "u2194a1"}, {"name": "パルセ", "text": "……はいっ！", "face": "u2276a1"}]}], "active": true}