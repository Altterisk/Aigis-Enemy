cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "special_effect_id": 64, "master_id": 32465, "global_id": 6084, "from_condition": 3}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 2, "hp": 10000, "attack": 480, "base_hp": 10000, "base_attack": 480, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103408, "race_id": 8, "special_effect_id": 64, "change_to": 19, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 32470, "global_id": 6089, "ranged": true, "to_condition": 3, "to_global_id": 6090, "spawn_sec": 161}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 480, "base_hp": 10000, "base_attack": 480, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 500, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 32471, "global_id": 6090, "ranged": true, "from_condition": 3}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 2, "hp": 12000, "attack": 420, "base_hp": 12000, "base_attack": 420, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103376, "race_id": 8, "special_effect_id": 64, "change_to": 21, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 32468, "global_id": 6087, "ranged": true, "to_condition": 3, "to_global_id": 6088, "spawn_sec": 163}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 420, "base_hp": 12000, "base_attack": 420, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "special_effect_id": 64, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 32469, "global_id": 6088, "ranged": true, "from_condition": 3}], "popups": ["オーク旗手が持つ\n敵の攻撃と防御アップの能力は、\nオーク旗手の数に応じて効果が\n重複します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "――うぉぉぉぉっ！！\n女王アリ様！　女王アリ様！！", "face": "l29df62150588"}, {"name": "オーク", "text": "何と素晴らしい肉体美なのだ！\n女王アリ様に栄光あれ！　女王アリ様こそ美の化身！", "face": "l29df62150588"}, {"name": "ジェイク", "text": "くっ……何だこのフェロモンの濃度は！？\n対抗ポーションの効果が無かったら\n一瞬で意識を奪われちまいそうだ！", "face": "u367"}, {"name": "オスカー", "text": "どうやらここのオーク達は、\n進化した女王アリのフェロモンを\nより高濃度で与えられたようですね……。", "face": "u366"}, {"name": "アナトリア", "text": "まったく、オークともあろう者が不甲斐ない。\nガツンと目を覚ましてやらないとねぇ。", "face": "u522"}, {"name": "レティシア", "text": "王子殿、オーク達は高濃度のフェロモンで、\n大幅に凶暴化しているようです。", "face": "u1001a1"}, {"name": "レティシア", "text": "打たれ強くなっているだけでなく、\nその力もさらに強大になっています。\n十分に警戒しつつ、指示を出してくださいね。", "face": "u1001a1"}]}, {"trigger": "end", "lines": [{"name": "オーク", "text": "――ぐっ……俺達は、いったいなにを……。", "face": "l29df62150588"}, {"name": "イリオス", "text": "女王アリに操られていたんですよ！\nはい、この対抗ポーションを早く早く！", "face": "u872"}, {"name": "オーク", "text": "……そうか、武人でありながら、\n魔界アリのフェロモン如きに操られるとは……。", "face": "l29df62150588"}, {"name": "ソーマ", "text": "ともかく、これでこの森のオークさんたちは、\n無事にフェロモンの影響から解放できましたね！", "face": "u23"}, {"name": "レティシア", "text": "えぇ。あとは開拓村に向かうだけ――", "face": "u1001a1"}]}, {"trigger": "end", "lines": [{"name": "魔界アリの女王", "text": "――くふふ、良い見世物であった。\n雄とは実に容易く支配されるものよなぁ。", "face": "lc4ff8a15531b"}, {"name": "ガオレオン", "text": "ガオーッ！　それは女王アリ様の美しさゆえにッ！！", "face": "l077f089788dd"}, {"name": "レティシア", "text": "女王アリ、ガオレオン……！！", "face": "u1001a1"}, {"name": "魔界アリの女王", "text": "む、誰かと思えば討ち漏らした小娘ではないか。\nおなごに興味は無いが、中々の武勇であった。", "face": "lc4ff8a15531b"}, {"name": "魔界アリの女王", "text": "頭を垂れ、恭順を誓うのであれば、\n妾の巣の飾りくらいにはしてやっても良いぞ？", "face": "lc4ff8a15531b"}, {"name": "レティシア", "text": "……ふざけないでください。\n虫の魔物はすべて、私がこの世界から抹殺します。", "face": "u1001a1"}, {"name": "魔界アリの女王", "text": "くふふふっ！　威勢のよい小娘よ！\nさぁ妾のガオレオンよ、余興はこれくらいにしておこう。\n妾の巣へと連れて行っておくれ。", "face": "lc4ff8a15531b"}, {"name": "ガオレオン", "text": "ガオーッ！　かしこまりました、我が女王よッ！\n……くっ、うぉぉっ、で、ですが、\n我が女王よ、一言だけ……お許しを……ッ！", "face": "l077f089788dd"}, {"name": "魔界アリの女王", "text": "……む？　言うてみるがよい。", "face": "lc4ff8a15531b"}, {"name": "ガオレオン", "text": "――レティシアよ、よくぞ王子と合流した。\n開拓村を、我らが同胞達を、必ず救ってくれ……ッ！！", "face": "l077f089788dd"}, {"name": "魔界アリの女王", "text": "くっ……まだ意識を保っているとは。\n妾しか見えぬようにしてくれる……ッ！！", "face": "lc4ff8a15531b"}, {"name": "ガオレオン", "text": "ぐ……ッ、ぐわぁぁぁぁッ！！\n女王アリ様……ッ、万歳……ッ！！\nい、いざ、女王アリ様の愛の巣へ……ッ！", "face": "l077f089788dd"}, {"name": "アンナ", "text": "女王アリ、ガオレオン、撤退していきます……。\nまさか、彼があれほどまでに操られてしまうなんて……。", "face": "lc54186a1690f"}, {"name": "アンナ", "text": "王子、開拓村ではより激しい戦いとなりそうです。\n十分に準備を整え、この先へ進みましょう。", "face": "lc54186a1690f"}]}], "active": true}