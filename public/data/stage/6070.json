ster_id": 35, "global_id": 34, "spawn_sec": 154}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 1000, "attack": 400, "base_hp": 1000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "attack_speed": 20, "attack_wait": 10, "attack_interval": 86, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098592, "race_id": 2, "master_id": 148, "global_id": 147, "spawn_sec": 161}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 10, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 175}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}], "popups": ["魔界ボアのHPを減らすと、\n移動速度が大幅に上昇します。\n\n倒さなくても★の評価には影響せず、\n拠点にも向かいません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――こちらですね。巨大な魔物が\n現れるようになった地というのは。", "face": "ld932c6faeba8"}, {"name": "ケイティ", "text": "報告書によるとゴブリン達が乗り物にしている\n豚のような魔物との事ですが……。", "face": "u114"}, {"name": "シャロン", "text": "だとすると、その魔物は恐らく魔界ボアですね。\n魔界の調査を進めている際に、\nちょうどその魔物が記述されている本を見つけました。", "face": "u283"}, {"name": "ゴブリン博士", "text": "――その魔界ボアは我々の騎獣ダ！\nみすみす渡すわけには行かんゾ！", "face": "l780906a4bc31"}, {"name": "ゴブリン博士", "text": "何をしていル、お前達さっさト\n逃げ出した騎獣を捕まえてこんカ！", "face": "l780906a4bc31"}, {"name": "ゴブリン", "text": "ギャギャッ！\nキジュウ、コワイ！　コワイ！！", "face": "l7e618fd2b7be"}, {"name": "ゴブリン博士", "text": "くそ……、今はあいつらを倒して、\nあとでゆっくり騎獣を捕まえるしかないカ……\nえぇイ、まずは王子達を始末しロ！", "face": "l780906a4bc31"}, {"name": "ゴブリン", "text": "ギャギャッ！", "face": "l7e618fd2b7be"}, {"name": "ケイティ", "text": "王子、ゴブリン達が向かってきます！\n戦いのご準備を！", "face": "u114"}, {"name": "シャロン", "text": "王子、野生の魔界ボアに、軽はずみな攻撃は\n控えた方が良いかと思います。\n傷を受けると怒りで手がつけられなくなります！", "face": "u283"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン", "text": "マカイボア、ニゲタ！　ニゲタ！！", "face": "l7e618fd2b7be"}, {"name": "ゴブリン博士", "text": "馬鹿モン！　逃げたではなイ、\n急いで追わんカー！　あれ一匹仕入れるのに\nいくらかかると思ってるのダ！", "face": "l780906a4bc31"}, {"name": "アンナ", "text": "王子、魔界ボアが逃げていきます！", "face": "ld932c6faeba8"}, {"name": "ケイティ", "text": "あのような魔物にうろつかれては危険ですね。\n急ぎ討伐隊を編成し向かわせます。", "face": "u114"}, {"name": "アンナ", "text": "はい、ケイティさんよろしくお願いします。", "face": "ld932c6faeba8"}, {"name": "アンナ", "text": "それにしてもあの魔物……魔界ボアでしたか。\n凄まじい攻撃力でした。", "face": "ld932c6faeba8"}, {"name": "シャロン", "text": "資料によると、魔界の深層では特に珍しくもない、\nどこにでも生息する魔物なんだそうですが……。", "face": "u283"}, {"name": "ケイティ", "text": "あれほどの魔物が当たり前に\n生息する地ですか。", "face": "u114"}, {"name": "アンナ", "text": "魔界深層……何の知識もなく向かうには、\n危険すぎる場所のようですね。", "face": "ld932c6faeba8"}, {"name": "シャロン", "text": "はい、ですがお任せ下さい！　深層については、\n必ずや私達魔法都市の面々で\n詳しい情報を集めてみせますので！", "face": "u283"}, {"name": "アンナ", "text": "シャロンさん、とても心強いです。\n何卒よろしくお願いします！"}]}], "active": true}