"base_attack": 350, "damage_type": "physical", "armor_defense": 70, "magic_defense": 40, "attack_speed": 40, "attack_wait": 3, "attack_interval": 68, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106064, "race_id": 3, "special_effect_id": 42, "master_id": 770, "global_id": 769, "spawn_sec": 164}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 300, "base_hp": 30000, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "magic_defense": 40, "attack_range": 200, "attack_speed": 50, "attack_wait": 48, "attack_interval": 162, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105984, "race_id": 3, "change_to": 9, "change_condition": 1, "missile_id": 14, "missile": {"speed": 6.0, "splash": 147}, "master_id": 764, "global_id": 763, "ranged": true, "variants": [{"hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 50, "attack_wait": 16, "attack_interval": 133, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106000, "race_id": 3, "master_id": 765, "global_id": 764}], "spawn_sec": 226}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士（過去）", "text": "――ぐッ……はぁ、はぁッ……なんて、強さだ。\nいったい、貴様は……何者なんだ……？\nなぜ、我々の王国を襲う……？", "face": "u65"}, {"name": "クロノデーモン", "text": "グワッハハハッ！　魔族を見た事がないのか？\n我が名はクロノデーモン。魔界より来れり者ぞ。\nそこをどけ雑魚ども。我は王子に用があるのだ。", "face": "l90b49cdb4253"}, {"name": "兵士（過去）", "text": "クロノ……デーモン？　ま、魔界……？\n一体なにを言っているのだ貴様！\n止まれ！　止まるんだ……！！", "face": "u65"}, {"name": "クロノデーモン", "text": "グハハハッ。\n我を止める事など一体誰が出来ようか！\nさぁとどめだ、死ぬがよい。", "face": "l90b49cdb4253"}, {"name": "子供王子", "text": "……。", "face": "lec93b8066b47"}, {"name": "クロノデーモン", "text": "ほう、自ら我が前に歩み出るとはな……。\nその潔さだけは褒めてやろう。", "face": "l90b49cdb4253"}, {"name": "子供王子", "text": "……！", "face": "lec93b8066b47"}, {"name": "クロノデーモン", "text": "まさか、我と戦う気なのか？\nそのオモチャの剣で？\nグハハハハハハハハハハハッッ！！", "face": "l90b49cdb4253"}, {"name": "クロノデーモン", "text": "いや、失礼。\nさすがは伝説の英雄の子孫！　実に健気だ！\nいいだろう、英雄らしく剣を手に死ぬがいい！", "face": "l90b49cdb4253"}, {"name": "子供アンナ", "text": "――そうは、させないんだからぁーッ！", "face": "l90a7b857a85a"}, {"name": "アンナ", "text": "ちょ、ちょっと待ちなさいッ！\nもう……急に駆けだしたりしないの！\n危ないでしょ？　あなたは私達の後ろにいるの。", "face": "l2323a32d9243"}, {"name": "クロノデーモン", "text": "また貴様たちか！？\nいいところで邪魔をしよってからに……。", "face": "l90b49cdb4253"}, {"name": "クロノデーモン", "text": "忌々しい奴らめ！\n手下共よッ、奴等の相手などするな！\n狙うべきはただ一人、ガキの王子だッ、ゆけ！", "face": "l90b49cdb4253"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "王子、ご無事ですか！？\nお怪我も……特にないようですね。\n本当に良かった……。", "face": "l2323a32d9243"}, {"name": "子供王子", "text": "……（ペコリ）", "face": "lec93b8066b47"}, {"name": "アンナ", "text": "……王子の反応が薄いのは、\n子供の時から変わらないのですね。", "face": "l4ea34363270d"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "クロノデーモン", "text": "――はぁ……ハァ……ぐゥ、ぅぅッ……。\nそんな、ばかな……我は、時を超越した……、\nクロノデーモンだと……いうのに……。", "face": "l90b49cdb4253"}, {"name": "ココロ", "text": "何が時を超越した、よ！\n人様の大切な師匠の力を利用して……、\n身体まで奪っておいて……ふざけないでよッ！", "face": "u364"}, {"name": "クロノデーモン", "text": "ま、待て！　貴様の師の力があれば、\n過去は何度だってやり直せるのだ！\n貴様の大切な人間を救うことだって――", "face": "l90b49cdb4253"}, {"name": "ココロ", "text": "うるっさーーーーーいッ！\n過去は変えてはいけないものなの……。\nそれがどんなに辛く悲しい過去であろうとね。", "face": "u364"}, {"name": "ココロ", "text": "そう……師匠が……言ってたんだもん……。", "face": "u364"}, {"name": "クロノデーモン", "text": "う、ぐぁぁあッ……。\nそんな……ばか……な…………。\n完璧な計画……だった……の……に。", "face": "l90b49cdb4253"}, {"name": "ケイティ", "text": "完全に滅んだようですね。\nこれで歴史を改ざんされる心配も\nなくなりましたし、一安心ですね。", "face": "u114"}, {"name": "ココロ", "text": "さてっ、早く時空の門を通って私達の世界に\n戻るよ！　クロノデーモンの力が失われた今、\nいつ門が消えてもおかしくないわ。", "face": "u364"}, {"name": "子供アンナ", "text": "あの……もう、行っちゃうの……？\nお礼もまだしてないのに……。", "face": "l90a7b857a85a"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "子供アンナ", "text": "そ、そうだ！\nちょっとまって……えっと……、\nはい、これ！　城の前でとってきたお花！", "face": "l90a7b857a85a"}, {"name": "子供アンナ", "text": "またいつか、この国に遊びにきてね！\nいつもは平和でいい国なんだから！", "face": "l90a7b857a85a"}, {"name": "アンナ", "text": "……アンナちゃん、これから様々な事があると\n思うけど、貴方が仕える人は、何があっても\n貴方を守ってくれるわ。だから……頑張るのよ。"}, {"name": "子供アンナ", "text": "んー？\nよくわからないけど、アンナがんばるよ！\n王子様の為にいっぱいいっぱい頑張るからね！", "face": "l90a7b857a85a"}, {"name": "アンナ", "text": "……さあ帰りましょう、王子。\n私達が戦うべき世界に。"}]}], "story_talk": true, "active": true}