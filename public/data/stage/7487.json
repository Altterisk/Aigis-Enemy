{"quest_id": 7487, "name": "闇の組織と絡繰り忍者", "description": "フォーの企みを阻止すべく帰路を急ぐ\n王子たちの前に、絡繰り忍者と\n変異した魔物が立ち塞がる。\n神級（★１獲得の目安：平均Lv50）", "event": "クリスマス・デストロイヤー", "event_category": "History", "mission_id": 920170, "map_no": 4006, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 32000, "attack": 1050, "base_hp": 32000, "base_attack": 1050, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126672, "race_id": 16, "special_effect_id": 663, "change_to": 1, "change_condition": 2, "master_id": 33318, "global_id": 6935, "to_condition": 2, "to_global_id": 6936, "route_behaviour": {"sets_flags": [[0, 0, 0], [0, 1, 0]], "calls_event": [2094, 2095, 2096]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "ステルス"], "hp": 90000, "attack": 1200, "base_hp": 90000, "base_attack": 1200, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 58, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126688, "race_id": 16, "special_effect_id": 664, "master_id": 33319, "global_id": 6936, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 30}, {"enemy_id": 4, "source": "local", "count": 29, "form_count": 1, "tags": ["変異"], "hp": 3300, "attack": 580, "base_hp": 3300, "base_attack": 580, "damage_type": "physical", "attack_range": 180, "attack_speed": 40, "attack_wait": 30, "attack_interval": 105, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2115744, "race_id": 9, "special_effect_id": 309, "change_to": 4, "change_condition": 1, "missile_id": 298, "missile": {"speed": 2.0}, "master_id": 31245, "global_id": 4864, "ranged": true, "variants": [{"tags": ["変異"], "hp": 3300, "attack": 580, "base_hp": 3300, "base_attack": 580, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2115760, "race_id": 9, "special_effect_id": 309, "master_id": 31244, "global_id": 4863}], "spawn_sec": 47}, {"enemy_id": 6, "source": "local", "count": 22, "form_count": 1, "tags": ["忍者"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098896, "race_id": 16, "master_id": 436, "global_id": 435, "spawn_sec": 137}, {"enemy_id": 7, "source": "local", "count": 10, "form_count": 2, "tags": ["変異", "狙う", "ブロック不可", "水面"], "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 201, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115696, "race_id": 7, "special_effect_id": 310, "change_to": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 31241, "global_id": 4860, "ranged": true, "to_global_id": 4859, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 146}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["変異"], "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 411, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115680, "race_id": 7, "special_effect_id": 310, "change_to": 6, "missile_id": 299, "missile": {"speed": 1.0}, "master_id": 31240, "global_id": 4859, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "tags": ["変異", "狙う", "ブロック不可", "水面"], "hp": 15000, "base_hp": 15000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2115728, "race_id": 7, "special_effect_id": 309, "change_to": 9, "master_id": 31243, "global_id": 4862, "to_global_id": 4861, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 179}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["変異"], "hp": 15000, "attack": 1100, "base_hp": 15000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2115712, "race_id": 7, "special_effect_id": 309, "change_to": 8, "master_id": 31242, "global_id": 4861}], "popups": ["絡繰り忍者は攻撃力300以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。", "変異した敵は\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フォー", "text": "まったく、王国の警備もハリボテだなァ。\n子どもたちへのプレゼントですって\n顔さえしとけば、巨大兵器を持ち込めるんだから。", "face": "lfe3f7d6c8e7f"}, {"name": "フォー", "text": "なぁ王子ィ……去年の屈辱、忘れるものかよォ……。\n俺のクリスマス爆破作戦を邪魔した代償は、\nお前のカワイイ国民どもに払ってもらおうかァ。", "face": "lfe3f7d6c8e7f"}, {"name": "闇組織構成員", "text": "……フォー様、王都から連絡です。\n例のメカドラゴンの組み立て、\nパーツが足りず難航中とのことで……。", "face": "l284a85e2b734"}, {"name": "フォー", "text": "へぇ……それで？　何か問題？", "face": "lfe3f7d6c8e7f"}, {"name": "闇組織構成員", "text": "い、いえっ、ですが足りない部品は――", "face": "l284a85e2b734"}, {"name": "フォー", "text": "そうだなァ……。\nお前をバラして部品にしてやろうかァ。", "face": "lfe3f7d6c8e7f"}, {"name": "闇組織構成員", "text": "ひっ……ぶ、部品は他の箇所から代用します！\nそれではっ、お、俺は警備に戻りますっ！！", "face": "l284a85e2b734"}, {"name": "フォー", "text": "ハァ……これだからクズってのは使いにくい……。\n頼れるのはお前だけだよ、絡繰り忍者。", "face": "lfe3f7d6c8e7f"}, {"name": "絡繰り忍者", "text": "――否、頼れるものは金と技術のみに候。", "face": "l62f6c5f68128"}, {"name": "フォー", "text": "どこまでも冷静だねぇ……。\n――まぁそれなら、契約を果たしてもらおうか。\n絡繰り忍者、連中を迎え撃て。", "face": "lfe3f7d6c8e7f"}, {"name": "絡繰り忍者", "text": "――御意に。", "face": "l62f6c5f68128"}, {"name": "ソーマ", "text": "なっ……絡繰り忍者さんがどうして……。\nまさか闇の組織に雇われたんですか！？", "face": "u23"}, {"name": "絡繰り忍者", "text": "先日のおなごか……。\n敵にさえ問いを投げかける癖は変わっておらぬようだ。", "face": "l62f6c5f68128"}, {"name": "絡繰り忍者", "text": "しかし、そのうぶさに免じて答えてやろう。\n我が主は元よりフォー殿にござる。\n――そして今、その契約を履行するといたそう。", "face": "l62f6c5f68128"}, {"name": "ヘレナ", "text": "……王子、周囲に変異した魔物が展開している。\n連中はすぐに傷を再生してしまう。\n半端な火力じゃジリ貧になるぞ。", "face": "u1397a1"}, {"name": "絡繰り忍者", "text": "つまらぬ情報共有は終わったか？\nなれば、戦と参ろうか。", "face": "l62f6c5f68128"}]}, {"trigger": "end", "lines": [{"name": "フォー", "text": "おいおい、口だけか絡繰り忍者ァ。\nお前の本当の力は、そんなもんじゃないだろォ！？", "face": "lfe3f7d6c8e7f"}, {"name": "絡繰り忍者", "text": "面目次第もござらん。\nされど気をつけられよ、\nこの者ら、以前よりも強くなっておるがゆえ。", "face": "l62f6c5f68128"}, {"name": "フォー", "text": "人間がそう簡単に成長するかよ。\nクズは永遠にクズなのさ。", "face": "lfe3f7d6c8e7f"}, {"name": "フォー", "text": "――そう、のんきに遠征なんかに出てるから、\n王都にはもうすぐ、虐殺と破壊が蔓延ることになるのさ。", "face": "lfe3f7d6c8e7f"}, {"name": "フォー", "text": "全部お前のせいだ、クズ王子ィ。\n悔しかったら追ってくるがいいさ！\nまっ、もう手遅れだけどなァ！！", "face": "lfe3f7d6c8e7f"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "ヘレナ", "text": "……大丈夫だ、王子。\n王都の方角からは、火の手も\nあがっていないし、伝令だって来ていない。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "王子を怒らせるのがあいつの策だ。\n敵の策に乗る暇があったら、\n何の不安もなく私の策に乗ってくれ。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "何しろ私は、天才戦術家のヘレナだぞ？\n――さぁ、王国のクリスマスを守るために、\n敵の策を粉々に粉砕してやろうじゃないか！", "face": "u1397a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "絡繰り忍者", "text": "――見事なり。\nされど気をつけられよ、爆死の危機は常に足元にあるのだ。", "face": "l62f6c5f68128"}, {"name": "ヘレナ", "text": "爆死――って、まずいぞ王子！\n絡繰り忍者の足元に爆弾がっ！！", "face": "u1397a1"}, {"name": "ヘレナ", "text": "みんな、急いで撤退しろ！\n爆発に巻き込まれるぞ！", "face": "u1397a1"}]}], "active": true}