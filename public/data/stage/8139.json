st": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2135824, "race_id": 11, "master_id": 34782, "global_id": 8399, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 19, "source": "local", "count": 3, "form_count": 1, "hp": 9000, "attack": 800, "base_hp": 9000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114592, "race_id": 14, "change_to": 19, "change_condition": 3, "master_id": 31017, "global_id": 4636, "spawn_sec": 128}, {"enemy_id": 21, "source": "local", "count": 5, "form_count": 3, "hp": 8000, "attack": 1100, "base_hp": 8000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149600, "race_id": 14, "change_to": 21, "master_id": 36995, "global_id": 10612, "to_global_id": 10613, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 138}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 5, "attack_interval": 91, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149536, "race_id": 14, "special_effect_id": 1610, "change_to": 22, "missile_id": 974, "missile": {"speed": 12.0}, "master_id": 36996, "global_id": 10613, "ranged": true, "to_global_id": 10614}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 8000, "attack": 1100, "base_hp": 8000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149600, "race_id": 14, "special_effect_id": 1615, "master_id": 36997, "global_id": 10614}], "dialogue": [{"trigger": "enemy_spawn", "enemy_id": 1, "lines": [{"name": "モモ", "text": "づぇええいっ！", "face": "u2043a1"}, {"name": "ミカ", "text": "決まったー！　超必殺モモパンチ！\n狛犬パンチにだって負けてないよー！", "face": "u2045a1"}, {"name": "アカネ", "text": "あれほどの威力の攻撃を受けたのです、\n以前であれば薬の効果も切れるはずですが……。", "face": "u1678a1"}, {"name": "マズゥ", "text": "馬鹿だね、これは『完璧な』若返りの秘薬さ！\nこの程度のダメージ、なんてことあるはずも──", "face": "l595b104e58a7"}, {"name": "マズゥ", "text": "………………。", "face": "l595b104e58a7"}, {"name": "マズゥ", "text": "なんだいこれはぁあああああああッ！？", "face": "l595b104e58a7"}, {"name": "モモ", "text": "あれ、もっと若返っちゃった？", "face": "u2043a1"}, {"name": "ミカ", "text": "うわ、ちっちゃ。", "face": "u2045a1"}, {"name": "フィーヌ", "text": "よくわかりませんが好機です！　\nここで一気に畳み掛けましょう！", "face": "u1415a1"}, {"name": "マズゥ", "text": "ええい、あんまり舐めるんじゃないよ！", "face": "l595b104e58a7"}, {"name": "マズゥ", "text": "あたしゃ生まれた頃から天才魔術師、\n全盛期にゃ及ばずとも魔力は十分さね！\nあんたらを吹き飛ばすぐらい朝飯前だよ！", "face": "l595b104e58a7"}, {"name": "ミカ", "text": "うぃー、頑張れー。", "face": "u2045a1"}, {"name": "モモ", "text": "ミカちゃん、駄目だよそういうの。", "face": "u2043a1"}, {"name": "マズゥ", "text": "馬鹿にするのも……大概にしなァ！", "face": "l595b104e58a7"}, {"name": "ミカ", "text": "うっひゃぁっ！？　まじでやばいじゃん！？", "face": "u2045a1"}, {"name": "フィーヌ", "text": "再度向かって来ます！　注意を！", "face": "u1415a1"}]}, {"trigger": "start", "lines": [{"name": "マズゥ", "text": "間違いない！　完成したよ！\nこれが完璧な若返りの秘薬さ！", "face": "ld3205ffa4bb6"}, {"name": "モモ", "text": "も、もう一度わたしを小さくするつもり！？", "face": "u2043a1"}, {"name": "マズゥ", "text": "馬鹿を言わないでおくれ、\nこれはあたしが自分で使う分さ。", "face": "ld3205ffa4bb6"}, {"name": "マズゥ", "text": "これまでの不良品とはひと味違うよ？\n今回のは肉体が完全に安定するはずさ！", "face": "ld3205ffa4bb6"}, {"name": "マズゥ", "text": "覚悟しな、全盛期の大魔女を前にして、\n五体満足で帰れるとは思わないことだね！", "face": "ld3205ffa4bb6"}, {"name": "ミカ", "text": "うっへぇ……変な色の薬ぃ。\nスライムみたいできもちわるー。\nあれ飲むの……？　まじ……？", "face": "u2045a1"}, {"name": "マズゥ", "text": "意識しないようにしてたんだから\nちょっと黙っててくれないかねぇ！？", "face": "ld3205ffa4bb6"}, {"name": "フィーヌ", "text": "ああっ！　マズゥが不味そうな薬を飲んで──", "face": "u1415a1"}]}, {"trigger": "start", "lines": [{"name": "ミカ", "text": "若返ったー！？", "face": "u2045a1"}, {"name": "モモ", "text": "お肌もピチピチだー！？", "face": "u2043a1"}, {"name": "アカネ", "text": "重要なのは容姿ではありません！\n早急に迎撃態勢を、油断したら危険です！", "face": "u1678a1"}, {"name": "モモ", "text": "が、頑張るよー！", "face": "u2043a1"}]}, {"trigger": "end", "lines": [{"name": "モモ", "text": "デコピン！", "face": "u2043a1"}, {"name": "マズゥ", "text": "ふんぎゃ！？", "face": "l595b104e58a7"}, {"name": "マズゥ", "text": "いてててて……大人気ないやつらだね！\nこんな幼気な子供を虐めて楽しいかい！？", "face": "l595b104e58a7"}, {"name": "ミカ", "text": "被害者仕草が多様じゃん。", "face": "u2045a1"}, {"name": "モモ", "text": "実年齢はお婆さんだから無問題？", "face": "u2043a1"}, {"name": "アカネ", "text": "想定外の事態ではありましたが、\nそろそろ観念してもらいましょう。", "face": "u1678a1"}, {"name": "マズゥ", "text": "まっ、まだだよ！　まだあたしは負けて──", "face": "l595b104e58a7"}, {"name": "マズゥ", "text": "──く、薬の効果が！", "face": "ld3205ffa4bb6"}, {"name": "ミカ", "text": "あ、戻った。", "face": "u2045a1"}, {"name": "マズゥ", "text": "あ、あと少しだったのにィ……！", "face": "ld3205ffa4bb6"}, {"name": "マズゥ", "text": "こっ、小人ォ！　金なら五倍出す！　あたしを守りな！", "face": "ld3205ffa4bb6"}, {"name": "小人A", "text": "働く喜び！　奉仕の心！", "face": "l1fe681a94ab0"}, {"name": "小人B", "text": "オフェンシブディフェンス！", "face": "l1fe681a94ab0"}, {"name": "ミカ", "text": "だから邪魔だってばー！", "face": "u2045a1"}, {"name": "アカネ", "text": "こう群がられては視界が──", "face": "u1678a1"}, {"name": "マズゥ", "text": "あたしは家に帰らせてもらうよ！\nこの仙薬湯は手土産に頂いとくね！", "face": "ld3205ffa4bb6"}, {"name": "モモ", "text": "なっ、なんでお婆さんなのにそんなに足速いの！？", "face": "u2043a1"}, {"name": "マズゥ", "text": "この年まで生き延びた悪党の逃げ足を舐めないことさ！", "face": "ld3205ffa4bb6"}, {"name": "ミカ", "text": "それは素直に納得！", "face": "u2045a1"}, {"name": "モモ", "text": "もぉー！　待ってよー！", "face": "u2043a1"}]}], "active": true}