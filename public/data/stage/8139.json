{"quest_id": 8139, "name": "若返りの秘薬", "description": "仙薬湯を使い、若返りの秘薬を完成させた\nマズゥが全盛期の力で王子たちに襲い来る。\n温泉郷の平穏を取り戻すため敵を撃退せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "魔女と闘士と温泉郷", "event_category": "History", "mission_id": 920208, "map_no": 4831, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 4, "tags": ["ステルスII", "ブロック不可"], "hp": 68000, "base_hp": 68000, "damage_type": "physical", "armor_defense": 40, "magic_defense": 20, "attack_speed": 1, "attack_wait": 120, "attack_interval": 306, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2137152, "race_id": 16, "change_to": 1, "master_id": 37003, "global_id": 10620, "to_global_id": 10621, "commands": {"raw": "SetStageFlag(1, 0, 100); DoEnemy_RegistCommand(\"OnModeChanged\", \"SetStageFlag(1, 1, 100);\"); FlagCheckCommandOrder(1, 1, 100, 1, \"CallEvent(2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249);\");", "sets_flags": [[1, 0], [1, 1]], "flag_checks": ["1, 1, 100, 1, \"CallEvent(2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249"], "on_mode_changed": true}, "route_behaviour": {"transforms": [{"wait": 120}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルスII", "ブロック不可"], "hp": 68000, "base_hp": 68000, "damage_type": "magical", "armor_defense": 300, "magic_defense": 40, "attack_speed": 1, "attack_wait": 40, "attack_interval": 146, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2149680, "race_id": 16, "change_to": 2, "master_id": 37004, "global_id": 10621, "to_global_id": 10618}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 68000, "attack": 3000, "base_hp": 68000, "base_attack": 3000, "damage_type": "magical", "armor_defense": 300, "magic_defense": 40, "attack_range": 240, "at