 30, "attack_speed": 35, "attack_wait": 50, "attack_interval": 136, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099088, "special_effect_id": 240, "missile_id": 45, "master_id": 20059, "global_id": 1134, "ranged": true, "spawn_sec": 27}, {"enemy_id": 8, "source": "local", "count": 13, "form_count": 1, "hp": 1200, "attack": 150, "base_hp": 1200, "base_attack": 150, "damage_type": "physical", "armor_defense": 400, "magic_defense": 5, "attack_speed": 80, "attack_wait": 60, "attack_interval": 270, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097776, "race_id": 16, "master_id": 34, "global_id": 33, "spawn_sec": 32}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 150, "attack_speed": 70, "attack_wait": 80, "attack_interval": 206, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098000, "race_id": 16, "special_effect_id": 222, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 31679, "global_id": 5298, "ranged": true, "spawn_sec": 78}, {"enemy_id": 10, "source": "local", "count": 9, "form_count": 1, "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_range": 140, "attack_speed": 80, "attack_wait": 60, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101408, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 299, "global_id": 298, "ranged": true, "spawn_sec": 79}, {"enemy_id": 11, "source": "local", "count": 17, "form_count": 1, "hp": 5000, "attack": 800, "base_hp": 5000, "base_attack": 800, "damage_type": "physical", "armor_defense": 350, "magic_defense": 5, "attack_speed": 70, "attack_wait": 60, "attack_interval": 260, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097776, "race_id": 16, "master_id": 65, "global_id": 64, "spawn_sec": 151}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 14000, "attack": 650, "base_hp": 14000, "base_attack": 650, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101824, "race_id": 16, "special_effect_id": 226, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30020, "global_id": 3639, "ranged": true, "spawn_sec": 162}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 11000, "attack": 560, "base_hp": 11000, "base_attack": 560, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_range": 500, "attack_speed": 1, "attack_wait": 60, "attack_interval": 151, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118656, "race_id": 12, "special_effect_id": 222, "missile_id": 187, "missile": {"speed": 3.0}, "master_id": 31750, "global_id": 5369, "ranged": true, "spawn_sec": 164}], "popups": ["\n\n\n　　 　――数日後。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "よしよし、封印が開いたような気がしたけど、\nちゃんと魔界の門は再封印されているようですね。", "face": "u904"}, {"name": "？？？", "text": "んーっ、それにしてもこの場所、\n懐かしい感じですねぇ……。\nもうしばらく森を散歩してから――", "face": "u904"}, {"name": "ミトラ", "text": "（む……？　何故魔界の門の前に人がいる？）", "face": "u276"}, {"name": "ミトラ", "text": "何者だ！　そこは我らの神聖なる場所。\n部外者は出ていってもらおうか。", "face": "u276"}, {"name": "？？？", "text": "わわっと……ごめんなさいね？\n星が私を、ここへ導いたものですから。", "face": "u904"}, {"name": "？？？", "text": "ではでは、部外者はささっと退散しますので。\n――英雄王の子孫によろしくお伝えくださいな。", "face": "u904"}, {"name": "ミトラ", "text": "……何？　待て、いったいどういう意味だ！", "face": "u276"}, {"name": "ミトラ", "text": "……くっ、行ってしまったか。\nもう気配が辿れないとは、\n本当に何者だったんだ、あの娘は……。", "face": "u276"}]}, {"trigger": "start", "lines": [{"name": "ルナール", "text": "――あっ、いたいた！\nおーい、皆も連れてきたよー♪", "face": "u889"}, {"name": "ミトラ", "text": "……あぁ、ルナールか。\n演武に挑む戦士達を連れてきてくれたんだな。", "face": "u276"}, {"name": "ミトラ", "text": "それから……むむ？　王子達も来たのか？\n確か今日は王国のハロウィンパーティがあると……。", "face": "u276"}, {"name": "アンナ", "text": "そうだったのですが、\nハロウィンパーティの日程を延ばす、\nという荒業を、王子が思いついたものですから……。"}, {"name": "エーリカ", "text": "祝祭自体をずらすことはできないけど、\n皆で楽しむハロウィンパーティだけなら、\n何日間やっても大丈夫だからね♪", "face": "u409"}, {"name": "デスピア", "text": "それに森の民の祭祀に参加できるなんて、\nこんな貴重な機会を逃すわけにもいかないでしょう？\nふふっ……研究意欲がそそられるわ……。", "face": "u49"}, {"name": "ルナール", "text": "そういうわけで、王子達も森のお祭りに参加できて、\nあたしも王国のパーティに参加できることになったんだ♪", "face": "u889"}, {"name": "ミトラ", "text": "……ふふっ、そうか。\nではその礼と言ってはなんだが、\n王子達も祭祀の演武に参加していかないか？", "face": "u276"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ルナール", "text": "やった！　王子も一緒にお祭りだ♪\nよぉし、かっこいいとこ見せなくちゃ！", "face": "u889"}, {"name": "ミトラ", "text": "それでは演武の奉納を始めるぞ。\nルナール、祭祀の進行役として、\n開演の言葉を述べるんだ。", "face": "u276"}, {"name": "ルナール", "text": "うんっ！　我らが森の神よ、\n勇敢なる戦士達の演武を捧げます。\n戦士達よ、存分に鍛えし武を振るうのです！", "face": "u889"}]}, {"trigger": "end", "lines": [{"name": "ルナール", "text": "――そこまでー！\n森の木々のざわめき、みなぎる英気、\nきっと森の神様も喜んでくれたと思うよ！", "face": "u889"}, {"name": "キャンディ", "text": "き、緊張しましたぁ……。\n大事な儀式だと思うと、もう膝がガクガクで……！", "face": "u691"}, {"name": "ユユ", "text": "キャンディちゃんは緊張しすぎだよぉ。\nさっきも呪文噛んじゃってたもんね♪", "face": "u110"}, {"name": "キャンディ", "text": "えぇっ、忘れてください～！\n緊張してたって言うなら、私だけじゃなくて\nルナールちゃんだってそうですよぉ！", "face": "u691"}, {"name": "ルナール", "text": "えぇぇっ、だ、だって、\n王子があたしの晴れ舞台を見てるって思うと、\n胸がどきどきしちゃって……！", "face": "u889"}, {"name": "ルナール", "text": "お、おうじ……？\nあたしの演武、どうだったかな……？", "face": "u889"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ルナール", "text": "わぁっ、やったぁ！", "face": "u889"}, {"name": "ミトラ", "text": "ふふ、子供みたいにはしゃぐものだな……。\nルナール、王国のハロウィンパーティへ行くんだろう？\n演武はこれで終わり。出立の準備をするといい。", "face": "u276"}, {"name": "ルナール", "text": "あっ、そうだった！\nそれじゃあ王子、急いで準備してくるから待っててね。", "face": "u889"}, {"name": "アンナ", "text": "私達も、王国へ戻る準備をしましょうか。\n王子、森の民との演武、お疲れさまでした！"}]}], "active": true}