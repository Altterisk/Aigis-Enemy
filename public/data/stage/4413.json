{"quest_id": 4413, "name": "立ち塞がるカボチャ", "description": "行く手を阻むカボチャたちの\n陣形を突き崩し防衛線を突破しろ！\n\n極級（★１獲得の目安：平均Lv25）", "event": "死竜と復讐の魔導司祭", "event_category": "History", "mission_id": 920053, "map_no": 3631, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 398, "global_id": 397, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 40, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 209, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102832, "missile_id": 28, "missile": {"speed": 6.0, "splash": 200}, "master_id": 399, "global_id": 398, "ranged": true, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 15, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 3, "level": 80, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 400, "global_id": 399, "ranged": true, "spawn_sec": 47}], "dialogue": [{"trigger": "start", "lines": [{"name": "カボチャの魔物", "text": "オ城！　オ城！　もうすぐオ城！\nドラコリッチサマに、魂ハコベ！", "face": "l915b68ad63b4"}, {"name": "アンナ", "text": "王子！　カボチャの魔物が住民の魂を\n奪おうとしています！　急ぎ阻止いたしましょう！", "face": "l6fc715adedb1"}]}, {"trigger": "start", "lines": [{"name": "パンプキンキング", "text": "ちょっと待った！　ここは通さないカボ！\n魂を取り戻したくば、我を倒してから進め！", "face": "l46b5f5cd6ecb"}, {"name": "パンプキンキング", "text": "な～んて、ボクらしくない事言っちゃったカボ☆\nクヒュヒュヒュ！　クヒュヒュヒュ！　", "face": "l46b5f5cd6ecb"}, {"name": "アンナ", "text": "パンプキンキング！　\nそれに、他のカボチャの騎士たちまで……！", "face": "l6fc715adedb1"}, {"name": "パンプキンキング", "text": "クヒュヒュ！　遊びはここまでカボ！☆", "face": "l46b5f5cd6ecb"}, {"name": "エターナー", "text": "貴様！　私たちは遊んでなどいない！", "face": "u298"}, {"name": "パンプキンキング", "text": "なんなの君。真面目って言われない？\nすっごくつまんない。君もボクやドラコリッチサマ\nみたいに新しい体を作ってもらった方が良いカボ。", "face": "l46b5f5cd6ecb"}, {"name": "エターナー", "text": "新しい……体を作る……！？\n一体誰がそんな事を！", "face": "u298"}, {"name": "パンプキンキング", "text": "おっと！　こんなところでお喋りしてる暇は\nなかったカボ！\n君たち大人と話しててもちっとも面白くないしね！", "face": "l46b5f5cd6ecb"}, {"name": "パンプキンキング", "text": "ボクの大好きな子供だったら\nたくさんお喋りしたい所だけど☆", "face": "l46b5f5cd6ecb"}, {"name": "パンプキンキング", "text": "さぁカボチャたち！\n早く魂をドラコリッチサマのところに運ぶカボ！", "face": "l46b5f5cd6ecb"}, {"name": "パンプキンキング", "text": "そしてその他のカボチャたち！\nそこにいるつまんない人間を倒してしまうカボ！\nレッツファイト！！", "face": "l46b5f5cd6ecb"}]}, {"trigger": "end", "lines": [{"name": "エターナー", "text": "よし。なんとかここも片付いたな。\n先を急ごう。", "face": "u298"}, {"name": "アンナ", "text": "そうですね！"}]}], "active": true}