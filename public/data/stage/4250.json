{"quest_id": 4250, "name": "神殿強襲", "description": "頑強な岩巨兵たちが神殿を襲う！\n持てる力を総動員して敵の進軍を\n食い止めよ！\n神級（★１獲得の目安：平均Lv50）", "event": "ヴァンパイアの逆襲", "event_category": "History", "mission_id": 920039, "map_no": 3550, "level": 110, "multiplier": 1.1, "charisma": 75, "capacity": 9, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "hp": 38500, "attack": 2000, "base_hp": 35000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 40, "attack_range": 100, "attack_speed": 300, "attack_wait": 120, "attack_interval": 406, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099184, "race_id": 5, "missile_id": 58, "master_id": 170, "global_id": 169, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "hp": 55000, "attack": 3000, "base_hp": 50000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 100, "attack_speed": 300, "attack_wait": 120, "attack_interval": 406, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099184, "race_id": 5, "missile_id": 58, "master_id": 160, "global_id": 159, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 16, "form_count": 1, "hp": 1650, "attack": 165, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 34}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 2310, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 50}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 1760, "attack": 440, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 78}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 7700, "attack": 330, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 102}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "hp": 3080, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 200}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1980, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 272}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "なんとか間に合ったようですが……。\nってあの巨人は……！？", "face": "ladee8649bf68"}, {"name": "アンナ", "text": "見るからに膨大な耐久力と攻撃力を\n備えていそうですね。\n注意して対処する必要がありそうです。", "face": "ladee8649bf68"}, {"name": "アンナ", "text": "激しい戦いが予想されます。\n王子、ご采配を！", "face": "ladee8649bf68"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "なんとか敵を撤退させましたね……。", "face": "ladee8649bf68"}, {"name": "エリザベート", "text": "あらなに？　\nもう終わっちゃったの？　ざーんねん。", "face": "u104"}, {"name": "ヴィンセント", "text": "話はスーから聞いている。\nひとまず俺たちが調べてきた内容を伝えよう。", "face": "u103"}, {"name": "ヴィンセント", "text": "あのエデンとやらのヴァンパイアについてだ。", "face": "u103"}, {"name": "ヴィンセント", "text": "どうやらあいつは以前\n魔物の手にかかり一度死んでいる。", "face": "u103"}, {"name": "エリザベート", "text": "それに生前の記憶も失ってるみたいよ？", "face": "u104"}, {"name": "アンナ", "text": "死んだ身体をヴァンパイアによって\n蘇えさせられあのような力を……。\nお父様と呼んでいた人物の仕業でしょうが……。", "face": "ladee8649bf68"}, {"name": "アンナ", "text": "可哀想に……。せめて記憶だけでも\n取り戻してあげたいものです……。", "face": "le6de31b285fb"}, {"name": "ヴィンセント", "text": "……自分が一度死んで化け物になったと、\n思い出させるのか？", "face": "u103"}, {"name": "アンナ", "text": "……！　それは……。", "face": "ladee8649bf68"}, {"name": "ヴィンセント", "text": "……とにかく今は時間がない。\n住民を救うには敵の親玉を\n倒すしかないだろう。", "face": "u103"}, {"name": "ヴィンセント", "text": "神殿の警備は俺たちで手配しといてやる。\nお前たちは先に敵の元へ向え。", "face": "u103"}, {"name": "アンナ", "text": "先の戦闘からみるに、\n敵は相当な策士のようです。\nこの先厳しい戦いが予想されますが……。", "face": "ladee8649bf68"}, {"name": "アンナ", "text": "王子、気を引き締めて参りましょう！\n……私も覚悟を決めています。", "face": "ladee8649bf68"}]}], "active": true}