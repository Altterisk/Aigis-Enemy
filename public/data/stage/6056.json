le_id": 30, "missile": {"speed": 1.0}, "master_id": 579, "global_id": 578, "to_global_id": 348}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 349, "global_id": 348, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 5000, "base_hp": 5000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2106560, "race_id": 7, "change_to": 9, "master_id": 826, "global_id": 825, "to_global_id": 824, "spawn_sec": 74}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "change_to": 8, "master_id": 825, "global_id": 824}, {"enemy_id": 11, "source": "local", "count": 27, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 79}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "こちらですか、弓矢の通じない魔物が現れたというのは。", "face": "lc26decf1e4cf"}, {"name": "カズハ", "text": "はい。王国領内へと水を運ぶ水路、\n以前までであれば魔物の襲撃も少なく\nカズハの弓でも充分に対処は出来ていたのですが……。", "face": "u235"}, {"name": "カズハ", "text": "ここ最近、矢が全く通らないほど硬い魔物が\n現れるようになった上、連日の雨で視界も悪く\n魔物の数も減らせなくなってしまって……。", "face": "u235"}, {"name": "アンナ", "text": "……硬い魔物……恐らくは龍玉の欠片を\n持った魔物に違いありませんね。", "face": "lc26decf1e4cf"}, {"name": "バシラ", "text": "飛んでいる魔物でしたら私にお任せ下さい！\n……と言いたい所ですが、矢が通じない程の\n硬さですか……むぅ～、一体どうすれば……。", "face": "u28"}, {"name": "ネーニャ", "text": "……んもう、私達だっているんだからね！\n硬い魔物は私達が魔法で担当するから任せて！", "face": "u135"}, {"name": "リルケ", "text": "少し時間は貰うけど、私達エンチャンターなら\n弓矢に魔法を付与する事だってできるわよ。\nいざって時は頼ってちょうだい。", "face": "u330"}, {"name": "バシラ", "text": "み、皆さん。……はい！　\nよーし、力を合わせて頑張りましょう！", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "バシラ", "text": "……ふう、なんとか魔物を倒しきる事が出来ましたね。", "face": "u28"}, {"name": "カズハ", "text": "皆さん、救援に来ていただいて\n本当に助かりました。ありがとうございます。", "face": "u235"}, {"name": "ネーニャ", "text": "そんなの気にしないで！　困ったときはお互い様よ！", "face": "u135"}, {"name": "リルケ", "text": "アンナ、また魔物が現れないとも限らないわ。\n私達は引き続きここの守りに努めるわね。", "face": "u330"}, {"name": "アンナ", "text": "リルケさん、ありがとうございます。\n軍備を増加するよう手配はしておきますので。", "face": "lc26decf1e4cf"}, {"name": "カズハ", "text": "はい！　この地の防衛は、\nカズハ達にお任せください！", "face": "u235"}, {"name": "アンナ", "text": "王子、龍玉の欠片を所持していると思わしき魔物は、\nまだまだ各地で報告が上がっています。\n急ぎ討伐に向かいましょう。", "face": "lc26decf1e4cf"}]}], "active": true}