{"quest_id": 30027, "name": "ロストヴィレッジ・レクイエム 極級", "description": "・時間経過によるコスト回復なし\n・ＥＸＰ/ゴールド/ドロップなし\n・ライフが０でもミッションクリア", "event": "ロストヴィレッジ・レクイエム", "event_category": "Subjugation", "mission_id": 400591, "map_no": 9454, "entry_no": 2, "level": 70, "multiplier": 0.7, "capacity": 10, "modifiers": [{"kind": "term", "influence": 17}], "enemies": [{"enemy_id": 1, "source": "local", "count": 38, "form_index": 0, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 1400, "attack": 175, "base_hp": 2000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2173904, "race_id": 16, "master_id": 23735, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 13, "form_index": 0, "form_count": 1, "hp": 700, "attack": 105, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 66, "form_index": 0, "form_count": 1, "hp": 1050, "attack": 7, "base_hp": 1500, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 23761, "spawn_sec": 45}, {"enemy_id": 4, "source": "local", "count": 22, "form_index": 0, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 2450, "attack": 245, "base_hp": 3500, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "as