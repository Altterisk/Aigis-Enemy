 2, "held": 2}}, "spawn_sec": 345}, {"enemy_id": 16, "source": "local", "count": 18, "form_index": 0, "form_count": 1, "tags": ["アーマー", "アンデッド"], "hp": 4550, "attack": 600, "base_hp": 6500, "base_attack": 600, "damage_type": "magical", "armor_defense": 2000, "attack_range": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 150, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2117616, "missile_id": 45, "master_id": 23737, "ranged": true, "spawn_sec": 405}, {"enemy_id": 17, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アンデッド", "置物"], "fixture": true, "uncounted": true, "hp": 5250, "attack": 7, "base_hp": 7500, "base_attack": 10, "damage_type": "physical", "armor_defense": 600, "attack_speed": 90, "attack_wait": 15, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2173936, "race_id": 16, "special_effect_id": 2576, "master_id": 23756, "route_behaviour": {"hold": {"routes": 2, "held": 2}}, "spawn_sec": 419}, {"enemy_id": 18, "source": "local", "count": 16, "form_index": 0, "form_count": 1, "hp": 4200, "attack": 490, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 23750, "spawn_sec": 475}, {"enemy_id": 19, "source": "local", "count": 21, "form_index": 0, "form_count": 1, "hp": 1400, "attack": 20, "base_hp": 2000, "base_attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 35, "attack_speed": 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 23760, "ranged": true, "spawn_sec": 481}, {"enemy_id": 20, "source": "local", "count": 18, "form_index": 0, "form_count": 2, "hp": 2800, "attack": 630, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103936, "race_id": 18, "change_to": 20, "master_id": 486, "global_id": 485, "to_condition": 0, "to_global_id": 626, "spawn_sec": 495}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2800, "attack": 630, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105248, "race_id": 18, "change_to": 19, "master_id": 627, "global_id": 626, "from_condition": 0}, {"enemy_id": 22, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3850, "attack": 500, "base_hp": 5500, "base_attack": 500, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 161, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106400, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 23745, "ranged": true, "spawn_sec": 542}], "popups": ["ゴースト村少年は\n撃破数に含まれません。\n\nゴースト村少年がいる間は、\n全てのアンデッドの攻撃と防御が\nアップします。", "ゴースト村娘は\n撃破数に含まれません。\n\nゴースト村娘がいる間\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ソーマ", "text": "……王子、村があります。\nでも、地図ではこの辺りには何もないはずでは……。", "face": "u2178a1"}, {"name": "ケイティ", "text": "道を間違えたのでしょうか？\n今の地図と、周囲の地形は合っているのですが。", "face": "u2433a1"}, {"name": "アルティア", "text": "少々お待ちを。\n……ああ、こちらの地図には載っていますね。", "face": "u2891a1"}, {"name": "リカルド", "text": "おっと……やけに古い地図だな。\nいったいいつの時代のものなんだ？", "face": "u205"}, {"name": "アルティア", "text": "倉庫で見つけた、千年戦争の頃の地図の写しです。\nこの写し自体もかなり古いものですけどね。", "face": "u2891a1"}, {"name": "アンナ", "text": "ということは、千年も前の村が、今も……？\n廃村というには、家々がきれいすぎるような。"}, {"name": "ソーマ", "text": "はい。でも……静かすぎませんか？\n家はこんなにあるのに、\n話し声も、誰かが働く音も聞こえません。", "face": "u2178a1"}, {"name": "アルティア", "text": "……誰も暮らしていないのでしょうか。\n王子、慎重に調べた方がよさそうです。", "face": "u2891a1"}, {"name": "ソーマ", "text": "あっ、あそこに人が！\nすみません、少しお尋ねしたいことが――", "face": "u2178a1"}, {"name": "シャルロット", "text": "待ってください。\nあの方の身体……向こう側が透けていますわ！？", "face": "u2827a1"}, {"name": "アリサ", "text": "亡霊……？\nそれに、こちらへ近づいて……っ！", "face": "u24"}, {"name": "アルティア", "text": "王子、お気をつけください！\nどうやらこちらに敵意があるようです！", "face": "u2891a1"}, {"name": "アンナ", "text": "……今は、目の前の敵を退けましょう。\nこのままでは、捜索もままなりません。"}, {"name": "ケイティ", "text": "王子、大討伐ミッションを開始します！\n亡霊たちを退け、村の安全を確保しましょう！", "face": "u2433a1"}]}, {"trigger": "end", "lines": [{"name": "アルティア", "text": "……追撃はありません。\n王子、ひとまずこの場を離れられそうです。", "face": "u2891a1"}, {"name": "ソーマ", "text": "あの、こちらを……。\n捜索願に書かれていた、行方不明者の持ち物が、\n村の中に落ちていました。", "face": "u2178a1"}, {"name": "アンナ", "text": "では、行方不明になった方々は、\nやはりこの村へ……。"}, {"name": "アルティア", "text": "道に迷い、人家を見つけて助けを求めたのでしょう。\nですが、そこで待っていたのは……。", "face": "u2891a1"}, {"name": "ソーマ", "text": "……あの亡霊たち、だったんですね。", "face": "u2178a1"}, {"name": "アンナ", "text": "失踪事件の原因は、この村にあったのですね。\nこれ以上、知らずに立ち入る人が出ないよう、\nすぐに周辺の村へ知らせなければなりません。"}, {"name": "ソーマ", "text": "でも、行方不明になった皆さんは、まだ……。\nこのまま捜索を終えるわけには……。", "face": "u2178a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "ええ。捜索は続けます。\nまずはこの村への立ち入りを禁じ、\n調査の準備を整えましょう。"}, {"name": "アルティア", "text": "……それに、気になることがあります。\n亡霊だけならともかく、\nどうして家々まで昔の姿を留めていたのでしょう。", "face": "u2891a1"}, {"name": "アリサ", "text": "誰も暮らしていないのに、\nまるで村が誰かの帰りを待っているみたいでした……。", "face": "u24"}, {"name": "アルティア", "text": "王子、ひとまず王国へ戻りましょう。\nこの村で何が起きたのか、必ず突き止めなくては。", "face": "u2891a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "route", "lines": [{"name": "アンナ", "text": "王子、彼の妄執を、ここで終わらせてあげましょう。"}, {"name": "シンディ", "text": "……騎士の姿が、消えていきます。", "face": "u1098a1"}, {"name": "アルティア", "text": "……あっ……思い出しました。\nあの地図と一緒に見つけた書物に、\n滅びた村を守っていた騎士の記録があったんです。", "face": "u2891a1"}, {"name": "ソーマ", "text": "村を守っていた……。\nでは、あの騎士が……？", "face": "u2178a1"}, {"name": "アルティア", "text": "千年戦争の頃、この地に偶然、魔界への門が開いた。\nそこからあふれた魔物に襲われ、\n村は一人の生存者もなく滅ぼされたそうです。", "face": "u2891a1"}, {"name": "アルティア", "text": "村を守っていた名高い騎士は、\n魔王軍との戦いで村を離れていたそうです。\n異変を知って駆け戻った時には、もう……。", "face": "u2891a1"}, {"name": "ソーマ", "text": "……さっき私たちが見たのは、\nその時の出来事だったんですね。", "face": "u2178a1"}, {"name": "アルティア", "text": "村人たちを失った騎士は、悲嘆のあまり、\n自ら命を絶った……と、記されていました。", "face": "u2891a1"}, {"name": "アンナ", "text": "それで、守れなかった村で、\nあの日を繰り返していたのでしょうか……。"}, {"name": "ソーマ", "text": "あの方も、きっと誰かを守りたくて、\n剣を取ったんですよね。", "face": "u2178a1"}, {"name": "ミレイユ", "text": "王子、散り際の彼の目を見ましたか？", "face": "u2626a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ミレイユ", "text": "きっと、彼なりに整理がついたのでしょう。\nもしかしたら、王子が英雄王の末裔だと、\nあの短い戦いの中で気付いたのかもしれません。", "face": "u2626a1"}, {"name": "アンナ", "text": "…………。"}, {"name": "アンナ", "text": "王子、村が少しずつ、消えていきます。"}, {"name": "ソーマ", "text": "あっ、向こうに倒れてる人が。\nもしかして、行方不明になっていた方でしょうか？", "face": "u2178a1"}, {"name": "アリサ", "text": "…………！\nまだ息があります！\n他の方も急いで捜索しましょう！", "face": "u24"}, {"name": "アリシア", "text": "……どういうことだと思いますか？", "face": "u2558a1"}, {"name": "ミレイユ", "text": "彼も人々を殺したかったわけではないのでしょう。\n守るべき村に、外部からやってきた者がいたから、\n仕方なく閉じ込めていた、とか。", "face": "u2626a1"}]}], "active": true}