{"quest_id": 8125, "name": "白熱するコマ対決", "description": "新年早々、魔物退治にやってきた王子たち。\nそこではチェインソン男がゴールデン\nデーモンにコマ回しで勝負を挑んでいて！？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ32(2023)", "event_category": "Reproduce", "mission_id": 300416, "map_no": 4821, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 52000, "attack": 1500, "base_hp": 52000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 500, "magic_defense": 40, "attack_range": 150, "attack_speed": 150, "attack_wait": 50, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "pattern_id": 2103456, "race_id": 3, "special_effect_id": 242, "change_to": 1, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 36793, "global_id": 10410, "ranged": true, "variants": [{"hp": 52000, "attack": 6000, "base_hp": 52000, "base_attack": 6000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 40, "attack_speed": 50, "attack_wait": 50, "attack_interval": 245, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "pattern_id": 2103440, "race_id": 3, "special_effect_id": 242, "master_id": 36794, "global_id": 10411}]}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド", "機械"], "hp": 240000, "attack": 1200, "base_hp": 240000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "attack_speed": 1, "attack_wait": 150, "attack_interval": 466, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "pattern_id": 2129248, "special_effect_id": 1598, "master_id": 36795, "global_id": 10412}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142