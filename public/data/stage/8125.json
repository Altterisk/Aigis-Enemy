"base_hp": 28000, "base_attack": 50, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 50, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2149360, "special_effect_id": 1597, "master_id": 36790, "global_id": 10407}], "spawn_sec": 44}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 21000, "attack": 200, "base_hp": 21000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2149264, "special_effect_id": 1599, "change_to": 10, "change_condition": 1, "master_id": 36791, "global_id": 10408, "variants": [{"hp": 21000, "attack": 200, "base_hp": 21000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2149376, "special_effect_id": 1597, "master_id": 36792, "global_id": 10409}], "spawn_sec": 44}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 48000, "attack": 150, "base_hp": 48000, "base_attack": 150, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 50, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149248, "special_effect_id": 1599, "change_to": 12, "change_condition": 1, "master_id": 36796, "global_id": 10413, "variants": [{"hp": 48000, "attack": 150, "base_hp": 48000, "base_attack": 150, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 50, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149360, "special_effect_id": 1597, "master_id": 36797, "global_id": 10414}], "spawn_sec": 212}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 36000, "attack": 400, "base_hp": 36000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149264, "special_effect_id": 1599, "change_to": 14, "change_condition": 1, "master_id": 36798, "global_id": 10415, "variants": [{"hp": 36000, "attack": 400, "base_hp": 36000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149376, "special_effect_id": 1597, "master_id": 36799, "global_id": 10416}], "spawn_sec": 212}], "popups": ["ゴールデンデーモンと\nチェインソン男は\n拠点には向かわず、\nしばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "チェインソン男", "text": "あけましておめでとう！！\nハロウィンの時間だぁぁーーッ！！", "face": "lcb0e141aacc0"}, {"name": "コレット", "text": "ハロウィンじゃなくてお正月だろ……！", "face": "u1615a1"}, {"name": "ソーマ", "text": "村に魔物が出没したと報告を受けて来ましたが、\nあれが噂のチェインソン男ですか……。", "face": "u439"}, {"name": "ウィリアス", "text": "いや、それだけじゃないわ！\nみんな、あれを見て！", "face": "u1213a1"}, {"name": "ゴールデンデーモン", "text": "まったく、正月から騒がしい……。\nなにを騒いでいるというのかな？", "face": "l60babf46dddd"}, {"name": "コレット", "text": "なにっ、ゴールデンデーモン！？\nどうしてこんな場所に！？", "face": "u1615a1"}, {"name": "ソーマ", "text": "えっと、デモシェフさんのライバルの方、\n……とは違いますよね？", "face": "u439"}, {"name": "ハルモニア", "text": "はい。あれは確か、\n魔王軍で前線指揮官をしていたグレーターデーモンです。\n王国軍との戦闘経験はなかったかと。", "face": "u941"}, {"name": "ハルモニア", "text": "どうやら、さらなる力をつけて、\nゴールデンデーモンになったみたいですね。", "face": "u941"}, {"name": "ゴールデンデーモン", "text": "ワシは新年を穏やかに祝い、\nまったりと過ごしたいのだがね……。", "face": "l60babf46dddd"}, {"name": "コレット", "text": "そうだそうだ！\n年明け早々ハロウィンなんてやめろぉー！！", "face": "u1615a1"}, {"name": "チェインソン男", "text": "だったら俺と勝負しようぜゴールデンデーモンッ！\n勝負は正月らしくコマ回しでどうだぁ！", "face": "lcb0e141aacc0"}, {"name": "ゴールデンデーモン", "text": "ほう、魔王軍にいた頃、コマでブイブイ言わせてきた、\nこのワシに挑むとは……面白い。", "face": "l60babf46dddd"}, {"name": "ハルモニア", "text": "出ますか……！\nグレーターデーモン時代に磨いていた、\n超絶爆転コマ回しが……！", "face": "u941"}, {"name": "ウィリアス", "text": "（ハルモニア……昔の知り合いと会えて、\nテンションが上がってるのかな……）", "face": "u1213a1"}, {"name": "ソーマ", "text": "というかあのふたりの持っているコマ、\nすごく危険な見た目をしていますよ！\n止めないと村がめちゃくちゃになってしまいます！", "face": "u439"}, {"name": "シャルロット", "text": "見たところゴールデンデーモンのコマは防御型で、\nチェインソン男のコマは攻撃型ですわね！\nでも時間経過で回転数は落ち、勝手に止まりそうですわ！", "face": "u128"}, {"name": "アンナ", "text": "通りすがりのシャルロットさん！"}, {"name": "ハルモニア", "text": "ふたりに悪意はなさそうです。\nあのコマさえ止めれば、被害は収まるでしょう。", "face": "u941"}, {"name": "ウィリアス", "text": "コマだけ狙えばいいってわけね！\n新年早々だけど、村を守るために戦うわよ！", "face": "u1213a1"}, {"name": "チェインソン男", "text": "準備はいいかゴールデンデーモンッ！！", "face": "lcb0e141aacc0"}, {"name": "ゴールデンデーモン", "text": "愚問だね。\nさぁ、過酷なコマ回しをはじめるよ。", "face": "l60babf46dddd"}, {"name": "チェインソン男＆ゴールデンデーモン", "text": "３、２、１――ことよろォォォッ！！", "face": "l650ff481ac39"}]}, {"trigger": "end", "lines": [{"name": "ゴールデンデーモン", "text": "ワ、ワシのコマがぁーー！？", "face": "l60babf46dddd"}, {"name": "ウィリアス", "text": "よしっ！　コマが爆散したよ！", "face": "u1213a1"}, {"name": "チェインソン男", "text": "う、うわぁぁあぁぁああッ！？\n死んだぜッ！！", "face": "lcb0e141aacc0"}, {"name": "コレット", "text": "しゃあっ！　ついでにチェインソン男も爆散！", "face": "u1615a1"}, {"name": "ゴールデンデーモン", "text": "まさか、ワシの自慢のコマが破壊されるとはね……。", "face": "l60babf46dddd"}, {"name": "ハルモニア", "text": "それでもさすがの腕前でしたね。\nチェインソン男のコマと王国軍を同時に相手取るなんて。", "face": "u941"}, {"name": "ゴールデンデーモン", "text": "そう言ってくれると救われるよ。\nまぁ、コマは壊れてしまったけれど、\nなんだかんだで楽しい時間だったね。", "face": "l60babf46dddd"}, {"name": "ゴールデンデーモン", "text": "そうだ、お礼にポチ袋をあげようじゃないか。\nこれでコマでも買って遊ぶといい。", "face": "l60babf46dddd"}, {"name": "ウィリアス", "text": "ありがとう！　美味しいものをいっぱい食べるわ！", "face": "u1213a1"}, {"name": "ゴールデンデーモン", "text": "コマを買いたまえよ。", "face": "l60babf46dddd"}, {"name": "コレット", "text": "なんだっていいですけど、\nコマ回しで村がだいぶ荒れたので、\n直さないとまずいですよ。", "face": "u1615a1"}, {"name": "チェインソン男", "text": "チェーンソッソッソォッ！！\nもちろん村は直してくぜぇーッ！\n後片付けまでがコマ回しだからなぁ！", "face": "lcb0e141aacc0"}, {"name": "ゴールデンデーモン", "text": "ワシも手伝おう。\n修理においてもグレーターデーモンを超えていることを、\n皆に教えてあげようじゃないか。", "face": "l60babf46dddd"}, {"name": "コレット", "text": "まったく、騒がしいお正月ですね……。", "face": "u1615a1"}, {"name": "ウィリアス", "text": "でも、こんな正月も楽しくていいんじゃない？", "face": "u1213a1"}, {"name": "コレット", "text": "…………そうですね。", "face": "u1615a1"}, {"name": "コレット", "text": "いや、そうですかね……？", "face": "u1615a1"}]}], "story_talk": true, "active": true}