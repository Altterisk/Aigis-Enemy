{"quest_id": 8345, "name": "第八陣 冥界の庭師", "description": "同盟軍の作戦会議中、冥界の入り口付近で\n戦闘が発生。現場に駆けつけると思いも\nよらぬ人物が冥界軍と対峙していて……？\n神級（★１獲得の目安：平均Lv50）", "event": "帝国八陣", "event_category": "Empire", "mission_id": 940008, "map_no": 5061, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 1, "base_hp": 300000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 75, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2155072, "master_id": 37822, "global_id": 11439}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 1, "base_hp": 300000, "base_attack": 1, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2155104, "race_id": 16, "change_to": 2, "master_id": 37824, "global_id": 11441, "variants": [{"tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 1, "base_hp": 300000, "base_attack": 1, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2155280, "race_id": 16, "master_id": 37838, "global_id": 11455}], "sp_change_to": [37838]}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 1, "base_hp": 300000, "base_attack": 1, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 112, "move_speed": 600.0, "gain_