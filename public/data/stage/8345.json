}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}, {"enemy_id": 29, "source": "local", "count": 12, "form_count": 1, "hp": 20000, "attack": 2000, "base_hp": 20000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 321, "global_id": 320, "spawn_sec": 123}, {"enemy_id": 30, "source": "local", "count": 2, "form_count": 2, "hp": 25000, "attack": 2500, "base_hp": 25000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102928, "race_id": 8, "change_to": 30, "change_condition": 3, "master_id": 405, "global_id": 404, "to_condition": 3, "to_global_id": 405, "spawn_sec": 170}, {"enemy_id": 30, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 25000, "attack": 2500, "base_hp": 25000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102944, "race_id": 8, "master_id": 406, "global_id": 405, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――不本意ですね、これは。", "face": "u2245a1"}, {"name": "？？？", "text": "敵と遭遇したことが？\nそれとも、後輩の敵を取っちゃったことが？", "face": "u2248a1"}, {"name": "？？？", "text": "いいえ、こんなところで\n足止めを食らったことが、です。", "face": "u2245a1"}, {"name": "？？？", "text": "それはお互い様。\n私もこんなところで、\n帝国軍と遭遇するつもりはなかった。", "face": "u2250a1"}, {"name": "？？？", "text": "まぁ気にする必要はないか。\n遭遇戦は嫌いじゃないし。\nでも、ひとつ訂正が必要かな？", "face": "u2248a1"}, {"name": "ヘイズル", "text": "私はヘイズル。\n残念ながら「今の帝国軍」じゃない。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "現帝国軍に、私たちの名前はありませんから。\n申し遅れました、ヴィラヘルムです。\n死ぬまでの短い間ですが、お見知りおきを。", "face": "u2245a1"}, {"name": "スイゼ", "text": "……スイゼ。\nハイドース様の――庭師だ。", "face": "u2250a1"}, {"name": "ヘイズル", "text": "庭師を前線投入とは、\n冥界軍の人材不足も極まれり、かな？", "face": "u2248a1"}, {"name": "スイゼ", "text": "違う……私は……。", "face": "u2250a1"}, {"name": "スイゼ", "text": "私は、あの御方をお救いするために――", "face": "u2250a1"}]}, {"trigger": "battle", "at_sec": 5, "lines": [{"name": "ヘイズル", "text": "――おっと、時間切れだ。\n悪いねスイゼ、そろそろ主役交代みたいだ。", "face": "u2248a1"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "メーア", "text": "うおー！　どいたどいたー！\nそこの民間人さん大丈夫ですかー！！", "face": "u796"}, {"name": "クラーラ", "text": "ひ、ひとりで突出しすぎです……！\nちゃんと隊列をぉ！？", "face": "u420"}, {"name": "イザベル", "text": "いえ、このまま駆け抜けてください！\n冥界の兵と相対しているのはふたりだけ。\n魔物の姿も見える……一刻も早く救援に……！", "face": "u286"}, {"name": "ヘイズル", "text": "ほら、お望みの「帝国軍」のお出ましだ。", "face": "u2248a1"}, {"name": "スイゼ", "text": "……くっ。", "face": "u2250a1"}, {"name": "メーア", "text": "総員抜剣ー！！\n最近何か、みんな暗い顔してて嫌なんですよー！\nここらで大戦果、あげさせてもらいますからねー！！", "face": "u796"}]}, {"trigger": "end", "lines": [{"name": "スイゼ", "text": "…………急がないと。", "face": "u2250a1"}, {"name": "アグナ", "text": "むっ……さっきの娘はどこに逃げた？", "face": "u2251a1"}, {"name": "ルスティ", "text": "闘技場の有名人、アグナを見て逃げ出したんじゃない？\nって、それどころじゃないんよ！\nそこの人たちー！　だいじょぶー！？", "face": "u2247a1"}, {"name": "ヘイズル", "text": "大丈夫大丈夫、これくらいどうってことないよ。", "face": "u2248a1"}, {"name": "ルスティ", "text": "でも、あの、全身血に濡れて――", "face": "u2247a1"}, {"name": "ヘイズル", "text": "ああ、これは魔物の返り血。\nそれより、現皇帝はここに来てる？", "face": "u2248a1"}, {"name": "白の皇帝", "text": "…………俺だ。", "face": "u418"}, {"name": "ヘイズル", "text": "わぉ、本当に血の繋がりはなさそうだ。\nヴィラヘルムには全然似てないね。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "血の繋がりなど、国家にはどうでもいいことです。\n民の安寧を守っているかどうか、\n皇帝の存在意義とはそこに尽きます。", "face": "u2245a1"}, {"name": "白の皇帝", "text": "……失礼を承知で確認させてもらおう。", "face": "u418"}, {"name": "白の皇帝", "text": "初代白の皇帝、ヴィラヘルム殿。\nそしてそちらは、\n初代騎士団長ヘイズル殿とお見受けするが、いかに。", "face": "u418"}, {"name": "ヴィラヘルム", "text": "いかにも。", "face": "u2245a1"}, {"name": "ヘイズル", "text": "ご明察。", "face": "u2248a1"}, {"name": "ディアナ", "text": "（陛下は確認したけれど……。\nこれは、兵に対し周知するためでしょうね。\nあれはどう見ても本物……初代皇帝その人です）", "face": "u624"}, {"name": "メーア", "text": "（えっ、確認しなくても本物だって分かるんです？）", "face": "u796"}, {"name": "ディアナ", "text": "（ヴィラヘルム様は、\n崩御の際に、ふたつの神器を次代皇帝に継承しました）", "face": "u624"}, {"name": "ディアナ", "text": "（その折、アダマス様は神器の写しである大剣と大鎌を\nヴィラヘルム様に贈られたとのことですが――）", "face": "u624"}, {"name": "アウローラ", "text": "（それら、葬送の贈り物はこつ然と姿を消しました。\nアダマス様が残されたお言葉は……）", "face": "u711"}, {"name": "アウローラ", "text": "（――『もちろん、\n使うために持っていったのですよ』でしたか）", "face": "u711"}, {"name": "ディアナ", "text": "（歴史解釈に余地はあれど、それはつまり、\n初代皇帝はいつか帰ってくる、\n神器のレプリカを、その証拠とするという意味で……）", "face": "u624"}, {"name": "アウローラ", "text": "（国宝を模倣する馬鹿はいないし、\nそも、あの莫大な魔力量を再現できる職人はほぼいない。\n間違いありません、あれは皇帝と騎士団長、本人です）", "face": "u711"}, {"name": "ヘイズル", "text": "その解説、内緒話じゃなくて、大声で全員に\n聞こえるようにしてくれると助かるんだけどなぁ。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "それでは不要な不和を招くことになります。\n現皇帝の配慮を無駄にしないように。", "face": "u2245a1"}, {"name": "ヘイズル", "text": "……政治って面倒。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "その面倒も、後輩たちと、民のためです。\n――さて、今は\n詳しく話をする時間が惜しいところです。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "まずは急ぎ、帝国首都へ戻りましょう。\n手早く決闘も済ませてしまわないと。", "face": "u2245a1"}, {"name": "ルスティ", "text": "……ん、えっ、何だって？\n説明する時間が惜しいけど決闘はするって？", "face": "u2247a1"}, {"name": "ヘイズル", "text": "今の帝国には必要なことでしょ。\nとにかく、私たちは味方だから。\n遠慮なく全力で殺し合おう？", "face": "u2248a1"}, {"name": "白の皇帝", "text": "はぁ……。\n……ご配慮、痛み入る。", "face": "u418"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 30, "params": [50]}], "enemies": [{"enemy_id": 1, "hp": 390000, "attack": 1, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2155072}, {"enemy_id": 2, "hp": 390000, "attack": 1, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "pattern_id": 2155104}, {"enemy_id": 5, "hp": 390000, "attack": 1, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "pattern_id": 2155088}, {"enemy_id": 8, "hp": 106600, "attack": 1800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "pattern_id": 2155072}, {"enemy_id": 9, "hp": 1560, "attack": 390, "damage_type": "physical", "armor_defense": 80, "pattern_id": 2106320}, {"enemy_id": 9, "form_index": 1, "hp": 1560, "attack": 650, "damage_type": "physical", "armor_defense": 130, "pattern_id": 2106336}, {"enemy_id": 11, "hp": 1170, "attack": 150, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2106496}, {"enemy_id": 11, "form_index": 1, "hp": 1170, "attack": 150, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2106512}, {"enemy_id": 13, "hp": 7800, "attack": 1300, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2100144}, {"enemy_id": 14, "hp": 3900, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102544}, {"enemy_id": 14, "form_index": 1, "hp": 3900, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102560}, {"enemy_id": 16, "hp": 3250, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102576}, {"enemy_id": 16, "form_index": 1, "hp": 3250, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102592}, {"enemy_id": 18, "hp": 5200, "attack": 520, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102224}, {"enemy_id": 18, "form_index": 1, "hp": 5200, "attack": 780, "damage_type": "physical", "armor_defense": 450, "pattern_id": 2102240}, {"enemy_id": 20, "hp": 23400, "attack": 1040, "damage_type": "physical", "armor_defense": 500, "pattern_id": 2102672}, {"enemy_id": 20, "form_index": 1, "hp": 23400, "attack": 2080, "damage_type": "physical", "armor_defense": 700, "pattern_id": 2102688}, {"enemy_id": 22, "hp": 19500, "attack": 2600, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102640}, {"enemy_id": 22, "form_index": 1, "hp": 19500, "attack": 260