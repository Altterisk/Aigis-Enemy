 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 69}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 76}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 98}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 120}], "dialogue": [{"trigger": "start", "lines": [{"name": "ダークエルフ", "text": "――魔物ども、花びらは持ったな？", "face": "laf7c4466fda5"}, {"name": "ゴブリン", "text": "ギャッギャッ！　イクゾォ！！", "face": "lb55200ecaf72"}, {"name": "ダークエルフ", "text": "その意気やよし。\n花びらの力を分け与えてやるのだから、\nちゃんと我らの計画に協力するのだな。", "face": "laf7c4466fda5"}, {"name": "ダークエルフ", "text": "なにせその花びらは……ん？", "face": "laf7c4466fda5"}, {"name": "ファルネ", "text": "――みんな、花びらの力の気配が強くなってきたわ。\n花びらを持つ魔物に警戒して。", "face": "u640"}, {"name": "ダークエルフ", "text": "（あれは――王子たち！？\nなぜここに……いや、なぜ花びらの事を知っている？）", "face": "laf7c4466fda5"}, {"name": "ダークエルフ", "text": "（もしや、我らの計画を嗅ぎつけたのか……？）", "face": "laf7c4466fda5"}, {"name": "ダークエルフ", "text": "（それに、あの先頭の眼鏡の女はなんだ？\nなぜあんな動きづらそうな服を着ている？\nくっ……読めん。ヤツらはなにがしたいのだ？）", "face": "laf7c4466fda5"}, {"name": "ベラ", "text": "くんくん、くんくん……。\n王子王子、なんか魔物みたいなニオイがするぞ！", "face": "u16"}, {"name": "ダークエルフ", "text": "（……まぁいい。ここで始末すれば良いことだ）\n――魔物ども、出番だ。人間どもを排除しろ。", "face": "laf7c4466fda5"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "……チッ、しくじったか。\nおい、一旦引き上げるぞ！", "face": "laf7c4466fda5"}, {"name": "兵士", "text": "ダークエルフ、撤退していきます。", "face": "u6"}, {"name": "アンナ", "text": "なぜダークエルフがこんなところに……？", "face": "le9fe07963d6d"}, {"name": "ロザリー", "text": "また妖精郷を狙って\nなにかを企んでいるのでしょうか？", "face": "u117"}, {"name": "ローレン", "text": "……しかし妙だな。\n近頃は鳴りを潜めていたはずのヤツらが、\nどうして今になって活動しはじめたんだろう。", "face": "u118"}, {"name": "ファルネ", "text": "……ひとつ確かなのは、\nあたしたちが力を秘めた花びらを探しに来たら\nヤツらと遭遇したってことね。", "face": "u640"}, {"name": "アンナ", "text": "ダークエルフたちの活動は、\n私たちが探している花びらと\n関係があるのかもしれない、ということですか。", "face": "le9fe07963d6d"}, {"name": "ファルネ", "text": "……ヤツらが逃げていった方角に\n花びらの力が集まっている気配を感じるの。\n王子、どうする？", "face": "u640"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ファルネ", "text": "……わかった、行くのね。\nそれじゃあ、一緒に行って調べてみましょう。", "face": "u640"}]}], "active": true}