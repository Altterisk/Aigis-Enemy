global_id": 11436, "ranged": true, "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 33, "form_count": 1, "tags": ["帝国"], "hp": 5000, "attack": 550, "base_hp": 5000, "base_attack": 550, "damage_type": "physical", "armor_defense": 400, "attack_speed": 1, "attack_wait": 30, "attack_interval": 114, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2155120, "race_id": 16, "special_effect_id": 1795, "master_id": 37821, "global_id": 11438, "spawn_sec": 4}, {"enemy_id": 5, "source": "local", "count": 21, "form_count": 1, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 45, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111792, "race_id": 16, "master_id": 30637, "global_id": 4256, "spawn_sec": 55}, {"enemy_id": 6, "source": "local", "count": 15, "form_count": 1, "tags": ["アーマー", "帝国"], "hp": 3500, "attack": 250, "base_hp": 3500, "base_attack": 250, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 321, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113104, "race_id": 16, "change_to": 6, "change_condition": 1, "missile_id": 244, "missile": {"speed": 4.0, "splash": 53}, "master_id": 30775, "global_id": 4394, "ranged": true, "variants": [{"tags": ["アーマー", "帝国"], "hp": 3500, "attack": 250, "base_hp": 3500, "base_attack": 250, "damage_type": "physical", "armor_defense": 250, "attack_speed": 60, "attack_wait": 60, "attack_interval": 206, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113120, "race_id": 16, "master_id": 30776, "global_id": 4395}], "spawn_sec": 95}, {"enemy_id": 8, "source": "local", "count": 11, "form_count": 1, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "spawn_sec": 128}, {"enemy_id": 9, "source": "local", "count": 14, "form_count": 1, "tags": ["帝国"], "hp": 18000, "attack": 500, "base_hp": 18000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133056, "race_id": 16, "change_to": 9, "change_condition": 1, "missile_id": 26, "master_id": 34628, "global_id": 8245, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133264, "race_id": 16, "master_id": 34629, "global_id": 8246}], "spawn_sec": 143}], "popups": ["ヴィラヘルムがいる間は\n敵の帝国兵の攻撃力と\n防御力がアップします。\n\nまたヴィラヘルムがいる間は\n味方の防御力が半減します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴィラヘルム", "text": "――そも、此度の目覚めは想定外のものでした。", "face": "u2245a1"}, {"name": "ヘイズル", "text": "本当なら、ずっと眠っているつもりだったしね。\n今の世代がやると決めたことを、\n横から口出しするなんて趣味じゃないし。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "とはいえ、これはアダマス様との契約によるもの。\n目覚めた以上、\n不干渉を貫くのも不義理というものでしょう。", "face": "u2245a1"}, {"name": "レオナ", "text": "あなた方は、アダマス様の命によりここにいると？", "face": "u311"}, {"name": "ヘイズル", "text": "命令ってわけじゃないかな……。\nこれは契約、言葉を選ばないなら強制だよ。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "女神アダマスの肉体か魂、いずれかが失われた時、\n自動的に私たちは新たな肉体を得て、\n帝国の守護を担うという契約を結んでいたのです。", "face": "u2245a1"}, {"name": "ヘイズル", "text": "だけど、それは諸刃の剣だ。\n今の帝国じゃダメだから、\n昔の皇帝を連れてきてどうにかしようって話と同じ。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "私は、今の帝国を信じています。\n私たちが繋いだものを、民が子や孫に受け継いだ、\n今の時代の帝国そのものを信じているのです。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "だから、どうかその実力を見せてください。\nあなたたちこそが、白の帝国なのだと。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "――それでは、始めましょうか。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "初代白の皇帝、ヴィラヘルム！\n今代の皇帝に異議を唱える！", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "帝国法に則り、その首、ここにもらい受けよう！！", "face": "u2245a1"}, {"name": "白の皇帝", "text": "白の帝国を治めるは強き力によるもの。\nその実力をもって、\n奪えるものなら奪ってみせるがいい。", "face": "u418"}, {"name": "白の皇帝", "text": "待っていたぞ、簒奪者。\nその手を届かせてみせろ、この戦いこそ、\n歴史上最も苛烈なものであると示してみせろ。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "白の皇帝", "text": "――白の帝国こそが最強であると、\n貴様の血で証明しよう。", "face": "u418"}, {"name": "帝国市民", "text": "――陛下が、陛下が勝ったぞ！！", "face": "l4da0d2780662"}, {"name": "帝国商人", "text": "うぉぉぉッ！\n陛下！　白の皇帝陛下万歳！！", "face": "l65de89a60cda"}, {"name": "白の皇帝", "text": "……恥をかかせてしまったな。", "face": "u418"}, {"name": "ヴィラヘルム", "text": "いいえ、私たちの時代は遥か過去のもの。\nこの時代の糧となれるなら安いものです。", "face": "u2245a1"}, {"name": "ヘイズル", "text": "さてと……これでようやく本題に入れるね。", "face": "u2248a1"}, {"name": "ディアナ", "text": "本題、ですか？", "face": "u624"}, {"name": "ヴィラヘルム", "text": "ハイドースの儀式を止めに行くのでしょう？", "face": "u2245a1"}, {"name": "レオナ", "text": "それは……そうですが。\nご同行いただけるということですか？", "face": "u311"}, {"name": "ヘイズル", "text": "そんなケチなこと言わないよ。\n同行するだけが目的なら、\nわざわざこんな、大掛かりな決闘しないって。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "帝国全軍が揃った場所で、\nこの計画を実行する必要があったのです。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "アダマス様が私たちの魂を、\nこの世界にとどめておいた理由、\nそして帝国への助力を契約させた理由……。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "それは、ハイドースによる儀式を、\nいつの日か必ず実行されるその儀式を、\n完全に破壊するため。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "私たちが借り受けたアダマス様の力で、\n帝国主力全軍を『庭園』へ導きます。", "face": "u2245a1"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 19, "params": [150]}, {"kind": "term", "influence": 18, "params": [110]}], "enemies": [{"enemy_id": 1, "hp": 171600, "attack": 2400, "damage_type": "physical", "armor_defense": 1400, "magic_defense": 20, "pattern_id": 2155104}, {"enemy_id": 1, "form_index": 1, "hp": 171600, "attack": 2400, "damage_type": "physical", "armor_defense": 1400, "magic_defense": 20, "pattern_id": 2155104}, {"enemy_id": 3, "hp": 143000, "attack": 2800, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "pattern_id": 2155088}, {"enemy_id": 4, "hp": 6500, "attack": 715, "damage_type": "physical", "armor_defense": 400, "pattern_id": 2155120}, {"enemy_id": 5, "hp": 3250, "attack": 624, "damage_type": "physical", "armor_defense": 250, "pattern_id": 2111792}, {"enemy_id": 6, "hp": 4550, "attack": 250, "damage_type": "physical", "armor_defense": 250, "pattern_id": 2113104}, {"enemy_id": 8, "hp": 14300, "attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "pattern_id": 2108336}, {"enemy_id": 9, "hp": 23400, "attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133056}]}, "active": true}