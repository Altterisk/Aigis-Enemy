ttack": 350, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_to": 8, "change_condition": 4, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38792, "global_id": 12409, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 12410, "spawn_sec": 44}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 7000, "attack": 250, "base_hp": 7000, "base_attack": 250, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_to": 7, "change_condition": 4, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38793, "global_id": 12410, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 6000, "attack": 820, "base_hp": 6000, "base_attack": 820, "damage_type": "physical", "armor_defense": 220, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 205, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101248, "master_id": 227, "global_id": 226, "spawn_sec": 161}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 140000, "attack": 3500, "base_hp": 140000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 10, "attack_range": 60, "attack_speed": 115, "attack_wait": 100, "attack_interval": 279, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 232, "missile_id": 11, "master_id": 38085, "global_id": 11702, "ranged": true, "spawn_sec": 185}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 14000, "attack": 880, "base_hp": 14000, "base_attack": 880, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 100, "attack_interval": 335, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160752, "race_id": 11, "master_id": 38811, "global_id": 12428, "spawn_sec": 195}], "popups": ["スノースパイダーは\nニ種類の攻撃を交互に行います。\n\nスノースパイダーから\n物理の遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ファオル", "text": "だ、だめです、まったく話を聞いてくれません……。", "face": "u2513a1"}, {"name": "ユリクセス", "text": "戦闘を避けて下がるにも限界がある。\nこれより先は市街地だぞ。", "face": "u2193a1"}, {"name": "フラフィー", "text": "わ、私も、説得してみます。\nたぶん……あの子が心配してるのは、\nファオルさんが白い獣人だからだと思うので……。", "face": "u811"}, {"name": "セブン", "text": "……大丈夫か？", "face": "u449"}, {"name": "フラフィー", "text": "はい、もう立ち直りましたから。\nみなさんのおかげです。", "face": "u811"}, {"name": "セブン", "text": "ん、分かった。", "face": "u449"}, {"name": "フラフィー", "text": "すぅー、はぁ……。", "face": "u811"}, {"name": "フラフィー", "text": "あのー！　マーたん？　マーさん？\nきいてくださいー！", "face": "u811"}, {"name": "マータン", "text": "マータン様と呼べ！", "face": "ld70a1c5d8714"}, {"name": "フラフィー", "text": "ま、まーたんさま！\n私の毛並みを！　みてくださーい！", "face": "u811"}, {"name": "マータン", "text": "むっ……お、お前も白い獣人！\n同郷……じゃなさそうだけど……。\nとにかくこっちへ来い！　さらわれるぞー！", "face": "ld70a1c5d8714"}, {"name": "フラフィー", "text": "さ、さらわれてません！\n私は、この人たちに助けてもらったんですー！", "face": "u811"}, {"name": "ファオル", "text": "……そうだったんだ。", "face": "u2513a1"}, {"name": "フラフィー", "text": "確かに悪い人はいますし、\n白い獣人が狙われているのも事実ですが――", "face": "u811"}, {"name": "フラフィー", "text": "この人たちが、私を助けてくれたのも事実なんです！", "face": "u811"}, {"name": "マータン", "text": "信じられるかー！\nっていうかー！　別に白くない子もさらわれるぞ！\n里の外は危険だってばっちゃが言ってたー！", "face": "ld70a1c5d8714"}, {"name": "ファオル", "text": "マータンは、頭が硬いんだ……。", "face": "u2513a1"}, {"name": "フラフィー", "text": "う、うぅ、どうしたら……。", "face": "u811"}, {"name": "ファオル", "text": "でも、頭がかたい分、\nちゃんと筋は通す子だ。", "face": "u2513a1"}, {"name": "マータン", "text": "だから、実力で試させてもらう！\nその剣が真実を語るはずだ！", "face": "ld70a1c5d8714"}, {"name": "マータン", "text": "――我が名はマータン！\n誇り高き白熊の戦士！　いざ尋常にがおー！！", "face": "ld70a1c5d8714"}]}, {"trigger": "end", "lines": [{"name": "マータン", "text": "…………。", "face": "ld70a1c5d8714"}, {"name": "ファオル", "text": "マータン、分かってくれた？", "face": "u2513a1"}, {"name": "マータン", "text": "いや、わかんない。", "face": "ld70a1c5d8714"}, {"name": "ファオル", "text": "まーたぁん！", "face": "u2513a1"}, {"name": "マータン", "text": "でも、嘘は言ってない。\nマータンはそういうとこ信じるタイプ。", "face": "ld70a1c5d8714"}, {"name": "マータン", "text": "でも、他の集落で\n本当に人さらいの被害が出てるのは事実。\n白いとか黒いとか関係なくな。", "face": "ld70a1c5d8714"}, {"name": "アンナ", "text": "なるほど、だからここまで警戒を……。", "face": "lc62e59cd6445"}, {"name": "マータン", "text": "それで、お前たち、ファオルに何の用だ。\nただ親切にしたくて親切にするようなやつは、\nだいたい悪いやつなんだ。何かあるんだろ！", "face": "ld70a1c5d8714"}, {"name": "シビラ", "text": "私たちは、北限の――いえ、\n「狭間の雪原」を超えたいの。", "face": "u39"}, {"name": "シビラ", "text": "そしてその先に、\n会わなければならない人がいるの。", "face": "u39"}, {"name": "マータン", "text": "……宿敵か？", "face": "ld70a1c5d8714"}, {"name": "シビラ", "text": "……今はまだ、\n対話のできる余地があると思ってる。", "face": "u39"}, {"name": "マータン", "text": "対話を諦めないのはいいことだ。\nマータン、そういうの好きだ。", "face": "ld70a1c5d8714"}, {"name": "マータン", "text": "……ついてこい。\nお前たちが悪いやつじゃないのは分かった。\nでも、マータンひとりで決められることじゃない。", "face": "ld70a1c5d8714"}, {"name": "ファオル", "text": "マータン……ありがとう。", "face": "u2513a1"}, {"name": "マータン", "text": "――ただし、ついてこられる者だけだ！\nさぁ行くぞ！　マータンダッシュ！！", "face": "ld70a1c5d8714"}, {"name": "アンナ", "text": "えっ……。\nみ、皆さん出立準備を！　彼女を追いましょう！", "face": "lc62e59cd6445"}]}], "active": true}