{"quest_id": 8637, "name": "誇り高き白熊の戦士", "description": "王子一行が誘拐犯という誤解を解くため、\n白熊の獣人との戦いに勝利して力を示せ！\n＜特定のタイミングで吹雪が発生＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "導きの白狼", "event_category": "History", "mission_id": 920236, "map_no": 9385, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 94000, "attack": 2250, "base_hp": 94000, "base_attack": 2250, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 5, "attack_interval": 52, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2162400, "race_id": 12, "special_effect_id": 1040, "master_id": 39002, "global_id": 12619, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 32, "form_count": 1, "hp": 7000, "attack": 550, "base_hp": 7000, "base_attack": 550, "damage_type": "physical", "armor_defense": 240, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 45, "attack_interval": 139, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2162368, "race_id": 12, "special_effect_id": 1415, "change_to": 2, "change_condition": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 39000, "global_id": 12617, "ranged": true, "variants": [{"hp": 7000, "attack": 750, "base_hp": 7000, "base_attack": 750, "damage_type": "physical", "armor_defense": 240, "magic_defense": 10, "attack_speed": 5, "attack_wait": 20, "attack_interval": 76, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2162384, "race_id": 12, "master_id": 39001, "global_id": 12618}], "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 22, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "a