"attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 6875, "attack": 1125, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 108}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "魔物を追って海に出たものの……。\n陸地はいったいどちらでしょう？", "face": "l59b0427b1197"}, {"name": "ヒカゲ", "text": "お待ちください。\nこの潮の香りは……覚えがありますわ！\nもしかしたら、このあたりは……！", "face": "u233"}, {"name": "カグヤ", "text": "ふむ？\n確かにわたしも知っている風の匂いだの？\n……あっ！", "face": "u191"}, {"name": "アンナ", "text": "あれは、大陸？\nいえ、半島か、大きな島影でしょうか？", "face": "lfcdca8f6add3"}, {"name": "ヒカゲ", "text": "ま、間違いございませんわ、姫様！\nあの石積みの港は、わたくしたちの故郷の……！\nまさか潮に流されて、郷里にまで戻ってくるなんて！", "face": "u233"}, {"name": "王子", "text": "あれが、カグヤたちの故郷の、東の国……？", "face": "u1"}, {"name": "カグヤ", "text": "そうだぞ王子。よもやこんな奇遇なことがあろうとは。\nちょうどいい。\n港に船を寄せて、しばし休息といこうではないか。", "face": "u191"}, {"name": "カグヤ", "text": "もちろん、わたしの国で子作りというのもありだの？\nふふふ。", "face": "u191"}, {"name": "カグヤ", "text": "ふむ、しかし……いざ近づいてみれば、\nここはわたしのいた西の京ではないの？", "face": "u191"}, {"name": "ヒカゲ", "text": "おそらくは南か東の都の近く、でございますね。姫様。\n……！？　おかしいですわ、人の気配がない？\nあっ！", "face": "u233"}, {"name": "アンナ", "text": "王子！　あれは、魔物です！\nまさかこんな東方にまで、魔物の手が……！", "face": "lfcdca8f6add3"}, {"name": "カグヤ", "text": "いや、あれは鬼どもかの？\nこの国に古くからいるという、物の怪の類だぞ？\nしかし人里に下りてくることなどないはずだが……！", "face": "u191"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 25, "params": [300], "expression": "IsRearguard() && !IsClassType(102,302);", "expression_human": "it is a ranged unit and its class type is not one of 102 / 302"}], "enemies": [{"enemy_id": 1, "hp": 2100, "attack": 690, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2099312}, {"enemy_id": 2, "hp": 4500, "attack": 1125, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2099328}, {"enemy_id": 3, "hp": 3000, "attack": 1500, "damage_type": "magical", "armor_defense": 250, "magic_defense": 40, "pattern_id": 2099504}, {"enemy_id": 3, "form_index": 1, "hp": 3000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "pattern_id": 2099520}, {"enemy_id": 5, "hp": 8250, "attack": 1350, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "pattern_id": 2099344}]}, "story_talk": true, "active": true}