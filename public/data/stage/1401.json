ocal", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "base_hp": 2000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 60, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6875, "attack": 1125, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 108}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "魔物を追って海に出たものの……。\n陸地はいったいどちらでしょう？", "face": "l59b0427b1197"}, {"name": "ヒカゲ", "text": "お待ちください。\nこの潮の香りは……覚えがありますわ！\nもしかしたら、このあたりは……！", "face": "u233"}, {"name": "カグヤ", "text": "ふむ？\n確かにわたしも知っている風の匂いだの？\n……あっ！", "face": "u191"}, {"name": "アンナ", "text": "あれは、大陸？\nいえ、半島か、大きな島影でしょうか？", "face": "lfcdca8f6add3"}, {"name": "ヒカゲ", "text": "ま、間違いございませんわ、姫様！\nあの石積みの港は、わたくしたちの故郷の……！\nまさか潮に流されて、郷里にまで戻ってくるなんて！", "face": "u233"}, {"name": "王子", "text": "あれが、カグヤたちの故郷の、東の国……？", "face": "u1"}, {"name": "カグヤ", "text": "そうだぞ王子。よもやこんな奇遇なことがあろうとは。\nちょうどいい。\n港に船を寄せて、しばし休息といこうではないか。", "face": "u191"}, {"name": "カグヤ", "text": "もちろん、わたしの国で子作りというのもありだの？\nふふふ。", "face": "u191"}, {"name": "カグヤ", "text": "ふむ、しかし……いざ近づいてみれば、\nここはわたしのいた西の京ではないの？", "face": "u191"}, {"name": "ヒカゲ", "text": "おそらくは南か東の都の近く、でございますね。姫様。\n……！？　おかしいですわ、人の気配がない？\nあっ！", "face": "u233"}, {"name": "アンナ", "text": "王子！　あれは、魔物です！\nまさかこんな東方にまで、魔物の手が……！", "face": "lfcdca8f6add3"}, {"name": "カグヤ", "text": "いや、あれは鬼どもかの？\nこの国に古くからいるという、物の怪の類だぞ？\nしかし人里に下りてくることなどないはずだが……！", "face": "u191"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 25, "params": [300], "expression": "IsRearguard() && !IsClassType(102,302);"}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 2100, "attack": 690, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2099312}, {"enemy_id": 2, "form_index": 0, "hp": 4500, "attack": 1125, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2099328}, {"enemy_id": 3, "form_index": 0, "hp": 3000, "attack": 1500, "damage_type": "magical", "armor_defense": 250, "magic_defense": 40, "pattern_id": 2099504}, {"enemy_id": 3, "form_index": 1, "hp": 3000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "pattern_id": 2099520}, {"enemy_id": 5, "form_index": 0, "hp": 8250, "attack": 1350, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "pattern_id": 2099344}]}, "map": {"image": "Map1051", "w": 960, "h": 640, "spots": [{"k": "b", "x": 863, "y": 302}, {"k": "m", "x": 617, "y": 420, "id": 200}, {"k": "m", "x": 764, "y": 320, "id": 201}, {"k": "m", "x": 288, "y": 389, "id": 202}, {"k": "m", "x": 592, "y": 195, "id": 203}, {"k": "m", "x": 399, "y": 175, "id": 204}, {"k": "m", "x": 179, "y": 328, "id": 205}, {"k": "m", "x": 67, "y": 244, "id": 206}, {"k": "m", "x": 546, "y": 344, "id": 207}, {"k": "m", "x": 687, "y": 251, "id": 208}, {"k": "m", "x": 175, "y": 172, "id": 209}, {"k": "m", "x": 398, "y": 318, "id": 210}, {"k": "m", "x": 847, "y": 384, "id": 211}, {"k": "m", "x": 706, "y": 478, "id": 212}, {"k": "m", "x": 289, "y": 102, "id": 213}, {"k": "m", "x": 676, "y": 139, "id": 214}, {"k": "m", "x": 505, "y": 247, "id": 215}, {"k": "r", "x": 368, "y": 395, "id": 300}, {"k": "r", "x": 530, "y": 290, "id": 301}, {"k": "r", "x": 687, "y": 192, "id": 302}, {"k": "r", "x": 447, "y": 345, "id": 303}, {"k": "r", "x": 754, "y": 150, "id": 304}, {"k": "r", "x": 749, "y": 406, "id": 305}, {"k": "r", "x"