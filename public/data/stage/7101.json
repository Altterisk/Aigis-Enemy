st": 100, "transform_resist": 100, "pattern_id": 2123904, "race_id": 2, "special_effect_id": 232, "change_to": 8, "change_condition": 4, "missile_id": 476, "master_id": 32700, "global_id": 6318, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6319, "spawn_sec": 37}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 87, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123920, "race_id": 2, "master_id": 32701, "global_id": 6319, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 2800, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 69}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 42, "global_id": 41, "ranged": true, "spawn_sec": 116}], "popups": ["ドラコレックスは味方ユニットを\n発見すると、咆哮を行います。\n咆哮を受けた味方ユニットは\n麻痺状態になります。\n\nまた、咆哮後\n移動速度が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マオ", "text": "お、王子！　見てください！\n巨大なドラゴンが２頭もいます！", "face": "u361"}, {"name": "ナナリー", "text": "ドラゴン、喧嘩……？\n戦っているみたい……。", "face": "u29"}, {"name": "クローディア", "text": "ドラコレックスは\n激しい闘争本能を持っていると聞きます。\n縄張り争いをしているのかもしれませんね。", "face": "u163"}, {"name": "レギーナ", "text": "しかしそろそろ決着がつきそうだな。\n片方はもうボロボロじゃないか。", "face": "u1045a1"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "レギーナ", "text": "くっ……なんて咆哮だ……！\n聞いただけで体が痺れるようだ。", "face": "u1045a1"}, {"name": "クローディア", "text": "どうやら、あのドラコレックスも\n私たちに気付いたようです。\nこちらへ向かってきますよ……！", "face": "u163"}, {"name": "レギーナ", "text": "王子、あいつは同族との決闘で\n傷を負っているみたいだ。", "face": "u1045a1"}, {"name": "レギーナ", "text": "だが、その闘争本能までは消えていない。\n奴がこちらを値踏みしている、\n今がハンティングチャンスだぞ！", "face": "u1045a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "レギーナ", "text": "よし、狩猟開始だ……ッ！！", "face": "u1045a1"}]}, {"trigger": "end", "lines": [{"name": "レギーナ", "text": "ふぅ……ドラコレックス、討ち取った……！！", "face": "u1045a1"}, {"name": "オーガスタ", "text": "これだけのお肉があれば、\nお祭りだけでなく、備蓄にも回せそうですね。\nふふふ、料理人の腕がなるというものです。", "face": "u960"}, {"name": "レギーナ", "text": "だが、まだまだ食材が足りない。\nそうじゃないか、オーガスタ？", "face": "u1045a1"}, {"name": "オーガスタ", "text": "……ごくり。\nまさか、まだ他にも食材を確保するおつもりで……？", "face": "u960"}, {"name": "レギーナ", "text": "当然だとも！\n何しろここはグルメジャングルなんだからな。\n王国に山のような食材を持って帰るぞ！", "face": "u1045a1"}, {"name": "オーガスタ", "text": "良いでしょう。\nその挑戦、受けて立ちますとも！", "face": "u960"}, {"name": "アンナ", "text": "……食材を集めるのは良いですが、\nちゃんとお祭りの日までに帰還しましょうね？", "face": "l91608c77d1e3"}, {"name": "アンナ", "text": "ともあれ、王子、此度の\nドラコレックス狩猟作戦、お疲れさまでした！"}]}], "active": true}