mor_defense": 75, "magic_defense": 10, "attack_range": 400, "attack_speed": 15, "attack_wait": 135, "attack_interval": 336, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108784, "race_id": 16, "missile_id": 26, "master_id": 30105, "global_id": 3724, "ranged": true, "spawn_sec": 38}, {"enemy_id": 5, "source": "local", "count": 9, "form_count": 1, "tags": ["サムライ"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099952, "race_id": 16, "master_id": 207, "global_id": 206, "spawn_sec": 68}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "hp": 1000, "attack": 320, "base_hp": 1000, "base_attack": 320, "damage_type": "physical", "armor_defense": 170, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 16, "master_id": 31164, "global_id": 4783, "spawn_sec": 164}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 15, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115376, "race_id": 16, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 31160, "global_id": 4779, "ranged": true, "spawn_sec": 181}], "popups": ["陰陽師コヨミのいる間は、\n味方ユニットの防御力と魔法耐性が、\n『30%』低下します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "カズハ", "text": "茨木童子を演じている紅牡丹さん、\nかっこよかったですよねぇ……。", "face": "u235"}, {"name": "イロハ", "text": "分かります……！\nさすがは名高い『千両かぶき姫』ですよね！", "face": "u242"}, {"name": "紅牡丹", "text": "うううっ、やめろってんだい！\n目の前で褒められると恥ずかしくなっちまうだろう？", "face": "u661"}, {"name": "紅牡丹", "text": "それより、次の稽古だ！\nみんな、準備はいいかい？", "face": "u661"}, {"name": "イロハ", "text": "次はどんな場面の練習をするのですか？", "face": "u242"}, {"name": "紅牡丹", "text": "妖怪に与した悪人どもの隠れ家に、\nたった三人の強者が乗り込んで、\nばったばったとなぎ倒していく激しい場面さ。", "face": "u661"}, {"name": "アオバ", "text": "なるほど、激しい場面ですか……。\nそれでしたら、悪役側を演じても良いでしょうか？", "face": "u441"}, {"name": "コヨミ", "text": "つまり見せ場ということよね……。\nそれなら私も悪役側を演じようかしら♪", "face": "u471"}, {"name": "紅牡丹", "text": "おや、良いのかい？\n精鋭三人を相手にするなら、\n妖怪側にも手練がもっと欲しいと思ってたんだ。", "face": "u661"}, {"name": "紅牡丹", "text": "さぁて、殺陣とはいえ、三人だけで\n多数の敵を相手にすることになるからね、\n王子はとびっきり腕の立つ子を選んでくれよ？", "face": "u661"}, {"name": "アンナ", "text": "舞台に立てるのは三人だけ……。\n王子、配役には慎重を期してくださいね。", "face": "l773934036516"}]}, {"trigger": "battle", "at_sec": 183, "lines": [{"name": "紅牡丹", "text": "随分と騒がしいとォ思えばッ、\nいつぞやの……アッ、人間共じゃ～ねェか！", "face": "u661"}, {"name": "紅牡丹", "text": "この茨木童子サマとて、\n堪忍袋の緒もォ、切れようってェ～もんだ！", "face": "u661"}, {"name": "紅牡丹", "text": "この日この場所で、\nアッ、我が前にィ立ちふさがった事！\n後悔の渦中にてェ、アッ、散るが～よいィッ！！", "face": "u661"}]}, {"trigger": "end", "lines": [{"name": "アオバ", "text": "ふぅ、殺陣とはいえ、\n王国の精鋭を相手にすると中々に疲れますね……。", "face": "u441"}, {"name": "コヨミ", "text": "ふふ、でも素敵な演技だったわ。\nアオバのお師匠さんも気に入ったんじゃないかしら♪", "face": "u471"}, {"name": "アオバ", "text": "い、いえっ、これは修行で……！\n良いところを見せようなどというつもりは……！！", "face": "u441"}, {"name": "イロハ", "text": "あ、紅牡丹さんが戻ってきましたよ。", "face": "u242"}, {"name": "紅牡丹", "text": "ふっふっふ……最っ高だ！\n皆このまま一座に入ってほしいくらいだよ！", "face": "u661"}, {"name": "アンナ", "text": "嬉しいお言葉ですが、\n私達には成すべきことがありますので……。"}, {"name": "紅牡丹", "text": "ははっ、分かってるさ。\n一公演だけって約束だったからねぇ。", "face": "u661"}, {"name": "紅牡丹", "text": "でも、これなら本番もきっと大成功だ。\nやはり私の目は間違ってなかった！\nさてさて、当日まで気を抜かずに稽古を続けようか！", "face": "u661"}]}], "active": true}