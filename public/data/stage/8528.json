"hp": 8200, "attack": 300, "base_hp": 8200, "base_attack": 300, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127792, "race_id": 21, "change_to": 43, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 22163, "global_id": 2446, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 2449, "spawn_sec": 213}, {"enemy_id": 43, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 8200, "attack": 600, "base_hp": 8200, "base_attack": 600, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127808, "race_id": 21, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 22166, "global_id": 2449, "ranged": true, "from_condition": 4, "trigger_ticks": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "トラム", "text": "――転移、した？\nいえ、最初からここに繋がるようになっていたの？", "face": "u1110a1"}, {"name": "ルイン", "text": "……あの墓地と同じ気配がします。\n無数の死の記憶が、空間を歪めているんです。", "face": "u1180a1"}, {"name": "白の皇帝", "text": "数日前から、喚ばれているような気はしていた。", "face": "u418"}, {"name": "白の皇帝", "text": "貴様らも、似たようなものだろう？", "face": "u418"}, {"name": "ダーク王子", "text": "……ああ。", "face": "u1831a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "白の皇帝", "text": "ハイドースの残留思念かと思っていたが、\nどうやら、仕掛け人は違ったらしい。", "face": "u418"}, {"name": "リンクス", "text": "この匂いは……もしかして、ペルセフォネの……？", "face": "u1561a1"}, {"name": "白の皇帝", "text": "ハイドースが負けたことを\n受け入れられなかったのだろう。", "face": "u418"}, {"name": "ダークアンナ", "text": "……いいえ。", "face": "u1832a1"}, {"name": "ダークアンナ", "text": "良き妻とは、夫の敗北も含めて受け止めるもの。", "face": "u1832a1"}, {"name": "ダークアンナ", "text": "きっと彼女は、もう一度だけ、\n何のしがらみもない戦いをさせてあげたいのでしょう。", "face": "u1832a1"}, {"name": "ダークアンナ", "text": "世界も、生命も、悲しみも、\n何もかも関係ない、神と戦士の戦いを。", "face": "u1832a1"}, {"name": "ヘカティエ", "text": "……呆れたものね。\nでも、昔より、今のあり方のほうが好きになれそうよ。", "face": "u1226a1"}, {"name": "ハイドース", "text": "――ほう。", "face": "lce51ca3fb3ba"}, {"name": "ハイドース", "text": "ヘカティエよ、我が妻を、\n昔は嫌いだったと言いたいのか？", "face": "lce51ca3fb3ba"}, {"name": "ヘカティエ", "text": "別に。今の方が、\n恋する乙女みたいで可愛いって思っただけよ。", "face": "u1226a1"}, {"name": "ハイドース", "text": "お前もいい顔をするようになった。\n戦いの最中では、なかなか気付かなかったが。", "face": "lce51ca3fb3ba"}, {"name": "ヘカティエ", "text": "放っておいて！", "face": "u1226a1"}, {"name": "白の皇帝", "text": "――では、やるか。", "face": "u418"}, {"name": "ハイドース", "text": "ああ。\n殺し合いを始めよう。", "face": "lce51ca3fb3ba"}, {"name": "トラム", "text": "タルタロスの魔力が、ハイドースに流れ込んでいく。\n失われていた権能が、戻っていくわ。", "face": "u1110a1"}, {"name": "ルイン", "text": "これが……大神ハイドースの、本当の力。", "face": "u1180a1"}, {"name": "ハイドース", "text": "戦士たちよ、安心して死ぬがよい。\n冥界は我が領土、永遠の安寧を授けようぞ。", "face": "lce51ca3fb3ba"}, {"name": "白の皇帝", "text": "――死ぬつもりはない。\n二度目の敗北を味わえ、大神ハイドース！", "face": "u418"}]}], "map": {"image": "Map5073", "w": 960, "h": 640, "spots": [{"k": "b", "x": 94, "y": 489}, {"k": "m", "x": 119, "y": 401, "id": 200}, {"k": "m", "x": 181, "y": 363, "id": 201}, {"k": "m", "x": 230, "y": 486, "id": 202}, {"k": "m", "x": 295, "y": 445, "id": 203}, {"k": "m", "x": 245, "y": 327, "id": 204}, {"k": "m", "x": 291, "y": 202, "id": 205}, {"k": "m", "x": 311, "y": 288, "id": 206}, {"k": "m", "x": 358, "y": 407, "id": 207}, {"k": "m", "x": 425, "y": 368, "id": 208}, {"k": "m", "x": 490, "y": 237, "id": 209}, {"k": "m", "x": 458, "y": 138, "id": 210}, {"k": "m", "x": 537, "y": 182, "id": 211}, {"k": "m", "x": 616, "y": 228, "id": 212}, {"k": "m", "x": 497, "y": 326, "id": 213}, {"k": "m", "x": 578, "y": 372, "id": 214}, {"k": "m", "x": 668, "y": 394, "id": 215}, {"k": "m", "x": 693, "y": 275, "id": 216}, {"k": "m", "x": 244, "y": 137, "id": 217}, {"