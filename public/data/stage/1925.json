{"quest_id": 1925, "name": "海神ポセイオス", "description": "海中神殿へと辿り着いた王子は、大地を\n呑み込まんとする海の神との決戦に挑む。\n＜深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション11", "event_category": "Story", "mission_id": 100011, "map_no": 1145, "level": 100, "multiplier": 1.0, "charisma": 54, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 2, "tags": ["アーマー", "置物"], "fixture": true, "hp": 10, "attack": 300, "base_hp": 10, "base_attack": 300, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 50, "attack_speed": 1, "attack_wait": 90, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "pattern_id": 2136528, "special_effect_id": 623, "change_to": 1, "change_condition": 2, "master_id": 34855, "global_id": 8472, "to_condition": 2, "to_global_id": 8473}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "置物"], "fixture": true, "hp": 180000, "attack": 6000, "base_hp": 180000, "base_attack": 6000, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 50, "attack_range": 400, "attack_speed": 1, "attack_wait": 90, "attack_interval": 241, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "pattern_id": 2136544, "special_effect_id": 623, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 34856, "global_id": 8473, "ranged": true, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 3, "tags": ["水棲"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 376, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.39999997