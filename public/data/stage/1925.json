_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136448, "master_id": 34850, "global_id": 8467, "spawn_sec": 144}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 120, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "change_to": 11, "change_condition": 4, "missile_id": 710, "master_id": 34857, "global_id": 8474, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 8475, "route_behaviour": {"calls_event": [2159, 2160, 2161, 2162, 2163, 2164]}, "spawn_sec": 275}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 160, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "change_to": 12, "change_condition": 4, "missile_id": 710, "master_id": 34858, "global_id": 8475, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 8476}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 2, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 200, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "change_to": 13, "change_condition": 4, "missile_id": 710, "master_id": 34859, "global_id": 8476, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 8477}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 3, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 240, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "change_to": 14, "change_condition": 4, "missile_id": 710, "master_id": 34860, "global_id": 8477, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 8478}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 4, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 280, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "change_to": 15, "change_condition": 4, "missile_id": 710, "master_id": 34861, "global_id": 8478, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 8479}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 5, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 320, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "missile_id": 710, "master_id": 34862, "global_id": 8479, "ranged": true, "from_condition": 4, "trigger_ticks": 1}], "popups": ["亜神ポセイオスは攻撃を行うたび、\n射程がアップしていきます。\n\n５回目の攻撃後、\n射程が最大になります。\n※６回目以降の射程が最大\n\n　　　　　　(1/3)", "亜神ポセイオスの攻撃を受けると\n「水の檻」状態になり、\n攻撃後の待ち時間が増加します。\nまた一定時間\n継続ダメージを受けます。\n\n\n　　　　　　(2/3)", "「水の檻」は\n深海の影響に対する\nユニット能力で\n軽減、無効化が可能です。\n\n\n\n　　　　　　(3/3)"], "dialogue": [{"trigger": "start", "lines": [{"name": "ポセイオス", "text": "……ほう、存外早い到着じゃなあ。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "そうか、メシナが手引きしたな？\nグワッハッハッハ！　我が娘ながら豪胆よのぉ！", "face": "l7d6479df1740"}, {"name": "リーンベル", "text": "ポセイオス、貴様の企みはここまでだ。\n陰謀とは、知られた時点で失敗なのだからな。", "face": "u268"}, {"name": "ポセイオス", "text": "陰謀？　失敗？\nこれだから溺れる民どもは……。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "我が儀式は、既に動き始めた。\nお前たちがどう足掻こうとも、\nもはや勝利は揺るがぬと知るがよいわ！", "face": "l7d6479df1740"}, {"name": "デューオ", "text": "なっ……王子、\nポセイオスが握っているの、神の楔じゃないか！？", "face": "u594"}, {"name": "ポセイオス", "text": "……かつて、アトランティスの民は、\n我が寵愛をもとめ、その証として神の楔を望んだ。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "だが、溺れる民にその権能を渡せば、\nよからぬ企みに使うに決まっておろう？", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "それゆえ、我が手に再び収まるその時まで、\n何の力も発さぬよう、\n幾重にも封印を施してやったのじゃ。", "face": "l7d6479df1740"}, {"name": "デューオ", "text": "アトランティス……やっぱり、\nこの神殿は、伝説上の沈んだ都市……っ！？", "face": "u594"}, {"name": "ポセイオス", "text": "グワッハッハッハ！\nあの都市がこんな小さなものであるものかッ！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "この神殿など、\n傲慢と欺騙に溺れた哀れな都市の、\nほんの一部に過ぎんわッ！！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "だが、都市の美しさは我が寵愛を\n受けるに値するものであった。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "ゆえに、こうして来るべき日まで封印し、\n我がものとして復活せんと狙っておったのだ。", "face": "l7d6479df1740"}, {"name": "トラム", "text": "傲慢なのは、どちらの方ですか！\n人の生きた証を、いったい何だと……！", "face": "u1110a1"}, {"name": "ポセイオス", "text": "人の生きた証、良い響きだ……。\nそれもまた、我が収集物としてやろう。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "その最後の飾りとして、\n王子を添えてやるのも悪くないのぅ！", "face": "l7d6479df1740"}, {"name": "デューオ", "text": "――な、なんだこの振動。\n海底が動いて……うわわっ！？", "face": "u594"}, {"name": "ポセイオス", "text": "グワッハッハッハ！　さぁ始まったぞ！\n神の楔が封じていた都市が目覚める時だ！！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "封印解除の余波、その身に感じられよう。\n巨大なる都市ひとつを隠すほどの海流、\n解き放たれれば地上など海の底じゃ！！", "face": "l7d6479df1740"}, {"name": "フローガ", "text": "お、王子殿下、こ、これ、本当にまずいです！\n神の楔から解放された魔力が、\n全方位の海へ向けて伝播しています！", "face": "u878"}, {"name": "フローガ", "text": "このまま神の楔を使わせたら、\n本当に地上が海に飲まれてしまいます！", "face": "u878"}, {"name": "アンナ", "text": "一刻の猶予もなさそうですね……。\n王子、ポセイオスの\n企みを止めるには、今しかありません！", "face": "lb760d417b733"}]}, {"trigger": "end", "lines": [{"name": "ポセイオス", "text": "――グワッハッハッハ！\nほう、神の楔の力を止めるとはなぁ！！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "よい……実によい……。\n我が寵愛を受けるに相応しい者よ。", "face": "l7d6479df1740"}, {"name": "リーンベル", "text": "笑っていられるのも今のうちだ。\nお前の企みは砕かれたぞ。", "face": "u268"}, {"name": "ポセイオス", "text": "――砕かれた？\nほう、そう見えるのか。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "いや、確かに砕かれたか、うむ、そうじゃなぁ？\n見事にアトランティスの封印を砕いてくれたわ。", "face": "l7d6479df1740"}]}, {"trigger": "end", "lines": [{"name": "リーンベル", "text": "……どういうことだ。", "face": "u268"}, {"name": "ポセイオス", "text": "これはすべて、余興だったのじゃよ。\n我が新たなる城、アトランティスを見せてやるためのなぁ。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "しかし……くくく、こうも上手く踊ってくれるとは！\nお前たちは、自ら\nアトランティスへの道を閉ざしたのだぞ！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "どちらに転んでも愉快だとは思っていたが、\nさすがは王子、最も面白い結果へ泳いでいくものよ！", "face": "l7d6479df1740"}, {"name": "デューオ", "text": "くっ……待て！　どこへ行くつもりだ！？", "face": "u594"}, {"name": "ポセイオス", "text": "決まっているだろう、アトランティスだとも。\nさぁ溺れる民たちよ、我が居城、\n手の届かぬ遥かな海洋より拝むが良いわ！！", "face": "l7d6479df1740"}, {"name": "ヴィアベル", "text": "くぅっ、この海流は……まずいっ！\n王子殿下、急いで兵を撤退させて！\nこんなめちゃくちゃな海流、誰も耐えられないわ！", "face": "u1247a1"}, {"name": "アンナ", "text": "仕方ありません……。\n王子、急ぎ神殿から脱出しましょう！", "face": "lb760d417b733"}]}, {"trigger": "route", "enemy_ids": [11], "lines": [{"name": "ポセイオス", "text": "さて、どう可愛がってやろうかのう……。\nいずれも良い戦士ばかり。\n我が寵愛を授けるのも悪くない……。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "よし、水の檻を授けよう。\n海神の愛を受ける喜びに、打ち震えるがよい！", "face": "l7d6479df1740"}, {"name": "ムイル", "text": "これは……王子殿下、気をつけてください！\nポセイオスの放つ水流、\nあれは伝承に残る水の檻です……！", "face": "u1419a1"}, {"name": "ムイル", "text": "超高圧の水流で編まれた檻ですから、\n閉じ込められたら動きが大きく鈍り、\nそのまま体力を削られてしまいます！", "face": "u1419a1"}, {"name": "ヴィアベル", "text": "へぇ……でも水流と水圧の檻だっていうなら、\n私たちみたいな、深海に抵抗力のある者だったら\nどうにかなるかもしれないわ。", "face": "u1247a1"}, {"name": "ヴィアベル", "text": "王子殿下、どう対抗するかはあなたに任せるわね！！", "face": "u1247a1"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 15, 6], "ext": "攻撃待ち増加=120,ダメージ開始待ち=600"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 13, "attack": 390, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 50, "pattern_id": 2136528}, {"enemy_id": 1, "form_index": 1, "hp": 234000, "attack": 6000, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 50, "pattern_id": 2136544}, {"enemy_id": 3, "hp": 9100, "attack": 1040, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136464}, {"enemy_id": 3, "form_index": 1, "hp": 9100, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136464}, {"enemy_id": 3, "form_index": 2, "hp": 9100, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136704}, {"enemy_id": 6, "hp": 32500, "attack": 2080, "damage_type": "physical", "armor_defense": 2500, "pattern_id": 2136512}, {"enemy_id": 7, "hp": 7800, "attack": 520, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "pattern_id": 2136480}, {"enemy_id": 7, "form_index": 1, "hp": 7800, "attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "pattern_id": 2136496}, {"enemy_id": 9, "hp": 19500, "attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "pattern_id": 2124416}, {"enemy_id": 10, "hp": 169000, "attack": 4680, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "pattern_id": 2136448}, {"enemy_id": 11, "hp": 650000, "attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_