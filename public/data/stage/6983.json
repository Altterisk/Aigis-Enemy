ount": 2, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 180, "attack_wait": 150, "attack_interval": 541, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108000, "race_id": 4, "change_to": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 966, "global_id": 965, "to_global_id": 961, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 129}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 100, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108000, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 962, "global_id": 961, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "シュシュ", "text": "――はぁ～♪\n温泉まんじゅうがおいしすぎて、\n耳がぴょこぴょこしちゃいますよぉ～♪", "face": "u979"}, {"name": "クゥイル", "text": "シュシュったら、そんなにいっぱい食べると、\n今夜のごちそうが食べられなくなってしまいますよ？", "face": "u702"}, {"name": "シュシュ", "text": "ふふーん、おいしいごはんは別腹なんですよ～！\n――なんて言ってる間に、\n遠くに見えてきたのはお茶屋さんでは！", "face": "u979"}, {"name": "ミコト", "text": "おや、走っていってしまいました……。\nシュシュちゃんにとっては、\nまだまだ花より団子の方に魅力を感じるのでしょうか。", "face": "u130"}, {"name": "コジュウロウ", "text": "東の国は武士の刀によって戦い、\n農民の育む食によって栄える国。\n他国の方が喜んでくれるならば、実に重畳にござろう。", "face": "u102"}, {"name": "クゥイル", "text": "でも甘やかしちゃだめですよ？\n口では別腹と言っていますが、晩ごはんが\n食べられなくて泣くのが目に見えているんですから！", "face": "u702"}, {"name": "シュシュ", "text": "――わっ、わぁあぁぁ！！\n大変っ！　大変ですよぉぉ～！！", "face": "u979"}, {"name": "クゥイル", "text": "ほら、もう大慌てで……って、\n何か様子がおかしくありませんか？", "face": "u702"}, {"name": "ヒエン", "text": "この妖気……主よ、お気をつけくだされ。\nシュシュ殿が見つけた大変なものとは――", "face": "u112"}]}, {"trigger": "start", "lines": [{"name": "重水の四天王", "text": "――くっ、せっかくの奇襲の用意が、\nまさか食い意地の張った小娘に破られてしまうとは。", "face": "l19912f5fa65b"}, {"name": "重水の四天王", "text": "王子達が慰安旅行に来ていると聞き、\n観光中ならば暗殺も容易だと思ったのですがねぇ。", "face": "l19912f5fa65b"}, {"name": "シュシュ", "text": "ふふーん！\n観光中でもみーんな武装してるんですからねー！\n王子さま、ぼっこぼこにしてやりましょー！", "face": "u979"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "重水の四天王", "text": "好きなだけ調子に乗っておけばよいのです。\nさぁ、死出のお覚悟をするがよろしい……！", "face": "l19912f5fa65b"}]}, {"trigger": "end", "lines": [{"name": "重水の四天王", "text": "――くっくっく、ただ温泉で休んでいただけ、\nというわけでは無さそうですね……。", "face": "l19912f5fa65b"}, {"name": "重水の四天王", "text": "さぁ撤退しますよ。\n此度の襲撃は余興のようなものなのですからね。", "face": "l19912f5fa65b"}, {"name": "河童", "text": "へ、へいっ！\n撤退だ！　ずらかるぞてめぇら！！", "face": "l04e137c4456c"}, {"name": "チズル", "text": "やれやれ……。\nドッペルゲンガーの騒ぎに乗じて、\n鬼までちょっかいをかけてくるとはねぇ。", "face": "u159"}, {"name": "ジュウベエ", "text": "常在戦場、気を緩める事なかれということですな。\nご覧くだされチズル殿、\n我らが主殿も周囲を警戒して――っと、おや？", "face": "u699"}, {"name": "シュシュ", "text": "クゥイルちゃん！\nもう一個！　あと一個だけ食べさせてください～！", "face": "u979"}, {"name": "クゥイル", "text": "だめです！　そう言って追加で何個食べているんですか。\n本当に晩ごはんが食べられなくなってしまいますよ？\n王子殿下も何とか言ってあげてください！", "face": "u702"}, {"name": "王子", "text": "…………（もぐもぐ）", "face": "u1"}, {"name": "クゥイル", "text": "王子殿下まで温泉まんじゅうを……。\nうぅぅ、こうなったら私も！　私も食べちゃいます！", "face": "u702"}, {"name": "シュシュ", "text": "わーい！\nたっぷり温泉ぐるめを堪能しちゃいましょー！", "face": "u979"}]}], "active": true}