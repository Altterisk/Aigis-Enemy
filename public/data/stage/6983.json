{"quest_id": 6983, "name": "休暇を阻む妖怪たち", "description": "敵はドッペルゲンガーだけではなかった！\n温泉宿で憩うシュシュたちの目の前に、\n重水の四天王率いる妖怪たちが現れる！\n上級（★１獲得の目安：平均Lv10）", "event": "王国軍の慰安旅行ー温泉編ー", "event_category": "History", "mission_id": 920139, "map_no": 3470, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 400, "base_hp": 15000, "base_attack": 400, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107216, "race_id": 4, "special_effect_id": 101, "missile_id": 168, "missile": {"speed": 2.0}, "master_id": 458, "global_id": 457, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 26, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 2, "hp": 1000, "attack": 100, "base_hp": 1000, "base_attack": 100, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_speed": 180, "attack_wait": 60, "attack_interval": 361, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "change_to": 3, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 965, "global_id": 964, "to_global_id": 960, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 14}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_coun