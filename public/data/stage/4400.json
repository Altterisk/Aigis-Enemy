n_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 7, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 49}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 61}, {"enemy_id": 10, "source": "local", "count": 10, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 74}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 82}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "王子！　デシウスを発見しました！", "face": "l5b8011f24f83"}, {"name": "アンナ", "text": "……しかし、肝心のユーノさんの姿が見当たりません。\n一体どこに……。", "face": "l781b48b6aff7"}, {"name": "暗黒騎士デシウス", "text": "ふははは！　どこだろうなぁ？\n我輩にもわからんなぁ。", "face": "ld557750182f4"}, {"name": "アンナ", "text": "卑怯な……。", "face": "l5b8011f24f83"}, {"name": "ドルカ", "text": "なんだか、癒しの力が奪われていきます……。", "face": "u44"}, {"name": "アンナ", "text": "王子、癒し手の力が弱まっています。\nどこかにユーノさんが捕らわれているのは\n間違いないようですが……。", "face": "l781b48b6aff7"}, {"name": "アンナ", "text": "なにかカラクリがあるのかもしれません。\nお気を付けください。", "face": "l5b8011f24f83"}, {"name": "ユーノ", "text": "ぅう……っ。闇の力を間近に感じるっ……。\n早くここ、から……出なければ……ッ。", "face": "u291"}, {"name": "暗黒騎士デシウス", "text": "あ、こら動くでない！　くすぐったいだろう！！", "face": "ld557750182f4"}, {"name": "アンナ", "text": "……？", "face": "l5b8011f24f83"}]}, {"trigger": "start", "lines": [{"name": "暗黒騎士デシウス", "text": "おい。そこの者。貴様にはこいつを支給してやろう。\nこの新しいワンドを使えば、強力な魔法を\n振るえる上に魔法に抵抗する力も与えられるのだ！", "face": "ld557750182f4"}, {"name": "暗黒騎士デシウス", "text": "（まぁ、多少装甲を犠牲にするが、止むをえん。\nこやつらには戦いに集中してもらおう）", "face": "ld557750182f4"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士デシウス", "text": "おのれ！！\n我輩の邪魔をしおって……！", "face": "ld557750182f4"}, {"name": "アンナ", "text": "卑劣なことばかりしようとするから、\n天罰が下ったのです。", "face": "l5b8011f24f83"}, {"name": "暗黒騎士デシウス", "text": "くそっ……、お、覚えていろ！！", "face": "ld557750182f4"}, {"name": "ユーノ", "text": "ありがとうございます。\n本当になんてお礼を言ったらいいか……。", "face": "u291"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "アンナ", "text": "ふふっ。私たちと一緒にいれば、\n闇の神官の魂が覚醒することもないはずです。"}, {"name": "アンナ", "text": "よろしければ私たちの仲間になりませんか？\nこれからは王子と一緒に行動を共にしましょう。"}, {"name": "ユーノ", "text": "私でよければ……。是非よろしくお願いします。", "face": "u291"}, {"name": "アンナ", "text": "それでは王子、お城に戻りましょうか。"}, {"name": "グレーターデーモン", "text": "まったく。君には期待していたんだけどね。\nこれ以上失敗が続くようなら……。わかるね？", "face": "lf2dd1f8513ee"}, {"name": "暗黒騎士デシウス", "text": "申し訳ございません……っ。\n次こそは必ずや王子を倒します！！", "face": "ld557750182f4"}, {"name": "暗黒騎士デシウス", "text": "（くそっ。いつまでも言いなりになると思うなよ。\nいつか我輩が力をつけた時、\n必ずや貴様も倒してやる……。）", "face": "ld557750182f4"}]}], "active": true}