ype": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 7, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_condition": 0, "to_global_id": 533, "spawn_sec": 49}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533, "from_condition": 0}, {"enemy_id": 9, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 61}, {"enemy_id": 10, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 74}, {"enemy_id": 11, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 82}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "王子！　デシウスを発見しました！", "face": "l5b8011f24f83"}, {"name": "アンナ", "text": "……しかし、肝心のユーノさんの姿が見当たりません。\n一体どこに……。", "face": "l781b48b6aff7"}, {"name": "暗黒騎士デシウス", "text": "ふははは！　どこだろうなぁ？\n我輩にもわからんなぁ。", "face": "ld557750182f4"}, {"name": "アンナ", "text": "卑怯な……。", "face": "l5b8011f24f83"}, {"name": "ドルカ", "text": "なんだか、癒しの力が奪われていきます……。", "face": "u44"}, {"name": "アンナ", "text": "王子、癒し手の力が弱まっています。\nどこかにユーノさんが捕らわれているのは\n間違いないようですが……。", "face": "l781b48b6aff7"}, {"name": "アンナ", "text": "なにかカラクリがあるのかもしれません。\nお気を付けください。", "face": "l5b8011f24f83"}, {"name": "ユーノ", "text": "ぅう……っ。闇の力を間近に感じるっ……。\n早くここ、から……出なければ……ッ。", "face": "u291"}, {"name": "暗黒騎士デシウス", "text": "あ、こら動くでない！　くすぐったいだろう！！", "face": "ld557750182f4"}, {"name": "アンナ", "text": "……？", "face": "l5b8011f24f83"}]}, {"trigger": "start", "lines": [{"name": "暗黒騎士デシウス", "text": "おい。そこの者。貴様にはこいつを支給してやろう。\nこの新しいワンドを使えば、強力な魔法を\n振るえる上に魔法に抵抗する力も与えられるのだ！", "face": "ld557750182f4"}, {"name": "暗黒騎士デシウス", "text": "（まぁ、多少装甲を犠牲にするが、止むをえん。\nこやつらには戦いに集中してもらおう）", "face": "ld557750182f4"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士デシウス", "text": "おのれ！！\n我輩の邪魔をしおって……！", "face": "ld557750182f4"}, {"name": "アンナ", "text": "卑劣なことばかりしようとするから、\n天罰が下ったのです。", "face": "l5b8011f24f83"}, {"name": "暗黒騎士デシウス", "text": "くそっ……、お、覚えていろ！！", "face": "ld557750182f4"}, {"name": "ユーノ", "text": "ありがとうございます。\n本当になんてお礼を言ったらいいか……。", "face": "u291"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "アンナ", "text": "ふふっ。私たちと一緒にいれば、\n闇の神官の魂が覚醒することもないはずです。"}, {"name": "アンナ", "text": "よろしければ私たちの仲間になりませんか？\nこれからは王子と一緒に行動を共にしましょう。"}, {"name": "ユーノ", "text": "私でよければ……。是非よろしくお願いします。", "face": "u291"}, {"name": "アンナ", "text": "それでは王子、お城に戻りましょうか。"}, {"name": "グレーターデーモン", "text": "まったく。君には期待していたんだけどね。\nこれ以上失敗が続くようなら……。わかるね？", "face": "lf2dd1f8513ee"}, {"name": "暗黒騎士デシウス", "text": "申し訳ございません……っ。\n次こそは必ずや王子を倒します！！", "face": "ld557750182f4"}, {"name": "暗黒騎士デシウス", "text": "（くそっ。いつまでも言いなりになると思うなよ。\nいつか我輩が力をつけた時、\n必ずや貴様も倒してやる……。）", "face": "ld557750182f4"}]}], "map": {"image": "Map920052_3127", "w": 960, "h": 640, "spots": [{"k": "b", "x": 476, "y": 226}, {"k": "m", "x": 734, "y": 134, "id": 200}, {"k": "m", "x": 643, "y": 151, "id": 201}, {"k": "m", "x": 546, "y": 140, "id": 202}, {"k": "m", "x": 443, "y": 114, "id": 203}, {"k": "m", "x": 328, "y": 145, "id": 204}, {"k": "m", "x": 214, "y": 156, "id": 205}, {"k": "m", "x": 130, "y": 170, "id": 206}, {"k": "m", "x": 408, "y": 287, "id": 207}, {"k": "m", "x": 557, "y": 279, "id": 208}, {"k": "m", "x": 675, "y": 333, "id": 209}, {"k": "m", "x": 796, "y": 408, "id": 210}, {"k": "m", "x": 697, "y": 404, "id": 211}, {"k": "m", "x": 593, "y": 409, "id": 212}, {"k": "m", "x": 486, "y": 393, "id": 213}, {"k": "m", "x": 404, "y": 375, "id": 214}, {"k": "m", "x": 303, "y": 369, "id": 215}, {"k": "m", "x": 217, "y": 392, "id": 216}, {"k": "r", "x": 192, "y": 458, "id": 300}, {"k": "r", "x": 262, "y": 430, "id": 301}, {"k": "r", "x": 347, "y": 418, "id": 302}, {"k": "r", "x": 437, "y": 428, "id": 303}, {"k": "r", "x": 524, "y": 452, "id": 304}, {"k": "r", "x": 753, "y": 471, "id": 305}, {"k": "r", "x": 843, "y": 461, "id": 306}, {"k": "r", "x": 590, "y": 347, "id": 307}, {"k": "r", "x": 338, "y": 307, "id": 308}, {"k": "r", "x": 291, "y": 249, "id": 309}, {"k": "r", "x": 256, "y": 197, "id": 310}]}, "start_cost": 10, "active": true}