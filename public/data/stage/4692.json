{"quest_id": 4692, "name": "魔神の羽化", "description": "広範囲を蝕む瘴気に注意し、\n疫病の元凶であるベルゼビュートを\n討ち倒せ！\n神級（★１獲得の目安：平均Lv50）", "event": "帝国の治癒士", "event_category": "History", "mission_id": 920074, "map_no": 3847, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 50000, "attack": 2000, "base_hp": 50000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_speed": 30, "attack_wait": 40, "attack_interval": 161, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2107344, "race_id": 3, "special_effect_id": 105, "master_id": 557, "global_id": 556, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 6000, "base_hp": 6000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101840, "race_id": 3, "special_effect_id": 55, "master_id": 434, "global_id": 433, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 9}, {"enemy_id": 4, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 70, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104096, "race_id": 3, "master_id": 498, "global_id": 497, "spawn_sec": 41}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 61}, {"enemy_id": 6, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 107}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 107}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 107}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ユリアンさん、待って下さい……！\nいくら帝国の皆さんの帰りが遅いからと言っても、\n私たちは追撃しないことになってるのですよ！", "face": "lab3e5c39447d"}, {"name": "ユリアン", "text": "だが、これだけ時間が経っても\n戻ってこないのはおかしすぎるだろ！\n何かあったに違いないぜ！", "face": "u7"}, {"name": "ケイティ", "text": "……それにしても、やけに静かですね？\n帝国の皆さんは、おそらくこのあたりへ\n向かっていたはずですが……。", "face": "u114"}, {"name": "アンナ", "text": "――えッ！？\nそんな、あれは……まさか！", "face": "lab3e5c39447d"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……随分と遅かったな、人間共よ。\n既に貴様の仲間たちにはしっかりと\n我らの積怨を晴らさせてもらったぞ……ブブッ。", "face": "ld8ef79b3ed4d"}, {"name": "レオナ", "text": "王子……く、来るな……このままでは、\n全滅は免れない……ベルゼビュートが、\n完全に復活してしまったのだ……ッく、うぅぅ……。", "face": "u311"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……ベルゼビュート様が復活した今、\nもはや貴様らなど取るに足らん……。", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "さあ、大人しくベルゼビュート様の\n食料となるがいい……ブブッ！", "face": "ld8ef79b3ed4d"}, {"name": "エリアス", "text": "王子軍の皆さん……逃げて下さい……。\nそして……帝国に……皇帝に、この事を……。", "face": "u373"}, {"name": "ユリアン", "text": "こんな時にまだ軍規を守ろうっていうのか？\n見殺しになんかできるかってんだよ！\n……王子、これでようやく治療薬の恩を返せるな。", "face": "u7"}, {"name": "アンナ", "text": "王子、今度は私たちが\n白の帝国の皆さんを助ける番です！\n魔神ベルゼビュートを、何としてでも倒しましょう！", "face": "lab3e5c39447d"}]}, {"trigger": "end", "lines": [{"name": "ベルゼビュートの配下", "text": "ブブッ……ブッ、ブブッ……ばかな……。\nベルゼビュート様が負ける、だと……？\nいや、それよりも……様子がおかしい……。", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "ベルゼビュート様が\n魔界の渦に飲み込まれていく……。", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "そ、そうか……！　魔界に戻られるという事ですね！\nならば我らも後を追わねば……ブブブブブッ！！", "face": "ld8ef79b3ed4d"}, {"name": "ケイティ", "text": "そんな……。\nここまで追い詰めて逃げられるなんて……！", "face": "u114"}, {"name": "バルバストラフ", "text": "おそらく、魔界で傷を癒やし、\n再び物質界に攻め込む気じゃろう……。\n魔神は不滅……ヤツ等は何度でも蘇るのじゃ。", "face": "u63"}, {"name": "アリサ", "text": "それよりも帝国の皆さんを\n早く治療しないといけません！\n治癒術を使える方は、手を貸して下さい！", "face": "u24"}, {"name": "ケイティ", "text": "帝国の方達は皆、\nとりあえず立てるまでに回復できたようですね。\nアリサさん達の迅速な対応に感謝です。", "face": "u114"}, {"name": "アンナ", "text": "帝国の皆さんが無事で、良かった……。\nこれで、少しは恩が返せましたね、王子。"}, {"name": "レオナ", "text": "王子、我が軍への助力、及び救護、感謝する。\nだがこれ以上、貴国に恥を晒すわけにはいかない。\n……全軍、速やかに撤退するぞ！", "face": "u311"}, {"name": "モーティマ", "text": "何だよ、あんなに慌てて帰っちまって。\nこの後、祝勝会をするんだと思ってたのによ。\n白の帝国って奴らは本当に付き合い辛れぇな……。", "face": "u14"}, {"name": "エリアス", "text": "…………あの、王子。", "face": "u373"}, {"name": "アンナ", "text": "え、エリアスさん！？\nまだいらしてたのですね……！\nレオナさん達と一緒に行かなくていいのですか？"}, {"name": "エリアス", "text": "その……お礼が言いたくて、私……。\nえっと、あの……助けて頂き、ありがとうございます。\n命を賭けて戦ってくれたこと……私、忘れません。", "face": "u373"}, {"name": "エリアス", "text": "……何か病気や怪我の治療などで困った時は、\n連絡を下さい。帝国兵としては協力できませんが、\nエリアス個人としてなら、お力になれるはずです……。", "face": "u373"}, {"name": "エリアス", "text": "それでは、私は本隊に戻ります。これ以上撤退\n命令を無視しては、レオナ様に何と言われるか\n分かりませんから……では、失礼します。", "face": "u373"}]}], "map": {"image": "Map920074_3847", "w": 960, "h": 640, "spots": [{"k": "b", "x": 24, "y": 422}, {"k": "b", "x": 935, "y": 410}, {"k": "m", "x": 190, "y": 201, "id": 200}, {"k": "m", "x": 736, "y": 204, "id": 201}, {"k": "m", "x": 117, "y": 299, "id": 202}, {"k": "m", "x": 225, "y": 292, "id": 203}, {"k": "m", "x": 334, "y": 288, "id": 204}, {"k": "m", "x": 435, "y": 288, "id": 205}, {"k": "m", "x": 530, "y": 285, "id": 206}, {"k": "m", "x": 440, "y": 355, "id": 207}, {"k": "m", "x": 536, "y": 353, "id": 208}, {"k": "m", "x": 622, "y": 284, "id": 209}, {"k": "m", "x": 711, "y": 283, "id": 210}, {"k": "m", "x": 806, "y": 288, "id": 211}, {"k": "m", "x": 400, "y": 412, "id": 212}, {"k": "m", "x": 582, "y": 411, "id": 213}, {"k": "m", "x": 300, "y": 429, "id": 214}, {"k": "m", "x": 676, "y": 429, "id": 215}, {"k": "m", "x": 172, "y": 432, "id": 216}, {"k": "m", "x": 782, "y": 434, "id": 217}, {"k": "m", "x": 152, "y": 144, "id": 218}, {"k": "m", "x": 268, "y": 138, "id": 219}, {"k": "m", "x": 384, "y": 127, "id": 220}, {"k": "m", "x": 606, "y": 130, "id": 221}, {"k": "m", "x": 793, "y": 148, "id": 222}, {"k": "r", "x": 333, "y": 356, "id": 300}, {"k": "r", "x": 238, "y": 355, "id": 301}, {"k": "r", "x": 138, "y": 359, "id": 302}, {"k": "r", "x": 624, "y": 343, "id": 303}, {"k": "r", "x": 718, "y": 342, "id": 304}, {"k": "r", "x": 813, "y": 349, "id": 305}]}, "active": true}