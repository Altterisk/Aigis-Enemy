{"quest_id": 6515, "name": "猛暑の水合戦", "description": "波打ち際で行われる壮絶なる水合戦。\n勝利の栄光を掴むのは誰だ！\n\n上級（★１獲得の目安：平均Lv10）", "event": "渚に咲きし水着騎兵", "event_category": "History", "mission_id": 920112, "map_no": 3276, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 720, "base_hp": 12000, "base_attack": 720, "damage_type": "physical", "armor_defense": 120, "attack_range": 300, "attack_speed": 75, "attack_wait": 75, "attack_interval": 199, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111280, "race_id": 16, "missile_id": 220, "missile": {"speed": 8.0, "splash": 80, "slow": [40, 15]}, "master_id": 31116, "global_id": 4735, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 180, "base_hp": 15000, "base_attack": 180, "damage_type": "physical", "armor_defense": 120, "attack_range": 180, "attack_speed": 90, "attack_interval": 11, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113984, "race_id": 16, "special_effect_id": 288, "missile_id": 213, "master_id": 31132, "global_id": 4751, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_range": 280, "attack_speed": 70, "attack_wait": 120, "attack_interval": 313, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101344, "race_id": 16, "missile_id": 222, "missile": {"speed": 4.0, "splash": 120}, "master_id": 31133, "global_id": 4752, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "physical", "armor_defense": 80, "attack_range": 300, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100448, "race_id": 16, "missile_id": 213, "master_id": 30430, "global_id": 4049, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 8400, "attack": 500, "base_hp": 8400, "base_attack": 500, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 321, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113136, "race_id": 16, "change_to": 5, "change_condition": 1, "missile_id": 222, "missile": {"speed": 4.0, "splash": 120}, "master_id": 31113, "global_id": 4732, "ranged": true, "variants": [{"tags": ["アーマー"], "hp": 8400, "attack": 500, "base_hp": 8400, "base_attack": 500, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 206, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113152, "race_id": 16, "master_id": 31114, "global_id": 4733}]}, {"enemy_id": 7, "source": "local", "count": 12, "form_count": 1, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 70, "attack_range": 280, "attack_speed": 70, "attack_wait": 120, "attack_interval": 313, "move_speed": 750.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101392, "race_id": 16, "missile_id": 221, "missile": {"speed": 4.0, "splash": 80}, "master_id": 30533, "global_id": 4152, "ranged": true, "spawn_sec": 19}, {"enemy_id": 8, "source": "local", "count": 8, "form_count": 1, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "physical", "armor_defense": 80, "attack_range": 250, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101104, "race_id": 16, "missile_id": 213, "master_id": 30418, "global_id": 4037, "ranged": true, "spawn_sec": 48}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 6000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115184, "race_id": 16, "master_id": 31109, "global_id": 4728, "spawn_sec": 133}], "dialogue": [{"trigger": "start", "lines": [{"name": "ジョヴァンニ", "text": "……フッ。待ってたぜ、王子様よォ。", "face": "u123"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ジョヴァンニ", "text": "そろそろ決着を付けようじゃねえか！\n――この水鉄砲でなァッ！", "face": "u123"}, {"name": "王子", "text": "…………！", "face": "u1"}, {"name": "ケイティ", "text": "ここでの訓練は水兵と海賊、砲兵の皆さんによる\n水鉄砲、および水風船を使用した砲火訓練となります。", "face": "u114"}, {"name": "カノン", "text": "たかが水って甘く見ないでよね？\n私の大砲で水風船をドカーンってやって、\nみーんなまとめてビショビショにしてやるんだから！", "face": "u264"}, {"name": "フリーデ", "text": "ふふん、アンナさんなんかマズいんじゃない？\nあたしたちに水浸しにされちゃったら、\n服が透けて大変なことになっちゃうかもよ？", "face": "u566"}, {"name": "アンナ", "text": "なッ……！？", "face": "l60362c483024"}, {"name": "イブキ", "text": "フッ、そうなったらこの私が\n容赦なく取り締まらせてもらおう。\nどんな理由であれ、軍内の風紀を乱す者は許せんしな。", "face": "u1511"}, {"name": "デューオ", "text": "あーやだやだ。海軍元帥さんはお堅いなぁ。\n王子ぃ、この機会にアタシの海賊団に入りなよ？\n多少の風紀の乱れには目をつぶったげるからさぁ♪", "face": "u1594"}, {"name": "アンナ", "text": "だ、ダメですっ！\n王子、実戦だと思って速やかな鎮圧を心掛けましょう！", "face": "l60362c483024"}, {"name": "ケイティ", "text": "それではこれより訓練を開始します。\n用意――始めッ！", "face": "u114"}]}, {"trigger": "battle", "at_sec": 132, "lines": [{"name": "キャリー", "text": "（……よし、そろそろ奇襲しよう――）", "face": "u646"}, {"name": "イブキ", "text": "くっ……王子たち、なかなかやるな。\n……よし！　カノン、こうなったら一斉射撃だ！", "face": "u1511"}, {"name": "カノン", "text": "オーケー！", "face": "u264"}, {"name": "キャリー", "text": "キャーーーッ！！\nな、なによこれ……水？", "face": "u646"}, {"name": "キャリー", "text": "って――わわっ！？　馬が暴走しちゃってる！\nだ、誰かー！　止めてくださいぃ～～～ッ！！！", "face": "u646"}]}, {"trigger": "end", "lines": [{"name": "キャリー", "text": "あ、ありがとうございます、皆さん。\nおかげさまでやっと止まっ――", "face": "u646"}, {"name": "キャリー", "text": "――きゃあぁッ！？　\nと、止まってないぃ～～～～～～ッ！！", "face": "u646"}, {"name": "アンナ", "text": "そ、そんな……。\n一度は止めたのに、また暴走しはじめてしまうなんて。", "face": "lab0e64136ede"}, {"name": "レアン", "text": "予想外の展開――はっ！？\nまさか、これも訓練のうちということか！", "face": "u50"}, {"name": "ケイティ", "text": "……はい？", "face": "u114"}, {"name": "エミリア", "text": "暴走したキャリーを捕まえる訓練か。\nそれなら我々騎兵の出番だな。", "face": "u207"}, {"name": "レシア", "text": "ああ。今日はキャリーばかりが目立っているが、\n王国には他にも優れた騎兵がいることを示してやろう。", "face": "u358"}, {"name": "レシア", "text": "騎兵部隊、出撃！\n我らの神速を篤とお見せしようじゃないか！", "face": "u1358"}, {"name": "リオン", "text": "ふふっ、面白そうじゃない！\nあたしも参加させてもらうわよっ！", "face": "u1251"}, {"name": "アベル", "text": "俺たち竜騎兵も忘れてもらっちゃあ困るな！\n行くぞ、相棒っ！", "face": "u241"}, {"name": "アンナ", "text": "……………………。", "face": "l60362c483024"}, {"name": "フリーデ", "text": "へぇーっ、王国の訓練ってすごいんだね！\n水風船とか使ったり、わざとトラブル起こしたりしてさ。\n帝国じゃこんな面白い訓練したことなかったよ！", "face": "u566"}, {"name": "ケイティ", "text": "……いえ。\n今のは本当に誰も予想していなかった事態です……。", "face": "u114"}, {"name": "フリーデ", "text": "…………え、そうなの？", "face": "u566"}, {"name": "アンナ", "text": "と、とにかくキャリーさんと\n彼女を追う騎兵の皆さんを止めましょう！", "face": "l60362c483024"}]}], "active": true}