{"quest_id": 4252, "name": "血の宴", "description": "強大な戦闘能力を誇る\nヴァンパイアロードとの決戦！\n住民たちを救うため戦いを制せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "ヴァンパイアの逆襲", "event_category": "History", "mission_id": 920039, "map_no": 3552, "level": 105, "multiplier": 1.05, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 1, "tags": ["アンデッド"], "hp": 7350, "attack": 315, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 10500, "attack": 1050, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 30, "attack_wait": 50, "attack_interval": 201, "move_speed": 300.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2099200, "change_to": 2, "change_condition": 2, "master_id": 172, "global_id": 171, "to_condition": 2, "to_global_id": 172, "spawn_sec": 62}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 10500, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 20, "attack_range": 300, "attack_speed": 10, "attack_wait": 10, "attack_interval": 125, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2099216, "change_to": 3, "change_condition": 1, "missile_id": 6, "master_id": 173, "global_id": 172, "ranged": true, "from_condition": 2, "variants": [{"tags": ["アンデッド"], "hp": 10500, "attack": 1575, "base_hp": 10000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 10, "attack_wait": 50, "attack_interval": 201, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2099232, "special_effect_id": 240, "master_id": 174, "global_id": 173}]}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 21000, "attack": 420, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157, "spawn_sec": 65}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 3150, "attack": 630, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 65}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 840, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 65}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 12600, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "missile_id": 6, "master_id": 8, "ranged": true, "spawn_sec": 66}, {"enemy_id": 9, "source": "local", "count": 10, "form_count": 1, "tags": ["アンデッド"], "hp": 1050, "attack": 315, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 73}], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴィンセント", "text": "ようやくここまできたか。\nこっから先は俺もついていくぜ。", "face": "u103"}, {"name": "ヴィンセント", "text": "敵の親玉は恐らくこの先だ。\n油断するなよ。", "face": "u103"}, {"name": "ヴァンパイアロード", "text": "よくぞきたな人間たちよ……。\nだがここで打ち滅ぼしてくれる！", "face": "l015cf7a774fe"}, {"name": "エデン", "text": "お父様、私も戦います！", "face": "u239"}, {"name": "ヴァンパイアロード", "text": "黙れ、失敗作が！　貴様のような出来損ないが\n我と共に戦うだと？　片腹痛い。", "face": "l015cf7a774fe"}, {"name": "アンナ", "text": "エデンさんが失敗作……。\nどういうことですか？", "face": "ladee8649bf68"}, {"name": "ヴァンパイアロード", "text": "ふむ……良かろう。教えてやる。\n本来、ヴァンパイアがヴァンパイアロードとなるには\n途方もない年月を要する……。", "face": "l015cf7a774fe"}, {"name": "ヴァンパイアロード", "text": "強き部下を求めた我は亡骸に膨大な魔力を\n注入し、強制的にヴァンパイアロードとして\n復活させる実験を行うことにしたのだ。", "face": "l015cf7a774fe"}, {"name": "ヴァンパイアロード", "text": "丁度その時、ヴァンパイア化する前の\n少女の亡骸が手に入ってな。あれはそう、\n以前ある村をヴァンパイアどもに襲わせた時……。", "face": "l015cf7a774fe"}, {"name": "ヴィンセント", "text": "……！！", "face": "u103"}, {"name": "ヴァンパイアロード", "text": "しかし実験は失敗だ。\nこれほど役に立たないとは……。", "face": "l015cf7a774fe"}, {"name": "ヴァンパイアロード", "text": "戦闘の邪魔だ。失せろ！", "face": "l015cf7a774fe"}, {"name": "アンナ", "text": "なんてひどい……っ。\n人の命を弄ぶなんて許せません！", "face": "ladee8649bf68"}, {"name": "ヴァンパイアロード", "text": "さぁ、血の宴を始めよう。\n闇に生きる魔物たちよ、王子を食い尽くせ！！", "face": "l015cf7a774fe"}]}, {"trigger": "battle", "at_sec": 64, "lines": [{"name": "ヴァンパイアロード", "text": "ここからは本物のヴァンパイアロードの力を\n見せてやろう……！", "face": "l015cf7a774fe"}]}, {"trigger": "end", "lines": [{"name": "スー", "text": "終わっていたか……。", "face": "u232"}, {"name": "エリザベート", "text": "あら、遅かったみたいね。", "face": "u104"}, {"name": "アンナ", "text": "王子、戦いは終わりました。\nここは一旦城に戻りましょう。", "face": "ladee8649bf68"}, {"name": "エデン", "text": "待って！", "face": "u239"}, {"name": "エデン", "text": "皆さんにお願いがあるの！\n私はお父様の支配から解放され、\n自由になった。", "face": "u239"}, {"name": "エデン", "text": "だけどいつ自我が失われ、次の悲劇を生む存在に\nなるかもしれない……。せめて迷惑をかける前に\n笑顔で死なせて。", "face": "u239"}, {"name": "スー", "text": "……た、確かにいつ人間を襲う存在に\nなるか分からない。\nここで命を絶たせるのは間違いではないが……。", "face": "u232"}, {"name": "エリザベート", "text": "……彼女の願いどおりに今、\n楽にしてあげるのも一つの考え……か。", "face": "u104"}, {"name": "ヴィンセント", "text": "待て。とりあえず今は様子を見るべきだろう。\n……それに、元に戻す手段があるかもしれん。\n状況が変わればそのときに考えればいいだろう。", "face": "u103"}, {"name": "エリザベート", "text": "一緒に時間を過ごすほど……。\n後で辛くなるわよ……。", "face": "u104"}, {"name": "アンナ", "text": "私も、ここで決断するのはまだ早いと思います。\n少し考える時間が必要です。", "face": "ladee8649bf68"}, {"name": "アンナ", "text": "いまはとにかく、\nこの薄気味悪い場所から出ましょう。", "face": "ladee8649bf68"}]}], "active": true}