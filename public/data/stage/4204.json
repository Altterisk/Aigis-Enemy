{"quest_id": 4204, "name": "聖霊と共に", "description": "聖霊の友セリアと聖霊たちが\n王子を狙う！\n聖霊の動きに翻弄されるな！\n上級（★１獲得の目安：平均Lv10）", "event": "山賊王への道", "event_category": "History", "mission_id": 920034, "map_no": 3068, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 21, "form_count": 1, "hp": 300, "attack": 150, "base_hp": 300, "base_attack": 150, "damage_type": "magical", "armor_defense": 120, "magic_defense": 80, "attack_range": 140, "attack_speed": 26, "attack_wait": 30, "attack_interval": 91, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101600, "special_effect_id": 229, "missile_id": 40, "missile": {"speed": 7.0}, "master_id": 10015, "global_id": 1014, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 55, "attack_wait": 10, "attack_interval": 157, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101728, "race_id": 16, "master_id": 10016, "global_id": 1015, "spawn_sec": 9}, {"enemy_id": 3, "source": "local", "count": 1, "level": 160, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099808, "race_id": 16, "master_id": 196, "global_id": 195, "spawn_sec": 53}], "dialogue": [{"trigger": "start", "lines": [{"name": "セリア", "text": "あ……王子……様。\n見つけた……！", "face": "u1084"}, {"name": "セリア", "text": "あの人を倒せば山賊王になれる。\nでも……、私一人じゃ……。", "face": "u1084"}, {"name": "聖霊", "text": "セリアさん。", "face": "u55"}, {"name": "聖霊", "text": "あなたは一人じゃない。", "face": "u58"}, {"name": "聖霊", "text": "私たちがいます。", "face": "u59"}, {"name": "セリア", "text": "え？　聖霊さん……！？", "face": "u1084"}, {"name": "聖霊", "text": "人と聖霊。", "face": "u55"}, {"name": "聖霊", "text": "今が手を取り合うときです。", "face": "u58"}, {"name": "聖霊", "text": "共に目指しましょう。", "face": "u59"}, {"name": "聖霊", "text": "山賊王！！", "face": "u59"}, {"name": "セリア", "text": "聖霊さん……！", "face": "u1084"}, {"name": "セリア", "text": "私、やります！\n聖霊さんと一緒なら\n何でもできる気がします！", "face": "u1084"}, {"name": "セリア", "text": "うん……。\n一人じゃない……！\n私にはこんなに仲間がいる。", "face": "u1084"}, {"name": "セリア", "text": "王子様……！\n聖霊さんたちと共にあなたを倒します。\nお覚悟を……！", "face": "u1084"}]}, {"trigger": "end", "lines": [{"name": "ロロネ", "text": "すげー！！\nあれが聖霊の友って言われている\nセリアさんかー！", "face": "u214"}, {"name": "ロロネ", "text": "王子は聖霊たちに気を取られている……。\nこのチャンス、逃さねぇ！", "face": "u214"}]}], "active": true}