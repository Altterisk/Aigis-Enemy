_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "change_to": 6, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 34062, "global_id": 7679, "ranged": true, "from_condition": 0, "to_condition": 0, "to_global_id": 3640}, {"enemy_id": 5, "source": "local", "count": 1, "level": 80, "form_index": 2, "form_count": 3, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "from_condition": 0}, {"enemy_id": 8, "source": "local", "count": 9, "form_index": 0, "form_count": 2, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 45, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111792, "race_id": 16, "special_effect_id": 242, "change_to": 8, "master_id": 34063, "global_id": 7680, "to_condition": 0, "to_global_id": 4256, "route_behaviour": {"hold": {"routes": 9, "held": 9}, "reroutes": ["Route=999"]}, "spawn_sec": 12}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 45, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111792, "race_id": 16, "master_id": 30637, "global_id": 4256, "from_condition": 0}, {"enemy_id": 10, "source": "local", "count": 6, "level": 80, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 77}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 25000, "attack": 500, "base_hp": 25000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 50, "attack_range": 210, "attack_speed": 1, "attack_wait": 45, "attack_interval": 145, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2130800, "special_effect_id": 856, "missile_id": 601, "missile": {"speed": 10.0}, "master_id": 34051, "global_id": 7668, "ranged": true, "commands": {"raw": "if (IsStageFlag(100) == 1) { CreateMapPlaceObject(\"locPlc_201\", 201, 402, 82); DeleteMapEffectObject(\"obj_01\", 30); } if (IsStageFlag(101) == 1) { CreateMapPlaceObject(\"locPlc_203\", 203, 92, 99); DeleteMapEffectObject(\"obj_02\", 30); } if (IsStageFlag(102) == 1) { CreateMapPlaceObject(\"locPlc_209\", 209, 212, 381); DeleteMapEffectObject(\"obj_04\", 30); } if (IsStageFlag(103) == 1) { CreateMapPlaceObject(\"locPlc_208\", 208, 188, 299); DeleteMapEffectObject(\"obj_05\", 30); }"}, "route_behaviour": {"sets_flags": [[100, 1, 500]]}, "spawn_sec": 82}], "popups": ["セグナンドは\n自身が通過したマスを占領します。\n\n占領されたマスに\n配置していたユニットは、\n撤退をしますが\n再出撃が可能です。", "敵に占領されているマスは、\n占領している敵を倒すことで、\n使用可能になります。\nマスを占領している敵には、\n旗のマークがついています。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "はぁ……国がどうとか、種族がどうとか、\nほんとよくやるよね、みんな。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "そういうサザンカこそ、\n普段から「鬼こそ最強！」とか叫んでいるじゃないか。", "face": "u1225a1"}, {"name": "サザンカ", "text": "鬼が最強なのは事実だから。\nそういう揺るぎない事実と違ってさ、\n今やってるのは、しなくてもいい戦いじゃん？", "face": "u1347a1"}, {"name": "マレブランケ", "text": "そうはいかないのが、人というものなのさ。\n人間は誇りのために、容易く剣を抜くからね。", "face": "u1225a1"}, {"name": "サザンカ", "text": "……それは、ちょっと分かるけどね。\nでも、誇りのために死ねる戦士かと思えば、\nお金や地位のために戦う連中もいるし……。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "ふふ、大いに悩み給え、若人よ。\nどれだけ悩もうと、私たちが今できるのは、\nこうして洋上監視を続けることだけなのさ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "そうだね。これは街を守るためだし――って、\nマレブランケ！　動いたっ！！\n敵艦隊が揚陸艦を出したよ！！", "face": "u1347a1"}, {"name": "マレブランケ", "text": "よし、陛下に知らせるぞ。\n悩むのは、全部終わらせてからにしよう！", "face": "u1225a1"}]}, {"trigger": "battle", "at_sec": 84, "lines": [{"name": "ベラート", "text": "――さて、そろそろ時間か。\n帝国軍、王国軍の目は洋上に引きつけた。\n……上手くやりたまえ、セグナンド殿。", "face": "l21787b277675"}, {"name": "セグナンド", "text": "……時は来た。\n先陣を切った獣人、オークの戦いぶりは聞いているな。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "一度は帝国に服従し、\nされど怒りを忘れぬ暗がりの民よ、\n種族の誇り、父祖の名誉のために剣を取る時だ。", "face": "l20ac59a2a223"}, {"name": "ドワイト", "text": "――陛下、伝令です！\n北部の街道にダークエルフの部隊が出現、\n陣地を強襲、占拠されたとのこと！", "face": "u348"}, {"name": "レオナ", "text": "やはり来たか……。\nだが、展開が予想より早すぎる。\n敵の指揮官は分かるか？", "face": "u311"}, {"name": "ドワイト", "text": "銀の髪に、黒き外套……。\nおそらくは、ダークエルフを率いる首魁、\nセグナンドだと思われます！", "face": "u348"}, {"name": "白の皇帝", "text": "……物質界のダークエルフ、\nその長が自ら出てきたか。", "face": "u418"}, {"name": "レオナ", "text": "セグナンドの戦法に振り回されるな。\n奴は神出鬼没に戦場を駆け、\nこちらの陣地を占拠してくるはずだ。", "face": "u311"}, {"name": "レオナ", "text": "だが、奴を仕留めれば陣地を取り戻すことができる。\n焦ればセグナンドの術中に嵌められるぞ。", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "サザンカ", "text": "はぁ……はぁ……。\nどうにか、今回もしのいだかな……？", "face": "u1347a1"}, {"name": "マレブランケ", "text": "まったく、戦う理由が分からないと言いながら、\n真っ先に敵陣に突っ込んでいくんだから恐れ入るよ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "ん……だって身体が勝手に……。\nなんだか、戦わないといけない気がしたんだよね。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "国のために？　種族のために？\nあるいは鬼らしく名誉のためかな？", "face": "u1225a1"}, {"name": "サザンカ", "text": "……うぅん、そのどれでもなさそう。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "それなら、どうして戦おうと思ったんだろうね。\n考えてみれば、サザンカが\nこちら側で戦っているのも奇妙な話だというのに。", "face": "u1225a1"}, {"name": "サザンカ", "text": "えっ、えっと、どうして？", "face": "u1347a1"}, {"name": "マレブランケ", "text": "サザンカ、君は帝国に恭順した鬼の一族だろう？\nしかも今や、その族長という立場だ。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "――ならば、冥界軍の蜂起に際して、\n君らも帝国に反旗を翻すと思っていたのさ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "あっ……言われてみれば、確かに……？\nでも、どうしてか反逆しようとか思わなかったんだよね。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "ほほう、それはどうしてかな？", "face": "u1225a1"}, {"name": "サザンカ", "text": "……んー、どうして、なのかなぁ。\n戦っていれば、そのうち分かるのかなー。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "ならば、それまで付き合うとしようか。\n我が友サザンカよ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "あはは、そんなこと言って、\nレオラっち辺りに言い含められたんでしょ？", "face": "u1347a1"}, {"name": "サザンカ", "text": "鬼の一族たるあたしが、\n帝国を裏切らないか近くで見ておけ、とかさ？", "face": "u1347a1"}, {"name": "マレブランケ", "text": "ああ、頼まれたとも。\n無論全力で断ってやったけれどね！", "face": "u1225a1"}, {"name": "サザンカ", "text": "えっ……ど、どうして？", "face": "u1347a1"}, {"name": "マレブランケ", "text": "さっきも言っただろう。\n私はサザンカを友だと思っているからだとも。\nさぁ、警戒を続けよう。まだ敵の攻勢は終わらないぞ？", "face": "u1225a1"}]}], "active": true}