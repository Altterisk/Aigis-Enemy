{"quest_id": 7424, "name": "第二陣 ダークエルフの首魁", "description": "洋上の敵艦隊が再び攻撃を開始。それに\n紛れダークエルフの首魁が動き始める……。\n＜広域戦闘：敵味方の射程減少＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国二陣", "event_category": "Empire", "mission_id": 940006, "map_no": 4573, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "tags": ["機械", "帝国", "置物"], "fixture": true, "uncounted": true, "hp": 36000, "base_hp": 36000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 300, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130880, "special_effect_id": 552, "change_to": 1, "master_id": 34056, "global_id": 7673, "to_condition": 0, "to_global_id": 7674, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag(11, 1);\");", "sets_flags": [[11, 1]], "on_destroy": true}, "route_behaviour": {"hold": {"routes": 4, "held": 4, "release_flags": [0, 11, 13, 14]}, "transforms": [{"wait": 1000}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "帝国", "置物"], "fixture": true, "uncounted": true, "hp": 36000, "attack": 600, "base_hp": 36000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 1000, "attack_speed": 1, "attack_wait": 300, "attack_interval": 691, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130896, "special_effect_id": 858, "missile_id": 598, "missile": {"speed": 3.0, "splash": 80}, "master_id": 34057, "global_id": 7674, "ranged": true, "from_condition": 0}, {"enemy_id": 3, "source": "local", "count": 30, "form_index": 0, "form_count": 2, "tags": ["帝国"]