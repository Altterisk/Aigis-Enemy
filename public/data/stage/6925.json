id": 406, "missile": {"speed": 7.0}, "master_id": 32147, "global_id": 5766, "ranged": true, "spawn_sec": 161}, {"enemy_id": 12, "source": "local", "count": 15, "form_count": 1, "hp": 1400, "base_hp": 1400, "damage_type": "physical", "armor_defense": 3000, "attack_speed": 60, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2110304, "master_id": 30275, "global_id": 3894, "spawn_sec": 191}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "tags": ["ステルス"], "hp": 30000, "attack": 1300, "base_hp": 30000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 95, "attack_interval": 273, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116688, "missile_id": 329, "missile": {"speed": 7.0}, "master_id": 31398, "global_id": 5017, "ranged": true, "spawn_sec": 197}, {"enemy_id": 14, "source": "local", "count": 5, "form_count": 1, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 448, "global_id": 447, "ranged": true, "spawn_sec": 218}], "popups": ["異界召喚士の弟子の攻撃は\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――王子、そろそろ多数の魔物が確認された地点です！", "face": "l1a56d366d6e8"}, {"name": "シャディア", "text": "中には魔王城にて倒したはずの、\n異界召喚士の姿もあったらしい。\n確かにあの時、奴は命を落としたはずだが……。", "face": "u713"}, {"name": "シャルロット", "text": "ともかく、この先にはいくつも村がありますわ。\nここで魔物の軍勢を食い止めないと――", "face": "u128"}]}, {"trigger": "start", "lines": [{"name": "？？？", "text": "――もう一度変身してください。\n……ふむ。……むぅ、似てないですね、やり直し。", "face": "u942"}, {"name": "インプ", "text": "プギィ！？\nこんなハッパで変身しろなんテ無理ダゼェ！？", "face": "ldad1cc783323"}, {"name": "？？？", "text": "口答えするやつは、\nどっちの炎で焼かれたいか選んでください。\nイフリート？　それともサラマンダーですか？", "face": "u942"}, {"name": "インプ", "text": "プギギィ！？\n変身スルっ！　スルカラ！！", "face": "ldad1cc783323"}, {"name": "シャルロット", "text": "あそこにいるのは、\nもしかして異界召喚士の弟子ではありませんか？", "face": "u128"}, {"name": "レアン", "text": "良かった、生きていたんだな。\nだが、いったい何をしているんだ……？", "face": "u50"}, {"name": "？？？", "text": "…………おや？\nあなた方は、確か飛空艇で……。", "face": "u942"}, {"name": "シャルロット", "text": "ご無事で安心しましたわ！\nでもこの魔力の波動、\n精神支配の影響が残っていますわね……。", "face": "u128"}, {"name": "？？？", "text": "せいしん、しはい……？\n何のことでしょうか。", "face": "u942"}, {"name": "？？？", "text": "ともかく、良い召喚魔法の実験台が来ました。\nインプたち、さっそく実践です。\n師匠の姿だけでなく、力も模倣してみせてください。", "face": "u942"}, {"name": "インプ", "text": "プギィ！？　能力マデなんテ……わ、ワカッタ！\n変身スル！　スルカラ！！", "face": "ldad1cc783323"}, {"name": "アンナ", "text": "どうやら、話は通じないようですね。\n王子、魔物の軍勢が来ます。\n迎撃の準備をお願いします！", "face": "l1a56d366d6e8"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "……むぅ。実験失敗。", "face": "u942"}, {"name": "？？？", "text": "でも実験、楽しかったですね。\nこれなら師匠なんて、\nすぐに追い抜いちゃうかもしれません。", "face": "u942"}, {"name": "？？？", "text": "さぁ次の実験に行きますよ、ガーゴイルさん。\nお空をびゅーんです。びゅーん。", "face": "u942"}, {"name": "シャルロット", "text": "あっ……飛んでいってしまいましたわ……。", "face": "u128"}, {"name": "シャルロット", "text": "精神支配の魔法は良くないものですわ。\n次に会った時にはちゃんと解呪してあげませんと！", "face": "u128"}, {"name": "シャディア", "text": "……異界召喚士という枷がなくなって、\nむしろより大変なことになったような気がするな。", "face": "u713"}, {"name": "アンナ", "text": "ともかく、これでこの先の村の被害は、\n未然に防ぐことができました。\n王子、此度の討伐お疲れさまでした！"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "ふふ、実験って楽しいです……♪\n師匠なんてすぐに追い抜いてやりますからね♪", "face": "u942"}]}], "active": true}