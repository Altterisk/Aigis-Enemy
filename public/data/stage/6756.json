"damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30238, "global_id": 3857, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 106}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 2, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "change_to": 10, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31069, "global_id": 4688, "to_global_id": 4678, "route_behaviour": {"transforms": [{"wait": 800}]}, "spawn_sec": 138}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31059, "global_id": 4678, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "マイン", "text": "遠くから穴を掘って、\n世界樹の根っこまでたどり着くねぇ……。\nへっへっへ、楽勝楽勝ってね♪", "face": "u672"}, {"name": "グスタフ", "text": "やれやれ、調子に乗っていらぬ穴を開けぬようにな。\nこの辺りにはどうやら、\n複数の空洞が存在しておるようじゃ。", "face": "u153"}, {"name": "エイル", "text": "――ふわわ、\nドワーフの発破技術ってスゴイんですねぇ。\nどんどん通路が出来上がっていきますよ！", "face": "u804"}, {"name": "アンナ", "text": "けれど、よく世界樹の根まで穴を掘る許可が出ましたね。\n世界樹の民からすれば、\n神聖な樹の根が傷つけられる危険もあるというのに……。", "face": "l622c96554351"}, {"name": "クゥイル", "text": "それはエイルさんのおかげかもしれませんね。\n頭の固い長老達が、エイルの頼みなら\n聞いてやっても良いって言い出したんですよ。", "face": "u702"}, {"name": "アリア", "text": "あの子は昔から、\nお爺ちゃんお婆ちゃんに好かれる子ですからね。\nエイルを世界樹に派遣した王子の慧眼でしょうか。", "face": "u75"}, {"name": "エイル", "text": "……ふぇっ？　何か言いました？", "face": "u804"}, {"name": "アリア", "text": "いいえ、何でも。\nしかし気がかりなのは、\n長老さんのもうひとつの言葉ですね。", "face": "u75"}, {"name": "クゥイル", "text": "いわく、この世界樹の枯死と見慣れぬ虫は、\n世界樹にやがて訪れるという災厄とは\n関係がない、ということですからね……。", "face": "u702"}, {"name": "シュシュ", "text": "世界樹を崩壊させかねないこの事件すら、\n災厄ではないだなんて……。\nうぅぅ、今から怖くて夜も眠れないですよぉ……。", "face": "u656"}, {"name": "エイル", "text": "……あれ、王子さま、今何か聞こえませんでした？", "face": "u804"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "エイル", "text": "……間違いありません。\n何かが近付いて来ています。\nこの足音は……ま、魔界アリです！", "face": "u804"}, {"name": "アリア", "text": "王子、急ぎ迎撃の用意をお願いします。\nエイル、あなたは王子の援護を！", "face": "u75"}, {"name": "エイル", "text": "は、はいっ！　わっかりましたー！！\n王子さま、頑張りましょうね！！", "face": "u804"}]}, {"trigger": "end", "lines": [{"name": "エイル", "text": "ふぅ……。\n何とかなりましたぁ……。", "face": "u804"}, {"name": "マイン", "text": "……へぇ、中々やるじゃねぇか。\n新兵って聞いてたけど、\n射撃の腕はかなりのものに見えるぞ。", "face": "u672"}, {"name": "エイル", "text": "えっ、えぇっ、そうです？\nそう見えちゃいます？　えへ、えへへぇ……♪", "face": "u804"}, {"name": "アリア", "text": "マインさん、エイルは褒めると\n褒めただけのぼせ上がるので……。", "face": "u75"}, {"name": "エイル", "text": "お姉ちゃん！？", "face": "u804"}, {"name": "グスタフ", "text": "ほう、つまりマインと同じじゃな。", "face": "u153"}, {"name": "マイン", "text": "何だとジジィ！？", "face": "u672"}, {"name": "グスタフ", "text": "ほれ、先を急ぐぞマイン。\n早くそちらに爆薬を設置せんか。", "face": "u153"}, {"name": "マイン", "text": "ぐぬぬぬぬ……。", "face": "u672"}, {"name": "エイル", "text": "ぐぬぬぬぬ……。", "face": "u804"}]}], "active": true}