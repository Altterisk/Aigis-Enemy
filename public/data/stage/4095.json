{"quest_id": 4095, "name": "神殿の翼竜", "description": "竜殺しの剣を狙って、さらなる\n追っ手が迫る！\n襲い来る魔物たちを撃退せよ！", "event": "竜殺しの剣", "event_category": "History", "mission_id": 920022, "map_no": 3851, "level": 80, "multiplier": 0.8, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 24, "form_count": 1, "hp": 512, "attack": 112, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "hp": 512, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 45}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "hp": 2240, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 86}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 512, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 106}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 720, "attack": 160, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 136}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 3200, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 42, "global_id": 41, "ranged": true, "spawn_sec": 147}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "……とはいえ、刻水晶を集めると\nいってもどうしたらよいのでしょうか。", "face": "l9cd57864533c"}, {"name": "クローディア", "text": "先ほどのような翼竜も刻水晶を持っていますが\n力はとても弱いです。", "face": "u163"}, {"name": "クローディア", "text": "剣の力を取り戻すためにはもっと\n力の強い刻水晶が必要です。", "face": "u163"}, {"name": "アンナ", "text": "力の強い刻水晶ですか。\n事情を話せば分けてくれるでしょうか？", "face": "l9cd57864533c"}, {"name": "クローディア", "text": "おそらく無理かと思われます。\n人間に好意的な竜も、例外として\nこの世のどこかにはいると聞きます。", "face": "u163"}, {"name": "クローディア", "text": "しかし、大抵は人間をエサとしてしか\n見ていませんから……。\n竜を倒して奪うほかないと思います。", "face": "u163"}, {"name": "アンナ", "text": "そうですか。では、これから竜を探しにいくと\nいうわけですね。", "face": "l9cd57864533c"}, {"name": "クローディア", "text": "はい。\n樹海に住むという竜の元へ行きます。", "face": "u163"}, {"name": "兵士", "text": "ご報告します！\n再び、敵襲です！", "face": "ld123ca7495a6"}, {"name": "アンナ", "text": "先ほどの魔物たちの増援でしょう。\n王子、出撃のご準備を！", "face": "l9cd57864533c"}]}], "active": true}