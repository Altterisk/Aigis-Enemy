: 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 105}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 109}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 8, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 11, "source": "local", "count": 14, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 131}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 137}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 143}], "dialogue": [{"trigger": "start", "lines": [{"name": "ぬらりひょん", "text": "もう一度言うぞ！\nさあ、封じられた魔物よ！\n出てくるのだ！", "face": "l717fe41d1c20"}, {"name": "？？？", "text": "あー、よく寝た。\nあれ？　でもまだ暗いぞ。\n夜なのか？", "face": "u327"}, {"name": "ぬらりひょん", "text": "お前がここに封印されていた魔物か。\nうーむ、想像と少し違うな……。\n何者だ名を名乗れ！", "face": "l717fe41d1c20"}, {"name": "？？？", "text": "なんだ、このじいさん。\nオレの名前を知りたきゃ、\nまず、お前が名乗れよ。", "face": "u327"}, {"name": "ぬらりひょん", "text": "な、なんだと……！　よ、よかろう。\nわしは妖怪総大将ぬらりひょん様じゃ。\nさあ、頭が高いひかえおろう。", "face": "lcf2e34c322f2"}, {"name": "？？？", "text": "妖怪の分際でえらそうに。\nよく聞け、オレの名は……ん？\nオレの名は……あれ、なんだっけ？", "face": "u327"}, {"name": "ぬらりひょん", "text": "自分の名前もわからぬのか！？\nまあ良い、封印を解いてやったのだ\nわが軍団に加わるのだ。", "face": "l717fe41d1c20"}, {"name": "？？？", "text": "へー、オレの主になりたいっていうのか。\nいいだろう、オレよりも強かったら\n手下になってやるよ。", "face": "u327"}, {"name": "ぬらりひょん", "text": "ちょ、ちょっと待て！", "face": "lcf2e34c322f2"}, {"name": "アンナ", "text": "そうです。ちょっとお待ちください。\nあなたは何者ですか。", "face": "lda7475f51c8c"}, {"name": "？？？", "text": "うるさいな。こいつをぶっ倒した後に\n相手してやるよ。\nさあ、じいさん、こっちに来い！", "face": "u327"}, {"name": "兵士", "text": "魔物の群れがこちらに\n向かって来ています！", "face": "lfe765ec149a6"}, {"name": "ケイティ", "text": "こんな時に！\n王子、まずは魔物を倒しましょう。", "face": "u114"}]}, {"trigger": "battle", "at_sec": 88, "lines": [{"name": "？？？", "text": "あーあ、あのじいさん口ほどでもねぇ。\nまだ暴れたりないぜ。", "face": "u327"}, {"name": "？？？", "text": "お、まだいたのか。\nお前たちもオレを仲間にしたかったら\nかかって来いよ！", "face": "u327"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "いてて、くそう、まだ起きたばかりだから\n力がでねぇ。\nよく聞け、まだ負けたわけじゃないぞ。", "face": "u327"}, {"name": "仙猿", "text": "……お！？　でも一つ思い出したぜ。\nオレは仙猿だ。猿の仙人ってやつだな。", "face": "u327"}, {"name": "アンナ", "text": "仙猿？\n魔物ではないのですか……。", "face": "lda7475f51c8c"}, {"name": "仙猿", "text": "どっちかっていうと魔物と戦っていた\n気がするな。", "face": "u327"}, {"name": "仙猿", "text": "でも、人間とも仙人たちとも戦っていた\n気もする……。\nまあ、いっか。こまけぇことは気にすんな。", "face": "u327"}, {"name": "ロイ", "text": "自分が何者かくらいは\n気にしたほうがよいですぞ。", "face": "u11"}, {"name": "仙猿", "text": "それよりも、お前たち。よく聞け。\nオレは腹が減った。これから腹ごしらえ\nしてくるから、その後勝負だ！", "face": "u327"}, {"name": "アンナ", "text": "ちょ、ちょっとお待ち下さい！", "face": "lda7475f51c8c"}]}], "active": true}