{"quest_id": 8159, "name": "永遠の眠りに誘う魔女", "description": "人々を仮死させ綺麗なまま永遠に\n保護しようとする災厄の魔女スィーテンを\n打ち破り、この悪夢を終わらせよ！！\n神級（★１獲得の目安：平均Lv50）", "event": "ビタースイートアイヴィワルツ", "event_category": "History", "mission_id": 920210, "map_no": 4845, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 35, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 550, "base_hp": 4000, "base_attack": 550, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 70, "attack_wait": 30, "attack_interval": 185, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149872, "special_effect_id": 1623, "master_id": 37031, "global_id": 10648, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 240, "base_hp": 4000, "base_attack": 240, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115520, "special_effect_id": 308, "master_id": 31219, "global_id": 4838, "spawn_sec": 19}, {"enemy_id": 3, "source": "local", "count": 34, "form_count": 1, "tags": ["植物"], "hp": 7000, "attack": 750, "base_hp": 7000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 30, "attack_interval": 185, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149888, "special_effect_id": 1624, "master_id": 37032, "global_id": 10649, "spawn_sec": 75}, {"enemy_id": 4, "source": "local", "count": 16, "form_count": 1, "tags": ["植物", "ボムプラント"], "hp": 3300, "attack": 400, "base_hp": 3300, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_speed": 30, "attack_wait": 10, "attack_interval": 103, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131664, "special_effect_id": 887, "master_id": 34187, "global_id": 7804, "spawn_sec": 79}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 240, "base_hp": 4000, "base_attack": 240, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131168, "special_effect_id": 872, "master_id": 34127, "global_id": 7744, "spawn_sec": 79}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "tags": ["植物"], "hp": 12000, "attack": 850, "base_hp": 12000, "base_attack": 850, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_wait": 50, "attack_interval": 139, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119376, "special_effect_id": 400, "master_id": 31845, "global_id": 5464, "spawn_sec": 85}, {"enemy_id": 7, "source": "local", "count": 5, "form_count": 1, "tags": ["植物"], "hp": 22000, "attack": 600, "base_hp": 22000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 1, "attack_wait": 30, "attack_interval": 102, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116192, "special_effect_id": 320, "master_id": 31315, "global_id": 4934, "spawn_sec": 110}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "tags": ["植物", "アンデッド"], "hp": 67000, "attack": 1500, "base_hp": 67000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 186, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2149904, "special_effect_id": 1625, "change_to": 8, "change_condition": 2, "master_id": 37034, "global_id": 10651, "to_condition": 2, "to_global_id": 10652, "route_behaviour": {"calls_event": [2163, 2164, 2165, 2166]}, "spawn_sec": 148}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "アンデッド"], "hp": 142000, "attack": 2400, "base_hp": 142000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 550, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 200, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2149920, "special_effect_id": 1626, "master_id": 37035, "global_id": 10652, "from_condition": 2}], "popups": ["アルラウネがいる間、\n全ての味方ユニットは\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ワルツ", "text": "……あなたの、目的は何？\nどうして、人々を眠らせるの？", "face": "u2058a1"}, {"name": "スィーテン", "text": "花が萎れることが怖いから。永遠であってほしいから。\nなぜなら人間の心はうつくしい――そうでしょう？", "face": "l22719d3937ab"}, {"name": "スィーテン", "text": "うつくしい心が、枯れ果てる前に。\n奇麗なままで、揃えて並べて飾っていたいの。", "face": "l22719d3937ab"}, {"name": "スィーテン", "text": "うつくしくなくなる、可能性。\nそれを打ち消すために、私は戦う！", "face": "l22719d3937ab"}, {"name": "シャディア", "text": "高潔な者の精神が、くすんでしまう可能性。\nそれが怖いから全員纏めて仮死にする、と聞こえるが？\n人間の心を持て囃すくせして、ずいぶんと臆病者だな。", "face": "u2056a1"}, {"name": "ワルツ", "text": "それで昏睡させるだなんて、身勝手なひと。\nお生憎様、私たちは自分の意思で踊っていたいの。", "face": "u2058a1"}, {"name": "スィーテン", "text": "ああ、乾びる乾びる、その前に。\n私が、すべてのうつくしい心を押し花に変える！", "face": "l22719d3937ab"}, {"name": "シャディア", "text": "悪いが私たちは、似たような大義を掲げる\nもっと強大な奴と戦っている最中なんだ。", "face": "u2056a1"}, {"name": "キャロップ", "text": "うん。だからそんな大規模なことを言っても、\n同じようなことを返してくれると思わないでね。", "face": "u2059a1"}, {"name": "ワルツ", "text": "『大切な人たちに危害を加えやがって』。\nあなたを討つには、そんな小規模な怒りで事足ります。", "face": "u2058a1"}, {"name": "ワルツ", "text": "眠れる花たちのためのワルツ。\n一曲、踊ってさしあげましょう。", "face": "u2058a1"}]}, {"trigger": "end", "lines": [{"name": "スィーテン", "text": "――ギャッ！？", "face": "l8ea7e49bc1cc"}, {"name": "シャディア", "text": "よし、腕を斬り落とした。", "face": "u2056a1"}, {"name": "キャロップ", "text": "背中に耳の穴みっつ空けといた。", "face": "u2059a1"}, {"name": "スィーテン", "text": "わだ、しは、あきらめない。\n必ずまた立ち上がり、ひとびとを、うつくしいまま……。", "face": "l8ea7e49bc1cc"}, {"name": "ポミエ", "text": "スィーテンが……地面に潜って逃げていきます～！？", "face": "u1422a1"}, {"name": "シャディア", "text": "地中まで深追いはできないだろう。\nどのみち、あの傷ではまともに動けないはず。でも――。", "face": "u2056a1"}, {"name": "キャロップ", "text": "うん、昏睡していた人たちの意識は、戻らないまま。\nスィーテンも取り逃がして、なんか、負けた気分。", "face": "u2059a1"}, {"name": "ワルツ", "text": "そんなに気を落とさないで。\n王国には、たくさんの協力者がいる。\nきっと誰かが、解決に導いてくれるはず。", "face": "u2058a1"}, {"name": "キャロップ", "text": "……うん。", "face": "u2059a1"}, {"name": "ワルツ", "text": "ねえ私、やっぱりスィーテンとは相容れないの。\n美しくても、そうじゃなくても、生き続けていいもの。", "face": "u2058a1"}, {"name": "ワルツ", "text": "それに、美しくないとされた何かが、\nうっかり誰かを救ってしまうこともある。\nそんな沢山の可能性と共に歩むのが、王国軍でしょ？", "face": "u2058a1"}, {"name": "チョコレート騎士", "text": "たッ……大変だ！\nシャディアのまずいチョコを食べさせたら、\n昏睡していた女性の意識が一瞬戻った！", "face": "l70733d6e01bc"}, {"name": "ワルツ", "text": "――ほらね！", "face": "u2058a1"}]}, {"trigger": "route", "enemy_ids": [8], "lines": [{"name": "スィーテン", "text": "ああ、やはり人間の心はうつくしい。\n私の葉と茎を焦がすその怒りさえ。", "face": "l22719d3937ab"}, {"name": "スィーテン", "text": "でも人間が、諦めない心の大切さを教えてくれた！\nだから私は折れない……ギッ――ジュオオオオ！！", "face": "l8ea7e49bc1cc"}, {"name": "シャディア", "text": "くっ……なんだあいつ、一人で盛り上がって！", "face": "u2056a1"}, {"name": "ワルツ", "text": "姿が変わった……あれが本性なの？\n皆、ここからが本番よ！", "face": "u2058a1"}]}], "active": true}