{"quest_id": 7486, "name": "植え付けられた恐怖", "description": "引き続き捜査を行い、闇組織構成員に\n投降を呼びかける一行。しかし、フォーに\n対する恐怖によって交渉は決裂してしまう。\n極級（★１獲得の目安：平均Lv25）", "event": "クリスマス・デストロイヤー", "event_category": "History", "mission_id": 920170, "map_no": 4005, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131872, "race_id": 16, "special_effect_id": 891, "change_to": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 34219, "global_id": 7836, "ranged": true, "to_global_id": 7837, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103536, "race_id": 16, "special_effect_id": 61, "master_id": 34220, "global_id": 7837}, {"enemy_id": 3, "source": "local", "count": 11, "form_count": 2, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131840, "race_id": 16, "change_to": 3, "master_id": 34215, "global_id": 7832, "to_global_id": 7833, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 9}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1,