_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131856, "race_id": 16, "change_to": 5, "master_id": 34217, "global_id": 7834}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 2, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "change_to": 2, "master_id": 34216, "global_id": 7833, "to_global_id": 7832, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 53}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131840, "race_id": 16, "change_to": 3, "master_id": 34215, "global_id": 7832}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109072, "race_id": 16, "special_effect_id": 61, "change_to": 7, "master_id": 34222, "global_id": 7839, "to_global_id": 7838, "route_behaviour": {"transforms": [{"wait": 1980}]}, "spawn_sec": 80}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 331, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131888, "race_id": 16, "special_effect_id": 891, "change_to": 6, "missile_id": 26, "master_id": 34221, "global_id": 7838, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 14, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 331, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131888, "race_id": 16, "special_effect_id": 891, "change_to": 6, "missile_id": 26, "master_id": 34221, "global_id": 7838, "ranged": true, "to_global_id": 7839, "spawn_sec": 113}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109072, "race_id": 16, "special_effect_id": 61, "change_to": 7, "master_id": 34222, "global_id": 7839}], "dialogue": [{"trigger": "start", "lines": [{"name": "闇組織構成員", "text": "――よし、頭部装甲も梱包完了っと。\nこれでフォー様に殺されることはないだろう……。", "face": "l284a85e2b734"}, {"name": "闇組織構成員", "text": "……闇ギルド時代が懐かしいな。\nナイン様の下で働いてた時は、\n危なっかしいけど、毎日楽しくて……。", "face": "l284a85e2b734"}, {"name": "セブン", "text": "――よぉ、その続きを聞かせてくれよ。", "face": "u449"}, {"name": "闇組織構成員", "text": "なっ……セブン様……！？\n……いけません、ナイン様のご友人と言えど、\nこれを話したら、俺の命も危ないんですよ……。", "face": "l284a85e2b734"}, {"name": "セブン", "text": "足を洗うなら、王子が面倒見てくれる。\nアイリーン姐さんだって味方してくれるぞ。", "face": "u449"}, {"name": "闇組織構成員", "text": "くっ……しかし……。\nだめだっ、俺は死にたくない！\nあいつは――フォーはどこまでも追ってくるんだ！！", "face": "l284a85e2b734"}, {"name": "ヘレナ", "text": "……セブンとアイリーンの名前を出した上でも、\nまだ離反できない程の恐怖を植え付けられているのか。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "恐怖政治なんてものじゃないな。\nフォーとやら、王国の未来にも悪影響を及ぼすぞ。", "face": "u1397a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "セブン", "text": "はぁ……悪い、ヘレナ。\n交渉決裂みたいだ。", "face": "u449"}, {"name": "ヘレナ", "text": "仕方ない。\nここは実力で倒して捕縛――いや、\n更生の余地があるなら保護してやらないと、か。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "王国にすでに運び込まれた部品も気になる。\n王子、迅速に片付けてしまおう！", "face": "u1397a1"}]}, {"trigger": "end", "lines": [{"name": "闇組織構成員", "text": "……すみません、セブン様、アイリーンの姐さん。\nでも俺、死にたくなくて、怖くて……。", "face": "l284a85e2b734"}, {"name": "セブン", "text": "いいんだ。\n今の組織が、闇ギルドの頃とは\n別物だってことは知ってるからな。", "face": "u449"}, {"name": "ヘレナ", "text": "……ふぅ、あいつはセブンに任せておいて大丈夫そうだな。\nあとは工場内で、もう梱包されている\n機械部品を見つけ出せば――", "face": "u1397a1"}, {"name": "デーモンシェフ", "text": "――それはもう済ませてあるぞ。\n工場所属の社員総出で\n梱包済みの箱をひっくり返したからな。", "face": "lf28f528005ca"}, {"name": "ヘレナ", "text": "さすがだデーモンシェフ！\nふむ……これが見つかった部品か……。", "face": "u1397a1"}, {"name": "アナベラ", "text": "ゴーレム……にも似てるけど、\nもっと魔術より機械寄りのパーツに見えるね。", "face": "u1309a1"}, {"name": "メレディス", "text": "ゴーレムには魔導技術が必須ですからね。\nとなると、これは何の部品なのでしょうか。", "face": "u400"}, {"name": "エスネア", "text": "あれ……？\nこれって……うーん……？", "face": "u997"}, {"name": "デーモンシェフ", "text": "エスネアよ、もしや見覚えがあるのか？", "face": "lf28f528005ca"}, {"name": "エスネア", "text": "うーん、もしかして、なんだけど……。\nこれってメカドラゴンシリーズじゃないかなぁ……。", "face": "u997"}, {"name": "クロエ", "text": "……あっ、本当だ。\nしかもこの塗装、暗黒メカドラゴンの後継機かも。", "face": "u145"}, {"name": "エフネ", "text": "よく見分けがつきますね……。\n――って、そういえばメカドラゴンのおもちゃは、\nデーモンシェフの工場で作っていたのでは？", "face": "u969"}, {"name": "デーモンシェフ", "text": "……心当たりがあるぞ。\nしばらく前に、工場に盗人が入ったのだ。", "face": "lf28f528005ca"}, {"name": "デーモンシェフ", "text": "あの時は何も盗まれなくて良かったと思ったのだが……。\nもしや設計図を写していったのか……！？", "face": "lf28f528005ca"}, {"name": "アナベラ", "text": "なるほどね……分かってきたぞ……。\nフォーは王国の警備を抜けるために、\nわざと部品をバラし、プレゼントに紛れ込ませ――", "face": "u1309a1"}, {"name": "ヘレナ", "text": "――現地で組み立てるつもり、ってことか。\nまずい……まずいぞ王子。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "今の王国は、外からの攻撃には強いけど、\n市街地で暴れられると、対応できる兵力が足りない。", "face": "u1397a1"}, {"name": "アンナ", "text": "王子、急いで王国へ帰還しましょう。\nフォーの企みを阻止するために！", "face": "l198e9e9e8c91"}]}], "active": true}