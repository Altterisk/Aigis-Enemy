{"quest_id": 6579, "name": "封印晶の迷宮", "description": "文献の迷宮に至った王子たちは、封印晶の\n力を発する魔物を発見。欠片の力によって\n傷つくほどに凶暴性を増す敵を迎撃せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "降魔の復讐者", "event_category": "History", "mission_id": 920115, "map_no": 5479, "level": 100, "multiplier": 1.0, "charisma": 50, "exp": 280, "gold": 1200, "drops": [{"item": 5003, "c": 2}, {"card": 25, "c": 1}, {"card": 24, "c": 1}, {"card": 150, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 17}, {"enemy_id": 3, "source": "local", "count": 22, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 50, "base_hp": 1200, "base_attack": 50, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 140, "attack_speed": 30, "attack_wait": 75, "attack_interval": 241, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 30909, "global_id": 4528, "ranged": true, "spawn_sec": 36}, {"enemy_id": 4, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 120, "base_hp": 2000, "base_attack": 120, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 31278, "global_id": 4897, "ranged": true, "spawn_sec": 64}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 120, "base_hp": 10000, "base_attack": 120, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "special_effect_id": 317, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 31280, "global_id": 4899, "ranged": true, "spawn_sec": 90}, {"enemy_id": 6, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 131}], "dialogue": [{"trigger": "start", "lines": [{"name": "アリサ", "text": "ここが「封印晶」が\nあったとされる迷宮ですか……。", "face": "u24"}, {"name": "ノワール", "text": "……おそらくな。\n迷宮中から「封印晶」の気配がする。\nやはり魔物が所持しているようだ……。", "face": "u679"}, {"name": "フィリス", "text": "なぁに、片っ端から倒して、\n欠片を取り戻せばいいんだ。", "face": "u40"}, {"name": "ソーマ", "text": "……あれ？\nさっきより呼吸が楽になったような……。", "face": "u23"}, {"name": "ノワール", "text": "……迷宮の内部までは、\n魔界の瘴気も入ってこないのだろう。", "face": "u679"}, {"name": "ユリアン", "text": "――おっと、話は後だ。\n早速お客さんみたいだぜ。", "face": "u7"}, {"name": "ソーマ", "text": "王子、前方から魔物の群れが！", "face": "u23"}, {"name": "バルバストラフ", "text": "ノワールや、\nあの中に「封印晶」の反応はあるかのう？", "face": "u63"}, {"name": "ノワール", "text": "――ああ。\nあの中の何体かの魔物が、\n「封印晶」を所持しているようだ……。", "face": "u679"}, {"name": "アンナ", "text": "王子、先程と同じく、\n魔物は凶暴になっているはずです。\n気を抜かないで迎え撃ちましょう！", "face": "l2fe133ccbf94"}]}, {"trigger": "end", "lines": [{"name": "ノワール", "text": "やはり「封印晶」を持っていたか……。\n僅かだが、欠片が出てきた。", "face": "u679"}, {"name": "バルバストラフ", "text": "微弱じゃが、魔力は残っているようじゃの。\nこれならば、数を集めれば増幅が出来そうじゃ。", "face": "u63"}, {"name": "アンナ", "text": "希望が見えてきましたね。\n王子、どうやら迷宮は奥に続いているようです。\n警戒しつつ奥へ進みましょう。"}]}], "map": {"image": "Map920115_5479", "w": 960, "h": 640, "spots": [{"k": "b", "x": 22, "y": 168}, {"k": "b", "x": 948, "y": 285}, {"k": "m", "x": 334, "y": 328, "id": 200}, {"k": "m", "x": 505, "y": 420, "id": 201}, {"k": "m", "x": 423, "y": 278, "id": 202}, {"k": "m", "x": 321, "y": 428, "id": 203}, {"k": "m", "x": 507, "y": 326, "id": 204}, {"k": "m", "x": 413, "y": 474, "id": 205}, {"k": "m", "x": 231, "y": 279, "id": 206}, {"k": "m", "x": 600, "y": 371, "id": 207}, {"k": "m", "x": 242, "y": 377, "id": 208}, {"k": "m", "x": 624, "y": 286, "id": 209}, {"k": "m", "x": 703, "y": 245, "id": 210}, {"k": "m", "x": 621, "y": 117, "id": 211}, {"k": "m", "x": 695, "y": 156, "id": 212}, {"k": "m", "x": 384, "y": 109, "id": 213}, {"k": "m", "x": 541, "y": 76, "id": 214}, {"k": "m", "x": 147, "y": 229, "id": 215}, {"k": "m", "x": 311, "y": 148, "id": 216}, {"k": "m", "x": 453, "y": 72, "id": 217}, {"k": "m", "x": 783, "y": 198, "id": 218}, {"k": "m", "x": 238, "y": 187, "id": 219}, {"k": "m", "x": 869, "y": 243, "id": 220}, {"k": "m", "x": 604, "y": 482, "id": 221}, {"k": "m", "x": 418, "y": 378, "id": 222}, {"k": "r", "x": 137, "y": 125, "id": 300}, {"k": "r", "x": 535, "y": 165, "id": 301}, {"k": "r", "x": 677, "y"