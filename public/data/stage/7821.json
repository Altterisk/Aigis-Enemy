{"quest_id": 7821, "name": "伝説のアイドル", "description": "伝説のアイドル、アンナちゃんの限定\nライブが開催！　最後の曲を前に盛り\n上がる会場へ魔物の群れが襲い来る。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "AIGIS Idol Project", "event_category": "History", "mission_id": 920191, "map_no": 4669, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 24, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 12, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 44}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 44}, {"enemy_id": 4, "source": "local", "count": 7, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 88}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 110}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 6, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 128}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 5, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 8, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 134}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 7, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "みなさーん！　今日はアンナの\n限定ライブに来てくれて、ありがとうーっ！！", "face": "u606"}, {"name": "アンナのファン", "text": "うぉぉぉぉ！\nアンナ！　アンナ！　らぶりー政務官！！", "face": "lbc816400d0f7"}, {"name": "アンナの古参ファン", "text": "待ってた……この日をずっと待ってた……。\nこれが俺たちのアイドル黄金時代……！！", "face": "l7f6ffd8de701"}, {"name": "リノ", "text": "はぁ……アンナさん、すっごい輝いてる……。\nうぅぅ、ライブ来てよかったなぁ……。", "face": "u350"}, {"name": "リノ", "text": "王子、一緒についてきてくれてありがとね。\nやっぱりこういうの、ひとりじゃ不安でさ。", "face": "u350"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "アンナ", "text": "それじゃあ、次が最後の曲です。\nライブが終わっちゃうの寂しいけど、\nでも、みんなとはずっと一緒ですからね！", "face": "u606"}, {"name": "アンナのファン", "text": "うぅぅ、ぐすっ……。\nアンナさん……いや、伝説のアイドルアンナちゃん……。", "face": "lbc816400d0f7"}, {"name": "アンナの古参ファン", "text": "泣くなよ、新入り……。\nアンナちゃんは政務官が本職なんだ。\nでもきっと、帰ってきてくれるはずだ……！", "face": "l7f6ffd8de701"}, {"name": "リノ", "text": "わっ……次が最後の曲だって！\nすごい、皆の期待と声援で、\nまるで会場全体が揺れてるみたい！", "face": "u350"}, {"name": "ミヤビ", "text": "……ん、いえ、これ本当に揺れてますよ！？\nこの地響き、何かの大群が走っているような――", "face": "u496"}, {"name": "警備スタッフ", "text": "ま、魔物だー！！\nライブ会場に魔物が迫っているぞー！！", "face": "u65"}, {"name": "リノ", "text": "ま、魔物！？\nそんな、せっかくのアンナさんのライブが……。", "face": "u350"}, {"name": "警備スタッフ", "text": "政務官殿！　すぐに避難してください！\nライブは中止です！　今すぐ安全な場所に！", "face": "u65"}, {"name": "アンナ", "text": "……だめ、だめですっ！\nせっかくみんなが、\nこの日を楽しみにしてくれていたのに……。", "face": "u606"}, {"name": "警備スタッフ", "text": "伝説のアイドル、アンナちゃんの安全の方が重要です！\nあなたは王国にいなくてはならない、\n重要な人物なのですから！", "face": "u65"}, {"name": "会場警備員", "text": "魔物が警備網を突破しました！\nもう時間がありません！", "face": "u6"}, {"name": "アンナ", "text": "……うぅ、どうして。\n今回は魔物を寄せ付けないように、\n魔力を隠す準備もしていたのに……。", "face": "u606"}, {"name": "リノ", "text": "アンナさん……。", "face": "u350"}, {"name": "王子", "text": "…………。\n…………（ガタッ）", "face": "u1"}, {"name": "リノ", "text": "えっ、お、王子！？　どこいくの！？\n――あ、アンナさんを助けにいくって！？", "face": "u350"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "ありがとうございます、王子。\n……ライブ、来てくれてたんですね。", "face": "u606"}, {"name": "アンナ", "text": "王子は忙しいから、誘うかどうか\nずっと悩んでいたんです。\nでも、こうして来てくれて、私、本当に――", "face": "u606"}, {"name": "リノ", "text": "――あっ、いた！　王子、大丈夫！？\nって、わっ、アンナさんも……。", "face": "u350"}, {"name": "アンナ", "text": "…………あっ。\nそ、そうでしたか、今日はリノさんと……。", "face": "u606"}, {"name": "リノ", "text": "アンナさん！　ライブ、とっても素敵だったよ！\nうぅぅ、私もうずうずしてきちゃった！", "face": "u350"}, {"name": "アンナ", "text": "ふふっ、良かったです。\nライブが中断になってしまったのは残念ですけど、\n喜んでもらえたなら、歌った甲斐がありました♪", "face": "u606"}, {"name": "会場警備員", "text": "――会場の安全確認、完了しました。\nどうにかライブの続きもできそうです。", "face": "u6"}, {"name": "アンナ", "text": "分かりました。\n――それじゃあ王子、リノさん、\n最後まで楽しんでいってくださいね！", "face": "u606"}, {"name": "リノ", "text": "はいっ！\nそれじゃ王子、元の場所に戻ろっか。", "face": "u350"}, {"name": "リノ", "text": "（リノも……あんなふうに歌えたらな……）", "face": "u350"}]}], "active": true}