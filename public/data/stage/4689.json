{"quest_id": 4689, "name": "暴虐のエルダートロル", "description": "凶暴化したトロルの群れが襲い掛かる！\n自身の傷を修復する能力に注意せよ！\n\n神級（★１獲得の目安：平均Lv50）", "event": "帝国の治癒士", "event_category": "History", "mission_id": 920074, "map_no": 3844, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 6000, "base_hp": 6000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101840, "race_id": 3, "special_effect_id": 55, "master_id": 434, "global_id": 433, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 43, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 20, "attack_wait": 40, "attack_interval": 136, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2105040, "special_effect_id": 66, "master_id": 593, "global_id": 592, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 900, "base_hp": 15000, "base_attack": 900, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 20, "attack_wait": 40, "attack_interval": 151, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103872, "special_effect_id": 68, "master_id": 600, "global_id": 599, "spawn_sec": 56}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 100000, "attack": 2500, "base_hp": 100000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 100, "attack_speed": 20, "attack_wait": 80, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105024, "special_effect_id": 67, "missile_id": 58, "master_id": 592, "global_id": 591, "ranged": true, "spawn_sec": 129}], "dialogue": [{"trigger": "start", "lines": [{"name": "ベルゼビュートの配下", "text": "ブブッ……あれがトロルか。\n", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "あの巨大な身体に、傷の再生能力……。\n物質界の魔物は頼りないが、\n奴なら少しは使えるかもしれん。", "face": "ld8ef79b3ed4d"}, {"name": "トロル", "text": "なんだ……オマエ。\nクンクン…………あまり、美味そうじゃないな。\nそれに、臭い。オマエ、近寄るな。", "face": "l24049f0d62cc"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……我々は食べ物ではない！\n生きている者ならば何でも食べようとするとは……。\nもう良い。他に使える魔物を探しに行く。ブブッ。", "face": "ld8ef79b3ed4d"}, {"name": "トロル", "text": "グォォォォオオオオオッッッ！！！！？？", "face": "l24049f0d62cc"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……！　これは！？", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "奴の自己修復能力と我々が持つ病原菌が\nせめぎあうことで精神異常が生じ、\n凶暴化したというわけか……ブブッ！", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……！　これはこれで良いな。\nこの状態のトロルを人間へと差し向ければ\n面白いことになるだろう……ブブッ。", "face": "ld8ef79b3ed4d"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、このあたりでトロルの姿が確認されています。\n行商人たちに危害を加えているらしく、\n退治して欲しいとのことですが……。", "face": "lab3e5c39447d"}, {"name": "トロル", "text": "ウゴォォォォオアアアアアッッッ！！\nニンゲン、喰イタイ！　ニンゲン、喰イタイィッ！　", "face": "l24049f0d62cc"}, {"name": "ケイティ", "text": "――ッあれはトロル！\n王子、慎重な采配をお願い致します！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "ふぅ……どうやらこれで、\n大体のトロルは倒せたみたいですね。", "face": "u114"}, {"name": "アンナ", "text": "ですが、やはり先ほどのトロルの様子は\nどこか変でしたね……。", "face": "lab3e5c39447d"}, {"name": "ケイティ", "text": "この地域に生息するトロルに\n何か変化が起きているのでしょうか？", "face": "u114"}, {"name": "アンナ", "text": "……少し調査してみる必要がありそうですね。\n王子、帰還後この件について話し合いましょう。", "face": "lab3e5c39447d"}, {"name": "ベルゼビュートの配下", "text": "……行ったようだな……ブブッ。", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……まさかあの暴走したトロルを倒すとは、\n人間の力はやはり侮れないな……ブブッ。", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……だが、今回の戦いで、\n面白い実験結果を得ることもできた……。", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "……ブブッ。\n早速、ベルゼビュート様に報告を……。ブブッ。", "face": "ld8ef79b3ed4d"}]}], "map": {"image": "Map920074_3844", "w": 960, "h": 640, "spots": [{"k": "b", "x": 604, "y": 367}, {"k": "m", "x": 124, "y": 411, "id": 200}, {"k": "m", "x": 666, "y": 464, "id": 201}, {"k": "m", "x": 759, "y": 464, "id": 202}, {"k": "m", "x": 527, "y": 463, "id": 203}, {"k": "m", "x": 424, "y": 463, "id": 204}, {"k": "m", "x": 325, "y": 440, "id": 205}, {"k": "m", "x": 171, "y": 165, "id": 206}, {"k": "m", "x": 233, "y": 384, "id": 207}, {"k": "m", "x": 248, "y": 289, "id": 208}, {"k": "m", "x": 275, "y": 194, "id": 209}, {"k": "m", "x": 308, "y": 110, "id": 210}, {"k": "m", "x": 867, "y": 196, "id": 211}, {"k": "m", "x": 628, "y": 68, "id": 212}, {"k": "m", "x": 849, "y": 465, "id": 213}, {"k": "r", "x": 784, "y": 395, "id": 300}, {"k": "r", "x": 519, "y": 392, "id": 301}, {"k": "r", "x": 164, "y": 300, "id": 302}, {"k": "r", "x": 183, "y": 239, "id": 303}, {"k": "r", "x": 356, "y": 233, "id": 304}, {"k": "r", "x": 453, "y": 391, "id": 305}, {"k": "r", "x": 385, "y": 384, "id": 306}, {"k": "r", "x": 184, "y": 103, "id": 307}, {"k": "r", "x": 617, "y": 140, "id": 308}, {"k": "r", "x": 784, "y": 227, "id": 309}, {"k": "r", "x": 239, "y": 465, "id": 310}, {"k": "r", "x": 897, "y": 286, "id": 311}]}, "active": true}