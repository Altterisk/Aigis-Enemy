{"quest_id": 7046, "name": "見えざる迅雷", "description": "ブラッドストーンは華の国の邪仙の手にも\n渡っていた。霧化の力を得て一層捉える\nことが難しくなった迅天君を撃破せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "ジューンブライド・ミッドナイト", "event_category": "History", "mission_id": 920145, "map_no": 5559, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 19, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106672, "master_id": 842, "global_id": 841, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 25000, "attack": 550, "base_hp": 25000, "base_attack": 550, "damage_type": "magical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 1, "attack_wait": 25, "attack_interval": 78, "move_speed": 3500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2122656, "special_effect_id": 43, "change_to": 2, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 32516, "global_id": 6135, "variants": [{"hp": 25000, "attack": 550, "base_hp": 25000, "base_attack": 550, "damage_type": "magical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 1, "attack_wait": 25, "attack_interval": 78, "move_speed": 3500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114240, "special_effect_id": 43, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30950, "global_id": 4569}], "spawn_sec": 11}, {"enemy_id": 4, "source": "local", "count": 17, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108080, "master_id": 991, "global_id": 990, "spawn_sec": 55}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 4500, "attack": 250, "base_hp": 4500, "base_attack": 250, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_range": 80, "attack_speed": 1, "attack_wait": 10, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117952, "missile_id": 11, "master_id": 31615, "global_id": 5234, "ranged": true, "spawn_sec": 59}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 4500, "attack": 250, "base_hp": 4500, "base_attack": 250, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_range": 80, "attack_speed": 1, "attack_wait": 10, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122672, "change_to": 4, "change_condition": 1, "missile_id": 11, "master_id": 32517, "global_id": 6136, "ranged": true, "variants": [{"tags": ["アンデッド"], "hp": 4500, "attack": 250, "base_hp": 4500, "base_attack": 250, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_range": 80, "attack_speed": 1, "attack_wait": 10, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117952, "missile_id": 11, "master_id": 31615, "global_id": 5234, "ranged": true}], "spawn_sec": 69}], "dialogue": [{"trigger": "start", "lines": [{"name": "迅天君", "text": "――華の国の栄華よりさらに以前、\n華やかなりしヴァンパイアの王国、ねぇ。", "face": "l1714448b1aac"}, {"name": "迅天君", "text": "まぁオレには関係ない話さ。\n結果としてこの手にはブラッドストーンがある。\nあの女とは今後も良い関係を築いておくとしよう。", "face": "l1714448b1aac"}, {"name": "迅天君", "text": "さて、さっそくこの石の力を試したいところだが――", "face": "l1714448b1aac"}, {"name": "太公望", "text": "――ほうほう。\n今度はヴァンパイアの研究を始めたのですか？", "face": "u603"}, {"name": "迅天君", "text": "……ハハッ！　それも悪くないね。\nだがあいにくと、オレは血吸いの魔物になりたくはない。", "face": "l1714448b1aac"}, {"name": "迅天君", "text": "あくまで目的を果たすため、\n誰にも邪魔されず、存分に研究に励むため、\nあの女とは協力関係になっただけのことさ。", "face": "l1714448b1aac"}, {"name": "清源妙道真君", "text": "あの女……？\nもしやヴァンパイアの王国の滅びに関与したという、\n古き血脈のあの者と手を組んだのですか。", "face": "u866"}, {"name": "迅天君", "text": "御名答。\nおかげでオレの速度にはさらに磨きがかかった。", "face": "l1714448b1aac"}, {"name": "迅天君", "text": "さぁ王子よ、王国軍よ、\nオレの速度に何処までついてこられるか。\n霧の如きこの身をとらえられるか、勝負といこう。", "face": "l1714448b1aac"}, {"name": "太公望", "text": "速いだけの男だと思っていましたが、\n己の特技を活かす方法だけは知っていたようですね。", "face": "u603"}, {"name": "清源妙道真君", "text": "王子殿、迅天君が手にしたのは\nブラッドストーンに間違いないでしょう。\n霧化の能力にはご注意を。", "face": "u866"}, {"name": "迅天君", "text": "さぁ、準備は良いか。\nお前の速度はどうだ、お前の力は！\n付いてきてみせろ、このオレに！！", "face": "l1714448b1aac"}]}, {"trigger": "end", "lines": [{"name": "迅天君", "text": "……チッ、まだ速度が足りないか。", "face": "l1714448b1aac"}, {"name": "清源妙道真君", "text": "足りないのはあなたの頭と実力では？", "face": "u866"}, {"name": "迅天君", "text": "……いつも正論を言うな。\nだから嫌いなんだよ、お前のこと。", "face": "l1714448b1aac"}, {"name": "迅天君", "text": "まぁいい。オレの弱点を思い知らせてくれたんだ、\nこれを教訓に、今回は撤退させてもらおうかな。", "face": "l1714448b1aac"}, {"name": "迅天君", "text": "王子、勝ちは譲っておくよ。\n次はオレの方が速くなっている。覚悟しておけ。", "face": "l1714448b1aac"}, {"name": "太公望", "text": "……逃げ足だけは邪仙一かもしれませんね。\nあの特技を他のことに活かせば良いと思うのですが。", "face": "u603"}, {"name": "清源妙道真君", "text": "そんな器用な生き方が出来るなら、\n彼も邪仙に与したりはしなかったでしょう。", "face": "u866"}, {"name": "太公望", "text": "ふふふ、我々も器用でなかったがゆえに、\n仙術なんて極めちゃったりしたんですけどね？", "face": "u603"}, {"name": "清源妙道真君", "text": "……それはそれです。\nさぁ王子殿、私達も拠点へ戻りましょうか。", "face": "u866"}]}], "active": true}