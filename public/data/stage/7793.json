_id": 7284, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 7, "source": "local", "count": 27, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106688, "master_id": 849, "global_id": 848, "spawn_sec": 77}, {"enemy_id": 8, "source": "local", "count": 27, "form_count": 1, "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 70, "attack_range": 200, "attack_speed": 100, "attack_wait": 60, "attack_interval": 165, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113696, "special_effect_id": 258, "missile_id": 6, "master_id": 30855, "global_id": 4474, "ranged": true, "spawn_sec": 92}, {"enemy_id": 9, "source": "local", "count": 16, "form_count": 1, "hp": 13000, "attack": 500, "base_hp": 13000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 15, "attack_range": 220, "attack_speed": 1, "attack_wait": 45, "attack_interval": 131, "move_speed": 1150.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119760, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 31921, "global_id": 5540, "ranged": true, "spawn_sec": 96}], "popups": ["金光聖菩は分身がいる間、\n攻撃力、防御力がアップします。\nまた、分身の数に応じて効果が\n重複します。", "清源妙道真君(本体)のいる間は、\n味方ユニットの攻撃力と防御力、\n魔法耐性が『20%』低下します。", "フーロンは攻撃を行うたびに、\n攻撃力がアップしていきます。\n\n３回目の攻撃後、\n攻撃力が最大になります。\n※４回目以降の攻撃力が最大"], "dialogue": [{"trigger": "start", "lines": [{"name": "清源妙道真君", "text": "……どうして貴方がここにいるのです。", "face": "u866"}, {"name": "金光聖菩", "text": "それはこちらの台詞だな、妙道よ。\n相変わらずお前の辛気臭い顔には気が滅入る。\n昔のように神仙郷に引き籠ってはどうだ？", "face": "u630"}, {"name": "フーロン", "text": "（……気まずい）", "face": "u1158a1"}, {"name": "シロガネ", "text": "（近寄らんとこ）", "face": "u1657a1"}, {"name": "清源妙道真君", "text": "貴方こそ邪仙郷に戻って……ああ、すみません。\n確か十天君から追放され居場所がないのでしたか？\n王国軍では節度ある振る舞いをお願いしますよ。", "face": "u866"}, {"name": "金光聖菩", "text": "極めて悪い仙人がどの口で節度を謳うか。\n威圧的で上から目線なのは変わってないな。\nまったく、恐ろしくて涙が出てしまいそうだ。", "face": "u630"}, {"name": "清源妙道真君", "text": "ほう、貴方のような女にも、\n流す涙が残っていたのですね。", "face": "u866"}, {"name": "金光聖菩", "text": "冷血なお前よりは人心に理解があってな。", "face": "u630"}, {"name": "フーロン", "text": "（あの仙人、いつも喧嘩してるな……）", "face": "u1158a1"}, {"name": "シロガネ", "text": "（誰だよこの組み合わせ作ったの）", "face": "u1657a1"}, {"name": "清源妙道真君", "text": "──いいでしょう、表に出なさい。\nその腐った性根、叩き直してあげます。", "face": "u866"}, {"name": "金光聖菩", "text": "はっ、神仙郷の優等生に何ができる。\n公衆の面前で吠え面かいても知らぬぞ？", "face": "u630"}, {"name": "シロガネ", "text": "ほら、フーロンさん出番っすよ。", "face": "u1657a1"}, {"name": "フーロン", "text": "は？　嘘でしょ、ちょ、待っ──！？", "face": "u1158a1"}, {"name": "シロガネ", "text": "それでは摸擬戦演武、開始でーす。\nどうか不殺だけは守ってくださいね。", "face": "u1657a1"}]}, {"trigger": "end", "lines": [{"name": "金光聖菩", "text": "ふむ、我々の間に割って入るとは中々やるな。", "face": "u630"}, {"name": "フーロン", "text": "……私ですか？", "face": "u1158a1"}, {"name": "清源妙道真君", "text": "よほど良い師に恵まれたとお見受けします。\nどうです、神仙郷に来る気はありませんか？", "face": "u866"}, {"name": "清源妙道真君", "text": "貴方ならキョンシーでありながら、\n仙人の道を歩めるかもしれません。", "face": "u866"}, {"name": "金光聖菩", "text": "待て待て、あんな堅苦しい場所はやめておけ。\nそれよりも私と武の極みを目指そうではないか。", "face": "u630"}, {"name": "フーロン", "text": "いえ、申し出はありがたいのですが、\nどちらもお断りさせていただきます。", "face": "u1158a1"}, {"name": "フーロン", "text": "私の将来の夢はお嫁さんなので。", "face": "u1158a1"}, {"name": "清源妙道真君", "text": "…………お嫁さんなら仕方ありませんね。", "face": "u866"}, {"name": "金光聖菩", "text": "お嫁さんなら仕方ないな。", "face": "u630"}, {"name": "シロガネ", "text": "何やら分かり合えたようですね。\n誰のお嫁さんとは言っていない割に、\n特定個人の共通理解がありそうですが。", "face": "u1657a1"}, {"name": "シロガネ", "text": "まあ、男性ファンたちのために、\n深くは追及しないでおきましょう。", "face": "u1657a1"}, {"name": "シロガネ", "text": "さて、王国闘兵パレードもいよいよ大詰め。\n次の舞台は、終点の王城前庭園となります。", "face": "u1657a1"}]}], "active": true}