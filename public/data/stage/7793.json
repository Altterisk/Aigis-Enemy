{"quest_id": 7793, "name": "華の国の乙女たち", "description": "華の国では、金光聖菩と清源妙道真君の\n喧嘩に巻き込まれ気まずそうなフーロンを\n後目に模擬戦演武が始まる……。\n神級（★１獲得の目安：平均Lv50）", "event": "人気闘兵凱旋パレードII", "event_category": "History", "mission_id": 920189, "map_no": 4656, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["金光陣"], "hp": 25000, "attack": 400, "base_hp": 25000, "base_attack": 400, "damage_type": "magical", "armor_defense": 300, "magic_defense": 70, "attack_range": 200, "attack_speed": 100, "attack_wait": 60, "attack_interval": 165, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113696, "special_effect_id": 92, "missile_id": 6, "master_id": 30854, "global_id": 4473, "ranged": true, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 45000, "attack": 750, "base_hp": 45000, "base_attack": 750, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_range": 240, "attack_speed": 1, "attack_wait": 45, "attack_interval": 131, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119760, "special_effect_id": 416, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 31920, "global_id": 5539, "ranged": true, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 4, "tags": ["アンデッド"], "hp": 21000, "attack": 420, "base_hp": 21000, "base_attack": 420, "damage_type": "true", "armor_defense": 300, "magic_defense": 10, "attack_range": 350, "attack_speed": 1, "attack_wait": 120, "attack_interval": 276, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2128192, "special_effect_id": 772, "change_to": 3, "change_condition": 4, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 33664, "global_id": 7281, "ranged": true, "to_condition": 4, "to