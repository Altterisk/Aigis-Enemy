ttack_speed": 1, "attack_wait": 50, "attack_interval": 143, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2130048, "race_id": 4, "special_effect_id": 222, "missile_id": 581, "missile": {"speed": 4.0}, "master_id": 33915, "global_id": 7532, "ranged": true, "spawn_sec": 309}, {"enemy_id": 25, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 16000, "attack": 1300, "base_hp": 16000, "base_attack": 1300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 25, "attack_range": 200, "attack_speed": 1, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2128208, "change_to": 25, "change_condition": 1, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33632, "global_id": 7249, "ranged": true, "variants": [{"hp": 16000, "attack": 1300, "base_hp": 16000, "base_attack": 1300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 25, "attack_range": 200, "attack_speed": 1, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2128224, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33633, "global_id": 7250, "ranged": true}], "spawn_sec": 312}, {"enemy_id": 27, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 3000, "base_hp": 30000, "base_attack": 3000, "damage_type": "magical", "armor_defense": 240, "magic_defense": 25, "attack_range": 280, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107792, "race_id": 16, "special_effect_id": 642, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 32981, "global_id": 6598, "ranged": true, "spawn_sec": 312}, {"enemy_id": 28, "source": "local", "count": 1, "form_count": 1, "hp": 42000, "attack": 1100, "base_hp": 42000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 800, "magic_defense": 5, "attack_speed": 20, "attack_wait": 15, "attack_interval": 84, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2129856, "race_id": 4, "special_effect_id": 825, "master_id": 34450, "global_id": 8067, "spawn_sec": 341}, {"enemy_id": 29, "source": "local", "count": 1, "form_count": 1, "hp": 44000, "attack": 1100, "base_hp": 44000, "base_attack": 1100, "damage_type": "true", "armor_defense": 350, "magic_defense": 5, "attack_range": 180, "attack_speed": 60, "attack_wait": 45, "attack_interval": 124, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2129872, "race_id": 4, "special_effect_id": 826, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 37391, "global_id": 11008, "ranged": true, "spawn_sec": 341}], "popups": ["\n\n\n――魔神セーレ討伐、出陣前のこと", "謙信とジュウベエは、\n一定確率で\n物理攻撃を回避します。", "ウルザがいる間は、\n全ての敵ユニットの\n攻撃と防御がアップします。\n\nまたウルザから\n遠距離攻撃を複数回受けると、\n麻痺状態になります。", "イングリッドは一定範囲内の\nユニットの魔法耐性を\n半減させます。", "エステルがいる間は、\n全ての味方ユニットの\n魔法耐性が\n70％ダウンします。", "フジムラサキがいる間は、\n全ての敵ユニットの\n防御がアップします。\n\nまた物理攻撃による\nダメージを受けると\n攻撃したユニットへ反撃を行います。", "ユキザクラがいる間は、\n全ての敵ユニットの\n攻撃がアップします。"], "dialogue": [{"trigger": "battle", "at_sec": 42, "lines": [{"text": "――魔神セーレ討伐、出陣前のこと"}, {"name": "ウルザ", "text": "――模擬戦、ですか？", "face": "u2158a1"}, {"name": "アンナ", "text": "えぇ、一時の共闘関係とはいえ、\n交流と、連携の確認に模擬戦をしてみてはどうかと。", "face": "lbd47455882a3"}, {"name": "ウルザ", "text": "もしそちらから提案されなければ、\nこちらから合同訓練でもと申し出ていたところでした。", "face": "u2158a1"}, {"name": "ウルザ", "text": "技術レベルが比較的近く、\nそれでいて、まったく異なる戦術も用いる王国。\nその用兵をぜひとも勉強させていただきたいです。", "face": "u2158a1"}, {"name": "ウルザ", "text": "それに――", "face": "u2158a1"}, {"name": "ジュウベエ", "text": "……上杉謙信殿、であったか？\nその立ち姿、相当な使い手とお見受けする。", "face": "u699"}, {"name": "上杉謙信", "text": "そう言うあなたも。\n異世界だというのに、どこか似た気配を感じる。", "face": "u2156a1"}, {"name": "ジュウベエ", "text": "一手ご指南賜りたい。\nＪＡＰＡＮと東の国の腕比べといこう。", "face": "u699"}, {"name": "シィル", "text": "わっ、わっ……。\nこういう時に止めてくれるのは……愛さーん！\n愛さん謙信さんを止めてくださいー！", "face": "u581"}, {"name": "ウルザ", "text": "シィルさん、愛さんはこちらに来ていないので……。\nそれに、模擬戦ですからおそらく大丈夫ですよ。", "face": "u2158a1"}, {"name": "ユキザクラ", "text": "あ、いや、けしかけてる側でアレなんですけどぉ……。", "face": "u1291a1"}, {"name": "ユキザクラ", "text": "謙信さんって、たぶんかなりの猪武者ですよね？\nどこまでもズバズバ斬り込んで行くタイプの……。", "face": "u1291a1"}, {"name": "ジュウベエ", "text": "異世界の剣豪、\n果たしてその実力いかほどか。じゅるり。", "face": "u699"}, {"name": "ユキザクラ", "text": "この人も、大概そっちの人なので。", "face": "u1291a1"}, {"name": "アンナ", "text": "……あの、お互いに怪我のないようにしましょうね？", "face": "lbd47455882a3"}, {"name": "ウルザ", "text": "え、えぇ、再起不能な怪我は避けるように！\nみなさん、よろしくお願いします！", "face": "u2158a1"}, {"name": "上杉謙信", "text": "上杉謙信……推して参る。", "face": "u2156a1"}]}, {"trigger": "end", "lines": [{"name": "上杉謙信", "text": "まだまだ……ッ！！", "face": "u2156a1"}, {"name": "ジュウベエ", "text": "なんのっ！　いいっ、実にいい剣だ！\nＪＡＰＡＮの侍、実にいい腕を持っている！", "face": "u699"}, {"name": "上杉謙信", "text": "毘沙門天の加護ぞ――", "face": "u2156a1"}, {"name": "ユキザクラ", "text": "すとーっぷ！！\nやめっ！　そこまで！　おすわりっ！！", "face": "u1291a1"}, {"name": "上杉謙信", "text": "はっ。", "face": "u2156a1"}, {"name": "ジュウベエ", "text": "おっと。", "face": "u699"}, {"name": "ジュウベエ", "text": "いやぁ……いい模擬戦であった。\n謙信殿、いい刺激になりました。", "face": "u699"}, {"name": "上杉謙信", "text": "ジュウベエ殿も。\n王子殿に仕えておられるのでなければ、\n上杉が家臣に勧誘していたところです。", "face": "u2156a1"}, {"name": "シィル", "text": "ふぅ……どうにかみなさん、\n軽い怪我で済んだみたいですね。\nいたいのいたいのとんでけー。", "face": "u581"}, {"name": "ウルザ", "text": "それに、戦術の研究も捗りました。\n王国軍独自の兵科の運用、勉強になります。", "face": "u2158a1"}, {"name": "上杉謙信", "text": "では、さっそく模擬戦第二陣を――", "face": "u2156a1"}, {"name": "上杉謙信", "text": "（くー）", "face": "u2156a1"}, {"name": "ユキザクラ", "text": "ん……今の音は？", "face": "u1291a1"}, {"name": "ウルザ", "text": "謙信さんの腹の虫ですね。", "face": "u2158a1"}, {"name": "上杉謙信", "text": "うっ……あっ……。", "face": "u2156a1"}, {"name": "オーガスタ", "text": "（あの食いしん坊なお腹の鳴り方、\n用意した料理だけでは足りない気がしますね……）", "face": "u960"}, {"name": "オーガスタ", "text": "皆さん、追加の料理を！\nお客様を空腹で帰さないようにがんばりますよ！", "face": "u960"}, {"name": "上杉謙信", "text": "すんすん……いい匂いが……。", "face": "u2156a1"}, {"name": "アンナ", "text": "ふふっ、せっかくですし、昼食にしましょうか。\n皆さん、王国料理を味わっていってくださいね。"}]}], "active": true}