{"quest_id": 8258, "name": "軍神の威光　軍師の戦術", "description": "魔神セーレとの戦いに備え、ウルザや\n謙信との模擬戦を行うことになった一行。\n共闘する異世界の精鋭たちに力を示せ！\n神級（★１獲得の目安：平均Lv50）", "event": "ランス1000　再び交わる世界", "event_category": "Reproduce", "mission_id": 320424, "map_no": 4895, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["サムライ"], "hp": 102000, "attack": 2600, "base_hp": 102000, "base_attack": 2600, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 90, "attack_wait": 15, "attack_interval": 150, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2152368, "race_id": 16, "special_effect_id": 827, "master_id": 37390, "global_id": 11007, "spawn_sec": 41}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 110000, "attack": 2400, "base_hp": 110000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 800, "attack_range": 60, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2152384, "race_id": 16, "special_effect_id": 1711, "change_to": 2, "change_condition": 1, "missile_id": 45, "master_id": 37380, "global_id": 10997, "ranged": true, "variants": [{"hp": 110000, "attack": 3200, "base_hp": 110000, "base_attack": 3200, "damage_type": "physical", "armor_defense": 800, "attack_speed": 1, "attack_wait": 75, "attack_interval": 212, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2152400, "race_id": 16, "special_effect_id": 1710, "master_id": 37381, "global_id": 10998}], "spawn_sec": 41}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 750, "base_hp": 12000, "base_attack": 750, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 151