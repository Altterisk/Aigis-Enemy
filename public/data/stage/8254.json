000, "magic_defense": 20, "attack_speed": 70, "attack_wait": 40, "attack_interval": 199, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152528, "race_id": 16, "special_effect_id": 1160, "change_to": 10, "master_id": 37397, "global_id": 11014, "route_behaviour": {"transforms": [{"flag": 92, "val": 1}], "sets_flags": [[92, 1, 90]]}, "spawn_sec": 60}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 70, "attack_wait": 40, "attack_interval": 195, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152560, "special_effect_id": 1160, "change_to": 12, "master_id": 37399, "global_id": 11016, "route_behaviour": {"transforms": [{"flag": 93, "val": 1}], "sets_flags": [[93, 1, 90]]}, "spawn_sec": 61}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 70, "attack_wait": 40, "attack_interval": 187, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152512, "race_id": 16, "special_effect_id": 1160, "change_to": 14, "master_id": 37396, "global_id": 11013, "route_behaviour": {"transforms": [{"flag": 94, "val": 1}], "sets_flags": [[94, 1, 90]]}, "spawn_sec": 61}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 70, "attack_wait": 40, "attack_interval": 223, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143072, "race_id": 16, "special_effect_id": 1160, "change_to": 16, "master_id": 37394, "global_id": 11011, "route_behaviour": {"transforms": [{"flag": 95, "val": 1}], "sets_flags": [[95, 1, 90]]}, "spawn_sec": 62}, {"enemy_id": 18, "source": "local", "count": 6, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 145}, {"enemy_id": 19, "source": "local", "count": 26, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 157}, {"enemy_id": 20, "source": "local", "count": 18, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 190}, {"enemy_id": 21, "source": "local", "count": 12, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 276}, {"enemy_id": 22, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 20, "attack_interval": 84, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143184, "race_id": 3, "special_effect_id": 1160, "change_to": 22, "master_id": 37401, "global_id": 11018, "spawn_sec": 307}], "popups": ["\n\n\n――次元の狭間、どこでもない場所", "魔神セーレは特定のタイミングで\n特殊攻撃を行います。\n\n特殊攻撃が発動すると\n特定の近接マスに配置していた\nユニットは撤退します。\n撤退後は再出撃が可能です。", "ハニーは倒されても\n★の評価には影響しません。"], "dialogue": [{"trigger": "battle", "at_sec": 42, "lines": [{"text": "――次元の狭間、どこでもない場所"}, {"name": "魔神セーレ", "text": "クックック……。", "face": "l70921f716695"}, {"name": "魔神セーレ", "text": "異世界の戦士ランス、そして王国の王子……。\n貴様らに復讐を果たす時が来た。", "face": "l70921f716695"}, {"name": "魔神セーレ", "text": "この魔神セーレを次元の狭間に幽閉するとは、\nその罪、万死に値する。\nまずはランス、貴様から血祭りにあげてくれる！", "face": "l70921f716695"}, {"name": "魔神セーレ", "text": "――開け、異界の扉。\nそしていでよ、異世界の英雄ランスよ！！", "face": "l70921f716695"}]}, {"trigger": "battle", "at_sec": 44, "lines": [{"name": "ランス", "text": "どわぁぁぁぁぁっ！？\nなっ、なんだ？　どこだここはー！？", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "クックック、久しいなランスよ。", "face": "l70921f716695"}, {"name": "ランス", "text": "誰だっけ？", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "ほう、一度倒した者の顔など覚えていないか？\n我が名は魔神セーレ。\n貴様を殺す者にして――", "face": "l70921f716695"}, {"name": "ランス", "text": "あー、分かった分かった。\nおいカオス、とっととこの「魔人」をぶった斬るぞ。", "face": "l56c324708564"}, {"name": "魔剣カオス", "text": "いや心の友よ、こいつは「魔人」じゃないぞ。\n儂が言うんだから間違いない。", "face": "le2e11fea1f65"}, {"name": "ランス", "text": "何を言っとるか！\nさっき自分でマジンセーレって名乗ってたろーが！", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "クククッ、覚悟は決まったか？", "face": "l70921f716695"}, {"name": "魔神セーレ", "text": "如何に貴様が優れた戦士であろうと、\n我が手勢の物量にはかなうまい！\nこれで終わりだ！　ランスゥゥゥゥッ！！", "face": "l70921f716695"}]}, {"trigger": "battle", "at_sec": 47, "lines": [{"name": "グリム", "text": "――はい、よいしょっとー。\nふっふっふ、次元の狭間直通ゲート、展開成功ですー。", "face": "u942"}, {"name": "魔神セーレ", "text": "…………は？\nおい、今大事なところなのだ。\n小娘、邪魔しないでもらおうか。", "face": "l70921f716695"}, {"name": "グリム", "text": "わっ、もしかして修羅場です？\n帰った方がいいですかー？", "face": "u942"}, {"name": "魔神セーレ", "text": "くっ……調子が狂う……。\nそうそう、今この男を殺すところなのだ。\n迷子の相手はその後でーー", "face": "l70921f716695"}, {"name": "グリム", "text": "あぁっ！　ランスさんじゃないですか！\nお久しぶりですー。", "face": "u942"}, {"name": "ランス", "text": "おっ、グリムちゃん。\nちょうどよかった、俺様を元の世界に戻してくれ。\nぐふふ、これからイイコトをするところだったのだ。", "face": "l56c324708564"}, {"name": "グリム", "text": "あー、それは難しいですねー。\nさすがに魔神セーレの召喚術を解読するには\nちょっと時間がかかるかとー？", "face": "u942"}, {"name": "グリム", "text": "でも逆なら行けますよ。\nピンチなら、お仲間を召喚すればいいわけでー。", "face": "u942"}, {"name": "グリム", "text": "えいっ、異界召喚！", "face": "u942"}]}, {"trigger": "battle", "at_sec": 49, "lines": [{"name": "ハニーＡ", "text": "はにほー。", "face": "l0a288895e9cd"}, {"name": "グリム", "text": "あれ？　しょうかーん！", "face": "u942"}]}, {"trigger": "battle", "at_sec": 50, "lines": [{"name": "ハニーＢ", "text": "あいやー。", "face": "l0a288895e9cd"}, {"name": "グリム", "text": "召喚召喚！　なんかすごい子、来い！", "face": "u942"}]}, {"trigger": "battle", "at_sec": 51, "lines": [{"name": "ハニーＣ", "text": "めがねっ子はどこだー。", "face": "l0a288895e9cd"}]}, {"trigger": "battle", "at_sec": 54, "lines": [{"name": "ランス", "text": "ハニーしか出て来ないぞ！\nえぇい、女の子はどこだ！　ハニワめっ、げしげしっ。", "face": "l56c324708564"}, {"name": "ハニーＡ", "text": "きゃーやめてー。", "face": "l0a288895e9cd"}]}, {"trigger": "battle", "at_sec": 57, "lines": [{"name": "グリム", "text": "まぁまぁ、次はきっとうまくいきますよー。\nほら、いい感じの手応えが……。\nごそっと一気にいきますよー！　えいっ！", "face": "u942"}]}, {"trigger": "battle", "at_sec": 63, "lines": [{"name": "リズナ", "text": "あら……？", "face": "u2155a1"}, {"name": "ウルザ", "text": "おや、ここは……？", "face": "u2158a1"}, {"name": "フェリス", "text": "……きゃっ？　うわ、なにここ？", "face": "u2159a1"}, {"name": "上杉謙信", "text": "おっと。", "face": "u2156a1"}, {"name": "シィル", "text": "ランス様ー！　どこですかー！？\nあ、あれ？　また知らない場所にぃ……！？", "face": "u581"}, {"name": "グリム", "text": "ふんすふんす。\nランスさんの縁を使って喚んでみました。", "face": "u942"}, {"name": "魔神セーレ", "text": "こ、この小娘……何だこのデタラメな召喚術は。\nまさか私をこの次元に封じた、あの時の術者か！？\nぽんぽんと世界の壁を簡単に越えよってぇぇぇッ！！", "face": "l70921f716695"}, {"name": "ランス", "text": "さっきからうるさいぞ、「魔人」なんとか。\nとりあえず死ぬがよい。", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "強がっていられるのも今のうちだ。\nこの次元に幽閉され、長き時間をかけて編み上げた秘術、\nとくと味わわせてやろう！", "face": "l70921f716695"}, {"name": "シィル", "text": "ランス様！　あれ、前に戦った魔神セーレです！\n確か、えっと、えっとー……。", "face": "u581"}, {"name": "グリム", "text": "セーレは転移を得意とする魔神ですねー。\n強制的に遠くにぽいって転移させられます。", "face": "u942"}, {"name": "ランス", "text": "思い出した！　かなみが走り回らされてたやつだな。", "face": "l56c324708564"}, {"name": "グリム", "text": "おそらく転移には一定のルールがありますけど、\nその分析はお任せします。", "face": "u942"}, {"name": "グリム", "text": "あっ、転移でぶっ飛ばされても、\nまたここまで戻ってくれば戦えますので。\n代わりに『コスト』が必要になりますけどねー。", "face": "u942"}, {"name": "グリム", "text": "それじゃ、張り切って魔神討伐しちゃいましょー。", "face": "u942"}]}, {"trigger": "battle", "at_sec": 310, "lines": [{"name": "ランス", "text": "くぅっ、ちょこまかと！\n「魔人」セーレ！　そこでじっとしてろ！", "face": "l56c324708564"}, {"name": "魔剣カオス", "text": "じゃからー、あいつ「魔人」じゃなくて「魔神」だって。\n無敵結界ももっとらんしー。\nおっ、なんかすごい魔力を練り上げとるぞ。", "face": "le2e11fea1f65"}, {"name": "魔神セーレ", "text": "さすがは意思ある魔剣、我が魔力を読み解くか。\nこれこそ、我が転移魔術の秘奥義……。", "face": "l70921f716695"}, {"name": "魔神セーレ", "text": "肉体から魂を引き剥がし、\n別世界へ転移させる大魔術である！", "face": "l70921f716695"}, {"name": "ウルザ", "text": "はっ……？\nそれってつまり、即死魔法ということでは？", "face": "u2158a1"}, {"name": "グリム", "text": "ですねー。\n魂だけぶっ飛ばされたら、肉体は死んじゃいますねぇ。", "face": "u942"}, {"name": "シィル", "text": "ば、バリアーで……！", "face": "u581"}, {"name": "グリム", "text": "……対象がこの次元全域です。\n打消しや防御じゃ間に合いません！\n急いで転移魔術を構築します、皆さん私の近くにー！", "face": "u942"}, {"name": "フェリス", "text": "い、いきなり喚ばれて何がなんだか……！\nランス、今度は何に首を突っ込んだの！？", "face": "u2159a1"}, {"name": "ランス", "text": "俺様が知るかー！！", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "さぁ、今度こそ息絶えよ！\n異世界の戦士、ランスよぉぉぉぉぉッ！！", "face": "l70921f716695"}, {"name": "グリム", "text": "ひ、開けー！！　異界の門ーッ！！", "face": "u942"}]}, {"trigger": "end", "lines": [{"name": "魔神セーレ", "text": "……逃したか。だが、まぁ良い。\n今回こそやつを殺し、肉体を奪って――", "face": "l70921f716695"}, {"name": "リズナ", "text": "…………あの～？", "face": "u2155a1"}, {"name": "魔神セーレ", "text": "……なぜ貴様だけここにいる？\n先ほどの転移魔術から漏れていたのか？", "face": "l70921f716695"}, {"name": "魔神セーレ", "text": "いや、だとしたら何故死んでいない。\n我が魔法が直撃したはずだろう！？", "face": "l70921f716695"}, {"name": "リズナ", "text": "えぇっと、体質でしょうか……？", "face": "u2155a1"}, {"name": "ハニーＣ", "text": "リズナちゃんは魔法が効かないんだよー。", "face": "l0a288895e9cd"}, {"name": "魔神セーレ", "text": "…………なんと厄介な。", "face": "l70921f716695"}]}], "active": true}