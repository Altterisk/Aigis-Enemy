{"quest_id": 8254, "name": "魔神セーレ　再び", "description": "封印された復讐を果たすべく魔神セーレは\n再びランスを召喚。絶体絶命の危機に\n何処からか見覚えのある少女が現れて……？\n%c[ff4000]このミッションは固定メンバーで出撃します。%c[ffffff]", "event": "ランス1000　再び交わる世界", "event_category": "Reproduce", "mission_id": 320424, "map_no": 4891, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 150, "gold": 700, "drops": [{"card": 65, "c": 2}, {"item": 5002, "c": 1}, {"item": 1005, "c": 1}, {"card": 588}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 130000, "attack": 750, "base_hp": 130000, "base_attack": 750, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 20, "attack_interval": 84, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143184, "race_id": 3, "change_to": 1, "master_id": 35968, "global_id": 9585, "to_condition": 0, "to_global_id": 9586, "route_behaviour": {"transforms": [{"wait": 80}], "creates_obj": 4}, "spawn_sec": 41}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルスII", "ブロック不可"], "hp": 130000, "base_hp": 130000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 60, "attack_interval": 202, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143200, "race_id": 3, "special_effect_id": 1160, "master_id": 35969, "global_id": 9586, "from_condition": 0}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 200000, "base_hp": 200000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 40, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143152, "race_id": 16, "special_effect_id": 1160, "change_to": 3, "master_id": 37393, "global_id": 11010, "variants": [{"tags": ["置物", "ステルスII", "ブロック不可