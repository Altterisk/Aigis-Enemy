80, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109104, "race_id": 16, "special_effect_id": 61, "change_to": 2, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 473, "global_id": 472, "ranged": true, "from_condition": 0}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 7000, "attack": 350, "base_hp": 7000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108544, "race_id": 16, "special_effect_id": 54, "master_id": 30129, "global_id": 3748, "spawn_sec": 152}], "dialogue": [{"trigger": "start", "lines": [{"name": "ユリアン", "text": "おいおい、なんだよこの大量の樽は？！\nクソッ、これじゃ仲間と連携がとりづらいじゃねぇか！", "face": "u7"}, {"name": "セシリー", "text": "部隊の分断……どうやらこれが\n敵の狙いだったようだな。", "face": "u21"}, {"name": "セブン", "text": "なーにが、敵の狙いだったようだな、だ！\nいまさら気づいたって遅すぎんだよーッ！\nこのまま一気に勝負をつけてやんぜ！", "face": "u449"}, {"name": "アンナ", "text": "――セブンさん！　もうやめてください！\nあなたは、本当にこんなことを望んでいるのですか？\n組織を抜けたいというのは、嘘だったのですか？", "face": "lee523e149977"}, {"name": "セブン", "text": "う、うるせぇぞアンナ！\nアンタらには関係ねぇコトだろうがー！　\nいいから大人しく、アタシに捕まりやがれってんだよ！", "face": "u449"}, {"name": "セブン", "text": "（そうさ……王子たちを捕まえれば、\n莫大な金が手に入る……そうすれば、\nアタシは組織を抜けられるんだ……！）", "face": "u449"}, {"name": "セシリー", "text": "……だめだ。\nどうやら、こちらの話を聞く気はなさそうだな。", "face": "u21"}, {"name": "アンナ", "text": "……ここは戦って切り抜けるしかないようですね。\n部隊が分断された不利な状況ではありますが、\n王子、冷静な判断をお願い致します。", "face": "lee523e149977"}]}, {"trigger": "end", "lines": [{"name": "ナイン", "text": "ちッ……コイツら思った以上にやりやがる。\nおいセブン！　そっちはどうだ？　やったか！？", "face": "ld7496088d5b4"}, {"name": "セブン", "text": "うるせーな！　やってたらとっくに報告してらぁっ！\n……くっそー、こっちが追い詰めたと思ったのに\n王子のやつら、何てしぶとさだ……イライラするぜ！", "face": "u449"}, {"name": "ケイティ", "text": "樽によって、敵側の戦力も分断されたのは幸いでした。\n王子が狙いなのであれば、\n王子のみに戦力を集中すべきでしたね。", "face": "u114"}, {"name": "セブン", "text": "勝手にこっちのミスを分析してんじゃねーぞ！\nくっそぉ……こうなったら逃げるぞ、ナイン！\n王子、憶えてやがれーーーっ！", "face": "u449"}, {"name": "ナイン", "text": "お、おい！　待てってば、セブン！\n頼むから置いていかないでくれってば！", "face": "ld7496088d5b4"}, {"name": "アンナ", "text": "…………なんとか窮地を脱することができましたね。\nですが、王子。セブンさんは、\n何やら事情がありそうな様子でしたが……。", "face": "lee523e149977"}, {"name": "セシリー", "text": "少し自分の方で探ってみよう。王子に懸賞金を\n仕掛けた奴も、見つけないといけないしな。", "face": "u21"}, {"name": "アンナ", "text": "お願いします、セシリーさん。\n王子、セシリーさんの調査が終わるまで、\nしばらくはここで隊を整えることにしましょう。", "face": "lee523e149977"}]}], "map": {"image": "Map920084_3234", "w": 960, "h": 640, "spots": [{"k": "b", "x": 931, "y": 228}, {"k": "b", "x": 927, "y": 424}, {"k": "b", "x": 25, "y": 408}, {"k": "b", "x": 28, "y": 171}, {"k": "m", "x": 744, "y": 372, "id": 200}, {"k": "m", "x": 649, "y": 349, "id": 201}, {"k": "m", "x": 544, "y": 166, "id": 202}, {"k": "m", "x": 310, "y": 400, "id": 203}, {"k": "m", "x": 176, "y": 410, "id": 204}, {"k": "m", "x": 823, "y": 198, "id": 205}, {"k": "m", "x": 714, "y": 177, "id": 206}, {"k": "m", "x": 320, "y": 167, "id": 207}, {"k": "m", "x": 534, "y": 407, "id": 208}, {"k": "m", "x": 311, "y": 313, "id": 209}, {"k": "m", "x": 216, "y": 168, "id": 210}, {"k": "m", "x": 114, "y": 169, "id": 211}, {"k": "m", "x": 683, "y": 258, "id": 212}, {"k": "m", "x": 846, "y": 407, "id": 213}, {"k": "m", "x": 316, "y": 244, "id": 214}, {"k": "m", "x": 565, "y": 250, "id": 215}, {"k": "m", "x": 562, "y": 328, "id": 216}, {"k": "m", "x": 629, "y": 172, "id": 217}, {"k": "r", "x": 637, "y": 421, "id": 300}, {"k": "r", "x": 631, "y": 229, "id": 301}, {"k": "r", "x": 757, "y": 234, "id": 302}, {"k": "r", "x": 724, "y": 309, "id": 303}, {"k": "r", "x": 255, "y": 222, "id": 304}, {"k": "r", "x": 110, "y": 450, "id": 305},