lobal_id": 306, "spawn_sec": 148}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 450, "base_hp": 5000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 137, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109792, "race_id": 16, "special_effect_id": 54, "master_id": 30215, "global_id": 3834, "spawn_sec": 153}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 400, "base_hp": 7000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 137, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101744, "race_id": 16, "special_effect_id": 54, "master_id": 30216, "global_id": 3835, "spawn_sec": 154}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 400, "base_hp": 7000, "base_attack": 400, "damage_type": "physical", "armor_defense": 180, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "attack_interval": 48, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2119792, "race_id": 16, "special_effect_id": 54, "master_id": 31934, "global_id": 5553, "spawn_sec": 169}], "popups": ["アナトリアは拠点に向かわず\n★の評価に影響しません。\n\n特定のタイミングまでに\n攻撃を受けると動きが変わり\n拠点へ向かいます。\n拠点へ向かうアナトリアは\n★の評価に影響します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アナトリア", "text": "――これより夏祭り前日祭、\n王国腕自慢大会を……開催するッ！！", "face": "u522"}, {"name": "イリオス", "text": "コホン、実況はアナトリア様のご指名で！\n遠路はるばるやってきたアナトリア様応援団長、\nこのイリオスが担当しまひゅっ！！", "face": "u872"}, {"name": "モモ", "text": "（噛んだ……）", "face": "u249"}, {"name": "リン", "text": "（舌痛そう……憧れの人からのご指名で、\n緊張しちゃったってところかしら……）", "face": "u122"}, {"name": "イリオス", "text": "大丈夫れひゅ……いててて……。\nともかく、激化する戦いの清涼剤として、\n戦士の皆さんの交流会として、今大会は開かれました！", "face": "u872"}, {"name": "アナトリア", "text": "ここに集うは腕に覚えのある猛者ばかり。\n今日は思う存分、\n全力でぶつかり合って魂を震わせな！", "face": "u522"}, {"name": "モーティマ", "text": "ん？　アナトリア、お前は出ないのか？", "face": "u14"}, {"name": "アナトリア", "text": "ああ、あたしはあくまで立会人さ。\n祭りの余興とはいえ、審判は必要だろう？", "face": "u522"}, {"name": "シプリア", "text": "へぇ……でも実は戦いたくて\n身体がうずうずしてるんじゃないのか？", "face": "u51"}, {"name": "アナトリア", "text": "……まぁ、それはそれだ。\n戦場のど真ん中で審判が出来るやつは、\nそんなに多くはないだろう？", "face": "u522"}, {"name": "イリオス", "text": "そういうわけですから、\nアナトリア様には攻撃しちゃだめですからね！\n審判を殴るのは反則行為です！", "face": "u872"}, {"name": "フューネス", "text": "正々堂々……心躍る……。\n心を通わすための戦い……良い……。", "face": "u15"}, {"name": "ダン", "text": "おぉ？　フューネスもやる気かぁ？\n俺も一切手を抜くつもりはないぜえ！\n正々堂々、真正面からだッ！！", "face": "u204"}, {"name": "アナトリア", "text": "よし、気合十分みたいだな。\nそれじゃあ王国腕自慢大会――開始だッ！！", "face": "u522"}]}, {"trigger": "end", "lines": [{"name": "アナトリア", "text": "いやぁ、皆本当にいい戦いぶりだったよ！\nこれなら夏祭りも、\nきっと大盛り上がり間違いなしだ！", "face": "u522"}, {"name": "マオ", "text": "はぁ……はぁ……。\nお祭りの準備をしてたら遅れちゃいました……。", "face": "u867"}, {"name": "マオ", "text": "王子！　私の戦いっぷり、見ていただけましたか！？", "face": "u867"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "マオ", "text": "やったぁ！\nお祭り会場から走ってきたかいがありましたぁ！", "face": "u867"}, {"name": "イリオス", "text": "お祭り……お祭りかぁ……。\nいいなぁ……楽しそうですよねぇ……。", "face": "u872"}, {"name": "アナトリア", "text": "ん？　何だいイリオス。\nお前も遠慮せずに遊びにいけばいいのさ。", "face": "u522"}, {"name": "イリオス", "text": "えぇっ！？　良いんですか！？", "face": "u872"}, {"name": "マオ", "text": "もちろんですよ！\nこのお祭りは、誰だって参加できるんですから！", "face": "u867"}, {"name": "イリオス", "text": "わぁい！\nそれじゃあ設営もお手伝いしますねー！！", "face": "u872"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アナトリア", "text": "何だい王子、嬉しそうな顔しちゃって。\n違う種族の者が仲良くしてるのが、そんなに嬉しいかい？", "face": "u522"}, {"name": "アナトリア", "text": "きっとそういう世界がくるさ。\nマオが準備している祭りも、その下準備のひとつ。\nさぁ、あたし達も手伝いにいくよ！", "face": "u522"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "アナトリア", "text": "――うんうん、皆いい戦いぶりだったよ！\nでもあたしまで熱くなっちまった……。\nこの滾りは祭りで遊んで発散するとしようかね！", "face": "u522"}, {"name": "イリオス", "text": "アナトリア様、審判お疲れさまでしたー！", "face": "u872"}]}, {"trigger": "route", "lines": [{"name": "アナトリア", "text": "――ん？　審判に手を出したのかい？", "face": "u522"}, {"name": "イリオス", "text": "あぁー！　アナトリア様！\n冷静な口調だけど\nすごく楽しそうな気配が伝わってきます！", "face": "u872"}, {"name": "アナトリア", "text": "ルール違反はいけないねぇ。\n反則行為には、罰則がつきものだよ！！", "face": "u522"}, {"name": "イリオス", "text": "アナトリア様、走ったぁー！！", "face": "u872"}]}], "active": true}