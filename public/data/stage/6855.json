{"quest_id": 6855, "name": "王国腕自慢大会", "description": "前日祭として開かれた腕自慢大会。アナト\nリア審判の下、腕自慢の猛者と競い合え！　\n……なお審判には決して手をださぬよう。\n上級（★１獲得の目安：平均Lv10）", "event": "あやかし狸と浴衣の拳士", "event_category": "History", "mission_id": 920132, "map_no": 5510, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 1, "attack": 1750, "base_hp": 1, "base_attack": 1750, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119936, "race_id": 8, "special_effect_id": 242, "change_to": 1, "change_condition": 2, "master_id": 31954, "global_id": 5573, "to_global_id": 5556, "route_behaviour": {"transforms": [{"wait": 9500}], "calls_event": [2164, 2165], "reroutes": ["Route=57"]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 3500, "base_hp": 20000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108992, "race_id": 8, "master_id": 31937, "global_id": 5556}, {"enemy_id": 4, "source": "local", "count": 15, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 27}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 650, "base_hp": 8000, "base_attack": 650, "damage_type": "physical", "armor_defense":