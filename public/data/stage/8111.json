lobal_id": 10374, "ranged": true, "to_global_id": 10375}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["機械"], "hp": 120000, "attack": 3000, "base_hp": 120000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1500, "attack_wait": 200, "attack_interval": 476, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2148976, "special_effect_id": 313, "change_to": 16, "missile_id": 300, "missile": {"speed": 6.0, "splash": 133}, "master_id": 36758, "global_id": 10375}, {"enemy_id": 19, "source": "local", "count": 10, "form_count": 2, "tags": ["機械"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 120, "attack_wait": 60, "attack_interval": 224, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120704, "race_id": 2, "special_effect_id": 449, "change_to": 19, "missile_id": 414, "missile": {"speed": 10.0, "splash": 80}, "master_id": 32091, "global_id": 5710, "ranged": true, "to_global_id": 5713, "commands": {"raw": "SetStageFlag(27, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 27, 1 );\");", "sets_flags": [[27, 0], [27, 1]], "on_destroy": true}, "spawn_sec": 171}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_wait": 60, "attack_interval": 224, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120768, "race_id": 2, "special_effect_id": 449, "change_to": 18, "missile_id": 414, "missile": {"speed": 10.0, "splash": 80}, "master_id": 32094, "global_id": 5713}, {"enemy_id": 21, "source": "local", "count": 6, "form_count": 1, "tags": ["水棲", "機械"], "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 60, "attack_wait": 20, "attack_interval": 147, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2144320, "special_effect_id": 1375, "master_id": 36168, "global_id": 9785, "commands": {"raw": "SetStageFlag(33, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 33, 1 );\");", "sets_flags": [[33, 0], [33, 1]], "on_destroy": true}, "spawn_sec": 197}], "popups": ["ブラックメカトナカイのおもちゃは\n攻撃力800以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シャチのギルマン", "text": "ここがおもちゃ製造工場であります。\nこの製造ラインを止めれば、\nおもちゃの出荷ができなくなるはず！", "face": "l9987c2f5a8b6"}, {"name": "ブランシュ", "text": "ありがと、感謝するわ。\nよーし、早速製造ラインを止めて――\n（ガチャガチャ……）", "face": "u2005a1"}, {"name": "ブランシュ", "text": "できたわ！　これで一安心ね。", "face": "u2005a1"}, {"name": "インテリデーモン", "text": "ククク……遅い！　遅いですねぇ！\n今更私の足止めをしようと言うのですか！", "face": "l815517a11268"}, {"name": "インテリデーモン", "text": "既に私は最終兵器を作り出した後！\n最終決戦の幕は切って落とされたも同然！", "face": "l815517a11268"}, {"name": "ホルテウス", "text": "さ、最終兵器！？\nあのメカトナカイのおもちゃの上があると！？", "face": "u1837a1"}, {"name": "インテリデーモン", "text": "姿を現すのです。\n私の最強兵器、ブラックメカトナカイ！", "face": "l815517a11268"}, {"name": "アエロ", "text": "な、なんですか！　あの巨大なおもちゃトナカイは！\n街で見た時と、色も大きさも違いますちゅん！", "face": "u2004a1"}, {"name": "インテリデーモン", "text": "戦闘用に改造したメカトナカイのおもちゃです！\n新規搭載した破壊光線の前にひれ伏すがいい！", "face": "l815517a11268"}, {"name": "シャチのギルマン", "text": "わ、我が社のおもちゃを\nここまで愚弄するか――ッ！！", "face": "l9987c2f5a8b6"}, {"name": "インテリデーモン", "text": "では王国軍、オルカ科学ラボの皆さんサヨウナラ。\n私はこのブラックメカトナカイを使い、\n商業的に平和なクリスマスを取り戻すのです！", "face": "l815517a11268"}, {"name": "インテリデーモン", "text": "デモシェフ商会に栄光を！\n社員一人一人に冬のボーナスを！", "face": "l815517a11268"}, {"name": "クルス", "text": "完全に思考が暴走しているわ！\nこれはもう力づくで止めるしかないわね！", "face": "u2006a1"}]}, {"trigger": "battle", "at_sec": 109, "lines": [{"name": "アエロ", "text": "ちゅん！？　製造ラインが再稼働してます！\n流れてきたのは……プレゼント！？", "face": "u2004a1"}, {"name": "クルス", "text": "あれ、行商人さんのところや街で見たやつと\nおんなじじゃない？\nまた中から改造おもちゃが出てくるかも……。", "face": "u2006a1"}, {"name": "アンナ", "text": "そうですね。\n王子、プレゼントボックスを刺激しないよう、\n気を付けて采配を！", "face": "l0192d3de6325"}]}, {"trigger": "end", "lines": [{"name": "アエロ", "text": "ブラックメカトナカイ、撃破ちゅん！", "face": "u2004a1"}, {"name": "ミネルバ", "text": "なかなかの強敵だったね。\nだけどね、私達も伊達に戦ってないよ。", "face": "u91"}, {"name": "インテリデーモン", "text": "この私の秘密兵器を撃破するとは……。\nなかなかやりますね、王国軍。", "face": "l815517a11268"}, {"name": "クルス", "text": "さっさと投降しなさい。インテリデーモン。\n貴方にはもう手はないわ。", "face": "u2006a1"}, {"name": "インテリデーモン", "text": "もう手はない……ですか？\nいいえ、私には希望が残されている……！", "face": "l0c6200c9da19"}, {"name": "マルティナ", "text": "その恰好は……ッ！\n聖夜に夢を届けるはずのその恰好は……ッ！", "face": "u2003a1"}, {"name": "インテリデーモン", "text": "そう、そう！　サンタクロース！", "face": "l0c6200c9da19"}, {"name": "インテリデーモン", "text": "貴方がたは忘れているようですが、\n私の手には、既に生産された改造おもちゃがあります！", "face": "l0c6200c9da19"}, {"name": "インテリデーモン", "text": "これを配り歩けばオルカ科学ラボの人気は失墜。\nデモシェフ商会の売り上げは右肩上がり！", "face": "l0c6200c9da19"}, {"name": "ブランシュ", "text": "人気失墜どころじゃないわ。\nあんなものばら撒いたら、どこも大混乱よ！", "face": "u2005a1"}, {"name": "インテリデーモン", "text": "さらばです！　\nおもちゃ業界からシャチ共が消え去った時、\nまた会いましょう！", "face": "l0c6200c9da19"}, {"name": "マルティナ", "text": "目的にまい進するあまり、\n結果が見えていないのですわ！", "face": "u2003a1"}, {"name": "マルティナ", "text": "インテリデーモン……しぶといお方。\n何としてでも阻止しますわ！", "face": "u2003a1"}]}], "active": true}