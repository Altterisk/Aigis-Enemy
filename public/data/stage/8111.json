{"quest_id": 8111, "name": "戦闘用メカトナカイのおもちゃ", "description": "インテリデーモンの計画を止めるため工場\n内部を進む王子一行に、戦闘向けの改造を\n施されたブラックメカトナカイが襲い来る。\n極級（★１獲得の目安：平均Lv25）", "event": "聖夜のメカニカルおもちゃ戦線", "event_category": "History", "mission_id": 920207, "map_no": 4813, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097312, "race_id": 9, "master_id": 53, "global_id": 52, "commands": {"raw": "SetStageFlag(1, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 1, 1 );\");", "sets_flags": [[1, 0], [1, 1]], "on_destroy": true}, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 9, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "commands": {"raw": "SetStageFlag(3, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 3, 1 );\");", "sets_flags": [[3, 0], [3, 1]], "on_destroy": true}, "spawn_sec": 5}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "commands": {"raw": "SetStageFlag(8, 0); DoEnem