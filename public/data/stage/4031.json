{"quest_id": 4031, "name": "獣人の誇り：魔狼と獣人　", "description": "人にも魔物にもなれない\n哀しき獣人たち\n己の力を示すため王子に挑む。", "event": "獣人の誇り", "event_category": "History", "mission_id": 920015, "map_no": 3129, "level": 75, "multiplier": 0.75, "charisma": 15, "capacity": 10, "enemies": [{"enemy_id": 1, "source": "local", "count": 20, "form_count": 1, "hp": 750, "attack": 112, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 2, "level": 60, "form_count": 1, "hp": 1500, "attack": 412, "base_hp": 2000, "base_attack": 550, "damage_type": "physical", "armor_defense": 800, "attack_speed": 60, "attack_wait": 10, "attack_interval": 116, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098496, "race_id": 12, "master_id": 100, "global_id": 99, "spawn_sec": 22}, {"enemy_id": 3, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 3000, "attack": 262, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 67, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102368, "race_id": 12, "master_id": 10046, "global_id": 1045, "spawn_sec": 30}, {"enemy_id": 4, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 1875, "attack": 450, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 27, "global_id": 26, "spawn_sec": 44}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "この数日、民たちが森の狼の襲撃を\n受けることが多発しています。"}, {"name": "アンナ", "text": "中には森から遠く離れた居住地まで\n被害が及んでおります。\n何か良くないことが起きているのかも……。"}]}, {"trigger": "battle", "at_sec": 33, "lines": [{"name": "エイダ", "text": "グルルルル……。\nやっと出てきたな。", "face": "u137"}, {"name": "エイダ", "text": "おまえが人間たちを率いる\n英雄の末裔か……。", "face": "u137"}, {"name": "エイダ", "text": "おまえを……おまえを倒せば！", "face": "u137"}, {"name": "アンナ", "text": "あの娘は獣人のようです。\n人と魔物の中間……\nどちらでもあり……どちらでもない。"}, {"name": "アンナ", "text": "どうやら魔物たちに組しているようです。\nお気をつけください！"}]}, {"trigger": "end", "lines": [{"name": "エイダ", "text": "ぐっ……。人間のくせに強い……。", "face": "u137"}, {"name": "エイダ", "text": "あたしの力はまだこんな物じゃない……\n次こそは勝つ！", "face": "u137"}, {"name": "アンナ", "text": "狼は獣人が操っていたようですね。"}, {"name": "アンナ", "text": "獣人たちは人間を憎んでいると聞きます。\n人間の中には獣人を魔物の手先として\nさげすむ者が多くいますから……。"}, {"name": "アンナ", "text": "そのため獣人は人里から離れ\nひっそりと暮らしていることが\n多いのですが"}, {"name": "アンナ", "text": "やはり、彼らは人間の敵になってしまう\nのでしょうか……。"}]}], "active": true}