hp": 1300, "attack": 280, "base_hp": 1300, "base_attack": 280, "damage_type": "physical", "armor_defense": 100, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 131, "global_id": 130, "ranged": true, "spawn_sec": 114}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ずいぶんと森の中を進んできましたが、\nまだまだベルゼビュートの居場所までは\n遠そうですね。", "face": "l8de2e2200bf7"}, {"name": "バシラ", "text": "……ッ！？\n皆さん、警戒してください。\n何者かが近づいてきました！", "face": "u28"}, {"name": "教団員", "text": "貴様たちがベルゼビュート様の\n復活を阻止しようとしている者か……。", "face": "lfc9619810aa7"}, {"name": "教団員", "text": "アイーダ達が敗れた今、\nベルゼビュート様を守ることができるのは\n我々しかいない……我々しかいないのだ……！", "face": "lfc9619810aa7"}, {"name": "ケイティ", "text": "あの見た目や言動から察するに、\n彼らが教団の者たちのようですね……。", "face": "u114"}, {"name": "教団員", "text": "見ていてください、ベルゼビュート様……！\n我らこそが貴方様の一番の僕であることを\n今ここに証明してみせましょう！", "face": "lfc9619810aa7"}, {"name": "アンナ", "text": "敵が戦闘態勢に入りました！\n王子、戦いの準備をお願いします！", "face": "l8de2e2200bf7"}]}, {"trigger": "end", "lines": [{"name": "教団員", "text": "ハァ……ハァ……ば、バカな……！？\n我らの信仰心が足りないというのか……？\nこんなところで負けるなど……有り得ない……。", "face": "lfc9619810aa7"}, {"name": "教団員", "text": "ベルゼビュート様……どうかお許しください！\n今この時だけは、敵に背を向けることを……、\nどうか、どうかお許しくださいぃぃ……ッ！", "face": "lfc9619810aa7"}, {"name": "バシラ", "text": "どうやら、退けられたようですね。\n……ですが、何だか少しだけ怖かったです。", "face": "u28"}, {"name": "ケイティ", "text": "そうですね。\n少しの間しか相対していませんが、\nあの盲信ぶりは常軌を逸しています……。", "face": "u114"}, {"name": "バシラ", "text": "何が何でもベルゼビュートを復活させようと\n思っているのでしょうね……。\n魔神なのに……。", "face": "u28"}, {"name": "アンナ", "text": "あまりゆっくりはしていられませんね。\n王子、急いでベルゼビュートの捜索を進めましょう。", "face": "l8de2e2200bf7"}]}], "active": true}