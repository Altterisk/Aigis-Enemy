{"quest_id": 1904, "name": "開発区", "description": "都の住民が囚われている開発区へと\n辿り着いた。警備機械と変異した\n魔物の軍勢を撃破し、人々を救出せよ！\n", "event": "ストーリーミッション9", "event_category": "Story", "mission_id": 100009, "map_no": 1125, "level": 100, "multiplier": 1.0, "charisma": 49, "capacity": 10, "enemies": [{"enemy_id": 1, "source": "local", "count": 41, "form_count": 1, "tags": ["変異"], "hp": 3300, "attack": 580, "base_hp": 3300, "base_attack": 580, "damage_type": "physical", "attack_range": 180, "attack_speed": 40, "attack_wait": 30, "attack_interval": 105, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2115744, "race_id": 9, "special_effect_id": 309, "change_to": 1, "change_condition": 1, "missile_id": 298, "missile": {"speed": 2.0}, "master_id": 31245, "global_id": 4864, "ranged": true, "variants": [{"tags": ["変異"], "hp": 3300, "attack": 580, "base_hp": 3300, "base_attack": 580, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2115760, "race_id": 9, "special_effect_id": 309, "master_id": 31244, "global_id": 4863}], "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "tags": ["変異"], "hp": 15200, "attack": 1800, "base_hp": 15200, "base_attack": 1800, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 171, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115776, "special_effect_id": 311, "master_id": 31246, "global_id": 4865, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 28, "form_count": 1, "tags": ["機械"], "hp": 35000, "attack": 1000, "base_hp": 35000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1500, "attack_range": 340, "attack_speed": 1, "attack_wait": 60, "attack_interval": 173, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119248, "race_id": 9, "special_effect_id": 383, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 31879, "global_id": 5498, "ranged": true, "spawn_sec": 50}, {"enemy_id": 5, "source": "local", "count": 11, "form_count": 1, "tags": ["機械"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1500, "attack_range": 250, "attack_wait": 100, "attack_interval": 226, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115792, "special_effect_id": 312, "missile_id": 26, "master_id": 31247, "global_id": 4866, "ranged": true, "spawn_sec": 132}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 150000, "attack": 4000, "base_hp": 150000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 3000, "attack_range": 300, "attack_wait": 200, "attack_interval": 476, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115808, "special_effect_id": 313, "missile_id": 300, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31248, "global_id": 4867, "ranged": true, "spawn_sec": 233}], "popups": ["ゴブリンの歩行機械は\n攻撃力1500以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――この先が、生存者の方々が\n監禁されているという開発区ですか……。", "face": "laa9c849b0c0e"}, {"name": "ピッキー", "text": "はい……元々は都市の発展のために、\n色んなものの新開発を担っていた場所です。", "face": "u671"}, {"name": "ピッキー", "text": "今は魔物がうじゃうじゃといて、\n皆を助けに行くどころか、\n偵察にも来れなくなってしまって……。", "face": "u671"}, {"name": "アンナ", "text": "今は我々がついています。\n一刻も早く、囚われている人達を助け出しましょう。", "face": "laa9c849b0c0e"}, {"name": "ピッキー", "text": "ぐすっ……はいっ！", "face": "u671"}, {"name": "アンナ", "text": "ここから先は何が出てくるか分かりません。\n王子、より一層慎重な采配をお願いします！", "face": "laa9c849b0c0e"}]}, {"trigger": "battle", "at_sec": 51, "lines": [{"name": "ゴブリン？", "text": "――ギャギャッ！　侵入者ハッケン！\n攻撃ヲ開始スル！！\nウィーン、ガシャーン！　ドドドド！！", "face": "l719081337c55"}, {"name": "リッカ", "text": "な、何ですかあれ！？\nゴブリンがくぐつに乗ってますよ！？", "face": "u152"}, {"name": "ピッキー", "text": "いえ、あれは……！！\nこの都市に配備されていた歩行機械です！\nゴブリン用に改造されちゃってますけど……！！", "face": "u671"}, {"name": "リッカ", "text": "鋼の都の兵器をゴブリンが改造するなんて……。\nで、でも一機だけなら――", "face": "u152"}, {"name": "バシラ", "text": "――いえ、奥から聞こえてくるこの音……。\nリッカさん、一機どころじゃないです！\nこの先からいっぱい向かってきてます！", "face": "u28"}, {"name": "リッカ", "text": "えぇぇぇっ！？\nあんな砲塔を構えた機械が何機も？\nそれにあのキラキラしたの、例の防壁でしょ！？", "face": "u152"}, {"name": "ピッキー", "text": "ど、どうしましょう……！？\nあの機械は砲弾が発射できるタイプですから、\nいっぱい来たら爆風で大変なことになっちゃいます！", "face": "u671"}, {"name": "レアン", "text": "落ち着けピッキー、リッカ。\n要は爆風の影響を最小限に抑える陣形を組んで、\n防壁を上回る攻撃をすればいい。そうだろう、王子？", "face": "u50"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "ピッキー", "text": "これで開発区への道が開きました！\nあ、あたし監禁されていた人達を助けてきます！！", "face": "u671"}, {"name": "アリサ", "text": "あっ、ピッキーさん！\n一人じゃ危ないですよ！　私も行きますから！", "face": "u24"}, {"name": "リッカ", "text": "人間用の機械をゴブリンが扱えるように改造……。\nこんなことができる魔物なんて……。", "face": "u152"}, {"name": "ティアル", "text": "うん……ゴブリン博士の仕業に間違いないよ。\nもしかしたら変異種も、博士の仕業かも……？", "face": "u505"}, {"name": "レアン", "text": "黒幕の予想がついたとは言っても、\nこちらが後手に回っている状況は覆しようがないな。\n慎重に進軍するしかないか。", "face": "u50"}, {"name": "バシラ", "text": "――あっ、ピッキーさんが戻ってきましたよ！\nピッキーさん、街の皆さんは……？", "face": "u28"}, {"name": "ピッキー", "text": "皆の閉じ込められていた牢は解放してきました！\n……でも、父さんが……うぅぅ。\n父さんは、奥の研究所に連れて行かれたって……。", "face": "u671"}, {"name": "アンナ", "text": "……ここまで来たら、\nもう最深部まで進むしかありませんね。\n王子、ピッキーさんのお父さんを助けにいきましょう！", "face": "laa9c849b0c0e"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 11, "params": [500]}], "enemies": [{"enemy_id": 1, "hp": 4290, "attack": 580, "damage_type": "physical", "pattern_id": 2115744}, {"enemy_id": 3, "hp": 19760, "attack": 2340, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2115776}, {"enemy_id": 4, "hp": 45500, "attack": 1000, "damage_type": "physical", "armor_defense": 1500, "pattern_id": 2119248}, {"enemy_id": 5, "hp": 10400, "attack": 800, "damage_type": "physical", "armor_defense": 1500, "pattern_id": 2115792}, {"enemy_id": 6, "hp": 195000, "attack": 4000, "damage_type": "physical", "armor_defense": 3000, "pattern_id": 2115808}]}, "story_talk": true, "active": true}