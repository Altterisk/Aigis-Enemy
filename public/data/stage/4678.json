{"quest_id": 4678, "name": "田んぼに潜む妖怪", "description": "泥田坊の動きに注意し\n妖怪総大将のぬらりひょんを\n撃破せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "第二次妖怪大戦", "event_category": "History", "mission_id": 920073, "map_no": 3725, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "level": 80, "form_count": 1, "tags": ["ステルス"], "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 110, "attack_wait": 30, "attack_interval": 219, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099552, "race_id": 4, "master_id": 108, "global_id": 107, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 27, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 29}, {"enemy_id": 4, "source": "local", "count": 8, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 51}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 3, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 68}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 17000, "attack": 1000, "base_hp": 17000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 280, "magic_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 90, "attack_interval": 281, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2103312, "race_id": 4, "special_effect_id": 567, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 440, "global_id": 439, "ranged": true, "spawn_sec": 165}], "popups": ["ぬらりひょんがいる間は\n全ての妖怪の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ぬらりひょん", "text": "ヒョッヒョッ。\nもうすぐ酒呑童子がおる都につくわい。\nこうもうまく鬼の頭領を部下にできるとはのう。", "face": "l1a8ed43acebc"}, {"name": "ヒバリ", "text": "――待て、ぬらりひょん！　", "face": "u389"}, {"name": "ぬらりひょん", "text": "誰じゃお主は……んっ？\nその刀はまさか……「鬼切」！？　", "face": "l1a8ed43acebc"}, {"name": "ヒバリ", "text": "ふ、こんな場所で鉢合わせるとはね……。\n酒呑童子を追っていたけれど、\nまずは貴方から仕留めさせてもらう！", "face": "u389"}, {"name": "ぬらりひょん", "text": "その出で立ち、その覇気……成る程。\n鬼退治の童というわけか。\n邪魔くさいのが増えたのう……。", "face": "l1a8ed43acebc"}, {"name": "ヒバリ", "text": "邪なる鬼達の封印を解いた罪は重いわよ！\n覚悟しなさい！", "face": "u389"}, {"name": "ぬらりひょん", "text": "ヒョッヒョッ。妖怪総大将のわしが\n相手にしてもよいが、ヌシの宿敵は鬼であろう？　\n奴ならばこの先の都におるぞい。", "face": "l1a8ed43acebc"}, {"name": "ヒバリ", "text": "……ッ！", "face": "u389"}, {"name": "ヒバリ", "text": "敵に塩を送るとはいい度胸ですね。\nだけど、貴方の罪は後で裁いてやるわ。\n私は使命を優先しなければ……。都へ向かう！", "face": "u389"}, {"name": "ぬらりひょん", "text": "ヒョッヒョッ。あっさり騙されよってからに。\nこのわしが「鬼切」を放っておくと思ったか？　\n妖怪達！　あの童を追い、滅するのじゃ。", "face": "l1a8ed43acebc"}, {"name": "アンナ", "text": "――ぬらりひょん、逃がしませんよ！", "face": "lef0cef750e7e"}, {"name": "ぬらりひょん", "text": "なんじゃ？\n鬼切の童の次はお主たちか。", "face": "l1a8ed43acebc"}, {"name": "ぬらりひょん", "text": "次から次へと、うるさい奴らじゃ。\n先程の童は妖怪達に任せるかのう。\nまずは貴様等を滅してくれるわ！", "face": "l1a8ed43acebc"}]}, {"trigger": "end", "lines": [{"name": "ぬらりひょん", "text": "ヒョーヒョッヒョッ。\nさすがに強いのぅ……。\n本気を出せば倒せるが、ここは退散するかのう。", "face": "l1a8ed43acebc"}, {"name": "ぬらりひょん", "text": "格下にはもったいないが、酒呑童子を使い、\n童と王子を一網打尽にしてやるかのう。\nわしは慎重で頭脳派なんじゃ。ヒョッヒョッ。", "face": "l1a8ed43acebc"}, {"name": "ユリアン", "text": "待て！　くそっ……。\n王子！　一刻も早く、ぬらりひょんを\n追いかけよう！", "face": "u7"}, {"name": "アンナ", "text": "都へ急ぎましょう、王子。", "face": "lef0cef750e7e"}]}], "active": true}