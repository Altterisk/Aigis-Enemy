{"quest_id": 4131, "name": "魔人の宿命：闇夜の吸血鬼", "description": "新たな魔物を伴い再び現れた\n少女。体の自由を奪われる前\nに魔物を倒せ！", "event": "魔人の宿命", "event_category": "History", "mission_id": 920026, "map_no": 3033, "level": 95, "multiplier": 0.95, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 17, "form_count": 1, "hp": 950, "attack": 142, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 6650, "attack": 285, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 30}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 855, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 32, "global_id": 31, "ranged": true, "spawn_sec": 40}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 7600, "attack": 180, "base_hp": 8000, "base_attack": 180, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099248, "race_id": 16, "special_effect_id": 234, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 205, "global_id": 204, "ranged": true, "spawn_sec": 57}], "dialogue": [{"trigger": "start", "lines": [{"name": "フラン", "text": "来たか。", "face": "u183"}, {"name": "アンナ", "text": "魔物に加担するのをやめて、\nこちらに来る気はありませんか？"}, {"name": "フラン", "text": "ここは……、やっと見つけた私の唯一の場所。\nあなたたちにとやかく言われる筋合いはない。", "face": "u183"}, {"name": "アンナ", "text": "魔物の側についても良い事はありません！\n手先として使われるだけです！", "face": "lcef074cc004b"}, {"name": "フラン", "text": "……人間は魔人の私を迫害してきた。\nヴァンパイアの血が流れる私の\n生きる道はここしかない。", "face": "u183"}, {"name": "兵士", "text": "報告！\n見慣れぬ敵がこちらに迫ってきています！", "face": "l1d875abbd067"}, {"name": "フラン", "text": "フフ。\n行け！吸血の魔物達！\n奴らの体の自由を奪うのだ！", "face": "u183"}, {"name": "アンナ", "text": "体の自由を奪う…？\n王子、お気を付けください！\n何か特殊な攻撃をしてくるようです！", "face": "lcef074cc004b"}]}, {"trigger": "end", "lines": [{"name": "フラン", "text": "……どうやら少々時間を無駄にしたようだ。", "face": "u183"}, {"name": "アンナ", "text": "あっ……。行ってしまいました。\n唯一の居場所ですか……。", "face": "lcef074cc004b"}, {"name": "アンナ", "text": "どんな場所でも魔物の側にいては\n無事ではありません。", "face": "lcef074cc004b"}, {"name": "アンナ", "text": "彼女の為にも、追いましょう！", "face": "lcef074cc004b"}]}], "active": true}