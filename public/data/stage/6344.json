98800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 30852, "global_id": 4471, "to_global_id": 121, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 98}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "tags": ["忍者"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098896, "race_id": 16, "master_id": 436, "global_id": 435, "spawn_sec": 109}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 4000, "attack": 750, "base_hp": 4000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098832, "race_id": 16, "master_id": 124, "global_id": 123, "spawn_sec": 148}], "dialogue": [{"trigger": "start", "lines": [{"name": "イリス", "text": "わ、わ、わ……わぁ～っ♪\nすごいですっ！　すごい高さまで揚がってますっ！", "face": "u1573"}, {"name": "イーリス", "text": "とってもお上手ですよ、イリスさん。\n凧揚げのコツもすっかり掴んだみたいですね。", "face": "u1575"}, {"name": "イリス", "text": "はい。イーリスさんに教えていただいたおかげです♪\n東の国の遊びって、すごく楽しいですね。", "face": "u1573"}, {"name": "イーリス", "text": "ふふ、私も東の国の方から教わったんですよ？\n（はぁ……はしゃいでるイリスさん、可愛いなぁ……）", "face": "u1575"}, {"name": "アンナ", "text": "お二人とも晴れ着姿がよくお似合いで、\n本当に可愛らしいですね……。"}, {"name": "イリス", "text": "あ、イーリスさん。\n向こうから大きな凧が飛んできましたよ？", "face": "u1573"}, {"name": "イーリス", "text": "な、なんですか、あの大きな凧？\nこっちに向かって……って、人が乗ってる！？", "face": "u1575"}, {"name": "忍者", "text": "ふふふ……凧揚げの凧に紛れて攻め込むという\nこの完璧な奇襲、よくぞ見破った。", "face": "u147"}, {"name": "忍者", "text": "だが、気づくのが少し遅かったな。\n己の間抜けさを悔いながら死ぬがいい！", "face": "u147"}, {"name": "アンナ", "text": "――ッ！　王子、凧に乗った忍者たちの他に、\n地上からも多数の忍者が接近してきています！", "face": "l9a888bab28b2"}, {"name": "ケイティ", "text": "ただちに迎撃しましょう。\nしかし、あれだけ多数の敵をさばききれるかどうか……。", "face": "u114"}, {"name": "イリス", "text": "皆さん、回復は私たちに任せてください！", "face": "u1573"}, {"name": "イーリス", "text": "ええ。私とイリスさんの二人なら\n皆さんを最後まで癒しきれると思います！", "face": "u1575"}, {"name": "アンナ", "text": "イーリスさん、イリスさん……ありがとうございます。"}, {"name": "アンナ", "text": "王子、回復はヒーラーのお二人にお任せして、\n我々は忍者たちの撃退に専念しましょう！"}]}, {"trigger": "end", "lines": [{"name": "忍者", "text": "くっ……計算外だ。\n晴れ着の小娘二人が治癒術の使い手だったとは……。", "face": "u147"}, {"name": "忍者", "text": "策士策に溺れる、とはこのことか。\nここは撤退あるのみ、だな……。", "face": "u147"}, {"name": "ケイティ", "text": "……なんとか撃退できましたね。\n王子、お疲れ様でした。", "face": "u114"}, {"name": "アンナ", "text": "イリスさん、イーリスさん、\n本当にありがとうございます。\nお二人とも大活躍でしたね。"}, {"name": "イーリス", "text": "ふふっ、どういたしまして。\n普段と違う恰好でしたので、少し不安でしたけど、\n皆さんのお役に立てて光栄です。", "face": "u1575"}, {"name": "イリス", "text": "私も今日は、いつもと違った気分で\n皆さんを癒やすことができました。\n晴れ着って、心まで暖かくしてくれるんですね♪", "face": "u1573"}, {"name": "ダニエラ", "text": "ねえ。せっかく似合ってるんだから、二人とも\nしばらくその恰好で過ごしたらいいんじゃない？", "face": "u43"}, {"name": "イーリス", "text": "え？　でも、いいのでしょうか……？", "face": "u1575"}, {"name": "ダニエラ", "text": "いいじゃない少しくらい。ねぇ、王子？\n王子も二人の可愛い姿、もっと見ていたいわよね？", "face": "u43"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "イーリス", "text": "か……可愛い？\n（ど……どうしましょう、イリスさん？）", "face": "u1575"}, {"name": "イリス", "text": "（わ、私は王子が見たいと仰るのでしたら、\nもう少しだけこの服装でいたいです……）", "face": "u1573"}, {"name": "イーリス", "text": "……ふふっ、そうですね。\nでは、しばらくはこの恰好でいようと思います。", "face": "u1575"}]}], "story_talk": true, "active": true}