{"quest_id": 6344, "name": "王子軍の凧揚げ", "description": "東の国にて束の間の休息。\n凧揚げを楽しむ王子軍だが、\nそこに魔の手が忍び寄る……。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ18(2017)", "event_category": "Reproduce", "mission_id": 300175, "map_no": 5473, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 20, "form_count": 1, "hp": 1000, "attack": 700, "base_hp": 1000, "base_attack": 700, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_range": 10, "attack_speed": 65, "attack_wait": 80, "attack_interval": 197, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098864, "race_id": 16, "special_effect_id": 229, "missile_id": 56, "missile": {"speed": 1.0, "splash": 80}, "master_id": 30851, "global_id": 4470, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 35}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "tags": ["忍者"], "hp": 900, "attack": 190, "base_hp": 900, "base_attack": 19