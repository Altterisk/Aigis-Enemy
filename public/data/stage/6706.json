400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157, "spawn_sec": 137}, {"enemy_id": 5, "source": "local", "count": 7, "form_count": 2, "tags": ["アンデッド"], "hp": 5600, "attack": 360, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_speed": 35, "attack_wait": 50, "attack_interval": 171, "move_speed": 650.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105104, "special_effect_id": 240, "change_to": 5, "master_id": 644, "global_id": 643, "to_global_id": 642, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 141}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 5600, "attack": 450, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 30, "attack_speed": 35, "attack_wait": 50, "attack_interval": 136, "move_speed": 650.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105424, "special_effect_id": 240, "missile_id": 45, "master_id": 643, "global_id": 642, "ranged": true}, {"enemy_id": 7, "source": "local", "count": 7, "form_count": 2, "tags": ["アンデッド"], "hp": 3600, "attack": 240, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111856, "race_id": 8, "special_effect_id": 233, "change_to": 7, "change_condition": 3, "master_id": 30626, "global_id": 4245, "to_condition": 3, "to_global_id": 4246, "spawn_sec": 167}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 3600, "attack": 360, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 400, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111872, "race_id": 8, "special_effect_id": 233, "master_id": 30627, "global_id": 4246, "from_condition": 3}], "popups": ["バリケードは破壊されても\n★の評価には影響しません。", " 　　　悪天候：闇夜\n\n・敵の『移動速度』上昇"], "dialogue": [{"trigger": "start", "lines": [{"name": "ディルク", "text": "――バリケードの敷設、完了しましたッ！！", "face": "u287"}, {"name": "レオナ", "text": "ご苦労。これでヴァンパイアに\n占拠された砦の奪還準備が整ったな。\n兵達には引き続き周辺の警戒にあたるよう伝えてくれ。", "face": "u311"}, {"name": "ディルク", "text": "――はっ！！", "face": "u287"}, {"name": "レオナ", "text": "王子、すまないな。客人であるお前達にまで、\n事態の鎮圧を手伝わせてしまうとは……。", "face": "u311"}, {"name": "アンナ", "text": "いえ、帝国と王国は協力関係にありますから、\n緊急事態にはお互い様です。\nそうですよね、王子？"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "レオナ", "text": "ふっ、ならばこれは借りだと思っておこう。\n――しかし『闇夜』に乗じて\nヴァンパイアに砦を占領されてしまうとはな……。", "face": "u311"}, {"name": "アンナ", "text": "ヴァンパイア達は『闇夜』でこそ、\n本来の力を発揮すると聞きます。\nやはり夜の間に襲撃をかけるより、朝を待つ方が――", "face": "l3cefd61f240e"}, {"name": "ルマリア", "text": "――いえ、今回はそうでもなさそうです。\n砦を占拠されてはいますが、\nどうやら連中の飢えは治まっていないようですから。", "face": "u343"}, {"name": "ヒューナ", "text": "ルマリアの言うとおりね。\n血に飢えたヴァンパイア達が、獲物を求めて\n外に飛び出してくるのも時間の問題よ。", "face": "u627"}, {"name": "ルマリア", "text": "はい。砦に攻め込むまでもなく、\n万全の態勢が整っているこの場で\nヴァンパイアを迎撃するのが最善の策かと。", "face": "u343"}, {"name": "レオナ", "text": "なるほど……。砦を包囲した我々が、\n連中には群がる餌に見えているということか。", "face": "u311"}, {"name": "ヒューナ", "text": "ふふっ、そういうこと。\nそれにせっかくディルク達がバリケードを\n用意してくれたんだから、利用しない手もないしね。", "face": "u627"}, {"name": "ルマリア", "text": "ヴァンパイア達の爪や牙から傷を受ければ、\n身体が麻痺してしまいますからね……。\nバリケードで足止めしつつ、遠距離から攻撃しましょう。", "face": "u343"}, {"name": "アンナ", "text": "――どうやら、おふたりの予想が当たったようですね。\n王子、砦の入り口から敵が現れました。\n急ぎ、迎撃の準備をお願いします！", "face": "l3cefd61f240e"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "――静かになりましたね。\n砦に籠もっていたヴァンパイアは、\n掃討出来たのでしょうか……？", "face": "l3cefd61f240e"}, {"name": "フラン", "text": "ふぅ、砦の内部も見てきたけど、\nこの周辺にもうヴァンパイアはいないみたい。", "face": "u183"}, {"name": "ディルク", "text": "こちら側に迫ってきたヴァンパイアも、\n無事に掃討が完了しております。", "face": "u287"}, {"name": "レオナ", "text": "何とか砦を奪還できたか……。\nしかし、これほどの手際となると、\n王子の言っていた公爵が黒幕か……？", "face": "u311"}, {"name": "ヒューナ", "text": "帝国の砦を落とすほどのこの手際、\n間違いなくヴァンパイア公爵の仕業ね。\nでもまさか、帝国にまで手を広げているなんて。", "face": "u627"}, {"name": "レオナ", "text": "魔王軍への対応だけでも厄介だというのに、\nまったく、手間をかけさせてくれるな……。", "face": "u311"}, {"name": "ルマリア", "text": "となれば、私達ももっと\n腕を磨かなくてはなりませんね。", "face": "u343"}, {"name": "フラン", "text": "ヴァンパイア達の\n好きにさせておくわけにもいかないからね。\nもっともっと強くならないと……。", "face": "u183"}, {"name": "ヒューナ", "text": "ふふっ、当然よ。\nでも今は、この周辺に討ち漏らした\nヴァンパイアがいないか、確認するのが先決ね。", "face": "u627"}, {"name": "レオナ", "text": "そうだな。\n周辺の捜索の後、帝国に帰還するとしよう。\n王子、すまないがもう少し付き合ってくれ。", "face": "u311"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}