0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 961, "global_id": 960, "ranged": true, "spawn_sec": 103}, {"enemy_id": 16, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 1200, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 161, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112288, "race_id": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30683, "global_id": 4302, "ranged": true, "spawn_sec": 120}, {"enemy_id": 17, "source": "local", "count": 2, "level": 150, "form_count": 1, "hp": 7200, "attack": 600, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "attack_interval": 164, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100016, "race_id": 4, "master_id": 863, "global_id": 862, "spawn_sec": 143}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 1, "hp": 2400, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 100, "attack_speed": 180, "attack_wait": 120, "attack_interval": 301, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108000, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 32866, "global_id": 6484, "ranged": true, "spawn_sec": 192}], "popups": ["　　　　三明剣　小通連\n\n小通連を破壊しない限り、\n大嶽丸にダメージを与えることは\nできません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "大嶽丸", "text": "ククク……。\nやはり三明剣は、全て揃ってこそ輝きを増すものだ……。", "face": "la8d2c15052d7"}, {"name": "大嶽丸", "text": "かつての力が蘇ってくる……。\nこれならば、畏れだ何だと言わず、\n全ての種族を従えるのも不可能ではない。", "face": "la8d2c15052d7"}, {"name": "大嶽丸", "text": "さて、まずは何を砕いてやろうか……。\n重水の、お前ならば何処を蹂躙せんと望むか。", "face": "la8d2c15052d7"}, {"name": "重水の四天王", "text": "そうですね……。\n我ら鬼が幾度も煮え湯を飲まされた、\n王国の領土を平らげてやりたいものですねぇ……。", "face": "l9556fd98d1d0"}, {"name": "大嶽丸", "text": "平らげる、か……甘美な響きだ。\nかつての力を取り戻した今ならば、\n地平の果てまで無に帰すことも不可能ではない。", "face": "la8d2c15052d7"}, {"name": "大嶽丸", "text": "しかし……あの男のことだ。\nきっと今に、この場所へ自ら殺されに来ることだろう。\nククッ……さぁ、王子よ、早くここへ来るがいい……。", "face": "la8d2c15052d7"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ホムラ", "text": "誰が殺されに来るかよ。\n大嶽丸、倒されるのはテメェの方だぜ！", "face": "u739"}, {"name": "ヒバリ", "text": "そのとおり。\nいつの世も、鬼の行く先を制すのは人なのよ。", "face": "u389"}, {"name": "大嶽丸", "text": "……ククッ、これまではそうだっただろう。\n酒呑童子も人に討たれたのだからな。", "face": "la8d2c15052d7"}, {"name": "大嶽丸", "text": "だが、これからは違う……。\nこれより先の世は、鬼が恐怖によって君臨するのだ。", "face": "la8d2c15052d7"}, {"name": "大嶽丸", "text": "さぁ、お前達の恐怖の色を、\n我ら鬼に味わわせてもらおうか……。", "face": "la8d2c15052d7"}, {"name": "ホムラ", "text": "王子、これまでと同じとは思わない方が良いぜ。\nオレ達の全力で、あいつを叩き潰すんだ！！", "face": "u739"}]}, {"trigger": "battle", "at_sec": 10, "lines": [{"name": "ホムラ", "text": "あん……？　何だあの箱は。\n大嶽丸のやつ、三明剣を箱に隠しやがったぞ？", "face": "u739"}, {"name": "スズネ", "text": "ぽぽん！？\nあれってあたし様たちが封印に使っていた、\n「三明剣の長持」ですぽん！！", "face": "u936"}, {"name": "ホムラ", "text": "自分で剣を封印したってことか……？\nいや、それにしちゃ大嶽丸の気配が弱まってないぞ？", "face": "u739"}, {"name": "大嶽丸", "text": "クク……卑怯な手は人から学ばせてもらったぞ……。\n我が力を封じるなどという、\n武人にあるまじき手段、利用させてもらおう。", "face": "la8d2c15052d7"}, {"name": "スズネ", "text": "……わかったですぽん！\n「三明剣の長持」から封印の力を剥ぎ取って、\n防護の力だけを悪用してるみたいですぽん！！", "face": "u936"}, {"name": "スズネ", "text": "王子さま、「三明剣の長持」を破壊しない限り、\n中に隠された剣を折ることはできないですぽんー！！", "face": "u936"}, {"name": "ヒバリ", "text": "しかし、封印の力を無理やり破壊した反動でしょう、\n箱自体の妖力も徐々に弱まっているみたい。\nじきに活路は開けるはずよ！", "face": "u389"}]}], "active": true}