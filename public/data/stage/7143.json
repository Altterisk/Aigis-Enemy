{"quest_id": 7143, "name": "Lv.1", "description": "鬼神大嶽丸を撃破せよ！\n＜三明の剣がいる間、大嶽丸は無敵＞\n＜編成内での同ユニット禁止＞\n＜ユニット、アイテムのドロップなし＞", "modifier_notes": ["三明の剣がいる間、大嶽丸は無敵", "編成内での同ユニット禁止", "ユニット、アイテムのドロップなし"], "event": "魔神降臨(大嶽丸)", "event_category": "Devil Advent", "mission_id": 500288, "map_no": 5036, "level": 60, "multiplier": 0.6, "charisma": 16, "capacity": 10, "modifiers": [{"kind": "term", "influence": 24, "params": [10], "expression": "IsOverlapMember() != 1;", "expression_human": "it is not a duplicate of another unit in your team"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルス"], "fixture": true, "hp": 360, "attack": 360, "base_hp": 600, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 1, "attack_wait": 100, "attack_interval": 242, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2097200, "special_effect_id": 604, "master_id": 32868, "global_id": 6486, "commands": {"raw": "DoEnemy_SetInvincible(1); DoEnemy_RegistCommand(\"OnChildAllDead\", \"DoEnemy_ForceDead();DoEnemy_SetInvincible(0);\");", "force_dead": true}}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルス"], "fixture": true, "hp": 360, "attack": 360, "base_hp": 600, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 1, "attack_wait": 100, "attack_interval": 242, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2097200, "special_effect_id": 605, "master_id": 32869, "global_id": 6487}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["魔神"], "hp": 60000, "attack": 1500, "base_hp": 100000, "base_attack": 2500, "damage_type": "magical", "armor_defense": 1100, "magic_defense": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 124, "move_speed": 500.0, "dot_rate": 1.5, "pattern_id": 2125424, "race_id": 4, "special_effect_id": 604, "change_to": 3, "change_condition": 2, "master_id": 32850, "gl