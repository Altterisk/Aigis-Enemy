": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 62}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 92}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 350, "base_hp": 9000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 147, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106240, "race_id": 16, "master_id": 793, "global_id": 792, "spawn_sec": 114}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 140}], "dialogue": [{"trigger": "start", "lines": [{"name": "ジェイク", "text": "協力してくれてありがとな。\nこの辺りはもう魔界アリの生息地だから、\n気を付けておいてくれ。", "face": "u367"}, {"name": "アンナ", "text": "分かりました、ジェイクさん。\n案内をお願いいたします。", "face": "l345427989d85"}, {"name": "兵士", "text": "伝令！\n斥候部隊が前方に敵影を確認！", "face": "l9173a2d96ff7"}, {"name": "バラッド", "text": "ふふ……王子、ようやく来たか。\nその身体……必ず奪ってみせるぞ！\n覚悟しろ！", "face": "u173"}, {"name": "ハリッサ", "text": "えっ！？\nまさか、バラッドまで……。", "face": "u25"}, {"name": "ジェイク", "text": "……間違いないな、\nあいつも女王蟻に操られている。\n王子、戦うしかないぞ。", "face": "u367"}]}, {"trigger": "battle", "at_sec": 116, "lines": [{"name": "バラッド", "text": "ジェイク、今だ！\n王子を攻撃しろ！\nあの極上の身体を捕縛するんだ！", "face": "u173"}, {"name": "ジェイク", "text": "了解だ、バラッド！\nおらぁ、いっくぜぇッ王子ッ！", "face": "u367"}, {"name": "アンナ", "text": "え……！？　ジェ、ジェイクさん！？\nなぜ私達を攻撃するんですか？", "face": "l345427989d85"}]}, {"trigger": "end", "lines": [{"name": "ジェイク", "text": "っぐ……王子がこれほどまでに強いとはな……。", "face": "u367"}, {"name": "バラッド", "text": "くそ、あと少しで王子を……上質の男を\n手に入れられたというのに……。\nこれでは女王様に何と報告すれば……。", "face": "u173"}, {"name": "ジェイク", "text": "もうここは俺達の縄張りだ。\nここまで王子を連れてこられただけで充分だ。\n一旦退くぞ、バラッド。", "face": "u367"}, {"name": "ケイティ", "text": "行ってしまいました……。\nまさか、ジェイクさんも操られていたなんて……。", "face": "u114"}, {"name": "アンナ", "text": "女王蟻が人を支配する力は\nそれほどまでに強力ということですね。\nどうしたら女王蟻の支配はとけるのでしょうか……。", "face": "l345427989d85"}, {"name": "ハリッサ", "text": "とにかく、彼らを追ってみよう。\nモーティマもきっといるはずだし、なんにせよ、\n先に進まない事には何も分からないよ。", "face": "u25"}]}], "map": {"image": "Map920068_3186", "w": 960, "h": 640, "spots": [{"k": "b", "x": 23, "y": 193}, {"k": "m", "x": 275, "y": 429, "id": 200}, {"k": "m", "x": 313, "y": 344, "id": 201}, {"k": "m", "x": 378, "y": 280, "id": 202}, {"k": "m", "x": 452, "y": 228, "id": 203}, {"k": "m", "x": 580, "y": 248, "id": 204}, {"k": "m", "x": 644, "y": 337, "id": 205}, {"k": "m", "x": 720, "y": 400, "id": 206}, {"k": "m", "x": 830, "y": 374, "id": 207}, {"k": "m", "x": 235, "y": 189, "id": 208}, {"k": "m", "x": 120, "y": 197, "id": 209}, {"k": "m", "x": 332, "y": 146, "id": 210}, {"k": "m", "x": 711, "y": 135, "id": 211}, {"k": "m", "x": 811, "y": 174, "id": 212}, {"k": "m", "x": 358, "y": 446, "id": 213}, {"k": "m", "x": 440, "y": 470, "id": 214}, {"k": "m", "x": 432, "y": 105, "id": 215}, {"k": "m", "x": 569, "y": 126, "id": 216}, {