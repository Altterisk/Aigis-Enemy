"attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 23, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102672, "race_id": 8, "change_to": 23, "change_condition": 3, "master_id": 385, "global_id": 384, "to_condition": 3, "to_global_id": 385, "route_behaviour": {"sets_flags": [[0, 1, 0], [0, 1, 1000]]}, "spawn_sec": 190}, {"enemy_id": 23, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1600, "base_hp": 18000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 700, "attack_speed": 20, "attack_wait": 15, "attack_interval": 116, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "master_id": 386, "global_id": 385, "from_condition": 3}, {"enemy_id": 25, "source": "local", "count": 5, "form_index": 0, "form_count": 2, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 30, "attack_speed": 30, "attack_wait": 50, "attack_interval": 196, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106704, "race_id": 8, "change_to": 25, "change_condition": 3, "master_id": 389, "global_id": 388, "to_condition": 3, "to_global_id": 389, "route_behaviour": {"sets_flags": [[0, 1, 3500], [0, 1, 2500], [0, 1, 1950]]}, "spawn_sec": 229}, {"enemy_id": 25, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 120, "attack_speed": 10, "attack_wait": 10, "attack_interval": 111, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106720, "race_id": 8, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 390, "global_id": 389, "ranged": true, "from_condition": 3}], "popups": ["砦の門は破壊されても\n★の評価には影響しません。", "帝国式魔導砲台は\nスキル中のみ攻撃を行います。\n敵の移動速度を長時間低下させる\n強力な砲弾を放ちます。\n\nHP回復を受けられませんが、\nHPが0になっても撤退せず\n一定時間後にその場で復活します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "ウオオオォォッ！　父祖よ！\nウオオオオォッ！　友よ！！　", "face": "le8d3f3acf4c9"}, {"name": "イリオス", "text": "――あ、あなたたち！\nこっちには前チャンプ、アナトリア様がいるんですよ！？\nせめてまずは話し合いを――", "face": "u872"}, {"name": "アナトリア", "text": "……イリオス、やめておきな。\nあいつらはあたしらとは、たどった道が違うのさ。", "face": "u522"}, {"name": "イリオス", "text": "……道、ですか？", "face": "u872"}, {"name": "アナトリア", "text": "魔界に住まうオークとは別に、\nかつての千年戦争以降、\n物質界に定住していたオークたちがいたと聞く。", "face": "u522"}, {"name": "アナトリア", "text": "あいつらは、千年の間先祖が守ってきた土地を、\n白の帝国に奪われ、隷従させられた民なんだろうさ。", "face": "u522"}, {"name": "イリオス", "text": "……そんな。\nそれじゃあ、正義はあちらにあるのでは――", "face": "u872"}, {"name": "アナトリア", "text": "戦争に正義なんざないさ。\nこっちの利益とあっちの利益、それが激突して、\n話し合いで済まなかった時にやるのが戦争だ。", "face": "u522"}, {"name": "アナトリア", "text": "白の帝国は戦力と領土を必要としていた。\nあいつらはその地を守りたかった。\n――で、あたしらは帝国の援軍としてここにいる。", "face": "u522"}, {"name": "イリオス", "text": "そんな、でも……うぅぅぅっ！\nよくないです！　こういうのは！", "face": "u872"}, {"name": "アナトリア", "text": "ははっ！　随分と王子に影響されたみたいだねぇ。\nこんな常識人になっちまってさ。", "face": "u522"}, {"name": "アナトリア", "text": "あたしには、あいつらの考えてることが分かるよ。\n連中もあたしも、どこまで行っても武人だからね。", "face": "u522"}, {"name": "アナトリア", "text": "――やられたことと、同じ手段をもって報復する。\nそれも正々堂々と、真正面から。\nそのために、連中はもう一度立ち上がったんだろうね。", "face": "u522"}, {"name": "イリオス", "text": "……こちらも全力で戦うのが彼らにとっての\n望みを叶えることにもなる、ということですか？", "face": "u872"}, {"name": "アナトリア", "text": "ああ、オークは戦いに生き、戦いに死ぬ誇り高き種族。\n連中の死に花、見届けてやらなくちゃね。", "face": "u522"}, {"name": "ドゥーラ", "text": "――おっと、ここにいたか！\nそろそろ戦闘が始まるぜ、\n連中が砦の「城門」に押し寄せてやがる！", "face": "u446"}, {"name": "レオナ", "text": "この砦は帝都に至る街道の、守りの要だ。\n「城門」も強固な防御力を誇っているが、\nそれでも戦いに万全は存在しない。", "face": "u311"}, {"name": "アナトリア", "text": "もっと素直に言いな。\n「城門」を破壊されたら、戦士がなだれ込んでくるから、\nどうか守って欲しいってな。", "face": "u522"}, {"name": "レオナ", "text": "……すまない、そのとおりだ。\n同族との戦いで気がすすまないだろうが――", "face": "u311"}, {"name": "アナトリア", "text": "ふん、同族との戦いっていうなら、\n人間の方が得意分野だろう？", "face": "u522"}, {"name": "アナトリア", "text": "王子、あたしは裏門を押さえに行く。\nこの正門はあんたの指揮に任せたよ！", "face": "u522"}]}, {"trigger": "battle", "at_sec": 29, "lines": [{"name": "レオナ", "text": "くっ……敵の数が多すぎるか。\n仕方ない、これは切り札だったが……。", "face": "u311"}, {"name": "レオナ", "text": "カトリーナ！\n「帝国式魔導砲台」を起動しろ！", "face": "u311"}, {"name": "カトリーナ", "text": "えぇっ！？　まだ起動試験も終わってないんですよ！？", "face": "u989"}, {"name": "レオナ", "text": "これが起動試験となる。……すまないな。\n――王子、この砲は広範囲を凍結させ、\n敵の行軍を大幅に遅らせることができる新兵器だ。", "face": "u311"}, {"name": "レオナ", "text": "だが、一度の砲撃ごとに魔導機関の冷却が必要となる。\n連射はできないから、使い所には気をつけてくれ。", "face": "u311"}, {"name": "カトリーナ", "text": "その使い所、もしかして今じゃないですか……？\nすごい数の敵が「城門」に向かってきていますー！", "face": "u989"}]}, {"trigger": "end", "lines": [{"name": "ハイオーク", "text": "あれが話に聞いた帝国の新兵器、か……。\n敵兵力の把握は十分だ、戦線を下げろ！！", "face": "l7bf980320ebd"}, {"name": "オーク", "text": "なっ……しかし！\n仇は目前に……！！", "face": "le8d3f3acf4c9"}, {"name": "ハイオーク", "text": "我らは誉れある戦いを重んずる。だがこの戦いは、\n志を同じくする友のための戦いでもあるのだ。", "face": "l7bf980320ebd"}, {"name": "ハイオーク", "text": "ハイドース様の宿願、虐げられし友の悲願、\nそして我らが父祖の怒り！\nそれらを遂げるため、今は撤退せよ！", "face": "l7bf980320ebd"}, {"name": "アナトリア", "text": "……まさか血気盛んな戦士たちが撤退するか。\n誉れよりも仲間を優先するとは、\n冥界軍とはそれほどの組織なのか……？", "face": "u522"}, {"name": "ケイティ", "text": "個ではなく、軍として動くオーク……。\nこれは一筋縄ではいかないようですね。", "face": "u114"}, {"name": "レオナ", "text": "ああ。こちらの手の内も明かしてしまった以上、\n次からの攻勢はより過酷なものとなるだろう。", "face": "u311"}, {"name": "アナトリア", "text": "いいじゃないか、心が躍るってものさ。\n大義と誉れ、どちらが勝つか勝負ってやつさ。", "face": "u522"}, {"name": "イリオス", "text": "……アナトリアさま？", "face": "u872"}, {"name": "アナトリア", "text": "あたしはね、じめじめしたのは嫌いなんだ。\n過去の遺恨、大義、友のための戦い、大いに結構。", "face": "u522"}, {"name": "アナトリア", "text": "でもね、そんなものは最前線じゃ消し飛ぶのが戦争さ。\nあいつらの本心を、信ずるモノを受け止められるのは、\n同じく最前線に立つ戦士だけってね。", "face": "u522"}, {"name": "アナトリア", "text": "さぁ王子、次の戦闘の準備だ！\nお前も戦士なら、あいつらを受け止めてやりな！", "face": "u522"}]}], "active": true}