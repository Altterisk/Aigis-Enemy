{"quest_id": 7322, "name": "第一陣 帝国式魔導砲台、起動！", "description": "冥界軍のオークが参戦し砦での戦いが激化。\n想定以上の敵の数に、帝国は切り札を切る。\n「帝国式魔導砲台」を使い、敵を撃退せよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "帝国一陣", "event_category": "Empire", "mission_id": 940007, "map_no": 4567, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [75]}, {"kind": "term", "influence": 20, "params": [75]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 30, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127760, "race_id": 21, "change_to": 1, "change_condition": 4, "master_id": 33555, "global_id": 7172, "to_condition": 4, "to_ticks": 3, "to_global_id": 7175, "commands": {"raw": "SetStageFlag(0, 0);", "sets_flags": [[0, 0]]}, "route_behaviour": {"sets_flags": [[0, 1, 0], [0, 1, 100], [0, 1, 250], [0, 1, 50], [0, 1, 150], [0, 1, 500], [0, 1, 300], [0, 1, 400]]}, "spawn_sec": 28}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127776, "race_id": 21, "special_effect_id": 222, "master_id": 33558, "global_id": 7175, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 5, "source": "local", "count": 12, "form_index": 0, "form_count": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102544, "race_id": 8, "change_to": 5, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 377, "global_id": 376, "ranged": true, "to_condition": 3, "to_global_id": 377, "route_behaviour": {"sets_flags": [[0, 1, 0], [0, 1, 700], [0, 1, 1000]]}, "spawn_sec": 28}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 378, "global_id": 377, "ranged": true, "from_condition": 3}, {"enemy_id": 7, "source": "local", "count": 10, "form_index": 0, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 7, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "route_behaviour": {"sets_flags": [[0, 1, 0], [0, 1, 1000]]}, "spawn_sec": 28}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "do