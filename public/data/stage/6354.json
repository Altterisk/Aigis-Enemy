{"quest_id": 6354, "name": "雷光に咲く華", "description": "決意のランファと力を合わせ、\n邪仙尊天君を撃破せよ！\n\n神級（★１獲得の目安：平均Lv50）", "event": "屍人想ウ華ノ残香", "event_category": "History", "mission_id": 920102, "map_no": 5285, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 19, "level": 10, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108080, "master_id": 991, "global_id": 990}, {"enemy_id": 2, "source": "local", "count": 13, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112832, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30726, "global_id": 4345, "ranged": true, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112816, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30725, "global_id": 4344, "ranged": true, "spawn_sec": 35}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 2, "hp": 60000, "base_hp": 60000, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 80, "attack_speed": 10, "attack_wait": 10, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113712, "special_effect_id": 260, "change_to": 4, "change_condition": 3, "master_id": 30880, "global_id": 4499, "to_condition": 3, "to_global_id": 4500, "spawn_sec": 65}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 60000, "base_hp": 60000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113872, "special_effect_id": 261, "master_id": 30881, "global_id": 4500, "from_condition": 3}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112640, "master_id": 30705, "global_id": 4324, "spawn_sec": 75}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108096, "master_id": 992, "global_id": 991, "spawn_sec": 75}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "hp": 2500, "attack": 350, "base_hp": 2500, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112624, "master_id": 30704, "global_id": 4323, "spawn_sec": 77}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 300, "base_hp": 12000, "base_attack": 300, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_wait": 20, "attack_interval": 91, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109360, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30182, "global_id": 3801, "ranged": true, "spawn_sec": 118}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112848, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30727, "global_id": 4346, "ranged": true, "spawn_sec": 120}], "dialogue": [{"trigger": "start", "lines": [{"name": "尊天君", "text": "ゆけ、キョンシーども！　総攻撃だ！\nぬしらとの戦いで疲弊した人間どもを、\n我が禍血陣で全員血祭りにあげてやる！", "face": "l198d39181e9a"}, {"name": "ケイティ", "text": "まずいですね……魔法も矢もほぼ効かず、\n近寄れば周囲の砂で相手を切り刻む、禍血陣……。\nあれを攻略できなければ一方的にやられてしまいます。", "face": "u114"}, {"name": "ランファ", "text": "私のせいです……私が皆さんを連れてこなければ……。", "face": "u579"}, {"name": "尊天君", "text": "その通り。わしの道具の分際で\n半端な自我などを保ち続けるから、\n此度のような悲劇を招いたのだ。", "face": "l198d39181e9a"}, {"name": "尊天君", "text": "されば、大人しく主に従うだけのキョンシーに戻れ。\n意志のない道具に戻れば、辛い過去も忘れられよう。\n目の前で演じられる惨劇にも心を痛めずに済むぞ？", "face": "l198d39181e9a"}, {"name": "ランファ", "text": "うぅッ……わ、私は…………ッ。", "face": "u579"}, {"name": "尊天君", "text": "さぁ……認めるのだ。\n自分はキョンシーであり、\n尊天君様の忠実なる下僕であるとなァ！", "face": "l198d39181e9a"}, {"name": "ランファ", "text": "あ、ぐぅッ……！\nはぁ、はぁっ……わ、私は……っ。\n……私、ハ…………キョンシー、デス……。", "face": "u579"}, {"name": "ランファ", "text": "…………ですが……ッ、\n貴方の下僕になど……断じてなるものですかッ！！", "face": "u579"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "――ッ！？　\nい、いまの雷は……！？", "face": "l03600a243b7b"}, {"name": "尊天君", "text": "――なッ！？　あ、あの輝きは……ッ！？\nまさか……あやつも以前屍解仙が言っておった、\n全てを貫く天雷を呼ぶ器だったというのか！？", "face": "l198d39181e9a"}, {"name": "ランファ", "text": "全てを貫く天雷……ならば、\n貴方のご自慢の禍血陣をも貫けるということですね？", "face": "u579"}, {"name": "尊天君", "text": "ぐぬぅッ……つ、つけあがるな！！\n禍血陣が破られる前にうぬを討てばよいことだ！", "face": "l198d39181e9a"}, {"name": "アンナ", "text": "させません！\n王子、ランファさんを援護いたしましょう！", "face": "l03600a243b7b"}, {"name": "アンナ", "text": "無敵にすら思える尊天君の禍血陣も、\n全てを貫くという彼女の雷の力があれば\nきっと破ることができるはずです！", "face": "l03600a243b7b"}, {"name": "アンナ", "text": "禍血陣の力が弱まれば、我々にも勝機はあります！\nランファさんと力を合わせ、\n此の地を尊天君の支配から解放いたしましょう！", "face": "l03600a243b7b"}]}, {"trigger": "end", "lines": [{"name": "尊天君", "text": "ぐがぁああアッ！！　し、失敗作めぇッ！！\nキョンシーの分際で……主に逆らうとは……ッ！！", "face": "l198d39181e9a"}, {"name": "ランファ", "text": "……確かに、私がキョンシーであることは事実。\nけれど私は失敗作でも、貴方の下僕でもありません。", "face": "u579"}, {"name": "ランファ", "text": "私はランファ、貴方のような邪悪を滅ぼす者です！", "face": "u579"}, {"name": "尊天君", "text": "（ぐぬぅッ……この地を手放すのは惜しいが、\nこれ以上粘ってもいたずらに損害を増すだけだ）", "face": "l198d39181e9a"}, {"name": "尊天君", "text": "……覚えておれ。\n此度は不覚を取ったが、\n再び相まみえた時は骨まで砕いてくれる！！", "face": "l198d39181e9a"}, {"name": "ケイティ", "text": "……敵の撤退を確認。\nあと一歩、尊天君を討つには至りませんでしたね……。", "face": "u114"}, {"name": "ランファ", "text": "……ですが、おかげさまで我が故郷を\n邪仙たちの手から解放することができました。", "face": "u579"}, {"name": "ランファ", "text": "本当に……ぐすっ……ありがとうございました……っ。", "face": "u579"}, {"name": "アンナ", "text": "ランファさん……。\n（故郷を取り戻せたとはいえ、\nランファさんのご家族やご友人は、もう……）", "face": "l1c34b9dab1d9"}, {"name": "ランファ", "text": "……大丈夫です。\nこれは後ろ向きな感情と決別するための涙ですから。", "face": "u579"}, {"name": "ランファ", "text": "王子様、御恩に報いる時が来ました。\n全てを貫く天雷を操る我が力、\nどうか今後の戦いにお役立てください。", "face": "u579"}, {"name": "ランファ", "text": "共に歩み、戦う中で気づいたのです。\n私の往くべき道は、貴方が歩む大道と同じであると。", "face": "u579"}, {"name": "王子", "text": "…………（こくり）。", "face": "u1"}, {"name": "ランファ", "text": "……ありがとうございます、王子様。\n貴方という光が道を照らしてくださっている限り、\n私はもう、決して迷いはいたしません！", "face": "u579"}]}], "active": true}