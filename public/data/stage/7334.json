{"quest_id": 7334, "name": "楽しい外来種ガーデニング", "description": "ある日の王国、ドルイドが管理する庭園で\nお茶会を行う王子たち。しかしそこには\n見慣れない巨大な花のつぼみが……？\n神級（★１獲得の目安：平均Lv50）", "event": "シャーク・オブ・ザ・デッド", "event_category": "History", "mission_id": 920161, "map_no": 5956, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 5, "hp": 70000, "attack": 2000, "base_hp": 70000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 125, "magic_defense": 40, "attack_range": 180, "attack_speed": 1, "attack_wait": 75, "attack_interval": 217, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129040, "race_id": 3, "special_effect_id": 803, "change_to": 1, "change_condition": 4, "missile_id": 89, "master_id": 33761, "global_id": 7378, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 7379, "spawn_sec": 29}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 5, "hp": 70000, "attack": 2000, "base_hp": 70000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 125, "magic_defense": 40, "attack_range": 180, "attack_speed": 1, "attack_wait": 75, "attack_interval": 217, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129040, "race_id": 3, "special_effect_id": 804, "change_to": 2, "change_condition": 4, "missile_id": 89, "master_id": 33762, "global_id": 7379, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 7380}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 5, "hp": 70000, "attack": 2000, "base_hp": 70000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 125, "magic_defense": 40, "attack_range": 180, "attack_speed": 1, "attack_wait": 75, "attack_interval": 217, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600