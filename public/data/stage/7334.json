30, "attack_wait": 50, "attack_interval": 139, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119376, "special_effect_id": 400, "master_id": 31845, "global_id": 5464, "spawn_sec": 212}, {"enemy_id": 15, "source": "local", "count": 7, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 10, "attack_interval": 76, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100224, "race_id": 3, "change_to": 11, "change_condition": 4, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 233, "global_id": 232, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 231, "spawn_sec": 246}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 16, "source": "local", "count": 9, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 321}], "popups": ["\n\n\n　　　――ある日の王国領。", "グレーターデーモンがいる間は、\n植物系の敵ユニットの\n攻撃と防御がアップします。\n\n\n\n\n　　　　　　(1/2)", "また、グレーターデーモンが\n攻撃を行うたび、\nこの効果はアップします。\n\n４回目の攻撃後、\n効果が最大になります。\n※５回目以降の効果が最大\n　　　　　　(2/2)", "魔界ヒマワリは、\n時間経過で開花します。\n開花すると一定範囲内の\nユニットは継続ダメージを受けます。\n\n一定時間継続ダメージを受けると、\n麻痺状態になります。", "マイコニドがいる間、\n全ての味方ユニットは\n継続ダメージを受けます。", "マンイーターは、\nHPが徐々に回復します。\n回復量は時間経過で減少します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "──ある日の王国領。"}, {"name": "メープル", "text": "はーい！　今日も王国ドルイド会！\nゲストに王子さまとお姉ちゃんを招いて、\nお茶会とガーデニングを始めるよぉ♪", "face": "u370"}, {"name": "メリーファ", "text": "今日もお花さんは元気かなぁ──って、\nええっ！？　し、知らない人がいますよぉ！", "face": "u876"}, {"name": "グレーターデーモン", "text": "ふむ、なんだい君たちは？\nワシの花き農場に何か用かね？", "face": "le28619cfe5d1"}, {"name": "フィオレ", "text": "ここは私たち王国ドルイド会の管理する庭園、\nそちらこそここでいったい何をしているのですか。", "face": "u392"}, {"name": "グレーターデーモン", "text": "王国のドルイド……なるほどねぇ。\nどうりで良い土壌が育っていたはずだ。", "face": "le28619cfe5d1"}, {"name": "グレーターデーモン", "text": "だが悪いねドルイド諸君、\nここに咲いていた花は全て枯れてしまったよ。\nワシのヒマワリとの生存競争に敗れてね。", "face": "le28619cfe5d1"}, {"name": "メープル", "text": "ああー！？\nメープルたちの育てたお花が、\n本当に全部枯れちゃってるよぉ！", "face": "u370"}, {"name": "ローリエ", "text": "なっ、なにがヒマワリですか！？\nどう見ても魔物じゃないですか！！", "face": "u257"}, {"name": "グレーターデーモン", "text": "魔界ヒマワリさ。開花すれば観葉植物の他、\n強力な従魔としても使える優秀な植物魔獣だよ。", "face": "le28619cfe5d1"}, {"name": "グレーターデーモン", "text": "今回の栽培が上手く行けば本格的に事業を立ち上げ、\n物質界に展開させるのも悪くないと考えていたところさ。", "face": "le28619cfe5d1"}, {"name": "フィオレ", "text": "付近の植生を丸ごと崩壊させるほどの外来種……、\nそんなものが広まれば世界中が混乱してしまいます！", "face": "u392"}, {"name": "ププル", "text": "許せんのぉ……乙女の花園に土足で踏み入り、\n大切に育てた花々を荒らした挙句に悪だくみとは。", "face": "u225"}, {"name": "グレーターデーモン", "text": "ふぅむ、ワシの密かな趣味を邪魔するのかね？\nいいだろう、相手になってあげようじゃないか。", "face": "le28619cfe5d1"}, {"name": "エメルダ", "text": "はぁ……私も付き添いで来てよかった。\nメープル、先にヒマワリの方を止めるよ。\nあれに開花されるとすごく厄介だからね……。", "face": "u717"}, {"name": "メープル", "text": "わかったよお姉ちゃん！\nよーし、まっけないぞぉ！", "face": "u370"}]}, {"trigger": "end", "lines": [{"name": "グレーターデーモン", "text": "むぅ……ワシが丹精込めて育て上げた\n魔界ヒマワリちゃんが全滅するとは……。\n物質界進出の夢は絶たれてしまったようだ。", "face": "le28619cfe5d1"}, {"name": "フィオレ", "text": "……当然です、あんな危険な植物……魔物？\n物質界での栽培なんて認めるわけにはいきません。", "face": "u392"}, {"name": "グレーターデーモン", "text": "良い商品にする自信はあったんだがねぇ。\n今回もまた王子たちに邪魔をされるなんて、\nまったく、ロクでもない因縁があったものだよ。", "face": "le28619cfe5d1"}, {"name": "ププル", "text": "そう言いたいのはこっちの方なんじゃがのぉ。\nお主とて、ほんにどこにでも現れるではないか。", "face": "u225"}, {"name": "グレーターデーモン", "text": "機を見るに敏であるのが商人だからさ、\n金の匂いあるところにはワシは現れるとも。", "face": "le28619cfe5d1"}, {"name": "ププル", "text": "良い根性しとるのぉ……。", "face": "u225"}, {"name": "メープル", "text": "謝って！　ちゃんと謝っておじさん！\nメープルたちのお花さん枯らしちゃったこと謝って！", "face": "u370"}, {"name": "グレーターデーモン", "text": "……これも敗者の務めだ。悪かった、謝罪するよ。\n枯らしてしまった花は後日同じ種を送付させてもらう。\n育てた花を台無しにされる辛さは身を以て体感したからね。", "face": "le28619cfe5d1"}, {"name": "メープル", "text": "むふー！　謝ってくれたならいいよ、許してあげる！", "face": "u370"}, {"name": "エメルダ", "text": "メープルは優しいね、えらいえらい。", "face": "u717"}, {"name": "ププル", "text": "……お主のやり方はあくどいが、\nわしもドルイドの一人として、\nあのヒマワリを育てる大変さは理解できる。", "face": "u225"}, {"name": "ププル", "text": "乗っ取りや買収だのつまらんことは言わず、\nお主も物質界で花を育ててみる気はないか。\nわしも時たま相談に乗ってやらんこともないぞ？", "face": "u225"}, {"name": "グレーターデーモン", "text": "ふん、庭仕事は趣味の範囲に留めておくさ。\n今の生き方を変えるつもりも、野望を捨てる気もない。\nこの世全ての商店をワシの手に置く計画は継続中さ。", "face": "le28619cfe5d1"}, {"name": "グレーターデーモン", "text": "さらばだ、王国の商売敵諸君。\n茶会に水を差してすまなかったね。", "face": "le28619cfe5d1"}]}, {"trigger": "end", "lines": [{"name": "ローリエ", "text": "グレーターデーモン、帰っていきます……。", "face": "u257"}, {"name": "メリーファ", "text": "えっと……予定とは大分違いますけど、\n改めてドルイド会の方を始めましょうかぁ？", "face": "u876"}, {"name": "メープル", "text": "うん♪　それじゃあみんな、\n今日はいーっぱい楽しもうねぇ♪", "face": "u370"}]}], "active": true}