se_hp": 25000, "base_attack": 500, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114288, "race_id": 16, "special_effect_id": 222, "master_id": 30961, "global_id": 4580, "spawn_sec": 130}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 5000, "attack": 600, "base_hp": 5000, "base_attack": 600, "damage_type": "magical", "armor_defense": 700, "magic_defense": 20, "attack_range": 150, "attack_speed": 100, "attack_wait": 60, "attack_interval": 241, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100096, "race_id": 16, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 216, "global_id": 215, "ranged": true, "spawn_sec": 132}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 800, "base_hp": 15000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "attack_range": 250, "attack_speed": 70, "attack_wait": 120, "attack_interval": 349, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101440, "race_id": 16, "special_effect_id": 222, "missile_id": 41, "missile": {"speed": 4.0, "splash": 133}, "master_id": 504, "global_id": 503, "ranged": true, "spawn_sec": 134}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 1000, "base_hp": 13000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_range": 440, "attack_speed": 70, "attack_wait": 120, "attack_interval": 313, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109472, "race_id": 16, "special_effect_id": 222, "missile_id": 192, "missile": {"speed": 4.0, "splash": 144}, "master_id": 30191, "global_id": 3810, "ranged": true, "spawn_sec": 134}], "dialogue": [{"trigger": "start", "lines": [{"name": "サリス", "text": "…………はぁ。", "face": "u605"}, {"name": "メル", "text": "サリスさーん、何か考えごと？", "face": "u199"}, {"name": "サリス", "text": "はい……どうしても、引っかかることがあって……。", "face": "u605"}, {"name": "サリス", "text": "公爵の言葉全てが真実だとは思いません。\nけれど、王が私を裏切ったという、その一言が、\n今も私の中に、不安の種として燻っているのです。", "face": "u605"}, {"name": "カノン", "text": "……もしかして、王子が裏切るかもって心配してる？", "face": "u264"}, {"name": "サリス", "text": "……いいえ……はい。\nそんな事はないと思ってはいるのですが、\n刻みつけられた恐怖心が、消えてくれなくて。", "face": "u605"}, {"name": "フレデリカ", "text": "それなら、試してみればいいのでは？", "face": "u362"}, {"name": "サリス", "text": "……えっ？", "face": "u605"}, {"name": "フレデリカ", "text": "言葉を交わしても心の壁が消えないのなら、\n王子や、他の仲間がどんな人なのか、\n本気でぶつかり合ってみれば良いと思います。", "face": "u362"}, {"name": "サリス", "text": "……確かに、剣を交えれば、\n人となりは分かるというものですが……。\n一国の主が、一介の騎士を相手に模擬戦なんて――", "face": "u605"}, {"name": "カノン", "text": "考えるより、まずは行動よ！\nあっ、ほら、ちょうど良いところに。おーうーじー！", "face": "u264"}, {"name": "サリス", "text": "えっ、あ、あの、カノンさん！？", "face": "u605"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "カノン", "text": "あのね王子、えぇとね……それでね……うん、そう。", "face": "u264"}, {"name": "カノン", "text": "やった！　王子も全力で相手してくれるって！", "face": "u264"}, {"name": "サリス", "text": "王子殿下自ら、模擬戦を……！？", "face": "u605"}, {"name": "サリス", "text": "ふふっ……ふふふっ。\n本当におかしな国ですね、ここは。", "face": "u605"}, {"name": "サリス", "text": "わかりました、それならば、\nこの迷いを断ち切るため、全力でお願いいたします！！", "face": "u605"}]}, {"trigger": "end", "lines": [{"name": "フレデリカ", "text": "いたた……負けちゃいましたが、\nとても良い訓練になりましたね。", "face": "u362"}, {"name": "カノン", "text": "サリスさんみたいな前衛がいるなら、\nもっと大型の砲を使っても良いかな……。", "face": "u264"}, {"name": "メル", "text": "それいいかも！\n後で砲術士会議だね！", "face": "u199"}, {"name": "ジャンナ", "text": "それなら砲弾も、更に改良出来そうですね……。\n守ってくれる人がいると心強いです。", "face": "u154"}, {"name": "サリス", "text": "ふふっ、上手く盾にしてくださいね。\nそのための重装備ですから。", "face": "u605"}, {"name": "サリス", "text": "……こうして剣を交えてみれば、\n悩んでいた時間が嘘みたいですね。", "face": "u605"}, {"name": "サリス", "text": "守られるべき国家の長が、後方ではなく、\n最前線に出てくる国だなんて、\nどう考えてもおかしな国ですけれど……。", "face": "u605"}, {"name": "サリス", "text": "どこまでも真っ直ぐな人柄だけは、\n私の心に、確かに伝わってきました。", "face": "u605"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "サリス", "text": "ふふっ、そんな顔をしないでください。\n一応、褒め言葉なのですから。", "face": "u605"}, {"name": "サリス", "text": "改めて誓いましょう。\n我が身、我が剣を、貴方に捧げると。\nこの身は人を守ることを旨とする、守護騎士なれば！！", "face": "u605"}]}], "active": true}