{"quest_id": 7242, "name": "狙われたチョコレート", "description": "チョコレートが奪われたとの報せを受け、\n調査を進めていたエレットたちに、\n魔界アリの影が忍び寄る……。\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "魅惑のチョコレート・トラップ", "event_category": "History", "mission_id": 920156, "map_no": 5864, "level": 70, "multiplier": 0.7, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 2, "hp": 2100, "attack": 280, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 1, "master_id": 485, "global_id": 484, "to_global_id": 625, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2100, "attack": 280, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "master_id": 626, "global_id": 625}, {"enemy_id": 3, "source": "local", "count": 24, "form_count": 2, "hp": 700, "attack": 210, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 3, "master_id": 986, "global_id": 985, "to_global_id": 987, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 700, "attack": 210, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 2, "master_id": 988, "global_id": 987}, {"enemy_id": 5, "source": "local", "count": 7, "form_count": 1, "hp": 2100, "attack": 154, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118448, "race_id": 18, "special_effect_id": 372, "change_to": 5, "change_condition": 1, "master_id": 31713, "global_id": 5332, "variants": [{"hp": 2100, "attack": 154, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118464, "race_id": 18, "master_id": 31714, "global_id": 5333}], "spawn_sec": 65}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 2, "hp": 700, "attack": 210, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 7, "master_id": 31504, "global_id": 5123, "to_global_id": 5124, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 99}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 700, "attack": 210, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 6, "master_id": 31505, "global_id": 5124}], "popups": ["異界の虫はHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フィリス", "text": "――チョコレート襲撃事件、だって？", "face": "u40"}, {"name": "エレット", "text": "うん、えぇと……この辺りかな。\nチョコレートを運んでいた荷馬車が、\n魔物に襲われたらしいんだよ。", "face": "u1152a1"}, {"name": "フィリス", "text": "最近は商隊の襲撃が\n増えてるからって警備を増やしてたけど、\n狙われた積荷はチョコレートばかりってことか。", "face": "u40"}, {"name": "シャルキー", "text": "むぅぅ、今の時期にチョコを狙うなんて、\n許せない魔物さんですね……！", "face": "u965"}, {"name": "エレット", "text": "そう！　そうなんだよ！\nあたしが取り寄せてた材料も盗まれちゃったし！", "face": "u1152a1"}, {"name": "シャルキー", "text": "えぇぇっ！？\nそれってすごく大変じゃないですか！\nだってもうそろそろバレンタ――", "face": "u965"}, {"name": "エレット", "text": "――わー！　シャルキーちゃん！\n声が大きいよ！　みんなに聞こえちゃうって！", "face": "u1152a1"}, {"name": "シャルキー", "text": "はっ、そうでした！\n当日までは内緒にしないとですよね。", "face": "u965"}, {"name": "エレット", "text": "そういうわけだから、\nなんとしてでも襲撃犯を捕まえて――", "face": "u1152a1"}, {"name": "エイル", "text": "――あ、あの、もしかして襲撃犯って、\nあれだったりしません？", "face": "u804"}, {"name": "シャルキー", "text": "あれ？　あれって……わっ、わー！！\n魔界アリ！　魔界アリが現れましたー！？", "face": "u965"}, {"name": "エレット", "text": "シャルキーちゃん急いで王子を呼んできて！\nあたしはここで、村を防衛してるから！", "face": "u1152a1"}, {"name": "シャルキー", "text": "わ、わかりました！\nエレットさん、気をつけてくださいね！", "face": "u965"}]}, {"trigger": "end", "lines": [{"name": "エレット", "text": "ふぅ、魔界アリ討伐完了！\n……あれ、でもどうしてこんなところに、\n魔界アリが現れたんだろう……？", "face": "u1152a1"}, {"name": "エイル", "text": "むぅ、確かに。\nこれは調査してみる必要がありますね……。", "face": "u804"}, {"name": "リーフ", "text": "あっ、もしかして甘い匂いに\n引き寄せられてきた……とかでしょうか？", "face": "u747"}, {"name": "フィリス", "text": "甘い匂い……つまりチョコレートに引き寄せられたと？", "face": "u40"}, {"name": "エイル", "text": "虫の習性として、ありえない話ではないですね。\n荷馬車の襲撃とも関係があるのかも……。", "face": "u804"}, {"name": "エイル", "text": "ともかく、急いで情報を集めます！\n何だか嫌な予感がしますからね！", "face": "u804"}]}], "active": true}