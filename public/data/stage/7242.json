{"quest_id": 7242, "name": "狙われたチョコレート", "description": "チョコレートが奪われたとの報せを受け、\n調査を進めていたエレットたちに、\n魔界アリの影が忍び寄る……。\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "魅惑のチョコレート・トラップ", "event_category": "History", "mission_id": 920156, "map_no": 5864, "level": 70, "multiplier": 0.7, "charisma": 25, "exp": 150, "gold": 700, "drops": [{"card": 70, "c": 2}, {"card": 55, "c": 1}, {"item": 1005, "c": 1}, {"item": 5002, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 2100, "attack": 280, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 1, "master_id": 485, "global_id": 484, "to_condition": 0, "to_global_id": 625, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2100, "attack": 280, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "master_id": 626, "global_id": 625, "from_condition": 0}, {"enemy_id": 3, "source": "local", "count": 24, "form_index": 0, "form_count": 2, "hp": 700, "attack": 210, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 3, "master_id": 986, "global_id": 985, "to_condition": 0, "to_global_id": 987, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 700, "attack": 210, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 2, "master_id": 988, "global_id": 987, "from_condition": 0}, {"enemy_id": 5, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "hp": 2100, "attack": 154, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118448, "race_id": 18, "special_effect_id": 372, "change_to": 5, "change_condition": 1, "master_id": 31713, "global_id": 5332, "variants": [{"hp": 2100, "attack": 154, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118464, "race_id": 18, "master_id": 31714, "global_id": 5333}], "spawn_sec": 65}, {"enemy_id": 7, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "hp": 700, "attack": 210, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 7, "master_id": 31504, "global_id": 5123, "to_condition": 0, "to_global_id": 5124, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 99}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 700, "attack": 210, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 6, "master_id": 31505, "global_id": 5124, "from_condition": 0}], "popups": ["異界の虫はHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フィリス", "text": "――チョコレート襲撃事件、だって？", "face": "u40"}, {"name": "エレット", "text": "うん、えぇと……この辺りかな。\nチョコレートを運んでいた荷馬車が、\n魔物に襲われたらしいんだよ。", "face": "u1152a1"}, {"name": "フィリス", "text": "最近は商隊の襲撃が\n増えてるからって警備を増やしてたけど、\n狙われた積荷はチョコレートばかりってことか。", "face": "u40"}, {"name": "シャルキー", "text": "むぅぅ、今の時期にチョコを狙うなんて、\n許せない魔物さんですね……！", "face": "u965"}, {"name": "エレット", "text": "そう！　そうなんだよ！\nあたしが取り寄せてた材料も盗まれちゃったし！", "face": "u1152a1"}, {"name": "シャルキー", "text": "えぇぇっ！？\nそれってすごく大変じゃないですか！\nだってもうそろそろバレンタ――", "face": "u965"}, {"name": "エレット", "text": "――わー！　シャルキーちゃん！\n声が大きいよ！　みんなに聞こえちゃうって！", "face": "u1152a1"}, {"name": "シャルキー", "text": "はっ、そうでした！\n当日までは内緒にしないとですよね。", "face": "u965"}, {"name": "エレット", "text": "そういうわけだから、\nなんとしてでも襲撃犯を捕まえて――", "face": "u1152a1"}, {"name": "エイル", "text": "――あ、あの、もしかして襲撃犯って、\nあれだったりしません？", "face": "u804"}, {"name": "シャルキー", "text": "あれ？　あれって……わっ、わー！！\n魔界アリ！　魔界アリが現れましたー！？", "face": "u965"}, {"name": "エレット", "text": "シャルキーちゃん急いで王子を呼んできて！\nあたしはここで、村を防衛してるから！", "face": "u1152a1"}, {"name": "シャルキー", "text": "わ、わかりました！\nエレットさん、気をつけてくださいね！", "face": "u965"}]}, {"trigger": "end", "lines": [{"name": "エレット", "text": "ふぅ、魔界アリ討伐完了！\n……あれ、でもどうしてこんなところに、\n魔界アリが現れたんだろう……？", "face": "u1152a1"}, {"name": "エイル", "text": "むぅ、確かに。\nこれは調査してみる必要がありますね……。", "face": "u804"}, {"name": "リーフ", "text": "あっ、もしかして甘い匂いに\n引き寄せられてきた……とかでしょうか？", "face": "u747"}, {"name": "フィリス", "text": "甘い匂い……つまりチョコレートに引き寄せられたと？", "face": "u40"}, {"name": "エイル", "text": "虫の習性として、ありえない話ではないですね。\n荷馬車の襲撃とも関係があるのかも……。", "face": "u804"}, {"name": "エイル", "text": "ともかく、急いで情報を集めます！\n何だか嫌な予感がしますからね！", "face": "u804"}]}], "map": {"image": "Map920156_5864", "w": 960, "h": 640, "spots": [{"k": "b", "x": 476, "y": 329}, {"k": "m", "x": 251, "y": 177, "id": 200}, {"k": "m", "x": 403, "y": 118, "id": 201}, {"k": "m", "x": 349, "y": 190, "id": 202}, {"k": "m", "x": 336, "y": 279, "id": 203}, {"k": "m", "x": 313, "y": 349, "id": 204}, {"k": "m", "x": 248, "y": 408, "id": 205}, {"k": "m", "x": 353, "y": 417, "id": 206}, {"k": "m", "x": 448, "y": 417, "id": 207}, {"k": "m", "x": 527, "y": 434, "id": 208}, {"k": "m", "x": 617, "y": 463, "id": 209}, {"k": "m", "x": 670, "y": 388, "id": 210}, {"k": "m", "x": 791, "y": 395, "id": 211}, {"k": "m", "x": 652, "y": 322, "id": 212}, {"k": "m", "x": 648, "y": 242, "id": 213}, {"k": "m", "x": 759, "y": 217, "id": 214}, {"k": "m", "x": 654, "y": 167, "id": 215}, {"k": "m", "x": 555, "y": 176, "id": 216}, {"k": "m", "x": 459, "y": 182, "id": 217}, {"k": "r", "x": 181, "y": 234, "id": 300}, {"k": "r", "x": 265, "y": 245, "id": 301}, {"k": "r", "x": 264, "y": 304, "id": 302}, {"k": "r", "x": 213, "y": 349, "id": 303}, {"k": "r", "x": 430, "y": 240, "id": 304}, {"k": "r", "x": 556, "y": 237, "id": 305}, {"k": "r", "x": 509, "y": 125, "id": 306}, {"k": "r", "x": 755, "y": 139, "id": 307}, {"k": "r", "x": 716, "y": 459, "id": 308}, {"k": "r", "x": 709, "y": 263, "id": 309}, {"k": "r", "x": 780, "y": 281, "id": 310}, {"k": "r", "x": 716, "y": 333, "id": 311}, {"k": "r", "x": 790, "y": 343, "id": 312}]}, "start_cost": 10, "active": true}