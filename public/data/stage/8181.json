{"quest_id": 8181, "name": "グルメジャングルの王者", "description": "暴走した魔物を退治する王子一行。それを\n乱獲と勘違いしたグルメジャングルの王者\nが、お供のドラコラプトルと共に襲い来る！\n極級（★１獲得の目安：平均Lv25）", "event": "クロスランペイジ", "event_category": "History", "mission_id": 920211, "map_no": 7131, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 24000, "attack": 1080, "base_hp": 24000, "base_attack": 1080, "damage_type": "physical", "armor_defense": 280, "attack_range": 240, "attack_speed": 70, "attack_wait": 90, "attack_interval": 223, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2150880, "race_id": 16, "special_effect_id": 92, "change_to": 1, "missile_id": 1007, "missile": {"speed": 12.0}, "master_id": 37143, "global_id": 10760, "ranged": true, "to_global_id": 10761, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 24000, "attack": 1350, "base_hp": 24000, "base_attack": 1350, "damage_type": "physical", "armor_defense": 280, "attack_speed": 20, "attack_wait": 40, "attack_interval": 145, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2150864, "race_id": 16, "special_effect_id": 222, "master_id": 37144, "global_id": 10761}, {"enemy_id": 3, "source": "local", "count": 19, "form_count": 2, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123904, "race_id": 2, "special_effect_id": 232, "change_to": 3, "change_condition": 4, "missile_id": 476, "master_id": 32700, "global_id": 6318, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6319, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 87, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123920, "race_id": 2, "master_id": 32701, "global_id": 6319, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 5, "source": "local", "count": 19, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098160, "master_id": 92, "global_id": 91, "spawn_sec": 58}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 2, "hp": 18000, "base_hp": 18000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 76, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137648, "race_id": 2, "special_effect_id": 232, "change_to": 6, "change_condition": 4, "missile_id": 476, "master_id": 34986, "global_id": 8603, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 8604, "spawn_sec": 118}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137664, "race_id": 2, "master_id": 34987, "global_id": 8604, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "hp": 160000, "attack": 500, "base_hp": 160000, "base_attack": 500, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 30, "attack_interval": 161, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123808, "race_id": 2, "special_effect_id": 1665, "change_to": 8, "change_condition": 4, "missile_id": 476, "master_id": 37166, "global_id": 10783, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 10784, "spawn_sec": 160}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 160000, "attack": 1800, "base_hp": 160000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 187, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2123824, "race_id": 2, "special_effect_id": 508, "master_id": 37167, "global_id": 10784, "from_condition": 4, "trigger_ticks": 1}], "popups": ["ドラコラプトルは味方ユニットを\n発見すると、咆哮を行います。\n咆哮後、移動速度が上昇します。", "ドラコトプスは味方ユニットを\n発見すると、咆哮を行います。\n咆哮後、移動速度が上昇します。", "ドラコレックスは味方ユニットを\n発見すると、咆哮を行います。\n咆哮を受けた味方ユニットは\n麻痺状態になります。\n\nまた、咆哮後\n移動速度が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ジークリンデ", "text": "──斬っても斬っても魔物が湧いてくる。\n大漁だな、さすがにこれではキリが無いぞ。", "face": "u429"}, {"name": "シャジャル", "text": "この島であれば食うに困ることはないのだろうね。\n砂漠に住まう民としては少し羨ましく思ってしまう。", "face": "u1769a1"}, {"name": "ユッタ", "text": "できるだけ綺麗に仕留めてくださいねー！\nグルメジャングルの魔物は高級食材なんでー！", "face": "u1228a1"}, {"name": "ジンレイ", "text": "了解、美味しいご飯のために頑張ろっかぁ。", "face": "u2065a1"}, {"name": "レギーナ", "text": "──いや、待ってくれ。このままでは拙い。", "face": "u405"}, {"name": "メーア", "text": "あれ、急にどうしたんですか？\n今日のご飯は山盛り確定だってのに、\nそんな深刻そうな顔をしちゃって。", "face": "u796"}, {"name": "レギーナ", "text": "今のグルメジャングルは明らかに異常だ。\nこれ以上の狩猟は生態系の乱れにも繋がる。\nそれを前にして『彼』が黙ってるはずがない。", "face": "u405"}, {"name": "メーア", "text": "だれさんです？", "face": "u796"}, {"name": "レギーナ", "text": "幼い頃に島に捨てられ、大猿に育てられた野人。\nドラコラプトルを従えしグルメジャングルの王者。", "face": "u405"}, {"name": "レギーナ", "text": "その名も──", "face": "u405"}, {"name": "メーア", "text": "──どぅあああああああっ！？", "face": "u796"}, {"name": "ユッタ", "text": "メーアがドラコラプトルに\n吹っ飛ばされちゃいましたー！？", "face": "u1228a1"}]}, {"trigger": "start", "lines": [{"name": "レギーナ", "text": "くそっ、遅かったか……！", "face": "u405"}, {"name": "アナトリア", "text": "あれがグルメジャングルの王者かい。\n鍛え上げられた良い筋肉をしてるねぇ。", "face": "u522"}, {"name": "レギーナ", "text": "彼は魔物の乱獲に怒っているんだ。\n可能ならば話し合いで解決をしたい。", "face": "u405"}, {"name": "レギーナ", "text": "くれぐれも決着は穏便に頼むぞ！", "face": "u405"}, {"name": "デューオ", "text": "アイアイ！　任せてっとー！", "face": "u594"}]}, {"trigger": "end", "lines": [{"name": "ジークリンデ", "text": "……なんとか無事に帰ってもらえたな。", "face": "u429"}, {"name": "レギーナ", "text": "彼は狩猟文化そのものを否定しているわけではない。\n肉食動物が他の動物を食べるのは自然の摂理だからだ。", "face": "u405"}, {"name": "レギーナ", "text": "こちらに乱獲の意図が無いと分かってもらえたのさ。", "face": "u405"}, {"name": "ユッタ", "text": "そうですねぇ、食材はもう十分に集まってますし……。", "face": "u1228a1"}, {"name": "レギーナ", "text": "悪いが、これからは殺さず気絶させる程度に留めてくれ。", "face": "u405"}, {"name": "ジンレイ", "text": "元はと言えば魔物の暴走が原因なんだけど、\nまあ難しいことを気軽に言ってくれるよねぇ。", "face": "u2065a1"}, {"name": "ジークリンデ", "text": "ああ、再三に渡る魔物の襲撃で、\n戦神コロッセウムの参加者たちも、\n少し疲弊してるように見受けられる。", "face": "u429"}, {"name": "ローリエ", "text": "でも、その暴走がそもそも怪しいんですよね。\n何と言いますか、誰かの作為を感じるような……。", "face": "u257"}, {"name": "レギーナ", "text": "そう、彼も同じことを疑っていた。\n戦神コロッセウムの参加者の中の誰かが、\n故意に魔物を暴走させているのではないかと。", "face": "u405"}, {"name": "シャジャル", "text": "バトルロイヤルを優位に進めるための策略ってことかい？", "face": "u1769a1"}, {"name": "ジークリンデ", "text": "今の時点ではまだ何とも言えないな。\n予選を勝ち抜けば、真実は自ずと判明するだろう。", "face": "u429"}, {"name": "ジークリンデ", "text": "島の生態系を乱すのは我らとしても本意ではない。\n今後は可能な限り無益な殺生は控える方向で行こう。", "face": "u429"}]}, {"trigger": "end", "lines": [{"name": "カウリオ", "text": "……これで良いんだよな、参謀。", "face": "u2081a1"}, {"name": "参謀", "text": "ええ、問題ありません船長。\nこのまま進めばコロッセウムの優勝、\n延いては戦神の加護はあなたのものです。", "face": "l7d1ac18367ee"}, {"name": "参謀", "text": "さすれば、もう誰もあなたを馬鹿にはできない。\nあなたの母君もきっと迎えに来てくれるはずです。", "face": "l7d1ac18367ee"}, {"name": "参謀", "text": "さあ、あと少し頑張りましょう。", "face": "l7d1ac18367ee"}, {"name": "カウリオ", "text": "……うん、そうだよな。", "face": "u2081a1"}]}], "active": true}