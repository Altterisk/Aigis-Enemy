ssassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119392, "race_id": 7, "change_to": 6, "missile_id": 45, "master_id": 31870, "global_id": 5489, "ranged": true, "to_global_id": 5491, "spawn_sec": 82}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 30, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119424, "race_id": 7, "change_to": 4, "missile_id": 45, "master_id": 31872, "global_id": 5491, "to_global_id": 575}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104832, "race_id": 7, "change_to": 3, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 576, "global_id": 575, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 576}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "人魚の大使", "text": "――海底までの道のりですが、\n泳いで進むとすごーく時間がかかる上に、\nいくつも危険な場所を通ることになります。", "face": "u1118a1"}, {"name": "人魚の大使", "text": "そこで、ここからさらに沖合の島の近くを流れる、\n海底まで一気に流れ込む海流を利用して、\n皆さんを海の底までご案内しますね♪", "face": "u1118a1"}, {"name": "ローザ", "text": "なるほど……海底への道のようなものですね。", "face": "u1040a1"}, {"name": "人魚の大使", "text": "道！　地上にあるという、\n平らな地面のことですね！", "face": "u1118a1"}, {"name": "人魚の大使", "text": "うぅぅ、地上って歩いてみたかったんですよね……。\nせっかく人に変身する魔法も覚えたのに、\nクラールフ様が地上には行くなって厳しくて……。", "face": "u1118a1"}, {"name": "ローザ", "text": "あら、そうなのですか？\nそれでは今回の事件が無事に終わったら、\n私が地上をご案内しましょう。", "face": "u1040a1"}, {"name": "人魚の大使", "text": "本当ですか！？\nふふふっ、やりました！　地上デビューです！", "face": "u1118a1"}, {"name": "ローザ", "text": "まずは深海で起きている事件を\n解決する方が先ですけどね。", "face": "u1040a1"}, {"name": "レオナ", "text": "さて、そろそろ物資の補給も終わる頃合いだ。\n島に出ている者を船に呼び戻して――", "face": "u1027a1"}, {"name": "メーア", "text": "――て、敵襲！　敵襲です！！\n魚人が現れましたぁー！！", "face": "u1038a1"}, {"name": "レオナ", "text": "何！？　連中、船を狙う気か？", "face": "u1027a1"}, {"name": "ローザ", "text": "船が無くては沖に出られません。\nここは私が支えますので、\n急いで防備を固めてください！"}, {"name": "レオナ", "text": "よし、この地点は任せたぞ、ローザ。\n王子、ローザは一時的に貴様の指揮下に入る。\n指示は任せたぞ。", "face": "u1027a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "王子、先程のソードギルマンも\n敵の中に混じっているようです。\n慎重な指揮をお願いします！！", "face": "ld56c815f1cd5"}]}, {"trigger": "end", "lines": [{"name": "ローザ", "text": "魚人の部隊、撤退していきます。\nお疲れさまです、王子。", "face": "u1040a1"}, {"name": "人魚の大使", "text": "何だか、嫌な感じの攻め方でしたね……。\n散発的じゃなくて、\n何というのか私たちを狙っているというか……。", "face": "u1118a1"}, {"name": "ディアナ", "text": "……その予測は当たっているかと。\n部隊の編成の仕方が、\n明確に軍事的な色をにじませていたので。", "face": "u1034a1"}, {"name": "ローザ", "text": "もしや、クラールフ殿が我々に救援を求めることに、\n彼らも気付いているのでは？", "face": "u1040a1"}, {"name": "人魚の大使", "text": "ありえるかもしれません……。\nあちらには天使がついているわけですから。", "face": "u1118a1"}, {"name": "アウローラ", "text": "海底のことも地上のことも、\nあちらには筒抜けというわけですね。", "face": "u1035a1"}, {"name": "ローザ", "text": "それなら、敵の妨害部隊が\n揃うより早く動く必要があります。\n陛下、王子、迅速に目的の島に向かいましょう。", "face": "u1040a1"}]}], "active": true}