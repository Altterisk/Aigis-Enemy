"assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "spawn_sec": 105}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104832, "race_id": 7, "change_to": 6, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 576, "global_id": 575, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 576, "spawn_sec": 106}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 1750, "attack": 250, "base_hp": 1750, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 87, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123776, "race_id": 7, "missile_id": 45, "master_id": 32692, "global_id": 6310, "ranged": true, "spawn_sec": 113}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 15, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123728, "race_id": 7, "special_effect_id": 229, "missile_id": 232, "master_id": 32689, "global_id": 6307, "ranged": true, "spawn_sec": 141}], "dialogue": [{"trigger": "start", "lines": [{"name": "スカー", "text": "――シャァァァァァァック！！\n大・正・解・だァ！！\n人間の王子ィ、今度は水中で喧嘩と行こうぜェ！！", "face": "u1396a1"}, {"name": "ローザ", "text": "スカー……！\nもう追いついてきたんですか！？", "face": "u1040a1"}, {"name": "スカー", "text": "アァン？　オレサマの方が\n速く泳げるに決まってんだろうがッ！！", "face": "u1396a1"}, {"name": "スカー", "text": "さぁ喧嘩だ喧嘩！！\n王子ィ、ぶん殴りあおうぜェ！！", "face": "u1396a1"}, {"name": "スカーの部下", "text": "（……ちっ、これだからギルマンは）\n――スカー様、あなたの役割は\nクラールフの神殿への強襲だったはずですが。", "face": "l25a1785c88ad"}, {"name": "スカー", "text": "……あのクソ天使サマの\n言うことなんざ聞かなくていいんだよ。\nテメェらは天使か、魚人か、どっちなんだ！！", "face": "u1396a1"}, {"name": "スカーの部下", "text": "今はギガエル様率いる魚人軍の兵士です。\nスカー様、それをわきまえてください。", "face": "l25a1785c88ad"}, {"name": "スカー", "text": "魚人の戦士のくせに、飼いならされやがって……。\nおい王子！　神殿を潰したら戻ってくるからな！", "face": "u1396a1"}, {"name": "ローザ", "text": "くっ……待ちなさい、スカー！\n王子、スカーの後を追いましょう！", "face": "u1040a1"}, {"name": "人魚の大使", "text": "だ、だめですローザさん！\nこの先には居住地があるんです。\nここの敵を置いてはいけませんよぉ！", "face": "u1118a1"}, {"name": "レオナ", "text": "何、たとえ海中だろうと、\n私たちのすることは変わらないさ。", "face": "u1027a1"}, {"name": "ディアナ", "text": "迅速に敵を鎮圧し、その後全速力で進軍ですね。\n王国も帝国も、地上で転戦には慣れていますから。", "face": "u1034a1"}, {"name": "フレイ", "text": "王子、あっちにはソードギルマンがいるよ。\n地上とは違って本来の力を発揮してくるはずだから、\n絶対に油断しないように気をつけてね！", "face": "u1025a1"}]}, {"trigger": "end", "lines": [{"name": "リーゼロッテ", "text": "王子、魚人部隊の鎮圧完了だ。\nスカーは神殿の方に向かったみたいだな。", "face": "u1026a1"}, {"name": "ジークリンデ", "text": "存外歯ごたえのない連中だったが、\nやはり本隊はあちらということか。", "face": "u1024a1"}, {"name": "エリアス", "text": "練度が低いとは言っても、\nまだ新手がこちらへ向かってきています。\n数で押されてはキリがありませんよ。", "face": "u1039a1"}, {"name": "衛兵マーマン", "text": "……この地点の防衛は、我らが引き継ごう。\n王子、どうかクラールフ様を助けてほしい。", "face": "l25a1785c88ad"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ローザ", "text": "それでは大使さん、\n神殿への案内をお願いできますか？", "face": "u1040a1"}, {"name": "人魚の大使", "text": "もちろんです！\nこっちです、ついてきてください！！", "face": "u1118a1"}]}], "active": true}