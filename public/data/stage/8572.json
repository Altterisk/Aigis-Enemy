"master_id": 30704, "global_id": 4323, "spawn_sec": 96}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 1, "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112640, "master_id": 30705, "global_id": 4324, "spawn_sec": 125}, {"enemy_id": 5, "source": "local", "count": 19, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112832, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30726, "global_id": 4345, "ranged": true, "spawn_sec": 150}, {"enemy_id": 6, "source": "local", "count": 10, "form_count": 1, "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "attack_range": 160, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142800, "race_id": 16, "change_to": 6, "change_condition": 1, "missile_id": 26, "master_id": 35837, "global_id": 9454, "ranged": true, "variants": [{"hp": 4000, "attack": 450, "base_hp": 4000, "base_attack": 450, "damage_type": "physical", "armor_defense": 250, "attack_speed": 70, "attack_wait": 60, "attack_interval": 231, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142816, "race_id": 16, "master_id": 35838, "global_id": 9455}], "spawn_sec": 170}, {"enemy_id": 8, "source": "local", "count": 16, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142784, "race_id": 16, "missile_id": 831, "missile": {"speed": 4.0, "splash": 133}, "master_id": 35836, "global_id": 9453, "ranged": true, "spawn_sec": 175}, {"enemy_id": 9, "source": "local", "count": 12, "form_count": 1, "hp": 6500, "attack": 750, "base_hp": 6500, "base_attack": 750, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112656, "master_id": 30724, "global_id": 4343, "spawn_sec": 193}, {"enemy_id": 10, "source": "local", "count": 10, "form_count": 1, "hp": 8500, "base_hp": 8500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116848, "special_effect_id": 1281, "master_id": 35958, "global_id": 9575, "spawn_sec": 205}, {"enemy_id": 11, "source": "local", "count": 12, "form_count": 1, "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112848, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30727, "global_id": 4346, "ranged": true, "spawn_sec": 232}], "popups": ["\n\n\n　――オリュンポス第二層「崑崙」", "伏綺がいる間、\n一定時間が経過するたびに\n配置された味方ユニット二体に\n物理の遠距離範囲攻撃を行います。", "扇道士の一定範囲内のユニットは\n攻撃力、防御力の低下と\n割合の継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――オリュンポス第二層「崑崙」"}, {"name": "徐華", "text": "おぉ、来たか。\nちゃんと誅子たちも連れてきたようじゃな。", "face": "u1896a1"}, {"name": "ジンレイ", "text": "この雰囲気は……お説教と見た。", "face": "u2065a1"}, {"name": "誅子", "text": "この誅子、ここ最近は世直しの旅もしているし、\n華の国の民の声にも耳を傾けているし、\nかなりの真面目路線だと思っているのだが……。", "face": "u2018a1"}, {"name": "ジンレイ", "text": "いやいや、年上というのは理不尽なもので――", "face": "u2065a1"}, {"name": "ロウユ", "text": "何か言ったか？", "face": "u2381a1"}, {"name": "ジンレイ", "text": "いえいえ何でも。", "face": "u2065a1"}, {"name": "徐華", "text": "儂のこと、なんだと思っとるんじゃ……。", "face": "u1896a1"}, {"name": "イコル", "text": "戦場のど真ん中にぼくを投擲した、\n勢いで生きている徐華娘々、\nといったところじゃないか？", "face": "u1988a1"}, {"name": "徐華", "text": "まぁ否定はせんが。\n――さて、では始めるとしようか。", "face": "u1896a1"}, {"name": "誅子", "text": "いや、せめて何を始めるのか説明を――", "face": "u2018a1"}, {"name": "徐華", "text": "こんな話を知っておるか。", "face": "u1896a1"}, {"name": "徐華", "text": "千年戦争の折、華の国の大地は酷く傷ついた。\nその大地はおよそ、幾万年は不毛の地となるほどに。", "face": "u1896a1"}, {"name": "誅子", "text": "……華の国は、見事に復興したはずだが。", "face": "u2018a1"}, {"name": "徐華", "text": "然り。では何者が、\n大地の傷を癒やし続けたのか。", "face": "u1896a1"}, {"name": "徐華", "text": "そう、誰も知らぬはずじゃ。", "face": "u1896a1"}, {"name": "徐華", "text": "その者は、己を大地と同化させ、\n概念となって華の国を癒やし続けた。", "face": "u1896a1"}, {"name": "徐華", "text": "神でもなく、人でもなく、仙人でもなく、\n大地そのものとなった彼女の名は、\nすべての者の記憶から消え去ったのじゃ。", "face": "u1896a1"}, {"name": "徐華", "text": "お主らを喚んだのは、彼女と縁深き者たちゆえ。", "face": "u1896a1"}, {"name": "徐華", "text": "華の国が王、誅子。", "face": "u1896a1"}, {"name": "誅子", "text": "…………。", "face": "u2018a1"}, {"name": "徐華", "text": "華の国が強者、ロウユ、ジンレイ。", "face": "u1896a1"}, {"name": "ロウユ", "text": "…………。", "face": "u2381a1"}, {"name": "ジンレイ", "text": "…………。", "face": "u2065a1"}, {"name": "徐華", "text": "そして英雄王の後継者、王子。", "face": "u1896a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "徐華", "text": "ここに縁は再び結ばれた。\n彼女を――我が姉、伏綺を呼び起こさん。", "face": "u1896a1"}, {"name": "徐華", "text": "王子よ、お主こそが最後の鍵じゃ。\n概念として荒ぶる伏綺を鎮め、\n現世に再び、我が姉を連れ戻してくれ。", "face": "u1896a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "徐華", "text": "さぁゆくぞ、戻ってこい、伏綺ちゃん！！", "face": "u1896a1"}]}, {"trigger": "end", "lines": [{"name": "イコル", "text": "――どうやら、成功したみたいだね。", "face": "u1988a1"}, {"name": "伏綺", "text": "…………じょ、か？", "face": "u2224a1"}, {"name": "徐華", "text": "おぉ、おぉ！　伏綺ちゃん！\n儂が分かるか！？\nお主の妹じゃ、世界一かわいい徐華ちゃんじゃ！", "face": "u1896a1"}, {"name": "伏綺", "text": "えぇ……今日も、かわいい……。\nわたしの、いもうと……。", "face": "u2224a1"}, {"name": "徐華", "text": "うっ、うぅぅぅぅ。\nお主らぁ、ありがとう……ありがとうなのじゃ……。", "face": "u1896a1"}, {"name": "ロウユ", "text": "姉妹の再会か……。\n千年ぶりとは、涙もひとしおだろうなぁ。", "face": "u2381a1"}, {"name": "ジンレイ", "text": "まぁ、先に思いっきり戦闘になるって\n教えてほしかったけどね。", "face": "u2065a1"}, {"name": "誅子", "text": "終わりよければ、だ。\nそれにしても、華の国が最大の恩人を、\nまさか国の民すべてが忘れていたとは……。", "face": "u2018a1"}, {"name": "王子", "text": "…………（にこにこ）", "face": "u1"}, {"name": "ジンレイ", "text": "ん、そういえば……。\nイコルは何のためにここへ？", "face": "u2065a1"}, {"name": "イコル", "text": "…………見学。", "face": "u1988a1"}, {"name": "ジンレイ", "text": "またまたぁ。", "face": "u2065a1"}, {"name": "イコル", "text": "徐華に借りを返しただけだよ。\nそれじゃあ、ぼくは用事があるから。", "face": "u1988a1"}, {"name": "徐華", "text": "あやつも素直じゃないのう……。", "face": "u1896a1"}, {"name": "徐華", "text": "儂に借りがあるからと、伏綺ちゃんの復活計画を、\nあれこれずーっと考えてくれておったのに。", "face": "u1896a1"}, {"name": "イコル", "text": "うるさい！　聞こえてるぞ！", "face": "u1988a1"}, {"name": "徐華", "text": "やれやれ、謀略の亜神も型なしじゃなぁ♪", "face": "u1896a1"}]}], "active": true}