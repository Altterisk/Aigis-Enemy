{"quest_id": 7082, "name": "天界の住人", "description": "門を抜けた先、物質界と天界の境目で\n王子一行を待ち受けるものとは……？\n\n神級（★１獲得の目安：平均Lv25）", "event": "ゴールドラッシュ27(2020)", "event_category": "Reproduce", "mission_id": 300277, "map_no": 4025, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["鳥"], "hp": 20000, "base_hp": 20000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "attack_interval": 31, "move_speed": 3000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123360, "race_id": 12, "special_effect_id": 549, "change_to": 1, "missile_id": 45, "master_id": 32630, "global_id": 6248, "ranged": true, "to_global_id": 6247, "spawn_sec": 28}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 20000, "base_hp": 20000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 3, "attack_interval": 38, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123344, "race_id": 12, "special_effect_id": 551, "missile_id": 45, "master_id": 32629, "global_id": 6247}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["鳥"], "hp": 25000, "base_hp": 25000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "move_speed": 3000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123424, "race_id": 12, "special_effect_id": 550, "change_to": 3, "missile_id": 45, "master_id": 32634, "global_id": 6252, "ranged": true, "to_global_id": 6251, "spawn_sec": 28}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 25000, "base_hp": 25000, "damage_type": "physical"