val": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114192, "race_id": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30948, "global_id": 4567, "ranged": true, "spawn_sec": 98}, {"enemy_id": 9, "source": "local", "count": 10, "form_count": 1, "tags": ["鳥"], "hp": 3200, "attack": 300, "base_hp": 3200, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_range": 130, "attack_speed": 1, "attack_wait": 3, "attack_interval": 49, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123008, "race_id": 12, "special_effect_id": 234, "missile_id": 474, "missile": {"speed": 10.0}, "master_id": 32635, "global_id": 6253, "ranged": true, "spawn_sec": 119}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107568, "race_id": 6, "master_id": 872, "global_id": 871, "spawn_sec": 130}, {"enemy_id": 11, "source": "local", "count": 9, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109312, "race_id": 6, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30176, "global_id": 3795, "ranged": true, "spawn_sec": 154}, {"enemy_id": 12, "source": "local", "count": 11, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107600, "race_id": 6, "master_id": 879, "global_id": 878, "spawn_sec": 182}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "hp": 20000, "attack": 300, "base_hp": 20000, "base_attack": 300, "damage_type": "magical", "armor_defense": 500, "magic_defense": 50, "attack_range": 180, "attack_speed": 20, "attack_wait": 110, "attack_interval": 281, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110096, "race_id": 6, "special_effect_id": 138, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30317, "global_id": 3936, "ranged": true, "spawn_sec": 220}], "popups": ["\n\n\n　　　――天界の入り口", "天界では、時間経過によって\n雲の足場が出現する\nことがあります。\n\n出現した雲の足場には、\n遠距離ユニットを\n配置できるようになります。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――天界の入り口"}, {"name": "モーティマ", "text": "ちくしょう、\nいったいコイツはどうなってやがるんだ？", "face": "u14"}, {"name": "ソーマ", "text": "道がぱったり途中で止まっているように見えます。\nその先は……うーん、\nどうして見えないんでしょうか。", "face": "u23"}, {"name": "フォニア", "text": "やはり天界の障壁は健在だったようですね……。\nこれは神性を帯びていない者を通さない、\n天界を守護する不可視の障壁なのです。", "face": "u548"}, {"name": "アンナ", "text": "ここを超えなければ、天界で何が起きているのか\n知ることもできないということですか……。", "face": "l1a77501fe7ea"}, {"name": "アトナテス", "text": "どうにかここを突破するしかないだろ。\nおっと、そういえば、\nオーガスタはどうやってここを超えたんだ？", "face": "u908"}, {"name": "オーガスタ", "text": "えぇと、私の時にはケラウノス様が、\n神の楔の奇跡で、私に神性を付与してくれたんです。\nそれで自由に障壁を超えられるようになって……。", "face": "u960"}, {"name": "アトナテス", "text": "ここでも神の楔が重要ってことか……。\n天界に知り合いがいないことはないが、\nあいつは神の楔なんて便利なもの持ってなかったしなぁ。", "face": "u908"}, {"name": "ソラス", "text": "ああ、あの子たちのことですね。\n千年戦争以来、音信不通ですからね……。", "face": "u904"}, {"name": "サナラ", "text": "ともあれ、調査してみるしかなさそうですね。\nまずはあちらに見える神殿に行ってみましょう！", "face": "u921"}, {"name": "ユージェン", "text": "――いや、ちょっと待て。\n何だこの風切り音……天使とは違うような……。\n王子、向こうから何かが飛んでくるぞ！", "face": "u906"}]}, {"trigger": "battle", "at_sec": 29, "lines": [{"name": "鷲翼の鳥人", "text": "……まさか、物質界から\n天界の門を超えて来る者がいるとは。", "face": "lf829f6b48c35"}, {"name": "白翼の鳥人", "text": "もしかして、天使たちが話してた\nガリウスを倒した英雄って、\nあの人たちのことなんじゃないかな？", "face": "l70909c04848e"}, {"name": "鷲翼の鳥人", "text": "しっ……声が大きい。\n天使連中に聞かれたらどうするつもりだ。\n今は従っているフリをしておけ。", "face": "lf829f6b48c35"}, {"name": "白翼の鳥人", "text": "う、うんっ！\n――あっ、天使……様たちが来たよ！", "face": "l70909c04848e"}, {"name": "天使", "text": "鳥人たち、お手柄ですよ。\n王子たちの居場所を発見するとは。", "face": "l8068500efeb1"}, {"name": "天使", "text": "さぁ、今こそあなた方の忠誠心を示す時です。\n障壁が破られるとは思いませんが、\n憂いは残したくありません。王子たちを抹殺しなさい。", "face": "l8068500efeb1"}, {"name": "鷲翼の鳥人", "text": "……はっ。仰せのままに。", "face": "lf829f6b48c35"}]}, {"trigger": "end", "lines": [{"name": "天使", "text": "……なるほど、想定以上の戦力です。\nこれは報告を上げておいた方が良さそうですね。", "face": "l8068500efeb1"}, {"name": "鷲翼の鳥人", "text": "……しんがりは我らにお任せを。\n障壁よりこちらへ来ることは無いでしょうが、\n可能な限り戦力を削っておきます。", "face": "lf829f6b48c35"}, {"name": "天使", "text": "良い心がけです。\nそれでは任せましたよ。", "face": "l8068500efeb1"}, {"name": "アンナ", "text": "……天使の軍勢、撤退していきます。", "face": "l11d67a4b7fc6"}, {"name": "鷲翼の鳥人", "text": "…………行ったか。\n――貴殿が、ガリウスを倒したという\n物質界の英雄に相違ないか？", "face": "lf829f6b48c35"}, {"name": "王子", "text": "…………？\n…………（こくり）", "face": "u1"}, {"name": "白翼の鳥人", "text": "わっ！　やった！　本当に英雄さんだよ！\nあのね、あのねっ、\nその障壁を超えるには――へぴっ！？", "face": "l70909c04848e"}, {"name": "鷲翼の鳥人", "text": "こら、声が大きいと言っただろう。\n――して、英雄殿、おそらく\nその障壁に困っているところなのではないか？", "face": "lf829f6b48c35"}, {"name": "鷲翼の鳥人", "text": "神性の付与された者しか、\nこの障壁を超えることはできない。\nそして神性の付与には、神の楔が必要だ。", "face": "lf829f6b48c35"}, {"name": "ソラス", "text": "……ですが、アイギス様も、\nアダマス様も、ケラウノス様も、\n今は力を失っています。いったいどうすれば……。", "face": "u904"}, {"name": "鷲翼の鳥人", "text": "物質界には、かつて神であり、今は力を奪われ\n『亜神』に堕ちた御方がいるはずだ。\nかの御方なら、神の楔をまだ持っているかもしれない。", "face": "lf829f6b48c35"}, {"name": "アリサ", "text": "物質界に、アイギス様たち以外の神さまが……？", "face": "u24"}, {"name": "鷲翼の鳥人", "text": "神ではなく『亜神』だ。\n神の楔を新たに作る権能を剥奪されているからな。\n確か、今は海底に国を作っていると聞いた覚えが――", "face": "lf829f6b48c35"}, {"name": "トゥアン", "text": "――海底に、国……？\n待てよ……それってまさか、クラールフのことか？", "face": "u1006a1"}, {"name": "白翼の鳥人", "text": "おぉぉ～！　やったよ！　もう知り合いみたいだよ！\nこれなら、すぐこっちに来てくれるかも！", "face": "l70909c04848e"}, {"name": "鷲翼の鳥人", "text": "……そうだな。\n英雄殿、手を貸せなくてすまないが、\n少しでもこの情報が助けになれば嬉しい。", "face": "lf829f6b48c35"}, {"name": "サナラ", "text": "……あの、何故私たちに、こんな助言を？\n先程は襲撃してきたというのに……。", "face": "u921"}, {"name": "鷲翼の鳥人", "text": "こちらにも事情がある、ということだ。\nだが、我々は少なくとも、貴殿らの味方だ。", "face": "lf829f6b48c35"}, {"name": "鷲翼の鳥人", "text": "どうかガリウスを討ったその力で、\n天界を救ってほしい。\n――再会の時を、心待ちにしている。", "face": "lf829f6b48c35"}, {"name": "白翼の鳥人", "text": "それじゃあね！　また会おうね！\nばいばい、英雄さま！", "face": "l70909c04848e"}]}], "active": true}