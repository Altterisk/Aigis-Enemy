transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "spawn_sec": 48}, {"enemy_id": 5, "source": "local", "count": 8, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 180, "magic_defense": 5, "attack_speed": 60, "attack_wait": 10, "attack_interval": 119, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2163232, "change_to": 5, "change_condition": 1, "master_id": 39091, "global_id": 12708, "variants": [{"tags": ["ステルス"], "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 180, "magic_defense": 5, "attack_range": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 59, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2163232, "missile_id": 483, "missile": {"on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 39092, "global_id": 12709, "ranged": true}], "spawn_sec": 58}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 1, "hp": 6000, "attack": 820, "base_hp": 6000, "base_attack": 820, "damage_type": "physical", "armor_defense": 220, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 205, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101248, "master_id": 227, "global_id": 226, "spawn_sec": 72}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 60, "attack_speed": 10, "attack_wait": 35, "attack_interval": 91, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2162320, "race_id": 11, "special_effect_id": 229, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38997, "global_id": 12614, "ranged": true, "spawn_sec": 119}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 8000, "attack": 330, "base_hp": 8000, "base_attack": 330, "damage_type": "magical", "armor_defense": 80, "attack_range": 200, "attack_speed": 30, "attack_wait": 70, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2171536, "missile_id": 1651, "missile": {"speed": 12.0}, "master_id": 40850, "ranged": true, "spawn_sec": 153}], "popups": ["　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇"], "dialogue": [{"trigger": "start", "lines": [{"name": "ケイティ", "text": "──それで、具体的に何をするんですか？", "face": "u2433a1"}, {"name": "アンナ", "text": "今のユキヒメさんたちはアイドルとしてまったくの素人。\nそこで各地で他の候補者たちとの野良オーディションを通じ、\nトップアイドルを目指すのに必要な力を養ってもらいます。", "face": "l64a5139bfbf0"}, {"name": "ユキヒメ", "text": "野良オーディション？"}, {"name": "アージェ", "text": "ライブラリーに存在しない単語です。"}, {"name": "アンナ", "text": "アイドル版の模擬戦です。"}, {"name": "アルタ", "text": "完璧に把握しました。"}, {"name": "ポミエ", "text": "嫌な理解の仕方だ……。", "face": "u2828a1"}, {"name": "アンナ", "text": "最初の相手はリノさんです。", "face": "l55d022a50766"}, {"name": "リノ", "text": "はーい、リノだよー♪", "face": "u1683a1"}, {"name": "アンナ", "text": "炎のアイドル召喚士リノと言えば、\nあのエス★エフと共に一世を風靡した、\n情熱系アイドルの先駆け的存在──", "face": "l64a5139bfbf0"}, {"name": "アンナ", "text": "トップアイドルとはどういう存在なのか、\nそれを肌で感じることができるでしょう。", "face": "l55d022a50766"}, {"name": "ユキヒメ", "text": "（アイドルの、頂点……）"}, {"name": "リノ", "text": "まずは習うより慣れろってね、いっくよー！", "face": "u1683a1"}, {"name": "リノ", "text": "ミュージック、スタート♪", "face": "u1683a1"}]}, {"trigger": "end", "lines": [{"name": "リノ", "text": "よーし、こんなところかな♪", "face": "u1683a1"}, {"name": "アージェ", "text": "これが、時代を築いたアイドルのライブ……！"}, {"name": "ユキヒメ", "text": "（すごい……！）"}, {"name": "アンナ", "text": "初めての野良オーディションはどうでしたか？"}, {"name": "ラタトスク", "text": "吾輩たちの完敗じゃな、見事と言う他なかろうて。\n正直、背中が遠すぎて何から始めればよいのやら……。"}, {"name": "リノ", "text": "うーん、みんなはアイドルに必要な技能って何だと思う？", "face": "u1683a1"}, {"name": "ユキヒメ", "text": "歌、とか……？"}, {"name": "アルタ", "text": "ダンスでしょうか。"}, {"name": "キュウビ", "text": "顔よな。"}, {"name": "リノ", "text": "そう、ボーカルとダンスとビジュアル。", "face": "u1683a1"}, {"name": "リノ", "text": "三組ともそのままで人気は出ると思うよ。\nでも、トップアイドルになれるかは分からない。", "face": "u1683a1"}, {"name": "リノ", "text": "ユキヒメちゃんはボーカルに。\nアージェ★アルタはダンスに。", "face": "u1683a1"}, {"name": "リノ", "text": "ラタ★キュウビはビジュアルに弱点がある。", "face": "u1683a1"}, {"name": "キュウビ", "text": "ぬ、わらわたちの美貌にケチを付ける気か？"}, {"name": "アルタ", "text": "我々のダンスに何か瑕疵がありましたか？"}, {"name": "リノ", "text": "んーん、そういうことじゃないよ。\n歌もダンスも上手だったし、みんな可愛かった。", "face": "u1683a1"}, {"name": "リノ", "text": "でもね、それだけなんだ。", "face": "u1683a1"}, {"name": "ユキヒメ", "text": "………………。"}, {"name": "リノ", "text": "だから、戦っておいで。", "face": "u1683a1"}, {"name": "リノ", "text": "世界を巡りながらライブでファンを増やして、\n野良オーディションでライバルと鎬を削って──", "face": "u1683a1"}, {"name": "リノ", "text": "そうして、自分たちに何が足りなかったのかを知るの。", "face": "u1683a1"}, {"name": "リノ", "text": "次は本当のステージで会おうね？", "face": "u1683a1"}]}]}