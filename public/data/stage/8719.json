st": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 9, "master_id": 39232, "global_id": 12849, "to_global_id": 10897}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["帝国"], "hp": 180000, "attack": 1500, "base_hp": 180000, "base_attack": 1500, "damage_type": "true", "armor_defense": 1200, "magic_defense": 20, "attack_range": 300, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 100, "pattern_id": 2151648, "race_id": 16, "special_effect_id": 222, "missile_id": 1024, "missile": {"speed": 10.0, "splash": 67}, "master_id": 37280, "global_id": 10897, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 66, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 179}, {"enemy_id": 12, "source": "local", "count": 18, "form_count": 1, "tags": ["帝国", "女性"], "hp": 2000, "attack": 500, "base_hp": 2000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_range": 40, "attack_speed": 80, "attack_wait": 30, "attack_interval": 91, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102496, "race_id": 16, "special_effect_id": 229, "missile_id": 45, "master_id": 335, "global_id": 334, "ranged": true, "spawn_sec": 226}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "spawn_sec": 288}], "popups": ["レオラがいる間は、\n全ての敵ユニットの\n攻撃と防御がアップします。", "カルラは一定確率で\n物理攻撃を回避します。", "ギョウブは\n特定のタイミングで\n変身します。", "ベネーは\n攻撃を複数回行うと\n攻撃性能が変化します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オルドネッタ", "text": "――おつかれさまでーす。\nオルドネッタ、物資の補給に参りました！", "face": "u2602a1"}, {"name": "ルーテ", "text": "お疲れ様です、オルドネッタさん。\nこの戦闘訓練が終わったら、\n全員で手分けして倉庫に搬入しましょうか。", "face": "u529"}, {"name": "オルドネッタ", "text": "わぁ、助かります！\n荷馬車でざっと数十台分ですからね！\nひとりで運び込もうとしたら三日はかかるところでした！", "face": "u2602a1"}, {"name": "オルドネッタ", "text": "ところで――\nハイドースとの戦いも終わったというのに、\nどうしてこんな、念入りに戦闘訓練を？", "face": "u2602a1"}, {"name": "？？？", "text": "それは簡単な話やねぇ。\n平和いうんは次の戦争の準備期間だけんね。", "face": "u2599a1"}, {"name": "？？？", "text": "少々言葉選びが物騒ではありますが、\n紛れもない事実ですわね。", "face": "u2603a1"}, {"name": "オルドネッタ", "text": "じゅんびきかん……？\nんん……？", "face": "u2602a1"}, {"name": "レオナ", "text": "……まだ戦いは続く、ということだ。\n訓練ご苦労だったな、ギョウブ、カルラ。\n兵たちの士気はどうだ？", "face": "u2600a1"}, {"name": "ギョウブ", "text": "どうにも気が抜けとるモンが多いなぁ。\nここらでひとつ、引き締めておかんと。", "face": "u2599a1"}, {"name": "カルラ", "text": "大きな戦いを乗り越えた以上、\n気が緩んでしまうのは致し方ないことではありますが。", "face": "u2603a1"}, {"name": "オルドネッタ", "text": "えっと……もしかして、\nまた大きな戦いが……？", "face": "u2602a1"}, {"name": "レオラ", "text": "そのとおり♪\nなんて言うと驚かせちゃうわね。", "face": "u2601a1"}, {"name": "レオラ", "text": "ハイドースとの戦いは一区切りついたけれど、\n倒しました、はい平和！　とはいかないのが、\n国、民族、種族、そして誇りの問題なのよねぇ。", "face": "u2601a1"}, {"name": "レオナ", "text": "此度、こうして大規模な戦闘訓練を実行したのは、\n今後帝国が直面する数々の試練に対応するためだ。", "face": "u2600a1"}, {"name": "レオナ", "text": "帝国を解体することなく継続し、\nなおかつ、平和を可能な限り維持するためには、\n避けては通れない問題が山積みだろう？", "face": "u2600a1"}, {"name": "オルドネッタ", "text": "あっ……あー……。\nそうですねー……。\nでも、あのー、なんというかー。", "face": "u2602a1"}, {"name": "？？？", "text": "ウチに気を使わなくて大丈夫だよ？", "face": "u2604a1"}, {"name": "オルドネッタ", "text": "わわわ、ベネーさん。\nごめんなさい、そういう意味でうろたえてたわけでは！", "face": "u2602a1"}, {"name": "レオナ", "text": "現在の帝国には、多数の種族が存在している。\n彼らとの対話なくして、帝国の未来はない。", "face": "u2600a1"}, {"name": "レオラ", "text": "だから、兵にはここでもう一度、\n気を引き締めてもらわないとね。", "face": "u2601a1"}, {"name": "レオナ", "text": "そういうわけだ。\n――では、次の戦闘訓練を始めるぞ！", "face": "u2600a1"}]}, {"trigger": "end", "lines": [{"name": "白の皇帝", "text": "……士気は落ちていないようだな。", "face": "u418"}, {"name": "レオナ", "text": "はっ！\n全軍、如何なる事態にも備えは万全です。", "face": "u2600a1"}, {"name": "白の皇帝", "text": "……ああ。", "face": "u418"}, {"name": "レオナ", "text": "陛下……？", "face": "u2600a1"}, {"name": "白の皇帝", "text": "いや、そろそろだと思ってな。", "face": "u418"}, {"name": "白の皇帝", "text": "奴が決起するのであれば、今しかあるまい。", "face": "u418"}, {"name": "ドワイト", "text": "――陛下！　緊急事態です！\nベラート伯爵領より、大規模な軍勢が出立！\n帝都へ向かっている模様！", "face": "u348"}, {"name": "白の皇帝", "text": "……やはりな。", "face": "u418"}, {"name": "白の皇帝", "text": "奴の決着の付け方、見届けてやろう。", "face": "u418"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 19, "params": [150]}, {"kind": "term", "influence": 18, "params": [110]}], "enemies": [{"enemy_id": 1, "hp": 98800, "attack": 1450, "damage_type": "magical", "armor_defense": 300, "magic_defense": 15, "pattern_id": 2164496}, {"enemy_id": 1, "form_index": 1, "hp": 98800, "attack": 2750, "damage_type": "magical", "armor_defense": 300, "magic_defense": 15, "pattern_id": 2164512}, {"enemy_id": 5, "hp": 122200, "attack": 2340, "damage_type": "physical", "armor_defense": 650, "magic_defense": 10, "pattern_id": 2164464}, {"enemy_id": 6, "hp": 118300, "attack": 2050, "damage_type": "physical", "armor_defense": 550, "magic_defense": 10, "pattern_id": 2164480}, {"enemy_id": 7, "hp": 85800, "attack": 1200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "pattern_id": 2164528}, {"enemy_id": 7, "form_index": 1, "hp": 234000, "attack": 650, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "pattern_id": 2127184}, {"enemy_id": 7, "fo