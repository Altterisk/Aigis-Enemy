cal", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108304, "race_id": 3, "master_id": 30018, "global_id": 3637, "spawn_sec": 160}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 1200, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 182}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 24000, "attack": 900, "base_hp": 40000, "base_attack": 900, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 190, "attack_speed": 50, "attack_wait": 10, "attack_interval": 86, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103488, "race_id": 3, "special_effect_id": 232, "change_to": 12, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 449, "global_id": 448, "ranged": true, "variants": [{"hp": 24000, "attack": 1320, "base_hp": 40000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 70, "attack_speed": 50, "attack_wait": 30, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103504, "race_id": 3, "master_id": 450, "global_id": 449}], "spawn_sec": 227}, {"enemy_id": 14, "source": "local", "count": 6, "form_count": 1, "hp": 9000, "attack": 600, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 254}], "popups": ["発光するマスに配置した\nユニットは射程が\n上昇します。", "魔神レラジェは、\n傷ついた周囲の敵を\n自身の攻撃力の値で\n回復します。\n\nレラジェの第一形態は\n味方ユニットへの\n攻撃を行いません。"], "dialogue": [{"trigger": "battle", "at_sec": 29, "lines": [{"name": "デーモンシェフ", "text": "――おぉ、あれに見えるは王国軍。\nやはり来てくれたか！", "face": "l94d739bdf183"}, {"name": "ハルモニア", "text": "デーモンシェフ、\nあなたもこの計画に関わっていたのですね。", "face": "u941"}, {"name": "デーモンシェフ", "text": "うむ、我がデモシェフ商会の社員も、\n何人かが魔界への帰還を望んでいるのだ。\nどうか、彼らの悲願に力を貸してやってほしい。", "face": "l94d739bdf183"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ソシエ", "text": "あれが件の廃砦ね。\n……狙撃にはぴったりかも。", "face": "u486"}, {"name": "レライエ", "text": "あ、あの……地形はしっかりと\n下見しておいてくださいね。\nレラジェさまは、全力の戦いをお望みなので……。", "face": "u1355a1"}, {"name": "ランヒルド", "text": "軍と軍の戦いを望んでるってことだったものね。\nそれなら、一切遠慮する必要はなさそうね！", "face": "u1311a1"}, {"name": "キホル", "text": "まぁ王子じゃレラジェさまには敵わないだろうけどね！\nで、でも……ちょっとだけ、応援してやってもいいわよ。", "face": "u1159a1"}, {"name": "レライエ", "text": "キホルさん、それは全力で\n応援してますって言ってるようなものですよ……？", "face": "u1355a1"}, {"name": "キホル", "text": "な、なによ！\nレライエだってレラジェさまに\n手加減をお願いしてたじゃない！", "face": "u1159a1"}, {"name": "レライエ", "text": "お願いしたのは事実ですけど！　そうしたら、\n武人相手に手加減は失礼なことですよって……。", "face": "u1355a1"}, {"name": "フィロ", "text": "あはは……レラジェさまは、\n王子さまと似ている方なのかもしれませんね。\n全力をお望みならば、こちらも全力を尽くしましょう！", "face": "u883"}, {"name": "レライエ", "text": "それでは、私は召喚に集中しますね。\n王子殿下、後のことはおまかせします……。", "face": "u1355a1"}]}], "active": true}