00, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 254}], "popups": ["発光するマスに配置した\nユニットは射程が\n上昇します。", "魔神レラジェは、\n傷ついた周囲の敵を\n自身の攻撃力の値で\n回復します。\n\nレラジェの第一形態は\n味方ユニットへの\n攻撃を行いません。"], "dialogue": [{"trigger": "battle", "at_sec": 29, "lines": [{"name": "デーモンシェフ", "text": "――おぉ、あれに見えるは王国軍。\nやはり来てくれたか！", "face": "l94d739bdf183"}, {"name": "ハルモニア", "text": "デーモンシェフ、\nあなたもこの計画に関わっていたのですね。", "face": "u941"}, {"name": "デーモンシェフ", "text": "うむ、我がデモシェフ商会の社員も、\n何人かが魔界への帰還を望んでいるのだ。\nどうか、彼らの悲願に力を貸してやってほしい。", "face": "l94d739bdf183"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ソシエ", "text": "あれが件の廃砦ね。\n……狙撃にはぴったりかも。", "face": "u486"}, {"name": "レライエ", "text": "あ、あの……地形はしっかりと\n下見しておいてくださいね。\nレラジェさまは、全力の戦いをお望みなので……。", "face": "u1355a1"}, {"name": "ランヒルド", "text": "軍と軍の戦いを望んでるってことだったものね。\nそれなら、一切遠慮する必要はなさそうね！", "face": "u1311a1"}, {"name": "キホル", "text": "まぁ王子じゃレラジェさまには敵わないだろうけどね！\nで、でも……ちょっとだけ、応援してやってもいいわよ。", "face": "u1159a1"}, {"name": "レライエ", "text": "キホルさん、それは全力で\n応援してますって言ってるようなものですよ……？", "face": "u1355a1"}, {"name": "キホル", "text": "な、なによ！\nレライエだってレラジェさまに\n手加減をお願いしてたじゃない！", "face": "u1159a1"}, {"name": "レライエ", "text": "お願いしたのは事実ですけど！　そうしたら、\n武人相手に手加減は失礼なことですよって……。", "face": "u1355a1"}, {"name": "フィロ", "text": "あはは……レラジェさまは、\n王子さまと似ている方なのかもしれませんね。\n全力をお望みならば、こちらも全力を尽くしましょう！", "face": "u883"}, {"name": "レライエ", "text": "それでは、私は召喚に集中しますね。\n王子殿下、後のことはおまかせします……。", "face": "u1355a1"}]}], "map": {"image": "Map5041", "w": 960, "h": 640, "spots": [{"k": "b", "x": 177, "y": 180}, {"k": "b", "x": 156, "y": 470}, {"k": "m", "x": 470, "y": 415, "id": 200}, {"k": "m", "x": 244, "y": 220, "id": 201}, {"k": "m", "x": 350, "y": 180, "id": 202}, {"k": "m", "x": 434, "y": 131, "id": 203}, {"k": "m", "x": 520, "y":