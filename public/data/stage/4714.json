, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 80000, "attack": 3500, "base_hp": 80000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 20, "attack_speed": 50, "attack_wait": 20, "attack_interval": 221, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2105680, "special_effect_id": 86, "master_id": 901, "global_id": 900, "from_condition": 2}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 350, "base_hp": 9000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 147, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106240, "race_id": 16, "master_id": 793, "global_id": 792, "spawn_sec": 186}], "dialogue": [{"trigger": "start", "lines": [{"name": "メレディス", "text": "王子、こっちです。\nあの黒い鎧の奴が王子を出せと暴れているんです。\n……あ。いました！　あそこです！", "face": "u400"}, {"name": "デシウス", "text": "王子！　隠れていないで出て来い！\n魔法都市内にいることは解っているぞ！", "face": "l74311a88c92e"}, {"name": "アンナ", "text": "本当ですね……。\nデシウスはあれからずっと、\n魔法都市に居たのでしょうか……？", "face": "la84c39fa5a9d"}, {"name": "デシウス", "text": "ようやく姿を現したな、忌々しい王子軍よ！\nよくも我輩の暗黒騎士団を崩壊させてくれたな！", "face": "l74311a88c92e"}, {"name": "メレディス", "text": "聞いた話だと、軍団が崩壊したのは、\n禁忌を破ってまで力を求めた結果でしょ？\nただの自業自得じゃないですか。", "face": "u400"}, {"name": "デシウス", "text": "我輩はもっともっと強くなる必要があるのだ！\n……そうだ、強くなければ……いけないのだーッ！", "face": "l74311a88c92e"}, {"name": "モーティマ", "text": "なんなんだあいつは、あんなに叫んじまって……。\n何回も俺達に戦いを挑んできて負けてるのに、\n諦めが悪い奴だな……。", "face": "u14"}, {"name": "アンナ", "text": "もしかしたら、何か作戦があるのかもしれません。\n王子、お気を付けください。", "face": "la84c39fa5a9d"}]}, {"trigger": "end", "lines": [{"name": "デシウス", "text": "分が悪いか……。\nこうなったら……。", "face": "l74311a88c92e"}, {"name": "デシウス", "text": "我輩は転送魔法陣で逃げる！\n覚えていろよ！　忌々しい王子！", "face": "l74311a88c92e"}, {"name": "メレディス", "text": "あっ！　こら！\n壊した魔法都市を修復していきなさいよ！", "face": "u400"}, {"name": "アンナ", "text": "王子、またデシウスが現れるようになりましたね。\n今後も襲ってくる可能性があります。\n引き続き、警戒致しましょう。", "face": "la84c39fa5a9d"}]}], "active": true}