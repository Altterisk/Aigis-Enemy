 "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 89}, {"enemy_id": 9, "source": "local", "count": 9, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 155}, {"enemy_id": 10, "source": "local", "count": 5, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108304, "race_id": 3, "master_id": 30018, "global_id": 3637, "spawn_sec": 159}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 10, "attack_interval": 76, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100224, "race_id": 3, "change_to": 5, "change_condition": 4, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 233, "global_id": 232, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 231, "spawn_sec": 179}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 221}], "popups": ["\n\n\n　　　　――数日前。", "デモンポーンは倒されると、\nその場で復活します。\n2回まで復活し、\n復活するたびに強くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンシェフ", "text": "――ついに、資金が底をついたか。\nやはりチョコレート工場を失ったのが痛手だったな……。", "face": "l250e6aa32dd0"}, {"name": "デモンポーン", "text": "チョコのかさ増しなんてしようとするからだよぅ……。\nで、でも次の事業の計画はあるんでしょ！？", "face": "u997"}, {"name": "デーモンシェフ", "text": "事業を起こすにも資金がいるのだ。\nつまり金を稼ぐための仕事を、始めるための金がないのだ！", "face": "l250e6aa32dd0"}, {"name": "デーモンシェフ", "text": "あの頃は良かった……。\nおもちゃを作り、チョコを作り、楽しい日々だった……。", "face": "l250e6aa32dd0"}, {"name": "デモンポーン", "text": "あ、諦めちゃだめだよ！\n諦めずに手を伸ばし続けるのが大事って\nよわよわ――そ、その辺りを歩いてた人が言ってたし！", "face": "u997"}, {"name": "デーモンシェフ", "text": "諦めない……か……。\nそうだな、諦めない、良い響きだ……。", "face": "l250e6aa32dd0"}, {"name": "デーモンシェフ", "text": "よし、もう一度ゼロから何を出来るか考えるぞ！！", "face": "l250e6aa32dd0"}, {"name": "副デーモンシェフ", "text": "――ふふっ、やはりあなたは本物だ。\n本物の経営者です、あなたは。\nきっと再起すると思って仕入れておきましたよ！", "face": "l49a785747b76"}, {"name": "デーモンシェフ", "text": "仕入れ……？\nこ、この赤い宝石の欠片はいったい！？", "face": "l250e6aa32dd0"}, {"name": "副デーモンシェフ", "text": "廃工場を襲撃してきたゴブリンが持っていた物です。\n失敗作らしくすぐに割れてしまいましたが、\n並々ならぬ力を感じませんか。", "face": "l49a785747b76"}, {"name": "デーモンシェフ", "text": "うむ！　この欠片は売れる、売れるぞ！！\nまずは実地試験だな！！", "face": "l250e6aa32dd0"}, {"name": "副デーモンシェフ", "text": "幸い、すぐ近くに王子達が遠征に来ています。\n欠片の効果を試す絶好の機会かと！", "face": "l49a785747b76"}, {"name": "デーモンシェフ", "text": "よし、ではお前はデーモン達の指揮をとれ！\n我々はこの欠片の力を観測するぞ！", "face": "l250e6aa32dd0"}, {"name": "デモンポーン", "text": "えっ、えぇぇっ！？\nよわよわ王子たちと……戦う……。\nうぅん、これもお仕事！　頑張らなきゃ！", "face": "u997"}]}, {"trigger": "end", "lines": [{"name": "デーモンシェフ", "text": "くっ……倒されてしまったか……。\nこれ程の力を持つ欠片でも、\n万能ではないということだな。", "face": "l250e6aa32dd0"}, {"name": "デーモンシェフ", "text": "しかし、良い励みとなった。\nどれだけ高い能力を持っていても、\n失敗することがあると、石が証明してくれた。", "face": "l250e6aa32dd0"}, {"name": "デーモンシェフ", "text": "もう少しだけ、自分の商才というものを信じて、\n新たなビジネスに挑むとしよう！", "face": "l250e6aa32dd0"}, {"name": "副デーモンシェフ", "text": "おぉ……どこまでもお供します！\nきっと物質界最大の企業となることでしょう！", "face": "l49a785747b76"}, {"name": "デーモンシェフ", "text": "そのためにも、情報収集がかかせないな。\nよし、お前はこの石を作っただろう研究者の、\n工房へ潜入調査に向かうのだ。", "face": "l250e6aa32dd0"}, {"name": "デモンポーン", "text": "せんにゅーちょーさ？", "face": "u997"}, {"name": "デーモンシェフ", "text": "うむ、部下として働きながら、\nこの石の実態を調べるのだ！", "face": "l250e6aa32dd0"}, {"name": "デモンポーン", "text": "ふむふむ……研究のお手伝いかぁ、楽しそうかも！\nそれじゃあいってきまーす♪", "face": "u997"}, {"name": "デーモンシェフ", "text": "さぁ、我らは事業計画の練り直しだ！\nゆくぞ副デーモンシェフよ！", "face": "l250e6aa32dd0"}, {"name": "副デーモンシェフ", "text": "はっ！　お供します……！！", "face": "l49a785747b76"}]}], "active": true}