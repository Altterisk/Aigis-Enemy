"physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "master_id": 24, "global_id": 23, "spawn_sec": 156}, {"enemy_id": 11, "source": "local", "count": 27, "form_index": 0, "form_count": 1, "hp": 1400, "attack": 210, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 190, "attack_interval": 442, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115088, "race_id": 11, "master_id": 31082, "global_id": 4701, "spawn_sec": 235}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 21000, "attack": 1200, "base_hp": 30000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 600, "magic_defense": 50, "attack_range": 180, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104368, "race_id": 13, "change_to": 18, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 594, "global_id": 593, "ranged": true, "variants": [{"hp": 21000, "attack": 1260, "base_hp": 30000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104384, "race_id": 13, "master_id": 595, "global_id": 594}], "spawn_sec": 276}], "dialogue": [{"trigger": "end", "lines": [{"name": "アンナ", "text": "――神獣ナンディ、進軍を停止しました！", "face": "l616b59afdfd8"}, {"name": "アマンダ", "text": "ナンディの身体が崩壊していくよ！\nやったぁ！　神獣ナンディ、討伐成功だよー！", "face": "u271"}, {"name": "ラテリア", "text": "ふぅ、何とかなったね……。\nここで食い止められてよかったよ。", "face": "u532"}, {"name": "フィスティア", "text": "ん……あれ？\nナンディの残骸から何か出てきたよ？", "face": "u792"}, {"name": "ラテリア", "text": "あれは……斧……？\nナンディに刺さってたのかな。", "face": "u532"}, {"name": "アマンダ", "text": "昔ナンディと戦った、\n名も知れぬ戦士の斧ってところかな？\nあんなデカブツに挑むなんてやるじゃん♪", "face": "u271"}, {"name": "ラテリア", "text": "それを言うなら王子もだよ。\n一瞬の迷いもなく、ここに駆けつけたんだからね。", "face": "u532"}, {"name": "パレス", "text": "あっ……この斧、\nナンディの魔力を帯びているみたいです。\nそれに周囲の、ナンディがまとっていた鎧も。", "face": "u129"}, {"name": "ヴァレリー", "text": "魔力を帯びた武器に、神獣の鎧か……。\n何かに使えるかもしれないね。", "face": "u12"}, {"name": "フィスティア", "text": "そういうことなら鍛冶師の出番だね！\n斧は手直しすれば王子が使えそうなサイズだし――", "face": "u792"}, {"name": "キャラット", "text": "ナンディの鎧のかけらも、\nこれを元に人間が着られる鎧が作れるかも！", "face": "u593"}, {"name": "フィスティア", "text": "よーし！　急いで工房に運び込もう！\n急げ急げー！", "face": "u792"}, {"name": "キャラット", "text": "あっ、ま、待ってー！\n鎧の破片集めてからにしてー！", "face": "u593"}, {"name": "ラテリア", "text": "……ふふっ。", "face": "u532"}, {"name": "アマンダ", "text": "ん、どうしたのラテリア？\nなんだか面白い顔してるけど。", "face": "u271"}, {"name": "ラテリア", "text": "いや、ちょっと思い出してたのさ。\n神獣ナンディはもともと、神の遣わした\n恵みをもたらす存在だったって伝説を、さ。", "face": "u532"}, {"name": "ラテリア", "text": "さぁ王子、僕らもナンディの\n鎧のかけらを拾いに行こうか。\n恵みの白牛のご利益があるかもしれないよ。", "face": "u532"}]}], "map": {"image": "Map9260", "w": 960, "h": 640, "spots": [{"k": "b", "x": 27, "y": 312}, {"k": "m", "x": 122, "y": 238, "id": 200}, {"k": "m", "x": 216, "y": 193, "id": 201}, {"k": "m", "x": 316, "y": 141, "id": 202}, {"k": "m", "x": 440, "y": 165, "id": 203}, {"k": "m", "x": 570, "y": 164, "id": 204}, {"k": "m", "x": 657, "y": 99, "id": 205}, {"k": "m", "x": 679, "y": 197, "id": 206}, {"k": "m", "x": 738, "y": 255, "id": 207}, {"k": "m", "x": 854, "y": 255, "id": 208}, {"k": "m", "x": 122, "y": 351, "id": 209}, {"k": "m", "x": 259, "y": 357, "id": 210}, {"k": "m", "x": 382, "y": 368, "id": 211}, {"k": "m", "x": 496, "y": 386, "id": 212}, {"k": "m", "x": 565, "y": 467, "id": 213}, {"k": "m", "x": 618, "y": 372, "id": 214}, {"k": "m", "x": 728, "y": 368, "id": 