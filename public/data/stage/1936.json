{"quest_id": 1936, "name": "亜神ポセイオスの憤怒", "description": "海上を目指す王子一行に亜神ポセイオスが\n迫りくる。絶体絶命の危機に全力で抗え！\n＜深海(弱)：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海(弱)：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション11", "event_category": "Story", "mission_id": 100011, "map_no": 1156, "level": 100, "multiplier": 1.0, "charisma": 58, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 6, 30], "ext": "攻撃待ち増加=30,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 120, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "change_to": 1, "change_condition": 4, "missile_id": 710, "master_id": 34857, "global_id": 8474, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 8475}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 160, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "change_to": 2, "change_condition": 4, "missile_id": 710, "master_id": 34858, "global_id": 8475, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 8476}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 6, "tags": ["水棲"], "hp": 500000, "attack": 7000, "base_hp": 500000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2000, "mag