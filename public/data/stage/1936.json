e": {"slow": [99, 0]}, "master_id": 32626, "global_id": 6244, "ranged": true, "spawn_sec": 142}, {"enemy_id": 17, "source": "local", "count": 20, "form_count": 1, "tags": ["水棲", "ブロック不可", "狙う", "水中"], "hp": 14000, "attack": 1000, "base_hp": 14000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_range": 220, "attack_speed": 1, "attack_wait": 60, "attack_interval": 163, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2153392, "missile_id": 1080, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 200, "attack_interval_f": 200, "effect_name": "HitEffectSlow"}}, "master_id": 37561, "global_id": 11178, "ranged": true, "spawn_sec": 176}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 15000, "attack": 800, "base_hp": 15000, "base_attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 250, "attack_speed": 1, "attack_wait": 50, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124416, "race_id": 7, "special_effect_id": 220, "missile_id": 480, "missile": {"speed": 3.0}, "master_id": 32768, "global_id": 6386, "ranged": true, "spawn_sec": 259}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 2, "tags": ["水棲", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 500000, "attack": 1, "base_hp": 500000, "base_attack": 1, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 40, "attack_wait": 54, "attack_interval": 242, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2136560, "race_id": 19, "special_effect_id": 1020, "change_to": 19, "master_id": 37790, "global_id": 11407, "to_global_id": 11409, "route_behaviour": {"transforms": [{"wait": 100}]}, "spawn_sec": 380}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 500000, "attack": 1, "base_hp": 500000, "base_attack": 1, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 70, "attack_wait": 54, "attack_interval": 229, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2154624, "race_id": 19, "special_effect_id": 1786, "master_id": 37792, "global_id": 11409}, {"enemy_id": 22, "source": "local", "count": 1, "form_count": 2, "tags": ["水中", "ジーラトス", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 450000, "attack": 1, "base_hp": 450000, "base_attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "attack_interval": 69, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2154976, "race_id": 19, "special_effect_id": 799, "change_to": 22, "master_id": 37793, "global_id": 11410, "to_global_id": 11411, "route_behaviour": {"transforms": [{"wait": 250}]}, "spawn_sec": 380}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水中", "ジーラトス", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 450000, "attack": 1, "base_hp": 450000, "base_attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "attack_interval": 69, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2154720, "race_id": 19, "master_id": 37794, "global_id": 11411}], "dialogue": [{"trigger": "start", "lines": [{"name": "ポセイオス", "text": "――王子よ、今一度問おう。\n我が配下に加わるのだ。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "さすれば、全ての大地を海に沈めはしない。\n深海の民のしもべとして、\n溺れる地の民の命も保証してやろう。", "face": "l7d6479df1740"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ポセイオス", "text": "グワッハッハッハ！　強情な男よ。\nだからこそ欲しい……全ての海も！\nこの世界も！　あらゆるものを我が手に！！", "face": "l7d6479df1740"}, {"name": "メシナ", "text": "お父さま！　どうして……今までどおり、\n海と陸は共存してはいけませんの！？", "face": "u1506a1"}, {"name": "ポセイオス", "text": "共存……？\n我が娘にしては、ずいぶんとヌルい言葉だのう……。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "ディアスの博愛に毒されたか？\nハイドースの感傷に影響されたか？\nあるいはそこの王子に惚れでもしたか？", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "戦争こそが生命の本質。\n千年戦争から立ち直った人類が文明を再興し、\n戦乱の時代を生きた人類が、今の栄光を手にした！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "奪い合い、殺し合ってこそ、\n初めて世界は光り輝くのだ！！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "クラールフの大馬鹿者は、\nその辺りが分かっておらなんだ。\nゆえにガリウスなどに頭を垂れたのだろう。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "全ての海の民よ、このポセイオスが、\nかつてない繁栄の時を約束しようぞ！！\nこの戦いの果てにこそ、海洋の未来は訪れる！！", "face": "l7d6479df1740"}, {"name": "メシナ", "text": "……お父さま。", "face": "u1506a1"}, {"name": "アンナ", "text": "王子、ポセイオスが来ます！\n迎撃の指揮をお願いします！", "face": "lb760d417b733"}]}, {"trigger": "battle", "at_sec": 380, "lines": [{"name": "ポセイオス", "text": "グワッハッハッハ！！\nそうだ、戦え！　深海の民に試練を与えよ！！", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "我らもまた、溺れる地の民に死の試練を与えよう！！", "face": "l7d6479df1740"}, {"name": "デューオ", "text": "……大丈夫、あと少しだよ王子。\n上を見て。あの影は――アタシの船と、王国海軍旗艦！！", "face": "u594"}, {"name": "リーンベル", "text": "海面が近い……！！\n上に出てしまえば、こちらのものだ！", "face": "u268"}, {"name": "ポセイオス", "text": "――ほう。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "ならば、そう、だなぁ。\nこちらも本来の姿を見せてやらねば。", "face": "l7d6479df1740"}, {"name": "メシナ", "text": "……何を言っていますの？\nお父さまは、昔から今のお姿なのでは……。", "face": "u1506a1"}, {"name": "ポセイオス", "text": "メシナ、お前には見せたことがなかったのう。\nさぁ我が半身を封じし器よ、ここへ参れ。", "face": "l7d6479df1740"}]}, {"trigger": "end", "lines": [{"name": "ジーラトス", "text": "……ぅ……ぐぁ……ヌゥゥ……。", "face": "l4d4fc97b8b55"}, {"name": "アメリ", "text": "ジーラトス……？\nいったい何を……。", "face": "u368"}, {"name": "ポセイオス", "text": "クラールフめが、この身に施したのは呪い。\n我が憤怒をふたつに引き裂き、\nあろうことか、醜き荒神の身などに封じおったのだ。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "貴様がこやつを倒したおかげで、\nようやく封印に綻びが生じた。", "face": "l7d6479df1740"}, {"name": "ポセイオス", "text": "溺れる地の民ごとき、枷ある今の身で十分だと思ったが、\n貴様らが望むのであれば見せてやるとしよう。", "face": "l7d6479df1740"}, {"name": "ジーラトス", "text": "や、やめろォ……それがしの、それがしの力は、\n海の民を守る……正義の……ッ！！", "face": "l4d4fc97b8b55"}, {"name": "ポセイオス", "text": "否！　ジーラトス、貴様に眠る我が欠片とは、\n破壊を望み、滅びをもたらす憤怒そのものよ！！", "face": "l7d6479df1740"}]}, {"trigger": "end", "lines": [{"name": "ジーラトス", "text": "アッ、あぁぁぁッ！！　ヌゥゥゥゥゥゥンッ！！", "face": "l4d4fc97b8b55"}, {"name": "メシナ", "text": "ジーラトス！！", "face": "u1506a1"}, {"name": "デューオ", "text": "――海面に出る！　全員何かに掴まって！！", "face": "u594"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 6, 30], "ext": "攻撃待ち増加=30,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}, {"kind": "term", "influence": 18, "params": [150]}], "enemies": [{"enemy_id": 1, "hp": 600000, "attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2136560}, {"enemy_id": 1, "form_index": 1, "hp": 600000, "attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2136560}, {"enemy_id": 1, "form_index": 2, "hp": 600000, "attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2136560}, {"enemy_id": 1, "form_index": 3, "hp": 600000, "attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2136560}, {"enemy_id": 1, "form_index": 4, "hp": 600000, "attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2136560}, {"enemy_id": 1, "form_index": 5, "hp": 600000, "attack": 7000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2136560}, {"enemy_id": 7, "hp": 26400, "attack": 2000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 15, "pattern_id": 2154736}, {"enemy_id": 8, "hp": 33600, "attack": 2400, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 15, "pattern_id": 2153408}, {"enemy_id": 9, "hp": 7200, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 9, "form_index": 1, "h