k_speed": 50, "attack_wait": 50, "attack_interval": 135, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 2.5999999046325684, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 474, "missile_id": 6, "master_id": 32310, "global_id": 5929, "ranged": true, "spawn_sec": 13}, {"enemy_id": 8, "source": "local", "count": 15, "form_index": 0, "form_count": 1, "tags": ["バレンタイン"], "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 600, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121312, "race_id": 3, "master_id": 32293, "global_id": 5912, "spawn_sec": 68}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 5500, "attack": 300, "base_hp": 5500, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "attack_range": 180, "attack_speed": 30, "attack_wait": 50, "attack_interval": 173, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112976, "race_id": 16, "missile_id": 6, "master_id": 30771, "global_id": 4390, "ranged": true, "spawn_sec": 115}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108544, "race_id": 16, "special_effect_id": 54, "master_id": 30038, "global_id": 3657, "spawn_sec": 142}], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンシェフ", "text": "まさかチョコが本格的に流通し始める前に、\nあの工場が操業停止になってしまうとはな……。", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "はっ……残念でなりません……。\nですが次なる事業では、きっと莫大な稼ぎを――", "face": "l32f8983f4959"}, {"name": "デーモンシェフ", "text": "――駄目、なのだ。\n我々には元手となる資金が足りないのだ……！！", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "おぉ……なんという……。\nそれでは従業員も路頭に迷ってしまいます！", "face": "l32f8983f4959"}, {"name": "デーモンシェフ", "text": "ふふん、そこで良い考えがあるのだ。\n我々には膨大なチョコの在庫がある。\nこれを巨大化させて販売すれば……？", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "おぉ、おぉ！　素晴らしい！！\n何も知らぬ消費者が、水増しされたチョコを！！", "face": "l32f8983f4959"}]}, {"trigger": "start", "lines": [{"name": "アイリーン", "text": "――なるほどなるほど。\n酷い悪巧みもあったものですね。", "face": "u315"}, {"name": "シャルキー", "text": "王子様ー！　こっちですー！！\nデーモンシェフを発見しましたー！！", "face": "u965"}, {"name": "デーモンシェフ", "text": "くっ、このままでは王国軍の本隊が来てしまう！\n副デーモンシェフよ、急ぎチョコを巨大化させるのだ！", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "背に腹はかえられない、ということですね。\nこれも未来の大事業のため……！！", "face": "l32f8983f4959"}, {"name": "シャルキー", "text": "わ、わわー！？\n王子様！　チョコがどんどん大きくなっていきますー！", "face": "u965"}, {"name": "ロヴィニア", "text": "コレほどの大きさのチョコマイコニド、\n打たれ強そうだし、何よりチョコ胞子を\n撒き散らす力も尋常じゃなさそうだね……。", "face": "u662"}, {"name": "シュシュ", "text": "早く倒さないと、\nどんどん体を蝕まれちゃいそうです……。", "face": "u656"}, {"name": "バイン", "text": "うわぁ、チョコトレントまで大きくなってるよ。\n再生能力も強くなってるとしたら、\nちょっとの傷じゃすぐに治しちゃうかも……？", "face": "u712"}, {"name": "シャルキー", "text": "ですが、デーモンシェフの悪事を防ぐためには、\nここで倒しちゃわないといけません！\n王子様、慎重な指揮をお願いしますー！", "face": "u965"}]}, {"trigger": "end", "lines": [{"name": "デーモンシェフ", "text": "あぁ……チョコ達が倒されていく……。\nだが副デーモンシェフよ、我らはこの悲しみを胸に、\n次なる事業に歩を進めるのだ……！！", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "はっ……！！　デーモンシェフの\n類まれなる商才に、どこまでもお供します！！", "face": "l32f8983f4959"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "デーモンシェフも、次は普通の\n事業を立ち上げてくれたら良いのですが……。", "face": "ld032ee81a07d"}, {"name": "ハルモニア", "text": "……あの様子だと、また悪巧みをしそうですね。\n魔界にいた頃から切れ者でしたが、\nとうとう才能が開花してしまったようです……。", "face": "u941"}, {"name": "シャルキー", "text": "うぅぅ、困っちゃいますね……。\nでも、今回のバレンタインはちゃーんと守られました！", "face": "u965"}, {"name": "シャルキー", "text": "これからも、何が起きても、\n私が王子様をいーっぱい応援しちゃいますから！\nデーモンシェフの悪事は、私達で食い止めましょうね！", "face": "u965"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "ふふっ、そうですね。\nそれではチョコの残骸を片付けて、\n王国へ帰還しましょうか！"}]}], "map": {"image": "Map920138_3492", "w": 960, "h": 640, "spots": [{"k": "b", "x": 481, "y": 529}, {"k": "m", "x": 707, "y": 183, "id": 200}, {"k": "m", "x": 459, "y": 219, "id": 201}, {"k": "m", "x": 331, "y": 235, "id": 202}, {"k": "m", "x": 214, "y": 255, "id": 203}, {"k": "m", "x": 714, "y": 368, "id": 204}, {"k": "m", "x": 589, "y": 383, "id": 205}, {"k": "m", "x": 477, "y": 382, "id": 206}, {"k": "m", "x": 351, "y": 380, "id": 207}, {"k": "m", "x": 219, "y": 384, "id": 208}, {"k": "m", "x": 101, "y": 241, "id": 209}, {"k": "m", "x": 188, "y": 145, "id": 210}, {"k": "m", "x": 290, "y": 126, "id": 211}, {"k": "m", "x": 400, "y": 123, "id": 212}, {"k": "m", "x": 499, "y": 148, "id": 213}, {"k": "m", "x": 580, "y": 204, "id": 214}, {"k": "m", "x": 751, "y": 280, "id": 215}, {"k": "m", "x": 478, "y": 448, "id": 216}, {"k": "m", "x": 787, "y": 129, "id": 217}, {"k": "m", "x": 125, "y": 334, "id": 218}, {"k": "r", "x": 740, "y": 468, "id": 300}, {"k": "r", "x": 871, "y": 469, "id": 301}, {"k": "r", "x": 356, "y": 468, "id": 302}, {"k": "r", "x": 229, "y": 467, "id": 303}, {"k": "r", "x": 93, "y": 468, "id": 304}, {"k": "r", "x": 563, "y": 266, "id": 305}, {"k": "r", "x": 613, "y": 317, "id": 306}, {"k": "r", "x": 264, "y": 332, "id": 307}, {"k": "r", "x": 189, "y": 306, "id": 308}, {"k": "r", "x": 808, "y": 202, "id": 309}, {"k": "r", "x": 517, "y": 319, "id": 310}, {"k": "r", "x": 830, "y": 286, "id": 311}, {"k": "r", "x": 365, "y": 324, "id": 312}, {"k": "r", "x": 812, "y": 373, "id": 313}, {"k": "r", "x": 606, "y": 465, "id": 314}]}, "start_cost": 10, "active": true, "story_talk": true, "name_en": "The Giant Chocolate Conspiracy", "description_en": "Due to the Demon Chef's cunning scheme, the chocolate has grown to a massive size! Defeat the powerful defective chocolate stock and protect the Valentine's supply! God Rank (Target for 1★: Avg. Lv50)"}