ase_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 2, "missile_id": 6, "master_id": 32304, "global_id": 5923}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 60000, "attack": 1000, "base_hp": 60000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 2.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 473, "change_to": 5, "master_id": 32308, "global_id": 5927, "to_global_id": 5928, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 12}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 60000, "attack": 1000, "base_hp": 60000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 2.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 275, "change_to": 4, "master_id": 32309, "global_id": 5928}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["植物", "バレンタイン"], "hp": 40000, "attack": 650, "base_hp": 40000, "base_attack": 650, "damage_type": "magical", "armor_defense": 2500, "attack_range": 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 135, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 2.5999999046325684, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 474, "missile_id": 6, "master_id": 32310, "global_id": 5929, "ranged": true, "spawn_sec": 13}, {"enemy_id": 8, "source": "local", "count": 15, "form_count": 1, "tags": ["バレンタイン"], "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 600, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121312, "race_id": 3, "master_id": 32293, "global_id": 5912, "spawn_sec": 68}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 300, "base_hp": 5500, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "attack_range": 180, "attack_speed": 30, "attack_wait": 50, "attack_interval": 173, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112976, "race_id": 16, "missile_id": 6, "master_id": 30771, "global_id": 4390, "ranged": true, "spawn_sec": 115}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108544, "race_id": 16, "special_effect_id": 54, "master_id": 30038, "global_id": 3657, "spawn_sec": 142}], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンシェフ", "text": "まさかチョコが本格的に流通し始める前に、\nあの工場が操業停止になってしまうとはな……。", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "はっ……残念でなりません……。\nですが次なる事業では、きっと莫大な稼ぎを――", "face": "l32f8983f4959"}, {"name": "デーモンシェフ", "text": "――駄目、なのだ。\n我々には元手となる資金が足りないのだ……！！", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "おぉ……なんという……。\nそれでは従業員も路頭に迷ってしまいます！", "face": "l32f8983f4959"}, {"name": "デーモンシェフ", "text": "ふふん、そこで良い考えがあるのだ。\n我々には膨大なチョコの在庫がある。\nこれを巨大化させて販売すれば……？", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "おぉ、おぉ！　素晴らしい！！\n何も知らぬ消費者が、水増しされたチョコを！！", "face": "l32f8983f4959"}]}, {"trigger": "start", "lines": [{"name": "アイリーン", "text": "――なるほどなるほど。\n酷い悪巧みもあったものですね。", "face": "u315"}, {"name": "シャルキー", "text": "王子様ー！　こっちですー！！\nデーモンシェフを発見しましたー！！", "face": "u965"}, {"name": "デーモンシェフ", "text": "くっ、このままでは王国軍の本隊が来てしまう！\n副デーモンシェフよ、急ぎチョコを巨大化させるのだ！", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "背に腹はかえられない、ということですね。\nこれも未来の大事業のため……！！", "face": "l32f8983f4959"}, {"name": "シャルキー", "text": "わ、わわー！？\n王子様！　チョコがどんどん大きくなっていきますー！", "face": "u965"}, {"name": "ロヴィニア", "text": "コレほどの大きさのチョコマイコニド、\n打たれ強そうだし、何よりチョコ胞子を\n撒き散らす力も尋常じゃなさそうだね……。", "face": "u662"}, {"name": "シュシュ", "text": "早く倒さないと、\nどんどん体を蝕まれちゃいそうです……。", "face": "u656"}, {"name": "バイン", "text": "うわぁ、チョコトレントまで大きくなってるよ。\n再生能力も強くなってるとしたら、\nちょっとの傷じゃすぐに治しちゃうかも……？", "face": "u712"}, {"name": "シャルキー", "text": "ですが、デーモンシェフの悪事を防ぐためには、\nここで倒しちゃわないといけません！\n王子様、慎重な指揮をお願いしますー！", "face": "u965"}]}, {"trigger": "end", "lines": [{"name": "デーモンシェフ", "text": "あぁ……チョコ達が倒されていく……。\nだが副デーモンシェフよ、我らはこの悲しみを胸に、\n次なる事業に歩を進めるのだ……！！", "face": "l1cb44203deef"}, {"name": "副デーモンシェフ", "text": "はっ……！！　デーモンシェフの\n類まれなる商才に、どこまでもお供します！！", "face": "l32f8983f4959"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "デーモンシェフも、次は普通の\n事業を立ち上げてくれたら良いのですが……。", "face": "lab0770995d2a"}, {"name": "ハルモニア", "text": "……あの様子だと、また悪巧みをしそうですね。\n魔界にいた頃から切れ者でしたが、\nとうとう才能が開花してしまったようです……。", "face": "u941"}, {"name": "シャルキー", "text": "うぅぅ、困っちゃいますね……。\nでも、今回のバレンタインはちゃーんと守られました！", "face": "u965"}, {"name": "シャルキー", "text": "これからも、何が起きても、\n私が王子様をいーっぱい応援しちゃいますから！\nデーモンシェフの悪事は、私達で食い止めましょうね！", "face": "u965"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "ふふっ、そうですね。\nそれではチョコの残骸を片付けて、\n王国へ帰還しましょうか！"}]}], "story_talk": true, "active": true}