{"quest_id": 4079, "name": "最後の水兵", "description": "水兵と海賊の戦いが続く\n海域に赴き、海賊の襲撃を\n受ける水兵を救え！", "event": "裏切りの海賊", "event_category": "History", "mission_id": 920020, "map_no": 3830, "level": 80, "multiplier": 0.8, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "form_count": 1, "hp": 800, "attack": 120, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "hp": 1200, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 80, "attack_range": 250, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101104, "race_id": 16, "missile_id": 26, "master_id": 317, "global_id": 316, "ranged": true, "spawn_sec": 34}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 640, "attack": 104, "base_hp": 800, "base_attack": 130, "damage_type": "physical", "armor_defense": 30, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 616, "global_id": 615, "spawn_sec": 52}, {"enemy_id": 4, "source": "local", "count": 1, "level": 40, "form_count": 1, "hp": 2000, "attack": 480, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 27, "global_id": 26, "spawn_sec": 66}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 1600, "attack": 104, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 71}, {"enemy_id": 6, "source": "local", "count": 1, "level": 60, "form_count": 1, "hp": 4800, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 80, "attack_range": 400, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104896, "race_id": 16, "missile_id": 26, "master_id": 617, "global_id": 616, "ranged": true, "spawn_sec": 88}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "この海域です。\nいまだに水兵と海賊が戦いを\n続けているのは……。", "face": "l3d74f56bb295"}, {"name": "アンナ", "text": "今、人間同士が争っている場合では\nありません。\nすぐに止めさせないと。", "face": "l3d74f56bb295"}, {"name": "兵士", "text": "報告！　この先で水兵と海賊が\n交戦中です！", "face": "l4e9aa89e1bb8"}, {"name": "水兵", "text": "……あぁ、みんなどうしましたか？\n生きてますか？\nまさか私以外、全滅ですか！？", "face": "u156"}, {"name": "水兵", "text": "わわっ！　誰ですかあなたたちは？　\nまさか海賊ですか！？", "face": "u156"}, {"name": "アンナ", "text": "われわれは海賊ではありません。\nこの争いを止めるためにやってきました。\n他の水兵はどこですか？"}, {"name": "水兵", "text": "それがどこにも見当たらないんです。\nもしかして、全滅したんでしょうか……。", "face": "u156"}, {"name": "海賊", "text": "いくぞ野郎ども！\n水兵どもを蹴散らせぇ！", "face": "u124"}, {"name": "アンナ", "text": "あなた方は海賊ですね。\nどうか話を聞いてください！", "face": "l3d74f56bb295"}, {"name": "海賊", "text": "誰だてめぇらは！\n水兵の仲間か？\nかまわねぇ、やっちまえ！", "face": "u124"}, {"name": "水兵", "text": "あわわっ……！\n助けてー！", "face": "u156"}]}, {"trigger": "battle", "at_sec": 89, "lines": [{"name": "水兵", "text": "あれは！　紅の海賊、ベアトリカ！", "face": "u156"}, {"name": "アンナ", "text": "彼女は……？", "face": "l3d74f56bb295"}, {"name": "水兵", "text": "海賊たちのリーダーです。\nただ見た目が女だからって\n油断しちゃだめです。", "face": "u156"}, {"name": "アンナ", "text": "王子、油断なさらないよう、\nお気を付けください。", "face": "l3d74f56bb295"}]}], "active": true}