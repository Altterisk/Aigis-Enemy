d": 2107584, "race_id": 6, "change_to": 9, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 100}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 4500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109312, "race_id": 6, "special_effect_id": 248, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30178, "global_id": 3797, "ranged": true, "spawn_sec": 106}, {"enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 126}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 4500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109328, "race_id": 6, "special_effect_id": 248, "change_to": 10, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30179, "global_id": 3798, "ranged": true, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 147}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107568, "race_id": 6, "master_id": 872, "global_id": 871, "spawn_sec": 165}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "hp": 9000, "attack": 900, "base_hp": 9000, "base_attack": 900, "damage_type": "physical", "armor_defense": 5000, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "special_effect_id": 222, "change_to": 13, "master_id": 30175, "global_id": 3794, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 179}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109312, "race_id": 6, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30176, "global_id": 3795, "ranged": true, "spawn_sec": 192}], "popups": ["古代龍のHPを減らすと、\n強烈な遠距離攻撃をしてきます。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "天使", "text": "――全て、主の仰せのままに。", "face": "l09449edda563"}, {"name": "モーティマ", "text": "ったく、なんつー数いやがんだ。……っておい！　\nハク……ノカミ？\nとかいうのもついてきてやがるぞ！", "face": "u14"}, {"name": "サーベイン", "text": "「様」をつけんカ、この愚か者が！！", "face": "u425"}, {"name": "モーティマ", "text": "お、おぅ。\n……は、ハクノカミ様もついてきてやが……、\nつ、ついてきておるますぜ！", "face": "u14"}, {"name": "バシラ", "text": "まるで私達についてくるように……\n一体何をお考えなのでしょうね。", "face": "u28"}, {"name": "サーベイン", "text": "ただの気紛れであろう。\n古代龍様の御心ハ\n誰にも計り知れるものではないのダ。", "face": "u425"}, {"name": "ケイティ", "text": "ハクノカミ様の御考えも気になりますが、\n今は欠片を集め、一刻も早く龍玉を\nほこらへ納める事を優先すべきです。", "face": "u114"}, {"name": "アンナ", "text": "その通りですね。そのためにもまず、\nこの地を天使達より取り戻さねばなりません。\n王子、戦闘のご準備を！", "face": "lc26decf1e4cf"}, {"name": "レオナ", "text": "どうやら後方の海からも敵が来ているようだ。\n我々はそちらを担当しよう。サーベイン、\nお前がここにいると面倒そうだ。一緒にこい！", "face": "u311"}, {"name": "サーベイン", "text": "う……むウ。承知致した。王子、念の為言っておくガ、\n決してハクノカミ様の御身に傷などつけヌようにな。\nよいか、絶対に傷つけるでないゾ！！", "face": "u425"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "王子、天使達が退いていきます。\n無事島を守り抜けたようです。", "face": "u114"}, {"name": "モーティマ", "text": "お？　いつの間にかハクノカミ……様も\nいなくなってんじゃねーか。", "face": "u14"}, {"name": "バシラ", "text": "本当です。一体どこにいっちゃったんでしょう……。", "face": "u28"}, {"name": "レオナ", "text": "――観測していたこちらの兵によると、\nどこかに移動していった訳ではなく、\n海中に吸い込まれるように消えたとの事だ。", "face": "u311"}, {"name": "アンナ", "text": "レオナさん、ご無事で何よりです。\nしかし海中に消えたとは……。", "face": "lc26decf1e4cf"}, {"name": "ケイティ", "text": "如何に海中であろうと、あれ程の巨体が\n海中を泳いでいれば何かしらの気配も\nありそうなものですが。", "face": "u114"}, {"name": "アンナ", "text": "……ハクノカミ様の行方も気になりますが、\nほこらの様子を見てきた方が良いかもしれません。\n龍玉の欠片を納めるほこらがなくては元も子もありません。", "face": "lc26decf1e4cf"}, {"name": "？？？", "text": "――あぁ～、よいよい。そんな事はもうせんでよい。", "face": "u458"}, {"name": "バシラ", "text": "どちら様でしょうか？　\n尻尾に鱗……竜人の方のようですが、\nサーベインさんのお知り合いです？", "face": "u28"}, {"name": "サーベイン", "text": "いや、見慣れぬ顔だな。新兵か？　\n貴公、まずは名を名乗るのが\n礼儀と言うものであろウ。", "face": "u425"}, {"name": "ハクノカミ", "text": "ハクノカミじゃ。", "face": "u458"}, {"name": "サーベイン", "text": "ハクノカミ様の名を騙るとは……ふム、\nまぁハクノカミ様の御姿を拝見したばかり、\nつい憧れてしまう気持ちもわからんでもないガ。", "face": "u425"}, {"name": "ハクノカミ", "text": "だからハクノカミ、その本人じゃと言うておる。", "face": "u458"}, {"name": "サーベイン", "text": "まだ言うカ。ハクノカミ様とは蒼銀に輝く鱗を持ち、\n清流の如きしなやかな尾には金毛を纏いし、\n偉大なる…………。", "face": "u425"}, {"name": "サーベイン", "text": "……ば、バカナ。……いや、\nそんナ……まさカ………\n…………………………。", "face": "u425"}, {"name": "レオナ", "text": "お、おいサーベイン、しっかりしろ！　サーベイン！", "face": "u311"}, {"name": "バシラ", "text": "立ったまま気を失ってしまいましたね……。", "face": "u28"}, {"name": "ハクノカミ", "text": "全く最近の若い奴は……まぁ構わん。\nひとまずどこか休める場所へ案内せい。わらわは\nまだまだ眠り足りん、まだ少し頭がまどろんでおるわ。", "face": "u458"}]}], "active": true}