true, "spawn_sec": 106}, {"enemy_id": 8, "source": "local", "count": 17, "form_index": 0, "form_count": 1, "hp": 2400, "attack": 450, "base_hp": 2400, "base_attack": 450, "damage_type": "physical", "armor_defense": 60, "attack_range": 180, "attack_speed": 80, "attack_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097760, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 50, "global_id": 49, "ranged": true, "spawn_sec": 109}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 4000, "attack": 150, "base_hp": 4000, "base_attack": 150, "damage_type": "physical", "armor_defense": 80, "magic_defense": 10, "attack_range": 260, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106288, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 799, "global_id": 798, "ranged": true, "spawn_sec": 139}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 14000, "attack": 650, "base_hp": 14000, "base_attack": 650, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101824, "race_id": 16, "special_effect_id": 226, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30020, "global_id": 3639, "ranged": true, "spawn_sec": 139}, {"enemy_id": 11, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_range": 140, "attack_speed": 80, "attack_wait": 60, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101408, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 299, "global_id": 298, "ranged": true, "spawn_sec": 151}], "popups": ["オーラをまとったフラフィーは\n防御無視の遠距離攻撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フラフィー", "text": "このままじゃ、\n王国軍をクビになっちゃいます……！！", "face": "u811"}, {"name": "フラフィー", "text": "歩兵さんとの足並みが揃えられないし、\nそれに気を取られて弓も外しちゃうし……。\nど、どどど、どうしましょう……っ。", "face": "u811"}, {"name": "リオン", "text": "……お悩みのようね！\n可愛い新人ちゃん！！", "face": "u1251"}, {"name": "フラフィー", "text": "……えっ？　わぁあああっ！？\n今の聞いてたんですか！？", "face": "u811"}, {"name": "バシラ", "text": "フラフィーちゃん、\n独り言のつもりだったんだろうけど、\n結構遠くまで聞こえていましたよ？", "face": "u28"}, {"name": "ミゲル", "text": "この渓谷、木とか無いから\n声が遠くまで聞こえるんだよなぁ……。", "face": "u369"}, {"name": "バシラ", "text": "戦場でなく、訓練中だったから問題ないですけどね！", "face": "u28"}, {"name": "フラフィー", "text": "うぅぅ……なんて恥ずかしいことを……。\nこれはもう本当にクビになってしまうのでは……。", "face": "u811"}, {"name": "テティス", "text": "大丈夫ですよ、フラフィーちゃん。\n私が手取り足取り、仲間との協力を教えて――", "face": "u37"}, {"name": "バシラ", "text": "――はい、テティスの隊列は私の隣ですからねっ。\nフラフィーさん、仲間との連携は実地で学ぶもの。\nここはひとつ、騎兵の訓練に混ざってみませんか？", "face": "u28"}, {"name": "テティス", "text": "そうですね、バシラ。\n私とバシラの連携を見て学び、\nそして実際に戦場を駆けてみると良いかと。", "face": "u37"}, {"name": "フラフィー", "text": "皆さん……わ、分かりました！\n私、頑張ってみます！", "face": "u811"}, {"name": "ミゲル", "text": "それじゃあ王子の兄貴を呼んでくるかな。\nさっそく騎兵訓練、開始だぜ！", "face": "u369"}]}, {"trigger": "end", "lines": [{"name": "フラフィー", "text": "すごい……仲間と一緒だと、\nいつもより動ける気がしてきました！", "face": "u811"}, {"name": "バシラ", "text": "一人より二人、ですからね！\nそれぞれ得意分野が違いますから、\n協力し合うことに意味があるんです。", "face": "u28"}, {"name": "フラフィー", "text": "一人での狩猟とは全然違いますね……。\n私、もっともっとがんばりますね！！", "face": "u811"}, {"name": "フラフィー", "text": "それから王子さま、訓練の相手をしていただき、\n本当にありがとうございましたっ！！", "face": "u811"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "フラフィー", "text": "……ってあぁー！！\n王子さまに恩返しをするはずが、\nまた借りを作ってしまいました……っ。", "face": "u811"}, {"name": "フラフィー", "text": "こうなったらもっともっと訓練しないと！\n先輩方、これからもビシバシお願いしますー！！", "face": "u811"}, {"name": "アンナ", "text": "……フラフィーさん、どうやら、\n元気を取り戻したようですね。\n彼女が無事で本当に良かったです。"}, {"name": "アンナ", "text": "しかし、闇の組織の動向には\n目を光らせておかねばなりませんね。\n今後も、気を抜かずに対処していきましょう。"}]}], "map": {"image": "Map920128_3316", "w": 960, "h": 640, "spots": [{"k": "b", "x": 8, "y": 374}, {"k": "m", "x": 282, "y": 380, "id": 200}, {"k": "m", "x": 293, "y": 449, "id": 201}, {"k": "m", "x": 358, "y": 289, "id": 202}, {"k": "m", "x": 369, "y": 370, "id": 203}, {"k": "m", "x": 382, "y": 453, "id": 204}, {"k": "m", "x": 524, "y": 437, "id": 205}, {"k": "m", "x": 506, "y": 354, "id": 206}, {"k": "m", "x": 490, "y": 273, "id": 207}, {"k": "m", "x": 578, "y": 259, "id": 208}, {"k": "m", "x": 598, "y": 339, "id": 209}, {"k": "m", "x": 619, "y": 420, "id": 210}, {"k": "m", "x": 665, "y": 243, "id": 211}, {"k": "m", "x": 689, "y": 325, "id": 212}, {"k": "m", "x": 712, "y": 405, "id": 213}, {"k": "m", "x": 272, "y": 310, "id": 214}, {"k": "m", "x": 798, "y": 229, "id": 215}, {"k": "m", "x": 823, "y": 304, "id": 216}, {"k": "m", "x": 849, "y": 377, "id": 217}, {"k": "m", "x": 186, "y": 309, "id": 218}, {"k": "m", "x": 187, "y": 371, "id": 219}, {"k": "m", "x": 193, "y": 435, "id": 220}, {"k": "m", "x": 104, "y": 298, "id": 221}, {"k": "m", "x": 105, "y": 361, "id": 222}, {"k": "m", "x": 104, "y": 425, "id": 223}, {"k": "r", "x": 272, "y": 244, "id": 300}, {"k": "r", "x": 607, "y": 202, "id": 301}, {"k": "r", "x": 832, "y": 175, "id": 302}, {"k": "r", "x": 902, "y": 404, "id": 303}, {"k": "r", "x": 782, "y": 435, "id": 304}, {"k": "r", "x": 557, "y": 471, "id": 305}, {"k": "r", "x": 345, "y": 234, "id": 306}, {"k": "r", "x": 533, "y": 215, "id": 307}, {"k": "r", "x": 144, "y": 239, "id": 308}, {"k": "r", "x": 52, "y": 477, "id": 309}, {"k": "r", "x": 439, "y": 479, "id": 310}]}, "start_cost": 10, "active": true, "name_en": "Lessons in Group Combat", "description_en": "Fluffy, who lost her confidence after failing in unfamiliar group combat.\nServe as the opponent for the cavalry unit in training and\nteach her the value of coordination with reliable allies! Divine (Target for 1★: Avg Lv50)"}