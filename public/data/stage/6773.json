ck_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097760, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 50, "global_id": 49, "ranged": true, "spawn_sec": 109}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 150, "base_hp": 4000, "base_attack": 150, "damage_type": "physical", "armor_defense": 80, "magic_defense": 10, "attack_range": 260, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106288, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 799, "global_id": 798, "ranged": true, "spawn_sec": 139}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 14000, "attack": 650, "base_hp": 14000, "base_attack": 650, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101824, "race_id": 16, "special_effect_id": 226, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30020, "global_id": 3639, "ranged": true, "spawn_sec": 139}, {"enemy_id": 11, "source": "local", "count": 12, "form_count": 1, "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_range": 140, "attack_speed": 80, "attack_wait": 60, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101408, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 299, "global_id": 298, "ranged": true, "spawn_sec": 151}], "popups": ["オーラをまとったフラフィーは\n防御無視の遠距離攻撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フラフィー", "text": "このままじゃ、\n王国軍をクビになっちゃいます……！！", "face": "u811"}, {"name": "フラフィー", "text": "歩兵さんとの足並みが揃えられないし、\nそれに気を取られて弓も外しちゃうし……。\nど、どどど、どうしましょう……っ。", "face": "u811"}, {"name": "リオン", "text": "……お悩みのようね！\n可愛い新人ちゃん！！", "face": "u1251"}, {"name": "フラフィー", "text": "……えっ？　わぁあああっ！？\n今の聞いてたんですか！？", "face": "u811"}, {"name": "バシラ", "text": "フラフィーちゃん、\n独り言のつもりだったんだろうけど、\n結構遠くまで聞こえていましたよ？", "face": "u28"}, {"name": "ミゲル", "text": "この渓谷、木とか無いから\n声が遠くまで聞こえるんだよなぁ……。", "face": "u369"}, {"name": "バシラ", "text": "戦場でなく、訓練中だったから問題ないですけどね！", "face": "u28"}, {"name": "フラフィー", "text": "うぅぅ……なんて恥ずかしいことを……。\nこれはもう本当にクビになってしまうのでは……。", "face": "u811"}, {"name": "テティス", "text": "大丈夫ですよ、フラフィーちゃん。\n私が手取り足取り、仲間との協力を教えて――", "face": "u37"}, {"name": "バシラ", "text": "――はい、テティスの隊列は私の隣ですからねっ。\nフラフィーさん、仲間との連携は実地で学ぶもの。\nここはひとつ、騎兵の訓練に混ざってみませんか？", "face": "u28"}, {"name": "テティス", "text": "そうですね、バシラ。\n私とバシラの連携を見て学び、\nそして実際に戦場を駆けてみると良いかと。", "face": "u37"}, {"name": "フラフィー", "text": "皆さん……わ、分かりました！\n私、頑張ってみます！", "face": "u811"}, {"name": "ミゲル", "text": "それじゃあ王子の兄貴を呼んでくるかな。\nさっそく騎兵訓練、開始だぜ！", "face": "u369"}]}, {"trigger": "end", "lines": [{"name": "フラフィー", "text": "すごい……仲間と一緒だと、\nいつもより動ける気がしてきました！", "face": "u811"}, {"name": "バシラ", "text": "一人より二人、ですからね！\nそれぞれ得意分野が違いますから、\n協力し合うことに意味があるんです。", "face": "u28"}, {"name": "フラフィー", "text": "一人での狩猟とは全然違いますね……。\n私、もっともっとがんばりますね！！", "face": "u811"}, {"name": "フラフィー", "text": "それから王子さま、訓練の相手をしていただき、\n本当にありがとうございましたっ！！", "face": "u811"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "フラフィー", "text": "……ってあぁー！！\n王子さまに恩返しをするはずが、\nまた借りを作ってしまいました……っ。", "face": "u811"}, {"name": "フラフィー", "text": "こうなったらもっともっと訓練しないと！\n先輩方、これからもビシバシお願いしますー！！", "face": "u811"}, {"name": "アンナ", "text": "……フラフィーさん、どうやら、\n元気を取り戻したようですね。\n彼女が無事で本当に良かったです。"}, {"name": "アンナ", "text": "しかし、闇の組織の動向には\n目を光らせておかねばなりませんね。\n今後も、気を抜かずに対処していきましょう。"}]}], "active": true}