defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "master_id": 423, "global_id": 422}], "spawn_sec": 141}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 361, "master_id": 31664, "global_id": 5283, "spawn_sec": 175}], "popups": ["ダークエルフナイトは\nダメージを受けると\n攻撃したユニットへ反撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ダークエルフ", "text": "――おぉ、全身に力が漲っていく！\nたかが剣の欠片と侮っていたが、\nこれならエルフ共を滅ぼせるぞ……！！", "face": "l597e11e0d7fb"}, {"name": "ダークエルフ", "text": "ふふっ……これで長きにわたる、\n我らの苦しき戦いも終わると思うと――むっ？", "face": "l597e11e0d7fb"}, {"name": "エマ", "text": "――王子、此方より欠片の気配が。\n欠片を持つ魔物に警戒を。", "face": "u582"}, {"name": "ダークエルフ", "text": "（あれは――王子たち！？\nなぜここに……いや、なぜ欠片の事を知っている？\nまたもや我らの計画を邪魔しに来たのか！？）", "face": "l597e11e0d7fb"}, {"name": "エマ", "text": "しかし我ら血族とは、些か異なるこの気配。\nどうやら欠片を持つは不死者ではなさそうです。\nこの血の香りは……ダークエルフでしょうか……？", "face": "u582"}, {"name": "ダークエルフ", "text": "（くっ……何だあの女っ！\n欠片を持つ我らが近くにいると知りながら、\nあの余裕は何なのだ……！？）", "face": "l597e11e0d7fb"}, {"name": "エマ", "text": "嗚呼、何と歪な輝きでありましょう。\n刈り取ればさぞかし甘い悲鳴を漏らすはず。", "face": "u582"}, {"name": "ダークエルフ", "text": "（ダメだっ、完全に気付かれている！\nこうなったら仕方ない、\n王子諸共、まとめて始末してやる！！）", "face": "l597e11e0d7fb"}, {"name": "ダークエルフ", "text": "――よく来たな王子共。\nこの欠片の力、お前達で試させてもらおう！", "face": "l597e11e0d7fb"}, {"name": "エマ", "text": "ふふ、うふふ、そちらから出てくるとは好都合。\n王子、欠片持つダークエルフにはお気をつけて。\nさぁ、欠片を奪う戦いを始めましょうか。", "face": "u582"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "……チィッ！　おい、撤退するぞ！\nこんなところで戦力を減らすわけにはいかない！", "face": "l597e11e0d7fb"}, {"name": "ダークエルフ", "text": "（何故いつも邪魔されるのだ……！！\nおのれっ、おのれ王子……っ！！）", "face": "l597e11e0d7fb"}, {"name": "エマ", "text": "おやおや、あんな怯えた顔をせずとも良いものを。\nさぁ王子、次なる地点へ向かいましょうか。", "face": "u582"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "フィリス", "text": "（……あんな余裕たっぷりに迫られたら、\nさすがに怯えるのも分かるなぁ）", "face": "u40"}, {"name": "ソーマ", "text": "（ちょっと可哀想でしたね……）", "face": "u23"}, {"name": "エマ", "text": "……ふふふ。", "face": "u582"}]}], "active": true}