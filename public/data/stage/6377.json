{"quest_id": 6377, "name": "鬼の抗争", "description": "各地で勃発しているという\n鬼の派閥争いを止めるべく、\n王子達は抗争の地へと向かう。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "青鬼娘と鬼一門", "event_category": "History", "mission_id": 920103, "map_no": 5289, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 200, "gold": 800, "drops": [{"item": 5002, "c": 1}, {"card": 236, "c": 2}, {"item": 2001, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 100, "attack_speed": 180, "attack_wait": 60, "attack_interval": 181, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 961, "global_id": 960, "ranged": true, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 18, "form_index": 0, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 4}, {"enemy_id": 6, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 1000, "attack": 100, "base_hp": 1000, "base_attack": 100, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_speed": 180, "attack_wait": 60, "attack_interval": 361, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "change_to": 2, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 965, "global_id": 964, "to_condition": 0, "to_global_id": 960, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 76}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 100, "attack_speed": 180, "attack_wait": 60, "attack_interval": 181, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 961, "global_id": 960, "ranged": true, "from_condition": 0}], "dialogue": [{"trigger": "start", "lines": [{"name": "リンドウ", "text": "ここまで来てくれておおきにな、王子。\nけど、こっからが本番やで？", "face": "u587"}, {"name": "リンドウ", "text": "今回集めてもらう『節分豆』は鬼や妖怪が持っとる。\n敵の鬼の力を弱めるための、お守りみたいなもんや。", "face": "u587"}, {"name": "リンドウ", "text": "ま、奴らは自分の力まで弱まってしまわんように\n少量しか持ってへん。せやからうちらは、鬼同士の\n抗争を収めつつ『節分豆』を少しずつ集めていかな――", "face": "u587"}, {"name": "河童", "text": "――おうおうおう、さっさと失せろや迅雷派ども！\nここはなァ、重水の四天王様のシマなんだよッ！", "face": "le6f1cf02017d"}, {"name": "リンドウ", "text": "あ……あかん！　もう始まっとる！", "face": "u587"}, {"name": "鬼刃姫", "text": "向こうで睨み合ってるのは、\n重水の四天王の部下たちと\n迅雷の四天王の部下たちみたいね……。", "face": "u435"}, {"name": "アンナ", "text": "とにかく、早く争いをやめさせましょう！\n付近に住む人々が巻き添えになる恐れがあります。", "face": "l82ee8a934738"}, {"name": "リンドウ", "text": "……せやな。\nおいコラーッ！　喧嘩はやめんかーい！", "face": "u587"}, {"name": "河童", "text": "あァん！？　誰だてめぇは？\nてめぇみてぇなチビの言うことなんざ誰が聞くかよッ！", "face": "le6f1cf02017d"}, {"name": "リンドウ", "text": "だ……だぁれがチビじゃボケーっ！\nうちは鬼刃姫よりは背ぇは高いわっ！！", "face": "u587"}, {"name": "鬼刃姫", "text": "なッ……背の高さなんてどうでもいいでしょッ！\n……とにかく、関係ない人たちを巻き込むなら\nあてが許さないわよ！", "face": "u435"}, {"name": "河童", "text": "ケッ、知ったことかよ！\nニンゲンどもがどうなろうが俺たちにゃ関係ねえ！", "face": "le6f1cf02017d"}, {"name": "河童", "text": "それにニンゲンどもを死の恐怖に直面させりゃあ、\n俺たち妖怪の力の源、「畏れ」が発生する。\n一石二鳥っつうわけよ。ヒャーッハハハーッ！", "face": "le6f1cf02017d"}, {"name": "鬼刃姫", "text": "やれやれ……力ずくで止めるしかなさそうね。", "face": "u435"}, {"name": "河童", "text": "お、やんのかテメこらぁ！？\n上等だ、ならてめぇらから消えてもらうぜぇッ！！", "face": "le6f1cf02017d"}]}, {"trigger": "end", "lines": [{"name": "河童", "text": "ヒィイッ！　す、すいやせんでしたーッ！！", "face": "le6f1cf02017d"}, {"name": "リンドウ", "text": "うむ、わかればええんや。\n両軍とも兵を退き。そしたら許したる。", "face": "u587"}, {"name": "河童", "text": "へ、へいッ！　ただいま！\n……おい、おめぇら！　撤収だ！", "face": "le6f1cf02017d"}, {"name": "リンドウ", "text": "待たんかい。あんたにはまだ話がある。", "face": "u587"}, {"name": "河童", "text": "ヒェッ……な、なんでごぜえましょう？", "face": "le6f1cf02017d"}, {"name": "リンドウ", "text": "他にも鬼同士の戦闘が起きそうな場所があるやろ？\nはよ教えんと、うちの金棒が火ィを噴くで？", "face": "u587"}, {"name": "河童", "text": "あばばばば……。\nじ、迅雷の四天王が配下の勢力を結集して\nどこかを攻めようとしているとか、いないとか……。", "face": "le6f1cf02017d"}, {"name": "リンドウ", "text": "はっきりせんかーいッ！！", "face": "u587"}, {"name": "河童", "text": "ぐげぇえ～～～ッ！！\nあ、あんまりだぁあ～～～ッ！！！", "face": "le6f1cf02017d"}, {"name": "鬼刃姫", "text": "……王子、迅雷の四天王が\n他の四天王に総力戦を仕掛けようとしてるみたい！", "face": "u435"}, {"name": "アンナ", "text": "総力戦ともなれば、甚大な被害が予想されますね。\nなんとか思いとどまらせに行かなければ！", "face": "l82ee8a934738"}, {"name": "リンドウ", "text": "おう、道案内は任しとき！\n迅雷の四天王の根城に連れてったる！", "face": "u587"}]}], "map": {"image": "Map920103_5289", "w": 960, "h": 640, "spots": [{"k": "b", "x": 558, "y": 41}, {"k": "m", "x": 156, "y": 219, "id": 200}, {"k": "m", "x": 250, "y": 334, "id": 201}, {"k": "m", "x": 495, "y": 183, "id": 202}, {"k": "m", "x": 747, "y": 222, "id": 203}, {"k": "m", "x": 622, "y": 191, "id": 204}, {"k": "m", "x": 337, "y": 229, "id": 205}, {"k": "m", "x": 448, "y": 461, "id": 206}, {"k": "m", "x": 599, "y": 450, "id": 207}, {"k": "m", "x": 787, "y": 319, "id": 208}, {"k": "m", "x": 867, "y": 164, "id": 209}, {"k": "m", "x": 526, "y": 110, "id": 210}, {"k": "m", "x": 324, "y": 434, "id": 211}, {"k": "m", "x": 715, "y": 416, "id": 212}, {"k": "m", "x": 190, "y": 273, "id": 213}, {"k": "m", "x": 798, "y": 169, "id": 214}, {"k": "m", "x": 110, "y": 183, "id": 215}, {"k": "r", "x": 336, "y": 340, "id": 300}, {"k": "r", "x": 434, "y": 394, "id": 301}, {"k": "r", "x": 443, "y": 245, "id": 302}, {"k": "r", "x": 714, "y": 292, "id": 303}, {"k": "r", "x": 620, "y": 389, "id": 304}, {"k": "r", "x": 244, "y": 226, "id": 305}, {"k": "r", "x": 139, "y": 321, "id": 306}, {"k": "r", "x": 184, "y": 399, "id": 307}, {"k": "r", "x": 836, "y": 220, "id": 308}, {"k": "r", "x": 866, "y": 332, "id": 309}, {"k": "r", "x": 723, "y": 141, "id": 310}, {"k": "r", "x": 585, "y": 136, "id": 311}, {"k": "r", "x": 416, "y": 145, "id": 312}, {"k": "r", "x": 815, "y": 437, "id": 313}, {"k": "r", "x": 686, "y": 489, "id": 314}, {"k": "r", "x": 142, "y": 133, "id": 315}, {"k": "r", "x": 36, "y": 224, "id": 316}]}, "start_cost": 10, "active": true}