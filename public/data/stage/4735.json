ndition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 83}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 8, "source": "local", "count": 10, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 103}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 128}], "dialogue": [{"trigger": "start", "lines": [{"name": "バシラ", "text": "……で、ぬらりひょんが私を妖怪と間違えて\nスカウトしに来て大変な事になったって訳なのです。\nこれって、すごく失礼だと思いませんか？", "face": "u28"}, {"name": "シノ", "text": "そのような事がバシラさんと父上の間にあったとは……。\nふふっ……妖怪総大将であった父上といえども、\n失敗はつきものだったみたいですね。", "face": "u403"}, {"name": "風神", "text": "――お、シノのやつ、あんなところにいたか。\nおいッ雷神！　ここじゃここじゃ！\n見てみろ、あれがぬらりひょんの娘じゃ。", "face": "l9284c6289f1c"}, {"name": "シノ", "text": "風神様に……それに、雷神様までッ！？\nどうしてこのような場所に？", "face": "u403"}, {"name": "風神", "text": "何を驚くことがあるのじゃ？\n欲しいのじゃろう？　\n高名な物の怪の「血判状」が！", "face": "l9284c6289f1c"}, {"name": "シノ", "text": "私の為に、風神様が……？\nああ、なんたる幸甚でしょうか。", "face": "u403"}, {"name": "シノ", "text": "王子、これは風神様と雷神様から\n共に認めてもらう絶好の機会となりましょう。\n急ぎ、戦いの準備をお願いします。", "face": "u403"}, {"name": "バシラ", "text": "…………えっ？\n風神とも、また戦うの……？", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "風神", "text": "ゲハハハハハ！\nこのわしと雷神を退けるとはさすがじゃのう！", "face": "l9284c6289f1c"}, {"name": "風神", "text": "ほれシノ、約束のものじゃ！\nここら一帯に棲む妖怪たちの「血判状」だ。\nとっとと持っていくがよい。", "face": "l9284c6289f1c"}, {"name": "シノ", "text": "ありがとうございます風神様、雷神様！\n本当に、なんとお礼を言っていいのか……。", "face": "u403"}, {"name": "風神", "text": "道のりは険しいかとは思うが、お主なら\n妖怪総大将の地位、十分に務まるとわしは思う。\nそれでは息災でな、シノよ。ゲハハハハッ！", "face": "l9284c6289f1c"}, {"name": "バシラ", "text": "……行ってしまいましたね。\nですが、お二人に認めてもらえたようで、\n本当によかったです！", "face": "u28"}, {"name": "シノ", "text": "はい！　多くの妖怪の期待に応える為にも、\nもっと頑張らなくてはいけませんね……。", "face": "u403"}, {"name": "シノ", "text": "行きましょう、バシラさん！\n私たち妖怪の未来の為にッ！", "face": "u403"}, {"name": "バシラ", "text": "はぅぅ……だから私は妖怪じゃないって言ってるのに。\nいつの間にか仲間みたいになってるし、\nやっぱりシノさんは、ぬらりひょんの娘ですぅ……。", "face": "u28"}]}], "story_talk": true, "active": true}