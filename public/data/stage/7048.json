e": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 30, "attack_wait": 25, "attack_interval": 120, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2122752, "special_effect_id": 520, "master_id": 32520, "global_id": 6139, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 11, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122560, "change_to": 10, "change_condition": 1, "master_id": 32512, "global_id": 6131, "variants": [{"tags": ["アンデッド"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122608, "master_id": 32513, "global_id": 6132}], "spawn_sec": 81}, {"enemy_id": 12, "source": "local", "count": 6, "form_count": 2, "tags": ["アンデッド"], "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111856, "race_id": 8, "special_effect_id": 233, "change_to": 12, "change_condition": 3, "master_id": 30626, "global_id": 4245, "to_condition": 3, "to_global_id": 4246, "spawn_sec": 128}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 400, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111872, "race_id": 8, "special_effect_id": 233, "master_id": 30627, "global_id": 4246, "from_condition": 3}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112032, "race_id": 3, "special_effect_id": 233, "master_id": 30634, "global_id": 4253, "spawn_sec": 157}], "popups": ["血の使い魔(騎士)の攻撃は、\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴァンパイア公爵", "text": "――我に、我に古き血脈の力をォ……ッ！！", "face": "lee015c5a5de2"}, {"name": "？？？", "text": "――大儀なり、我が臣下よ。\nお前の忠義に応えてやろう。", "face": "l847e2bd89197"}, {"name": "ヴィンセント", "text": "なっ……いつの間に現れた？\n全く気配を感じなかったぞ。", "face": "u103"}, {"name": "？？？", "text": "くく……血族を狩る者と名乗る人の子らか。\nなるほど、煩わしいまでの輝きに満ちている。", "face": "l847e2bd89197"}, {"name": "？？？", "text": "だがいささか目障りだ。\nまだ妾は乙女の血を味わっておらぬゆえ。\n公爵よ、疾く此奴らを滅ぼすが良い。", "face": "l847e2bd89197"}, {"name": "？？？", "text": "そうさな、妾の血の騎士を貸してやろう。\n我が血で編み上げた槍なれば、\nあらゆる守りを貫こうとも。", "face": "l847e2bd89197"}, {"name": "ヴァンパイア公爵", "text": "おぉ、おぉ！　光栄の至り……！！\nさぁ王子よ、ゆくぞ……ッ！！", "face": "lee015c5a5de2"}, {"name": "ディエーラ", "text": "王子、ブラッドストーンの力に\nさらされて分かりました。", "face": "u1010a1"}, {"name": "ディエーラ", "text": "今の公爵は、私の時以上に力が暴走しているはずです。\n手傷を負わせることができれば、\n溢れた力で自滅するかもしれません。", "face": "u1010a1"}, {"name": "ディエーラ", "text": "……王子。\nどうか、どうかご武運を！", "face": "u1010a1"}]}, {"trigger": "end", "lines": [{"name": "ヴァンパイア公爵", "text": "嗚呼、身体が……我が肉体が……っ！", "face": "lee015c5a5de2"}, {"name": "？？？", "text": "……使えぬ駒だな。\nだが、忠義を尽くす者には報いねばならんか。\n今一度、お前に不死なる生を与えてやろう。", "face": "l847e2bd89197"}, {"name": "ラキュア", "text": "……なっ、滅びかけた公爵を再生しただと？\nあの女、いったいどれだけの力を備えているのだ。", "face": "u344"}, {"name": "？？？", "text": "これくらいで驚いて貰っては少々不服だ。\n妾にはまだ血が、生命の精髄が足りぬゆえな。", "face": "l847e2bd89197"}, {"name": "？？？", "text": "くく……しかし面白い……。\n滅ぼしてやったヴァンパイアの王国、\nその残党共を人間が従えているとは……。", "face": "l847e2bd89197"}, {"name": "？？？", "text": "王子、と言ったか？\nお前の輝きは覚えておこう。\n再び見えぬ方が、互いの為ではあろうがな。", "face": "l847e2bd89197"}, {"name": "フーリ", "text": "…………！？\nヴァンパイアたちが、消えていきます……！", "face": "u174"}, {"name": "ディエーラ", "text": "私やスイレンさんをさらった時と同じ、\n空間を転移する術でしょうか……？", "face": "u1010a1"}, {"name": "ラキュア", "text": "ともあれ、今は花嫁たちを助けるのが先決だろう。\nディエーラ、案内を頼めるか？", "face": "u344"}, {"name": "ディエーラ", "text": "は、はい！　この奥です！", "face": "u1010a1"}, {"name": "アンナ", "text": "ヴァンパイアの王国を滅ぼした存在の復活……。\n今後も吸血鬼の動向には、警戒が必要そうですね。", "face": "ld25eb68c1dfc"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}