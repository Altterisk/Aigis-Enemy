.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 3, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_condition": 0, "to_global_id": 624, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 2, "master_id": 625, "global_id": 624, "from_condition": 0}, {"enemy_id": 5, "source": "local", "count": 2, "level": 80, "form_index": 0, "form_count": 2, "hp": 4000, "attack": 900, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103936, "race_id": 18, "change_to": 5, "master_id": 486, "global_id": 485, "to_condition": 0, "to_global_id": 626, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 900, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105248, "race_id": 18, "change_to": 4, "master_id": 627, "global_id": 626, "from_condition": 0}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 25000, "attack": 1200, "base_hp": 25000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 40, "attack_speed": 10, "attack_wait": 15, "attack_interval": 96, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106304, "race_id": 18, "master_id": 797, "global_id": 796, "spawn_sec": 155}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "女王蟻！\nもう追い詰めましたよ、覚悟しなさい！", "face": "l345427989d85"}, {"name": "女王蟻", "text": "追い詰めた……だと……？\n……頼りにならぬ男共が……。\nこうなれば、妾が自ら手を下すまでだ！", "face": "l0a4f2f643212"}, {"name": "女王蟻", "text": "貴様ら雌どもを皆殺しにした後、\n外にいる王子を\nたっぷりと味わってやるわ……くふふ。", "face": "l0a4f2f643212"}, {"name": "ソーマ", "text": "あんな魔物に\n王子を食べさせたりなんて絶対にさせません！\n私達が、絶対に守り抜いて見せます！", "face": "u23"}, {"name": "女王蟻", "text": "妾以外の雌などこの世に必要ないわ！\n……全ての雄は妾のものよ……。\nさあ……ここで朽ち果てるがいい！", "face": "l0a4f2f643212"}, {"name": "アンナ", "text": "女王蟻の犠牲者を\nこれ以上だしてはなりません！\nここで、決着をつけます！", "face": "l345427989d85"}]}, {"trigger": "end", "lines": [{"name": "女王蟻", "text": "――ギャャァアッ！？\n……そ、そんな、ありえぬ……。\n人間の雌どもに……妾が負けるなど……。", "face": "l0a4f2f643212"}, {"name": "レアン", "text": "そのおごりが敗因だということを\n気づけないような相手に、\n私達が負けるわけがない。", "face": "u50"}, {"name": "女王蟻", "text": "覚えていろ……これで終わりになどしない……。\n……必ず……必ず復讐してやる……。", "face": "l0a4f2f643212"}, {"name": "ソーマ", "text": "どうやら、逃げられてしまったようですね……。\nですがあれほどの痛手を負っては、\nこれ以上、何かができるとは思えませんね……。", "face": "u23"}, {"name": "オスカー", "text": "……じょ、女王蟻を、倒したのですね……？\n助かりました……意識はあったのに……、\n女王蟻への忠義の念に抗えませんでした……。", "face": "u366"}, {"name": "ジェイク", "text": "俺も同じだオスカー……くそっ。\n冒険者だなんて名乗りを上げてるくせに、\nみっともなく他人に助けられちまうとはな……。", "face": "u367"}, {"name": "アンナ", "text": "見て下さい！　女王蟻の力が弱まった\nおかげで、囚われていた男性達が\n正気に戻ってくれたようです！"}, {"name": "レアン", "text": "ジェイクもオスカーも\nあまり自分を責めるな。\n今回ばかりは、克服のしようのないことだ。", "face": "u50"}, {"name": "ジェイク", "text": "ったく、とんだお人好しだぜ、あんたらはよ。\n……なあ、オスカー、こいつらの仲間になろうぜ？\n仲間は多い方がいいしな。", "face": "u367"}, {"name": "オスカー", "text": "僕もちょうど同じ事を言おうと思っていたところさ。\nもちろん、彼女達の許しを得られるのなら、\nという話だがね。", "face": "u366"}, {"name": "アンナ", "text": "断るわけがありません。\nとても心強い申し出です。\n是非とも、よろしくお願いします！"}, {"name": "ソーマ", "text": "アンナさーんッ！\n早く王子の所に行きましょー！\n私達が無事であることを早く報せたいです！", "face": "u23"}, {"name": "アンナ", "text": "そうですね！\n捕らえられた人たちの解放もありますし、\n急ぎ、王子と合流しましょう！"}]}], "map": {"image": "Map920068_3189", "w": 960, "h": 640, "spots": [{"k": "b", "x": 14, "y": 289}, {"k": "b", "x": 940, "y": 293}, {"k": "m", "x": 544, "y": 99, "id": 200}, {"k": "m", "x": 340, "y": 145, "id": 201}, {"k": "m", "x": 345, "y": 431, "id": 202}, {"k": "m", "x": 633, "y": 427, "id": 203}, {"k": "m", "x": 215, "y": 370, "id": 204}, {"k": "m", "x": 104, "y": 345, "id": 205}, {"k": "m", "x": 103, "y": 237, "id": 206}, {"k": "m", "x": 210, "y": 213, "id": 207}, {"k": "m", "x": 683, "y": 241, "id": 208}, {"k": "m", "x": 684, "y": 337, "id": 209}, {"k": "m", "x": 781, "y": 335, "id": 210}, {"k": "m", "x": 779, "y": 242, "id": 211}, {"k": "m", "x": 867, "y": 243, "id": 212}, {"k": "m", "x": 438, "y": 99, "id": 213}, {"k": "m", "x": 438, "y": 472, "id": 214}, {"k": "m", "x": 307, "y": 225, "id": 215}, {"k": "m", "x": 309, "y": 332, "id": 216}, {"k": "m", "x": 870, "y": 335, "id": 217}, {"k": "r", "x": 245, "y": 96, "id": 300}, {"k": "r", "x": 744, "y": 160, "id": 301}, {"k": "r", "x": 210, "y": 430, "id": 302}, {"k": "r", "x": 779, "y": 406, "id": 303}, {"k": "r", "x": 832, "y": 444, "id": 304}, {"k": "r", "x": 210, "y": 289, "id": 305}, {"k": "r", "x": 195, "y": 141, "id": 306}, {"k": "r", "x": 816, "y": 149, "id": 307}, {"k": "r", "x": 736, "y": 453, "id": 308}, {"k": "r", "x": 718, "y": 101, "id": 309}]}, "start_cost": 10, "active": true, "name_en": "Demon Ant Queen", "description_en": "Defeat the Demon Ant Queen who has finally revealed herself!\n<Only female units may deploy>\nExtreme (★1 target: Avg Lv25)"}