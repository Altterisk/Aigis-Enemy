resist": 1500, "transform_resist": 1500, "pattern_id": 2123616, "race_id": 7, "master_id": 32682, "global_id": 6300, "spawn_sec": 120}, {"enemy_id": 14, "source": "local", "count": 9, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 700, "attack": 250, "base_hp": 1750, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 87, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123776, "race_id": 7, "missile_id": 45, "master_id": 32692, "global_id": 6310, "ranged": true, "spawn_sec": 216}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 7200, "attack": 220, "base_hp": 18000, "base_attack": 550, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 228, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119360, "race_id": 7, "master_id": 31869, "global_id": 5488, "spawn_sec": 340}, {"enemy_id": 16, "source": "local", "count": 2, "form_count": 1, "hp": 2400, "attack": 240, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "spawn_sec": 397}], "popups": ["渦潮は味方ユニットの\n遠距離攻撃を自身に引き付けます。\n\n渦潮は撃破数に含まれません。", "　　　悪天候：激流\n\n・敵の『移動速度』上昇\n・味方の『射程』減少\n・一部の味方は影響を受けない"], "dialogue": [{"trigger": "start", "lines": [{"name": "デューオ", "text": "――リバン、封印が解けかけてるって話じゃなかった！？\nもう完全に解けてるように見えるんだけど！", "face": "u594"}, {"name": "リバン", "text": "いえ、あれでもまだ不完全なのですわ！\n封印の地に縛られたままですもの！", "face": "u1062a1"}, {"name": "ハルフゥ", "text": "封印が解けかけただけで、\n海流まで変わってしまっていますね。\nこの力……バハムトの魔力を帯びた激流のようです。", "face": "u1118a1"}, {"name": "ハルフゥ", "text": "「激流」に込められた魔力のせいで、\n私たちの攻撃は遠くへ届かなくなりそうですね。", "face": "u1118a1"}, {"name": "ベアトリカ", "text": "どうせ敵は、この「激流」を利用してくるだろうな。\n環境全部が敵とは、胸が熱くなるぜ。", "face": "u157"}, {"name": "ピピン", "text": "あっ、それなら私たち風水使いの出番ですよ！\n海流も気象のひとつ、どうにか軽減してみせます！", "face": "u275"}, {"name": "ハルフゥ", "text": "あとは渦潮にもご注意を。\n遠距離攻撃は吸い寄せられてしまうはずですから、\n迅速に破壊していったほうが良いでしょう。", "face": "u1118a1"}, {"name": "ベアトリカ", "text": "――よし、対策は十分だな？\n王子、そろそろ覚悟は決まったかい？", "face": "u157"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "デューオ", "text": "はは、伝説の神獣と戦えるからって、\nちょっと楽しそうな顔してるように見えるよ？", "face": "u594"}, {"name": "デューオ", "text": "それじゃあ王子、全部隊に号令を！\n神獣バハムト再封印作戦、開始だ！！", "face": "u594"}]}, {"trigger": "battle", "at_sec": 165, "lines": [{"name": "フローガ", "text": "王子殿下、封印に亀裂が入っています！\nこのままでは\n完全にバハムトが解き放たれてしまいます……！", "face": "u878"}, {"name": "アンナ", "text": "討伐を急ぐしかありませんね……。\n皆さん、火力を集中してください！", "face": "l6ad2d2ab4d1f"}]}, {"trigger": "battle", "at_sec": 339, "lines": [{"name": "ベアトリカ", "text": "まずい……おい王子！　封印が砕けそうだぞ！", "face": "u157"}, {"name": "デューオ", "text": "さすがは伝説の神獣、簡単にはいかないか……。\nでも諦める選択はないよね。\n全力でバハムトを倒すよ、王子！", "face": "u594"}]}, {"trigger": "route", "enemy_ids": [4100, 4201], "lines": [{"name": "ハルフゥ", "text": "――こ、これは、まずいです！！\nバハムトの封印が完全に解けました！！", "face": "u1118a1"}, {"name": "リバン", "text": "バハムトが、真の力を……。\nお、王子さま、一度撤退しましょう！！", "face": "u1062a1"}, {"name": "マルスィ", "text": "ですが、ここで退いては深海の都市が……！", "face": "u1065a1"}, {"name": "アンナ", "text": "……王子、判断はすべて、王子に委ねます。\nどうか慎重な判断をお願いします！", "face": "l6ad2d2ab4d1f"}]}, {"trigger": "route", "lines": [{"name": "キュステ", "text": "はぁ……はぁ……っ！\nお、王子さま、バハムトがどこかへ去っていきます……。", "face": "u1248a1"}, {"name": "ベアトリカ", "text": "ちっ、待ちやがれ！\n戻ってこい海蛇野郎！", "face": "u157"}, {"name": "アンナ", "text": "急いで追撃に――いえ、この状況では……それも……。", "face": "lcd5b67a8847f"}, {"name": "ヴィアベル", "text": "今は周囲の敵を片付けるしかないわ。\n皆、被害を抑えることに集中して！", "face": "u1247a1"}]}], "active": true}