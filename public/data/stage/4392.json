ist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "condition": 3}], "spawn_sec": 161}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "報告！　前方に敵を発見！", "face": "le4c54648adb1"}, {"name": "アンナ", "text": "こんな森の深くまで……。\n王子、急ぎ戦闘の準備を！", "face": "l1813779fe06c"}, {"name": "ダン", "text": "この湧き上がる力……！！　うおおお！！\n敵なんざこの拳で蹴散らしてやるぜ！！", "face": "u204"}, {"name": "ジーナ", "text": "ちょっとそれあたしのセリフ！！\nでもたしかにこの力、体がうずうずしてくる……！！\nきっとあの石碑のおかげだね！", "face": "u131"}, {"name": "暗黒騎士デシウス", "text": "ちぃっ、もう追いつかれたか。", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "オークよ。ご所望の強い奴が来たぞ。", "face": "ld336215cf73a"}, {"name": "オーク", "text": "来たか……。待ちくたびれるところだった。", "face": "l0632d7f6f22d"}, {"name": "オーク", "text": "魔術師も合流したことだし、\nここからはもっと楽しい戦いになるだろう……。", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "お前たちの強さは誰もが恐れをなすほど。\n思う存分戦うといい。", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "どれ。我輩は近くの道を行く。\nオークたちは他の道を抑えておいてくれないか？", "face": "ld336215cf73a"}, {"name": "オーク", "text": "任せろ。", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "（さすがはこの我輩。\nもはやオークなど我輩の手の内よ）", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "（やはり我輩には統率する力が備わっている。\nあとはアレさえあれば……）", "face": "ld336215cf73a"}]}, {"trigger": "end", "lines": [{"name": "リコラ", "text": "撃退はできたけど、\nやっぱり敵の目的は見えないままだね。", "face": "u289"}, {"name": "アンナ", "text": "とはいえこのまま見過ごすわけにもいきません。\n王子、先へ進みましょう。", "face": "l1813779fe06c"}]}], "map": {"image": "Map920051_3620", "w": 960, "h": 640, "spots": [{"k": "b", "x": 952, "y": 207}, {"k": "b", "x": 839, "y": 533}, {"k": "b", "x": 2, "y": 446}, {"k": "b", "x": 3, "y": 167}, {"k": "m", "x": 101, "y": 178, "id": 200}, {"k": "m", "x": 173, "y": 357, "id": 201}, {"k": "m", "x": 209, "y": 454, "id": 202}, {"k": "m", "x": 568, "y": 150, "id": 203}, {"k": "m", "x": 736, "y": 271, "id": 204}, {"k": "m", "x": 561, "y": 470, "id": 205}, {"k": "m", "x": 759, "y": 368,