e_id": 8, "change_to": 3, "change_condition": 3, "master_id": 366, "global_id": 365, "to_condition": 3, "to_global_id": 366, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "physical", "armor_defense": 450, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102240, "race_id": 8, "master_id": 367, "global_id": 366, "from_condition": 3}, {"enemy_id": 5, "source": "local", "count": 42, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 3}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 6, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 161}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "報告！　前方に敵を発見！", "face": "le4c54648adb1"}, {"name": "アンナ", "text": "こんな森の深くまで……。\n王子、急ぎ戦闘の準備を！", "face": "l1813779fe06c"}, {"name": "ダン", "text": "この湧き上がる力……！！　うおおお！！\n敵なんざこの拳で蹴散らしてやるぜ！！", "face": "u204"}, {"name": "ジーナ", "text": "ちょっとそれあたしのセリフ！！\nでもたしかにこの力、体がうずうずしてくる……！！\nきっとあの石碑のおかげだね！", "face": "u131"}, {"name": "暗黒騎士デシウス", "text": "ちぃっ、もう追いつかれたか。", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "オークよ。ご所望の強い奴が来たぞ。", "face": "ld336215cf73a"}, {"name": "オーク", "text": "来たか……。待ちくたびれるところだった。", "face": "l0632d7f6f22d"}, {"name": "オーク", "text": "魔術師も合流したことだし、\nここからはもっと楽しい戦いになるだろう……。", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "お前たちの強さは誰もが恐れをなすほど。\n思う存分戦うといい。", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "どれ。我輩は近くの道を行く。\nオークたちは他の道を抑えておいてくれないか？", "face": "ld336215cf73a"}, {"name": "オーク", "text": "任せろ。", "face": "l0632d7f6f22d"}, {"name": "暗黒騎士デシウス", "text": "（さすがはこの我輩。\nもはやオークなど我輩の手の内よ）", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "（やはり我輩には統率する力が備わっている。\nあとはアレさえあれば……）", "face": "ld336215cf73a"}]}, {"trigger": "end", "lines": [{"name": "リコラ", "text": "撃退はできたけど、\nやっぱり敵の目的は見えないままだね。", "face": "u289"}, {"name": "アンナ", "text": "とはいえこのまま見過ごすわけにもいきません。\n王子、先へ進みましょう。", "face": "l1813779fe06c"}]}], "story_talk": true, "active": true}