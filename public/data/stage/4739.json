 1000, "pattern_id": 2099968, "race_id": 16, "change_to": 12, "change_condition": 5, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 977, "global_id": 976, "ranged": true, "to_condition": 5, "to_global_id": 977, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 119}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_interval": 76, "move_speed": 4500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099968, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 978, "global_id": 977, "ranged": true, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "シノさんのおかげで、\n東の国にいる妖怪たちも、\n少しずつまとまってきているようですね。"}, {"name": "カゲロウ", "text": "とは言え、シノの配下でない妖怪は、\n未だに人間を襲っている。\n全てが終わったとは言えな………ン？　何奴！？", "face": "u139"}, {"name": "鬼刃衆", "text": "――気づかれては仕方がない。\nいや、簡単に気づかれてしまう程に\n我らの力が強大になっているということか……ふふふ。", "face": "lbf9912b568cc"}, {"name": "カゲロウ", "text": "今度は、一体何をその身に宿したのか……。", "face": "u139"}, {"name": "鬼刃衆", "text": "ほう……。\nどうやら我らが体内に魔神アガレスの残片を\n取り込んだことを察しているようだな……。", "face": "lbf9912b568cc"}, {"name": "アンナ", "text": "魔神アガレスの残片！？\nということは、まさか……！", "face": "l8ec88efe61fd"}, {"name": "鬼刃衆", "text": "理解したところで、時既に遅しッ！\n我ら鬼刃衆と魔神の力、しかとその身に刻むがいい！", "face": "lbf9912b568cc"}]}, {"trigger": "end", "lines": [{"name": "鬼刃衆", "text": "王子……さすがの強さだな。\n魔神アガレスの力をもってしても\n倒せないとは……。", "face": "lbf9912b568cc"}, {"name": "カゲロウ", "text": "まったく……力に振り回され過ぎなんだ。\nそんなふうに無闇に力を求めたところで\n何の意味も成さないというのに……。", "face": "u139"}, {"name": "鬼刃姫", "text": "――勝手な言い草ね。\n戦うことの意味は、あてたちが決すべき事柄よ。", "face": "u435"}, {"name": "鬼刃衆", "text": "鬼刃姫様ッ！\n今の戦い、ご覧になっていたのですか？", "face": "lbf9912b568cc"}, {"name": "鬼刃姫", "text": "勿論よ。\n……あての目算では、あなた達の力は\n今回の戦いをもって、十分な域に達しつつあるわ。", "face": "u435"}, {"name": "鬼刃衆", "text": "そ、それでは……ついに！？", "face": "lbf9912b568cc"}, {"name": "鬼刃姫", "text": "……機は、熟した。\n決戦の時は近いわよ……。", "face": "u435"}]}], "map": {"image": "Map920077_3750", "w": 960, "h": 640, "spots": [{"k": "b", "x": 8, "y": 374}, {"k": "m", "x": 282, "y": 380, "id": 200}, {"k": "m", "x": 293, "y": 449, "id": 201}, {"k": "m", "x": 358, "y": 289, "id": 202}, {"k": "m", "x": 369, "y": 370, "id": 203}, {"k": "m", "x": 382, "y": 453, "id": 204}, {"k": "m", "x": 524, "y": 437, "id": 205}, {"k": "m", "x": 506, "y": 354, "id": 206}, {"k": "m", "x": 490, "y": 273, "id": 207}, {"k": "m", "x": 578, "y": 259, "id": 208}, {"k": "m", "x": 598, "y": 339, "id": 209}, {"k": "m", "x": 619, "y": 420, "id": 210}, {"k": "m", "x": 665, "y": 243, "id": 211}, {"k": "m", "x": 689, "y": 325, "id": 212}, {"k": "m", "x": 712, "y": 405, "id": 213}, {"k": "m", "x": 272, "y": 310, "id": 214}, {"k": "m", "x": 798, "y": 229, "id": 215}, {"k": "m", "x": 823, "y": 304, "id": 216}, {"k": "m", "x": 849, "y": 377, "id": 217}, {"k": "m", "x": 186, "y": 309, "id": 218}, {"k": "m", "x": 187, "y": 371, "id": 219}, {"k": "m", "x": 193, "y": 435, "id": 220}, {"k": "m", "x": 104, "y": 298, "id": 221}, {"k": "m", "x": 105, "y": 361, "id": 222}, {"k": "m", "x": 104, "y": 425, "id": 223}, {"k": "r", "x": 272, "y": 244, "id": 300}, {"k": "r", "x": 607, "y": 202, "id": 301}, {"k": "r", "x": 832, "y": 175, "id": 302}, {"k": "r", "x": 902, "y": 404, "id": 303}, {"k": "r", "x": 782, "y": 435, "id": 304}, {"k": "r", "x": 557, "y": 471, "id": 305}, {"k": "r", "x": 345, "y": 234, "id": 306}, {"k": "r", "x": 533, "y": 215, "id": 307}, {"k": "r", "x": 144, "y": 239, "id": 308}, {"k": "r", "x": 52, "y": 477, "id": 309}, {"k": "r", "x": 439, "y": 479, "id": 310}]}, "active": true, "story_talk": true}