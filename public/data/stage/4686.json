{"quest_id": 4686, "name": "蔓延する疫病", "description": "さらに激しくなる魔物の\n襲撃を食い止めよ！\n＜味方ユニットの攻撃力減少：小＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["味方ユニットの攻撃力減少：小"], "event": "帝国の治癒士", "event_category": "History", "mission_id": 920074, "map_no": 3841, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [70]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 9, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 9}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 30}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 39}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 61}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 81}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 92}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 117}], "dialogue": [{"trigger": "start", "lines": [{"name": "バーガン", "text": "なあ、お頭……山賊仲間たちも\nみんな疫病にかかっちまったようだ……。\n……あんたも、さっきから辛そうだぜ？", "face": "u68"}, {"name": "モーティマ", "text": "ヘッ、このモーティマ様が\nたかだか病気ごときにやられるわけねぇだろ！", "face": "u14"}, {"name": "山賊手下", "text": "……お頭、腕がブルブルしてますぜ……。\nもう斧を振るう事さえ無理なんじゃあ……。", "face": "u4"}, {"name": "モーティマ", "text": "う、うるせぇ！\n余計な事言ってんじゃねぇ！", "face": "u14"}, {"name": "アンナ", "text": "身体の丈夫なモーティマさんでさえ\n弱ってしまっているなんて……。", "face": "lb7312ce8ed63"}, {"name": "アリサ", "text": "病がどんどん兵士たちに広がっていますね。\n早く解決策を見つけないと……。", "face": "u24"}, {"name": "兵士", "text": "――報告！！\n魔物が前方より攻めてきます！", "face": "lade201cbece2"}, {"name": "モーティマ", "text": "……病気だろうがなんだろうが、\n魔物はおかまいなしだ……。\n弱音吐いてる場合じゃねぇ、戦いに行くぞ！　", "face": "u14"}]}, {"trigger": "end", "lines": [{"name": "モーティマ", "text": "……ハァ、はぁ……ど、どうだ……！\nここらの魔物は全部倒してやったぜ……。", "face": "u14"}, {"name": "バーガン", "text": "おい、お頭！？\n異常なくらい汗かいてるぞ……。\nもう無理しないで少し休んでくれ！", "face": "u68"}, {"name": "アリサ", "text": "モーティマさん、私の治癒術を試させてください。\nはぁ――ッ！", "face": "u24"}, {"name": "モーティマ", "text": "…………おい、真面目にやってくれてるのか？\nぜんぜん楽にならねぇぞ……？", "face": "u14"}, {"name": "アリサ", "text": "予想はしていましたが……、\nやはり、私の治癒術では治せないようですね。\n一体どうすれば……。", "face": "u24"}, {"name": "アトラ", "text": "――お、王子！\nお待ち下さい……ハァ、ハァ……。\nようやくあなたを見つけました……！", "face": "u119"}, {"name": "アトラ", "text": "僕たちのエルフの里に疫病が広まってしまって、\n皆が病に伏せているのですが……、\nそこにダークエルフが襲撃してきてるのです！", "face": "u119"}, {"name": "ユリアン", "text": "エルフの里にも疫病が……！？\nいや、それよりもダークエルフの襲撃が\nこんな時に重なるなんて……何か妙だぜ。", "face": "u7"}, {"name": "アンナ", "text": "王子、エルフの里へと急ぎ向かいましょう！", "face": "lab3e5c39447d"}]}], "active": true}