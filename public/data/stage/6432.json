nt": 2, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "change_to": 6, "master_id": 30343, "global_id": 3962}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 116}, {"enemy_id": 10, "source": "local", "count": 5, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "ジョヴァンニ", "text": "ヒューッ！\n海の上で授業とはイカしてんじゃねえか！", "face": "u611"}, {"name": "レーレン", "text": "よーし、みんな集まったな？\nそれではこれより、\n今回の課外授業の目的を説明するぜ！", "face": "u614"}, {"name": "レーレン", "text": "魔物との戦闘では、敵の性質に合わせて\n兵の特性を活かすような戦術・陣形を組むのが基本だ。", "face": "u614"}, {"name": "レーレン", "text": "無論その大部分は指揮官の仕事だが、\n個々の兵自身も、自分が戦場で果たすべき役割を\n正しく理解しておくことが重要なんだぜ！", "face": "u614"}, {"name": "レーレン", "text": "今回の課外授業では、\nそいつを学んでもらおうってわけだ。", "face": "u614"}, {"name": "ケイティ", "text": "（む……思いのほか良いことをおっしゃっていますね）", "face": "u114"}, {"name": "ジョヴァンニ", "text": "役割だぁ？　ハッ、くだらねぇな。\nどんな敵だろうと、\n俺とこの相棒にぶち抜けねぇモンなんざ――", "face": "u611"}, {"name": "レーレン", "text": "まぁ聞けオシャレ番長。\n今回の授業で出現する敵には、\n海賊であるお前の銃が有効なんだ。", "face": "u614"}, {"name": "レーレン", "text": "海上で魔物と戦う場合は特に、\n空や水中から接近してくる敵に\n対処する必要があるからな。", "face": "u614"}, {"name": "レーレン", "text": "そういう敵は、遠距離から攻撃できる弓や銃で\n近づかれる前に撃ち抜くのがセオリーなんだぜ！\n硬い敵でも銃の威力なら弾かれにくいしな！", "face": "u614"}, {"name": "メーリス", "text": "あ、あの……先生、\nそうこう言っているうちに魔物が……。", "face": "u609"}, {"name": "レーレン", "text": "にひひ、いいタイミングだ。\nそれじゃあジョヴァンニ君、後は任せたぜ！", "face": "u614"}, {"name": "ジョヴァンニ", "text": "あぁ。\n飛んでる敵、遠くの敵をぶち抜くのが\n俺の役目っつったな……。", "face": "u611"}, {"name": "ジョヴァンニ", "text": "おもしれえ、やってやるぜ！\n雑魚どもが近づいてくる前に全員海に沈めてやらあッ！", "face": "u611"}, {"name": "アンナ", "text": "王子、ジョヴァンニさんを援護しましょう。"}]}, {"trigger": "end", "lines": [{"name": "ネーニャ", "text": "ほ、本当にジョヴァンニが\n近づいてくる前に魔物を倒しちゃった。", "face": "u610"}, {"name": "ジョヴァンニ", "text": "ヒューッ、こいつはすげぇや！\nこの俺と相棒の技がここまでうまくハマるとはな！", "face": "u611"}, {"name": "レーレン", "text": "どうだ？\nあたしの講義も少しは役に立ったろ？", "face": "u614"}, {"name": "ジョヴァンニ", "text": "ああ、認めるぜ。\nいままでは銃の腕ばっか磨いてきたが、\nちーっと頭を使えばもっと活躍できるんだな。", "face": "u611"}, {"name": "ジョヴァンニ", "text": "これからも指導を頼むぜ、先生！", "face": "u611"}, {"name": "レーレン", "text": "もぉちろんイイぜっ！\nそれじゃあ、次の授業と行くか！", "face": "u614"}, {"name": "ジョヴァンニ", "text": "っしゃあ！", "face": "u611"}, {"name": "ネーニャ", "text": "おーっ！", "face": "u610"}, {"name": "メーリス", "text": "お、おーっ！", "face": "u609"}, {"name": "ケイティ", "text": "……なんだか盛り上がってきましたね。\nこういうタイプの先生は初めて見ました。", "face": "u114"}, {"name": "レーレン", "text": "――っと、次の授業には前もって準備が必要だから、\n参加希望者は休み時間の後に\n今から言う場所に来てくれよなっ！", "face": "u614"}, {"name": "メーリス", "text": "……どうしようか、ネーニャ？", "face": "u609"}, {"name": "ネーニャ", "text": "あたしは行く。\nジョヴァンニみたいに今よりもっと\n上手く戦える方法を教えてもらいたいもん。", "face": "u610"}, {"name": "メーリス", "text": "……そうよね。\nうん、ネーニャが行くなら私も行く。", "face": "u609"}, {"name": "アンナ", "text": "王子、私たちも次の授業に向かいましょう。"}]}], "story_talk": true, "active": true}