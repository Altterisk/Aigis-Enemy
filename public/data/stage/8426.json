": 86}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 60, "attack_range": 100, "attack_speed": 80, "attack_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097760, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 33, "global_id": 32, "ranged": true, "spawn_sec": 90}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 2, "hp": 80000, "attack": 2000, "base_hp": 80000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 20, "attack_wait": 75, "attack_interval": 241, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118528, "race_id": 12, "change_to": 8, "change_condition": 3, "master_id": 31747, "global_id": 5366, "to_condition": 3, "to_global_id": 5367, "spawn_sec": 127}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 80000, "attack": 1200, "base_hp": 80000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 300, "attack_range": 200, "attack_speed": 20, "attack_wait": 50, "attack_interval": 137, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118544, "race_id": 12, "special_effect_id": 374, "missile_id": 357, "missile": {"speed": 10.0}, "master_id": 31748, "global_id": 5367, "ranged": true, "from_condition": 3}, {"enemy_id": 10, "source": "local", "count": 14, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "spawn_sec": 134}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 190, "attack_interval": 442, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115088, "race_id": 11, "master_id": 31082, "global_id": 4701, "spawn_sec": 145}, {"enemy_id": 12, "source": "local", "count": 7, "form_count": 1, "hp": 2400, "attack": 650, "base_hp": 2400, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "master_id": 24, "global_id": 23, "spawn_sec": 147}], "popups": ["森の守護獣がいる間は\n敵の獣の防御が\n大幅にアップします。\n\nまた森の守護獣がいる間は、\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "セーラ", "text": "随分森の奥まで来ましたね。\nここに守護獣がいるのですか？", "face": "u2317a1"}, {"name": "メープル", "text": "うん！　森の動物たちが教えてくれたの！\n守護獣はこのあたりにいるって！", "face": "u2315a1"}, {"name": "ルチア", "text": "見た所ただの雪原だが……。\nいや待て、あそこに何かいるぞ。", "face": "u2318a1"}]}, {"trigger": "start", "lines": [{"name": "？？？", "text": "ワァ！？　また人間がいる！", "face": "lcddc14d06801"}, {"name": "ラピス", "text": "小さいトナカイのように見えるな。\nだが、そこらの動物とは雰囲気が違う。", "face": "u2316a1"}, {"name": "セーラ", "text": "あちらが守護獣ということでしょうか。\n言葉が通じるようですし、声をかけて――。", "face": "u2317a1"}, {"name": "？？？", "text": "――僕はね、怒ってるんだよ！\n人間たちが森を荒らして、\nみんなを捕まえようとするから！", "face": "lcddc14d06801"}, {"name": "森の守護獣", "text": "やっぱり人間は悪なんだ……！\n森の守護獣として、人間は滅ぼさなきゃ……！", "face": "lcddc14d06801"}, {"name": "森の守護獣", "text": "ああ、父よ母よ、森の仲間よ。\n死という安易な解決に頼る僕を許して！", "face": "lcddc14d06801"}, {"name": "メープル", "text": "だ、だめ！　守護獣は\n攻撃的な気持ちでいっぱいだよぉ！？", "face": "u2315a1"}, {"name": "ルチア", "text": "攻撃的というか殺気立っているというか……。\nとにかく話を聞いてもらえる雰囲気ではないぞ。", "face": "u2318a1"}, {"name": "森の守護獣", "text": "キミたちはさ！　どの木が好き？\n養分になるんだからさァ！\nどれの下に埋まりたいか教えてよ！", "face": "lcddc14d06801"}, {"name": "セーラ", "text": "言葉は通じましたが、\n残念なことに話が通じる状態ではないようです。", "face": "u2317a1"}, {"name": "ラピス", "text": "だが私たちが倒されてはたまらん。\n一旦大人しくさせるぞ！", "face": "u2316a1"}, {"name": "メープル", "text": "う、うん！　守護獣さん、ごめんね！", "face": "u2315a1"}]}, {"trigger": "end", "lines": [{"name": "森の守護獣", "text": "僕がこの森を守るんだ……！\nそのために滅ぼすべきだよね！　全部！", "face": "lcddc14d06801"}, {"name": "メープル", "text": "守護獣さん、落ち着いて！\nメープルたちは、森のみんなを助けにきたの！", "face": "u2315a1"}, {"name": "森の守護獣", "text": "そうなの……？", "face": "lcddc14d06801"}, {"name": "メープル", "text": "うん！　そうだよ！\nだから安心して！", "face": "u2315a1"}, {"name": "森の守護獣", "text": "じゃあ誰の血で角を赤く染めればいいの……？", "face": "lcddc14d06801"}, {"name": "メープル", "text": "誰の血もながさないでよぉ……！", "face": "u2315a1"}, {"name": "セーラ", "text": "聞き分けはいいようですが、\n少々ワイルドすぎでございますね。", "face": "u2317a1"}, {"name": "森の守護獣", "text": "キミは心優しいみたいだ……。\nだったら、人間は善い存在なのかな……。", "face": "lcddc14d06801"}, {"name": "ラピス", "text": "……とりあえず肯定しておけば大人しくなりそうだな。", "face": "u2316a1"}, {"name": "ルチア", "text": "シッ！　丸く収まりそうですから、\n少し静かにしててください！", "face": "u2318a1"}, {"name": "メープル", "text": "この森の動物たちは、密猟されそうになったり、\n酷い目にあってきたと思う。", "face": "u2315a1"}, {"name": "メープル", "text": "でも、人間は悪い人ばっかりじゃないんだよ。\nだから、メープルたちを信じて！", "face": "u2315a1"}, {"name": "森の守護獣", "text": "そっか……なら、キミを信じて――。", "face": "lcddc14d06801"}, {"name": "スリー", "text": "――ヤーハーッ！\n密猟の時間だぜェー！！", "face": "le4f4702567ad"}]}], "active": true}