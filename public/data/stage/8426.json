{"quest_id": 8426, "name": "思い込みの激しいトナカイ", "description": "密猟者を追う王子たちは森の守護獣と遭遇。\n対話を試みようとするも何やら様子が……？\n＜特定のタイミングで吹雪が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "聖なる森と闇の組織", "event_category": "History", "mission_id": 920223, "map_no": 4985, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 4, "hp": 32000, "attack": 1250, "base_hp": 32000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 70, "attack_wait": 70, "attack_interval": 261, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157552, "race_id": 11, "special_effect_id": 1912, "change_to": 1, "change_condition": 3, "master_id": 38121, "global_id": 11738, "to_condition": 3, "to_global_id": 11739, "sp_change_to": [38123], "commands": {"raw": "SetStageFlag(0, 0); DoEnemy_RegistCommand(\"OnModeChanged\", \"SetStageFlag(0, 1); DoEnemy_RemoveCommand( \"OnModeChanged\" );\");", "sets_flags": [[0, 0], [0, 1]], "on_mode_changed": true}, "route_behaviour": {"transforms": [{"to": 38123}, {}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "hp": 32000, "attack": 1500, "base_hp": 32000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_range": 240, "attack_speed": 70, "attack_wait": 70, "attack_interval": 191, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157568, "race_id": 11, "special_effect_id": 1912, "change_to": 2, "missile_id": 410, "missile": {"speed": 8.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 38122, "global_id": 11739, "ranged": true, "from_condition": 3, "to_global_id": 11741}, {"enemy_id": 1, "source": "local", "count": 1, "form_index