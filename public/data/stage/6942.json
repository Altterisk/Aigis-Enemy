{"quest_id": 6942, "name": "縁起を担ぐ破魔矢祭", "description": "矢を射る縁起の良いお祭りが開催！\n威力を抑えた破魔矢で\n今年の運気を上げろ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ26(2019)", "event_category": "Reproduce", "mission_id": 300257, "map_no": 5842, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 300, "gold": 800, "drops": [{"item": 2003, "c": 1}, {"item": 1005, "c": 2}, {"card": 56, "c": 1}, {"card": 946}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 7000, "attack": 200, "base_hp": 7000, "base_attack": 200, "damage_type": "physical", "armor_defense": 80, "attack_range": 240, "attack_speed": 1, "attack_wait": 30, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120992, "race_id": 16, "special_effect_id": 222, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 32240, "global_id": 5859, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 5500, "attack": 180, "base_hp": 5500, "base_attack": 180, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_range": 240, "attack_speed": 1, "attack_wait": 30, "attack_interval": 87, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113968, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 32241, "global_id": 5860, "ranged": true, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 90, "base_hp": 9000, "base_attack": 90, "damage_type": "physical", "armor_defense": 40, "attack_range": 220, "attack_speed": 30, "attack_wait": 10, "attack_interval": 30, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 12, "special_effect_id": 53, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30810, "global_id": 4429, "ranged": true, "spawn_sec": 7}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 4000, "attack": 150, "base_hp": 4000, "base_attack": 150, "damage_type": "physical", "armor_defense": 30, "attack_range": 380, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107280, "race_id": 16, "special_effect_id": 222, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30812, "global_id": 4431, "ranged": true, "spawn_sec": 9}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 11000, "attack": 180, "base_hp": 11000, "base_attack": 180, "damage_type": "physical", "armor_defense": 60, "magic_defense": 20, "attack_range": 200, "attack_speed": 40, "attack_wait": 20, "attack_interval": 86, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107120, "race_id": 16, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30808, "global_id": 4427, "ranged": true, "spawn_sec": 9}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 12000, "attack": 120, "base_hp": 12000, "base_attack": 120, "damage_type": "physical", "armor_defense": 50, "attack_range": 260, "attack_speed": 30, "attack_wait": 10, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113536, "race_id": 16, "special_effect_id": 257, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30806, "global_id": 4425, "ranged": true, "spawn_sec": 32}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 100, "base_hp": 10000, "base_attack": 100, "damage_type": "physical", "armor_defense": 50, "attack_range": 250, "attack_speed": 30, "attack_wait": 10, "attack_interval": 66, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097984, "race_id": 16, "special_effect_id": 226, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30807, "global_id": 4426, "ranged": true, "spawn_sec": 34}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 200, "base_hp": 15000, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 5, "attack_range": 330, "attack_speed": 1, "attack_wait": 10, "attack_interval": 51, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120208, "special_effect_id": 235, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 32242, "global_id": 5861, "ranged": true, "spawn_sec": 37}], "dialogue": [{"trigger": "start", "lines": [{"name": "ユージェン", "text": "――破魔矢を、射つのか！？", "face": "u906"}, {"name": "バシラ", "text": "あはは……以前は間違えて\n射っちゃったんですけどね。", "face": "u28"}, {"name": "ソーマ", "text": "どうやら街の皆さんには好評だったみたいで、\nとうとうそういうお祭りになっちゃったんです。", "face": "u23"}, {"name": "ナナリー", "text": "縁起の良い矢を射るのだから、\n縁起が良いお祭りには違いない……と思います。", "face": "u29"}, {"name": "フウカ", "text": "――でも、街の人に怪我をさせないように、\n十分に注意してお祭りを楽しむのよ？", "face": "u946"}, {"name": "アーシェラ", "text": "射っていいのは武装している仲間だけだ。\n翻って、武装しているならいくら射ってもいい。", "face": "u391"}, {"name": "リナリア", "text": "で、でも、あんまり痛くないように当てましょうね。\n破魔矢は痛くないように作ってあるらしいですけど……。", "face": "u592"}, {"name": "ユージェン", "text": "郷に入れば郷に従え、とはこういうことか。\nなれば我が漆黒の同胞よ、\n共に聖なる矢を射る祭りを楽しもうじゃないか！", "face": "u906"}, {"name": "リタ", "text": "こ、声が大きいです！\nでも負けませんからね、ユージェン。", "face": "u178"}, {"name": "フウカ", "text": "ふふっ、仲が良くてよろしい♪\nそれじゃあ破魔矢を配るわね。", "face": "u946"}, {"name": "フウカ", "text": "縁起物の破魔矢なんだから、\nいっぱい王子に当ててあげましょ♪", "face": "u946"}]}, {"trigger": "end", "lines": [{"name": "フウカ", "text": "ふぅ、射ち尽くしちゃったわ……。\nどう王子、運勢が上がってきた感じはするかしら？", "face": "u946"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "フウカ", "text": "ふふっ、それなら今年は、\nきっと良いことばかりね♪", "face": "u946"}, {"name": "バシラ", "text": "それじゃあ、外にいて身体も冷えてしまいましたし、\n甘酒でも飲みに行きましょうか。", "face": "u28"}, {"name": "ソーマ", "text": "あ、甘酒は、ちょっと……そのぉ……。", "face": "u23"}, {"name": "アンナ", "text": "ふふっ、無事に破魔矢の祭りは終わったようですね。\n今日くらいは王子も、\nゆっくりと羽を伸ばしてくださいね♪"}]}], "map": {"image": "Map5842", "w": 960, "h": 640, "spots": [{"k": "b", "x": 892, "y": 529}, {"k": "m", "x": 385, "y": 200, "id": 200}, {"k": "m", "x": 146, "y": 264, "id": 201}, {"k": "m", "x": 490, "y": 263, "id": 202}, {"k": "m", "x": 573, "y": 204, "id": 203}, {"k": "m", "x": 657, "y": 149, "id": 204}, {"k": "m", "x": 299, "y": 147, "id": 205}, {"k": "m", "x": 225, "y": 207, "id": 206}, {"k": "m", "x": 737, "y": 211, "id": 207}, {"k": "m", "x": 830, "y": 276, "id": 208}, {"k": "m", "x": 572, "y": 324, "id": 209}, {"k": "m", "x": 742, "y": 332, "id": 210}, {"k": "m", "x": 739, "y": 435, "id": 211}, {"k": "m", "x": 494, "y": 496, "id": 212}, {"k": "m", "x": 661, "y": 384, "id": 213}, {"k": "m", "x": 576, "y": 445, "id": 214}, {"k": "m", "x": 404, "y": 318, "id": 215}, {"k": "m", "x": 228, "y": 328, "id": 216}, {"k": "m", "x": 314, "y": 382, "id": 217}, {"k": "m", "x": 401, "y": 438, "id": 218}, {"k": "m", "x": 814, "y": 481, "id": 219}, {"k": "m", "x": 65, "y": 314, "id": 220}, {"k": "m", "x": 223, "y": 97, "id": 221}, {"k": "m", "x": 900, "y": 233, "id": 222}, {"k": "m", "x": 725, "y": 97, "id": 223}, {"k": "r", "x": 248, "y": 417, "id": 300}, {"k": "r", "x": 190, "y": 378, "id": 301}, {"k": "r", "x": 195, "y": 149, "id": 302}, {"k": "r", "x": 786, "y": 175, "id": 303}, {"k": "r", "x": 749, "y": 517, "id": 304}, {"k": "r", "x": 672, "y": 465, "id": 305}, {"k": "r", "x": 407, "y": 377, "id": 306}, {"k": "r", "x": 588, "y": 263, "id": 307}, {"k": "r", "x": 312, "y": 218, "id": 308}, {"k": "r", "x": 490, "y": 432, "id": 309}, {"k": "r", "x": 659, "y": 309, "id": 310}, {"k": "r", "x": 376, "y": 261, "id": 311}, {"k": "r", "x": 798, "y": 386, "id": 3