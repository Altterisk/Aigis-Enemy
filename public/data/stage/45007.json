ce_id": 2, "change_to": 19, "change_condition": 2, "missile_id": 33, "missile": {"speed": 5.0}, "master_id": 41242, "ranged": true, "to_condition": 2, "spawn_sec": 324}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 55000, "attack": 800, "base_hp": 55000, "base_attack": 800, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100880, "race_id": 2, "missile_id": 34, "missile": {"speed": 5.0}, "master_id": 41243, "ranged": true, "from_condition": 2}, {"enemy_id": 21, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "hp": 42000, "attack": 750, "base_hp": 42000, "base_attack": 750, "damage_type": "magical", "armor_defense": 200, "attack_range": 210, "attack_speed": 1, "attack_wait": 25, "attack_interval": 141, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130976, "race_id": 2, "missile_id": 609, "missile": {"speed": 10.0}, "master_id": 40725, "global_id": 14342, "ranged": true, "spawn_sec": 337}, {"enemy_id": 22, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 41241, "ranged": true, "spawn_sec": 422}], "popups": ["神像リヴァイアサンは\n天眼のカタパルトの攻撃を\n当てることで段階的に\n弱体化することが可能です。\n\n\n\n　　　　　　(1/3)", "青い神像リヴァイアサンは\n全てのダメージを\n一定値以下に軽減します。\n\n\n\n\n　　　　　　(2/3)", "赤い神像リヴァイアサンは\n味方ユニットから受ける\n全てのダメージを30％軽減します。\n\n赤い神像リヴァイアサンが\n破損した状態になると\n全てのダメージを70％軽減します。\n　　　　　　(3/3)"], "dialogue": [{"trigger": "start", "lines": [{"name": "クローディア", "text": "――あらためて見ると、\n本当に大きいですねぇ……。", "face": "u163"}, {"name": "シビラ", "text": "背中に国家ひとつを背負っているのだもの。\n――それで、こちら側の作戦は？", "face": "u2940a1"}, {"name": "アナーニャ", "text": "天眼ノ国、王国連合軍は、\nリヴァイアサンの暴走に対し、\n迎え撃つ形での戦闘となります。", "face": "u2873a1"}, {"name": "アナーニャ", "text": "いくつかの地点には、\n既にカタパルトを設置しました。", "face": "u2873a1"}, {"name": "アイシャ", "text": "へぇ……発射の指示は？", "face": "u181"}, {"name": "アナーニャ", "text": "「カタパルトの前に兵を配置」してもらえば、\n攻撃を放つよう指示してあります。", "face": "u2873a1"}, {"name": "アナーニャ", "text": "リヴァイアサンが攻撃可能地点へ到達したら、\n発射の命令をお願いします。\n……タイミングを逃さないようにお気をつけて。", "face": "u2873a1"}, {"name": "プリヤンカ", "text": "でもさ、あんなデッカイリヴァイアサンに、\nただのカタパルトで本当に効果あるの？", "face": "u2808a1"}, {"name": "アナーニャ", "text": "カタパルトは、あくまで攻撃の補助ですね。\nリヴァイアサンの持つ、攻撃を軽減する結界を\n砲撃によって引き剥がすのが主な目的です。", "face": "u2873a1"}, {"name": "レン", "text": "ふむ。あとは、誰に\nその命令伝達役を任せるかですが――", "face": "u127"}, {"name": "ラージヴィール", "text": "――フゥゥゥゥハハハハーッ！\n王子よ！　再び肩を並べて戦う日が来たぞ！", "face": "l4ebe7bd5270c"}, {"name": "三つ目の従者", "text": "閣下、喜びすぎです。", "face": "l0da42f6d0d27"}, {"name": "ラージヴィール", "text": "フフフ、王子よ、\n我が軍勢も此度の戦いに参加する。", "face": "l4ebe7bd5270c"}, {"name": "ラージヴィール", "text": "カタパルトへの伝令役の兵も貸し与えるがゆえ、\n存分に活躍させてやってほしい！", "face": "l4ebe7bd5270c"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アイシャ", "text": "それじゃあ、実り多い戦いにしよう。\nある意味では、これが国家間の今後を占う戦いにもなる。\nみんな、全力を出し切って！", "face": "u181"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "ラージヴィール", "text": "王子よ！　リヴァイアサンが\nカタパルトの射程圏内に入ったぞ！", "face": "l4ebe7bd5270c"}, {"name": "三つ目の従者", "text": "カタパルトに発射の命令を！", "face": "l0da42f6d0d27"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "アナーニャ", "text": "カタパルトの射程圏内を抜けたようね。", "face": "u2873a1"}, {"name": "ニハラ", "text": "リヴァイアサン、依然進行中です！", "face": "u2888a1"}]}, {"trigger": "route", "enemy_ids": [10], "lines": [{"name": "リヴァイアサン", "text": "グォォォォォッ！！", "face": "l5ccbb6f64176"}, {"name": "プリヤンカ", "text": "カタパルトによる砲撃、命中確認！", "face": "u2808a1"}]}, {"trigger": "route", "enemy_ids": [10], "lines": [{"name": "リヴァイアサン", "text": "グォォォォォッ！！", "face": "l5ccbb6f64176"}, {"name": "プリヤンカ", "text": "カタパルトによる砲撃、命中確認！", "face": "u2808a1"}, {"name": "ラージヴィール", "text": "よし王子、王国の力を見せてみよ！\n攻撃を集中するのだ！", "face": "l4ebe7bd5270c"}]}], "map": {"image": "Map7486", "w": 960, "h": 640, "spots": [{"k": "b", "x": 16, "y": 238}, {"k": "b", "x": 10, "y": 479}, {"k": "m", "x": 233, "y": 270, "id": 200}, {"k": "m", "x": 121, "y": 262, "id": 201}, {"k": "m", "x": 108, "y": 184, "id": 202}, {"k": "m", "x": 112, "y": 483, "id": 203}, {"k": "m", "x": 269, "y": 145, "id": 204}, {"k": "m", "x": 382, "y": 239, "id": 205}, {"k": "m", "x": 454, "y": 163, "id": 206}, {"k": "m", "x": 432, "y": 88, "id": 207}, {"k": "m", "x": 416, "y": 202, "id": 208}, {"k": "m", "x": 327, "y": 143, "id": 209}, {"k": "m", "x": 281, "y": 472, "id": 210}, {"k": "m", "x": 342, "y": 474, "id": 211}, {"k": "m", "x": 524, "y": 479, "id": 212}, {"k": "m", "x": 590, "y": 469, "id": 213}, {"k": "m", "x": 734, "y": 495, "id": 214}, {"k": "m", "x": 839, "y": 484, "id": 215}, {"k": "m", "x": 860, "y": 377, "id": 216}, {"k": "m", "x": 215, "y": 474, "id": 217}, {"k": "m", "x": -239, "y": 932, "id": 218}, {"k": "r", "x": 586, "y": 388, "id": 300, "buff": [[202, 155, 0]]}, {"k": "r", "x": 582, "y": 128, "id": 301, "buff": [[202, 155, 0]]}, {"k": "r", "x": 795, "y": 335, "id": 302}, {"k": "r", "x": 181, "y": 307, "id": 303}, {"k": "r", "x": 534, "y": 418, "id": 304}, {"k": "r", "x": 225, "y": 199, "id": 305}, {"k": "r", "x": 530, "y": 162, "id": 306}], "events": [{"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "StageTowerPowerUp", "x": 582, "y": 160}]}, {"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_01", "fx": "StageTowerPowerUp2", "x": 582, "y": 130}]}, {"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_02", "fx": "StageTowerPowerUp", "x": 588, "y": 422}]}, {"t":