 "attack_range": 180, "attack_speed": 55, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114192, "race_id": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30948, "global_id": 4567, "ranged": true, "spawn_sec": 115}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109312, "race_id": 6, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30176, "global_id": 3795, "ranged": true, "spawn_sec": 118}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109328, "race_id": 6, "special_effect_id": 232, "change_to": 11, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30177, "global_id": 3796, "ranged": true, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 144}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 14, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 147}, {"enemy_id": 16, "source": "local", "count": 2, "form_count": 1, "hp": 8000, "attack": 550, "base_hp": 8000, "base_attack": 550, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105488, "race_id": 6, "special_effect_id": 215, "master_id": 30774, "global_id": 4393, "spawn_sec": 156}], "popups": ["ラッパを吹く天使がいる間は\n敵の天使の攻撃と防御が\nアップします。", "上位天使(戦斧)がいる間は\n全ての天使のHPが\n徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "天使", "text": "――セフィーレ様、観念なさってください。\nこれ以上、我らから逃げられるとお思いですか？", "face": "l3eb15fbca648"}, {"name": "セフィーレ", "text": "くっ……なぜ同じ天使である貴方たちが\n私を滅ぼそうとするのですか？", "face": "u638"}, {"name": "天使", "text": "主の御命令です。\n全て、主の仰せのままに……。", "face": "l3eb15fbca648"}, {"name": "セフィーレ", "text": "そんな……。主よ、お答えください。\n貴方はなぜ私をお見捨てになるのですか？", "face": "u638"}, {"name": "ヴェロッテ", "text": "――へへーん、一番乗り～っ！\nさぁ～て、このあたしが報告にあった\n天使同士の争いとやらをチャチャっと収めて……ん？", "face": "u150"}, {"name": "ニエル", "text": "あれは――セフィーレ？\nなぜ彼女が他の天使たちに襲われているんだ？", "face": "u206"}, {"name": "天使", "text": "……人間たちを確認。\n神の命を妨げんとする愚かな者たちよ、\n貴方たちも共に粛清して差し上げましょう。", "face": "l3eb15fbca648"}, {"name": "ヴェロッテ", "text": "うげっ、こっちに向かってきた！\n仕方ないわね……王子、やっちゃいましょ！", "face": "u150"}, {"name": "アンナ", "text": "ええ。それに事情はよくわかりませんが、\n集団で一人を虐げることが\n良いことであるはずがありません。", "face": "l70780bb26ee4"}, {"name": "アンナ", "text": "王子、ここはひとまず\nセフィーレという天使をお救いしましょう。", "face": "l70780bb26ee4"}]}, {"trigger": "end", "lines": [{"name": "セフィーレ", "text": "……なぜ助けたのですか？\n主の使いとして貴方たち人間と敵対していた私を。", "face": "u638"}, {"name": "アンナ", "text": "なぜ、と言われましても……。\n大勢が一人を襲っているのを\n放っておくことなんてできませんよ。", "face": "l70780bb26ee4"}, {"name": "セフィーレ", "text": "……まったく、理解に苦しみますね。", "face": "u638"}, {"name": "ヴェロッテ", "text": "な、なによその態度は。\nせっかく助けてあげたっていうのに。", "face": "u150"}, {"name": "セフィーレ", "text": "……主よ、私をお導きください。\n私はこれからどうすればよいのでしょうか……。", "face": "u638"}, {"name": "ヴェロッテ", "text": "さぁね。自分で考えたらいいんじゃない？", "face": "u150"}, {"name": "セフィーレ", "text": "な、なにを愚かな……。\n主のご意思にない考えを持つなど――", "face": "u638"}, {"name": "セフィーレ", "text": "…………いえ、案外その通りかもしれませんね。\n至高の存在であらせられる主が、意味もなく私を\nこのような状況に置かれるはずはありませんから。", "face": "u638"}, {"name": "セフィーレ", "text": "これはきっと、私に課せられた試練なのでしょう。\nであるならば、未だ死ねと命じられていない以上、\n主の御心を知るまでは生きて耐え続けねば……。", "face": "u638"}, {"name": "アンナ", "text": "……でしたら、\n私たちの国に身を寄せるというのはいかがでしょうか？"}, {"name": "セフィーレ", "text": "な……馬鹿なのですか、貴方は？\n人間の敵である私を陣中に招こうとするなんて。", "face": "u638"}, {"name": "ニエル", "text": "そうも言ってられないんじゃないかな。\n天使たちが主の命令で動いていると言っていた以上、\n一人でいたらまた襲われる可能性は高いと思うよ。", "face": "u206"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "セフィーレ", "text": "……実に度し難いですね、人間は。お生憎様ですが、\n貴方たちの国に身を寄せるつもりはありません。", "face": "u638"}, {"name": "セフィーレ", "text": "……ですが、その人間たちに救われたのもまた事実。\nこの白き翼の誇りにかけて、\n借りはいずれ返させて頂きます……では。", "face": "u638"}]}], "active": true}