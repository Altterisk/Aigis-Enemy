": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 900, "attack_speed": 1, "attack_wait": 90, "attack_interval": 375, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136704, "special_effect_id": 1028, "change_to": 5, "missile_id": 709, "missile": {"speed": 8.0}, "master_id": 34863, "global_id": 8480, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 19, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 35000, "attack": 800, "base_hp": 35000, "base_attack": 800, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 150, "attack_interval": 351, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124384, "race_id": 7, "special_effect_id": 232, "missile_id": 481, "missile": {"speed": 1.0}, "master_id": 34522, "global_id": 8139, "ranged": true, "spawn_sec": 97}, {"enemy_id": 9, "source": "local", "count": 9, "form_count": 2, "tags": ["水棲"], "hp": 68000, "attack": 1, "base_hp": 68000, "base_attack": 1, "damage_type": "physical", "armor_defense": 650, "magic_defense": 30, "attack_speed": 90, "attack_wait": 80, "attack_interval": 299, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142000, "special_effect_id": 1179, "change_to": 9, "change_condition": 3, "master_id": 35752, "global_id": 9369, "to_condition": 3, "to_global_id": 9370, "route_behaviour": {"transforms": [{"wait": 1080}]}, "spawn_sec": 142}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 68000, "attack": 650, "base_hp": 68000, "base_attack": 650, "damage_type": "magical", "armor_defense": 650, "magic_defense": 30, "attack_range": 200, "attack_speed": 90, "attack_wait": 80, "attack_interval": 225, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142016, "special_effect_id": 1222, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 35753, "global_id": 9370, "ranged": true, "from_condition": 3}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中", "水棲"], "hp": 260000, "attack": 800, "base_hp": 260000, "base_attack": 800, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 40, "attack_range": 300, "attack_wait": 60, "attack_interval": 305, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2142064, "race_id": 19, "special_effect_id": 1223, "missile_id": 810, "missile": {"speed": 4.0}, "master_id": 35756, "global_id": 9373, "ranged": true, "spawn_sec": 256}], "dialogue": [{"trigger": "start", "lines": [{"name": "キュステ", "text": "ここが、龍宮城の奥の院……。", "face": "u1248a1"}, {"name": "イヲナミ", "text": "オオワタツミさまー！！\n乾いた地よりの使者を連れてまいりました！", "face": "u1722a1"}, {"name": "イヲナミ", "text": "姫さまが乾いた地との\n接触を望んでおられぬことは承知です！\nしかし、どうか一度だけでも対話の機会を……！", "face": "u1722a1"}, {"name": "？？？", "text": "――そう叫ばずとも聞こえておる。\n乾いた地の者たちよ、\nイヲナミを救ってくれたそうだな。", "face": "l38fd31c4e097"}, {"name": "キュステ", "text": "……わっ、可愛いタツノオトシゴです！\nすごい、言葉を話してますよ！", "face": "u1248a1"}, {"name": "イヲナミ", "text": "ふ、不敬ですよ！\nあれなるは、オオワタツミ様の仮初の姿！\nいわばオオワタツミ様の化身なのです！", "face": "u1722a1"}, {"name": "オオワタツミの化身", "text": "よいよい。\nこれなる姿も、乾いた地の者を\n無用に怖れさせぬために変じたものであるがゆえな。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "さぁ、イヲナミを救ってくれた礼をしよう。\n鯛、錦鯉よ、宝物をもて。", "face": "l38fd31c4e097"}, {"name": "アンナ", "text": "お、オオワタツミ様！\n私たちは謝礼は求めていません。\nどうか、この世界のために助力をお願いしたく――", "face": "lb760d417b733"}, {"name": "オオワタツミの化身", "text": "――断る。\n乾いた地にも、件の昔話は伝わっていよう？", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "深海の者と、乾いた地の者が交われば、\nそこには必ず悲しい離別が待っているものよ。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "クラールフのように人と共に歩むのも、\nポセイオスのように人を隷属させんとするのも、\nワシからすれば、どちらも大きな過ちにしか見えぬ。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "ワシは、龍宮城の者たちが、\n誰も傷つくことなく、\n平穏に生き、死んでいくことだけを望んでおるのだ。", "face": "l38fd31c4e097"}, {"name": "イヲナミ", "text": "オオワタツミさま……。\nしかし、それでは姫さまは、\nずっと悲しみに暮れたままではありませんか。", "face": "u1722a1"}, {"name": "オオワタツミの化身", "text": "……一度の悲しみを味わい続ける方が、\nこれから先、幾度も悲しみに触れるよりもよかろうて。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "それでもなお、\nワシを交渉の場に引きずり出したいのなら、\nまずは龍宮城が衛兵たちに、実力を見せることだな。", "face": "l38fd31c4e097"}, {"name": "イヲナミ", "text": "くぅぅぅ、親娘揃って、\n本当に分からずやなんですから……。", "face": "u1722a1"}, {"name": "イヲナミ", "text": "皆さん、すみません、\nボクの説得じゃ、やっぱり足りなかったようです……。", "face": "u1722a1"}, {"name": "ヴィアベル", "text": "いいっていいって。\n王子、ここから先はいつもどおり！\n私たちが交渉相手に相応しいと、実力で見せてあげるわよ！", "face": "u1247a1"}]}, {"trigger": "battle", "at_sec": 262, "lines": [{"name": "オオワタツミの化身", "text": "ほう、なかなかやりおる。\n乾いた地の者が、深海でここまで戦ってみせるか。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "どれ、ワシ自ら相手をしてやろうではないか！", "face": "l38fd31c4e097"}, {"name": "キュステ", "text": "わぁぁぁぁ！？\nタツノオトシゴが出てきましたぁ！？", "face": "u1248a1"}, {"name": "イヲナミ", "text": "オオワタツミ様の化身です！！\nタツノオトシゴじゃありません！！", "face": "u1722a1"}, {"name": "ヴィアベル", "text": "あはは、戦いの気配に釣られて出てくるとか、\nこれならちゃんと交渉できそうね！", "face": "u1247a1"}]}, {"trigger": "end", "lines": [{"name": "オオワタツミの化身", "text": "見事なり……。\n久方ぶりの演武、心躍ったぞ。", "face": "l38fd31c4e097"}, {"name": "アンナ", "text": "では、私たちと交渉を――"}, {"name": "オオワタツミの化身", "text": "焦るでない。\n乾いた地の民よ、何を求めているのかは\nこちらもすでに把握しておる。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "アトランティスが目覚め、ポセイオスが\n乾いた地を水没させんとしておるのだろう？", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "だが、こちらも厄介な事情があってな。\nひとつ困っていることがあるのだ。", "face": "l38fd31c4e097"}, {"name": "キュステ", "text": "困ってること、ですか？", "face": "u1248a1"}, {"name": "オオワタツミの化身", "text": "ワシには、乙姫という娘がいる。\nそれはそれは可愛らしい、\n物質界一番の美人な娘でな……。", "face": "l38fd31c4e097"}, {"name": "イヲナミ", "text": "……まぁ、その、本当に美人なのは確かですが、\nオオワタツミ様、惚気話はその辺りで……。", "face": "u1722a1"}, {"name": "オオワタツミの化身", "text": "む、そうか。\nともあれ、あまりに美人すぎるのも困りもの。\nある大妖怪が、娘に懸想しておるのだ。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "それがただの、若者の恋煩いであれば見逃すが、\n力ある大妖怪が、龍宮城の者らにまで\n被害を及ぼしておるのだから、看過は出来ぬ。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "とはいえ、龍宮城は軍を持っておらぬ。\nワシが討伐に出ている間に\n他の外敵に狙われれば、民に被害がでるやもしれん。", "face": "l38fd31c4e097"}, {"name": "ヴィアベル", "text": "なるほど、龍宮城の戦力に代わり、\n私たちがその妖怪を討伐すれば解決ってことね。", "face": "u1247a1"}, {"name": "オオワタツミの化身", "text": "うむ、話が早い！\n――そしてその討伐譚を、\nぜひとも娘に聞かせてやってほしい。", "face": "l38fd31c4e097"}, {"name": "オオワタツミの化身", "text": "討伐と物語、これがワシからの要求である。\nそれに応えてくれるのなら、\nそなたらの望む助力を惜しまぬと約束しようぞ。", "face": "l38fd31c4e097"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 13, "params": [30]}, {"kind": "term", "influence": 34, "params": [0, 10, 6], "ext": "攻撃待ち増加=90,ダメージ開始待ち=900"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 56000, "attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 25, "pattern_id": 2141968}, {"enemy_id": 1, "form_index": 1, "hp": 56000, "attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 25, "pattern_id": 2141984}, {"enemy_id": 3, "hp": 25000, "attack": 1600, "damage_type": "physical", "armor_defense": 2500, "pattern_id": 2136512}, {"enemy_id": 4, "hp": 6000, "attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "pattern_id": 2136480}, {"enemy_id": 4, "form_index": 1, "hp": 6000, "attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "pattern_id": 2136496}, {"enemy_id": 6, "hp": 7000, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136464}, {"enemy_id": 6, "form_index": 1, "hp": 7000, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136704}, {"enemy_id": 8, "hp": 35000, "attack": 800, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "pattern_id": 2124384}, {"enemy_id": 9, "hp": 68000, "attack": 1, "damage_type": "physical", "armor_defense": 650, "magic_defense": 30, "pattern_id": 2142000}, {"enemy_id": 9, "form_index": 1, "hp": 68000, "attack": 650, "damage_type": "magical", "armor_defense": 650, "magic_defense": 30, "pattern_id": 2142016}, {"enemy_id": 11, "hp": 260000, "attack": 800, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 40, "pattern_id": 2142064}]}, "active": true}