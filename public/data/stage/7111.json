{"quest_id": 7111, "name": "異端審問", "description": "神聖騎士団を率いる謎の男が立ち塞がる。\n＜味方のデーモン、アンデッドの\n　攻撃力、防御力が70％ダウン＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["味方のデーモン、アンデッドの\n　攻撃力、防御力が70％ダウン"], "event": "開かれし扉と集う戦士たち", "event_category": "History", "mission_id": 920149, "map_no": 5751, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 1;", "expression_human": "(it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 13, "params": [30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 1;", "expression_human": "(it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 2, "tags": ["アーマー", "神聖騎士団"], "hp": 9000, "attack": 1700, "base_hp": 9000, "base_attack": 1700, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 100, "attack_interval": 252, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124336, "special_effect_id": 510, "change_to": 1, "change_condition": 2, "master_id": 32735, "global_id": 6353, "to_condition": 2, "to_global_id": 6354, "route_behaviour": {"sets_flags": [[1, 0, 0]], "calls_event": [2067, 2068, 2069, 2070]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団", "アンデッド"], "hp": 100000, "attack": 1000, "base_hp": 100000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 10000, "magic_defense": 90, "attack_speed": 1, "attack_wait": 120, "attack_interval": 292, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124352, "special_effect_id": 562, "master_id": 32736, "global_id": 6354, "from_condition":