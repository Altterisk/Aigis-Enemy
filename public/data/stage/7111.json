": 6263, "ranged": true, "spawn_sec": 65}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104592, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 728, "global_id": 727, "ranged": true, "spawn_sec": 78}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["神聖騎士団"], "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 45, "attack_speed": 1, "attack_wait": 100, "attack_interval": 252, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124368, "race_id": 16, "special_effect_id": 561, "master_id": 32737, "global_id": 6355, "spawn_sec": 148}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 32728, "global_id": 6346, "spawn_sec": 210}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 150000, "attack": 2500, "base_hp": 150000, "base_attack": 2500, "damage_type": "magical", "armor_defense": 600, "magic_defense": 40, "attack_range": 220, "attack_speed": 20, "attack_wait": 80, "attack_interval": 233, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2117504, "race_id": 15, "special_effect_id": 108, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 32730, "global_id": 6348, "ranged": true, "spawn_sec": 221}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 194, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2103856, "special_effect_id": 222, "master_id": 32729, "global_id": 6347, "spawn_sec": 223}], "popups": ["ドゥマルデがいる間\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "異端審問官", "text": "……主は、あなたを異端だと告げました。\nしかし赦しの機会は常に、全ての者にあります。\nあなたの言葉を聞きましょう、鳥人の娘よ。", "face": "u1266a1"}, {"name": "鷲翼の鳥人", "text": "……神ならぬ、亜神を盲信するとは。\n天界で起きている争いの事は教えただろう！？\nそれでもなお、その教義に従うのか！？", "face": "u1086a1"}, {"name": "鷲翼の鳥人", "text": "その主とやらが、人を殺せと言えば殺すのか！\n本当にこれが正しいことだと思っているのか！", "face": "u1086a1"}, {"name": "異端審問官", "text": "…………。\nもう少し、対話を続けましょう。\nあなたとは、まだ言葉を交わす価値があります。", "face": "u1266a1"}, {"name": "神聖騎士団員", "text": "ドゥマルデ審問官！\n王国軍が迫っていると情報が入っている。\n異端の断罪は手早く済ませるべきかと。", "face": "lf1e56eb7fd73"}, {"name": "ドゥマルデ", "text": "えぇ、分かっています。\nしかし彼女には、一時悪魔にそそのかされただけで、\n正しい心を取り戻す余地があるように思えるのです。", "face": "u1266a1"}, {"name": "神聖騎士団員", "text": "……審問官殿がそういうのであれば。\nだがもうあまり時間がない。\n――我らに祈りを、我らが主に栄光を。", "face": "lf1e56eb7fd73"}, {"name": "ドゥマルデ", "text": "――我らに祈りを、我らが主に栄光を。\nさぁ鳥人の娘よ、悪魔の囁きに抗い、\n祈りの言葉を唱えるのです。", "face": "u1266a1"}, {"name": "ノーマ", "text": "――そこまでよ！　邪教のクソ人類ども！！\n時代に輝く一番星、\nこのノーマ様が成敗してやるわ！", "face": "u1047a1"}, {"name": "ドゥマルデ", "text": "……やれやれ、ようやく来たか。", "face": "u1266a1"}, {"name": "ノーマ", "text": "ん、何か言った？", "face": "u1047a1"}, {"name": "ドゥマルデ", "text": "……いいえ、何も。\nさぁ異端者の首魁たる王国軍よ、\n鷲翼の娘はここですよ。", "face": "u1266a1"}, {"name": "ノーマ", "text": "ふふん、教えてくれるなんて間抜けな邪教徒ね！\nって、あ、あれ……？\nやだ、身体から力が抜けていく……みたい……。", "face": "u1047a1"}, {"name": "ドゥマルデ", "text": "（こちらも信仰を疑われるわけにはいかないんでな）\n我が祈りを聞き給え、悪魔を祓う権能を我に、\n戦士を癒やす権能を我に与え給え……。", "face": "u1266a1"}, {"name": "ノーマ", "text": "お、王子！　やばいかも！\nあいつただの司祭じゃないわ！", "face": "u1047a1"}, {"name": "ナキア", "text": "ちっ……あいつの祈りは仲間を癒やすだけじゃない、\nデーモンやアンデッドの力まで削ってきやがるぜ。", "face": "u641"}, {"name": "ノーマ", "text": "ご、ごめん王子……。\nわ、わたし、戦力になれないかも……。", "face": "u1047a1"}, {"name": "アンナ", "text": "王子、このままではノーマさんが危険です。\n彼女を守りながら戦いましょう。", "face": "l8f96efe6a9ee"}]}, {"trigger": "end", "lines": [{"name": "神聖騎士団員", "text": "おぉ、天使様が神獣を遣わしてくださった……！！\nやはり我らの行いこそが正義なのだ……！！", "face": "lf1e56eb7fd73"}, {"name": "デシウス", "text": "う、お、お、おおぉぉぉぉぉぉぉッ！！\nそれがどうした！　我輩は、我輩は知っているぞ！\n思い出せぬが、確かに知っているのだ……！！", "face": "l6607c719ec5f"}, {"name": "デシウス", "text": "――神は、正義ではない！！\n善き行いも、悪しき行いもする！　それが神だ！！", "face": "l6607c719ec5f"}, {"name": "ノーマ", "text": "デ、デシウス様！？\nどうしてここに……！？", "face": "u1047a1"}, {"name": "デシウス", "text": "おお、貴様がライオン頭の言っていた娘か！\n先刻そいつが村に駆け込んできてな！\nこんなことを言ったのだ！！", "face": "l6607c719ec5f"}, {"name": "デシウス", "text": "『王子が危ない』とな……ッ！！", "face": "l6607c719ec5f"}, {"name": "王子", "text": "…………っ！！", "face": "u1"}, {"name": "デシウス", "text": "なぜ泣きそうな顔をしている。\n我輩は今、こんなに晴れやかな気持ちだというのに！", "face": "l6607c719ec5f"}, {"name": "デシウス", "text": "嗚呼、嗚呼！\n王子よ、お前と共に戦えることが！\n我輩は、どうしようもなく嬉しくて仕方ないのだ！！", "face": "l6607c719ec5f"}, {"name": "デシウス", "text": "さぁ剣をとれ、我輩と共に並び立て！！\n我輩との誓いを忘れたとは言わせないぞ！", "face": "l6607c719ec5f"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "レティシア", "text": "なっ……倒したはずなのに、復活した！？\nどうなってるのこいつ！", "face": "u1001a1"}, {"name": "神聖騎士団員", "text": "祈りが死を超越し、霊魂となっても戦う騎士、\nホワイトクルセイダーだ。\n信仰の騎士が威容をとくと見よ！", "face": "lf1e56eb7fd73"}, {"name": "レティシア", "text": "王子殿、ちょっとマズイです。\nあの騎士、信じられない耐久力と守りの硬さですよ！", "face": "u1001a1"}, {"name": "ノーマ", "text": "で、でも霊魂になったせいかしら……。\n少しずつ存在が消えていっているように見えるわ。\n時間をかければ自滅させられるかも。", "face": "u1047a1"}]}], "active": true}