orm_resist": 1, "pattern_id": 2159696, "race_id": 21, "special_effect_id": 795, "change_to": 26, "change_condition": 4, "master_id": 40039, "global_id": 13656, "to_condition": 4, "to_ticks": 3, "to_global_id": 13659, "spawn_sec": 275}, {"enemy_id": 26, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 232000, "attack": 1450, "base_hp": 232000, "base_attack": 1450, "damage_type": "true", "armor_defense": 5000, "magic_defense": 30, "attack_speed": 1, "attack_wait": 120, "attack_interval": 376, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2159712, "race_id": 21, "special_effect_id": 2029, "master_id": 40042, "global_id": 13659, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 30, "source": "local", "count": 4, "form_count": 2, "hp": 22500, "attack": 950, "base_hp": 22500, "base_attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 126, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159616, "race_id": 21, "change_to": 30, "change_condition": 4, "master_id": 40035, "global_id": 13652, "to_condition": 4, "to_ticks": 3, "to_global_id": 13655, "spawn_sec": 327}, {"enemy_id": 30, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 22500, "attack": 700, "base_hp": 22500, "base_attack": 700, "damage_type": "true", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 200, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159632, "race_id": 21, "special_effect_id": 1540, "master_id": 40038, "global_id": 13655, "from_condition": 4, "trigger_ticks": 3}], "popups": ["ティシファは倒されると、\nその場で一度だけ復活します。\n\n復活後はステータスが上昇し、\n攻撃性能が変化します。\nまた一定のHPが減るたびに\n攻撃と防御がアップします。", "冥界のケルベロス、\n冥界のウルフは、\n倒されると黒炎に変化します。", "各種冥界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。", "冥界の蝶は、\n倒されると小さな黒炎に\n変化します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "白の皇帝", "text": "……何者だ、貴様は。", "face": "u418"}, {"name": "？？？", "text": "…………。", "face": "u2739a1"}, {"name": "カルペム", "text": "もしかして、あなたは……ティシファ……？", "face": "u2401a1"}, {"name": "ティシファ", "text": "なぜ、私の名を。", "face": "u2739a1"}, {"name": "カルペム", "text": "タルタロスの門の向こう、\n無数の封じられし者たちが溢れ出さぬよう、\n咎人を処断する裁定者がいると、聞いたことがあるわ。", "face": "u2401a1"}, {"name": "メーア", "text": "えっ、門番ってことです？\nそれってカルペムと同じ役目じゃ……。", "face": "u2404a1"}, {"name": "カルペム", "text": "私はタルタロスの門の、\n向こう側を求める者を阻む門番よ。\nでも、あの子は――", "face": "u2401a1"}, {"name": "ティシファ", "text": "なるほど、あなたが外の世界の門番でしたか。", "face": "u2739a1"}, {"name": "ティシファ", "text": "で、あれば、話は早い。\n我が使命はタルタロスの門を\n越えんとする者すべての断罪。", "face": "u2739a1"}, {"name": "ティシファ", "text": "素直に立ち去るのであれば、危害は加えません。\nどうか、二度とここへは近づかぬように。", "face": "u2739a1"}, {"name": "ディアナ", "text": "それは、できない相談です。", "face": "u624"}, {"name": "ディアナ", "text": "現在、タルタロスに由来する呪いが\n物質界に影響を及ぼしています。", "face": "u624"}, {"name": "ディアナ", "text": "その原因を絶つことなく、\n踵を返すことはできません。", "face": "u624"}, {"name": "ティシファ", "text": "……呪い。", "face": "u2739a1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "ティシファ", "text": "なるほど。あなたのその影、そしてまとわりつく淀んだ気配。", "face": "u2739a1"}, {"name": "ティシファ", "text": "確かに、それはタルタロスに封じられし、\n私たちに連なる魔力に違いありません。", "face": "u2739a1"}, {"name": "ティシファ", "text": "門が開いたのは一瞬だったというのに、\nよくもこれほどの呪いを外へ放ったものですね。", "face": "u2739a1"}, {"name": "白の皇帝", "text": "心当たりがあるようだな。\nならば、そこを退け。", "face": "u418"}, {"name": "ティシファ", "text": "いいえ、退きません。", "face": "u2739a1"}, {"name": "白の皇帝", "text": "――なぜ、と問おう。", "face": "u418"}, {"name": "ティシファ", "text": "事情は理解しました。\n咎人でありながら物質界に手を伸ばす所業、\n私も決して許しはしません。", "face": "u2739a1"}, {"name": "ティシファ", "text": "しかし、だからといって\nあなた方を中へ入れる理由にはなりません。", "face": "u2739a1"}, {"name": "ティシファ", "text": "ここはタルタロス。\n如何なる理由があろうと、出入りは禁じられています。", "face": "u2739a1"}, {"name": "ティシファ", "text": "……引き返しなさい。\nさもなくば、私があなた方に「死」を与えます。", "face": "u2739a1"}, {"name": "メーア", "text": "うわぁ、目がどんよりギラついてますよ。", "face": "u2404a1"}, {"name": "フルス", "text": "お姉ちゃんと逆方向に話通じないやつですね。", "face": "u2738a1"}, {"name": "白の皇帝", "text": "……ならば、力ずくでこじ開けるまでだ。", "face": "u418"}, {"name": "白の皇帝", "text": "俺は止まるわけにはいかない。\n退かぬというなら、貴様ごと斬り伏せる！", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "ティシファ", "text": "……くっ。", "face": "u2739a1"}, {"name": "ティシファ", "text": "これほどの武技。\nここまでに、いったいどれだけの戦いを。", "face": "u2739a1"}, {"name": "白の皇帝", "text": "命までは奪わん。そこをどけ。", "face": "u418"}, {"name": "ティシファ", "text": "……いいえ。退きません。", "face": "u2739a1"}, {"name": "アネット", "text": "何か、事情があるの？", "face": "u2740a1"}, {"name": "ティシファ", "text": "タルタロス内部は、物質界の生命が\n踏み入って無事で済むような環境ではありません。", "face": "u2739a1"}, {"name": "ティシファ", "text": "光も温もりも届かない、\n時を永遠に繰り返し続ける牢獄。\n罪人はその檻の中、永遠に幽閉され続けるのです。", "face": "u2739a1"}, {"name": "ティシファ", "text": "生きたまま足を踏み入れれば、\nその魂はたちまち摩耗し、\n永遠の苦しみを味わうことになるでしょう。", "face": "u2739a1"}, {"name": "ティシファ", "text": "それでも、行くと言うのですか？", "face": "u2739a1"}, {"name": "白の皇帝", "text": "ああ。俺の命ひとつで済むのなら構わないが、\nこのままでは帝国が滅びる。", "face": "u418"}, {"name": "白の皇帝", "text": "民を守るためならば、\nどんな地獄であろうと踏み入る覚悟はできている。", "face": "u418"}, {"name": "ティシファ", "text": "…………。", "face": "u2739a1"}, {"name": "ティシファ", "text": "止めても、聞いてくれそうにありませんね。", "face": "u2739a1"}, {"name": "白の皇帝", "text": "……悪いな、元からの性分だ。", "face": "u418"}, {"name": "ティシファ", "text": "では、ますますここを通すわけにはいきません。", "face": "u2739a1"}, {"name": "ティシファ", "text": "あなたの覚悟は、よく分かりました。\nしかし門を越えたところで、問題は解決しません。", "face": "u2739a1"}, {"name": "ティシファ", "text": "一歩踏み入った瞬間から、\nあなたの時間が永遠に引き伸ばされ、\nそれ以上進むことすらできなくなるでしょう。", "face": "u2739a1"}, {"name": "ティシファ", "text": "ゆえに、あなた方を通すのではなく、\n私が、呪いの解決に助力します。", "face": "u2739a1"}, {"name": "カルペム", "text": "いいの？", "face": "u2401a1"}, {"name": "ティシファ", "text": "タルタロスという贖罪の牢獄から、\n外の世界へ腕を伸ばす者がいるのなら、\nそれを断罪するのが、私の使命です。", "face": "u2739a1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "白の皇帝", "text": "分かった。\nティシファと言ったか？", "face": "u418"}, {"name": "ティシファ", "text": "えぇ。", "face": "u2739a1"}, {"name": "白の皇帝", "text": "恩に着る。\n貴様の断罪、俺たちも手を貸すと誓おう。", "face": "u418"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 20]}, {"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 20, "params": [150]}, {"kind": "term", "influence": 11, "params": [300]}], "enemies": [{"enemy_id": 1, "hp": 187000, "attack": 1850, "damage_type": "physical", "armor_defense": 1250, "magic_defense": 10, "pattern_id": 2168560}, {"enemy_id": 1, "form_index": 1, "hp": 347000, "attack": 1850, "damage_type": "physical", "armor_defense": 850, "magic_defense": 5, "pattern_id": 2168560}, {"enemy_id": 1, "form_index": 2, "hp": 347000, "attack": 2400, "damage_type": "physical", "armor_defense": 1350, "magic_defense": 5, "pattern_id": 2168560}, {"enemy_id": 1, "form_index": 3, "hp": 347000, "attack": 2950, "damage_type": "physical", "armor_defense": 1850, "magic_defense": 5, "pattern_id": 2168560}, {"enemy_id": 1, "form_index": 4, "hp": 347000, "attack": 3600, "damage_type": "physical", "armor_defense": 2350, "magic_defense": 5, "pattern_id": 2168560}, {"enemy_id": 6, "hp": 4000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 6, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 8, "hp": 30000, "attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "pattern_id": 2168544}, {"enemy_id": 9, "hp": 35000, "attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2159904}, {"enemy_id": 10, "hp": 21000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 10, "form_index": 1, "hp": 21000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 14, "hp": 82000, "attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127824}, {"enemy_id": 14, "form_index": 1, "hp": 82000, "attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127840}, {"enemy_id": 18, "hp": 15000, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 18, "form_index": 1, "hp": 15000, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 22, "hp": 3000, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2155216}, {"enemy_id": 22, "form_index": 1, "hp": 2000, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2155232}, {"enemy_id": 24, "hp": 62000, "attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2168528}, {"enemy_id": 25, "hp": 62000, "attack": 700, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2138576}, {"enemy_id": 26, "hp": 232000, "attack": 2650, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 30, "pattern_id": 2159696}, {"enemy_id": 26, "form_index": 1, "hp": 232000, "attack": 1450, "damage_type": "true", "armor_defense": 5000, "magic_defense": 30, "pattern_id": 2159712}, {"enemy_id": 30, "hp": 22500, "attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2159616}, {"enemy_id": 30, "form_index": 1, "hp": 22500, "attack": 700, "damage_type": "true", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2159632}]}, "active": true}