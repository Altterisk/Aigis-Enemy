{"quest_id": 6827, "name": "混沌たる魔の森", "description": "一行が睨んだ通り、異変の中心にいたのは\n異界召喚士だった。森の魔力で凶暴化した\n魔物の軍勢を押し返し、敵の企みを挫け！\n神級（★１獲得の目安：平均Lv50）", "event": "白き姫と魔獣の剣", "event_category": "History", "mission_id": 920131, "map_no": 3421, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 83, "global_id": 82, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 1200, "base_hp": 30000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 40, "attack_speed": 55