esist": 1, "pattern_id": 2116416, "race_id": 3, "change_to": 12, "change_condition": 3, "missile_id": 325, "missile": {"speed": 6.0}, "master_id": 31736, "global_id": 5355, "ranged": true, "to_condition": 3, "to_global_id": 5356, "spawn_sec": 131}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 34000, "attack": 1250, "base_hp": 34000, "base_attack": 1250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 50, "attack_range": 300, "attack_speed": 1, "attack_wait": 80, "attack_interval": 226, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2116432, "race_id": 3, "special_effect_id": 222, "missile_id": 229, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31737, "global_id": 5356, "ranged": true, "from_condition": 3}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_wait": 1, "attack_interval": 69, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "special_effect_id": 64, "master_id": 31856, "global_id": 5475, "spawn_sec": 141}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 1, "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_wait": 1, "attack_interval": 69, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 396, "master_id": 31855, "global_id": 5474, "spawn_sec": 151}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 1000, "base_hp": 20000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_wait": 5, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "special_effect_id": 64, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 31853, "global_id": 5472, "ranged": true, "spawn_sec": 179}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "hp": 45000, "attack": 1200, "base_hp": 45000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 40, "attack_speed": 1, "attack_wait": 7, "attack_interval": 86, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2113792, "race_id": 3, "special_effect_id": 64, "master_id": 31854, "global_id": 5473, "spawn_sec": 184}], "dialogue": [{"trigger": "start", "lines": [{"name": "異界召喚士", "text": "――キヒヒ……！！\n異界の虫よ、魔の森をもっと蝕むのじゃ！\n樹を喰み、大地を蝕み、魔力を根こそぎ吸い上げよ！", "face": "lfcbfc20ac93b"}, {"name": "ピリカ", "text": "――ここ！　ここだよ王子のお兄ちゃん！\n剣があいつの喉笛を食い千切れって言ってる！！", "face": "u843"}, {"name": "ラテリア", "text": "なるほどね……。\n異界召喚士が森を荒らし、魔力を乱したことで、\n周辺の獣達が凶暴化していたってわけだ。", "face": "u532"}, {"name": "異界召喚士", "text": "キヒィッ！？\n王子達に、裏切り者のシャディア！！\nもうこの場所を嗅ぎつけてきたのかぁ！？", "face": "lfcbfc20ac93b"}, {"name": "シャディア", "text": "魔の森は、かつてのベルゼビュート封印の地。\nなるほど、ガリウスの為に\nこの場所の魔力を根こそぎ吸い上げる目論見か。", "face": "u713"}, {"name": "異界召喚士", "text": "今更気付いても遅いわぁ！！\nいずれ魔力の乱れを察知し、\nここに王子達が来る事は予想済みじゃ！！", "face": "lfcbfc20ac93b"}, {"name": "エイル", "text": "……王子、確かに既に、\n周囲を異界の虫と、\nデーモンが包囲しているみたいです。", "face": "u804"}, {"name": "ピリカ", "text": "がう……絶対負けない……。\n剣がボクの心の中で、ずっと叫んでるんだ……！", "face": "u843"}, {"name": "ピリカ", "text": "――『我こそこの森の正当なる主。\n我が眷属たる獣の心を乱し、森を害したその罪、\n決して許しはしない』って……！！", "face": "u843"}, {"name": "ラテリア", "text": "心優しき森の主にして、ベルゼビュートの\n封印に影響されて荒ぶる獣と化した獣……。\nなるほど、その剣の伝承は正しかったわけだ。", "face": "u532"}, {"name": "ラテリア", "text": "ピリカの剣に宿っているのは、\nこの森の本来の主たる獣だ。\nこんな好き放題されて、許せるはずがないよね。", "face": "u532"}, {"name": "ピリカ", "text": "がうう！　この子の怒り、ボクにも伝わってくるよ！\n王子のお兄ちゃん、お願い、力を貸して……！！", "face": "u843"}, {"name": "王子", "text": "…………！！（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "異界召喚士", "text": "キヒィッ！？\nなぜだ！　なぜいつも上手くいかぬのじゃ！！", "face": "lfcbfc20ac93b"}, {"name": "異界召喚士", "text": "撤退せよ！　異界の門より魔界へ撤収する！！", "face": "lfcbfc20ac93b"}, {"name": "アイーダ", "text": "……魔の森のざわめきが、収まっていく。\nどうやら異界の虫も、異界召喚士と共に消えたようだな。", "face": "u381"}, {"name": "ピリカ", "text": "がう……がうう……。\n良かった……この子は、故郷が壊されるのを防ぐために、\nボクをここに呼んでたんだね……。", "face": "u843"}, {"name": "ピリカ", "text": "王子のお兄ちゃん、\nそれに、王国のお兄ちゃんたちに、お姉ちゃんたち！\nえっと、えぇと……。", "face": "u843"}, {"name": "ピリカ", "text": "ありがとう、本当にありがとうっ！\nこの子もボクの心を通じて、お礼を言ってるよ！\nがうー！　がううー！", "face": "u843"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アイーダ", "text": "異界の虫に食い荒らされた魔力も、\n少しずつ元に戻っていくことだろう。\nこれで今回の事件も一段落だな。", "face": "u381"}, {"name": "アンナ", "text": "それでは、一度王国へ帰還しましょうか。\n王子、此度の戦い、お疲れ様でした！"}]}], "active": true}