 4, "missile_id": 1071, "missile": {"speed": 6.0}, "master_id": 41105, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "hp": 20000, "attack": 500, "base_hp": 20000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 90, "attack_range": 320, "attack_speed": 1, "attack_wait": 80, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152608, "special_effect_id": 1714, "change_to": 17, "change_condition": 4, "missile_id": 1070, "master_id": 41106, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 24, "source": "local", "count": 8, "form_count": 1, "tags": ["ハニー"], "hp": 4500, "attack": 420, "base_hp": 4500, "base_attack": 420, "damage_type": "physical", "armor_defense": 180, "attack_speed": 10, "attack_wait": 1, "attack_interval": 37, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2172720, "master_id": 41113, "spawn_sec": 136}, {"enemy_id": 25, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 240000, "attack": 1500, "base_hp": 240000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 90, "attack_speed": 1, "attack_wait": 40, "attack_interval": 182, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152608, "special_effect_id": 1160, "master_id": 37440, "global_id": 11057, "spawn_sec": 217}, {"enemy_id": 26, "source": "local", "count": 2, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 86, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 2000, "pattern_id": 2172720, "master_id": 41116, "spawn_sec": 217}], "popups": ["\n\n\n\n　　――王国領内、市街地"], "dialogue": [{"trigger": "start", "lines": [{"text": "――王国領内、市街地"}, {"name": "ハニーＡ", "text": "はにほー。", "face": "l0a288895e9cd"}, {"name": "ハニーＢ", "text": "あいやー。", "face": "l0a288895e9cd"}, {"name": "ハニーＣ", "text": "にせものがいっぱいだー。", "face": "l0a288895e9cd"}, {"name": "ケイティ", "text": "……本物のハニーが混ざっているようです。\n様子がおかしいのは、あちらの――", "face": "u2433a1"}, {"name": "ハニーセーレ", "text": "ハーッハッハッハ！　ハニホー！！", "face": "l889a78825052"}, {"name": "ハニーセーレ", "text": "私こそが真の魔神セーレ！\n異世界の戦士ランス、王子、覚悟せよ！", "face": "l889a78825052"}, {"name": "ランス", "text": "丸い方のセーレか。", "face": "u2897a1"}, {"name": "ハニーセーレ", "text": "丸い方と言うな！", "face": "l889a78825052"}, {"name": "シルキィ", "text": "……あの魔神、魔法への耐性がとても高そう。", "face": "u2902a1"}, {"name": "志津香", "text": "面倒ね。魔法使い泣かせだわ。", "face": "u1759a1"}, {"name": "ハニーセーレ", "text": "クックック……ランスよ、\n偽物の私では無理だったようだが、\nここで息の根を止めてやるぞ！", "face": "l889a78825052"}, {"name": "ハニーセーレ", "text": "行け、眷属ども！", "face": "l889a78825052"}, {"name": "ランス", "text": "えぇい、むらがるなー！", "face": "u2897a1"}, {"name": "ハニーＡ", "text": "にせものだー。であえであえー。", "face": "l0a288895e9cd"}, {"name": "ハニーＢ", "text": "めがねっこのてきー。", "face": "l0a288895e9cd"}, {"name": "ハニーＣ", "text": "おもしろそうだからさんかー。", "face": "l0a288895e9cd"}, {"name": "アンナ", "text": "本物のハニーまで参戦してきました！\n王子、偽物と本物を見分けつつ、ハニーセーレを――"}, {"name": "ランス", "text": "見分けなど知るか！　全部ぶっ飛ばす！", "face": "u2897a1"}]}, {"trigger": "end", "lines": [{"name": "ハニーセーレ", "text": "ぐぬぬ……この私が、押されるとは……。", "face": "l889a78825052"}, {"name": "ハニーセーレ", "text": "……だが、まだ終わらん。\n貴族気取りの偽物より先に、私が貴様を殺す。", "face": "l889a78825052"}, {"name": "ハニーセーレ", "text": "開け、異界の門！　ハニホー！", "face": "l889a78825052"}]}, {"trigger": "end", "lines": [{"name": "グリム", "text": "あっ、逃げましたー。\n自分の居城に戻ったみたいですねー。", "face": "u942"}, {"name": "ケイティ", "text": "逃げ足の速い魔神ですね……。", "face": "u2433a1"}, {"name": "シィル", "text": "……あの、ランス様、王子様。\nちょっと気になることがあるんですけど……。", "face": "u2900a1"}, {"name": "シィル", "text": "ランス様はここにいるのに、\nなぜか向こうの方からも\nランス様の気配がするような……？", "face": "u2900a1"}, {"name": "オロチヒメ", "text": "んん……呪いの影響、かもぉ……？", "face": "u555"}, {"name": "フローガ", "text": "なるほど、現在、魔神セーレとランスさんは、\n呪いという魔力の糸で繋がっています。\nその気配をたどれば……？", "face": "u878"}, {"name": "シィル", "text": "セーレさんの居場所が分かるかもしれません！", "face": "u2900a1"}, {"name": "志津香", "text": "へぇ、やるじゃないシィル。\nそんな遠くのランスの気配に気付くなんて。", "face": "u1759a1"}, {"name": "シィル", "text": "えへへ……ランス様のことなら、\n私、いつも見てますから。", "face": "u2900a1"}, {"name": "ランス", "text": "……む。", "face": "u2897a1"}, {"name": "ランス", "text": "と、とにかくだ！　辿れるなら早く辿れ！\n俺様は一刻も早く女の子に――", "face": "u2897a1"}, {"name": "リア", "text": "ダーリン、また近づいたら爆発するわよ？", "face": "u2901a1"}, {"name": "ランス", "text": "ぐぬぬぬ！", "face": "u2897a1"}, {"name": "グリム", "text": "シィルさんの逆探知と、私の門の追跡で\nセーレの居城を探しましょー。", "face": "u942"}, {"name": "アンナ", "text": "王子、次は王都へ。\nどうやら向こうも、ただでは済まなさそうです。"}]}], "active": true}