my_id": 19, "source": "local", "count": 6, "form_count": 1, "hp": 5000, "attack": 450, "base_hp": 5000, "base_attack": 450, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 119, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2165376, "race_id": 2, "master_id": 39338, "global_id": 12955, "spawn_sec": 303}, {"enemy_id": 20, "source": "local", "count": 9, "form_count": 1, "tags": ["アーマー"], "hp": 9000, "attack": 750, "base_hp": 9000, "base_attack": 750, "damage_type": "physical", "armor_defense": 800, "attack_range": 120, "attack_speed": 1, "attack_wait": 60, "attack_interval": 167, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160656, "race_id": 16, "special_effect_id": 232, "missile_id": 45, "master_id": 38800, "global_id": 12417, "ranged": true, "spawn_sec": 308}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 185, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2166176, "race_id": 16, "special_effect_id": 1900, "missile_id": 1281, "missile": {"speed": 9.0}, "master_id": 39471, "global_id": 13088, "spawn_sec": 408}, {"enemy_id": 22, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 218, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2166144, "race_id": 16, "change_to": 22, "master_id": 39468, "global_id": 13085, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 408}, {"enemy_id": 24, "source": "local", "count": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 10, "base_hp": 299999, "base_attack": 10, "damage_type": "magical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 167, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2166320, "race_id": 16, "change_to": 24, "master_id": 39489, "global_id": 13106, "to_global_id": 13084, "route_behaviour": {"transforms": [{"wait": 40}]}, "spawn_sec": 408}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "magical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 167, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2166336, "race_id": 16, "master_id": 39467, "global_id": 13084}], "popups": ["　　【魔力嵐】\n・ユニット配置時の\n　初期HPが減少\n\n・味方の魔法攻撃による\n　ダメージが減少\n\n・敵味方の爆風範囲が減少", "黒い光冠を纏ったギルガメッシュは\n攻撃力2000以下の\nあらゆる攻撃を受け付けません。\n\nまた黒い光冠を纏った\nギルガメッシュは倒されると\nその場で強くなって復活します。\n　　　　　　(1/3)", "黒い光冠を纏った\nギルガメッシュがいる間は\n全ての敵の攻撃力と\n防御力が大幅にアップします。\n\n\n\n　　　　　　(2/3)", "黒い光冠を纏った\nギルガメッシュが\n特定の位置に到着すると\n・癒しの魔力結晶\n・時空の間隙\n・破壊神の雷撃\nを発生させます。\n　　　　　　(3/3)", "モードリオンがいる間は\n全ての敵の攻撃力と\n防御力がアップします。", "大神降臨ギルガメッシュが\n解放されました。\n\nホーム画面左側の\nミッションクエストにある、\n魔神降臨のメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "セーラ", "text": "（これが、この方が、英雄王……。\nいえ、英雄王の、肉体……）", "face": "u2627a1"}, {"name": "セーラ", "text": "（ご主人様に、彼を殺させる……？\nそんなことが、果たして赦されるのか……）", "face": "u2627a1"}, {"name": "ミレイユ", "text": "――セーラ。", "face": "u2626a1"}, {"name": "セーラ", "text": "は、はい。", "face": "u2627a1"}, {"name": "ミレイユ", "text": "あなたの主を、信じなさい。", "face": "u2626a1"}, {"name": "セーラ", "text": "……ミレイユ様は、ずっと、そうしてきたのですか？", "face": "u2627a1"}, {"name": "ミレイユ", "text": "王国の王というものは、\nわがままで、お人好しで、困った人ばかりです。\nこの国が生まれたそのときから、ずっと変わりません。", "face": "u2626a1"}, {"name": "ミレイユ", "text": "その中でも、王子は本当に困った人です。\n自分の手の届かない場所で起きた悲劇まで、\n我がことのように苦しみ、足掻こうとする……。", "face": "u2626a1"}, {"name": "ミレイユ", "text": "でもセーラ、あなたの主のそんな姿を見て、\n手が届かないのなら、代わりにそこまで\n駈けていけばいいと考える仲間たちが集まった。", "face": "u2626a1"}, {"name": "シャディア", "text": "ああ。放っておけない大馬鹿者のためにな。", "face": "u713"}, {"name": "イコル", "text": "本当に、どうしようもない馬鹿だけど。\n意地でも運命を捻じ曲げようとする大馬鹿だ。", "face": "u1988a1"}, {"name": "トラム", "text": "助けを求める言葉を、\nずっと声にできないままの誰かの所へだって。", "face": "u1110a1"}, {"name": "ガレア", "text": "今度こそ、どこへだって駈けつけるさ。\n君の手が届かない場所にだって。", "face": "u2459a1"}, {"name": "ユリクセス", "text": "今度こそ、兜をきらきらさせながらな？", "face": "u2193a1"}, {"name": "ギルガメッシュ", "text": "…………。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ", "text": "なるほど、確かに。\nまるでこの男の記憶を見ているかのようだ。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ", "text": "――創造神の求めた世界。\nその後継者こそ、この者たち、か。", "face": "lb61b637c79b6"}, {"name": "王子", "text": "…………名を聞こう。", "face": "u1"}, {"name": "ギルガメッシュ", "text": "今はギルガメッシュと呼ぶがいい。\n我が臣下より望まれた名だ。", "face": "lb61b637c79b6"}, {"name": "王子", "text": "――ギルガメッシュ。\n王国は二度と、敗北しない。\nたとえ相手が誰であろうとも。", "face": "u1"}, {"name": "ギルガメッシュ", "text": "それが誓いか。\n王国とは、お前と仲間たちの手が届く全て。\n助けを求める全ての民のことであると。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ", "text": "ならば見せてもらおう。\nこの肉体が夢見た、人類の未来の姿を。", "face": "lb61b637c79b6"}, {"name": "アンブローズ", "text": "……モリグナン、不服ですけど、\n今は少しだけ協力してもらえますか。", "face": "u1088a1"}, {"name": "モリグナン", "text": "あら、偉大なるアンブローズちゃん、\nこの魔女の力が必要かしら？", "face": "lfe5456e1292d"}, {"name": "アンブローズ", "text": "いちいち煽らないでくださいよぉ！\nはぁ……サナラちゃん、あのときの再現をします！", "face": "u1088a1"}, {"name": "サナラ", "text": "あのとき……？", "face": "u921"}, {"name": "アンブローズ", "text": "魔王城決戦です！\n女神の力には及びませんけど――", "face": "u1088a1"}, {"name": "サナラ", "text": "あっ……了解ですよー！\nふたりの力、私が束ねます！", "face": "u921"}, {"name": "アンブローズ", "text": "王子ちゃん！\n周囲に強化魔法を展開します！", "face": "u1088a1"}, {"name": "アンブローズ", "text": "王国最初の魔法使いと、王国最初の魔女。\nその魔力を――今の時代に委ねます！", "face": "u1088a1"}]}, {"trigger": "battle", "at_sec": 407, "lines": [{"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "モードリオン", "text": "くっ……なぜだ。\n脆弱な理想を追う者が、なぜ――", "face": "leaf7da0f56b0"}, {"name": "ギルガメッシュ", "text": "…………。", "face": "lb61b637c79b6"}, {"name": "モードリオン", "text": "……我が王？", "face": "leaf7da0f56b0"}, {"name": "ギルガメッシュ？", "text": "――モードリオン。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ？", "text": "我が息子よ。\nそれはね、彼らの力の根底にあるのは、\n諦めないという意志、だからだよ。", "face": "lb61b637c79b6"}, {"name": "モードリオン", "text": "あ……あぁ……あぁああああッ。父、上……っ。", "face": "leaf7da0f56b0"}, {"name": "アトナテス", "text": "……お前、なのか？", "face": "u908"}, {"name": "ギルガメッシュ？", "text": "ああ。あまり時間がない。\n王国を継ぐ皆、よく聞いておくれ。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ？", "text": "世界を渡るんだ。\nこの先の世界へ、破壊神を追って。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ？", "text": "それからモードリオン、\nアトナテス、君たちは強い子だ。\n自分の道は自分で選びなさい。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ？", "text": "そして、王子。\n君が成し遂げたことは、聞いている。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ？", "text": "――ありがとう。", "face": "lb61b637c79b6"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ギルガメッシュ", "text": "…………死してなお、言葉を紡ぐとはな。\nなるほど、これが人類の英雄か。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ", "text": "王子よ、お前にも期待ができそうだ。\n以前の言葉は撤回しよう。", "face": "lb61b637c79b6"}, {"name": "ギルガメッシュ", "text": "追ってこい、創造神の子らよ。\n我が世界を――\n始まりの戦いを、その先で見せてやろう。", "face": "lb61b637c79b6"}]}, {"trigger": "end", "lines": [{"name": "ファオル", "text": "消え、た……？", "face": "u2513a1"}, {"name": "マータン", "text": "あの渦の向こうに行ったのか……？", "face": "u2524a1"}, {"name": "モードリオン", "text": "あ、あぁあ……。", "face": "leaf7da0f56b0"}, {"name": "ガルヴェイン", "text": "…………ぜぇ、はぁ。\nあー……ちくしょう、全部終わった後かよ。", "face": "l4e82cab272e3"}, {"name": "ガルヴェイン", "text": "おい、モードリオン！\nてめぇ何腑抜けてやがる。", "face": "l4e82cab272e3"}, {"name": "モードリオン", "text": "ガル、ヴェイン……。\n私は……どうすれば……。", "face": "leaf7da0f56b0"}, {"name": "ガルヴェイン", "text": "知るか！\nくそっ、世話のやける……。", "face": "l4e82cab272e3"}, {"name": "ガルヴェイン", "text": "世界の再誕とやらを見せてくれるんだろ？\n俺様が飽きるまでは、付き合ってやるよ。\nだから――おらっ、さっさと行きやがれ！", "face": "l4e82cab272e3"}, {"name": "トラム", "text": "待ちなさいガルヴェイン！\nまだ聞きたいことが――", "face": "u1110a1"}]}, {"trigger": "end", "lines": [{"name": "トラム", "text": "…………。", "face": "u1110a1"}, {"name": "アージェ", "text": "飛び込むのは推奨しません。", "face": "u1090a1"}, {"name": "トラム", "text": "分かってる、でも――", "face": "u1110a1"}, {"name": "グリム", "text": "本当に行かないほうが良いと思います。", "face": "u942"}, {"name": "グリム", "text": "これ、異界の門とかじゃないです。\n向こう側が、何も観測できません。", "face": "u942"}, {"name": "グリム", "text": "それに、たぶんガルヴェインの仕業ですが、\n一時的に魔力の均衡が崩されています。\n入ったら、たぶん無事で済まないです。", "face": "u942"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "トラム", "text": "……分かったわ。", "face": "u1110a1"}, {"name": "アンナ", "text": "先程の言葉は、英雄王のもの、だったのでしょうか。", "face": "l023fef4a18d9"}, {"name": "ユージェン", "text": "……うん。よく、覚えてる。\nあれは英雄王の言葉だった。", "face": "u906"}, {"name": "アトナテス", "text": "はぁ、まったく……。\n全部託していきやがったな、あいつ。", "face": "u908"}, {"name": "アンブローズ", "text": "あの人、死ぬ時もそうでしたからねー。", "face": "u1088a1"}, {"name": "サナラ", "text": "でも、ちょっと安心した顔してましたね？", "face": "u921"}, {"name": "ソラス", "text": "その原因は、明白でしょう。", "face": "u904"}, {"name": "ソラス", "text": "――王子くんの誓いを、\nしっかりと、その目で見たからですよ。", "face": "u904"}]}, {"trigger": "route", "lines": [{"name": "ニミュエ", "text": "――アンブローズ様、\nこちらの攻撃が吸い寄せられています。", "face": "u1175a1"}, {"name": "アンブローズ", "text": "その手は見覚えありますよぉ！\n王子ちゃん、あれは時空の間隙です！", "face": "u1088a1"}, {"name": "ニミュエ", "text": "遠距離攻撃は吸い寄せられてしまいますので、\nそれを踏まえて指揮をお願いします。", "face": "u1175a1"}, {"name": "アンブローズ", "text": "ニミュエぇ！　その解説はあたしがぁ！？", "face": "u1088a1"}, {"name": "ニミュエ", "text": "はいはい、お仕事しましょうねー。\nそろそろ冗談をいう余裕もなくなってきたのでー。", "face": "u1175a1"}, {"name": "アンブローズ", "text": "ですねぇ！\n王子ちゃん、全力全開で行きますよぉ！", "face": "u1088a1"}]}, {"trigger": "route", "lines": [{"name": "ホルミース", "text": "あの結晶は――", "face": "u2292a1"}, {"name": "アトナテス", "text": "ちっ……見覚えがありすぎるぜ。", "face": "u908"}, {"name": "アトナテス", "text": "王子、あれは癒しの魔力結晶。\nあいつの――英雄王の力だ。", "face": "u908"}, {"name": "イーリス", "text": "強い癒しの力を感じます。\n敵がどんどん回復していってます！", "face": "u31"}]}, {"trigger": "route", "lines": [{"name": "ネーヴェ", "text": "お嬢様、奇妙な耳鳴りが。", "face": "u2619a1"}, {"name": "エヴェリーナ", "text": "なんだあれは……。\n魔力の塊、なのか？", "face": "u2620a1"}, {"name": "アキレア", "text": "……グングニル、いや、\n終焉要塞ゼウスと似た力を感じる。", "face": "u1972a1"}, {"name": "アキレア", "text": "早く撃ち落とさねぇと、何かぶっ放してくるぞ！", "face": "u1972a1"}, {"name": "ロゼルヌ", "text": "なるほど、では急ぎ斬りすてましょう。\n王子様、そちらはお任せします。", "face": "u2621a1"}]}], "active": true}