{"quest_id": 8764, "name": "破壊を司る古き神", "description": "破壊の神を前に英雄は誓いを示す。\nこれが英雄王の夢見た人類の未来だと――\n＜魔力嵐：爆風範囲、魔法ダメージが減少＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["魔力嵐：爆風範囲、魔法ダメージが減少"], "event": "黒き導き、白き目覚め", "event_category": "History", "mission_id": 920240, "map_no": 7312, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 50, "params": [60]}, {"kind": "term", "influence": 22, "params": [60]}, {"kind": "term", "influence": 9, "params": [50], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 287100, "attack": 1500, "base_hp": 287100, "base_attack": 1500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 1, "attack_interval": 99, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2166240, "race_id": 16, "special_effect_id": 2268, "change_to": 1, "change_condition": 3, "master_id": 39485, "global_id": 13102}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 3, "hp": 156720, "attack": 1500, "base_hp": 156720, "base_attack": 1500, "damage_type": "true", "armor_defense": 500, "magic_defense": 20, "attack_range": 250, "attack_speed": 65, "attack_wait": 50, "attack_interval": 165, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2166208, "race_id": 16, "special_effect_id": 2087, "change_to": 3, "change_condition": 2, "missile_id": 1281, "missile": {"speed": 9.0}, "master_id": 39476, "global_id": 13093, "ranged": true, "to_condition": 2, "to_global_id": 13094, "sp_change_to": [39478], "commands": {"raw": "SetStageFlag(99, 1);", "sets_flags": [[99, 1]]}, "route_behaviour": {"transforms": [{"to": 39478, "wait": 60}, {"to": 39476, "wait": 240}], "sets_flags": [[50, 1, 900], [41, 1, 0]]}}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "h