{"quest_id": 8463, "name": "封鎖された炭鉱", "description": "ザ・リッパーに追いつくため、一行は\n封鎖された坑道から鋼の都を目指す。\n魔物を撃退し、道を切り開け！\n上級（★１獲得の目安：平均Lv10）", "event": "スティールシティ・マーダーズ", "event_category": "History", "mission_id": 920225, "map_no": 9290, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "tags": ["ステルス"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2126240, "change_to": 2, "change_condition": 1, "master_id": 33277, "global_id": 6894, "variants": [{"tags": ["ステルス"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113920, "master_id": 30917, "global_id": 4536}], "spawn_sec": 36}, {"enemy_id": 4, "source": "local", "count": 23, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 152, "global_id": 151, "spawn_sec": 41}, {"enemy_id": 5, "source": "local", "count": 18, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 47}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 86}, {"enemy_id": 7, "source": "local", "count": 11, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 96}], "dialogue": [{"trigger": "start", "lines": [{"name": "ピーク", "text": "――ここは鋼の都が今の形になる前、\n遥か昔に使われていた坑道です。", "face": "u2344a1"}, {"name": "アイゼルフ", "text": "一応封鎖されてはいますが、\nあまりに入り組んでいて、\nいくつか抜け道が残ったままなんですよね。", "face": "u2343a1"}, {"name": "アイシャ", "text": "驚いた……。\n鋼の都の地下にこんな空間があったなんて。", "face": "u181"}, {"name": "ピッキー", "text": "ひとりで入っちゃだめですからね。\n道を知ってる人と一緒じゃないと、\nそのまま帰れなくなっちゃいます。", "face": "u671"}, {"name": "アイゼルフ", "text": "魔物もいっぱい住み着いてますしねー。", "face": "u2343a1"}, {"name": "アイリーン", "text": "では、迷わないように道案内をお願いしますね。", "face": "u315"}, {"name": "ピーク", "text": "任せてください。\n真っ直ぐ地下水道区画まで突き進みます！", "face": "u2344a1"}, {"name": "ケイティ", "text": "総員、戦闘準備！\n魔物を蹴散らしつつ前進します！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "リッカ", "text": "ふぅ……片付きましたね！\nさぁ地下水道区画目指して進みましょう！", "face": "u152"}, {"name": "アイゼルフ", "text": "リッカさん、やけに楽しそうですね。", "face": "u2343a1"}, {"name": "リッカ", "text": "えっ、あっ、ごめん……。\nでも噂に名高い鋼の都の地下が見られるとなると、\nどうしても興味が……。", "face": "u152"}, {"name": "ピーク", "text": "ああ、なるほど……。", "face": "u2344a1"}, {"name": "ピーク", "text": "王国軍の方にでしたら、\n後日解説つきで見学会を開きましょうか。", "face": "u2344a1"}, {"name": "リッカ", "text": "いいんですか～！？", "face": "u152"}, {"name": "ピーク", "text": "本来、部外者は進入禁止ですが、\n王国には水道技術の提供もしていますし、\nたぶん許可がおりると思いますよ。", "face": "u2344a1"}, {"name": "リッカ", "text": "ふふふ、楽しみです～！\n噂の地下水道区画に、機関大隧道、\n都市全体のエネルギーを生み出す大機関に――", "face": "u152"}, {"name": "アイゼルフ", "text": "そ、そこまで見せれるか分からないけど！\nさぁそろそろ、お目当ての区画に到着ですよー。", "face": "u2343a1"}, {"name": "アイゼルフ", "text": "ここが、鋼の都の地下水道区画です！", "face": "u2343a1"}]}], "active": true}