pecial_effect_id": 234, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 388, "global_id": 387, "ranged": true, "from_condition": 3}, {"enemy_id": 9, "source": "local", "count": 3, "level": 80, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 9, "change_condition": 3, "master_id": 800, "global_id": 799, "to_condition": 3, "to_global_id": 800, "spawn_sec": 82}, {"enemy_id": 9, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 500, "base_hp": 1200, "base_attack": 500, "damage_type": "physical", "armor_defense": 130, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "魔物の出現報告があったのはこの付近ですね。", "face": "l831eb29f1552"}, {"name": "兵士", "text": "報告！　前方より魔物の群れが接近中です！", "face": "l4517b1f200b9"}, {"name": "ケイティ", "text": "早速現れたようですね。\n行きましょう、王子！", "face": "u114"}]}, {"trigger": "battle", "at_sec": 76, "lines": [{"name": "ドゥーラ", "text": "お、居た居た。\n王子たちも戦いに励んでいるみたいで何よりだぜ。", "face": "u446"}, {"name": "ドゥーラ", "text": "この招待状を届けてやったら、\nきっと王子たちも喜ぶだろうな。", "face": "u446"}, {"name": "ドゥーラ", "text": "ま、その前に腕前が落ちてないか、\n軽く試しておかないとな。", "face": "u446"}]}, {"trigger": "end", "lines": [{"name": "ドゥーラ", "text": "ふぅ、こんなもんか。\n相変わらずの強さだな、王子。\n腕は鈍ってないみたいで安心したぜ。", "face": "u446"}, {"name": "アンナ", "text": "ドゥーラさん！　急に挑んでくるなんて、\n一体どういう事なんですか！", "face": "l831eb29f1552"}, {"name": "ドゥーラ", "text": "おいおい、そんな怒る事でもないだろ。\n強い相手と出会ったら戦う、\nそれがオーク流の挨拶だし礼儀だぜ。", "face": "u446"}, {"name": "ケイティ", "text": "はぁ……まったく。彼女は初めて出会った時も、\n挨拶代わりにと戦いを挑んできましたね、王子。", "face": "u114"}, {"name": "ドゥーラ", "text": "あぁ、『魔界武術大会』に招待した時のことだな。\n人間の代表として王子を招待して、決勝で戦った。", "face": "u446"}, {"name": "ドゥーラ", "text": "オークとして、剣闘士として。\nオレは全力で戦い……そして負けた。", "face": "u446"}, {"name": "ドゥーラ", "text": "まさか、オレを負かす程の\n人間が居るなんて思わなかったぜ。", "face": "u446"}, {"name": "ドゥーラ", "text": "……で、そんな強い王子に\n嬉しいお知らせを持ってきたんだよ。\n話もあるし、場所を変えようぜ？", "face": "u446"}, {"name": "アンナ", "text": "ドゥーラさんからの嬉しいお知らせ、\nと言うのは嫌な予感もしますが……。\n王子、執務室へ移動しましょうか。", "face": "l3cef686ba4a9"}]}], "story_talk": true, "active": true}