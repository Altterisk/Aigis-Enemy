 true}, "master_id": 388, "global_id": 387, "ranged": true, "condition": 3}], "spawn_sec": 78}, {"enemy_id": 9, "source": "local", "count": 3, "level": 80, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 9, "change_condition": 3, "master_id": 800, "global_id": 799, "phases": [{"hp": 1200, "attack": 500, "base_hp": 1200, "base_attack": 500, "damage_type": "physical", "armor_defense": 130, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "condition": 3}], "spawn_sec": 82}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "魔物の出現報告があったのはこの付近ですね。", "face": "l41ef8471a996"}, {"name": "兵士", "text": "報告！　前方より魔物の群れが接近中です！", "face": "l4517b1f200b9"}, {"name": "ケイティ", "text": "早速現れたようですね。\n行きましょう、王子！", "face": "u114"}]}, {"trigger": "battle", "at_sec": 76, "lines": [{"name": "ドゥーラ", "text": "お、居た居た。\n王子たちも戦いに励んでいるみたいで何よりだぜ。", "face": "u446"}, {"name": "ドゥーラ", "text": "この招待状を届けてやったら、\nきっと王子たちも喜ぶだろうな。", "face": "u446"}, {"name": "ドゥーラ", "text": "ま、その前に腕前が落ちてないか、\n軽く試しておかないとな。", "face": "u446"}]}, {"trigger": "end", "lines": [{"name": "ドゥーラ", "text": "ふぅ、こんなもんか。\n相変わらずの強さだな、王子。\n腕は鈍ってないみたいで安心したぜ。", "face": "u446"}, {"name": "アンナ", "text": "ドゥーラさん！　急に挑んでくるなんて、\n一体どういう事なんですか！", "face": "l41ef8471a996"}, {"name": "ドゥーラ", "text": "おいおい、そんな怒る事でもないだろ。\n強い相手と出会ったら戦う、\nそれがオーク流の挨拶だし礼儀だぜ。", "face": "u446"}, {"name": "ケイティ", "text": "はぁ……まったく。彼女は初めて出会った時も、\n挨拶代わりにと戦いを挑んできましたね、王子。", "face": "u114"}, {"name": "ドゥーラ", "text": "あぁ、『魔界武術大会』に招待した時のことだな。\n人間の代表として王子を招待して、決勝で戦った。", "face": "u446"}, {"name": "ドゥーラ", "text": "オークとして、剣闘士として。\nオレは全力で戦い……そして負けた。", "face": "u446"}, {"name": "ドゥーラ", "text": "まさか、オレを負かす程の\n人間が居るなんて思わなかったぜ。", "face": "u446"}, {"name": "ドゥーラ", "text": "……で、そんな強い王子に\n嬉しいお知らせを持ってきたんだよ。\n話もあるし、場所を変えようぜ？", "face": "u446"}, {"name": "アンナ", "text": "ドゥーラさんからの嬉しいお知らせ、\nと言うのは嫌な予感もしますが……。\n王子、執務室へ移動しましょうか。", "face": "ld659d95e8019"}]}], "map": {"image": "Map920095_5200", "w": 960, "h": 640, "spots": [{"k": "b", "x": 25, "y": 290}, {"k": "m", "x": 717, "y": 308, "id": 200}, {"k": "m", "x": 583, "y": 303, "id": 201}, {"k": "m", "x": 566, "y": 221, "id": 202}, {"k": "m", "x": 498, "y": 201, "id": 203}, {"k": "m", "x": 419, "y": 191, "id": 204}, {"k": "m", "x": 335, "y": 187, "id": 205}, {"k": "m", "x": 262, "y": 226, "id": 206}, {"k": "m", "x": 522, "y": 408, "id": 207}, {"k": "m", "x": 445, "y": 415, "id": 208}, {"k": "m", "x": 369, "y": 412, "id": 209}, {"k": "m", "x": 281, "y": 362, "id": 210}, {"k": "m", "x": 238, "y": 287, "id": 211}, {"k": "m", "x": 148, "y": 270, "id": 212}, {"k": "r", "x": 657, "y": 262, "id": 300}, {"k": "r", "x": 627, "y": 376, "id": 301}, {"k": "r", "x": 501, "y": 271, "id": 302}, {"k": "r", "x": 415, "y": 241, "id": 303}, {"k": "r", "x": 337, "y": 258, "id": 304}, {"k": "r", "x": 343, "y": 312, "id": 305}, {"k": "r", "x": 413, "y": 343, "id": 306}, {"k": "r", "x": 495, "y": 339, "id": 307}, {"k": "r", "x": 538, "y": 159, "id": 308}, {"k": "r", "x": 462, "y": 142, "id": 309}, {"k": "r", "x": 387, "y": 135, "id": 310}, {"k": "r", "x": 298, "y": 137, "id": 311}, {"k": "r", "x": 195, "y": 209, "id": 312}, {"k": "r", "x": 391, "y": 471, "id": 313}, {"k": "r", "x": 245, "y": 413, "id": 314}, {"k": "r", "x": 199, "y": 361, "id": 315}]}, "start_cost": 10, "active": true, "story_talk": true, "name_en": "Re-Invitation from the Demon Realm", "description_en": "Hearing reports of Monster appearances, the Princes set out to subdue them. But who is this interloper who appears before 