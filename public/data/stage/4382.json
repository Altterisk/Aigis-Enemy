gic_defense": 15, "attack_range": 40, "attack_speed": 80, "attack_wait": 30, "attack_interval": 91, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102496, "race_id": 16, "special_effect_id": 229, "missile_id": 45, "master_id": 335, "global_id": 334, "ranged": true, "spawn_sec": 82}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["帝国"], "hp": 6650, "attack": 700, "base_hp": 7000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 15, "attack_range": 60, "attack_speed": 70, "attack_wait": 30, "attack_interval": 91, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102464, "race_id": 16, "special_effect_id": 229, "missile_id": 45, "master_id": 333, "global_id": 332, "ranged": true, "spawn_sec": 83}, {"enemy_id": 6, "source": "local", "count": 29, "form_count": 1, "hp": 1425, "attack": 142, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 98}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 1710, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 118}], "dialogue": [{"trigger": "start", "lines": [{"name": "帝国軍師", "text": "全軍、進め！　この先にある神殿と、そこを拠点と\nしている帝国に敵対する者たちを倒すのだ！", "face": "u311"}, {"name": "アンナ", "text": "待ってください！　あなた方は\n白の帝国の軍隊ですか？", "face": "la09ad7060e76"}, {"name": "帝国軍師", "text": "いかにも。我々は白の帝国の軍である。\nそちらから出向いてくれるとは好都合だ。", "face": "u311"}, {"name": "帝国軍師", "text": "我が帝国と皇帝陛下の御為に、\nそこの王子の首を差し出してもらおう。", "face": "u311"}, {"name": "帝国軍師", "text": "そうすれば我々は大人しく帝国に\n戻ってやる。", "face": "u311"}, {"name": "アンナ", "text": "そ、そんなことできませんっ！", "face": "la09ad7060e76"}, {"name": "アンナ", "text": "なぜ帝国が王子を狙っているのですか！？\n今は人間同士が争っている場合ではありません！", "face": "la09ad7060e76"}, {"name": "帝国軍師", "text": "ふふっ。確かに今は魔物たちのせいで\n人間同士が戦っている場合ではない。\nしかし魔物を退けた後はどうなる。", "face": "u311"}, {"name": "帝国軍師", "text": "多くの国が滅びた今、世界の覇権を\n手にするのはそう難しくない。", "face": "u311"}, {"name": "帝国軍師", "text": "その時に我が帝国の最も邪魔になる存在。\nそれがお前たちと言うわけだ。", "face": "u311"}, {"name": "帝国軍師", "text": "今はまだ勢力としては小さいが、\nしかし必ず我が帝国の覇道を\n脅かす存在となる……！", "face": "u311"}, {"name": "帝国軍師", "text": "その前に決着をつけようと\n我らがやってきたのだ。", "face": "u311"}, {"name": "アンナ", "text": "そんな……。", "face": "la09ad7060e76"}]}, {"trigger": "battle", "at_sec": 85, "lines": [{"name": "イザベル", "text": "天馬騎士団、到着しました。", "face": "u286"}, {"name": "帝国軍師", "text": "遅かったな。\n……さてお前たち。敵は目の前だ。\n今こそその翼で敵を蹴散らせッ！！", "face": "u311"}, {"name": "イザベル", "text": "……！　あれが敵、ですか。\n彼らは魔物たちと戦っている小国の生き残りでは……。", "face": "u286"}, {"name": "帝国軍師", "text": "いずれ帝国を脅かす存在となる者たちだ。\nそうなる前に倒すことが帝国を守ることになる。", "face": "u311"}, {"name": "イザベル", "text": "了解、しました。\n……それが、皇帝陛下のご意思ならば……、\n私はそれに従うまで……っ。", "face": "u286"}]}, {"trigger": "battle", "at_sec": 98, "lines": [{"name": "帝国軍師", "text": "天馬騎士団も到着した……、\nそろそろだな。", "face": "u311"}, {"name": "帝国軍師", "text": "よし。黒の軍団を出せ。", "face": "u311"}, {"name": "イザベル", "text": "黒の軍団……っ！？\nあの魔物共を連れてきたのですか……っ！", "face": "u286"}, {"name": "帝国軍師", "text": "そうだ。お前が黒の軍団を快く\n思っていないのは知っている。\nゆえに、本隊とは別行動をとらせていた。", "face": "u311"}, {"name": "イザベル", "text": "……目的の為ならば、手段は選ばないと\nいうことですか！？", "face": "u286"}, {"name": "帝国軍師", "text": "聞きたいことは勝利してから聞いてやる。\nまずは帝国の敵を打ち倒せ！！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "帝国軍師", "text": "さすが……というべきか。\n一旦後退する。態勢を整えるぞ。", "face": "u311"}]}], "active": true}