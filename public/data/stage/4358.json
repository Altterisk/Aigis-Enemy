d": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 16}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 12600, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "missile_id": 6, "master_id": 355, "global_id": 354, "ranged": true, "spawn_sec": 32}, {"enemy_id": 6, "source": "local", "count": 9, "form_count": 1, "tags": ["アンデッド"], "hp": 2940, "attack": 788, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 83}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 12600, "attack": 600, "base_hp": 12000, "base_attack": 600, "damage_type": "magical", "armor_defense": 250, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 50, "attack_interval": 165, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102000, "missile_id": 6, "master_id": 346, "global_id": 345, "ranged": true, "spawn_sec": 139}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "追いつきました！\nリーンベルさんを返してください！", "face": "l4add1c18b394"}, {"name": "メトゥス", "text": "くくくっ、見事に罠にハマるなんて……。\n本当に可愛い坊やだわ……。", "face": "u329"}, {"name": "メトゥス", "text": "あなたたちを倒す奥の手を紹介してあげようかしら？\nさぁ、みて頂戴……私の傑作。\nドラゴンゾンビよ……！", "face": "u329"}, {"name": "アンナ", "text": "ドラゴン、ゾンビ……！？", "face": "l4add1c18b394"}, {"name": "メトゥス", "text": "このドラゴンは実験の過程で生まれたものだけどー、\nなんといっても体力がすさまじいの。爪の攻撃を受け\n続けたら、麻痺して動けないでしょうね？", "face": "u329"}, {"name": "メトゥス", "text": "ブレスだって、あまり遠くには届かないのが\n惜しいところだけど、威力はすごいのよー。", "face": "u329"}, {"name": "アンナ", "text": "そんなものを生み出すなんて……。\nそれに王子、先ほどからリーンベルさんが\n見当たりません。", "face": "l4add1c18b394"}, {"name": "メトゥス", "text": "あぁ、さっきのお嬢さんならあのドラゴンの腹の中よ。\n私は別にあなたたちが逃げても構わないけど、\nお嬢さんは確実に生きて帰れないでしょうねぇ？", "face": "u329"}, {"name": "アンナ", "text": "酷いことを……。王子、ドラゴンゾンビを倒し、\nリーンベルさんを救出致しましょう！", "face": "l4add1c18b394"}]}, {"trigger": "end", "lines": [{"name": "メトゥス", "text": "あーらら、やられちゃった。ここまでやるなんて……。\nそれによく見たら坊や、いい男じゃない。\nあ、そうだわ。アンデッドになる気はない？", "face": "u329"}, {"name": "メトゥス", "text": "悪い話でもないのよ？　不死の存在になれば、\n魔物たちとの戦いも有利になるし。", "face": "u329"}, {"name": "アンナ", "text": "なんて馬鹿なことを……！", "face": "l4add1c18b394"}, {"name": "メトゥス", "text": "一回死んでみれば考えも変わるでしょう……。\nまた必ず、坊やを殺しに来てあげるわ。\nそれまでいい子で待っててね？", "face": "u329"}]}], "active": true}