al_id": 7179, "spawn_sec": 151}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127808, "race_id": 21, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 33562, "global_id": 7179, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 26, "source": "local", "count": 7, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127760, "race_id": 21, "change_to": 26, "change_condition": 4, "master_id": 33555, "global_id": 7172, "to_condition": 4, "to_ticks": 3, "to_global_id": 7175, "spawn_sec": 151}, {"enemy_id": 26, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127776, "race_id": 21, "special_effect_id": 222, "master_id": 33558, "global_id": 7175, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 30, "source": "local", "count": 4, "form_count": 2, "hp": 8000, "attack": 1400, "base_hp": 8000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "change_to": 30, "change_condition": 4, "master_id": 33563, "global_id": 7180, "to_condition": 4, "to_ticks": 3, "to_global_id": 7183, "spawn_sec": 155}, {"enemy_id": 30, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}], "popups": ["亜神ペルセフォネは\n不完全な復活によって\n体力が徐々に減少していきます。", "大神降臨ペルセフォネが\n解放されました。\n\nホーム画面左側の\nミッションクエストにある、\n魔神降臨のメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ハイドース", "text": "――存外、早かったな。\nスイゼが裏切ったか。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "疑念あれど貴様を信じた忠臣を、\nよりにもよって裏切り者扱いか。"}, {"name": "アンジェリーネ", "text": "これまでの冥界連合軍との戦いで、\nあなたのこと、ようやく分かってきましたわ。", "face": "u430"}, {"name": "アンジェリーネ", "text": "ハイドース、あなたは誰も信じていないのね。", "face": "u430"}, {"name": "アンジェリーネ", "text": "……いえ、誰も信じられなくなった、のかしら。", "face": "u430"}, {"name": "ハイドース", "text": "スイゼから聞いたのか。\nあるいはポセイオスか、ディアスからか？\nまさか秘密主義のアダマスが漏らすことはあるまい。", "face": "le4066daa294e"}, {"name": "アンジェリーネ", "text": "哀れな。\nもう、自分と、亡き妻のことしか見えていないのね。", "face": "u430"}, {"name": "アンジェリーネ", "text": "本来のあなたは、慈悲深く、\n物質界の命を愛し、\nゆえに苦悩する善神だったのでしょうに。", "face": "u430"}, {"name": "ハイドース", "text": "……ほう。\nまだこの身を善なる神であったと言えるのか。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "冥界の神にあって、貴様は唯一、\n死者を慈しむだけでなく、\nいずれ死にゆく生者の苦しみを憂いた。"}, {"name": "白の皇帝", "text": "いらない世話だが、その想いは、\nまぎれもなく愛ある神そのものだ。"}, {"name": "ハイドース", "text": "…………不思議なものだ。\n生者にそう呼ばれることを、\n嬉しく思う心が我が身に残っていたとは。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "しかし、憂いも、後悔も、\nすべては今日のためにあった。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "我が宿願は、今日、ここに成就する。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "――かつて我らは、定命の苦しみを終わらせるべく、\n世界すべての命を、\n生まれる前に冥界へ呑み込まんとした。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "二度と生命の生まれることのない、\n新たな苦しみのない世界を作ろうとしたのだ。", "face": "le4066daa294e"}, {"name": "アンジェリーネ", "text": "……けれど、それは失敗した。", "face": "u430"}, {"name": "ハイドース", "text": "アダマスめは、我が肉体を破壊し、\n魂までをも砕かんとした。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "……しかし、我が妻、ペルセフォネは、\n滅びゆく我に魔力のすべてを注ぎ、\nそのためにアダマスに封じられてしまった。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "ならば、貴様の悲願とは。"}, {"name": "ハイドース", "text": "知れたこと。\n失われし我が伴侶の復活に他ならぬ。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "そのためになら、世界など敵に回しても構わない。\nただもう一度だけ、\n愛しき者を、この腕に抱くことができるなら。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "……貴様にも、理解できよう？\n大切なものを失った世界に、\n如何なる価値があるものか。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "…………。"}, {"name": "白の皇帝", "text": "ならば、貴様も理解しているはずだ。\n身勝手な理由で、大切なものを奪われる苦痛を。"}, {"name": "ハイドース", "text": "…………理解してなお、止められぬこともある。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "さぁ、始めよう。\nこれより復活の儀式は最後の工程を迎える。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "物質界の半数の命をここに捧げよう。\nそして、我が妻の復活の暁には、\n残る半数の命を、我らが慈愛を持って滅ぼそう！", "face": "le4066daa294e"}]}, {"trigger": "start", "lines": [{"name": "ヴィラヘルム", "text": "――生命の、生への執着を甘く見すぎです。", "face": "u2245a1"}]}, {"trigger": "start", "lines": [{"name": "ヘイズル", "text": "……そして、白の帝国という、\n私たちの国に喧嘩を売ったのも大いなる失敗だった。", "face": "u2248a1"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "白の皇帝", "text": "神もまた、生命のひとつである、か。\n貴様の想い、理解できないことはないが――"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "白の皇帝", "text": "――断じて、許容はできない。\n亜神ハイドース、伴侶共々、俺がここで斬り捨てる。"}, {"name": "ハイドース", "text": "白の、皇帝……ッ、アダマスの信徒がぁぁぁぁッ！！", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "皇帝とは、誰かの願いの器ではない。\nようやく理解できたぞ、王子。"}, {"name": "白の皇帝", "text": "国を率いる者とは、大切なもののために、\n誰から恨まれようと、どんな因縁を背負おうと、\n決して止まらず歩み続ける者のことだ。"}, {"name": "白の皇帝", "text": "――ハイドース、貴様の願いは、俺が断ち切る。"}, {"name": "ハイドース", "text": "おのれ、アダマスの信徒ども……。\nああ、我が、妻よ……愛しき、ペルセフォネ、よ……。", "face": "le4066daa294e"}, {"name": "スイゼ", "text": "……ハイドースさまッ！", "face": "u2250a1"}, {"name": "レオナ", "text": "…………これで、全て――", "face": "u311"}, {"name": "ヘイズル", "text": "――いや、何かがおかしい。\n儀式が……止まっていない……？", "face": "u2248a1"}, {"name": "スイゼ", "text": "違う……儀式は失敗した……。\nこれは、不完全な形に終わった魔術が、\n膨大な魔力に耐えきれず、暴走している……。", "face": "u2250a1"}, {"name": "ヘイズル", "text": "まずい……この魔力……なるほど、\n物質界そのものを冥界に落とすなんて言えるわけだ。\nこんなの、アダマス様だって封じるしかない！", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "来ます……亜神、ペルセフォネが！", "face": "u2245a1"}]}, {"trigger": "battle", "at_sec": 9, "lines": [{"name": "亜神ペルセフォネ", "text": "…………あ、な……た。", "face": "lb6c5301f531a"}, {"name": "亜神ペルセフォネ", "text": "どう……か……い……きて……。", "face": "lb6c5301f531a"}, {"name": "ハイドース", "text": "なっ……やめろ！\nペルセフォネ！　我を置いていくな！\n今度こそ、お前と――", "face": "le4066daa294e"}]}, {"trigger": "battle", "at_sec": 14, "lines": [{"name": "ヘイズル", "text": "ハイドースを逃がしたか！\nちぃっ……全部一気に片付けたかったのに！", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "泣き言は後にしましょう。\n不完全な状態とはいえ、敵は世界を滅ぼしうる亜神です！", "face": "u2245a1"}, {"name": "ヘカティエ", "text": "身体が崩壊しつつあるというのに、\nそう、私たちと戦うつもりのようね……。\n夫を無事に逃がすためかしら。", "face": "u1226a1"}, {"name": "ヘイズル", "text": "正気を保っていないのが唯一の救いかな。\nあの状態なら、神としての権能も振るえないはず。", "face": "u2248a1"}, {"name": "白の皇帝", "text": "奴を見逃せば、あの状態であっても\n物質界にどんな被害があるかわからない。"}, {"name": "白の皇帝", "text": "――聞け、白の帝国が誇る戦士たち。\n帝国が強くあるのは、理不尽に打ち勝つためだ。\n生きることを、諦めないためだ。"}, {"name": "白の皇帝", "text": "今、ここで、亜神ペルセフォネを討つ。"}]}, {"trigger": "end", "lines": [{"name": "ヘイズル", "text": "……亜神ペルセフォネ、消滅。\n魔力の痕跡も……感じられない。", "face": "u2248a1"}, {"name": "アンジェリーネ", "text": "またひとつ、恨みを買いましたわね。", "face": "u430"}, {"name": "白の皇帝", "text": "歩み続けるということは、\n相反する意志を砕き、進むということだ。"}, {"name": "白の皇帝", "text": "あいつはまた、違うことを言うだろうが、\n白の帝国はより強くあるべきだろう。\n立ちはだかるものは、すべて砕いて行こう。"}, {"name": "スイゼ", "text": "……ハイドース、さま。", "face": "u2250a1"}, {"name": "ヘイズル", "text": "そこに、さっそく君の背中を刺しそうな子がいるけど？", "face": "u2248a1"}, {"name": "白の皇帝", "text": "スイゼ、そうしたければ、いつでも殺しに来い。\n帝国法はすべての者に、皇帝との決闘を認めている。"}, {"name": "スイゼ", "text": "…………分からない。\nどうするべきだったのか、これから、どうすべきなのか。", "face": "u2250a1"}, {"name": "ヴィラヘルム", "text": "それなら、一緒に来ませんか。\n彼を殺すにせよ、他の道を探すにせよ、\nこの場所は――もう、寂しすぎますから。", "face": "u2245a1"}, {"name": "スイゼ", "text": "…………。", "face": "u2250a1"}, {"name": "白の皇帝", "text": "判断は、好きにしろ。\nついてくるつもりなら、後を追ってこい。"}, {"name": "白の皇帝", "text": "レオナ、帝国全軍に通達。\nこれより帝都へ帰還する。\n道中でハイドースの痕跡も探せ。"}, {"name": "レオナ", "text": "はっ！", "face": "u311"}, {"name": "白の皇帝", "text": "ハイドースは討ち損ねたが……。\n今の帝国に必要なのは、凱旋だろう。"}, {"name": "白の皇帝", "text": "帰るぞ、俺たちの国へ。"}]}, {"trigger": "end", "lines": [{"name": "スイゼ", "text": "……ハイドース様。", "face": "u2250a1"}, {"name": "スイゼ", "text": "あなたの焦りは、きっと、誰にも知られていない。\n定命の者にとって、想像も及ばない苦しみだろうから。", "face": "u2250a1"}, {"name": "スイゼ", "text": "庭園が少しずつ朽ちていくことに、\nどれだけ手を入れても、静かに、\n冷たくなっていくことに、貴方は苦悩していた。", "face": "u2250a1"}, {"name": "スイゼ", "text": "私はただ、その背中を見ていることしかできなかった。", "face": "u2250a1"}, {"name": "スイゼ", "text": "あなたの、ペルセフォネ様への愛が揺らぎ、\n奥方の自我が砕け始めた結果が、庭園の荒廃だとすれば。\nやはり、永遠というものは、生命には長すぎる……。", "face": "u2250a1"}, {"name": "スイゼ", "text": "会えない時間、言葉を交わせない時間が、\nどれだけ、あなたを苦しめてきたのか。", "face": "u2250a1"}, {"name": "ヘカティエ", "text": "――その言葉、本人にきかせてあげなさいよ。", "face": "u1226a1"}, {"name": "スイゼ", "text": "……臣下の言葉なんて、\nもうハイドース様には届かないさ。", "face": "u2250a1"}, {"name": "ヘカティエ", "text": "じゃあ、届けに行きなさいよ。", "face": "u1226a1"}, {"name": "スイゼ", "text": "…………冥界の亜神だと言っても、\nヘカティエ、お前は我が主とは大違いだ。", "face": "u2250a1"}, {"name": "スイゼ", "text": "冷たくて、人の心が分からなくて、\nそれなのに、自分勝手に励ましてくる。", "face": "u2250a1"}, {"name": "ヘカティエ", "text": "じゃあ、嫌っていいわよ？\nあなたがそれで立ち上がれるなら、安いものよ。", "face": "u1226a1"}, {"name": "スイゼ", "text": "ふん……。\n言われるまでもない。", "face": "u2250a1"}, {"name": "スイゼ", "text": "（盲信するだけが、忠義じゃない、か――）", "face": "u2250a1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 18, "params": [120]}, {"kind": "term", "influence": 20, "params": [120]}, {"kind": "term", "influence": 25, "params": [300], "expression": "IsAssign(\"帝国\") != 1;", "expression_human": "it is assigned to [[tag:白の帝国]] != 1"}], "enemies": [{"enemy_id": 1, "hp": 550000, "attack": 5500, "damage_type": "magical", "armor_defense": 1700, "magic_defense": 55, "pattern_id": 2155408}, {"enemy_id": 1, "form_index": 1, "hp": 550000, "attack": 5500, "damage_type": "magical", "armor_defense": 1700, "magic_defense": 55, "pattern_id": 2155264}, {"enemy_id": 4, "hp": 300000, "attack": 1, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "pattern_id": 2155104}, {"enemy_id": 7, "hp": 300000, "attack": 1, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "pattern_id": 2155088}, {"enemy_id": 10, "hp": 300000, "damage_type": "true", "armor_defense": 1300, "magic_defense": 20, "pattern_id": 2151648}, {"enemy_id": 13, "hp": 360000, "attack": 4000, "damage_type": "magical", "armor_defense": 800, "magic_defense": 45, "pattern_id": 2155184}, {"enemy_id": 15, "hp": 2000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 15, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 17, "hp": 3000, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2155216}, {"enemy_id": 17, "form_index": 1, "hp": 2000, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2155232}, {"enemy_id": 19, "hp": 23000, "attack": 700, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2138576}, {"enemy_id": 20, "hp": 4000, "attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "pattern_id": 2101328}, {"enemy_id": 21, "hp": 6000, "attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "pattern_id": 2103472}, {"enemy_id": 22, "hp": 2500, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 22, "form_index": 1, "hp": 2500, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 26, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 26, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 30, "hp": 8000, "attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127824}, {"enemy_id": 30, "form_index": 1, "hp": 8000, "attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127840}]}, "active": true}