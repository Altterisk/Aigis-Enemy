{"quest_id": 8350, "name": "第八陣 亜神ペルセフォネ", "description": "亜神ハイドースの妄執による復活の儀式を\n阻止するも、魔術の暴走により正気を失い\n不完全な形で亜神ペルセフォネが蘇る……。\n神級（★１獲得の目安：平均Lv50）", "event": "帝国八陣", "event_category": "Empire", "mission_id": 940008, "map_no": 5066, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 550000, "attack": 5500, "base_hp": 550000, "base_attack": 5500, "damage_type": "magical", "armor_defense": 1700, "magic_defense": 55, "attack_wait": 54, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2155408, "race_id": 19, "special_effect_id": 1039, "change_to": 1, "master_id": 37829, "global_id": 11446, "to_global_id": 11448, "to_flag": [0, 1], "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "route_behaviour": {"transforms": [{"val": 1}, {"flag": 1, "val": 1}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 550000, "attack": 5500, "base_hp": 550000, "base_attack": 5500, "damage_type": "magical", "armor_defense": 1700, "magic_defense": 55, "attack_wait": 54, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2155264, "race_id": 19, "master_id": 37831, "global_id": 11448, "from_flag": [0, 1]}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 300000, "attack": 1, "base_hp": 300000, "base_attack": 1, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2155104, "race_id": 16, "change_to": 4, "master_id": 37824, "global_id": 11441, "variants": [{"tags": ["置物",