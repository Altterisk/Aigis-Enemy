{"quest_id": 7776, "name": "お菓子の兵隊と小人たち", "description": "ヘンゼルの痕跡を辿って森の奥へ進んで\nいくと、そこには何故かスプリガンがいて？\n＜特定のタイミングで吹雪が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "聖樹の森とおかしな家の魔女", "event_category": "History", "mission_id": 920188, "map_no": 4645, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 2, "hp": 7000, "attack": 900, "base_hp": 7000, "base_attack": 900, "damage_type": "physical", "armor_defense": 200, "magic_defense": 15, "attack_speed": 1, "attack_wait": 40, "attack_interval": 130, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137072, "race_id": 10, "special_effect_id": 54, "change_to": 1, "change_condition": 2, "master_id": 34918, "global_id": 8535, "to_condition": 2, "to_global_id": 8536}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 90000, "attack": 2500, "base_hp": 90000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 900, "magic_defense": 5, "attack_speed": 150, "attack_wait": 10, "attack_interval": 231, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137088, "race_id": 10, "master_id": 34919, "global_id": 8536, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 21, "form_count": 1, "hp": 5600, "base_hp": 5600, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 102, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2140608, "special_effect_id": 1179, "master_id": 35466, "global_id": 9083}, {"enemy_id": 4, "source": "local", "count": 19, "form_count": 1, "tags": ["バレンタイン"], "hp": 1600, "attack": 500, "base_hp": 1600, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "attack_range": 100, "attack_speed": 70, "attack_wait": 50, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113952, "missile_id": 257, "missile": {"speed": 2.0}, "master_id": 30905, "global_id": 4524, "ranged": true, "spawn_sec": 27}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 308, "change_to": 5, "master_id": 32290, "global_id": 5909, "to_global_id": 5920, "spawn_sec": 50}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 275, "change_to": 4, "master_id": 32301, "global_id": 5920}, {"enemy_id": 7, "source": "local", "count": 5, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "spawn_sec": 124}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 275, "change_to": 4, "master_id": 32301, "global_id": 5920, "to_global_id": 5909, "spawn_sec": 165}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 308, "change_to": 5, "master_id": 32290, "global_id": 5909}], "dialogue": [{"trigger": "start", "lines": [{"name": "グレーテル", "text": "こっちだよ！　向こうにお兄ちゃんが──", "face": "u1652a1"}]}, {"trigger": "start", "lines": [{"name": "スプリガン", "text": "──だべ？", "face": "l28d95d79733d"}, {"name": "グレーテル", "text": "全然お兄ちゃんじゃない！？", "face": "u1652a1"}, {"name": "ハルモニア", "text": "なぜスプリガンがここに……？　\nジューンブライドの祝祭前の事件で、\n東の国に捕まり死んだはずでは……？", "face": "u1651a1"}, {"name": "ドリー", "text": "ん？　地下施設で労働させられてるんじゃなかったか？", "face": "u1399a1"}, {"name": "ヘレナ", "text": "何にせよクッキーの兵隊を率いているのを見るに、\n今回の黒幕か、またはその一味に間違いはないな。", "face": "u1397a1"}, {"name": "コーネリア", "text": "つまりちびっ子の敵か、処さねばならんな。", "face": "u725"}, {"name": "スプリガン", "text": "なっ、なんだがよぐわがんねぇけど好機だべや！\nお前たち、あのちんまい娘っ子たちを捕まえるべ！", "face": "l28d95d79733d"}, {"name": "グレーテル", "text": "わたしとドリーのこと……？", "face": "u1652a1"}, {"name": "小人", "text": "褐色悪魔お姉さん！　金髪清楚お姉さん！", "face": "lf60f2a76ce07"}, {"name": "スプリガン", "text": "そっちはいらないべ。", "face": "l28d95d79733d"}, {"name": "ローズ＆ハルモニア", "text": "は？", "face": "la3bf3089a06c"}, {"name": "ハルモニア", "text": "……どうやら害虫の駆除が必要なようですね？", "face": "u1651a1"}, {"name": "ローズ", "text": "ふふふ……ちょうど手元に園芸用の殺虫剤が。", "face": "u1649a1"}, {"name": "ヘレナ", "text": "あー、そいつも一応は容疑者の一人だからな。\nやり過ぎない程度に加減……と言っても無駄か。", "face": "u1397a1"}, {"name": "ドリー", "text": "おーし、今から殴るけど、強く生きろよスプリガン。", "face": "u1399a1"}, {"name": "スプリガン", "text": "だべぇええええ！？", "face": "l28d95d79733d"}]}, {"trigger": "end", "lines": [{"name": "ヘレナ", "text": "よーし、そこまで。それ以上は洒落にならん。", "face": "u1397a1"}, {"name": "スプリガン", "text": "だ、だべぇ……。", "face": "l28d95d79733d"}, {"name": "チヨメ", "text": "こんにちはー、脱走犯の回収に来ましたー。", "face": "u1144a1"}, {"name": "スプリガン", "text": "ひぃっ！？", "face": "l28d95d79733d"}, {"name": "ヨシノ", "text": "目を離すとすーぐ家出するよね、君。", "face": "u1104a1"}, {"name": "ヨシノ", "text": "あーあー、こんなに震えちゃってさ。\n寒かったね、お風呂に入れてあげないと。", "face": "u1104a1"}, {"name": "スプリガン", "text": "（ガタガタブルブル）", "face": "l28d95d79733d"}, {"name": "コーネリア", "text": "もしかしてそれって釜ゆ──", "face": "u725"}, {"name": "チヨメ", "text": "──非暴力的かつ合法的なちょっと熱めのお風呂です。", "face": "u1144a1"}, {"name": "コーネリア", "text": "なんだ、ちょっと熱めのお風呂か。", "face": "u725"}, {"name": "ヘレナ", "text": "……さて、それはそうとお前たち、\nこんなところで何をやっていたんだ？", "face": "u1397a1"}, {"name": "小人", "text": "人、集める。お菓子、もらえる。", "face": "lf60f2a76ce07"}, {"name": "ローズ", "text": "ジューンブライドのときと同じ形みたいですね。\n小人さん、あなたにそれを依頼したのは誰ですか？", "face": "u1649a1"}, {"name": "小人", "text": "チョコレート。", "face": "lf60f2a76ce07"}, {"name": "ローズ", "text": "ああいや、もらえるお菓子の話ではなく……。", "face": "u1649a1"}, {"name": "ハルモニア", "text": "待ってくださいローズ。\n私たちはすでに知っているはずです、\nチョコレートとしか言いようのない存在を。", "face": "u1651a1"}, {"name": "ローズ", "text": "──ッ！　まさか……。", "face": "u1649a1"}, {"name": "ローズ", "text": "チョコレート騎士団……？", "face": "u1649a1"}]}], "active": true}