{"quest_id": 7246, "name": "グルメジャングルの奇跡を見た！", "description": "再び足を踏み入れたグルメジャングルで\n一行はチョコレート畑を凌駕する\n奇跡の生態系を目撃する！\n神級（★１獲得の目安：平均Lv50）", "event": "魅惑のチョコレート・トラップ", "event_category": "History", "mission_id": 920156, "map_no": 5868, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 1, "tags": ["バレンタイン"], "hp": 12000, "attack": 650, "base_hp": 12000, "base_attack": 650, "damage_type": "physical", "armor_defense": 800, "attack_speed": 10, "attack_wait": 10, "attack_interval": 66, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127040, "special_effect_id": 712, "master_id": 33411, "global_id": 7028}, {"enemy_id": 2, "source": "local", "count": 14, "form_count": 1, "tags": ["バレンタイン"], "hp": 1600, "attack": 500, "base_hp": 1600, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "attack_range": 100, "attack_speed": 70, "attack_wait": 50, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113952, "missile_id": 257, "missile": {"speed": 2.0}, "master_id": 30905, "global_id": 4524, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 25, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 308, "change_to": 3, "master_id": 32290, "global_id": 5909, "to_global_id": 5920, "spawn_sec": 32}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 275, "change_to": 2, "master_id": 32301, "global_id": 5920}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["バレンタイン"], "hp": 55000, "attack": 2100, "base_hp": 55000, "base_attack": 2100, "damage_type": "physical", "armor_defense": 1800, "attack_speed": 10, "attack_wait": 10, "attack_interval": 66, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 2.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127040, "special_effect_id": 712, "master_id": 33412, "global_id": 7029, "spawn_sec": 99}, {"enemy_id": 6, "source": "local", "count": 10, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 39, "change_to": 6, "missile_id": 6, "master_id": 32291, "global_id": 5910, "ranged": true, "to_global_id": 5923, "spawn_sec": 153}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 5, "missile_id": 6, "master_id": 32304, "global_id": 5923}, {"enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "tags": ["バレンタイン"], "hp": 35000, "attack": 1120, "base_hp": 35000, "base_attack": 1120, "damage_type": "physical", "armor_defense": 1200, "attack_range": 100, "attack_speed": 70, "attack_wait": 50, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 2.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113952, "missile_id": 521, "missile": {"speed": 2.0}, "master_id": 33413, "global_id": 7030, "ranged": true, "spawn_sec": 205}], "popups": ["チョコ王子がいる間は、\nチョコ系の敵の攻撃と防御が\nアップします。\n\nまた、チョコ王子の数に応じて\n効果が重複します。", "チョコマイコニドがいる間、\n全ての味方ユニットは\n継続ダメージを受けます。\n\nまた、チョコマイコニドの数に応じて\n効果が重複します。", "チョコトレントは\n徐々に自身のHPを回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーヴ", "text": "――チョコなくしてバレンタインなし。\n至高のカカオ豆を手に入れるため、我々王国軍は\nグルメジャングルに再び、足を踏み入れたのだった――。", "face": "u454"}, {"name": "エレット", "text": "レーヴさんって真面目だよね。\nこういうの、全部書き残しているの？", "face": "u1152a1"}, {"name": "レーヴ", "text": "えぇ、書記官として当然のつとめですから。\n後世に間違って情報が伝わらないよう、\n何事も正確に書き残さないと！", "face": "u454"}, {"name": "エレット", "text": "あっ、ちょっと分かるかも……。\n神殿の本を読むと、結構曖昧だったりして\n困ることあるもんね。", "face": "u1152a1"}, {"name": "レーヴ", "text": "そう、そうなんです！\nなので王子の記録については、\nしっかり正確に残しておきたいんです。", "face": "u454"}, {"name": "王子？", "text": "…………。", "face": "lec7912a04259"}, {"name": "エレット", "text": "ほら、噂をすれば♪\n王子、そろそろ休憩も終わりだよね。\nグルメジャングルの奥へ進もうか！", "face": "u1152a1"}, {"name": "王子？", "text": "…………。", "face": "lec7912a04259"}]}, {"trigger": "start", "lines": [{"name": "レーヴ", "text": "え、エレットさん！\nこの王子、何だか様子が変ですよ！\nだ、だだだ、だって、ふたり、王子がふたりいます！！", "face": "u454"}, {"name": "エレット", "text": "見間違いじゃないよね！？\n王子がふたりいるし、人型のチョコが踊ってるし！", "face": "u1152a1"}, {"name": "エレット", "text": "どうみても魔法生物だね……！\nそれに偽王子のまわりのチョコ、\nなんだか活発になってないかな！", "face": "u1152a1"}, {"name": "レーヴ", "text": "魔力供給でもしてるんでしょうか！？\n本物の王子さながらの士気高揚ですよ！", "face": "u454"}, {"name": "エレット", "text": "ね、ねぇレーヴさん！\nこれはどう書き残すの！？", "face": "u1152a1"}, {"name": "レーヴ", "text": "書き残す前に本物の王子に報告です！\nた、助けてくださーい！！", "face": "u454"}]}, {"trigger": "end", "lines": [{"name": "レギーナ", "text": "……聞いたことがあるぞ。\nグルメジャングルは、そこに踏み入った強者を\n植物で模倣することがあるんだとか……。", "face": "u405"}, {"name": "レーヴ", "text": "なるほど、植物が自己防衛に、\n毒を持ったり、溶解液を持ったりするのと同じと。", "face": "u454"}, {"name": "エレット", "text": "それで、前にドラコレックスと戦った、\n強者である王子そっくりのチョコを生み出したんだ……。", "face": "u1152a1"}, {"name": "レギーナ", "text": "この森には食材と魔力が満ちている。\nグルメジャングル、まさしく奇跡の生態系だな。", "face": "u405"}, {"name": "エレット", "text": "でも、だからこそ\n最高の食材が待ってるってことだよね！", "face": "u1152a1"}, {"name": "レギーナ", "text": "ふふっ、分かっているなエレット！\n無事に帰ったら、試食は私に任せてくれ！", "face": "u405"}, {"name": "エレット", "text": "もうっ、試食だけじゃなくて一緒に作ろうよ！\nレギーナさんのチョコ、あたしも食べてみたいな♪", "face": "u1152a1"}, {"name": "レギーナ", "text": "むっ、私もお菓子には一家言あるぞ。\nぜひとも一緒につくろうじゃないか。", "face": "u405"}, {"name": "レーヴ", "text": "あっ、わ、私も一緒にいいですか……？\n魔力のこもった食材は扱ったことがなくて……。", "face": "u454"}, {"name": "エレット", "text": "もちろん♪\nよぉし、みんなで幻のカカオ豆を見つけよう！", "face": "u1152a1"}]}], "active": true}