": 750, "base_hp": 16000, "base_attack": 750, "damage_type": "physical", "armor_defense": 600, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 123, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112672, "race_id": 2, "special_effect_id": 248, "missile_id": 11, "master_id": 30713, "global_id": 4332, "ranged": true, "spawn_sec": 148}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "attack_range": 260, "attack_speed": 30, "attack_wait": 200, "attack_interval": 473, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107952, "missile_id": 6, "master_id": 959, "global_id": 958, "ranged": true, "spawn_sec": 150}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112752, "race_id": 4, "special_effect_id": 54, "master_id": 30715, "global_id": 4334, "spawn_sec": 155}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112768, "race_id": 4, "special_effect_id": 54, "master_id": 30720, "global_id": 4339, "spawn_sec": 157}], "popups": ["メルヴィナは倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "（……私はなにを迷っているのでしょう？\n神より仰せつかりし、人間たちを滅ぼすという命を\n果たすために地上に降り立ったというのに……）", "face": "u548"}, {"name": "？？？", "text": "（全ては神の御心のままに……。\nそんな天使としての信念が、此の地で懸命に生きる\n人間たちの姿を目にしただけで揺らいでしまうとは）", "face": "u548"}, {"name": "？？？", "text": "（神よ……いま一度お示しください。\n人間たちは本当に、抹殺しなければならないほど\n愚かで不浄な存在なのでしょうか……？）", "face": "u548"}, {"name": "ファー", "text": "――は～な～せ～よぉ～～～っ！\n王子は、これからオレたちと\n街でデートするんだっつーの～～っ！", "face": "u327"}, {"name": "レアン", "text": "なにがデートだ！　無理やりさらったくせに！\nさぁ、王子は返してもらうぞ！", "face": "u50"}, {"name": "ナディア", "text": "もうっ！　どうして邪魔するの？\nせっかく王子と一緒に食べようと思って\n美味しいリンゴを採ってきたのにー！", "face": "u304"}, {"name": "？？？", "text": "（これは一体……？\n仲間同士で争っているように見受けられますが……）", "face": "u548"}, {"name": "アンナ", "text": "皆さん、一体どうしてしまったのですか？\n王子をさらって街へ連れ出すなんて……。", "face": "l0e4ad692db53"}, {"name": "ナタク", "text": "堕姫が落としたっていう赤い彼岸花が原因かもね。\nそれに乗り移った強い誘惑の力に影響されて、普段は\n抑制されている他者への情愛が表出してしまったんだ。", "face": "u297"}, {"name": "ナタク", "text": "――というわけで、王子はぼくが頂くよ！", "face": "u297"}, {"name": "レアン", "text": "ナタク、お前もか！", "face": "u50"}, {"name": "ドロテア", "text": "ひがむな、王国の者たちよ。\n貴様らと違い、我々はいわば他国からの来客。\n国の長たる王子に厚遇を求めるのは当然であろう？", "face": "u408"}, {"name": "テティス", "text": "バシラ～っ！\n私たちもデートしましょ～っ♪", "face": "u37"}, {"name": "ラピス", "text": "（――ッ！\nこの気配、ルチアも来ているのか……）", "face": "u436"}, {"name": "ケイティ", "text": "……とにかく、この事態を収拾しなくては。\n王子、向かってくる女性たちを鎮圧しましょう。", "face": "u114"}, {"name": "？？？", "text": "（愚かな……仲間同士で刃を向け合うとは。\nやはり神の仰せの通り、人間たちは我々天使の手で\n滅ぼさなければならないようですね……）", "face": "u548"}]}, {"trigger": "battle", "at_sec": 145, "lines": [{"name": "アンナ", "text": "あれは……天使？\n……いえ、翼が黒いので堕天使でしょうか？", "face": "l0e4ad692db53"}, {"name": "フォニア", "text": "私は天使フォニア。\n神の命により貴方がた人間を浄化しに来た者です。", "face": "u548"}, {"name": "フォニア", "text": "この黒き翼は、一瞬でも神のご意志を疑った\n不遜な私への戒めの証……。\nですが、もう迷いはしません。", "face": "u548"}, {"name": "フォニア", "text": "さぁ、戦きながら逝きなさい。\nこの銃が滅びの旋律を奏でる時です。", "face": "u548"}]}, {"trigger": "end", "lines": [{"name": "フォニア", "text": "（くっ……そんな馬鹿な……。\nこの私が……人間たちに、負ける……？）", "face": "u548"}, {"name": "イナリ", "text": "あいたたた……たんこぶできちゃった。", "face": "u1243"}, {"name": "カヨウ", "text": "だが、王子たちや皆に迷惑をかけたのは\nわらわたちの方のようだ。\nすまんのぅ。どうかしておったわ。", "face": "u1325"}, {"name": "メルヴィナ", "text": "あぁ。私も得体の知れない感情に衝き動かされ、\nついこの血塗られた魔剣を抜いてしまった……。", "face": "u1326"}, {"name": "アンナ", "text": "今回ばかりは仕方ありません。\n皆さんは赤い彼岸花に秘められた\n誘惑の力の影響を受けていたのですから。"}, {"name": "ルチア", "text": "ふぅ……それを聞いて安心した。\n今日の王子がやけに魅力的に見えたのは、\nその赤い彼岸花とやらのせいだったんだな？", "face": "u412"}, {"name": "フォニア", "text": "（……フォニア、惑わされてはなりません。\nたとえ赤い彼岸花とやらが原因の一端だとしても、\n人間同士が相争っていたのは紛れもない事実）", "face": "u548"}, {"name": "フォニア", "text": "（その争いの焦点となっていた\nあの王子という人間だけでも討たなければ――）", "face": "u548"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "フォニア", "text": "（ふふ、私に気づいてはいないようですね。\nその脳天気な頭を吹き飛ばしてあげましょう）", "face": "u548"}, {"name": "フォニア", "text": "……………………。", "face": "u548"}, {"name": "アンナ", "text": "――ッ！\n王子、危ない！　フォニアさんに狙われています！", "face": "l0e4ad692db53"}, {"name": "フォニア", "text": "……安心なさい。\n撃つつもりなら既に撃っています。", "face": "u548"}, {"name": "フォニア", "text": "今日のところは一旦退きましょう。\n私が銃の引き金を引けなかった、\nその理由をつきとめなくてはなりません。", "face": "u548"}, {"name": "ケイティ", "text": "……天使の撤退を確認。\n追わなくて良かったのですね？", "face": "u114"}, {"name": "アンナ", "text": "……ふぅ。天使が介入してくるとは予想外でしたが、\nなんとか一件落着したようですね。\nそれでは帰還致しましょう。"}]}], "active": true}