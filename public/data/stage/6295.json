{"quest_id": 6295, "name": "滅びを奏でし銃口", "description": "赤い彼岸花の影響を受け\n王子へと迫る女性陣。そんな一行を\n天より見下ろす堕天使の胸中とは……。\n神級（★１獲得の目安：平均Lv50）", "event": "傾国の妖狐と誘惑されし王子", "event_category": "History", "mission_id": 920099, "map_no": 5263, "level": 100, "multiplier": 1.0, "charisma": 115, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30717, "global_id": 4336, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "base_hp": 15000, "damage_type": "true", "armor_defense": 350, "magic_defense": 40, "attack_speed": 10, "attack_wait": 10, "attack_interval": 109, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108288, "race_id": 3, "special_effect_id": 110, "master_id": 30017, "global_id": 3636, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 40, "attack_wait": 30, "attack_interval": 133, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102272, "race_id": 16, "master_id": 369, "global_id": 368, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 8, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gai