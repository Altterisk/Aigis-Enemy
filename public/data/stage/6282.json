{"quest_id": 6282, "name": "王墓の決戦", "description": "棺から無数に湧き出るアンデッド、\n這い寄るサソリの麻痺針。苛烈なる\n戦場を制し、復活したバステトを討て！\n神級（★１獲得の目安：平均Lv50）", "event": "大怪盗とピラミッドの秘宝", "event_category": "History", "mission_id": 920098, "map_no": 5257, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 260, "base_hp": 12000, "base_attack": 260, "damage_type": "physical", "armor_defense": 210, "magic_defense": 30, "attack_range": 100, "attack_speed": 70, "attack_wait": 30, "attack_interval": 93, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112048, "race_id": 12, "special_effect_id": 193, "missile_id": 45, "master_id": 30641, "global_id": 4260, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 45000, "attack": 1000, "base_hp": 45000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 120, "magic_defense": 50, "attack_range": 330, "attack_speed": 30, "attack_wait": 120, "attack_interval": 311, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112128, "race_id": 12, "special_effect_id": 204, "missile_id": 6, "master_id": 30659, "global_id": 4278, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 29, "form_count": 1, "tags": ["アンデッド"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 4}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 18000, "attack": 390, "base_hp": 18000, "base_attack": 390, "damage_type": "physical", "armor_defense": 210, "magic_defense": 30, "attack_range": 100, "attack_speed": 70, "attack_wait": 30, "attack_interval": 93, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112048, "race_id": 12, "special_effect_id": 194, "missile_id": 45, "master_id": 30642, "global_id": 4261, "ranged": true, "spawn_sec": 22}, {"enemy_id": 5, "source": "local", "count": 7, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098448, "race_id": 18, "special_effect_id": 220, "master_id": 96, "global_id": 95, "spawn_sec": 34}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100624, "race_id": 18, "special_effect_id": 220, "master_id": 272, "global_id": 271, "spawn_sec": 94}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 161, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098304, "special_effect_id": 227, "master_id": 90, "global_id": 89, "spawn_sec": 99}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 80, "attack_interval": 111, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103280, "special_effect_id": 227, "master_id": 425, "global_id": 424, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "バステト", "text": "…………。", "face": "l636e95b4c547"}, {"name": "サバル", "text": "なんてこった……。\n信じてなかったわけじゃないけど、\n本当に呪われた宝石の力で復活するなんて。", "face": "u536"}, {"name": "アンナ", "text": "あれが復活したバステト……。\n神だと聞いていましたが、どことなく猫っぽいというか、\n獣人のような風貌ですね。", "face": "l43ffb21ff54d"}, {"name": "ザラーム", "text": "……おそらく奴は、真の意味での神ではない。", "face": "u175"}, {"name": "ザラーム", "text": "かつて、此の地で栄華を誇った獣人の国があった。\nその国を治めていた強大な力を持つ女王を、神として\n信奉したのがバステト信仰の始まりと言われている。", "face": "u175"}, {"name": "？？？", "text": "な……なんということを！\n神に疑いを向けるとは……許せません！", "face": "u551"}, {"name": "？？？", "text": "バステト様、この邪なる異教徒どもに\n神の裁きをお下しください！\n愚かなる罪人どもに、永劫の罰を！", "face": "u551"}, {"name": "バステト", "text": "……ファァ……五月蝿イ小娘ヨノ。\n偉ソウニ指図スルデナイ。", "face": "l636e95b4c547"}, {"name": "？？？", "text": "――バステト様っ！？\nた……大変失礼いたしました！", "face": "u551"}, {"name": "バステト", "text": "……ダガ、我ヲ永劫ノ眠リカラ\n覚マサセタ功績ハ評価シヨウ……。\n望ミ通リ、目ノ前ノ鼠ドモヲ根絶ヤシニシテヤル！", "face": "l636e95b4c547"}, {"name": "ケイティ", "text": "――来ます！\n王子、全力で迎え撃ちましょう！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "バステト", "text": "グフッ……ナ、ナンダ、コレハ……。\nチカラガ、抜ケテイク……ッ。", "face": "l636e95b4c547"}, {"name": "？？？", "text": "ば、バステト様！？\nそんな……まさか、\n復活の儀が失敗していたというのですか？", "face": "u551"}, {"name": "サバル", "text": "宝石の欠片の大半は私たちが頂いたからね。\n不完全な状態で復活してたんだろうさ。", "face": "u536"}, {"name": "？？？", "text": "くっ……おのれ！\nいつか必ず雪辱を果たさせていただきますよ！", "face": "u551"}, {"name": "？？？", "text": "バステト様を蘇らせる方法は他にもあるはず……！\n総員――退却ッ！", "face": "u551"}, {"name": "ユリアン", "text": "……チッ、バステトを抱えて逃げやがった。\nこのピラミッドは奴らの庭だ。\n追いかけっこじゃ敵う気がしねーな。", "face": "u7"}, {"name": "ケイティ", "text": "ですが、あの様子では当分の間は\nバステトを復活させることはできないでしょう。\n私たちの勝利です。", "face": "u114"}, {"name": "アンナ", "text": "サバルさん、\nこの度は本当にありがとうございました。"}, {"name": "サバル", "text": "にゃはは、いいっていいって。\nそれに、礼を言わなきゃいけないのは私の方さ。", "face": "u536"}, {"name": "サバル", "text": "最初は単に、君たちを利用して\nお目当ての大秘宝を華麗に奪ってやろうとしか\n考えていなかったけど……。", "face": "u536"}, {"name": "サバル", "text": "今回、王子たちと行動を共にしたことで、\n自分のための盗みが世のために繋がるっていう\n得難い経験をさせてもらったからね。", "face": "u536"}, {"name": "サバル", "text": "長いこと怪盗をやっていて、\nこれほど気分が良くなったのは初めてさ！", "face": "u536"}, {"name": "サバル", "text": "……ありがとう、皆。\nそれと、もしよかったら\nこれからも一緒に行動させてもらっていいかな？", "face": "u536"}, {"name": "王子", "text": "…………（こくり）。", "face": "u1"}, {"name": "サバル", "text": "にゃはは、さすが王子、いい選択だ♪", "face": "u536"}, {"name": "サバル", "text": "この天下の大怪盗、サバル様がついてれば\n魔物から平和を奪い返す日もそう遠くないさ！", "face": "u536"}]}], "active": true}