ssassin_resist": 100, "transform_resist": 100, "pattern_id": 2113408, "race_id": 9, "change_to": 1, "missile_id": 252, "missile": {"speed": 2.0}, "master_id": 30790, "global_id": 4409, "ranged": true}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 5000, "attack": 600, "base_hp": 5000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097808, "master_id": 43, "global_id": 42, "spawn_sec": 141}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 149}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 157}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "この辺りでしょうか？　ゴブリンたちが\n妙な機械で通行人を襲っているというのは。", "face": "lbd47455882a3"}, {"name": "ケイティ", "text": "――っ！\n王子、あれを！", "face": "u114"}, {"name": "ゴブリン", "text": "ギャギャッ！　テスト、セイコウ！\nシンガタ、スゴイ！　ユキ、ナゲホーダイ！", "face": "lf604c46b5aaa"}, {"name": "アンナ", "text": "あれは……カタパルトでしょうか？", "face": "lbd47455882a3"}, {"name": "ケイティ", "text": "そのようですね。ですが石ではなく\n雪を固めて投げられるように改良してあるようです。", "face": "u114"}, {"name": "カリオペ", "text": "雪合戦じゃ大活躍ってわけね。\nなかなか面白そうじゃない♪", "face": "u42"}, {"name": "セシリー", "text": "……なんて言っている場合でもなさそうだぞ？", "face": "u21"}, {"name": "ゴブリン", "text": "ギャギャッ、ミツケタ！\nニンゲン、タオス！", "face": "lf604c46b5aaa"}, {"name": "レアン", "text": "望むところだ。元より奴らがこれ以上\n通行人に危害を加えるのを許すわけにはいかない。", "face": "u50"}, {"name": "ケイティ", "text": "ええ。ですが敵は凍結した道の上を猛スピードで\n滑走してくることが予想されます。慎重に対処しましょう。", "face": "u114"}, {"name": "アンナ", "text": "カタパルトへの警戒も忘れないでくださいね。\nそれでは王子、ご指示をお願いします。", "face": "lbd47455882a3"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン", "text": "ギャギャッ！？　カタパルト、コワレタ！\nハカセニ、オコラレル……。", "face": "lf604c46b5aaa"}, {"name": "ゴブリン", "text": "タ……タイキャク！　タイキャク！", "face": "lf604c46b5aaa"}, {"name": "アンナ", "text": "……ふぅ。なんとか追い払えましたね。\n皆さん、お疲れ様でした。"}, {"name": "アンナ", "text": "しかし……どうやらあの雪玉仕様のカタパルトは\nゴブリン博士の発明品だったようですね。"}, {"name": "ケイティ", "text": "やはりというか、なんというか……。\n敵ながら彼の開発力は侮れませんね。", "face": "u114"}, {"name": "カリオペ", "text": "ねえ、それよりみんなで雪合戦しましょうよ。\nあいつらが雪玉投げてるの見てたら\nなんかウズウズしてきちゃった！", "face": "u42"}, {"name": "ダン", "text": "おお、いいじゃねえか雪合戦！\n王子、勝負しようぜ！", "face": "u204"}, {"name": "アンナ", "text": "皆さん、私たちは遊びに来たんじゃありませんよ？", "face": "lbd47455882a3"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "え、王子も雪合戦をしたいのですか？", "face": "lbd47455882a3"}, {"name": "王子", "text": "…………（こくり）。", "face": "u1"}, {"name": "アンナ", "text": "……もう、少しだけですよ。\n滑って転ばないように注意してくださいね？"}]}], "active": true}