 {"speed": 7.0, "deflectable": true}, "master_id": 208, "global_id": 207, "ranged": true}], "spawn_sec": 96}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 13000, "attack": 5800, "base_hp": 13000, "base_attack": 5800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 30, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108128, "race_id": 16, "special_effect_id": 54, "master_id": 994, "global_id": 993, "spawn_sec": 100}, {"enemy_id": 10, "source": "local", "count": 9, "form_count": 1, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 106}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 8000, "attack": 550, "base_hp": 8000, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "attack_speed": 120, "attack_wait": 30, "attack_interval": 211, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102960, "race_id": 16, "special_effect_id": 225, "change_to": 11, "missile_id": 26, "master_id": 31862, "global_id": 5481, "to_global_id": 437, "route_behaviour": {"transforms": [{"wait": 180}]}, "spawn_sec": 109}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 8000, "attack": 550, "base_hp": 8000, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "attack_range": 180, "attack_speed": 120, "attack_wait": 30, "attack_interval": 91, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102960, "race_id": 16, "special_effect_id": 225, "missile_id": 26, "master_id": 438, "global_id": 437, "ranged": true}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "tags": ["ステルス"], "hp": 13000, "attack": 5800, "base_hp": 13000, "base_attack": 5800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 30, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119456, "race_id": 16, "special_effect_id": 54, "change_to": 8, "change_condition": 1, "master_id": 31857, "global_id": 5476, "variants": [{"hp": 13000, "attack": 5800, "base_hp": 13000, "base_attack": 5800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 30, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108128, "race_id": 16, "special_effect_id": 54, "master_id": 994, "global_id": 993}], "spawn_sec": 131}, {"enemy_id": 14, "source": "local", "count": 2, "form_count": 1, "tags": ["ステルス"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 160, "attack_speed": 40, "attack_wait": 40, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119472, "race_id": 16, "special_effect_id": 54, "change_to": 14, "change_condition": 1, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 31858, "global_id": 5477, "ranged": true, "variants": [{"hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 160, "attack_speed": 40, "attack_wait": 40, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102192, "race_id": 16, "special_effect_id": 54, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 362, "global_id": 361, "ranged": true}], "spawn_sec": 144}], "dialogue": [{"trigger": "start", "lines": [{"name": "忍者", "text": "――して、これがグラシャラボラスの骨片ですか。", "face": "u147"}, {"name": "鬼刃衆", "text": "うむ。誰もこの欠片を口にしないよう、\n厳重に封印すべしと思ってな。", "face": "l33cd8f7acc56"}, {"name": "忍者", "text": "おぉ……。\n我らは鬼刃姫様より、次に魔神の欠片を摂取したら\n『めっ』だと念入りに戒められておりますからな。", "face": "u147"}, {"name": "鬼刃衆", "text": "然り。故に手ずからこの欠片を、\n念入りに、慎重に、厳重に封印せんと――", "face": "l33cd8f7acc56"}, {"name": "忍者", "text": "では、早く封印いたしましょう。\nさぁ、お早く。", "face": "u147"}, {"name": "鬼刃衆", "text": "…………うむ。\nだがしばし待て、この力があれば……。", "face": "l33cd8f7acc56"}, {"name": "忍者", "text": "な、なりませぬ！\nそれは鬼刃姫様とて怒髪、天を衝きますぞ……！？\nもはや『めっ』では済まぬやも……！！", "face": "u147"}, {"name": "鬼刃衆", "text": "だが……！　だが……！！\n我らも対魔王軍の戦力として、\n鬼刃姫様の戦線に馳せ参じたいのだ……！！", "face": "l33cd8f7acc56"}, {"name": "忍者", "text": "くっ……そう言われると、\n我が身の無力さに打ちひしがれてしまいまする……！！", "face": "u147"}, {"name": "鬼刃衆", "text": "我らとて、幾つもの魔神の欠片を摂取した身。\n流石に今更、グラシャラボラス如きの魔力に、\n我を失ったりはしないやもしれぬぞ！！", "face": "l33cd8f7acc56"}, {"name": "忍者", "text": "そう言われてみれば！\nそんな気もしてきてしまいましたぞ……！！", "face": "u147"}, {"name": "鬼刃衆", "text": "然らば。――ごくり。", "face": "l33cd8f7acc56"}, {"name": "忍者", "text": "――ごくりごくり。", "face": "u147"}, {"name": "鬼刃姫", "text": "――あれ？　あそこにいるの鬼刃衆じゃない？\nおーい、何やって――って！！\n待ちなさーい！！　何食べようとしてるのー！！", "face": "u435"}, {"name": "アンナ", "text": "確かしばらく前に、\n魔神グラシャラボラスの骨片を封印すると、\n聞いた覚えがありますが……。", "face": "le4da4fde4f27"}, {"name": "鬼刃衆", "text": "うおおおおおっ！！\nこの身にみなぎる魔神の――くっ、ぐおおっ！！\n鬼刃姫様ぁぁぁっ！　お逃げくだされぇぇっ！！", "face": "l33cd8f7acc56"}, {"name": "鬼刃姫", "text": "今度やったら『めっ』て言ったのに！！\n王子、お願い、鬼刃衆を止めるの手伝って！", "face": "u435"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "鬼刃姫", "text": "グラシャラボラスの力を得ているってことは、\n姿を隠して遠距離からは狙えなくなっちゃうかも。\n侵攻してくる鬼刃衆を、正面から受け止めよう！", "face": "u435"}]}, {"trigger": "end", "lines": [{"name": "鬼刃衆", "text": "――はっ、我らは何を！？", "face": "l33cd8f7acc56"}, {"name": "鬼刃姫", "text": "…………次に同じことしたら、\n『めっ』だって、あて言ったよね……？", "face": "u435"}, {"name": "鬼刃衆", "text": "……はっ。確かに。\n申し開きのしようもございませぬ……。", "face": "l33cd8f7acc56"}, {"name": "鬼刃姫", "text": "どうしてあてとの約束を破ったの……？", "face": "u435"}, {"name": "鬼刃衆", "text": "それは……くっ……。", "face": "l33cd8f7acc56"}, {"name": "忍者", "text": "――鬼刃姫様！\n我らは己の無力故に、対魔王軍の戦線にて、\n鬼刃姫様をお助け出来ぬことを悔いたのです……！！", "face": "u147"}, {"name": "鬼刃衆", "text": "――こらっ、それは言ってはならぬっ！！", "face": "l33cd8f7acc56"}, {"name": "鬼刃姫", "text": "……皆、あてのために……？\nそれじゃあ、し、叱るに叱れないよぉ……！", "face": "u435"}, {"name": "鬼刃衆", "text": "否っ！　我らが鬼刃姫様との約束を破ったのは事実！\n何卒、何卒厳しい処罰を……！！", "face": "l33cd8f7acc56"}, {"name": "鬼刃姫", "text": "……うぅ、王子はどう思う？", "face": "u435"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "鬼刃姫", "text": "うん……わかった。\nじゃあ皆、歯を食いしばれーッ！！", "face": "u435"}, {"name": "鬼刃姫", "text": "――めっ！！", "face": "u435"}, {"name": "鬼刃衆", "text": "あ痛ぁぁぁぁぁぁぁぁぁッ！？", "face": "l33cd8f7acc56"}, {"name": "アンナ", "text": "……どうやら、これで一件落着のようですね？\n王子も鬼刃姫さんも、お疲れ様でした！"}]}], "active": true}