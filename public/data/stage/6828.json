{"quest_id": 6828, "name": "魔神グラシャラボラスの残片", "description": "またしても魔神が残した骨片を取り込んで\nしまった鬼刃衆。グラシャラボラスの力で\n透明化した鬼刃衆たちの暴走を止めよ！\n神級（★１獲得の目安：平均Lv50）", "event": "白き姫と魔獣の剣", "event_category": "History", "mission_id": 920131, "map_no": 3422, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 730, "base_hp": 13000, "base_attack": 730, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 1, "attack_interval": 53, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103344, "race_id": 16, "special_effect_id": 54, "master_id": 341, "global_id": 340, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 16, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 5}, {"enemy_id": 3, "source": "local", "count": 19, "form_count": 1, "tags": ["ステルス"], "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119504, "race_id": 16, "change_to": 1, "change_condition": 1, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 31860, "global_id": 5479, "ranged": true, "variants": [{"hp": 900, "attack": 200