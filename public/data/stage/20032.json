_defense": 3500, "magic_defense": 90, "attack_speed": 1, "attack_wait": 60, "attack_interval": 190, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "pattern_id": 2172912, "race_id": 3, "change_to": 39, "master_id": 41174, "spawn_sec": 160}, {"enemy_id": 41, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 90, "attack_speed": 1, "attack_wait": 80, "attack_interval": 270, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2172928, "race_id": 3, "change_to": 41, "master_id": 41176, "spawn_sec": 160}, {"enemy_id": 43, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 90, "attack_speed": 1, "attack_wait": 40, "attack_interval": 206, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2172976, "race_id": 3, "change_to": 43, "master_id": 41178, "spawn_sec": 160}], "dialogue": [{"trigger": "start", "lines": [{"text": "――次元の狭間、魔力炉"}, {"name": "貴族セーレ", "text": "……貴様が炉に入れ、紛い物。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "貴様が入れ！　偽物め！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "私こそ本物だと何度言えば！", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "ハニホー！！", "face": "l889a78825052"}, {"name": "志津香", "text": "ほんとに仲が悪いのね、あの二人。\n同じ魂の欠片同士のはずなのに。", "face": "u1759a1"}, {"name": "ルキファ", "text": "同じ欠片だからこそ、だろう。\n互いを取り込まねば完全になれない。", "face": "u1621a1"}, {"name": "貴族セーレ", "text": "……おっと、来たか、ランス。王子。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "ちょうどいい。貴様らを殺した方が本物だ。\nそれで決着とする！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "望むところだ！", "face": "l70921f716695"}, {"name": "ランス", "text": "どっちでもいい。両方死ね。", "face": "u2897a1"}, {"name": "リア", "text": "ダーリン、雑ー。", "face": "u2901a1"}, {"name": "シルキィ", "text": "貴族の方は転移術が厄介。\n丸い方は魔法が効かない。……面倒な組み合わせね。", "face": "u2902a1"}, {"name": "グリム", "text": "転移でぶっ飛ばされても、戻れば戦えますー。\n魔法が効かない方は、物理でどうぞー。", "face": "u942"}, {"name": "アンナ", "text": "王子、二体同時に来ます！"}]}, {"trigger": "battle", "at_sec": 158, "lines": [{"name": "貴族セーレ", "text": "ぐ……ぬ……。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "ま、まだだ……私はまだ……。", "face": "l889a78825052"}, {"name": "ルキファ", "text": "……待て。炉の魔力が、暴走している。", "face": "u1621a1"}, {"name": "志津香", "text": "ふたりの魂が、炉に引きずり込まれてる……！\nまずいわ、これ、融合する！", "face": "u1759a1"}]}, {"trigger": "end", "lines": [{"name": "貴族セーレ", "text": "な、なんだ、身体が……紛い物と、混ざる……！？", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "やめろ、私は私だ……ハニホ……！", "face": "l889a78825052"}]}, {"trigger": "end", "lines": [{"name": "魔神セーレ", "text": "…………。", "face": "lf6eef03410c8"}, {"name": "魔神セーレ", "text": "――ああ。ようやく、ひとつになった。", "face": "lf6eef03410c8"}, {"name": "魔神セーレ", "text": "全てが、この私に。", "face": "lf6eef03410c8"}, {"name": "シィル", "text": "ひんっ……！\nラ、ランス様、あれ……！", "face": "u2900a1"}, {"name": "グリム", "text": "完全体ですねー。わー、大きいなー。", "face": "u942"}, {"name": "魔神セーレ", "text": "異世界の戦士ランス、そして王国の王子。\n三度目の正直だ。今度こそ、貴様らを殺す。", "face": "lf6eef03410c8"}, {"name": "ランス", "text": "ふん。何度でも言ってやる。\n死ぬのはお前だ、まじんなんとか。", "face": "u2897a1"}, {"name": "魔神セーレ", "text": "魔神セーレだ！！", "face": "lf6eef03410c8"}]}], "active": true}