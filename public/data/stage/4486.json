"from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 63}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104608, "missile_id": 6, "master_id": 556, "global_id": 555, "ranged": true, "spawn_sec": 133}], "dialogue": [{"trigger": "start", "lines": [{"name": "リッチロード", "text": "このあたりから、\n配下の声が聞こえたのだが……。\n駆けつけるのが遅かったか。", "face": "l6be2b1e870a8"}, {"name": "リッチ", "text": "うう……あんな所で俺が転ばなければ……。\nすまない、兄さん。", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "残していくこともできんだろうに……。\nチャンスはまた来る。汚名はそこでそそげ。", "face": "l6be2b1e870a8"}, {"name": "リッチ", "text": "チームっていいもんだな……兄さん！", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "おお、弟よ……。\n野盗には真似のできぬ絆の力を今こそ――ッ？", "face": "l6be2b1e870a8"}, {"name": "モーティマ", "text": "は――はッ、ハッブショッ！　……うう。\nしっかし、冷えるなここは。\n死体の化け物が近くにいるからかぁ？", "face": "u14"}, {"name": "リッチ", "text": "や、やつら、山賊だッ！　物凄い筋肉だよ！？\n脳筋野郎は苦手なのに……どうする兄さん？", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "臆するでない弟よ！　頭と骨を使うのだ！\n自惚れの力自慢達など我らの敵ではないわ！", "face": "l6be2b1e870a8"}, {"name": "モーティマ", "text": "出やがったな、リッチどもめ！\n墓場までブッ飛ばしてやるぜ！　オラァッ！", "face": "u14"}, {"name": "コンラッド", "text": "いくぞ野郎共！　山賊の戦いを見せてやれ！", "face": "u61"}]}, {"trigger": "end", "lines": [{"name": "ロロネ", "text": "たぁッ――！　よし、これで全部仕留めた。\n手ごたえのないヤツらだったな。", "face": "u214"}, {"name": "コンラッド", "text": "弱いも何も、もともと死んでるからな。", "face": "u61"}, {"name": "リッチ", "text": "うう……こんな筋肉馬鹿たちに負けるなんて。\n悔しい、くやしいよ、兄さん……。", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "泣くな弟よ。我が主ビフロンス様が、\nすぐに新しい身体をくださるはずだ。\nその時こそ筋肉への復讐を果たすのだ！", "face": "l6be2b1e870a8"}, {"name": "リッチ", "text": "うん！　また兄さんの弟に生まれるよ！\n兄さんの……おとうと……に……。", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "お、弟よぉぉおおおおッ！\n待っていろ、山賊め……骨よりも強い筋肉など\nありは……しない……の……だ――。", "face": "l6be2b1e870a8"}, {"name": "コンラッド", "text": "ふぅ。しっかし疲れたぜぇ\n老体にはちょいと厳しい相手だったな。\nあー腹減ったなぁ。", "face": "u61"}, {"name": "モーティマ", "text": "今日はおごるぜ山賊王！\n朝日を拝むまでしこたま飲もう！\nガッハッハッハッハ！", "face": "u14"}]}], "map": {"image": "Map920060_3659", "w": 960, "h": 640, "spots": [{"k": "b", "x": 824, "y": 116}, {"k": "b", "x": 779, "y": 525}, {"k": "m", "x": 703, "y": 412, "id": 200}, {"k": "m", "x": 738, "y": 252, "id": 201}, {"k": "m", "x": 571, "y": 317, "id": 202}, {"k": "m", "x": 603, "y": 234, "id": 203}, {"k": "m", "x": 517, "y": 204, "id": 204}, {"k": "m", "x": 428, "y": 188, "id": 205}, {"k": "m", "x": 263, "y": 225, "id": 206}, {"k": "m", "x": 616, "y": 406, "id": 207}, {"k": "m", "x": 451, "y": 428, "id": 208}, {"k": "m", "x": 360, "y": 417, "id": 209}, {"k": "m", "x": 273, "y": 383, "id": 210}, {"k": "m", "x": 236, "y": 310, "id": 211}, {"k": "m", "x": 151, "y": 301, "id": 212}, {"k": "m", "x": 537, "y": 400, "id": 213}, {"k": "m", "x": 872, "y": 248, "id": 214}, {"k": "m", "x": 814, "y": 422, "id": 215}, {"k": "m", "x": 881, "y": 335, "id": 216}, {"k": "m", "x": 342, "y": 187, "id": 217}, {"k": "r", "x": 645, "y": 330, "id": 300}, {"k": "r", "x": 812, "y": 332, "id": 301}, {"k": "r", "x": 453, "y": 245, "id": 302}, {"k": "r", "x": 351, "y": 344, "id": 303}, {"k": "r", "x": 516, "y": 153, "id": 304}, {"k": "r", "x": 433, "y": 136, "id": 305}, {"k": "r", "x": 338, "y": 133, "id": 306}, {"k": "r", "x": 250, "y": 154, "id": 307}, {"k": "r", "x": 192, "y": 209, "id": 308}, {"k": "r"