{"quest_id": 4486, "name": "不死の追跡者", "description": "助手リッチを追ってきた\n魔神ビフロンスの配下たちを\n退けろ！\n神級（★１獲得の目安：平均Lv50）", "event": "死霊術師と反魂の至宝", "event_category": "History", "mission_id": 920060, "map_no": 3659, "level": 100, "multiplier": 1.0, "charisma": 115, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 32, "form_count": 1, "tags": ["アンデッド"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "attack_range": 100, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 350.0, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "missile_id": 6, "master_id": 551, "global_id": 550, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 2, "tags": ["アンデッド"], "hp": 14000, "attack": 600, "base_hp": 14000, "base_attack": 600, "damage_type": "magical", "armor_defense": 300, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "special_effect_id": 222, "change_to": 2, "change_condition": 2, "missile_id": 6, "master_id": 552, "global_id": 551, "ranged": true, "to_condition": 2, "to_global_id": 552, "spawn_sec": 5}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "magical", "armor_defense": 300, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 350.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "special_effect_id": 64, "missile_id": 6, "master_id": 553, "global_id": 552, "ranged": true, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 63}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104608, "missile_id": 6, "master_id": 556, "global_id": 555, "ranged": true, "spawn_sec": 133}], "dialogue": [{"trigger": "start", "lines": [{"name": "リッチロード", "text": "このあたりから、\n配下の声が聞こえたのだが……。\n駆けつけるのが遅かったか。", "face": "l6be2b1e870a8"}, {"name": "リッチ", "text": "うう……あんな所で俺が転ばなければ……。\nすまない、兄さん。", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "残していくこともできんだろうに……。\nチャンスはまた来る。汚名はそこでそそげ。", "face": "l6be2b1e870a8"}, {"name": "リッチ", "text": "チームっていいもんだな……兄さん！", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "おお、弟よ……。\n野盗には真似のできぬ絆の力を今こそ――ッ？", "face": "l6be2b1e870a8"}, {"name": "モーティマ", "text": "は――はッ、ハッブショッ！　……うう。\nしっかし、冷えるなここは。\n死体の化け物が近くにいるからかぁ？", "face": "u14"}, {"name": "リッチ", "text": "や、やつら、山賊だッ！　物凄い筋肉だよ！？\n脳筋野郎は苦手なのに……どうする兄さん？", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "臆するでない弟よ！　頭と骨を使うのだ！\n自惚れの力自慢達など我らの敵ではないわ！", "face": "l6be2b1e870a8"}, {"name": "モーティマ", "text": "出やがったな、リッチどもめ！\n墓場までブッ飛ばしてやるぜ！　オラァッ！", "face": "u14"}, {"name": "コンラッド", "text": "いくぞ野郎共！　山賊の戦いを見せてやれ！", "face": "u61"}]}, {"trigger": "end", "lines": [{"name": "ロロネ", "text": "たぁッ――！　よし、これで全部仕留めた。\n手ごたえのないヤツらだったな。", "face": "u214"}, {"name": "コンラッド", "text": "弱いも何も、もともと死んでるからな。", "face": "u61"}, {"name": "リッチ", "text": "うう……こんな筋肉馬鹿たちに負けるなんて。\n悔しい、くやしいよ、兄さん……。", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "泣くな弟よ。我が主ビフロンス様が、\nすぐに新しい身体をくださるはずだ。\nその時こそ筋肉への復讐を果たすのだ！", "face": "l6be2b1e870a8"}, {"name": "リッチ", "text": "うん！　また兄さんの弟に生まれるよ！\n兄さんの……おとうと……に……。", "face": "lb5b47d021da2"}, {"name": "リッチロード", "text": "お、弟よぉぉおおおおッ！\n待っていろ、山賊め……骨よりも強い筋肉など\nありは……しない……の……だ――。", "face": "l6be2b1e870a8"}, {"name": "コンラッド", "text": "ふぅ。しっかし疲れたぜぇ\n老体にはちょいと厳しい相手だったな。\nあー腹減ったなぁ。", "face": "u61"}, {"name": "モーティマ", "text": "今日はおごるぜ山賊王！\n朝日を拝むまでしこたま飲もう！\nガッハッハッハッハ！", "face": "u14"}]}], "active": true}