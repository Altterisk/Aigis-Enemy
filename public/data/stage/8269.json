{"quest_id": 8269, "name": "花嫁の演武", "description": "王子たちはジューンブライドの祝祭で、\n花嫁姿のヤハールと場を盛り上げるべく\n雇われた吟遊詩人を相手に演武を行う。\n上級（★１獲得の目安：平均Lv10）", "event": "バトルハネムーン", "event_category": "History", "mission_id": 920216, "map_no": 7136, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["ジューンブライド"], "hp": 12000, "attack": 600, "base_hp": 12000, "base_attack": 600, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_range": 230, "attack_speed": 80, "attack_wait": 60, "attack_interval": 159, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2153184, "race_id": 3, "special_effect_id": 1728, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 37480, "global_id": 11097, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "tags": ["ジューンブライド"], "hp": 15800, "attack": 300, "base_hp": 15800, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_interval": 34, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2153152, "race_id": 9, "special_effect_id": 1720, "change_to": 2, "change_condition": 1, "master_id": 37476, "global_id": 11093, "variants": [{"tags": ["ジューンブライド"], "hp": 15800, "attack": 300, "base_hp": 15800, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_interval": 34, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2153168, "race_id": 9, "special_effect_id": 1720, "master_id": 37477, "global_id": 11094}], "sp_change_to": [37478], "commands": {"raw": "DoEnemy_RouteMoveChange(\"ID=18\", \"永久停止解除=1\");"}, "route_behaviour": {"transforms": [{"to": 37478}]}, "spaw