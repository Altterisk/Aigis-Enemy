ange": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 122}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 149}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 150}, {"enemy_id": 11, "source": "local", "count": 14, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 11, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 160}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 10, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 13, "source": "local", "count": 7, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 178}, {"enemy_id": 14, "source": "local", "count": 13, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103360, "race_id": 9, "master_id": 441, "global_id": 440, "spawn_sec": 216}], "popups": ["ヤハールの\n攻撃を受けた味方ユニットは\n2秒間、攻撃力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。", "敵に吟遊詩人の\nゴブリンがいる間は、\n敵のジューンブライド属性ユニットの\n攻撃がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マレス？", "text": "──ウルカノくん！　この荷物はここで良かったかな？", "face": "l9874989e96be"}, {"name": "ウルカノ", "text": "おーう、そこに置いといてくれ。\nあ、武勲結晶の用意も忘れんなよ？", "face": "u1669a1"}, {"name": "マレス？", "text": "はははっ！　もちろんだとも！", "face": "l9874989e96be"}, {"name": "マレス？", "text": "……ウルカノくん、\n祝祭の成功は僕たちの手に懸かっている。\n共に最高のジューンブライドを彩ろうじゃないか！", "face": "l9874989e96be"}, {"name": "ウルカノ", "text": "うんうん、そうだなー。んじゃ、持ち場に戻れー。", "face": "u1669a1"}]}, {"trigger": "start", "lines": [{"name": "シェミア", "text": "……何ですか、アレ？", "face": "u1505a1"}, {"name": "ウルカノ", "text": "綺麗なマレス。", "face": "u1669a1"}, {"name": "アラン", "text": "気色悪いマレスの間違いでは？", "face": "u1511a1"}, {"name": "ウルカノ", "text": "どうにも、打ち所が絶妙だったみたいでなぁ。\nでも、グレる前は実際あんな感じだったらしいぞ。", "face": "u1669a1"}, {"name": "シェミア", "text": "にわかには信じられませんが……大丈夫なのですか？", "face": "u1505a1"}, {"name": "ウルカノ", "text": "知らねぇけど、たぶん大丈夫だろ。\nせっかく祭りの手伝いしてくれるってんだ、\n記憶が戻る前にこれまでの迷惑料ふんだくっとけ。", "face": "u1669a1"}, {"name": "アスバール", "text": "そうですね、おかげさまでうちの子の晴れ舞台を、\n予定よりずっと豪華にしてあげることができました。", "face": "u1668a1"}, {"name": "ヤハール", "text": "──よーし、まずはあたしの出番ね？\nデーモンなのに神殿前ってのが少し不満だけど、\nお嬢の前でみっともない姿は見せられないわ！", "face": "u2171a1"}, {"name": "ロタン", "text": "……何で花嫁が演武を？", "face": "u1616a1"}, {"name": "レジナレア", "text": "ウェディングドレスの美しさを表現するのに、\n最も適した表現方法であるからと聞いています。", "face": "u2168a1"}, {"name": "エンジュ", "text": "ほんに蛮族よのー。", "face": "u2170a1"}, {"name": "アンナ", "text": "そういえば今回は祝祭を盛り上げてくださる、\n強力な助っ人の方をお呼びしているのですよね？"}, {"name": "ウルカノ", "text": "おう、マレスの金でな。さっき迎えを出したんだが──", "face": "u1669a1"}, {"name": "チャムチャム", "text": "つれてきたよー！", "face": "u2146a1"}, {"name": "ウルカノ", "text": "おっと、丁度到着したみてーだな。", "face": "u1669a1"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "アンナ", "text": "あれは……開拓地で出会った、\nゴブリンの吟遊詩人さん？", "face": "lae68f4f381be"}, {"name": "ウルカノ", "text": "祭りと言ったら歌と音楽だろ？\nヤハール！　準備できてるかー！？", "face": "u1669a1"}, {"name": "ヤハール", "text": "準備万端よ！　いつでも行けるわ！", "face": "u2171a1"}, {"name": "ヤハール", "text": "さあ、最高の花嫁さんを見せてあげる！", "face": "u2171a1"}]}, {"trigger": "end", "lines": [{"name": "少女", "text": "わぁーっ！　すごいすごーい！\nあの花嫁さん、すっごくきれー！", "face": "le406413a9c0a"}, {"name": "ヤハール", "text": "ふふっ、ありがと。この後もお祭り楽しんでね？", "face": "u2171a1"}, {"name": "少女", "text": "きゃーー♪", "face": "le406413a9c0a"}, {"name": "アスバール", "text": "ヤハール、とっても素敵でしたよ。", "face": "u1668a1"}, {"name": "ヤハール", "text": "えへへ、お嬢もありがとう！", "face": "u2171a1"}, {"name": "ロタン", "text": "……悔しいけど、可愛かった。", "face": "u1616a1"}, {"name": "ヤハール", "text": "ふふん、お嬢の一番の家臣として、\nあたしが一歩リードってとこかしら？", "face": "u2171a1"}, {"name": "ロタン", "text": "なんか……ムカつく。", "face": "u1616a1"}, {"name": "マレス？", "text": "皆さん、素晴らしい演武をありがとうございました。", "face": "l9874989e96be"}, {"name": "マレス？", "text": "しかし、祝祭はこれで終わりではありません。\n今回のジューンブライドは世界を回る巡業の旅。", "face": "l9874989e96be"}, {"name": "マレス？", "text": "王子と花嫁は吟遊詩人の運転する\nブライダルカーへとご乗車ください。", "face": "l9874989e96be"}, {"name": "ヤハール", "text": "ブライダルカー？", "face": "u2171a1"}, {"name": "ファルネ", "text": "結婚式用に特別に飾り付けた車よ。\n昔は馬車なんか使っていたみたいね。", "face": "u158"}, {"name": "ファルネ", "text": "後部に結び付けた空き缶のガラガラと鳴る音が、\n悪いものを遠ざけるって言われていたらしいわよ。", "face": "u158"}, {"name": "ヤハール", "text": "それ大丈夫？　あたしが乗ったら消し飛ばない？", "face": "u2171a1"}, {"name": "アスバール", "text": "もう、こんなに綺麗なヤハールが\n悪いものであるはずがないでしょう？", "face": "u1668a1"}, {"name": "ヤハール", "text": "えへへー♪", "face": "u2171a1"}, {"name": "チャムチャム", "text": "それじゃあアタシが先導するよ！\nみんな、ちゃんと付いて来てねー！", "face": "u2146a1"}]}], "active": true}