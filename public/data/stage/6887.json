"base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 50, "attack_speed": 40, "attack_wait": 30, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118848, "race_id": 8, "special_effect_id": 378, "change_to": 8, "change_condition": 1, "master_id": 31772, "global_id": 5391, "variants": [{"tags": ["アーマー", "アイドルリノのファン"], "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 50, "attack_speed": 40, "attack_wait": 30, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118864, "race_id": 8, "master_id": 31773, "global_id": 5392}], "spawn_sec": 127}, {"enemy_id": 10, "source": "local", "count": 12, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 10, "change_condition": 3, "master_id": 800, "global_id": 799, "to_condition": 3, "to_global_id": 800, "spawn_sec": 129}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 500, "base_hp": 1200, "base_attack": 500, "damage_type": "physical", "armor_defense": 130, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "from_condition": 3}, {"enemy_id": 12, "source": "local", "count": 5, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106496, "race_id": 8, "change_to": 12, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 387, "global_id": 386, "ranged": true, "to_condition": 3, "to_global_id": 387, "spawn_sec": 148}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106512, "race_id": 8, "special_effect_id": 234, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 388, "global_id": 387, "ranged": true, "from_condition": 3}, {"enemy_id": 14, "source": "local", "count": 2, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 187}], "popups": ["\n\n\n　　 ――とある戦場にて", "アトナテスのHPを減らすと、\n強烈な攻撃を行います。\nアトナテスの攻撃は\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。\n　　　　　　　　　　　(1/2)", "アトナテスは拠点には向かわず、\nしばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 \n　　　　　　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "一般兵", "text": "――伝令！　伝令です！\n西方の戦線が突破されました！\n敵の規模は……その……。", "face": "u6"}, {"name": "フローガ", "text": "ここまで響いてくる異様な魔力。\nもしや突破したのは、竜を駆る騎士では？", "face": "u878"}, {"name": "ケイティ", "text": "……フローガさん、何か心当たりがあるのですか？", "face": "u114"}, {"name": "フローガ", "text": "いえ、この魔力の乱れ、\n先日観測したものと同じなんです。", "face": "u878"}, {"name": "ソラス", "text": "へぇ、フローガちゃんは良い勘をしていますね。\n星もこう言っています。\n心を操られし友が、この地へ至らんとしていると。", "face": "u903"}, {"name": "ソラス", "text": "その者は、紫鱗の竜を友とし、\n千年戦争の後、魔界の深淵にて、\nただ一人で戦い続けた孤高の騎士……。", "face": "u903"}, {"name": "ソラス", "text": "そして英雄王の真なる友――", "face": "u903"}, {"name": "？？？", "text": "ああ……あぁぁぁぁぁっ！！\nソラ……スゥ……っ！　ユージェン……っ！！\nあぁぁあっ、英雄ぅっ、王……っ！！", "face": "u908"}, {"name": "ソーマ", "text": "もうこんなところまで……って、\nあれは、先日戦った紫竜の騎士さんでは……！？", "face": "u23"}, {"name": "ソラス", "text": "どうやら心を縛る術と、彼の強き意志が\nぶつかり合って暴走しているようですね。", "face": "u903"}, {"name": "ユージェン", "text": "……彼こそが、英傑と謳われし者のひとり。\n魔竜騎士たるアトナテスおじさまだ。", "face": "u905"}, {"name": "ソラス", "text": "ただ、話が通じるような状況ではなさそうですね……。\n幸いにも精神支配は逃れつつあるようですが、\n暴走状態の彼に触れるのは得策ではありません。", "face": "u903"}, {"name": "ユージェン", "text": "アトナテスおじさまに下手に攻撃すると、\nおそらく戦士の本能で、\n苛烈な反撃が飛んでくるはずだ。", "face": "u905"}, {"name": "ユージェン", "text": "今は周囲の魔物を排除し、\n安全を確保するのが先決だろう。\n出来るな、王子？", "face": "u905"}]}, {"trigger": "end", "lines": [{"name": "アトナテス", "text": "くっ……ソラ……ス……っ！\n俺を……止め、て、くれ……っ！！", "face": "u908"}, {"name": "フローガ", "text": "ソラスさん、アトナテスさんの意識が！", "face": "u878"}, {"name": "ソラス", "text": "よぉし、今助けてあげますからね。\nユージェンちゃん、王子君、\n動けないように押さえつけてください！", "face": "u903"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ユージェン", "text": "は、はいっ！　アトナテスおじさま！\n大人しくしてくださいっ！　このぉっ！", "face": "u905"}, {"name": "ソラス", "text": "この精神支配……なるほど……かなり深く刻まれて……。\nでもこれで……こうして……よしっ。\n――アトナテス、私がわかりますか？", "face": "u903"}, {"name": "アトナテス", "text": "…………ああ、ソラス。\nそれから、ユージェンに……言ってやってくれ……。\n俺を……おじさまと呼ぶなと……。", "face": "u908"}, {"name": "ユージェン", "text": "おじさま……！！\n良かった……一時はどうなることかと……！", "face": "u905"}, {"name": "アトナテス", "text": "……済まなかったな。\nところでお前、英雄王の末裔だな？", "face": "u908"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アトナテス", "text": "そうか……ということは、物質界では、\n随分と時間が経過してしまったようだな……。", "face": "u908"}, {"name": "アトナテス", "text": "だが、あいつの子孫がいるならちょうどいい。\n色々と……話を聞かせてくれないか……？", "face": "u908"}, {"name": "アトナテス", "text": "俺も……お前の先祖の話を、\n英雄王の話を聞かせてやるよ……。", "face": "u908"}, {"name": "ソラス", "text": "しかし、まずは休息が必要そうですね。\nアトナテス、どうしてこんなことになったのか、\n後で言い訳をたっぷりさせてあげますからね？", "face": "u903"}, {"name": "アトナテス", "text": "ああ……でもまずは酒だな……。\n久しぶりの、物質界だ……ははっ。", "face": "u908"}, {"name": "アンナ", "text": "どうにか、精神支配は解除できたようですね。\nアトナテスさんを休ませるためにも、\n一度王国へ帰還しましょうか。"}]}, {"trigger": "end", "lines": [{"name": "ガード", "text": "…………。", "face": "l2d49bcb6d799"}, {"name": "ガード", "text": "精神支配が破られたと思って駆けつけてみれば、\nなるほど、かつて魔王様を封じた英傑達が、\nあの王子のもとへ集っていたのか……。", "face": "l2d49bcb6d799"}, {"name": "ガード", "text": "――激突の時は近い、か。", "face": "l2d49bcb6d799"}]}], "story_talk": true, "active": true}