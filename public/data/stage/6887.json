{"quest_id": 6887, "name": "紫竜騎士の暴威", "description": "周囲の魔物を退けた王子たちの前に、\n心を縛る術に抗うアトナテスが向かい\n来る。戦いに勝利し、術から解放せよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ25(2019)", "event_category": "Reproduce", "mission_id": 300251, "map_no": 5830, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 60000, "attack": 1200, "base_hp": 60000, "base_attack": 1200, "damage_type": "true", "armor_defense": 1800, "magic_defense": 30, "attack_range": 190, "attack_speed": 1, "attack_interval": 63, "move_speed": 1300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120224, "special_effect_id": 431, "change_to": 1, "change_condition": 5, "missile_id": 204, "missile": {"speed": 8.0, "splash": 120}, "master_id": 32029, "global_id": 5648, "ranged": true, "to_condition": 5, "to_global_id": 5647, "spawn_sec": 24}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 60000, "attack": 1200, "base_hp": 60000, "base_attack": 1200, "damage_type": "true", "armor_defense": 1800, "magic_defense": 30, "attack_range": 190, "attack_speed": 1, "attack_interval": 63, "move_speed": 1300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120224, "special_effect_id": 48, "missile_id": 204, "missile": {"speed": 8.0, "splash": 120}, "master_id": 32028, "global_id": 5647, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 79}, {"enemy_id": 4, "source": "local", "count": 18, "form_count": 1, "hp": 640, "attack":