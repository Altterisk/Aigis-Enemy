{"quest_id": 4437, "name": "暗影の毒沼", "description": "闇ギルドで使用されている武器の原料が\n採れる地へと向かい、採取を阻止せよ！\n＜毒：HPに継続ダメージ＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["毒：HPに継続ダメージ"], "event": "闇ギルドの召使い", "event_category": "History", "mission_id": 920056, "map_no": 3639, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 5, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 6}, {"enemy_id": 3, "source": "local", "count": 12, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 13}, {"enemy_id": 4, "source": "local", "count": 8, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 26}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 41}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 5500, "attack": 10, "base_hp": 5500, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_speed": 30, "attack_interval": 61, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098352, "special_effect_id": 220, "master_id": 23, "global_id": 22, "spawn_sec": 51}, {"enemy_id": 7, "source": "local", "count": 1, "level": 80, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103536, "race_id": 16, "special_effect_id": 61, "change_to": 7, "master_id": 454, "global_id": 453, "to_global_id": 454, "route_behaviour": {"transforms": [{"wait": 2000}]}, "spawn_sec": 76}, {"enemy_id": 7, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103552, "race_id": 16, "special_effect_id": 61, "change_to": 6, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 455, "global_id": 454, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 92}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 98}], "dialogue": [{"trigger": "start", "lines": [{"name": "レダ", "text": "王子、こっちこっちー！", "face": "u254"}, {"name": "アンナ", "text": "レダさん。ここでギルド長をみたのですか？", "face": "lb82169bfb75c"}, {"name": "レダ", "text": "そうなのよー。アジトまで行く手間省けると思って、\n王子を呼んだんだよね！　あたしって気が利くぅ！", "face": "u254"}, {"name": "アンナ", "text": "ここは……採掘場ですか？", "face": "lb82169bfb75c"}, {"name": "レダ", "text": "ここは闇ギルドの幹部たちが使っている\n特殊な武器の原料が採れる場所なのよ。\nだから、ギルド長もよくここに出入りしてるみたい。", "face": "u254"}, {"name": "アンナ", "text": "原料？", "face": "lb82169bfb75c"}, {"name": "レダ", "text": "そ。闇ギルドの幹部たちの武器って毒性の強い\n鉱物を元に作られてるんだよね。", "face": "u254"}, {"name": "レダ", "text": "すごく貴重な鉱物だから、\n闇ギルドの資金源にもなってるってわけ！", "face": "u254"}, {"name": "ユリアン", "text": "へぇ。奴らから受けた傷がやけに痛いのは\nそのせいか。王子、その鉱物を使えば、\n軍備を強化できるかもしれないな。", "face": "u7"}, {"name": "アイリーン", "text": "それはやめた方がよろしいかと思います。\n毒性が強いので、普通の人間が長時間持つと、\n身の危険を伴います。", "face": "u315"}, {"name": "アイリーン", "text": "取り扱いの仕方も闇ギルドの暗殺部隊にしか\n知らされていないんです。そんな危険を\n冒すほどの価値はあの武器にはないでしょう。", "face": "u315"}, {"name": "アイリーン", "text": "しかし、世の中には自分が滅んだとしても\n自分の手で倒したい相手がいる人もいるようで、\nこの危険な武器が高値で取引されているのです。", "face": "u315"}, {"name": "モーティマ", "text": "なるほど、高値で……ねぇ。", "face": "u14"}, {"name": "闇ギルド幹部", "text": "……侵入者を確認。\n魔物たちよ、いち早く奴らを排除しろ。\nここを部外者に知られるわけにはいかない。", "face": "lf1b1179a909c"}, {"name": "魔物", "text": "ギャギャー！", "face": "l018614bdc4df"}, {"name": "アンナ", "text": "王子、闇ギルドの魔物たちです！\n迎撃の準備を！", "face": "lb82169bfb75c"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "どうやらここにはもうギルド長はいないようですね。", "face": "lb82169bfb75c"}, {"name": "レダ", "text": "うーん。残念……。\nやっぱりアジトに乗り込むしかないかー。", "face": "u254"}, {"name": "アンナ", "text": "レダさん、気を落とさないでください。身の危険を\nかえりみずに、闇ギルドの情報を伝えて頂いたので、\n彼等の資金源を断つ事が出来たわけですし。"}, {"name": "レダ", "text": "いやー！　そんなぁー！\nシーフのあたしだから出来る事をしたまでだよ！", "face": "u254"}, {"name": "ユリアン", "text": "なるほどな。確かにシーフだから出来る事だな。\nで、その袋に入れてるのはなんだ？", "face": "u7"}, {"name": "レダ", "text": "え、えっと……。\nこれは……その……。", "face": "u254"}, {"name": "モーティマ", "text": "信じられねぇ！　\n鉱物をこっそり売って金儲けしようとしたんだろ！\nまったく……！　油断もスキもねぇな。", "face": "u14"}, {"name": "ユリアン", "text": "ほんとにな。\nで、モーティマのおっさんが、\nズボンに隠してるのはなんだ？", "face": "u7"}, {"name": "モーティマ", "text": "……。\nえーっと……。", "face": "u14"}, {"name": "アンナ", "text": "……はぁ。\n王子、先へ進みましょうか。", "face": "l7da694b51892"}]}], "active": true}