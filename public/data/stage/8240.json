"dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 112}, {"enemy_id": 13, "source": "local", "count": 5, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 122}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098928, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 119, "global_id": 118, "ranged": true, "spawn_sec": 123}, {"enemy_id": 15, "source": "local", "count": 5, "form_count": 1, "hp": 8000, "attack": 150, "base_hp": 8000, "base_attack": 150, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 40, "attack_wait": 50, "attack_interval": 216, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2152112, "race_id": 9, "special_effect_id": 1699, "master_id": 37370, "global_id": 10987, "spawn_sec": 130}], "popups": ["亜神プロメは\n徐々に自身のHPを回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アラン", "text": "――それは、人類の歴史が始まった頃のこと。", "face": "u1511a1"}, {"name": "アラン", "text": "夜の闇、冬の冷たさに、\n人々はただ翻弄され、その数を減らし続けた時代。", "face": "u1511a1"}, {"name": "アラン", "text": "その様を哀れに思った少数の神々が、\n天界に輝く火と叡智を奪い、人類に分け与えました。", "face": "u1511a1"}, {"name": "アルレット", "text": "……それ、天界の神サマたち\nめちゃくちゃ怒ったんじゃない？", "face": "u1453a1"}, {"name": "マイン", "text": "んん、明るく暖かくなるのはいいことだろ？\n怒る理由どこかにあったか？", "face": "u672"}, {"name": "セリド", "text": "火は文明の始まり。\n人が火を手にするというのは、いつの日か、\n人類が神と同じ場所にまで至ることを意味します。", "face": "u2136a1"}, {"name": "アルレット", "text": "事実として、高度な文明を得たことで、\n自滅してしまった超古代文明だってあったわけだしね。", "face": "u1453a1"}, {"name": "セリド", "text": "もちろん、天界の神々すべてが\n火の簒奪を責めたわけではありませんでした。", "face": "u2136a1"}, {"name": "セリド", "text": "たとえばタカマガハラやアヴァロンの者たちは、\n人が正しき成長の道を――争いながらも進歩する道を、\n歩み始めたことを歓迎していましたし。", "face": "u2136a1"}, {"name": "イヨ", "text": "転ぼうが滅びようが、\n何度でも立ち上がる者が大好きだからね、\nタカマガハラの神さまたちは！", "face": "u1948a1"}, {"name": "アラン", "text": "ただ、人が力を手にすることに\n烈火のごとき怒りを示した神々は、確かにいました。", "face": "u1511a1"}, {"name": "アラン", "text": "結果として、簒奪者たちは神の座を追われ、\n天界の記録からも抹消され――", "face": "u1511a1"}, {"name": "？？？", "text": "――その果てに、\nすべての誤った文明を焼き尽くす者となった、でしょう？", "face": "u2150a1"}, {"name": "？？？", "text": "物質界でこんなに神々が集まってる様を見るなんて、\nやっぱり、私は誤った道を\n人類に教えてしまったのですね。", "face": "u2150a1"}, {"name": "アンナ", "text": "……あなたは？", "face": "l8458786dc994"}, {"name": "？？？", "text": "今まさに、この子たちが語ったばかりでしょう？\n文明を与え、滅びをまねいた者。", "face": "u2150a1"}, {"name": "？？？", "text": "そしてその罪がゆえに、\n天界の伝承からその名を消された者。", "face": "u2150a1"}, {"name": "？？？", "text": "王子、あなたの志は称賛すべきものです。\nけれど、古の技術を、与えるわけにはいきません。", "face": "u2150a1"}, {"name": "プロメ", "text": "これが最初で最後の警告です。\nこの先へ進むことは、このプロメが許しません。", "face": "u2150a1"}, {"name": "アンナ", "text": "戦うしか、なさそうですね……。\n王子、戦闘準備をお願いします！", "face": "l8458786dc994"}]}, {"trigger": "end", "lines": [{"name": "プロメ", "text": "…………それだけの力があれば、\nいずれ亜神ディアスにも手が届くでしょう。", "face": "u2150a1"}, {"name": "プロメ", "text": "なぜ焦るのですか。\n人類の苦しみはしばらく続くでしょうが、\nいつか、あなたの子孫がそれを晴らすでしょうに。", "face": "u2150a1"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "プロメ", "text": "未来に負債を残すわけにはいかない、と？", "face": "u2150a1"}, {"name": "プロメ", "text": "ですが、あなたが求めている古の技術は、\n本来ならば未だ人類が手にすることが\nなかったはずの、遥か未来の技術です。", "face": "u2150a1"}, {"name": "プロメ", "text": "己の器を超えた力を求めた結果は、\n同族による殺し合いと、力の暴走。\n文明の終焉のみです。", "face": "u2150a1"}, {"name": "プロメ", "text": "それでも、この先へ進むつもりですか？", "face": "u2150a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "プロメ", "text": "……何を言っても、無駄のようですね。\n分かりました。では、この先で待っています。", "face": "u2150a1"}, {"name": "アンナ", "text": "……あの方が、人類に火を与えた亜神。", "face": "l8458786dc994"}, {"name": "アラン", "text": "人類の母に反逆するようなものですね。\nそれでも、私たちは進まねばなりません。", "face": "u1511a1"}, {"name": "アラン", "text": "要塞宮殿に座すディアスを倒さねば、\n物質界はいずれ、停滞という滅びを迎えるのですから。", "face": "u1511a1"}]}], "active": true}