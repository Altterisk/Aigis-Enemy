{"quest_id": 8240, "name": "人類に火を与えた者", "description": "人に火を分け与え、神の座を追われた者が\n超古代文明の技術を求める王子たちを\n阻止するべくランタンの火と共に姿を現す。\n上級（★１獲得の目安：平均Lv10）", "event": "目覚めの炎", "event_category": "History", "mission_id": 920214, "map_no": 4883, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "tags": ["置物", "アーマー"], "fixture": true, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 100, "attack_range": 40, "attack_speed": 1, "attack_wait": 60, "attack_interval": 153, "move_speed": 2000.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2152160, "special_effect_id": 1702, "change_to": 1, "change_condition": 1, "missile_id": 11, "master_id": 37360, "global_id": 10977, "ranged": true, "variants": [{"tags": ["置物", "アーマー"], "fixture": true, "hp": 10000, "attack": 150, "base_hp": 10000, "base_attack": 150, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 1, "attack_interval": 44, "move_speed": 2000.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2152176, "special_effect_id": 1703, "master_id": 37361, "global_id": 10978}, {"tags": ["置物", "アーマー"], "fixture": true, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 100, "attack_range": 40, "attack_speed": 1, "attack_wait": 60, "attack_interval": 153, "move_speed": 2000.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2152192, "special_effect_id": 1702, "change_to": 3, "change_condition": 1, "missile_id": 11, "master_id": 37362, "global_id": 10979, "ranged": true}], "sp_change_to": [37362], "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 101 , 1 );\");", "sets_flags": [[101, 1]], "on_destroy": true}, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "physical", "armor