gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_to": 10, "change_condition": 4, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38792, "global_id": 12409, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 2, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "attack_wait": 60, "attack_interval": 164, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155648, "race_id": 11, "special_effect_id": 1812, "change_to": 13, "master_id": 37861, "global_id": 11478, "to_global_id": 11479, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 240}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ブロック不可"], "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "attack_wait": 60, "attack_interval": 164, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155664, "race_id": 11, "change_to": 12, "master_id": 37862, "global_id": 11479}], "popups": ["スノーワームから攻撃を受けると、\n攻撃後の待ち時間が増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。", "　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇", "スノースパイダーは\nニ種類の攻撃を交互に行います。\n\nスノースパイダーから\n物理の遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。", "毒カエルの魔物から攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "チャムチャム", "text": "えっほ、えっほ♪", "face": "u2549a1"}, {"name": "トレシア", "text": "さすがは魔界ボアの騎手。\n王子殿下からもお話を聞いたことがありますが、\nとんでもない踏破力ですね。", "face": "u2314a1"}, {"name": "マータン", "text": "魔界ボアの力だけじゃない、\n騎手の血の滲むような努力が垣間見える実力だ。\nマータン、努力家には親近感覚えるタイプ。", "face": "u2524a1"}, {"name": "ファオル", "text": "マータンもすごい努力家だもんね。\nたぶん、あの子と仲良くなれるんじゃない？", "face": "u2513a1"}, {"name": "マータン", "text": "おぉ、異文化フレンド！\nそういうの胸が熱くなる！\nおーいチャムチャムー！　一緒にえっほしよう！", "face": "u2524a1"}, {"name": "チャムチャム", "text": "えっ、一緒に！？\nいいよやろう！　レッツゴーゴブリン！", "face": "u2549a1"}, {"name": "マータン", "text": "レッツゴーゴブリン！", "face": "u2524a1"}, {"name": "トレシア", "text": "……一瞬で仲良くなりましたね。", "face": "u2314a1"}, {"name": "ファオル", "text": "単純に打ち解けるのが上手いだけじゃなくて、\nたぶん、互いに通じるところがあるんじゃないかな。", "face": "u2513a1"}, {"name": "トレシア", "text": "おかげで物資輸送も捗っています。", "face": "u2314a1"}, {"name": "トレシア", "text": "このあとも、何度か北部城塞と\n雪枝の里を往復しますが、\n魔物も積雪も蹴散らしてくれていますから。", "face": "u2314a1"}, {"name": "ファオル", "text": "うん、予定よりもすごく早く準備が終わりそうだね。", "face": "u2513a1"}, {"name": "チャムチャム", "text": "むっ……変なやつの気配する。", "face": "u2549a1"}, {"name": "マータン", "text": "くんくん……嗅いだことのない匂いだ。", "face": "u2524a1"}, {"name": "ファオル", "text": "……敵襲？", "face": "u2513a1"}, {"name": "チャムチャム", "text": "分からないけど、敵意を感じるよ！\n皆！　戦闘準備！！", "face": "u2549a1"}]}, {"trigger": "battle", "at_sec": 241, "lines": [{"name": "トレシア", "text": "なっ、か、カエル？\nどうして雪原にカエルの魔物が？", "face": "u2314a1"}, {"name": "マータン", "text": "なんだコイツ！\nゲコゲコするしぴょんぴょんしてる！", "face": "u2524a1"}, {"name": "チャムチャム", "text": "マータン！　あれは毒カエルの魔物だよ！\n攻撃受けると毒を浴びちゃうやつ！", "face": "u2549a1"}]}, {"trigger": "end", "lines": [{"name": "トレシア", "text": "雪原に存在しないはずの魔物。\nいったい何が起きて……。", "face": "u2314a1"}, {"name": "伝令兵", "text": "――伝令！　伝令！\n北部城塞群より、トレシア様へ！！", "face": "lbdf0f450a320"}, {"name": "トレシア", "text": "報告を。", "face": "u2314a1"}, {"name": "伝令兵", "text": "はっ！\n北部戦線各地に多数の魔物が出現しました！", "face": "lbdf0f450a320"}, {"name": "トレシア", "text": "魔物……？\n狭間の雪原からの襲撃ですか？", "face": "u2314a1"}, {"name": "伝令兵", "text": "いえ、何というのか……。\nいずれも北限ではほぼ見かけない個体ばかりです。", "face": "lbdf0f450a320"}, {"name": "トレシア", "text": "…………。", "face": "u2314a1"}, {"name": "マータン", "text": "トレシア！　迷う必要はないぞ！", "face": "u2524a1"}, {"name": "チャムチャム", "text": "そうだよ。\nここに最強の戦力が揃っているんだから。\nいそいで戻れば、最高の援軍になるよ！", "face": "u2549a1"}, {"name": "トレシア", "text": "……ですが、お客人にそんなことを――", "face": "u2314a1"}, {"name": "チャムチャム", "text": "アタシたちは、もう仲間でしょ！\nゴブリンは仲間を見捨てない！\nチャムチャムの誇りにかけて！", "face": "u2549a1"}, {"name": "ファオル", "text": "よし、決まりだね。\n急いで引き返そう！", "face": "u2513a1"}]}], "active": true}