{"quest_id": 6167, "name": "水鉄砲大会準備", "description": "海賊たちの夏祭り参加を賭け、\nフィリス隊と海賊で勝負を行うことに。\nフィリスを支援しその覚悟を海賊に見せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "王子軍の夏祭り", "event_category": "History", "mission_id": 920093, "map_no": 3247, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "physical", "armor_defense": 80, "attack_range": 300, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100448, "race_id": 16, "missile_id": 213, "master_id": 30430, "global_id": 4049, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 39, "form_count": 1, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "physical", "armor_defense": 80, "attack_range": 250, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101104, "race_id": 16, "missile_id": 213, "master_id": 30418, "global_id": 4037, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 80, "attack_range": 200, "attack_speed": 50, "attack_wait": 30, "attack_interval": 111, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101776, "race_id": 16, "missile_id": 213, "master_id": 30429, "global_id": 4048, "ranged": true, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104800, "race_id": 16, "missile_id": 213, "master_id": 30432, "global_id": 4051, "ranged": true, "spawn_sec": 56}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 4000, "attack": 450, "base_hp": 4000, "base_attack": 450, "damage_type": "physical", "armor_defense": 80, "attack_range": 250, "attack_speed": 90, "attack_wait": 100, "attack_interval": 246, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104928, "race_id": 16, "missile_id": 213, "master_id": 30419, "global_id": 4038, "ranged": true, "spawn_sec": 113}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 650, "base_hp": 7000, "base_attack": 650, "damage_type": "physical", "armor_defense": 80, "attack_range": 155, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104896, "race_id": 16, "special_effect_id": 222, "missile_id": 213, "master_id": 30428, "global_id": 4047, "ranged": true, "spawn_sec": 144}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 200, "attack_speed": 55, "attack_wait": 100, "attack_interval": 251, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104912, "race_id": 16, "missile_id": 213, "master_id": 30431, "global_id": 4050, "ranged": true, "spawn_sec": 150}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 300, "base_hp": 8000, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_interval": 11, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111008, "race_id": 16, "special_effect_id": 222, "missile_id": 213, "master_id": 30417, "global_id": 4036, "ranged": true, "spawn_sec": 152}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "physical", "armor_defense": 100, "attack_range": 400, "attack_speed": 120, "attack_wait": 100, "attack_interval": 251, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097888, "race_id": 16, "special_effect_id": 222, "missile_id": 213, "master_id": 30416, "global_id": 4035, "ranged": true, "spawn_sec": 162}], "dialogue": [{"trigger": "start", "lines": [{"name": "フィリス", "text": "ミネルバさん、\n夏祭りの余興として、水鉄砲大会を開きたいんだ。\n海賊の皆に協力して欲しい……頼む！", "face": "u506"}, {"name": "ミネルバ", "text": "……断るわ。私たちの銃は命の駆け引きを行う道具。\nそんな遊びで引き金を引くなんて事は、\n海賊のプライドを捨てるようなものだわ。", "face": "u91"}, {"name": "兵士", "text": "ミネルバさん、僕たちからもお願いします！\nフィリスさんは皆の為に夏祭りを成功させようと、\nこれまで準備してきたんです！", "face": "l8bd3049f618e"}, {"name": "ミネルバ", "text": "あら、フィリス隊の兵士じゃない。\n訓練の時の動きは酷かったし、夏祭りの準備より先に、\nやる事があるんじゃない？", "face": "u91"}, {"name": "フィリス", "text": "フィリス隊は……もう解散している。\n私が兵長を務められなかったからな……。", "face": "u506"}, {"name": "ミネルバ", "text": "……あら、そうなの。", "face": "u91"}, {"name": "フィリス", "text": "だが、まだ私は彼らと共に何も成してはいない。\nせめて何か一つくらい、彼らと共に成し遂げたいんだ。", "face": "u506"}, {"name": "フィリス", "text": "彼らと共に……絶対に、夏祭りを成功させたい。\nその為なら私はなんだってする……！\nだから頼む、力を貸してくれ！！", "face": "u506"}, {"name": "ミネルバ", "text": "迷いのない目ね。\n分かったわ。\nその水鉄砲を貸しなさい。", "face": "u91"}, {"name": "フィリス", "text": "ミネルバさん……やってくれるのか！？", "face": "u506"}, {"name": "ミネルバ", "text": "まだやるとは言ってないわ。\n今から私達と戦って勝つことが出来たら、\nその時はいくらでも余興に付き合ってあげるわ。", "face": "u91"}, {"name": "ミネルバ", "text": "水鉄砲とはいえ、油断は禁物よ、フィリス。\n私達海賊が放つ弾丸は常に命のやり取りをしてきたのよ。\n例え水鉄砲とはいえ、その威力は並じゃないわ。", "face": "u91"}, {"name": "フィリス", "text": "分かった……！", "face": "u506"}, {"name": "フィリス", "text": "みんな、まずは私が戦線に立って、\n部隊展開の機会を作る。\n水鉄砲が私に集中するから、その隙に一気に展開して！", "face": "u506"}, {"name": "兵士", "text": "はい、フィリスさん！", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "王子達も後ろで見てくれている。\nうまく連携を取れれば、\n後続部隊が攻勢をとりやすくなるはず……！", "face": "u506"}, {"name": "ミネルバ", "text": "（王子からの依頼とはいえ、やっぱり憎まれ役なんて\n嫌だわね。でも、それが彼からの信頼の証というなら、\n受けるしかないの。本当に嫌になっちゃうわね。）", "face": "u91"}]}, {"trigger": "end", "lines": [{"name": "ミネルバ", "text": "……貴方たちの覚悟、伝わったわ。\n夏祭りの余興引き受けてあげる。", "face": "u91"}, {"name": "フィリス", "text": "ほ……本当に良いのか！？", "face": "u506"}, {"name": "ミネルバ", "text": "ええ、海賊たるもの二言はないわ。", "face": "u91"}, {"name": "兵士", "text": "やりましたね、フィリスさん！\nこれで、夏祭りの準備も余興も、\n準備万端です！", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "ああ、そうだな。もうすぐだ……\n……日が暮れれば、夏祭りが始まる。\n……みんな、楽しんでくれるといいな。", "face": "u506"}]}], "active": true}