3}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 82}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 11, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 40, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105776, "race_id": 16, "master_id": 719, "global_id": 718, "spawn_sec": 83}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 91}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンクイーン", "text": "ウフフ……ゴブリンライダー！\n予定の地点へ移動しなさ～い。", "face": "ldf5e1bdd1e51"}, {"name": "ゴブリン", "text": "ギャギャッ！\n配置、オワッタ！　英雄、タオス！", "face": "le4066ac1ed12"}, {"name": "ゴブリンクイーン", "text": "あのゴブリン達がこんなにきびきび動くなんて。\n本当に軍隊みたいになって嬉しいわぁ……ウフフ。\nで、今回の作戦はどうなってるのかしらぁ？", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "王子軍の遠距離攻撃部隊の無力化を目的とした\nゴブリンライダーの特殊配置によって、奴らの\n特定の部隊を機能不全にさせるのです。", "face": "u354"}, {"name": "ヘレナ", "text": "遠距離攻撃を封じられた敵軍に対し、兵数で\n勝る我が軍の有利を最大限に活用した密集陣形\nでもって王子たちを追い詰め、捻伏せてみせます。　", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "ウフフ……素晴らしい作戦だわぁ。\nでも、そろそろ後がない事も覚えておきなさい。\nワタシは優しいけど、怒るときは怒るわよぉ？", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "……十全に、理解しているつもりです……。\n今度こそ……今度こそ必ず\nこの手に勝利を掴み、ご覧に入れましょう。", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "……ウフフ。いい顔つきよヘレナ……。\nそれじゃあワタシはもう行くわねぇ。\nアナタの戦いを遠くから見守っているわ……。", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "（…………ようやく、行ったか。\nふん……誰も君の勝利などとは言っていない。\n今に見ていろ……ゴブリンクイーン。）", "face": "u354"}, {"name": "ヘレナ", "text": "（王子ならば、この総攻撃、必ず打ち破るだろう。\nこの戦いでゴブリン軍は終わりだ……ッ！）", "face": "u354"}]}, {"trigger": "start", "lines": [{"name": "へクター", "text": "ゴブリンの軍勢を確認！\nどうやら待ち伏せていたようです！", "face": "u74"}, {"name": "アンナ", "text": "敵が向かってきます！\n王子、戦いのご準備を。", "face": "la0e94353615f"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンクイーン", "text": "そんな、ゴブリン軍団が壊滅ですってぇ！？\n組織化して、訓練だってしたのに……。\nヘレナ……これはどういうことなのかしらぁ？", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "……ご覧の通りです。\n私には、これが限界だったというだけ……。", "face": "u354"}]}, {"trigger": "end", "lines": [{"name": "ヘレナ", "text": "ここまでの大敗を喫しておいて、ゴブリン軍の\n軍師を名乗ることなどできません……。\n責任をとり、私は軍から身を退こうと――。", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "――許さないわ。", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "……え？", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "そんなこと絶対に許さないわよぉ、ヘレナ……。\n仮にも戦術家なら戦いで汚名をそそぎなさい。\n何の為に、あなたを引き入れたと思ってるの？", "face": "ldf5e1bdd1e51"}, {"name": "ゴブリンクイーン", "text": "もう容赦しないわぁ……。\n最新型の騎獣戦車でもって、次こそは王子たちを\nバラバラにしてやるのよぉ……ウフフ……。", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "――ッ！？\n騎獣戦車……完成していたのですか！？\nまさか……ここで使うおつもりなのですか？", "face": "u354"}, {"name": "ヘレナ", "text": "（……まずいな。\nこの地形で戦車などと……\nこのままでは王子軍は壊滅だぞ……！）", "face": "u354"}, {"name": "ヘレナ", "text": "（なんとか戦場を変えるしか……。\nいや……まて。戦場を変えるのではなく、\n戦場の地形を変化させれば……！）", "face": "u354"}]}], "active": true}