tack_wait": 30, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107280, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30922, "global_id": 4541, "ranged": true, "spawn_sec": 169}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 64, "global_id": 63, "spawn_sec": 178}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 50, "base_hp": 9000, "base_attack": 50, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 74, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109456, "race_id": 16, "master_id": 30190, "global_id": 3809, "spawn_sec": 181}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 32000, "attack": 800, "base_hp": 32000, "base_attack": 800, "damage_type": "magical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 30, "attack_interval": 69, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117600, "race_id": 3, "master_id": 31558, "global_id": 5177, "spawn_sec": 219}], "popups": ["敵に王子がいる間は\n全ての敵の攻撃力と\n防御力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マンモン", "text": "……んー、あっちの子たちも中々。\nでも願いを叶えてあげたい感は、\nやっぱりあの人間の子達の方が……。", "face": "u767"}, {"name": "シャディア", "text": "……いや、あなたに願いを叶えられると、\nそのまま人は破滅の道を行くと聞く。\n残念ながら私達には、そんな余裕はないんだ。", "face": "u713"}, {"name": "マンモン", "text": "あら、あらあら？\nもう追いついてきてしまったのですか？", "face": "u767"}, {"name": "マンモン", "text": "むむむ、でもどうしても叶えたい願いや、\n酷く苦しい後悔が、人間にはあるものでしょう？\n……ね？　……ね？　ね？", "face": "u767"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "…………。", "face": "l3cefd61f240e"}, {"name": "マンモン", "text": "ですから、今度はあなたの願いを叶えてあげます！\n可愛い可愛いお嬢さんの願い、\nほら、これでどうですか？　素敵でしょう？", "face": "u767"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "……これは、王国……いえ、これはっ！\n私の……夢みた……。", "face": "l3cefd61f240e"}, {"name": "ロイ", "text": "何と、魔物の復活以前の王国の姿。\nまさか人の記憶や願望から、\nこれほどの規模の幻影を紡ぎ出すとは……っ！！", "face": "u11"}, {"name": "マンモン", "text": "私の力で満たしたこの迷宮は、欲望を映す鏡です。\nこの迷宮の中であれば、誰もが願いを叶えられる。\nさぁ、私があなたの欲を満たしてあげますからね！", "face": "u767"}, {"name": "アンナ", "text": "……だめ、だめですっ！\n過去を再現するためではなく、\n平和な未来を掴み取るために戦っているのですから！", "face": "ldefe8315eabe"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "王子、過去の私達に勝ちましょう。\n思い出に負けていては、\nここから先には進めませんから。", "face": "l3cefd61f240e"}, {"name": "マンモン", "text": "…………やだ、ちょっと素敵じゃないですか？\nそれなら私も、さっきよりちょっと本気を出しますね。\nあなた達の願望と輝きを見せてくださいな！", "face": "u767"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "なんとか勝利できましたね。\n過去の自分達より、\n今の方が勝っていると前向きに考えましょう。", "face": "u114"}, {"name": "アンナ", "text": "願望の投影ではなく、現実の世界でこそ、\nあんな平和な世界を\n実現していかなければなりませんね。"}, {"name": "アルス", "text": "そういう意味では、\nマンモンには感謝した方がいいかな？\n昔の自分を振り返る手助けをしてくれたわけだしね。", "face": "u73"}, {"name": "マンモン", "text": "……むむ、少し複雑ですが、\n感謝されるのは悪い気分ではないですね？", "face": "u767"}, {"name": "フィリス", "text": "（悪いやつじゃないんだな……）", "face": "u40"}, {"name": "ソーマ", "text": "（そうですね、素直というか、一途というか……。\nちゃんとお話すれば『力』のところまで\n道案内をしてくれないでしょうか……？）", "face": "u23"}, {"name": "マンモン", "text": "――んっ、『力』？　あっ、そうでした！\n魔王軍……？　の子達の相手もしてあげないと！", "face": "u767"}, {"name": "マンモン", "text": "でもすぐそこですからね、\nさっきみたいに急がなくても\nたっぷり遊んであげられそうです♪", "face": "u767"}, {"name": "フィリス", "text": "……魔王軍が、近くにいるだって！？\nこうしちゃいられない、早く連中を止め――", "face": "u40"}, {"name": "シャディア", "text": "――待てフィリス。\nようやく追いつけたのだから、万全の状態で進むべきだ。\n何しろ向こうの戦力も分からないのだぞ？", "face": "u713"}, {"name": "フィリス", "text": "……むぅ、確かに。\nよし、急いで準備を整えよう。", "face": "u40"}, {"name": "アンナ", "text": "王子、ここから先は何が起きるか分かりません。\n十分な準備をしてから進軍しましょう。", "face": "l3cefd61f240e"}]}], "active": true}