": 20000, "attack": 380, "base_hp": 20000, "base_attack": 380, "damage_type": "true", "armor_defense": 200, "magic_defense": 90, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 245, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152624, "special_effect_id": 1715, "change_to": 20, "change_condition": 4, "missile_id": 1071, "missile": {"speed": 6.0}, "master_id": 41100, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 7, "form_count": 12, "hp": 20000, "attack": 500, "base_hp": 20000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 90, "attack_range": 320, "attack_speed": 1, "attack_wait": 80, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152608, "special_effect_id": 1714, "change_to": 21, "change_condition": 4, "missile_id": 1070, "master_id": 41101, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 8, "form_count": 12, "hp": 20000, "attack": 650, "base_hp": 20000, "base_attack": 650, "damage_type": "physical", "armor_defense": 200, "magic_defense": 90, "attack_range": 240, "attack_speed": 1, "attack_wait": 40, "attack_interval": 229, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152640, "special_effect_id": 1716, "change_to": 22, "change_condition": 4, "missile_id": 11, "master_id": 41102, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 2}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 9, "form_count": 12, "hp": 20000, "attack": 500, "base_hp": 20000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 90, "attack_range": 320, "attack_speed": 1, "attack_wait": 80, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152608, "special_effect_id": 1714, "change_to": 24, "change_condition": 4, "missile_id": 1070, "master_id": 41104, "ranged": true, "from_condition": 4, "trigger_ticks": 2, "to_condition": 4, "to_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "hp": 20000, "attack": 380, "base_hp": 20000, "base_attack": 380, "damage_type": "true", "armor_defense": 200, "magic_defense": 90, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 245, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152624, "special_effect_id": 1715, "change_to": 25, "change_condition": 4, "missile_id": 1071, "missile": {"speed": 6.0}, "master_id": 41105, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "hp": 20000, "attack": 500, "base_hp": 20000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 90, "attack_range": 320, "attack_speed": 1, "attack_wait": 80, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152608, "special_effect_id": 1714, "change_to": 26, "change_condition": 4, "missile_id": 1070, "master_id": 41106, "ranged": true, "from_condition": 4, "trigger_ticks": 1}], "popups": ["\n\n\n\n　　　　　――王都"], "dialogue": [{"trigger": "battle", "at_sec": 52, "lines": [{"text": "――王都"}, {"name": "レーヴ", "text": "――王子！　ご無事でよかったです！\n魔力の追跡、こちらでも結果が出ました。", "face": "u454"}, {"name": "レーヴ", "text": "魔神たちの反応は……この王都の中です！", "face": "u454"}, {"name": "フローガ", "text": "王都に、異界の門がふたつ……。\n眷属が溢れ出しているようです！", "face": "u878"}, {"name": "貴族セーレ", "text": "クックック。王子よ、\n貴様の民を人質に取らせてもらった。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "私が先に人質に取ったのだ！　ハニホー！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "黙れ紛い物！\nランスを殺すのは私だ！", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "なにをぅ！？　私だぞ！", "face": "l889a78825052"}, {"name": "ヒエン", "text": "主よ、敵は二手に分かれておりまする。\n東と西、挟撃の構え……。", "face": "u112"}, {"name": "サナラ", "text": "でも、あのふたり、\n全然連携する気がないですよね……？", "face": "u921"}, {"name": "リア", "text": "……ふぅ～ん？", "face": "u2901a1"}, {"name": "リア", "text": "ねえ、王子。あのふたり、\nお互いのことを全然信用してないわよ。", "face": "u2901a1"}, {"name": "リア", "text": "片方が勝てば、もう片方は用済み。\nそういう連中の顔をしてる。", "face": "u2901a1"}, {"name": "シルキィ", "text": "同感。仲間というより、\nどちらが先に裏切るかを計っている目。", "face": "u2902a1"}, {"name": "ランス", "text": "難しいことは分からんが、要するに\nあの二匹はまとめてぶっ飛ばせばいいんだな！", "face": "u2897a1"}, {"name": "リア", "text": "もう、ダーリンったら。\nでも、それで合ってるわ！", "face": "u2901a1"}, {"name": "アンナ", "text": "王子、東西から同時に敵が来ます！\n両方の魔神を押し返しましょう！"}]}, {"trigger": "end", "lines": [{"name": "貴族セーレ", "text": "くっ……なぜ私の兵ばかり減っている！", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "私の偽ハニーもだ！\n貴様、手を抜いたな！", "face": "l889a78825052"}, {"name": "リア", "text": "――ふふ。ねえ、そこの偉そうな方のセーレ。", "face": "u2901a1"}, {"name": "リア", "text": "丸い方が言ってたわよ？\n「あいつは私に倒される役だ」って。", "face": "u2901a1"}, {"name": "貴族セーレ", "text": "何だと……！？", "face": "l70921f716695"}, {"name": "リア", "text": "丸い方も聞いて。偉そうな方、\n「ハニーの力を奪って完全体になる」って言ってたわ。", "face": "u2901a1"}, {"name": "ハニーセーレ", "text": "ぬぐっ……！？　やはり貴様、\n私を魔力炉に投げ込むつもりだったな！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "先に企んだのは貴様だろうが！", "face": "l70921f716695"}, {"name": "シィル", "text": "あ、あの、リア様……？\n本当にそんなこと言ってましたか？", "face": "u2900a1"}, {"name": "リア", "text": "言ってないわよ？\nでも、思ってはいるでしょ。あの顔。", "face": "u2901a1"}, {"name": "志津香", "text": "女王って怖いわね……。", "face": "u1759a1"}, {"name": "ハニーセーレ", "text": "偽物め！　この場で決着をつけてやる！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "望むところだ！\n――いや、待て。", "face": "l70921f716695"}, {"name": "貴族セーレ", "text": "……あの男と王子の目。\n今、我らが仲違いすれば、まとめて狩られるぞ。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "……ちっ。", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "今日のところは引く。\nだが、次は居城で待っている。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "魔力炉で決着をつけようではないか。\nランス、王子、貴様らもだ！　ハニホー！", "face": "l889a78825052"}, {"name": "グリム", "text": "あっ、異界の門で帰っちゃいましたー。\nでも、大事な情報を落としていきましたねー。", "face": "u942"}, {"name": "シィル", "text": "はいっ。魔力炉……？\nそれと、ランス様の呪印の痕跡から、居城の場所も！", "face": "u2900a1"}, {"name": "シィル", "text": "セーレさんたちの居城は、\n次元の狭間の……あっちの方向です！", "face": "u2900a1"}, {"name": "グリム", "text": "よし、それならそこそこ時空間も安定してきたので、\n私が門を開けますよー。\n次元の狭間直通、やっと展開できますねー。", "face": "u942"}, {"name": "アンナ", "text": "決戦に備えて、一度準備を整えましょう。\n王子、ランスさん、敵は魔神です、\n万全の備えをしておいてください。"}, {"name": "ランス", "text": "がははは！　ようやくだ！\nセーレをぶっ飛ばして呪いを解いて、女の子と――", "face": "u2897a1"}, {"name": "リア", "text": "ダーリン、まだ近づいたら駄目よ？", "face": "u2901a1"}, {"name": "ランス", "text": "ぐぬぬぬぬ！", "face": "u2897a1"}]}], "active": true}