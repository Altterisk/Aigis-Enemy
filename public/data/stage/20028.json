{"quest_id": 20028, "name": "呪印の魔力を辿って", "description": "魔力を追って辿り着いた王都では、民を\n人質にしたセーレたちが待ち構えていた。\nしかし、何やらぎこちない動きをしていて？\n上級（★１獲得の目安：平均Lv10）", "event": "ランス1000　鬼畜戦士の降臨", "event_category": "Emergency", "mission_id": 200582, "map_no": 7494, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 130000, "attack": 750, "base_hp": 130000, "base_attack": 750, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 20, "attack_interval": 84, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143184, "race_id": 3, "change_to": 1, "master_id": 35968, "global_id": 9585, "to_global_id": 9586}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルスII", "ブロック不可"], "hp": 130000, "base_hp": 130000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 60, "attack_interval": 202, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143200, "race_id": 3, "special_effect_id": 1160, "master_id": 35969, "global_id": 9586}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 2, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "change_to": 3, "change_condition": 2, "master_id": 30976, "global_id": 4595, "to_condition": 2, "to_global_id": 403, "spawn_sec": 53}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1500, "attack": 100, "base_hp": 1500, "base_attack": 100, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_r