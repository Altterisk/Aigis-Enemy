 "global_id": 7709, "ranged": true, "variants": [{"hp": 6500, "attack": 600, "base_hp": 6500, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 30, "attack_wait": 20, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130960, "race_id": 2, "master_id": 34093, "global_id": 7710}], "spawn_sec": 193}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130992, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34095, "global_id": 7712, "ranged": true, "spawn_sec": 233}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_range": 200, "attack_speed": 90, "attack_wait": 10, "attack_interval": 70, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2140208, "race_id": 2, "special_effect_id": 234, "change_to": 14, "change_condition": 1, "missile_id": 45, "master_id": 35320, "global_id": 8937, "ranged": true, "variants": [{"hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 157, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2140224, "race_id": 2, "special_effect_id": 621, "master_id": 35321, "global_id": 8938}], "spawn_sec": 249}], "popups": ["工場は壊されると爆発して、\n自身の周囲の\n敵味方にダメージを与えます。\n\n壊されても★の評価には\n影響しません。", "飛翔するクロコは、\n移動中は攻撃を行いません。", "雷竜クロコ降臨が\n解放されました。\n\nホーム画面左側の\nミッションクエストにある、\n魔神降臨のメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "クロコ", "text": "――この街も落ちたカ……。\n人の文明ナド、実に脆いものダ。", "face": "lc6a487316ae7"}, {"name": "クロコ", "text": "守れもシナイ領土を広げ、\n現にコウシテ、愚かな敗北を繰り返ス。", "face": "lc6a487316ae7"}, {"name": "クロコ", "text": "ダガ、ソノ歩みだけは覚えておこウ。\n次の時代に、愚かな先人の歴史とシテ。\n最後の仕上げに移ると――", "face": "lc6a487316ae7"}, {"name": "竜人戦士", "text": "クロコ様、遠方ヨリ軍勢が迫っておりまス。\nおそらく帝国軍カト。", "face": "u95"}, {"name": "クロコ", "text": "ホウ、想定より、少々早かったナ……。\n良いだろう、少々飽いてきたところダ。", "face": "lc6a487316ae7"}, {"name": "ヴルム", "text": "どっけぇぇぇぇぇッ！！", "face": "u527"}, {"name": "ゴライア", "text": "オラァ！　腰抜けドモ！\n竜の誇りがネェならどきやがれェ！！", "face": "u385"}, {"name": "クロコ", "text": "……マタ奴らか。", "face": "lc6a487316ae7"}, {"name": "ジュディス", "text": "……！　陛下、街が……！", "face": "u2089a1"}, {"name": "クリッペ", "text": "街壁が突破されてる……。\nしかもあれ、工場の排熱が止まってない！？", "face": "u2084a1"}, {"name": "ヘンドリカ", "text": "今工場を破壊されたら……。\n周囲を巻き込んで大爆発しちゃうぞ！", "face": "u1106a1"}, {"name": "ジュディス", "text": "……あの、それって、\n工場を止められる人も、もういないってことですか？\n工場の職員さんは、街のみんなは――", "face": "u2089a1"}, {"name": "リチュエ", "text": "…………。", "face": "u2088a1"}, {"name": "オルフィー", "text": "リチュエ、今は――", "face": "u2085a1"}, {"name": "白の皇帝", "text": "冥界の騎士たちならば、命の灯火も分かるだろう。\n……教えろ。帝国の民の血は、流れたのか。", "face": "u418"}, {"name": "リチュエ", "text": "…………まだ、全部が消えたわけじゃないです。\nでも、これは……。", "face": "u2088a1"}, {"name": "オルフィー", "text": "失われたのは、戦士の魂ばかり。\n力なき者たちを守るために散っていったのでしょう。", "face": "u2085a1"}, {"name": "白の皇帝", "text": "…………そう、か。", "face": "u418"}, {"name": "白の皇帝", "text": "クロコ……竜将クロコ。\n貴様の思惑など、知ったことではない。", "face": "u418"}, {"name": "白の皇帝", "text": "今ここで、貴様の雷を終わらせる。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "クロコ", "text": "……想定以上、カ。\n我が雷霆の目覚めヨリ早く、\nこれだけの力ヲ手にスルとは。", "face": "lc6a487316ae7"}, {"name": "白の皇帝", "text": "もはや、貴様の言葉など届かない。\n何を言おうと、ただ叩き潰すだけだ。", "face": "u418"}, {"name": "クロコ", "text": "……結構。\nその怒り、人の身としておくには惜しいものダ。", "face": "lc6a487316ae7"}, {"name": "クロコ", "text": "シカシ、こちらにも退けぬ理由がアル。\nいずれ終焉ヲ迎えるコノ大地で、\n竜神の血を残すタメに――", "face": "lc6a487316ae7"}, {"name": "竜人戦士", "text": "オヤメください！\nクロコ様、今のお身体デハ、\n雷竜の力に耐えきれマセヌ！！", "face": "u95"}, {"name": "クロコ", "text": "逃げろト言うノカ！？", "face": "lc6a487316ae7"}, {"name": "竜人戦士", "text": "そうデス！\nモハヤ、ハイドースも帝国も関係アリませヌ！", "face": "u95"}, {"name": "竜人戦士", "text": "古の雷竜、真なる雷霆、その成就のタメ、\n我らはココに集いましタ。", "face": "u95"}, {"name": "竜人戦士", "text": "愚かな人類に雷の鉄槌を下ス日マデ、\n御身に散られては困りまス！", "face": "u95"}, {"name": "白の皇帝", "text": "どうした、尻尾を巻いて逃げ出すのか？\n無様だな、偽物の雷竜殿。", "face": "u418"}, {"name": "クロコ", "text": "クッ……。", "face": "lc6a487316ae7"}, {"name": "白の皇帝", "text": "ここで、終わらせてやろう。\nその覚悟もなく、俺の民を手に掛けたわけではあるまい？", "face": "u418"}, {"name": "クロコ", "text": "ほざけぇぇぇぇッ！！", "face": "lc6a487316ae7"}, {"name": "竜人戦士", "text": "クロコ様！\nくっ……転送魔法陣を急ゲ！", "face": "u95"}, {"name": "ルーテ", "text": "――ッ！　……クロコ、竜人部隊、消失。\nおそらく転移の魔法を使ったようです。", "face": "u529"}, {"name": "レオナ", "text": "…………工場の機関停止を急げ。\n爆発を止め、負傷者の手当てを。", "face": "u311"}, {"name": "レオナ", "text": "それから……。", "face": "u311"}, {"name": "白の皇帝", "text": "死者の確認を。\n必ず、全員見つけ出せ。", "face": "u418"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 11, "params": [200]}], "enemies": [{"enemy_id": 1, "hp": 1199999, "attack": 11999, "damage_type": "physical", "pattern_id": 2151584}, {"enemy_id": 1, "form_index": 1, "hp": 1199999, "attack": 11999, "damage_type": "physical", "pattern_id": 2151584}, {"enemy_id": 3, "hp": 7200, "attack": 300, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2130976}, {"enemy_id": 4, "hp": 144000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2130912}, {"enemy_id": 4, "form_index": 1, "hp": 144000, "attack": 3300, "damage_type": "true", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2130928}, {"enemy_id": 6, "hp": 1440, "attack": 360, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "pattern_id": 2098416}, {"enemy_id": 7, "hp": 1200, "attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "pattern_id": 2098432}, {"enemy_id": 8, "hp": 4800, "attack": 840, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2098528}, {"enemy_id": 9, "hp": 7200, "attack": 500, "damage_type": "magical", "armor_defense": 400, "pattern_id": 2098544}, {"enemy_id": 10, "hp": 50400, "attack": 1500, "damage_type": "magical", "armor_defense": 600, "pattern_id": 2151376}, {"enemy_id": 11, "hp": 7800, "attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "pattern_id": 2130944}, {"enemy_id": 13, "hp": 24000, "attack": 600, "damage_type": "magical", "armor_defense": 400, "pattern_id": 2130992}, {"enemy_id": 14, "hp": 7200, "attack": 500, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2140208}]}, "active": true}