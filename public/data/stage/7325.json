eed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103376, "race_id": 8, "change_to": 31, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 442, "global_id": 441, "ranged": true, "to_condition": 3, "to_global_id": 442, "route_behaviour": {"sets_flags": [[0, 1, 0]]}, "spawn_sec": 235}, {"enemy_id": 31, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 443, "global_id": 442, "ranged": true, "from_condition": 3}, {"enemy_id": 33, "source": "local", "count": 3, "form_count": 1, "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105088, "race_id": 8, "special_effect_id": 567, "master_id": 382, "global_id": 381, "spawn_sec": 253}, {"enemy_id": 34, "source": "local", "count": 4, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103408, "race_id": 8, "change_to": 34, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 444, "global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "spawn_sec": 261}, {"enemy_id": 34, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}], "popups": ["オークロードは\nHPが50％以下になると\n攻撃速度が上昇し、\n遠距離攻撃を行うようになります。", "オークシールダーは\n味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nブロックされている間、\n引き付けの効果を失います。\n　　　　　　(1/2)", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "蘇ったオーク勇者", "text": "城門なんざワシらの敵じゃないぞ。\nここはひとつ、城壁に穴あけてやらァッ！！", "face": "lb2983dc719b8"}, {"name": "ディルク", "text": "城壁が……一撃で砕け散っただと……？\nまずい、敵が来るぞ！　守りを固めろ！！", "face": "u287"}, {"name": "蘇ったオーク勇者", "text": "見たか！　若ぇの！！\nワシらの子孫の土地を奪った\n白の帝国の土手っ腹に風穴あけてやったぞッ！！", "face": "lb2983dc719b8"}, {"name": "蘇ったオーク勇者", "text": "あとは今の世を生きる……お前たちの役目だ……。\n存分に戦え、戦って、戦って、名誉ある死に至れ。\n……冥界で、土産話を楽しみに待っているぞ。", "face": "lb2983dc719b8"}, {"name": "蘇ったオーク勇者", "text": "さて、ワシには会わない方がいいヤツがいるからな……。\nさっさと冥界に戻ると――", "face": "lb2983dc719b8"}, {"name": "？？？", "text": "――誰が、会わない方がいいヤツだ。\n親父、今度こそ死に様を看取ってやるぞ。", "face": "l7abef6f2023c"}, {"name": "蘇ったオーク勇者", "text": "けっ……戦士が息子に死を看取られるなんざ、\n全然嬉しくないだろうが……。", "face": "lb2983dc719b8"}, {"name": "オークロード", "text": "黙れよ、こうして晴れ姿を見せてやったんだ。\nお前の息子は、今や物質界のオークを率いる王となったぞ。\n――白の帝国に負けた、敗軍の王だがな。", "face": "l7abef6f2023c"}, {"name": "蘇ったオーク勇者", "text": "……ワシの息子のくせに、頑張ったんだな。\n戦うことしか教えられなかったが、\nそうか、王となったか……。", "face": "lb2983dc719b8"}, {"name": "オークロード", "text": "ああ、どうだ、冥界への土産話ができただろう。\nだから、今度こそ、安心して逝ってくれ……。", "face": "l7abef6f2023c"}, {"name": "蘇ったオーク勇者", "text": "…………ああ、さらばだ、息子よ。\n――困った時には頼れよ、冥界から助けに来てやる。", "face": "lb2983dc719b8"}, {"name": "オークロード", "text": "ハッ、別れが台無しだぞ、親父。\nそういう冗談は、オレが死んだ時、冥界で聞かせてくれ。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "さぁ我が配下たちよ、\n誇りを胸に、立ち上がったオークよ！\n先代勇者たちが開いた血路、食い破るは今ぞ！！", "face": "l7abef6f2023c"}, {"name": "マレブランケ", "text": "あいつが物質界のオーク、\nそのすべてを束ねる長、オークロードってわけか……。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "ハイドースめ、さすがは冥界の亜神か。\n戦士の心を滾らせる方法を熟知しているようだ。", "face": "u1225a1"}, {"name": "メフィスト", "text": "伝説上のオーク勇者に、\n完璧なタイミングでのオークロードの出陣……。\nいずれも戦争を知る者の手腕だな。", "face": "u526"}, {"name": "マレブランケ", "text": "敵を褒めている場合じゃないよ、団長。\n――王子、もうあまり時間がない、\nオークの大攻勢を受け止める準備を！！", "face": "u1225a1"}]}, {"trigger": "battle", "at_sec": 10, "lines": [{"name": "オーク", "text": "ウオオォォオッ！　ロードッ！！\nウオオォォオッ！！　我らが王ッ！！", "face": "le8d3f3acf4c9"}, {"name": "ハイオーク", "text": "ウオオォォオッ！　ロードッ！！\nウオオォォオッ！！　我らが覇王！！", "face": "l7bf980320ebd"}, {"name": "オークロード", "text": "……オレは今、すこぶる機嫌がいい。\nさぁ人間ども、オレの相手をするのは誰だッ！！", "face": "l7abef6f2023c"}]}, {"trigger": "end", "lines": [{"name": "オークロード", "text": "くっ……なんという力だ……。\nまさかオークでない者に、これ程の使い手がいたとはな。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "……これは次の戦が楽しみだ。\n者ども、笑え！　笑いながら、歩いて退けッ！！", "face": "l7abef6f2023c"}, {"name": "ハイオーク", "text": "……はっ、わ、笑いながら、歩いて、ですか？", "face": "l7bf980320ebd"}, {"name": "オークロード", "text": "そうだッ！　だが追撃してくる者は皆殺しにしろ！\nそうして――次の戦の為に生き残れッ！！", "face": "l7abef6f2023c"}, {"name": "ハイオーク", "text": "ハッ……ハハッ、笑えッ！\n貴様ら、王の命令だ！　笑えッ！！", "face": "l7bf980320ebd"}, {"name": "オーク", "text": "おぉ……おぉぉぉッ！！\nガーッハッハッハッ！！　ウオォォーッ！！", "face": "le8d3f3acf4c9"}, {"name": "マレブランケ", "text": "――追撃は、どうする？", "face": "u1225a1"}, {"name": "レオナ", "text": "連中が退いたのは、壊滅したからではない。\nこれ以上の被害拡大を防ぐために退いたのだ。", "face": "u311"}, {"name": "レオナ", "text": "ここで追撃をすれば、その部隊は残らず返り討ちにあうぞ。\n……今回は、痛み分けだな。", "face": "u311"}, {"name": "アナトリア", "text": "あれが物質界のオークの長、オークロードか。\n魔界のオークとは、やっぱり考え方が違うねぇ。", "face": "u522"}, {"name": "イリオス", "text": "はい……でも、少しだけ心が震えました。\nきっと、物質界のオークはそれ以上に。", "face": "u872"}, {"name": "アナトリア", "text": "手強い相手だよ、兵の心を掴んでる。\n――そう、それこそ連中にとっての王子みたいなものさ。", "face": "u522"}, {"name": "トゥアン", "text": "……おい、それより……レオナ、だったか？\n連中、やけに的確にこの砦を攻めてきたな。\n裏切り者は、オークや獣人だけなのか？", "face": "u1006a1"}, {"name": "レオナ", "text": "何……どういうことだ？", "face": "u311"}, {"name": "トゥアン", "text": "最新鋭の兵器なんだろ、帝国式魔導何とかってのは。\n――それがこの砦にあるって、\n情報を流したヤツがいるんじゃないかと思ってね。", "face": "u1006a1"}, {"name": "レオナ", "text": "帝国に、内通者がいると……？\n馬鹿な、軍内に裏切り者がいるはずが――", "face": "u311"}, {"name": "マレブランケ", "text": "――いや、いるよ。\n正規軍は忠誠心の高い兵士ばかりだけど、\nそうじゃない連中が、帝国にはいるじゃないか。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "私兵を持つ貴族が、王政の頃からの連中が、\n今の白の帝国にどれだけいると思っているんだい。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "その中でも、公然と皇帝陛下に牙を剥いたのは――", "face": "u1225a1"}]}, {"trigger": "end", "lines": [{"name": "ベラート", "text": "――我が情報、お役に立ちましたかな？", "face": "l21787b277675"}, {"name": "ハイドース", "text": "ああ、帝国式魔導砲の情報、大儀である。\n我が配下であれば褒美を与えるところだが――", "face": "le4066daa294e"}, {"name": "ベラート", "text": "いやいや、私はあくまで同盟者ですからな。\n褒美は最前線で戦った、\n獣人、オーク、冥界兵に与えるのが筋というもの。", "face": "l21787b277675"}, {"name": "ハイドース", "text": "殊勝な心がけだな。\nでは、この礼は別の形でするとしよう。\n帝国――いや、白の王国貴族たるベラートよ。", "face": "le4066daa294e"}, {"name": "ベラート", "text": "我ら王政の時代より国を支えてきた貴族……。\n何処の馬の骨とも知れぬあの男が長となって以来、\n我が祖国は戦に明け暮れ、歪んでいくばかり……。", "face": "l21787b277675"}, {"name": "ハイドース", "text": "帝国とは決して止まれぬものだ。\n侵略を始めたなら、全てを喰らい尽くすか、\n内部より食い破られるしかない。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "これまで、よくぞ耐えてきた。\n貴様ら白の王国貴族の無念、\n我ら冥界軍と共に晴らそうではないか。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "――さぁ、女神アダマスよ。\n此度の戦は始まったばかり。\nその首、どう落としてやろうか……。", "face": "le4066daa294e"}]}, {"trigger": "route", "enemy_ids": [3], "lines": [{"name": "オークロード", "text": "帝国――いや、王国か？\nそっちにも良い戦士がいるじゃないか……。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "良いだろう、そろそろ本気を見せてやる。\nう、お、お、おおお、おおおおおおおォオオッ！！", "face": "l7abef6f2023c"}]}], "active": true}