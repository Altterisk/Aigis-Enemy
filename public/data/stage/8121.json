form_count": 1, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "spawn_sec": 150}, {"enemy_id": 23, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 5000, "base_hp": 3000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 40, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102128, "race_id": 3, "special_effect_id": 57, "master_id": 359, "global_id": 358, "spawn_sec": 150}, {"enemy_id": 24, "source": "local", "count": 8, "form_count": 1, "hp": 5200, "attack": 900, "base_hp": 5200, "base_attack": 900, "damage_type": "physical", "armor_defense": 400, "attack_speed": 60, "attack_wait": 10, "attack_interval": 177, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097408, "race_id": 3, "master_id": 10057, "global_id": 1056, "spawn_sec": 170}], "popups": ["アンデッド系から\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "みんなー！\n今日はアンナの年末ライヴに来てくれて、ありがとー！！", "face": "u606"}, {"name": "一般兵", "text": "うぉぉぉぉ！　アンナ！\nうぉぉぉぉ！　政務官！！", "face": "u6"}, {"name": "アンナ", "text": "のんのん、今は政務官じゃなくて、\nあ・い・ど・る♪　アンナでしょ？", "face": "u606"}, {"name": "重装兵", "text": "うぉぉぉぉぉ！　アンナちゃん！\nアイドルアンナちゃーん！！", "face": "u65"}, {"name": "アンナ", "text": "今日はなんと、\n魔界からもファンの皆が来てくれています。\n魔界のみんなー！　ありがとー！", "face": "u606"}]}, {"trigger": "start", "lines": [{"name": "ゴブリン", "text": "ギャギャ！　アンナチャーン！！", "face": "l86d5a806e375"}, {"name": "エフネ", "text": "うぅ、悔しいけど、\nまだまだ伝説の人気には勝てませんね……。", "face": "u969"}, {"name": "エスネア", "text": "ふふん、アイドルは勝ち負けじゃないよ？\nあたしたちも、もっともっと輝こうね♪", "face": "u997"}, {"name": "ケイティ", "text": "最初に「アイドルやりたい」と言い出した時は、\nとうとう過労で、仕事をしながら\n夢を見始めたのかと思ったものでしたが……。", "face": "u114"}, {"name": "ミレイユ", "text": "あら、私はずっと、\nアンナちゃんの歌の魅力に気付いていましたよ？", "face": "u386"}, {"name": "ケイティ", "text": "確かに、歌が上手いのは事実です。\nでもそれを趣味の範囲ではなく、\n兵や民の慰問にも使おうと考えるのは、やはり――", "face": "u114"}, {"name": "クロノシア", "text": "――アンナさんの、人徳、人間性というものでしょう。\n自分にできることがあるなら、\n全力を尽くさずにはいられない、そんな子ですから。", "face": "u1986a1"}, {"name": "フローガ", "text": "あのぉ……ただ、問題は山積みでして。", "face": "u878"}, {"name": "フローガ", "text": "魔術師ギルドで周囲の警戒してますが、\n予想通りあちこちから魔物が接近中です。\nアンナさんの魔物を引き寄せる歌、パないです。", "face": "u878"}, {"name": "ケイティ", "text": "……まぁ、それも込みでのライヴですから。\n周辺の魔物被害を軽減するために、\nどうせならまとめて倒そう、という。", "face": "u114"}, {"name": "アンナ", "text": "――それじゃあ、最初の曲です！\nみんな、アンナについてきて！！", "face": "u606"}, {"name": "ミレイユ", "text": "さぁ魔物の群れが来ますよ。\nアンナちゃんのライヴ、\nしっかり守ってあげましょうね。", "face": "u386"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "みんなー！　ありがとー！！", "face": "u606"}, {"name": "アンナ", "text": "それから、ライヴ会場を守ってくれた皆さんも！\nないすないす、アンないす、です♪", "face": "u606"}, {"name": "ゴブリン", "text": "ギャギャ！　あんなーいす！！", "face": "l86d5a806e375"}, {"name": "フライデーモン", "text": "アンナちゃーん！", "face": "lc531c838f85b"}, {"name": "少女", "text": "ふわぁぁ……アンナちゃん可愛い！\n兵士の人たちもかっこいいなぁ……。", "face": "lb780df329f29"}, {"name": "ケイティ", "text": "……どうやら、ライヴは大成功のようですね。", "face": "u114"}, {"name": "ソーマ", "text": "周辺に棲息する野生の魔物も、\n根こそぎ引き寄せられたようです。\nしばらくは、周辺の村も安全ですね。", "face": "u23"}, {"name": "ソーマ", "text": "あっ、規制退場も始まったようです。\n案内のお手伝いしてきますね。", "face": "u23"}, {"name": "フローガ", "text": "はーい、次はこの２列、立ち上がってくださーい。\n押さないでー、焦らないでー。\n心にいつでもアンナちゃんですよー。", "face": "u878"}, {"name": "フローガ", "text": "はい、進んで進んでーっと、\nおや？　これは……。", "face": "u878"}, {"name": "ケイティ", "text": "何かありましたか？\n忘れ物なら受付に届けないと……。", "face": "u114"}, {"name": "フローガ", "text": "んんん、いえ、これは忘れ物ではなく……。\nほら、見てください。\nこの人形と一緒に、お手紙が。", "face": "u878"}, {"name": "ケイティ", "text": "これは……魔神レラジェの、フィギュア、でしょうか？", "face": "u114"}, {"name": "デーモンシェフ", "text": "むっ……それは魔界の門開通記念に、\n極少数だけ生産された\n魔神レラジェ様フィギュアではないか？", "face": "l015ea23e7faa"}, {"name": "ケイティ", "text": "手紙にはなんと？", "face": "u114"}, {"name": "フローガ", "text": "なになに……「ライヴ、最高でした」と。\nどうやら魔界遠征組からの\nプレゼントみたいですね。", "face": "u878"}, {"name": "ケイティ", "text": "ふふっ、きっと大切なものでしょうに。\nアンナさんも罪な女、ですね？", "face": "u114"}, {"name": "フローガ", "text": "それだけ応援されている、ということですよ。\nさぁて、私は次回のライヴに備えて、\nギルドメンバーと対策会議をしてきますね。", "face": "u878"}, {"name": "ケイティ", "text": "えぇ、よろしくお願いします。\nそれでは私たちは楽屋へ行きましょうか。\nアンナさんをねぎらってあげましょう。", "face": "u114"}]}], "story_talk": true, "active": true}