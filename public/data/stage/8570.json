1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "special_effect_id": 2073, "change_to": 14, "change_condition": 2, "master_id": 38771, "global_id": 12388, "to_condition": 2, "to_global_id": 12389, "spawn_sec": 246}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 2700, "attack": 740, "base_hp": 2700, "base_attack": 740, "damage_type": "physical", "armor_defense": 260, "magic_defense": 40, "attack_speed": 40, "attack_wait": 5, "attack_interval": 67, "move_speed": 2200.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "special_effect_id": 2074, "master_id": 38772, "global_id": 12389, "from_condition": 2}], "popups": ["　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇", "スノースパイダーは\nニ種類の攻撃を交互に行います。\n\nスノースパイダーから\n物理の遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。", "黒い光冠の魔物は倒されると、\nその場で強くなって復活します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アサル", "text": "さ、寒さが強くなってきましたね……。", "face": "u172"}, {"name": "クルル", "text": "大丈夫？\n上着、一枚貸そうか？", "face": "u197"}, {"name": "アサル", "text": "ありがとうございます……くちゅんっ。", "face": "u172"}, {"name": "トレシア", "text": "吹雪いてきそうですね。\nはぐれないように注意してください。", "face": "u2314a1"}, {"name": "アサル", "text": "砂嵐なら慣れているのですが……。", "face": "u172"}, {"name": "クルル", "text": "吹雪を侮ったらだめよ？", "face": "u197"}, {"name": "アサル", "text": "むむむ……はい……。", "face": "u172"}, {"name": "ロヴィサ", "text": "どう、フローガ。\n魔力の乱れは近付いてる？", "face": "u2455a1"}, {"name": "フローガ", "text": "まだもう少し遠く、ですね。\nどれくらいの距離かは判断できません。", "face": "u878"}, {"name": "ロヴィサ", "text": "……遺跡陣地の辺りかしら。", "face": "u2455a1"}, {"name": "トレシア", "text": "遺跡陣地？", "face": "u2314a1"}, {"name": "ロヴィサ", "text": "えぇ。いつの時代かも知れない、\n遺跡を流用して作られた仮の陣地よ。", "face": "u2455a1"}, {"name": "ロヴィサ", "text": "ここからだと、もう少し距離があるわね。", "face": "u2455a1"}, {"name": "トレシア", "text": "周囲を警戒しつつ進みましょう。\nおそらく、吹雪に乗じて魔物が襲ってくるはずです。", "face": "u2314a1"}]}, {"trigger": "battle", "at_sec": 68, "lines": [{"name": "アリア", "text": "――王子、新手が！\nおそらくエンキドゥの配下……仮面の騎士たちです！", "face": "u75"}, {"name": "アトナテス", "text": "上等だ。\n向こうから、正解に近付いてるって\n知らせてくれたようなものだぜ。", "face": "u908"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "吹雪を抜けたようですね……。"}, {"name": "クルル", "text": "あっ、向こうに街が見えてきたよ。\n……街って呼んでいいのか、ちょっと迷うけど。", "face": "u197"}, {"name": "ロヴィサ", "text": "越境要塞を建てる前の、仮の拠点だった場所ですもの。\nすでに吹雪と魔物に破壊されてしまっているはずよ。", "face": "u2455a1"}, {"name": "ズィズィー", "text": "――あっ、王子じゃん。\nかわいいお姫ちゃんもついてるぅー。", "face": "u2456a1"}, {"name": "シビラ", "text": "……お姫ちゃん？", "face": "u39"}, {"name": "ズィズィー", "text": "エっちゃんの所行くんでしょ？\nんー、んんー、どうしようかな。", "face": "u2456a1"}, {"name": "アヴリック", "text": "……何か迷うこと、あります？", "face": "u2443a1"}, {"name": "ズィズィー", "text": "うわ、ブチギレキャノンガールも一緒だ。\nこれは楽しめそう……。", "face": "u2456a1"}, {"name": "ズィズィー", "text": "よし、独り占めはよくないし――\nラシュマシュー！　おーい！\n王子たちが遊ばれてくれるってさー。", "face": "u2456a1"}, {"name": "フィノーラ", "text": "あっ、こら、逃げるな！", "face": "u2441a1"}, {"name": "ロヴィサ", "text": "……遺跡陣地の方へ向かったようね。", "face": "u2455a1"}, {"name": "トレシア", "text": "追いましょう、ロヴィサ！", "face": "u2314a1"}, {"name": "ロヴィサ", "text": "えぇ。貴重な手がかり、ここで捕えるわ。", "face": "u2455a1"}]}], "active": true}