, "master_id": 423, "global_id": 422}], "spawn_sec": 205}, {"enemy_id": 23, "source": "local", "count": 7, "form_count": 1, "tags": ["アーマー"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 296, "master_id": 31084, "global_id": 4703, "spawn_sec": 207}, {"enemy_id": 24, "source": "local", "count": 24, "form_count": 1, "hp": 8000, "attack": 650, "base_hp": 8000, "base_attack": 650, "damage_type": "magical", "armor_defense": 250, "magic_defense": 20, "attack_range": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 51, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2140160, "race_id": 20, "special_effect_id": 232, "missile_id": 45, "master_id": 35350, "global_id": 8967, "ranged": true, "spawn_sec": 262}, {"enemy_id": 25, "source": "local", "count": 2, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103376, "race_id": 8, "change_to": 25, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 442, "global_id": 441, "ranged": true, "to_condition": 3, "to_global_id": 442, "spawn_sec": 314}, {"enemy_id": 25, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 443, "global_id": 442, "ranged": true, "from_condition": 3}, {"enemy_id": 27, "source": "local", "count": 3, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103408, "race_id": 8, "change_to": 27, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 444, "global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "spawn_sec": 320}, {"enemy_id": 27, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}], "popups": ["ルキファは\n一定時間経過するたびに\n攻撃性能を交互に変更します。\n\n\n\n\n　　　　　　(1/2)", "・ルキファの\n一定範囲内のユニットは\n継続ダメージを受けます。\n\n・オーラをまとったルキファは\n継続ダメージが無くなり\n貫通の遠距離攻撃を行います。\n　　　　　　(2/2)", "ダークエルフナイトは\nダメージを受けると\n攻撃したユニットへ反撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ルキファ", "text": "（私の使命とは、魔界の民を守護すること――\n否、違う、亜神ディアス様を守護することだ）", "face": "u1621a1"}, {"name": "ルキファ", "text": "（ならば私は、何のために堕天を――\n否、違う、私は堕ちてなど……）", "face": "u1621a1"}, {"name": "ルキファ", "text": "（――私は、何故、こんなに）", "face": "u1621a1"}, {"name": "ラーワル", "text": "……ルキファ、苦しいんでしょ。\n物質界のために堕天して、\n誰かを守るために戦っていたのにって。", "face": "u1369a1"}, {"name": "アルタ", "text": "お姉さま、もう大丈夫なのですか……？", "face": "u1403a1"}, {"name": "ラーワル", "text": "うん、よく考えたらさ、\n僕らのパパが、そう簡単に負けるはずないしね。\nだから急いで、ここを切り抜けなきゃいけないんだ。", "face": "u1369a1"}, {"name": "ラーワル", "text": "ルキファ、千年戦争の時には、いっぱい喧嘩したよね。\nキミはどう見ても正義の味方なのに、\n頑なに私は悪だって言い張ったりするからさ。", "face": "u1369a1"}, {"name": "ラーワル", "text": "アトにぃともよくぶつかってた。\nふたりとも強情だから、全然会話が噛み合わなくて。", "face": "u1369a1"}, {"name": "アトナテス", "text": "ああ、懐かしいな。\n結局いつも、あいつが仲裁してたっけか。", "face": "u908"}, {"name": "ラーワル", "text": "あはは。\n英雄王じゃなくて、もうただの仲裁役になってたよね。", "face": "u1369a1"}, {"name": "ラーワル", "text": "ルキファ、僕らは、キミを取り戻す。\nこの後には亜神ディアスが待ってるんだ。\nどんなに嫌がっても仲間として戦ってもらう。", "face": "u1369a1"}, {"name": "ラーワル", "text": "キミにも言い分はあるだろうけど！\nそんなに民に慕われてるキミを、\n苦しませたままでいられるもんか！！", "face": "u1369a1"}, {"name": "ルキファ", "text": "……らーわ、る……？\nくっ、あぁぁああッ！　この、記憶は……。\nやめろ……私を惑わすな、ディアス様の敵が……ッ！！", "face": "u1621a1"}, {"name": "ラーワル", "text": "嫌だね！　僕は正義の味方なんだ！\n正義は自分勝手で、誰より傲慢で、\n問答無用で全部救わなきゃなんだから！！", "face": "u1369a1"}]}, {"trigger": "end", "lines": [{"name": "ヘンゼル", "text": "――ルキファ様が、倒れた。\n……今だ、今しかない！\n王子、頼む、ルキファ様の精神支配を解いてくれ！", "face": "u1622a1"}, {"name": "シャルロット", "text": "はっ、急ぎますわよ！\nメーリス、あなたも手伝ってくださいな！", "face": "u128"}, {"name": "メーリス", "text": "わっ、わかった！\n即席で解呪の魔法を組み立てて……。", "face": "u78"}, {"name": "ルキファ", "text": "くっ……あぁぁああッ！！\nわたしに、何を……ッ！？", "face": "u1621a1"}, {"name": "シャルロット", "text": "目覚めの時ですわよ、堕天使さま。\nあなたの逸話は本で何度も読みましたわ。", "face": "u128"}, {"name": "シャルロット", "text": "迷える人々のために、翼を黒く染めた最初の天使。\n施すだけでなく、共に立ち上がる力を与える正義の徒。\n英傑として語られし、黎明を齎す者ルキファ様。", "face": "u128"}, {"name": "メーリス", "text": "そんなすごい人を、\n支配されっぱなしになんてできないよね。\nさぁ、最後の術式を破壊するよ！", "face": "u78"}, {"name": "ルキファ", "text": "――わ、たしは……ここは……。", "face": "u1621a1"}, {"name": "ヘンゼル", "text": "ルキファ様、よかった……！\nありがとう、王子、シャルロットさん、メーリスさん……。", "face": "u1622a1"}, {"name": "ルキファ", "text": "何故、泣いている……。\n汝は……妹と再会するまで、泣かぬと言っていただろう。", "face": "u1621a1"}, {"name": "ヘンゼル", "text": "……良いんです、今は。\n恩人が、帰ってきてくれたのですから……。", "face": "u1622a1"}, {"name": "ルキファ", "text": "――おぉ、そういうことか。\n妹が、見つかったのだな？", "face": "u1621a1"}, {"name": "ヘンゼル", "text": "はっ、いえ、妹は随分と昔に、\n物質界へ逃げ延びさせたので……。\nこんな所で会えるはずが――", "face": "u1622a1"}, {"name": "ルキファ", "text": "…………む。\nでは、そこの娘は妹ではないのか？\nラーワル、そこの娘を連れてくるがよい。", "face": "u1621a1"}, {"name": "ラーワル", "text": "はっ、えっ？　どの子？\nグレーテルちゃんのこと？", "face": "u1369a1"}, {"name": "グレーテル", "text": "…………えっ？", "face": "u365"}, {"name": "ヘンゼル", "text": "……まさか、グレーテルがここに……？\nいや、そうだ、確かに面影がある……。", "face": "u1622a1"}, {"name": "グレーテル", "text": "へん、ぜる、おにいちゃん……？", "face": "u365"}, {"name": "ヘンゼル", "text": "ああ、グレーテル……。\nよかった、また、きみに会えるなんて……。", "face": "u1622a1"}, {"name": "ルキファ", "text": "ふふ、また悪行をなしてしまったな。\n兄妹を再会させてしまうとは。", "face": "u1621a1"}, {"name": "ルキファ", "text": "さて……誰か、状況を説明してくれまいか。\nどうやら、随分と大きな借りを作ってしまったようだからな。", "face": "u1621a1"}]}], "active": true}