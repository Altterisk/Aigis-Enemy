{"quest_id": 7768, "name": "黎明の訪れ", "description": "魔界の民を救うべく王子たちの前に\nルキファが姿を現す。伝説の堕天使を\n打ち破り精神支配から解放せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "千の誓い、千の約束", "event_category": "History", "mission_id": 920184, "map_no": 4170, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 68000, "attack": 1750, "base_hp": 68000, "base_attack": 1750, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 10, "attack_wait": 20, "attack_interval": 89, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2140064, "race_id": 6, "special_effect_id": 1165, "change_to": 1, "master_id": 35342, "global_id": 8959, "to_global_id": 8960, "to_flag": [0, 1], "route_behaviour": {"transforms": [{"val": 1}, {"flag": 1, "val": 1}, {"flag": 2, "val": 1}, {"flag": 3, "val": 1}, {"flag": 4, "val": 1}, {"flag": 5, "val": 1}, {"flag": 6, "val": 1}, {"flag": 7, "val": 1}, {"flag": 8, "val": 1}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 68000, "attack": 1050, "base_hp": 68000, "base_attack": 1050, "damage_type": "true", "armor_defense": 250, "magic_defense": 50, "attack_range": 200, "attack_speed": 10, "attack_wait": 20, "attack_interval": 79, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2140080, "race_id": 6, "special_effect_id": 1169, "missile_id": 533, "missile": {"speed": 12.0}, "master_id": 35343, "global_id": 8960, "ranged": true, "from_flag": [0, 1]}, {"enemy_id": 3, "source": "local", "count": 7, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_r