effect_id": 222, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 30708, "global_id": 4327, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 350, "base_hp": 6000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112784, "race_id": 4, "special_effect_id": 54, "master_id": 30706, "global_id": 4325, "route_behaviour": {"sets_flags": [[1, 1, 0], [1, 0, 0]]}, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 4}, {"enemy_id": 5, "source": "local", "count": 17, "form_count": 2, "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104272, "race_id": 14, "change_to": 5, "master_id": 517, "global_id": 516, "to_global_id": 517, "route_behaviour": {"transforms": [{"wait": 3560}]}, "spawn_sec": 11}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 105, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104320, "race_id": 14, "change_to": 4, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 518, "global_id": 517, "ranged": true}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 22}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 76}], "dialogue": [{"trigger": "start", "lines": [{"name": "ナタク", "text": "もうじき華の国だ。\n堕姫と王子も近くにいるはずだよ。\nみんな、山道続きで疲れてないかい？", "face": "u297"}, {"name": "モーティマ", "text": "ゼエッ、ゼエッ……。\nクソッ……あの女、なんつー体力だ。", "face": "u14"}, {"name": "ダニエラ", "text": "っていうより、浮いてるから\n山道でも関係ないんでしょうね。\nはぁ……仙人って羨ましいわぁ。", "face": "u43"}, {"name": "バシラ", "text": "あれ？　あの洞くつの手前で\nお弁当を広げてる二人って……。", "face": "u28"}, {"name": "アンナ", "text": "――あれは！\n王子と堕姫さんではないですか！", "face": "lfd3f42c51a24"}, {"name": "堕姫", "text": "んむっ！？　おぬしら、何故ここに！？", "face": "u547"}, {"name": "ケイティ", "text": "判りきったことを……。\n早く王子を返しなさい！", "face": "u114"}, {"name": "堕姫", "text": "……ふん、嫌じゃ。\nわらわと王子の新婚旅行を邪魔しおって。", "face": "u547"}, {"name": "ユリアン", "text": "……新婚旅行？\n邪仙どもに王子を引き渡すつもりじゃねえのかよ？", "face": "u7"}, {"name": "堕姫", "text": "誰が邪仙になど渡すか！\n王子は一生わらわと共に暮らすのじゃ！\nのう、王子？", "face": "u547"}, {"name": "王子", "text": "…………（こくり）。", "face": "u1"}, {"name": "アンナ", "text": "王子……。", "face": "l5822f73cad14"}, {"name": "堕姫", "text": "さぁて、話は終わりじゃ。\nゆけ、獣ども！　わらわと王子の愛を邪魔する\n目障りな人間どもを蹴散らすのじゃ！", "face": "u547"}]}, {"trigger": "end", "lines": [{"name": "ユリアン", "text": "ここまでだな、堕姫。", "face": "u7"}, {"name": "堕姫", "text": "う……うわ～～～～ん！\n王子ぃぃ～ッ！　この男がいじめるのじゃ～！", "face": "u547"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ユリアン", "text": "……なぁ、どうしちまったんだよ王子？\nどうしてこんな女狐なんかを庇うんだ？\n俺の声が聞こえてねえわけじゃねーんだろ？", "face": "u7"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ユリアン", "text": "……そうかよ。\n仲間に剣を向けてまで守りてえほど、\nあの女狐が大事だっつーんだな？", "face": "u7"}, {"name": "アンナ", "text": "ゆ、ユリアンさん、落ち着いてください。\n……って、あら？　堕姫さんは？", "face": "lfd3f42c51a24"}, {"name": "堕姫", "text": "お～い、王子～っ！\nわらわはもう大丈夫じゃぞ～っ！\n王子も早くこっちに来るのじゃ～っ！", "face": "u547"}, {"name": "ケイティ", "text": "くっ……いつの間にあんな遠くに！", "face": "u114"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "あっ！　待ってください、王子――", "face": "lfd3f42c51a24"}, {"name": "ナタク", "text": "――無駄だよ、アンナ。\n気づいているんだろう？　\n術が解けない限り、王子を捕まえても意味ないって。", "face": "u297"}, {"name": "アンナ", "text": "それは、そうですけど……。", "face": "l5822f73cad14"}, {"name": "ナタク", "text": "心配いらないさ。\n堕姫は王子を邪仙に渡さないって言ってるわけだし、\n彼に危害を加えるつもりもなさそうだしね。", "face": "u297"}, {"name": "ナタク", "text": "今は地道に赤い彼岸花を集めながら機会を窺おう。\n王子を助け出すための好機は、じきに訪れるさ。", "face": "u297"}]}], "active": true}