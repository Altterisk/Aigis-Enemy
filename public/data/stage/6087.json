2}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101760, "race_id": 16, "special_effect_id": 54, "master_id": 30214, "global_id": 3833, "spawn_sec": 3}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 500, "base_hp": 7000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109776, "race_id": 12, "special_effect_id": 145, "master_id": 30213, "global_id": 3832, "spawn_sec": 4}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 2, "attack_interval": 32, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109744, "race_id": 8, "special_effect_id": 54, "master_id": 30227, "global_id": 3846, "spawn_sec": 8}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 4500, "attack": 150, "base_hp": 4500, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105584, "missile_id": 152, "missile": {"speed": 6.0, "splash": 133}, "master_id": 702, "global_id": 701, "ranged": true, "spawn_sec": 10}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 2, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 8, "change_condition": 5, "master_id": 778, "global_id": 777, "to_condition": 5, "to_global_id": 778, "spawn_sec": 74}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 779, "global_id": 778, "ranged": true, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "ケイティ", "text": "良かった。皆さん今日もここで\n修行されてたのですね。", "face": "u114"}, {"name": "ジーナ", "text": "お？　王子達がここに来るなんて\n珍しいじゃない。どうかしたの？", "face": "u1131"}, {"name": "ケイティ", "text": "それがですね、ベストラさんが\nジーナさん達の修行を見たいと仰られるもので。\nここまで案内してきたのです。", "face": "u114"}, {"name": "ベストラ", "text": "無理を言ってすみません。格闘家の皆さんが\n過酷な修行を行っていると聞き、\nどうしても気になったもので……。", "face": "u474"}, {"name": "ダン", "text": "あぁあんたか。話は聞いてるぜ、\nオークにしては珍しく\n冷静で良い奴なんだってな。", "face": "u204"}, {"name": "ベストラ", "text": "れ、冷静で良い奴……オーク族としては\n素直には喜べない評価です……。\n怒りを力に変えたいのに……。", "face": "u474"}, {"name": "アンナ", "text": "それにしても、本当に熱い地ですね。\nどんどん体力が奪われてしまいます……。\nなにもこんなところで訓練しなくても……。", "face": "l249c9d29b57c"}, {"name": "ウル", "text": "こんな所だからこそ、磨ける力もあるんだよっ！\nあたし達のラッシュは、ここで\n闘志を燃やす修行をしてこそ出せるんだから！", "face": "u1162"}, {"name": "ベストラ", "text": "「闘志」……ですか。", "face": "u474"}, {"name": "ダン", "text": "そうだ。ここの溶岩地帯では、\n体力が徐々に奪われていっちまう。", "face": "u204"}, {"name": "ジーナ", "text": "少しでも気を抜くと、あっという間に\n命が奪われる……ギリギリの命のやりとりは、\n心を強くするわよ！", "face": "u1131"}, {"name": "ベストラ", "text": "望むところです！\n（闘志……私に足りないものは\nそれなのかも……！）", "face": "u474"}, {"name": "ウル", "text": "そうだ！　折角きたんだし、王子も\n特訓に付き合って行ってよ。熱さで倒れないよう\nくれぐれも気を付けてね！　それじゃ、行っくよー！", "face": "u1162"}]}, {"trigger": "end", "lines": [{"name": "ベストラ", "text": "……くっ、なんという熱気……\nこれ以上は体が…………！", "face": "u474"}, {"name": "ウル", "text": "まだまだだよ！　ベストラの力は\nそんなもんじゃないはずだよ！\n", "face": "u1162"}, {"name": "ベストラ", "text": "く……！　ここでくじけちゃダメだ……！\n絶対に……！　\nううぅおおおおおおおっ！！", "face": "u474"}, {"name": "ベストラ", "text": "………！", "face": "u1474"}, {"name": "ダン", "text": "す、すげぇ……なんつー闘志だ。\nこれが……！", "face": "u204"}, {"name": "ジーナ", "text": "追い詰められてからの底力……\nオークの本領発揮って所ね！", "face": "u1131"}, {"name": "ベストラ", "text": "凄い。力が湧いてくるようだ。\nこれなら……あのアナトリアにも……！\nはぁあぁぁぁあああああっ！！", "face": "u1474"}, {"name": "ベストラ", "text": "ああああああ……あ……ぁ………………。", "face": "u474"}, {"name": "ウル", "text": "ありゃ、闘志が消えていっちゃった。", "face": "u1162"}, {"name": "アンナ", "text": "ベストラさん、限界だったのでしょう。\n……ですが最後の気迫、凄まじいものでしたね。\n私にも闘志の凄さが伝わってきましたよ。", "face": "l03108ff2f9a4"}, {"name": "アンナ", "text": "気を失われてしまったみたいですし、\nこのままにしておく訳にも参りません。\n一度涼める場所へと移動しましょうか。", "face": "l03108ff2f9a4"}]}], "active": true}