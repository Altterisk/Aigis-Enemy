hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109328, "race_id": 6, "special_effect_id": 232, "change_to": 10, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30177, "global_id": 3796, "ranged": true, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 111}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107568, "race_id": 6, "master_id": 872, "global_id": 871, "spawn_sec": 124}, {"enemy_id": 5, "source": "local", "count": 12, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 126}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107024, "race_id": 6, "master_id": 697, "global_id": 696, "spawn_sec": 155}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 13, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 400}]}, "spawn_sec": 156}], "popups": ["ケラウノスは拠点には\n向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "この辺りでしょうか。\n巨人の報告があったのは。", "face": "l4680010083c3"}, {"name": "ニエル", "text": "報告ではこの辺りみたいだけど。\n……上空から見回してみた限りじゃ、\n巨人の姿は見当たらなかったよ。", "face": "u206"}, {"name": "モーティマ", "text": "あんだけでけぇ連中、いれば\nすぐ判りそうなもんだしなぁ\n既に移動しちまったんじゃねーか。", "face": "u14"}, {"name": "アンナ", "text": "そうかもしれませんね。\n……！　皆さん、あちらを！", "face": "l4680010083c3"}]}, {"trigger": "start", "lines": [{"name": "ケラウノス", "text": "――全く、このような所にまで来るとは。\nここは神聖なる神の領域、お前達人間が\n土足で踏み入ってよい場所ではありませんよ。", "face": "l4241f65f1182"}, {"name": "ニエル", "text": "……ケラウノス様！", "face": "u206"}, {"name": "ケラウノス", "text": "粗暴な巨人族の連中が復活したようなので、\n物質界に降りてみましたが……巨人族より先に、\nまずは貴方達の戦力でも削っておきましょうか。", "face": "l4241f65f1182"}, {"name": "ケラウノス", "text": "来なさい、荘厳なる神のしもべ達よ。", "face": "l4241f65f1182"}]}, {"trigger": "battle", "at_sec": 53, "lines": [{"name": "モーティマ", "text": "げ、げげぇっ！？　巨人族！？", "face": "u14"}, {"name": "ケイティ", "text": "あれは……巨人族とケラウノスが\n手を組んだという事でしょうか。", "face": "u114"}, {"name": "ニエル", "text": "……いや、あれは巨人族なんかじゃないよ。", "face": "u206"}, {"name": "ケラウノス", "text": "ふふ。これは神の創造物が一つ、天使像。\n地上を滅ぼすための破壊の権化。巨人族と\n同列に語るとは、本当に愚かな者達ですね。", "face": "l4241f65f1182"}, {"name": "モーティマ", "text": "けっ、どっちにしろぶっ倒さなきゃ\nいけねー事には代わりねーんだろ！", "face": "u14"}, {"name": "ケラウノス", "text": "抵抗をやめてしまえば、楽に滅ぼしてあげますよ。\n……まぁ、貴方達には幾ら説いても無駄でしょうが。\nさぁ、愚かな人間達に裁きを与えるのです。", "face": "l4241f65f1182"}, {"name": "ケイティ", "text": "やはり……戦うしかないようですね！", "face": "u114"}, {"name": "ニエル", "text": "みんな、天使像は巨人達にも劣らない\n強力な攻撃力を持っている。気を付けて。", "face": "u206"}, {"name": "ニエル", "text": "それに、剣や矢の攻撃程度じゃ\n傷をつけるのも難しい。\n魔法での攻撃を心掛けた方が良いと思うよ！", "face": "u206"}, {"name": "アンナ", "text": "ニエルさん、ありがとうございます。\n王子、適切なご指示をお願いします。\nどうかお気をつけて。", "face": "l4680010083c3"}]}, {"trigger": "end", "lines": [{"name": "モーティマ", "text": "ぜぇ……ぜぇ……な、なんでぇ！　\n全然、大したこと、ねぇじゃ、ねぇかっ！！", "face": "u14"}, {"name": "ケイティ", "text": "何とか、敵は退ける事が出来たようですね……。", "face": "u114"}, {"name": "アンナ", "text": "皆さんご無事で何よりです。\n……それにしても、ケラウノス様はこの場で\n一体何をしていたのでしょうか。", "face": "l4680010083c3"}, {"name": "ニエル", "text": "多分、天使像を呼び出す\n準備をしていたんじゃないかな。", "face": "u206"}, {"name": "ニエル", "text": "この場所……昔は天使の降臨の儀に\n使われていたんだと思う。だいぶ昔の建造物だけど、\nまだ微かにその力が残っていたのかもしれない。", "face": "u206"}, {"name": "ケイティ", "text": "その力を利用し、\n天使像を沢山呼び出したと……。", "face": "u114"}, {"name": "ニエル", "text": "うん。巨人族と天界は、\n昔から敵対していたから。彼らと戦う\n戦力にしようとしてたんじゃないかな。", "face": "u206"}, {"name": "ケイティ", "text": "敵の敵は味方……とは\nなってくれそうにはないですね。", "face": "u114"}, {"name": "アンナ", "text": "そうですね……巨人族に天使像。\nまた新たな脅威が増えたようにも思えますが……", "face": "l4680010083c3"}, {"name": "アンナ", "text": "……ですが、私達は負ける訳にはいきません。\n王子、今は休み今後の戦いに備えましょう！", "face": "l4680010083c3"}]}], "active": true}