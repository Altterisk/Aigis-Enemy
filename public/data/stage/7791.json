0, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 95}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 13000, "attack": 5800, "base_hp": 13000, "base_attack": 5800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 30, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108128, "race_id": 16, "special_effect_id": 54, "master_id": 994, "global_id": 993, "spawn_sec": 110}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 177}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 180, "attack_wait": 40, "attack_interval": 403, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099632, "race_id": 16, "special_effect_id": 222, "master_id": 182, "global_id": 181, "spawn_sec": 212}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "attack_speed": 40, "attack_wait": 10, "attack_interval": 142, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097920, "race_id": 16, "special_effect_id": 222, "master_id": 30689, "global_id": 4308, "spawn_sec": 215}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー"], "hp": 16000, "attack": 500, "base_hp": 16000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 240, "attack_speed": 1, "attack_wait": 30, "attack_interval": 101, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135632, "race_id": 16, "special_effect_id": 1189, "change_to": 9, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 35533, "global_id": 9150, "ranged": true, "to_global_id": 9151, "spawn_sec": 218}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 16000, "attack": 500, "base_hp": 16000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 240, "attack_speed": 1, "attack_wait": 30, "attack_interval": 101, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135632, "race_id": 16, "special_effect_id": 1190, "change_to": 8, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 35534, "global_id": 9151, "ranged": true}], "popups": ["鬼刃衆は一定確率で\n物理攻撃を回避します。", "アスラハがいる間は\n全ての敵の防御が\n固定値で150アップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "（ワクワクドキドキ）", "face": "l7318f2ffc1b6"}, {"name": "シロガネ", "text": "……えー、続きましては筋肉と質量のお時間です。", "face": "u1657a1"}, {"name": "シロガネ", "text": "まずはこの方、一目で分かるぞダイナマイトボディ。\n王国の誇る鉄壁の二枚看板が一人、鉄腕乙女ディーネ！", "face": "u1657a1"}, {"name": "シロガネ", "text": "ここでディーネさんには特別に、\n王国在住の女の子からお手紙を預かっています。\nどうすればディーネさんみたいに大きくなれますか？", "face": "u1657a1"}, {"name": "ディーネ", "text": "え！？　えっと、よく食べて、よく眠る。\nあとは……妹のマッサージ、でしょうか？", "face": "u223"}, {"name": "シロガネ", "text": "ディーネさん、ありがとうございます。\nそれでは続けまして、妹さんのご登場です。\n目を疑う光景がそこにはある、怪力少女ディーナ！", "face": "u1657a1"}, {"name": "シロガネ", "text": "ディーナさんには叡智の園からのお便りです。\n『物理法則って知ってます？』とのことですが。", "face": "u1657a1"}, {"name": "ディーナ", "text": "なにそれ？", "face": "u22"}, {"name": "シロガネ", "text": "知らないそうなので次に参ります。\n砂漠の国における最優の騎士とは誰か、\nそれは彼女を措いて他にはいないでしょう。", "face": "u1657a1"}, {"name": "シロガネ", "text": "熱砂の騎士、アスラハ！\n現在大絶賛お友達募集中！", "face": "u1657a1"}, {"name": "アスラハ", "text": "おい言うなそれを！？", "face": "u1427a1"}, {"name": "アスラハ", "text": "……こほん、折角の摸擬戦演武ではあるが、\nこの三人が集まって普通にやるのも芸がない。", "face": "u1427a1"}, {"name": "ディーネ", "text": "そうですね、観客席にも力自慢さんがたくさんです。\n技どうこうは、あまり期待されてないように思います。", "face": "u223"}, {"name": "アスラハ", "text": "聞け者共！　これよりこの場のルールを説明する！", "face": "u1427a1"}, {"name": "重装歩兵A", "text": "……ごくり。", "face": "u65"}, {"name": "ディーナ", "text": "正面から殴り合って最後に立ってたやつが優勝だー！", "face": "u22"}, {"name": "重装歩兵B", "text": "うぉおおおおおおおおおおおッ！！", "face": "u69"}, {"name": "シロガネ", "text": "暑苦し──ではなく、摸擬戦演武、開始です。", "face": "u1657a1"}]}, {"trigger": "end", "lines": [{"name": "オーク", "text": "ふはははは！　負けた！　盛大に負けたぞ！\nこれほどまでに清々しい気分は久しぶりだ！", "face": "l7318f2ffc1b6"}, {"name": "重装歩兵A", "text": "き、筋肉が悲鳴を上げている……！", "face": "u65"}, {"name": "ディーネ", "text": "確かに……ちょっとはしゃぎすぎましたかね？", "face": "u223"}, {"name": "ディーナ", "text": "大丈夫、私がマッサージする！", "face": "u22"}, {"name": "ディーネ", "text": "ふぁあああ～～♪", "face": "u223"}, {"name": "重装歩兵A", "text": "──ッ！？　わっ、我々も！", "face": "u65"}, {"name": "アスラハ", "text": "馬鹿言うんじゃない、美しき姉妹愛を汚すな。", "face": "u1427a1"}, {"name": "重装歩兵B", "text": "アスラハ殿ー！　ぜひ自分とお友達にー！", "face": "u69"}, {"name": "アスラハ", "text": "やかましい！　防御力を上げて出直せ！", "face": "u1427a1"}, {"name": "ディーナ", "text": "アスラハー！　お前もマッサージだ！", "face": "u22"}, {"name": "アスラハ", "text": "なっ、ちょっ──ふぁあああ～～♪", "face": "u1427a1"}, {"name": "重装歩兵B", "text": "…………よいものを見た。", "face": "u69"}, {"name": "シロガネ", "text": "はいはい、さっさと次行くっすよ。", "face": "u1657a1"}]}], "active": true}