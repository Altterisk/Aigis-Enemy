{"speed": 8.0}, "master_id": 31912, "global_id": 5531, "to_global_id": 5532, "spawn_sec": 83}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 4, "special_effect_id": 415, "change_to": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31913, "global_id": 5532, "ranged": true, "to_global_id": 5533}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 9000, "attack": 450, "base_hp": 9000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 10, "master_id": 31914, "global_id": 5533, "to_global_id": 5534}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31915, "global_id": 5534, "ranged": true}, {"enemy_id": 12, "source": "local", "count": 4, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "change_to": 12, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31916, "global_id": 5535, "to_global_id": 5536, "spawn_sec": 97}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 6000.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2101616, "race_id": 4, "special_effect_id": 415, "change_to": 13, "master_id": 31917, "global_id": 5536, "to_global_id": 5537}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 14, "master_id": 31918, "global_id": 5537, "to_global_id": 5538}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 6000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2101616, "race_id": 16, "master_id": 31919, "global_id": 5538}], "dialogue": [{"trigger": "start", "lines": [{"name": "マオ", "text": "――なるほど、他人に化ける術を得意とする妖怪ですか。", "face": "u867"}, {"name": "ホムラ", "text": "ああ。たぬきはたぬきでも、\n変化の術を身に着けた妖怪たぬきってことさ。", "face": "u739"}, {"name": "サイゾウ", "text": "妖狸の伝承は拙者も聞いたことが。\nいわく、かつては諜報といえば\n忍者か妖狸かと並び称されていたのだとか。", "face": "u237"}, {"name": "カナメ", "text": "……情報収集にかけては、忍者に匹敵する。\n変身して……何処にでも潜入できる……。\nその力を買われ……東の国に仕えていた時代もある……。", "face": "u314"}, {"name": "サイゾウ", "text": "されど、彼らは元来争いを好まない種族のはず。\nそれが人里に襲撃してくるとは……。", "face": "u237"}, {"name": "ケイティ？", "text": "きっと、何か事情があったぽん。\n今は彼らの後を追うしかないぽん。", "face": "u114"}, {"name": "マオ", "text": "そうですね……。\nって、ケイティさん妖狸さんの真似ですか？\nふふっ、ちょっと可愛いですね♪", "face": "u867"}, {"name": "ケイティ？", "text": "ぽんっ♪　可愛いぽん？\nこの子に化けて正解だったぽん♪", "face": "u114"}, {"name": "カナメ", "text": "……マオ、そいつはケイティじゃない。\nケイティは後方で、兵に指示を出していたはず。", "face": "u314"}, {"name": "マオ", "text": "な、なんですってー！？\nケイティさんに化けるなんて……。\n正体を現しなさい……ッ！！", "face": "u867"}, {"name": "妖狸ケイティ", "text": "バレちゃったぽん……！！\nでもここまで来たら想定通りぽん。\n皆、王国軍の実力を確かめるぽん……！！", "face": "u114"}, {"name": "マオ", "text": "王子、もう囲まれてます……！！\n妖狸さんは姿を変えて襲ってくるはずです。\n隠れやすそうな木の陰には注意してくださいね……！！", "face": "u867"}, {"name": "サイゾウ", "text": "あるいは変化の術を使う前に倒すのも策のひとつ。\n完全にではないとはいえ、\n変身した相手の能力を真似る術は脅威かと……！", "face": "u237"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "やややー！　参りました！　このとおり！\nご無礼をお許しくだされぽんー！", "face": "u1019a1"}, {"name": "マオ", "text": "まったく、最初からそうやって\n話してくれれば良いんです。\nいったいどうして村を襲ったんですか？", "face": "u867"}, {"name": "？？？", "text": "たぬぬぬ……。\n実はボクさま達の里に、\n鬼の軍団が攻めてきたのですぽん。", "face": "u1019a1"}, {"name": "？？？", "text": "ボクさま達は助けを呼ぶために、\n必死で王国に走ったんだぽん……。", "face": "u1019a1"}, {"name": "マオ", "text": "鬼の軍団……。\nもしかして、大嶽丸の軍団が、\n妖狸さん達の里に攻め込んだんですか？", "face": "u867"}, {"name": "？？？", "text": "いやはやー、ボクさまは\nおーたけまるの姿を見たことがないから、\nそこは何とも言えないぽん……。", "face": "u1019a1"}, {"name": "？？？", "text": "ただ鬼の軍勢が、\nちょっと尋常じゃない規模なのは確かぽん！\n鬼総出で何かを探しているみたいだぽん！", "face": "u1019a1"}, {"name": "サイゾウ", "text": "……人里に降りてきた魔物も、\n鬼の軍勢を恐れて逃げてきたのかもしれませんな。\nして、我らを襲ったのはなにゆえでしょう？", "face": "u237"}, {"name": "？？？", "text": "あの鬼どもの強さは、身を以て知っているぽん。\n生半可な実力の者に助けを求めては、\nその者達が返り討ちにあってしまうかもしれないぽん。", "face": "u1019a1"}, {"name": "？？？", "text": "だから、里からどうにか逃げ延びた者達で、\n噂に名高い王国軍の力を試すべく、\n一芝居打ったというわけだぽん。", "face": "u1019a1"}, {"name": "マオ", "text": "……なるほど、私達を心配してのことだったんですね。\nでも、もう心配はいりません。\nそうですよね、王子？", "face": "u867"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "？？？", "text": "ぽん……っ！！\nたぬぬぬ……なんたる心の広いお人かぽん！", "face": "u1019a1"}, {"name": "たぬきの里の長", "text": "申し遅れましたぽん！\nボクさまは妖狸の里の長をしているたぬきだぽん！\nさぁ美しき武闘家さま、王子さま、こちらですぽん……！！", "face": "u1019a1"}, {"name": "マオ", "text": "う、美しき武闘家……！？\nって感激している場合じゃなかったですねっ！\n王子、急いで森の奥へ向かいましょう！", "face": "u867"}]}], "active": true}