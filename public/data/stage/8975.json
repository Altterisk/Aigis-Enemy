"attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112592, "missile_id": 11, "master_id": 30697, "global_id": 4316, "ranged": true, "spawn_sec": 101}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "tags": ["スライム"], "hp": 1600, "attack": 300, "base_hp": 1600, "base_attack": 300, "damage_type": "magical", "armor_defense": 1600, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097296, "master_id": 22, "global_id": 21, "spawn_sec": 113}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "tags": ["スライム"], "hp": 8500, "attack": 580, "base_hp": 8500, "base_attack": 580, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158528, "change_to": 13, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38493, "global_id": 12110, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 8500, "attack": 1050, "base_hp": 8500, "base_attack": 1050, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158544, "master_id": 38494, "global_id": 12111}], "spawn_sec": 130}, {"enemy_id": 15, "source": "local", "count": 6, "form_count": 1, "tags": ["スライム"], "hp": 30000, "attack": 800, "base_hp": 30000, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 60, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112608, "missile_id": 11, "master_id": 30698, "global_id": 4317, "ranged": true, "spawn_sec": 152}, {"enemy_id": 16, "source": "local", "count": 8, "form_count": 1, "hp": 4000, "attack": 800, "base_hp": 4000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 120, "attack_wait": 45, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2171280, "special_effect_id": 2464, "master_id": 40811, "spawn_sec": 176}], "popups": ["スライム増産装置がある間\n全ての敵のHPが徐々に回復します。\n\n倒さなくても★の評価には\n影響しません。", "自爆スライムは自爆して、\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レミィ", "text": "――ようやく追いついたわよ！", "face": "u2837a1"}, {"name": "水着スライム", "text": "うぅ……どこにも逃げ場がない……！\nもう駄目だぁ……死ぬしかないんだぁ……！", "face": "l2f12797896ef"}, {"name": "ヴィディア", "text": "君に手荒な真似をするつもりはない。\n事が事だから、罰として後始末に協力してもらいはするが、\nなにも命を取ろうだなんて考えてはないとも。", "face": "u2841a1"}, {"name": "イムラウ", "text": "そもそもだけど、あなたはどうしてこんなことをしたの？", "face": "u2842a1"}, {"name": "水着スライム", "text": "……海で泳ぎたかったから。", "face": "l2f12797896ef"}, {"name": "ハリンヘイム", "text": "なんですかその理由は……。", "face": "u2839a1"}, {"name": "水着スライム", "text": "くだらないって思ったでしょ？\nでもね、私たちは海で泳げないのよ。", "face": "l2f12797896ef"}, {"name": "水着スライム", "text": "私たちの身体はスライムだから、\n海水に触れると水分が抜けてしなしなになったり、\n変な溶け方をしてドロドロになったりするの。", "face": "l2f12797896ef"}, {"name": "水着スライム", "text": "だけど私は、人間みたいに普通に海水浴を楽しみたかった。\nそのためには海水そのものを変える必要があって……。", "face": "l2f12797896ef"}, {"name": "太上老君", "text": "……それで、ローパー博士から装置を盗んだわけか。", "face": "u2838a1"}, {"name": "水着スライム", "text": "スライムの海なら、私たちの身体も溶けたりしないから。", "face": "l2f12797896ef"}, {"name": "水着スライム", "text": "だけど……まさか、こんなことになるなんて……。", "face": "l2f12797896ef"}, {"name": "ヘイズル", "text": "どうやらこの規模の被害が出るとは\n想像できなかったみたいだね。", "face": "u2836a1"}, {"name": "クーコ", "text": "ローパー博士の発明品は、\n思っていたよりも高性能だったってことなのかな。", "face": "u2837a1"}, {"name": "水着スライム", "text": "うん……私、色んな人に迷惑をかけちゃった。", "face": "l2f12797896ef"}, {"name": "水着スライム", "text": "でも、だからこそ……もう、ね？\n行くところまで行っちゃうしかないのかなって。", "face": "l2f12797896ef"}, {"name": "太上老君", "text": "おっと、なんだか雲行きが怪しくなってきたね？", "face": "u2838a1"}, {"name": "水着スライム", "text": "どうせ私は悪いスライムなんだから！\nじゃあとことん悪くなっちゃうよ！", "face": "l2f12797896ef"}, {"name": "水着スライム", "text": "ずっとずっとスライムの海の中で、\n海水浴をしちゃうんだからー！！", "face": "l2f12797896ef"}, {"name": "ヘイズル", "text": "この子は良心の呵責に耐えられなかったんだろうね。\nそのせいで、やけくそになってしまっているみたいだ。", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "ならば、私たちで止めてあげましょう。\nこのままでは、誰も幸せにはなりませんから。", "face": "u2835a1"}]}, {"trigger": "end", "lines": [{"name": "水着スライム", "text": "きゅう……。", "face": "l2f12797896ef"}, {"name": "クーコ", "text": "なんとか落ち着かせることができたみたいね。", "face": "u2837a1"}, {"name": "水着スライム", "text": "うぅ、迷惑をかけて、ごめんなさい……。", "face": "l2f12797896ef"}, {"name": "ヴィディア", "text": "まぁまぁ、そんな縮こまらないでくれ。\n今回の件は事故みたいなものだったのだろう？", "face": "u2841a1"}, {"name": "ヴィディア", "text": "装置一つで海一帯がスライムになるなんて、\n分かるはずがないのだから。", "face": "u2841a1"}, {"name": "いつの間にかついてきてたローパー博士", "text": "このような事故が起きないように、\n次からは説明書を付けておきますね。", "face": "lca0a1294f2b4"}, {"name": "ハリンヘイム", "text": "いつの間にかついてきていた博士は黙っててください。", "face": "u2839a1"}, {"name": "水着スライム", "text": "……本当にごめんなさい。\n償いになるかは分からないけど……装置はもう、止めるね。", "face": "l2f12797896ef"}, {"name": "水着スライム", "text": "そうしたらきっと、海は元に戻るはずだから。", "face": "l2f12797896ef"}, {"name": "ヴィディア", "text": "ああ、そうしてくれ。", "face": "u2841a1"}, {"name": "イムラウ", "text": "これで全部解決かな……？", "face": "u2842a1"}, {"name": "アブグルント", "text": "……いいえ、そういうわけにはいかないみたいよ？", "face": "u2840a1"}, {"name": "ダグマール", "text": "それはどういう――", "face": "u2843a1"}, {"name": "水着スライム", "text": "――た、助けて！　装置が暴走しちゃってる！！", "face": "l2f12797896ef"}]}]}