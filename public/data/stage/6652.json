age_type": "physical", "armor_defense": 80, "magic_defense": 10, "attack_range": 260, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106288, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 799, "global_id": 798, "ranged": true, "spawn_sec": 116}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 1, "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_range": 140, "attack_speed": 80, "attack_wait": 60, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101408, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 299, "global_id": 298, "ranged": true, "spawn_sec": 129}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 260, "attack_speed": 70, "attack_wait": 60, "attack_interval": 162, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2103808, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 338, "global_id": 337, "ranged": true, "spawn_sec": 188}], "dialogue": [{"trigger": "start", "lines": [{"name": "エレイン", "text": "――ようやくここまで来たようね。", "face": "u36"}, {"name": "ミゲル", "text": "へへっ、雪の中でも騎兵は戦えるってとこ、\n王子の兄貴に見せてやらなくちゃな。", "face": "u369"}, {"name": "サラサ", "text": "そもそも、私は雪の中の方が専門だしね。\nサンタクロースの一族の力、\n見せてあげちゃうわ♪", "face": "u317"}, {"name": "ケイティ", "text": "さて王子、次は騎兵の皆さんが相手です。\n雪の中とはいえ、機動力の高さはあなどれません。", "face": "u114"}, {"name": "シプリア", "text": "あっちが機動力ならこっちも機動力かな。\nよし、私は王子の側に付いてあげよう。", "face": "u1565"}, {"name": "イーリス", "text": "……あれ？　人質役なのに、\nお姉ちゃんの姿が見当たりませんね……。", "face": "u31"}, {"name": "ユキヒメ", "text": "カミラお姉ちゃん、\n雪だるまさん作るの、たのしいね。", "face": "u667"}, {"name": "カミラ", "text": "そうですね、\nこんな風に遊ぶのは久々です。ふふっ。", "face": "u724"}, {"name": "ユキヒメ", "text": "ころころ、ぺたぺた……。ふふふっ。\n雪だるまさん～♪　まぁるく大きくぅ～♪", "face": "u667"}, {"name": "アンナ", "text": "……あの、そろそろ模擬戦を\n始めても良いでしょうか……？", "face": "lcd5b67a8847f"}, {"name": "ユキヒメ", "text": "あっ！　ごめんなさい……忘れてました……。\nよぉし、カミラお姉ちゃんは私が守るからね。", "face": "u667"}, {"name": "ケイティ", "text": "それでは王子、配置についてください。\n模擬戦を開始します！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "騎兵の機動力と、アイスエレメンタルの\n波状攻撃を凌ぐのは、至難の業ですね……。", "face": "u114"}, {"name": "ミゲル", "text": "これだけ攻めても受け止めちまう、\n兄貴達の方がよっぽどすごいと思うけどな。", "face": "u369"}, {"name": "ソーマ", "text": "雪の中の戦闘も慣れてきましたからね。\nこの訓練を始めて良かったと思います。", "face": "u23"}, {"name": "アサル", "text": "くちゅんっ！　……うぅ、でも次はもっと、\n難しい地形での戦いを経験しておきたいですね。\n普段は雪の中で戦うことはあまりないので……。", "face": "u172"}, {"name": "ケイティ", "text": "そうですね……。\nどこかちょうど良い場所があれば……。", "face": "u114"}, {"name": "ユキヒメ", "text": "それなら良い場所を知ってるよ。\n地面がつるつるーってなってるところ。", "face": "u667"}, {"name": "ケイティ", "text": "なるほど、訓練の締めには最適かもしれません。\nユキヒメさん、案内をお願いしても良いですか？", "face": "u114"}, {"name": "ユキヒメ", "text": "うん、まかせて。\n王子、カミラお姉ちゃん、こっちだよ。", "face": "u667"}, {"name": "ケイティ", "text": "我々も移動しましょう。\n次の模擬戦が本日最後の訓練ですよ！", "face": "u114"}]}], "story_talk": true, "active": true}