id": 32291, "global_id": 5910, "ranged": true, "to_global_id": 5923, "spawn_sec": 98}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 8, "missile_id": 6, "master_id": 32304, "global_id": 5923}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "tags": ["バレンタイン"], "hp": 9500, "attack": 950, "base_hp": 9500, "base_attack": 950, "damage_type": "physical", "armor_defense": 150, "magic_defense": 30, "attack_range": 170, "attack_speed": 26, "attack_wait": 20, "attack_interval": 89, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142160, "special_effect_id": 92, "missile_id": 815, "missile": {"speed": 7.0}, "master_id": 35790, "global_id": 9407, "ranged": true, "spawn_sec": 172}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["植物", "バレンタイン"], "hp": 40000, "attack": 650, "base_hp": 40000, "base_attack": 650, "damage_type": "magical", "armor_defense": 2500, "attack_range": 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 135, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 2.5999999046325684, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 474, "missile_id": 6, "master_id": 32310, "global_id": 5929, "ranged": true, "spawn_sec": 181}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "tags": ["バレンタイン"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121328, "race_id": 3, "change_to": 13, "master_id": 32294, "global_id": 5913, "spawn_sec": 205}], "popups": ["チョコトレントは\n徐々に自身のHPを回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ローリエ", "text": "──ようやく追い付きましたよ、妖精さん。", "face": "u1692a1"}, {"name": "魔界カカオの妖精", "text": "やぁ、待っていたよ王国軍の乙女たち。\n挨拶が遅れたね、ボクは魔界カカオの妖精。\n気軽に「フォラスくん」とでも呼んでおくれよ。", "face": "le0ee8b8f609a"}, {"name": "ラタトスク", "text": "呼び名なんぞどうでもよい。\n何を企んでおるのか知らんが、\n吾輩の世界樹から離れぬか。", "face": "u1693a1"}, {"name": "フォラス", "text": "それはできない相談だなぁ。\n悪いけどこれからキミの世界樹には、\nボクのお手伝いをしてもらうからね。", "face": "le0ee8b8f609a"}, {"name": "ラタトスク", "text": "ふん、魔界の木っ端妖精風情に、\n世界樹の支配権を奪えるものか。", "face": "u1693a1"}, {"name": "フォラス", "text": "確かに、ボクにそれだけの力は無いよ。\nだけど一滴の泥水がワインを台無しにするように、\nボクという異物を世界樹に混入させることは可能さ。", "face": "le0ee8b8f609a"}, {"name": "フォラス", "text": "いつかろ過され消えることになろうとも、\n世界樹の飛ばす花粉に乗って各地を巡り、\n数日世界を変えられたならボクの望みは叶う。", "face": "le0ee8b8f609a"}, {"name": "ラタトスク", "text": "はんッ、あまり甘く見るでないわい！\nそう簡単に吾輩の世界樹が堕ちるわけ──", "face": "u1693a1"}, {"name": "フォラス", "text": "ちなみに汚染率は現在５０％だよ。", "face": "le0ee8b8f609a"}, {"name": "ラタトスク", "text": "──誰か早くあやつを止めよーッ！\n世界樹ー！　もっと根性を見せぬかー！\nだから魔物化なんかするんじゃ貴様はー！", "face": "u1693a1"}, {"name": "ローリエ", "text": "……望み、と言いましたね。\nこれがただの悪戯ではないのであれば、\nフォラスさん、あなたの目的はなんですか？", "face": "u1692a1"}, {"name": "フォラス", "text": "それはもちろん、恋する乙女たちの応援さ。", "face": "le0ee8b8f609a"}, {"name": "フォラス", "text": "バレンタインとは、胸に秘めたる想いを伝える日。\nでもね、そんな勇気を持てない子たちは少なくない。", "face": "le0ee8b8f609a"}, {"name": "フォラス", "text": "渡せなかったチョコレート、\n机の引き出しに仕舞われたラブレター、\n両想いのはずがすれ違うカップル。", "face": "le0ee8b8f609a"}, {"name": "フォラス", "text": "ボクがこの世で一番大っ嫌いな光景だ。\nそんな悲劇を、ボクが喜劇で塗り替える。", "face": "le0ee8b8f609a"}, {"name": "フォラス", "text": "中には想いが実らず、恋に破れる乙女もいるだろうさ。\nだけどその痛みは、やがて乗り越えられる類の痛みだ。", "face": "le0ee8b8f609a"}, {"name": "フォラス", "text": "伝えなかったという後悔が癒えることは一生ない。", "face": "le0ee8b8f609a"}, {"name": "ミリアム", "text": "………………。", "face": "u1694a1"}, {"name": "ローリエ", "text": "……フォラスさんの考えは理解しました。\nですが、私はあえてこう主張しましょう。", "face": "u1692a1"}, {"name": "ローリエ", "text": "──あなたのそれは、お節介です！\nそんなの、誰も、頼んでいません！", "face": "u1692a1"}, {"name": "ローリエ", "text": "怒りました、私はすごく怒りましたから。\n力づくでもあなたを止めさせてもらいます。", "face": "u1692a1"}, {"name": "フォラス", "text": "いいとも、己の傲慢さは自覚しているつもりさ。\nボクの本気で、キミたちの相手をしてあげるよ。", "face": "le0ee8b8f609a"}]}, {"trigger": "end", "lines": [{"name": "ローリエ", "text": "私たちの勝ちです、フォラスさん。", "face": "u1692a1"}, {"name": "フォラス", "text": "……どうやらそうみたいだね。\nボクの何が駄目だったのかなぁ、\n参考までに聞かせてもらえないかい？", "face": "le0ee8b8f609a"}, {"name": "ローリエ", "text": "……恋は、他人に強制されるものではありません。", "face": "u1692a1"}, {"name": "ローリエ", "text": "苦悩の末に、相談することはあっても。\n誰かの後押しを必要とするのだとしても。", "face": "u1692a1"}, {"name": "ローリエ", "text": "想いを伝えるという選択をするのは、自分です。", "face": "u1692a1"}, {"name": "ローリエ", "text": "踏み出す一歩は、\n自分の意思でないといけないんです。", "face": "u1692a1"}, {"name": "ローリエ", "text": "そうでなければ、たとえ恋が叶ったとしても、\nきっと胸には、小さな棘が刺さったままだから。", "face": "u1692a1"}, {"name": "フォラス", "text": "……踏み出す一歩は自分の意思で、か。\nボクは悲恋がこの世の何より嫌いだけど。", "face": "le0ee8b8f609a"}, {"name": "フォラス", "text": "振り絞られた勇気の尊さを、忘れていたみたいだね。", "face": "le0ee8b8f609a"}, {"name": "フォラス", "text": "完敗だ、煮るなり焼くなりお好きにどうぞ。", "face": "le0ee8b8f609a"}, {"name": "ラタトスク", "text": "ほぉ、中々に潔いではないか。\nこれだけの騒動を起こしたのじゃ、\n覚悟はできているのじゃろうな？", "face": "u1693a1"}, {"name": "ローリエ", "text": "ら、ラタトスクさん！　あまり重い罰は──", "face": "u1692a1"}, {"name": "ラタトスク", "text": "──まあ聞け、吾輩に良い考えがある。", "face": "u1693a1"}]}], "active": true}