{"quest_id": 7836, "name": "恋する乙女たちへのお節介", "description": "ようやく世界樹に辿り着いた王子一行。\nすると己の願いを叶えるべく世界樹に干渉\nしていた魔界カカオの妖精が姿を現す。\n極級（★１獲得の目安：平均Lv25）", "event": "花咲く想いのバレンタイン", "event_category": "History", "mission_id": 920192, "map_no": 4684, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142080, "special_effect_id": 1224, "change_to": 1, "master_id": 35757, "global_id": 9374, "to_global_id": 9375, "route_behaviour": {"transforms": [{"wait": 50}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 5, "tags": ["植物", "バレンタイン", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142096, "change_to": 2, "master_id": 35758, "global_id": 9375, "to_global_id": 9376}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142112, "special_effect_id": 1225, "change_to": 3, "master_id": 35759, "global_id": 9376, "to_global_id": 9377}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 3, "form_count": 5, "tags": ["植物", "バレンタイン", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 21