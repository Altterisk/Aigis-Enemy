"dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 82}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 91}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "hp": 20000, "attack": 700, "base_hp": 20000, "base_attack": 700, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 50, "attack_interval": 111, "move_speed": 400.0, "dot_rate": 1.5, "pattern_id": 2104256, "race_id": 14, "special_effect_id": 230, "master_id": 516, "global_id": 515, "spawn_sec": 114}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 1200, "base_hp": 40000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 50, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104224, "race_id": 14, "special_effect_id": 231, "master_id": 514, "global_id": 513, "spawn_sec": 127}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 156}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 157}], "popups": ["牛頭の魔物の影には、\nダメージを与える事ができません。\n以下の条件を満たすと消滅します。\n\n・本体を倒す\n・本体が拠点に到達する"], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "報告によれば、\n牛頭の妖怪兄弟が暴れているのは\nこの近くということでしたが。", "face": "lfe765ec149a6"}, {"name": "ファー", "text": "しっかし、暑い場所だなぁ……。\n溶岩の熱気ってのはどうにも慣れねえや。", "face": "u327"}, {"name": "アンナ", "text": "立っているだけで\n体力を消耗する恐れがあります。\n皆さん、くれぐれも注意してください。", "face": "l4189aaf75d19"}, {"name": "兵士", "text": "あ！　あそこを見てください！", "face": "lfe765ec149a6"}, {"name": "牛頭の魔物(弟)", "text": "グフフフフ……。\n来たな、人間ども。", "face": "l640eff49a836"}, {"name": "牛頭の魔物(兄)", "text": "ゴモモモモ！！\n我が兄弟の力を思い知れ！\n叩き潰し、磨り潰し、捻り潰してくれるわッ！", "face": "l03581101a64a"}]}, {"trigger": "battle", "at_sec": 59, "lines": [{"name": "牛頭の魔物(弟)", "text": "より強力になった我が妖術を見せてくれる。\nさあ、影どもよ敵を滅ぼせ。", "face": "l640eff49a836"}, {"name": "ファー", "text": "あ～ん？\nこいつはこざかしい術を使うじゃねえか！\nいいか、王子？", "face": "u327"}, {"name": "ファー", "text": "一目で影とホンモノを見分けることなんざ、\n千里眼でもなきゃ無理な芸当だ。", "face": "u327"}, {"name": "ファー", "text": "まぁつまりは、実際にぶっ叩いた感触で\n真贋を判断するしかねぇわけだな。\nまどろっこしいことは抜きだ！", "face": "u327"}, {"name": "ファー", "text": "手当たりしだいに攻撃して本体を探しだすぞ！\nこれしか倒す手段はないと考えな。\nさあ、いっちょ暴れてやろうぜ！", "face": "u327"}]}, {"trigger": "end", "lines": [{"name": "牛頭の魔物(兄)", "text": "ゴモモ……。\nま、負けた、だと……。", "face": "l03581101a64a"}, {"name": "牛頭の魔物(弟)", "text": "グフゥ～！！\n覚えていろ人間！　\n次こそは必ず根絶やしにしてくれるわッ！", "face": "l640eff49a836"}, {"name": "アンナ", "text": "……なんとか勝利しましたね。", "face": "l4189aaf75d19"}, {"name": "ケイティ", "text": "手強い相手でした。", "face": "u114"}, {"name": "ロイ", "text": "あの異常なまでの人への怨念は\n恐ろしいですな。", "face": "u11"}, {"name": "アリサ", "text": "分かり合うことは、できないのですね……。", "face": "u24"}, {"name": "ファー", "text": "種族を超えた理解ってのは難しいもんさ。\nオレとお前らだって、分かり合うのに、\n何度も戦っただろう？", "face": "u327"}, {"name": "ローレン", "text": "原因の大半はお前だがな。", "face": "u118"}, {"name": "ファー", "text": "何ぃッ！", "face": "u327"}, {"name": "ローレン", "text": "お、なんだ、やるか？", "face": "u118"}, {"name": "ケイティ", "text": "言ったそばからケンカして……。\n相手を理解するって難しいですわね。", "face": "u114"}, {"name": "アリサ", "text": "でも、ファーさん達とっても楽しそうです。", "face": "u24"}]}], "active": true}