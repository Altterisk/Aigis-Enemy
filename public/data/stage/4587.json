 42, "master_id": 771, "global_id": 770, "spawn_sec": 107}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 2700, "attack": 350, "base_hp": 2700, "base_attack": 350, "damage_type": "physical", "armor_defense": 70, "magic_defense": 40, "attack_speed": 40, "attack_wait": 3, "attack_interval": 68, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106064, "race_id": 3, "special_effect_id": 42, "master_id": 770, "global_id": 769, "spawn_sec": 107}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 300, "base_hp": 30000, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "magic_defense": 40, "attack_range": 200, "attack_speed": 50, "attack_wait": 48, "attack_interval": 162, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105984, "race_id": 3, "change_to": 9, "change_condition": 1, "missile_id": 14, "missile": {"speed": 6.0, "splash": 147}, "master_id": 764, "global_id": 763, "ranged": true, "variants": [{"hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 50, "attack_wait": 16, "attack_interval": 133, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106000, "race_id": 3, "master_id": 765, "global_id": 764}], "spawn_sec": 127}], "dialogue": [{"trigger": "start", "lines": [{"name": "クロノデーモン", "text": "グハハハハッ！　ついに到着したか！\nもはや時空魔法は我が物ぞ！　さぁ、\n魔の者たちよ我の時空魔法を受け、王子を滅せよ！", "face": "l90b49cdb4253"}, {"name": "ヘクター(過去)", "text": "伝令！\n戦場に突如としてデーモンが出現しました！\nこ、このままでは前線は半時も保ちません……！", "face": "u74"}, {"name": "クレイブ(過去)", "text": "デーモンだと……！？　くそっ……\nここまで……なのか……？\n王子は……王子はご無事なのか！？", "face": "u8"}, {"name": "ヘクター(過去)", "text": "政務官殿が急ぎ王子をお連れして、\n安全な場所へと逃がすよう手配しています。\n既に女神神殿へ向かっているはずです……。", "face": "u74"}, {"name": "クレイブ(過去)", "text": "そうか……ならば俺達がやるべき事はただ一つのみ。\n王子が少しでも遠くへ逃れることができるよう\n一秒でも長く、魔物を食い止める事だ……！", "face": "u8"}, {"name": "ヘクター(過去)", "text": "はいっ！！\nぼくも最期まで傍で戦わせて下さい……！", "face": "u74"}, {"name": "アンナ", "text": "ここは……まさか、王都……？\n魔物が城に攻め込んできた、\nあの時に戻ってきたのですね……。", "face": "l0a873060b98d"}, {"name": "クレイブ(過去)", "text": "せ、政務官殿！？　それに王子まで……？\nどうしてここにおられるのですか？\n王都を脱出したのではなかったのですか？", "face": "u8"}, {"name": "アンナ", "text": "（そうか……この時の私は、\n王子と共に王都から脱出して……ならば！）", "face": "l0a873060b98d"}, {"name": "アンナ", "text": "一度逃げはしましたが、\nこうして援軍を率いて戻ってきたのです！", "face": "l0a873060b98d"}, {"name": "ケイティ", "text": "ヘクター、良くがんばりましたね。\nこんなにボロボロになるまで戦って……。\n今こそ、貴方達の献身に報いさせて頂きます。", "face": "u114"}, {"name": "ヘクター(過去)", "text": "援軍……こんなに大勢の方々が……。\n王国の為に力をかしてくれる仲間がこんなに\nいただなんて……夢じゃ、ないんですよね？", "face": "u74"}, {"name": "クレイブ(過去)", "text": "これだけの戦力がいったいどこから……！？", "face": "u8"}]}, {"trigger": "end", "lines": [{"name": "クレイブ(過去)", "text": "まさか、あれだけの魔物を退けるとは！\nあなたは私が知っている王子なのですか、\nまるで別人のような強さ……。", "face": "u8"}, {"name": "兵士(過去)", "text": "――報告ッ！\n魔物の軍勢が、これまで以上の数で\n王都へ向け、進軍しているとのことです……。", "face": "l783480b7d606"}, {"name": "クレイブ(過去)", "text": "くそっ……。\n魔物どもめ……、一体どれだけ倒せば……！\n王子、ここは私達が引き続き死守します！", "face": "u8"}, {"name": "アンナ", "text": "……全軍、至急撤退の準備をしてください。\n東西に散開して逃走し、敵の追撃を避け、\n女神の神殿へ続く森へと向かってください。", "face": "l0a873060b98d"}, {"name": "クレイブ(過去)", "text": "王都を、魔物に明け渡すというのですか……！？\n……王子の指示ということであれば……、\n異論は……ありません……。", "face": "u8"}, {"name": "アンナ", "text": "ごめんなさい、クレイブさん。ヘクターさん。\nそして王子の為に……ありがとうございます。\nですが、今は全員で脱出する事が先決です！", "face": "l0a873060b98d"}, {"name": "アンナ", "text": "さあ皆さん、急いで退却の準備をしてください。", "face": "l0a873060b98d"}, {"name": "クレイブ(過去)", "text": "了解しました……王子、どうかご無事で。\n再び、神殿の森にてまみえましょう。", "face": "u8"}, {"name": "ココロ", "text": "………………行っちゃったね、アンナさん。\nデーモンはまた時空の門を使って過去へと\n跳んでいったわ……私達も急がないと……。", "face": "u364"}, {"name": "アンナ", "text": "はい……ココロさん。次の時代へ行きましょう。\n何としても私達の歴史を、そして過去の王子を、\n守らなくてはいけないのですから……。", "face": "l0a873060b98d"}]}], "story_talk": true, "active": true}