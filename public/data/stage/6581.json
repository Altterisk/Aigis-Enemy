: 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 633, "global_id": 632, "ranged": true, "spawn_sec": 105}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 30000, "attack": 2500, "base_hp": 30000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 30, "attack_wait": 50, "attack_interval": 201, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2111984, "change_to": 9, "change_condition": 2, "master_id": 30635, "global_id": 4254, "to_condition": 2, "to_global_id": 4255, "spawn_sec": 108}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 60000, "attack": 3300, "base_hp": 60000, "base_attack": 3300, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 30, "attack_wait": 50, "attack_interval": 209, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112000, "special_effect_id": 240, "master_id": 30636, "global_id": 4255, "from_condition": 2}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド", "植物"], "hp": 3000, "attack": 40, "base_hp": 3000, "base_attack": 40, "damage_type": "magical", "armor_defense": 800, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115952, "missile_id": 47, "master_id": 31282, "global_id": 4901, "ranged": true, "spawn_sec": 111}], "dialogue": [{"trigger": "start", "lines": [{"name": "エーリカ", "text": "カボチャのランタンに、美味しいお菓子♪", "face": "u409"}, {"name": "ミサ", "text": "それから街の子供たちの為の、\nハロウィンの衣装に、会場の飾り付けも万端です。\n王子も手伝ってくれて、大助かりでした♪", "face": "u539"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "エーリカ", "text": "これなら街の子供たちも、\nいーっぱい喜んでくれそうだね♪", "face": "u409"}, {"name": "カルマ", "text": "……あの、私も誘ってもらって、\n本当に良かったのでしょうか……？", "face": "u682"}, {"name": "エーリカ", "text": "もっちろん♪\nハロウィンはみーんなで、楽しくじゃなきゃね！", "face": "u409"}, {"name": "ミサ", "text": "そのとおりです。それに子供たちも、\nカルマお姉ちゃんと一緒にハロウィンパーティをしたい！\nと言っていましたし。", "face": "u539"}, {"name": "ゴーストパンプキンキング", "text": "――でも、人間のハロウィンパーティは\nここで終わりカボ。", "face": "l8b71fa632b69"}, {"name": "エーリカ", "text": "あ、あなたは……！？\nどうして魔物がこんなところまで！", "face": "u409"}, {"name": "ヴァンパイア公爵", "text": "ふん、わざわざ魂を集めて喰わせてやったのだ、\nその分の働きはしてもらうぞ。", "face": "lc2d0f813e720"}, {"name": "ゴーストパンプキンキング", "text": "分かっているカボ。\nヴァンパイア公爵の力まで借りた以上、\nこのハロウィンパーティは絶対に成功させるカボ！", "face": "l8b71fa632b69"}, {"name": "カルマ", "text": "……ハロウィンパーティは、皆で楽しくです。\nあなた達がしようとしているのは、\nパーティではなく、ただの人殺しではないですか……！", "face": "u1682"}, {"name": "ゴーストパンプキンキング", "text": "……カボ？", "face": "l8b71fa632b69"}, {"name": "ミサ", "text": "そのとおりです！\n戦いなんて楽しいパーティじゃありません！", "face": "u539"}, {"name": "ゴーストパンプキンキング", "text": "……カ、カボ！？", "face": "l8b71fa632b69"}, {"name": "エーリカ", "text": "ハロウィンの邪魔は、\nぜ～ったいにさせないわ！", "face": "u409"}, {"name": "ゴーストパンプキンキング", "text": "何だカボ、こいつらどうして、\nそんなにハロウィンにこだわるカボ……！？", "face": "l8b71fa632b69"}, {"name": "カルマ", "text": "王子様、力を貸してください。\nハロウィンパーティは、私たちが守ります！", "face": "u1682"}]}, {"trigger": "battle", "at_sec": 35, "lines": [{"name": "ゴーストパンプキンキング", "text": "王子たち、前より強くなっているカボ……？", "face": "l8b71fa632b69"}, {"name": "ゴーストパンプキンキング", "text": "仕方ないカボ、パンプキンナイト、\n魔界で拾った「封印晶」の力、見せてやるカボ！！", "face": "l8b71fa632b69"}, {"name": "ミサ", "text": "「封印晶」……！？\n古い文献で読んだことがあります。", "face": "u539"}, {"name": "ミサ", "text": "特定の魔物を制御する力を持ち、\nそれ以外の魔物であれば、\n手傷を与えるとより凶暴になってしまうはず。", "face": "u539"}, {"name": "カルマ", "text": "手の内が分かるなら問題ありません。\n王子様、警戒しつつ倒してしまいましょう。", "face": "u1682"}]}, {"trigger": "end", "lines": [{"name": "ヴァンパイア公爵", "text": "――所詮はゴーストだったか。\n期待はしていなかったが、\nここまで使えないとはな……。", "face": "lc2d0f813e720"}, {"name": "カルマ", "text": "公爵、今度は何を企んでいるのですか。", "face": "u1682"}, {"name": "ヴァンパイア公爵", "text": "お前如きに教えると思ったか。\nしかし、戯れとはいえ王子の軍勢の、\n力を測ることは出来た……。", "face": "lc2d0f813e720"}, {"name": "ヴァンパイア公爵", "text": "次は手加減抜きで相手をしてやろう。\n楽しみに次の夜を待つが良い。", "face": "lc2d0f813e720"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "エーリカ", "text": "うぅ、せっかくのハロウィンパーティだったのにぃ！", "face": "u409"}, {"name": "ミサ", "text": "でも、皆が集まってくる前で良かったです。\n楽しいお祭の日に、怪我人が出てはいけませんから。", "face": "u539"}, {"name": "カルマ", "text": "そうですね。\n今夜は皆で楽しい、ハロウィンパーティですから。", "face": "u682"}, {"name": "エーリカ", "text": "それじゃあ王子、カルマ、\n街の子供たちと、軍の皆を呼んできてくれるかな？", "face": "u409"}, {"name": "カルマ", "text": "はい♪　王子様、楽しいパーティにしましょうね？", "face": "u682"}]}], "active": true}