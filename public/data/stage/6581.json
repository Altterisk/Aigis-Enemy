{"quest_id": 6581, "name": "ナイトメア・パーティ", "description": "準備中のハロウィンパーティ会場に突如、\nカボチャの魔物と共に吸血鬼が現れる！\n楽しいパーティを公爵の手から守り切れ！\n神級（★１獲得の目安：平均Lv50）", "event": "降魔の復讐者", "event_category": "History", "mission_id": 920115, "map_no": 5481, "level": 100, "multiplier": 1.0, "charisma": 115, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "tags": ["アンデッド", "植物"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115984, "missile_id": 45, "master_id": 31284, "global_id": 4903, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド", "植物"], "hp": 24000, "attack": 500, "base_hp": 24000, "base_attack": 500, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 81, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115984, "special_effect_id": 317, "missile_id": 45, "master_id": 31285, "global_id": 4904, "ranged": true, "spawn_sec": 32}, {"enemy_id": 3, "source": "local", "count": 12, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 42}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack