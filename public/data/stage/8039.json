: 2108336, "race_id": 16, "special_effect_id": 80, "change_to": 8, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 36435, "global_id": 10052, "ranged": true, "from_condition": 0}, {"enemy_id": 11, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 46000, "attack": 650, "base_hp": 46000, "base_attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 210, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133312, "race_id": 16, "special_effect_id": 1483, "change_to": 11, "change_condition": 1, "missile_id": 26, "master_id": 36439, "global_id": 10056, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 46000, "attack": 1800, "base_hp": 46000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133328, "race_id": 16, "master_id": 34631, "global_id": 8248}, {"tags": ["帝国"], "hp": 46000, "attack": 650, "base_hp": 46000, "base_attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 210, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133312, "race_id": 16, "special_effect_id": 229, "change_to": 10, "missile_id": 26, "master_id": 36441, "global_id": 10058, "ranged": true}], "sp_change_to": [36441], "route_behaviour": {"transforms": [{"to": 36441}, {}]}, "spawn_sec": 127}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["アーマー"], "hp": 124000, "attack": 1500, "base_hp": 124000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_range": 285, "attack_speed": 1, "attack_wait": 55, "attack_interval": 167, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2146240, "race_id": 16, "special_effect_id": 1478, "change_to": 14, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 36431, "global_id": 10048, "ranged": true, "to_condition": 0, "to_global_id": 10050, "spawn_sec": 161}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 124000, "attack": 1500, "base_hp": 124000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_range": 190, "attack_speed": 1, "attack_wait": 55, "attack_interval": 167, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2146240, "race_id": 16, "special_effect_id": 1480, "change_to": 13, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 36433, "global_id": 10050, "ranged": true, "from_condition": 0}], "popups": ["骸帝の部隊は体力が\n徐々に減少していきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "骸帝", "text": "よく耐えている。\nしかし、誰が守るための戦いなど言い伝えたのか……。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "戦え、剣を取れ、殺し続けよ。\n我が帝国は血河の上に建つ城なのだから。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "確かに、そう伝え聞いていた。\n帝国は我が父祖の大地を踏みにじる巨悪だと。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "だが、今代の皇帝は約束したぞ？\n民と共に歩いていく、それが未来の帝国の姿だと。", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "ほざけ、負け犬ごときに国家の何が分かる。\n人質を取られた程度で動けなくなる貴様に――", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "――いや、訂正しよう。\nそうか、セグナンド、貴様も戦士の顔になったな。\nどうやら覚悟を決めたとみえる。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "……そうか、ようやく分かった。\n骸帝、お前の覚悟とは、殺し、殺される覚悟か。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "その身は既に死したも同然、\n奪い、蹂躙し、莫大な富を築くその覇道は、\n己が命を賭け続けたがゆえの産物なのだな。", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "貴様、良い王の器となったな。\n惜しい、本当に惜しいものだ……。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "死の覚悟ある者こそ良い王の器だというのなら、\nそんなものは願い下げだ。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "ただ、良き父として、\n未来を子らに残す族長として、\n俺はここに、命をかけて剣を取っただけなのだから。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "さぁ、負傷者は早く撤退しろ！\nそう長くは――いや、格好つける意味もないか。\n稼げても数秒だ、急げ！！", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "いや、その誇りに敬意を払おう。\n貴様の首ひとつで、その者らは見逃してやる。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "今代の帝国軍が我が首を狙いにかけつけるまで、\nここに留まり、待つことを誓おう。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "ああ……そいつは、助かる。\nお前の約束なんて、信じちゃいないがな。", "face": "l20ac59a2a223"}]}, {"trigger": "start", "lines": [{"name": "ハイデマリー", "text": "…………むごい。\n誰も、生き残ってないじゃない……。", "face": "u1704a1"}, {"name": "サザンカ", "text": "これも、ある意味じゃ慈悲なのかもね。\n苦しまないようにしたんだと思うよ。", "face": "u1347a1"}, {"name": "ハイデマリー", "text": "それにしても、酷すぎるよ。\n……ッ、あれは、あの姿は――", "face": "u1704a1"}, {"name": "ヘリューズ", "text": "セグナンド……最後まで、戦士として生きたのですね。", "face": "u1919a1"}, {"name": "骸帝", "text": "――存外、早かったな。\nしかしこの男の時間稼ぎも、意味があったか。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "我が古の帝国軍も、その数を大きく減らした。\n首ひとつで戦況を変えるとは、大したものだ。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "さて、では今の皇帝はなにができる？\n何をもって我らに対抗せんとする。", "face": "lf035f042ddb3"}, {"name": "白の皇帝", "text": "――この場に、言葉が必要か？", "face": "u418"}, {"name": "骸帝", "text": "ククッ……ハハハハハッ！！\n良い、最上級の答えだ、我が後継者よ。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "さぁ、殺し合おう。\n帝国の未来を、この目に見せてみよ！！", "face": "lf035f042ddb3"}]}, {"trigger": "end", "lines": [{"name": "骸帝", "text": "…………さぁ、殺せ。", "face": "lf035f042ddb3"}, {"name": "白の皇帝", "text": "……ああ。\n我が先達よ、貴様の帝国は、もはや存在しない。", "face": "u418"}, {"name": "白の皇帝", "text": "これより先、未来の帝国は、\n迷い、選び、それでも立ち止まらない、\n力強く歩み続ける――民のための国となる。", "face": "u418"}, {"name": "骸帝", "text": "…………見届けよう。\n我が覇道が、間違いであったと、証明して、みせよ……。", "face": "lf035f042ddb3"}, {"name": "レオナ", "text": "……陛下。", "face": "u311"}, {"name": "白の皇帝", "text": "決着はついた。\n帝国の未来を決めるのは、今を生きる者だ。\n過去の亡霊などではない。", "face": "u418"}, {"name": "エルミラ", "text": "――ッ、な、なに？　なんだか地面が揺れてるような！", "face": "u427"}, {"name": "ヘリューズ", "text": "……私がこの地を離れることを決めたから、でしょうか。\n封鎖が解け、\n冥界の、元の位置へと戻ろうとしているのかと。", "face": "u1919a1"}, {"name": "ハイデマリー", "text": "……大地がそんな急に移動したら、\nその上にいるの、危ないんじゃないの！？", "face": "u1704a1"}, {"name": "レオナ", "text": "総員、撤退準備！\n負傷者の回収急げ！！", "face": "u311"}, {"name": "メーア", "text": "で、でも、どうやってここから離れるんですかー！？\n結構入り口から歩きましたよね！？", "face": "u796"}, {"name": "レオナ", "text": "問題ない。\nこういう時のために、わざわざ準備をさせたんだ。", "face": "u311"}, {"name": "ミュレ", "text": "――ギュララララーっとぉ！\n大規模隧道、貫通完了ー！！", "face": "u1920a1"}, {"name": "ミュレ", "text": "ふふふ、穴掘りと同時に補強もしちゃう、\n帝国式隧道掘削術のお披露目いかがで――", "face": "u1920a1"}, {"name": "フォーラ", "text": "ミュレ！　重機どけて！！\n飛空戦艦突入するから！！", "face": "u1921a1"}, {"name": "ハイデマリー", "text": "はっ、えっ、えぇ……？\nトンネルに……飛空戦艦飛ばしたの……？", "face": "u1704a1"}, {"name": "レオナ", "text": "これなら、誰ひとり残さず収容が可能だ。\nさぁ呆けていないで撤収を急げ！", "face": "u311"}, {"name": "フォーラ", "text": "格納庫は空っぽにしてある。\n全員乗れるから慌てず、奥まで詰めて！", "face": "u1921a1"}, {"name": "ミュレ", "text": "はい詰めて詰めてー！\nこっちの大型掘削機にも乗っちゃってください！", "face": "u1920a1"}, {"name": "イルヴィ", "text": "…………。", "face": "u1918a1"}, {"name": "イルヴィ", "text": "――さようなら、父上。", "face": "u1918a1"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "…………。", "face": "l9d320c40e349"}, {"name": "？？？", "text": "…………甘いものだ。\n骸帝も、現皇帝も。", "face": "l9d320c40e349"}, {"name": "？？？", "text": "さて、この報告を聞いたとき、\nあいつはどんな顔をするだろうか……。", "face": "l9d320c40e349"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [85]}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}, {"kind": "term", "influence": 18, "params": [150]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 25200, "attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "pattern_id": 2146224}, {"enemy_id": 1, "form_index": 1, "hp": 25200, "attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "pattern_id": 2146224}, {"enemy_id": 3, "form_index": 0, "hp": 2400, "attack": 420, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2102256}, {"enemy_id": 4, "form_index": 0, "hp": 3000, "attack": 576, "damage_type": "physical", "armor_defense": 250, "pattern_id": 2111792}, {"enemy_id": 5, "form_index": 0, "hp": 21600, "attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133056}, {"enemy_id": 8, "form_index": 0, "hp": 24000, "attack": 540, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2130064}, {"enemy_id": 9, "form_index": 0, "hp": 13200, "attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "pattern_id": 2108336}, {"enemy_id": 9, "form_index": 1, "hp": 13200, "attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "pattern_id": 2108336}, {"enemy_id": 11, "form_index": 0, "hp": 55200, "attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133312}, {"enemy_id": 14, "form_index": 0, "hp": 148800, "attack": 1500, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "pattern_id": 2146240}, {"enemy_id": 14, "form_index": 1, "hp": 148800, "attack": 1500, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "pattern_id": 2146240}]}, "active": true}