{"quest_id": 8039, "name": "第六陣 骸帝", "description": "骸帝と雌雄を決するべく総力をもって抗え！\n＜冥界：HPに継続ダメージ＞\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["冥界：HPに継続ダメージ", "広域戦闘：敵味方の射程減少"], "event": "帝国六陣", "event_category": "Empire", "mission_id": 940002, "map_no": 4782, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 26, "form_index": 0, "form_count": 2, "tags": ["アーマー", "帝国"], "hp": 21000, "attack": 1400, "base_hp": 21000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 80, "attack_interval": 217, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146224, "race_id": 16, "special_effect_id": 1477, "change_to": 1, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 36430, "global_id": 10047, "ranged": true, "to_condition": 0, "to_global_id": 10049, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 3}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "帝国"], "hp": 21000, "attack": 1400, "base_hp": 21000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 80, "attack_interval": 217, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146224, "race_id": 16, "special_effect_id": 1479, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 36432, "global_id": 10049, "ranged": true, "from_condition": 0}, {"enemy_id": 3, "source": "local", "count": 20, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_att