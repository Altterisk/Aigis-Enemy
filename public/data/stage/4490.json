"dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104768, "race_id": 16, "change_to": 7, "change_condition": 2, "master_id": 563, "global_id": 562, "spawn_sec": 4}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 13200, "attack": 660, "base_hp": 12000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104688, "race_id": 16, "change_to": 9, "change_condition": 2, "master_id": 567, "global_id": 566, "spawn_sec": 4}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 1, "hp": 2200, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 49, "global_id": 48, "ranged": true, "spawn_sec": 18}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "hp": 2750, "attack": 770, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 51, "global_id": 50, "spawn_sec": 31}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "hp": 2200, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_range": 140, "attack_speed": 80, "attack_wait": 60, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101408, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 299, "global_id": 298, "ranged": true, "spawn_sec": 32}, {"enemy_id": 14, "source": "local", "count": 9, "form_count": 1, "hp": 1980, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 150, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 52, "global_id": 51, "ranged": true, "spawn_sec": 38}], "dialogue": [{"trigger": "start", "lines": [{"name": "メトゥス", "text": "父上……あなたの悲願は達せられましたわ。\n私はこうして、人間に戻ることができました。", "face": "u329"}, {"name": "メトゥス", "text": "ですが、父上の命を犠牲にして、\nこうしておめおめと生きているなんて、\nさぞ無様に思われるでしょうね……。", "face": "u329"}, {"name": "メメント", "text": "……そんなことないよ！", "face": "u195"}, {"name": "メメント", "text": "ボク、メトゥスのお父さんは、メトゥスが\n人間になって良かったって喜んでると思う……。\nそれに、その為に――……。", "face": "u195"}, {"name": "メメント", "text": "……なんでもない。過去は変えられないもんね。\nでもねメトゥス、これからメトゥスがどう生きるかで\n思い出は何色にでも変わるとボクは思うよ？", "face": "u195"}, {"name": "メメント", "text": "永久に生きることは醜いけど、\n限りある命を生きることは、きっと綺麗だよ。", "face": "u195"}, {"name": "メトゥス", "text": "……そうね。あなたの言うとおりだわ。\nこんな顔してたら、私を救ってくれた王子にも\n無礼よね。ありがとう、メメント。", "face": "u329"}, {"name": "メメント", "text": "そ、そんな改めてお礼を言われると、\nなんだか照れちゃうよ……にはは。", "face": "u195"}, {"name": "セラ", "text": "そこまでです、死霊術師メトゥス！\n死者の身体を弄ぶ、貴方を断罪します！\nさあ、神罰を受ける準備は、よろしくて？", "face": "u255"}, {"name": "アンナ", "text": "皆さん聞いて下さい！\nもうメトゥスさんは私たちの――。", "face": "l4a3feac43ef3"}, {"name": "メトゥス", "text": "止めなくてよろしいですわ、アンナ。\nあの方々の怒りは、私が過去に犯した\n罪の残り火なのですもの。", "face": "u329"}, {"name": "フェルミ", "text": "何故あんな所に王子様たちが……？", "face": "u324"}, {"name": "エレット", "text": "きっと死霊にして自分のコレクションに\n加える気なんだ……。\nそんなの許せないよ！", "face": "u217"}, {"name": "フラメル", "text": "皆さん、これは聖戦です！\n今こそ聖なる力を解放して敵を討ち、\n王子達を神の御許へと還すのです！", "face": "u193"}, {"name": "メメント", "text": "これって、必要な戦い……なんだよね？", "face": "u195"}, {"name": "メトゥス", "text": "そうね。\nこれは私が人間として生きる為の通過儀礼……\nそして過去と未来を肯定する為の闘いですわ。", "face": "u329"}, {"name": "メトゥス", "text": "ねえ、ダーリン……。\n私を抱きしめた時から、\nこうなることは覚悟してたわよね？", "face": "u329"}, {"name": "ダーリン", "text": "……。", "face": "u1"}, {"name": "メトゥス", "text": "ふふ、ごめんなさい……ダーリン。\n迷惑ばかりかけて……。でも、ダーリンなら私の\n全てを受け入れてくれるって信じてますわ。", "face": "u329"}]}, {"trigger": "end", "lines": [{"name": "エーテル", "text": "なぜ、とどめを刺さないのですか？", "face": "u215"}, {"name": "メトゥス", "text": "だって私はもう、不死者ではないですもの。\n貴方と同じく、不可避の死を内包する者よ。\nどうせいつか死ぬなら奪う必要はないでしょ？", "face": "u329"}, {"name": "セラ", "text": "人に戻ったからといって、\n全ての罪が許されるわけでは\nありませんのよ……。", "face": "u255"}, {"name": "メトゥス", "text": "わかってるわ……。だから背負うと決めたの。\nみそぎ捨てるのではなく、\n苦しんででも王子と共に生きることをね。", "face": "u329"}, {"name": "フラメル", "text": "……そう、ですか。\n貴方は、随分と変わられたようですね。", "face": "u193"}, {"name": "エレット", "text": "王子のおかげだよね、きっと。\nうん、それならすごく納得できるもん。", "face": "u217"}, {"name": "アンナ", "text": "皆さん……。\nそれでは、メトゥスさんを仲間として、\n受け入れていただけますでしょうか？"}, {"name": "フラメル", "text": "……神は罪を赦す存在でもあります。\n私たちは、常に主と共にあります。\nですが、今日のところはここで失礼致します。", "face": "u193"}, {"name": "アンナ", "text": "……行ってしまわれましたね。\n心の整理にはまだ時間が必要ですね。", "face": "l3f7d87a0b065"}, {"name": "メメント", "text": "メトゥス……。\nボクはメトゥスの味方だからね。\n傍にいること、忘れないでよ？", "face": "u195"}, {"name": "メトゥス", "text": "分かっていますわ。仲間、ですものね！　\nいつか皆にも仲間だと思ってもらえると、信じてる。\n……それじゃ、皆のいるお城に帰りましょう。", "face": "u329"}]}], "active": true}