{"quest_id": 8761, "name": "国宝と騎竜", "description": "王子の元へ積荷を運ぶ最中、馬車が破損。\n襲い来る魔物から修理中の馬車を守れ！\n＜特定のタイミングで吹雪が発生＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "黒き導き、白き目覚め", "event_category": "History", "mission_id": 920240, "map_no": 7309, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 60000, "attack": 350, "base_hp": 60000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145152, "race_id": 16, "special_effect_id": 902, "change_to": 1, "change_condition": 1, "master_id": 39432, "global_id": 13049, "variants": [{"tags": ["置物"], "fixture": true, "hp": 60000, "attack": 350, "base_hp": 60000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145168, "race_id": 16, "special_effect_id": 1090, "master_id": 39433, "global_id": 13050}], "route_behaviour": {"creates_obj": 4, "creates_guest": 4}}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 2, "tags": ["黒輪"], "hp": 15000, "attack": 1100, "base_hp": 15000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 2200, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099136, "race_id": 12, "special_effect_id": 2075, "change_to": 3, "change_condition": 2, "master_id": 39424, "global_id": 13041, "to_condition": 2, "to_global_id": 13042, "spawn_sec": 9}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 22500, "attack": 2200, "base_hp