pecial_effect_id": 2076, "master_id": 39421, "global_id": 13038, "from_condition": 2}, {"enemy_id": 15, "source": "local", "count": 12, "form_count": 2, "tags": ["黒輪"], "hp": 2400, "attack": 650, "base_hp": 2400, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "special_effect_id": 2075, "change_to": 15, "change_condition": 2, "master_id": 39422, "global_id": 13039, "to_condition": 2, "to_global_id": 13040, "spawn_sec": 69}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 3600, "attack": 1300, "base_hp": 3600, "base_attack": 1300, "damage_type": "physical", "armor_defense": 4000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "special_effect_id": 2076, "master_id": 39423, "global_id": 13040, "from_condition": 2}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 2, "tags": ["黒輪"], "hp": 24000, "attack": 1200, "base_hp": 24000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_range": 60, "attack_speed": 115, "attack_wait": 100, "attack_interval": 279, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 2077, "change_to": 17, "change_condition": 2, "missile_id": 11, "master_id": 38785, "global_id": 12402, "ranged": true, "to_condition": 2, "to_global_id": 12403, "spawn_sec": 109}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 36000, "attack": 2400, "base_hp": 36000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_range": 60, "attack_speed": 115, "attack_wait": 80, "attack_interval": 239, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 2078, "missile_id": 11, "master_id": 38786, "global_id": 12403, "ranged": true, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "リッカ", "text": "え、エレイン～！\n馬車がガッタガッタ揺れて酔っちゃいますぅぅぅ！？", "face": "l2b1b7f9536ca"}, {"name": "エレイン", "text": "我慢して！\nこれでも一番マシな所を選んでるから！", "face": "l92fe57e02df3"}, {"name": "リッカ", "text": "はぁぁ……アトナテスさんの\nヴァリトスちゃんに乗せてもらえばよかったぁ……。\nこれじゃあお尻がよっつに割れちゃいますぅぅ。", "face": "l2b1b7f9536ca"}, {"name": "エレイン", "text": "あっちに乗ってたら、\n誰がこのとんでもない積荷を守るのよ！？", "face": "l92fe57e02df3"}, {"name": "リッカ", "text": "うぇぇぇん！\nただでさえメチャクチャ堅苦しい儀式のせいで、\n全身バッキバキなんですけどぉぉぉ。", "face": "l2b1b7f9536ca"}, {"name": "アトナテス", "text": "悪いなリッカ。\nこっちもとんでもない暴れん坊の世話で大変なんだ。", "face": "l5e70bc53ced6"}, {"name": "アトナテス", "text": "この騎竜、ヴァリトス相手に緊張するどころか\nちょっかいかけてきやがる。", "face": "l5e70bc53ced6"}, {"name": "イーリス", "text": "まぁまぁ。\nリッカさんのお尻には\n癒しの魔法をかけておきますから。", "face": "laec01ab41421"}, {"name": "リッカ", "text": "うぅ、ありがとうございますぅぅ。", "face": "l2b1b7f9536ca"}, {"name": "リッカ", "text": "はぁ……。\nエヴェリーナ様に言われて、\n気軽に手伝いを請け負いましたけど……。", "face": "l2b1b7f9536ca"}, {"name": "リッカ", "text": "それがまさか、とんでもない国宝の運搬と、\n騎竜を最前線に運ぶ任務だったなんて。", "face": "l2b1b7f9536ca"}, {"name": "エレイン", "text": "でも、やりがいはあるでしょ？\n最前線で戦ってる王子に、\n何が何でもこれを届けなくちゃ！", "face": "l92fe57e02df3"}, {"name": "エレイン", "text": "――って、あ、あら？\n車軸がきしんで――きゃああああぁっ！？", "face": "l92fe57e02df3"}, {"name": "リッカ", "text": "わきゃあああああぁっ！？", "face": "l2b1b7f9536ca"}, {"name": "アトナテス", "text": "ちっ……こんなところで故障か？\n魔物の生息域のど真ん中だぞ！", "face": "l5e70bc53ced6"}, {"name": "エレイン", "text": "仕方ない……。\n馬車の修理が終わるまで、護衛をお願い！", "face": "l92fe57e02df3"}]}, {"trigger": "end", "lines": [{"name": "エヴェリーナ", "text": "――無事か！？", "face": "u2620a1"}, {"name": "リッカ", "text": "エヴェリーナ公爵！\nはい、修理完了です！", "face": "l2b1b7f9536ca"}, {"name": "エヴェリーナ", "text": "よし、越境要塞からの馬車も合流した。\nこのまま最前線まで駆け抜けるぞ。", "face": "u2620a1"}, {"name": "アトナテス", "text": "なぁ、公爵。\nいったいあの儀式で、何を持ち出したんだ。", "face": "l5e70bc53ced6"}, {"name": "エヴェリーナ", "text": "……北の大国の国宝は？", "face": "u2620a1"}, {"name": "アトナテス", "text": "あ？　フラガラッハだろう？", "face": "l5e70bc53ced6"}, {"name": "エヴェリーナ", "text": "そのとおり。\nでは今の時代に、もうひとつ、\n足りないものがあるとは思わないか？", "face": "u2620a1"}, {"name": "エヴェリーナ", "text": "英雄王の誰よりも近くで戦い続けた、\n紫竜の騎士たるあなたなら、分かるはずだ。", "face": "u2620a1"}, {"name": "アトナテス", "text": "……足りねぇものなんざいくつもあるが。\nあえて、その中でもすぐに分かるもの、か。", "face": "l5e70bc53ced6"}, {"name": "アトナテス", "text": "……フラガラッハ。ロンゴミニアド。\nそれから英傑連中の神器に、エクスカリバー。", "face": "l5e70bc53ced6"}, {"name": "アトナテス", "text": "……エクスカリバー。\nおい、もう一振り足りねぇぞ。", "face": "l5e70bc53ced6"}, {"name": "エヴェリーナ", "text": "ふふっ、そういうことだ。", "face": "u2620a1"}, {"name": "エヴェリーナ", "text": "アヴァロンは英雄王に、\n過去から未来、すべての王であることを望み――", "face": "u2620a1"}, {"name": "アトナテス", "text": "ふたつの剣を、贈った。", "face": "l5e70bc53ced6"}, {"name": "アトナテス", "text": "ようやく理解したぜ。\nそれなら、なおさら急いで届けてやらねぇとな。", "face": "l5e70bc53ced6"}, {"name": "アトナテス", "text": "――神剣コールブランド。\nこの戦いで、王子に一番必要なものだろ？", "face": "l5e70bc53ced6"}]}], "active": true}