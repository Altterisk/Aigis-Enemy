{"quest_id": 8033, "name": "英雄と暗殺者", "description": "闇の組織が本命であるアスバール、\n元始天尊、ティルトを狙って襲い来る。\n三人と協力して敵を撃退し勝利を掴め！\n神級EX（★１獲得の目安：平均覚醒Lv25）", "event": "人気闘兵凱旋パレードIII", "event_category": "History", "mission_id": 920202, "map_no": 4776, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 36, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103536, "race_id": 16, "special_effect_id": 61, "change_to": 2, "master_id": 454, "global_id": 453, "to_global_id": 454, "route_behaviour": {"transforms": [{"wait": 1000}]}, "spawn_sec": 23}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103552, "race_id": 16, "special_effect_id": 61, "change_to": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 455, "global_id": 454, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 1, "level": 300, "form_count": 1, "hp": 