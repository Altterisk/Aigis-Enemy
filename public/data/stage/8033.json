e_id": 26, "master_id": 30128, "global_id": 3747, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 1, "level": 150, "form_count": 1, "hp": 24000, "attack": 600, "base_hp": 24000, "base_attack": 600, "damage_type": "physical", "armor_defense": 65, "magic_defense": 20, "attack_range": 170, "attack_speed": 90, "attack_wait": 50, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115280, "race_id": 16, "special_effect_id": 299, "missile_id": 291, "missile": {"speed": 15.0}, "master_id": 31144, "global_id": 4763, "ranged": true, "spawn_sec": 89}, {"enemy_id": 9, "source": "local", "count": 1, "level": 150, "form_count": 1, "hp": 21000, "attack": 1600, "base_hp": 21000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 125, "attack_interval": 293, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115264, "race_id": 16, "special_effect_id": 61, "missile_id": 290, "missile": {"splash": 93}, "master_id": 31145, "global_id": 4764, "ranged": true, "spawn_sec": 89}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 2, "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103696, "race_id": 16, "special_effect_id": 61, "change_to": 10, "master_id": 470, "global_id": 469, "to_global_id": 470, "route_behaviour": {"transforms": [{"wait": 700}]}, "spawn_sec": 94}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103712, "race_id": 16, "special_effect_id": 61, "change_to": 9, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 471, "global_id": 470, "ranged": true}, {"enemy_id": 12, "source": "local", "count": 12, "form_count": 2, "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109136, "race_id": 16, "special_effect_id": 61, "change_to": 12, "master_id": 30132, "global_id": 3751, "to_global_id": 3752, "route_behaviour": {"transforms": [{"wait": 700}]}, "spawn_sec": 107}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 135, "attack_interval": 361, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109152, "race_id": 16, "special_effect_id": 61, "change_to": 11, "missile_id": 26, "master_id": 30133, "global_id": 3752, "ranged": true}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 112000, "attack": 3600, "base_hp": 112000, "base_attack": 3600, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_range": 120, "attack_speed": 300, "attack_wait": 60, "attack_interval": 223, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145984, "race_id": 16, "special_effect_id": 1446, "change_to": 14, "change_condition": 1, "missile_id": 11, "master_id": 36360, "global_id": 9977, "ranged": true, "variants": [{"hp": 112000, "attack": 4200, "base_hp": 112000, "base_attack": 4200, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_speed": 1, "attack_wait": 80, "attack_interval": 282, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2146000, "race_id": 16, "special_effect_id": 1447, "master_id": 36361, "global_id": 9978}], "spawn_sec": 137}], "popups": ["ワンから受けたダメージは\n４倍になります。\n\nまたワンは一定確率で\n物理攻撃を回避します。\n\n\n　　　　　　(1/2)", "ワンの\n近接攻撃を受けると、\n即座に麻痺状態になります。\n\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "シックス", "text": "──ようやく戦力がバラバラになってくれましたね。", "face": "l117e4b0a4866"}, {"name": "シックス", "text": "本命は最初から最多得票者。他はおまけに過ぎません。", "face": "l117e4b0a4866"}, {"name": "ティルト", "text": "どうする、出番の前に囲まれてしまったぞ。", "face": "u1705a1"}, {"name": "アスバール", "text": "これが投票してくれたファンであれば良かったのですが……。", "face": "u1668a1"}, {"name": "元始天尊", "text": "ふむ、不心得者もこれだけ集まれば壮観ですね。", "face": "u1801a1"}, {"name": "シックス", "text": "ノストラ、あなたも愚かなことをしたものですね。\nせっかく自由に外出する権利を与えてあげたというのに、\n我々の信頼を裏切るとは……許されることではありません。", "face": "l117e4b0a4866"}, {"name": "ノストラ", "text": "信頼とか気色悪い言葉使わないでもらえる？\nだから貴方、他の幹部からも嫌われてるのよ？", "face": "u1912a1"}, {"name": "ノストラ", "text": "それに何か勘違いしてないかしら。\n前回の人気闘兵の上位入賞者であるこの三人、\n暗殺が成功すれば確かに王国は大打撃でしょうね。", "face": "u1912a1"}, {"name": "アスバール", "text": "しかし人気闘兵とは元々、\n世界樹を襲う災いに抗う力を持った、\n英雄を見出すべく行われた催事。", "face": "u1668a1"}, {"name": "元始天尊", "text": "その英雄とは、とびきり強くて素敵な人物だそうです。", "face": "u1801a1"}, {"name": "シックス", "text": "なにが言いたいのです……。", "face": "l117e4b0a4866"}, {"name": "ティルト", "text": "我々はな……お前たちのような三下風情が、\n束になっても敵う相手ではないということだ。", "face": "u1705a1"}, {"name": "ノストラ", "text": "だそうよ、精々頑張ってね。シックス。", "face": "u1912a1"}, {"name": "シックス", "text": "──ッ、怯えることはありません。\n亜神といえど武装もまだ整っていません、\n数の力で以って圧殺してしまいなさい！", "face": "l117e4b0a4866"}, {"name": "ティルト", "text": "来るのであれば容赦はしない。我が冥府の剣技──", "face": "u1705a1"}, {"name": "元始天尊", "text": "崑崙の秘術を──", "face": "u1801a1"}, {"name": "アスバール", "text": "神の嵐雨を、お見せしましょう。", "face": "u1668a1"}]}, {"trigger": "battle", "at_sec": 139, "lines": [{"name": "？？？", "text": "手酷くやられたようだな。", "face": "l0ba6f3e8f0c2"}, {"name": "ティルト", "text": "──何者だ。", "face": "u1705a1"}, {"name": "シックス", "text": "ワッ、ワン様……申し訳ありません……！", "face": "l117e4b0a4866"}, {"name": "アイリーン", "text": "ワン……あれが、あのワンなのか……？", "face": "u315"}, {"name": "元始天尊", "text": "まさかあの者は……生きていたのですね。", "face": "u1801a1"}, {"name": "アスバール", "text": "知っているんですか？", "face": "u1668a1"}, {"name": "元始天尊", "text": "ええ、あのワンという男は華の国の破戒僧。\n師父を殺して魔道に堕ち、魔教の主となった魔人です。\n先代華王や正派の武人に討たれたと聞いていましたが……。", "face": "u1801a1"}, {"name": "ノストラ", "text": "国外に逃亡して復讐の機会を狙っていたのよ。\n今の闇の組織の目的はワンを最強の男にすること。\n私の仕事は、そのための霊薬や武功書集めだったわ。", "face": "u1912a1"}, {"name": "ノストラ", "text": "閉関修練を終えて出てきたってことは、\nめでたく化境にでも至ったんでしょうね。", "face": "u1912a1"}, {"name": "元始天尊", "text": "化境……半神半人の域、ですか。\nあながち冗談でもなさそうですね。", "face": "u1801a1"}, {"name": "ワン", "text": "……長い時を過ごした、屈辱の時間だった。\nだがそれも終わる、魔道は再び天を暗く覆う。", "face": "l0ba6f3e8f0c2"}, {"name": "ワン", "text": "挨拶代わりだ、暗天の武威を知るが良い。", "face": "l0ba6f3e8f0c2"}, {"name": "ノストラ", "text": "ワンは一子相伝の暗殺拳の使い手よ。\nもし本当に化境に足を踏み入れているとすれば、\n彼の拳は神をも殺し得る、気を付けなさい。", "face": "u1912a1"}, {"name": "ワン", "text": "喝ッ！！！！", "face": "l0ba6f3e8f0c2"}]}, {"trigger": "end", "lines": [{"name": "ツー", "text": "はしゃぎすぎだぞ、ワン。\n換骨奪胎を終えて食事もまだのはずだ。\n王国は万全の準備無しで戦える相手ではない。", "face": "lbf7cf12344e7"}, {"name": "セブン", "text": "（これで腹ペコ状態ってまじかよ……）", "face": "u449"}, {"name": "ツー", "text": "襲撃計画は失敗だ、潮時だろう。", "face": "lbf7cf12344e7"}, {"name": "ワン", "text": "確かにお前の言う通りだ、ツー。\nだが、今回は組織も大きな損害を負った。\n手土産の一つでも貰わねば割に合わん。", "face": "l0ba6f3e8f0c2"}, {"name": "ワン", "text": "闇ギルドの亡霊よ、その命を貰い受ける。", "face": "l0ba6f3e8f0c2"}, {"name": "元始天尊", "text": "──ッ！　速い！？", "face": "u1801a1"}, {"name": "アイリーン", "text": "しまっ──！？", "face": "u315"}]}, {"trigger": "end", "lines": [{"name": "ノストラ", "text": "──ゴホッ。", "face": "u1912a1"}, {"name": "アイリーン", "text": "…………ノストラ？", "face": "u315"}, {"name": "ツー", "text": "……姉を庇ったか。あの傷では助かるまい。", "face": "lbf7cf12344e7"}, {"name": "アイリーン", "text": "ノストラ、なぜ私を庇った！？", "face": "u315"}, {"name": "ノストラ", "text": "ふ……ふふっ、姐さん、私ね、ずっと待ってたのよ？", "face": "u1912a1"}, {"name": "アイリーン", "text": "何を……。", "face": "u315"}, {"name": "ノストラ", "text": "あの日……闇ギルドが終わった日、\n私はギルド長の派閥だからって地下牢に監禁されて、\nずっと姐さんが助けに来てくれるのを待ってた。", "face": "u1912a1"}, {"name": "ノストラ", "text": "何日も何日も何日も何日も、真っ暗な闇の中で。\nずっと待ってたのに、姐さんは来てくれなかった。", "face": "u1912a1"}, {"name": "アイリーン", "text": "それは、お前が死んだと聞いて……復讐しようと……。", "face": "u315"}, {"name": "ノストラ", "text": "死体も確認せずに？　どうせギルド長のことばかりで、\n私のことはおまけ程度にしか考えてなかったんでしょ？", "face": "u1912a1"}, {"name": "ノストラ", "text": "すごく絶望したわ、私は姐さんに忘れられたんだって。\n姐さんが、私をこのクソッタレな世界に連れ戻したのに。", "face": "u1912a1"}, {"name": "ノストラ", "text": "親に捨てられたことも分からなかった私を、\n冬の雪山で死なせてくれなかったくせに──", "face": "u1912a1"}, {"name": "ノストラ", "text": "だから……私も姐さんに復讐してやろうって思ったの。\n組織が、姐さんを殺そうとしてたのは知ってたから……。", "face": "u1912a1"}, {"name": "ノストラ", "text": "どう？　これならもう、私のこと忘れないでしょ……？", "face": "u1912a1"}, {"name": "セブン", "text": "じゃあアンタ、最初から死ぬつもりで……。", "face": "u449"}, {"name": "ノストラ", "text": "ああ、セブン……貴方の借金については、\n私も、悪いことをしたなって思っているわ。\nでもね、私だって生きるのに必死だったのよ？", "face": "u1912a1"}, {"name": "ノストラ", "text": "そうすることでしか、生きられなかった──ゲホッ！", "face": "u1912a1"}, {"name": "アイリーン", "text": "もういいノストラ、もう喋るんじゃない。\n恨み言はあとで全部聞いてやる、だから──", "face": "u315"}, {"name": "ノストラ", "text": "ふふっ……最期に全部、騙してやったわ。\n組織も王国も、姐さんも……ざまぁないわ。", "face": "u1912a1"}, {"name": "アイリーン", "text": "ダメだ……逝くなノストラ、ダメだ！", "face": "u315"}, {"name": "アイリーン", "text": "誰かッ！　誰か治癒士はいないのか！\n助けてくれ！　妹を死なせないでくれ！", "face": "u315"}, {"name": "ノストラ", "text": "大っ嫌いよ、お姉ちゃ──", "face": "u1912a1"}]}, {"trigger": "end", "lines": [{"name": "カーニア", "text": "──お呼びカニ？", "face": "u1685a1"}]}], "active": true}