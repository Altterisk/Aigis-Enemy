16, "race_id": 16, "master_id": 30385, "global_id": 4004, "spawn_sec": 104}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 900, "base_hp": 10000, "base_attack": 900, "damage_type": "physical", "armor_defense": 100, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104800, "race_id": 16, "special_effect_id": 53, "missile_id": 26, "master_id": 582, "global_id": 581, "ranged": true, "spawn_sec": 127}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "magical", "armor_defense": 200, "magic_defense": 10, "attack_range": 200, "attack_speed": 55, "attack_wait": 100, "attack_interval": 251, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104912, "race_id": 16, "special_effect_id": 248, "missile_id": 26, "master_id": 30395, "global_id": 4014, "ranged": true, "spawn_sec": 129}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 100, "attack_range": 400, "attack_speed": 120, "attack_wait": 140, "attack_interval": 331, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097888, "race_id": 16, "special_effect_id": 222, "missile_id": 26, "master_id": 30396, "global_id": 4015, "ranged": true, "spawn_sec": 133}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107296, "race_id": 16, "special_effect_id": 222, "master_id": 30387, "global_id": 4006, "spawn_sec": 158}, {"enemy_id": 18, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 950, "base_hp": 8000, "base_attack": 950, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 40, "attack_wait": 30, "attack_interval": 133, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102272, "race_id": 16, "special_effect_id": 222, "master_id": 30397, "global_id": 4016, "spawn_sec": 159}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1200, "base_hp": 15000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 150, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097904, "race_id": 16, "special_effect_id": 222, "master_id": 30398, "global_id": 4017, "spawn_sec": 160}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "hp": 14000, "attack": 650, "base_hp": 14000, "base_attack": 650, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101824, "race_id": 16, "special_effect_id": 226, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30020, "global_id": 3639, "ranged": true, "spawn_sec": 165}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "……こ、こんな感じで良いのでしょうか？", "face": "l335f9088597e"}, {"name": "ティアル", "text": "後は、くぐつを信じる気持ちです！　\n……あ、王子！　\n今、アンナさんにくぐつの乗り方を教えてたんだ。", "face": "u505"}, {"name": "ティアル", "text": "誰かにくぐつの事を教えるなんて初めてだけど……。\nくぐつへの想いはボリス先生にだって負けないから\n大丈夫だよね！", "face": "u505"}, {"name": "ケイティ", "text": "……お話中の所失礼します。\n王子、訓練の準備が整ったようです。\n今日は海での訓練、実りあるものにしたいですね。", "face": "u114"}, {"name": "モーティマ", "text": "山賊が海で訓練だぁ？\nバカらしい……って、怪しげな洞窟があるじゃねぇか。\nもしかしてお宝でも――", "face": "u14"}, {"name": "ケイティ", "text": "モーティマさん、訓練として来ている事をお忘れなく。", "face": "u114"}, {"name": "モーティマ", "text": "お宝がありゃ、王子だって助かるだろ？\nおい、野郎ども行くぞ！", "face": "u14"}, {"name": "ミレイユ", "text": "王子、砂浜での采配見させて頂きます。\n騎兵隊も、準備が完了次第参加しますので、\n油断なきように。", "face": "u386"}, {"name": "ダン", "text": "へへっ、足場が悪い砂浜だからこそ、\n走り込みには最適ってもんだぜ！", "face": "u204"}, {"name": "サキ", "text": "忍者には砂浜も水の上も関係ないわ。\nスイトンの術、見せてあげる！", "face": "u1090"}, {"name": "ミネルバ", "text": "海で海賊に勝てると思っているのかしら？\n訓練と言っても、今日は本気で行かせてもらうわよ。", "face": "u91"}, {"name": "フィリス", "text": "私とポーラは、今日は休みなんだがな……。\n訓練に巻き込まれないよう、気を付けないと。", "face": "u506"}, {"name": "アンナ", "text": "なんだか皆さん、自由な感じですね……。\n私も今日はくぐつに初挑戦しますので、\n王子も訓練、頑張ってくださいね！"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "く、くぐつに乗るのがあんなに大変だとは……。\nティアルさん達はスゴイですね。"}, {"name": "ティアル", "text": "アンナさんも、初めてにしてはすっごい上手だったよ。\nもっと特訓すれば、すぐ乗りこなせるようになるよ！", "face": "u505"}, {"name": "ティアル", "text": "あ、もっとスピード出た方が練習になるかな？\nそうだ、ゼンマイの大きさと数を増やして……。", "face": "u505"}, {"name": "アンナ", "text": "い、いえ、私はもうくぐつは……。", "face": "ld29464d4468b"}, {"name": "ボリス", "text": "おいこら、ティアル。乗ってるのが初心者だってこと\n忘れてんじゃねーぞ。見ろ、もうヘトヘトじゃねーか！", "face": "u360"}, {"name": "ティアル", "text": "せ、先生！？　……す、すみません。\nそこまで気が回っていませんでした……。", "face": "u505"}, {"name": "ボリス", "text": "ったく、無茶な事させて怪我したらどうすんだ。\n技術は上達してきても、まだまだ人に教えるには程遠いな。\n……お前はまだ人に教えるのは禁止だ！", "face": "u360"}, {"name": "ティアル", "text": "え、えぇ～！？", "face": "u505"}, {"name": "ボリス", "text": "それにそのねじの巻き方もあますぎんだよ。\nほら、早くこっちこい！　\n本当のねじ巻きってやつを教えてやる！！", "face": "u360"}, {"name": "ティアル", "text": "は、はぁ～い……。", "face": "u505"}, {"name": "アンナ", "text": "それでは今日の訓練は終了ですね。\n王子、それに皆さんも、お疲れ様でした。"}]}], "active": true}