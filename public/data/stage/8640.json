{"quest_id": 8640, "name": "交渉とはパワー", "description": "交渉のため手合わせをする事になった一行。\n雪枝の戦士たちを相手に武威を示せ！\n＜特定のタイミングで吹雪が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "導きの白狼", "event_category": "History", "mission_id": 920236, "map_no": 9388, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 19, "level": 1, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 18, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 179, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2162336, "race_id": 12, "change_to": 2, "change_condition": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 38998, "global_id": 12615, "ranged": true, "variants": [{"hp": 3500, "attack": 500, "base_hp": 3500, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 5, "attack_wait": 35, "attack_interval": 116, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2162352, "race_id": 12, "master_id": 38999, "global_id": 12616}], "spawn_sec": 11}, {"enemy_id": 4, "source": "local", "count": 13, "form_count": 1, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 60, "attack_range": 10