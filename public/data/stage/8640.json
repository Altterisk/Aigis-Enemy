9, "form_count": 1, "hp": 7000, "attack": 550, "base_hp": 7000, "base_attack": 550, "damage_type": "physical", "armor_defense": 240, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 45, "attack_interval": 139, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2162368, "race_id": 12, "special_effect_id": 1415, "change_to": 9, "change_condition": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 39000, "global_id": 12617, "ranged": true, "variants": [{"hp": 7000, "attack": 750, "base_hp": 7000, "base_attack": 750, "damage_type": "physical", "armor_defense": 240, "magic_defense": 10, "attack_speed": 5, "attack_wait": 20, "attack_interval": 76, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2162384, "race_id": 12, "master_id": 39001, "global_id": 12618}], "spawn_sec": 70}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 950, "base_hp": 30000, "base_attack": 950, "damage_type": "physical", "armor_defense": 180, "magic_defense": 5, "attack_speed": 1, "attack_wait": 5, "attack_interval": 52, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2162400, "race_id": 12, "special_effect_id": 621, "master_id": 39016, "global_id": 12633, "spawn_sec": 123}], "dialogue": [{"trigger": "start", "lines": [{"name": "オーシェン", "text": "……説得、上手くいくでしょうか。", "face": "u2133a1"}, {"name": "シビラ", "text": "どうでしょうね……。\n私たちは、狭間の雪原に人類がいるなんて、\nまったく知らなかったわけだし……。", "face": "u39"}, {"name": "シビラ", "text": "それはつまり、彼らは私たちと、\n一切交流を持つつもりがない、という意味だもの。", "face": "u39"}, {"name": "シビラ", "text": "補給拠点は置けなくとも、ファオルの旅立ちと、\n私たちが里の近くを通過することを認めてもらえたら、\nそれだけで十分過ぎる成果でしょうね。", "face": "u39"}, {"name": "オーシェン", "text": "交流を望まない集落に、\nさぁ門戸を開け、とは言いたくないですからね。", "face": "u2133a1"}, {"name": "オーシェン", "text": "しかし、何とも不思議な気分です。", "face": "u2133a1"}, {"name": "シビラ", "text": "ふしぎ？", "face": "u39"}, {"name": "オーシェン", "text": "えぇ、マータンは私たちのことを、\n南の者と呼んだでしょう？\n普段は北の者と呼ばれますから、不思議な感覚で。", "face": "u2133a1"}, {"name": "レーヴ", "text": "物質界の多くの国が名乗る雅称は、\n英雄王にちなんで名付けられたものですからね。\nどうしても王国から見た方角になりがちです。", "face": "u454"}, {"name": "レーヴ", "text": "狭間の雪原から見れば、\n私たちの知る国々の全てが、\n南の国、みたいになるのかもしれませんね。", "face": "u454"}, {"name": "アリサ", "text": "――あっ、マータンさんが戻ってきました。\nでも、何だか落ち込んでいるような……。", "face": "u24"}, {"name": "マータン", "text": "むぅぅぅぅぅ……。", "face": "u2524a1"}, {"name": "マータン", "text": "すまん、南の客人たち。\nマータンの説得ぱわーが足りなかった。", "face": "u2524a1"}, {"name": "マータン", "text": "ファオルは戻ってこい、南の者は帰れ、\nここより北に進むのは止めておけ、とのことだ。", "face": "u2524a1"}, {"name": "ファオル", "text": "マータン、でも……。", "face": "u2513a1"}, {"name": "マータン", "text": "でも、マータンいっぱいねばった！\n雪枝の里の戦士たちで、\n返り討ちにするから見てろってことにした！", "face": "u2524a1"}, {"name": "ファオル", "text": "えっ。", "face": "u2513a1"}, {"name": "マータン", "text": "で、それで戦士たちが負けたら、\nさすがに話聞くしかないよねってことにした！", "face": "u2524a1"}, {"name": "オーシェン", "text": "なるほど、交渉とはパワー……。", "face": "u2133a1"}, {"name": "マータン", "text": "マータン、こういう悪知恵はたらくタイプ。\n戦士には筋肉だけじゃなくて知恵も必要。", "face": "u2524a1"}, {"name": "マータン", "text": "さぁ剣をとれ！\n雪枝の戦士は強いぞー！", "face": "u2524a1"}, {"name": "ファオル", "text": "……マータンったら。\n利き手じゃない方で武器を持ってたら、\nあたしたちに肩入れしてるの、バレバレじゃない。", "face": "u2513a1"}, {"name": "フラフィー", "text": "それだけ、何とかしようとしてくれてるんですね。\n王子さま、彼女のはからいに応えましょう！", "face": "u811"}]}, {"trigger": "end", "lines": [{"name": "マータン", "text": "やーられたー！\nっていうかやっぱ強いな！\nもうひと勝負したいくらいだ！", "face": "u2524a1"}, {"name": "ファオル", "text": "あっ、マータンも一緒に里を出る？", "face": "u2513a1"}, {"name": "マータン", "text": "むっ……むー。それは考えておく。\nさすがに勢いで答えるのは難しい。", "face": "u2524a1"}, {"name": "マータン", "text": "ともかく、お前たちは実力を見せた。\nそして戦士を傷つけず無力化して、\n敵対する意思がないことも示した。", "face": "u2524a1"}, {"name": "マータン", "text": "マータン、もう一度長老たちを説得する。\n今度は期待して待ってて――", "face": "u2524a1"}, {"name": "シビラ", "text": "…………待って。\n聞こえた？", "face": "u39"}, {"name": "サラサ", "text": "雪をかき分けるような音……。\nこれはソリじゃなくて、\n大勢が走ってくる音ね？", "face": "u317"}, {"name": "ファオル", "text": "えっと、どういうこと？", "face": "u2513a1"}, {"name": "サラサ", "text": "マータン、この付近にも里はある？\nそれか、大きな獣の群生地があるとか……。", "face": "u317"}, {"name": "マータン", "text": "いや、狭間の雪原の里はどれもそこそこ距離があるし、\nこのあたりには小さな獣しか住んでいないぞ？", "face": "u2524a1"}, {"name": "オーシェン", "text": "……襲撃ですか。", "face": "u2133a1"}, {"name": "マータン", "text": "まさか、ありえない。\n狭間の雪原は生きていくだけでも大変だ。\n里同士は互いに不可侵の約束を――", "face": "u2524a1"}, {"name": "アキレア", "text": "…………来る。", "face": "u1972a1"}, {"name": "獣人の騎士？", "text": "――グオァァァァァッグ！！\n野郎ども、牙を剥け、咆哮を上げろ！！", "face": "le9911ed05ac8"}, {"name": "獣人の騎士？", "text": "ちっぽけな里だ、根こそぎ喰い荒らせェ！！", "face": "le9911ed05ac8"}]}], "active": true}