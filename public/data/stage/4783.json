ack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 171, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101136, "race_id": 7, "change_to": 3, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 658, "global_id": 657, "ranged": true, "to_global_id": 348, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 59}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 349, "global_id": 348, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 2, "hp": 12500, "attack": 1500, "base_hp": 12500, "base_attack": 1500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108448, "race_id": 7, "special_effect_id": 112, "change_to": 5, "change_condition": 4, "missile_id": 177, "missile": {"speed": 5.0}, "master_id": 30028, "global_id": 3647, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 3648, "spawn_sec": 130}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12500, "attack": 500, "base_hp": 12500, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "special_effect_id": 112, "master_id": 30029, "global_id": 3648, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "エイミー", "text": "見つけましたよ、マーマン！\nあなた達が魔界マーケットで購入した武器は盗品です！\nすぐに元々の持ち主である私に返して下さい！", "face": "u414"}, {"name": "マーマン", "text": "何を言っているのだ、あの小娘は……？\nこれは我々がきちんと金を払って買ったものだ。\n文句があるのならば売った店主に言うのだな。", "face": "l75f9869235a9"}, {"name": "エイミー", "text": "それなら私がそれ以上の金額で買い取りましょう。\nこう見えても私、けっこう持ってるんです。\nだから「呪いの武器」をこちらに渡して下さい。", "face": "u414"}, {"name": "マーマン", "text": "金銭の問題と捉えているとは……話しにならんな。\n我らはこの武器が今必要だから買ったのだ。\nいくら積まれようが売り払うつもりは毛頭無い！", "face": "l75f9869235a9"}, {"name": "エイミー", "text": "そ、そんなぁ……。\nお金で解決できないなんて……。\n魔物との交渉は難しいです……。", "face": "u414"}, {"name": "マーマン", "text": "それよりも王子、丁度いいところに来た。\n何を隠そう、これは貴様を倒す為に仕入れた武器なのだ。", "face": "l75f9869235a9"}, {"name": "マーマン", "text": "今こそ、この武器の切れ味を試させてもらうぞ！", "face": "l75f9869235a9"}]}, {"trigger": "end", "lines": [{"name": "マーマン", "text": "――グぁッ……ぅうう……。\nそんな……あれだけの高値で買ったというのに、\nこうもあっさりと負けてしまうとは……！", "face": "l75f9869235a9"}, {"name": "マーマン", "text": "魔界マーケットの店主め、何が\n「これで噂の王子も一刀両断！」だ。\nとんだなまくら物を掴ませてくれたな……。", "face": "l75f9869235a9"}, {"name": "エイミー", "text": "それは違います。\n武器の良悪は値段の高低では決しません。\n", "face": "u414"}, {"name": "エイミー", "text": "相応しき者に武器が渡らなければ、真価は示されない……。\n魔界マーケットの武器商人はそれを理解してないのです！", "face": "u414"}, {"name": "マーマン", "text": "フン……人間共よ、知らぬようだから教えてやる。\n魔界マーケットに品物を流しているのは、\n他ならぬ地上界の人間たちなのだぞ。", "face": "l75f9869235a9"}, {"name": "ユリアン", "text": "に、人間が魔界マーケットに武器を流してるだと！？\nおい、エイミー！\n本当にそんなことが行われてるのかよ？", "face": "u7"}, {"name": "エイミー", "text": "思い当たる売人の存在を知っています……。\n少し前に壊滅した悪漢を束ねる組織の残党で、盗品を\n独自のルートで売買をしているという噂があるのです。", "face": "u414"}, {"name": "エイミー", "text": "魔界への武器の供給については、商人仲間の間でもチラ\nホラ噂を聞いていたので、危険視してはいたのですが……\nマーマンの言葉で確証を得ました。", "face": "u414"}, {"name": "セシリー", "text": "悪漢を束ねる組織……もしかして、闇ギルドのことか？\nそれなら、１年程前に確かに\n私達が壊滅させたが……まさか残党がいたとはな。", "face": "u21"}, {"name": "エイミー", "text": "闇ギルドの事をご存知だったのですね。\n壊滅した時期からしても、\nそのギルドで間違いないでしょう。", "face": "u414"}, {"name": "エイミー", "text": "今の彼らはごく少数の売人が取引の実働部隊として\n活動していて、組織の全貌はほとんど分からないのです。", "face": "u414"}, {"name": "セシリー", "text": "なら闇ギルドの残党について探るのが先決か……。\nかつて闇ギルドと深くかかわっていた、\n黒シャチ海賊団なら何か知っているかもしれないな。", "face": "u21"}, {"name": "マウロ", "text": "あいつら、闇ギルドから武器を買っていたしな。\nここらの海域じゃ有名な海賊団だ。\nアジトの場所も知ってるぜ。みんな、俺の後についてきな。", "face": "u124"}]}], "active": true}