nge_condition": 5, "missile_id": 40, "missile": {"speed": 7.0}, "master_id": 34955, "global_id": 8572, "ranged": true, "to_condition": 5, "to_global_id": 3892, "spawn_sec": 155}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 250, "base_hp": 2000, "base_attack": 250, "damage_type": "magical", "armor_defense": 150, "magic_defense": 60, "attack_range": 140, "attack_speed": 26, "attack_wait": 30, "attack_interval": 93, "move_speed": 9000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110272, "special_effect_id": 229, "missile_id": 40, "missile": {"speed": 7.0}, "master_id": 30273, "global_id": 3892, "ranged": true, "from_condition": 5}, {"enemy_id": 14, "source": "local", "count": 2, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097312, "race_id": 9, "master_id": 53, "global_id": 52, "spawn_sec": 171}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 1, "hp": 6500, "attack": 430, "base_hp": 6500, "base_attack": 430, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "master_id": 74, "global_id": 73, "spawn_sec": 194}, {"enemy_id": 16, "source": "local", "count": 4, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 717, "global_id": 716, "spawn_sec": 215}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 1, "hp": 60000, "attack": 800, "base_hp": 60000, "base_attack": 800, "damage_type": "magical", "armor_defense": 150, "magic_defense": 60, "attack_range": 220, "attack_speed": 1, "attack_wait": 90, "attack_interval": 217, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116576, "special_effect_id": 216, "missile_id": 326, "missile": {"speed": 6.0}, "master_id": 31381, "global_id": 5000, "ranged": true, "spawn_sec": 249}], "popups": ["\n\n\n\n　　　　――妖精郷", "エンジェルゲイザーから\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――妖精郷"}, {"name": "オリヴィエ", "text": "まさか、妖精郷が\nこれほどの規模の襲撃を受けるとは……。", "face": "u115"}, {"name": "アトラ", "text": "いずれも以前、妖精郷を襲った魔物に似ている。\nしかし……あの奇怪な姿は……？", "face": "u119"}, {"name": "ロイ", "text": "おそらくは、黒冠の影響を受け、\n様々な特徴を合成した新種の魔物ですな。", "face": "u11"}, {"name": "オリヴィエ", "text": "黒冠……。\n妖精郷にまで影響を及ぼすなんて。", "face": "u115"}, {"name": "クレイブ", "text": "別働隊の私たちが訪問している時で、本当に良かった。\nじきに援軍も到着するはずです。", "face": "u8"}, {"name": "ダン", "text": "それまで、あの濁流みたいな魔物の群れを、\nどうにか抑え込まないとな！", "face": "u204"}, {"name": "サリエット", "text": "（……どうして）", "face": "l17449ceb5e01"}, {"name": "サリエット", "text": "（皆、命をかけて戦っているのに。\n私にできることは、成長の加護を与えることだけ）", "face": "l17449ceb5e01"}, {"name": "サリエット", "text": "（魔物の群れは尽きません。\n王子たちが駆けつけるまで、\nこの少人数でどこまで耐えられるか……）", "face": "l17449ceb5e01"}, {"name": "セリア", "text": "あ、あの、サリエットさん。\n大丈夫ですよ、わたしたちだって、\nずっと戦ってきた戦士ですから。", "face": "u84"}, {"name": "セリア", "text": "あんな魔物ぐらい、\nど、どかーんって、倒してみせますっ。", "face": "u84"}, {"name": "サリエット", "text": "（セリアさん……。\nああ、女神アイギス様……どうか、私に力を……）", "face": "l17449ceb5e01"}, {"name": "サリエット", "text": "（皆を助ける力を、私に……）", "face": "l17449ceb5e01"}, {"name": "女神アイギス", "text": "（――その願い、叶えましょう）", "face": "lf6426e1cd4d0"}, {"name": "サリエット", "text": "――えっ？", "face": "l17449ceb5e01"}]}, {"trigger": "start", "lines": [{"name": "セリア", "text": "わ、わ、何が起きてるんですか……！？", "face": "u84"}, {"name": "サリエット", "text": "私の身体が……。\nあ、アイギス様が……私に戦える身体を……？", "face": "u416"}, {"name": "ダン", "text": "くっ……魔物の群れが来たぞ！", "face": "u204"}, {"name": "サリエット", "text": "私も……私も戦います！\n皆さんのとなりで！", "face": "u416"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "……どうにか援軍が間に合いましたね。\n皆さん、ご無事でしたか？"}, {"name": "セリア", "text": "は、はいっ！\nサリエットさんも手伝ってくれましたし！", "face": "u84"}, {"name": "アンナ", "text": "えぇと、そのお姿は、いったい何が……？", "face": "l7b45c535c403"}, {"name": "サリエット", "text": "微かに、女神アイギス様のお声が聞こえまして……。", "face": "u416"}, {"name": "サリエット", "text": "たぶん、なのですが、\n私の内に元々存在していた力を、\n目覚めさせてくれたのではないかと……？", "face": "u416"}, {"name": "サリエット", "text": "皆さんと一緒に戦いたい、\n大切な人たちを守りたいという願いを叶えるために。", "face": "u416"}, {"name": "セリア", "text": "えっと……あ、あらためて、よろしくお願いします？", "face": "u84"}, {"name": "ダン", "text": "おいおい、別人になったわけじゃないんだろ？\nこういう時は、これからもよろしく、だぜ。", "face": "u204"}, {"name": "サリエット", "text": "ふふっ。\nこれからもよろしくお願いします、皆さん。", "face": "u416"}, {"name": "サリエット", "text": "（女神アイギス様……）", "face": "u416"}, {"name": "サリエット", "text": "（大切な人を、守りたい人たちを、\nきっと守り続けていくと、私は誓います）", "face": "u416"}, {"name": "サリエット", "text": "（アイギス様にいただいた、\nこの機会を絶対に無駄にはしません）", "face": "u416"}, {"name": "ジョヴァンニ", "text": "おーいサリエット！\nメシにしようぜ！　腹が減っちまった。", "face": "u123"}, {"name": "サリエット", "text": "は、はいっ！　すぐに参ります！", "face": "u416"}, {"name": "サリエット", "text": "私も皆さんと一緒に……。\nふふっ、何だか、楽しくなってきました♪", "face": "u416"}]}], "active": true}