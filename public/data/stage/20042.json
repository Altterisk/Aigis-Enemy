4}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 68000, "attack": 750, "base_hp": 68000, "base_attack": 750, "damage_type": "physical", "armor_defense": 900, "magic_defense": 80, "attack_speed": 60, "attack_wait": 10, "attack_interval": 171, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2173808, "race_id": 2, "special_effect_id": 821, "master_id": 41232, "from_condition": 2}, {"enemy_id": 12, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "hp": 40000, "attack": 500, "base_hp": 40000, "base_attack": 500, "damage_type": "magical", "armor_defense": 600, "magic_defense": 80, "attack_range": 400, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103776, "race_id": 2, "change_to": 12, "change_condition": 2, "missile_id": 39, "missile": {"splash": 133}, "master_id": 40728, "global_id": 14345, "ranged": true, "to_condition": 2, "to_global_id": 14346, "spawn_sec": 211}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 68000, "attack": 750, "base_hp": 68000, "base_attack": 750, "damage_type": "magical", "armor_defense": 900, "magic_defense": 80, "attack_range": 90, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103792, "race_id": 2, "missile_id": 39, "missile": {"splash": 133}, "master_id": 40729, "global_id": 14346, "ranged": true, "from_condition": 2}, {"enemy_id": 14, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 42000, "attack": 750, "base_hp": 42000, "base_attack": 750, "damage_type": "magical", "armor_defense": 200, "attack_range": 210, "attack_speed": 1, "attack_wait": 25, "attack_interval": 141, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130976, "race_id": 2, "missile_id": 609, "missile": {"speed": 10.0}, "master_id": 40725, "global_id": 14342, "ranged": true, "spawn_sec": 232}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンウェン", "text": "何を、どれだけ背負えば、\nそこまで意地を張れるようになるのだろうな。", "face": "l9c5e016ae569"}, {"name": "アンウェン", "text": "剣の腕も、平和な時代に鍛えたような、\nひどく丁寧な基礎の上に、\n実戦で磨いた荒業が成り立っておる。", "face": "l9c5e016ae569"}, {"name": "アンウェン", "text": "一騎打ちで負けそうになっても、\n命乞いどころか、背後の誰かを守ろうとするかのように\nむしろ距離を詰め、抗わんとする。", "face": "l9c5e016ae569"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンウェン", "text": "これは、かなわんな。\nしかし……。", "face": "l9c5e016ae569"}, {"name": "アンウェン", "text": "この背にも、国民の命を背負っておるのだ。\n負けるわけには、いかぬ……！", "face": "l9c5e016ae569"}, {"name": "ヴァニカ", "text": "王子殿下！\nあ、アナーニャ様！　このままでは……！", "face": "u2931a1"}, {"name": "ラージヴィール", "text": "やめておけ。\n大勢は決した。あとは意地の問題だ。", "face": "l4ebe7bd5270c"}, {"name": "ラージヴィール", "text": "王子よ、天眼ノ国の助力は必要か？\nそれとも、この地にて、王国の力を見せるか？", "face": "l4ebe7bd5270c"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ラージヴィール", "text": "ふっ、ふふふ……。\nやはり王子こそ、長らくくすぶってきた\nこの世界を駆け抜ける、一筋の疾風よ！", "face": "l4ebe7bd5270c"}, {"name": "アナーニャ", "text": "熱い戦いを求めてたのはあなただけでしょ。\n王子！　危なくなったらすぐ逃げなさい！\nその女の子、本物の竜の姫君なんだから！", "face": "u2873a1"}, {"name": "アンウェン", "text": "では、一手御指南願おう。\nわらわはアンウェン！　竜都の次代の王！", "face": "l9c5e016ae569"}, {"name": "王子", "text": "…………王国の、王子だ。", "face": "u1"}, {"name": "アンウェン", "text": "いざ――！！", "face": "l9c5e016ae569"}]}, {"trigger": "end", "lines": [{"name": "アンウェン", "text": "…………見事。", "face": "l9c5e016ae569"}, {"name": "サフレア", "text": "姫様！！", "face": "l91ed24334c6e"}, {"name": "アキレア", "text": "トドメはいいのか？", "face": "u1972a1"}, {"name": "ユリクセス", "text": "何か言おうとしていただろう？\n服従の呪いを解くほうが優先だ。", "face": "u2193a1"}, {"name": "アイシャ", "text": "シャルロット、手を貸して。\n頼れそうな人材はどれだけ使ってもいいよ。", "face": "u181"}, {"name": "シャルロット", "text": "ですわ？", "face": "u2827a1"}, {"name": "アンウェン", "text": "きゅぅぅ……。", "face": "l9c5e016ae569"}, {"name": "ヴァニカ", "text": "気付け薬はご入用ですか？\n今ならお安くしますよ？", "face": "u2931a1"}, {"name": "サフレア", "text": "結構です！", "face": "l91ed24334c6e"}, {"name": "トトノ", "text": "王国産もありますよ？\n薬草師特別製です。", "face": "u316"}, {"name": "サフレア", "text": "結構！　です！！", "face": "l91ed24334c6e"}, {"name": "アキレア", "text": "やれやれ……。\nさて、せっかく王女サマを捕虜に取ったんだ。\nゆっくりじっくり、あれこれ聞き出すとするか。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "手荒な真似は――", "face": "u2193a1"}, {"name": "アキレア", "text": "あぁ？　そこは王国式だろ？", "face": "u1972a1"}]}], "active": true}