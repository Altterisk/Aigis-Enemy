_id": 2118448, "race_id": 18, "special_effect_id": 372, "change_to": 11, "change_condition": 1, "master_id": 31713, "global_id": 5332, "variants": [{"hp": 3000, "attack": 220, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118464, "race_id": 18, "master_id": 31714, "global_id": 5333}], "spawn_sec": 81}, {"enemy_id": 13, "source": "local", "count": 5, "form_count": 1, "tags": ["アーマー", "スカラベ"], "hp": 15000, "attack": 400, "base_hp": 15000, "base_attack": 400, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 1, "attack_wait": 1, "attack_interval": 49, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121632, "race_id": 18, "master_id": 32393, "global_id": 6012, "spawn_sec": 85}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 2, "hp": 21000, "attack": 1200, "base_hp": 21000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 350.0, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118480, "race_id": 18, "change_to": 14, "change_condition": 2, "master_id": 31715, "global_id": 5334, "to_condition": 2, "to_global_id": 5335, "spawn_sec": 153}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10500, "attack": 800, "base_hp": 10500, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_range": 260, "attack_speed": 1, "attack_wait": 20, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118496, "race_id": 18, "missile_id": 351, "missile": {"speed": 10.0}, "master_id": 31716, "global_id": 5335, "ranged": true, "from_condition": 2}], "popups": ["キラーマンティスは倒されると、\nその場で復活します。\n\n復活後、キラーマンティスは\n飛行を開始します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "キホル", "text": "――すっごぉーい♪\n人間が逃げ回ってるの、すっごく無様ぁ♪", "face": "u1159a1"}, {"name": "魔界アリの女王", "text": "然り然り。\n魔王ガリウス様に逆らった、\n愚かな物質界の民を苦しめてやろうぞ。", "face": "l4dbb867a1051"}, {"name": "エレット", "text": "――うぅん、これ以上は好きにさせないよ！", "face": "u1152a1"}, {"name": "キホル", "text": "……あっ、さっきの人間。\n何？　キホルちゃんの奴隷になりにきたの？", "face": "u1159a1"}, {"name": "エレット", "text": "ここに来る途中にね、デーモンシェフから\nキホルちゃんのこと色々聞いたよ。", "face": "u1152a1"}, {"name": "エレット", "text": "戦いよりも料理が大好きで、\n人間のことは大嫌いだけど、\n誰かが傷つくところは見たくない、そんな子だって。", "face": "u1152a1"}, {"name": "キホル", "text": "……うるさい。", "face": "u1159a1"}, {"name": "デーモンシェフ", "text": "そしてキホル、お前は相手がどんな存在であろうと、\n絶対に許せないことがあったはずだ。", "face": "l20ec5642c69a"}, {"name": "キホル", "text": "うるさい！　黙れ裏切りものぉ！！", "face": "u1159a1"}, {"name": "エレット", "text": "――食べ物で遊ぶやつはぶっ殺す！！\nそれが口癖だったキホルちゃんが、\nフェロモンチョコを望んで作るはずないよね！？", "face": "u1152a1"}, {"name": "キホル", "text": "あっ……あぁああぁああッ！！\n私、わたしは……ッ！！", "face": "u1159a1"}, {"name": "魔界アリの女王", "text": "――困ったものよなぁ。\nこれしきの言葉に惑わされるとは、\nやはり妾以外のメスは使い物にならぬのか。", "face": "l4dbb867a1051"}, {"name": "魔界アリの女王", "text": "ほれ、キホルよ、\n残りのフェロモンチョコを喰らうがよい。\n憧れの魔王様を害した人間を、殺すのであろう？", "face": "l4dbb867a1051"}, {"name": "キホル", "text": "や、やめっ……んぐっ！？\nうぐっ……あぁっ、うわぁぁああぁあッ！！", "face": "u1159a1"}, {"name": "エレット", "text": "キホルちゃん！！\n王子、早くキホルちゃんを止めないと！", "face": "u1152a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "デーモンシェフ", "text": "王子よ、デモシェフ商会総員で、\nこの付近にデーモンのチョコ細工を配置した。\n盾として有効に使うのだぞ……！！", "face": "l20ec5642c69a"}]}, {"trigger": "end", "lines": [{"name": "キホル", "text": "もっと、もっと虫をけしかけて……。\n魔王様を傷つけた人間どもに……罪をつぐなわせ……。", "face": "u1159a1"}, {"name": "エレット", "text": "……キホルちゃん！\nお願い、目を覚まして！", "face": "u1152a1"}, {"name": "魔界アリの女王", "text": "その小娘にばかり気を取られていて良いのか？\n妾の軍勢が、もうひとつの門を破ったぞ？", "face": "l4dbb867a1051"}, {"name": "副デーモンシェフ", "text": "――社長！　王子！\n東門から虫が流れ込んできております！！", "face": "lf6d79249b91b"}, {"name": "魔界アリの女王", "text": "くふふふ……さぁキホルよ、\n虫たちの指揮をとるのだ。\n妾のための、妾の王国の礎となれ！", "face": "l4dbb867a1051"}, {"name": "エレット", "text": "……キホルちゃん、必ず助けるからね。\nあたしが、約束するから！", "face": "u1152a1"}, {"name": "キホル", "text": "…………知らない。\n虫たち、東門に向かうよ。", "face": "u1159a1"}]}, {"trigger": "end", "lines": [{"name": "エレット", "text": "王子、あたしたちも市街に入った虫を倒しにいこう。\n街も、あの子も、全部守らなきゃ！", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "エレット嬢、キホルはデーモンだぞ。\nなぜ異種族であるデーモンに、\nそこまで肩入れしてくれるのだ……？", "face": "l20ec5642c69a"}, {"name": "エレット", "text": "デーモンシェフだってデーモンでしょ？\n一緒に生きていける、もしかしたら友だちにもなれる、\nデーモンと人間なんて、そんなに変わらないよ。", "face": "u1152a1"}, {"name": "エレット", "text": "王子だって、皆だって、\nきっとそう言うと思うよ！", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "……ははっ。\nこれは魔王様がかなわないわけだ。\nよし、我々も市街へ急ぐぞ！", "face": "l20ec5642c69a"}]}], "active": true}