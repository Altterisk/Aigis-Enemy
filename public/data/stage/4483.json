{"quest_id": 4483, "name": "魂呼びの迷宮", "description": "メトゥスを人間に戻すため\n迷宮に眠る「至宝のカケラ」を\n手に入れろ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "死霊術師と反魂の至宝", "event_category": "History", "mission_id": 920060, "map_no": 3656, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["スライム"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100576, "master_id": 269, "global_id": 268, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 6}, {"enemy_id": 3, "source": "local", "count": 28, "form_index": 0, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 8}, {"enemy_id": 4, "source": "local", "count": 9, "form_index": 0, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 23}, {"enemy_id": 5, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1600.0, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "special_effect_id": 222, "change_to": 5, "change_condition": 2, "master_id": 554, "global_id": 553, "to_condition": 2, "to_global_id": 554, "spawn_sec": 30}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 400, "base_hp": 2500, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2500.0, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "special_effect_id": 64, "master_id": 555, "global_id": 554, "from_condition": 2}, {"enemy_id": 7, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 57}, {"enemy_id": 8, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 130}], "dialogue": [{"trigger": "start", "lines": [{"name": "リアナ", "text": "ここが「反魂の至宝」が眠る迷宮です。", "face": "u219"}, {"name": "メトゥス", "text": "案内役ご苦労様。\nまさか、あなたの一族に、\n「反魂の至宝」の伝承が残っていたなんてね。", "face": "u329"}, {"name": "リアナ", "text": "私達の一族が語り継いできた「癒しの至宝」\nと同じく「反魂の至宝」は『癒し』の力を極限\nまで高め凝縮させたものだとされています。", "face": "u219"}, {"name": "リアナ", "text": "ですが、その力はあまりに強大で……。", "face": "u219"}, {"name": "リアナ", "text": "私達の一族は誰の目にもふれないようにと\n至宝を粉々にしてこの迷宮に封印したと\n言い伝えられています。", "face": "u219"}, {"name": "メトゥス", "text": "ごめんなさいね、父上の戯言のせいで、\n先祖が蓋した釜を、末裔のお嬢さんに\n開けさせる手伝いなんかさせちゃって。", "face": "u329"}, {"name": "リアナ", "text": "お気になさらず。もしかしたら\nメトゥスさんだけでなく、世界に役立てる事が\nできるかもしれないのですから。", "face": "u219"}, {"name": "メトゥス", "text": "はぁ～、あなたみたいな清廉な人間って、\n見ているとどうしても汚したくなっちゃうわ。\n探索が終わったら不死者にしていいかしら？", "face": "u329"}, {"name": "リアナ", "text": "愚問ですね。\n私は人として王子の傍に在りたいのです。", "face": "u219"}, {"name": "リアナ", "text": "それよりもメトゥスさん、失礼ですが\nあなたは一体、何を恐れているのですか？", "face": "u219"}, {"name": "メトゥス", "text": "恐れている？　私が……？　\n何を適当なこと言ってるのかしら。", "face": "u329"}, {"name": "リアナ", "text": "失言でしたね。ただ、人間になる事を……、\nいえ、自分が人間であったことに、\nあなたが怯えているように見えたもので……。", "face": "u219"}, {"name": "メトゥス", "text": "――ッ！？　\n……ククク、バカを言わないでちょうだい。\n私に怖いものなんて――。", "face": "u329"}, {"name": "兵士", "text": "前方より魔物の姿を確認！", "face": "lc0e4661faf65"}, {"name": "アンナ", "text": "やはり現れましたね。\nみなさん気を引き締めていきましょう。\n王子、戦いのご準備を！", "face": "l40c186734f05"}]}, {"trigger": "battle", "at_sec": 32, "lines": [{"name": "ゴブリン", "text": "ウウ……セッカク宝を見ツケタノニ、\n狼ニ食ベラレルナンテ……\nツイテナイ……。", "face": "lc6555f3213a3"}, {"name": "バルバストラフ", "text": "おや？　\n魔物の中から「反魂の至宝」の力を感じる。\nどうやら飲み込んだモノがおるらしいのぅ。", "face": "u63"}, {"name": "ゴブリン", "text": "ニ、ニンゲン！？\n宝ハ渡サナイ！　宝ハ俺ノモノダ！", "face": "lc6555f3213a3"}, {"name": "リアナ", "text": "まさか「反魂の至宝」は魔物たちが……！？", "face": "u219"}, {"name": "カリオペ", "text": "ねえ、「反魂の至宝」を取り込んだ魔物って\nもしかして強くなったりするの？", "face": "u42"}, {"name": "リアナ", "text": "「反魂の至宝」の伝承が真であれば、\nおそらくその魔物たちを倒したとしても、\n生き返ってしまうでしょう。", "face": "u219"}, {"name": "カリオペ", "text": "ちょっと、そんなのどう相手するのよ！？", "face": "u42"}, {"name": "メトゥス", "text": "「反魂の至宝」っていってもカケラじゃない。\n蘇ってもせいぜい一度きりよ。\nダーリン、腕の見せ所よ。私を満足させてね。", "face": "u329"}, {"name": "カリオペ", "text": "あんたなんでそんな離れたところにいるのよ？\nもしかして偉そうなこと言うだけ言って、\n戦わないつもり？", "face": "u42"}, {"name": "メトゥス", "text": "当たり前でしょ？　死霊化に値しない\n雑魚を何で相手しなくちゃいけないのよ？\nほら、頼んだわよ。ふふ、仲間って素敵ね。", "face": "u329"}, {"name": "カリオペ", "text": "便利ね、の間違いでしょ？\nって、無駄話できる感じじゃないわね。\nあーもうッ！　王子、やるわよ！", "face": "u42"}]}, {"trigger": "end", "lines": [{"name": "メトゥス", "text": "呆気ないわねー。さすがは私の仲間達♪\nでも唯一の欠点は、\n死んだら死んじゃう、ってところねー。", "face": "u329"}, {"name": "カリオペ", "text": "ったく、不死者の価値観って恐ろしいわ。\nはー疲れた。しばらくは頑張らないからね。", "face": "u42"}, {"name": "ロイ", "text": "それにしてもメトゥスさんは\nほんとに人間に戻る気がないのでしょうか？", "face": "u11"}, {"name": "バルバストラフ", "text": "個々の死生観は千差万別じゃ。強要ができん。\nわしにしても同門のサイラスとは延命魔法の\n使用に関して随分ともめたものじゃ。", "face": "u63"}, {"name": "メトゥス", "text": "ほらー急がないと置いていくわよー？\n早く「反魂の至宝」を手に入れて、更なる\nネクロマンシーの力をこの手に……ククク。", "face": "u329"}]}], "map": {"image": "Map920060_3656", "w": 960, "h": 640, "spots": [{"k": "b", "x": 27, "y": 161}, {"k": "m", "x": 601, "y": 180, "id": 200}, {"k": "m", "x": 541, "y": 146, "id": 201}, {"k": "m", "x": 481, "y": 110, "id": 202}, {"k": "m", "x": 422, "y": 143, "id": 203}, {"k": "m", "x": 360, "y": 180, "id": 204}, {"k": "m", "x": 890, "y": 261, "id": 205}, {"k": "m", "x": 851, "y": 212, "id": 206}, {"k": "m", "x": 623, "y": 254, "id": 207}, {"k": "m", "x": 670, "y": 212, "id": 208}, {"k": "m", "x": 760, "y": 190, "id": 209}, {"k": "m", "x": 755, "y": 316, "id": 210}, {"k": "m", "x": 667, "y": 301, "id": 211}, {"k": "m", "x": 842, "y": 306, "id": 212}, {"k": "m", "x": 562, "y": 364, "id": 213}, {"k": "m", "x": 480, "y": 350, "id": 214}, {"k": "m", "x": 395, "y": 366, "id": 215}, {"k": "m", "x": 563, "y": 452, "id": 216}, {"k": "m", "x": 606, "y": 408, "id": 217}, {"k": "m", "x": 358, "y": 413, "id": 218}, {"k": "m", "x": 479, "y": 466, "id": 219}, {"k": "m", "x": 403, "y": 452, "id": 220}, {"k": "m", "x": 295, "y": 221, "id": 221}, {"k": "m", "x": 213, "y": 199, "id": 222}, {"k": "m", "x": 120, "y": 219, "id": 223}, {"k": "m", "x": 71, "y": 265, "id": 224}, {"k": "m", "x": 347, "y": 269, "id": 225}, {"k": "m", "x": 293, "y": 315, "id": 226}, {"k": "m", "x": 204, "y": 332, "id": 227}, {"k": "m", "x": 116, "y": 312, "id": 228}, {"k": "r", "x": 105, "y": 403, "id": 300}, {"k": "r", "x": 375, "y": 92, "id": 301}, {"k": "r", "x": 669, "y": 480, "id": 302}, {"k": "r", "x": 607, "y": 80, "id": 303}, {"k": "r", "x": 701, "y": 414, "id": 304}, {"k": "r", "x": 751, "y": 454, "id": 305}, {"k": "r", "x": 191, "y": 116, "id": 306}, {"k": "r", "x": 453, "y": 268, "id": 307}]}, "active": true}