ge_type": "true", "armor_defense": 50, "magic_defense": 30, "attack_range": 300, "attack_speed": 1, "attack_wait": 80, "attack_interval": 221, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120656, "race_id": 16, "special_effect_id": 229, "change_to": 5, "missile_id": 406, "missile": {"speed": 7.0}, "master_id": 35556, "global_id": 9173, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 8, "level": 30, "form_count": 1, "hp": 15000, "attack": 600, "base_hp": 15000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 40, "attack_speed": 120, "attack_wait": 30, "attack_interval": 261, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "pattern_id": 2100608, "master_id": 35692, "global_id": 9309, "spawn_sec": 98}, {"enemy_id": 9, "source": "local", "count": 2, "level": 70, "form_count": 2, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123904, "race_id": 2, "special_effect_id": 232, "change_to": 9, "change_condition": 4, "missile_id": 476, "master_id": 32700, "global_id": 6318, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6319, "spawn_sec": 110}, {"enemy_id": 9, "source": "local", "count": 1, "level": 70, "form_index": 1, "form_count": 2, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 87, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123920, "race_id": 2, "master_id": 32701, "global_id": 6319, "from_condition": 4, "trigger_ticks": 1}], "popups": ["ドラコラプトルは味方ユニットを\n発見すると、咆哮を行います。\n咆哮後、移動速度が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "時間切れ"}, {"name": "アンナ", "text": "――大変です！\nグリムさんがお説教から逃走しました！！", "face": "ldbb14e8ce3b1"}, {"name": "ケイティ", "text": "まさか王子の目を盗んで逃げ出すとは。\n今回の異世界を巻き込んだ大騒動、\nしっかり反省してもらうつもりだったのですが……。", "face": "u574"}, {"name": "フィリス", "text": "ああ……本当に大騒動だったもんなぁ……。\n魔王ガリウスのコピーに、異世界の魔王を名乗る兜に、\nそれから、何か偉そうなドラゴン娘に……。", "face": "u40"}, {"name": "ソーマ", "text": "ふふっ、でもちょっとだけ楽しかったですよね。\n久々に異世界の方々とも交流できましたし。", "face": "u439"}, {"name": "フィリス", "text": "まぁ、良いことも悪いこともあったってとこかな。\n仕方ない、こっちも冬祭りの片付けで忙しいけど、\nグリム捜索隊を出すとしようか。", "face": "u40"}, {"name": "アリサ", "text": "えぇ、こんな雪の中では、\nきっと寒い思いをしていると思いますし。", "face": "u24"}, {"name": "グリム", "text": "（――ふんふんふーん。\nお説教脱出成功でーす）", "face": "u1127a1"}, {"name": "グリム", "text": "（……正直、まだもうちょっとだけ、\nお祭り騒ぎしたい気分だったんですよね）", "face": "u1127a1"}, {"name": "グリム", "text": "（お別れとか、お祭りの後の空気とか、\nなんだか寂しくてむずむずしますし……）", "face": "u1127a1"}, {"name": "グリム", "text": "もっと、遊びたかったな……。", "face": "u1127a1"}, {"name": "ソーマ", "text": "はっ、グリムさん発見です！\nグリムさーん！　こっちにきて温まりませんかー？", "face": "u439"}, {"name": "グリム", "text": "やーです。\nお祭りの片付けをしたら、\nお祭りが終わっちゃうじゃないですかー。", "face": "u1127a1"}, {"name": "グリム", "text": "というわけで、皆さんかもーんです♪", "face": "u1127a1"}, {"name": "フィリス", "text": "うわ、あれ冬祭りの食材用に\n確保したドラコラプトルじゃないか！？", "face": "u40"}, {"name": "アリア", "text": "た、たた、大変です！\n拠点の檻も解放されていると報告が！", "face": "u75"}, {"name": "フィリス", "text": "まったく……。\nグリム、次はお説教２倍だからな！", "face": "u40"}, {"name": "グリム", "text": "やーです♪\nさぁ、お祭りの続きをしますよー！", "face": "u1127a1"}]}, {"trigger": "battle", "at_sec": 97, "lines": [{"name": "グリム", "text": "ふっふっふ。\nそろそろコレの出番ですねー。", "face": "u1127a1"}, {"name": "グリム", "text": "いでよ、魔王の影！　のコピー！　のお人形！", "face": "u1127a1"}]}, {"trigger": "battle", "at_sec": 101, "lines": [{"name": "ポミエ", "text": "……魔王ガリウス！？　の、コピー……？\nの、さらに人形って……それただの動く人形なんじゃ？", "face": "u1099a1"}, {"name": "グリム", "text": "だってこれ、お祭りですし。\nもっともっと遊びたいんですー。", "face": "u1127a1"}, {"name": "シンディ", "text": "王子殿下、魔王の影は本物から\n大きく弱体化しているみたいですが、\n一応注意して戦ってくださいね！", "face": "u1098a1"}]}, {"trigger": "end", "lines": [{"name": "グリム", "text": "うー。捕まっちゃいました。", "face": "u1127a1"}, {"name": "フィリス", "text": "はぁ……まったく、\nどうしてこんな悪戯ばかりするんだ？", "face": "u40"}, {"name": "アリサ", "text": "今回も召喚実験の一環なのでしょうか？", "face": "u24"}, {"name": "グリム", "text": "……おまつり。", "face": "u1127a1"}, {"name": "フィリス", "text": "ん？　なんだって？", "face": "u40"}, {"name": "グリム", "text": "なんでもないでーす。\nさー、つまんないお説教聞きに行きますよー。", "face": "u1127a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "王子、もしかしてグリムさんを逃したの、\nわざとだったりしませんか？"}, {"name": "アンナ", "text": "グリムさんがあまりにも楽しそうだったから、\nお祭りが終わって、寂しそうな顔を\nしているのが見ていられなかったとか……。", "face": "ldbb14e8ce3b1"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "アンナ", "text": "おや……。\n王子も、とぼけ方は上手くないんですね。"}, {"name": "フィリス", "text": "王子！　ガリウスコピーの人形の……あーもう！\nガリウスのカケラっぽいやつ、まだ動いてるぞ！", "face": "u40"}, {"name": "レアン", "text": "これは大変だな……。\nよし、さっさと動力を外すぞ！\nみんな、手伝ってくれ。", "face": "u438"}, {"name": "フィリス", "text": "後片付けも増えちゃったし、\nこれはグリムもお説教じゃなくて、\n後片付けの手伝いをしてもらったほうがいいかな。", "face": "u40"}, {"name": "グリム", "text": "やーです♪\nお説教が待ってるのでー。", "face": "u1127a1"}, {"name": "フィリス", "text": "はぁ……そう言いつつ、\nちゃっかり片付け手伝ったりするから、\n全然恨めないんだよなぁ……あいつ……。", "face": "u40"}, {"name": "アンナ", "text": "ふふ、それでは王子、私も片付けを手伝ってきます。\n片付けが終わるまでがお祭りですからね♪"}]}], "story_talk": true, "active": true}