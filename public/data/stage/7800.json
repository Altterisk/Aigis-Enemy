{"quest_id": 7800, "name": "グリムの後夜祭", "description": "王子たちはお説教から逃走したグリムの\n捜索隊を結成。彼女の悪戯で解き放たれた\n祭り用の食材たちを倒しグリムを捕まえよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ31(2022)", "event_category": "Reproduce", "mission_id": 300377, "map_no": 4200, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 2, "hp": 1500, "attack": 130, "base_hp": 1500, "base_attack": 130, "damage_type": "magical", "armor_defense": 60, "magic_defense": 10, "attack_range": 150, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101888, "race_id": 7, "change_to": 1, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 35551, "global_id": 9168, "ranged": true, "to_global_id": 9169, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1500, "attack": 130, "base_hp": 1500, "base_attack": 130, "damage_type": "magical", "armor_defense": 60, "magic_defense": 10, "attack_range": 150, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101888, "race_id": 7, "special_effect_id": 229, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 35552, "global_id": 9169, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 2, "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "change_to": 3, "missile_id": 30, "missile": {"speed": 1