tack_interval": 157, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099024, "race_id": 13, "special_effect_id": 220, "change_to": 8, "change_condition": 3, "master_id": 141, "global_id": 140, "to_condition": 3, "to_global_id": 141, "spawn_sec": 74}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099040, "race_id": 13, "master_id": 142, "global_id": 141, "from_condition": 3}, {"enemy_id": 10, "source": "local", "count": 11, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 78}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 236, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103248, "change_to": 11, "change_condition": 1, "missile_id": 6, "master_id": 424, "global_id": 423, "ranged": true, "variants": [{"hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "master_id": 423, "global_id": 422}], "spawn_sec": 86}], "dialogue": [{"trigger": "start", "lines": [{"name": "リナリア", "text": "はぁ……夢みたい。\nこんな綺麗な場所があるなんて……♪", "face": "u592"}, {"name": "ネヴィン", "text": "おいおい、さっきから頬が緩みっぱなしだぜ？\nそろそろ王子たちが来る頃だから、気を抜くなよ。", "face": "u407"}, {"name": "ドロテア", "text": "ネヴィンの言うとおりだ、リナリア。\n今後仕える相手に己の力を示すための好機、\n無駄にするでないぞ。", "face": "u408"}, {"name": "ドロテア", "text": "手合わせだからと遠慮せず、全力を出し切れ。\n王子たちに我が一族の有能さを示すのだ。", "face": "u408"}, {"name": "リナリア", "text": "は、はいっ！\nリナリア、精一杯がんばります！", "face": "u592"}, {"name": "ドロテア", "text": "ふふ、いい返事だ。\n我々も我が一族の代表者を送り出すつもりで\n協力させてもらおう。", "face": "u408"}, {"name": "ネヴィン", "text": "――っと。\n来ました、ドロテア様。ヤツらです。", "face": "u407"}, {"name": "アンナ", "text": "お待たせしました、ダークエルフの皆さん。\n本日の手合わせ、よろしくお願いいたします。"}, {"name": "ドロテア", "text": "こちらこそよろしく頼む。\nこの者の力が貴軍に必要かどうか、\nしかとその目で確かめてくれ。", "face": "u408"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "スピカ", "text": "ふん……ダークエルフの射手なんて、\nどうせ大したことないに決まってるんだから。", "face": "u113"}, {"name": "リナリア", "text": "そ、そんなことないですっ！\n王子様、見ててくださいね！\nわたし、がんばりますからっ！", "face": "u592"}]}, {"trigger": "end", "lines": [{"name": "リナリア", "text": "はぁっ、はぁっ……ど、どうでしたか？", "face": "u592"}, {"name": "スピカ", "text": "お、思ったよりやるじゃない。\n……ダークエルフにしては、だけど。", "face": "u113"}, {"name": "アンナ", "text": "ええ、実力は十分に見せていただきました。\nリナリアさん、今後もご協力をお願いできますか。"}, {"name": "リナリア", "text": "は、はいっ！　喜んで！\n…………あ。", "face": "u592"}, {"name": "ドロテア", "text": "ふふ……どうした、遠慮するな。\n王子たちの許に行きたいのだろう？", "face": "u408"}, {"name": "リナリア", "text": "で、でも……。", "face": "u592"}, {"name": "ドロテア", "text": "お前は自ら王子たちに己の有能さを示した。\nそして彼らはお前の力を欲している。\nならば止める道理はあるまい。", "face": "u408"}, {"name": "ドロテア", "text": "さぁ、行って夢を叶えるがいい。\n物質界で人間たちと共に暮らすことが\nお前の夢だったのだろう？", "face": "u408"}, {"name": "リナリア", "text": "ぐすっ……ドロテア様っ……。", "face": "u592"}, {"name": "ドロテア", "text": "リナリア。今日からこの物質界がお前の住処だ。\n王子たちに保護してもらう代わりに彼らに尽くし、\n彼ら人間と我が一族の紐帯の強化に努めろ。", "face": "u408"}, {"name": "ドロテア", "text": "魔界育ちのダークエルフである\nお前にしかできないことが必ずあるはずだ。\n期待しているぞ。", "face": "u408"}, {"name": "リナリア", "text": "……ありがとうございます、ドロテア様。\nわたし、精一杯がんばります！", "face": "u592"}, {"name": "アンナ", "text": "ふふ、話がまとまったようですね。\nそれではリナリアさん、今後もよろしくお願いします。"}]}], "active": true}