226, "spawn_sec": 70}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 57000, "base_hp": 57000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130272, "race_id": 16, "special_effect_id": 222, "change_to": 9, "change_condition": 1, "master_id": 33949, "global_id": 7566, "variants": [{"hp": 57000, "base_hp": 57000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130272, "race_id": 16, "special_effect_id": 841, "master_id": 33950, "global_id": 7567}], "commands": {"raw": "SetStageFlag(0, 0);", "sets_flags": [[0, 0]]}, "route_behaviour": {"sets_flags": [[0, 1, 0]]}, "spawn_sec": 135}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130272, "special_effect_id": 837, "master_id": 33951, "global_id": 7568, "commands": {"raw": "SetStageFlag(1, 0); SetStageFlag(2, 1); SetStageFlag(3, 1);", "sets_flags": [[1, 0], [2, 1], [3, 1]]}, "route_behaviour": {"reroutes": ["Route=999"]}, "spawn_sec": 135}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 50000, "attack": 3000, "base_hp": 50000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 100, "attack_speed": 300, "attack_wait": 120, "attack_interval": 406, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099184, "race_id": 5, "missile_id": 58, "master_id": 160, "global_id": 159, "ranged": true, "spawn_sec": 181}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130272, "special_effect_id": 838, "master_id": 33952, "global_id": 7569, "commands": {"raw": "SetStageFlag(2, 0); SetStageFlag(1, 1);", "sets_flags": [[2, 0], [1, 1]]}, "spawn_sec": 193}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130272, "special_effect_id": 839, "master_id": 33953, "global_id": 7570, "commands": {"raw": "SetStageFlag(3, 0); SetStageFlag(2, 1);", "sets_flags": [[3, 0], [2, 1]]}, "spawn_sec": 224}], "popups": ["アナベラは攻撃を行いませんが、\nアナベラがいる間は\n味方の攻撃、防御、魔法耐性が\n30％ダウンします。\n\nまた一定時間が経過するたびに\nステータスダウン効果が強化され\n最大50％までダウンします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アルヴァ", "text": "――誰も、いない？", "face": "u1198a1"}, {"name": "アトナテス", "text": "いや、気配は微かに感じるな……。\nただ距離感と遮蔽物、それに\nこの吹雪すら利用して、俺たちの実力を制限してやがる。", "face": "u908"}, {"name": "アルヴァ", "text": "知識で武人に対抗しているのか。\nなるほど、万の知識が軍に匹敵するわけだ。", "face": "u1198a1"}, {"name": "ユージェン", "text": "王子、油断するんじゃないぞ。\nまわりから変な気配もしている。\n賢者の連中、防衛のために魔物を招き入れたらしい。", "face": "u906"}, {"name": "？？？", "text": "――そのとおりだ。\nこちらは知識はあれど軍備は少ない。\n魔物の力くらいは利用させてもらおう。", "face": "u1309a1"}, {"name": "アナベラ", "text": "ぼくはアナベラ。\n大賢者さまの代弁者として、王国軍に警告する。", "face": "u1309a1"}, {"name": "アナベラ", "text": "今すぐにここから立ち去れ。\nぼくらは世界との関わりを望んでいない。", "face": "u1309a1"}, {"name": "ルイン", "text": "――そういうわけには、いきません。\n私はルイン、かつて叡智の園の\n賢者によって生み出された兵器です。", "face": "u1180a1"}, {"name": "ルイン", "text": "賢者アナベラさま、お願いがあります。\n物質界は今、天界によって脅威にさらされています。", "face": "u1180a1"}, {"name": "ルイン", "text": "どうか、オリュンポスの結界を突破するために、\n知識を貸してほしいのです。", "face": "u1180a1"}, {"name": "アナベラ", "text": "……その言葉は信じよう。\nぼくらの観測していた事実と相違ない。", "face": "u1309a1"}, {"name": "アナベラ", "text": "だが、かつてぼくらの先祖は、\n長き戦乱を終わらせるべく\n人々に知識を貸し与え――大きな失敗をした。", "face": "u1309a1"}, {"name": "アナベラ", "text": "人は過ぎたる知識を持つべきではない。\n知識と武力は等しく、\n世界を揺るがしうるものなのだから。", "face": "u1309a1"}, {"name": "王子", "text": "……………。", "face": "u1"}, {"name": "アナベラ", "text": "――だが、ひとつだけ。\nぼくの家系には、こんな言葉が伝わっている。", "face": "u1309a1"}, {"name": "アナベラ", "text": "――心なき自動人形が、\nいつか誰かのために戦うことを決め、\n知識を求めたのなら、その覚悟を受け止めてやりなさい。", "face": "u1309a1"}, {"name": "ルイン", "text": "――それは……。\nもしかして、その言葉の主は……。", "face": "u1180a1"}, {"name": "アナベラ", "text": "さて、先祖が何者かまで語るつもりはない。\n――ぼくの役割は、きみたちが\n知識を得るに値するか、見極めることだけだ。", "face": "u1309a1"}, {"name": "エターナー", "text": "やれやれ、叡智の園まで来て腕試しとは。\n――王子、アナベラにあまり時間を与えるな。\nこちらの動きを分析されれば、さらに苦戦することになる。", "face": "u298"}, {"name": "ティール", "text": "周囲からゴーレムの起動音も聞こえてきます！\nルインさんを作った里なんですから、\n当然警備ゴーレムもいますよねぇ……！", "face": "u615"}, {"name": "アンナ", "text": "状況は完全にこちらが不利です。\n王子、慎重な指揮をお願いします！", "face": "le565c05faac8"}]}, {"trigger": "end", "lines": [{"name": "アナベラ", "text": "…………ぼくの防衛網を突破するか。\n見事な采配と言うべきかな。", "face": "u1309a1"}, {"name": "アナベラ", "text": "蓄積した経験も、またひとつの知識。\nどうやら天界と戦うという決意は\n実力に見合ったもののようだ。", "face": "u1309a1"}, {"name": "ルイン", "text": "では……。", "face": "u1180a1"}, {"name": "アナベラ", "text": "ああ、少なくともぼくは、\nきみたちが里に踏み入ることを認めよう。\n他でもない、ご先祖さまの愛娘の頼みでもあるしね。", "face": "u1309a1"}, {"name": "ルイン", "text": "…………はぅ。", "face": "u1180a1"}, {"name": "アナベラ", "text": "――ただ、その前にひと仕事しないといけないようだ。\n今日は随分と、お客さんが多いようでね。", "face": "u1309a1"}, {"name": "天槍騎兵団長", "text": "……驚いた。\nこの距離から、もう我々に気づいたか。", "face": "lcbd1385d4f33"}, {"name": "スルーズ", "text": "姉さま……！\nどうしてここに！？", "face": "u1143a1"}, {"name": "天槍騎兵団長", "text": "我らが主は、叡智の園の破壊をお望みだ。\n知識を持てば、人は過ぎたる夢を抱く。\n無知なる安寧に、叡智なるものは必要ないからな。", "face": "lcbd1385d4f33"}, {"name": "アナベラ", "text": "……それには同意するよ。\n戦乱の時代を引き起こした元凶のひとつは、\n間違いなくぼくらの知識だからね。", "face": "u1309a1"}, {"name": "アナベラ", "text": "――でも、知識は得難く、尊いものだ。\nそれを破壊すると言われて\n引き下がるほど、ぼくらも熱を失ってはいない。", "face": "u1309a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アナベラ", "text": "ははっ、きみ、そういう顔もできるんだ。\n悪いけど、手を貸してくれるかな。\n――ぼくは、あいつらの言動が気に入らないんだよ。", "face": "u1309a1"}]}], "active": true}