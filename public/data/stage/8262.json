ion": 2, "missile_id": 45, "master_id": 30561, "global_id": 4180, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 208}, {"enemy_id": 43, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 20, "attack_interval": 82, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152656, "special_effect_id": 1160, "master_id": 37434, "global_id": 11051, "spawn_sec": 221}, {"enemy_id": 44, "source": "local", "count": 1, "form_count": 1, "tags": ["ハニー", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 150000, "attack": 500, "base_hp": 150000, "base_attack": 500, "damage_type": "magical", "armor_defense": 500, "magic_defense": 90, "attack_wait": 40, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2113824, "special_effect_id": 1160, "change_to": 44, "master_id": 37412, "global_id": 11029, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 223}], "popups": ["第三形態の魔神セーレがいる間は\n敵のハニーの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "魔剣カオス", "text": "おい、ランスよ。\nあの魔神ふざけた姿だが、ちとまずいぞ。", "face": "le2e11fea1f65"}, {"name": "ランス", "text": "わかっとる！\nだが……ぐぬぬぬぬ、力が出んのだ！！", "face": "l56c324708564"}, {"name": "魔剣カオス", "text": "……くぅぅ、マジン違いとはいえ\nヤツをぶった斬るとなれば儂の出番なのに！", "face": "le2e11fea1f65"}, {"name": "バルバストラフ", "text": "ふむ……確か、ランスのハイパー……兵器？\nが失われたのは、魔神セーレの転移術の影響じゃったの。", "face": "u63"}, {"name": "サイラス", "text": "セーレの魔力が濃いこの場所でなら、\n術の解析も可能かもしれないな。", "face": "u13"}, {"name": "ランス", "text": "な、なんだと！　今やれ！　すぐやれ！", "face": "l56c324708564"}, {"name": "サイラス", "text": "しかし……むぅ、魔神の術となれば、\nどれだけ解析に時間がかかることか……。", "face": "u13"}, {"name": "ランス", "text": "……あっ、あぁぁぁぁ！！\nそうか、魔法を無効化すればいいんだな！？", "face": "l56c324708564"}, {"name": "バルバストラフ", "text": "お、おぉ？　どうしたランス殿。", "face": "u63"}]}, {"trigger": "start", "lines": [{"name": "ランス", "text": "魔法無効化ならそこにおるじゃないか！\nぐふふ、リズナちゃん、\n俺様のハイパー兵器跡地をやさぁしく撫でるのだ！", "face": "l56c324708564"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "フェリス", "text": "ちょっとランス！\nこんな時に何いたずらしようとしてるのよ！", "face": "u2159a1"}, {"name": "ランス", "text": "何がいたずらか！\nさぁリズナちゃん、いま！　すぐ！　ここで！", "face": "l56c324708564"}, {"name": "リズナ", "text": "えっ、えぇっ、ここで……？\nその……恥ずかし……。", "face": "u2155a1"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "ハニーＡ", "text": "うおーっ、リズナちゃんをいじめるなー。", "face": "l0a288895e9cd"}, {"name": "ハニーＢ", "text": "リズナちゃんをまもれー。", "face": "l0a288895e9cd"}]}, {"trigger": "battle", "at_sec": 12, "lines": [{"name": "グリム", "text": "あっ、ランスさんの股間にハニーさんの頭突きがー。", "face": "u942"}, {"name": "ランス", "text": "ぐぉぉぉおぁあぁっ！？", "face": "l56c324708564"}, {"name": "グリム", "text": "……えっ、あれ？\n冗談だと思ってましたけど、\n本当に何かの魔力が砕けましたよ？", "face": "u942"}]}, {"trigger": "battle", "at_sec": 13, "lines": [{"name": "ランス", "text": "お、お、おおおぉぉぉ！！\n治ったああああああ！！", "face": "l56c324708564"}, {"name": "シィル", "text": "えーーーっ！？", "face": "u581"}, {"name": "ランス", "text": "ぐふふふ、俺様復活！　ハイパー兵器ふっかーつ！！", "face": "l56c324708564"}, {"name": "グリム", "text": "魔法が効かないのと魔法を打ち消すの、\n全然違う理論なはずなんですけどー……。\nあ、あの、後で分解させてもらえませんか？", "face": "u942"}, {"name": "ハニーＡ", "text": "やだー。", "face": "l0a288895e9cd"}, {"name": "ハニーＢ", "text": "めがねっこじゃないからやだー。", "face": "l0a288895e9cd"}]}, {"trigger": "battle", "at_sec": 18, "lines": [{"name": "魔神セーレ", "text": "ま、またもや巫山戯たマネをぉぉぉ……！！", "face": "lf83406422d06"}, {"name": "魔神セーレ", "text": "もはや許さぬ！\nここで殺してくれるぞ、ランスぅぅぅぅぅッ！！", "face": "lf83406422d06"}]}, {"trigger": "battle", "at_sec": 21, "lines": [{"name": "ランス", "text": "ふん、死ぬのはお前だ。", "face": "l56c324708564"}, {"name": "ランス", "text": "異世界の魔神退治だ！\n行くぞシィル！　それと王子！", "face": "l56c324708564"}, {"name": "シィル", "text": "は、はい！　ランス様！", "face": "u581"}, {"name": "王子", "text": "…………（にこにこ）", "face": "u1"}]}, {"trigger": "battle", "at_sec": 222, "lines": [{"name": "魔神セーレ", "text": "お、おのれ、おのれぇぇぇッ！\nなぜだ、何なのだ、そのデタラメな力は！", "face": "lf83406422d06"}, {"name": "ランス", "text": "知るか。\n貴様、俺様に迷惑ばかりかけおって。", "face": "l56c324708564"}, {"name": "ランス", "text": "死ねぇー！！\nランスあたたたーっく！！", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "まだ、まだだ……。\n魔神たるこの身、これしきの攻撃で砕けは――", "face": "lf83406422d06"}, {"name": "グリム", "text": "――ッ！？\nわ、わわわ、何だかすごい次元の歪みがぁ！？", "face": "u942"}]}, {"trigger": "end", "lines": [{"name": "ハニーＡ", "text": "わー、ハニーキングさまだー。", "face": "l0a288895e9cd"}, {"name": "グリム", "text": "えぇぇっ、私っ、\n異界の門開いてないですよー！？\n自力で異世界転移できるんですか！？", "face": "u942"}]}, {"trigger": "end", "lines": [{"name": "魔神セーレ", "text": "な、何者だ！？\n何をするつもりなのだぁぁぁッ！？", "face": "lf83406422d06"}]}, {"trigger": "end", "lines": [{"name": "魔神セーレ", "text": "くっ、か、身体が――魂が砕け……ッ！？\nやめろっ！　貴様ッ、私は、魔神セーレだぞ！？", "face": "lf83406422d06"}, {"name": "魔神セーレ", "text": "ぐわぁぁぁぁぁぁぁッ！！", "face": "lf83406422d06"}, {"name": "魔神セーレ", "text": "…………。\n……………………。", "face": "lf83406422d06"}]}, {"trigger": "end", "lines": [{"name": "グリム", "text": "あっ、ハニーキングが帰っていきます。\nうわぁ、また自前で異界の門まで……。", "face": "u942"}, {"name": "ハニーＢ", "text": "ばいばーい。", "face": "l0a288895e9cd"}]}, {"trigger": "end", "lines": [{"name": "ホーネット", "text": "ハニーキングの攻撃で、\n魔神セーレは消滅したようですね……。", "face": "u2157a1"}, {"name": "ウルザ", "text": "私たちに倒された後での追い打ち、\n今度こそ、本当に決着がつきましたか。", "face": "u2158a1"}, {"name": "ランス", "text": "がはははははッ！\n俺様の女に手を出した報いだ！", "face": "l56c324708564"}, {"name": "ランス", "text": "シィル、拍手！", "face": "l56c324708564"}, {"name": "シィル", "text": "はいっ、ぱちぱち！", "face": "u581"}, {"name": "グリム", "text": "ふぃー、何だかすごいことになりましたけど、\nとりあえず王国に戻りましょうか。\nみなさーん、こっちですよー。", "face": "u942"}]}], "active": true}