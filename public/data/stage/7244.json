": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 14, "master_id": 796, "global_id": 795, "to_global_id": 484, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 163}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 15, "master_id": 485, "global_id": 484, "to_global_id": 625}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 14, "master_id": 626, "global_id": 625}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 15, "master_id": 485, "global_id": 484, "to_global_id": 625, "spawn_sec": 177}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 14, "master_id": 626, "global_id": 625}], "dialogue": [{"trigger": "start", "lines": [{"name": "オーガスタ", "text": "――なるほど、このチョコ細工をオトリに、\n虫をおびき出して、\nチョコを食べている間に倒してしまおうと。", "face": "u1153a1"}, {"name": "エレット", "text": "ただ街全体に配置するには、\nちょっと数が足りないんだよね……。\nうーん、どうしようかなぁ。", "face": "u1152a1"}, {"name": "オーガスタ", "text": "ああ、それなら私が何体か作りましょうか。\n幸いチョコ彫刻用に、\n大きなチョコを用意していたので。", "face": "u1153a1"}, {"name": "デーモンシェフ", "text": "なっ……オーガスタ嬢、舐めてもらっては困るぞ。\nあのチョコ細工技術を身につけるために、\n我々がどれだけ修行を重ねたか――", "face": "l20ec5642c69a"}, {"name": "オーガスタ", "text": "――ふふ、デーモンシェフこそ、\nケラウノス様のお抱えシェフを\n舐めてもらっては困りますよ。", "face": "u1153a1"}, {"name": "デーモンシェフ", "text": "なっ……何だあのナイフさばきは！？\nチョコがまたたく間に等身大デーモンチョコに！？", "face": "l20ec5642c69a"}, {"name": "オーガスタ", "text": "ふぅ、お菓子は専門外なので、\nさすがに本物には負けてしまいますが、\nこんなところでいかがでしょう？", "face": "u1153a1"}, {"name": "デーモンシェフ", "text": "……くっ……これが一芸を極めた者の技術か。\n完敗だ、完敗だよオーガスタ嬢。", "face": "l20ec5642c69a"}, {"name": "オーガスタ", "text": "いえ、お手本が量産を考えられた\n優秀なデザインだったからこそですよ。", "face": "u1153a1"}, {"name": "エレット", "text": "……ど、どうしよう。\n作戦前なのに、料理人同士の友情が芽生えてないかな。", "face": "u1152a1"}, {"name": "エメルダ", "text": "仲が悪いよりはいいんじゃないかな。\nそれよりエレット、こっちも準備を始めよう。\n私は王子たちの部隊を呼んでくるね。", "face": "u964"}, {"name": "エレット", "text": "うんっ、よろしくね！\nこっちは釣られて出てくる虫を叩いていくから！", "face": "u1152a1"}, {"name": "エレット", "text": "よぉし、バレンタイン同盟のらぶぱわー！\n虫たちに思い知らせてやるんだから！", "face": "u1152a1"}]}, {"trigger": "end", "lines": [{"name": "エレット", "text": "バレンタイン同盟、大勝利ー！", "face": "u1152a1"}, {"name": "オーガスタ", "text": "ふふ、チョコ作戦大成功ですね。\nこの調子で街中の虫を掃討しましょうか。", "face": "u1153a1"}, {"name": "エレット", "text": "そうだね。ついでに事件の黒幕も\n引きずりだしたいところだけど……。", "face": "u1152a1"}, {"name": "女王蜘蛛", "text": "――ぅ……あぁ……。\nここはどこなの……かしら……。", "face": "ldacf78972b65"}, {"name": "エレット", "text": "あれ……？\nあそこにいるのって、\n世界樹に住んでる女王蜘蛛さんじゃ……。", "face": "u1152a1"}, {"name": "女王蜘蛛", "text": "わたくしの民は……どこ……どこに……。\nああっ……熱い……身体が熱い……っ！", "face": "ldacf78972b65"}, {"name": "エレット", "text": "女王蜘蛛さん！　大丈夫！？\nどこか怪我してるの！？", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "むっ……下がれエレット嬢、オーガスタ嬢！\nこのむせ返るような香りは……！\n女王蜘蛛はフェロモンで操られているぞ！", "face": "l20ec5642c69a"}, {"name": "魔界アリの女王", "text": "くふふ……さすがは\n魔界一の知恵者と謳われた男よ。\n妾のフェロモンに気付くとはなぁ。", "face": "l4dbb867a1051"}, {"name": "エレット", "text": "魔界アリの女王……！\nオスにしか効かないフェロモンで、\n女王蜘蛛を操ったっていうの……？", "face": "u1152a1"}, {"name": "魔界アリの女王", "text": "ふふ、効かぬなら、効くように作り変えればよいこと。\nそう……料理することによってなぁ！", "face": "l4dbb867a1051"}, {"name": "キホル", "text": "――えっへん。\n魔界一の料理人、キホルちゃん参上ぅー♪", "face": "u1159a1"}]}], "active": true}