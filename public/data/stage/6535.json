d": 8, "source": "local", "count": 6, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 97}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 3800, "attack": 630, "base_hp": 3800, "base_attack": 630, "damage_type": "physical", "armor_defense": 240, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 16, "master_id": 31167, "global_id": 4786, "spawn_sec": 141}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "attack": 320, "base_hp": 1000, "base_attack": 320, "damage_type": "physical", "armor_defense": 170, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 16, "master_id": 31164, "global_id": 4783, "spawn_sec": 149}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 14000, "attack": 350, "base_hp": 14000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 15, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115376, "race_id": 16, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 31162, "global_id": 4781, "ranged": true, "spawn_sec": 174}], "popups": ["\n\n\n　　　～公演当日・終盤～"], "dialogue": [{"trigger": "start", "lines": [{"name": "紅牡丹", "text": "よぉし、ここまでは順調っと。\n観客も目をきらきらさせてやがる……！", "face": "u661"}, {"name": "カズハ", "text": "はぁ……はぁ……お稽古の時より、\n緊張のせいか体力を使いますね……。", "face": "u235"}, {"name": "紅牡丹", "text": "そういうものさ。\nでも皆、本当にいい顔してるよ。\nこれが舞台役者の顔ってやつさ。", "face": "u661"}, {"name": "紅牡丹", "text": "しかし、泣いても笑っても、\n次の大立ち回りが最後の場面だ！", "face": "u661"}, {"name": "イロハ", "text": "そうですね、頑張らないと……！", "face": "u242"}, {"name": "紅牡丹", "text": "おっと、それから舞台の上ってのは、\n立ち位置が重要になるからね。", "face": "u661"}, {"name": "紅牡丹", "text": "他の者と被らず、見栄えのする場所が大事ってことさ。\nアタシの指定した場所で構えるようにね！", "face": "u661"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "紅牡丹", "text": "よしよし、それじゃあ最後の大立ち回り、\n張り切って行ってみようか！！", "face": "u661"}]}, {"trigger": "battle", "at_sec": 100, "lines": [{"name": "紅牡丹", "text": "おや……？\nあんな衣装用意した覚えはないぞ？", "face": "u661"}, {"name": "アオバ", "text": "かまいたち……あれは本物の妖怪です！\nまさか紛れ込んでいるなんて……。", "face": "u441"}, {"name": "紅牡丹", "text": "なんてこった！\n早く観客を逃さないと……って、どうしたアンナ？", "face": "u661"}, {"name": "アンナ", "text": "――このまま演技を続けてください。\n大丈夫です、ここには私達がいますから。\nそうですよね、王子？", "face": "l305cf5cf6dd1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "紅牡丹", "text": "…………へぇ、わかった。\nあんた達がそう言うんなら、任せてみるよ！", "face": "u661"}]}, {"trigger": "end", "lines": [{"name": "ソーマ", "text": "わぁ……！　すごい拍手の音です！", "face": "u23"}, {"name": "足軽", "text": "また、またこんな熱いかぶきが観られるとは……！\nくぅっ、生きてて良かったぁ……！", "face": "u141"}, {"name": "紅牡丹", "text": "へへっ、大成功だったな。\nこれも全部、手伝ってくれた王子達のおかげだ！", "face": "u661"}, {"name": "アンナ", "text": "紅牡丹さんが、丁寧に教えてくれたからですよ。\nこちらも貴重な体験ができましたし。"}, {"name": "紅牡丹", "text": "でも……これでお別れたぁ寂しいな。\n約束しちまったもんは仕方ないが……。", "face": "u661"}, {"name": "イロハ", "text": "紅牡丹さん……。", "face": "u242"}, {"name": "シズカ", "text": "――いいえ、こんなに素晴らしい舞台、\nここで終わってしまっては勿体無いわ。", "face": "u101"}, {"name": "紅牡丹", "text": "ひ、姫侍……シズカ様ぁ……！？", "face": "u661"}, {"name": "シズカ", "text": "東の国の復興は未だ道半ば。\n民を元気付ける為にも、\nこの一座で、都での公演をしてくれないかしら。", "face": "u101"}, {"name": "紅牡丹", "text": "あ、アタシは……望むところだけど……。\nでも王子達は今、視察の旅の途中で……。", "face": "u661"}, {"name": "アンナ", "text": "……王子、いかがでしょう？\n東の国の復興を助けることにも繋がると思いますし、\n紛れ込んでいた妖怪のことも気がかりです……。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "紅牡丹", "text": "お、王子……皆……ッ！！\nよ、よぉし、それなら更に稽古に力を入れないとな！", "face": "u661"}, {"name": "紅牡丹", "text": "何しろ次の公演会場は、\nとびっきりでっかい舞台だ……！！", "face": "u661"}]}], "active": true}