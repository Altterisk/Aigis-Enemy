{"quest_id": 7485, "name": "おもちゃ工場に紛れ込む者", "description": "デモシェフ商会の新おもちゃ工場で\n謎の機械部品の調査を行う王子一行。\nすると、何やら見慣れない社員がいて……？\n上級（★１獲得の目安：平均Lv10）", "event": "クリスマス・デストロイヤー", "event_category": "History", "mission_id": 920170, "map_no": 4004, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 17, "form_count": 2, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131840, "race_id": 16, "change_to": 1, "master_id": 34215, "global_id": 7832, "to_global_id": 7833, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 34216, "global_id": 7833}, {"enemy_id": 3, "source": "local", "count": 11, "form_count": 2, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131856, "race_id": 16, "change_to": 3, "master_id": 34217, "global_id": 7834, "to_global_id": 7835, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 51}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "change_to": 2, "master_id": 34218, "global_id": 7835}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 3200, "attack": 220, "base_hp": 3200, "base_attack": 220, "damage_type": "physical", "armor_defense": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 162, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 1, "spawn_sec": 65}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131872, "race_id": 16, "special_effect_id": 891, "change_to": 6, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 34219, "global_id": 7836, "ranged": true, "to_global_id": 7837, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 93}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103536, "race_id": 16, "special_effect_id": 61, "change_to": 5, "master_id": 34220, "global_id": 7837}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 119}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 331, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131888, "race_id": 16, "special_effect_id": 891, "change_to": 9, "missile_id": 26, "master_id": 34221, "global_id": 7838, "ranged": true, "to_global_id": 7839, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 127}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109072, "race_id": 16, "special_effect_id": 61, "change_to": 8, "master_id": 34222, "global_id": 7839}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 162}], "popups": ["アサシンから受けたダメージは\n２倍になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンシェフ", "text": "――なに？\n我が新おもちゃ工場から発送した箱に、\n機械の部品が混入されていたと？", "face": "lf28f528005ca"}, {"name": "ヘレナ", "text": "ああ、それもパーツが外れたって感じじゃない。\n何かの巨大な機械の一部だけが\nクリスマスプレゼントの箱に入っていたんだ。", "face": "u1397a1"}, {"name": "デーモンシェフ", "text": "むっ……むむむっ、それは由々しき事態だ！\n良い子が怪我でもしたら大変だぞ！", "face": "lf28f528005ca"}, {"name": "デーモンシェフ", "text": "副デーモンシェフよ、\n発送済みのプレゼントを急ぎ調査するのだ！", "face": "lf28f528005ca"}, {"name": "副デーモンシェフ", "text": "はっ！　デモシェフ商会全社に通達いたします！", "face": "lfa4ceac01385"}, {"name": "デーモンシェフ", "text": "我々は新たな異物混入がないか、工場内を調査するぞ。\n悪意ある何者かの営業妨害の可能性もある。\n子どもたちの安全を守るため、全力で捜索するのだ！", "face": "lf28f528005ca"}, {"name": "ヘレナ", "text": "……いいのか？\nデーモンシェフ、ここで工場を止めたら、\nお前たちの損害も大きくなるだろうに。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "私たちは工場内の調査さえさせてくれれば――", "face": "u1397a1"}, {"name": "デーモンシェフ", "text": "いや、ヘレナ殿、それでは駄目なのだ。\nデモシェフ商会は安心と信頼でなりたっているのだから。", "face": "lf28f528005ca"}, {"name": "デーモンシェフ", "text": "これは子どもたちを守ると同時に、\n社員の生活を守るために、絶対に必要な調査なのだ。", "face": "lf28f528005ca"}, {"name": "ヘレナ", "text": "……ふふっ、あははっ！\nそうだな、さすがデーモンシェフ、\nこちらが学ばされたよ。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "よし、王子、デーモンシェフ、\n急いで工場内の調査を進めよう。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "工場のラインだけじゃなく、\n怪しい人物にも注意を――", "face": "u1397a1"}, {"name": "デーモンシェフ", "text": "――むっ、そこの作業員どこへいく。\n倉庫はそちらではないぞ？\n……いや待て、貴様、みかけない顔だな。", "face": "lf28f528005ca"}, {"name": "作業員？", "text": "ぎくっ……い、いえ、\n実は今日から配属になったばかりで……。", "face": "l284a85e2b734"}, {"name": "デーモンシェフ", "text": "こう見えて、社員の顔と名前は全員覚えているのだ。\nたとえ今日から配属になった社員であってもな。", "face": "lf28f528005ca"}, {"name": "ヘレナ", "text": "最初から大当たりみたいだ。\n王子、作業員の中に闇組織の構成員が紛れ込んでいるぞ！", "face": "u1397a1"}, {"name": "闇組織構成員", "text": "ちっ！　てめぇら、脱出するぞ！", "face": "l284a85e2b734"}, {"name": "ヘレナ", "text": "デーモンシェフは作業員の避難を！\n王子、構成員どもを一網打尽にするぞ！", "face": "u1397a1"}]}, {"trigger": "end", "lines": [{"name": "闇組織構成員", "text": "くっ……このままでは、\nクリスマス・デストロイ作戦が……ぐふっ……。", "face": "l284a85e2b734"}, {"name": "ヘレナ", "text": "くりすます・ですとろい作戦……？\n例の機械部品で、いったい何をするつもりなんだ！", "face": "u1397a1"}, {"name": "闇組織構成員", "text": "い、言えない……言えば俺たちも殺されちまう……。", "face": "l284a85e2b734"}, {"name": "ヘレナ", "text": "自分の部下を殺すような指揮官がいるものか。\n――いや、闇の組織なら、それが普通なのか？", "face": "u1397a1"}, {"name": "アイリーン", "text": "闇の組織の幹部は、いずれも凶悪な犯罪者。\n部下のことも、使い捨てだと思っているかもしれませんね。", "face": "u315"}, {"name": "ヘレナ", "text": "嫌な連中だよ、まったく。\n人の命を何だと思っているんだ。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "ともかく、工場内の調査を続けようか。\nまだ闇の組織の構成員が潜んでいるかもしれない。", "face": "u1397a1"}]}], "active": true}