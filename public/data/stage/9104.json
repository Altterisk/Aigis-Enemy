ve_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109872, "race_id": 16, "special_effect_id": 72, "missile_id": 198, "missile": {"speed": 12.0}, "master_id": 30205, "global_id": 3824, "ranged": true, "spawn_sec": 61}, {"enemy_id": 8, "source": "local", "count": 37, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098160, "master_id": 92, "global_id": 91, "spawn_sec": 105}, {"enemy_id": 9, "source": "local", "count": 16, "form_count": 1, "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100624, "race_id": 18, "special_effect_id": 220, "master_id": 272, "global_id": 271, "spawn_sec": 118}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "magical", "armor_defense": 150, "magic_defense": 30, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109920, "missile_id": 197, "missile": {"speed": 6.0, "splash": 80}, "master_id": 30249, "global_id": 3868, "ranged": true, "spawn_sec": 126}, {"enemy_id": 11, "source": "local", "count": 10, "form_count": 1, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "magical", "armor_defense": 400, "attack_range": 200, "attack_speed": 90, "attack_wait": 60, "attack_interval": 181, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109984, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30239, "global_id": 3858, "ranged": true, "spawn_sec": 171}, {"enemy_id": 12, "source": "local", "count": 24, "form_count": 1, "hp": 4000, "attack": 450, "base_hp": 4000, "base_attack": 450, "damage_type": "physical", "armor_defense": 800, "magic_defense": 90, "attack_speed": 90, "attack_wait": 20, "attack_interval": 181, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100992, "race_id": 16, "special_effect_id": 227, "master_id": 308, "global_id": 307, "spawn_sec": 175}, {"enemy_id": 13, "source": "local", "count": 6, "form_count": 1, "tags": ["ステルス"], "hp": 30000, "attack": 1300, "base_hp": 30000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 95, "attack_interval": 273, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116688, "missile_id": 329, "missile": {"speed": 7.0}, "master_id": 31398, "global_id": 5017, "ranged": true, "spawn_sec": 221}, {"enemy_id": 14, "source": "local", "count": 10, "form_count": 1, "tags": ["ステルス"], "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "physical", "armor_defense": 550, "magic_defense": 10, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099568, "master_id": 11, "spawn_sec": 242}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 1000, "base_hp": 2000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_range": 300, "attack_speed": 70, "attack_wait": 90, "attack_interval": 253, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109888, "race_id": 16, "missile_id": 26, "master_id": 30206, "global_id": 3825, "ranged": true, "spawn_sec": 294}], "popups": ["妖霊使いは\nジン、シャイターンがいる間、\nダメージを受けません。\n以下の条件を満たすと弱体化し\nダメージを与える事ができます。\n\n・両方を倒す\n・両方が拠点に到達する"], "dialogue": [{"trigger": "start", "lines": [{"name": "戦神マレス", "text": "――これより、戦神コロッセウム、\n人類最強決定戦・砂漠の部、決勝戦を執り行う。", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "祈り、願い、決意……。\n戦いに挑む理由は数多あれど、\nそれはただ、ひとつしか叶えられないものだ。", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "すなわち、勝者こそが！\n敗者全てを平らげる、強き者だけがッ！\n己が意志を世界に示すことが出来るッ！！", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "もはや多くは語らぬッ！！\n戦士たちよ、勝利をもって最強を証明するがいいッ！！", "face": "lc23d3669b6ff"}, {"name": "観客Ａ", "text": "うぉぉぉぉぉッ！！", "face": "la14390605630"}, {"name": "観客Ｂ", "text": "うぉぉぉぉッ！！\n熱き戦いを見せてくれ！！", "face": "l03ef504c38ba"}, {"name": "アナトリア", "text": "魔界武術大会ぶりかねぇ……。\nこんな声援の中で戦うのは。", "face": "u522"}, {"name": "ドゥーラ", "text": "あいつ、ただの卑怯者じゃないな……。\nどうにも血の匂いが濃すぎる。", "face": "u446"}, {"name": "ネフティ", "text": "……あの者は、砂漠の国の闇に生きてきた術者です。\n国を守るため、維持するために、\nあらゆる行為に手を染めてきた者……。", "face": "u551"}, {"name": "ネフティ", "text": "外敵あらば妖霊にて薙ぎ払い、\n国に巣食う虫あらば、同胞とて手に掛ける。", "face": "u551"}, {"name": "ネフティ", "text": "決して表に出ることなく、栄誉も汚名も持たぬ者。\nされど、王子とホルエス様のおかげで、\n彼らもまた、表舞台に出ることが可能となりました。", "face": "u551"}, {"name": "ホルエス", "text": "それが彼にとって良いことだったのかどうか、\nそれは別の話、ですけどね。", "face": "u149"}, {"name": "ホルテウス", "text": "……見れば分かるだろう？\nあの者は、歓喜と興奮に打ち震えておる。", "face": "u1373a1"}, {"name": "ホルテウス", "text": "歓声の中、父なる陽光のもとで、\n己がすべての実力を振るうという初めての舞台に、\nただただ、喜んでいるのだろう。", "face": "u1373a1"}, {"name": "戦神マレス", "text": "後はただ、祈るがいい。\n俺様にではない。己が信ずる鍛錬の日々に祈りを捧げよ。", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "いざ、時は来たッ！！\n双方、武器を構えよ。\nこれより決勝戦を――開始するッ！！", "face": "lc23d3669b6ff"}, {"name": "ネフティ", "text": "王子、あやつの妖霊はニ種。\n渦巻く風のジン、そしてランプの精たるシャイターン。", "face": "u551"}, {"name": "ネフティ", "text": "そのどちらをも倒さねば、\nあの者を倒すことはできません。\n迅速にして慎重な指揮をお願いします！", "face": "u551"}]}, {"trigger": "end", "lines": [{"name": "戦神マレス", "text": "――そこまでッ！！\n勝者は……王国、王国の王子ィッ！！", "face": "lc23d3669b6ff"}, {"name": "プロエ", "text": "妖霊使いは――おや？　消えた？", "face": "u1768a1"}, {"name": "戦神マレス", "text": "２位の栄光はいらない……いや、違うな。\nただこの戦いに挑み、勝ち抜き、\n王子に敗北したことで十分だということか。", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "ハハハッ、やはり戦士とは、\nどいつもこいつも変わり者ばかりだ！", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "王子よ、人類最強決定戦・砂漠の部、\nその初代優勝者は貴様だ。\n見事……実に見事な戦いぶりだった！", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "勝者には褒美がなければならぬ！\n狩りならば最も良い肉を、\n戦場ならば勝利と領地を！", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "そして我がコロッセウムならば、\n「栄誉」と戦神マレスが「加護」を授けよう！", "face": "lc23d3669b6ff"}, {"name": "プロエ", "text": "おめでとう、王子殿下。\n貴殿ならば、勝ち抜くと思っていたぞ。", "face": "u1768a1"}, {"name": "プロエ", "text": "では、私は本来の職務に戻ろう。\nまた次の大会でも、\n貴殿の案内役を務めたいもの――", "face": "u1768a1"}, {"name": "戦神マレス", "text": "待てプロエ、「栄誉」がどこへ行く。", "face": "lc23d3669b6ff"}, {"name": "プロエ", "text": "は？　えっ？　それはどういう……？", "face": "u1768a1"}, {"name": "戦神マレス", "text": "戦神マレスが手塩にかけて育てた戦士、\n戦の聖霊たる貴様を、王国への大使として常駐させる。\nウルカノと仲良くするがいい。", "face": "lc23d3669b6ff"}, {"name": "ウルカノ", "text": "……優勝賞品として、\n王国に亜神の大使を置きますってことか？", "face": "u1669a1"}, {"name": "戦神マレス", "text": "俺様は王子を気に入った。\n戦いぶり、遠征の逸話、戦場の有り様、\nすべてをくまなく俺様に伝えるがよい。", "face": "lc23d3669b6ff"}, {"name": "プロエ", "text": "えっ、ま、また仕事が、増え……。", "face": "u1768a1"}, {"name": "ウルカノ", "text": "……諦めろ、プロエ。\nこいつには言語が通じない。", "face": "u1669a1"}, {"name": "戦神マレス", "text": "さぁ諸君！\n次の戦神コロッセウムも楽しみにしておくがよい！", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "戦いとは物語である！\nそして物語とは、決して終わること無く紡がれ続ける！", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "ゆえに、戦いは終わらず！\n戦士たちよ、次なる戦に向け、武技を磨き続けよ！\nハーッハッハッハッハァ！！", "face": "lc23d3669b6ff"}]}], "active": true}