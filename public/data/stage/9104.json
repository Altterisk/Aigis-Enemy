{"quest_id": 9104, "name": "決勝Lv.1", "description": "声援が鳴り響く中、王子は決勝戦に挑む。\n妖霊使いとの戦いに勝利せよ！\n＜出撃時の初期HP減少：極大＞\n＜ユニット、アイテムのドロップなし＞", "modifier_notes": ["出撃時の初期HP減少：極大", "ユニット、アイテムのドロップなし"], "event": "デザートストーム", "event_category": "History", "mission_id": 920194, "map_no": 7115, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [95], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルス"], "fixture": true, "hp": 600, "attack": 600, "base_hp": 600, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 1, "attack_wait": 100, "attack_interval": 242, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2097200, "special_effect_id": 604, "master_id": 32868, "global_id": 6486, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルス"], "fixture": true, "hp": 600, "attack": 600, "base_hp": 600, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 1, "attack_wait": 100, "attack_interval": 242, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2097200, "special_effect_id": 605, "master_id": 32869, "global_id": 6487, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 72000, "attack": 1000, "base_hp": 72000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 25, "attack_range": 300, "attack_speed": 60, "attack_wait": 90, "attack_interval": 225, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2143424, "race_id": 16, "special_effect_id": 1289, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 36011, "global_id": 9628, "ranged": true, "commands": {"raw": "DoEnemy_SetInvincible(1); DoEnemy_Re