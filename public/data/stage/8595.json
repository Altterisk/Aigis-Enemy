, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 177}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 179}, {"enemy_id": 10, "source": "local", "count": 5, "form_count": 1, "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 25, "attack_range": 180, "attack_speed": 1, "attack_wait": 45, "attack_interval": 153, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160480, "change_to": 10, "change_condition": 1, "missile_id": 1262, "missile": {"speed": 9.0}, "master_id": 38890, "global_id": 12507, "ranged": true, "variants": [{"hp": 8000, "attack": 850, "base_hp": 8000, "base_attack": 850, "damage_type": "physical", "armor_defense": 250, "magic_defense": 25, "attack_speed": 1, "attack_wait": 15, "attack_interval": 70, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160496, "master_id": 38891, "global_id": 12508}], "spawn_sec": 199}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "hp": 5000, "attack": 550, "base_hp": 5000, "base_attack": 550, "damage_type": "magical", "armor_defense": 100, "magic_defense": 60, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 185, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2160512, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 38892, "global_id": 12509, "ranged": true, "spawn_sec": 204}, {"enemy_id": 13, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097952, "race_id": 9, "change_to": 13, "change_condition": 1, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 54, "global_id": 53, "ranged": true, "variants": [{"hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 24, "attack_wait": 1, "attack_interval": 51, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097968, "race_id": 9, "master_id": 55, "global_id": 54}], "spawn_sec": 214}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 717, "global_id": 716, "spawn_sec": 253}], "popups": ["\n\n\n──ジューンブライドの祝祭当日。", "迷宮の悪霊のゴーストは、\nブロックされていない間は味方の\n遠距離攻撃の対象になりません。", "迷宮の悪霊のゴーストは\n一定範囲内のユニットの\n攻撃力と防御力を\n70％ダウンさせます。\n\nまた複数のゴーストによる\nこの効果は重複しません。", "花冠をつけて祝福する\n迷宮の悪霊のゴーストは、\nブロックされていない間は味方の\n遠距離攻撃の対象になりません。\n\n花冠をつけて祝福する\n迷宮の悪霊のゴーストは、\n一定確率で物理攻撃を回避します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "──ジューンブライドの祝祭当日。"}, {"name": "ホルミース", "text": "『むかしむかし、あるところに、\nそれはもう美しい娘がおりました』", "face": "u2292a1"}, {"name": "ホルミース", "text": "『その娘の名はニミュデレラ』", "face": "u2292a1"}, {"name": "ウルカノ", "text": "（語呂悪ッ！？）", "face": "u2475a1"}, {"name": "ホルミース", "text": "『容姿端麗、頭脳明晰、才気煥発ニミュデレラ。\nそのカリスマは彼女に求婚しようとする男たちで、\n連日ニミュデレラの家に長蛇の列ができるほど──』", "face": "u2292a1"}, {"name": "ホルミース", "text": "『ですがある日、その美しさを妬んだ悪い魔女が、\nニミュデレラを塔の中に閉じ込めてしまったのです』", "face": "u2292a1"}, {"name": "ホルミース", "text": "『それは悪霊の塔という未完成の、\nしかしとても恐ろしい塔なのでした』", "face": "u2292a1"}, {"name": "アンブローズ", "text": "『おお、忌々しきニミュデレラよ。\nこの悪霊の塔の先端が雲の上に至るまで、\nそなたはここから出ることができない』", "face": "u1088a1"}, {"name": "ニミュエ", "text": "おおー、なんてことでしょー。", "face": "u2473a1"}, {"name": "観客の少女", "text": "ひっどーい！！　ニミュデレラが可哀想！！", "face": "l80ab72b42278"}, {"name": "アンブローズ", "text": "（げふんげふん）", "face": "u1088a1"}, {"name": "ホルミース", "text": "『しかしそこはさすがのニミュデレラ。\n彼女にかかればダンジョン製作もお手の物。\n巧みな手腕で瞬く間に塔を完成させました』", "face": "u2292a1"}, {"name": "ニミュエ", "text": "おー、意外と楽しー。", "face": "u2473a1"}, {"name": "ホルミース", "text": "『けれど、魔女はまたもニミュデレラへの嫉妬心から、\n約束を破って彼女を千年も塔に閉じ込めてしまったのです』", "face": "u2292a1"}, {"name": "アンブローズ", "text": "『こんなのじゃまだまだ足りないよ。\nもっと高く、宙よりも高くないとねぇ』", "face": "u1088a1"}, {"name": "ニミュエ", "text": "そ、そんなー。", "face": "u2473a1"}, {"name": "観客の少女", "text": "魔女最低ー！！　信じらんない！！", "face": "l80ab72b42278"}, {"name": "アンブローズ", "text": "（しくしくしくしく……）", "face": "u1088a1"}, {"name": "ホルミース", "text": "『今日も今日とて塔を伸ばし続けるニミュデレラ。\n何人もの勇者たちが囚われの姫を救い出そうとして、\n皮肉にも彼女が育てた塔がそれを阻み続けました』", "face": "u2292a1"}, {"name": "ホルミース", "text": "『様々な入場制限や、ミミック、\n凶暴なモンスターやゴーストたち』", "face": "u2292a1"}, {"name": "ホルミース", "text": "『塔の上層で孤独に耐えるニミュデレラ。\nそこに新たに塔へ挑まんとする若者が一人』", "face": "u2292a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "観客", "text": "うぉーー！！　がんばれ王子ー！！", "face": "l23f438011f71"}, {"name": "ホルミース", "text": "『立ち塞がるは魔女の下僕の悪霊たち』", "face": "u2292a1"}, {"name": "ゴースト", "text": "（ほわほわ）", "face": "l2126bbb4b962"}, {"name": "ホルミース", "text": "『果たして王子はニミュデレラを救い出せるのか』", "face": "u2292a1"}, {"name": "ニミュエ", "text": "たすけてー、王子ちゃん様ー。", "face": "u2473a1"}, {"name": "ホルミース", "text": "ジューンブライドの祝祭のメインイベント！\n『塔の上のニミュデレラ』これより開演です！", "face": "u2292a1"}]}, {"trigger": "end", "lines": [{"name": "ホルミース", "text": "『──かくして、姫のもとへ辿り着いた王子』", "face": "u2292a1"}, {"name": "ニミュエ", "text": "よくぞ私の建てた渾身の塔を攻略してくださいましたー。", "face": "u2473a1"}, {"name": "ニミュエ", "text": "（まあ建設途中の階層を流用したんですけどー）", "face": "u2473a1"}, {"name": "ホルミース", "text": "『王子は悪い魔女を成敗し──』", "face": "u2292a1"}, {"name": "アンブローズ", "text": "『ひぃん！』", "face": "u1088a1"}, {"name": "ホルミース", "text": "『ニミュデレラを優しく抱き上げました』", "face": "u2292a1"}, {"name": "王子", "text": "…………(ひょいっ)", "face": "u1"}, {"name": "ニミュエ", "text": "むふふー♪", "face": "u2473a1"}, {"name": "アンブローズ", "text": "う、うちの子がー！？", "face": "u1088a1"}, {"name": "アンナ", "text": "（アンブローズさん！　台本、台本！）", "face": "lec893af6dcd1"}, {"name": "ムルーア", "text": "いーなー、あたしもお姫様だっこされたーい！", "face": "u2474a1"}, {"name": "ウルカノ", "text": "あんとき勝ってりゃ今頃なぁ……。", "face": "u2475a1"}, {"name": "ホルミース", "text": "『無事に花嫁を救い出した白馬の王子様。\nあとは城に帰って二人の結婚式を挙げるだけ──』", "face": "u2292a1"}, {"name": "ホムラ", "text": "『──と、そうは問屋が卸さねぇ』", "face": "u2476a1"}, {"name": "王子", "text": "────ッ！？", "face": "u1"}, {"name": "ココヒメ", "text": "『通りゃんせー、通りゃんせー』", "face": "u1790a1"}, {"name": "キシマ", "text": "『ここはどこの細道じゃー、悪霊さまの細道じゃー』", "face": "ld1c3dba5728a"}, {"name": "ハヤセ", "text": "『行きはよいよい、帰りはこわい』", "face": "l4d0d77cc9903"}, {"name": "？？？", "text": "（ズモモモモモ……！！）", "face": "l6f39ba2bc7f1"}, {"name": "ニミュエ", "text": "王子ちゃん様。帰るまでがダンジョン攻略、ですよ？", "face": "u2473a1"}]}], "active": true}