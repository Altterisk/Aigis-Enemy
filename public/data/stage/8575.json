, "base_hp": 1000000, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 50, "attack_speed": 1, "attack_wait": 60, "attack_interval": 170, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2160912, "race_id": 19, "special_effect_id": 1160, "master_id": 38828, "global_id": 12445, "from_flag": [90, 1]}, {"enemy_id": 9, "source": "local", "count": 16, "form_count": 1, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 45, "attack_wait": 60, "attack_interval": 208, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160816, "race_id": 13, "special_effect_id": 2090, "master_id": 38823, "global_id": 12440, "spawn_sec": 215}, {"enemy_id": 10, "source": "local", "count": 27, "form_count": 2, "hp": 12000, "attack": 650, "base_hp": 12000, "base_attack": 650, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_speed": 45, "attack_wait": 50, "attack_interval": 196, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160832, "race_id": 13, "special_effect_id": 2091, "change_to": 10, "change_condition": 3, "master_id": 38824, "global_id": 12441, "to_condition": 3, "to_global_id": 12442, "spawn_sec": 218}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1050, "base_hp": 12000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_speed": 45, "attack_wait": 30, "attack_interval": 146, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160848, "race_id": 13, "special_effect_id": 2091, "master_id": 38825, "global_id": 12442, "from_condition": 3}, {"enemy_id": 12, "source": "local", "count": 14, "form_count": 2, "tags": ["黒輪"], "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "special_effect_id": 2073, "change_to": 12, "change_condition": 2, "master_id": 38771, "global_id": 12388, "to_condition": 2, "to_global_id": 12389, "spawn_sec": 233}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 2700, "attack": 740, "base_hp": 2700, "base_attack": 740, "damage_type": "physical", "armor_defense": 260, "magic_defense": 40, "attack_speed": 40, "attack_wait": 5, "attack_interval": 67, "move_speed": 2200.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "special_effect_id": 2074, "master_id": 38772, "global_id": 12389, "from_condition": 2}, {"enemy_id": 14, "source": "local", "count": 6, "form_count": 2, "tags": ["黒輪"], "hp": 24000, "attack": 1200, "base_hp": 24000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_range": 60, "attack_speed": 115, "attack_wait": 100, "attack_interval": 279, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 2077, "change_to": 14, "change_condition": 2, "missile_id": 11, "master_id": 38785, "global_id": 12402, "ranged": true, "to_condition": 2, "to_global_id": 12403, "spawn_sec": 287}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 36000, "attack": 2400, "base_hp": 36000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_range": 60, "attack_speed": 115, "attack_wait": 80, "attack_interval": 239, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 2078, "missile_id": 11, "master_id": 38786, "global_id": 12403, "ranged": true, "from_condition": 2}, {"enemy_id": 16, "source": "local", "count": 12, "form_count": 2, "tags": ["黒輪"], "hp": 9500, "attack": 550, "base_hp": 9500, "base_attack": 550, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 100, "attack_speed": 300, "attack_wait": 90, "attack_interval": 343, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155568, "race_id": 5, "special_effect_id": 2071, "change_to": 16, "change_condition": 2, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 38781, "global_id": 12398, "ranged": true, "to_condition": 2, "to_global_id": 12399, "spawn_sec": 292}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 14250, "attack": 1100, "base_hp": 14250, "base_attack": 1100, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_range": 100, "attack_speed": 300, "attack_wait": 70, "attack_interval": 303, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155568, "race_id": 5, "special_effect_id": 2072, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 38782, "global_id": 12399, "ranged": true, "from_condition": 2}], "popups": ["黒い光冠を纏ったギルガメッシュは\n攻撃力2000以下の\nあらゆる攻撃を受け付けません。\n\nまた黒い光冠を纏った\nギルガメッシュは倒されると\nその場で強くなって復活します。\n　　　　　　(1/3)", "黒い光冠を纏った\nギルガメッシュがいる間は\n全ての敵の攻撃力と\n防御力が大幅にアップします。\n\n\n\n　　　　　　(2/3)", "黒い光冠を纏った\nギルガメッシュが\n特定の位置に到着すると、\n結晶魔法のバリアを発生させます。\n\n\n\n　　　　　　(3/3)", "結晶魔法のバリアの範囲内に入った\nバリア本体を除いた敵ユニットは、\n攻撃力50000以下の\nあらゆる攻撃を受け付けません。\n\nギルガメッシュの撃破、\n結晶魔法のバリアの破壊、\nもしくは一定時間経過で消滅します。"], "dialogue": [{"trigger": "battle", "at_sec": 6, "lines": [{"name": "フローガ", "text": "――王子、ダメです。\n下がってください。", "face": "u878"}, {"name": "フローガ", "text": "この魔力は、\n神のものでも、人のものでもありません。", "face": "u878"}, {"name": "アンブローズ", "text": "黒冠の、根源の魔力が流れ込んでますよぅ……。\nこんな膨大な魔力、\n人間の身体で耐えられるはずないのに！", "face": "u1088a1"}, {"name": "ロヴィサ", "text": "……アンブローズ様、対応策は。", "face": "u2455a1"}, {"name": "アンブローズ", "text": "ここで、殺すしかありません。\n際限なく魔力が増幅し続けるなら、\nいずれ大神すら超える存在に――", "face": "u1088a1"}, {"name": "トゥアン＆アトナテス", "text": "……それだけ聞けばッ！　十分だッ！！", "face": "l44778e1714bc"}, {"name": "ギルガメッシュ", "text": "いい動きだ。\nほんの数秒前の力であれば、\n容易く首を落とされていただろう。", "face": "l8f74c1a01ae5"}, {"name": "トゥアン", "text": "お前も良い腕だ。\nだが、どこまで保つかな！？", "face": "u1006a1"}, {"name": "ラーワル", "text": "アトにぃ！　下がって！　ぶっ放す！！", "face": "u1369a1"}, {"name": "アトナテス", "text": "おうッ！！", "face": "u908"}, {"name": "ギルガメッシュ", "text": "光神の槍に、人間の戦士に、\n魔竜の騎士か……良い腕だが、それだけに残念だ。", "face": "l8f74c1a01ae5"}, {"name": "ギルガメッシュ", "text": "貴様らの弱点は、よく分かった。\nその男を失えば容易く瓦解する、\n脆く、弱い戦士に過ぎない。", "face": "l8f74c1a01ae5"}, {"name": "ギルガメッシュ", "text": "その男は――王子は、ただの人間だろう。\n人は、容易く死ぬものだ。", "face": "l8f74c1a01ae5"}, {"name": "ラーワル", "text": "うそっ、攻撃魔法！？　剣士じゃないの！？\n――王子、避けてッ！！", "face": "u1369a1"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "ガレア", "text": "――はぁぁッ！！", "face": "la1cc3aab4d99"}]}, {"trigger": "battle", "at_sec": 11, "lines": [{"name": "ガレア", "text": "……ははっ、なんて魔力だ。\n逸らすだけで手一杯とは。", "face": "la1cc3aab4d99"}, {"name": "マレス", "text": "修行が足りんぞガレア。\n王子ならば、ここで魔法を打ち返すところだ。", "face": "l5c6d6d2b42c4"}, {"name": "ホルミース", "text": "ガレア……マレス様……？\nどうして……ゆ、ゆゆ、幽霊ですか！？", "face": "u2292a1"}, {"name": "ガレア", "text": "おぉ、あのホルミースが動揺するなんてね。\nたまには僕らしくないこともしてみるものだ。", "face": "la1cc3aab4d99"}, {"name": "ユリクセス", "text": "……いったい、どこから？", "face": "u2193a1"}, {"name": "ガレア", "text": "天界の門から、ここまで一直線に。\nマレス様の加護はすごいね。\nこんな魔力を帯びた氷も砕けるなんて。", "face": "la1cc3aab4d99"}, {"name": "ガレア", "text": "それに、着地点も\nわざわざ幻影で示してくれたりして――", "face": "la1cc3aab4d99"}, {"name": "王子", "text": "……………。", "face": "u1"}, {"name": "ガレア", "text": "……そうだね、こんな話をしている場合じゃない。", "face": "la1cc3aab4d99"}, {"name": "ガレア", "text": "今度は、間に合ったかい？", "face": "la1cc3aab4d99"}, {"name": "王子", "text": "ああ。\nガレア、この時を、ずっと待っていた。", "face": "u1"}, {"name": "マレス", "text": "王子よ、手は貸さんぞ。\n――こいつを届けただけで、貴様には十分だろう。", "face": "l5c6d6d2b42c4"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ガレア", "text": "今度は、勝ってみせるさ。", "face": "la1cc3aab4d99"}, {"name": "王子", "text": "ああ。\n――行くぞギルガメッシュ。", "face": "u1"}, {"name": "ギルガメッシュ", "text": "英雄がふたり、か。\n見せてみよ、この時代の英雄の力を！", "face": "l8f74c1a01ae5"}]}, {"trigger": "end", "lines": [{"name": "ギルガメッシュ", "text": "――なんと。\nこれがこの時代の英雄か。", "face": "l8f74c1a01ae5"}, {"name": "ギルガメッシュ", "text": "強く、理想に燃え、なお貪欲に願いを追い続ける。\n素晴らしい、実に輝きに満ちている。", "face": "l8f74c1a01ae5"}, {"name": "ギルガメッシュ", "text": "……あやつを思い出すな。\nゆえに、気に入らぬ。", "face": "l8f74c1a01ae5"}, {"name": "ガレア", "text": "……王子、次が来るぞ。", "face": "la1cc3aab4d99"}, {"name": "ギルガメッシュ", "text": "興味はあるが、ここで摘み取っておくべきか。", "face": "l8f74c1a01ae5"}, {"name": "ギルガメッシュ", "text": "貴様は、強くなりすぎた。\n神の庇護なき世界で、それだけの力を持って何を望む。", "face": "l8f74c1a01ae5"}, {"name": "ギルガメッシュ", "text": "人はいずれ、貴様を怖れるぞ。\n歴史がそれを証明している。", "face": "l8f74c1a01ae5"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ガレア", "text": "ならば、それだけ人が強くなればいい。\n王子の手が届かぬ場所で誰かが嘆くなら、\n代わりに助けに行く、お人好しがいればいい。", "face": "la1cc3aab4d99"}, {"name": "ガレア", "text": "まぁ、僕ではまだ力が足りないだろうけどね。", "face": "la1cc3aab4d99"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ギルガメッシュ", "text": "覚悟はできている、か。\nならば、ここに散るがいい。", "face": "l8f74c1a01ae5"}, {"name": "ギルガメッシュ", "text": "さらばだ、当代の英雄よ。\n願いの前に散るが――", "face": "l8f74c1a01ae5"}, {"name": "黒き導き？", "text": "――させませんよ？", "face": "l968cdb86d531"}, {"name": "ギルガメッシュ", "text": "……ほう、神の残滓ごときが！\n邪魔立てするか！", "face": "l8f74c1a01ae5"}, {"name": "ギルガメッシュ", "text": "また会おう、王子よ。\n北の果てにて――貴様を――", "face": "l8f74c1a01ae5"}]}, {"trigger": "end", "lines": [{"name": "ガレア", "text": "消え、た……？", "face": "la1cc3aab4d99"}, {"name": "フローガ", "text": "エンキドゥ、仮面の騎士たちの気配も消えています。", "face": "u878"}, {"name": "ガレア", "text": "これは、まいったな、\n大活躍するつもりだったんだけど。", "face": "la1cc3aab4d99"}, {"name": "ユリクセス", "text": "そんな身体でよく言う。\n戦う前から負傷者だっただろ。", "face": "u2193a1"}, {"name": "ガレア", "text": "ははっ、さすがユリクセス、\n僕の調子を一発で見抜くとは。", "face": "la1cc3aab4d99"}, {"name": "ユリクセス", "text": "うるさい。\n生きているなら文のひとつでも送らないか！\nこの馬鹿者っ！　王子がどれだけ悔やんでいたとっ！", "face": "u2193a1"}, {"name": "ガレア", "text": "いたっ、痛いっ、本気で痛いっ！\n助けっ、王子、肋がっ、いだっ、痛いからッ！", "face": "la1cc3aab4d99"}, {"name": "ヘルメルク", "text": "ユリクセス、やり過ぎだよ。\n――僕が蹴る分も残しておいて。", "face": "u2275a1"}, {"name": "ガレア", "text": "それっ、元仲間のセリフかい！？", "face": "la1cc3aab4d99"}, {"name": "王子", "text": "…………（にこにこ）", "face": "u1"}, {"name": "ロヴィサ", "text": "はい、再会を喜ぶのはそこまで。\n一旦越境要塞に戻らないと。", "face": "u2455a1"}, {"name": "フィノーラ", "text": "ギルガメッシュは、北の果てと言っていたね。\nロヴィサ、何か心当たりはあるかい？", "face": "u2441a1"}, {"name": "ロヴィサ", "text": "……記録はなにひとつ。\nただ、心当たりがないことはありません。", "face": "u2455a1"}, {"name": "ロヴィサ", "text": "越境要塞の書庫には、古い地図があります。\nそこに記されているのは、\n有史以前の物語、神話に語られる未知の大地のこと。", "face": "u2455a1"}, {"name": "フィノーラ", "text": "未知の大地……？", "face": "u2441a1"}, {"name": "アイシャ", "text": "それに、黒き導きと思しき存在のことも気になるね。\n敵対したり味方になったり、\nいったいどういうつもりなんだか……。", "face": "u181"}, {"name": "ズィズィー", "text": "そうそう、どういうつもりなんだろうねー。", "face": "u2456a1"}, {"name": "ラシュマシュ", "text": "えぇ、まったく。", "face": "u2457a1"}, {"name": "アイシャ", "text": "どっちの味方か分からないのは、\nきみたちも似たりよったりだと思うけど。\nで、協力してくれるなら、ついてくる？", "face": "u181"}, {"name": "ラシュマシュ", "text": "遠慮しておくわ。\nガレア君の活躍も見られたし、\nマレスに貸しも作れたし、今回は大満足だから。", "face": "u2457a1"}, {"name": "ズィズィー", "text": "それじゃ、ばいばーい。", "face": "u2456a1"}, {"name": "トレシア", "text": "えぇと……では、越境要塞に戻りましょうか。\n歩ける方は、負傷者に手を貸してください！", "face": "u2314a1"}]}], "active": true}