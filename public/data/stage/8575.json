{"quest_id": 8575, "name": "二人の英雄", "description": "黒冠の力を取り込み魔力を増幅させた\nギルガメッシュの一撃が王子に迫りくる。\nその時、氷柱が砕かれ一筋の光が差し込む！\n神級（★１獲得の目安：平均Lv50）", "event": "深淵を知る者", "event_category": "History", "mission_id": 920232, "map_no": 9353, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 1, "hp": 5000, "attack": 450, "base_hp": 5000, "base_attack": 450, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 45, "attack_interval": 148, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160640, "race_id": 16, "special_effect_id": 1795, "master_id": 38799, "global_id": 12416, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "hp": 92000, "attack": 1000, "base_hp": 92000, "base_attack": 1000, "damage_type": "true", "armor_defense": 500, "magic_defense": 20, "attack_range": 200, "attack_speed": 65, "attack_wait": 60, "attack_interval": 199, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2160896, "race_id": 16, "special_effect_id": 2087, "change_to": 2, "change_condition": 2, "missile_id": 1281, "missile": {"speed": 9.0}, "master_id": 38820, "global_id": 12437, "ranged": true, "to_condition": 2, "to_global_id": 12438, "commands": {"raw": "SetStageFlag(0, 1);", "sets_flags": [[0, 1]]}, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 138000, "attack": 2000, "base_hp": 138000, "base_attack": 2000, "damage_type": "true", "armor_defense": 1000, "magic_defense": 40, "attack_range": 300, "attack_speed": 65, "attack_wait": 45, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2160784, "race_id": 16, "special_effect_id": 2088, "missile_id": 1281, "missile": {"speed": 9.0}, "master_id": 38821, "global_id": 12438, "ranged": true, "from_condition": 2},