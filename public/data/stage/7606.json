{"quest_id": 7606, "name": "堕天使のメッセンジャー", "description": "亜神マレスによる戦神コロッセウムが開催！\nその招待状を届けるべく一人の堕天使が\n王国を訪れるが……？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "戦神からの招待状", "event_category": "History", "mission_id": 920176, "map_no": 4113, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112080, "race_id": 9, "special_effect_id": 229, "missile_id": 6, "master_id": 31092, "global_id": 4711, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112096, "race_id": 9, "special_effect_id": 229, "missile_id": 6, "master_id": 31093, "global_id": 4712, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112112, "race_id": 9, "special_effect_id": 229, "missile_id": 6, "master_id": 31094, "global_id": 4713, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 6}, {"enemy_id": 5, "source": "local", "count": 7, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 7}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 19}, {"enemy_id": 7, "source": "local", "count": 9, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 54}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 72}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097312, "race_id": 9, "master_id": 53, "global_id": 52, "spawn_sec": 86}, {"enemy_id": 10, "source": "local", "count": 11, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 94}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンプリンセス長女", "text": "――いい、あなたたち。\nお母さまの命令はちゃーんと覚えているわねぇ？", "face": "ld8d5bb09ef4f"}, {"name": "ゴブリンプリンセス次女", "text": "もちろんですわ！\n千年に一度の戦神コロッセウム、\nゴブリン軍団がその優勝をかっさらうのですわよね！", "face": "la6cd8f3be398"}, {"name": "ゴブリンプリンセス三女", "text": "そのために、物質界各地にばらまかれた、\n出場資格証を集めるのですよね。\nお姉さま方、頑張りましょうね！", "face": "l15963fa7aa03"}, {"name": "ゴブリンプリンセス長女", "text": "はぁ？　何を言っているの？\n優勝への最短コースが分かってないのかしら！", "face": "ld8d5bb09ef4f"}, {"name": "ゴブリンプリンセス次女", "text": "優勝の可能性を引き上げる最強の方法！\nそれは優勝候補の出場権利を\n取り上げてしまうことに決まってましてよ！", "face": "la6cd8f3be398"}, {"name": "ゴブリンプリンセス三女", "text": "えっ、えぇっ！？\nそれって、王国の出場資格証あつめを\n妨害するということですか……！？", "face": "l15963fa7aa03"}, {"name": "ゴブリンプリンセス長女", "text": "ノンノン、美しき私たちはぁ、\nもう一歩手前から着手すべきだと思うのよぉ♪", "face": "ld8d5bb09ef4f"}, {"name": "ゴブリンプリンセス次女", "text": "そう、そもそも最初に届く招待状がなければ、\n予選に参加することすらできないのですわよ？", "face": "la6cd8f3be398"}, {"name": "ゴブリンプリンセス三女", "text": "ま、まさか……招待状を配達する、\n天使さんを襲うということ――もごっ、もごごっ！？", "face": "l15963fa7aa03"}, {"name": "ゴブリンプリンセス長女", "text": "ウフフッ、口が悪いわよ三女。\nさぁ、王子たちの招待状を拝借しにいくわよぉ！", "face": "ld8d5bb09ef4f"}]}, {"trigger": "start", "lines": [{"name": "？？？", "text": "――はぁ、はぁ……。\nどうしてゴブリンが私を狙うのでしょうか……。", "face": "u1505a1"}, {"name": "？？？", "text": "まさか、マレス様からの\nこの招待状を狙って……？", "face": "u1505a1"}, {"name": "ゴブリンプリンセス長女", "text": "オーッホッホッホォ！　そのとおりよぉ！\nさぁ堕天使ちゃん、その招待状を渡しなさぁい♪", "face": "ld8d5bb09ef4f"}, {"name": "？？？", "text": "絶対に渡すわけにはいきません。\n王国にこの招待状が届かなかったら、\nその時叱られるのは私なので……。", "face": "u1505a1"}, {"name": "ゴブリンプリンセス次女", "text": "ふんっ、そんな強気でいられるのも今のうちだけ。\nこんな僻地に助けなんて来な――", "face": "la6cd8f3be398"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "アンナ", "text": "――ご無事ですか！？\nって、あなたたちはメカゴブリンクイーンの……。\nどうしてこの方を襲っているんですか！", "face": "lc119340f5565"}, {"name": "ゴブリンプリンセス長女", "text": "ちぃっ、タイミングの悪い！\nゴブリン軍団、やーっておしまい！", "face": "ld8d5bb09ef4f"}, {"name": "ゴブリン", "text": "ギャギャ！　ショータイジョー！　ウバウ！", "face": "lf8d7fae10ca3"}, {"name": "アンナ", "text": "事情を聞く余裕はなさそうですね……。\n王子、ゴブリン軍団を撃退しましょう！", "face": "lc119340f5565"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンプリンセス長女", "text": "キィィっ！　さすがは王国軍、やるわねぇ！", "face": "ld8d5bb09ef4f"}, {"name": "ゴブリンプリンセス次女", "text": "お姉さま、ここで招待状を奪えなくても、\n出場資格証を先んじて奪えば良いだけですわ！", "face": "la6cd8f3be398"}, {"name": "ゴブリンプリンセス三女", "text": "あ、あれ、それって普通に\n予選の戦いをするというだけでは……。", "face": "l15963fa7aa03"}, {"name": "ゴブリンプリンセス長女", "text": "おだまり！　さぁ撤退するわよぉ！", "face": "ld8d5bb09ef4f"}, {"name": "？？？", "text": "……えぇと、助かりました。\nまさか配達先である王国軍に\n助けてもらうことになるとは。", "face": "u1505a1"}, {"name": "シェミア", "text": "申し遅れました、私はシェミア、\n今はマレス様の使いっぱしりをしています。", "face": "u1505a1"}, {"name": "シェミア", "text": "英雄王陛下、あなたに\n戦神コロッセウム予選への\n招待状をお届けに参りました。", "face": "u1505a1"}]}], "active": true}