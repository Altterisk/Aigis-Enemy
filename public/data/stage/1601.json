{"quest_id": 1601, "name": "密林の強者", "description": "女神アイギスの啓示により、密林へと\n向かった王子たちが見たものとは……。\n＜旗手がいる間敵の攻撃と防御アップ＞", "modifier_notes": ["旗手がいる間敵の攻撃と防御アップ"], "event": "ストーリーミッション6", "event_category": "Story", "mission_id": 100006, "map_no": 1101, "level": 100, "multiplier": 1.0, "charisma": 38, "exp": 949, "gold": 3220, "drops": [{"card": 301, "c": 2}, {"card": 73, "c": 1}, {"card": 302, "c": 3}, {"card": 300}], "capacity": 10, "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 1, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "phases": [{"hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "condition": 3}]}, {"enemy_id": 3, "source": "local", "count": 35, "form_index": 0, "form_count": 1, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102224, "race_id": 8, "change_to": 3, "change_condition": 3, "master_id": 366, "global_id": 365, "phases": [{"hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "physical", "armor_defense": 450, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102240, "race_id": 8, "master_id": 367, "global_id": 366, "condition": 3}]}, {"enemy_id": 5, "source": "local", "count": 37, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102544, "race_id": 8, "change_to": 5, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 377, "global_id": 376, "ranged": true, "phases": [{"hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 378, "global_id": 377, "ranged": true, "condition": 3}]}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 250, "base_hp": 5000, "base_attack": 250, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102608, "race_id": 8, "special_effect_id": 567, "master_id": 381, "global_id": 380, "spawn_sec": 132}, {"enemy_id": 8, "source": "local", "count": 19, "form_index": 0, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 166}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、この辺りです。\n女神アイギス様から啓示のあった地は。", "face": "lc1a894249b0f"}, {"name": "アンナ", "text": "『大いなる災い』を封じているという\nアイギス様の武具に危機が迫っていると\nおっしゃっていましたが、一体何が……。", "face": "lc1a894249b0f"}, {"name": "？？？", "text": "やめて！　これ以上この森に入ってこないで！", "face": "u300"}, {"name": "オーク", "text": "お前に用はない。\n消え失せろ。", "face": "lc3098a587432"}, {"name": "？？？", "text": "どうしよう……。このままじゃ村が……。\nあんなに沢山のオーク、\nあたし一人じゃ絶対に止められない……。", "face": "u300"}, {"name": "オーク", "text": "さぁお前ら！\n俺たちの力を見せつけてやれ！", "face": "lc3098a587432"}, {"name": "アンナ", "text": "王子！　オーク達が……！\n戦闘の準備を！", "face": "lc1a894249b0f"}]}, {"trigger": "battle", "at_sec": 139, "lines": [{"name": "オーク", "text": "オオオオオッ！！！", "face": "lc3098a587432"}, {"name": "オーク", "text": "俺たちはオーク！！\n強き種族！　誇り高き種族！！\n士気をあげろォオッ！！", "face": "lc3098a587432"}, {"name": "オーク", "text": "敵に軍旗を奪われるなよッ！　お前ら！", "face": "lc3098a587432"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "大丈夫ですか？"}, {"name": "？？？", "text": "な、なんとかなったの……？", "face": "u300"}, {"name": "アンナ", "text": "ええ。オーク達はいなくなったみたいです。\nひとまず無事でよかったです……。"}, {"name": "？？？", "text": "一体なんでこんなことに……。", "face": "u300"}, {"name": "アンナ", "text": "オークは好戦的で力を求める種族だと\n聞いた事はありますが、\nこんな数の軍を率いて攻めてくるなんて……。", "face": "lc1a894249b0f"}, {"name": "？？？", "text": "なんでこんな辺境を攻めようとしたのかな？", "face": "u300"}, {"name": "アンナ", "text": "気になりますね……。\nもしかしたらアイギス様の言っていた\n『大いなる災い』が関係しているのかも……。", "face": "lc1a894249b0f"}, {"name": "？？？", "text": "アイギス様って女神アイギス様？", "face": "u300"}, {"name": "アンナ", "text": "ええ、ご存じなのですか？", "face": "lc1a894249b0f"}, {"name": "？？？", "text": "はい。あたしたちの部族は、\n女神アイギス様の武具を守ってるの。\n『大いなる災い』の事はよくわからないけど……。", "face": "u300"}, {"name": "ルナール", "text": "あたしで協力できることがあるならするわ。\nさっき助けてもらったし……。\nあたしはルナール。よろしくね！", "face": "u300"}, {"name": "ルナール", "text": "あたしの村に案内するよ！\n何か分かるかもしれないし！", "face": "u300"}, {"name": "アンナ", "text": "本当ですか！\nありがとうございます。\n助かります。"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 20, "params": [300]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 3750, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102576}, {"enemy_id": 3, "form_index": 0, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102224}, {"enemy_id": 5, "form_index": 0, "hp": 4500, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102544}, {"enemy_id": 7, "form_index": 0, "hp": 7500, "attack": 375, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2102608}, {"enemy_id": 8, "form_index": 0, "hp": 2400, "attack": 600, "damage_type": "physical", "armor_defense": 40, "pattern_id": 2097344}]}, "map": {"image": "Map1101", "w": 960, "h": 640, "spots": [{"k": "b", "x": 10, "y": 263}, {"k": "b", "x": 12, "y": 403}, {"k": "m", "x": 572, "y": 234, "id": 200}, {"k": "m", "x": 500, "y": 348, "id": 201}, {"k": "m", "x": 578, "y": 422, "id": 202}, {"k": "m", "x": 690, "y": 238, "id": 203}, {"k": "m", "x": 441, "y": 133, "id": 204}, {"k": "m", "x": 334, "y": 150, "id": 205}, {"k": "m", "x": 383, "y": 385, "id": 206}, {"k": "m", "x": 162, "y": 444, "id": 207}, {"k": "m", "x": 110, "y": 220, "id": 208}, {"k": "m", "x": 795, "y": 218, "id": 209}, {"k": "m", "x": 762, "y": 494, "id": 210}, {"k": "m", "x": 661, "y": 485, "id": 211}, {"k": "m", "x": 215, "y": 167, "id": 212}, {"k": "m", "x": 280, "y": 412, "id": 213}, {"k": "r", "x": 503, "y": 103, "id": 300}, {"k": "r", "x": 735, "y": 178, "id": 301}, {"k": "r", "x": 587, "y": 320, "id": 302}, {"k": "r", "x": 491, "y": 398, "id": 303}, {"k": "r",