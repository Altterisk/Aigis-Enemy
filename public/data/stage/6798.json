wn_sec": 28}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 1, "tags": ["機械"], "hp": 3600, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 500, "attack_range": 150, "attack_wait": 30, "attack_interval": 88, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118928, "special_effect_id": 382, "missile_id": 26, "master_id": 31790, "global_id": 5409, "ranged": true, "spawn_sec": 31}, {"enemy_id": 12, "source": "local", "count": 4, "form_count": 1, "tags": ["機械"], "hp": 4800, "attack": 480, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 600, "attack_wait": 60, "attack_interval": 159, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119008, "special_effect_id": 389, "master_id": 31803, "global_id": 5422, "spawn_sec": 176}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 42000, "attack": 1800, "base_hp": 35000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 2000, "attack_range": 250, "attack_wait": 200, "attack_interval": 476, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118944, "special_effect_id": 384, "missile_id": 300, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31792, "global_id": 5411, "ranged": true, "spawn_sec": 181}], "popups": ["青い障壁を持つ\nデウスエクスマキナの眷属は、\nあらゆる魔法攻撃を受け付けません。\n\nまた眷属がいる間は\nデウスエクスマキナも同様に、\nあらゆる魔法攻撃を受け付けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ピッキー", "text": "王子の旦那！\n今度は青いコアの機械が出てきましたよ！！", "face": "u671"}, {"name": "バルバストラフ", "text": "――何じゃ、この異質な魔力反応は！\n警備機械に魔法が効かぬぞ……！？", "face": "u63"}, {"name": "ボリス", "text": "まさか、機械技術で\n魔法障壁を再現したとでもいうのか！？\n古代の技術ってのもふざけてやがるぜ……。", "face": "u360"}, {"name": "ボリス", "text": "王子、あの青いコアの機械がいる限り、\nデウスエクスマキナには\n魔法が効かないと見ていいだろう。", "face": "u360"}, {"name": "ティアル", "text": "あの青い機械自体にも、\nデウスエクスマキナと同じ魔力障壁があるみたい。\nこうなったら物理攻撃でぶっ壊すしかないかも！", "face": "u505"}, {"name": "ピッキー", "text": "えっと、赤い機械が物理障壁、\n青い機械が魔法障壁でしたよね……。", "face": "u671"}, {"name": "ボリス", "text": "難しいこたぁ考えるな。\n逆の特性で殴ってやれば弱点になるってことだ。\n両方破壊すれば本体にダメージが通るはずだぜ！", "face": "u360"}, {"name": "アンナ", "text": "二重の防御機械に守られた\n古代兵器デウスエクスマキナ、ですか……。\n王子、慎重な采配をお願いします……！！", "face": "l616b59afdfd8"}]}, {"trigger": "route", "lines": [{"name": "ピッキー", "text": "――やった！\nデウスエクスマキナが崩壊していきます！\nさっすが王子の旦那――って、えっ？　あれ！？", "face": "u671"}, {"name": "ボリス", "text": "崩壊じゃない……あれは、変形だ……ッ！！\nあんなデカブツと激突したら潰されちまうぞ！", "face": "u360"}, {"name": "アンナ", "text": "まともに正面から止められる相手ではありません！\n至急、進路上の兵には一旦退避頂きます！\n王子、よろしいですね！", "face": "l616b59afdfd8"}, {"name": "王子", "text": "…………！！（こくり）", "face": "u1"}]}], "active": true}