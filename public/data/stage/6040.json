{"quest_id": 6040, "name": "ドルイドの巫女姫（記憶）", "description": "妖精郷が襲われているとの報せを受け、\n王子たちは妖精郷へと向かう。\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "戦場の記憶", "event_category": "History", "mission_id": 920085, "map_no": 3770, "level": 110, "multiplier": 1.1, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "level": 70, "form_count": 1, "tags": ["植物"], "hp": 1430, "attack": 280, "base_hp": 1300, "base_attack": 280, "damage_type": "physical", "armor_defense": 100, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 131, "global_id": 130, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "level": 70, "form_count": 1, "tags": ["植物"], "hp": 1430, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 667, "global_id": 666, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 12, "form_count": 1, "hp": 704, "attack": 154, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 1320, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 8}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 2200, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 27}, {"enemy_id": 6, "source": "local", "count": 2, "level": 80, "form_count": 1, "tags": ["植物"], "hp": 8800, "attack": 990, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 280, "attack_speed": 100, "attack_wait": 10, "attack_interval": 211, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098960, "special_effect_id": 126, "master_id": 30142, "global_id": 3761, "spawn_sec": 47}, {"enemy_id": 7, "source": "local", "count": 12, "form_count": 1, "hp": 1100, "attack": 165, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 74}, {"enemy_id": 8, "source": "local", "count": 1, "level": 80, "form_count": 1, "tags": ["植物"], "hp": 8800, "attack": 1100, "base_hp": 8000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 280, "magic_defense": 50, "attack_speed": 100, "attack_wait": 10, "attack_interval": 211, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106960, "special_effect_id": 94, "master_id": 668, "global_id": 667, "spawn_sec": 110}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "エルフ族から妖精郷に再び危機が迫っていると\n聞いてきましたが……妖精郷を襲っている\n木のような魔物達は一体……。", "face": "l9d6a0fdd4bae"}, {"name": "アンナ", "text": "先ほど出会ったエルフの方から聞いた話では、木々を司る\n巫女姫様であれば何か事情が分かるかもとの\n事でしたが……眠っているのはこの辺りのハズです。", "face": "l9d6a0fdd4bae"}, {"name": "？？？", "text": "原因としてはわしの持つ「神樹の枝杖」\nが奪われたからじゃろうな。", "face": "u225"}, {"name": "アンナ", "text": "あ、あなたは？", "face": "l9d6a0fdd4bae"}, {"name": "ププル", "text": "何を隠そう、お主らが捜している\nドルイドの美少女巫女姫ププルとは\n他でもない、わしのことじゃ。", "face": "u225"}, {"name": "アンナ", "text": "あ、あなたが巫女姫なんですね……。\n先ほど仰っていた「神樹の枝杖」とは？", "face": "l9d6a0fdd4bae"}, {"name": "ププル", "text": "「神樹の枝杖」というのはじゃの、トレント……お主らが\n木の魔物と呼んでいる奴らじゃ。あ奴らを操る事が出来る\nドルイド伝統の魔法の杖みたいなもんじゃよ。", "face": "u225"}, {"name": "ププル", "text": "あ奴らは元々わしらドルイドと共に妖精郷の\n木々を護る存在なんじゃが……恐らく、わしを\n起こした連中が、その杖を奪ったのじゃろう。", "face": "u225"}, {"name": "ププル", "text": "本来わしは神樹の根本にて森の木々、\n同時に「神樹の枝杖」を護るため\n杖と共に長き眠りについていたのじゃが……。", "face": "u225"}, {"name": "ププル", "text": "なのにダークエルフが\n突然わしを起こして……。", "face": "u225"}, {"name": "ププル", "text": "目覚めたわしは恐怖のあまり\n逃げ出すのに精いっぱいじゃった。\nあまりに突然で杖を置いてきてしもうた……。", "face": "u225"}, {"name": "ププル", "text": "あれがなくては、わしは力を発揮できぬ……。\n枝杖がないわしはただの可愛い美少女じゃ……。", "face": "u225"}, {"name": "ププル", "text": "ふぇえ……っ、わ、わしのせいじゃぁ～！\nぐすっ、うわぁああああんっ……！！\nあれがないと大変なのに～っ！！", "face": "u225"}, {"name": "アンナ", "text": "ちょ……ちょっと。泣き止みそうにありません、\nまいりましたね……。そ、そうだ！\n王子、神樹の枝杖を一緒に取り返してあげませんか！", "face": "l9d6a0fdd4bae"}, {"name": "ププル", "text": "本当か！！　よし、良い返事じゃな！\nそれでは早速取り返して来てくれ！\nほれ、早く行くのじゃ！", "face": "u225"}, {"name": "アンナ", "text": "は……謀られたのでしょうか……。", "face": "lf1221dd6d909"}]}, {"trigger": "end", "lines": [{"name": "ププル", "text": "さすがじゃの！　よく神樹の枝杖を取り戻した……！\nこれでトレントたちの暴走を止められる……。\nありがとう。感謝するぞ王子よ。", "face": "u225"}, {"name": "アンナ", "text": "これで妖精郷の混乱が収束しますね。\n良かった……。"}, {"name": "ププル", "text": "ふむ。これで妖精郷に平和がもどって……。", "face": "u225"}, {"name": "ププル", "text": "ってまだじゃ！　まだ終わらん！\nわしの怒りはやつらを焼き払うまでは拭えぬ！\n撤退したダークエルフを追うぞ！", "face": "u225"}, {"name": "ププル", "text": "二度と妖精郷に近づきたくなくなるよう、\n成敗してくれる！\nさぁ、王子よ。行くのじゃ！", "face": "u225"}, {"name": "レーヴ", "text": "――――あれが、噂のププル様ですかぁ……。\n……あんなにも可憐な風体だというのに、\n巫女姫様という立派な立場にあるのですね。", "face": "u454"}, {"name": "レーヴ", "text": "でも、神樹の下で長らく眠られていたとの事ですが、\nププル様は一体お幾つなのでしょうか？　エルフは長寿と\n聞きますから、きっと私よりも年上なのでしょうけど……。", "face": "u454"}, {"name": "レーヴ", "text": "――え？　子供を見守るような目をしてる？　\nそ、そんな……ちっちゃくて元気で可愛らしいなーとか、\nそんな失礼なこと、考えてないですから！ほ、ほんとです！", "face": "u454"}, {"name": "レーヴ", "text": "そ、そんなことよりも、次の記憶へと急ぎましょう！　\nさ、はやく私の手を！　もぉ、置いていっちゃいますよ？", "face": "u454"}]}], "active": true}