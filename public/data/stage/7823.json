: 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 387, "global_id": 386, "ranged": true, "to_condition": 3, "to_global_id": 387, "spawn_sec": 157}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106512, "race_id": 8, "special_effect_id": 234, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 388, "global_id": 387, "ranged": true, "from_condition": 3}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105088, "race_id": 8, "special_effect_id": 252, "master_id": 30918, "global_id": 4537, "spawn_sec": 198}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 250, "base_hp": 5000, "base_attack": 250, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102608, "race_id": 8, "special_effect_id": 252, "master_id": 31142, "global_id": 4761, "spawn_sec": 211}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102544, "race_id": 8, "change_to": 11, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 377, "global_id": 376, "ranged": true, "to_condition": 3, "to_global_id": 377, "spawn_sec": 226}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 378, "global_id": 377, "ranged": true, "from_condition": 3}], "popups": ["巨躯のオークはHPが\n50%以下になると咆哮を行います。\n咆哮後、移動速度が上昇します。", "オーク旗手がいる間は\n敵のオークの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リノ", "text": "――デビューライブが、まさかオークの村なんて。\nねっ、最初はよく見知った王国が良かったんじゃ……。", "face": "u1683a1"}, {"name": "ミヤビ", "text": "よく知ってる人だけに、歌を届けたいんですか？", "face": "u496"}, {"name": "リノ", "text": "うっ……うぅん、みんなに、\n世界中のみんなに歌を届けたい、けど……。", "face": "u1683a1"}, {"name": "リノ", "text": "オークさんたちって、みんな武人ばかりでしょ？\nリノの歌、ちゃんと届く、かな……。", "face": "u1683a1"}, {"name": "ミヤビ", "text": "アイドルが不安になってちゃいけませんよ。\n歌は、人の心を震わせられるんです。\n不安な気持ちで歌ったら、みんなを不安にしちゃいます。", "face": "u496"}]}, {"trigger": "start", "lines": [{"name": "ハイオーク", "text": "――歌、か。\n我らも戦歌を嗜むことはあるが、\n王国の名高い召喚士の歌とは如何なるものか……。", "face": "lac20ffe9668e"}, {"name": "オーク", "text": "けっ、リノ嬢の武力は大したものだが、\n軟弱なウタなんかで、俺達の心は震えないぜ。", "face": "l44436316ebf0"}, {"name": "ハイオーク", "text": "さて、分からぬぞ。\n伝説のアイドルは、その歌で心だけでなく、\n魔力まで震わせ魔物たちを呼び寄せたと聞く……。", "face": "lac20ffe9668e"}]}, {"trigger": "start", "lines": [{"name": "ミヤビ", "text": "……会場の反応は、半々といったところですね。\nふふ、でもライブが終わった後には、\nきっとみんなリノさんのファンになっていますよ。", "face": "u496"}, {"name": "リノ", "text": "ほ、ほんとに……？　大丈夫……？", "face": "u1683a1"}, {"name": "ミヤビ", "text": "大丈夫にするのは、リノさん自身です！\n王子たちも来てくれていますし、\n最高のデビューライブにしちゃいましょう！", "face": "u496"}]}, {"trigger": "battle", "at_sec": 5, "lines": [{"name": "巨躯のオーク", "text": "――何だ、この軟弱な音色は！\nオーク伝統の戦太鼓にも及ばぬ雑音め！", "face": "l44436316ebf0"}, {"name": "ミヤビ", "text": "なに！？　部外者！？", "face": "u496"}, {"name": "オーク", "text": "あれは、隣村の巨躯オークの連中じゃないか！", "face": "l44436316ebf0"}, {"name": "巨躯のオーク", "text": "これだから人間と交流を持つような連中は……。\n軟弱な音楽など、この村ごと破壊してやるわ！", "face": "l44436316ebf0"}, {"name": "リノ", "text": "……軟弱かどうか、ちゃんと聞いてから判断してよね。", "face": "u1683a1"}, {"name": "巨躯のオーク", "text": "なにィ……？\n良かろう、歌ごときで戦士を鼓舞できるのかどうか、\nその身をもって示すがいい、小娘ェ！！", "face": "l44436316ebf0"}, {"name": "ハイオーク", "text": "王国の戦士たちよ、気をつけよ。\n巨躯の村の連中は我らよりも力も体力も強い。", "face": "lac20ffe9668e"}, {"name": "オーク", "text": "戦傷を負うと、興奮してウォークライを放ち始める。\nあれはもはや叫びではない、衝撃波にも近いものだぞ！", "face": "l44436316ebf0"}, {"name": "リノ", "text": "みんな、これがリノのデビューライブだよ！\n千年先まで届く輝きを！　みんなに！！", "face": "u1683a1"}]}, {"trigger": "end", "lines": [{"name": "巨躯のオーク", "text": "くっ……なんだ、この気持ちは……。\n戦の興奮とも違う、む、胸が、ドキドキして……。", "face": "l44436316ebf0"}, {"name": "リノ", "text": "どう？　もう一曲聴きたくなった？", "face": "u1683a1"}, {"name": "巨躯のオーク", "text": "ふざけるな！\n軟弱な音楽を聴きたいなどと……くっ、この俺が……！", "face": "l44436316ebf0"}, {"name": "巨躯のオーク", "text": "この村のオークたちが、音楽などにうつつを抜かし、\n戦士の誇りを汚したことは我が村に伝えるぞ！\n覚えておけ、か、可憐なる、歌姫め……ッ！！", "face": "l44436316ebf0"}, {"name": "リノ", "text": "……帰っていった、みたいだね？", "face": "u1683a1"}, {"name": "オーク", "text": "ステージはこのとおり、しっかり守りきったぞ。", "face": "l44436316ebf0"}, {"name": "ハイオーク", "text": "あの連中は、魔界との行き来が可能になった後、\n王国軍の噂を聞いて物質界に出てきた者たちなのだ。", "face": "lac20ffe9668e"}, {"name": "ハイオーク", "text": "腕利きの戦士揃いと名高い王国軍、\nそして同族たる我らが、あいどるのらいぶ、\nなるものを楽しんでいたのが気に障ったのだろう。", "face": "lac20ffe9668e"}, {"name": "ミヤビ", "text": "……と、ともかく、\nこれでライブの続きができますね。\n何事もなくて本当によかったです。", "face": "u496"}, {"name": "リノ", "text": "……ねぇ、ミヤビ。", "face": "u1683a1"}, {"name": "ミヤビ", "text": "……何でしょう？\n言いたいこと、ちょっと察せますけど。", "face": "u496"}, {"name": "リノ", "text": "リノはね、伝説のアイドル、アンナさんの歌を聴いて、\nいっぱい元気と勇気をもらったの。", "face": "u1683a1"}, {"name": "リノ", "text": "歌は、軟弱なものなんかじゃない。\n巨躯のオークさんたちにも、きっと届く、よね。", "face": "u1683a1"}, {"name": "ミヤビ", "text": "ふふふ。\n何もかも把握しちゃいましたよ。", "face": "u496"}, {"name": "ミヤビ", "text": "――つまり、ゲリラライブですね！！", "face": "u496"}]}], "active": true}