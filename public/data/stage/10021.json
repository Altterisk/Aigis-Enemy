{"quest_id": 10021, "name": "第21階層", "description": "【主な敵】\n塔の装置 / ゴーレム系\n\n＜ドロップなし＞＜編成内での同ユニット禁止＞", "modifier_notes": ["ドロップなし", "編成内での同ユニット禁止"], "event": "英傑の塔", "event_category": "Tower", "mission_id": 110001, "map_no": 20, "level": 100, "multiplier": 1.0, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [200], "expression": "IsStageFlag( 1);", "expression_human": "stage flag 1 is set"}, {"kind": "term", "influence": 24, "params": [10], "expression": "IsOverlapMember() != 1;", "expression_human": "it is not a duplicate of another unit in your team"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "機械", "アーマー"], "fixture": true, "hp": 500000, "base_hp": 500000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 60, "attack_speed": 1, "attack_wait": 1, "move_speed": 400.0, "gain_cost": 10, "dot_rate": 1.7999999523162842, "pattern_id": 2122192, "special_effect_id": 516, "master_id": 21074, "global_id": 1368, "route_behaviour": {"sets_flags": [[1, 1, 0], [1, 0, 0]]}}, {"enemy_id": 2, "source": "local", "count": 30, "form_count": 1, "hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 70, "attack_wait": 40, "attack_interval": 176, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102336, "race_id": 5, "master_id": 374, "global_id": 373, "spawn_sec": 28}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "hp": 30000, "attack": 2500, "base_hp": 30000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 60, "attack_interval": 566, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102320, "race_id": 5, "master_id": 373, "global_id": 372, "spawn_sec": 115}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 2, "hp": 60000, "attack": 5200, "base_hp": 60000, "base_attack": 5200, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 60, "attack_speed": 200, "attack_wait": 80, "attack_interval": 531, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2100784, "race_id": 5, "change_to": 4, "change_condition": 5, "master_id": 426, "global_id": 425, "to_condition": 5, "to_global_id": 426, "spawn_sec": 227}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 60000, "attack": 3500, "base_hp": 60000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 60, "attack_range": 200, "attack_speed": 200, "attack_wait": 80, "attack_interval": 356, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2100800, "race_id": 5, "special_effect_id": 234, "change_to": 5, "change_condition": 1, "missile_id": 86, "missile": {"speed": 3.0, "splash": 133}, "master_id": 427, "global_id": 426, "ranged": true, "from_condition": 5, "variants": [{"hp": 60000, "attack": 5200, "base_hp": 60000, "base_attack": 5200, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 60, "attack_speed": 200, "attack_wait": 80, "attack_interval": 531, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2100784, "race_id": 5, "master_id": 428, "global_id": 427}]}], "popups": ["赤いオーブの装置がある間、\n敵の攻撃力が２倍になります。\n\n装置は撃破数に含まれません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――英傑の塔は、\n２０層が最上階だと思っていましたが……。", "face": "l26f6d378e2bc"}, {"name": "ソラス", "text": "私もそのつもりでしたよ？\n２０層まで上り詰めれば、魔王ガリウスに\n対抗できる力が身につくだろうと思っていたので。", "face": "u904"}, {"name": "ソラス", "text": "けれど、もし『魔王以上の脅威』が迫ったなら……。\nそんな時に備えて、塔が最適な形に\n自己増殖するよう、細工を施しておいたんです。", "face": "u904"}, {"name": "ユージェン", "text": "今の私達では、天界の異変に対抗できないと……。\nそれで突然、２１層に続く階段が現れたということか。", "face": "u906"}, {"name": "アトナテス", "text": "まぁ、新しい修行の場が増えるのは良いことだけどな。\nそれより、塔なんかに\nお前は実力不足だって言われるのは不服だぜ。", "face": "u908"}, {"name": "ソラス", "text": "ふふふ、さすがに塔が\n自分でそこまで判断はしませんよ♪", "face": "u904"}, {"name": "ソラス", "text": "英傑の塔の意思というべきもの。\n次代の英雄にあらゆる智慧と武技を授けんと、\n成長を促すための管理魔術を編み上げたのは――", "face": "u904"}, {"name": "ソラス", "text": "――王子君、あなたのご先祖さま、\nそして私達の仲間であった英雄王なんですよ。", "face": "u904"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ソラス", "text": "私は彼の未来を想う願いを再現できるように、\nこの塔を設計したに過ぎませんからね！", "face": "u904"}, {"name": "アトナテス", "text": "なるほどな……。\nあいつが王子を助けようとしてくれてるってことか。", "face": "u908"}, {"name": "ソラス", "text": "はい♪　お人好しはご先祖様譲りですね、王子君♪", "face": "u904"}, {"name": "サナラ", "text": "あ、ちょっとうれしそうですね。\nほっぺが緩んでますよ？", "face": "u921"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "トゥアン", "text": "ふん、上等だ。\nさぁ王子、英雄王にお前の実力を見せてやろうぜ！", "face": "u1006a1"}, {"name": "ソラス", "text": "それでは２１層の試練を起動しますよ！\n王子君、戦闘準備をお願いします！", "face": "u904"}]}], "active": true}