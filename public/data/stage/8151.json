_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124336, "special_effect_id": 510, "change_to": 13, "change_condition": 2, "master_id": 32735, "global_id": 6353, "to_condition": 2, "to_global_id": 6354, "spawn_sec": 233}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団", "アンデッド"], "hp": 100000, "attack": 1000, "base_hp": 100000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 10000, "magic_defense": 90, "attack_speed": 1, "attack_wait": 120, "attack_interval": 292, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124352, "special_effect_id": 562, "master_id": 32736, "global_id": 6354, "from_condition": 2}, {"enemy_id": 15, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 3500, "attack": 240, "base_hp": 3500, "base_attack": 240, "damage_type": "magical", "armor_defense": 1500, "attack_range": 180, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127424, "special_effect_id": 510, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 33527, "global_id": 7144, "ranged": true, "spawn_sec": 275}, {"enemy_id": 16, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4200, "attack": 380, "base_hp": 4200, "base_attack": 380, "damage_type": "magical", "armor_defense": 1500, "attack_range": 140, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127440, "special_effect_id": 510, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33528, "global_id": 7145, "ranged": true, "spawn_sec": 318}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団"], "hp": 64000, "attack": 2100, "base_hp": 64000, "base_attack": 2100, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 240, "attack_speed": 1, "attack_wait": 1, "attack_interval": 43, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127584, "special_effect_id": 510, "change_to": 17, "change_condition": 4, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 33537, "global_id": 7154, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 7155, "spawn_sec": 331}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団"], "hp": 64000, "attack": 1050, "base_hp": 64000, "base_attack": 1050, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 240, "attack_speed": 1, "attack_wait": 70, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127600, "special_effect_id": 510, "change_to": 16, "change_condition": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33538, "global_id": 7155, "ranged": true, "from_condition": 4, "trigger_ticks": 1}], "popups": ["\n\n\n　　――北の大国へ続く街道", "ジメネスの攻撃は、\nデーモン、ハーフデーモン、\nヴァンパイア、アンデッド系の\n味方ユニットに対する\nダメージが50％アップします。", "ジメネスとジメネスの幻影は、\n戦場にいる神聖騎士の総数に応じて\n攻撃力と防御力がアップします。", "　　　　　【天界】\n・味方攻撃力が最終値から-500。\n・アンデッド、デーモン系を除く\n　味方、敵ユニットの\n　HPが徐々に回復。\n※これらは、風水使いなどがもつ\n　地形効果を軽減する能力では\n　軽減できません。", "白い鎧の神聖騎士は、\n戦場にいる神聖騎士の総数に応じて\n攻撃力と防御力がアップします。", "ホワイトクルセイダーは倒されると、\nその場で復活します。\n\n復活後、ホワイトクルセイダーは\n強くなりますが、HPが徐々に減少し\nいずれ自滅します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――北の大国へ続く街道"}, {"name": "神聖騎士団員", "text": "ジメネス様、次なる標的がそろそろここを通ります。", "face": "lfe88e3d63fb9"}, {"name": "ジメネス", "text": "敬虔なる信徒たちよ、邪教の徒に一切の慈悲はいらぬ。\nその肉体の一欠片まで滅することで、\n罪と穢れを祓ってやるのだ。", "face": "l775d5edcc73c"}, {"name": "神聖騎士団員", "text": "はっ！", "face": "lfe88e3d63fb9"}, {"name": "ジメネス", "text": "（鋼の都に住まう悪魔の発明家は、\n王国の手に落ちたと報告があった……）", "face": "l775d5edcc73c"}, {"name": "ジメネス", "text": "（だが、あの者だけで天に手が届くことはなかろう。\nそして今の戦力で、\n王国軍と正面から激突するのも悪手だ）", "face": "l775d5edcc73c"}, {"name": "ジメネス", "text": "（なれば、今なすべきことは――）", "face": "lc2cef43b7b51"}, {"name": "ジメネス", "text": "王国が重鎮、政務官が肉親の身柄を確保し、\n我らが真なる雷神の教えに改宗させること、か。", "face": "l775d5edcc73c"}, {"name": "神聖騎士団員", "text": "ジメネス様、北の大国の馬車が来ました！\nた、ただ……想定外のことが……。", "face": "lfe88e3d63fb9"}, {"name": "神聖騎士団員", "text": "同時に、王国軍本隊の隊列も\nこちらへ接近中とのことです！", "face": "lfe88e3d63fb9"}, {"name": "ジメネス", "text": "どこまでも忌々しい連中が……。", "face": "l775d5edcc73c"}, {"name": "ジメネス", "text": "殲滅を目標とする必要はない。\n邪教徒との戦いは一度や二度で終わるものではないのだ。\n着実に、目標を捕らえることのみを考えよ。", "face": "l775d5edcc73c"}]}, {"trigger": "start", "lines": [{"name": "？？？", "text": "――姫殿下、そろそろ王国軍との合流地点です。\nただ、何か嫌な魔力の流れが。", "face": "u2048a1"}, {"name": "シビラ", "text": "ありがとう、アンジェラ。\nさて、どっちを狙ったものかしらね……。\n私の国も、王国も、敵が多いから。", "face": "u39"}, {"name": "レクテ", "text": "――おーじ様！\nあれ、北の大国の人たちじゃない？", "face": "u2047a1"}, {"name": "フローガ", "text": "無事に合流できそう……ではありますが、\nなんだか気持ち悪い魔力の波を感じますね……。", "face": "u878"}, {"name": "ジメネス", "text": "――例の発明家に、件の魔女まで揃っている、か。\nこれは神の導きである。\n我が同胞たちよ、これより神罰をなすのだ！", "face": "l775d5edcc73c"}, {"name": "ノーマ", "text": "あぁあぁぁあッ！　またこれぇ！？\n王子、あのジメネスってやつ、\n天界と同じ結界を張ってるみたいよ！", "face": "u1047a1"}, {"name": "レアン", "text": "くっ……力は抑制されているのに、\n傷が勝手に癒えていくのは、気持ち悪いな……。", "face": "u50"}, {"name": "レクテ", "text": "えっ、傷が癒える……？\nそんな感じしないんだけど……。", "face": "u2047a1"}, {"name": "ノーマ", "text": "私たちみたいなデーモンや、アンデッドには\n癒やしの効果がないの！\nこれだから天界の力ってやつは！", "face": "u1047a1"}]}, {"trigger": "battle", "at_sec": 44, "lines": [{"name": "ジメネス", "text": "異教の民よ、邪神を崇める邪教の者たちよ。\n我らは地上の神罰代行者。\n汝らに、死による浄化を与えん。", "face": "l775d5edcc73c"}, {"name": "ノーマ", "text": "あいつ、攻撃も治癒もできるみたいね。\n顔が怖いだけあるわ。腕利きの魔術師じゃない。", "face": "u1047a1"}, {"name": "アンジェラ", "text": "それだけではありません。\nあなたのようなデーモンや、\nアンデッドの方は特に注意を払ってください。", "face": "u2048a1"}, {"name": "アンジェラ", "text": "ジメネスの魔法は、強い浄化の力を宿しています。\nデーモン、アンデッドの方は\n想定より大きな被害を受けかねません。", "face": "u2048a1"}]}, {"trigger": "end", "lines": [{"name": "ジメネス", "text": "（王子まで合流したか……。\nこの作戦は失敗だな）", "face": "lc2cef43b7b51"}, {"name": "ジメネス", "text": "我が同胞たちよ、我らが主は\n信徒が命を落とすことを望まれない。\n友を守り、我らが神殿へと退くのだ。", "face": "l775d5edcc73c"}, {"name": "神聖騎士団員", "text": "はっ！　動けぬ者に手を貸せ！\n撤退するぞ！！", "face": "lfe88e3d63fb9"}, {"name": "アンナ", "text": "……神聖騎士団、撤退していきます。", "face": "lc125164f5e2c"}, {"name": "シビラ", "text": "お疲れ様、王子。\nこんな街道にまで神聖騎士団が現れるなんて、\nまた警備を手厚くしないといけないわね。", "face": "u39"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "レクテ", "text": "あの顔、ほんっと怖かったぁ……。\n守ってくれてありがとうございましたぁ……。", "face": "u2047a1"}, {"name": "レクテ", "text": "あ、あの、ところで……。\nアンジェラ、さん？\nどうしてあたしの後ろに隠れてるの？", "face": "u2047a1"}, {"name": "アンジェラ", "text": "……少し、その、事情が。", "face": "u2048a1"}, {"name": "レクテ", "text": "事情？　あっ、アンナさん！\nこの魔術師さん、さっきの戦いで\n手を貸してくれて――もごごぉっ！？", "face": "u2047a1"}, {"name": "アンジェラ", "text": "事情があるんですって言いましたよね！？\nアンナお姉様たちにご迷惑をおかけするわけには――", "face": "u2048a1"}, {"name": "レクテ", "text": "ぷはっ！\nいやぁ、もう手遅れだよ。\nほら、満面の笑みでこっちに駆け寄って来てるし。", "face": "u2047a1"}, {"name": "アンナ", "text": "アンジェラ！\nよかった、無事みたいですね。"}, {"name": "アンジェラ", "text": "は、はい……うぅ、ご迷惑をおかけして……。", "face": "u2048a1"}, {"name": "ケイティ", "text": "（おや？　アンジェラ……？\n確かアンナさんの母君のお名前では？）", "face": "u114"}, {"name": "アリシア", "text": "（ですです。\nアンナお姉様の母君と、\nアンジェラお姉様は同じ名前なんですよ）", "face": "u372"}, {"name": "アリシア", "text": "（お母様から聞いた話では、\n伯母様――アンジェラお姉様の母君は、\n小さい頃、大のお姉ちゃんっ子だったそうで）", "face": "u372"}, {"name": "ケイティ", "text": "（なるほど。\nそれで尊敬する姉の名を、愛する娘に付けたと。\nああ、でもあの姿を見ると――）", "face": "u114"}, {"name": "アンナ", "text": "もうっ、何が迷惑なものですか。\n困ったことがあってもなくても、\n私を頼ってといつも言っていますよね？", "face": "lc125164f5e2c"}, {"name": "アンジェラ", "text": "えっ、いや、あの、お手紙にはそう書かれてましたが、\nなんというのか畏れ多いというか、\n圧が強すぎて怖いというか……。", "face": "u2048a1"}, {"name": "アンナ", "text": "従姉妹なんですから、\nちゃんと頼ってくださいね？", "face": "lc125164f5e2c"}, {"name": "アンジェラ", "text": "は、はい……。", "face": "u2048a1"}, {"name": "ケイティ", "text": "ふふっ、親世代はお姉ちゃん大好きな妹。\n子世代は妹大好きなお姉ちゃん、ですか。", "face": "u114"}, {"name": "アリシア", "text": "でも、あれはちょっと困らせ過ぎなので……。\nアンナお姉様、抱きつくのは拠点に戻ってからで！", "face": "u372"}, {"name": "アンナ", "text": "はっ、そうでした……。\nこほん……おかえりなさい、アンジェラ。\n王国軍はあなたを歓迎します！"}, {"name": "アンジェラ", "text": "――はい。\nアンジェラ、ただいま王国へ帰還しました♪", "face": "u2048a1"}]}], "active": true}