{"quest_id": 8151, "name": "ジメネスの狙い", "description": "襲い来るジメネスを仲間と協力し撃退せよ！\n＜天界：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復＞\n神級EX（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["天界：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復"], "event": "遥かな空を目指すには？", "event_category": "History", "mission_id": 920209, "map_no": 4837, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -500]}, {"kind": "term", "influence": 41, "params": [0, 100, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 20, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["神聖騎士団"], "hp": 83000, "attack": 3800, "base_hp": 83000, "base_attack": 3800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 90, "attack_interval": 321, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2149744, "special_effect_id": 993, "change_to": 1, "change_condition": 4, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 37013, "global_id": 10630, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 10631, "spawn_sec": 42}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["神聖騎士団"], "hp": 83000, "attack": 2500, "base_hp": 83000, "base_attack": 2500, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2149760, "special_effect_id": 1596, "change_condition": 4, "missile_id": 509, "missile": {"speed": 15.0, "splash": 67, "slow": [50, 65]}, "master_id": 37014, "global_id": 10631, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 3, "source": "local", "count": 9, "form_count": 4, "tags": ["神聖騎士団"], "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 321, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2149184, "special_effect_id": 993, "change_to": 3, "change_condition": 4, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 37015, "global_id": 10632, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 10633, "sp_change_to": [37017, 37018], "spawn_sec": 148}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["神聖騎士団"], "hp": 12000, "attack": 650, "base_hp": 12000, "base_attack": 650, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2149200, "special_effect_id": 1596, "change_to": 2, "change_condition": 4, "missile_id": 509, "missile": {"speed": 15.0, "splash": 67, "slow": [50, 65]}, "master_id": 37016, "global_id": 10633, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["神聖騎士団", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 1, "attack_wait": 90, "attack_interval": 250, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "p