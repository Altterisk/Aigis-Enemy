{"quest_id": 7917, "name": "バケツちゃんと堕天使", "description": "次なる謎、正体不明の掃除当番を探す一行。\n現場を調査しているとバケツの付喪神と\n一緒に掃除をするクロエがいて？\n極級（★１獲得の目安：平均Lv25）", "event": "王国学園七不思議", "event_category": "History", "mission_id": 920195, "map_no": 4709, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 10, "base_hp": 10, "damage_type": "physical", "attack_speed": 1, "attack_wait": 30, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2143488, "race_id": 4, "special_effect_id": 1293, "change_to": 1, "change_condition": 2, "master_id": 36031, "global_id": 9648, "to_condition": 2, "to_global_id": 9642}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6500, "base_hp": 6500, "damage_type": "magical", "armor_defense": 1600, "magic_defense": 5, "attack_speed": 45, "attack_wait": 50, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2143504, "race_id": 4, "special_effect_id": 1179, "master_id": 36025, "global_id": 9642, "from_condition": 2, "spawned_on_death_by": [1, 5]}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 1800, "base_hp": 40000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 50, "attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118160, "race_id": 6, "special_effect_id": 222, "master_id": 31652, "global_id": 5271}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 1, "hp": 750, "attack": 150, "base_hp": 750, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 5, "attack_interval": 91, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2133632, "race_id": 9, "master_id": 34655, "global_id": 8272, "spawn_sec": 11}, {"enemy_id": 5, "source": "local", "count": 17, "form_count": 2, "hp": 10, "base_hp": 10, "damage_type": "physical", "attack_speed": 1, "attack_wait": 30, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2143488, "race_id": 4, "special_effect_id": 1179, "change_to": 1, "change_condition": 2, "master_id": 36024, "global_id": 9641, "to_condition": 2, "to_global_id": 9642, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 46}, {"enemy_id": 6, "source": "local", "count": 12, "form_count": 1, "hp": 2000, "attack": 380, "base_hp": 2000, "base_attack": 380, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127936, "race_id": 16, "master_id": 33579, "global_id": 7196, "spawn_sec": 49}, {"enemy_id": 7, "source": "local", "count": 9, "form_count": 1, "hp": 1600, "attack": 320, "base_hp": 1600, "base_attack": 320, "damage_type": "physical", "armor_defense": 90, "attack_range": 100, "attack_speed": 1, "attack_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127968, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 33581, "global_id": 7198, "ranged": true, "spawn_sec": 74}, {"enemy_id": 8, "source": "local", "count": 16, "form_count": 1, "hp": 1200, "attack": 180, "base_hp": 1200, "base_attack": 180, "damage_type": "physical", "attack_speed": 40, "attack_wait": 5, "attack_interval": 91, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2133648, "race_id": 9, "master_id": 34656, "global_id": 8273, "spawn_sec": 104}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "hp": 5400, "attack": 540, "base_hp": 5400, "base_attack": 540, "damage_type": "physical", "armor_defense": 210, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127952, "race_id": 16, "master_id": 33580, "global_id": 7197, "spawn_sec": 149}], "dialogue": [{"trigger": "start", "lines": [{"name": "ロヴィニア", "text": "それで、次の七不思議は何なの？", "face": "u1778a1"}, {"name": "サクヤ", "text": "次は……『正体不明の掃除当番』ですね。\n当番の仕事を忘れていたら誰かが代わってくれていた。\nそんな怪奇現象が何度も発生しているのだそうです。", "face": "u1774a1"}, {"name": "ロヴィニア", "text": "平和ッ！", "face": "u1778a1"}, {"name": "ホムラ", "text": "それは……普通に親切な誰かさんか、\nどっかの綺麗好きがやってるんじゃないか？", "face": "u1185a1"}, {"name": "サクヤ", "text": "私もそう考えているのですが、\n王国学園不思議倶楽部の部長として、\nやはり自分の目で確かめないことには──", "face": "u1774a1"}, {"name": "ロヴィニア", "text": "──あ、見て見て！　あそこ！", "face": "u1778a1"}]}, {"trigger": "battle", "at_sec": 5, "lines": [{"name": "ロヴィニア", "text": "バケツの付喪神だ！　カワイイ！", "face": "u1778a1"}, {"name": "サクヤ", "text": "なるほど、あの子たちが……。", "face": "u1774a1"}, {"name": "クレア", "text": "んんっ？　待って、その隣にいるのは──", "face": "u1444a1"}, {"name": "クロエ", "text": "おっそうじ♪　おっそうじ♪　楽しいな～♪\nバケツちゃんたちー？　今日もお掃除がんば──あ。", "face": "u784"}, {"name": "ホムラ", "text": "………………。", "face": "u1185a1"}, {"name": "クロエ", "text": "…………見た？", "face": "u784"}, {"name": "ホムラ", "text": "ひゅー、ひょろろー。", "face": "u1185a1"}, {"name": "サクヤ", "text": "どうしたんですか、ホムラさん。\n急に下手な口笛をお吹きになって。", "face": "u1774a1"}, {"name": "ホムラ", "text": "いま天然発揮しなくていいんだよ！？", "face": "u1185a1"}, {"name": "クロエ", "text": "そっかー、見ちゃったかー。\nそれならもー、仕方ないよねー。", "face": "u784"}, {"name": "クロエ", "text": "消してやる……！　その記憶……！\n全部、この世から……！　欠片も残さず！", "face": "u784"}, {"name": "ホムラ", "text": "だーもうっ！　サクヤのせいだぞ！", "face": "u1185a1"}, {"name": "ロヴィニア", "text": "なんで毎回襲われるのー！？", "face": "u1778a1"}]}, {"trigger": "end", "lines": [{"name": "クロエ", "text": "うがーーっ！　忘れろ忘れろ忘れろーッ！", "face": "u784"}, {"name": "ロヴィニア", "text": "どうどう、落ち着いてねー、クロエちゃん。", "face": "u1778a1"}, {"name": "サクヤ", "text": "どうしてお怒りになられているのでしょうか？\nクロエさんのお掃除はとても素晴らしい心掛けです。", "face": "u1774a1"}, {"name": "サクヤ", "text": "褒められこそすれ、\n隠すようなことではないと思いますが……。", "face": "u1774a1"}, {"name": "クロエ", "text": "隠すようなことなんだよ。\nあたしがこんなことしてるなんて、\nみんなには知られたくないもん。", "face": "u784"}, {"name": "ホムラ", "text": "みんな……ああ、小悪魔ガールズ見守り隊か。", "face": "u1185a1"}, {"name": "ロヴィニア", "text": "あったねー、そんなファンクラブ。", "face": "u1778a1"}, {"name": "クロエ", "text": "あの堕天系小悪魔的カリスマギャルが、\n本当はお掃除大好き、バケツが友達だなんてさ、\nみんなが知ったらガッカリさせちゃうじゃん。", "face": "u784"}, {"name": "クレア", "text": "（堕天系小悪魔的カリスマギャル……）", "face": "u1444a1"}, {"name": "クロエ", "text": "ただでさえ最近はあたしに憧れてくれる、\n女の子の後輩とかも少し増えてきたのに……。", "face": "u784"}, {"name": "サクヤ", "text": "……いいえ、それは違いますよクロエさん。\n貴方のそれは恥ずべきものでは決してありません。\n世の中には、ギャップ萌えなるものがあるそうです。", "face": "u1774a1"}, {"name": "クロエ", "text": "ギャップ萌え……。", "face": "u784"}, {"name": "サクヤ", "text": "お掃除大好き、結構ではありませんか。\n家庭派堕天系小悪魔的カリスマギャルです！", "face": "u1774a1"}, {"name": "クロエ", "text": "家庭派堕天系小悪魔的カリスマギャル……！", "face": "u784"}, {"name": "ホムラ", "text": "長ぇよ。", "face": "u1185a1"}, {"name": "サクヤ", "text": "貴方の個性を大事にしてください。\nみんなで仲良くお掃除をしましょう。", "face": "u1774a1"}, {"name": "クロエ", "text": "うん、レッツクリーニングだね……！", "face": "u784"}, {"name": "ロヴィニア", "text": "…………うん、良い話！", "face": "u1778a1"}, {"name": "ホムラ", "text": "そうでもねぇと思うぞ。", "face": "u1185a1"}]}], "active": true}