mor_defense": 40, "attack_speed": 1, "attack_wait": 1, "attack_interval": 20, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2145712, "race_id": 12, "special_effect_id": 621, "master_id": 36329, "global_id": 9946, "spawn_sec": 154}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 3, "tags": ["置物", "植物", "狙う", "ブロック不可"], "fixture": true, "hp": 80, "base_hp": 100, "damage_type": "physical", "attack_speed": 1, "attack_wait": 60, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2157808, "special_effect_id": 1926, "change_to": 15, "master_id": 22429, "global_id": 2712, "to_global_id": 2675, "to_flag": [1, 1], "commands": {"raw": "SetStageFlag(1, 0); SetStageFlag(2, 0); SetStageFlag(3, 0); SetStageFlag(4, 0); SetStageFlag(3, 1);", "sets_flags": [[1, 0], [2, 0], [3, 0], [4, 0], [3, 1]]}, "route_behaviour": {"transforms": [{"flag": 1, "val": 1}], "sets_flags": [[4, 1, 0]]}, "spawn_sec": 250}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["置物", "植物"], "fixture": true, "hp": 80, "base_hp": 100, "damage_type": "physical", "attack_speed": 1, "attack_wait": 60, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2157840, "special_effect_id": 1926, "change_to": 16, "change_condition": 2, "master_id": 22392, "global_id": 2675, "to_condition": 2, "to_global_id": 2693, "from_flag": [1, 1]}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["置物"], "fixture": true, "hp": 48000, "base_hp": 60000, "damage_type": "physical", "magic_defense": 30, "attack_speed": 1, "attack_wait": 60, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2157920, "special_effect_id": 1926, "master_id": 22410, "global_id": 2693, "from_condition": 2}, {"enemy_id": 18, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 80000, "base_hp": 100000, "damage_type": "physical", "attack_speed": 1, "attack_wait": 60, "attack_interval": 162, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2097200, "special_effect_id": 1955, "master_id": 22431, "global_id": 2714, "route_behaviour": {"force_dead": true}, "spawn_sec": 251}], "dialogue": [{"trigger": "end", "lines": [{"name": "ケツァルコアトル", "text": "――見事なり、人類の英雄よ、勇敢なる戦士たちよ。", "face": "ld9b508b1cb99"}, {"name": "パルセ", "text": "ふぅ……死にそうな雰囲気なんて全然ないのに、\nこの身はもう長くないなんて言いだすから、\n本当に焦りましたよ、ケツァルコアトル。", "face": "u2276a1"}, {"name": "ケツァルコアトル", "text": "ふん、小娘に心配されるほど老いぼれてはおらぬわ。\nこの密林は、これからも我が守護せねばな！", "face": "ld9b508b1cb99"}, {"name": "アイシャ", "text": "やれやれ……困った神獣だよ。\nでも、生きる気力を取り戻してくれてよかった。", "face": "u181"}, {"name": "ケツァルコアトル", "text": "とはいえ、この祭殿から離れられぬのもまた事実。\n貴様らの戦いに、助力するのは難しい。", "face": "ld9b508b1cb99"}, {"name": "ケツァルコアトル", "text": "そこで王子よ、我が羽と鱗を譲ろう。\n我が権能の断片を宿した、魔力の塊だ。", "face": "ld9b508b1cb99"}, {"name": "ケツァルコアトル", "text": "鱗は強力無比なる武具に、\n羽はその身を守る装束に使うがよい。", "face": "ld9b508b1cb99"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ケツァルコアトル", "text": "では我が信徒たちよ！\n近隣の里の者らも呼んで参れ！", "face": "ld9b508b1cb99"}, {"name": "ケツァルコアトル", "text": "これより王国の勇者たちを讃える、\n密林大宴会を始めようぞ！！", "face": "ld9b508b1cb99"}, {"name": "アンナ", "text": "……これは、断れない雰囲気ですね。"}, {"name": "アンナ", "text": "ともあれ、此度の戦い、お疲れ様でした！"}]}, {"trigger": "route", "lines": [{"name": "レギーナ", "text": "よし、リュウゼツランを破壊したぞ！", "face": "u405"}, {"name": "アイシャ", "text": "ん……何か光って……？", "face": "u181"}, {"name": "パルセ", "text": "…………羽？\nリュウゼツランから、光る羽が出てきました！", "face": "u2276a1"}, {"name": "ケツァルコアトル", "text": "この温もりは……輝きは……。\nおぉ、おぉ……！　ケツァルペトラトル！\n我が愛しき妹よ、そこにいたのか……！！", "face": "ld9b508b1cb99"}, {"name": "アイシャ", "text": "まさか……千年戦争で消滅したはずの、\nケツァルペトラトルが、生きていたってこと？", "face": "u181"}, {"name": "徐華", "text": "いや……おそらくその断片じゃ。\n粉々に砕け散った力の残滓が、\n密林全土に広がっていたのじゃろ。", "face": "u1896a1"}, {"name": "徐華", "text": "木々にも、花にも、\nケツァルペトラトルの\n断片が宿っておったということじゃな。", "face": "u1896a1"}, {"name": "パルセ", "text": "……ケツァルコアトル！\n生きる意志を、取り戻せましたか？", "face": "u2276a1"}, {"name": "ケツァルコアトル", "text": "ユニコーン、何を――", "face": "ld9b508b1cb99"}, {"name": "パルセ", "text": "家族を亡くし、生きる意志も失ったあなたは、\n王子にすべてを譲って消えようと考えたのでしょう。", "face": "u2276a1"}, {"name": "パルセ", "text": "ですが、この密林そのものが、\nケツァルペトラトルの生きた証ではありませんか！", "face": "u2276a1"}, {"name": "ケツァルコアトル", "text": "なるほど……ふふふ、口の上手い小娘が。\nよかろう、ならばこれより先は手を抜かぬ。\n我が真なる力を見せてやろうぞ！", "face": "ld9b508b1cb99"}, {"name": "フローガ", "text": "あの輝く白い羽から、とんでもない魔力が\nケツァルコアトルへ流れ込んでいます！\nあのまま羽を残しておくと危険です！", "face": "u878"}]}], "active": true}