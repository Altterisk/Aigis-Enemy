{"quest_id": 6658, "name": "砂中の大食漢", "description": "巨大な体躯で地中から襲い来る難敵、\n『ジャイアントクロウラー』を討伐せよ！\n＜出撃時の初期ＨＰ減少：小＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["出撃時の初期ＨＰ減少：小"], "event": "ゴールドラッシュ22(2018)", "event_category": "Reproduce", "mission_id": 300217, "map_no": 3460, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 22, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 60, "attack_wait": 30, "attack_interval": 173, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098144, "master_id": 91, "global_id": 90, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 30000, "attack": 1300, "base_hp": 30000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 95, "attack_interval": 273, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116688, "missile_id": 329, "missile": {"speed": 7.0}, "master_id": 31398, "global_id": 5017, "ranged": true, "spawn_sec": 43}, {"enemy_id": 3, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098416, "race_id": 2, "master_id": 85, "global_id": 84, "spawn_sec": 68}, {"enemy_id": 4, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 1800, "attack": 500, "base_hp": 1800, "base_attack": 500, "damage_type": "physical", "armor_defense": 180, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098368, "race_id": 2, "master_id": 88, "global_id": 87, "spawn_sec": 95}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "巨大なワーム……ジャイアントクロウラーが\n出現したというのは、この辺りですか？", "face": "l60362c483024"}, {"name": "フーリ", "text": "はい、今は静かですが、\n次にいつ暴れだすか分からない状況で……。\n今はアサルさん達が、交代で見張ってくれています。", "face": "u174"}, {"name": "アサル", "text": "――あっ、フーリさん。\n王子達を連れてきてくれたんですね。", "face": "u172"}, {"name": "フーリ", "text": "見張り、お疲れ様ですアサルさん。\nジャイアントクロウラーの様子はどうですか？", "face": "u174"}, {"name": "アサル", "text": "今は眠っているのか、落ち着いていますね。\nですが目を覚まして、人里を襲撃したら\nなんて、想像もしたくないですね……。", "face": "u172"}, {"name": "ゾラ", "text": "砂漠の住人に被害が出る前に、\n可能ならここで討伐してしまいたいな。", "face": "u165"}, {"name": "アサル", "text": "ですがこの周辺には、敵対的な竜人もいますし、\nジャイアントクロウラーの周囲には、\n複数のサンドワームも確認されて――", "face": "u172"}, {"name": "フーリ", "text": "――ア、アサルさん、私もそう思っていたんですけど、\nちょっとこれ、手遅れだったみたいです……！！", "face": "u174"}, {"name": "ゾラ", "text": "この地鳴り……くっ、ちょうどジャイアントクロウラーが\n目を覚ます頃合いだったということか！", "face": "u165"}, {"name": "レアン", "text": "奴もワームの一種なら、\n地中を進軍してくるかもしれない。重装甲の\n連中で受け止めるから、そこを総攻撃してくれ。", "face": "u50"}, {"name": "アンナ", "text": "わかりました。王子、時間がありません。\n急ぎ迎撃の準備をお願いします！", "face": "l60362c483024"}]}, {"trigger": "end", "lines": [{"name": "アサル", "text": "しばらく長いものは見たくないですね……。\nともかく、討伐できて良かったです。\n王子、皆さん、ありがとうございました。", "face": "u172"}, {"name": "フーリ", "text": "これでこの周辺は、\nしばらく安全そうですね。", "face": "u174"}, {"name": "ゾラ", "text": "ふぅ、前衛がいてくれて助かったよ。\n遠距離攻撃主体の私達だけじゃ、\nきっとお手上げだったからな。", "face": "u165"}, {"name": "レアン", "text": "おかげで前衛は、あのワームの親玉みたいなやつを\n受け止め続けるはめになったが……。\n皆が無事で何よりだよ。", "face": "u50"}, {"name": "フーリ", "text": "それでは私は、\n他にもジャイアントクロウラーの巣がないか、\n周辺の調査をしてきますね。", "face": "u174"}, {"name": "アサル", "text": "私も行きましょう。\nフーリさん一人では心配ですしね。", "face": "u172"}, {"name": "アンナ", "text": "分かりました。それでは私達は、\n一度拠点へ戻りましょうか。\nジャイアントクロウラー討伐、お疲れ様でした。"}]}], "map": {"image": "Map3460", "w": 960, "h": 640, "spots": [{"k": "b", "x": 35, "y": 139}, {"k": "m", "x": 355, "y": 243, "id": 200}, {"k": "m", "x": 438, "y": 138, "id": 201}, {"k": "m", "x": 360, "y": 410, "id": 202}, {"k": "m", "x": 425, "y": 330, "id": 203}, {"k": "m", "x": 269, "y": 474, "id": 204}, {"k": "m", "x": 563, "y": 372, "id": 205}, {"k": "m", "x": 718, "y": 382, "id": 206}, {"k": "m", "x": 830, "y": 310, "id": 207}, {"k": "m", "x": 221, "y": 252, "id": 208}, {"k": "m", "x": 802, "y": 184, "id": 209}, {"k": "m", "x": 564, "y": 75, "id": 210}, {"k": "m", "x": 709, "y": 87, "id": 211}, {"k": "m", "x": 139, "y": 178, "id": 212}, {"k": "m", "x": 162, "y": 449, "id": 213}, {"k": "r", "x": 459, "y": 422, "id": 300}, {"k": "r", "x": 757, "y": 331, "id": 301}, {"k": "r", "x": 570, "y": 316, "id": 302}, {"k": "r", "x": 450, "y": 247, "id": 303}, {"k": "r", "x": 348, "y": 321, "id": 304}, {"k": "r", "x": 520, "y": 170, "id": 305}, {"k": "r", "x": 325, "y": 158, "id": 306}, {"k": "r", "x": 182, "y": 124, "id": 307}, {"k": "r", "x": 640, "y": 436, "id": 308}, {"k": "r", "x": 470, "y": 71, "id": 309}, {"k": "r", "x": 128, "y": 375, "id": 310}, {"k": "r", "x": 86, "y": 224, "id": 311}]}, "active": true}