{"quest_id": 7223, "name": "ツルっと万来 獣の御一行", "description": "ある雪の日、寒さに震える獣たちが\n温泉へと押し寄せた！\n獣たちを落ち着かせ、混乱を収めよ！\n上級（★１獲得の目安：平均Lv10）", "event": "王国おんせん繁盛記", "event_category": "History", "mission_id": 920154, "map_no": 5849, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 17, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 28}, {"enemy_id": 2, "source": "local", "count": 29, "form_count": 2, "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104272, "race_id": 14, "change_to": 2, "master_id": 33324, "global_id": 6941, "to_global_id": 6942, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 56}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 105, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104320, "race_id": 14, "special_effect_id": 229, "change_to": 1, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 33325, "global_id": 6942, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 820, "base_hp": 6000, "base_attack": 820, "damage_type": "physical", "armor_defense": 220, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 205, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101248, "master_id": 227, "global_id": 226, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 65}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 2, "hp": 8000, "attack": 1100, "base_hp": 8000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104400, "race_id": 14, "change_to": 5, "master_id": 33326, "global_id": 6943, "to_global_id": 6944, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 95}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 5, "attack_interval": 55, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104416, "race_id": 14, "special_effect_id": 229, "change_to": 4, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 33327, "global_id": 6944, "ranged": true}], "popups": ["\n\n\n　　　――ある日の温泉宿。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シュシュ", "text": "た、たたた、たいへんなんですー！！", "face": "u979"}, {"name": "ソーマ", "text": "どうしたんですかシュシュちゃん！？\nタオル姿で出てきちゃだめですよー！？", "face": "u23"}, {"name": "シュシュ", "text": "ソーマさん、サオシュさん……じゃなかった！\n若女将さんたち、大変なんですよぉ！", "face": "u979"}, {"name": "サオシュ", "text": "……落ちつきましょう？\nいっしょに深呼吸です、すー、はー。", "face": "u968"}, {"name": "シュシュ", "text": "す、すー、ひゃー……。\nこほん……い、一大事なんですー！\n温泉が動物さんに占拠されちゃいましたー！！", "face": "u979"}, {"name": "ソーマ", "text": "温泉を、動物さんが占拠……！？\nいったいどういうことなんですか！？", "face": "u23"}, {"name": "サオシュ", "text": "……お外は雪、ぶるぶる寒くて、\nだから動物さんたちが\n温泉に殺到しちゃったのでしょうか……？", "face": "u968"}, {"name": "シュシュ", "text": "最初は一緒に仲良く入ってたんですけどね……。\nそれが評判になっちゃったのか、\nほら、今も山の方からいっぱい足音が――", "face": "u979"}, {"name": "ソーマ", "text": "――あ、足音って……。\nすごい数ですよ！？", "face": "u23"}, {"name": "サオシュ", "text": "……いっせいに入ったら温泉が溢れちゃいます。\nそれに入泉料もいただいていませんし。", "face": "u968"}, {"name": "ソーマ", "text": "ですね！\n急いで王子を呼びに行きましょう！", "face": "u23"}, {"name": "サオシュ", "text": "はいっ、温泉防衛戦です……！", "face": "u968"}]}, {"trigger": "end", "lines": [{"name": "ソーマ", "text": "ふぅ……やっと落ち着いてくれましたね。", "face": "u23"}, {"name": "サオシュ", "text": "でも……こんな雪が積もっている中で、\n温泉に入らず帰れっていうのは可哀想ですよね……。", "face": "u968"}, {"name": "ソーマ", "text": "ですよね……うーん、どうしたら……。", "face": "u23"}, {"name": "シュシュ", "text": "あっ、それじゃあ山奥の秘湯に、\n動物さんたちを案内しちゃいましょうか♪", "face": "u979"}, {"name": "ソーマ", "text": "秘湯……？\nシュシュちゃん、いつのまにそんなものを……。", "face": "u23"}, {"name": "シュシュ", "text": "この辺りの魔物の生息地を探している時に、\n偶然ばっちり発見しちゃったんですよー♪", "face": "u979"}, {"name": "シュシュ", "text": "あっそうだ！\nよかったら三人で秘湯めぐりしちゃいませんか？\n動物さんたちと一緒に♪", "face": "u979"}, {"name": "サオシュ", "text": "えっと……でも私たちには、\n若女将としてのお仕事がありまして……。", "face": "u968"}, {"name": "エマ", "text": "――良いではありませんか。\nこれも魔物調査の一環といたしましょう。", "face": "u1137a1"}, {"name": "ソーマ", "text": "女将さん！\nえへ、女将さんがそういうなら、\n私たちも秘湯めぐりに行きましょうか！", "face": "u23"}, {"name": "シュシュ", "text": "やったぁー！\nそれじゃあおふたりとも、\nお風呂の準備を整えて集合ですよー！", "face": "u979"}, {"name": "エマ", "text": "……これも美しき輝きのひとつ。\n限りある生を、存分に楽しむのも、\n人の子に許された大切な権利なれば。", "face": "u1137a1"}, {"name": "エマ", "text": "宿のお手伝いは、そうですね、\n王子にお願いするといたしましょうか。――ふふっ。", "face": "u1137a1"}]}], "story_talk": true, "active": true}