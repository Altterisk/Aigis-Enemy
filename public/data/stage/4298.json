, "damage_type": "magical", "armor_defense": 200, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 133, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100592, "race_id": 10, "special_effect_id": 232, "missile_id": 44, "missile": {"speed": 8.0}, "master_id": 270, "global_id": 269, "ranged": true, "spawn_sec": 62}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "hp": 55000, "attack": 2200, "base_hp": 55000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 40, "attack_speed": 120, "attack_wait": 30, "attack_interval": 261, "move_speed": 250.0, "dot_rate": 1.7999999523162842, "pattern_id": 2100656, "special_effect_id": 242, "change_to": 9, "change_condition": 3, "master_id": 20022, "global_id": 1097, "to_condition": 3, "to_global_id": 1098, "spawn_sec": 86}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 55000, "attack": 2200, "base_hp": 55000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 40, "attack_range": 120, "attack_speed": 120, "attack_wait": 30, "attack_interval": 141, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "pattern_id": 2100656, "special_effect_id": 48, "missile_id": 57, "missile": {"speed": 12.0}, "master_id": 20023, "global_id": 1098, "ranged": true, "from_condition": 3}, {"enemy_id": 11, "source": "local", "count": 24, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 118}], "popups": ["魔王の影は、拠点には向かわず\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここは……。\n……なにか背筋が凍るような殺気が感じられます。", "face": "l67e3c62cf227"}, {"name": "ポーラ", "text": "私もここ……、嫌なのです。", "face": "u253"}, {"name": "兵士", "text": "報告！　何者かがこちらに向かってきます！", "face": "l19c8bba64df9"}, {"name": "アンナ", "text": "やはりですか。\n王子、参りましょう！", "face": "l67e3c62cf227"}]}, {"trigger": "battle", "at_sec": 12, "lines": [{"name": "冒険者", "text": "か、体が……ッ、勝手に……！！！", "face": "l2318e74fc12b"}, {"name": "シャルロット", "text": "なんですの……？\n体が、勝手に……！", "face": "u128"}, {"name": "シャルロット", "text": "みなさん、逃げてください！\nアタシこう見えて強いから危ないですわ！！", "face": "u128"}, {"name": "シャルロット", "text": "……！　\n勝手に魔法剣も発動してしまいましたわーっ！！！\nどうなってますのー！", "face": "u128"}]}, {"trigger": "battle", "at_sec": 93, "lines": [{"name": "アンナ", "text": "先ほどの不可思議な現象、\n魔王の影の仕業なのでしょうか……。", "face": "l67e3c62cf227"}]}, {"trigger": "end", "lines": [{"name": "シャルロット", "text": "やっと解放されましたわ……。", "face": "u128"}, {"name": "アンナ", "text": "教えてください、何があったのですか？", "face": "l67e3c62cf227"}, {"name": "シャルロット", "text": "何があったというか、操られる前に遠くから\n「王子を倒せ」と声が聞こえましたの。", "face": "u128"}, {"name": "冒険者", "text": "俺たちもだ！", "face": "l2318e74fc12b"}, {"name": "アンナ", "text": "みなさんが聞いたという何者かの声……。\nこの迷宮の探索を快く思わないものの仕業と\n考えると、魔王によるものではないかもしれません。", "face": "l67e3c62cf227"}, {"name": "ポーラ", "text": "なにか得るものがあったです？", "face": "u253"}, {"name": "アンナ", "text": "はい。魔物の復活について情報を得ることが\n叶わなかったのは残念ですが……。", "face": "l67e3c62cf227"}, {"name": "アンナ", "text": "封印されていると思われていた魔王の\n存在については確証を得ることができました。\nこれだけでも大きな収穫です。", "face": "l67e3c62cf227"}, {"name": "アンナ", "text": "今回得られた情報を元に、王国内でも\n調査を続けるべきでしょう。", "face": "l67e3c62cf227"}]}], "active": true}