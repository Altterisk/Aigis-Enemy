"attack": 2500, "base_hp": 86000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 255, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146032, "race_id": 4, "change_to": 15, "missile_id": 908, "missile": {"speed": 4.0, "splash": 133, "on_hit": {"kind": "攻撃遅延", "duration_f": 200, "attack_interval_f": 200, "effect_name": "HitEffectSlow"}}, "master_id": 36370, "global_id": 9987, "ranged": true, "to_global_id": 9988, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 132}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["水棲", "ブロック不可"], "hp": 86000, "attack": 3000, "base_hp": 86000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146064, "race_id": 4, "change_to": 16, "master_id": 36371, "global_id": 9988, "to_global_id": 9989}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["水棲"], "hp": 86000, "attack": 3000, "base_hp": 86000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146080, "race_id": 4, "change_to": 17, "change_condition": 1, "master_id": 36372, "global_id": 9989, "variants": [{"hp": 86000, "attack": 3000, "base_hp": 86000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146080, "race_id": 4, "special_effect_id": 1090, "master_id": 36373, "global_id": 9990}]}, {"enemy_id": 19, "source": "local", "count": 4, "form_count": 1, "tags": ["鳥", "水棲"], "hp": 9000, "base_hp": 9000, "damage_type": "physical", "armor_defense": 600, "attack_speed": 1, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132432, "race_id": 11, "master_id": 34505, "global_id": 8122, "spawn_sec": 189}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――魔物が復活した頃からだろうか。\n海路が絶たれ、人は海に出ることがなくなった。", "face": "l63fcaad3241b"}, {"name": "？？？", "text": "妖怪は、畏れを食わねば生きてゆけぬ。\nああ口惜しや、口惜しや……。\n我が配下どもに畏れを満足に食わせることもできぬ。", "face": "l63fcaad3241b"}, {"name": "海河童", "text": "ケケッ、気にしないでくだせェ。\n魔物が好き勝手しやがってた頃、\n海の仲間を守ってくれたのはアンタじゃねぇですかィ。", "face": "l15ef4255c9c0"}, {"name": "海河童", "text": "今だって亜神ドモが戦争おっぱじめて、\n妖怪の肩身が狭いってェのに、\nアンタはこうして棲家を分けてくれている。", "face": "l15ef4255c9c0"}, {"name": "海河童", "text": "クゥゥッ、どうして乙姫チャンは、\nこんなにイケてる「蜃」サマに\n振り向いてくれねェのかなァ！！", "face": "l15ef4255c9c0"}, {"name": "清源妙道真君", "text": "――それは愛情の押し付けだからでは？", "face": "u866"}, {"name": "メレディス", "text": "外に出たくないって子を、\n無理やり連れ出そうっていうのも良くないですね。", "face": "u400"}, {"name": "ハーニィ", "text": "対話なしに「結婚しろ」って迫るのも、\n一方的で印象は最悪ですねぇ。", "face": "u856"}, {"name": "海河童", "text": "な、なんだァこいつら！？\n東の国じゃ見ねェ顔ばかり――って、あぁッ！！\nテメェら浜辺で尻子玉集めを邪魔しやがった奴らだな！？", "face": "l15ef4255c9c0"}, {"name": "イヲナミ", "text": "あぁ！　ボクの尻子玉引っこ抜こうとした海河童！！\nあの時は本当に怖かったんですからね！？", "face": "u1722a1"}, {"name": "海河童", "text": "ケッ、知ったことか！\nこちとら畏れが食えずにひもじい思いしてんだよ！", "face": "l15ef4255c9c0"}, {"name": "海河童", "text": "蜃のアニキ！\nこいつらに死ぬほど怖い思いをさせて、\n畏れをがっぽり頂きましょうゼ！！", "face": "l15ef4255c9c0"}, {"name": "レーヴ", "text": "「シン」……？\nまさか、幻の宮殿を生み出すという、\n海の大妖怪「蜃」ですか！？", "face": "u454"}, {"name": "蜃", "text": "然り……。\nどぉれ、溺れる地の者らの実力、試させてもらおうか。", "face": "l63fcaad3241b"}, {"name": "レーヴ", "text": "王子、あれは幻を操る大妖怪です！\n何をしてくるか分かりません。\n慎重な指揮をお願いします！", "face": "u454"}]}, {"trigger": "battle", "at_sec": 140, "lines": [{"name": "蜃", "text": "こやつら、強い……！\nならば、この手はどうだ！！", "face": "l63fcaad3241b"}, {"name": "イヲナミ", "text": "えっ、えぇぇぇ！？\n蜃がいきなり増えましたー！！", "face": "u1722a1"}, {"name": "シノ", "text": "これが蜃気楼を操るという蜃の秘術ですか。\n……しかも、ただの幻ではないようです。", "face": "u403"}, {"name": "シノ", "text": "あれらの幻は確かに、本体より脆そうです。\nしかしその力は幻にあるまじき、\n術者本人に近いものを有しています。", "face": "u403"}]}, {"trigger": "end", "lines": [{"name": "蜃", "text": "……見事。", "face": "l63fcaad3241b"}, {"name": "イヲナミ", "text": "ふぅ……あのぉ、お話きいてくれますか？\nできれば戦いではなく、\n対話で解決できるといいなぁなんて。", "face": "u1722a1"}, {"name": "蜃", "text": "解決……？\nはて、ぬしらと何か解決すべきことがあったか？", "face": "l63fcaad3241b"}, {"name": "イヲナミ", "text": "乙姫さまのことです！\n乙姫さまは、あなたと結婚するつもりはないんです。", "face": "u1722a1"}, {"name": "蜃", "text": "…………。", "face": "l63fcaad3241b"}, {"name": "蜃", "text": "……認めぬ。\n認めぬぞぉ！！", "face": "l63fcaad3241b"}, {"name": "イヲナミ", "text": "えぇぇぇっ、分からずやです！\nこの妖怪話が通じません！", "face": "u1722a1"}, {"name": "蜃", "text": "龍宮城と我が楼閣の婚姻は必定！\nさもなくば、海の妖怪に未来はない！", "face": "l63fcaad3241b"}, {"name": "蜃", "text": "それしきのこと、オオワタツミとて理解しておろう！\nだというのに、だというのに……！！", "face": "l63fcaad3241b"}, {"name": "ウズメ", "text": "（…………おや？）", "face": "u125"}, {"name": "シナト", "text": "（んんぅ？）", "face": "u773"}, {"name": "シナト", "text": "なぁちょっと待ちなって。\nもしかして蜃とやら、\n乙姫サマが好き好きちゅっちゅなんじゃなくて――", "face": "u773"}, {"name": "ウズメ", "text": "何か別の目的があって婚姻を迫って――", "face": "u125"}, {"name": "蜃", "text": "問答無用、ぬしらを生きて帰しはせぬぞ！\n我が妖力の真なる姿を見せてやろう！！", "face": "l63fcaad3241b"}, {"name": "蜃", "text": "解けよ蜃気楼、いでよ真なる深海の祭殿よ！！", "face": "l63fcaad3241b"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 21, "params": [150]}, {"kind": "term", "influence": 19, "params": [150]}], "enemies": [{"enemy_id": 1, "hp": 10, "damage_type": "physical", "pattern_id": 2146096}, {"enemy_id": 1, "form_index": 1, "hp": 23000, "attack": 1800, "damage_type": "physical", "armor_defense": 2800, "magic_defense": 30, "pattern_id": 2146112}, {"enemy_id": 3, "hp": 1400, "attack": 