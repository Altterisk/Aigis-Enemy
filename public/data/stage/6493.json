"base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 12}, {"enemy_id": 5, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 45}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 161, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107264, "race_id": 2, "master_id": 878, "global_id": 877, "spawn_sec": 60}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "magical", "armor_defense": 150, "attack_range": 200, "attack_speed": 70, "attack_wait": 25, "attack_interval": 83, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100640, "race_id": 16, "special_effect_id": 225, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 274, "global_id": 273, "ranged": true, "spawn_sec": 82}, {"enemy_id": 8, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 350, "base_hp": 9000, "base_attack": 350, "damage_type": "magical", "armor_defense": 200, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 133, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100592, "race_id": 10, "special_effect_id": 232, "missile_id": 44, "missile": {"speed": 8.0}, "master_id": 270, "global_id": 269, "ranged": true, "spawn_sec": 145}], "dialogue": [{"trigger": "start", "lines": [{"name": "都市国家兵士", "text": "――いました。皆さん、あちらです。", "face": "l8105cd4a6407"}, {"name": "アンナ", "text": "……確かに巨人の群れが見えますね。\n壁の薄い箇所を突破してきたのでしょうか。", "face": "ld0c6fac768c7"}, {"name": "チズル", "text": "ふわぁ……ったく、無粋なヤツらだぜ。\n私らが王国に帰ろうって矢先に襲ってきやがって。", "face": "u159"}, {"name": "バシラ", "text": "――ッ！？\n王子、向こうに凄く大きい巨人みたいな魔物がいます！\nあれって、まさか……。", "face": "u28"}, {"name": "ギガース", "text": "――地を這う者どもよ、ひれ伏すがいい。\n我らが救い主、ヘカトンケイル様が遂に降臨された。", "face": "lfe26e9cdce65"}, {"name": "ギガース", "text": "此度は偉大なる神威（しんい）の一部をお示しになる。\n復活から間もない故、本来の力は発揮できぬだろうが\n貴様ら人間に恐怖と絶望を植え付けるには十分だろう。", "face": "lfe26e9cdce65"}, {"name": "ケイティ", "text": "――神獣の威力を披露しようと言うのですか。\n……本格的な侵攻に先立ち、\n小手調べに来たというわけですね。", "face": "u114"}, {"name": "バルバストラフ", "text": "ふむ……しかし妙じゃな。\n巨人どもが雪原で手に入れた卵にしては\n復活が早すぎはせんかのう？", "face": "u63"}, {"name": "アンナ", "text": "詳しいことはわかりませんが、\nこれ以上敵の侵入を許すわけにはいきません！\n王子、巨人たちとヘカトンケイルを撃退しましょう！", "face": "ld0c6fac768c7"}]}, {"trigger": "end", "lines": [{"name": "ギガース", "text": "……うむ、そろそろ引き上げるとしよう。\nヘカトンケイル様の御力の一端を知ることができた、\nそれだけでも十分な収穫だ。", "face": "lfe26e9cdce65"}, {"name": "ギガース", "text": "人間どもよ、僅かな余生を大事にするがいい。\n再び我らが此処を訪れたその日が、貴様らの命日だ。", "face": "lfe26e9cdce65"}, {"name": "都市国家兵士", "text": "――巨人たち、\nヘカトンケイルを伴って撤退していきます！", "face": "l8105cd4a6407"}, {"name": "アンナ", "text": "……ふぅ。なんとか撃退できましたね。", "face": "ld0c6fac768c7"}, {"name": "ケイティ", "text": "ですが、先ほどのギガースの口ぶりからすると\n近日中に大規模な襲撃が行われる恐れがあります。\n引き続き油断はできませんね……。", "face": "u114"}, {"name": "サイラス", "text": "そのようだ。そして巨人どもがヘカトンケイルの\n卵を複数手に入れているという予想も、\n確定的なものとなったようだな。", "face": "u13"}, {"name": "バルバストラフ", "text": "ふむ、さっきのは雪原で見つかったものとは\n別の卵から復活した個体だったというわけか。", "face": "u63"}, {"name": "バルバストラフ", "text": "しかし、そう考えると巨人どもは\n複数体のヘカトンケイルの復活とともに\n都市国家に侵攻してくる可能性もあるのう。", "face": "u63"}, {"name": "バシラ", "text": "え、さっきのが一度に何体も攻めてくるんですか？\nそれってかなり深刻な事態なのでは……？", "face": "u28"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "とにかく、いまはできることをするしかありません。\n都市国家の人たちと協力し、来たる決戦の日に向けて\n可能な限り防衛の準備を整えてまいりましょう。", "face": "ld0c6fac768c7"}]}], "map": {"image": "Map920110_5354", "w": 960, "h": 640, "spots": [{"k": "b", "x": 934, "y": 269}, {"k": "m", "x": 594, "y": 305, "id": 200}, {"k": "m", "x": 728, "y": 304, "id": 201}, {"k": "m", "x": 835, "y": 307, "id": 202}, {"k": "m", "x": 591, "y": 135, "id": 203}, {"k": "m", "x": 225, "y": 126, "id": 204}, {"k": "m", "x": 598, "y": 465, "id": 205}, {"k": "m", "x": 594, "y": 379, "id": 206}, {"k": "m", "x": 589, "y": 217, "id": 207}, {"k": "m", "x": 404, "y": 129, "id": 208}, {"k": "m", "x": 497, "y": 129, "id": 209}, {"k": "m", "x": 311, "y": 128, "id": 210}, {"k": "m", "x": 421, "y": 466, "id": 211}, {"k": "m", "x": 329, "y": 469, "id": 212}, {"k": "m", "x": 504, "y": 465, "id": 213}, {"k": "m", "x": 726, "y": 230, "id": 214}, {"k": "m", "x": 827, "y": 230, "id": 215}, {"k": "m", "x": 230, "y": 337, "id": 216}, {"k": "r", "x": 352, "y": 200, "id": 300}, {"k": "r", "x": 420, "y": 198, "id": 301}, {"k": "r", "x": 501, "y": 380, "id": 302}, {"k": "r", "x": 411, "y": 387, "id": 303}, {"k": "r", "x": 772, "y": 174, "id": 304}, {"k": "r", "x": 686, "y": 173, "id": 305}, {"k": "r", "x": 775, "y": 357, "id": 306}, {"k": "r", "x": 687, "y": 357, "id": 307}, {"k": "r", "x": 691, "y": 423, "id": 308}, {"k": "r", "x": 490, "y": 196, "id": 309}, {"k": "r", "x": 58, "y": 159, "id": 310}, {"k": "r", "x": 60, "y": 438, "id": 311}]}, "start_cost": 10, "active": true}