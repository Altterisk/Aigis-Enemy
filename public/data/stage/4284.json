esist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 48}, {"enemy_id": 4, "source": "local", "count": 14, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 88}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 42, "global_id": 41, "ranged": true, "spawn_sec": 116}], "dialogue": [{"trigger": "start", "lines": [{"name": "サンドラ", "text": "私は一旦、修行に戻るわ。\n今の私じゃ王子の足手まといになってしまう。", "face": "u248"}, {"name": "サンドラ", "text": "……けれど、奥義を会得したら、\n必ず共に戦うと誓うわ。", "face": "u248"}, {"name": "アンナ", "text": "分かりました。お待ちしております。"}, {"name": "兵士", "text": "報告！　空飛ぶ魔物たちの群れがこちらに接近！\n次はこの妖精郷の住人たちをターゲットにして\nいるものと思われます！", "face": "l60303f9a5488"}, {"name": "ソーマ", "text": "王子、空飛ぶ魔物なら私たちアーチャーといった\n遠距離攻撃が得意な味方に任せてください。\nでは、行きましょう！", "face": "u23"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "妖精郷も守ることができて良かったです。\nしかし、あの規模で斥候とは……。", "face": "l56bb55a8b0e9"}, {"name": "アンナ", "text": "空を黒く染めるほどの飛行する敵の本隊……。\nそれに対抗する準備を\n私たちも進めないといけませんね。", "face": "l56bb55a8b0e9"}]}], "active": true}