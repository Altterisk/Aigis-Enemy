{"quest_id": 6378, "name": "進軍の迅雷", "description": "重水の四天王の首を狙わんとする、\n迅雷の四天王の進軍を止めよ！\n\n上級（★１獲得の目安：平均Lv10）", "event": "青鬼娘と鬼一門", "event_category": "History", "mission_id": 920103, "map_no": 5290, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 350, "base_hp": 15000, "base_attack": 350, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106976, "race_id": 4, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30901, "global_id": 4520, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 11, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 50}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 2, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 56}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 64}, {"enemy_id": 6, "source": "local", "count": 9, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 74}], "dialogue": [{"trigger": "start", "lines": [{"name": "迅雷の四天王", "text": "者ども、続けぇッ！\n水の野郎の首が落ちるまでは、止まることは許さんッ！", "face": "lfaf630b5a5ce"}, {"name": "リンドウ", "text": "うげっ！？\nあかん、もう進軍が始まっとる！", "face": "u587"}, {"name": "鬼刃姫", "text": "待ちなさい、迅雷の四天王！", "face": "u435"}, {"name": "迅雷の四天王", "text": "――むっ、その声は……茨木童子様！？\n何をなさっているのです？　人間どもと連れ立って。", "face": "lfaf630b5a5ce"}, {"name": "鬼刃姫", "text": "それはこっちの台詞よ。\n一体どこへ行くつもりなの？", "face": "u435"}, {"name": "迅雷の四天王", "text": "……隠しても仕方ありますまい。\n水の奴めを討ち取りに行くのです。", "face": "lfaf630b5a5ce"}, {"name": "リンドウ", "text": "重水の四天王を！？\nあ……あかん！　んなことしたら戦争になるで！\nなぁおっちゃん、考え直そうや？　な？", "face": "u587"}, {"name": "迅雷の四天王", "text": "誰がおっちゃんだッ！\nそれに、わしはもう後には退けんのだ！", "face": "lfaf630b5a5ce"}, {"name": "迅雷の四天王", "text": "此度の抗争において出遅れた我ら一派を\n先に攻めてきたのは、あの水の野郎の一派だ……。", "face": "lfaf630b5a5ce"}, {"name": "迅雷の四天王", "text": "すでに多くの同胞（はらから）たちが\n水の手先どもに襲われ深手を負った！\n仲間を守るためには、奴の首を落とすしかないのだ！", "face": "lfaf630b5a5ce"}, {"name": "リンドウ", "text": "くっ、だったら……ッ！\nアンナはん、あれを――！", "face": "u587"}, {"name": "アンナ", "text": "は、はい！　ええと……。\nこ、この節分豆が目に入らぬかー！", "face": "l24e6142bb3bb"}, {"name": "迅雷の四天王", "text": "ぐぬぅッ！？　せ、節分豆だと……ッ！\nわしの力をそれで抑えようというのか！？", "face": "lfaf630b5a5ce"}, {"name": "迅雷の四天王", "text": "くっ……ええい、たかが豆ごとき恐るるに足らんわ！\n者ども、奴らを蹴散らすのだッ！", "face": "lfaf630b5a5ce"}]}, {"trigger": "end", "lines": [{"name": "迅雷の四天王", "text": "グゥッ……思うように力が入らぬ……ッ！", "face": "lfaf630b5a5ce"}, {"name": "迅雷の四天王", "text": "節分豆……たかが豆ごときと侮っていたが、\nその鬼封じの力、本物であったか……ッ！", "face": "lfaf630b5a5ce"}, {"name": "リンドウ", "text": "だから言うたやんか！\nこれ以上鬼同士で喧嘩しようとするなら、\n次はもっと痛いのをお見舞いしたるでぇ！", "face": "u587"}, {"name": "迅雷の四天王", "text": "くそっ……重水の手先どもに\n我が配下の兵力を削られていなければ……ッ！", "face": "lfaf630b5a5ce"}, {"name": "迅雷の四天王", "text": "……者ども、一時撤退だ。\n根城に戻って態勢を立て直すぞ。", "face": "lfaf630b5a5ce"}, {"name": "アンナ", "text": "……ふぅ。\nひとまず進軍を思い留まってもらえたようですね。", "face": "l24e6142bb3bb"}, {"name": "リンドウ", "text": "でも……噂には聞いとったけど\n重水の四天王の手先が迅雷の四天王の部下を\n先に襲ったっちゅー話はホンマやったんやな。", "face": "u587"}, {"name": "アンナ", "text": "なにか理由があったのでしょうか？", "face": "l24e6142bb3bb"}, {"name": "鬼刃姫", "text": "うん、きっとそうだと思う。\n重水の四天王は軽率に争いを\n起こすような奴じゃないから。", "face": "u435"}, {"name": "リンドウ", "text": "よし、ほんなら次は重水の四天王の根城に向かおか！\nヤツの狙いを聞き出したる！", "face": "u587"}]}], "active": true}