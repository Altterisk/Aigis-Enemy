{"quest_id": 6417, "name": "太公望の秘策", "description": "神仙郷に張り巡らされし邪仙の策。\n秘策があるとの太公望の言葉を信じ、\n迫る敵の猛攻を凌ぎ勝利を掴め！\n神級（★１獲得の目安：平均Lv50）", "event": "神算の太公望", "event_category": "History", "mission_id": 920105, "map_no": 5314, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "hp": 2500, "attack": 350, "base_hp": 2500, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112624, "master_id": 30704, "global_id": 4323, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112640, "master_id": 30705, "global_id": 4324, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112816, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30725, "global_id": 4344, "ranged": true, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 17, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112832, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30726, "global_id": 4345, "ranged": true, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 48000, "attack": 550, "base_hp": 48000, "base_attack": 550, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "attack_interval": 22, "move_speed": 4500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114256, "special_effect_id": 277, "master_id": 30954, "global_id": 4573, "spawn_sec": 50}, {"enemy_id": 6, "source": "local", "count": 9, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106672, "master_id": 842, "global_id": 841, "spawn_sec": 54}, {"enemy_id": 7, "source": "local", "count": 13, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106688, "master_id": 849, "global_id": 848, "spawn_sec": 63}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108080, "master_id": 991, "global_id": 990, "spawn_sec": 71}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 300, "base_hp": 12000, "base_attack": 300, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_wait": 20, "attack_interval": 91, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109360, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30182, "global_id": 3801, "ranged": true, "spawn_sec": 88}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 231, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106768, "master_id": 856, "global_id": 855, "spawn_sec": 147}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112848, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30727, "global_id": 4346, "ranged": true, "spawn_sec": 170}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108096, "master_id": 992, "global_id": 991, "spawn_sec": 172}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108112, "master_id": 993, "global_id": 992, "spawn_sec": 175}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "迅天君……率いていた部隊の戦力の大半を失って\n敗走したものと思っていましたが……。", "face": "l9cb6e8886bd9"}, {"name": "迅天君", "text": "フッ、戦術的撤退と言ったろ？\n勝利に気を良くしたキミらをおびき寄せて、\nここで包囲する作戦だったのさ。", "face": "l80b2a8cce4eb"}, {"name": "仙人", "text": "…………。", "face": "u603"}, {"name": "迅天君", "text": "ハハッ！　\nかの高名な太公望ともあろう御方が、\n万策尽きたって様子じゃあないか？", "face": "l80b2a8cce4eb"}, {"name": "マオ", "text": "太公望……？\nまさか――貴方があの神仙郷随一の策士と名高い\n太公望先生だったのですか！？", "face": "u361"}, {"name": "太公望", "text": "…………。", "face": "u603"}, {"name": "迅天君", "text": "いや～、こっちの戦力が手薄になる時期を見計らって\n生き残りの仙人たちが神仙郷を奪い返しに来ることは\n予想していたんだけどねぇ。", "face": "l80b2a8cce4eb"}, {"name": "迅天君", "text": "だからこそ、東の国への遠征に集中させていた\n戦力の一部を引き上げて罠を張っていたわけだが――", "face": "l80b2a8cce4eb"}, {"name": "迅天君", "text": "まさか行方知れずだった太公望が\nオレたちの宿敵である王子たちを連れて\n罠にかかってくれるとは思わなかったよ。", "face": "l80b2a8cce4eb"}, {"name": "アンナ", "text": "（罠にかかった？　彼女が？\nでは、今までの不審な言動は一体……）", "face": "l9cb6e8886bd9"}, {"name": "フェイ", "text": "ま、まずいよ王子！\n敵がどんどん包囲網を狭めてきてるよぅっ！", "face": "u434"}, {"name": "迅天君", "text": "悪いことは言わない、早く降伏したまえ。\nキミらも苦しんで死ぬのは嫌だろう？", "face": "l80b2a8cce4eb"}, {"name": "太公望", "text": "――いえ、なりません！\n王子、平にお願い申し上げます！\nここは前方にいる敵部隊の殲滅に集中してください！", "face": "u603"}, {"name": "迅天君", "text": "ハハハッ！　血迷ったのかい太公望？\nそんなことをすれば、後方に控える我が軍の部隊が\nすかさず距離を詰めて背後からキミらを攻撃するだけさ。", "face": "l80b2a8cce4eb"}, {"name": "太公望", "text": "……大丈夫です、私に秘策がございます！\nどうか……どうか信じてください！　お願いします！", "face": "u603"}, {"name": "アンナ", "text": "……王子、ここは太公望さんを信じて戦いましょう！\n理由は私にもよくわかりませんが、\n今の彼女は嘘を吐いていないように思います。", "face": "l9cb6e8886bd9"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "迅天君", "text": "ほう、あくまで戦うってかい？\nいいね……その心意気、気に入った！\nならば！　今度こそオレも全力を以って礼を尽くそう！", "face": "l80b2a8cce4eb"}]}, {"trigger": "end", "lines": [{"name": "迅天君", "text": "な……なぜだッ！？\nなぜ背後にいた兵が彼らを攻撃しない！？", "face": "l80b2a8cce4eb"}, {"name": "ファー", "text": "――へへーん、ざまぁみろってんだ！\n後方に雑魚ばっか配置するからこうなるんだよ。", "face": "u327"}, {"name": "アンナ", "text": "貴方は――ファーさん！？　\nそれにナタクさんまで！\nなぜ、こちらに？", "face": "l9cb6e8886bd9"}, {"name": "ナタク", "text": "古い友人からの要請を受けてね。\nキミたちを背後から叩こうとしていた\n敵の部隊を足止めしに来たのさ。", "face": "u297"}, {"name": "迅天君", "text": "ということは……まさか！\n太公望、キミはこちらの作戦を読んだ上で\nあらかじめ援軍を呼んでいたというのか？", "face": "l80b2a8cce4eb"}, {"name": "太公望", "text": "……作戦内容だけでなく、戦力状況の把握も重要でした。", "face": "u603"}, {"name": "太公望", "text": "従来通りの防衛戦力であれば、\n貴方がたの包囲作戦は上手くいったでしょう。", "face": "u603"}, {"name": "太公望", "text": "しかし、今回は東の国侵攻に戦力が割かれていた上、\n包囲作戦を実行するために戦力が分散化し、\n結果として本隊の戦力が手薄になったのです。", "face": "u603"}, {"name": "迅天君", "text": "ぬぅ……そこまで読んだうえで\nこちらの作戦の裏をかいてくるとは……。", "face": "l80b2a8cce4eb"}, {"name": "迅天君", "text": "せめて策を授けたヤツがここにいれば……。\nいや、いまさら嘆いても仕方あるまい。\n――総員撤退ッ！　これ以上無駄な命は散らすなッ！", "face": "l80b2a8cce4eb"}, {"name": "ケイティ", "text": "……敵軍の撤退を確認。\n太公望さん、お見事な策略でした。", "face": "u114"}, {"name": "アンナ", "text": "ええ……疑ってすみませんでした。\n貴方が行軍中に度々姿を消していたのは、\nナタクさんたちを呼びに行っていたからなのですね。", "face": "lf08f2c87c7db"}, {"name": "太公望", "text": "いえ、こちらこそ正体を隠していて申し訳ありません。\n確実に敵の裏をかくには「敵を欺くには味方から」を\n実践する必要がありましたので……。", "face": "u603"}, {"name": "太公望", "text": "それはさておき、王子。\n此度のご協力、誠にありがとうございました。\nおかげさまで無事に神仙郷を奪還することができました。", "face": "u603"}, {"name": "太公望", "text": "私は今後、神仙郷の復興を進めると共に、\n現在行方不明となっている神仙郷の長、\n元始天尊様の探索を行っていく所存です。", "face": "u603"}, {"name": "太公望", "text": "その過程で再び道が交わることもあるでしょう。\nその時になりましたら、またお会いしましょう。", "face": "u603"}]}], "active": true}