{"quest_id": 7456, "name": "聖霊ラタトスク", "description": "助けを求める声を聞き、現場へ駆けつける\n王子たち。そこにはラタトスクへ襲い\n掛かろうとする茨の女王の姿が……！？\n極級（★１獲得の目安：平均Lv25）", "event": "世界の架け橋を求めて", "event_category": "History", "mission_id": 920167, "map_no": 5945, "level": 80, "multiplier": 0.8, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 24, "form_count": 1, "hp": 2000, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 7, "form_count": 1, "hp": 2000, "attack": 240, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 23}, {"enemy_id": 3, "source": "local", "count": 15, "form_count": 1, "tags": ["植物"], "hp": 3200, "attack": 192, "base_hp": 4000, "base_attack": 240, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115520, "special_effect_id": 308, "master_id": 31219, "global_id": 4838, "spawn_sec": 61}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 2400, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_range": 180, "attack_speed": 55, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114192, "race_id": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30948, "global_id": 4567, "ranged": true, "spawn_sec": 79}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 96000, "attack": 1200, "base_hp": 120000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_range": 300, "attack_speed": 1, "attack_wait": 80, "attack_interval": 235, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2120672, "special_effect_id": 108, "missile_id": 410, "missile": {"speed": 8.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 32080, "global_id": 5699, "ranged": true, "spawn_sec": 140}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["植物", "置物"], "fixture": true, "hp": 96000, "attack": 880, "base_hp": 120000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 80, "attack_interval": 236, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2131136, "special_effect_id": 242, "missile_id": 410, "missile": {"speed": 8.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 34128, "global_id": 7745, "spawn_sec": 210}, {"enemy_id": 7, "source": "local", "count": 10, "form_count": 1, "tags": ["植物", "置物"], "fixture": true, "hp": 3200, "attack": 192, "base_hp": 4000, "base_attack": 240, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131168, "special_effect_id": 242, "master_id": 34129, "global_id": 7746, "spawn_sec": 211}], "popups": ["茨の女王から攻撃を受けると、\n攻撃後の待ち時間が\n大幅に増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ラタトスク", "text": "吾輩の騎士たちを好き勝手ぶん殴りおってー！\nなんじゃぁ！？　やる気かぁ！？　このこのー！！", "face": "u1375a1"}, {"name": "茨の女王", "text": "くふふふ……。\nあわれ……何と哀れな……。\n世界樹の再誕に抗おうとはなぁ……。", "face": "l87311ad39bb3"}, {"name": "ラタトスク", "text": "何が再誕じゃ！　世界樹を蝕みおって！！\n吾輩がどれだけ苦労したと思っておるのじゃ！", "face": "u1375a1"}, {"name": "茨の女王", "text": "その苦労も今日まで……。\nくふ……これからは一緒に、\n世界樹と共に堕ちていこうぞ……。", "face": "l87311ad39bb3"}, {"name": "ラタトスク", "text": "ひっ……やめ……マリレーヌ！\nマリレーヌどこじゃぁ！？", "face": "u1375a1"}, {"name": "マリレーヌ", "text": "――ここにッ！\nご無事ですか、ラタトスク様！", "face": "u1354a1"}, {"name": "茨の女王", "text": "くふふ……面倒な騎士が来たものよ。\nまぁよい、有象無象共々、ここで枯らしてくれよう。", "face": "l87311ad39bb3"}, {"name": "マリレーヌ", "text": "茨の女王が相手、か……。\n王子殿、奴の茨に絡みつかれぬよう注意するのだ。\nこちらの動きを制限されてしまうぞ。", "face": "u1354a1"}, {"name": "マリレーヌ", "text": "ラタトスク様を失えば、世界樹に未来はない。\nどうか、貴殿らの力を貸してくれ！", "face": "u1354a1"}]}, {"trigger": "battle", "at_sec": 210, "lines": [{"name": "アナベラ", "text": "……やるじゃないか、騎士。", "face": "u1309a1"}, {"name": "マリレーヌ", "text": "ふふっ、お褒めに預かり光栄だ、学者殿。", "face": "u1354a1"}, {"name": "ラタトスク", "text": "やれやれ……まさか吾輩の隠れ家まで見つけられるとは、\nそろそろ世界樹も限界なのかのう……。", "face": "u1375a1"}, {"name": "ラタトスク", "text": "ところでうぬらは――あぁ、見覚えがあるぞ？\n世界樹が燃えた時、助けてくれた者らじゃな？", "face": "u1375a1"}, {"name": "クゥイル", "text": "あ、あの……あなたはいったい……？", "face": "u702"}, {"name": "シュシュ", "text": "わぁっ、可愛いリスさん尻尾ですよー！", "face": "u656"}, {"name": "マリレーヌ", "text": "こ、こらっ！　不敬だぞ！！\nラタトスク様に触れるんじゃない！", "face": "u1354a1"}, {"name": "ラタトスク", "text": "よいよい、吾輩も長年姿を見せておらなんだ。\n今の者らは、可愛い吾輩を知らずとも無理はなかろう。", "face": "u1375a1"}, {"name": "クゥイル", "text": "では……あなたが聖霊ラタトスク様、なのですか？", "face": "u702"}, {"name": "ラタトスク", "text": "うむ、いかにも。\n吾輩こそ、世界樹の守護者、ラタトスクぞ。", "face": "u1375a1"}, {"name": "茨の女王", "text": "（……おのれ、ラタトスクの騎士、王国軍、王子ィ……！）", "face": "l87311ad39bb3"}, {"name": "茨の女王", "text": "（世界樹に打ち込まれし神の楔よ……。\nさらなる力を……全てを蝕む毒を我が身に……！！）", "face": "l87311ad39bb3"}, {"name": "ラタトスク", "text": "……むっ、何じゃこの気配は。\n大気がにごって――はっ、気をつけよ！\n茨の女王がまだ動いておるぞ！！", "face": "u1375a1"}]}, {"trigger": "end", "lines": [{"name": "毒茨の女王", "text": "くふ……くふふ……っ！\n毒が……毒が満ちていくぞ……。", "face": "l1d85a0bcc089"}, {"name": "毒茨の女王", "text": "さぁラタトスク、その身を我が肥料としてやろう！", "face": "l1d85a0bcc089"}]}], "active": true}