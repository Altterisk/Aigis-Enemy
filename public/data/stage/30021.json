36096, "global_id": 9713, "to_global_id": 9714}, {"enemy_id": 34, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 8600, "attack": 450, "base_hp": 8600, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 36, "master_id": 36097, "global_id": 9714, "to_global_id": 9715}, {"enemy_id": 34, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 8600, "attack": 1000, "base_hp": 8600, "base_attack": 1000, "damage_type": "physical", "armor_defense": 120, "attack_range": 200, "attack_speed": 1, "attack_wait": 51, "attack_interval": 139, "move_speed": 3000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2143760, "race_id": 4, "special_effect_id": 1303, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 36098, "global_id": 9715, "ranged": true}], "popups": ["ディエーラがいる間は、\nマーセナリーの\n攻撃力と防御力がアップします。", "エターナーがいる間は、\n全ての敵のHPが\n徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "金糸雀姉妹の父", "text": "いい加減聞き分けんか！\nどこの誰とも分からんやつのところへ、\n嫁になど行かせられん！", "face": "l5e77f0cb0193"}, {"name": "ココヒメ", "text": "だーーかーーらーーっ！\nまだ嫁入りするわけじゃないって言ってるじゃん！\n聞き分けがないのは一体どっちなの！？", "face": "u1790a1"}, {"name": "ハヤセ", "text": "ただ隣に並んで歩くだけ。\nそれに、王子サマはアタシたちがよく知っている人だ。\n悪く言うんなら、いくらアンタでも容赦しないからな。", "face": "l4d0d77cc9903"}, {"name": "レナータ", "text": "うわぁ、やっぱりヒートアップしてる。\n皆さん落ち着いてくださーい！", "face": "u1797a1"}, {"name": "ロカ", "text": "あれ、戻ってきた～。でもタイミング悪いかも。", "face": "u1798a1"}, {"name": "アンナ", "text": "いえ、式場に被害が出る前に到着できて良かったです。\nこれ以上の混乱は祝祭の進行に影響が出かねませんので。"}, {"name": "ココヒメ", "text": "もーーーーーっ！　お父さんの分からず屋！\nあんぽんたん！　大バカ妖怪！！", "face": "u1790a1"}, {"name": "金糸雀姉妹の父", "text": "なっ！？　ココヒメ、なんだその口の利き方は！\nそんな娘に育てた覚えはないぞ！", "face": "l5e77f0cb0193"}, {"name": "レナータ", "text": "うわぁ、その台詞言う親って実在したんだ。\nめもめも～♪", "face": "u1797a1"}, {"name": "アンナ", "text": "かなり激昂していますね。\n娘思いの方ではあるようですが……。", "face": "l240c3401326d"}, {"name": "キシマ", "text": "あっ……王子様にアンナさん、レナータさんも。", "face": "ld1c3dba5728a"}, {"name": "金糸雀姉妹の父", "text": "王子？　そうか、お前が……。少し待っていろ、\nこっちを片付けた後でじっくり相手をしてやる。", "face": "l5e77f0cb0193"}, {"name": "ココヒメ", "text": "王子さまは手出ししないでね！\nこれはココヒメちゃんたちの問題なんだから！", "face": "u1790a1"}, {"name": "ロカ", "text": "え～……助けて貰ったほうがいいと思うんだけど～。", "face": "u1798a1"}, {"name": "キシマ", "text": "ごめんなさい。こうなったら、\nお父さんもお姉ちゃんたちも止まらないんです。\nそれに私も、王子様を馬鹿にされるのは……許せません。", "face": "ld1c3dba5728a"}, {"name": "アンナ", "text": "やはり話し合いでは解決出来そうにありませんね。\nこのまま暴れられては、式場が壊滅してしまいます。", "face": "lbd7ff2ae0b3a"}, {"name": "レナータ", "text": "お披露目会の前に怪我しちゃったら大変ですし、\n多少力尽くでも止めたほうが良さそうですね。", "face": "u1797a1"}, {"name": "ハヤセ", "text": "なんだ、アタシたちとやり合おうってのか、王子サマ。\n言っとくけど手加減出来ないからな。\nそれでも良いなら――かかってこい！！", "face": "l4d0d77cc9903"}]}, {"trigger": "end", "lines": [{"name": "金糸雀姉妹の父", "text": "うおおぉっ……ぐぅっ……。\nそ、そうか、これが王子の力……か。\nどうやら……侮っていたようだな。", "face": "l5e77f0cb0193"}, {"name": "ハヤセ", "text": "……！？　って事は……。", "face": "l4d0d77cc9903"}, {"name": "金糸雀姉妹の父", "text": "ふん……実力を以てオレたちの争いを止め、\n目を覚まさせたんだ。認める他ないだろうがよ。", "face": "l5e77f0cb0193"}, {"name": "ハヤセ", "text": "そっか……そうだよな。\n……その、王子サマ、ありがとうな。\nさっきは突っかかって悪かったよ。", "face": "l4d0d77cc9903"}, {"name": "ココヒメ", "text": "うん。結局暴れちゃってごめんなさい。\n王子さまはココヒメちゃんたちを\n止めようとしてくれてたのに。", "face": "u1790a1"}, {"name": "キシマ", "text": "私も、自分を失ってました。\n迷惑かけちゃって、すみません……。", "face": "ld1c3dba5728a"}, {"name": "アンナ", "text": "皆さん落ち着いてくださったようです。\n冷静に話せるのなら、もう大丈夫ですよね、王子。"}, {"name": "王子", "text": "（……にっこり）", "face": "u1"}, {"name": "金糸雀姉妹の父", "text": "……今日のところは引いてやろう。\nだが……もし娘たちを泣かせてみろ。\n夜の闇全てがお前の敵になるからな。", "face": "l5e77f0cb0193"}, {"name": "ロカ", "text": "思ったよりあっさり帰っていったね～。\nちょっと思い込みが激しそうだけど、\n実は物分りが良いかまいたちさんなのでは～？", "face": "u1798a1"}, {"name": "レナータ", "text": "親馬鹿ツンデレお父さん……。\n次の作品にぜひ出したい属性ですね……めもめもっと。\nうん、創作意欲が湧いてきた♪", "face": "u1797a1"}, {"name": "ココヒメ", "text": "ええっ？　あなたもさっきまで戦ってたのに、\n切り替え早いなー。", "face": "u1790a1"}, {"name": "アンナ", "text": "王子、何はともあれ\n騒動を沈静化することが出来ましたね。\n式場の片付けが済んだら、ショーを開始しましょう。"}, {"name": "ハヤセ", "text": "心の準備は良いよな。\nしっかりエスコートしてくれよ？　王子サマ。", "face": "l4d0d77cc9903"}, {"name": "キシマ", "text": "王子様の隣をウエディングドレスで歩くの\n……実は夢だったんです。", "face": "ld1c3dba5728a"}, {"name": "ココヒメ", "text": "ちょっとちょっと、二人とも抜け駆けはずるいって！\n王子さまのお嫁さんになるのは、\n三人一緒に、でしょーーー！？", "face": "u1790a1"}]}], "active": true}