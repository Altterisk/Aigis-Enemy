 30073, "global_id": 3692, "to_global_id": 3693}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105056, "race_id": 16, "change_to": 8, "master_id": 30074, "global_id": 3693, "to_global_id": 3694}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 100, "attack_interval": 236, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108768, "race_id": 16, "special_effect_id": 248, "change_to": 5, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30075, "global_id": 3694, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110352, "race_id": 16, "special_effect_id": 207, "master_id": 30718, "global_id": 4337, "spawn_sec": 10}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 400, "base_hp": 12000, "base_attack": 400, "damage_type": "magical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105072, "race_id": 16, "master_id": 30802, "global_id": 4421, "spawn_sec": 11}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "magical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 90, "attack_wait": 40, "attack_interval": 213, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101664, "race_id": 16, "master_id": 30097, "global_id": 3716, "spawn_sec": 12}], "popups": ["セーラがいる間は\n敵のプリンセスは\n防御力がアップします。", "メルヴィナは倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "テミス", "text": "セーラさん。\nこんなところに私たちを呼び出して\n一体なんのおつもりですの？", "face": "u38"}, {"name": "シェリー", "text": "そうですよ。こんな寒い中、外に来いだなんて。\nそれにどうして私たちプリンセスだけなんですか？", "face": "u1027"}, {"name": "セーラ", "text": "お集まりいただき、誠にありがとうございます。\n寒い中こうしてプリンセスの皆様に\nお集まりいただいたのには、勿論理由がございます。", "face": "u1346"}, {"name": "セーラ", "text": "時に皆様。新年も二日目を迎えましたが、\n年末年始の宴で供された料理は\nお口に合いましたでしょうか？", "face": "u1346"}, {"name": "シルヴィア", "text": "えぇ、美味しくてつい食べすぎてしまいましたわ♪\n私は吸血鬼ですので、太ったりはしませんけれど。", "face": "u1442"}, {"name": "メルヴィナ", "text": "……っ！？", "face": "u1326"}, {"name": "セーラ", "text": "そう……この時期はつい食べすぎてしまいがち。\nですが、プリンセスの皆様におかれましては、\n食べすぎて太るなんて、言語道断です。", "face": "u1346"}, {"name": "セーラ", "text": "プリンセスたるもの、常に美しくあらねばなりません。\nですから皆様には、体型維持のために\nこれから適度な運動をしていただきます。", "face": "u1346"}, {"name": "リリア", "text": "お、王子に太ったと思われるのはイヤです！\nセーラさん、一体どんな運動をすればいいんですか？", "face": "u1020"}, {"name": "セーラ", "text": "良いご質問です。\n皆様には、この辺りを走りながら\n私が手配したお相手と手合わせをしていただきます。", "face": "u1346"}, {"name": "アーニャ", "text": "わぁ、なんだか楽しそうですね！\nでも、肝心のお相手はどこにいるんですか？", "face": "u1099"}, {"name": "アンナ", "text": "……あの、プリンセスの皆様が\n手合わせをご所望と伺って来たのですが……。"}, {"name": "メルヴィナ", "text": "ふ――ふははは！！　よく来たな！　\n全員この魔剣の糧としてやる！", "face": "u1326"}, {"name": "シビラ", "text": "自分から魔剣を手にするなんて……。\nすごいやる気じゃない、メルヴィナ。\nでも……私も負けてはいられないわ！", "face": "u1039"}, {"name": "アンナ", "text": "な、なんだか皆さん殺気立っていますね……。\n王子、怪我をしないように気をつけてください。", "face": "l0b8ddb96cf47"}]}, {"trigger": "end", "lines": [{"name": "シェリー", "text": "ふぅ……いい運動になりました。\n皆さん、お付き合い頂いてありがとうございます♪", "face": "u1027"}, {"name": "アンナ", "text": "ですが、なぜ急に手合わせをご所望になったのですか？\nまだ新年を迎えたばかりですのに。"}, {"name": "リリア", "text": "うっ……それは……。", "face": "u1020"}, {"name": "オリヴィエ", "text": "セーラさんに運動を勧められたのです。\n私は太りにくい体質なので、\n本当はあまり必要ではありませ――", "face": "u1115"}, {"name": "テミス", "text": "――そこまで！\nそれ以上は戦争が起きますわよ？", "face": "u38"}, {"name": "アンナ", "text": "……？"}, {"name": "ソーマ", "text": "お疲れさまです、皆さん。\nモーティマさんたちが作ってくれた\nお餅をお持ちしましたよ。", "face": "u439"}, {"name": "アーニャ", "text": "うわぁ、なんですかこれ？　すっごく美味しそうです！\nセーラさん、これ食べてもいいですか？", "face": "u1099"}, {"name": "セーラ", "text": "ふふ、いいですよ。\n先ほど十分に運動しましたからね。", "face": "u1346"}, {"name": "アンナ", "text": "（なるほど……そういう事情だったのですね）"}, {"name": "シルヴィア", "text": "はふはふ……んん～っ♪\nモチモチしていて、とっても美味しいですわ♪", "face": "u1442"}, {"name": "ソーマ", "text": "……あれ？　\n他の皆さんは召し上がらないのですか？\n皆さんの分のお餅も、ちゃんとありますよ？", "face": "u439"}, {"name": "メルヴィナ", "text": "……はっ！　目の前に美味しそうなものが。\nだが、食欲ごときに負けるわけには……。", "face": "u1326"}, {"name": "シビラ", "text": "大丈夫よ。また運動すればいいんだから。\nほら、メルヴィナの分も貰ってきたわ。", "face": "u1039"}, {"name": "メルヴィナ", "text": "…………それもそうだな。\nありがとう、シビラ。では、ひとつだけ頂くとしよう。", "face": "u1326"}]}], "story_talk": true, "active": true}