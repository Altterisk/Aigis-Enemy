{"quest_id": 4411, "name": "カボチャのパレード", "description": "楽しそうなカボチャたちの隊列に\nうっかり近づいてしまった\nカボチャの魔女を魔物から守れ！\n神級（★１獲得の目安：平均Lv50）", "event": "死竜と復讐の魔導司祭", "event_category": "History", "mission_id": 920053, "map_no": 3629, "level": 100, "multiplier": 1.0, "charisma": 115, "exp": 370, "gold": 1800, "drops": [{"item": 5003, "c": 4}, {"card": 8, "c": 1}, {"card": 133, "c": 1}, {"item": 2002, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 398, "global_id": 397, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 29, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 3, "level": 80, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 400, "global_id": 399, "ranged": true, "spawn_sec": 82}, {"enemy_id": 4, "source": "local", "count": 1, "fo