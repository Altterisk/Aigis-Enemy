{"quest_id": 6894, "name": "灼熱の溶岩洞", "description": "赤熱から冷める足場を駆使し、\n迫りくる魔物を迎え撃て！\n<HPに継続ダメージ>\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["HPに継続ダメージ"], "event": "終末の戦士たち", "event_category": "History", "mission_id": 920135, "map_no": 5536, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 5, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 13, "form_count": 2, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 1, "change_condition": 5, "master_id": 778, "global_id": 777, "to_condition": 5, "to_global_id": 778, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 779, "global_id": 778, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 14}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 4500, "attack": 150, "base_hp": 4500, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105584, "missile_id": 152, "missile": {"speed": 6.0, "splash": 133}, "master_id": 702, "global_id": 701, "ranged": true, "spawn_sec": 56}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 58}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 2800, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 79}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 300, "base_hp": 25000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_range": 130, "attack_speed": 120, "attack_wait": 60, "attack_interval": 221, "move_speed": 230.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100192, "missile_id": 28, "missile": {"speed": 6.0, "splash": 200}, "master_id": 703, "global_id": 702, "ranged": true, "spawn_sec": 98}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 8, "change_condition": 5, "master_id": 780, "global_id": 779, "to_condition": 5, "to_global_id": 780, "spawn_sec": 158}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 781, "global_id": 780, "ranged": true, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "リタ", "text": "暑すぎて、溶けて、しまいそう……です……。", "face": "u178"}, {"name": "ユージェン", "text": "むしろこれはもう、溶けるというより、\nそのまま蒸発してしまいそうだぞ……。", "face": "u906"}, {"name": "ソーマ", "text": "こんな溶岩の洞窟の中に、\n『破滅の力』が隠されているんですか……？", "face": "u23"}, {"name": "カタラ", "text": "えぇ……あちち……。\n人が入り込めない場所に隠してあると、\nあの谷でも話したわよね……。", "face": "u912"}, {"name": "フィリス", "text": "……つまり、この先も同じように、\n過酷な場所に行かないといけない、ということか？", "face": "u40"}, {"name": "カタラ", "text": "当然よ……。\nさぁ、早く『破滅の力』を手に入れて、\n次の場所へ向かいましょう……。", "face": "u912"}, {"name": "フーリ", "text": "そうですね……。\n暑いのは嫌いじゃないですけど、\nこの暑さはちょっと耐えきれないですから……。", "face": "u174"}, {"name": "ネーニャ", "text": "……あっ、あのほこらにあるの、\nもしかして『破滅の力』じゃない？", "face": "u135"}, {"name": "フィリス", "text": "おっ、でかしたネーニャ！\nさっそく回収して――", "face": "u40"}, {"name": "エレイン", "text": "――待ってフィリス！\nこの物音……洞窟の奥から魔物が迫ってるわ！", "face": "u36"}, {"name": "アンナ", "text": "どうやら、魔物を迎え撃つしかなさそうですね……。\n王子、この熱気の中では、\n皆さんの体力も徐々に削られてしまいます。", "face": "le97d7f6e3497"}, {"name": "アンナ", "text": "仲間の状況には\n常に気を配るようにした方が良さそうです。", "face": "le97d7f6e3497"}, {"name": "カタラ", "text": "それから、戦える場所も限られているわ。\nでも、溶岩で熱せられたあの足場も、\n時間が経てば使えるかもしれないわね……。", "face": "u912"}, {"name": "カタラ", "text": "こんな暑い場所に長くいたくはないわ。\n王子、ささっと片付けちゃいましょ！", "face": "u912"}]}, {"trigger": "end", "lines": [{"name": "カタラ", "text": "よし……この洞窟の『破滅の力』は\n無事に回収できたわ。", "face": "u912"}, {"name": "フローガ", "text": "なるほど……。\n複数の『破滅の力』が集まった結果、\n確かに大きな魔力の乱れが感じられます。", "face": "u878"}, {"name": "カタラ", "text": "あら、魔力の乱れが読めるのね？\nでもここにはあたしがいるから大丈夫よ。", "face": "u912"}, {"name": "カタラ", "text": "あたしの術と、先祖代々の血の力で、\n『破滅の力』を制御しているから、\nあんた達に大きな影響は出ないはずよ。", "face": "u912"}, {"name": "アンナ", "text": "頼りにしていますね、カタラさん。\n……それにしても、今回の洞窟は、\n何者かに辺り一帯を荒らされている感じでしたが。"}, {"name": "カタラ", "text": "恐らくは、あんた達のいう魔王軍の仕業ね。\nここ最近になって、一族の知り合いから\n似たような報告をたくさん受けてて困っているのよ。", "face": "u912"}, {"name": "フローガ", "text": "んー、もし魔王軍が\n封印された地を把握しているなら、\n先を越されてしまう可能性も十分にあり得ますね……。", "face": "u878"}, {"name": "アンナ", "text": "そうではないことを祈りますが……。\nとはいえ、考えても仕方ありませんね。\n王子、先を急ぎましょう。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "story_talk": true, "active": true}