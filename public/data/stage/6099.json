11, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 59}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 10, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 13, "source": "local", "count": 32, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 78}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 75, "global_id": 74, "spawn_sec": 102}, {"enemy_id": 15, "source": "local", "count": 3, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 111}, {"enemy_id": 16, "source": "local", "count": 3, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 120}], "dialogue": [{"trigger": "start", "lines": [{"name": "闇組織の運び屋", "text": "ほらよ、これが例のグリモワールの書片だ。\n危ない橋を渡ってんだ、さっさと確認してくれ。", "face": "l777ca7dd8962"}, {"name": "ゴブリン博士", "text": "ふム、間違いないようだナ。\n……約束の金ダ、持っていくが良イ。", "face": "l17d017269691"}, {"name": "闇組織の運び屋", "text": "毎度あり。それじゃ俺はこれで失礼するぜ。", "face": "l777ca7dd8962"}, {"name": "ゴブリン博士", "text": "ふふふ。このグリモワールの書片ガあれバ、\n我らゴブリン軍の更なる戦力増強も見込めるハズ。\nきっと女王様もお喜びになられるゾ。", "face": "l17d017269691"}, {"name": "ドルチェ", "text": "――王子、ここがグリモワールが取引されている\n魔界のマーケットです。\n早く取り戻しましょう。", "face": "u359"}, {"name": "ケイティ", "text": "おや、ゴブリン博士の姿が見えますね……。\n手に持っているのは書片ではないですか？", "face": "u114"}, {"name": "アンナ", "text": "間違いないですね。\n魔界マーケットで手に入れたのでしょう。\nしかし、こちらに渡してくれるでしょうか……。", "face": "l546252706e34"}, {"name": "ドルチェ", "text": "簡単な事よ。\n脅せばいいだけだわ。", "face": "u359"}, {"name": "ドルチェ", "text": "そこのゴブリン。\nこの銃で撃たれたくなければ、その書片を渡しなさい。", "face": "u359"}, {"name": "ゴブリン博士", "text": "なな！？　王子ども……！\n何を言ってるンダ。この書片は渡さんゾ！\n予算の大半を使ってやっと購入したのダ！", "face": "l17d017269691"}, {"name": "ドルチェ", "text": "早く渡しなさい……！", "face": "u359"}, {"name": "ゴブリン博士", "text": "予算の大半を使って買ったグリモワールを渡しタラ、\nワタクシ、女王様に殺されるノダ！\nどの道殺さレルなら、渡すわけにはいかナイ！", "face": "l17d017269691"}, {"name": "ドルチェ", "text": "……。\nこうなったら強引に奪うまでだわ！", "face": "u359"}, {"name": "ゴブリン博士", "text": "な、なんだこの女！　強引すぎるゾ！\n離せ、離すノダ！\nあ、ああーーーーーーーー！", "face": "l17d017269691"}, {"name": "ゴブリン", "text": "グリモワール、トンデイッタ！\nグリモワール、トンデイッタ！", "face": "l42b082f01534"}, {"name": "ゴブリン博士", "text": "か、風で書片がッ……！　\nお前達！　急いで書片を追いかけるのダ！", "face": "l17d017269691"}, {"name": "ゴブリン", "text": "ギャギャーッ！\nショヘン、ボアガ食ベタ。　", "face": "l42b082f01534"}, {"name": "ゴブリン博士", "text": "ボ、ボアが食ベタだト！？\nば、馬鹿もンーーーーー！\n早く書片を吐かせロ！！　この際王子達も利用するノダ！", "face": "l17d017269691"}, {"name": "アンナ", "text": "王子、ゴブリンが向かってきます。\n戦闘のご準備をお願いします。", "face": "l546252706e34"}, {"name": "アンナ", "text": "魔界の瘴気の中では力が半減します。\n厳しい戦闘になるかと思いますが、\n王子、どうかくれぐれもお気をつけて。", "face": "l546252706e34"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "お、おのれェ。何度も我々の邪魔をしよっテ！\n覚えておれヨ、次こそハ必ず……\n……お前達、撤退ダ！！", "face": "l17d017269691"}, {"name": "ゴブリン", "text": "ギャギャーッ！", "face": "l42b082f01534"}, {"name": "ケイティ", "text": "ゴブリン博士達は撤退したようですね。", "face": "u114"}, {"name": "バシラ", "text": "書片すら食べようとしてしまうなんて。\n魔界ボアの食欲、恐るべしです。", "face": "u28"}, {"name": "ケイティ", "text": "悪魔を呼び出す書物……書片とは言え、\nあれを喰らって何の影響もないとは思えません。", "face": "u114"}, {"name": "バシラ", "text": "魔界ボアが食べちゃうと危険ですね。\n他にも書片が落ちていないか、\n私は捜索を続けてみます。", "face": "u28"}, {"name": "アンナ", "text": "はい、よろしくお願いします。\n私達は引き続き書片の情報を集めましょう。\n王子、お疲れ様です。"}]}], "active": true}