{"quest_id": 6379, "name": "待ち受ける重水", "description": "王子達を待ち受けし、\n重水の四天王の罠。\n迫り来る重水の一派を退けよ！\n極級（★１獲得の目安：平均Lv25）", "event": "青鬼娘と鬼一門", "event_category": "History", "mission_id": 920103, "map_no": 5291, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 400, "base_hp": 15000, "base_attack": 400, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107216, "race_id": 4, "special_effect_id": 101, "missile_id": 168, "missile": {"speed": 2.0}, "master_id": 458, "global_id": 457, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 14, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 25}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 2, "hp": 1000, "attack": 100, "base_hp": 1000, "base_attack": 100, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_speed": 180, "attack_wait": 60, "attack_interval": 361, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "change_to": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 965, "global_id": 964, "to_global_id": 960, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 34}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 100, "attack_speed": 180, "attack_wait": 60, "attack_interval": 181, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 961, "global_id": 960, "ranged": true}, {"enemy_id": 6, "source": "local", "count": 11, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 59}, {"enemy_id": 7, "source": "local", "count": 13, "form_count": 2, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 180, "attack_wait": 150, "attack_interval": 541, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108000, "race_id": 4, "change_to": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 966, "global_id": 965, "to_global_id": 961, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 88}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 100, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108000, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 962, "global_id": 961, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 156}], "dialogue": [{"trigger": "start", "lines": [{"name": "リンドウ", "text": "もうすぐや！\nもうすぐ重水の四天王の根城に着くで！", "face": "u587"}, {"name": "鬼刃姫", "text": "――ッ！\n待って、あの軍勢は……。", "face": "u435"}]}, {"trigger": "start", "lines": [{"name": "重水の四天王", "text": "くっくっく……待っていましたよ。\n茨木童子様、それと王子たち御一行も。", "face": "l51a03b109ab7"}, {"name": "アンナ", "text": "なッ……私たちが来ることを\nあらかじめ知っていたというのですか？", "face": "l24e6142bb3bb"}, {"name": "重水の四天王", "text": "ええ、間者の報告を通じてね。\nなんでも貴方たちは迅雷の四天王を破ってくれたとか。", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "お、おう。知っとるなら話が早いわ。\nあのおっちゃんと同じ目に遭いとうなければ、\nはよ兵を退くんやな。", "face": "u587"}, {"name": "重水の四天王", "text": "それは承服しかねますね。\n彼との戦いで疲弊した貴方たちにお礼をするために\nこうして兵を集結させて待っていたのですから。", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "な……なんやてーッ！？", "face": "u587"}, {"name": "重水の四天王", "text": "……そういう貴方は何処の子鬼ですか？\n一族から離反した茨木童子様はともかく、\n鬼である貴方がなぜ人間たちと共にいるのです？", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "う……うちは鬼の一族みんなの味方や！\nせやから鬼同士の喧嘩は止める。それだけや！", "face": "u587"}, {"name": "重水の四天王", "text": "くっくっく……愚かを通り越して滑稽ですね。\n貴方は問題の本質をまるで理解していない。", "face": "l51a03b109ab7"}, {"name": "重水の四天王", "text": "全ての鬼を束ねる酒呑童子様がご不在の今、\n四人の異なる長を仰ぐ勢力が相争うのは必定。\nその争乱の収拾には、唯一の統率者が不可欠なのです。", "face": "l51a03b109ab7"}, {"name": "重水の四天王", "text": "そしてその統率者――頭領代理には\nこの抗争を勝ち抜いた最優の者がなるべきだ。\n力だけでなく、智謀にも長けた者がね……。", "face": "l51a03b109ab7"}, {"name": "鬼刃姫", "text": "結局自分が権力を握りたいだけじゃない！\nそんな理由で一族の仲間を傷つけるなんて、許せない！", "face": "u435"}, {"name": "重水の四天王", "text": "やれやれ、理解していただけなかったようですね。\nまぁ、初めから期待はしていませんでしたが。", "face": "l51a03b109ab7"}, {"name": "重水の四天王", "text": "されば、予定通り水葬に付して差し上げましょう！", "face": "l51a03b109ab7"}]}, {"trigger": "end", "lines": [{"name": "重水の四天王", "text": "――ぐふッ！？　\nお、おかしい……こんな……こんなはずでは……ッ！", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "ふっふーん。\nアンナはん、あれを――！", "face": "u587"}, {"name": "アンナ", "text": "は、はいっ！\nこの節分豆が目に入らぬかーっ！", "face": "l24e6142bb3bb"}, {"name": "重水の四天王", "text": "なッ……その手があったか……ッ！\n我ら鬼の力を奪う、忌まわしき穀霊め……。\n道理で……身体が重いわけです……。", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "っちゅーわけや。\n悪いことは言わん。抗争なんてやめて\nはよぅ皆と仲直りしーや？", "face": "u587"}, {"name": "重水の四天王", "text": "……無駄ですよ。\n私がやめたところで、\n他の四天王が同じことをするだけです。", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "そ……そん時はソイツも止めるだけや！", "face": "u587"}, {"name": "重水の四天王", "text": "ほう、そうやって全ての鬼を敵に回すつもりですか？", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "……ッ！", "face": "u587"}, {"name": "重水の四天王", "text": "……さて、我々はそろそろお暇するとしましょう。\n王子たちを倒す好機を逃したのは惜しいですが、\n他の四天王との戦いに備えねばなりませんゆえ。", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "ま、待たんかいッ――", "face": "u587"}, {"name": "重水の四天王", "text": "――止めたければ、力ずくでどうぞ。\n但し、その場合こちらも刺し違えるつもりで参ります。\nそうなれば、風か炎あたりが天下を取るでしょうね。", "face": "l51a03b109ab7"}, {"name": "リンドウ", "text": "く……くっそ～～～～ッ！\nうちは……うちはどないしたらええんや……ッ！", "face": "u587"}, {"name": "重水の四天王", "text": "簡単ですよ。こんな児戯のような真似はおやめなさい。\nでなければ先ほど申し上げた通り、いずれ同族全てを\n敵に回すことになりますよ……では、またいずれ。", "face": "l51a03b109ab7"}, {"name": "アンナ", "text": "リンドウさん……。", "face": "ldf31201fd8e4"}, {"name": "リンドウ", "text": "……確かに、うちの考えは甘かったかもしれん……。", "face": "u587"}, {"name": "リンドウ", "text": "……けど、だからって鬼同士で殺し合うなんて嫌や！\n見とれや、四天王のアホンダラーっ！\nこの抗争、うちが絶対に止めたるからなーっ！！", "face": "u587"}]}], "active": true}