t": 1, "tags": ["機械"], "hp": 2800, "attack": 280, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 600, "attack_wait": 60, "attack_interval": 159, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119008, "special_effect_id": 389, "master_id": 31803, "global_id": 5422, "spawn_sec": 147}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "tags": ["機械"], "hp": 5600, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1500, "attack_range": 250, "attack_wait": 100, "attack_interval": 226, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115792, "special_effect_id": 312, "missile_id": 26, "master_id": 31247, "global_id": 4866, "ranged": true, "spawn_sec": 176}, {"enemy_id": 12, "source": "local", "count": 6, "form_count": 1, "tags": ["機械"], "hp": 2100, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 500, "attack_range": 150, "attack_wait": 30, "attack_interval": 88, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118928, "special_effect_id": 382, "missile_id": 26, "master_id": 31790, "global_id": 5409, "ranged": true, "spawn_sec": 199}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "tags": ["機械"], "hp": 5600, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1500, "attack_range": 250, "attack_wait": 100, "attack_interval": 226, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118976, "special_effect_id": 383, "missile_id": 26, "master_id": 31801, "global_id": 5420, "ranged": true, "spawn_sec": 270}], "popups": ["魔神デミウルゴスがいる間は\n全ての敵のHPが\n徐々に回復します。\n\n\n\n\n　　　　　　(1/2)", "また、魔神デミウルゴスは\n一定値以下の攻撃を防ぐバリアに\n守られています。\n\nバリアはデミウルゴスの触手を\n破壊することで強度を下げることが\nできます。\n　　　　　　(2/2)", "デミウルゴスの触手は\n拠点には向かわず、\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リーンベル", "text": "――無事に侵入できたが、\nこれはいったい、どうなっているんだ……？", "face": "u268"}, {"name": "レクテ", "text": "見たことのない形式だ……。\n配線が機械っていうより生物に近いよ。", "face": "u2047a1"}, {"name": "アルレット", "text": "全く反撃がないのが不気味だねぇ。\nともあれ、今のうちに調査しちゃおう。\n破壊したら調べられなくなるし！", "face": "u1453a1"}, {"name": "レクテ", "text": "変なスイッチとか触らないようにねー。", "face": "u2047a1"}, {"name": "アルレット", "text": "任せて、当たりを引くのは得意だから――っと。\nおーい、レーヴ！　こっちきて！", "face": "u1453a1"}, {"name": "レーヴ", "text": "は、はいっ！\nえっと……制御盤ですか？\n刻まれている名称が、これは……。", "face": "u454"}, {"name": "レーヴ", "text": "……間違いありません。\nデミウルゴスの名が、ここに書かれています。", "face": "u454"}, {"name": "リッカ", "text": "デミウルゴス……。\n昔話の異形の怪物ですよね？\nそれから、くぐつ使いの間では――", "face": "u152"}, {"name": "ウェンディ", "text": "――そう、古の巨大兵器、\n成長し続ける機械なんじゃないかって言われてる。", "face": "u401"}, {"name": "プロメ", "text": "………。", "face": "u2150a1"}, {"name": "レーヴ", "text": "何か、ご存知みたいですね？", "face": "u454"}, {"name": "プロメ", "text": "えぇ、これは、私ですら焼き尽くせなかった、\nいつの時代からあるかも分からない、\n無限に増殖し続ける機械生命です。", "face": "u2150a1"}, {"name": "ユリクセス", "text": "超古代文明の遺産を焼き尽くしてきたプロメが……？\nそれだけ強力な存在ということか？", "face": "u2193a1"}, {"name": "プロメ", "text": "いえ、確かに強力な存在ではあるのですが……。", "face": "u2150a1"}, {"name": "プロメ", "text": "私が対処できなかった最大の理由は、\nその核となるユニットが、\nどこにあるのか全く分からなかったからです。", "face": "u2150a1"}, {"name": "プロメ", "text": "今この場にあるものも、\n果たして本体なのかどうか……。", "face": "u2150a1"}, {"name": "ユリクセス", "text": "まったく、いつの時代の奴か知らないが、\n厄介な遺産を残してくれたものだな。", "face": "u2193a1"}, {"name": "プロメ", "text": "ただ、この個体はこれまでのものに比べて\n遥かに巨大な姿をしています。\nおそらく、コアに近い存在なのではないかと。", "face": "u2150a1"}, {"name": "パルセ", "text": "何にせよ、放置すれば\n際限なく増殖し続けるのであれば、\nここで破壊する以外の選択肢はないですね。", "face": "u2276a1"}, {"name": "エピウス", "text": "ですね……。\nでは、調査が一段落したら、破壊作業に――", "face": "u2194a1"}, {"name": "？？？", "text": "――再起動シークエンス開始。\n再起動シークエンス開始。\n機関始動――カウント開始――", "face": "l7ab7b3e13580"}, {"name": "アルレット", "text": "えっ、わっ、待って！\n変なスイッチ押したりしてないからね！？", "face": "u1453a1"}, {"name": "リーンベル", "text": "どうやら休眠期間が終わったらしい。\n最初から破壊するつもりだったんだ、\n総員、戦闘準備！！", "face": "u268"}, {"name": "デミウルゴス", "text": "――警報。侵入者を確認。\nコアユニットにバリアシステムを展開。\nバリアシステム連携ユニット、正常稼働中。", "face": "l7ab7b3e13580"}, {"name": "レクテ", "text": "ば、ばりあとか言ってるけど！？", "face": "u2047a1"}, {"name": "パルセ", "text": "おそらく、デミウルゴスの異様な耐久性能の原因です。\n周囲に展開されている小型ユニットが、\n共鳴してバリアの強度を高めているんです！", "face": "u2276a1"}, {"name": "レクテ", "text": "あの触手みたいなやつか！\nあれを壊せばいいってことね！", "face": "u2047a1"}, {"name": "パルセ", "text": "それが無難かと思います。\n大火力をもってすれば、\n直接バリアを砕くことも可能かもしれませんが……。", "face": "u2276a1"}, {"name": "リーンベル", "text": "さて、敵は未知の魔神だ。\n気を抜くな！　総員攻撃開始！！", "face": "u268"}, {"name": "デミウルゴス", "text": "――至上命令を遂行します。\n人類に栄光を、人類に平和を、永遠の時代を。", "face": "l7ab7b3e13580"}]}], "active": true}