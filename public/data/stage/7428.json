attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127760, "race_id": 21, "change_to": 10, "change_condition": 4, "master_id": 33555, "global_id": 7172, "to_condition": 4, "to_ticks": 3, "to_global_id": 7175}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127776, "race_id": 21, "special_effect_id": 222, "master_id": 33558, "global_id": 7175, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 2, "hp": 1000, "attack": 230, "base_hp": 1000, "base_attack": 230, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_speed": 60, "attack_wait": 60, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098624, "race_id": 2, "change_to": 14, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34118, "global_id": 7735, "to_global_id": 149, "route_behaviour": {"transforms": [{"wait": 100}]}, "spawn_sec": 81}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 230, "base_hp": 1000, "base_attack": 230, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098624, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 150, "global_id": 149, "ranged": true}, {"enemy_id": 16, "source": "local", "count": 5, "form_count": 1, "hp": 4000, "attack": 700, "base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098528, "race_id": 2, "master_id": 297, "global_id": 296, "route_behaviour": {"transforms": [{"wait": 100}]}, "spawn_sec": 113}], "popups": ["冥界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。\n※軍艦から上陸してくる敵"], "dialogue": [{"trigger": "start", "lines": [{"name": "カテリナ", "text": "陛下！　王子！\n警戒すべきは地面の下だよー！！", "face": "u1344a1"}, {"name": "イグニス", "text": "地面の下って、まさか……。\n皆、足元に注意して！", "face": "u396"}, {"name": "竜人戦士", "text": "地下坑道、貫通！　地上ダ！\n地上ニ出るゾ！　総員戦闘用意ッ！！", "face": "u95"}, {"name": "サザンカ", "text": "なにこれっ、地面に大穴が――\nきゃああぁああっ！？", "face": "u1347a1"}, {"name": "マレブランケ", "text": "掴まれサザンカ！！\n……まったく、連中の時間稼ぎはこのためか！！", "face": "u1225a1"}, {"name": "サザンカ", "text": "このためって、いったいどういうことなの！？\nこんな所に大穴開けたって何も……。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "街を包囲する地下道を、\n竜人族が作るまでの時間稼ぎだったんだよ、この戦いは。\nこのままでは……全周包囲されて壊滅するぞ！", "face": "u1225a1"}]}, {"trigger": "end", "lines": [{"name": "メリュジアナ", "text": "貴様ら、いったい誰に刃を向けたのか分かっているのか！\n古代龍様、黄金竜の姫様は、\n王国と歩みを共にしているのだぞ！！", "face": "u740"}, {"name": "竜人戦士", "text": "……黙レ、黒き竜人の裏切り者。\nモハヤ、誰もお前を族長トハ認めナイ。", "face": "u95"}, {"name": "竜人戦士", "text": "古代龍は我ラの怒りヲ受け入れなかっタ。\n黄金竜ナド、タダの飾りに過ぎヌ。", "face": "u95"}, {"name": "エルドラ", "text": "……メリュジアナ、説得は無用ですわ。\n彼らとて、覚悟の上での反乱でしょう。", "face": "u549"}, {"name": "メリュジアナ", "text": "しかし、姫……っ。\nこの者らは、本来私が……。", "face": "u740"}, {"name": "ハクノカミ", "text": "――悔いておるのか、メリュジアナ。\nおぬしが王国に付くことを選んだその時に、\n袂を分かった小奴らを、始末しておかなかったことを。", "face": "u458"}, {"name": "メリュジアナ", "text": "……はい。\nいずれこんな日が来ると、気付いていたはずなのに……。", "face": "u740"}, {"name": "ハクノカミ", "text": "気にするでない。\n竜とは、気まぐれに世界を愛し、世界を壊す存在じゃ。", "face": "u458"}, {"name": "ハクノカミ", "text": "古代龍とて然り、おぬしらの祖たる竜神とてまた然り。\n敵として会うてしまったなら、\nしっかり引導を渡してやれば済むことよ。", "face": "u458"}, {"name": "エルドラ", "text": "ふっふっふ、もし辛かったら、\nわたくしが代わりにガツンとやってやりますわよ？", "face": "u549"}, {"name": "メリュジアナ", "text": "おふたりは、強すぎます。\nですが私とて、黒き竜人族の長。\n――この血に恥じぬ戦いをしましょうとも。", "face": "u740"}, {"name": "竜人戦士", "text": "……何を言ってイル。\n黒き竜人族ハ、モハヤお前の民ではナイ。", "face": "u95"}, {"name": "メリュジアナ", "text": "……何？", "face": "u740"}, {"name": "竜人戦士", "text": "蘇っタ……蘇っタノダ……。\n我ラが族長が……大長老が……ッ！！", "face": "u95"}]}, {"trigger": "route", "lines": [{"name": "アトナテス", "text": "あれは……ドラゴニュートキャバリアか。\n連中、どうやら戦力を惜しむ気は無さそうだな。", "face": "u908"}, {"name": "ティファ", "text": "なるほど、竜に騎乗した竜人……。\nあの走破能力なら、悪路も簡単に突破しそうですね。", "face": "u476"}, {"name": "エレニア", "text": "上等です。\n竜との絆ならば王国の騎兵とて負けません。\n王子、進行経路に警戒を！　迎え撃ちましょう！", "face": "u252"}]}], "active": true}