{"quest_id": 4539, "name": "大天使長の裁き", "description": "ミルノを浄化するべく現れた\n大天使長の猛攻に耐え、\n堕天使達を罪の楔から解き放て！\n神級（★１獲得の目安：平均Lv50）", "event": "堕天使の誕生", "event_category": "History", "mission_id": 920064, "map_no": 3681, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "hp": 8000, "attack": 550, "base_hp": 8000, "base_attack": 550, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105600, "race_id": 6, "special_effect_id": 74, "master_id": 661, "global_id": 660, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 54, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 2, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 6}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 4, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 28}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 134}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 135}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 2, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 450, "magic_defense": 40, "attack_speed": 200, "attack_wait": 80, "attack_interval": 481, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105504, "race_id": 6, "special_effect_id": 89, "change_to": 6, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 30311, "global_id": 3930, "to_global_id": 658, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 152}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 450, "magic_defense": 40, "attack_range": 300, "attack_speed": 200, "attack_wait": 80, "attack_interval": 281, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105504, "race_id": 6, "special_effect_id": 89, "change_to": 7, "change_condition": 1, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 659, "global_id": 658, "ranged": true, "variants": [{"hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 450, "magic_defense": 40, "attack_speed": 50, "attack_wait": 10, "attack_interval": 151, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105552, "race_id": 6, "special_effect_id": 86, "master_id": 660, "global_id": 659}]}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "待って下さいミルノさん！\n一人ではいずれ天使達に捕まってしまいます。\n私達と行動を共にすべきではありませんか？", "face": "lca552ed7785e"}, {"name": "堕天使ミルノ", "text": "何故来たのですかッ……？！\n……そうか、これが無償の愛……人間には\nやはり天使には無い、きらめきがある……。", "face": "u337"}, {"name": "？？？", "text": "一時の気の迷いに惑わされ堕天するとは……。\n実に嘆かわしいですね。\n天使長ミルノ。", "face": "lb30ecbe31374"}, {"name": "堕天使ミルノ", "text": "貴方は……大天使長様……。\nいずれ、貴方が来ると思っていました。\n全ての天使を監視し、その罪を罰する者……。", "face": "u337"}, {"name": "大天使長", "text": "貴方は尊きものの典型であったのに……。\n知恵に満ち、美の極みであったはずなのに……。\n貴方を惑わす全てを私が罰しましょう。", "face": "lb30ecbe31374"}, {"name": "大天使長", "text": "手始めに貴方の前で、\nまずはこの堕天使を浄化するとしましょう。", "face": "lb30ecbe31374"}, {"name": "クロエ", "text": "――やだッ、ちょっと、放してよぉ！！\n私を誰だと思って……くぅ、っが……ぁ……。\nな、何……この力……こんな……ぁ、ぁあ……。", "face": "u145"}, {"name": "堕天使ミルノ", "text": "クロエ！\n……彼女は、関係ありません……大天使長様！\n罰せられるべきは私のはずです！", "face": "u337"}, {"name": "大天使長", "text": "まだ理解できていないようですね。\nこの堕天使だけでなく、貴方を堕落させた\n人間達も、全て罰するべき罪なのです。", "face": "lb30ecbe31374"}, {"name": "エルン", "text": "そんなこと……させません！\nミルノは人を護ると決めたのです。大天使長で\nあろうと、彼女の邪魔はさせませんよ！", "face": "u202"}, {"name": "大天使長", "text": "全ては神の御心のままに……。\nさあ天使たちよ。\n普く光を以て、粛清を始めましょう。", "face": "lb30ecbe31374"}, {"name": "アンナ", "text": "ミルノさんもクロエも、\n絶対に死なせたりしません！\n王子、戦いのご準備を！", "face": "lca552ed7785e"}]}, {"trigger": "end", "lines": [{"name": "大天使長", "text": "グッ、ぅう……このようなことが……ばかな。\n薄汚れた堕天使などに、この私が、負ける？\n有りえません……有りえるはずが、ない……。", "face": "lb30ecbe31374"}, {"name": "アンナ", "text": "天使たち、撤退していきます。\n何とか、ミルノさん達を護れたようですね。", "face": "lca552ed7785e"}, {"name": "クロエ", "text": "ミルノぉ～！！\n怖かったよぉ……でも、大天使長を退けられた\nんだね……よかった……よかったよぉ～。", "face": "u145"}, {"name": "堕天使ミルノ", "text": "クロエも無事で良かった……。\n王子、ありがとう……心から感謝します。", "face": "u337"}, {"name": "エルン", "text": "誰かを護りたいという強い想いが、王子や私達を\n動かしたのです。\n天使長の崇高な精神に敬意を表します。", "face": "u202"}, {"name": "ニエル", "text": "私もエルンさんと一緒の気持ちだよ。\nミルノさんは、天使であった時よりも、\n今の方が輝いて見えるよ。やっぱり天使長だよ。", "face": "u206"}, {"name": "堕天使ミルノ", "text": "こんな穢れた羽をもった私に、\nそのような言葉は勿体ないです……。", "face": "u337"}, {"name": "クロエ", "text": "まーたそんなこと言ってぇ～！　\n私にとってはミルノはずっと天使長なんだから！\n忘れないでね。", "face": "u145"}, {"name": "天使長ミルノ", "text": "皆さんの言葉が……胸に響くようです。\nこんなに暖かな気持ちになったことは、\n今までにありません……。", "face": "u337"}, {"name": "天使長ミルノ", "text": "……王子、ご相談があります。\n私を貴方たちの仲間として頂けないでしょうか。\n王子のもとで、人々を護っていきたいのです。", "face": "u337"}, {"name": "アンナ", "text": "その言葉、大変嬉しく思います。\n私達は、ミルノさんを歓迎致します。\nこれから、宜しくお願いしますね。"}, {"name": "アンナ", "text": "天使との争いは続いていくのでしょうね……。\nですが、ミルノさんのような天使がいることも\n忘れてはいけません。王子、お疲れ様でした。", "face": "lca552ed7785e"}]}], "active": true}