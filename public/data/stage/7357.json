{"quest_id": 7357, "name": "天界道中の戦い", "description": "敵の新手を増援部隊が到着する前に倒せ！\n<天界（弱）：攻撃力がダウン。\n　一部を除く敵味方のHPが徐々に回復>\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["天界（弱）：攻撃力がダウン。\n　一部を除く敵味方のHPが徐々に回復"], "event": "最後に残された信仰", "event_category": "History", "mission_id": 920163, "map_no": 5900, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -70]}, {"kind": "term", "influence": 41, "params": [0, 60, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 10, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 1, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 30}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124128, "race_id": 20, "change_to": 3, "change_condition": 4, "master_id": 32919, "global_id": 6536, "to_condition": 4, "to_ticks": 3, "to_global_id": 6539, "spawn_sec": 41}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2