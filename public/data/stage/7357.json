ial_effect_id": 242, "change_to": 29, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 33855, "global_id": 7472, "to_global_id": 7478, "route_behaviour": {"reroutes": ["Route=911", "Route=918", "Route=919"]}, "spawn_sec": 176}, {"enemy_id": 29, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["鳥"], "hp": 60000, "attack": 700, "base_hp": 60000, "base_attack": 700, "damage_type": "physical", "armor_defense": 450, "magic_defense": 40, "attack_speed": 1, "attack_wait": 30, "attack_interval": 132, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125824, "race_id": 11, "change_to": 30, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 33861, "global_id": 7478, "to_global_id": 6549}, {"enemy_id": 29, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["鳥"], "hp": 60000, "attack": 700, "base_hp": 60000, "base_attack": 700, "damage_type": "physical", "armor_defense": 450, "magic_defense": 40, "attack_range": 350, "attack_speed": 1, "attack_wait": 30, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125824, "race_id": 11, "special_effect_id": 619, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 32932, "global_id": 6549, "ranged": true}, {"enemy_id": 32, "source": "local", "count": 2, "form_count": 1, "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "magical", "armor_defense": 400, "magic_defense": 25, "attack_range": 240, "attack_speed": 70, "attack_wait": 35, "attack_interval": 101, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112688, "race_id": 6, "special_effect_id": 234, "missile_id": 236, "missile": {"speed": 8.0}, "master_id": 31369, "global_id": 4988, "ranged": true, "commands": {"raw": "SetStageFlag(6, 0);", "sets_flags": [[6, 0]]}, "route_behaviour": {"sets_flags": [[6, 1, 0], [7, 1, 0]]}, "spawn_sec": 185}], "popups": ["こちらに敵の増援が向かっています。\n\n素早く敵を撃破することで、\n増援の到着を防ぐことができます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アルヴァ", "text": "――ほう、僕らの道を塞ぐつもりか。\n王子、前方に敵の新手だ。", "face": "u1198a1"}, {"name": "サナラ", "text": "これだけ荒らしてるんです。\n敵だって必死になりますよね。", "face": "u921"}, {"name": "アルヴァ", "text": "必死なのは兵か、あるいは将か。\nどちらにせよ僕らが脅威とみなされたのは間違いないね。", "face": "u1198a1"}, {"name": "トゥアン", "text": "上等だ。\nこっちは最初から戦争をするつもりなんだ。\n全力でかかって来てもらわないとな。", "face": "u1006a1"}, {"name": "サナラ", "text": "あはは……新たなる千年戦争、ですからね。\nこの次の、千年の平和を勝ち取る戦い……。\n絶対に勝ちましょうね！", "face": "u921"}, {"name": "イリス", "text": "ただ、こちらの被害も拡大しています……。\nこれ以上敵の増援が現れると、\n魔力も薬草も余力が厳しくなりそうです。", "face": "u17"}, {"name": "アイシャ", "text": "こちらの戦力を奪う神聖騎士団とは、\nまさに真逆の立ち位置、かな。\n長引くほどボクらの勝機は減っていく。", "face": "u181"}, {"name": "トゥアン", "text": "つまりやることは一緒だろ？\n短期決戦で、連中をぶちのめせばいいわけだ。", "face": "u1006a1"}, {"name": "アルヴァ", "text": "違いない。\n――王子、軍団の指揮は任せた。\nオリュンポスまであと少し……切り抜けるぞ！", "face": "u1198a1"}]}, {"trigger": "end", "lines": [{"name": "アルヴァ", "text": "よし、増援は追いついていないようだね。\nこのまま突っ切ればオリュンポスを守る結界、\n僕らを阻む障壁とご対面だ。", "face": "u1198a1"}, {"name": "アンナ", "text": "あらゆる奇跡を起こすという、神の楔。\nこの力で、オリュンポスに侵入できれば良いのですが……。", "face": "l45313c4b71aa"}, {"name": "ミレイユ", "text": "私たちの取りうる手段の内、最善を選んだのです。\n今はただ、人の手が天界にも\n届きうるのだと、前を向いて進みましょう。", "face": "u386"}, {"name": "ミレイユ", "text": "それに、上に立つ者が不安がっていると、\n兵にもその気持ちは伝わってしまうものですよ。\nさぁ胸を張って、あなたは政務官なのですから。", "face": "u386"}, {"name": "ウズメ", "text": "失敗した時のことも、策は練ってあります。\nどれも厳しい道程ではありますが、\nそういったことは我々におまかせを。", "face": "u125"}, {"name": "アンナ", "text": "……そう、ですね。\n私たちは常に、前を向いていないと。\nすみません王子、つい弱気になってしまいました。"}, {"name": "アンナ", "text": "ここを抜ければ、オリュンポスは目の前です。\nこの戦いに勝利し、物質界の騒乱を鎮めましょう！", "face": "l276c938aebac"}]}, {"trigger": "end", "lines": [{"name": "アラエル", "text": "どう、して……。\nソフィー……？　トラム様……？\nああ、僕の小鳥たち、なぜ僕を、あああああああッ！！", "face": "l052e68aac31d"}, {"name": "アラエル", "text": "クソッ、クソッ、クソォォォッ！！\n死ねっ！　勝手に死ねッ！\n嫌いだ、皆みんな嫌いだぁあッ！！", "face": "l052e68aac31d"}, {"name": "アンナ", "text": "……敵の増援、撤退していきます。", "face": "l276c938aebac"}, {"name": "アルヴァ", "text": "ここを抜ければ、目的地はもうすぐそこだ。\n……皆、覚悟はできているかい？", "face": "u1198a1"}, {"name": "アンナ", "text": "あらゆる奇跡を起こすという、神の楔。\nこの力で、オリュンポスに侵入できれば良いのですが……。", "face": "l45313c4b71aa"}, {"name": "ミレイユ", "text": "私たちの取りうる手段の内、最善を選んだのです。\n今はただ、人の手が天界にも\n届きうるのだと、前を向いて進みましょう。", "face": "u386"}, {"name": "ミレイユ", "text": "それに、上に立つ者が不安がっていると、\n兵にもその気持ちは伝わってしまうものですよ。\nさぁ胸を張って、あなたは政務官なのですから。", "face": "u386"}, {"name": "ウズメ", "text": "失敗した時のことも、策は練ってあります。\nどれも厳しい道程ではありますが、\nそういったことは我々におまかせを。", "face": "u125"}, {"name": "アンナ", "text": "……そう、ですね。\n私たちは常に、前を向いていないと。\nすみません王子、つい弱気になってしまいました。"}, {"name": "アンナ", "text": "ここを抜ければ、オリュンポスは目の前です。\nこの戦いに勝利し、物質界の騒乱を鎮めましょう！", "face": "l276c938aebac"}]}, {"trigger": "route", "lines": [{"name": "アラエル", "text": "とうとうここまで来ましたか。\n罪深き人の子らよ。", "face": "l052e68aac31d"}, {"name": "パリオス", "text": "アラエルさまっ！？\nどうしてここに……。", "face": "u1109a1"}, {"name": "アラエル", "text": "おぉ、僕の小鳥たちよ。\n罪深き者の甘言に惑わされ、我らが主に刃を向けるとは。", "face": "l052e68aac31d"}, {"name": "ライノー", "text": "……くっ、以前より精神支配が強くなっているのか？\n本来のアラエル様ならば、\nきっと私たちの味方になってくれただろうに……。", "face": "u1086a1"}, {"name": "ソフィー", "text": "天使に施された支配の力は、\nおそらく神の楔にも匹敵するものです。", "face": "u146"}, {"name": "ソフィー", "text": "堕天した身なれど、\n私にもアラエルを縛る魔力の波動が感じられます。", "face": "u146"}, {"name": "アラエル", "text": "ぐっ……その顔は……どこかで……。\nソ、フィー……？　ソフィーなのですか……？", "face": "l052e68aac31d"}, {"name": "アラエル", "text": "ああ、良かった……。\nすぐにこの邪魔者たちを浄化して……。\nそうだ、トラム様の天使も誘って遊びに行きましょう。", "face": "l052e68aac31d"}, {"name": "アラエル", "text": "物質界の見える高台を見つけたんです。\nきっと楽しいですよ……ああ……皆で、皆、ああ、あぁッ、\nくそっ、なんだ、なんだこれッ、こんな記憶……ッ！！", "face": "l052e68aac31d"}, {"name": "アトナテス", "text": "……ますます、気に入らねぇな。\nトラム、この支配魔法を使ってる奴が、\nオリュンポスにいるんだな？", "face": "u908"}, {"name": "トラム", "text": "えぇ、おそらくこれも、\n創造神の遺構を悪用したものだと思うわ。", "face": "u1110a1"}, {"name": "アトナテス", "text": "アラエル、てめぇの苦しみは目に焼き付けたぜ。\nそれ以上の槍を、\nオリュンポスの主に叩き込んでやるからな。", "face": "u908"}, {"name": "パリオス", "text": "王子さま、あの霊鳥はアラエル様と繋がっているの。\n先にアラエル様を倒さないと、\n霊鳥は不滅だから気をつけて！", "face": "u1109a1"}]}], "active": true}