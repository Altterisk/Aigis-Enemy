{"quest_id": 4439, "name": "アジトの決戦", "description": "姿を消して忍び寄る暗殺部隊と\nミノタウロスを撃破し、\nギルド長の野望を砕け！\n極級（★１獲得の目安：平均Lv25）", "event": "闇ギルドの召使い", "event_category": "History", "mission_id": 920056, "map_no": 3641, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 20, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 8, "form_count": 1, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 13}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["ステルス"], "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103728, "race_id": 16, "special_effect_id": 61, "change_to": 3, "master_id": 472, "global_id": 471, "to_global_id": 472, "route_behaviour": {"transforms": [{"wait": 1500}]}, "spawn_sec": 29}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109104, "race_id": 16, "special_effect_id": 61, "change_to": 2, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 473, "global_id": 472, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103536, "race_id": 16, "special_effect_id": 61, "change_to": 5, "master_id": 454, "global_id": 453, "to_global_id": 454, "route_behaviour": {"transforms": [{"wait": 1500}]}, "spawn_sec": 54}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103552, "race_id": 16, "special_effect_id": 61, "change_to": 4, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 455, "global_id": 454, "ranged": true}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 30000, "attack": 1100, "base_hp": 30000, "base_attack": 1100, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103568, "race_id": 12, "master_id": 456, "global_id": 455, "spawn_sec": 68}, {"enemy_id": 8, "source": "local", "count": 12, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 82}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "tags": ["ステルス"], "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103744, "race_id": 16, "special_effect_id": 61, "change_to": 9, "master_id": 474, "global_id": 473, "to_global_id": 474, "route_behaviour": {"transforms": [{"wait": 1600}]}, "spawn_sec": 94}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103712, "race_id": 16, "special_effect_id": 61, "change_to": 8, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 475, "global_id": 474, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "アイリーン", "text": "見つけました。\nここがギルド長のアジトのようです。", "face": "u315"}, {"name": "ギルド長", "text": "お前は……。そうか、あの時のメイドか。\n一部の者しか知らないはずのこの場所を突き止める\nその執念は、闇ギルド仕込みと言ったところか。", "face": "l1501c5fc245a"}, {"name": "アイリーン", "text": "前ギルド長が家族のように愛した\n闇ギルドをこんな風にしてしまうなんて……。\n今の闇ギルドは、まるで魔物の手先です。", "face": "u315"}, {"name": "ギルド長", "text": "あのお人好しで能無しの奴が築き上げたものなど、\n取るにたらん。闇ギルドの勢力は奴が治めていた\n時代とは比べ物にならない程、増している。", "face": "l1501c5fc245a"}, {"name": "アイリーン", "text": "……！", "face": "u315"}, {"name": "ギルド長", "text": "すでに俺の元には、あいつの代では到底集める\nことのできなかった潤沢な資金と、闇ギルドの規則に\n忠実な構成員が集まっているんだ。", "face": "l1501c5fc245a"}, {"name": "ギルド長", "text": "魔物の手先といったな？　笑わせるな。\n俺はむしろ魔物の力を利用し、この世界を支配する。\n俺の作ったこの新しい闇ギルドでな……っ！", "face": "l1501c5fc245a"}, {"name": "アンナ", "text": "そんな事はさせません！", "face": "lb82169bfb75c"}, {"name": "ギルド長", "text": "ん？　どうやら英雄の末裔も一緒のようだな。\n標的が向こうからやってくるとは都合がいい。\n懸賞金を払う必要もなくなるというものだ。", "face": "l1501c5fc245a"}, {"name": "ギルド長", "text": "ここで王子を倒せば、闇ギルドはより一層盤石な\n組織となるだろう。\n暗殺部隊よ、指令だ。王子を抹殺せよ。", "face": "l1501c5fc245a"}, {"name": "闇ギルド幹部", "text": "……承知。", "face": "lf1b1179a909c"}, {"name": "アンナ", "text": "王子、向かってきます！\n私たちも戦闘の準備を！", "face": "lb82169bfb75c"}]}, {"trigger": "end", "lines": [{"name": "ギルド長", "text": "くっ……、このまま、お前たちの手に\nかかるくらいなら、俺は自ら死を選ぶ……っ！", "face": "l1501c5fc245a"}, {"name": "アンナ", "text": "……！\n何をするつもりですか！？", "face": "lb82169bfb75c"}, {"name": "ギルド長", "text": "……。", "face": "l15a6483d0c78"}, {"name": "アンナ", "text": "そんな……。自ら命を絶つなんて……。", "face": "lb82169bfb75c"}, {"name": "セシリー", "text": "これは毒入りの瓶……。\n案外、潔かったな、もっと見苦しい最期を\n期待していたのだが。", "face": "u21"}, {"name": "モーティマ", "text": "仕方ねぇな……。\nま、ギルド長がいなくなれば、\n今の闇ギルドもしばらくはなりを潜めるだろう。", "face": "u14"}, {"name": "アンナ", "text": "……そうですね。これで闇ギルドに悩まされていた\n方々も解放される事でしょう。\nアイリーンさんはこれからどうされるんですか？", "face": "lb82169bfb75c"}, {"name": "アイリーン", "text": "まずは前ギルド長の墓前にご報告をしてまいります。\nそれから先のことは考えておりません。", "face": "u315"}, {"name": "アンナ", "text": "もしよかったらですが、\n私達の所へいらっしゃいませんか。\nぜひ王子に力を貸してください。"}, {"name": "アイリーン", "text": "そうですね、今回は王子たちにはとてもお世話に\nなりましたし、今度は、私が王子の軍の方々の\nお世話をさせていただきます。", "face": "u315"}, {"name": "アイリーン", "text": "では、皆さまは先にお帰りください。\n私も用事を済ませましたら参上させていただきます。", "face": "u315"}, {"name": "アイリーン", "text": "どうぞお気をつけて。", "face": "u315"}, {"name": "アンナ", "text": "はい、アイリーンさんも。"}]}, {"trigger": "end", "lines": [{"name": "ギルド長", "text": "……。", "face": "l1501c5fc245a"}, {"name": "ギルド長", "text": "ククク、行ったか。\n愚か者どもめが、この瓶の薬が仮死状態になる\n薬とも気づかずに。", "face": "l1501c5fc245a"}, {"name": "ギルド長", "text": "やつらのせいで、我が闇ギルドも痛手を\n負ってしまったが俺が死んだと思ってくれれば、\n活動しやすくなるというものだ。", "face": "l1501c5fc245a"}, {"name": "ギルド長", "text": "それにしても、いまいましい王子め。\nやつを倒さねば我が野望も危ういな。\nこれから定期的に刺客を送り込んでやろう。", "face": "l1501c5fc245a"}, {"name": "ギルド長", "text": "そうだなぁ。最初は……。\n例の暗黒騎士団と手を組むのも面白いな。\nやつらに闇ギルド特製の毒の武器を渡して……。", "face": "l1501c5fc245a"}, {"name": "ギルド長", "text": "はっ！\n誰だそこにいるのは。", "face": "l1501c5fc245a"}, {"name": "アイリーン", "text": "やっと目を覚ましたか、待ちくたびれたぞ。", "face": "u1315"}, {"name": "ギルド長", "text": "き、貴様なぜここに！", "face": "l1501c5fc245a"}, {"name": "アイリーン", "text": "あの薬が仮死状態になるものだとは最初から\nわかっていた。", "face": "u1315"}, {"name": "ギルド長", "text": "なんだと。\nで、では、なぜ……！？", "face": "l1501c5fc245a"}, {"name": "アイリーン", "text": "なぜ、先に王子たちを帰したのか\nということか？", "face": "u1315"}, {"name": "アイリーン", "text": "あの方々がいっしょだと、貴様のような外道に\nふさわしい死に様をくれてやれないからだ。\n王子たちは優しいからな……。", "face": "u1315"}, {"name": "ギルド長", "text": "くそっ…、く、来るな。\nか、体が……まだ完全には動かないんだ。\nお、俺はまだこれからの男なんだよ。", "face": "l1501c5fc245a"}, {"name": "アイリーン", "text": "いえ、あなたはここで終わりです。\nごきげんよう。", "face": "u1315"}, {"name": "ギルド長", "text": "……ぐ……ぁぁぁ。", "face": "l1501c5fc245a"}]}], "active": true}