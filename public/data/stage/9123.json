5, "master_id": 40011, "global_id": 13628, "route_behaviour": {"hold": {"routes": 9, "held": 9}}, "spawn_sec": 60}, {"enemy_id": 9, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "tags": ["タルタロスの呪縛"], "hp": 620000, "attack": 350, "base_hp": 62000, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 75, "attack_interval": 199, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2168528, "special_effect_id": 2344, "missile_id": 11, "master_id": 40010, "global_id": 13627, "ranged": true, "route_behaviour": {"sets_flags": [[100, 1, 0]]}, "spawn_sec": 60}, {"enemy_id": 10, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "tags": ["アーマー", "帝国", "タルタロスの呪縛"], "hp": 210000, "attack": 1400, "base_hp": 21000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 80, "attack_interval": 217, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2173680, "race_id": 16, "special_effect_id": 2526, "missile_id": 1665, "missile": {"speed": 12.0}, "master_id": 41223, "ranged": true, "spawn_sec": 105}, {"enemy_id": 11, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "tags": ["影の帝国", "タルタロスの呪縛", "置物"], "fixture": true, "uncounted": true, "hp": 1200000, "attack": 1200, "base_hp": 120000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "attack_range": 250, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2173648, "special_effect_id": 2530, "missile_id": 1725, "missile": {"speed": 8.0}, "master_id": 41218, "ranged": true, "route_behaviour": {"hold": {"routes": 11, "held": 11, "release_flags": [0, 1, 2, 3, 4, 5, 6]}}, "spawn_sec": 109}, {"enemy_id": 12, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "tags": ["タルタロスの呪縛"], "hp": 150000, "attack": 5500, "base_hp": 15000, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 75, "attack_interval": 240, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2173696, "race_id": 11, "special_effect_id": 2525, "master_id": 41224, "route_behaviour": {"sets_flags": [[100, 1, 0]]}, "spawn_sec": 117}, {"enemy_id": 13, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 2000000, "attack": 3500, "base_hp": 200000, "base_attack": 3500, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_range": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 343, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173504, "race_id": 10, "special_effect_id": 2522, "missile_id": 45, "master_id": 41210, "ranged": true, "spawn_sec": 163}, {"enemy_id": 14, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 250000, "attack": 1800, "base_hp": 25000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2173488, "race_id": 16, "missile_id": 1665, "missile": {"speed": 12.0}, "master_id": 23606, "ranged": true, "spawn_sec": 273}], "dialogue": [{"trigger": "start", "lines": [{"name": "ネヴィン", "text": "――王子、来てくれたか。\nだが戦況は最悪だ。\n魔神の侵攻を遅らせることすらできていない。", "face": "u407"}, {"name": "マンモン", "text": "ね、ねぇ、ベルーフェちゃん？\nこの魔力の響き方、やばやばじゃない……！？", "face": "u767"}, {"name": "ベルーフェ", "text": "うぅぅ～……。\nいやーな感じ……ぎりぎり爆発してないっていうか、\nもういつ弾け飛んでもおかしくないっていうか……。", "face": "u645"}, {"name": "アンナ", "text": "魔力の臨界が近い、ということですね……。"}, {"name": "バロウス", "text": "でも魔神本体も平気ではいられないみたいね。\n見て、臨界に近づいた魔力のせいで、\n身体が徐々に崩壊し始めてる。", "face": "u448"}, {"name": "バロウス", "text": "魔力を溜め込めばそれだけ強くなるけど、\n同時に、自らも崩壊に近付くっていうのに。", "face": "u448"}, {"name": "ベルーフェ", "text": "それでも魔力を溜め込むのをやめない、のかぁ\nこれはもう、彼らの意志とは関係ない、\n完全なる暴走って言えそうだねぇ。", "face": "u645"}, {"name": "バロウス", "text": "臨界前に、とにかく最速で叩き潰すしかないね。", "face": "u448"}, {"name": "ネヴィン", "text": "状況は最悪だが、\n最悪の中でもギリギリマシな方ってことか。\nはぁ……王子、絶対に油断するんじゃないぞ。", "face": "u407"}, {"name": "アトナテス", "text": "これまでと同じ、とは思わないほうがいいな。\nこの異常な魔力量だ、己の消滅を厭わない力を\n発揮してくるかもしれない。", "face": "u908"}, {"name": "アンナ", "text": "早期撃破を狙うしかなさそうですね……。\n王子、全軍出撃準備完了しました。\nどうか、慎重な指揮をお願いします！"}, {"name": "ネヴィン", "text": "――王子、気をつけろ！\n魔神アモンの魔力が増幅しているぞ！", "face": "u407"}, {"name": "ヘンゼル", "text": "アモンの灼熱の力が『暴走』している！\n戦場すべてが、灼熱の炎で満たされていくぞ！", "face": "u1622a1"}, {"name": "ラクシャーサ", "text": "これは……！\nアモンが周囲に展開していた、\n生命力を削る力が戦場全域に広がっているのか！？", "face": "u306"}, {"name": "アトナテス", "text": "なんだ……？\nキメリエスの眷属の士気が上がったぞ。", "face": "u908"}]}, {"trigger": "start", "lines": [{"name": "サオシュ", "text": "魔神キメリエスの周囲の敵、\n防護だけでなく、攻撃の鋭さまで向上しています……。\n魔神の加護が『暴走』したのかもしれません！", "face": "u968"}, {"name": "バロウス", "text": "眷属に攻撃の加護を与えたのね……。\n王子、眷属の力にも注意を払って！", "face": "u448"}, {"name": "フローガ", "text": "魔神キメリエス、魔神アモン、\n共に魔力が霧散していきます！", "face": "u878"}, {"name": "アトナテス", "text": "……やれやれ、今度こそ決着か？", "face": "u908"}, {"name": "アスバール", "text": "本当に危ないところでした……。\n霧散していく魔力の、この尋常ではない量。\n臨界に達していたら、今頃魔界は……。", "face": "u1668a1"}, {"name": "ロタン", "text": "魔界だけでなく、\nきっと物質界にも大きな爪痕を残していたでしょうね。\n本当に、倒せて良かった……。", "face": "u1616a1"}, {"name": "マンモン", "text": "ふふふ、でも勝利は勝利ですよ！\nはぁ、本当に大変な戦いでしたぁ……。", "face": "u767"}]}], "active": true}