{"quest_id": 9123, "name": "超越神級", "description": "2体の魔神を撃破せよ！\n＜魔界：味方の攻撃力と防御力が半減＞\n＜時間経過によるコスト回復なし＞\n＜編成内での同ユニット禁止＞", "modifier_notes": ["魔界：味方の攻撃力と防御力が半減", "時間経過によるコスト回復なし", "編成内での同ユニット禁止"], "event": "魔神最終決戦アモン＆キメリエス", "event_category": "Devil Advent", "mission_id": 500401, "map_no": 5082, "level": 1000, "multiplier": 10.0, "charisma": 25, "capacity": 10, "modifiers": [{"kind": "term", "influence": 24, "params": [10], "expression": "IsOverlapMember() != 1;", "expression_human": "it is not a duplicate of another unit in your team"}, {"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 11, "params": [400], "expression": "IsStageFlag( 1) && IsEnemyElementAny( \"アーマー\") ;", "expression_human": "stage flag 1 is set and the enemy is element/tag アーマー"}, {"kind": "term", "influence": 18, "params": [300], "expression": "IsStageFlag( 8) && IsEnemyElementAny( \"アーマー\") ;", "expression_human": "stage flag 8 is set and the enemy is element/tag アーマー"}, {"kind": "term", "influence": 17}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 2500000, "attack": 2200, "base_hp": 250000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 800, "attack_range": 220, "attack_speed": 1, "attack_wait": 35, "attack_interval": 121, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2173632, "race_id": 16, "special_effect_id": 2523, "change_to": 1, "missile_id": 1723, "missile": {"speed": 10.0, "on_hit": {"kind": "DOT", "duration_f": 180, "interval_f": 30, "pct_hp": 30, "uses_atk": true, "relief": true, "effect_name": "DebuffEffectPoison3"}}, "master_id": 41214, "ranged": true, "to_condition": 0, "to_flag": [50, 1], "sp_change_to": [41215], "route_behaviour": {"transforms": [{"flag": 50, "val": 1}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["影の帝国", "タルタロスの呪縛"]