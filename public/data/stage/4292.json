 "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 126}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 2, "hp": 1430, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 131}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1430, "attack": 385, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 8, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "あれは……。", "face": "l81910d30b191"}, {"name": "冒険者", "text": "お、ポーラ！　あ？　そいつらは？", "face": "l2318e74fc12b"}, {"name": "ポーラ", "text": "私たちに協力してくれるのです。\nそれより、何をしてるのです？", "face": "u253"}, {"name": "冒険者", "text": "あぁ、ここのフロアは遠距離攻撃をしてくる\n魔物が生息しているんだが……。", "face": "l2318e74fc12b"}, {"name": "冒険者", "text": "俺らのパーティーにはヒーラーがいねぇ。\n一方的に受けると回復できねぇから\n立ち往生してんだよ。", "face": "l2318e74fc12b"}, {"name": "冒険者", "text": "それに、なんだかこのフロアから\n魔物が強くなっている印象がある。", "face": "l2318e74fc12b"}, {"name": "冒険者", "text": "逃げ帰ろうにもどこから攻撃が飛んでくるか\nわかんねぇから、動くに動けやしねぇ……！", "face": "l2318e74fc12b"}]}, {"trigger": "start", "lines": [{"name": "兵士", "text": "報告！　敵が接近してきています！", "face": "l19c8bba64df9"}, {"name": "アンナ", "text": "王子、迎撃の準備を。", "face": "l81910d30b191"}, {"name": "冒険者", "text": "あわわわ……。\nきたぁあ……！！", "face": "l2318e74fc12b"}]}, {"trigger": "battle", "at_sec": 30, "lines": [{"name": "アンナ", "text": "心なしか敵の射程距離が長くなっているような\n気がします。", "face": "l81910d30b191"}, {"name": "アンナ", "text": "さながら、魔王の加護といったところでしょうか。", "face": "l81910d30b191"}, {"name": "冒険者", "text": "おい、魔物はあっちにくぎ付けだ。今のうちに行くぜ。\nあばよ！　先に行くぜぇ！", "face": "l2318e74fc12b"}, {"name": "ポーラ", "text": "えっ……？\nあ、あの人たち……！", "face": "u253"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "魔物の撤退を確認しました。\nあの冒険者たちは先に向かったようですが、\n大丈夫でしょうか……。", "face": "l81910d30b191"}, {"name": "ポーラ", "text": "あの人たちは、どんな危険なダンジョンに潜っても\n生還してくるベテランなのです。\nただ、常に金欠なのです。", "face": "u253"}, {"name": "アンナ", "text": "彼らのパーティーにヒーラーがいないと\n言っていましたし、恐らく回復薬の購入費かと……。\nひとまず次のフロアにいきましょう。", "face": "l81910d30b191"}]}], "active": true}