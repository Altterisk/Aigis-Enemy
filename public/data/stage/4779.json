, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 68}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 8, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 72}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 7, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 10, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 73}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 250, "base_hp": 8000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 79, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108384, "master_id": 30025, "global_id": 3644, "spawn_sec": 130}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "attack_range": 400, "attack_speed": 70, "attack_wait": 35, "attack_interval": 130, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105472, "race_id": 6, "missile_id": 151, "missile": {"speed": 3.0}, "master_id": 30026, "global_id": 3645, "ranged": true, "spawn_sec": 150}, {"enemy_id": 14, "source": "local", "count": 5, "form_count": 1, "tags": ["帝国", "女性"], "hp": 2000, "attack": 500, "base_hp": 2000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_range": 40, "attack_speed": 80, "attack_wait": 30, "attack_interval": 91, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102496, "race_id": 16, "special_effect_id": 229, "missile_id": 45, "master_id": 335, "global_id": 334, "ranged": true, "spawn_sec": 163}], "dialogue": [{"trigger": "start", "lines": [{"name": "皇帝", "text": "…………。", "face": "u418"}, {"name": "ゴブリンクイーン", "text": "ウフフ……何て精神力なのかしら。\nここまでワタシの催眠術をはね除けた人間なんて\n過去に一人もいなかったわ。", "face": "ldabb61962c40"}, {"name": "女王蟻", "text": "生物として雄であれば何者であろうと魅了する\n妾のフェロモンにも抗い続けるとは……ふふ。\n帝国の皇帝……其方が堕ちる時が楽しみよのぅ。", "face": "l98cf3cb254f7"}, {"name": "皇帝", "text": "黙れ……貴様らの様な愚物に、屈するものか……。", "face": "u418"}, {"name": "ゴブリンクイーン", "text": "あらぁ、まだそんな口を利く元気があるのね。\nこの状況が分かっているのかしら？\n貴方の可愛い部下達はもう既に全員堕ちているのよ？", "face": "ldabb61962c40"}, {"name": "皇帝", "text": "…………薄汚い雌が。", "face": "u418"}, {"name": "女王蟻", "text": "ほう……。魔界でも絶世の美女と、うたわれた妾と\nゴブリンクイーンにその様な戯言……。\n許さぬぞ……絶対にィ……キシィィィィ！", "face": "l98cf3cb254f7"}, {"name": "ゴブリンクイーン", "text": "ちょっと待つのよ、蟻の女王。\n私にいい考えがあるわぁ。\n同時に使うのよ、私達の秘術をね。ウフフフフ。", "face": "ldabb61962c40"}, {"name": "女王蟻", "text": "ふぅむ……それは、たいそうな妙案よの。\nまこと、それであればこの雄もすぐに堕ちるであろうな。", "face": "l98cf3cb254f7"}, {"name": "ゴブリンクイーン", "text": "ウフフフ……決まりね。女として敵である\nアナタとの共同作業なんて、嫌な感じだけど、\nこの際仕方ないわぁ。さぁ、いくわよぉ！！", "face": "ldabb61962c40"}, {"name": "皇帝", "text": "――ッ！！\nう………ぐ………あぁあ。い、意識……が……。\n――女王……サマ。クイーンサ……マ……。", "face": "u418"}, {"name": "アンナ", "text": "王子！　あそこに皇帝が！", "face": "ld79f76f59b1a"}, {"name": "ユリアン", "text": "お、おい……皇帝に寄り添ってる魔物達を見ろよ……。\nゴブリンクイーンだぞ……それに、女王蟻も……！\n２人がかりで皇帝を自分達の奴隷にしたってわけかよ。", "face": "u7"}, {"name": "アダマス", "text": "ケラウノス姉様……魔物の女王までも使うなんて……。\n王子、私の加護を受けた皇帝は強敵です。\nお気をつけください！", "face": "lddf7a687accd"}]}, {"trigger": "end", "lines": [{"name": "ディルク", "text": "陛下ッ！！\nしっかりしてください！　私がお分かりになりますか？", "face": "u287"}, {"name": "皇帝", "text": "……う……お、お前は……。\nディルク……か……？", "face": "u418"}, {"name": "ディルク", "text": "はいっ！　そうです、ディルクです！\n陛下……良かった……！　うぅ……グス……。", "face": "u287"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "皇帝", "text": "――ん？\n貴様は、英雄王の末裔の王子か……。", "face": "u418"}, {"name": "皇帝", "text": "なるほど……。\n俺はとんだ醜態を見せてしまったという訳だな。", "face": "u418"}, {"name": "ディルク", "text": "す、すいません……。\nですが、陛下が戻られぬ不安から、\n兵士もレオナ様も皆、動揺していて……。", "face": "u287"}, {"name": "アダマス", "text": "我が神器を受け継ぎし者よ。", "face": "lddf7a687accd"}, {"name": "皇帝", "text": "その姿は、アダマス様……なのか！？", "face": "u418"}, {"name": "アダマス", "text": "はい。如何にも私が女神アダマスです。この迷宮に\n長らく囚われていましたが、精神体の身とはいえ、\n貴方達のお陰でこうして、復活を果たしました。", "face": "lddf7a687accd"}, {"name": "アダマス", "text": "ですが、状況は悪化しています。\n我が姉ケラウノスが活動を開始しました。\nそれと共に、魔王も復活の兆しを見せています。", "face": "lddf7a687accd"}, {"name": "皇帝", "text": "なん……だと……。", "face": "u418"}, {"name": "アダマス", "text": "地上界は絶望的といっても過言ではありません……。\n今や、アイギス姉さまも私も、\n力の大半を失ってしまいました……。", "face": "lddf7a687accd"}, {"name": "アダマス", "text": "かつての千年戦争の時の様に、\n貴方達に力を貸す事はできません……。", "face": "lddf7a687accd"}, {"name": "アダマス", "text": "わずかな望みがあるとすれば、\n二柱の神の加護を受けし者達。\n聡明な貴方ならば、もう全て理解しているのでしょう？", "face": "lddf7a687accd"}, {"name": "皇帝", "text": "……是非も無い。\n王子、どうやら貴様と協力せねばならぬようだな。", "face": "u418"}, {"name": "王子", "text": "……。（コクリ）", "face": "u1"}, {"name": "アンナ", "text": "ち、ちょっと、王子！　\n国同士の大事な取り決めです！\n相槌だけじゃダメですよっ！", "face": "ld79f76f59b1a"}, {"name": "皇帝", "text": "……ふ。気にするな。俺もお喋りは好きじゃない。\n王子、貴様と俺は何もかもが違うが、\nそこだけは気が合うかもしれんな。", "face": "u418"}]}], "active": true}