{"quest_id": 9107, "name": "決勝Lv.1", "description": "決勝戦に挑むべく鉱山へ踏み入る王子たち。\nそこには無法者たちをまとめ上げた\nゴブリンの少女が待ち構えていた。\n＜ユニット、アイテムのドロップなし＞", "modifier_notes": ["ユニット、アイテムのドロップなし"], "event": "ガンスリングフロンティア", "event_category": "History", "mission_id": 920199, "map_no": 7121, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 108000, "attack": 600, "base_hp": 108000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_interval": 34, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145392, "race_id": 9, "special_effect_id": 1423, "change_to": 1, "change_condition": 1, "master_id": 36295, "global_id": 9912, "variants": [{"hp": 108000, "attack": 600, "base_hp": 108000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_interval": 34, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145408, "race_id": 9, "special_effect_id": 1417, "master_id": 36296, "global_id": 9913}], "sp_change_to": [36297], "route_behaviour": {"transforms": [{"to": 36297}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 108000, "attack": 600, "base_hp": 108000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_interval": 34, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145392, "race_id": 9, "special_effect_id": 1420, "master_id": 36297, "global_id": 9914, "from_condition": "sp_change"}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type":