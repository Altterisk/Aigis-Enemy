, "count": 38, "form_count": 1, "hp": 7500, "attack": 500, "base_hp": 7500, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 237, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145280, "race_id": 16, "special_effect_id": 1415, "missile_id": 26, "master_id": 36288, "global_id": 9905, "ranged": true, "spawn_sec": 219}, {"enemy_id": 18, "source": "local", "count": 10, "form_count": 1, "hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2145296, "race_id": 16, "change_to": 18, "change_condition": 1, "master_id": 36289, "global_id": 9906, "variants": [{"hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2145312, "race_id": 16, "special_effect_id": 1090, "master_id": 36290, "global_id": 9907}], "spawn_sec": 284}, {"enemy_id": 20, "source": "local", "count": 10, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 717, "global_id": 716, "spawn_sec": 323}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2097200, "special_effect_id": 902, "master_id": 36265, "global_id": 9882, "route_behaviour": {"sets_flags": [[11, 1, 300], [10, 1, 60]]}, "spawn_sec": 382}, {"enemy_id": 22, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097952, "race_id": 9, "change_to": 22, "change_condition": 1, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 54, "global_id": 53, "ranged": true, "variants": [{"hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 24, "attack_wait": 1, "attack_interval": 51, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097968, "race_id": 9, "master_id": 55, "global_id": 54}], "spawn_sec": 383}], "popups": ["敵に吟遊詩人の\nゴブリンがいる間は\n全ての敵の攻撃力が\nアップします。", "ボムゴブリンは倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "トネール", "text": "ここが鉱山か。\nアタシも足を踏み入れるのははじめてだねぇ。", "face": "u1885a1"}, {"name": "トネール", "text": "それでお相手の無法者は……\nおっと、あれかい？", "face": "u1885a1"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "あれは……ゴブリンでしょうか？", "face": "le9ef8695c4fb"}, {"name": "リーナ", "text": "え、えぇっ……！？\nま、まさか、あのゴブリンは……！", "face": "u521"}, {"name": "トネール", "text": "ん？　知っているのかい、お嬢ちゃん。", "face": "u1885a1"}, {"name": "リーナ", "text": "は、はい……噂で聞いたことが、あります……。\n私と似たような……人間に近い容姿の、\nゴブリンの少女がいると……。", "face": "u521"}, {"name": "リーナ", "text": "その少女は、ギター一本で、\n無法者をまとめ上げた、吟遊詩人なのだそうです……。", "face": "u521"}, {"name": "アンナ", "text": "ギ、ギターでですか！？", "face": "le9ef8695c4fb"}, {"name": "トネール", "text": "いったいどうやったのかは気になるが……\nその噂は確かみたいだねぇ。", "face": "u1885a1"}, {"name": "王妃人", "text": "奏でる音色を聞くだけでわかりますわ。\n彼女は一流の演奏者ですわよ……！", "face": "u774"}, {"name": "トネール", "text": "ついでに戦士としても一流とお見受けするよ。", "face": "u1885a1"}, {"name": "リーナ", "text": "き、気をつけてください！\n彼女の演奏は仲間たちを……\n無法者たちの攻撃力を、大きく上げる効果があります！", "face": "u521"}, {"name": "無法者", "text": "ギャギャー！　チカラ、ミナギル！！\nアネゴ、オンガク！　パワー、スゴイ！！", "face": "la95d08f8202c"}, {"name": "トネール", "text": "面白いねぇ！\nアタシも腕が鳴るってもんさ！", "face": "u1885a1"}, {"name": "プロエ", "text": "双方、準備はいいみたいだな。\nでは僭越ながら、開始の宣言をさせてもらおう。", "face": "u1768a1"}, {"name": "プロエ", "text": "人類最強決定戦・開拓地の部。\nこれより決勝戦を――開始する！！", "face": "u1768a1"}]}, {"trigger": "end", "lines": [{"name": "トネール", "text": "勝負あり、だね。", "face": "u1885a1"}, {"name": "プロエ", "text": "ああ――そこまで！\n優勝者は、王国の王子！！", "face": "u1768a1"}, {"name": "アンナ", "text": "やりましたね、王子！"}, {"name": "リーナ", "text": "それで、吟遊詩人のゴブリンさんは……\nギ、ギターで不服そうな音を鳴らしています……。", "face": "u521"}, {"name": "王妃人", "text": "けれど、それだけじゃありませんわ。\n文句は言いたそうですけど、彼女の奏でる音は、\n私たちの勝利を祝うようでもありますもの。", "face": "u774"}, {"name": "アンナ", "text": "これで、この町の無法者たちは、\n全員退治できたのでしょうか。"}, {"name": "トネール", "text": "そうだな。これで一件落着！\n……なんだけどさ。", "face": "u1885a1"}, {"name": "トネール", "text": "なぁ、王子サマ。\nよかったら、この町を王国の庇護下にいれてくれないか？", "face": "u1885a1"}, {"name": "アンナ", "text": "それはできると思いますけど、いいんですか？"}, {"name": "トネール", "text": "ああ。アンタたちなら信頼できる。\nそれに、ちゃんとした人が管理してないと、\nこの町は危なすぎるからねぇ。", "face": "u1885a1"}, {"name": "アンナ", "text": "それはまぁ……町の人々の有様を思うと、\n不安はありますね。", "face": "la91db6d5e5fa"}, {"name": "麗しき銀銃", "text": "そうなると、この町は今日から、\n「王子タウン」となるわけですね。", "face": "l848747214be8"}, {"name": "皆殺しの凶銃", "text": "恐れ多いがダセェと言わざるを得ねェよ。\n保安官殿もその名前はないと仰ってるぜェ。", "face": "lc5a890fab8c1"}, {"name": "トネール", "text": "なんでアンタたちがいるのさ。", "face": "u1885a1"}, {"name": "皆殺しの凶銃", "text": "優勝を祝いにきたに決まってんだろ。\nおらッ、浴びられるくらいの酒もってきたぞォ！", "face": "lc5a890fab8c1"}, {"name": "麗しき銀銃", "text": "やりました。宴の始まりですね！\n王子様の優勝と町の新たな門出を祝って、\n今日はみんなでドンチャン騒ぎましょう！", "face": "l848747214be8"}, {"name": "リーナ", "text": "あっ、吟遊詩人さんが、賑やかな音楽を、\n演奏してくれています……！", "face": "u521"}, {"name": "トネール", "text": "まぁ、なんだ……。\nとにかく、ありがとう。", "face": "u1885a1"}, {"name": "トネール", "text": "色々と大変な町だけど、\nこれからよろしく頼んだぜ。", "face": "u1885a1"}]}], "active": true}