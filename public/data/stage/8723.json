{"quest_id": 8723, "name": "第十陣 新たなオークロード", "description": "新たなオークロードは帝国法に則り、\n正々堂々と白の皇帝に決闘を挑む。\n＜白の皇帝の出撃時の初期HP減少：小＞\n神級（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["白の皇帝の出撃時の初期HP減少：小"], "event": "帝国十陣", "event_category": "Empire", "mission_id": 940010, "map_no": 9435, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [20], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 400000, "attack": 6000, "base_hp": 400000, "base_attack": 6000, "damage_type": "physical", "armor_defense": 1750, "magic_defense": 25, "attack_speed": 40, "attack_wait": 60, "attack_interval": 229, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2164816, "race_id": 8, "change_to": 1, "change_condition": 3, "master_id": 39245, "global_id": 12862, "to_condition": 3, "to_global_id": 12863, "spawn_sec": 47}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 400000, "attack": 4500, "base_hp": 400000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 1750, "magic_defense": 25, "attack_range": 180, "attack_speed": 1, "attack_wait": 35, "attack_interval": 131, "move_speed": 1100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2164832, "race_id": 8, "special_effect_id": 232, "missile_id": 45, "master_id": 39246, "global_id": 12863, "ranged": true, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 8, "form_index": 0, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102224, 