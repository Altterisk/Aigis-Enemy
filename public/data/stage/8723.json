 "global_id": 5394}], "spawn_sec": 239}, {"enemy_id": 22, "source": "local", "count": 12, "form_index": 0, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103376, "race_id": 8, "change_to": 22, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 442, "global_id": 441, "ranged": true, "to_condition": 3, "to_global_id": 442, "spawn_sec": 253}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 443, "global_id": 442, "ranged": true, "from_condition": 3}, {"enemy_id": 24, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 30000, "attack": 3000, "base_hp": 30000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 30, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106464, "race_id": 8, "change_to": 24, "change_condition": 3, "master_id": 31744, "global_id": 5363, "to_condition": 3, "to_global_id": 5364, "spawn_sec": 274}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 3000, "base_hp": 30000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 30, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106480, "race_id": 8, "master_id": 31745, "global_id": 5364, "from_condition": 3}], "popups": ["\n\n\n\n――帝国領内、オーク居留地にて", "二代目オークロードは\nHPが50％以下になると\n移動速度が上昇し、\n遠距離攻撃を行うようになります。", "オークシールダーは\n味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nブロックされている間、\n引き付けの効果を失います。\n　　　　　　(1/2)", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n\n\n\n　　　　　　(2/2)", "オーク旗手が持つ\n敵の攻撃と防御アップの能力は、\nオーク旗手の数に応じて効果が\n重複します。"], "dialogue": [{"trigger": "battle", "at_sec": 48, "lines": [{"text": "――帝国領内、オーク居留地にて"}, {"name": "オークロード", "text": "…………ッ。", "face": "l40a05db4d614"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "アスバール", "text": "（あの、王子？\n最初から臨戦態勢じゃないですか？）", "face": "u1668a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アスバール", "text": "（……もしや、他に何か気になることが？）", "face": "u1668a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "白の皇帝", "text": "……ここへ来るに際し、\nまず最初に斬りかかられると思っていたが。", "face": "u418"}, {"name": "オークロード", "text": "皇帝、貴様は先代が認めた男だ。\n刃を交えるのなら、正々堂々であるべきだろう。", "face": "l40a05db4d614"}, {"name": "白の皇帝", "text": "オークの流儀を甘く見ていたのは、俺の方だったようだ。\nその刃と誇りに対し、謝罪しよう。", "face": "u418"}, {"name": "白の皇帝", "text": "――新たなオークロードよ。\n白の帝国に望むことはあるか。", "face": "u418"}, {"name": "オークロード", "text": "……何も望まん。\nこれまでどおり、オレたちは戦いに生き続けるのみだ。", "face": "l40a05db4d614"}, {"name": "オークロード", "text": "だが――", "face": "l40a05db4d614"}, {"name": "白の皇帝", "text": "…………？", "face": "u418"}, {"name": "オークロード", "text": "戦いに流儀があるように、\n国に法があることも、理解している。", "face": "l40a05db4d614"}, {"name": "オークロード", "text": "白の皇帝、貴様の首はオレが叩き落とす。\n……帝国法に則り、正々堂々と、決闘の場で、だ。", "face": "l40a05db4d614"}, {"name": "白の皇帝", "text": "……ああ。\nいつでも待っている。", "face": "u418"}, {"name": "白の皇帝", "text": "そのために、オークの部族には\n現在の居留地を――正式に領地として与え……。\n族長たるオークロードには……爵位を……。", "face": "u418"}, {"name": "オークロード", "text": "…………？\nどうした、白の皇帝。覇気がないぞ。", "face": "l40a05db4d614"}, {"name": "レオナ", "text": "…………陛下？", "face": "u2600a1"}, {"name": "白の皇帝", "text": "……いや、問題ない。", "face": "u418"}, {"name": "オークロード", "text": "フム……まぁいい。\nならば、さっそく最初の決闘をさせてもらおう。", "face": "l40a05db4d614"}, {"name": "オークロード", "text": "誇り高く散った先代に、この戦いを捧げる！\nオークの戦士たちよ、オレに続けェ！！", "face": "l40a05db4d614"}, {"name": "オーク", "text": "うおおおおおッ！　ロード！！\nうおおおおおッ！！　我らがオークロード！！", "face": "l63166045e5e7"}, {"name": "ハイオーク", "text": "うおおおおおッ！　ロード！！\nうおおおおおッ！！　誇り高きオークロード！！", "face": "l7bf980320ebd"}]}, {"trigger": "end", "lines": [{"name": "白の皇帝", "text": "…………なぜ剣を収めた。", "face": "u418"}, {"name": "オークロード", "text": "貴様の様子がおかしいからだ。\n疲労、負傷……いや、呪いの類か？", "face": "l40a05db4d614"}, {"name": "オークロード", "text": "万全の状態でない貴様に勝っても、\nそれはオレたちが望む誇りある勝利ではない。", "face": "l40a05db4d614"}, {"name": "オークロード", "text": "我が部族は、常に笑えと教えられる。\n笑いながら攻め込み、退くときも堂々と笑いながら、\nそして死ぬときも、全ての戦いに満足して笑って逝く。", "face": "l40a05db4d614"}, {"name": "オークロード", "text": "皇帝、貴様との心躍る戦いを、\n死に際に誇りとして思い出せる戦いを望む。\n今日の勝負は、預けておくぞ。", "face": "l40a05db4d614"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "レオナ", "text": "陛下、いったい何が……。", "face": "u2600a1"}, {"name": "ジュディス", "text": "陛下、失礼します。\n――っ、な、なんですかこれ。\n大変です、すごい高熱が……！", "face": "u2089a1"}, {"name": "白の皇帝", "text": "……問題ない。", "face": "u418"}, {"name": "ジュディス", "text": "問題だらけですよ！\nエレオノーラ様、この近くにアダマス教会は――", "face": "u2089a1"}, {"name": "エレオノーラ", "text": "森を抜けてすぐに、戦乱で今は使われていない神殿が。", "face": "u799"}, {"name": "ジュディス", "text": "誰か！　すぐに担架を！", "face": "u2089a1"}, {"name": "白の皇帝", "text": "……自分で歩ける。", "face": "u418"}, {"name": "王子", "text": "…………（ふんす）", "face": "u1"}, {"name": "白の皇帝", "text": "……王子、肩など貸して、どういうつもりだ。", "face": "u418"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ジュディス", "text": "うぅー、医官の言うことはきかないのに。\nすみません王子殿下、陛下をお願いします。", "face": "u2089a1"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 9, "params": [20], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 20, "params": [130]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 600000, "attack": 9000, "damage_type": "physical", "armor_defense": 1750, "magic_defense": 25, "pattern_id": 2164816}, {"enemy_id": 1, "form_index": 1, "hp": 600000, "attack": 4500, "damage_type": "physical", "armor_defense": 1750, "magic_defense": 25, "pattern_id": 2164832}, {"enemy_id": 3, "form_index": 0, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102224}, {"enemy_id": 3, "form_index": 1, "hp": 6000, "attack": 900, "damage_type": "physical", "armor_defense": 450, "pattern_id": 2102240}, {"enemy_id": 5, "form_index": 0, "hp": 27000, "attack": 1200, "damage_type": "physical", "armor_defense": 500, "pattern_id": 2102672}, {"enemy_id": 5, "form_index": 1, "hp": 27000, "attack": 2400, "damage_type": "physical", "armor_defense": 700, "pattern_id": 2102688}, {"enemy_id": 7, "form_index": 0, "hp": 6750, "attack": 450, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 50, "pattern_id": 2118848}, {"enemy_id": 9, "form_index": 0, "hp": 1350, "attack": 150, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2106496}, {"enemy_id": 9, "form_index": 1, "hp": 1350, "attack": 150, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2106512}, {"enemy_id": 11, "form_index": 0, "hp": 37500, "attack": 3750, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "pattern_id": 2102928}, {"enemy_id": 11, "form_index": 1, "hp": 37500, "attack": 3750, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "pattern_id": 2102944}, {"enemy_id": 13, "form_index": 0, "hp": 30000, "attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "pattern_id": 2105088}, {"enemy_id": 14, "form_index": 0, "hp": 4500, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102544}, {"enemy_id": 14, "form_index"