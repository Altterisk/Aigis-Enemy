": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 1248, "change_to": 12, "master_id": 35856, "global_id": 9473, "to_global_id": 9474}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 275, "change_to": 13, "master_id": 35857, "global_id": 9474}, {"enemy_id": 23, "source": "local", "count": 32, "form_count": 1, "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "attack_range": 160, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142800, "race_id": 16, "change_to": 23, "change_condition": 1, "missile_id": 26, "master_id": 35837, "global_id": 9454, "ranged": true, "variants": [{"hp": 4000, "attack": 450, "base_hp": 4000, "base_attack": 450, "damage_type": "physical", "armor_defense": 250, "attack_speed": 70, "attack_wait": 60, "attack_interval": 231, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142816, "race_id": 16, "master_id": 35838, "global_id": 9455}], "spawn_sec": 5}, {"enemy_id": 25, "source": "local", "count": 28, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142784, "race_id": 16, "missile_id": 831, "missile": {"speed": 4.0, "splash": 133}, "master_id": 35836, "global_id": 9453, "ranged": true, "spawn_sec": 40}, {"enemy_id": 26, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 550, "base_hp": 6000, "base_attack": 550, "damage_type": "magical", "armor_defense": 350, "magic_defense": 5, "attack_speed": 80, "attack_wait": 60, "attack_interval": 249, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142832, "race_id": 16, "master_id": 35839, "global_id": 9456, "spawn_sec": 71}], "dialogue": [{"trigger": "start", "lines": [{"name": "フェイロン", "text": "――王国軍本隊と合流させるな！\n仙人があちらについているとはいえ、\nこちらには天の声が味方している！", "face": "u1720a1"}, {"name": "太公望", "text": "おや、もう回り込んで来ましたか。\n――それで、天の声とは何者なのです？", "face": "u603"}, {"name": "フェイロン", "text": "太公望……！\nあなたに教える義理はありませんよ！", "face": "u1720a1"}, {"name": "太公望", "text": "亜神ディアス……亜神ヒュープ……。\nいえ、彼らが華の国に手を伸ばす理由がない。", "face": "u603"}, {"name": "太公望", "text": "ならば他の存在……。\n魔界や冥界、あるいはオリュンポスの――", "face": "u603"}, {"name": "フェイロン", "text": "知ったことか！\n兵よ聞け、仙人を人と思うな！　多数で圧殺しろ！", "face": "u1720a1"}, {"name": "清源妙道真君", "text": "太公望、敵をからかう悪い癖が出ていますよ。", "face": "u866"}, {"name": "太公望", "text": "おや、それは自己紹介ですか？", "face": "u603"}, {"name": "清源妙道真君", "text": "……お互い様ということで。\n――王子殿！　敵は騎兵を出しています！\n兵の陣形には注意を！", "face": "u866"}]}, {"trigger": "end", "lines": [{"name": "フェイロン", "text": "やはり王国は手強い、か。\nふざけた連中だが、その練度が段違いだ。", "face": "u1720a1"}, {"name": "フェイロン", "text": "魔王を倒し、今や世界を救わんとするだけある。\nしかし、こちらにも祖国の未来がかかっているんだ。", "face": "u1720a1"}, {"name": "フェイロン", "text": "攻撃の手を休めるな！\n地の利はこちらにある！", "face": "u1720a1"}, {"name": "マオ", "text": "うわぁぁああぁ！？\nあっちからも新手が！\nまた囲まれちゃいそうですよ！？", "face": "u361"}, {"name": "メイリン", "text": "あっち！　あの路地は大丈夫だよ！\n先行したナタク様たちが押さえてくれてる！", "face": "u380"}, {"name": "マオ", "text": "はぁぁぁ……。\nどうしてこんなことにぃ……！？", "face": "u361"}, {"name": "メイリン", "text": "金光聖菩さんを渡さないって、\n断言しちゃったからかなぁ……？", "face": "u380"}, {"name": "マオ", "text": "……でも、うん、間違ってないですよね。\nあの人はもう、私たちの仲間ですから。", "face": "u361"}, {"name": "リン", "text": "そのとおり！\n仲間を絶対見捨てない、王子がそんな人だから、\n安心して最前線で戦えるんだから！", "face": "u122"}, {"name": "ナタク", "text": "ようやく来た！\nみんな、こっち！　橋の前まで抜けるよ！", "face": "u297"}, {"name": "メイリン", "text": "もう少し、みんな頑張ろ！！", "face": "u380"}]}], "active": true}