{"quest_id": 4161, "name": "さまよう亡魂", "description": "少女を追い触手の妖魔が巣食う魔の毒沼へ。\n死霊術でさらに強さを増す亡者に注意せよ！\n＜毒：HPに継続ダメージ＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["毒：HPに継続ダメージ"], "event": "死者の王の娘", "event_category": "History", "mission_id": 920030, "map_no": 3861, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 5, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "hp": 5500, "attack": 10, "base_hp": 5500, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_speed": 30, "attack_interval": 61, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098352, "special_effect_id": 220, "master_id": 23, "global_id": 22, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 2000, "attack": 320, "base_hp": 2000, "base_attack": 320, "damage_type": "physical", "armor_defense": 140, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 150.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104160, "master_id": 746, "global_id": 745, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 400, "base_hp": 12000, "base_attack": 400, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 90, "attack_wait": 50, "attack_interval": 165, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104176, "race_id": 16, "special_effect_id": 568, "missile_id": 6, "master_id": 502, "global_id": 501, "ranged": true, "spawn_sec": 10}, {"enemy_id": 4, "source": "local", "count": 20, "form_count": 1, "tags": ["アンデッド"], "hp": 1500, "attack": 250, "base_hp": 1500, "base_attack": 250, "damage_type": "physical", "armor_defense": 80, "attack_range": 10, "attack_speed": 60, "attack_wait": 30, "attack_interval": 101, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104144, "missile_id": 45, "master_id": 20184, "global_id": 1259, "ranged": true, "spawn_sec": 13}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 102}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "やっと追いつきましたよ。\n……メメントさん、あなた人間ですね。\n戦っていると分かります。", "face": "l90b84180c4f9"}, {"name": "アンナ", "text": "なぜ魔物の手先になっているんですか？", "face": "l90b84180c4f9"}, {"name": "メメント", "text": "ふーん。さすがは、ってところだね。\nいいよ。教えてあげる。", "face": "u195"}, {"name": "メメント", "text": "人間の中にはさ。力を求めて\n自らの体に魔を受けいれるものがいる。", "face": "u195"}, {"name": "メメント", "text": "死者の王もその一人なんだよ。\n死霊魔術を極め、より大きな力を手に入れるため\n魔物に成り果てた男。", "face": "u195"}, {"name": "メメント", "text": "……ボクの父さ。", "face": "u195"}, {"name": "アンナ", "text": "父親の命令で私達を襲撃したというわけですか。", "face": "l90b84180c4f9"}, {"name": "メメント", "text": "そうだよ。\n偉大なる死霊魔術師である死者の王の娘として\nあなた達を倒さなきゃならない。", "face": "u195"}, {"name": "メメント", "text": "そろそろ本気で行くよ。", "face": "u195"}, {"name": "メメント", "text": "さあ亡者達よ。\nボク達の恐ろしさを見せてやるんだ！", "face": "u195"}, {"name": "メメント", "text": "ふふふ、気をつけてね。\nボクの死霊魔術で強化された亡者たちは\n手ごわいから。", "face": "u195"}, {"name": "アンナ", "text": "気をつけてください。\nあのネクロマンサーが戦場にいる間は\n亡者たちが強化されるようです。", "face": "l90b84180c4f9"}, {"name": "アンナ", "text": "油断されぬよう！", "face": "l90b84180c4f9"}]}, {"trigger": "end", "lines": [{"name": "メメント", "text": "どうやら、ボクの力じゃ\nあなた達に勝てないみたいだ。", "face": "u195"}, {"name": "メメント", "text": "こうなったらお父様のお力にすがるしかないかな……。", "face": "u195"}, {"name": "メメント", "text": "死者の王に立ち向かう勇気があるんなら、\nボクを追ってきたらいい。", "face": "u195"}, {"name": "ケイティ", "text": "……どうにも彼女はまだ本気で\n戦っていないように思えます。", "face": "u114"}, {"name": "ケイティ", "text": "何かたくらんでいるかもしれません。\n罠の可能性もあります。\nお気をつけて。", "face": "u114"}]}], "active": true}