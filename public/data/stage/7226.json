{"quest_id": 7226, "name": "あやかし大決戦～おんせん編～", "description": "妖狸と妖狐、古来より相容れぬ妖の二派が\n温泉宿にてついに雌雄を決する……。\n狐を討つべく狸が変化した姿とは……？\n神級（★１獲得の目安：平均Lv50）", "event": "王国おんせん繁盛記", "event_category": "History", "mission_id": 920154, "map_no": 5852, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 18, "form_count": 1, "tags": ["温泉"], "hp": 6000, "attack": 580, "base_hp": 6000, "base_attack": 580, "damage_type": "physical", "armor_defense": 110, "attack_range": 180, "attack_speed": 30, "attack_wait": 30, "attack_interval": 91, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126832, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 33331, "global_id": 6948, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "magical", "armor_defense": 100, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101024, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 310, "global_id": 309, "ranged": true, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 38, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "change_to": 3, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 33328, "global_id": 6945, "to_global_id": 6946, "route_behaviour": {"transforms": [{"wait": 40}]}, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 6000, "attack": 580, "base_hp": 6000, "base_attack": 580, "damage_type": "physical", "armor_defense": 110, "attack_speed": 30, "attack_wait": 30, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119744, "race_id": 4, "special_effect_id": 415, "change_to": 4, "master_id": 33329, "global_id": 6946, "to_global_id": 6947}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["ステルス"], "hp": 6000, "attack": 580, "base_hp": 6000, "base_attack": 580, "damage_type": "physical", "armor_defense": 110, "attack_speed": 30, "attack_wait": 30, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "master_id": 33330, "global_id": 6947, "to_global_id": 6948}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["温泉"], "hp": 6000, "attack": 580, "base_hp": 6000, "base_attack": 580, "damage_type": "physical", "armor_defense": 110, "attack_range": 180, "attack_speed": 30, "attack_wait": 30, "attack_interval": 91, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126832, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 33331, "global_id": 6948, "ranged": true}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 450, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 36, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104352, "race_id": 16, "special_effect_id": 222, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 30394, "global_id": 4013, "ranged": true, "spawn_sec": 64}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 400, "base_hp": 25000, "base_attack": 400, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107248, "race_id": 4, "special_effect_id": 103, "master_id": 526, "global_id": 525, "spawn_sec": 93}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 300, "base_hp": 20000, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107232, "race_id": 4, "special_effect_id": 102, "missile_id": 169, "missile": {"speed": 15.0}, "master_id": 32260, "global_id": 5879, "ranged": true, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "ヤシマ", "text": "――とうとう、この日が来たぽんね。", "face": "u1019a1"}, {"name": "カヨウ", "text": "王国の皆の手前、\n仲良しこよしを演じてはおったが……。", "face": "u325"}, {"name": "スズネ", "text": "あたし様たちは妖怪！\nそして因縁尽きないたぬきときつねですぽん！", "face": "u936"}, {"name": "イナリ", "text": "ふふ……もとから、きつねとたぬきが\n手を取り合っている方が無理だったんだよ。", "face": "u243"}, {"name": "ヤシマ", "text": "互いに人を化かすあやかし。\n先祖代々の縄張り争いは烈火の如しぽん。", "face": "u1019a1"}, {"name": "カヨウ", "text": "王国という安住の地を得たとて、\n千年の遺恨は中々に消えぬものゆえなぁ。", "face": "u325"}, {"name": "スズネ", "text": "――でも、さすがに本気で争ったら\n王子さまに迷惑かけちゃいますぽん。", "face": "u936"}, {"name": "イナリ", "text": "王子に迷惑はかけたくないしね。\nうーん、じゃあ今日の化け化けあやかし大決戦は\nどんな内容にしようかー？", "face": "u243"}, {"name": "ヤシマ", "text": "ぽぽん♪\nもちろん化け合戦に決まっているぽん♪", "face": "u1019a1"}, {"name": "カヨウ", "text": "ふむ……やけに自信がありそうよな。\n何か隠し玉があるとでも？", "face": "u325"}, {"name": "スズネ", "text": "――ふふん、化け合戦の審判といえば王子さま。\nそして王子さまを悩殺するにはどうしたらいいのか？\nあたし様たちは温泉に浸かりながら考えましたぽん。", "face": "u936"}, {"name": "ヤシマ", "text": "ぽかぽか温泉……最高だったぽん……。\nそしてその結果、温泉の思い出を\n鮮やかに蘇らせる、このヘンゲを獲得したぽん……！！", "face": "u1019a1"}, {"name": "カヨウ", "text": "なっ……その、その姿は……っ！！", "face": "u325"}]}, {"trigger": "start", "lines": [{"name": "ソーマ", "text": "……ということがあったらしいんですけど！\nどうして妖狸さんたち、\nみんな私に変身しているんですかぁ！", "face": "u23"}, {"name": "ヤシマ", "text": "ぽぽん、若女将してるソーマちゃんが\nあまりに可愛すぎて、\nずーっと見つめちゃってたからだぽん？", "face": "u1019a1"}, {"name": "スズネ", "text": "頑張る若女将、かーっこよかったですぽーん♪", "face": "u936"}, {"name": "ソーマ", "text": "うぅぅぅ～！\nだからって、バスタオル姿は恥ずかしすぎます～！", "face": "u23"}, {"name": "ソーマ", "text": "王子、一緒にみんなを止めてください！\n急いで！　迅速に！　できるだけ早く～！！", "face": "u23"}]}, {"trigger": "end", "lines": [{"name": "ヤシマ", "text": "……むぅー、今回の化け化けあやかし大決戦は――", "face": "u1019a1"}, {"name": "カヨウ", "text": "――王子に止められたので引き分け、よな。", "face": "u325"}, {"name": "イナリ", "text": "王子に止められちゃ仕方ないよねー。", "face": "u243"}, {"name": "ソーマ", "text": "……皆さん、喧嘩していたにしては、\nずいぶんあっさりと手を引くんですね？", "face": "u23"}, {"name": "スズネ", "text": "あはは……実はそんなに\n仲が悪いというわけでもないんですぽん。", "face": "u936"}, {"name": "スズネ", "text": "人を化かして生きるあやかし。\nそんなあり方がゆえに、衝突することはありますぽん。", "face": "u936"}, {"name": "イナリ", "text": "でも、それで争ってたら\n両方の種族が滅んじゃうからね。", "face": "u243"}, {"name": "ソーマ", "text": "あっ……妖怪の皆さんは、\n人の畏れが必要なんでしたよね……。", "face": "u23"}, {"name": "ヤシマ", "text": "ふふっ、そういうわけで今日は、\nソーマちゃんの畏れをいただいたぽーん♪", "face": "u1019a1"}, {"name": "ソーマ", "text": "……えっ？", "face": "u23"}, {"name": "ヤシマ", "text": "それじゃあお腹も膨れたことだし、\nこの後は一緒に温泉でもいかがぽん？", "face": "u1019a1"}, {"name": "カヨウ", "text": "ほう、それはよい。\n件の温泉宿に遊びに行くとしようかのう。", "face": "u325"}, {"name": "イナリ", "text": "王子も連れて行こ。\n夜遅くまで報告書を片付けてたし、癒やしてあげよー。", "face": "u243"}, {"name": "スズネ", "text": "ふふっ、ソーマちゃんも一緒に来ますかぽーん？", "face": "u936"}, {"name": "ソーマ", "text": "い、行きません！\n――あっ、で、でもちょっと行きたいような……。\nってみなさーん！　まってくださーい！！", "face": "u23"}]}], "story_talk": true, "active": true}