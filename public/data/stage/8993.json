{"quest_id": 8993, "name": "サブマリンレイダース 初級", "description": "・深海：攻撃後の時間増加、一定時間で継続ダメージ\n・コストの自然回復/ＥＸＰ/ゴールド/ドロップなし\n・ライフが０でもミッションクリア", "event": "サブマリンレイダース", "event_category": "Subjugation", "mission_id": 400573, "map_no": 9370, "level": 50, "multiplier": 0.5, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 6, 30], "ext": "攻撃待ち増加=30,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}, {"kind": "term", "influence": 17}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "機械", "ブロック不可", "狙う", "水中"], "hp": 8000, "attack": 100, "base_hp": 16000, "base_attack": 100, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 20, "attack_range": 200, "attack_speed": 200, "attack_wait": 55, "attack_interval": 161, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2161392, "race_id": 9, "missile_id": 26, "master_id": 22641, "global_id": 2924, "ranged": true, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag(1, 1);\");", "sets_flags": [[1, 1]], "on_destroy": true}}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "tags": ["機械", "ブロック不可", "置物"], "fixture": true, "hp": 2500, "attack": 150, "base_hp": 5000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 122, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2161904, "special_effect_id": 2122, "change_to": 2, "master_id": 22647, "global_id": 2930, "route_behaviour": {"reroutes": ["Route=999"]}}, {"enemy_id": 4, "source": "local", "count": 41, "form_count": 1, "tags": ["水中"], "hp": 500, "attack": 75, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 50, "attack_wait": 10, "attack_interval": 121, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2161344, "race_id": 9, "missile_id": 1297, "missile": {"speed": 10.0}, "master_id": 22634, "global_id": 2917}, {"enemy_id": 5, "source": "local", "count": 21, "form_count": 1, "hp": 1250, "attack": 125, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "spawn_sec": 22}, {"enemy_id": 6, "source": "local", "count": 28, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 525, "attack": 200, "base_hp": 1050, "base_attack": 200, "damage_type": "physical", "armor_defense": 60, "magic_defense": 10, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123712, "race_id": 7, "special_effect_id": 229, "missile_id": 232, "master_id": 32688, "global_id": 6306, "ranged": true, "spawn_sec": 114}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 5000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "master_id": 348, "global_id": 347, "spawn_sec": 192}, {"enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "tags": ["水中"], "hp": 1000, "attack": 100, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "attack_speed": 50, "attack_wait": 10, "attack_interval": 121, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2161360, "race_id": 9, "missile_id": 1297, "missile": {"speed": 10.0}, "master_id": 22635, "global_id": 2918, "spawn_sec": 192}], "popups": ["ゴブリン博士お手製機雷は倒されると\n自身の周囲にダメージを与えます。\n\nまた、ゴブリン博士お手製機雷は\n撃破数に含まれません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴィアベル", "text": "――そろそろ海底に到達するわ。", "face": "u1247a1"}, {"name": "キュステ", "text": "あっ、ゴブリン軍団が集まってますよ。\n遺跡かなにかに群がってるみたいですね？", "face": "u1248a1"}, {"name": "イヴリール", "text": "いや……あれは遺跡じゃない。沈没船だ。", "face": "u1959a1"}, {"name": "リーンベル", "text": "沈没船……？\nここ数年、この海域での沈没報告は受けていないぞ？", "face": "u268"}, {"name": "イヴリール", "text": "それも当然だ。\nあの船の様式、おそらく戦乱の時代のものだろう。", "face": "u1959a1"}, {"name": "ヴィアベル", "text": "そんな船に、ゴブリン軍団がいったい何の用事で――", "face": "u1247a1"}, {"name": "ゴブリン博士", "text": "クックック。\nコレだけの財宝がアレバ！\nメカゴブリンクイーン様に最高のプレゼントを……！", "face": "l2bdcef4785ee"}, {"name": "ヴィアベル", "text": "…………。", "face": "u1247a1"}, {"name": "ゴブリン博士", "text": "黄金の首飾り……イヤ、\n光り輝く全身像……ッ！！\nイヤイヤイヤ、ココはモウ、黄金の指輪ヲ……！！", "face": "l2bdcef4785ee"}, {"name": "リーンベル", "text": "…………。", "face": "u268"}, {"name": "ゴブリン博士", "text": "フフッ、フフフッ……。\n夢が無限に広がル……！！", "face": "l2bdcef4785ee"}, {"name": "キュステ", "text": "見逃してあげていいんじゃないですか？", "face": "u1248a1"}, {"name": "アンナ", "text": "そういうわけにも……。\nあれが沈没船なら、まずは調査が優先です。", "face": "l3e7b18ff46b6"}, {"name": "リーンベル", "text": "それにここは王国領海内だ。\n好き勝手に盗掘させていたら、国家の主権に関わる。", "face": "u268"}, {"name": "イヴリール", "text": "難しい理屈付けは終わったか？", "face": "u1959a1"}, {"name": "リーンベル", "text": "えぇ。あとは存分に。", "face": "u268"}, {"name": "イヴリール", "text": "やれやれ。\n財宝なんてのは、昔から勝ったやつの総取りだろう？\n向こうがそれを望んでいるんだ、乗ってやれ。", "face": "u1959a1"}, {"name": "ゴブリン博士", "text": "なっ……王子ィ！？\nナゼここに！？", "face": "l2bdcef4785ee"}, {"name": "王子", "text": "…………（ふんす）", "face": "u1"}, {"name": "ゴブリン博士", "text": "くぅぅっ、盗掘がバレたノカ！？\n仕方ナイ！\n相手が王子と言えド、ココは譲れヌ！", "face": "l2bdcef4785ee"}, {"name": "アンナ", "text": "王子、ゴブリン軍団が来ます！\n指揮をお願いします！", "face": "l3e7b18ff46b6"}]}, {"trigger": "end", "lines": [{"name": "イヴリール", "text": "――で、反省したか？", "face": "u1959a1"}, {"name": "ゴブリン博士", "text": "グヌヌヌ……。", "face": "l2bdcef4785ee"}, {"name": "リーンベル", "text": "せっかく沈没船を発見したんだから、\n焦らず王国に報告すれば良かったんだ。", "face": "u268"}, {"name": "リーンベル", "text": "合同調査だって可能だし、\n発見者として取り分の要求だってできただろうに。", "face": "u268"}, {"name": "ゴブリン博士", "text": "ムッ……そ、そうナノカ……？", "face": "l2bdcef4785ee"}, {"name": "アンナ", "text": "王国法にも類似の記述がありますし、\n王子だって駄目とは言わないかと……。"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "サブリナ", "text": "それに、これ戦乱の時代の商船っぽいし？\n発掘調査するなら、\nゴブリン軍団の技術も借りたいよね。", "face": "u332"}, {"name": "ゴブリン博士", "text": "おぉ、おぉ！\nソウイウことなら！　全力で協力スルゾ！！", "face": "l2bdcef4785ee"}, {"name": "ゴブリン博士", "text": "メカゴブリンクイーン様！\nステキな贈り物、待っていてクダサレー！！", "face": "l2bdcef4785ee"}, {"name": "アンナ", "text": "丸く……収まったということで？\nともあれ、王子、お疲れ様でした！"}]}], "active": true}