erval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 89}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 40, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105776, "race_id": 16, "master_id": 718, "global_id": 717, "spawn_sec": 89}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンクイーン", "text": "ウフフ……そんなにたくさん穴を掘って\n今度はいったい何をしようっていうのかしら？", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "ここには空き家が多く散在しています。\n朽ちた家と家の地面を穴で繋げ、\n王子達を奇襲することが可能となります。", "face": "u354"}, {"name": "ゴブリン", "text": "キシュウ！　キシュウ！", "face": "le4066ac1ed12"}, {"name": "ヘレナ", "text": "遠距離攻撃部隊が\n敵を引き付けて予定地点まで引き込めば、\n王子たちを一網打尽にできるでしょう。", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "素晴らしい戦略じゃない。\nさすがは天才戦術家さんだことぉ。それじゃあ\nここもアナタに任せて私はお暇するわぁ。", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "………………行ったか。\nいつまでもこの私を支配できると思うなよ……。", "face": "u354"}]}, {"trigger": "start", "lines": [{"name": "へクター", "text": "前方にゴブリン達の姿を確認！", "face": "u74"}, {"name": "ユリアン", "text": "何とか追いつくことができたようだな。\nだが警戒を怠るなよ、王子？\n奴らはきっと何かを用意しているはずだ……。", "face": "u7"}, {"name": "アンナ", "text": "敵、陣形を展開！\nやはり不穏な動きをしているようです……。\n王子、臨戦態勢をとってください！", "face": "l8dd7136e7a40"}]}, {"trigger": "end", "lines": [{"name": "ヘレナ", "text": "(今回の戦で、予感は確信に変わった。\n時は……満ちたということね。)", "face": "u354"}, {"name": "へクター", "text": "敵、撤退していきます！\n現状での追撃は……困難かと思われます。", "face": "u74"}, {"name": "ラセル", "text": "見事な退却だな……。\n追撃する暇すら与えず、考え得る最善の\n経路と瞬間を選び、兵士を逃がすとは……。", "face": "u3"}, {"name": "アンナ", "text": "敵の戦略は徐々にその多彩さを増していますね。\nより困難な闘いが待っているのは明白です。\n王子、気を引き締めていきましょう！", "face": "l8dd7136e7a40"}]}], "active": true}