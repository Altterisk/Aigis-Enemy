 533, "from_condition": 0}, {"enemy_id": 8, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 89}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 40, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105776, "race_id": 16, "master_id": 718, "global_id": 717, "spawn_sec": 89}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンクイーン", "text": "ウフフ……そんなにたくさん穴を掘って\n今度はいったい何をしようっていうのかしら？", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "ここには空き家が多く散在しています。\n朽ちた家と家の地面を穴で繋げ、\n王子達を奇襲することが可能となります。", "face": "u354"}, {"name": "ゴブリン", "text": "キシュウ！　キシュウ！", "face": "le4066ac1ed12"}, {"name": "ヘレナ", "text": "遠距離攻撃部隊が\n敵を引き付けて予定地点まで引き込めば、\n王子たちを一網打尽にできるでしょう。", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "素晴らしい戦略じゃない。\nさすがは天才戦術家さんだことぉ。それじゃあ\nここもアナタに任せて私はお暇するわぁ。", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "………………行ったか。\nいつまでもこの私を支配できると思うなよ……。", "face": "u354"}]}, {"trigger": "start", "lines": [{"name": "へクター", "text": "前方にゴブリン達の姿を確認！", "face": "u74"}, {"name": "ユリアン", "text": "何とか追いつくことができたようだな。\nだが警戒を怠るなよ、王子？\n奴らはきっと何かを用意しているはずだ……。", "face": "u7"}, {"name": "アンナ", "text": "敵、陣形を展開！\nやはり不穏な動きをしているようです……。\n王子、臨戦態勢をとってください！", "face": "la0e94353615f"}]}, {"trigger": "end", "lines": [{"name": "ヘレナ", "text": "(今回の戦で、予感は確信に変わった。\n時は……満ちたということね。)", "face": "u354"}, {"name": "へクター", "text": "敵、撤退していきます！\n現状での追撃は……困難かと思われます。", "face": "u74"}, {"name": "ラセル", "text": "見事な退却だな……。\n追撃する暇すら与えず、考え得る最善の\n経路と瞬間を選び、兵士を逃がすとは……。", "face": "u3"}, {"name": "アンナ", "text": "敵の戦略は徐々にその多彩さを増していますね。\nより困難な闘いが待っているのは明白です。\n王子、気を引き締めていきましょう！", "face": "la0e94353615f"}]}], "map": {"image": "Map920065_3181", "w": 960, "h": 640, "spots": [{"k": "b", "x": 30, "y": 437}, {"k": "m", "x": 158, "y": 187, "id": 200}, {"k": "m", "x": 270, "y": 198, "id": 201}, {"k": "m", "x": 403, "y": 211, "id": 202}, {"k": "m", "x": 475, "y": 186, "id": 203}, {"k": "m", "x": 561, "y": 122, "id": 204}, {"k": "m", "x": 648, "y": 88, "id": 205}, {"k": "m", "x": 463, "y": 285, "id": 206}, {"k": "m", "x": 239, "y": 392, "id": 207}, {"k": "m", "x": 348, "y": 384, "id": 208}, {"k": "m", "x": 448, "y": 360, "id": 209}, {"k": "m", "x": 546, "y": 308, "id": 210}, {"k": "m", "x": 655, "y": 265, "id": 211}, {"k": "m", "x": 751, "y": 246, "id": 212}, {"k": "m", "x": 114, "y": 390, "id": 213}, {"k": "r", "x": 589, "y": 48, "id": 300}, {"k": "r", "x": 393, "y": 146, "id": 301}, {"k": "r", "x": 175, "y": 129, "id": 302}, {"k": "r", "x": 129, "y": 243, "id": 303}, {"k": "r", "x": 571, "y": 177, "id": 304}, {"k": "r", "x": 545, "y": 230, "id": 305}, {"k": "r", "x": 436, "y": 432, "id": 306}, {"k": "r", "x": 293, "y": 456, "id": 307}, {"k": "r", "x": 165, "y": 445, "id": 308}, {"k": "r", "x": 784, "y": 312, "id": 309}]}, "start_cost": 10, "active": true, "name_en": "Genius Firepower Tactics", "description_en": "Beware of concentrated fire from bows and magic at range, and suppress the enemy!\nIntermediate (★1 target: Avg Lv1, 8 enemies)"}