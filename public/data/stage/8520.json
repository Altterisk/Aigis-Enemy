{"quest_id": 8520, "name": "第九陣 戦士の魂", "description": "かつて冥界軍の将として、帝国を苦しめた\n二人の戦士がタルタロスの影響で姿を現す。\n＜冥界：HPに継続ダメージ＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["冥界：HPに継続ダメージ"], "event": "帝国九陣", "event_category": "Empire", "mission_id": 940009, "map_no": 9323, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 20]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 70000, "attack": 1200, "base_hp": 70000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 210, "attack_speed": 1, "attack_wait": 45, "attack_interval": 149, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130816, "special_effect_id": 904, "change_to": 1, "missile_id": 599, "missile": {"speed": 9.0}, "master_id": 38672, "global_id": 12289, "ranged": true, "to_global_id": 12290, "commands": {"raw": "CallEvent(2139,2140,2141,2142,2143,2144,2145);"}, "route_behaviour": {"transforms": [{"wait": 300}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 70000, "attack": 600, "base_hp": 70000, "base_attack": 600, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 210, "attack_speed": 1, "attack_wait": 270, "attack_interval": 961, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130832, "special_effect_id": 905, "missile_id": 600, "missile": {"speed": 17.0}, "master_id": 38673, "global_id": 12290, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 108000, "attack": 2400, "base_hp": 108000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 35, "attack_range": 300, "attack_speed": 66, "attack_wait": 50, "attack_inte