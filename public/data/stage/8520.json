mage_type": "physical", "armor_defense": 100, "attack_speed": 30, "attack_wait": 10, "attack_interval": 87, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2138560, "race_id": 13, "change_to": 5, "change_condition": 2, "master_id": 35092, "global_id": 8709, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 39}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 2, "tags": ["アンデッド"], "hp": 3500, "base_hp": 3500, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_interval": 50, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142464, "special_effect_id": 1179, "change_to": 5, "change_condition": 2, "master_id": 35805, "global_id": 9422, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 78}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "hp": 23000, "attack": 700, "base_hp": 23000, "base_attack": 700, "damage_type": "magical", "armor_defense": 200, "attack_range": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 71, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138576, "race_id": 13, "special_effect_id": 216, "change_to": 5, "change_condition": 2, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 35093, "global_id": 8710, "ranged": true, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 90}], "dialogue": [{"trigger": "start", "lines": [{"name": "カルペム", "text": "……タルタロスの門まで、あと少しよ。", "face": "u2401a1"}, {"name": "トットン", "text": "この手みたいなの、\nいったい何なんでしょうね……。", "face": "u2405a1"}, {"name": "ヘカティエ", "text": "手よ。", "face": "u1226a1"}, {"name": "トットン", "text": "ひぃーっ！？", "face": "u2405a1"}, {"name": "ヘカティエ", "text": "タルタロスの魔力を浴びた霊魂が、\n苦しみ、手を伸ばし、そのまま物質化したのね。", "face": "u1226a1"}, {"name": "トットン", "text": "鎮魂歌とか、演奏します……？", "face": "u2405a1"}, {"name": "ティルト", "text": "そうしてやりたいところだが、\n今は、先にあいつらを何とかしないと。", "face": "u1705a1"}]}, {"trigger": "enemy_death", "enemy_id": 1, "lines": [{"name": "イルヴィ", "text": "父上、父上……！\nああ……どうして、こんな……。", "face": "u1918a1"}, {"name": "ヘカティエ", "text": "イルヴィ、それは霊魂が\nタルタロスの魔力で暴走しているだけよ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "語りかけても返事は――", "face": "u1226a1"}, {"name": "セグナンド", "text": "…………イル、ヴィ。", "face": "l20ac59a2a223"}, {"name": "ヘカティエ", "text": "…………！", "face": "u1226a1"}, {"name": "セグナンド", "text": "強く、なれ……。\n何にも、穢されない……強き、花に……。", "face": "l20ac59a2a223"}, {"name": "イルヴィ", "text": "はい……父上……！", "face": "u1918a1"}]}, {"trigger": "enemy_death", "enemy_id": 3, "lines": [{"name": "オークロード", "text": "――なんだ、もう死んだのか？\n我が死をもたらした戦士、白の皇帝。", "face": "l7abef6f2023c"}, {"name": "白の皇帝", "text": "ふざけたことを。\n俺は、貴様を倒した男だぞ。", "face": "u418"}, {"name": "オークロード", "text": "ハハハッ、違いない！", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "……王の顔に、なったな。", "face": "l7abef6f2023c"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "オークロード", "text": "白の皇帝よ、以前、ある騎士にこんなことを言われた。\n――死ぬために戦うな、と。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "皇帝よ、白の皇帝よ、\n民のために死ぬな、己のために、その命を使え。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "お前を信じる民は、\nお前の信念に、必ずついてきてくれる。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "それが……我らが宿敵、白の帝国というものだ。", "face": "l7abef6f2023c"}, {"name": "白の皇帝", "text": "…………ああ。", "face": "u418"}]}, {"trigger": "battle", "at_sec": 9, "lines": [{"name": "ハイデマリー", "text": "あれは……まさか……。", "face": "u1704a1"}, {"name": "オークロード", "text": "…………。", "face": "l7abef6f2023c"}, {"name": "セグナンド", "text": "…………。", "face": "l20ac59a2a223"}, {"name": "イルヴィ", "text": "ちち、うえ……？", "face": "u1918a1"}, {"name": "白の皇帝", "text": "タルタロスの魔力を浴びたか、\nオークロード、セグナンド。", "face": "u418"}, {"name": "レオナ", "text": "陛下……。", "face": "u311"}, {"name": "白の皇帝", "text": "今、楽にしてやる。\n戦い抜いた戦士の魂を穢すことなど、\n誰であろうと、赦されることではない。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "白の皇帝", "text": "…………先へ進むぞ。", "face": "u418"}, {"name": "ティルト", "text": "ヘカティエ様、これが、\n亜神ハイドースの望む世界ですか……？", "face": "u1705a1"}, {"name": "ティルト", "text": "全ての生命を殺し、\n冥界にて永劫の安寧を得る……それは理解できます。", "face": "u1705a1"}, {"name": "ティルト", "text": "ですが、そのためにタルタロスを使えば、\n安寧どころか……無限の苦しみだけが……。", "face": "u1705a1"}, {"name": "ヘカティエ", "text": "……もう、それすら分からないのかもしれないわ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "生きる理由を、戦う理由をなくした彼を、\n今も突き動かしているのは……。", "face": "u1226a1"}, {"name": "ティルト", "text": "恨み、ですか？", "face": "u1705a1"}, {"name": "ヘカティエ", "text": "……どうでしょうね。\nもう、そんな感情すら残っていないかもしれないわ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "行きましょう。\nこの先に、待っているはずよ。", "face": "u1226a1"}, {"name": "白の皇帝", "text": "ああ。ここを決戦の地としよう。", "face": "u418"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 20]}, {"kind": "term", "influence": 19, "params": [150]}], "enemies": [{"enemy_id": 1, "hp": 105000, "attack": 1200, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "pattern_id": 2130816}, {"enemy_id": 1, "form_index": 1, "hp": 105000, "attack": 600, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "pattern_id": 2130832}, {"enemy_id": 3, "hp": 162000, "attack": 2400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 35, "pattern_id": 2142384}, {"enemy_id": 5, "hp": 6000, "attack": 1125, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2159904}, {"enemy_id": 5, "form_index": 1, "hp": 9750, "attack": 2, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 7, "hp": 3000, "attack": 675, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 8, "hp": 5250, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2142464}, {"enemy_id": 9, "hp": 34500, "attack": 700, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2138576}]}, "active": true}