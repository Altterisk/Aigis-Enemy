pawn_sec": 103}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099584, "race_id": 16, "special_effect_id": 222, "missile_id": 57, "missile": {"speed": 12.0}, "master_id": 179, "global_id": 178, "ranged": true, "spawn_sec": 125}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "base_hp": 8000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117456, "race_id": 16, "special_effect_id": 348, "master_id": 31511, "global_id": 5130, "spawn_sec": 127}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 900, "base_hp": 12000, "base_attack": 900, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105072, "race_id": 16, "special_effect_id": 121, "master_id": 30071, "global_id": 3690, "spawn_sec": 128}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 30000, "attack": 1300, "base_hp": 30000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 900, "magic_defense": 55, "attack_speed": 2, "attack_wait": 8, "attack_interval": 49, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117440, "race_id": 6, "special_effect_id": 121, "change_to": 11, "change_condition": 2, "master_id": 31512, "global_id": 5131, "spawn_sec": 128}], "popups": ["ソフィーは倒されると、\nその場で一度だけ復活します。", "マーニーがいる間は\n全ての敵ユニットの\n攻撃力がアップし、\n防御力が大幅にアップします。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "サバル", "text": "――にゃっはっは。\n王子に最初にチョコを渡す権利は、\nこのサバル様がもらっていくぞ！", "face": "u536"}, {"name": "セブン", "text": "こらっ！　抜け駆けするんじゃねぇ！！\nこっちが先に渡すって言っただろ！？", "face": "u449"}, {"name": "メメント", "text": "抜け駆けはそっちの方じゃない？\n王子にチョコスケルトンをけしかけるのは、\nボクの方が先なんだからね？", "face": "u195"}, {"name": "メトゥス", "text": "ふふっ、メメントとの合作だけれど、\n今回のチョコスケルトンは本当に素敵な出来なのよ？\nきっとダーリンも喜んでくれるわ。", "face": "u329"}, {"name": "リタ", "text": "……何の騒ぎですか、これは。\nせっかくお昼寝していたのに、\n目が覚めてしまいました。", "face": "u1178"}, {"name": "リーフ", "text": "もう、神殿の中まで\n皆さんの騒ぎ声が聞こえてきましたよ？", "face": "u747"}, {"name": "マーニー", "text": "きゃっ！？\nちょ、チョコで出来たスケルトンが歩いてますよ！？\nいったいどういう原理なんでしょうか……。", "face": "u745"}, {"name": "リリア", "text": "あはは……すみません大騒ぎしていて。\nさっきまでは普通のお茶会だったんですけどね……。", "face": "u1020"}, {"name": "シビラ", "text": "誰が一番最初に王子にチョコを渡すのか、\nそんな口論から、\nあの追いかけっこが始まってしまったの。", "face": "u1039"}, {"name": "ソフィー", "text": "……な、なるほど、そんな争いが。\n順番に仲良く渡すという選択肢は――", "face": "u1746"}, {"name": "サバル", "text": "にゃははっ、ないない！\n全ての財宝も、王子へのチョコ一番乗りも、\nこのサバルさまに決まっているのさー！", "face": "u536"}, {"name": "セブン", "text": "このぉ……っ！！\nあんたたちもぼーっとしてると、\nバレンタインの王子、独り占めしちゃうからなー！", "face": "u449"}, {"name": "リーフ", "text": "えぇっ！？　そ、それは困ります！！\nボクだって王子さんにチョコあげたいのに！\n皆さん、急いで追いかけましょう！？", "face": "u747"}, {"name": "アンナ", "text": "……おや？　た、大変です王子！\n向こうからすごい勢いで皆さんがやってきます！\nと、とにかく一度落ち着いてもらいましょう！", "face": "l307fe93ca6aa"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "……いきなり何事かと思えば、\n誰が一番にチョコを渡すかの競争だったのですか。", "face": "la55ec44fcf48"}, {"name": "サバル", "text": "にゃはは……全員まとめて返り討ちとは。\nさすがは王子ってところかな？", "face": "u536"}, {"name": "メメント", "text": "うぅ、今回のチョコスケルトンは\nすっごい力作だったのになぁ……。", "face": "u195"}, {"name": "ソフィー", "text": "（魔物の型のチョコは、さすがに王子も\n困ってしまうのではないでしょうか……）", "face": "u746"}, {"name": "リリア", "text": "（でも本人たちが楽しそうなので……。\nこれはこれでアリではないでしょうか……？）", "face": "u20"}, {"name": "マーニー", "text": "うぅぅ……勢いに流されてしまいました……。\nあっ、王子の服にもチョコが……っ！", "face": "u745"}, {"name": "リーフ", "text": "えぇっ！？　ご、ごめんなさい王子さん！\n急いで洗わないと……あわわわっ！\nそうだ、ボクがお洗濯します！　さぁ王子さん！", "face": "u747"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "セブン", "text": "……あっ、リーフが抜け駆けした！？\nリーフ！　こら待てー！！", "face": "u449"}, {"name": "リーフ", "text": "待ちませーん！\nバレンタインは戦争なんですよー！！", "face": "u747"}, {"name": "リーフ", "text": "それじゃあ王子さん、一緒に行きましょう♪", "face": "u747"}]}], "story_talk": true, "active": true}