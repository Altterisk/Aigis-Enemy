"attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "spawn_sec": 87}, {"enemy_id": 4, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 1750, "attack": 250, "base_hp": 1750, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 87, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123776, "race_id": 7, "missile_id": 45, "master_id": 32692, "global_id": 6310, "ranged": true, "spawn_sec": 92}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104832, "race_id": 7, "change_to": 2, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 576, "global_id": 575, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 576, "spawn_sec": 162}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "from_condition": 4, "trigger_ticks": 1}], "popups": ["　　　　【深海の水圧】\n・味方の攻撃後の待ち時間が増加\n・ユニット配置後、一定時間経過で\n　継続ダメージが発生\n\n※これらは、風水使いなどがもつ\n　地形効果を軽減する能力では\n　軽減できません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "モニカ", "text": "――へぇぇぇ！　ここが海の底なんだぁ！", "face": "u87"}, {"name": "アネリア", "text": "いつも眺めてた海の下が、\nこんなふうになっていたなんて驚きね！", "face": "u184"}, {"name": "アウローラ", "text": "さすがに、海に慣れている子たちは違いますね。\nもうこの風景を楽しんでいるなんて。\n私からすれば、呼吸ができることの方が驚きですけど。", "face": "u1035a1"}, {"name": "人魚の大使", "text": "ふふふ、私も地上の風景には\nびっくりしましたけどね？\nうぅ、早く陸地をお散歩したいです……。", "face": "u1118a1"}, {"name": "ローザ", "text": "今回の事件を見事解決すれば、\nきっとクラールフ殿も\n地上へ行くのを許してくれますよ。", "face": "u1040a1"}, {"name": "人魚の大使", "text": "でっすよね！\nよぉし、クラールフ様の海底神殿はこちらです！\nさぁさぁお早くー！　――って、あれ？", "face": "u1118a1"}, {"name": "ローザ", "text": "どうかしましたか？\n……おや？　向こうに何か見えたような。", "face": "u1040a1"}, {"name": "人魚の大使", "text": "えぇと、向こうから武器を構えて向かってくるの、\n私の街の衛兵さんたちなんですけど……。\n何だか様子がおかしいような……。", "face": "u1118a1"}, {"name": "衛兵マーマン", "text": "……海巫女殿、この溺れる民たちは、\nあなたが案内した王国の者に相違ないか？", "face": "l25a1785c88ad"}, {"name": "人魚の大使", "text": "えっ、えーっとぉ……？\nそうですけど……クラールフ様から聞いてませんか？", "face": "u1118a1"}, {"name": "衛兵マーマン", "text": "……くっ……そうか、クラールフ様が\n溺れる民に助けを求めたというのは本当だったのか。", "face": "l25a1785c88ad"}, {"name": "衛兵マーマン", "text": "我らだけでは、あの傷ありのシャークギルマンに\n勝てないと判断されたと、そういうことなのだな……。\nなれば……王子よ！　我らにその実力を見せてくれ！", "face": "l25a1785c88ad"}, {"name": "人魚の大使", "text": "えぇっ！？　今はそんなこと\n言ってる場合じゃないですよ！\nシャークギルマンが攻めてくるんですよ！？", "face": "u1118a1"}, {"name": "衛兵マーマン", "text": "……海巫女殿には分からないかもしれない。\nだが、これは戦士の誇りをかけた決闘なのだ。", "face": "l25a1785c88ad"}, {"name": "衛兵マーマン", "text": "水中を自在に泳ぐ我ら魚人が勝つか、\n乾いた地の人間たちが勝つか、それをもって\n王子たちを信じるかどうか決めさせてもらおう。", "face": "l25a1785c88ad"}, {"name": "人魚の大使", "text": "わわわ……どうしましょうどうしましょう！\n王子様、水中での戦いは初めてですよね！？", "face": "u1118a1"}, {"name": "人魚の大使", "text": "ここは水の中ですから、『水圧』で地上の方々は、\n少しずつ体力を削られてしまうと思います。\nそれから動きも遅くなりますので、ご注意ください！", "face": "u1118a1"}]}, {"trigger": "end", "lines": [{"name": "衛兵マーマン", "text": "……くっ……我らの負けだ、乾いた地の王子よ。\nいや、英雄王の名を継ぐ、次代の英雄よ。", "face": "l25a1785c88ad"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "衛兵マーマン", "text": "……なぜ手を差し出す。\nいったい何のつもりだ、王子よ。", "face": "l25a1785c88ad"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ローザ", "text": "おそらく、仲間を助けるためにここに来た、\nと言っているのではないかと……。", "face": "u1040a1"}, {"name": "衛兵マーマン", "text": "……そうか、我らを仲間と呼ぶのか。\n乾いた地の者たちが、お前の後に\n続いた理由が分かったような気がするな。", "face": "l25a1785c88ad"}, {"name": "衛兵マーマン", "text": "良かろう。\nクラールフ様は神殿の奥だ。我らが案内し――", "face": "l25a1785c88ad"}, {"name": "セノーテ", "text": "――あ、あのっ！　ちょっと待ってください！\n何だか水がざわめいていて……。\n大群がこっちに向かってる気配がします！", "face": "u502"}, {"name": "人魚の大使", "text": "大群……？　まさかシャークギルマンの部隊が！？", "face": "u1118a1"}, {"name": "スカー", "text": "――シャァァァァァァック！！\n大・正・解・だァ！！\n人間の王子ィ、今度は水中で喧嘩と行こうぜェ！！", "face": "u1396a1"}]}], "map": {"image": "Map920147_5715", "w": 960, "h": 640, "spots": [{"k": "b", "x": 10, "y": 140}, {"k": "b", "x": 8, "y": 476}, {"k": "m", "x": 108, "y": 159, "id": 200}, {"k": "m", "x": 120, "y": 451, "id": 201}, {"k": "m", "x": 225, "y": 437, "id": 202}, {"k": "m", "x": 206, "y": 169, "id": 203}, {"k": "m", "x": 177, "y": 314, "id": 204}, {"k": "m", "x": 325, "y": 173, "id": 205}, {"k": "m", "x": 466, "y": 395, "id": 206}, {"k": "m", "x": 401, "y": 105, "id": 207}, {"k": "m", "x": 517, "y": 96, "id": 208}, {"k": "m", "x": 414, "y": 272, "id": 209}, {"k": "m", "x": 637, "y": 116, "id": 210}, {"k": "m", "x": 713, "y": 206, "id": 211}, {"k": "m", "x": 734, "y": 304, "id": 212}, {"k": "m", "x": 346, "y": 423, "id": 213}, {"k": "m", "x": 862, "y": 312, "id": 214}, {"k": "m", "x": 853, "y": 432, "id": 215}, {"k": "m", "x": 746, "y": 515, "id": 216}, {"k": "m", "x": 589, "y": 490, "id": 217}, {"k": "m", "x": 598, "y": 336, "id": 218}, {"k": "r", "x": 429, "y": 159, "id": 300}, {"k": "r", "x": 918, "y": 378, "id": 301}, {"k": "r", "x": 597, "y": 421, "id": 302}, {"k": "r", "x": 659, "y": 267, "id": 303}, {"k": "r", "x": 136, "y": 205, "id": 304}, {"k": "r", "x": 289, "y": 390, "id": 305}, {"k": "r", "x": 196, "y": 486, "id": 306}, {"k": "r", "x": 333, "y": 250, "id": 307}], "events": [{"t": 0, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "InTheSea", "x": 480, "y": 320}]}, {"t": 26.9, "when": "time", "ops": [{"op": "+fx", "name": "obj_01", "fx": "Bubble1", "x": 761, "y": 263}]}, {"t": 27.9, "when": "time", "ops": [{"op": "+fx", "name": "obj_03", "fx": "Bubble3", "x": 440, "y": 348}]}, {"t": 28.9, "when": "time", "ops": [{"op": "+fx", "name": "obj_02", "fx": "Bubble2", "x": 554, "y": 110}]}]}, "start_cost": 10, "active": true}