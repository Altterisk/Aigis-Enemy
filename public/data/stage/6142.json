{"quest_id": 6142, "name": "暴風の洞窟", "description": "欠片が隠された洞窟にて、\n風霊達が王子に迫る。\n刃の如き風を鎮圧せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "風神の娘", "event_category": "History", "mission_id": 920091, "map_no": 3983, "level": 100, "multiplier": 1.0, "charisma": 50, "exp": 280, "gold": 1200, "drops": [{"item": 5003, "c": 2}, {"card": 129, "c": 1}, {"card": 135, "c": 1}, {"card": 215, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "level": 80, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 150, "base_hp": 10000, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 80, "attack_speed": 25, "attack_interval": 19, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109536, "special_effect_id": 169, "missile_id": 45, "master_id": 30322, "global_id": 3941, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 21, "form_index": 0, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 21}, {"enemy_id": 3, "source": "local", "count": 2, "level": 80, "form_index": 0, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "special_effect_id": 222, "master_id": 30324, "global_id": 3943, "spawn_sec": 77}, {"enemy_id": 4, "source": "local", "count": 7, "level": 80, "form_index": 0, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 78}, {"enemy_id": 5, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 162}], "popups": ["エアーエレメンタルは\nブロックする事ができません。\n近接ユニットを配置しても\nすり抜けていきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フーコ", "text": "ここが……定風珠を……\n隠したどうく……うぷっ。", "face": "u493"}, {"name": "アンナ", "text": "大丈夫ですか、フーコさん。", "face": "lefe7d7c5c587"}, {"name": "フーコ", "text": "へ、へーき………………\nじゃない……かも……うっ。", "face": "u493"}, {"name": "ケイティ", "text": "……まさか船酔いされてしまうとは。\n雲に乗ってる方が揺れそうなものですが。", "face": "u114"}, {"name": "バシラ", "text": "まぁ慣れない乗り物じゃしょうがないですよ。\nそれよりも、早く定風珠の欠片を探しましょう！", "face": "u28"}, {"name": "フーコ", "text": "こ、この辺りは……定風珠の欠片の影響で、\nエアーエレメンタルが発生……しやすい……から\n気をつけ……………………。", "face": "u493"}, {"name": "バシラ", "text": "エアーエレメンタル？　……ダメですね、\n完全に伸びてしまっています。", "face": "u28"}, {"name": "バルバストラフ", "text": "エレメンタルとは珍しいのう。害意があるものでもないし、\n本来そっとしておくべきじゃが……定風珠の欠片を\n探すとなれば、無視というのは難しいじゃろうな。", "face": "u63"}, {"name": "サイラス", "text": "エアーエレメンタルは周囲を切り裂く風を纏っている。\nそれに、奴らの実体を捕まえるのは困難だ。", "face": "u13"}, {"name": "バルバストラフ", "text": "接近して捕らえて倒すのは難しいじゃろうな。\n遠距離から核を撃ち抜き倒すのが賢明じゃ。", "face": "u63"}, {"name": "アンナ", "text": "ご忠告ありがとうございます。\n王子、指示をお願いします！", "face": "lefe7d7c5c587"}]}, {"trigger": "end", "lines": [{"name": "バルバストラフ", "text": "あれ程大量のエレメンタルが発生するとはの。", "face": "u63"}, {"name": "サイラス", "text": "定風珠の欠片の力か……興味深いものだ。", "face": "u13"}, {"name": "バシラ", "text": "王子、先ほど倒した妖怪達が\n欠片を落としていきましたよ！", "face": "u28"}, {"name": "ケイティ", "text": "長い時を経て、妖怪達の\n手に渡った欠片もあるようですね。", "face": "u114"}, {"name": "アンナ", "text": "はい、フーコさんの為にも、\n一刻も早く欠片を集めねばなりませんね。\n引き続き辺りを捜索致しましょう。", "face": "lefe7d7c5c587"}]}], "map": {"image": "Map920091_3983", "w": 960, "h": 640, "spots": [{"k": "b", "x": 226, "y": 79}, {"k": "b", "x": 580, "y": 65}, {"k": "m", "x": 145, "y": 308, "id": 200}, {"k": "m", "x": 145, "y": 403, "id": 201}, {"k": "m", "x": 259, "y": 399, "id": 202}, {"k": "m", "x": 259, "y": 307, "id": 203}, {"k": "m", "x": 791, "y": 314, "id": 204}, {"k": "m", "x": 796, "y": 410, "id": 205}, {"k": "m", "x": 367, "y": 403, "id": 206}, {"k": "m", "x": 371, "y": 305, "id": 207}, {"k": "m", "x": 489, "y": 306, "id": 208}, {"k": "m", "x": 478, "y": 402, "id": 209}, {"k": "m", "x": 691, "y": 410, "id": 210}, {"k": "m", "x": 694, "y": 316, "id": 211}, {"k": "m", "x": 499, "y": 231, "id": 212}, {"k": "m", "x": 597, "y": 231, "id": 213}, {"k": "m", "x": 404, "y": 229, "id": 214}, {"k": "m", "x": 590, "y": 307, "id": 215}, {"k": "m", "x": 583, "y": 402, "id": 216}, {"k": "m", "x": 556, "y": 178, "id": 217}, {"k": "r", "x": 140, "y": 495, "id": 300}, {"k": "r", "x": 242, "y": 494, "id": 301}, {"k": "r", "x": 352, "y": 488, "id": 302}, {"k": "r", "x": 459, "y": 468, "id": 303}, {"k": "r", "x": 584, "y": 483, "id": 304}, {"k": "r", "x": 666, "y": 243, "id": 305}, {"k": "r", "x": 740, "y": 258, "id": 306}, {"k": "r", "x": 234, "y": 224, "id": 307}, {"k": "r", "x": 333, "y": 223, "id": 308}, {"k": "r", "x": 443, "y": 183, "id": 309}, {"k": "r", "x": 698, "y": 521, "id": 310}, {"k": "r", "x": 143, "y": 226, "id": 311}, {"k": "r", "x": 829, "y": 490, "id": 312}, {"k": "r", "x": 455, "y": 116, "id": 313}]}, "start_cost": 10, "active": true, "name_en": "Cave of the Storm", "descript