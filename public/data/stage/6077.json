st": 1000, "pattern_id": 2108000, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 962, "global_id": 961, "ranged": true, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 15, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 5}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 35}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 100, "attack_speed": 180, "attack_wait": 60, "attack_interval": 181, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 961, "global_id": 960, "ranged": true, "spawn_sec": 80}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_range": 40, "attack_speed": 60, "attack_wait": 180, "attack_interval": 426, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108816, "race_id": 4, "special_effect_id": 229, "missile_id": 45, "master_id": 30106, "global_id": 3725, "ranged": true, "spawn_sec": 117}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 5, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 121}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "コヨミ", "text": "――鬼門が三つも……確かに変ねぇ～。", "face": "u471"}, {"name": "ミコト", "text": "はい、恐らく自然に発生したものではないかと思います。\nコヨミさんなら、何か心当たりがあったりしませんか？", "face": "u130"}, {"name": "コヨミ", "text": "そうねぇ。以前、陰陽寮の術士総出で鬼門を\n封じた事もあったわ。その時は東方の者じゃない、\n別の国の術士が鬼門を開いてたみたいよ。", "face": "u471"}, {"name": "コヨミ", "text": "あの時の仲間がいれば詳しく判りそうだけど、\n都の襲撃で陰陽寮の仲間はもう……ね。あ、でも\n鬼門なら私の霊符で封じれるから安心してちょうだい！", "face": "u471"}, {"name": "アンナ", "text": "……辛い事を思い出させてしまいすみません。\n鬼門の封印、頼りにさせて頂きますね。", "face": "l3b3c87d123dd"}, {"name": "カスミ", "text": "……。", "face": "u470"}, {"name": "バシラ", "text": "あれ？　あそこにいるのは先ほどの\nカスミさん……と呼ばれてた娘ではないでしょうか。", "face": "u28"}, {"name": "コヨミ", "text": "変ねぇ。いつもなら畏れを集めたら\nしばらくは村にはこないんだけど。\n畏れが足りなかったのかしら……。", "face": "u471"}, {"name": "コヨミ", "text": "仕方ないわね。ごめんなさいみんな、\nまた少しあの子の相手をしてあげてくれないかしら。", "face": "u471"}]}, {"trigger": "start", "lines": [{"name": "バシラ", "text": "変ですね～？　カスミさんの姿が\nどこにも見当たりませんが……", "face": "u28"}, {"name": "コヨミ", "text": "危ない！　王子、伏せてっ！！", "face": "u471"}, {"name": "王子", "text": "……！", "face": "u1"}, {"name": "カスミ", "text": "……。", "face": "u470"}, {"name": "バシラ", "text": "い、いつの間に王子の後ろに！\nそれに今、本気で首をはねようと……\n……！？", "face": "u28"}, {"name": "コヨミ", "text": "あの娘、姿を消す事ができたのね。", "face": "u471"}, {"name": "ミコト", "text": "気配もなく、姿を消して近づく妖怪……\nぬらりひょんと性質が似ていますね。", "face": "u130"}, {"name": "バシラ", "text": "近づかれるまで姿が見えないんじゃ\n弓で狙いようがないですぅ……。", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "カスミ", "text": "――っ！　あら？　ここは……。", "face": "u470"}, {"name": "コヨミ", "text": "良かったぁ～。目を覚ましたみたいね。", "face": "u471"}, {"name": "バシラ", "text": "大丈夫ですか！", "face": "u28"}, {"name": "カスミ", "text": "あれ？　陰陽師のお姉さんと……猫娘さん……？\nあ、畏れでしたら余ってますのでもし宜しければ……。", "face": "u470"}, {"name": "バシラ", "text": "いりません！　この間違われ方、\nなんだかどこかで……。", "face": "u28"}, {"name": "コヨミ", "text": "ねえアナタ。なんだかいつもと\n様子が違ったけれど……何かあったの？", "face": "u471"}, {"name": "カスミ", "text": "それが、畏れを集め帰ってる途中だったのですが\n帽子を被った方に話しかけられて……\n……すみません、そこから先の記憶はあまり。", "face": "u470"}, {"name": "？？？", "text": "――ごくろうだったネェ、妖怪娘。\n気配を消せるオマエが、首尾よく結界を\n破壊してくれたおかげでようやく村に入り込めたヨ。", "face": "l5bcbcdce7bdd"}, {"name": "ケイティ", "text": "……！　何者です！？", "face": "u114"}, {"name": "妖天君", "text": "ボクは華の国の仙人、十天君が一人、\n妖天君。酒呑童子の気配が消えたから、\n今度はボクがこの国をまとめちゃおうと思ってネ。", "face": "l5bcbcdce7bdd"}, {"name": "コヨミ", "text": "華の国の仙人……この国をまとめる……！？\nあのさ、ボク？　\n悪戯も程ほどにしないと大変な事になるわよ！", "face": "u471"}, {"name": "コヨミ", "text": "あと、結界を破壊したですって！？\n村全体に術を施すの、どれだけ\n面倒だと思ってるの！？", "face": "u471"}, {"name": "ケイティ", "text": "コヨミさん、不用意に近づいては……！", "face": "u114"}, {"name": "妖天君", "text": "自分から近づいてくるとは\n手間が省けたネェ！　ほいっ！", "face": "l5bcbcdce7bdd"}, {"name": "コヨミ", "text": "う……ああ……陰の気が、\n体に………………。", "face": "u471"}, {"name": "妖天君", "text": "ククッ！　さぁて、これで鬼門を封じる厄介な\n陰陽師は手中に落ちタ。ついでにそこの連中も\n始末しておくかねぇ……ほほいっ！", "face": "l5bcbcdce7bdd"}, {"name": "アンナ", "text": "そんな！　辺り一帯に鬼門が！？", "face": "lca2c86f2c187"}, {"name": "妖天君", "text": "さぁ陰陽師、ついてくるヨ……この地上を、\n鬼門で埋め尽くしてやるネェ！", "face": "l5bcbcdce7bdd"}]}], "active": true}