rce": "local", "count": 6, "form_count": 1, "tags": ["式神"], "hp": 6000, "attack": 350, "base_hp": 6000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 220, "attack_speed": 1, "attack_wait": 30, "attack_interval": 117, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 1000, "pattern_id": 2170096, "race_id": 4, "special_effect_id": 54, "missile_id": 1590, "missile": {"speed": 4.0, "slow": [50, 80], "on_hit": {"kind": "攻撃遅延", "duration_f": 240, "attack_interval_f": 120, "effect_name": "HitEffectSlow"}}, "master_id": 41034, "ranged": true, "spawn_sec": 119}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 97, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2120464, "race_id": 16, "special_effect_id": 436, "master_id": 41040, "spawn_sec": 258}, {"enemy_id": 10, "source": "local", "count": 12, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 104, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2170048, "race_id": 16, "special_effect_id": 2409, "master_id": 41039, "route_behaviour": {"force_dead": true}, "spawn_sec": 261}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 102, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2172176, "change_to": 11, "master_id": 41037, "route_behaviour": {"transforms": [{}], "sets_flags": [[100, 1, 0]]}, "spawn_sec": 273}], "popups": ["下級陰陽師から攻撃を\n受けると「呪毒」状態になり、\n一定時間継続ダメージを受けます。\n\n呪毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。", "えんえんらから攻撃を受けると、\n攻撃後の待ち時間が増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シズカ", "text": "遠からん者は音に聞け！　近くば寄って目に物を見よ！", "face": "u101"}, {"name": "シズカ", "text": "我こそは先代国主が一人娘、シズカなり！\n武名惜しまぬ者、功を望む者はかかって参れ！\nいざ、我が首取って生涯の手柄とせよッ！", "face": "u101"}, {"name": "近衛兵", "text": "先代国主の娘って……。", "face": "l040cea8008c4"}, {"name": "陰陽師", "text": "知ってるぞ、姫侍だ！", "face": "l17ba454a069a"}, {"name": "ヨシノ", "text": "シズカ、何のつもりだ！", "face": "u1104a1"}, {"name": "シズカ", "text": "私が殿を務める。その隙に離脱しなさい。", "face": "u101"}, {"name": "ヨシノ", "text": "……また、全部押し付ける気か。", "face": "u1104a1"}, {"name": "シズカ", "text": "これは単純な比較の問題よ。\nどちらを生かした方が得なのか、\n自分の器の程度は知ってるもの。", "face": "u101"}, {"name": "ヨシノ", "text": "君は先代の娘だぞ。", "face": "u1104a1"}, {"name": "シズカ", "text": "生き方を教わる前に死んじゃったのよ、あの人。", "face": "u101"}, {"name": "シズカ", "text": "結局ね、私の器は侍大将止まり。\n前線に立つ以外に能のない武骨者よ。\nそれに比べてあなたは政をよく学んでる。", "face": "u101"}, {"name": "ヨシノ", "text": "誰のために学んだと思ってる！！", "face": "u1104a1"}, {"name": "近衛兵", "text": "──妖怪に与する逆賊を殺せ！", "face": "l040cea8008c4"}, {"name": "陰陽師", "text": "式神を出す、俺に続け──", "face": "l17ba454a069a"}, {"name": "シズカ", "text": "ぬるいわっ！！", "face": "u101"}, {"name": "陰陽師", "text": "ひぃいいいいっ！？", "face": "l17ba454a069a"}, {"name": "シズカ", "text": "今まで武家の盾に隠れていたうらなり風情が、\n帝の権勢を笠に着た途端に強者面とは笑止千万！", "face": "u101"}, {"name": "シズカ", "text": "これより先、我が身は修羅道に入る！\n鬼を斬る覚悟もなければさっさと去ね！", "face": "u101"}, {"name": "近衛兵", "text": "…………っ。", "face": "l040cea8008c4"}, {"name": "ノリモチ", "text": "シズカ……。", "face": "u2881a1"}, {"name": "チヨメ", "text": "包囲を抜けます、急いで！！", "face": "u1144a1"}, {"name": "ヨシノ", "text": "ふざけるなよ……おい、ふざけるな！　おいっ！", "face": "u1104a1"}, {"name": "ヨシノ", "text": "説教なら死んだ後に聞くわよ、行きなさい！", "face": "u1104a1"}]}, {"trigger": "battle", "at_sec": 258, "lines": [{"name": "近衛兵", "text": "──覚悟ッ！", "face": "l040cea8008c4"}, {"name": "シズカ", "text": "それが必要なのは貴様の方だ。", "face": "u101"}, {"name": "近衛兵", "text": "ぐっ──！？", "face": "l040cea8008c4"}, {"name": "シズカ", "text": "てんで駄目ね、公家の人材不足は深刻かしら。", "face": "u101"}, {"name": "ノリモチ", "text": "シズカ、お前……。", "face": "u2881a1"}, {"name": "ドウマン", "text": "キシシ、見事なものよなぁ。", "face": "l134bb0de0456"}, {"name": "ノリモチ", "text": "ドウマン様！？　どうしてこちらに！", "face": "u2881a1"}, {"name": "ドウマン", "text": "兵部卿、儂はヨシノを殺せと言うたはずよのぅ？\nそれがなにを、侍一匹にここまで手こずっておる。", "face": "l134bb0de0456"}, {"name": "ノリモチ", "text": "いえ、それが、奴の気迫に将兵たちが気圧され……。", "face": "u2881a1"}, {"name": "ドウマン", "text": "……ふむ、腐っても天下人の娘か。", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "言い訳は後で聞く、さっさと終わらせよ。", "face": "l134bb0de0456"}, {"name": "ノリモチ", "text": "はっ……お前たち、奴を囲め。", "face": "u2881a1"}]}, {"trigger": "battle", "at_sec": 270, "lines": [{"name": "シズカ", "text": "………………。", "face": "u101"}, {"name": "ノリモチ", "text": "シズカ、見事だった。お前の勝ちだよ、武器を捨てろ。", "face": "u2881a1"}, {"name": "シズカ", "text": "人質になってあの子の足を引っ張るぐらいなら、\n此処で一人でも多く道連れにして死んでやるわよ。", "face": "u101"}, {"name": "ドウマン", "text": "存外、虎の器であったか。見くびっておったわ。\n気骨のある武士を手に欠けるのは忍びないが──", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "これも世の常よな、殺せ。", "face": "l134bb0de0456"}, {"name": "シズカ", "text": "（ここまで、か……）", "face": "u101"}]}, {"trigger": "battle", "at_sec": 272, "lines": [{"name": "近衛兵", "text": "──雨？", "face": "l040cea8008c4"}, {"name": "陰陽師", "text": "馬鹿言え、さっきまでそんな気配──", "face": "l17ba454a069a"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "──斬り捨て御免。", "face": "u2884a1"}, {"name": "ノリモチ", "text": "なっ、なんだぁ！？", "face": "u2881a1"}, {"name": "？？？", "text": "見事な啖呵にござった、シズカ殿。\nやはりもののふとはそうでなくては。", "face": "u2884a1"}, {"name": "シズカ", "text": "あなたは……？", "face": "u101"}, {"name": "？？？", "text": "なぁに、通りすがりの浪人です。\nひとまずは拙者が前を受け持ちましょう。\nその間に息を整えられるがよろしい。", "face": "u2884a1"}, {"name": "？？？", "text": "──雨が止む前に、終わらせまする。", "face": "u2884a1"}]}], "active": true}