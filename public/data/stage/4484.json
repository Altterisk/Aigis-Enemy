 39, "spawn_sec": 104}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2104512, "race_id": 9, "special_effect_id": 222, "change_to": 9, "change_condition": 2, "master_id": 545, "global_id": 544, "to_condition": 2, "to_global_id": 545, "spawn_sec": 134}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 1000.0, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2104512, "race_id": 9, "special_effect_id": 64, "master_id": 546, "global_id": 545, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "カリオペ", "text": "ねえねえ質問なんだけどさー。\n前にあんたが王国に不死者の軍団と共に\n攻め込んできた時のこと覚えてる？", "face": "u42"}, {"name": "メトゥス", "text": "あら、懐かしいわね。もちろん覚えてるわよ。\nあの時のダーリンの強さっていったら……。\n本当に惚れ惚れしたわぁ。", "face": "u329"}, {"name": "カリオペ", "text": "あんたさ、あのとき投影魔術の伝書を使ったでしょ。\n姿がぶわっと映し出されて一方的に\n喋って、用件が済んだらぼわって消えたやつ。", "face": "u42"}, {"name": "カリオペ", "text": "私にもやり方教えて！", "face": "u42"}, {"name": "メトゥス", "text": "な、なによ大声で……。\nまあ別にいいわよ。難しい術じゃないし。\nでも何に使うのかしら？", "face": "u329"}, {"name": "カリオペ", "text": "ふっふっふ、王子に悪戯するためよ。\nそれにしてもメトゥスも大胆よねぇ。\nあーんな格好でメッセージ送るなんて。", "face": "u42"}, {"name": "メトゥス", "text": "あんな格好って……？", "face": "u329"}, {"name": "ロイ", "text": "……たしかに。あれは凄かったですね。", "face": "u11"}, {"name": "メトゥス", "text": "ん？　え？　なによ？\nたしか普段着だったと思うけど……？", "face": "u329"}, {"name": "カリオペ", "text": "もしかして私達と倫理観が違うのかしら？\nそれとも天然？", "face": "u42"}, {"name": "メトゥス", "text": "天然って、どういうことよ、ねえ――ッ！", "face": "u329"}, {"name": "兵士", "text": "前方に魔物を確認！", "face": "lc0e4661faf65"}, {"name": "ケイティ", "text": "皆さん、おしゃべりはそこまでですわ！\n戦闘体勢に即時移行しなさい！\n王子、行きましょう！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "メトゥス", "text": "あーんもう！\n気になって戦いに集中できなかったじゃない！", "face": "u329"}, {"name": "カリオペ", "text": "だからあんたは戦ってないじゃないの！\n……じゃなくて！\nほらほらーさっそくあの魔術お・し・え・て？", "face": "u42"}, {"name": "メトゥス", "text": "……いやよ。", "face": "u329"}, {"name": "カリオペ", "text": "えー！　なんでよ！　約束が違うじゃない！", "face": "u42"}, {"name": "メトゥス", "text": "ふん。\nあなたたちが私をからかうからよ。", "face": "u329"}, {"name": "カリオペ", "text": "うぅ……メトゥスのばか。", "face": "u42"}, {"name": "ロイ", "text": "勉強熱心のようですな。\n投影魔術なら私も少し心得があります。\nお教えしましょうか？", "face": "u11"}, {"name": "カリオペ", "text": "……なんか眼がいやらしいから遠慮しておく。\nあッ王子ぃ！　ちょっとちょっとぉ！\nこの前のあれなんだけどさぁ――……。", "face": "u42"}, {"name": "ロイ", "text": "私の優しい眼差しにそのような\n言いがかりをつけるとは……。\n私はこれでも王国魔術師だというのに……。", "face": "u11"}]}], "active": true}