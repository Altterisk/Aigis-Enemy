{"quest_id": 8555, "name": "眠り姫と後継者", "description": "北の大国の都市を襲う黒冠の魔物を退けよ！\n＜特定のタイミングで吹雪が発生＞\n＜時間経過でのコスト回復量が100％上昇＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["特定のタイミングで吹雪が発生", "時間経過でのコスト回復量が100％上昇"], "event": "時の監視者と仮面の騎士", "event_category": "History", "mission_id": 920231, "map_no": 9339, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 30, "params": [200]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 13, "form_count": 2, "hp": 7000, "attack": 350, "base_hp": 7000, "base_attack": 350, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_to": 1, "change_condition": 4, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38792, "global_id": 12409, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 12410, "spawn_sec": 45}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 7000, "attack": 250, "base_hp": 7000, "base_attack": 250, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_condition": 4, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38793, "global_id": 12410, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 3, "source": "local", "count": 24, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 4