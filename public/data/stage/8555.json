"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 2700, "attack": 740, "base_hp": 2700, "base_attack": 740, "damage_type": "physical", "armor_defense": 260, "magic_defense": 40, "attack_speed": 40, "attack_wait": 5, "attack_interval": 67, "move_speed": 2200.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "special_effect_id": 2074, "master_id": 38772, "global_id": 12389, "from_condition": 2}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 2, "tags": ["黒輪"], "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_speed": 50, "attack_wait": 30, "attack_interval": 165, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "special_effect_id": 2075, "change_to": 12, "change_condition": 2, "master_id": 38779, "global_id": 12396, "to_condition": 2, "to_global_id": 12397, "spawn_sec": 233}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "attack_speed": 50, "attack_wait": 20, "attack_interval": 145, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "special_effect_id": 2076, "master_id": 38780, "global_id": 12397, "from_condition": 2}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 2, "tags": ["黒輪"], "hp": 3000, "attack": 240, "base_hp": 3000, "base_attack": 240, "damage_type": "magical", "armor_defense": 50, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 2075, "change_to": 14, "change_condition": 2, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38777, "global_id": 12394, "ranged": true, "to_condition": 2, "to_global_id": 12395, "spawn_sec": 242}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 4500, "attack": 480, "base_hp": 4500, "base_attack": 480, "damage_type": "magical", "armor_defense": 100, "attack_range": 120, "attack_speed": 30, "attack_wait": 40, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 2076, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38778, "global_id": 12395, "ranged": true, "from_condition": 2}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 2, "tags": ["黒輪"], "hp": 24000, "attack": 1200, "base_hp": 24000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_range": 60, "attack_speed": 115, "attack_wait": 100, "attack_interval": 279, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 2077, "change_to": 16, "change_condition": 2, "missile_id": 11, "master_id": 38785, "global_id": 12402, "ranged": true, "to_condition": 2, "to_global_id": 12403, "spawn_sec": 247}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 36000, "attack": 2400, "base_hp": 36000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_range": 60, "attack_speed": 115, "attack_wait": 80, "attack_interval": 239, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 2078, "missile_id": 11, "master_id": 38786, "global_id": 12403, "ranged": true, "from_condition": 2}], "popups": ["\n\n\n　　――北の大国、衛星都市", "スノースパイダーは\nニ種類の攻撃を交互に行います。\n\nスノースパイダーから\n物理の遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。", "　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇", "黒い光冠の魔物は倒されると、\nその場で強くなって復活します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――北の大国、衛星都市"}, {"name": "シビラ", "text": "（なるほどね。\nそれであのふたり、ギスギスしているのね？）", "face": "u39"}, {"name": "フィノーラ", "text": "…………（そわそわ）", "face": "u2441a1"}, {"name": "アヴリック", "text": "…………（おろおろ）", "face": "u2443a1"}, {"name": "オーシェン", "text": "（仲が悪いというわけではなく、\nただ、互いの距離を測りかねているようですね）", "face": "u2133a1"}, {"name": "セブン", "text": "（アヴリックの代で技術が途絶えたとかいうけど、\nそんなの自分じゃどうしようもないことじゃん？\n気にせず仲良くすればいいと思うんだけどなぁ）", "face": "u449"}, {"name": "セブン", "text": "はぁ……いつまで\n初恋の少年少女みたいなマネしてんだよ。", "face": "u449"}, {"name": "フィノーラ", "text": "だ、誰が初恋だ！？", "face": "u2441a1"}, {"name": "ユージェン", "text": "『時の破片』の捜索が最優先事項なんだろう？\nこの方角から反応があった、で間違いないのか？", "face": "u906"}, {"name": "フィノーラ", "text": "あ、ああ。\n僅かだが、時空の歪みを感知した。", "face": "u2441a1"}, {"name": "フィノーラ", "text": "アヴリック！\n君の観測装置で詳細な場所を――", "face": "u2441a1"}, {"name": "アヴリック", "text": "えっ、あっ、わっ……。\nごめんなさい、観測装置の出力が上がらなくて……。", "face": "u2443a1"}, {"name": "フィノーラ", "text": "……す、すまない。", "face": "u2441a1"}, {"name": "セブン", "text": "（初恋のガキの初めての喧嘩かよ……。\n姐さん、どうにかできないのか？）", "face": "u449"}, {"name": "アイリーン", "text": "（人間関係というのはままならないものだ。\n時間か、あるいは何かのきっかけが解決するだろう）", "face": "u315"}, {"name": "フィノーラ", "text": "まぁ、おおまかには方角は把握できている。\nこのまま進めば、問題なく『時の破片』を見つけ――", "face": "u2441a1"}, {"name": "シビラ", "text": "――待って。雪の声が……。", "face": "u39"}, {"name": "ユージェン", "text": "雪の声？", "face": "u906"}, {"name": "シビラ", "text": "これだけ雪が積もっていれば、\n音が吸収されて静かになるものなのだけれど……。\n聞こえない？　遠くから、地響きのような……。", "face": "u39"}, {"name": "オーシェン", "text": "雪崩……いや、ここは平野部ですから……。\n――ッ！！　見えました！\n遠方より魔物の群れが接近中！", "face": "u2133a1"}, {"name": "シビラ", "text": "あれは……黒冠を背負った魔物ね。\nこんな非常事態に……。", "face": "u39"}, {"name": "オーシェン", "text": "スノースパイダーの姿も見えます。\n糸と氷を操る、厄介な魔物です。", "face": "u2133a1"}, {"name": "シビラ", "text": "街の皆は屋内に避難を！\n王子、黒冠の魔物を退けましょう！", "face": "u39"}]}, {"trigger": "end", "lines": [{"name": "アヴリック", "text": "……うぅ、お役に立てず申し訳ありません。", "face": "u2443a1"}, {"name": "フィノーラ", "text": "そう謝らないでくれ。\nアヴリックは何も悪いことはしていない。", "face": "u2441a1"}, {"name": "シビラ", "text": "そうよ。\nそれに、避難した私の民を守ってくれたじゃない。", "face": "u39"}, {"name": "アヴリック", "text": "あ、ありがとうございます、\nシビラ殿下、フィノーラ様……。", "face": "u2443a1"}, {"name": "ユージェン", "text": "それにしても、\nやけにタイミングの悪い――いや、\n襲撃者にとってはタイミングのいい魔物の暴走だったな。", "face": "u906"}, {"name": "ちぃエフトラ", "text": "黒冠の魔物の出現も、\n『時の破片』を狙った襲撃者の仕業だと？", "face": "u1989a1"}, {"name": "ユージェン", "text": "あくまで可能性でしかないけど……。\nでも、用心はしておいた方がいいはず。", "face": "u906"}, {"name": "エフトラ", "text": "ユージェンの勘はよく当たりますし、\n私も周辺警戒を続けておきましょう。", "face": "u1468a1"}, {"name": "ちぃエフトラ", "text": "わ、私も行きます！\n大人の私には負けません！", "face": "u1989a1"}, {"name": "フィノーラ", "text": "……よし、ここでも少量の『時の破片』を回収できた。\n次の街へ進もう。", "face": "u2441a1"}, {"name": "フィノーラ", "text": "『時の破片』を回収しつつ、\n大きな反応を追い続ければ、\n必ず襲撃者のもとへたどり着けるはずだ。", "face": "u2441a1"}, {"name": "アヴリック", "text": "は、はい！\nでは参りましょう！", "face": "u2443a1"}]}], "story_talk": true, "active": true}