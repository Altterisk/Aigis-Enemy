"missile_id": 777, "missile": {"splash": 40}, "master_id": 41256, "ranged": true, "spawn_sec": 108}, {"enemy_id": 22, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "hp": 35000, "attack": 500, "base_hp": 35000, "base_attack": 500, "damage_type": "magical", "armor_defense": 250, "attack_range": 150, "attack_speed": 1, "attack_wait": 80, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174032, "race_id": 2, "special_effect_id": 2574, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 41254, "ranged": true, "spawn_sec": 177}, {"enemy_id": 23, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物"], "fixture": true, "uncounted": true, "hp": 300000, "attack": 2800, "base_hp": 300000, "base_attack": 2800, "damage_type": "magical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 45, "attack_interval": 142, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2174368, "race_id": 2, "change_to": 1, "change_condition": 1, "master_id": 41269, "variants": [{"hp": 300000, "attack": 2800, "base_hp": 300000, "base_attack": 2800, "damage_type": "magical", "armor_defense": 1600, "magic_defense": 60, "attack_speed": 1, "attack_wait": 45, "attack_interval": 142, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2174368, "race_id": 2, "master_id": 41268}], "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 226}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["置物"], "fixture": true, "uncounted": true, "hp": 58000, "attack": 600, "base_hp": 58000, "base_attack": 600, "damage_type": "magical", "armor_defense": 600, "magic_defense": 80, "attack_range": 400, "attack_speed": 60, "attack_wait": 30, "attack_interval": 151, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174064, "race_id": 2, "special_effect_id": 72, "change_to": 3, "change_condition": 2, "missile_id": 1735, "missile": {"speed": 5.0}, "master_id": 41270, "ranged": true, "to_condition": 2, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 226}], "popups": ["ルビードラゴンがいる間は、\n全てのドラゴンの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ドラゴン兵", "text": "――将軍閣下、リヴァイアサンのブレスが、\n正体不明の魔力によって中和されております。", "face": "l21f9da625278"}, {"name": "トラハイア", "text": "なに……？", "face": "u2944a1"}, {"name": "トラハイア", "text": "天眼ノ国はヴィマーナを既に失ったはずだ。\nまさか、リヴァイアサンに匹敵する神造兵器が、\nもう一機存在するとでも？", "face": "u2944a1"}, {"name": "アングハラド", "text": "かの獣人どもの国が手を貸したか？\nいや、それにしても早すぎる……。", "face": "lc12185578db6"}, {"name": "トラハイア", "text": "この目で見たほうが早いな。\nアングハラド、お前はここで座ってろ。\n俺が見てきてやるよ。", "face": "u2944a1"}, {"name": "アングハラド", "text": "……深追いはするな。", "face": "lc12185578db6"}, {"name": "トラハイア", "text": "お前まで臆病になるな、まったく。\nドラゴンってのはもともと、\n傲岸不遜な種族だったはずだろ？", "face": "u2944a1"}, {"name": "トラハイア", "text": "お前の娘の方が、よっぽど王の器だ。", "face": "u2944a1"}, {"name": "アングハラド", "text": "ははっ……違いない。\nだからこそ、アンウェンが向こうへ行ったのは、\n種にとっては最善の判断だった。", "face": "lc12185578db6"}, {"name": "トラハイア", "text": "今から滅ぶことを考えてる場合か。\n死ぬ時は一緒に死んでやる。だがせめて、\nドラゴンらしく世界を焼き尽くしてからにしようぜ。", "face": "u2944a1"}]}, {"trigger": "start", "lines": [{"name": "アンウェン", "text": "――ラピス！　ラピスー！\n大丈夫か！？　いったい何をしたんだ！？", "face": "u2934a1"}, {"name": "サフレア", "text": "竜都の瘴気が完全にかき消えています。\nおそらく、ラピス様が何らかの儀式を……。", "face": "u2935a1"}, {"name": "アンウェン", "text": "あれ……ラピス……？", "face": "u2934a1"}, {"name": "ラピス", "text": "…………。", "face": "u2941a1"}, {"name": "アンウェン", "text": "おい、ラピス！　息をしろ！\nこんなところで死んでいる場合か！", "face": "u2934a1"}, {"name": "サフレア", "text": "……姫様、だめです。どうか安らかに眠らせて――", "face": "u2935a1"}, {"name": "レヴィアタンの化身", "text": "……魔界を召喚してみせたのです。\n彼女の肉体はもう……。", "face": "lfe7a12f0fc1b"}, {"name": "ルチア", "text": "――馬鹿。大馬鹿。大馬鹿召喚士……！", "face": "u2741a1"}, {"name": "アンウェン", "text": "なっ、だ、誰か降ってきたぞ！？\nまさかあの飛空艦から……？", "face": "u2934a1"}, {"name": "ルチア", "text": "勝手に……勝手にかっこつけて、\n勝手に犠牲になって、また自分で全部決めて、\nほんとうに、何にも変わってない……。", "face": "u2741a1"}, {"name": "ルチア", "text": "起きろ！　起きてください！\n――ラピス様！！", "face": "u2741a1"}, {"name": "ラピス", "text": "…………。", "face": "u2941a1"}, {"name": "ラピス", "text": "…………大丈夫だ。まだ、死んでいない。", "face": "u2941a1"}, {"name": "ラピス", "text": "声が聞こえたんだ。\n白い、綺麗な――いや、\nルチアほどじゃないが、綺麗な光の声が……。", "face": "u2941a1"}, {"name": "ラピス", "text": "いま死んだら、冥界でも転生先にでも、\nメイスを持って殴り込んでくる女の子がいるが、\n手助けは必要か、とな……。", "face": "u2941a1"}, {"name": "ルチア", "text": "白き導き……？", "face": "u2741a1"}, {"name": "ラピス", "text": "おそらくな。\nともあれ、えぇと、\nこういうときに伝える言葉があったな……。", "face": "u2941a1"}]}, {"trigger": "start", "lines": [{"name": "ルチア", "text": "……おかえりなさい。", "face": "u2741a1"}, {"name": "ラピス", "text": "ああ、ただいま。", "face": "u2941a1"}, {"name": "レヴィアタンの化身", "text": "……すごい。\nずっと眠っているだけでは、\nこんな場面には、出会えませんでしたね。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "レヴィアタン、お前はそこで休んでいろ。\nここにいるのは大悪魔召喚士を超えた、\n極悪魔召喚士だ。", "face": "u2941a1"}, {"name": "レヴィアタンの化身", "text": "そうも言ってられませんよ。\n味方すると決めた以上、私も力を貸しましょう。\n戦場全域に、魔界の縁者たちへの加護を与えます。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "ふむ……任せた。\nドラゴンどもを、ここで迎え撃つぞ！", "face": "u2941a1"}, {"name": "アンウェン", "text": "はぁ……すごいもの見ちゃった。\nサフレア、わらわたちもここで戦うぞ。", "face": "u2934a1"}, {"name": "サフレア", "text": "はい、アンウェン様。", "face": "u2935a1"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "トラハイア", "text": "なんだ、この奇妙な魔力の残滓は……。", "face": "u2944a1"}, {"name": "アンウェン", "text": "トラハイアー！\nよくも堂々と顔を見せられたな！", "face": "u2934a1"}, {"name": "トラハイア", "text": "……姫様。\n天真爛漫さにはお変わりないようで。", "face": "u2944a1"}, {"name": "アンウェン", "text": "……太守が命じたのか。\n地上の仕組みすら書き換える、あの儀式を。", "face": "u2934a1"}, {"name": "トラハイア", "text": "当然です。\n世界へ干渉するあの術は、行使すれば、\n漏れなくドラゴン種が世界の敵となるのですから。", "face": "u2944a1"}, {"name": "アンウェン", "text": "なれば、もはや遠慮も容赦もせぬ。\n王女として、同等の覚悟を見せねばな。", "face": "u2934a1"}, {"name": "トラハイア", "text": "元、武術指南役として、お受けしましょう。\n――見せてみろよ、姫様の覚悟ってやつを。", "face": "u2944a1"}]}, {"trigger": "end", "lines": [{"name": "アンウェン", "text": "……武術指南役殿、見極めはいかに？", "face": "u2934a1"}, {"name": "トラハイア", "text": "お見事。\nもう花を愛でておやつを貪っていた、\nあの頃の姫様はどこにもいないようです。", "face": "u2944a1"}, {"name": "アンウェン", "text": "おやつは余計だ。\nトラハイアよ、お前だけでも投降せよ。\n竜ノ国は、もはや終わりだ。", "face": "u2934a1"}, {"name": "トラハイア", "text": "そうも行かないのは、姫様も承知でしょう。\nそのためにも、あなたには生き延びてもらわねば。", "face": "u2944a1"}]}, {"trigger": "end", "lines": [{"name": "アンウェン", "text": "待て！　逃げる気か！？", "face": "u2934a1"}, {"name": "トラハイア", "text": "いいえ、悪とは本拠地にて待つものでしょう。\n竜都にてお待ちしておりますよ。", "face": "u2944a1"}, {"name": "トラハイア", "text": "（どこからかやってきた、王国の飛行戦力。\nそしてリヴァイアサンの能力を無効化した者……）", "face": "u2944a1"}, {"name": "トラハイア", "text": "（最強の戦闘国家も、ここが死に場所か……）", "face": "u2944a1"}, {"name": "トラハイア", "text": "やれやれ、最期まで\nお供させてもらうぜ、アングハラド。", "face": "u2944a1"}]}], "map": {"image": "Map7524", "w": 960, "h": 640, "spots": [{"k": "b", "x": 941, "y": 488}, {"k": "m", "x": 845, "y": 431, "id": 200}, {"k": "m", "x": 755, "y": 381, "id": 201}, {"k": "m", "x": 682, "y": 340, "id": 202}, {"k": "m", "x": 614, "y": 376, "id": 203}, {"k": "m", "x": 687, "y": 414, "id": 204}, {"k": "m", "x": 516, "y": 339, "id": 205}, {"k": "m", "x": 589, "y": 299, "id": 206}, {"k": "m", "x": 339, "y": 271, "id": 207}, {"k": "m", "x": 261, "y": 315, "id": 208}, {"k": "m", "x": 538, "y": 497, "id": 209}, {"k": "m", "x": 615, "y": 459, "id": 210}, {"k": "m", "x": 536, "y": 418, "id": 211}, {"k": "m", "x": 468, "y": 456, "id": 212}, {"k": "m", "x": 360, "y": 429, "id": 213}, {"k": "m", "x": 434, "y": 393, "id": 214}, {"k": "m", "x": 362, "y": 357, "id": 215}, {"k": "m", "x": 289, "y": 390, "id": 216}, {"k": "m", "x": 498, "y": 265, "id": 217}, {"k": "m", "x": 572, "y": 231, "id": 218}, {"k": "m", "x": 500, "y": 194, "id": 219}, {"k": "m", "x": 428, "y": 229, "id": 220}, {"k": "m", "x": 213, "y": 245, "id": 221}, {"k": "m", "x": 178, "y": 363, "id": 222}, {"k": "r", "x": 428, "y": 302, "id": 300}, {"k": "r", "x": 344, "y": 162, "id": 301}, {"k": "r", "x": 254, "y": 472, "id": 302}, {"k": "r", "x": 746, "y": 273, "id": 303}, {"k": "r", "x": 747, "y": 480, "id": 304}, {"k": "r", "x": 841, "y": 333, "id": 305}, {"k": "r", "x": 394, "y": 500, "id": 306}], "events": [{"t": 0, "when": "time", "ops": [{"op": "+fx", "name": "obj_99", "fx": "BlackOut3", "x": 480, "y": 301}]}, {"t": 69.9, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "RockFall3", "x": 526, "y": 231}]}, {"t": 72.4, "when": "time", "ops": [{"op": "-fx", "name": "obj_00"}]}, {"t": 172.1, "when": "time", "ops": [{"op": "+fx", "name": "obj_02", "fx": "RockFall3", "x": 387, "y": 383}]}, {"t": 174.6, "when": "time", "ops": [{"op": "-fx", "name": "obj_02"}]}, {"t": 183.6, "when": "time", "ops": [{"op": "+fx", "name": "obj_03", "fx": "RockFall3", "x": 526, "y": 231}]}, {"t": 186.1, "when": "time", "ops": [{"op": "-fx", "name": "obj_03"}]}, {"t": 208.1, "when": "time", "ops": [{"op": "+fx", "name": "obj_01", "fx": "RockFall3", "x": 720, "y": 367}]}, {"t": 210.6, "when": "time", "ops": [{"op": "-fx", "name": "obj_01"}]}, {"t": 218.6, "when": "time", "ops": [{"op": "+fx", "name": "obj_04", "fx": "RockFall3", "x": 387, "y": 383}]}, {"t": 221.1, "when": "time", "ops": [{"op": "-fx", "name": "obj_04"}]}, {"t": 224.2, "when": "time", "ops": [{"op": "-s", "name": "locPlc_200"}, {"op": "-s", "name": "locPlc_201"}, {"op": "-s", "name": "locPlc_202"}, {"op": "-s", "name": "locPlc_203"}, {"op": "-s", "name": "locPlc_204"}, {"op": "-s", "name": "locPlc_205"}, {"op": "-s", "name": "locPlc_206"}, {"op": "-s", "name": "locPlc_207"}, {"op": "-s", "name": "locPlc_208"}, {"op": "-s", "name": "locPlc_209"}, {"op": "-s", "name": "locPlc_210"}, {"op": "-s", "name": "locPlc_211"}, {"op": "-s", "name": "locPlc_212"}, {"op": "-s", "name": "locPlc_213"}, {"op": "-s", "name": "locPlc_214"}, {"op": "-s", "name": "locPlc_215"}, {"op": "-s", "name": "locPlc_216"}, {"op": "-s", "name": "locPlc_217"}, {"op": "-s", "name": "locPlc_218"}, {"op": "-s", "name": "l