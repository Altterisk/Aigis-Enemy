{"quest_id": 6384, "name": "巨鬼の残痕", "description": "酒呑童子復活の余波を受け、\n暴走する鬼刃衆たち。その身に残りし\n巨鬼の力を封じ、彼らの心を取り戻せ！\n神級（★１獲得の目安：平均Lv50）", "event": "青鬼娘と鬼一門", "event_category": "History", "mission_id": 920103, "map_no": 5296, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "hp": 13000, "attack": 730, "base_hp": 13000, "base_attack": 730, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 1, "attack_interval": 53, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103328, "race_id": 16, "special_effect_id": 54, "master_id": 340, "global_id": 339, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 42, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 6}, {"enemy_id": 3, "source": "local", "count": 7, "form_count": 1, "tags": ["忍者"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098896, "race_id": 16, "master_id": 436, "global_id": 435, "spawn_sec": 24}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "hp": 13000, "attack": 5800, "base_hp": 13000, "base_attack": 5800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 30, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108128, "race_id": 16, "special_effect_id": 54, "master_id": 994, "global_id": 993, "spawn_sec": 44}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 20, "attack_range": 160, "attack_speed": 80, "attack_wait": 5, "attack_interval": 61, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098784, "race_id": 16, "special_effect_id": 220, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 125, "global_id": 124, "ranged": true, "spawn_sec": 78}, {"enemy_id": 6, "source": "local", "count": 18, "form_count": 1, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 91}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 1, "hp": 1000, "attack": 3000, "base_hp": 1000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_range": 10, "attack_speed": 65, "attack_wait": 80, "attack_interval": 197, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098864, "race_id": 16, "special_effect_id": 229, "missile_id": 56, "missile": {"speed": 1.0, "splash": 80}, "master_id": 127, "global_id": 126, "ranged": true, "spawn_sec": 98}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 160, "attack_speed": 40, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108848, "race_id": 4, "special_effect_id": 54, "change_to": 8, "change_condition": 2, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 30107, "global_id": 3726, "ranged": true, "to_condition": 2, "to_global_id": 3727, "spawn_sec": 114}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 1100, "base_hp": 10000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 160, "attack_speed": 40, "attack_wait": 5, "attack_interval": 51, "move_speed": 650.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108832, "race_id": 4, "special_effect_id": 54, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 30108, "global_id": 3727, "ranged": true, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 12, "form_count": 1, "tags": ["忍者"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_interval": 76, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099968, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 208, "global_id": 207, "ranged": true, "spawn_sec": 118}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "鬼刃姫さん、鬼刃衆らしき姿の忍者たちが\n破壊行為を繰り返しているというのは……。", "face": "l24e6142bb3bb"}, {"name": "鬼刃姫", "text": "うん、聞いた話では\n確かこの近くだったはず……あ！", "face": "u435"}]}, {"trigger": "start", "lines": [{"name": "鬼刃衆", "text": "ウガァァアアアアアッ！！\n酒呑童子ヨリ得シ此ノ蛮力……失ッテ……ナルモノカ！", "face": "l40ccad5efdcc"}, {"name": "鬼刃衆", "text": "壊シ、潰シ……ソシテ殺セェッ！！\n我ラガ宿願、酒呑童子誅殺ガ成ルマデハ、\n憤怒ノ炎ヲ燃ヤシ続ケルノダァッ！！", "face": "l40ccad5efdcc"}, {"name": "鬼刃姫", "text": "鬼刃衆……どうしてこんなことに。", "face": "u435"}, {"name": "ヒバリ", "text": "……おそらく、この間の戦いと節分豆の影響で\n酒呑童子の力が大幅に削がれたことが原因ね。", "face": "u389"}, {"name": "ヒバリ", "text": "彼らを操っていた酒呑童子の血肉の力が低下して、\nそれと鬼刃衆が個々に有していた自我とが\n背反した結果、ああして暴走したんだと思う。", "face": "u389"}, {"name": "鬼刃姫", "text": "そんな……っ。\nねえ、鬼刃衆を元に戻す方法はないの？", "face": "u435"}, {"name": "ヒバリ", "text": "……無くはないわ。\n前に王子たちに集めてもらった\nこの『封印の札』を使えばね。", "face": "u389"}, {"name": "ヒバリ", "text": "あの時は酒呑童子の力を封じるには至らなかったけど、\nヤツの力が弱まった今なら、鬼刃衆を支配している\nヤツの血肉の力を封じることくらいはできるはず。", "face": "u389"}, {"name": "ヒバリ", "text": "けど、今の鬼刃衆は酒呑童子の血肉によって得た\n力に取り付かれてるようにも見える。\nもしそうだとしたら、その力を失った場合――。", "face": "u389"}, {"name": "ヒバリ", "text": "――鬼刃衆は、廃人同然になってしまうかもしれないわ。\nそうなる覚悟はあるかしら？", "face": "u389"}, {"name": "鬼刃姫", "text": "…………わからない。\n鬼刃衆は……あての大切な仲間だもん。", "face": "u435"}, {"name": "鬼刃姫", "text": "……でも、だからこそこれ以上鬼刃衆に\n無意味な破壊を続けさせるわけにはいかない！", "face": "u435"}, {"name": "鬼刃姫", "text": "王子、みんな……力を貸して！\n鬼刃衆を縛る忌まわしき鎖……、\n今日こそ断ち切ってやるんだから！", "face": "u435"}]}, {"trigger": "end", "lines": [{"name": "鬼刃衆", "text": "――グフッ！？　\nハァ、ハァッ……ウグッ……！\nキ……キバ、ヒメ……サマ……ッ！", "face": "l40ccad5efdcc"}, {"name": "ヒバリ", "text": "鬼刃姫！\n封印するなら今よ！　どうするの！？", "face": "u389"}, {"name": "鬼刃姫", "text": "くッ……！\n…………お願い、ヒバリさん！", "face": "u435"}, {"name": "ヒバリ", "text": "わかったわ！\n恨みっこなしだからね――はァアッ！！", "face": "u389"}, {"name": "鬼刃衆", "text": "――グ、グァァアアアアァァアアアアアッッ！！！", "face": "l40ccad5efdcc"}, {"name": "アンナ", "text": "…………っ。", "face": "l24e6142bb3bb"}, {"name": "鬼刃姫", "text": "…………鬼刃、衆……？", "face": "u435"}, {"name": "鬼刃衆", "text": "…………う、うぅ……これは……夢、か……？\n鬼刃姫様の、ご尊顔が……これほど、近くに……。", "face": "l40ccad5efdcc"}, {"name": "鬼刃姫", "text": "――鬼刃衆ッ！\n夢なんかじゃない！　あてよ、鬼刃姫よ！", "face": "u435"}, {"name": "鬼刃衆", "text": "おおッ……き、鬼刃姫様ぁああッ！\n申し訳ありませぬ……我らが不甲斐ないばかりに、\nあの酒呑童子の眷属になど……く、うぅ……ッ！", "face": "l40ccad5efdcc"}, {"name": "鬼刃姫", "text": "ふふ、馬鹿ね……。\n大切な仲間たちが、こうして無事に帰ってきてくれた。\nそれ以上になにを望むっていうの……。", "face": "u435"}, {"name": "鬼刃衆", "text": "ははっ……しばらくお会いせぬうちに\n丸くなりましたな、鬼刃姫様……。", "face": "l40ccad5efdcc"}, {"name": "鬼刃衆", "text": "……王子、今日まで多大なる迷惑をかけた儀、\nここに謝罪させてほしい。\n誠に申し訳ござらんかった。", "face": "l40ccad5efdcc"}, {"name": "鬼刃衆", "text": "酒呑童子を討つという我らが宿願、貴殿に託そう。\nそして我らが主、鬼刃姫様のことも。\n……あの御方を泣かすなよ。", "face": "l40ccad5efdcc"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "鬼刃衆", "text": "しかと頼んだぞ。\n今後我らは、酒呑童子の動向を探り、鬼刃姫様に\nお伝えすることで力になろう……では、さらばだ。", "face": "l40ccad5efdcc"}]}], "active": true}