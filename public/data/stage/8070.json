erval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124208, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 33363, "global_id": 6980, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 3, "tags": ["アーマー"], "hp": 6400, "attack": 500, "base_hp": 6400, "base_attack": 500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126928, "race_id": 20, "change_to": 12, "master_id": 33346, "global_id": 6963, "to_global_id": 6964, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 151}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 6400, "attack": 1500, "base_hp": 6400, "base_attack": 1500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126944, "race_id": 20, "change_to": 13, "change_condition": 4, "master_id": 33347, "global_id": 6964, "to_condition": 4, "to_ticks": 1, "to_global_id": 6965}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 6400, "attack": 500, "base_hp": 6400, "base_attack": 500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126928, "race_id": 20, "master_id": 33348, "global_id": 6965, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 2, "hp": 5000, "attack": 560, "base_hp": 5000, "base_attack": 560, "damage_type": "physical", "armor_defense": 240, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124096, "race_id": 20, "change_to": 15, "change_condition": 4, "master_id": 33356, "global_id": 6973, "to_condition": 4, "to_ticks": 3, "to_global_id": 6976, "spawn_sec": 153}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1120, "base_hp": 5000, "base_attack": 1120, "damage_type": "true", "armor_defense": 240, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 33359, "global_id": 6976, "from_condition": 4, "trigger_ticks": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "スズネ", "text": "――くぅぅっ、ぽんぽこ会議中を狙うとは、\n天界の連中、道理を知らないみたいですぽん！", "face": "u936"}, {"name": "アキレア", "text": "おらァ！　出てこい妖怪ダヌキども！\nてめぇらカワイイ顔して情報戦の達人なんだってなぁ！", "face": "u1972a1"}, {"name": "アキレア", "text": "者ども、ぽんぽこ連中をぶっ飛ばしてやれ！！", "face": "u1972a1"}, {"name": "ヤシマ", "text": "むしろ妖狸がみーんな揃ってるから、\n一網打尽でちょうどいいぽん。", "face": "u1019a1"}, {"name": "スズネ", "text": "な、なんで落ち着いてるんですぽん！\nあたし様たちのお里が襲われてるんですぽーん！", "face": "u936"}, {"name": "ヤシマ", "text": "はぁ、お茶がおいしいぽん……。", "face": "u1019a1"}, {"name": "スズネ", "text": "だ、だめですぽん……。\nこれじゃあ妖狸の歴史はおしまいですぽん……！", "face": "u936"}, {"name": "スズネ", "text": "こうなったらあたし様が！\nむむむむ、ぽんぽこへんげ――", "face": "u936"}, {"name": "ヤシマ", "text": "まぁまぁ、落ち着くぽん。\n指揮官が慌てたら、勝てる戦も勝てないぽん。", "face": "u1019a1"}, {"name": "ヤシマ", "text": "――手なら、もう打ってあるぽん。", "face": "u1019a1"}, {"name": "スズネ", "text": "……へ？", "face": "u936"}, {"name": "シノ", "text": "戦馬鹿は仁義も守れぬ様子。\nご無事ですか、お嬢さん方。", "face": "u403"}, {"name": "スズネ", "text": "よ、妖怪総大将ですぽんー！？", "face": "u936"}, {"name": "山ン本五郎左衛門", "text": "おーおー、大丈夫か狸ども。\nタヌキ鍋にされてねェか？", "face": "u1617a1"}, {"name": "スズネ", "text": "アヤカシの王さまですぽんー！！", "face": "u936"}, {"name": "シノ", "text": "古の盟約に従い、妖狸の里の防衛に助太刀します。\n総大将に王、こちらの布陣は万全かと。", "face": "u403"}, {"name": "山ン本五郎左衛門", "text": "里の外から来る連中は、俺たちが蹴散らしてやる。\n里に入った不届き者どもは、\nテメェらの手でケジメつけてやんな！", "face": "u1617a1"}, {"name": "ヤシマ", "text": "さ、いざ出陣だぽん♪", "face": "u1019a1"}, {"name": "スズネ", "text": "分かりましたぽん！\n妖怪に喧嘩を売るとどうなるか、\n天界の連中に教えてやりますぽーん！", "face": "u936"}]}, {"trigger": "end", "lines": [{"name": "スズネ", "text": "――さぁ。", "face": "u936"}, {"name": "ヤシマ", "text": "――ケジメを。", "face": "u1019a1"}, {"name": "シノ", "text": "取っていただきましょう。", "face": "u403"}, {"name": "山ン本五郎左衛門", "text": "……ほどほどにな。\nどうやら王子の読みは当たってたようだ。\n連中、本当に世界中に兵を放ったらしい。", "face": "u1617a1"}, {"name": "山ン本五郎左衛門", "text": "おそらくは、王子に縁のある連中の本拠に向かってな。", "face": "u1617a1"}, {"name": "スズネ", "text": "ぽぽん？　どうしてですぽん？\nそれなら王国を直接狙ったほうが早いですぽん。", "face": "u936"}, {"name": "山ン本五郎左衛門", "text": "どうしてか、あのアキレアって小娘、\n王子とディアスの約束を邪魔するつもりがないらしい。", "face": "u1617a1"}, {"name": "山ン本五郎左衛門", "text": "王子がオリュンポスに挑むのは邪魔しねェが、\nそれ以外の戦力は潰したい、ってところか？", "face": "u1617a1"}, {"name": "シノ", "text": "……なるほど、仁義、ですか。", "face": "u403"}, {"name": "シノ", "text": "あの者、心根はひどく真っ直ぐに見えました。\n約束を違えぬよう、されど\n今この場で武勲を立てるためにはどうすればいいか――", "face": "u403"}, {"name": "山ン本五郎左衛門", "text": "王子以外と戦えばいい、ってか。\n一応正々堂々ではあるが、\nそんな中途半端で満足できるのかねェ。", "face": "u1617a1"}, {"name": "シノ", "text": "さて、それはあの者が、\n己を納得させられるかどうかでしょう。", "face": "u403"}, {"name": "シノ", "text": "ですが――", "face": "u403"}, {"name": "ヤシマ", "text": "――あの子、たぶん満足しないぽん。\n根っこが強欲でイイヤツに見えたぽん。", "face": "u1019a1"}, {"name": "山ン本五郎左衛門", "text": "ははっ、だろうな。", "face": "u1617a1"}]}], "active": true}