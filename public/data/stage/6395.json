ck_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 26}, {"enemy_id": 13, "source": "local", "count": 53, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 29}, {"enemy_id": 14, "source": "local", "count": 1, "level": 70, "form_count": 2, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110624, "race_id": 9, "special_effect_id": 234, "change_to": 14, "change_condition": 2, "missile_id": 26, "master_id": 30739, "global_id": 4358, "ranged": true, "to_condition": 2, "to_global_id": 4350, "spawn_sec": 102}, {"enemy_id": 14, "source": "local", "count": 1, "level": 70, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110640, "race_id": 9, "special_effect_id": 234, "missile_id": 26, "master_id": 30731, "global_id": 4350, "ranged": true, "from_condition": 2}], "popups": ["くぐつに搭乗したゴブリンたちは\n倒されると2回まで修理を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "……再びココを訪れることになるとはナ。\nクイーン様の乗っタ飛行型くぐつが墜落シタ、\nコノ因縁の地ニ……。", "face": "lc1978d414b8c"}, {"name": "ゴブリン博士", "text": "ダガ、仕方あるマイ。\n開発資金が足りナイ以上、アノ時落下したくぐつを\n回収して再利用するシカないノダ……。", "face": "lc1978d414b8c"}, {"name": "ゴブリン博士", "text": "コレも我らがゴブリン軍の未来のタメ……。\nソレでは諸君、奈落に落ちタ\nくぐつの捜索を開始してくれタマエ！", "face": "lc1978d414b8c"}, {"name": "ゴブリン", "text": "……メンドクサイ。\nハカセ、自分デヤレバイイ。", "face": "l9c9308fd3b8d"}, {"name": "ゴブリン博士", "text": "キーッ！　イイから早く持ち場に就かんカ！\n従わんヤツは三姉妹様に言いつけルゾ！", "face": "lc1978d414b8c"}, {"name": "ゴブリン博士", "text": "……ハァ。思えバ生前のクイーン様は\n厳シクもカリスマがアリ、優れたリーダーだっタ。\nソレにひきかえ、ワタクシは……。", "face": "lc1978d414b8c"}, {"name": "兵士", "text": "――報告！　前方にゴブリンの群れを発見！\n報告にあった一団のようです。", "face": "u6"}, {"name": "ケイティ", "text": "報告感謝します。\nそれでは早速、こんなところでなにを企んでいるのかを\n彼らに問いただすとしましょう。", "face": "u114"}, {"name": "ゴブリン博士", "text": "――エエイ、目障りナ人間どもメ！\nダガ、くぐつの捜索を邪魔されルわけにはイカン！", "face": "lc1978d414b8c"}, {"name": "ゴブリン博士", "text": "ゴブリン兵、デアエ！\n捜索を邪魔スル愚か者ドモを撃退するノダ！", "face": "lc1978d414b8c"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "トホホ……戦いに敗れタばかりカ、\nくぐつの回収にモ失敗するトハ……。", "face": "lc1978d414b8c"}, {"name": "ゴブリン博士", "text": "コンナ時、クイーン様がいテくだされバ……。", "face": "lc1978d414b8c"}, {"name": "？？？", "text": "う、うぅ……っ。", "face": "l931eef5691c6"}, {"name": "ゴブリン博士", "text": "…………ヒッ！？\nい、今の声は……マサカ！", "face": "lc1978d414b8c"}, {"name": "？？？", "text": "う……わ、私はここよ……。\n早く……ッ……助けに来なさい、博士……。", "face": "l931eef5691c6"}, {"name": "ゴブリン博士", "text": "ク……クイーン様ぁアアッ！！\nアァ、おいたわしヤ……コンナ全身傷だらけで……。", "face": "lc1978d414b8c"}, {"name": "ゴブリンクイーン", "text": "ハァ、ハァッ……御託はいいから、早くしなさい……ッ。\nいまのあなたが……やるべきことは何？\n私を連れて……人間たちから逃れることでしょう？", "face": "l931eef5691c6"}, {"name": "ゴブリン博士", "text": "デ……デスガ、\nイマ無理に動かすトお身体に障るのデハ……。", "face": "lc1978d414b8c"}, {"name": "ゴブリンクイーン", "text": "馬鹿ね……そうなったらあなたが\nなんとかしてくれればいいじゃない……。\n天才科学者の貴方に……不可能はないはずでしょう？", "face": "l931eef5691c6"}, {"name": "ゴブリン博士", "text": "……オ、仰る通りでゴザイマス！\nこのワタクシが必ずヤ、貴方様のお身体を\n以前ヨリ強ク、美シク生まれ変わらせテ進ぜマショウ！", "face": "lc1978d414b8c"}, {"name": "アンナ", "text": "な…………。", "face": "ld1598bfe5dd1"}, {"name": "兵士", "text": "……ご、ゴブリン部隊、撤退していきます……。", "face": "u6"}, {"name": "アンナ", "text": "そんな……ゴブリンクイーンがまだ生きていたなんて。\n飛行型くぐつに乗ったまま墜落したはずでは……。", "face": "ld1598bfe5dd1"}, {"name": "ケイティ", "text": "ゴブリンとはいえ、女王ともなれば\n生命力は桁違い、ということでしょうか……。", "face": "u114"}, {"name": "ケイティ", "text": "ともあれ、ゴブリンたちの今後の動向には\nますます注意が必要ですね……。\n引き続き注視して参りましょう。", "face": "u114"}]}], "active": true}