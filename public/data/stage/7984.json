{"quest_id": 7984, "name": "炎の剣の担い手", "description": "戒めから解き放たれた炎の剣によって、\n担い手である巨人スルトが生み出される。\n＜HPに継続ダメージ：大＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["HPに継続ダメージ：大"], "event": "神話の笛の音は、ただ遠く", "event_category": "History", "mission_id": 920198, "map_no": 4745, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ブロック不可"], "fixture": true, "hp": 40000, "attack": 3000, "base_hp": 40000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_range": 2000, "attack_speed": 1, "attack_wait": 30, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2137216, "special_effect_id": 1393, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 36243, "global_id": 9860, "ranged": true, "commands": {"raw": "DeleteMapEffectObject(\"obj_00\", 0); CreateMapEffectObject2(\"obj_01\", \"Laevateinn_stop\", 5, 0, 15, 490, 89);"}}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "tags": ["スルト", "ステルスII", "ブロック不可"], "hp": 62000, "attack": 2200, "base_hp": 62000, "base_attack": 2200, "damage_type": "magical", "armor_defense": 50, "attack_speed": 150, "attack_wait": 120, "attack_interval": 521, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "pattern_id": 2144912, "race_id": 10, "change_to": 2, "master_id": 36246, "global_id": 9863, "to_global_id": 9858, "route_behaviour": {"transforms": [{"wait": 2000}]}, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["スルト"], "hp": 62000, "attack": 2200, "base_hp": 62000, "base_attack": 2200, "damage_type": "magical", "armor_defense": 50, "attack_speed": 150, "attack_wait": 120, "attack_interval": 521, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassi