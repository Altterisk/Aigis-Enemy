": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "attack": 250, "base_hp": 10000, "base_attack": 250, "damage_type": "magical", "armor_defense": 400, "magic_defense": 40, "attack_range": 160, "attack_speed": 1, "attack_wait": 60, "attack_interval": 185, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133552, "race_id": 2, "change_to": 5, "missile_id": 685, "missile": {"speed": 8.0, "on_hit": {"kind": "DOT", "duration_f": 360, "interval_f": 30, "flat": 20, "expire_duration_only": true, "effect_name": "DebuffEffectMagma"}}, "master_id": 21324, "global_id": 1617, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 12, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 8, "change_condition": 5, "master_id": 782, "global_id": 781, "to_condition": 5, "to_global_id": 782, "spawn_sec": 180}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 783, "global_id": 782, "ranged": true, "from_condition": 5}], "popups": ["炎の剣は一定範囲内のユニットに\n継続してダメージを与えます。\n\nまた炎の剣は、\nスルトのHPを回復します。\n\n倒さなくても★の評価には影響せず、\n拠点にも向かいません。", "スルトは\n一定範囲内のユニットに\n継続してダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "イコル", "text": "――久しいな、スルト。", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "剣の形として、炎と共に封じて以来か。\nお前の怒りがここまで伝わってくるようだ。", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "望みどおり、その戒めを解き放とう。\n世界を、この階層そのものを焼き尽くすはずだった、\n今や向けるべき矛先を失った力を。", "face": "l098045bf1b0c"}, {"name": "ハリンヘイム", "text": "イコル！　もうやめてください。\nどうしてそうまでして、\n炎の剣を解放しようというのですか。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "あなたが恨んだ、あなたが憎んだアスガルドの神は、\nもう誰も残っていないというのに！", "face": "u1854a1"}, {"name": "イコル", "text": "……存外、早かったな。\nなるほど、王子たちを味方につけたか。", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "実に望ましい結果だ。\n想定しうる最善の過程を歩んでいる。", "face": "l098045bf1b0c"}, {"name": "ハリンヘイム", "text": "あなたが何を企んでいるのかは、知りません。\nでも、この第三層を、神々の墓標を、\n炎で焼き尽くそうという愚行は許せません。", "face": "u1854a1"}, {"name": "イコル", "text": "きみの許可を取る必要はないだろう？\nこの階層に、もはや管理者はいないのだから。", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "ハリンヘイム、きみの役割は終わった。\nどこか安全な場所にでもこもって、\n世界が焼け落ちていく様を見ているがいい。", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "そう、もはやきみには、\n巨人スルトを止める術などないのだから。", "face": "l098045bf1b0c"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "エステル", "text": "――あれが、巨人スルト。\n炎の剣の担い手にして、\nアスガルドを滅ぼす運命にある者。", "face": "u245"}, {"name": "フローガ", "text": "なるほど、剣と一体だという意味が分かりました。\n魔力が繋がっていて、\n炎の剣を止めない限り再生し続けるということですか。", "face": "u878"}, {"name": "イコル", "text": "ああ、ぼくがそうなるように組み上げたからね。\nこれはいずれ、アスガルドを焼くはずだった炎だ。\nあいつらを殺すはずだった、未来の死だ。", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "滅びの炎にあらがってみるか、王子。", "face": "l098045bf1b0c"}, {"name": "フローガ", "text": "王子殿下、兵の配置には注意してください。\nあの剣も巨人も、凄まじい熱を放っています。\n近づくだけで身体が焼かれてしまうでしょう。", "face": "u878"}, {"name": "アンナ", "text": "それでも、どうにかしてあの剣を止めないと……。\n王子、どうか慎重な指揮をお願いします！", "face": "l5d7fc0c6e79c"}]}, {"trigger": "end", "lines": [{"name": "イコル", "text": "――ほう、剣に手を届かせたか。\nやはり可能性があるのは、お前だけだな。", "face": "l098045bf1b0c"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "イコル", "text": "今はそう、分からないという顔をしておくといい。\nだが、お前も薄々勘付いているのだろう？", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "ぼくか、女神アイギスか、あるいは他の亜神か、\n誰かがいずれお前に望むことだろう。", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "さぁ、スルトはまだ生きている。\nこの試練を見事、乗り越えてみせるといい。\n今はまだ人間の、大英雄殿？", "face": "l098045bf1b0c"}, {"name": "ハリンヘイム", "text": "イコル、もうやめてください。\nあなたのことは嫌いですが、\n数少ない同胞の生き残りを殺したくはありません。", "face": "u1854a1"}, {"name": "イコル", "text": "ハッ、笑わせてくれる。\n誰が、ぼくを殺すって？", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "良いだろう、お前たちにはまだ\n力が足りていないという現実を教えてやる。", "face": "l098045bf1b0c"}, {"name": "イコル", "text": "さぁ立て、スルト。\nお前の怒りはこんなものか。\nぼくを殺したいと、世界を焼滅したいと叫ぶがいい！", "face": "l098045bf1b0c"}]}], "active": true}