{"quest_id": 4688, "name": "帝国と共に", "description": "白の帝国のエリアスたちと共闘し\nデーモンの軍勢を引き連れた\nベルゼビュートの配下を打ち倒せ！\n極級（★１獲得の目安：平均Lv25）", "event": "帝国の治癒士", "event_category": "History", "mission_id": 920074, "map_no": 3843, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 6000, "base_hp": 6000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101840, "race_id": 3, "special_effect_id": 55, "master_id": 434, "global_id": 433, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 26}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 93}, {"enemy_id": 4, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 70, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104096, "race_id": 3, "master_id": 498, "global_id": 497, "spawn_sec": 103}, {"enemy_id": 5, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 157}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 187}], "popups": ["ベルゼビュートの配下の\n一定範囲内のユニットは攻撃力低下と\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "待って下さい、エリアスさん！\n私たちも協力させてください！", "face": "lab3e5c39447d"}, {"name": "エリアス", "text": "……王子、どうして来たのですか？\n私は邪魔をしないでくださいと言いましたよね？", "face": "u373"}, {"name": "ユリアン", "text": "あんたの治療薬でこうして元気になったんだ。\n少しは礼くらいさせろってんだよ。", "face": "u7"}, {"name": "ドワイト", "text": "エリアス殿、ここは王国領内です。\n彼らが協力してくれるというのなら、\nこちらに不利益はないのでは……？", "face": "u348"}, {"name": "エリアス", "text": "……分かりました。\nそういうことなら仕方ありませんが、\n帝国軍は貴方達と馴れ合う気はありません。", "face": "u373"}, {"name": "ケイティ", "text": "相変わらずですね、帝国は……。", "face": "u114"}, {"name": "アンナ", "text": "一時的とはいえ、\nこうして協力できるのです。\n王子、しっかりと連携していきましょう！", "face": "lab3e5c39447d"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……厄介な奴らが手を組んだな。\nしかし、治療薬を渡すとは計算外だったな。\nあれは貴重なもののはずだが……。", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "しかし、ベルゼビュート様が完全体になれば、\nそれこそ魔力は無尽蔵……ここは魔界の\n奴等を使って時間稼ぎをするとしよう……ブブッ。", "face": "ld8ef79b3ed4d"}, {"name": "ディルク", "text": "――報告！\n前方に、ベルゼビュートの配下を確認！　", "face": "u287"}, {"name": "エリアス", "text": "予想通りですね。\nそれでは、全軍臨戦態勢をとってください。", "face": "u373"}, {"name": "アンナ", "text": "王子、こちらも戦いの準備をお願い致します！", "face": "lab3e5c39447d"}]}, {"trigger": "end", "lines": [{"name": "エリアス", "text": "デーモンの掃滅を確認。\n各隊、目立った死傷者もありません。\nまずまずの勝利と言って良いでしょう。", "face": "u373"}, {"name": "ディルク", "text": "ふん、この程度とは拍子抜けだな。", "face": "u287"}, {"name": "ドワイト", "text": "思った以上に王子軍との連携が\n上手くいって良かったですね。", "face": "u348"}, {"name": "ユリアン", "text": "悔しいが、さすがは白の帝国軍の精鋭だぜ……。\nこれならベルゼビュートのところにも\n簡単に辿り着けそうだな。", "face": "u7"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……愚かなる人間たちよ。\nせいぜい束の間の勝利に喜んでいるがいい。", "face": "ld8ef79b3ed4d"}, {"name": "ベルゼビュートの配下", "text": "ベルゼビュート様はもう間もなく完全体になるのだ。\nその時が来れば、お前たちなど、\n一瞬にして塵芥に帰すだろう……ブブッ。", "face": "ld8ef79b3ed4d"}, {"name": "ユリアン", "text": "魔神ベルゼビュートが……完全体に！？", "face": "u7"}, {"name": "エリアス", "text": "皆さん、ここで慌てても仕方ありません。\n確かに、ベルゼビュート復活までの\n残り時間は少ないとは思います……。", "face": "u373"}, {"name": "エリアス", "text": "ですが、想定の範囲内でもあります。\nつまり、我が白の帝国軍の目測に\n今のところ誤りはないということです。", "face": "u373"}, {"name": "ドワイト", "text": "エリアス殿の言うとおりです。\nさ、王子軍の皆さん。\n進軍の準備をお願い致します。", "face": "u348"}, {"name": "ケイティ", "text": "この状況でも冷静沈着でいられるなんて……。\n白の帝国軍の力は計り知れないですね。", "face": "u114"}, {"name": "アンナ", "text": "ですが、力を合わせることが出来ている今は、\nこれ以上ないほど頼りになる仲間と言えます。"}, {"name": "アンナ", "text": "王子、このままエリアスさん達と協力し、\nベルゼビュートのもとへと向かいましょう！", "face": "lab3e5c39447d"}]}], "map": {"image": "Map920074_3843", "w": 960, "h": 640, "spots": [{"k": "b", "x": 25, "y": 116}, {"k": "b", "x": 22, "y": 215}, {"k": "b", "x": 83, "y": 480}, {"k": "m", "x": 805, "y": 124, "id": 200}, {"k": "m", "x": 655, "y": 121, "id": 201}, {"k": "m", "x": 539, "y": 121, "id": 202}, {"k": "m", "x": 419, "y": 121, "id": 203}, {"k": "m", "x": 283, "y": 125, "id": 204}, {"k": "m