ssin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098416, "race_id": 2, "master_id": 85, "global_id": 84, "spawn_sec": 129}, {"enemy_id": 8, "source": "local", "count": 9, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098432, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 87, "global_id": 86, "ranged": true, "spawn_sec": 137}, {"enemy_id": 9, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 293, "global_id": 292, "ranged": true, "spawn_sec": 173}], "popups": ["\n\n\n　　　　――竜人の里"], "dialogue": [{"trigger": "battle", "at_sec": 46, "lines": [{"text": "――竜人の里"}, {"name": "ジュジュカ", "text": "へぇー、あなたはとっても物知りなんですね！\n色んな事を知っててすごいです！", "face": "u2431a1"}, {"name": "訳知り竜人", "text": "イヤハヤ、そう褒められると照れますナ。\n貴方ははじめて見る方ですガ、話上手みたいデスね。", "face": "l9ff98b4ac522"}, {"name": "竜人の若者", "text": "それヨリ、今回はどんなヤツが来てるんダ？\n前はとんでもナイのがいっぱいダッタけどヨ。", "face": "l2360a6f61399"}, {"name": "トリシャ", "text": "――なるほど、君たちが噂の竜人ふたり組か。", "face": "u1706a1"}, {"name": "訳知り竜人", "text": "おぉっ！　貴方ハもしや、トリシャさんですか！", "face": "l9ff98b4ac522"}, {"name": "訳知り竜人", "text": "山の一部を吹き飛ばしタリ、\n異世界召喚士と組んで魔神を姪っ子にシタ話は、\nこの里にマデ伝わっておりますゾォ！", "face": "l9ff98b4ac522"}, {"name": "トリシャ", "text": "ろくでもない話が伝わっているようだね。", "face": "u1706a1"}, {"name": "竜人の若者", "text": "おい、アッチには騎竜がいるゾ！\n上の人間は大したコトなさそうダガ、\nあの竜カラはすごい力を感じるゼ……！", "face": "l2360a6f61399"}, {"name": "イーファ", "text": "あら、では一戦お相手しましょうか？", "face": "u1521a1"}, {"name": "竜人の若者", "text": "なっ……殺気！？\nこいつタダのお嬢サマじゃねぇぞ！？", "face": "l2360a6f61399"}, {"name": "イーファ", "text": "そんなに殺気みなぎってみえます……？", "face": "u1521a1"}, {"name": "ジュジュカ", "text": "戦場のイーファさんは結構怖いですよ？　歴戦って感じで。", "face": "u2431a1"}, {"name": "イーファ", "text": "イメージ戦略って大事ですのね……。\nではさっそく……にこっ♪　にぱーっ♪", "face": "u1521a1"}, {"name": "竜人の若者", "text": "え、笑顔は、素敵じゃねぇか……！！", "face": "l2360a6f61399"}, {"name": "ジュジュカ", "text": "（速攻で絆されてる……！）", "face": "u2431a1"}, {"name": "訳知り竜人", "text": "アッ……あ、あの、あのお姿ハ……！\nまさか、またコノ目で見られるトハ……！", "face": "l9ff98b4ac522"}, {"name": "竜人の若者", "text": "なんだ！　どうした――こ、この気配ハ……！？", "face": "l2360a6f61399"}, {"name": "訳知り竜人", "text": "千年前、亜神トラムから、\nクラウ・ソラスを受け継いダ伝説の竜姫！\nあ、アーニャ様の姿を拝めるトハぁ！！", "face": "l9ff98b4ac522"}, {"name": "アーニャ", "text": "えっ、えぇ！？\nなんか、すごい盛り上がってる……！？", "face": "u99"}, {"name": "アーニャ", "text": "よく分からないけど、ありがとう……？", "face": "u99"}, {"name": "訳知り竜人", "text": "アーニャ様カラ感謝の言葉を貰いましたゾ！？\nこれハもう抑えられナイ！\nパレードの模擬戦に飛び込みますゾ！", "face": "l9ff98b4ac522"}, {"name": "竜人の若者", "text": "お、オイッ！　相変わらず仕方ねぇヤツだ！\nオレたちも行くゾォ！！", "face": "l2360a6f61399"}]}, {"trigger": "end", "lines": [{"name": "ジュジュカ", "text": "も、模擬戦終わり！　そこまでですー！", "face": "u2431a1"}, {"name": "アーニャ", "text": "竜人のみんな、すごく喜んでくれてたね。", "face": "u99"}, {"name": "トリシャ", "text": "竜姫アーニャは竜人の間だと有名人だからね。\n手合わせできるとなったら、\nこうなるのはある意味当然のことだよ。", "face": "u1706a1"}, {"name": "イーファ", "text": "それなら貴方も、\nアーニャさんの前では興奮したりしますの？", "face": "u1521a1"}, {"name": "トリシャ", "text": "興奮とは違うが、柄にもなく緊張することはあるよ。\n初めて会ったときは翼が伸びる気持ちだったね。", "face": "u1706a1"}, {"name": "アーニャ", "text": "そうなの？　トリシャは亜神二柱に\n臆することなく胸を借りたって聞いたよ？", "face": "u99"}, {"name": "トリシャ", "text": "前の凱旋パレードのときの……。\nあの冗句、言うんじゃなかったかな……。", "face": "u1706a1"}, {"name": "イーファ", "text": "いったい何を言いましたの？", "face": "u1521a1"}, {"name": "トリシャ", "text": "あー……さぁね？　もう忘れちゃったよ。", "face": "u1706a1"}, {"name": "アーニャ", "text": "えーとね、あたしが聞いた話だと……。", "face": "u99"}, {"name": "トリシャ", "text": "おいおいおい言わないでくれたまえよ。\n今更ほじくり返されるのは私だって恥ずかしいんだ。", "face": "u1706a1"}, {"name": "訳知り竜人", "text": "あぁ、アーニャ様たちが楽し気にしてイル……。\nなんト尊いことだろうカ……。", "face": "l9ff98b4ac522"}, {"name": "ジュジュカ", "text": "尊い……可愛い……。\nあの空間、絶対いい匂いする……。", "face": "u2431a1"}, {"name": "ベルニス", "text": "ジュジュカさん……？", "face": "u2434a1"}, {"name": "竜人の若者", "text": "スマン、今のお前たち、チョット気持ち悪いぞ。", "face": "l2360a6f61399"}, {"name": "訳知り竜人", "text": "言ってイイことと……悪いコトがありますゾ……！", "face": "l9ff98b4ac522"}]}], "map": {"image": "Map920230_9333", "w": 960, "h": 640, "spots": [{"k": "b", "x": 936, "y": 153}, {"k": "m", "x": 423, "y": 372, "id": 200}, {"k": "m", "x": 486, "y": 454, "id": 201}, {"k": "m", "x": 719, "y": 439, "id": 202}, {"k": "m", "x": 721, "y": 336, "id": 203}, {"k": "m", "x": 748, "y": 229, "id": 204}, {"k": "m", "x": 364, "y": 471, "id": 205}, {"k": "m", "x": 227, "y": 458, "id": 206}, {"k": "m", "x": 120, "y": 265, "id": 207}, {"k": "m", "x": 149, "y": 173, "id": 208}, {"k": "m", "x": 260, "y": 132, "id": 209}, {"k": "m", "x": 392, "y": 109, "id": 210}, {"k": "m", "x": 533, "y": 96, "id": 211}, {"k": "m", "x": 596, "y": 438, "id": 212}, {"k": "m", "x": 821, "y": 491, "id": 213}, {"k": "m", "x": 830, "y": 172, "id": 214}, {"k": "m", "x": 146, "y": 371, "id": 215}, {"k": "r", "x": 835, "y": 420, "id": 300}, {"k": "r", "x": 538, "y": 393, "id": 301}, {"k": "r", "x": 492, "y": 360, "id": 302}, {"k": "r", "x": 117, "y": 461, "id": 303}, {"k": "r", "x": 66, "y": 319, "id": 304}, {"k": "r", "x": 85, "y": 391, "id": 305}, {"k": "r", "x": 177, "y": 224, "id": 306}, {"k": "r", "x": 655, "y": 271, "id": 307}, {"k": "r", "x": 781, "y": 305, "id": 308}, {"k": "r", "x": 537, "y": 148, "id": 309}]}, "start_cost": 10, "active": true, "name_en": "Rumors and Admiration of the Dragons", "description_en": "The Princes move to the Dragonfolk village, the next venue.\nHype up the venue with a mock battle demonstration\nalongside Trisha, Yipha, and Anya! Advanced (★1 acquisition guideline: Avg Lv10)"}