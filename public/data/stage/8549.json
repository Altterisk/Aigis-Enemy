{"quest_id": 8549, "name": "ドラゴンたちの噂と憧れ", "description": "王子たちは次の会場である竜人の里に移動。\nトリシャ、イーファ、アーニャとの\n模擬戦演武で会場を盛り上げろ！\n上級（★１獲得の目安：平均Lv10）", "event": "人気闘兵凱旋パレードVI", "event_category": "History", "mission_id": 920230, "map_no": 9333, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 26, "params": [90]}, {"kind": "term", "influence": 27, "params": [90]}, {"kind": "term", "influence": 30, "params": [90]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 13, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_range": 60, "attack_speed": 60, "attack_wait": 30, "attack_interval": 129, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160336, "race_id": 2, "missile_id": 11, "master_id": 38747, "global_id": 12364, "ranged": true, "spawn_sec": 45}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 500, "base_hp": 13000, "base_attack": 500, "damage_type": "magical", "armor_defense": 650, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 153, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108720, "race_id": 2, "master_id": 30801, "global_id": 4420, "spawn_sec": 45}, {"enemy_id": 3, "source": "local", "count": 12, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098576, "race_id": 2, "master_id": 147, "global_id": 146, "spawn_sec": 51}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 650, "base_hp": 13000, "base_attack": 650, "damage_type": "physical", "armor_defense": 200, "attack_range": 260, "attack_speed": 1, "attack_wait": 60, "attack_interval": 147, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2140992, "race_id": 16, "missile_id": 665, "missile": {"speed": 20.0, "splash": 80}, "master_id": 38745, "global_id": 12362, "ranged": true, "spawn_sec": 82}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "magical", "armor_defense": 100, "magic_defense": 35, "attack_range": 260, "attack_speed": 70, "attack_wait": 100, "attack_interval": 255, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2145968, "race_id": 2, "missile_id": 902, "missile": {"speed": 6.0, "splash": 53}, "master_id": 38744, "global_id": 12361, "ranged": true, "spawn_sec": 120}, {"enemy_id": 6, "source": "local", "count": 12, "form_count": 1, "hp": 4000, "attack": 700, "base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098528, "race_id": 2, "master_id": 297, "global_id": 296, "spawn_sec": 124}, {"enemy_id": 7, "source": "local", "count": 10, "form_count": 1, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098416, "race_id": 2, "master_id": 85, "global_id": 84, "spawn_sec": 129}, {"enemy_id": 8, "source": "local", "count": 9, "form_count": 1, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098432, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 87, "global_id": 86, "ranged": true, "spawn_sec": 137}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 293, "global_id": 292, "ranged": true, "spawn_sec": 173}], "popups": ["\n\n\n　　　　――竜人の里"], "dialogue": [{"trigger": "battle", "at_sec": 46, "lines": [{"text": "――竜人の里"}, {"name": "ジュジュカ", "text": "へぇー、あなたはとっても物知りなんですね！\n色んな事を知っててすごいです！", "face": "u2431a1"}, {"name": "訳知り竜人", "text": "イヤハヤ、そう褒められると照れますナ。\n貴方ははじめて見る方ですガ、話上手みたいデスね。", "face": "l9ff98b4ac522"}, {"name": "竜人の若者", "text": "それヨリ、今回はどんなヤツが来てるんダ？\n前はとんでもナイのがいっぱいダッタけどヨ。", "face": "l2360a6f61399"}, {"name": "トリシャ", "text": "――なるほど、君たちが噂の竜人ふたり組か。", "face": "u1706a1"}, {"name": "訳知り竜人", "text": "おぉっ！　貴方ハもしや、トリシャさんですか！", "face": "l9ff98b4ac522"}, {"name": "訳知り竜人", "text": "山の一部を吹き飛ばしタリ、\n異世界召喚士と組んで魔神を姪っ子にシタ話は、\nこの里にマデ伝わっておりますゾォ！", "face": "l9ff98b4ac522"}, {"name": "トリシャ", "text": "ろくでもない話が伝わっているようだね。", "face": "u1706a1"}, {"name": "竜人の若者", "text": "おい、アッチには騎竜がいるゾ！\n上の人間は大したコトなさそうダガ、\nあの竜カラはすごい力を感じるゼ……！", "face": "l2360a6f61399"}, {"name": "イーファ", "text": "あら、では一戦お相手しましょうか？", "face": "u1521a1"}, {"name": "竜人の若者", "text": "なっ……殺気！？\nこいつタダのお嬢サマじゃねぇぞ！？", "face": "l2360a6f61399"}, {"name": "イーファ", "text": "そんなに殺気みなぎってみえます……？", "face": "u1521a1"}, {"name": "ジュジュカ", "text": "戦場のイーファさんは結構怖いですよ？　歴戦って感じで。", "face": "u2431a1"}, {"name": "イーファ", "text": "イメージ戦略って大事ですのね……。\nではさっそく……にこっ♪　にぱーっ♪", "face": "u1521a1"}, {"name": "竜人の若者", "text": "え、笑顔は、素敵じゃねぇか……！！", "face": "l2360a6f61399"}, {"name": "ジュジュカ", "text": "（速攻で絆されてる……！）", "face": "u2431a1"}, {"name": "訳知り竜人", "text": "アッ……あ、あの、あのお姿ハ……！\nまさか、またコノ目で見られるトハ……！", "face": "l9ff98b4ac522"}, {"name": "竜人の若者", "text": "なんだ！　どうした――こ、この気配ハ……！？", "face": "l2360a6f61399"}, {"name": "訳知り竜人", "text": "千年前、亜神トラムから、\nクラウ・ソラスを受け継いダ伝説の竜姫！\nあ、アーニャ様の姿を拝めるトハぁ！！", "face": "l9ff98b4ac522"}, {"name": "アーニャ", "text": "えっ、えぇ！？\nなんか、すごい盛り上がってる……！？", "face": "u99"}, {"name": "アーニャ", "text": "よく分からないけど、ありがとう……？", "face": "u99"}, {"name": "訳知り竜人", "text": "アーニャ様カラ感謝の言葉を貰いましたゾ！？\nこれハもう抑えられナイ！\nパレードの模擬戦に飛び込みますゾ！", "face": "l9ff98b4ac522"}, {"name": "竜人の若者", "text": "お、オイッ！　相変わらず仕方ねぇヤツだ！\nオレたちも行くゾォ！！", "face": "l2360a6f61399"}]}, {"trigger": "end", "lines": [{"name": "ジュジュカ", "text": "も、模擬戦終わり！　そこまでですー！", "face": "u2431a1"}, {"name": "アーニャ", "text": "竜人のみんな、すごく喜んでくれてたね。", "face": "u99"}, {"name": "トリシャ", "text": "竜姫アーニャは竜人の間だと有名人だからね。\n手合わせできるとなったら、\nこうなるのはある意味当然のことだよ。", "face": "u1706a1"}, {"name": "イーファ", "text": "それなら貴方も、\nアーニャさんの前では興奮したりしますの？", "face": "u1521a1"}, {"name": "トリシャ", "text": "興奮とは違うが、柄にもなく緊張することはあるよ。\n初めて会ったときは翼が伸びる気持ちだったね。", "face": "u1706a1"}, {"name": "アーニャ", "text": "そうなの？　トリシャは亜神二柱に\n臆することなく胸を借りたって聞いたよ？", "face": "u99"}, {"name": "トリシャ", "text": "前の凱旋パレードのときの……。\nあの冗句、言うんじゃなかったかな……。", "face": "u1706a1"}, {"name": "イーファ", "text": "いったい何を言いましたの？", "face": "u1521a1"}, {"name": "トリシャ", "text": "あー……さぁね？　もう忘れちゃったよ。", "face": "u1706a1"}, {"name": "アーニャ", "text": "えーとね、あたしが聞いた話だと……。", "face": "u99"}, {"name": "トリシャ", "text": "おいおいおい言わないでくれたまえよ。\n今更ほじくり返されるのは私だって恥ずかしいんだ。", "face": "u1706a1"}, {"name": "訳知り竜人", "text": "あぁ、アーニャ様たちが楽し気にしてイル……。\nなんト尊いことだろうカ……。", "face": "l9ff98b4ac522"}, {"name": "ジュジュカ", "text": "尊い……可愛い……。\nあの空間、絶対いい匂いする……。", "face": "u2431a1"}, {"name": "ベルニス", "text": "ジュジュカさん……？", "face": "u2434a1"}, {"name": "竜人の若者", "text": "スマン、今のお前たち、チョット気持ち悪いぞ。", "face": "l2360a6f61399"}, {"name": "訳知り竜人", "text": "言ってイイことと……悪いコトがありますゾ……！", "face": "l9ff98b4ac522"}]}], "active": true}