se": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 90, "attack_interval": 261, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098480, "missile_id": 41, "missile": {"speed": 4.0, "splash": 133}, "master_id": 98, "global_id": 97, "ranged": true, "spawn_sec": 2}, {"enemy_id": 5, "source": "local", "count": 2, "level": 80, "form_count": 1, "tags": ["アーマー"], "hp": 3500, "attack": 700, "base_hp": 3500, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101280, "master_id": 267, "global_id": 266, "spawn_sec": 6}, {"enemy_id": 6, "source": "local", "count": 7, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 13}, {"enemy_id": 7, "source": "local", "count": 5, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 26}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 12000, "attack": 700, "base_hp": 12000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 20, "attack_wait": 1, "attack_interval": 48, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101632, "race_id": 16, "special_effect_id": 222, "master_id": 20004, "global_id": 1079, "spawn_sec": 108}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "暗黒騎士団を発見しました。\n前方に部隊を展開しようとしています！", "face": "lcc130fd78bb7"}, {"name": "アンナ", "text": "王子、暗黒騎士団を操る\n魔物も一緒のようです！", "face": "lefb1d0ba9c6a"}, {"name": "？？？", "text": "何だね？　\nワシはこれから魔界へ\n帰るところなのだが。", "face": "l329580f82645"}, {"name": "アンナ", "text": "魔界へ帰る……！？\nあなたは魔界とこちら側を行き来できる程の\n力を持っているのですか？", "face": "lefb1d0ba9c6a"}, {"name": "グレーターデーモン", "text": "ふむ……。\n君たちは上級のデーモンを\n見るのは初めてかね？", "face": "l329580f82645"}, {"name": "グレーターデーモン", "text": "この世界と魔界が接近している今、\n上級デーモンならばゲートを開くことは\n実にたやすいことだ。", "face": "l329580f82645"}, {"name": "アンナ", "text": "そのゲートから魔物がやってくるせいで、\nたくさんの悲劇が生まれているんです。\nあなたをこのまま帰すわけにはいきません。", "face": "lefb1d0ba9c6a"}, {"name": "グレーターデーモン", "text": "ふむ……面倒だね。\n副団長、ここは君に任せる。\nいいね？", "face": "l329580f82645"}, {"name": "エルヴァ", "text": "御意。お任せ下さい。", "face": "ld30285a1a287"}]}, {"trigger": "end", "lines": [{"name": "エルヴァ", "text": "アタシの技「滅多斬り」をみせてやろう。\n剣の乱撃を止めることができるかしら？", "face": "ld30285a1a287"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "デーモンは魔界に帰ってしまったようです。\nゲートは開いたままですが……。", "face": "lefb1d0ba9c6a"}, {"name": "アンナ", "text": "……まさか追いかけるおつもりですか！？\nそのような危険な……！", "face": "lefb1d0ba9c6a"}, {"name": "アンナ", "text": "もしどうしても追いかけると言うならば……。", "face": "lefb1d0ba9c6a"}, {"name": "アンナ", "text": "私もついていきます。\n王子とならばどこまでも。"}]}], "active": true}