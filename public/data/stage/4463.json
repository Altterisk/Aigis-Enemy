ack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 104}], "dialogue": [{"trigger": "start", "lines": [{"name": "ケイティ", "text": "王子、どうやらあれが魔物が封印された\n場所のようです。\nいかにも、という感じですね。", "face": "u114"}, {"name": "兵士", "text": "報告いたします！\n魔物たちが接近中です。", "face": "lfe765ec149a6"}, {"name": "アンナ", "text": "王子、迎え撃ちましょう。", "face": "lda7475f51c8c"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "封印はまだ解かれていないようですね。", "face": "lda7475f51c8c"}, {"name": "ロイ", "text": "ふむ。この封印の術式は、\nかなり古いもののようですな。", "face": "u11"}, {"name": "ロイ", "text": "先ほどの冒険者たちが言っていた、\n数千年前に封印されたものというのも、\nあながち本当かもしれません。", "face": "u11"}, {"name": "ケイティ", "text": "今の魔物たちも大した\n強さではありませんでした。", "face": "u114"}, {"name": "ケイティ", "text": "冒険者たちが遭遇した魔物たちは、\n別にいると思われますので\n周囲を警戒させておいたほうが良さそうです。", "face": "u114"}]}], "active": true}