{"quest_id": 8404, "name": "人の歴史を紡ぐ者", "description": "要塞宮殿の内部を進行する王子たち。\nそんな一行の前に戦場を渡り歩き詩を\n記録した観測者、ホルミースが姿を現す。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "星降る黎明", "event_category": "History", "mission_id": 920222, "map_no": 4996, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 5, "hp": 10000, "attack": 1, "base_hp": 10000, "base_attack": 1, "damage_type": "physical", "armor_defense": 10, "attack_speed": 90, "attack_wait": 45, "attack_interval": 261, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157040, "race_id": 16, "special_effect_id": 1893, "change_to": 1, "master_id": 38035, "global_id": 11652, "to_global_id": 11653, "to_flag": [1, 1], "route_behaviour": {"transforms": [{"flag": 1, "val": 1}, {"flag": 2, "val": 1}, {"flag": 3, "val": 1}, {"flag": 4, "val": 1}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 5, "hp": 10000, "attack": 1, "base_hp": 10000, "base_attack": 1, "damage_type": "physical", "armor_defense": 10, "attack_speed": 90, "attack_wait": 45, "attack_interval": 261, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157040, "race_id": 16, "special_effect_id": 1894, "change_to": 2, "master_id": 38036, "global_id": 11653, "to_global_id": 11654, "from_flag": [1, 1], "to_flag": [2, 1]}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 5, "hp": 10000, "attack": 1, "base_hp": 10000, "base_attack": 1, "damage_type": "physical", "armor_defense": 10, "attack_speed": 90, "attack_wait": 45, "attack_interval": 261, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157040, "race_id": 16, "special_effect_id": 1895, "change_to": 3, "master_id": 38037, "global_id": 11654, "to_global_id": 11655, "from_flag": [2, 1], "to_flag": [3, 