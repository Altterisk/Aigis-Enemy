"attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 19, "special_effect_id": 1039, "change_to": 12, "master_id": 38066, "global_id": 11683, "to_global_id": 11682, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 285}, {"enemy_id": 23, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 19, "special_effect_id": 1039, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 38065, "global_id": 11682, "ranged": true}], "popups": ["ホルミースの影響により\n天使と天界兵は、\n攻撃と防御がアップします。\n\nこの効果はミッションの\n時間が経過するほど\n強力になります。", "各種天界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。", "天槍騎兵団は突撃中、\nブロックすると、\n一度だけ強力な攻撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アリア", "text": "――全周警戒！\nみんな、油断しないで。\n敵には「神の力」を与える術者が残っている！", "face": "u2293a1"}, {"name": "ホルミース", "text": "あらあら、騒々しいお客さんですね。\nそんなに警戒しなくても、こちらから出ていきますよ？", "face": "u2292a1"}, {"name": "コハル", "text": "竪琴……？\nへぇ、こんな戦場で詩人気取りかい？", "face": "u450"}, {"name": "アミー", "text": "あたしたちも他人のこと言えないですけどね！\n……それにしても、あたし、\nあの人のことは知ってるかもしれません。", "face": "u2260a1"}, {"name": "リーナ", "text": "お知り合い、ですか？", "face": "u521"}, {"name": "アミー", "text": "詩人の間じゃ有名な噂話でして。\nあらゆる戦場にふらりと現れ、\nただ詩を記録して立ち去っていく、正体不明の女。", "face": "u2260a1"}, {"name": "アミー", "text": "容姿も持ってる楽器も、噂とぴったり一致です。\n――歴史の観測者、ホルミース！", "face": "u2260a1"}, {"name": "ホルミース", "text": "おやおや、その語り口では、\nまるで戦場を詩にすることにしか興味のない、\n人でなしみたいじゃないですか。", "face": "u2292a1"}, {"name": "コハル", "text": "事実、だろう？\n人の心がないとは言わないが、\nお前さんからは、どこか道から外れたものを感じるよ。", "face": "u450"}, {"name": "ホルミース", "text": "おや、人でなしの猫又さんに言われてしまいました。\nふふっ……でも確かに、私よりも\nコハルさんの方がよほど人間らしいかもしれません。", "face": "u2292a1"}, {"name": "ホルミース", "text": "ですが、人には領分というものがあるでしょう？\n戦うのは戦士の領分、\n人の歴史を紡ぐことこそ、詩人の領分。", "face": "u2292a1"}, {"name": "コハル", "text": "さて、それはお前の言い分だろう？\n自由気ままに、\n音を奏でるのが好きなやつだっているさ。", "face": "u450"}, {"name": "ホルミース", "text": "――それゆえに、生命の自由意志を守るべく、\nあなた方はこの天空の果てまで来た。", "face": "u2292a1"}, {"name": "ホルミース", "text": "とても素晴らしいことです。\nこの場所に立ち会えたこと、心の底から嬉しく思います。", "face": "u2292a1"}, {"name": "ホルミース", "text": "ただ、私もひとつくらい、\n義理というものを果たさねばならないので。", "face": "u2292a1"}, {"name": "ヘルメルク", "text": "よく言うよ。\n君のどこに義理なんて言葉があるのさ。", "face": "u2275a1"}, {"name": "ホルミース", "text": "ふふ、ありますとも。\n私は詩人ですから、\nいただいた料金分は歌っていくものです。", "face": "u2292a1"}, {"name": "ヘルメルク", "text": "正直に言いなよ。\nここで時間を稼いだ方が、\nより面白い物語になるからだってさ。", "face": "u2275a1"}, {"name": "ホルミース", "text": "それは、ちょっと心外です。\n裏切り者同士、仲良くしましょうよ。\n――まぁ、私が裏切るのはこの後の予定なのですが。", "face": "u2292a1"}, {"name": "アリア", "text": "話が通じない……。\nいえ、話に一貫性がありすぎてむしろ困る……？", "face": "u2293a1"}, {"name": "アリア", "text": "とにかく、こんなところで\n足止めを食らっている時間はありません。\n王子、実力で突破しましょう！", "face": "u2293a1"}, {"name": "ホルミース", "text": "えぇ、どうか全力で。\n私もこの歌をもって応えましょう。", "face": "u2292a1"}, {"name": "アミー", "text": "ふんっ、歌合戦と来れば応じましょう！\n王子、ここなら外と違って空気の心配はいりません！\n地上と同じく全力で演れますよ！", "face": "u2260a1"}, {"name": "ホルミース", "text": "――それでは一曲、お付き合いください。", "face": "u2292a1"}]}, {"trigger": "end", "lines": [{"name": "ラピス", "text": "……気はすんだか？", "face": "u436"}, {"name": "ホルミース", "text": "えぇ、十分に歌わせていただきました。\nそれでは、この先へどうぞ。", "face": "u2292a1"}, {"name": "ラピス", "text": "変な女だ、まったく。\n殺意も感じないし、足止めしようという気迫もない。", "face": "u436"}, {"name": "ホルミース", "text": "あなたも似たようなものでしょう。\n人類に興味、ないのでは？", "face": "u2292a1"}, {"name": "ラピス", "text": "侮るな。\n最近は興味が出てきた。\nそれに、接し方を知らなかっただけだ。", "face": "u436"}, {"name": "ホルミース", "text": "おや、それは失礼しました。\nでは似たもの同士かもしれませんね。", "face": "u2292a1"}, {"name": "ラピス", "text": "……私に懐いたりするな。\nそれで、この先にもついて来るんだろう？\nどちらで戦うつもりなんだ？", "face": "u436"}, {"name": "ホルミース", "text": "場合によっては、ここで殺すと？", "face": "u2292a1"}, {"name": "ラピス", "text": "私は、あいつが目指す人類の未来とやらを、\n守ってやりたいと思っている。\nそのために必要なら、多少は手を汚すことも厭わない。", "face": "u436"}, {"name": "ホルミース", "text": "今のセリフ、いただきました。\nおっと、返事をしないと殺されてしまいますね。\nこれでディアス様への義理は果たしましたので――", "face": "u2292a1"}, {"name": "ラピス", "text": "……違うな。", "face": "u436"}, {"name": "ホルミース", "text": "はい？", "face": "u2292a1"}, {"name": "ラピス", "text": "お前の歌は、崇める神のためのものではなかった。\n己の使命に殉じた男への、鎮魂歌に聞こえた。", "face": "u436"}, {"name": "ラピス", "text": "不器用な男だったが、ちゃんと仲間はいたんだな。\n私はそういう心の機微とか、よくわからないが……。\nたぶん、届いたんじゃないか？", "face": "u436"}, {"name": "ホルミース", "text": "……ふふっ、はい。", "face": "u2292a1"}, {"name": "アルティア", "text": "――ラピス！　急いでください！\nこんな天空の果てではぐれたら大変ですよ！", "face": "u261"}, {"name": "ラピス", "text": "ん、分かった。\nでは、待つつもりはないが、来るなら勝手に来い。", "face": "u436"}, {"name": "ホルミース", "text": "はい、名場面を見逃すつもりはありませんから。", "face": "u2292a1"}, {"name": "ホルミース", "text": "（……面白い人でした。\nあの人のことも、後で歌にしましょう）", "face": "u2292a1"}, {"name": "ホルミース", "text": "（けれど、他人を理解することは、\nまだまだ苦手なようですね……。\nだって私の奏でたあの歌は、鎮魂歌などではなく――）", "face": "u2292a1"}, {"name": "ホルミース", "text": "――戦い抜いた英雄を\n称えるための歌、でしたから。", "face": "u2292a1"}]}], "active": true}