pe": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "master_id": 74, "global_id": 73, "spawn_sec": 103}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 103}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 8, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 154}, {"enemy_id": 12, "source": "local", "count": 12, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 156}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 717, "global_id": 716, "spawn_sec": 158}, {"enemy_id": 14, "source": "local", "count": 6, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 162}], "popups": ["くぐつに搭乗した\nメカゴブリンクイーンの\n一定範囲内の味方ユニットは\n継続ダメージを受けます。\n\nまた、倒されると1回のみ修理を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "メカゴブリンクイーン", "text": "――あら？\nここまで追ってくるだなんて、\nどうして生き埋めになっていないのかしら。", "face": "lda00e82b435a"}, {"name": "マイン", "text": "あんな崩落くらい楽勝だってんだ！\nさぁ『浮遊石』を返してもらうぜ！！", "face": "u672"}, {"name": "メカゴブリンクイーン", "text": "ウフフ、いつまで強気な口をきいていられるかしら。\nアナタの事は気に入ったけれど、\n今度は本当にさよならよ。――来なさいッ！！", "face": "lda00e82b435a"}]}, {"trigger": "start", "lines": [{"name": "エレイン", "text": "な、何あの大型の飛行くぐつ……！？", "face": "u36"}, {"name": "メカゴブリンクイーン", "text": "オーッホッホ！　これこそ『浮遊石』を用い、\n強化された、私専用の新型飛行くぐつ！\n私の炎で焼き尽くされるがいいわ！", "face": "lda00e82b435a"}, {"name": "アンナ", "text": "あのような兵器に悪用するため、\nゴブリンたちは『浮遊石』を盗掘していたのですね……。\n王子、ゴブリンたちを止めましょう！", "face": "l031151a3e8d0"}]}, {"trigger": "end", "lines": [{"name": "メカゴブリンクイーン", "text": "くっ……まだ出力が足りていないわね……ッ！", "face": "lda00e82b435a"}, {"name": "マイン", "text": "ふんっ、てめぇの腕が悪いんだよ！！\nさぁ『浮遊石』を返してもらうぜ！！", "face": "u672"}, {"name": "メカゴブリンクイーン", "text": "ウフ、ウフフ……オーッホッホッホ！！", "face": "lda00e82b435a"}, {"name": "マイン", "text": "なんだよ、何がおかしいってぇんだ！！", "face": "u672"}, {"name": "メカゴブリンクイーン", "text": "王子に小生意気な娘、\n確かにアナタたちには一杯食わされたわ。\nでもねぇ、勝ったのは私の方よ！！", "face": "lda00e82b435a"}, {"name": "メカゴブリンクイーン", "text": "私自らがアナタたちを足止めしていたと、\n気付かないのかしら、お馬鹿さぁん！　『浮遊石』を持った\n部隊が逃げる時間は、十二分に稼がせてもらったわぁ。", "face": "lda00e82b435a"}, {"name": "グスタフ", "text": "足止めじゃと！？　ぬかったわ！\nメカゴブリンクイーン自ら時間稼ぎをするとは……ッ！", "face": "u153"}, {"name": "メカゴブリンクイーン", "text": "さぁ生き残りのゴブリンたちも撤退よ！\n戻ったら兵器の調整でこき使ってやるわ！", "face": "lda00e82b435a"}, {"name": "ゴブリン", "text": "ギャギャ！　テッタイ！　テッタイ！", "face": "l3c6204d81c07"}, {"name": "マイン", "text": "あっ、おい待ちやがれ！\n空飛ぶなんて卑怯だぞてめぇーッ！！", "face": "u672"}, {"name": "アンナ", "text": "申し訳ありません、王子。\nメカゴブリンクイーンの逃走を許した上、\n『浮遊石』も大部分が持ち去られてしまいました。", "face": "lce3866b60bb0"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ケイティ", "text": "それに、ゴブリン博士が不在だったことも、\nやはり気になりますね……。", "face": "u114"}, {"name": "アンナ", "text": "今後はより一層、\nゴブリン軍団への警戒が必要ですね。\n王子、ひとまずティニーさんの所へ戻りましょう。", "face": "l031151a3e8d0"}]}, {"trigger": "route", "enemy_ids": [6], "lines": [{"name": "マイン", "text": "空が突然暗く……って、\nおい王子、向こうの空から何か来るぞ！", "face": "u672"}, {"name": "メカゴブリンクイーン", "text": "ウフフフフッ！　冥土の土産に、\n私たちが『浮遊石』を集めていた\n真の理由も教えてあげるわぁ！", "face": "lda00e82b435a"}, {"name": "メカゴブリンクイーン", "text": "これこそ試作ゴブリン浮遊戦車！\n『浮遊石』のおかげで頑丈で壊れにくく、\nさらに爆弾も山程搭載することが可能なのよ！", "face": "lda00e82b435a"}, {"name": "ケイティ", "text": "浮遊戦車……！　どうやら空から多数の目標に向けて、\n爆撃を行うつもりのようですね……。\n王子、浮遊戦車の攻撃範囲には十分な警戒を！", "face": "u114"}]}], "active": true}