"move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 349, "global_id": 348, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 5, "form_count": 2, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104832, "race_id": 7, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 576, "global_id": 575, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 576, "spawn_sec": 30}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349, "spawn_sec": 37}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 1100, "base_hp": 30000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 50, "attack_speed": 60, "attack_wait": 80, "attack_interval": 286, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2104864, "race_id": 3, "special_effect_id": 65, "master_id": 581, "global_id": 580, "spawn_sec": 70}], "popups": ["魔神ウェパルの\n一定範囲内のユニットは\n敵ユニットから受けたダメージが\n２倍になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "とりあえず、岸に戻ることができましたね。\nサブリナさんは大丈夫でしょうか……。", "face": "la802a40c027c"}, {"name": "マーマン", "text": "人間どもめ……。\nまだ終わってないぞ……！\n我らには、魔神ウェパル様がついている！", "face": "l4900ebc0bb16"}, {"name": "マーマン", "text": "王子の魂なぞなくとも、\n下等な魂を大量に使えば完全体でなくとも、\nウェパル様を復活させる事はできるのだ！", "face": "l4900ebc0bb16"}, {"name": "アンナ", "text": "魔神が復活してしまった……！？\nまさかサブリナさんは仲間を助ける事が\n出来なかったというのですか……？！", "face": "lfdc346bbb16b"}, {"name": "サブリナ", "text": "海の平和は、私がまもーる！！\nマーマン達！　ざーんねんだったわね♪\n仲間達はとっくに助け出させてもらったわ！", "face": "u332"}, {"name": "マーマン", "text": "な……！　貴様……裏切ったというのか！！\nくっそぉぉおッ！\n我らが下等な人間ごときにぃ……っ！", "face": "l4900ebc0bb16"}, {"name": "マーマン", "text": "許さん……。\nぜったいに許さんぞぉぉおお！", "face": "l4900ebc0bb16"}, {"name": "サブリナ", "text": "王子クン待たせたわね！\n仲間は全員解放したわ！　これで心置きなく\n王子クン達の味方ができるわよ！", "face": "u332"}, {"name": "ユリアン", "text": "まったく、本当なのかよ？\nまた裏切るんじゃないだろうな？！", "face": "u7"}, {"name": "サブリナ", "text": "そりゃあそうよね。\nすぐには信じてもらえないよね？", "face": "u332"}, {"name": "サブリナ", "text": "言ってもだめならまずやってみろ！\nこれぞサブリナ私掠船団の鉄則！\n嫌がられても王子クン達に加勢するわよ！", "face": "u332"}, {"name": "アンナ", "text": "王子、サブリナさん！\nマーマン達が向かってきます……！\n迎撃の準備を！", "face": "lfdc346bbb16b"}]}, {"trigger": "battle", "at_sec": 80, "lines": [{"name": "ユリアン", "text": "なんだ、あの異様な化け物は……。", "face": "u7"}, {"name": "マーマン", "text": "ふはははは！\nあの方こそが、魔神ウェパル様だ。\n人間どもよ、恐怖するがいい。", "face": "l4900ebc0bb16"}, {"name": "サブリナ", "text": "そんな……。\nまさか、王子クン死んじゃったの！？", "face": "u332"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "サブリナ", "text": "あ、いたのね。\nご、ごめんなさい、悪気はないのよ……？\nでも……じゃあ、一体どうして……。", "face": "u332"}, {"name": "マーマン", "text": "魔神ウェパル様に捧げられた人間どもの魂は、\nすでに復活するには充分ではあったのだ。", "face": "l4900ebc0bb16"}, {"name": "マーマン", "text": "だが、ウェパル様が完全なお姿を取り戻すには\n魂の数が不足していた。女神の加護を持つ王子\n一人の魂で補填する方が楽だったというだけの話だ。", "face": "l4900ebc0bb16"}, {"name": "マーマン", "text": "我らの絶対神であらせられる\n魔神ウェパル様であれば、\n不完全だろうと人間を殺し尽くすには十分よ！", "face": "l4900ebc0bb16"}, {"name": "サブリナ", "text": "……参ったなぁ。\nまさか魔神が復活しちゃうなんてねー。\n私の人生ここで終わりかなぁ……。", "face": "u332"}, {"name": "サブリナ", "text": "ねえ王子クン？　もしこの窮地を脱して無事に\n生還できたらさ、私たち王子クンの国の\n私掠船団になってもいいかな？", "face": "u332"}, {"name": "サブリナ", "text": "ううん。絶対なる！　もう決めた！\nだからさ、絶対に生きて帰ろうね！\nキミとなら魔神だって倒せるって信じられる。", "face": "u332"}]}, {"trigger": "end", "lines": [{"name": "マーマン", "text": "そんな……ウェパル様が……負ける？\n貴方様は私の唯一神……負けるなど……、\nあってはならない……あっては……。", "face": "l4900ebc0bb16"}, {"name": "ユリアン", "text": "おい。あの野郎、ウェパルの屍を抱えて\n海へ逃げていくぜ。これ以上は\n戦いじゃねえ。どうせ、何もできないだろう。", "face": "u7"}, {"name": "サブリナ", "text": "あの、王子クン……その、今までごめんなさい。\n本当に、私達は逆らうことができなかったの。\n仲間達は家族……見捨てるなんてできないわ。", "face": "u332"}, {"name": "アンナ", "text": "いえいえ。仲間を思う気持ちは、\n私達もとてもよくわかります。\nでは、サブリナさんも私達とともにお城へ――"}, {"name": "私掠船長の部下", "text": "――船長ぉ～～～～～～！\nやっと追いつきましたぜ！", "face": "u144"}, {"name": "サブリナ", "text": "あ、みんな……！　\nもう遅かったじゃない！\n心配したんだからね！", "face": "u332"}, {"name": "私掠船長の部下", "text": "へへへ！あっしらは大丈夫でさぁ。\nなんたってサブリナ船長の部下なんすよ！", "face": "u144"}, {"name": "私掠船長の部下", "text": "さーーって、船長！　\n早速サブリナ船団の再出発を祝って、\n恒例の乱痴気騒ぎといきましょうや！", "face": "u144"}, {"name": "サブリナ", "text": "再出発……。えと、その話なんだけど……、\n――いや、今はいいか！", "face": "u332"}, {"name": "サブリナ", "text": "とりあえず！\n私もみんなも疲れてるから、\n一度王子クンの所で休むことが先ね。", "face": "u332"}]}], "story_talk": true, "active": true}