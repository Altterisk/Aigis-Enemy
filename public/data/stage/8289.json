mage_type": "physical", "armor_defense": 350, "magic_defense": 5, "attack_range": 15, "attack_speed": 65, "attack_wait": 60, "attack_interval": 175, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.100000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2153840, "race_id": 2, "special_effect_id": 229, "change_to": 9, "change_condition": 4, "missile_id": 1086, "missile": {"speed": 1.0}, "master_id": 37569, "global_id": 11186, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 11187, "spawn_sec": 92}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 7000, "base_hp": 7000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 5, "attack_speed": 65, "attack_wait": 10, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.100000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2153856, "race_id": 2, "special_effect_id": 1179, "master_id": 37570, "global_id": 11187, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 11, "source": "local", "count": 11, "form_count": 1, "hp": 7000, "attack": 650, "base_hp": 7000, "base_attack": 650, "damage_type": "physical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 50, "attack_interval": 143, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137376, "race_id": 12, "change_to": 11, "change_condition": 1, "missile_id": 725, "missile": {"speed": 7.0, "splash": 120}, "master_id": 34963, "global_id": 8580, "ranged": true, "variants": [{"hp": 7000, "attack": 550, "base_hp": 7000, "base_attack": 550, "damage_type": "physical", "armor_defense": 150, "attack_speed": 20, "attack_wait": 10, "attack_interval": 83, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137520, "race_id": 12, "master_id": 34964, "global_id": 8581}], "route_behaviour": {"sets_flags": [[2, 1, 0], [1, 1, 0], [3, 1, 0]]}, "spawn_sec": 97}, {"enemy_id": 13, "source": "local", "count": 5, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "route_behaviour": {"sets_flags": [[1, 1, 0], [2, 1, 0]]}, "spawn_sec": 117}], "popups": ["スリーから受けたダメージは\n２倍になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ピューロ", "text": "海にいっぱいスイカが浮いてますー！", "face": "u1839a1"}, {"name": "副デーモンシェフ", "text": "事前に海水で冷やしておいたスイカが、\n騒動の余波で海に流れてしまったのです。\n……これを全て回収すれば良いのですね？", "face": "lba3493f7bf22"}, {"name": "ホルテウス", "text": "うむ、この我の見立てによれば、\n魔獣たちに統率された動きはない。", "face": "u1837a1"}, {"name": "ホルテウス", "text": "奴らを餌で釣って進路を誘導し、\n集まったところを一網打尽にする。", "face": "u1837a1"}, {"name": "ホルテウス", "text": "そのためには大量のスイカが必要だ。\n皆の者、急ぎスイカの回収作業に移れ。", "face": "u1837a1"}, {"name": "トゥアン", "text": "移れじゃねぇよ、お前も集めんだよ。", "face": "u2189a1"}, {"name": "ホルテウス", "text": "馬鹿め、我は女王であるぞ？\n頭脳労働担当に決まっているであろう。", "face": "u1837a1"}, {"name": "トゥアン", "text": "奇遇だな、あたしも女王なんだ。", "face": "u2189a1"}, {"name": "ホルテウス", "text": "向こうの者たちを見てみよ。\nせっせとスイカを回収しておる。\n汝らも見習って早く作業に──", "face": "u1837a1"}, {"name": "デーモンシェフ", "text": "待て、あれは我が社の従業員ではないぞ？", "face": "l993fb1fcf3bc"}, {"name": "スリー", "text": "よーし、お前らジャンジャン集めてけー。\n帰りの駄賃だ、ありったけ持って帰る──あ。", "face": "lce321327ba49"}, {"name": "コーネリア", "text": "……闇の組織の幹部が、コソコソとスイカ泥棒とはな。\n海の漢を名乗りながらよくもまあここまで堕ちたものだ。", "face": "u2179a1"}, {"name": "スリー", "text": "あ、いや、お嬢さん、これはだな……。", "face": "lce321327ba49"}, {"name": "海賊手下", "text": "テメェら、見損なうんじゃねぇ！\n船長は前々からこのリゾート地を狙ってたがなァ、\n思いのほか現地の環境がヤバくて日和っちまったんだよ！", "face": "u144"}, {"name": "スリー", "text": "フォローになってねぇぞオイ！？", "face": "lce321327ba49"}, {"name": "トゥアン", "text": "なんだ、日和ったのかよ？", "face": "u2189a1"}, {"name": "スリー", "text": "せっ、戦略的撤退と言ってもらいてぇところだなァ……！\nこんな馬鹿げた島に手下を送り込むわけにはいかねぇだろ？", "face": "lce321327ba49"}, {"name": "ラーワル", "text": "それは賢い選択だけど、泥棒は見過ごせないよね。\n悪いことばっかしてると嘘つきになっちゃうんだよ？", "face": "u2181a1"}, {"name": "スリー", "text": "ハッ、見つかっちまったもんは仕方がねェ！\n悪党だろうが、嘘つきだろうが上等じゃねぇか！\nカワイイお嬢ちゃんに追いかけられるのも悪くねェ！", "face": "lce321327ba49"}, {"name": "スリー", "text": "レディたち、オレを捕まえてごらん……？", "face": "lce321327ba49"}, {"name": "ラーワル", "text": "うへぇ。", "face": "u2181a1"}, {"name": "トロワ", "text": "オカシラ！　ドンビキ！　ドンビキ！", "face": "lf8bfaf54a96a"}, {"name": "ティルト", "text": "すごいな、驚くほど気勢が削がれたぞ。\nこの生理的嫌悪もあの男の作戦なのか？", "face": "u2187a1"}, {"name": "エマ", "text": "極めて卑劣で低俗な手ですが、効果的な戦術かと。\nやはり闇の組織の幹部、中々の策略家のようですね。", "face": "u2180a1"}, {"name": "海賊手下", "text": "ばっかオメェ、これが船長の素に決まって──", "face": "u144"}, {"name": "スリー", "text": "もういいよ！　もういいから戦おうや！", "face": "lce321327ba49"}]}, {"trigger": "end", "lines": [{"name": "ラーワル", "text": "必殺！　こっちくんなビーム！", "face": "u2181a1"}, {"name": "スリー", "text": "──グハァ！？", "face": "lce321327ba49"}, {"name": "海賊手下", "text": "船長ォ！？　ひでぇ、奴ら鬼かよ！？", "face": "u144"}, {"name": "スリー", "text": "フッ……ボロボロだぜ、身も心もな……。", "face": "lce321327ba49"}, {"name": "トロワ", "text": "アワレ！　アワレ！　サスガニアワレ！", "face": "lf8bfaf54a96a"}, {"name": "リムリィ", "text": "（なんとも惨めですが……不思議と惹かれませんねぇ……）", "face": "u2188a1"}, {"name": "スリー", "text": "オレのハートは深く傷ついたァ！\nってことでこのスイカは頂いていくぜェ！\nお前ら、一人一玉かっぱらっちまえ！", "face": "lce321327ba49"}, {"name": "海賊手下", "text": "いやっふー！", "face": "u144"}, {"name": "トゥアン", "text": "全然元気じゃねぇか！？", "face": "u2189a1"}, {"name": "ラーワル", "text": "待てー！　スイカ置いてけー！", "face": "u2181a1"}, {"name": "デーモンシェフ", "text": "いや、追う必要はないだろう。\nスイカの十や二十は渡してやってくれ、\n今はそれよりも大事なことがあるはずだ。", "face": "l993fb1fcf3bc"}, {"name": "アスバール", "text": "そうですね、今は魔獣の対処の方が先です。\n残りのスイカを集めて、早急に動きましょう。", "face": "u2184a1"}]}], "active": true}