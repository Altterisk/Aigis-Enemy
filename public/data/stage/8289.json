{"quest_id": 8289, "name": "スイカ泥棒", "description": "王子たちは騒動の余波で海に流された\nスイカの回収作業を開始。すると何故か\n闇の組織がスイカを集めていて……？\n上級（★１獲得の目安：平均Lv10）", "event": "サマーオブバーバリアンズ", "event_category": "History", "mission_id": 920217, "map_no": 4911, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "hp": 71000, "attack": 650, "base_hp": 71000, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 100, "attack_interval": 258, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2137440, "race_id": 16, "special_effect_id": 61, "change_to": 1, "missile_id": 723, "missile": {"speed": 12.0, "splash": 187}, "master_id": 34968, "global_id": 8585, "ranged": true, "to_global_id": 8586, "route_behaviour": {"transforms": [{"wait": 60}], "sets_flags": [[2, 1, 0]]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["ステルスII", "ブロック不可"], "hp": 71000, "attack": 650, "base_hp": 71000, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 259, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2137456, "race_id": 16, "special_effect_id": 86, "change_to": 2, "missile_id": 723, "missile": {"speed": 12.0, "splash": 187}, "master_id": 34969, "global_id": 8586, "to_global_id": 8589}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 71000, "attack": 650, "base_hp": 71000, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 100, "attack_interval": 258, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2137504, "race_id": 16, "special_effect_