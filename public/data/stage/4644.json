{"quest_id": 4644, "name": "魔の森のトレント", "description": "魔法に強い耐性を持つ\n魔の森固有種の木の魔物に注意せよ！\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "魔蝿の森と呪われた番人", "event_category": "History", "mission_id": 920072, "map_no": 3198, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "tags": ["植物"], "hp": 1300, "attack": 280, "base_hp": 1300, "base_attack": 280, "damage_type": "physical", "armor_defense": 100, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 131, "global_id": 130, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 250, "base_hp": 5500, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_range": 180, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106912, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 664, "global_id": 663, "ranged": true, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 13, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 6}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 1300, "attack": 150, "base_hp": 1300, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 130, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106896, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 666, "global_id": 665, "ranged": true, "spawn_sec": 8}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 33}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 44}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "tags": ["植物"], "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 667, "global_id": 666, "ranged": true, "spawn_sec": 71}], "dialogue": [{"trigger": "start", "lines": [{"name": "アイーダ", "text": "お前達のせいでベルゼビュート様の居場所が\n森の外の者達に知れ渡ってしまったんだぞ！\nどう責任をとるつもりなんだ！　答えろ！", "face": "u381"}, {"name": "教団員", "text": "王子軍を森に引き寄せてしまった事は詫びよう。\nだが、これもベルゼビュート様への信仰を\n世に広める為……仕方のないことだ。", "face": "lfc9619810aa7"}, {"name": "アイーダ", "text": "ベルゼビュート様に新たな僕などいらない。\n古くからお仕えする私達一族だけで十分だ。", "face": "u381"}, {"name": "教団員", "text": "そんな事を言っているから、\nベルゼビュート様がいつまで経っても\n復活できないということが分からないのか？", "face": "lfc9619810aa7"}, {"name": "アイーダ", "text": "どういうことだ……！？", "face": "u381"}, {"name": "教団員", "text": "お前ら一族のような少人数の信者だけでは、\nベルゼビュート様の糧とは成り得ないということだ。", "face": "lfc9619810aa7"}, {"name": "アイーダ", "text": "何だと……ッ！？\n新参者のくせに大きな口を叩きやがって……！\nこの森から早く出ていけ！", "face": "u381"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……やめないか、二人とも……。\n仲間割れをしている場合ではないだろう。\n見ろ、すぐそこまで敵は来ているぞ……ブブッ。", "face": "l60231936c46a"}, {"name": "アイーダ", "text": "先ほどの侵入者どもか。\nベルゼビュート様を何としても守らなくては……。\n一番の僕である私達が必ず奴らを討つ！", "face": "u381"}, {"name": "兵士", "text": "報告！\n前方に敵影を確認！", "face": "l408d498445ba"}, {"name": "アンナ", "text": "やはり来ましたね……。\n王子、戦いの準備をお願いします。", "face": "l80020749b988"}]}, {"trigger": "end", "lines": [{"name": "アイーダ", "text": "――くっ……そんな、二度も負けるなんて……。\nこれが、王子軍の力……なのか……。\nベルゼビュート様、すいません……。", "face": "u381"}, {"name": "アイーダ", "text": "……口惜しいが、ここは教団のヤツらに\n頼るしかないか……。", "face": "u381"}, {"name": "兵士", "text": "敵が退いていきます！", "face": "l408d498445ba"}, {"name": "アンナ", "text": "教団のヤツら……？\n彼女の一族以外にも、\nこの森に仲間がいるのでしょうか？", "face": "l80020749b988"}, {"name": "ケイティ", "text": "ベルゼビュートの伝承や、その強大な力を目当てに\n森の人間以外の者たちが流入した\n可能性は充分に考えられますが……。", "face": "u114"}, {"name": "バシラ", "text": "いずれにせよ、まだまだ気は抜けませんね……。\n王子、森の中の案内は引き続き任せてください！", "face": "u28"}]}], "active": true}