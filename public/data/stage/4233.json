d": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 42, "global_id": 41, "ranged": true, "spawn_sec": 86}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "hp": 13200, "attack": 550, "base_hp": 12000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 30, "attack_wait": 40, "attack_interval": 157, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099024, "race_id": 13, "special_effect_id": 220, "change_to": 9, "change_condition": 3, "master_id": 141, "global_id": 140, "to_condition": 3, "to_global_id": 141, "spawn_sec": 98}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 13200, "attack": 1210, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099040, "race_id": 13, "master_id": 142, "global_id": 141, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "トレントたちの動きが\n活発化しているようですね。", "face": "lbf1c7222647d"}, {"name": "ププル", "text": "わしの手から神樹の枝杖が離れて、\n時間がたっておる。", "face": "u225"}, {"name": "ププル", "text": "制御を失った枝杖はトレントたちに\n過剰な力を与えているようじゃ。\n回復力が上がっておるから注意せい。", "face": "u225"}, {"name": "ププル", "text": "それに、過剰に力を与えられた\n木々は、寿命が縮まってしまうのじゃ……。\nドルイドとして見過ごすわけにはいかん。", "face": "u225"}, {"name": "ププル", "text": "王子よ。わしは戦うことはできんが、\n巫女姫としてそなたたちの勝利を信じて\n祈っておる。絶対に勝ってくれ！", "face": "u225"}]}, {"trigger": "battle", "at_sec": 99, "lines": [{"name": "ダークエルフ", "text": "どうやら強力な援軍が来てくれたようだ。\nそこらの魔物とは一味違うぞ。", "face": "la905b4094ad4"}, {"name": "ププル", "text": "王子、気をつけい。\nダークエルフどもは\nマンティコアを連れてきおった。", "face": "u225"}, {"name": "ププル", "text": "あやつの麻痺攻撃には気をつけるんじゃ！\n体力を減らして弱らせてしまえば\n麻痺攻撃は使わなくなるはずじゃが……。", "face": "u225"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "ダークエルフたちの撤退を確認しました。\n王子、お疲れ様です。", "face": "lbf1c7222647d"}, {"name": "ププル", "text": "神樹の枝杖を取り戻した……！\nこれでトレントたちの暴走を止められる……。\nありがとう。感謝するぞ王子よ。", "face": "u225"}, {"name": "アンナ", "text": "これで妖精郷の混乱が収束しますね。\n良かった……。"}, {"name": "ププル", "text": "ふむ。これで妖精郷に平和がもどって……。", "face": "u225"}, {"name": "ププル", "text": "ってまだじゃ！　まだ終わらん！\nわしの怒りはやつらを焼き払うまでは拭えぬ！\n撤退したダークエルフを追うぞ！", "face": "u225"}, {"name": "ププル", "text": "二度と妖精郷に近づきたくなくなるよう、\n成敗してくれる！\nさぁ、王子よ。行くのじゃ！", "face": "u225"}, {"name": "アンナ", "text": "よっぽど寝込みを襲われたのが\n怖かったのですね……。", "face": "l5d6ee606b6c3"}]}], "active": true}