000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 228, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119360, "race_id": 7, "master_id": 31869, "global_id": 5488, "spawn_sec": 106}, {"enemy_id": 8, "source": "local", "count": 4, "level": 70, "form_count": 1, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349, "spawn_sec": 157}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "base_hp": 6000, "damage_type": "true", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 1, "attack_interval": 84, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2122064, "race_id": 3, "special_effect_id": 494, "master_id": 32431, "global_id": 6050, "spawn_sec": 178}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "tags": ["水中"], "hp": 25000, "attack": 1600, "base_hp": 25000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 150, "attack_interval": 358, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123680, "race_id": 7, "master_id": 32684, "global_id": 6302, "spawn_sec": 199}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 300000, "attack": 1200, "base_hp": 300000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 4000, "magic_defense": 5, "attack_range": 230, "attack_speed": 1, "attack_wait": 100, "attack_interval": 267, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123264, "race_id": 7, "change_to": 11, "change_condition": 1, "missile_id": 473, "missile": {"speed": 4.0, "splash": 133, "on_hit": {"kind": "攻撃遅延", "duration_f": 200, "attack_interval_f": 200, "effect_name": "HitEffectSlow"}}, "master_id": 32937, "global_id": 6554, "ranged": true, "variants": [{"tags": ["アーマー"], "hp": 300000, "attack": 9000, "base_hp": 300000, "base_attack": 9000, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 125, "attack_interval": 313, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123280, "race_id": 7, "master_id": 32938, "global_id": 6555}], "spawn_sec": 221}], "popups": ["　　　　【深海の水圧】\n・味方の攻撃後の待ち時間が増加\n・ユニット配置後、一定時間経過で\n　継続ダメージが発生\n\n※これらは、風水使いなどがもつ\n　地形効果を軽減する能力では\n　軽減できません。", "サラタンの幼体から\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\nブロックされている間は、\n攻撃に遅延効果が無くなります。", "サラタンの成体から\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\nブロックされている間は、\n攻撃に遅延効果が無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "スカー", "text": "シャァァァァァック！！\nやってらんねェぜ！　あのクソ天使サマめ！！", "face": "l20b7674a66b9"}, {"name": "スカー", "text": "何が魚人たちのタメだッ！\nクラールフのクソ野郎に牙剥く\nイケテル野郎だと思ったら、とんだ詐欺師じゃねェか！", "face": "l20b7674a66b9"}, {"name": "スカー", "text": "何か憂さ晴らしを……って、アァン？\nなんだこのでっかい影は――って、グワァァァァ！？", "face": "l20b7674a66b9"}, {"name": "マルスィ", "text": "――と、水面から勢いよく飛び出して、\n遥か彼方にスカーさんが\nぶっ飛ばされたのが数日前のこと。", "face": "u1065a1"}, {"name": "セディナ", "text": "あんなデカイ鮫の魚人に殴り勝つなんて、\n海底にいったい何がいるんだろうね……。", "face": "u1095a1"}, {"name": "アンナ", "text": "ギガエルの軍勢との戦いもありますし、\n可能な限り海底の危険は\n取り除いておきたいところですね……。", "face": "l9a7c79d45da3"}, {"name": "ヤマブキ", "text": "はぁ、今日はおいしいお鍋のはずだったのですが……。\n水中ではお鍋が作れないですよねぇ。", "face": "u1056a1"}, {"name": "オーガスタ", "text": "……東の国風に、おさしみという手もありますけどね。\nとはいえ調査が終わるまでは、\n豪勢なご飯とはいきませんね。", "face": "u960"}, {"name": "リバン", "text": "乾いた地のごはん、楽しみにしていたのですが……。\n――っと、あら……？\nなんだか海流が乱れているような……。", "face": "u1062a1"}, {"name": "セディナ", "text": "本当だ……すごい大きなものが動いてる気がする！", "face": "u1095a1"}, {"name": "マルスィ", "text": "うわっとっとっと。\n海流の乱れのせいで、興奮した魚も出てきました！", "face": "u1065a1"}, {"name": "リバン", "text": "深海での戦闘では、水圧に気をつけてくださいまし。\n乾いた地の方々は徐々に身体に負荷を受けますし、\n動きが鈍って攻撃が遅くなってしまいますから。", "face": "u1062a1"}, {"name": "マルスィ", "text": "王子様、すぐそこまで魚の群れと、\n何だか巨大な気配が迫ってますよ！\n迎撃の準備をお願いします！！", "face": "u1065a1"}]}, {"trigger": "end", "lines": [{"name": "オーガスタ", "text": "……まさか深海でサラタンと遭遇するとは。", "face": "u960"}, {"name": "ヤマブキ", "text": "海面だけじゃなく、深海でも活動できたんですね。\nさすがは伝説の巨大カニです……。", "face": "u1056a1"}, {"name": "マルスィ", "text": "でもこれで、謎の巨大生物の件は解決ですね♪", "face": "u1065a1"}, {"name": "セディナ", "text": "地上に戻って、砂浜でおいしいごはんだね！", "face": "u1095a1"}, {"name": "アンナ", "text": "兵にも休息が必要ですからね。\nそれでは王子、地上に帰還しましょうか。", "face": "ld3cabc17279a"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "スカー", "text": "――ゼェ！　ハァ！\nクソッ、エラ呼吸が苦しいゼ……。", "face": "l20b7674a66b9"}, {"name": "スカー", "text": "テメェ！　このサラタン！\nリベンジマッチに来たぞ――って、アァン？", "face": "l20b7674a66b9"}, {"name": "スカー", "text": "サラタァァァァァン！！\nどこに逃げやがったァ！？\nシャァァァァァァァック！！", "face": "l20b7674a66b9"}]}], "active": true}