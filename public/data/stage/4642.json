{"quest_id": 4642, "name": "狙われた虎姫", "description": "空中を自在に浮遊する\n屍解仙の動きに注意し、\n虎姫を助け出せ！\n神級（★１獲得の目安：平均Lv50）", "event": "邪仙郷の罠", "event_category": "History", "mission_id": 920071, "map_no": 3721, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 25, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106672, "master_id": 842, "global_id": 841, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 21, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106688, "master_id": 849, "global_id": 848, "spawn_sec": 88}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 40, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105776, "race_id": 16, "master_id": 719, "global_id": 718, "spawn_sec": 120}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 45000, "attack": 500, "base_hp": 45000, "base_attack": 500, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 200, "attack_speed": 30, "attack_wait": 10, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106736, "special_effect_id": 229, "missile_id": 6, "master_id": 855, "global_id": 854, "ranged": true, "spawn_sec": 146}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 231, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106768, "master_id": 856, "global_id": 855, "spawn_sec": 148}], "dialogue": [{"trigger": "start", "lines": [{"name": "屍解仙", "text": "カッカッカッ。\nまさか、王子の元に身を寄せているとはのぅ、虎姫。", "face": "lac467bfee065"}, {"name": "メイリン", "text": "屍解仙……！\nなんでこんな所に……！", "face": "u380"}, {"name": "屍解仙", "text": "どっかで野垂れ死んでおるかと、\n心配しておったが、元気そうで何よりじゃ！", "face": "lac467bfee065"}, {"name": "屍解仙", "text": "さて、今日はお前を迎えにきたのじゃ、虎姫。\n仙人の才能のないお前でも役に立てる事が\nあるのじゃ……。　さぁこっちへ来い！", "face": "lac467bfee065"}, {"name": "メイリン", "text": "い、痛い！！\n手を放して！\nもうメイリンは邪仙郷の人達と関わりたくないの！", "face": "u380"}, {"name": "アンナ", "text": "――メイリンさん！？", "face": "l2e51ace5ef66"}, {"name": "屍解仙", "text": "ふむ。\n邪魔が入ってしもうたか……。\nまぁよい、まとめて相手にしてやろう。", "face": "lac467bfee065"}, {"name": "アンナ", "text": "王子、戦闘のご準備を！\n屍解仙からメイリンさんを取り戻しましょう！", "face": "l2e51ace5ef66"}]}, {"trigger": "end", "lines": [{"name": "屍解仙", "text": "……ちィッ！？　なかなかどうしてやりよるわい。\n虎姫め、新しいキョンシーの製作にうってつけの\n素材だったのじゃが……。", "face": "lac467bfee065"}, {"name": "屍解仙", "text": "ここは一旦退くしかあるまい……さらばじゃ。", "face": "lac467bfee065"}, {"name": "ユリアン", "text": "おい、また逃げるのか、屍解仙！？\n最後まで戦えってんだ！\n……くそ、見失っちまったか。", "face": "u7"}, {"name": "アンナ", "text": "今は屍解仙を退けられただけでも良しとしましょう。\nそれよりもメイリンさんが無事で何よりです。", "face": "l2e51ace5ef66"}, {"name": "メイリン", "text": "……あ、ありがとう。\nメイリンなんかの為に……駆けつけてくれて。\n本当に、ありがとう……。", "face": "u380"}, {"name": "アンナ", "text": "いえいえ！　メイリンさんは大事な仲間ですから。\nさぁ、皆さんそれでは帰還しましょう。\nこの度の戦い、本当にお疲れ様でした。"}]}], "active": true}