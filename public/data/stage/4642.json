{"quest_id": 4642, "name": "狙われた虎姫", "description": "空中を自在に浮遊する\n屍解仙の動きに注意し、\n虎姫を助け出せ！\n神級（★１獲得の目安：平均Lv50）", "event": "邪仙郷の罠", "event_category": "History", "mission_id": 920071, "map_no": 3721, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 25, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106672, "master_id": 842, "global_id": 841, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 21, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106688, "master_id": 849, "global_id": 848, "spawn_sec": 88}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["女性"], "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 40, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105776, "race_id": 16, "master_id": 719, "global_id": 718, "spawn_sec": 120}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 45000, "attack": 500, "base_hp": 45000, "base_attack": 500, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 200, "attack_speed": 30, "attack_wait": 10, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106736, "special_effect_id": 229, "missile_id": 6, "master_id": 855, "global_id": 854, "ranged": true, "spawn_sec": 146}, {"enemy_id": 5, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 231, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106768, "master_id": 856, "global_id": 855, "spawn_sec": 148}], "dialogue": [{"trigger": "start", "lines": [{"name": "屍解仙", "text": "カッカッカッ。\nまさか、王子の元に身を寄せているとはのぅ、虎姫。", "face": "lac467bfee065"}, {"name": "メイリン", "text": "屍解仙……！\nなんでこんな所に……！", "face": "u380"}, {"name": "屍解仙", "text": "どっかで野垂れ死んでおるかと、\n心配しておったが、元気そうで何よりじゃ！", "face": "lac467bfee065"}, {"name": "屍解仙", "text": "さて、今日はお前を迎えにきたのじゃ、虎姫。\n仙人の才能のないお前でも役に立てる事が\nあるのじゃ……。　さぁこっちへ来い！", "face": "lac467bfee065"}, {"name": "メイリン", "text": "い、痛い！！\n手を放して！\nもうメイリンは邪仙郷の人達と関わりたくないの！", "face": "u380"}, {"name": "アンナ", "text": "――メイリンさん！？", "face": "l68d23b557d5d"}, {"name": "屍解仙", "text": "ふむ。\n邪魔が入ってしもうたか……。\nまぁよい、まとめて相手にしてやろう。", "face": "lac467bfee065"}, {"name": "アンナ", "text": "王子、戦闘のご準備を！\n屍解仙からメイリンさんを取り戻しましょう！", "face": "l68d23b557d5d"}]}, {"trigger": "end", "lines": [{"name": "屍解仙", "text": "……ちィッ！？　なかなかどうしてやりよるわい。\n虎姫め、新しいキョンシーの製作にうってつけの\n素材だったのじゃが……。", "face": "lac467bfee065"}, {"name": "屍解仙", "text": "ここは一旦退くしかあるまい……さらばじゃ。", "face": "lac467bfee065"}, {"name": "ユリアン", "text": "おい、また逃げるのか、屍解仙！？\n最後まで戦えってんだ！\n……くそ、見失っちまったか。", "face": "u7"}, {"name": "アンナ", "text": "今は屍解仙を退けられただけでも良しとしましょう。\nそれよりもメイリンさんが無事で何よりです。", "face": "l68d23b557d5d"}, {"name": "メイリン", "text": "……あ、ありがとう。\nメイリンなんかの為に……駆けつけてくれて。\n本当に、ありがとう……。", "face": "u380"}, {"name": "アンナ", "text": "いえいえ！　メイリンさんは大事な仲間ですから。\nさぁ、皆さんそれでは帰還しましょう。\nこの度の戦い、本当にお疲れ様でした。"}]}], "map": {"image": "Map920071_3721", "w": 960, "h": 640, "spots": [{"k": "b", "x": 935, "y": 169}, {"k": "b", "x": 936, "y": 314}, {"k": "b", "x": 936, "y": 468}, {"k": "m", "x": 208, "y": 283, "id": 200}, {"k": "m", "x": 241, "y": 472, "id": 201}, {"k": "m", "x": 423, "y": 313, "id": 202}, {"k": "m", "x": 260, "y": 209, "id": 203}, {"k": "m", "x": 160, "y": 134, "id": 204}, {"k": "m", "x": 593, "y": 463, "id": 205}, {"k": "m", "x": 589, "y": 321, "id": 206}, {"k": "m", "x": 380, "y": 385, "id": 207}, {"k": "m", "x": 747, "y": 311, "id": 208}, {"k": "m", "x": 413, "y": 458, "id": 209}, {"k": "m", "x": 590, "y": 132, "id": 210}, {"k": "m", "x": 415, "y": 138, "id": 211}, {"k": "m", "x": 774, "y": 142, "id": 212}, {"k": "m", "x": 754, "y": 468, "id": 213}, {"k": "m", "x": 728, "y": 231, "id": 214}, {"k": "m", "x": 635, "y": 400, "id": 215}, {"k": "r", "x": 489, "y": 81, "id": 300}, {"k": "r", "x": 365, "y": 226, "id": 301}, {"k": "r", "x": 684, "y": 182, "id": 302}, {"k": "r", "x": 280, "y": 378, "id": 303}, {"k": "r", "x": 774, "y": 370, "id": 304}]}, "active": true}