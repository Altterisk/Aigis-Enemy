attack_wait": 25, "attack_interval": 87, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100400, "race_id": 16, "special_effect_id": 225, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 20042, "global_id": 1117, "ranged": true, "spawn_sec": 88}], "dialogue": [{"trigger": "start", "lines": [{"name": "ホルエス", "text": "ゆくのです！　呪われしマミーよ！", "face": "u149"}, {"name": "ホルエス", "text": "（この王国に恨みはありませんが、\n　祖国で待つ民のため……。\n　私が、生き残った私がやらないと……！）", "face": "u149"}, {"name": "アンナ", "text": "もう戦うのはやめてください！\n私たちが争う意味はないはずです！", "face": "l9d6a0fdd4bae"}, {"name": "ホルエス", "text": "戦いをやめる訳にはいきません！\n祖国で私の帰りを待つ民のためにも\n王子の命を頂きます！　覚悟……！", "face": "u149"}, {"name": "アンナ", "text": "帰りを待つ民のため……？\nなにやら訳ありのようですね。\nこの戦いに勝ち、お話を聞き出しましょう！", "face": "l9d6a0fdd4bae"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "魔法剣士さん……。\nあなたの国は魔物たちに滅ぼされたと\n聞いています。なぜその国の方が王子を？", "face": "lf1221dd6d909"}, {"name": "ホルエス", "text": "今は無き砂漠の王国。\n位が高い王族はすべて魔物に殺され、\n私は唯一生き残った存在です。", "face": "u149"}, {"name": "ホルエス", "text": "王国を占領した魔物に、\n『王子を倒す事ができれば王国を返す』と\n言われ、海を渡ってやってきました。", "face": "u149"}, {"name": "アンナ", "text": "魔物がそんな約束を守るとは……。", "face": "lf1221dd6d909"}, {"name": "ホルエス", "text": "分かっています……！\nしかし、王国の民が人質にとられている以上、\n従う事しかできないのです……。", "face": "u149"}, {"name": "アンナ", "text": "王子、砂漠の国の方たちをなんとか\n救う方法はないのでしょうか……？", "face": "l9d6a0fdd4bae"}, {"name": "アンナ", "text": "滅ぼされた国の人間同士が戦うなんて、\nあまりにも悲しいです……。", "face": "lf1221dd6d909"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "王子", "text": "アンナ、遠征の準備を。\n砂漠の国を救いに行く。", "face": "u1"}, {"name": "アンナ", "text": "ふふっ、王子ならばそう言うと\n思いました。準備が終わり次第向かいましょう。\n新たな敵が住む地、砂漠の国へ。"}, {"name": "レーヴ", "text": "…………困っている方を放ってはおけない。\nそれを当たり前のように行えてしまうのが、\n王子の凄さなのでしょうね。", "face": "u454"}, {"name": "レーヴ", "text": "ですが、くれぐれも気を付けて下さいね？\nそのような王子の優しさに付け込み、\n悪事を企む輩がいないとは限りません。", "face": "u454"}, {"name": "レーヴ", "text": "……え？　そんなことは慣れっこ？\nな、慣れてしまうほどに王子を騙そうとする\n者たちが沢山いるということですね……。", "face": "u454"}, {"name": "レーヴ", "text": "ですが、何度騙されようとも、助けを求める方々には救いの\n手を差し伸べられる様な、そんな強い人間になりたいです。\n……それでは、王子。次の記憶へと参りましょう！", "face": "u454"}]}], "active": true}