{"quest_id": 7474, "name": "常夏のグルメジャングル", "description": "グルメジャングルに到着！　まずはチームに\n分かれ食材集めを開始。我々は獲物を探す\nべくジャングルの奥地へと向かった。\n上級（★１獲得の目安：平均Lv10）", "event": "グルメジャングルは夏のち鮫", "event_category": "History", "mission_id": 920169, "map_no": 5949, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 190, "attack_interval": 442, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115088, "race_id": 11, "master_id": 31082, "global_id": 4701, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 2, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123904, "race_id": 2, "special_effect_id": 232, "change_to": 2, "change_condition": 4, "missile_id": 476, "master_id": 32700, "global_id": 6318, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6319, "spawn_sec": 44}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 87, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123920, "race_id": 2, "master_id": 32701, "global_id": 6319, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 850, "base_hp": 6500, "base_attack": 850, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131696, "race_id": 16, "change_to": 4, "change_condition": 2, "master_id": 34193, "global_id": 7810, "spawn_sec": 84}, {"enemy_id": 7, "source": "local", "count": 11, "form_count": 1, "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104640, "race_id": 16, "change_to": 7, "change_condition": 2, "master_id": 561, "global_id": 560, "spawn_sec": 90}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105328, "race_id": 16, "change_to": 9, "change_condition": 2, "master_id": 646, "global_id": 645, "spawn_sec": 117}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 350, "base_hp": 13000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2123152, "race_id": 16, "master_id": 32591, "global_id": 6209, "spawn_sec": 144}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 17000, "attack": 500, "base_hp": 17000, "base_attack": 500, "damage_type": "physical", "armor_defense": 420, "magic_defense": 15, "attack_speed": 1, "attack_wait": 15, "attack_interval": 69, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2123088, "race_id": 4, "special_effect_id": 130, "master_id": 32587, "global_id": 6205, "spawn_sec": 150}], "popups": ["ドラコラプトルは味方ユニットを\n発見すると、咆哮を行います。\n咆哮後、移動速度が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ルチア", "text": "──ここがグルメジャングルか。\n本当に、冬なのに夏のような気温だ。", "face": "u1395a1"}, {"name": "リーゼロッテ", "text": "さて、バカンスの前にまずは拠点の確保だな。\n付近の獣を狩りながら、水と食料を集めよう。", "face": "u1026a1"}, {"name": "ジークリンデ", "text": "提案だ。ただ集めるというのも面白くない。\nこれがルチアにとって演習の代わりになるのなら、\n何か競技的な要素を付与するべきではないか？", "face": "u1024a1"}, {"name": "ルチア", "text": "競技性か……。\n集めた食材の質と量で競争……などだろうか？\n安全のためにチームを作って手分けするとして──", "face": "u1395a1"}, {"name": "アナトリア", "text": "一位になれば一番良い肉が喰えるとくれば、\nそりゃ否が応でも燃えちまうんじゃないかねぇ？", "face": "u1250a1"}, {"name": "リーゼロッテ", "text": "決まりだな、それが後腐れもない。", "face": "u1026a1"}, {"name": "キュウビ", "text": "……また面倒なことになっておるのぉ。\n適当に真面目な連中についていくとするか。", "face": "u1022a1"}, {"name": "ラピス", "text": "(ルチアと同じチームに……いや、しかし)", "face": "u832"}, {"name": "リーゼロッテ", "text": "演習ほどの人数はいないし、気心の知れた仲だ。\n細かなルールは無用だろう、各自の良心を信じる。", "face": "u1026a1"}, {"name": "ルチア", "text": "なら早速、ハンティングスタートだな。", "face": "u1395a1"}]}, {"trigger": "battle", "at_sec": 86, "lines": [{"name": "ルチア", "text": "む、王子と狩場が被ってしまったな。\nしかし早い者勝ち、馬肉と竜肉は私たちが──", "face": "u1395a1"}, {"name": "ルチア", "text": "──あれ？　リーゼロッテさんは？", "face": "u1395a1"}, {"name": "リーゼロッテ", "text": "キュウビ様……そろそろ降りてもらえませんか？", "face": "u1026a1"}, {"name": "キュウビ", "text": "断る。わらわは歩きとうない、眠い。", "face": "u1022a1"}, {"name": "リーゼロッテ", "text": "……すまないルチア、先行してくれ。\nキュウビ様を起こして私も後から追いつく。", "face": "u1026a1"}, {"name": "ルチア", "text": "え、あ、はい、えーっと……いっ、行くぞ王子！", "face": "u1395a1"}]}, {"trigger": "end", "lines": [{"name": "ユッタ", "text": "はーいそこまでー！　第一ラウンド終了でーす！", "face": "u1228a1"}, {"name": "オーガスタ", "text": "食材の集計は炊事班が行いますので、\nチームごとに持って来てくださいねー！", "face": "u960"}, {"name": "ユッタ", "text": "いやぁ、すごいですねオーガスタさん。\nおいしそうなお肉がたくさんありますよ？", "face": "u1228a1"}, {"name": "オーガスタ", "text": "腕が鳴りますね、ユッタさん。\nグルメジャングル産のお肉は貴重ですから、\nこんなに新鮮なものは私も久しぶりです。", "face": "u960"}, {"name": "ルチア", "text": "むぅ、スタートダッシュは王子が先頭か？", "face": "u1395a1"}, {"name": "リーゼロッテ", "text": "まだまだ逆転の可能な範囲、ではあるが……。", "face": "u1026a1"}, {"name": "キュウビ", "text": "すぴー……すぴー……。", "face": "u1022a1"}, {"name": "ルチア", "text": "チームの主力がこの調子だと、厳しいな。", "face": "u1395a1"}, {"name": "メーア", "text": "──何やらお困りのようですね！", "face": "u1038a1"}, {"name": "ルチア", "text": "おっ、お前は──！？", "face": "u1395a1"}]}], "active": true}