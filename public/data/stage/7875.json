interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 275, "change_to": 36, "master_id": 35876, "global_id": 9493, "to_global_id": 9494}, {"enemy_id": 27, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 1259, "change_to": 37, "master_id": 35877, "global_id": 9494, "to_global_id": 9495}, {"enemy_id": 27, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 275, "change_to": 38, "master_id": 35878, "global_id": 9495}, {"enemy_id": 48, "source": "local", "count": 27, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142784, "race_id": 16, "missile_id": 831, "missile": {"speed": 4.0, "splash": 133}, "master_id": 35836, "global_id": 9453, "ranged": true, "spawn_sec": 206}], "popups": ["フェイロンは\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で２倍までアップ\n\n\n\n　　　　　　(1/2)", "また、フェイロンは一定確率で\n物理攻撃を回避します。\n\nさらに、フェイロンは\nHPが徐々に回復します。\n\n\n　　　　　　(2/2)", "華王、誅子は\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ\n\n\n\n　　　　　　(1/2)", "また華王、誅子は一定確率で\n物理攻撃を回避します。\n\nさらに、華王、誅子がいる間は\n全ての敵の攻撃と防御が\nアップします。\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "華王、誅子", "text": "――ここは、余の国である。\nまさか余を出し抜き、正門から抜けられると思ったか？", "face": "lc7f1b4d09516"}, {"name": "アイシャ", "text": "待ち伏せは最初から織り込み済み。\n誅子率いる華の国軍との激突は、\nどうあがいても一度だけは避けられない。", "face": "u181"}, {"name": "華王、誅子", "text": "ほう、この場所での戦闘は、\nむしろそちらが仕掛けたものだというのか。", "face": "lc7f1b4d09516"}, {"name": "アイシャ", "text": "当然だよ。\nボクを誰だと思っているの？", "face": "u181"}, {"name": "華王、誅子", "text": "伏龍の軍師、か。うむ、恐れ入った！\nだが、純粋な武力のぶつかり合いではどうだ？", "face": "lc7f1b4d09516"}, {"name": "華王、誅子", "text": "魔王を討ち、神とすら戦わんとする王国軍。\nされどその退路は絶たれ、\n本隊からも距離が離れた状態だ。", "face": "lc7f1b4d09516"}, {"name": "華王、誅子", "text": "――十天君の討伐は、我らが悲願。\n金光聖菩よ、その首討たせてもらうぞ！", "face": "lc7f1b4d09516"}, {"name": "太公望", "text": "さすがは華王、誅子。\n戦場に出ただけで、兵の士気が上がっています。", "face": "u603"}, {"name": "太公望", "text": "しかし、こちらは場数が違います。\n諦めず、抗い、戦わねばならなかった時に、\n引きこもっていた者との違いを見せてやりましょう。", "face": "u603"}, {"name": "華王、誅子", "text": "…………ッ！！\n太公望、その減らず口、徹底的に縫い合わせてやろうか！", "face": "lc7f1b4d09516"}, {"name": "清源妙道真君", "text": "また敵を煽って……。\nいや、むしろ本音を引き出すつもりなのでしょうか。", "face": "u866"}, {"name": "太公望", "text": "えぇ、失敗してしまいましたけど。\nどうやら真実を知るためには、\n聞忠を引きずり出さないといけないようで。", "face": "u603"}, {"name": "清源妙道真君", "text": "ならば、それまで勝ち続けなければ。\n王子殿、誅子の軍を蹴散らしますよ！！", "face": "u866"}]}, {"trigger": "end", "lines": [{"name": "フェイロン", "text": "…………くっ。\nこれでも届かないというのか！？", "face": "u1720a1"}, {"name": "竜吉公主", "text": "そちらも仙人を出したらどう？\n天の声だ何だと言っているの、どうせ聞忠なんでしょう？", "face": "u663"}, {"name": "聞忠", "text": "――言われずとも、姿くらい見せましょう。\n久しい顔ばかりですね。", "face": "l02a0871d84cb"}, {"name": "清源妙道真君", "text": "聞忠、いったい華の国に、\n何を吹き込んだのですか。", "face": "u866"}, {"name": "聞忠", "text": "吹き込んだとは人聞きの悪い。\nただ私は、天の声を伝えただけですよ。", "face": "l02a0871d84cb"}, {"name": "太公望", "text": "神――いいえ、亜神の声をですか。\nどこの者とも知れぬ声に惑わされ、\n挙句の果てに、主君の戦いに遅れ、敗北させるなど――", "face": "u603"}, {"name": "聞忠", "text": "――誅子は負けていませんッ！！", "face": "l02a0871d84cb"}, {"name": "聞忠", "text": "はぁ……相変わらず神経を逆撫でする仙人ですね……。\nしかし、勝機はこちらにあるのですよ。", "face": "l02a0871d84cb"}, {"name": "聞忠", "text": "聞きなさい、神仙郷の者たちよ。\nあなたたちが敬愛し、師事した偉大なる神仙。\n元始天尊は、こちらに味方しました。", "face": "l02a0871d84cb"}, {"name": "清源妙道真君", "text": "……は？　いったい何を――", "face": "u866"}, {"name": "聞忠", "text": "戦場は整いました。\nどうせ、あなたたちも来るつもりだったのでしょう？", "face": "l02a0871d84cb"}, {"name": "聞忠", "text": "――オリュンポス第二層、崑崙にて、\nあなたたちを待っていますよ。", "face": "l02a0871d84cb"}]}, {"trigger": "end", "lines": [{"name": "太公望", "text": "……聞忠、誅子、共に姿を消したようです。\nあれはもはや仙術などではない、\nそう……亜神の御業そのものですね……。", "face": "u603"}, {"name": "アンナ", "text": "オリュンポス……第二層、崑崙。\nまさか、亜神との戦いが、\n華の国にまで波及していたとは。", "face": "l5c2dd51ae9b9"}, {"name": "清源妙道真君", "text": "元より、オリュンポスには挑まねばならなかったのです。\n敵の手のひらで踊らされるのは癪ですが――", "face": "u866"}, {"name": "太公望", "text": "――どうせなら、存分に踊り尽くしてやりましょう。\nまずは作戦会議ですね。", "face": "u603"}]}], "active": true}