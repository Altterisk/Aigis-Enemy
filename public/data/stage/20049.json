"enemy_id": 21, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 250, "base_hp": 2000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 30692, "global_id": 4311, "ranged": true, "spawn_sec": 64}, {"enemy_id": 22, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100864, "race_id": 2, "change_to": 22, "change_condition": 2, "missile_id": 33, "missile": {"speed": 5.0}, "master_id": 285, "global_id": 284, "ranged": true, "to_condition": 2, "to_global_id": 285, "spawn_sec": 92}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100880, "race_id": 2, "missile_id": 34, "missile": {"speed": 5.0}, "master_id": 286, "global_id": 285, "ranged": true, "from_condition": 2}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["置物"], "fixture": true, "uncounted": true, "hp": 58000, "attack": 600, "base_hp": 58000, "base_attack": 600, "damage_type": "magical", "armor_defense": 600, "magic_defense": 80, "attack_range": 400, "attack_speed": 60, "attack_wait": 30, "attack_interval": 151, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174400, "race_id": 2, "change_to": 24, "master_id": 41299, "ranged": true, "to_condition": 0, "spawn_sec": 154}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物"], "fixture": true, "uncounted": true, "hp": 80000, "attack": 850, "base_hp": 80000, "base_attack": 850, "damage_type": "physical", "armor_defense": 900, "magic_defense": 80, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174432, "race_id": 2, "master_id": 41274, "from_condition": 0}], "dialogue": [{"trigger": "start", "lines": [{"name": "パルセ", "text": "竜都への接近に成功しました！\n王子、降下の準備をお願いします！", "face": "u2276a1"}, {"name": "ユリクセス", "text": "よし！　ドーンブリンガーは、降下を終えたら離脱を。\n今の状態で、空中戦まで任せるわけにはいかない。", "face": "u2193a1"}, {"name": "アカツキ", "text": "りょうかいでーす！\nむぅぅ、主砲さえ残っていればぁぁぁ……。", "face": "u2578a1"}, {"name": "アイシャ", "text": "うぅん、アカツキにはまだ重要な任務が残ってる。\n全部終わったあと、このお姫様を\n無事に地上に連れ帰る必要があるからね。", "face": "u181"}, {"name": "アンウェン", "text": "むっ……よいのか……？", "face": "u2934a1"}, {"name": "アキレア", "text": "こんな覚悟決まってるお姫様、\nここに残していったら国と心中しかねないだろ。", "face": "u1972a1"}, {"name": "アンウェン", "text": "ははっ、そんなことはせぬ。\nわらわには、竜ノ国なきあとの\nドラゴンたちを導く責任がある。", "face": "u2934a1"}, {"name": "アキレア", "text": "……どこの国も、姫サマってのは\n何もかも背負い込むものなのかねぇ。", "face": "u1972a1"}, {"name": "シビラ", "text": "…………？\nどうしてこちらを見ているの？", "face": "u1981a1"}, {"name": "アキレア", "text": "なんでもねぇよ！\nさぁ敵陣に乗り込むぜ！", "face": "u1972a1"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "アンウェン", "text": "――帰ってきた、な。\n今度はこの国を、攻め滅ぼす者として。", "face": "u2934a1"}, {"name": "サフレア", "text": "はい、姫様。\nどこまでもお供しましょう。", "face": "u2935a1"}, {"name": "アンウェン", "text": "うむ！　……ところでいまさらだが、\n王子よ、この決死の突撃部隊に、\n王族がぞろぞろと付いてきすぎではないか？", "face": "u2934a1"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "アンウェン", "text": "さも当然のような顔をしておる……。\nよいのか？　この竜都は、リヴァイアサンは、\n動力を失えば墜落するのだぞ？", "face": "u2934a1"}, {"name": "シビラ", "text": "これから一国の長との決戦に挑むのだもの。\n当然、高度に政治的な判断が必要になる、\nということもあるけれど……。", "face": "u1981a1"}, {"name": "シビラ", "text": "私たちの世界は、かつて一度滅びかけているの。\n魔王ガリウスとの戦いによってね。", "face": "u1981a1"}, {"name": "アンウェン", "text": "魔王……。", "face": "u2934a1"}, {"name": "シビラ", "text": "その戦いで、人類を導き、\n勝利をもたらした英雄王は、\nどんな戦場でも最前線に立っていたと伝えられているわ。", "face": "u1981a1"}, {"name": "シビラ", "text": "一度は滅びかけた世界。\n今存在している国は、多かれ少なかれ、\nいずれも英雄王の影響を強く受けているのよ。", "face": "u1981a1"}, {"name": "アンウェン", "text": "ふっ……ふふっ、そうか、ははっ、そうか！", "face": "u2934a1"}, {"name": "アンウェン", "text": "なぁサフレアよ、忘れていたな。\nかつてはわらわたちドラゴンも、\n猛威を振るう暴君として常に最前線にあったはず。", "face": "u2934a1"}, {"name": "アンウェン", "text": "それがどうして、空飛ぶ都市に引きこもる、\nこんなにも臆病な種族になってしまったのだろうなぁ！", "face": "u2934a1"}, {"name": "サフレア", "text": "……姫様。", "face": "u2935a1"}, {"name": "アンウェン", "text": "異世界の者たちのおかげで、目が覚めた。\n竜都は滅びぬ、たとえリヴァイアサンが堕ちるとも、\nわらわが必ず、別の形で竜ノ国を再建しよう。", "face": "u2934a1"}, {"name": "アンウェン", "text": "さぁ、祖国を尻尾で叩き飛ばして、目を覚まさせるぞ！", "face": "u2934a1"}]}, {"trigger": "battle", "at_sec": 154, "lines": [{"name": "サフレア", "text": "敵部隊、後退しました。\n……姫様。お怪我はありませんか？", "face": "u2935a1"}, {"name": "アンウェン", "text": "うむ、仔細ない。それにしても、\nお前含め、皆張り切りすぎではないか？", "face": "u2934a1"}, {"name": "サフレア", "text": "姫様の凱旋ですから。\n私にとって、仕えるべき先は国ではなく姫様です。", "face": "u2935a1"}, {"name": "アンウェン", "text": "……お前も変わり者だなぁ。\nまぁ、王国や天眼ノ国の連中もだが。", "face": "u2934a1"}, {"name": "セーラ", "text": "メイドは主人に似るそうですよ。", "face": "u2627a1"}, {"name": "サフレア", "text": "なるほど、至言ですね。", "face": "u2935a1"}, {"name": "アンウェン", "text": "お前たち結託しておるだろー！？\n前にも同じこと言っておったろー！？", "face": "u2934a1"}, {"name": "レヴィアタンの化身", "text": "……騒がしいですねぇ。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "どうした、賑やかなのは嫌いか？", "face": "u2941a1"}, {"name": "レヴィアタンの化身", "text": "いえ、慣れたものです。\n少し前には、私の身体の中で\n大暴れしていた方々もいましたし……。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "……嫌味か？\nどちらかというと、お前を守った側だが。", "face": "u2941a1"}, {"name": "レヴィアタンの化身", "text": "ふふふ。\nいつか文句を言ってやろうとは思っていましたが、\nお礼と一緒に相殺しておきましょう。", "face": "lfe7a12f0fc1b"}, {"name": "レヴィアタンの化身", "text": "――ただ、竜都の民には謝ることが。\nこの竜都の奥から、\n私に流れ込んでいたものと同種の魔力を感じるのです。", "face": "lfe7a12f0fc1b"}, {"name": "アンウェン", "text": "……そなたが魔力を吸ったから、\n竜都の天竜核が出力を落としていたと？", "face": "u2934a1"}, {"name": "レヴィアタンの化身", "text": "あくまで可能性ですが……。\nただ、私が吸ったというより、\n何者かによって流し込まれたような……。", "face": "lfe7a12f0fc1b"}, {"name": "アンウェン", "text": "気にするでない。\nそなたが望んでやったことではない。\nそれが分かれば十分だ。", "face": "u2934a1"}, {"name": "アンウェン", "text": "それに、いつかはこうなっていた。\n同じ世界におるのに、閉じこもったまま\n永遠を過ごせると思う方が間違いなのだ。", "face": "u2934a1"}, {"name": "アンウェン", "text": "レヴィアタン、異世界の竜都よ、\nわらわたち、ドラゴンの目を覚まさせるため、\nそなたの力を貸してくれ。", "face": "u2934a1"}, {"name": "レヴィアタンの化身", "text": "はい。契約者たるラピスも、\nいつになく乗り気な様子ですし。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "……わたしの何を知っているというんだ。\n出会ったばかりだぞ。", "face": "u2941a1"}, {"name": "レヴィアタンの化身", "text": "あなたの私生活は全部見ていましたよ？", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "くっ……。", "face": "u2941a1"}, {"name": "アンウェン", "text": "はははっ。\nまるでわらわとサフレアを見ているようだ。\n仲良きことはよいことよ！", "face": "u2934a1"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "――っ！？　今、頭上を何かが……！\n王子、戻ってきます！"}]}, {"trigger": "end", "lines": [{"name": "アングハラド", "text": "ほんの少し見ぬ間に、\n随分と仲間を増やしたようだな、アンウェン。", "face": "lc12185578db6"}, {"name": "アンウェン", "text": "……太守っ！！", "face": "u2934a1"}, {"name": "アングハラド", "text": "よくぞ戻った、アンウェン。敵としてだがな。\n……そして、王子よ。\n我が空へ踏み込んだ以上、逃げ帰れると思うな。", "face": "lc12185578db6"}]}], "map": {"image": "Map7525", "w": 960, "h": 640, "spots": [{"k": "b", "x": 39, "y": 417}], "events": [{"t": 8.4, "when": "time", "ops": [{"op": "+s", "name": "locPlc_200", "id": 200, "k": "m", "x": 168, "y": 369}, {"op": "+s", "name": "locPlc_201", "id": 201, "k": "m", "x": 253, "y": 309}, {"op": "+s", "name": "locPlc_202", "id": 202, "k": "m", "x": 249, "y": 221}, {"op": "+s", "name": "locPlc_300", "id": 300, "k": "r", "x": 227, "y": 457}, {"op": "+s", "name": "locPlc_301", "id": 301, "k": "r", "x": 360, "y": 459}, {"op": "+s", "name": "locPlc_302", "id": 302, "k": "r", "x": 442, "y": 492}, {"op": "+s", "name": "locPlc_303", "id": 303, "k": "r", "x": 772, "y": 302}, {"op": "+s", "name": "locPlc_304", "id": 304, "k": "r", "x": 671, "y": 191}, {"op": "+s", "name": "locPlc_305", "id": 305, "k": "r", "x": 425, "y": 213}, {"op": "+s", "name": "locPlc_203", "id": 203, "k": "m", "x": 494, "y": 316}, {"op": "+s", "name": "locPlc_204", "id": 204, "k": "m", "x": 603, "y": 324}, {"op": "+s", "name": "locPlc_205", "id": 205, "k": "m", "x": 708, "y": 441}, {"op": "+s", "name": "locPlc_206", "id": 206, "k": "m", "x": 646, "y": 475}, {"op": "+s", "name": "locPlc_207", "id": 207, "k": "m", "x": 758, "y": 477}, {"op": "+s", "name": "locPlc_208", "id": 208, "k": "m", "x": 700, "y": 510}, {"op": "+s", "name": "locPlc_209", "id": 209, "k": "m", "x": 849, "y": 243}, {"op": "+s", "name": "locPlc_210", "id": 210, "k": "m", "x": 289, "y": 113}, {"op": "+s", "name": "locPlc_211", "id": 211, "k": "m", "x": 415, "y": 132}, {"op": "+s", "name": "locPlc_212", "id": 212, "k": "m", "x": 566, "y": 131}, {"op": "+s", "name": "locPlc_213", "id": 213, "k": "m", "x": 681, "y": 103}]}, {"t": 153.4, "when": "time", "ops": [{"op": "-s", "name": "locPlc_200"}, {"op": "-s", "name": "locPlc_201"}, {"op": "-s", "name": "locPlc_202"}, {"op": "-s", "name": "locPlc_203"}, {"op": "-s", "name": "locPlc_204"}, {"op": "-s", "name": "locPlc_205"}, {"op": "-s", "name": "locPlc_206"}, {"op": "-s", "name": "locPlc_207"}, {"op": "-s", "name": "locPlc_208"}, {"op": "-s", "name": "locPlc_209"}, {"op": "-s", "name": "locPlc_210"}, {"op": "-s", "name": "locPlc_211"}, {"op": "-s", "name": "locPlc_212"}, {"op": "-s", "name": "locPlc_213"}, {"op": "-s", "name": "locPlc_300"}, {"op": "-s", "name": "locPlc_301"}, {"op": "-s", "name": "locPlc_302"}, {"op": "-s", "name": "locPlc_303"}, {"op": "-s", "name": "locPlc_304"}, {"op": "-s", "name": "locPlc_305"}]}]}, "active": true, "name_en": "Soaring Giant Ship, Operation to Storm the Dragon Capital", "description_en": "Alongside the Dragon Princess who vows to awaken her homeland, \nrepel the incoming swarm of dragons! <Bad weather: strong winds> Intermediate (★1 acquisition guide: Avg Lv1, 8 units deployed)"}