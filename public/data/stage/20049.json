{"quest_id": 20049, "name": "天翔ける巨艦、竜都突入作戦", "description": "祖国の目を覚ますと誓う竜姫と共に、 \n飛来するドラゴンの群れを打ち払え！\n＜悪天候：強風が発生＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["悪天候：強風が発生"], "event": "破滅のリヴァイアサン", "event_category": "Emergency", "mission_id": 200592, "map_no": 7525, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 200, "gold": 850, "drops": [{"card": 295, "c": 1}, {"card": 50, "c": 1}, {"card": 57, "c": 1}, {"card": 415}], "capacity": 8, "start_cost": 10, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["機械", "置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 1000000, "attack": 2000, "base_hp": 1000000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 1200, "magic_defense": 20, "attack_speed": 1, "attack_wait": 120, "attack_interval": 292, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2156752, "change_to": 1, "master_id": 38001, "global_id": 11618}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 50000, "attack": 1800, "base_hp": 50000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 25, "attack_speed": 10, "attack_wait": 10, "attack_interval": 59, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2174688, "race_id": 16, "change_to": 3, "master_id": 41290, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 4}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 50000, "attack": 1800, "base_hp": 50000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 25, "attack_speed": 10, "attack_wait": 10, "attack_interval": 59, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2174624, "race_id": 16,