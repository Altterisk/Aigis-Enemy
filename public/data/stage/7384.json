{"quest_id": 7384, "name": "ビフロストの手がかり", "description": "魔法都市で遺構ビフロストの調査を行う\n王子たちに天使の軍勢が襲い掛かる。\nミスリルゴーレムに注意しつつ敵を倒せ！\n上級（★１獲得の目安：平均Lv10）", "event": "隠されし叡智の園", "event_category": "History", "mission_id": 920165, "map_no": 5964, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 60000, "attack": 5200, "base_hp": 60000, "base_attack": 5200, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 60, "attack_speed": 200, "attack_wait": 80, "attack_interval": 531, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2100784, "race_id": 5, "special_effect_id": 242, "change_to": 1, "change_condition": 5, "master_id": 294, "global_id": 293, "to_condition": 5, "to_global_id": 294}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 60000, "attack": 3500, "base_hp": 60000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 60, "attack_range": 200, "attack_speed": 200, "attack_wait": 80, "attack_interval": 356, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2100800, "race_id": 5, "special_effect_id": 49, "change_to": 2, "change_condition": 1, "missile_id": 86, "missile": {"speed": 3.0, "splash": 133}, "master_id": 295, "global_id": 294, "ranged": true, "from_condition": 5, "variants": [{"hp": 60000, "attack": 5200, "base_hp": 60000, "base_attack": 5200, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 60, "attack_speed": 200, "attack_wait": 80, "attack_interval": 531, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2100784, "race_id": 5, "special_effect_id": 242, "master_id": 302, "global_id": 301}]}, {"enemy_id": 4, "source": "local", "count": 11, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 4, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 19}, {"enemy_id": 6, "source": "local", "count": 10, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 6, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 31}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 19, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 8, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 84}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107024, "race_id": 6, "master_id": 697, "global_id": 696, "spawn_sec": 141}, {"enemy_id": 11, "source": "local", "count": 7, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 11, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 142}], "popups": ["ミスリルゴーレムのHPを\n少しでも減らすと、強烈な\n遠距離攻撃をしてきます。\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "エルシャ", "text": "むむむむむ……。\n資料、見つかりませんねぇ。", "face": "u281"}, {"name": "メレディス", "text": "魔法都市の蔵書は膨大ですからね。\nそれに研究者たちが、\nそれぞれ自分のルールで書棚を整理していますから。", "face": "u400"}, {"name": "エルシャ", "text": "ちゃんと発行年代順にしてほしいですよね。", "face": "u281"}, {"name": "メレディス", "text": "……著者名順こそ至高ですよ？", "face": "u400"}, {"name": "ウズメ", "text": "……なるほど、調査が進展しない理由が\n目の前で実体験として理解できました。", "face": "u125"}, {"name": "エルシャ", "text": "でもまぁ、おおよその目星は付きました。\nこの資料室、他と比べて資料の年代がとても古いんです。", "face": "u281"}, {"name": "メレディス", "text": "この資料室の主だった魔術師は、\n古代――千年戦争前後から、\nそれ以前の時代を中心に研究していたのでしょう。", "face": "u400"}, {"name": "エルシャ", "text": "ビフロストに直接つながらずとも、\nその足がかりになる情報を必ず見つけてみせますとも！", "face": "u281"}, {"name": "ティール", "text": "――じゃあ、その時間稼ぎは\n私たちの出番ですねー？", "face": "u615"}, {"name": "ハーニィ", "text": "じかん、かせぎ？\n――って、わっ、わぁっ！？\nどうしてこんな所に天使が！？", "face": "u856"}, {"name": "ウズメ", "text": "――ビフロストには触れられたくない、\nと言ったところでしょうか。\n亜神ディアスの本音が垣間見えるかのようですね。", "face": "u125"}, {"name": "アイシャ", "text": "うん、ボクらが正しい道を進んでいる証左だよ。\nビフロストこそ、\nオリュンポスの結界を突破する手段ということさ。", "face": "u181"}, {"name": "アンリ", "text": "で、でも気をつけてくださいね！\nこの周辺には警備のミスリルゴーレムがいます。\n間違って攻撃すると反撃してきますから！", "face": "u571"}, {"name": "ティール", "text": "……間違えて殴っちゃったらごめんね？", "face": "u615"}, {"name": "アンリ", "text": "魔法都市の警備機構を破壊しようとしないでください！\nそれじゃあ王子さま、指揮はお任せしますね！", "face": "u571"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "天使の軍勢、撤退していきます。"}, {"name": "アイシャ", "text": "というより、こちらが手がかりを見つけたから、\nこれ以上の攻撃は無駄って考えたみたいだね。", "face": "u181"}, {"name": "エルシャ", "text": "――見つけました！\n見つけ、えっと、見つけたんですけどぉ……。\n……本当にこれ、あってるんでしょうか……。", "face": "u281"}, {"name": "フィグネリア", "text": "やけに自信がなさそうだけど、どうしたの？\nその資料、ちょっと見せてくれないかしら。", "face": "u18"}, {"name": "エルシャ", "text": "えぇとぉ……はい、これなんですけど……。", "face": "u281"}, {"name": "フィグネリア", "text": "なになに……？　これは探検記かしら……。\n北の大国を超えたさらに先……。\n豪雪地帯を抜けた先の――「叡智の園」？", "face": "u18"}, {"name": "シュシュ", "text": "えーちのその？\n聞いたことのない地名ですねぇ。", "face": "u656"}, {"name": "エルシャ", "text": "そうなんです。\n神話でも、伝承でも、地理的な情報でも、\nまったく一度も聞いたことのない地名で……。", "face": "u281"}, {"name": "ソラス", "text": "記録からも、記憶からも抹消された場所、ですか。\n確かに英傑の塔で眠っていた時にも、\nそんな情報は一切入ってきませんでしたね。", "face": "u904"}, {"name": "アンリ", "text": "千年戦争当時には存在しなかったのか、\n何らかの手段によって、\n存在自体を隠蔽しているということなのか……。", "face": "u571"}, {"name": "エルシャ", "text": "そして重要なのは、\n叡智の園には、千年戦争以前の知識すら持つ、\n賢者たちが隠れ住んでいるのだとか……。", "face": "u281"}, {"name": "エターナー", "text": "ともかく、行ってみるしかないだろうな。\n少しでも可能性があるならな。", "face": "u298"}, {"name": "アイシャ", "text": "うん。よし王子、防寒装備を整えよう。\n豪雪地帯を抜けることになりそうだからね！", "face": "u181"}, {"name": "ルイン", "text": "（…………。\n…………賢者、叡智、北の大地）", "face": "u1180a1"}, {"name": "ルイン", "text": "（ルインの記憶領域内部にノイズが発生しています。\nこれは、消去された記憶なのでしょうか……？）", "face": "u1180a1"}]}], "active": true}