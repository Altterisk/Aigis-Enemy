{"quest_id": 4124, "name": "影の妖術", "description": "妖術で生み出される無敵の\n分身！本体を撃破せよ！\n＜出撃時の初期ＨＰ減少：中＞", "modifier_notes": ["出撃時の初期ＨＰ減少：中"], "event": "亡国の将", "event_category": "History", "mission_id": 920025, "map_no": 3523, "level": 95, "multiplier": 0.95, "charisma": 50, "capacity": 9, "modifiers": [{"kind": "term", "influence": 9, "params": [50], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "hp": 5700, "attack": 950, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 2, "level": 90, "form_count": 1, "hp": 11400, "attack": 1425, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 220, "global_id": 219, "spawn_sec": 52}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 1, "tags": ["ステルス"], "hp": 2375, "attack": 285, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098160, "master_id": 92, "global_id": 91, "spawn_sec": 55}, {"enemy_id": 4, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 19000, "attack": 1900, "base_hp": 20000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 221, "global_id": 220, "spawn_sec": 76}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 5700, "attack": 522, "base_hp": 6000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 30, "attack_interval": 161, "move_speed": 400.0, "dot_rate": 1.5, "pattern_id": 2104240, "race_id": 14, "special_effect_id": 230, "master_id": 515, "global_id": 514, "spawn_sec": 91}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 11400, "attack": 694, "base_hp": 12000, "base_attack": 730, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 50, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104208, "race_id": 14, "special_effect_id": 231, "master_id": 513, "global_id": 512, "spawn_sec": 106}], "dialogue": [{"trigger": "start", "lines": [{"name": "シュウカ", "text": "国王陛下の仇……。\nわが命に代えても必ず！", "face": "u179"}, {"name": "アンナ", "text": "まだ、そんなことを\n言っているのですか！", "face": "l88fa3a3198d5"}, {"name": "アンナ", "text": "本当に勝ちたいのならば\n命を捨てるのではなく\nすべきことがあるはずです。", "face": "l88fa3a3198d5"}, {"name": "シュウカ", "text": "……。", "face": "u179"}, {"name": "シャオ", "text": "……シュウカ様。", "face": "u180"}]}, {"trigger": "battle", "at_sec": 89, "lines": [{"name": "牛頭の魔物", "text": "グフフフフ……。\nわが妖術見せてくれる。\nさあ、影どもよ敵を滅ぼせ。", "face": "l02eee62e6e63"}, {"name": "兵士", "text": "報告！　牛頭の魔物の数が\n増えているようです。", "face": "l30eeb307f139"}, {"name": "アンナ", "text": "数が増えているとは\nどういうことですか！？", "face": "l88fa3a3198d5"}, {"name": "シュウカ", "text": "惑わされるな！　あれは自分の影を\n増やし戦わせる妖術だ。\n影には攻撃を通す事はできない。", "face": "u179"}, {"name": "シュウカ", "text": "だが影自体は魔物本体を倒せば消える。\n戦場をかき乱される前に\n本体へ攻撃を集中しろ！", "face": "u179"}, {"name": "アンナ", "text": "なるほど、みなに伝令を。\n攻撃を本体に集中してください。", "face": "l88fa3a3198d5"}, {"name": "シュウカ", "text": "勝つためには貴公たちの協力が必要だ。\n頼む。力を貸してくれ。", "face": "u179"}]}, {"trigger": "end", "lines": [{"name": "シュウカ", "text": "王子、礼を言おう。\n私とシャオの力だけでは\n倒すことはできなかった……。", "face": "u179"}, {"name": "アンナ", "text": "気になさらないでください。\nあなたの助言があったから得られた\n勝利です。"}, {"name": "シュウカ", "text": "私の助言か……。死に場所を求めて\n一人で戦っている気になっていたが、\n大事な事を忘れていた。", "face": "u179"}, {"name": "シュウカ", "text": "軍の力は団結、協力することで何倍にもなる。\n私の考えの基本であったな。\nシャオ、目が覚めたよ。すまなかった。", "face": "u179"}, {"name": "シャオ", "text": "シュウカ様……。", "face": "u180"}]}], "story_talk": true, "active": true}