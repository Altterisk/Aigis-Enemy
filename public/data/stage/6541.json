ed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102224, "race_id": 8, "special_effect_id": 301, "change_to": 15, "change_condition": 3, "master_id": 31181, "global_id": 4800, "to_condition": 3, "to_global_id": 4801, "spawn_sec": 204}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3600, "attack": 540, "base_hp": 4000, "base_attack": 600, "damage_type": "physical", "armor_defense": 450, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102240, "race_id": 8, "special_effect_id": 301, "master_id": 31182, "global_id": 4801, "from_condition": 3}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 2, "hp": 2700, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102544, "race_id": 8, "special_effect_id": 301, "change_to": 17, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 31183, "global_id": 4802, "ranged": true, "to_condition": 3, "to_global_id": 4803, "spawn_sec": 213}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2700, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "special_effect_id": 301, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 31184, "global_id": 4803, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここがかつての闘技場ですか。\n……以前とは随分と雰囲気が違いますね。"}, {"name": "ケイティ", "text": "はい……ですが、魔界を進んでいた際\n感じていた瘴気を、この闘技場内では感じません。", "face": "u114"}, {"name": "ケイティ", "text": "前大会の時もそうでしたが、\n魔界の瘴気が遮断されているのを見るに\n同じ闘技場である事は間違いはないようです。", "face": "u114"}, {"name": "バシラ", "text": "うぅ～……瘴気はないはずなのに、\nなんだか空気が重たく感じます……。", "face": "u28"}, {"name": "アナトリア", "text": "……やれやれ。ついてくるなと言ったんだがねぇ。", "face": "u522"}, {"name": "アンナ", "text": "何を言ってるんですか！　危険な闘いに、\nアナトリアさんを一人向わせる訳にはいきません！", "face": "l4132eb27a3aa"}, {"name": "ケイティ", "text": "我々は仲間です。\nアナトリアさんが困っているのであれば、\n見過ごす事なんて出来ませんよ。", "face": "u114"}, {"name": "アナトリア", "text": "全く、命知らずな連中だね。\n……けど、そんな言葉が少し嬉しく思っちまうとは。\nあたしもヤキが回っちまったかねぇ。", "face": "u522"}, {"name": "アンナ", "text": "アナトリアさん……。"}, {"name": "アナトリア", "text": "まぁついてきちまった以上はしょうがないね。\n奴の配下の雑魚共の相手はあんた達に任せる、\n頼りにさせてもらうよ。", "face": "u522"}, {"name": "バシラ", "text": "はい、お任せください！", "face": "u28"}, {"name": "ケイティ", "text": "王子、魔神の配下と化した者達は、\n傷つく程に闘争心を引き出され、\n限界以上の力を発揮すると聞いています。", "face": "u114"}, {"name": "ケイティ", "text": "力を引き出された者達の猛攻に耐えうるには、\n装甲の厚い兵の皆さん、魔法を使ったしっかりとした\n対策も不可欠に思われます。くれぐれもご注意を。", "face": "u114"}, {"name": "アナトリア", "text": "……話は済んだかい。それじゃいくよ！\nあんた達、絶対に死ぬんじゃないよ！", "face": "u522"}]}], "active": true}