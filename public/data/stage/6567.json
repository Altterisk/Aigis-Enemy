: 233, "global_id": 232, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 231, "spawn_sec": 97}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 5, "source": "local", "count": 10, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 102}, {"enemy_id": 6, "source": "local", "count": 7, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 108}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 145}], "dialogue": [{"trigger": "start", "lines": [{"name": "グレーターデーモン", "text": "やはり所詮はダークエルフ。\nワシに一人で歯向かおうとしたのが運の尽きだ。", "face": "lde4aeedd2d24"}, {"name": "？？？", "text": "ひ、ひとりじゃないわ……。\nひぐっ……し、死霊の皆が一緒だもの……っ！", "face": "u675"}, {"name": "グレーターデーモン", "text": "死霊如きに何が出来るというのかね。\n命乞いか、助けを呼ぶ時間くらいはくれてやろう。\n無様に泣き叫んでみるがよい。", "face": "lde4aeedd2d24"}, {"name": "？？？", "text": "だ、誰がそんなこと……っ！！\nそれにアタシを助けてくれる人なんて――", "face": "u675"}, {"name": "シャルキー", "text": "――王子様！　こっちです！\nこっちで女の子が、\nグレーターデーモンに襲われています！", "face": "u596"}, {"name": "グレーターデーモン", "text": "むぅ、邪魔が入ったか。\nしかも王子たちとは……。", "face": "lde4aeedd2d24"}, {"name": "アリサ", "text": "何とか間に合ったようですね。\nお怪我はありませんか？", "face": "u24"}, {"name": "？？？", "text": "た、助けなんて、頼んでないし……。", "face": "u675"}, {"name": "？？？", "text": "……でも、こいつを倒すのに、\n手を貸してくれるっていうのなら、\nありがたく頼らせてもらうわ。", "face": "u675"}, {"name": "レアン", "text": "話してる時間は無いみたいだぞ。\n王子、早く戦闘準備を！", "face": "u50"}, {"name": "？？？", "text": "アタシのスケルトンたちを上手く使って、\nヤツを足止めするといいわ。\nそうすれば、有利に立ち回れるはずよ。", "face": "u675"}, {"name": "アンナ", "text": "分かりました。\n王子、彼女の力を借りて、\n慎重に戦いを進めましょう！", "face": "ldbe7f0a6cdf4"}]}, {"trigger": "end", "lines": [{"name": "シャルキー", "text": "ふぅ……どうにか\nグレーターデーモンを退けましたね……！", "face": "u596"}, {"name": "？？？", "text": "ぐっ……助かったわ……。\nそれじゃあ、アタシはもう行くから。", "face": "u675"}, {"name": "アリサ", "text": "あっ、待ってください。\n今傷を治しますから。\n少しだけ、じっとしていてくださいね。", "face": "u24"}, {"name": "？？？", "text": "…………ありがと。\nその、お礼は言っておくわ、一応ね。", "face": "u675"}, {"name": "？？？", "text": "この借りは必ず返すから。\nあなた達が危機に陥った時は、\nアタシが助けにいくわ。", "face": "u675"}, {"name": "アリサ", "text": "その時は頼りにさせてもらいますね。\nあ、そうだ。あなたのお名前は……？", "face": "u24"}, {"name": "メルアビス", "text": "借りを返すだけよ！！\n――アタシはメルアビス。覚えておきなさい！", "face": "u675"}, {"name": "アンナ", "text": "メルアビスさん、ですね。\nそれでは王子、我々は先へ進みましょうか。"}]}, {"trigger": "end", "lines": [{"name": "メルアビス", "text": "――あれが、女王様の言っていた王子なのね。\n思ったより悪くないじゃない。", "face": "u675"}]}], "active": true}