"armor_defense": 200, "attack_speed": 40, "attack_wait": 50, "attack_interval": 216, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2152128, "race_id": 9, "special_effect_id": 773, "master_id": 37358, "global_id": 10975, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "route_behaviour": {"reroutes": ["Route=927", "Route=928", "Route=929", "Route=930", "Route=999"]}, "spawn_sec": 30}, {"enemy_id": 9, "source": "local", "count": 15, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 9, "master_id": 485, "global_id": 484, "to_global_id": 625, "spawn_sec": 33}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 8, "master_id": 626, "global_id": 625}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "hp": 16000, "attack": 450, "base_hp": 16000, "base_attack": 450, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 40, "attack_wait": 50, "attack_interval": 216, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2152128, "race_id": 9, "special_effect_id": 1699, "master_id": 37371, "global_id": 10988, "spawn_sec": 112}, {"enemy_id": 12, "source": "local", "count": 6, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 12, "master_id": 625, "global_id": 624, "to_global_id": 483, "route_behaviour": {"transforms": [{"wait": 40}]}, "spawn_sec": 114}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 11, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true}], "popups": ["特定の配置マスには\n落石が発生します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リリア", "text": "――た、助かりましたぁ……。\nもう溶岩は迫ってきてないですよね？", "face": "u20"}, {"name": "アンナ", "text": "あなたが上層まで転送してくれたのですね。\nえぇと……確か、オラティル様でしたか……？"}, {"name": "レーヴ", "text": "豊穣神オラティル様といえば……。\n今でも各地に神殿の残る\nとても古い時代の神さまですよ！", "face": "u454"}, {"name": "レーヴ", "text": "嵐雨の亜神アスバール様と並び、\nこの世界に豊穣をもたらす偉大な神で――", "face": "u454"}, {"name": "イムラウ", "text": "――同時に、知識を人類に与え、\n超古代文明が滅ぶ原因を作った神のひとり。", "face": "u1470a1"}, {"name": "オラティル", "text": "おや懐かしい顔だ。\nイムラウ、今までいったいどこにいたんだい？", "face": "u2149a1"}, {"name": "イムラウ", "text": "話せば長くなるんだけど……ちょっと異世界に……？", "face": "u1470a1"}, {"name": "オラティル", "text": "へぇ、私に黙って楽しそうなことを……。\n後で土産話を聞かせてもらおうかな？\n昔、私の杖をあげた代価ということで。", "face": "u2149a1"}, {"name": "リリア", "text": "あ、あのっ！\n長話になるなら先に地上を目指しませんか？\n何だか、今にも崩れそうな音がさっきから……！", "face": "u20"}, {"name": "シビラ", "text": "きゃっ……そうね、坑道が崩落し始めているし……。\nこんな大きな落石、当たったら大怪我しちゃうわ。", "face": "u39"}, {"name": "イムラウ", "text": "もうっ、オラティル様なら\n上層までじゃなくて、地上まで転送できたんじゃないの？", "face": "u1470a1"}, {"name": "オラティル", "text": "いやいや、今この上は大変なことになってるんだよ。\n事前に戦闘準備する余裕くらい欲しいだろう？", "face": "u2149a1"}, {"name": "シビラ", "text": "大変な、こと……？", "face": "u39"}, {"name": "オラティル", "text": "まぁ、見れば分かるよ。\n今は心構えをしつつ、ここから脱出しよう。", "face": "u2149a1"}, {"name": "アンナ", "text": "そうですね……。\n王子、崩落がさらに進んでいます。\n落石地点も多くなっていくはずなので――", "face": "l8458786dc994"}, {"name": "マイン", "text": "……お、おい！　魔界アリまで出てきたぞ！？", "face": "u672"}, {"name": "ティニー", "text": "坑道が崩れて巣穴と繋がったのね。\n落石と、アリと……とにかく！\n全部気をつけなさい！", "face": "u523"}]}, {"trigger": "end", "lines": [{"name": "マイン", "text": "はぁ……はぁ……。\nようやく……あとちょっとで出口だ……。", "face": "u672"}, {"name": "オラティル", "text": "覚悟しておきたまえよ。\nここを出たら、アレと戦うことになるからね。", "face": "u2149a1"}, {"name": "トラム", "text": "……超古代文明の航空艦ね。", "face": "u1110a1"}, {"name": "オラティル", "text": "おや、トラムもいたのかい？\nそれにアランも！　ふふっ、姉妹の感動の再会だね！", "face": "u2149a1"}, {"name": "アラン", "text": "馬鹿なことを言っている暇があったら、\n知っている情報を全部吐いてください。\nこれから王国軍は、プロメと激突するんですよ。", "face": "u1511a1"}, {"name": "オラティル", "text": "（おや……なぁトラム？\nアランの罵りがちょっと優しくなっていないかい？）", "face": "u2149a1"}, {"name": "トラム", "text": "（指摘するとまた激しくなるからやめておいたら？\n姉さんがいない間に、こっちも色々あったのよ）", "face": "u1110a1"}, {"name": "リリア", "text": "……プロメ様の説得、できるのでしょうか。", "face": "u20"}, {"name": "オラティル", "text": "簡単ではないだろうね。\n彼女は超古代文明の滅亡を、自分の責任だと考えている。\n自分が人類に、文明の火を与えたからだと。", "face": "u2149a1"}, {"name": "オラティル", "text": "きみたちは、それを否定しなければならない。\n今の人類は未来にあるべき技術を手にしても\n過つことなく正しき道を歩めると示すか――", "face": "u2149a1"}, {"name": "リリア", "text": "プロメ様に監視者となってもらい、\nすべての戦いを終えた後、\n超古代文明の技術を無に還す約束をするか……。", "face": "u20"}, {"name": "オラティル", "text": "あるいはプロメを――\nいや、これはきみたちが、\n自分で答えを見つけ出すべきものだね。", "face": "u2149a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "シビラ", "text": "もう、答えは決まっているんでしょう？\n大丈夫、みんなあなたの答えを、信じているから。", "face": "u39"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}