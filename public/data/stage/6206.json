: 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 8, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 147}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 2100, "attack": 280, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107376, "race_id": 6, "change_to": 10, "change_condition": 2, "master_id": 30509, "global_id": 4128, "to_condition": 2, "to_global_id": 4054, "spawn_sec": 164}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4410, "attack": 224, "base_hp": 6300, "base_attack": 320, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30435, "global_id": 4054, "from_condition": 2}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 1750, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 178}], "dialogue": [{"trigger": "start", "lines": [{"name": "サヨ", "text": "天使が人間を滅ぼそうとしてるなんて、\n最初は自分の目を疑ったわ。", "face": "u510"}, {"name": "サヨ", "text": "神様は、悪を罰するもの。そういう教えは、\nどこにでも言い伝わってるものだもの。", "face": "u510"}, {"name": "サヨ", "text": "天使達と戦おうとする王子をみて、\nやっぱり王子は悪者なんじゃないかって、\n信じかけていた気持ちが揺らいだ事もある。", "face": "u510"}, {"name": "ニエル", "text": "――王子、もうすぐ天使兵団との決戦だね。\n私たち天使は遠い昔、神から「人間を滅ぼせ」って\n命令を受けている。", "face": "u206"}, {"name": "ニエル", "text": "中には神に逆らい、堕天使となる天使も居るけど……。\nあの軍勢の天使は冷酷な天使たちしか居ない。\n話し合いとか、分かり合うとかはできないと思う。", "face": "u206"}, {"name": "ニエル", "text": "神の名の下に、人間を滅ぼしに来る。\nでも、神の命令だからって一方的に\n人間を滅ぼすなんて間違ってるよ。", "face": "u206"}, {"name": "ニエル", "text": "だから王子、天使たちが人間を襲う前に、\nここで食い止めよう。", "face": "u206"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "アンナ", "text": "巨大な天使の像……！？", "face": "lb17e96a90f21"}, {"name": "ケイティ", "text": "天使製のゴーレム……と言ったところでしょうか。\nあの巨体に装甲、悔しいですが、\n剣で戦うのは無謀でしょうね。", "face": "u114"}, {"name": "ロイ", "text": "ここは魔術の力の出番のようですな。\n魔法使いや魔法剣士の攻撃を集中し、\n動き出す前に痛手を負わせておくのが良さそうですな。", "face": "u11"}]}, {"trigger": "end", "lines": [{"name": "サヨ", "text": "結局天使達の目的は、王子ではなく、\n人を滅ぼす事に向かっていた。", "face": "u510"}, {"name": "サヨ", "text": "天使から人々を守っている王子を見て。\n……わたしは、やっぱり王子を信じたいって思ったの。", "face": "u510"}, {"name": "サヨ", "text": "神様の考えなんて判らないわ。\nでも、目の前にいる人をただ助けたいって、\nただそれだけの為にいつだって全力で戦う……", "face": "u510"}, {"name": "サヨ", "text": "……そんなお人好しの王子の方が、\nよっぽど信じる価値があるって、そう思った。", "face": "u510"}, {"name": "サヨ", "text": "……で、でもこの時はまだ、完全に信じてた訳じゃ\nないんだからね！　キチンと王子を見極めるには、\nもっともっと王子を知らなきゃいけないでしょっ！", "face": "u510"}, {"name": "サヨ", "text": "さぁ、次は魔法都市での戦いの話をさせてちょうだい！", "face": "u510"}]}], "active": true}