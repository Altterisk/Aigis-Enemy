{"quest_id": 6418, "name": "愚を超えし大賢", "description": "過ぎし日を憂う太公望を励まさんと、\n模擬戦を行う王子たち。\n落ち込む太公望の実力を見極めよ！\n神級（★１獲得の目安：平均Lv50）", "event": "神算の太公望", "event_category": "History", "mission_id": 920105, "map_no": 5315, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 600, "base_hp": 30000, "base_attack": 600, "damage_type": "physical", "armor_defense": 650, "magic_defense": 10, "attack_range": 240, "attack_speed": 1, "attack_wait": 45, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114272, "special_effect_id": 278, "change_to": 1, "missile_id": 265, "missile": {"speed": 2.0}, "master_id": 30958, "global_id": 4577, "ranged": true, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 1, "hp": 11500, "attack": 280, "base_hp": 11500, "base_attack": 280, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 45, "attack_interval": 127, "move_speed": 1150.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114272, "missile_id": 265, "missile": {"speed": 2.0}, "master_id": 30956, "global_id": 4575, "ranged": true, "spawn_sec": 7}, {"enemy_id": 4, "source": "local", "count": 14, "form_count": 1, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 15, "attack_speed": 100, "attack_wait": 30, "attack_interval": 203, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104304, "master_id": 30957, "global_id": 4576, "spawn_sec": 39}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 137, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101744, "race_id": 16, "special_effect_id": 130, "master_id": 30222, "global_id": 3841, "spawn_sec": 74}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 90, "attack_wait": 30, "attack_interval": 177, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100976, "race_id": 16, "master_id": 307, "global_id": 306, "spawn_sec": 75}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 2, "attack_interval": 32, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100976, "race_id": 16, "special_effect_id": 130, "master_id": 30390, "global_id": 4009, "spawn_sec": 81}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 450, "base_hp": 12000, "base_attack": 450, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112784, "race_id": 4, "special_effect_id": 54, "master_id": 30723, "global_id": 4342, "spawn_sec": 97}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 12000, "attack": 400, "base_hp": 12000, "base_attack": 400, "damage_type": "physical", "armor_defense": 900, "magic_defense": 15, "attack_range": 200, "attack_speed": 100, "attack_wait": 30, "attack_interval": 103, "move_speed": 450.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104336, "missile_id": 130, "missile": {"speed": 6.0, "deflectable": true}, "master_id": 520, "global_id": 519, "ranged": true, "spawn_sec": 103}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 15, "attack_range": 200, "attack_speed": 100, "attack_wait": 30, "attack_interval": 103, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104192, "missile_id": 128, "missile": {"speed": 6.0, "deflectable": true}, "master_id": 508, "global_id": 507, "ranged": true, "spawn_sec": 121}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099840, "race_id": 16, "special_effect_id": 739, "master_id": 963, "global_id": 962, "spawn_sec": 152}], "popups": ["ワルツがいる間は\n全ての敵ユニットの\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "太公望", "text": "………………（ぼーっ）。", "face": "u603"}, {"name": "アンナ", "text": "（……心ここにあらず、といったご様子ですね。\n釣りをなさっていらっしゃるのに、\n釣り針が水面よりも上にあるようですし……）"}, {"name": "ケイティ", "text": "（神仙郷の復興状況について伺いに来たものの、\nあのご様子では少々話しかけづらいですね）", "face": "u114"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "（あ……王子、いま近寄っては……）"}, {"name": "太公望", "text": "…………ナタク、後ろにいるんでしょう？\nそんな悪戯をする仙人は貴方くらいだもの。", "face": "u603"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "太公望", "text": "……ねぇナタク、ここにいる資格が私にあるのかしら？\n神仙郷屈指の策士として皆に期待されていながら、\n邪仙たちの侵攻を見抜けなかった、愚かな私に。", "face": "u603"}, {"name": "太公望", "text": "私がこの神仙郷の陥落を防げていれば、\n多くの仲間たちが邪仙の手に落ちることも\n元始天尊様が行方不明になることもなかったはず……。", "face": "u603"}, {"name": "太公望", "text": "それができなかった私に、\nいまさら神仙郷の仙人を名乗る資格があると思う？", "face": "u603"}, {"name": "堕姫", "text": "――おーい、太公望ーっ！\n皆で美味しい桃を採ってき……\n――のわっ！？　お……王子、来ておったのか！", "face": "u547"}, {"name": "太公望", "text": "へ？　おう――えぇえっ！？\nお、王子！？　なぜ私の後ろに？", "face": "u603"}, {"name": "アンナ", "text": "……コホン。太公望さん、自信を持ってください。\n貴方の見事な策略があったからこそ、\nこうして神仙郷を取り戻すことができたのですから。"}, {"name": "太公望", "text": "って、アンナさんまで！\nうぅ……全部聞いていらっしゃったのですね？", "face": "u603"}, {"name": "ナタク", "text": "やぁ王子、いいところに来てくれたね。\nちょうど今、落ち込んでる太公望を\n神仙郷のみんなで励まそうとしてたところなんだ。", "face": "u297"}, {"name": "ナタク", "text": "太公望、これでわかっただろう？\nキミはこんなにも多くの仲間たちに慕われてるんだ。", "face": "u297"}, {"name": "太公望", "text": "……ありがとうございます、皆さん。\nでしたら、いま一度確かめて頂けませんか？\n私の力が本当に皆さんの評価に見合うものかどうかを。", "face": "u1603"}, {"name": "アンナ", "text": "模擬戦をお望みということですね？\nわかりました。王子、お相手して差し上げましょう。"}, {"name": "ファー", "text": "よっしゃー！　オレは太公望に加勢するぜ！\n神仙郷での修行の成果、見せてやるよっ！", "face": "u327"}]}, {"trigger": "end", "lines": [{"name": "太公望", "text": "……ふぅ。\nやはり、王子たちには敵いませんね。", "face": "u1603"}, {"name": "ファー", "text": "いてて……。\nったく、王子、模擬戦で本気出すなよなー。", "face": "u327"}, {"name": "太公望", "text": "え？", "face": "u1603"}, {"name": "ケイティ", "text": "すみません……気を抜く余裕がありませんでしたので。", "face": "u114"}, {"name": "アンナ", "text": "……太公望さん、此度の模擬戦で\nあらためて貴方の実力を思い知りました。"}, {"name": "アンナ", "text": "今後も続く邪仙たちとの戦いの中で、\n貴方の叡智が必要となる時が来ると思います。\nそうなった時は、ご協力いただけますか？"}, {"name": "太公望", "text": "…………。\n……少し、考えさせていただけますか？", "face": "u1603"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ナタク", "text": "ちょっと待ってよ。\n太公望はこれからの神仙郷に必要な女性だ。\n勝手に連れて行ったりしたら、このぼくが許さないよ？", "face": "u297"}, {"name": "ファー", "text": "そうだそうだ！\nオレだって一緒に修行するって\n太公望と約束したんだからなー！", "face": "u327"}, {"name": "堕姫", "text": "わ、わらわも邪仙郷での暮らしで染み付いた邪気を\n祓う修行法を教わっている最中なのじゃ。\nだから、頼む……太公望を連れて行かないでたもれ。", "face": "u547"}, {"name": "太公望", "text": "みんな……。", "face": "u1603"}, {"name": "太公望", "text": "……決めました。\n王子……私は今後、神仙郷の仙人の一人として\n貴方にできる限りの協力をさせていただきます。", "face": "u1603"}, {"name": "アンナ", "text": "太公望さん……ありがとうございます。\n今後とも宜しくお願いいたしますね。"}, {"name": "アンナ", "text": "私たちもできる限りの協力はいたします。\nなにかお困りになりましたら、またご連絡ください。"}]}], "active": true}