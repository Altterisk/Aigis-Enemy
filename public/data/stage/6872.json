{"quest_id": 6872, "name": "紫竜を駆る騎士", "description": "乱れの中心部に辿り着いた一行の前に魔界\nと物質界を繋ぐ、巨大な亀裂が現前する。\n亀裂から現れる魔物と紫竜の騎士を倒せ！\n神級（★１獲得の目安：平均Lv50）", "event": "紅の魔術師と魔界の騎士", "event_category": "History", "mission_id": 920133, "map_no": 5531, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "hp": 100000, "attack": 4500, "base_hp": 100000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 115, "attack_wait": 100, "attack_interval": 401, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109424, "race_id": 13, "master_id": 30314, "global_id": 3933, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 15, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 70, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104096, "race_id": 3, "master_id": 498, "global_id": 497, "spawn_sec": 17}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 2, "hp": 4000, "base_hp": 4000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 181, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "change_to": 3, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31968, "global_id": 5587, "to_global_id": 321, "spawn_sec": 37}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 322, "global_id": 321, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 22000, "attack": 600, "base_hp": 22000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 1, "attack_wait": 30, "attack_interval": 102, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116192, "special_effect_id": 320, "master_id": 31315, "global_id": 4934, "spawn_sec": 83}, {"enemy_id": 6, "source": "local", "count": 20, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 240, "base_hp": 4000, "base_attack": 240, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115520, "special_effect_id": 308, "master_id": 31219, "global_id": 4838, "spawn_sec": 90}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 3, "hp": 21000, "base_hp": 21000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 20, "attack_interval": 97, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118496, "race_id": 18, "change_to": 7, "missile_id": 351, "missile": {"speed": 10.0}, "master_id": 31965, "global_id": 5584, "to_global_id": 5334, "route_behaviour": {"transforms": [{"wait": 100}]}, "spawn_sec": 100}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 21000, "attack": 1200, "base_hp": 21000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 350.0, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118480, "race_id": 18, "change_to": 8, "change_condition": 2, "master_id": 31715, "global_id": 5334, "to_condition": 2, "to_global_id": 5335}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 10500, "attack": 800, "base_hp": 10500, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_range": 260, "attack_speed": 1, "attack_wait": 20, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118496, "race_id": 18, "missile_id": 351, "missile": {"speed": 10.0}, "master_id": 31716, "global_id": 5335, "ranged": true, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 1200, "base_hp": 60000, "base_attack": 1200, "damage_type": "true", "armor_defense": 1800, "magic_defense": 30, "attack_range": 190, "attack_speed": 1, "attack_wait": 30, "attack_interval": 123, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2119984, "missile_id": 204, "missile": {"speed": 8.0, "splash": 120}, "master_id": 31962, "global_id": 5581, "ranged": true, "spawn_sec": 131}, {"enemy_id": 11, "source": "local", "count": 5, "form_count": 2, "hp": 6000, "base_hp": 6000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 10, "attack_interval": 141, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "change_to": 11, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 31969, "global_id": 5588, "to_global_id": 447, "spawn_sec": 174}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 448, "global_id": 447, "ranged": true}], "popups": ["紫竜に騎乗した騎士の攻撃は\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フローガ", "text": "――ここが、魔力の乱れの中心……って、\nな、何ですかあの巨大な亀裂はぁ！？", "face": "u878"}, {"name": "シャディア", "text": "くっ……何て濃い魔力の濁流だ。\nこんな規模のゲートは見たことがないぞ！？", "face": "u713"}, {"name": "フローガ", "text": "ゲートっていうより、\n魔界との間に開いた空間の裂け目ですねぇ……ッ！！\nこれ、放置したら大変なことになりますよー！！", "face": "u878"}, {"name": "フローガ", "text": "何しろ魔界そのものみたいな魔力が、\nあの裂け目から流れ込んでいるんですからぁ！", "face": "u878"}, {"name": "ガード", "text": "――ほう、良い目を持っているな、人間の魔術師よ。\nこれが門ではなく、亀裂だということを解するか。", "face": "lee9399c5ee8f"}, {"name": "？？？", "text": "…………。", "face": "u908"}, {"name": "シャディア", "text": "ガード……！\nお前がいるということは、\nやはりこの事態、ガリウスの策謀なのだな？", "face": "u713"}, {"name": "ガード", "text": "やれやれ、それは言いがかりというものだ。\nこれはいわばひとつの事故でね。", "face": "lee9399c5ee8f"}, {"name": "ガード", "text": "此奴の力を見てみようと連れて来たのだが、\nまさかゲートを通過するだけで、\n空間に亀裂を発生させるとは……。", "face": "lee9399c5ee8f"}, {"name": "ガード", "text": "さすがにこちらも予想外というものだ。\n――だが、こうして英雄王の系譜がやってきたのは、\nむしろ好都合といったところか？", "face": "lee9399c5ee8f"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ガード", "text": "その男に、お前の力を見せてやれ。\n悪夢の如き永年の戦いから、\nお前が脱する方法はそれしかないのだぞ？", "face": "lee9399c5ee8f"}, {"name": "？？？", "text": "…………戦いを、終わらせる。", "face": "u908"}, {"name": "ガード", "text": "ああ、そうだ。\nあの男を倒せば、記憶の霧はきっと晴れることだろう。", "face": "lee9399c5ee8f"}, {"name": "？？？", "text": "…………ああ。", "face": "u908"}, {"name": "フローガ", "text": "……何か、様子がおかしいですね。\nこの魔力の波動、まるで操られているような……？", "face": "u878"}, {"name": "シャディア", "text": "ガードめ、あれほどの魔力を備えた騎士の\n魂を汚すような真似をするとは……。", "face": "u713"}, {"name": "フローガ", "text": "ですね……心を操るような術、絶対に許せません。\n王子殿下、どうかあの方を助けてあげてください……！", "face": "u878"}]}, {"trigger": "battle", "at_sec": 132, "lines": [{"name": "シャディア", "text": "――ッ！？\nあの紫竜……まさか……いや、ありえない。", "face": "u713"}, {"name": "フローガ", "text": "ど、どうしましたか！？\nもしかしてお知り合いだったりとか……？", "face": "u878"}, {"name": "シャディア", "text": "いや、かつて千年戦争の折、\n紫の竜を従えた騎士を見たことがあってな。", "face": "u713"}, {"name": "シャディア", "text": "だが存命であるはずがない。\n彼は魔界の深淵に向かい、帰らぬ人となったのだから。", "face": "u713"}, {"name": "フローガ", "text": "そんな偉大な騎士様の似姿を用意するなんて、\n冒涜にも程がありますね、魔王ガリウスめぇ……っ！", "face": "u878"}, {"name": "フローガ", "text": "ともかく、今はここを切り抜けないといけません。\n王子殿下、あの人の斧槍にはご注意を！\n鎧も魔法の壁も貫く、強力な力を感じますよ！", "face": "u878"}, {"name": "シャディア", "text": "正面から受け止めるのは得策ではないだろうな。\nそれにあの斧槍に宿った魔力、\n遠距離に放つことすら可能だろう。", "face": "u713"}, {"name": "？？？", "text": "…………行くぞ。", "face": "u908"}]}, {"trigger": "end", "lines": [{"name": "ティファ", "text": "くぅっ……なんて強い……っ！！\n魔力だけじゃなくて、\n斧槍の一発一発が達人の域に達していますよ……っ！？", "face": "u476"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "？？？", "text": "…………良い、腕だ。", "face": "u908"}, {"name": "？？？", "text": "だが……あの、男には、まだ……遠く及ばな――", "face": "u908"}, {"name": "ガード", "text": "（精神支配が解けかけているのか？\nだが、意識を制御下に置いた上でなお、\nこれ程の戦技と力量を見せるとはな……）", "face": "lee9399c5ee8f"}, {"name": "ガード", "text": "……今日はここまでとしよう。\nさぁ魔界へ帰還するぞ。", "face": "lee9399c5ee8f"}, {"name": "？？？", "text": "……うっ……あ、ああ……。", "face": "u908"}, {"name": "アンナ", "text": "…………魔王軍、撤退していきます。"}, {"name": "ティファ", "text": "……荒々しい戦い方でしたが、\nあの斧槍捌き、まるで何百年も戦い続けてきたみたいに、\nすごく洗練されていました。", "face": "u476"}, {"name": "ティファ", "text": "あれほどの腕を持つ方が、\n魔王軍に操られてしまっているなんて……。", "face": "u476"}, {"name": "フローガ", "text": "魔物とも、人間とも、\n何かが根本的に違っているような、\nそんな魔力が微かに残っています。", "face": "u878"}, {"name": "フローガ", "text": "彼は、いったい何者なのでしょうか……。", "face": "u878"}, {"name": "シャディア", "text": "ともかく、情報もなく悩むのは後にしよう。\nこの亀裂を先に片付けてしまわないとな。", "face": "u713"}, {"name": "フローガ", "text": "そうですねっ！　空間に発生していた亀裂も、\nあの騎士さんがいなくなって安定してきました。\nこれなら私でも修復できそうですよ。", "face": "u878"}, {"name": "アンナ", "text": "それでは、魔力の乱れを修復したら、\n一度王国へ戻りましょうか。\n王子、此度の遠征お疲れさまでした！"}]}], "story_talk": true, "active": true}