"global_id": 236, "spawn_sec": 17}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 49}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 57}, {"enemy_id": 9, "source": "local", "count": 12, "level": 80, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 98}], "dialogue": [{"trigger": "start", "lines": [{"name": "カノン", "text": "は～、ラッキーだったわね～。\nこんなとこに宿屋があったなんて。", "face": "u1417a1"}, {"name": "フィオレ", "text": "おまけに温泉付きですから、\nちょっとした旅行気分ですね♪", "face": "u1679a1"}, {"name": "ソーマ", "text": "シエナさん、どうされました？\n何かをお探しのようですけど……。", "face": "u1138a1"}, {"name": "シエナ", "text": "温泉まんじゅう食べたい。", "face": "u1680a1"}, {"name": "リズリー", "text": "にっひひひひひー♪\nそれにしても混浴とはねー♪", "face": "u977"}, {"name": "リズリー", "text": "これだけの美女たちを侍らせて、\n王子様は一体どんな気分なのかな？", "face": "u977"}, {"name": "王子", "text": "…………（ニッコリ）", "face": "u1"}, {"name": "リズリー", "text": "おっと笑顔で誤魔化されちゃった。\nまあ？　私としては？　王子様との混浴に、\nあまり動じてない女性陣の方が気になるなー♪", "face": "u977"}, {"name": "リズリー", "text": "ね！　ソーマちゃん！", "face": "u977"}, {"name": "ソーマ", "text": "んんっ！？　げほっ、ごほっ！", "face": "u1138a1"}, {"name": "リズリー", "text": "にひひ♪　ソーマちゃんも隅に置けないねぇ♪", "face": "u977"}, {"name": "アカネ", "text": "（……山中の温泉宿、客足はおそらく極小数。\n採算度外視の老後の道楽だと仰っていましたが、\nそれにしては設備があまりにも豪華すぎるような）", "face": "u1678a1"}, {"name": "アカネ", "text": "（宿全体が完璧に手入れされているのに、\n他の従業員の姿が見えないのも不自然です。\nまるで時が止まっているかのような違和感）", "face": "u1678a1"}, {"name": "アカネ", "text": "（主人の振る舞いに特段おかしな点はなかった。\n本当に善意？　しかしこの拭えない不気味さは──）", "face": "u1678a1"}, {"name": "風神？", "text": "──永遠の安息を。", "face": "l56ed90a1b098"}, {"name": "雷神？", "text": "──恒久的な平穏を。", "face": "l864538dac0cc"}, {"name": "カノン", "text": "いいい、いきなりどこから出てきたのよこいつら！？", "face": "u1417a1"}, {"name": "ミコト", "text": "なっ……風神、そして雷神！？\nそんな、彼らがどうしてここに！？", "face": "u130"}, {"name": "酒呑童子？", "text": "──限り無き循環の輪に、呑まれよまろうど。", "face": "l4549d9192ddc"}, {"name": "アカネ", "text": "酒呑童子まで……！\n王子、武装は所持しています！\nどうか指揮をお願いします！", "face": "u1678a1"}]}, {"trigger": "end", "lines": [{"name": "ソーマ", "text": "──さん！　──ください！　──さん！", "face": "u1138a1"}, {"name": "ソーマ", "text": "起きてください！　アカネさん！", "face": "u1138a1"}, {"name": "アカネ", "text": "──っ！？　わ、私は一体何を……？", "face": "u1678a1"}, {"name": "ソーマ", "text": "湯船の中で眠ってしまったみたいです、私たちみんな。", "face": "u1138a1"}, {"name": "カノン", "text": "全員揃って寝落ちしちゃうなんて、\nよっぽど気が抜けちゃったのかしらね。", "face": "u1417a1"}, {"name": "王子", "text": "…………（ぽやぽや）", "face": "u1"}, {"name": "アカネ", "text": "そうでしたか。あれは、夢だったのですね。\n確かに、風神と雷神が生きているはずがない。", "face": "u1678a1"}, {"name": "ミコト", "text": "奇遇ですね、私も似たような夢を見ました。", "face": "u130"}, {"name": "フィオレ", "text": "私も、悪い夢を見ていたような気がします。", "face": "u1679a1"}, {"name": "アカネ", "text": "……なにか、気味が悪いですね。\nのぼせる前に早く上がりましょう。", "face": "u1678a1"}, {"name": "シエナ", "text": "お風呂上がったら宴会って言ってた。", "face": "u1680a1"}, {"name": "フィーヌ", "text": "宴会ですか！　お肉ですかね！？", "face": "u1415a1"}, {"name": "シエナ", "text": "私はケーキが良い。", "face": "u1680a1"}, {"name": "ソーマ", "text": "さすがにケーキはないんじゃ……。", "face": "u1138a1"}, {"name": "ミコト", "text": "…………ふむ。", "face": "u130"}, {"name": "アカネ", "text": "（やはりこの温泉宿が普通とは思えません。\nいざと言うときは私が王子をお守りしないと）", "face": "u1678a1"}]}], "active": true}