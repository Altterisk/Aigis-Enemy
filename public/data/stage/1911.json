emy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["水中"], "hp": 90000, "attack": 4500, "base_hp": 90000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 15, "attack_speed": 1, "attack_wait": 85, "attack_interval": 238, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123600, "race_id": 7, "special_effect_id": 222, "change_to": 16, "change_condition": 4, "master_id": 32679, "global_id": 6297, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 6298}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["水中"], "hp": 90000, "attack": 6750, "base_hp": 90000, "base_attack": 6750, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 15, "attack_speed": 1, "attack_wait": 85, "attack_interval": 238, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123600, "race_id": 7, "special_effect_id": 509, "change_to": 17, "change_condition": 4, "master_id": 32680, "global_id": 6298, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 6299}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["水中"], "hp": 90000, "attack": 10125, "base_hp": 90000, "base_attack": 10125, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 15, "attack_speed": 1, "attack_wait": 85, "attack_interval": 238, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123600, "race_id": 7, "special_effect_id": 127, "master_id": 32681, "global_id": 6299, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "スカー", "text": "――シャァァァァァァック！！\nギガエルのクソ天使野郎、イラつくぜェ……。", "face": "lac8f84d264d1"}, {"name": "スカー", "text": "何が『クラールフと王子の合流を阻め』だ！！\nハナっからオレサマが王子に勝てねェって\n言ってるようなモンじゃねェかッ！！", "face": "lac8f84d264d1"}, {"name": "スカー", "text": "だが、また王子と殴り合えるのはいいゼェ……。\n久々に背びれにビンビンきてやがる……。\nオレサマの退屈をふっとばすのはアイツしかいねェ！", "face": "lac8f84d264d1"}, {"name": "リバン", "text": "――王子様、やっぱり海底都市が\nギガエル配下の魚人に\n包囲されているみたいですわ……。", "face": "u1062a1"}, {"name": "フォニア", "text": "ギガエル……かつてクラールフ様が\n神の力を有していた頃、\n補佐として創造した天使ですね。", "face": "u548"}, {"name": "ニエル", "text": "海の命を司る天使たる者が、\n深海の王と、その民に敵意を向けるなんてね。\n存在理由より優先される命令を出すということは――", "face": "u206"}, {"name": "ソフィー", "text": "――ギガエルを従えたのは、\n亜神の中でも高位の存在なのだということでしょう。", "face": "u146"}, {"name": "イブキ", "text": "だが今は、黒幕のことよりも\n包囲された海底都市を解放する方が先決だろう。", "face": "u511"}, {"name": "アンナ", "text": "そうですね。\n海底都市と王国は同盟関係にあります。\nこの状況を見過ごすことはできませんから。", "face": "l8681a1bbb90b"}, {"name": "スカー", "text": "――シャァァァァァック！！\nやはり来たか、来てくれたか王子ィ！\nこのオレサマと喧嘩するためになァ！！", "face": "lac8f84d264d1"}, {"name": "スカー", "text": "聞くところによりゃァ、\nテメェは大層な使命を負ってるらしいじゃねェか。", "face": "lac8f84d264d1"}, {"name": "スカー", "text": "だがなァ、オスとオスの喧嘩の前じゃ、\n世界の命運なんざどうでもいいよなァ！！", "face": "lac8f84d264d1"}, {"name": "リバン", "text": "……なんだか、あの魚人嬉しそうに見えますわ。\n他のギガエルの配下とは、気配が違うというか……。", "face": "u1062a1"}, {"name": "スカー", "text": "うるッせェ海巫女！　黙りやがれッ！！\n他の魚人が気味悪いぐらい従順になって\nこっちは気持ち悪くてしかたねェんだよォ！！", "face": "lac8f84d264d1"}, {"name": "スカー", "text": "さぁ、気持ちよく喧嘩させてもらうゼ、王子ィ！！\nテメェのハートはどうだ、テメェの怒りはどうだ！\n付いてこいよ、このオレサマの破壊力になァ！！", "face": "lac8f84d264d1"}]}, {"trigger": "end", "lines": [{"name": "スカー", "text": "へへっ……最高の喧嘩だったァ……。\nまたしてもオレサマの完敗だぜェ……。", "face": "lac8f84d264d1"}, {"name": "スカー", "text": "さぁ王子ィ、この先に進みな……。\n傷が癒えたらまた喧嘩挑みに行くからよォ、\nその前にギガエルのクソ野郎をぶん殴ってこいッ！！", "face": "lac8f84d264d1"}, {"name": "リバン", "text": "どこまでも自分勝手ですわね……。\nでも、おかげで海底都市に入れそうですわ！", "face": "u1062a1"}, {"name": "シャディア", "text": "クラールフ殿のもとへ急ごう。\nおそらく都市の内部にも、\n既にギガエルの手勢が侵入しているはずだ。", "face": "u713"}]}, {"trigger": "end", "lines": [{"name": "スカー", "text": "王国ってのは強ぇヤツらばかりか……。\n背びれにビンビンきやがるゼェ……。", "face": "lac8f84d264d1"}, {"name": "スカー", "text": "だが見てろよ……。\nオレサマはもっと強くなるからよォ……。", "face": "lac8f84d264d1"}, {"name": "スカー", "text": "次に勝つのはオレサマだぜ、王子ィ！\nシャークギルマンはッ！　最ッ強ッ、なんだよォッ！！", "face": "lac8f84d264d1"}]}, {"trigger": "route", "enemy_ids": [15, 4201], "lines": [{"name": "スカー", "text": "シャァァァァァァック！！\n今日もオレサマのイカリは絶好調だゼェ！！\nどこまで耐えられるか！　見せてみやがれェッ！！", "face": "lac8f84d264d1"}, {"name": "リバン", "text": "あのシャークギルマン、\n攻撃を振るう度に力が増しているみたいですわ！\n王子様、どうかお気をつけて……！", "face": "u1062a1"}]}], "hard": {"level": 170, "multiplier": 1.7, "modifiers": [{"kind": "term", "influence": 12, "params": [200]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 10200, "attack": 1020, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 2, "hp": 10200, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 2, "form_index": 1, "hp": 10200, "attack": 1020, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 3, "hp": 11900, "attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "pattern_id": 2123760}, {"enemy_id": 4, "hp": 34000, "attack": 600, "damage_type": "physical", "armor_defense": 700, "magic_defense": 5, "pattern_id": 2123696}, {"enemy_id": 4, "form_index": 1, "hp": 34000, "attack": 900, "damage_type": "physical", "armor_defense": 700, "magic_defense": 5, "pattern_id": 2123696}, {"enemy_id": 4, "form_index": 2, "hp": 34000, "attack": 1350, "damage_type": "physical", "armor_defense": 700, "magic_defense": 5, "pattern_id": 2123696}, {"enemy_id": 7, "hp": 10200, "attack": 850, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "pattern_id": 2123616}, {"enemy_id": 8, "hp": 5100, "attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2123728}, {"enemy_id": 9, "hp": 68000, "a