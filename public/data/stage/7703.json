se": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124192, "race_id": 20, "change_to": 6, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32923, "global_id": 6540, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6543, "spawn_sec": 93}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124208, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32926, "global_id": 6543, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 10, "source": "local", "count": 10, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124128, "race_id": 20, "change_to": 10, "change_condition": 4, "master_id": 32919, "global_id": 6536, "to_condition": 4, "to_ticks": 3, "to_global_id": 6539, "spawn_sec": 93}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124144, "race_id": 20, "special_effect_id": 222, "master_id": 32922, "global_id": 6539, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 14, "source": "local", "count": 19, "form_count": 2, "tags": ["鳥"], "hp": 1500, "base_hp": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 3, "move_speed": 1250.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2125728, "race_id": 12, "special_effect_id": 70, "change_to": 14, "master_id": 32911, "global_id": 6528, "to_global_id": 6529, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 115}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 1500, "base_hp": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2125744, "race_id": 12, "special_effect_id": 613, "change_to": 13, "master_id": 32912, "global_id": 6529, "ranged": true}], "popups": ["レフカは、自身の攻撃力の値で\n自身を含む周囲の敵を回復します。\n\nまたレフカがいる間は、\n味方の攻撃力がダウンします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レフカ", "text": "――あうぅぅぅ……。\nラシティ、飛び方が雑ですわよ……。\n目が回りましたわぁ……。", "face": "u1559a1"}, {"name": "ラシティ", "text": "文句を言うなら、敵に捕まらないでほしかったね。\nぼくだって、もっとカッコよく\n門番として登場したかったんだけど？", "face": "u1560a1"}, {"name": "レフカ", "text": "うぅ、だってぇ……。\nふわふわ飛んでたら、王国軍が\n侵攻してくるのが見えちゃったんですものぉ……。", "face": "u1559a1"}, {"name": "ラシティ", "text": "そういう時はまず報告。\nヒュープ様だって、腕試しをして、\nぼくらが実力を認めたら通して良いと言ってたじゃないか。", "face": "u1560a1"}, {"name": "レフカ", "text": "はぁい、気をつけますのー。", "face": "u1559a1"}, {"name": "ラシティ", "text": "……まぁ、分かればいいさ。\n次はぼくの相棒として、\nちゃんとカッコよくキメてくれよ？", "face": "u1560a1"}, {"name": "レフカ", "text": "はぁーいですわー。", "face": "u1559a1"}, {"name": "ラシティ", "text": "……はぁ。\nこれは従姉妹殿も苦労したんだろうなぁ。", "face": "u1560a1"}, {"name": "オーキュ", "text": "――えぇ、いっぱい苦労しましたわよ！", "face": "u1101a1"}, {"name": "ラシティ", "text": "おっと、存外早い到着だ。\nそれじゃあ、第一層の門番として、\nその実力を試させてもらおうか。", "face": "u1560a1"}, {"name": "レフカ", "text": "わたくしたちを見事倒せば、\nこの先へ進ませるようにとのお達しですわ。", "face": "u1559a1"}, {"name": "レフカ", "text": "でも、わたくしたちにも敵わない、\nよわよわな感じでしたら、\nここでぼっこぼこにしてやりますわよ！", "face": "u1559a1"}, {"name": "オーキュ", "text": "つまり、ここでふたりを倒せば、\n精神支配も解除して、\n堂々とオリュンポスへ乗り込めますのね。", "face": "u1101a1"}, {"name": "ラシティ", "text": "そういうこと。\nさぁ、ぼくらにその実力を見せてもらおうか！", "face": "u1560a1"}]}, {"trigger": "end", "lines": [{"name": "レフカ", "text": "――降参！　こうさーん！！\n参りましたですわー！！", "face": "u1559a1"}, {"name": "ラシティ", "text": "はぁ……うん、これは認めざるをえないかな。\nぼくも降参するよ。\n噂に違わぬ強さだったね、王国軍。", "face": "u1560a1"}, {"name": "シャルロット", "text": "やれやれ……ようやく解呪してあげられますわね。\nそれじゃあ、そのままじっとして――", "face": "u128"}, {"name": "？？？", "text": "――いや、その必要はないよ。\nレフカ、ラシティ、よく戦ってくれたね。\nおかげでじっくりと、王子を観察できた。", "face": "lb725270a1e70"}, {"name": "？？？", "text": "それじゃあ、後は好きにするといい。\n君たちの精神支配は解いておくからね。", "face": "lb725270a1e70"}, {"name": "レフカ", "text": "ふぁ……ひゅーぷさま……？", "face": "u1559a1"}, {"name": "ラシティ", "text": "……おや、ここは……？\nぼくらはいったい……？", "face": "u1560a1"}, {"name": "ヒュープ", "text": "さて、初めましてだね。\nえぇと、王国の王子、だったかな？", "face": "lb725270a1e70"}, {"name": "ヒュープ", "text": "僕は亜神ヒュープ。\nオリュンポス第一層の管理者だ。", "face": "lb725270a1e70"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ヒュープ", "text": "いやぁ、よく来てくれたよ。\n僕はずっと君を待っていたんだ。", "face": "lb725270a1e70"}, {"name": "ヒュープ", "text": "暗い夢の水底で、まばゆい天頂の幻の中で、\n温かなまどろみの淵で、\n見果てぬ夢、叶わぬ夢を願う欲望の中心で……。", "face": "lb725270a1e70"}, {"name": "トラム", "text": "……これは……王子！\nだめよ！　彼の言葉に耳をかしたら――", "face": "u1110a1"}, {"name": "ヒュープ", "text": "遅いよ、亜神トラム。\n人の子は、決して己の夢からは逃げられないのだからね。", "face": "lb725270a1e70"}, {"name": "ヒュープ", "text": "さぁ、眠れ、王子――。", "face": "lb725270a1e70"}]}], "active": true}