{"quest_id": 4777, "name": "博士のメッセージ", "description": "王子達にゴブリンの軍勢が\n襲い来る！\n敵の隊形に留意せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "女神の封印", "event_category": "History", "mission_id": 920080, "map_no": 5302, "level": 80, "multiplier": 0.8, "charisma": 50, "exp": 270, "gold": 1200, "drops": [{"card": 345, "c": 1}, {"card": 205, "c": 1}, {"card": 57, "c": 1}, {"item": 1007, "c": 1}, {"item": 5003, "c": 2}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 211, "form_index": 0, "form_count": 1, "hp": 512, "attack": 112, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 28, "form_index": 0, "form_count": 1, "hp": 800, "attack": 120, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 84}, {"enemy_id": 3, "source": "local", "count": 4, "level": 60, "form_index": 0, "form_count": 1, "hp": 960, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 101}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 6400, "attack": 200, "base_hp": 8000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 79, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108384, "master_id": 30025, "global_id": 3644, "spawn_sec": 144}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 12000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "attack_range": 400, "attack_speed": 70, "attack_wait": 35, "attack_interval": 130, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105472, "race_id": 6, "missile_id": 151, "missile": {"speed": 3.0}, "master_id": 30026, "global_id": 3645, "ranged": true, "spawn_sec": 144}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "我々、魔族の復活カラ早３年余リデアル……。\nまさか、ワタクシの頭脳ヲこれ程使ワネバナラヌ\n人間ガイルトハ想定外……。　想定外デアル！", "face": "l986dcca124d3"}, {"name": "ゴブリン", "text": "ソウテイガイ！　ソウテイガイ！", "face": "l3f436d46b28f"}, {"name": "ゴブリン博士", "text": "……実ニ、嬉シイ。\nワタクシ、今日ハこの想イヲ\n戦場ニ、ブツけるのデアル。", "face": "l986dcca124d3"}, {"name": "ゴブリン博士", "text": "ゴブリン兵！　ススメ！\n今日コソ王子軍ヲ倒すのデアル！", "face": "l986dcca124d3"}]}, {"trigger": "battle", "at_sec": 142, "lines": [{"name": "ゴブリン", "text": "オウジ　ツヨイ　タイキャク！\nオウジ　ツヨイ　タイキャク！", "face": "l3f436d46b28f"}, {"name": "ゴブリン博士", "text": "サスガ王子軍。\nココマデハ、ワタクシも王子サエも想定内デアロウ。\nダガ、今回ハ奥ノ手ヲ用意シテイルのダ！\n", "face": "l986dcca124d3"}, {"name": "ゴブリン博士", "text": "サァ、オ前達！　ユクノデアル！", "face": "l986dcca124d3"}, {"name": "カルマ", "text": "王子……。魔の花嫁となる宿命から、\n私を救って頂いた事は忘れていません。", "face": "u1106"}, {"name": "カルマ", "text": "この花嫁衣裳、\n王子のお傍で、永遠のものとさせてください。", "face": "u1106"}, {"name": "ミルノ", "text": "神を裏切ってしまった罪は\n消えはしないのですよね……。\n王子と共に歩めば、いつかあがなえると信じています。", "face": "u1337"}, {"name": "ゴブリン博士", "text": "フヒヒヒ。\n心の奥ニ眠ル闇の意識がバッチリ活性化シテイル。\nワタクシが新たに開発シタ秘薬ノ力は絶大デアル！", "face": "l986dcca124d3"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "ヒーー！\nコレデモ、ダメなのか！", "face": "l986dcca124d3"}, {"name": "ゴブリン博士", "text": "王子メ、\nお前の力が勝ツカ、ワタクシの頭脳が勝ツカ、\nイズレ必ず決着をつけるノデアル！", "face": "l986dcca124d3"}, {"name": "兵士", "text": "報告！\nゴブリン軍、退却していきます！", "face": "ld5b089f2b266"}, {"name": "ケイティ", "text": "ふぅ。ゴブリン軍の戦闘力は侮れませんね、王子。\nあれ程美しい隊列は、他の軍隊でも見た事がありません。\n一体どれ程訓練をしたのでしょうか……。", "face": "u114"}, {"name": "アンナ", "text": "ゴブリンが努力をするなんて……。\n王子、魔物達は益々力をつけてきているようですね。", "face": "l8b956a21ebca"}, {"name": "アンナ", "text": "ですが王子と一緒なら、\nどの様な困難でも乗り越えられると信じています。"}]}], "map": {"image": "Map920080_5302", "w": 960, "h": 640, "spots": [{"k": "b", "x": 30, "y": 280}, {"k": "m", "x": 303, "y": 210, "id": 200}, {"k": "m", "x": 303, "y": 288, "id": 201}, {"k": "m", "x": 303, "y": 363, "id": 202}, {"k": "m", "x": 525, "y": 212, "id": 203}, {"k": "m", "x": 525, "y": 290, "id": 204}, {"k": "m", "x": 525, "y": 371, "id": 205}, {"k": "m", "x": 714, "y": 210, "id": 206}, {"k": "m", "x": 714, "y": 284, "id": 207}, {"k": "m", "x": 714, "y": 361, "id": 208}, {"k": "m", "x": 414, "y": 210, "id": 209}, {"k": "m", "x": 414, "y": 288, "id": 210}, {"k": "m", "x": 414, "y": 363, "id": 211}, {"k": "m", "x": 619, "y": 212, "id": 212}, {"k": "m", "x": 619, "y": 290, "id": 213}, {"k": "m", "x": 619, "y": 371, "id": 214}, {"k": "m", "x": 192, "y": 210, "id": 215}, {"k": "m", "x": 192, "y": 284, "id": 216}, {"k": "m", "x": 192, "y": 361, "id": 217}, {"k": "r", "x": 192, "y": 127, "id": 300}, {"k": "r", "x": 192, "y": 457, "id": 301}, {"k": "r", "x": 303, "y": 127, "id": 302}, {"k": "r", "x": 303, "y": 457, "id": 303}, {"k": "r", "x": 414, "y": 127, "id": 304}, {"k": "r", "x": 414, "y": 457, "id": 305}, {"k": "r", "x": 525, "y": 127, "id": 306}, {"k": "r", "x": 525, "y": 457, "id": 307}, {"k": "r", "x": 619, "y": 127, "id": 308}, {"k": "r", "x": 619, "y": 457, "id": 309}, {"k": "r", "x": 714, "y": 127, "id": 310}, {"k": "r", "x": 714, "y": 457, "id": 311}]}, "start_cost": 10, "active": true, "name_en": "Doctor's Message", "description_en": "A horde of Goblins attacks the Princes!\nWatch the enemy formation!\nAdvanced (★1 target: average Lv10)"}