ur": {"transforms": [{}]}, "spawn_sec": 104}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物"], "fixture": true, "hp": 700, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "magical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 120, "attack_interval": 326, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2097280, "change_to": 13, "missile_id": 6, "master_id": 33841, "global_id": 7458, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 700, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 120, "attack_interval": 306, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2129456, "master_id": 33836, "global_id": 7453, "spawn_sec": 117}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン", "text": "ギャギャ！　トツゲキ！　トツゲキ！！", "face": "l4cdc375dd5c6"}, {"name": "アリサ", "text": "はぁ……はぁ……っ、\n王子、ここにいたんですね……！", "face": "u24"}, {"name": "アリサ", "text": "伝令です！　王城は完全に占拠されました。\n生き延びた兵は王都の外にて、\n部隊を再編中ですが、動ける戦力は多くありません……。", "face": "u24"}, {"name": "アリサ", "text": "北の大国からも部隊が派遣されたそうですが、\nおそらく、もう間に合わないかと……。", "face": "u24"}, {"name": "ソーマ", "text": "……王城が、英雄王さまの築いたお城が、\n陥ちてしまうなんて……。", "face": "u23"}, {"name": "警備兵Ａ", "text": "……それでは、国王陛下は……。", "face": "u64"}, {"name": "王子", "text": "…………ッ。", "face": "u1"}, {"name": "警備兵Ｂ", "text": "王子、いったい何を……。\nまさか、戦うおつもりですか！？", "face": "u69"}, {"name": "ソーマ", "text": "……もし王子が、ここで命を捨てるつもりなら、\n私も最後まで、王子と一緒に戦います！", "face": "u23"}, {"name": "アリサ", "text": "私もです！\n王子が逃げないのなら、\n皆、ここで命を捨てる覚悟です！", "face": "u24"}, {"name": "警備兵Ａ", "text": "無論、我々もですよ、王子。\nあなたの存在は、我らの最後の希望なのですから。", "face": "u64"}, {"name": "王子", "text": "……ソーマ、アリサ、皆。", "face": "u1"}, {"name": "王子", "text": "――分かった、逃げ延びよう。\n生きて、反撃の時を待とう。", "face": "u1"}, {"name": "ソーマ", "text": "……っ！　はいっ！！", "face": "u23"}, {"name": "アリサ", "text": "城壁は突破されましたが、\nまだ城下町方面への突破口は残されています。\n皆で血路を開きましょう！", "face": "u24"}]}, {"trigger": "battle", "at_sec": 98, "lines": [{"name": "ソーマ", "text": "王子、魔物の攻勢が弱まりました！\n西門から抜けられそうです！", "face": "u23"}, {"name": "アリサ", "text": "王子、傷を癒します。\n走れそうですか……？", "face": "u24"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "battle", "at_sec": 106, "lines": [{"name": "ソーマ", "text": "王子、肩を貸します。\n急いで王城を脱出しま――", "face": "u23"}, {"name": "リッチ", "text": "英雄王ノ系譜……王国ノ民……。\nスベテ……スベテ死ニ至レ……。", "face": "ldbdb1ea40d48"}, {"name": "アリサ", "text": "なっ……ソーマ、危ないッ！！", "face": "u24"}]}, {"trigger": "battle", "at_sec": 110, "lines": [{"name": "ソーマ", "text": "え……っ？", "face": "u23"}, {"name": "ソーマ", "text": "王子、どうして私なんかをかばって……。", "face": "u23"}]}, {"trigger": "battle", "at_sec": 117, "lines": [{"name": "アリサ", "text": "ソーマ、話は後にしましょう。\nリッチがひるんでいる、今が好機です。", "face": "u24"}, {"name": "王子", "text": "……全部を選んで、全部を救う、か。", "face": "u1"}, {"name": "王子", "text": "必ず、俺が皆の故郷を取り戻す。\n王都を、この世界を、必ず――。", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "アリサ", "text": "王城を脱出したら、\nまずは生き残った部隊との合流を目指しましょう。", "face": "u24"}, {"name": "ソーマ", "text": "そのための移動経路確保は、\n私たちにまかせてください！\n魔物の少ない道を、先行して探してきますね。", "face": "u23"}, {"name": "アリサ", "text": "城の外では、政務官のアンナさんが\n各部隊をまとめているはずです。\n王子、どうか、王国の未来をお願いします！", "face": "u24"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 18, "params": [120]}], "enemies": [{"enemy_id": 4, "hp": 1500, "attack": 225, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2097184}, {"enemy_id": 1, "hp": 1350, "attack": 300, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2097360}, {"enemy_id": 2, "hp": 960, "attack": 210, "damage_type": "physical", "pattern_id": 2097200}, {"enemy_id": 5, "hp": 7500, "attack": 600, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2097792}, {"enemy_id": 3, "hp": 960, "damage_type": "physical", "armor_defense": 40, "pattern_id": 2097216}, {"enemy_id": 6, "hp": 1500