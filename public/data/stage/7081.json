 "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114192, "race_id": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30948, "global_id": 4567, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 9, "master_id": 656, "global_id": 655, "to_global_id": 648, "spawn_sec": 95}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 11, "master_id": 873, "global_id": 872, "spawn_sec": 95}], "popups": ["サンダーバードは\nダメージを受けると反撃を行います。\n拠点には向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "レオナ", "text": "――魔術で浮遊している遺跡の噂は聞いていたが、\nまさかそれが天界の門だったとはな。", "face": "u311"}, {"name": "レオラ", "text": "それで帝国を頼ってきたってわけねぇ。\nこの高度にたどり着ける飛行船は、\n私たちしか持っていないものねぇ♪", "face": "u464"}, {"name": "レオナ", "text": "だがこの空域は、稲妻をまとう巨鳥、\nサンダーバードの縄張りだ。\n門を開くなら早くしたほうが――", "face": "u311"}, {"name": "タラニア", "text": "……いや、轟く遠雷は、先程からこちらを\nずっと見張っているようだ。\n僕らが悪なる者かどうか、見極めるためにね。", "face": "u967"}, {"name": "ラテリア", "text": "えぇと、サンダーバードが近くにいるってこと？\nまぁでも、伝承によれば警戒心は強いけど、\nこちらから手を出さなければ無害って聞いてるよ。", "face": "u532"}, {"name": "レオナ", "text": "ふむ……ならばあえて戦う必要もないだろう。\n王子、早々に天界の門を開く儀式を進めるといい。", "face": "u311"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "天使", "text": "――いいえ、そうはさせません。\nこんな古い門を知っているとは驚きましたが、\n監視していた甲斐があったというものです。", "face": "l8068500efeb1"}, {"name": "ソフィー", "text": "……この門を知っているとは、\nあなたに命を下している者は、\n随分と古い知識をお持ちのようですね。", "face": "u146"}, {"name": "天使", "text": "さて、どうでしょうか。\n堕天した者に答えるつもりはありません。\nさぁ、ここで飛行船ごと墜としてあげましょう。", "face": "l8068500efeb1"}, {"name": "アンナ", "text": "王子、天使の軍勢が向かってきます。\n付近にはサンダーバードもいますから、\n慎重な采配をお願いします！", "face": "l11d67a4b7fc6"}]}, {"trigger": "battle", "at_sec": 63, "lines": [{"name": "ソフィー", "text": "おや、あの雲は……。\nもしや天界と同じ魔力を帯びて……？", "face": "u146"}, {"name": "フォニア", "text": "なるほど、ならば足場にできそうですね。\n王子、今出現した雲は魔力で固体化しています。\n雲の上に立って戦うことも可能でしょう。", "face": "u548"}]}, {"trigger": "end", "lines": [{"name": "天使", "text": "……そんな……私たちが、負ける、とは……。", "face": "l8068500efeb1"}, {"name": "レオナ", "text": "王子、天使の攻勢が止まった。\n天界に乗り込むのなら今のうちだ。", "face": "u311"}, {"name": "フォニア", "text": "それでは、天界の門を開きます。\n皆さん、衝撃に備えてください。", "face": "u548"}, {"name": "ソフィー", "text": "行きますよ、フォニアさん、クロエさん。\n古い門ですから、多めに魔力を注ぎます。", "face": "u146"}, {"name": "クロエ", "text": "……久しぶりだから上手くできるか分からないけど、\nうん、ちょっと頑張ってみようかな。", "face": "u145"}, {"name": "アンナ", "text": "……天界、いったいどんな所なのでしょう。\n私たち人間が、踏み入って良い場所なのでしょうか。", "face": "l11d67a4b7fc6"}, {"name": "アンナ", "text": "……いえ、弱気になっていてはいけませんね。\n王子、飛行船から遺跡に移る準備をしておきましょう！", "face": "l11d67a4b7fc6"}]}], "active": true}