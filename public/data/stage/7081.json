{"quest_id": 7081, "name": "忘れ去られし門", "description": "帝国の協力により、高空に浮かぶとある\n遺跡に辿り着いた。伝説の巨鳥を刺激する\nことなく、天使の軍勢を退けよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ27(2020)", "event_category": "Reproduce", "mission_id": 300277, "map_no": 4024, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107376, "race_id": 6, "master_id": 572, "global_id": 571, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["鳥"], "hp": 80000, "base_hp": 80000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "attack_speed": 1, "attack_wait": 90, "attack_interval": 246, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123376, "race_id": 11, "special_effect_id": 552, "change_to": 3, "change_condition": 5, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 32631, "global_id": 6249, "to_condition": 5, "to_global_id": 6250, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 80000, "attack": 900, "base_hp": 80000, "base_attack": 900, "damage_type": "magical", "armor_defense": 400, "mag