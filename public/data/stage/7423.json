792, "race_id": 16, "master_id": 30637, "global_id": 4256, "from_condition": 0}, {"enemy_id": 7, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "tags": ["帝国"], "hp": 20000, "attack": 450, "base_hp": 20000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130064, "race_id": 16, "special_effect_id": 242, "change_to": 7, "master_id": 34059, "global_id": 7676, "to_condition": 0, "to_global_id": 7675, "route_behaviour": {"hold": {"routes": 4, "held": 4}, "reroutes": ["Route=999"]}, "spawn_sec": 97}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["帝国"], "hp": 20000, "attack": 450, "base_hp": 20000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130064, "race_id": 16, "master_id": 34058, "global_id": 7675, "from_condition": 0}, {"enemy_id": 9, "source": "local", "count": 2, "form_index": 0, "form_count": 3, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 242, "change_to": 9, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 34061, "global_id": 7678, "ranged": true, "to_condition": 0, "to_global_id": 7679, "route_behaviour": {"hold": {"routes": 2, "held": 2}, "reroutes": ["Route=999"]}, "spawn_sec": 161}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "change_to": 10, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 34062, "global_id": 7679, "ranged": true, "from_condition": 0, "to_condition": 0, "to_global_id": 3640}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "from_condition": 0}], "popups": ["発光するマスに配置した\nユニットは射程が\n上昇します。", "軍艦が着岸すると、\n艦内の敵が登場します。\n軍艦を撃破すると、艦内の敵も\n同時に倒すことができます。\n\nまた軍艦は、海上で停止中の時のみ\n砲撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "ふぁ……あふ……。\nうぅぅ、睡眠不足だぁ……。", "face": "u1344a1"}, {"name": "？？？", "text": "そろそろ交代の時間です。\n仮眠をとってきてください、カテリナさん。", "face": "u1343a1"}, {"name": "カテリナ", "text": "マルゴットー！\nやった！　やっと睡眠時間だー！\nカテリナさんの頭脳は睡眠を求めて……すやぁ……。", "face": "u1344a1"}, {"name": "マルゴット", "text": "はいはい、ここで寝ないでくださいね。\nいつダークエルフの襲撃が\nあるか分からないのですから。", "face": "u1343a1"}, {"name": "マルゴット", "text": "伝令が無事にたどり着いていれば、\nそろそろ援軍がやってくる頃です。\nもう少しだけ、今の戦力で頑張りましょう。", "face": "u1343a1"}, {"name": "カテリナ", "text": "マルゴットはこういう状況慣れてるだろうけど、\n私は最前線向きじゃな――んっ？\nあっ！　あー！！　噂をすればっ！！", "face": "u1344a1"}, {"name": "マルゴット", "text": "海岸線の向こうに、軍艦が！\n――いえ、それにしては妙な……。", "face": "u1343a1"}, {"name": "マルゴット", "text": "あれが帝国の援軍なのだとしたら、\nなぜ海から……それにあの軍艦、\n軍旗を掲げていないように見えます。", "face": "u1343a1"}, {"name": "カテリナ", "text": "……えっとー？\nそれってもしかして……。", "face": "u1344a1"}, {"name": "マルゴット", "text": "敵の増援、かもしれません。\nあれだけの艦隊ならば、\n上陸部隊もかなりの数でしょう。", "face": "u1343a1"}, {"name": "カテリナ", "text": "……はぁ、やるしかない、かぁ。\nマルゴット、他の兵士にも伝えに行こ。", "face": "u1344a1"}, {"name": "マルゴット", "text": "……カテリナさん、存外やる気ですね。\nてっきり駄々をこねるかと思いましたが……。", "face": "u1343a1"}, {"name": "カテリナ", "text": "失敗したって死にはしない、\n成功すれば一生誇れる！\nそう思えばなんだって頑張れるって！", "face": "u1344a1"}, {"name": "マルゴット", "text": "中々剛毅な名言ですね……。\nですが、確かに何でもできる気がしてきました。", "face": "u1343a1"}, {"name": "マルゴット", "text": "カテリナさん、これだけの広域に渡る戦闘です。\n普段とは射程の感覚が違うと思いますから、\nしっかり見極めて行動するようにしてくださいね。", "face": "u1343a1"}, {"name": "カテリナ", "text": "もっちろん、分かってるって。\nそれよりあの艦隊、沈められないかな？\n上陸前に倒せば一網打尽だよね。", "face": "u1344a1"}, {"name": "マルゴット", "text": "確かに……。\nでも無理はしないように！\n援軍がきっと来てくれるはずですから！", "face": "u1343a1"}, {"name": "ソーマ", "text": "――あれは……大変です！\nもう戦闘が始まりそうですよ！", "face": "u23"}, {"name": "アンナ", "text": "王子、港町の防衛部隊も出ているようです。\n協力して戦闘を進めましょう。", "face": "l91db55a83012"}, {"name": "デューオ", "text": "あの軍艦……まずいな、大砲が陸を向いてやがる。\n王子、あいつら上陸前にぶっ放してくるよ！", "face": "u594"}]}, {"trigger": "end", "lines": [{"name": "ベラート", "text": "――ふむ、帝国軍ばかりか王国軍までも。\n帝都からにしては、随分と早い到着だ。", "face": "l21787b277675"}, {"name": "ベラート", "text": "英雄王の系譜、その力を借りねば\n帝国の維持も出来ないとは……。\n何が力ある者だ、何が皇帝だ。", "face": "l21787b277675"}, {"name": "？？？", "text": "……嬉しそうだな、ベラート伯爵。\nそんなに白の皇帝と戦いたかったのか？", "face": "l20ac59a2a223"}, {"name": "ベラート", "text": "おぉ、セグナンド殿。\nはて……どうでしょうな……。", "face": "l21787b277675"}, {"name": "ベラート", "text": "白の王国貴族たちの\n無念を代表してここにあるのは確かですが、\nさりとて皇帝の首を取りたいかと言えば……。", "face": "l21787b277675"}, {"name": "セグナンド", "text": "……国を奪われたのだろう？\n国とは故郷であり、骨を埋めるべき父祖の地だ。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "故郷を奪われた貴殿には、我らと同じく、\nその怒りをもって皇帝を断罪する権利がある。\nだというのに、何を思い悩んでいる。", "face": "l20ac59a2a223"}, {"name": "ベラート", "text": "……戦が起きれば、民は困窮しますからな。\n怒りだけで戦うことはできない、\nそれは偽らざる真実でありましょう。", "face": "l21787b277675"}, {"name": "セグナンド", "text": "不器用な男め。\n――だが、今は我らがいる。\n手を取り合う、戦友がいるではないか。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "これは、故郷を取り戻す戦いだ。\n胸を張って舵を取れ。\nさぁ、今しばらく海上支援は任せたぞ。", "face": "l20ac59a2a223"}, {"name": "ベラート", "text": "そう、でしたな……。\nそれではセグナンド殿、地上の制圧は任せましたぞ。", "face": "l21787b277675"}]}, {"trigger": "end", "lines": [{"name": "マルゴット", "text": "――陛下、それに王子殿下！\nよかった……援軍が間に合ったのですね！", "face": "u1343a1"}, {"name": "ディアナ", "text": "ご苦労でした、マルゴット教導隊長。\nあなたが防衛部隊を指揮してくれていたのですね。", "face": "u624"}, {"name": "マルゴット", "text": "最初のダークエルフの襲撃で、\n警備部隊長が負傷してしまいましたので……。", "face": "u1343a1"}, {"name": "レオナ", "text": "援軍到着まで保たせただけで勲章ものだ。\n後は我々にまかせておけ。", "face": "u311"}, {"name": "リーンベル", "text": "……しかし、あの艦隊はいったいどこから？\nあの規模の船団が動けば、\n噂のひとつも立ちそうなものだが。", "face": "u268"}, {"name": "白の皇帝", "text": "……提督、もったいぶった言い方をする必要はない。\nあれは、元は帝国艦隊のひとつだ。", "face": "u418"}, {"name": "レオナ", "text": "白の帝国――いや、白の王国というべきか。\n王政時代に領海を守護した、貴族たちの率いる艦隊だ。", "face": "u311"}, {"name": "リーンベル", "text": "――では、此度の大戦、\nもはや異種族と帝国の戦いには収まらないということか。\n貴殿らは、同じ国の兵に刃を向けるのだな？", "face": "u268"}, {"name": "レオナ", "text": "あちらも、きっとそれと同じ問いを、\nベラート伯爵にしたことだろう。", "face": "u311"}, {"name": "白の皇帝", "text": "俺たちの選んだ道が、今になって、\nようやく牙を剥いてきただけのことだ。", "face": "u418"}, {"name": "白の皇帝", "text": "民を守る、強き力を持つ者が皇帝となる。\nこちらの流儀に、あちらもあわせてくれている。", "face": "u418"}, {"name": "白の皇帝", "text": "ならば、白の王国貴族に恥をかかせるな。\n正面から打ち破り、\n民を守護すべきはどちらかを教えてやれ。", "face": "u418"}, {"name": "レオナ", "text": "――はっ。\n総員、陣形を整えろ！\nまもなく敵の第二波が来るぞ！", "face": "u311"}]}], "map": {"image": "Map940006_4572", "w": 960, "h": 640, "spots": [{"k": "b", "x": 176, "y": 229}, {"k": "m", "x": 516, "y": 129, "id": 200}, {"k": "m", "x": 402, "y": 82, "id": 201}, {"k": "m", "x": 251, "y": 60, "id": 202}, {"k": "m", "x": 92, "y": 99, "id": 203}, {"k": "m", "x": 48, "y": 219, "id": 204}, {"k": "m", "x": 332, "y": 216, "id": 205}, {"k": "m", "x": 434, "y": 208, "id": 206}, {"k": "m", "x": 400, "y": 310, "id": 207}, {"k": "m", "x": 188, "y": 299, "id": 208}, {"k": "m", "x": 212, "y": 381