{"quest_id": 8036, "name": "第六陣 死を背負う者", "description": "守るべき者の悲哀や嘆きを聴き、\n暴走している亜神ヘリューズを止めよ！\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国六陣", "event_category": "Empire", "mission_id": 940002, "map_no": 4779, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 24, "form_count": 1, "tags": ["アンデッド"], "hp": 18000, "attack": 900, "base_hp": 18000, "base_attack": 900, "damage_type": "physical", "armor_defense": 660, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2146176, "master_id": 36399, "global_id": 10016, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 120000, "attack": 5000, "base_hp": 120000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 800, "attack_speed": 120, "attack_wait": 10, "attack_interval": 221, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2127520, "race_id": 10, "master_id": 36422, "global_id": 10039, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 17, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 6}, {"enemy_id": 4, "source": "local", "count": 8, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defen