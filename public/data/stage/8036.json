st": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 180}, {"enemy_id": 28, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104608, "missile_id": 6, "master_id": 556, "global_id": 555, "ranged": true, "spawn_sec": 215}, {"enemy_id": 29, "source": "local", "count": 10, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 400, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102160, "master_id": 364, "global_id": 363, "spawn_sec": 223}], "popups": ["亜神ヘリューズがいる間は、\n全てのアンデッドの攻撃と防御が\nアップします。\n\n\n\n\n　　　　　　(1/2)", "亜神ヘリューズは\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ\n\n\n\n　　　　　　(2/2)", "亜神ヘリューズの眷属は\n一定範囲内のユニットに\n継続ダメージを与えます。\n\nまた亜神ヘリューズの眷属は\n倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヘリューズ", "text": "（――魔界へ逃げることもできず、\nさりとて、物質界で賊のように生きることもできず）", "face": "u1919a1"}, {"name": "ヘリューズ", "text": "（誇り高き戦士でありながら、\n強き者に敗れ、長く苦しい日々を生き続け……）", "face": "u1919a1"}, {"name": "ヘリューズ", "text": "（亜神であることを捨てられなかった、\n私とどこか似た、ダークエルフの戦士たち……）", "face": "u1919a1"}, {"name": "ヘリューズ", "text": "（かの暴虐の骸帝より、\n私が、あの子らを守ってあげなければ）", "face": "u1919a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "白の皇帝", "text": "どうした王子。\n王国軍は下げておけ。\nここでお前の軍を消耗させたくはない。", "face": "u418"}, {"name": "ヘリューズ", "text": "（……おや？　人の子よ、\nもしや、私の声が、聴こえているのですか？）", "face": "u1919a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "白の皇帝", "text": "……王子？\nまさか、奴の声が分かるのか？", "face": "u418"}, {"name": "ジェニー", "text": "……嘘は、言ってなさそう。\n隠し事の上手そうな顔だけど、\n本当に、あの亜神の言葉が分かるみたい。", "face": "u1923a1"}, {"name": "白の皇帝", "text": "女神アイギスの加護か、あるいは――\nいや、考えるのは後にしよう。", "face": "u418"}, {"name": "白の皇帝", "text": "王子、お前なら、\nあの亜神の目を覚ましてやれるか。", "face": "u418"}, {"name": "王子", "text": "…………。\n………………（こくり）", "face": "u1"}, {"name": "ヘリューズ", "text": "死を背負い、嘆きを背負い、\nされどその音色はどれも、\nあなたを後押ししているように聴こえます。", "face": "u1919a1"}, {"name": "ヘリューズ", "text": "どれだけの悲しみを背負ってきたのですか。\nどれだけの嘆きを、その胸に抱いてきたのですか。", "face": "u1919a1"}, {"name": "ヘリューズ", "text": "それでもなお、進もうとする、なんて。\nどうか、おやめなさい。\nあなたの歩む道は、あなたを苦しめるばかりです。", "face": "u1919a1"}, {"name": "王子", "text": "――俺の苦しみは、どうでもいい。", "face": "u1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "ヘリューズ", "text": "…………そう、ですか。\nならば、私が代わりに泣きましょう。\nあなたのために、あなたの痛みのために。", "face": "u1919a1"}, {"name": "アンナ", "text": "王子、亜神ヘリューズの軍勢が来ます。\n前線拠点の防衛指揮、お願いします！", "face": "l3ce37df4acc6"}]}, {"trigger": "end", "lines": [{"name": "ヘリューズ", "text": "……私は、何を……ここは……？", "face": "u1919a1"}, {"name": "ヘカティエ", "text": "ヘリューズ、ようやく正気に戻ったようね。\n守る者がいるとはいえ、\n死の蔓延する最前線にでるなんて。", "face": "u1226a1"}, {"name": "ヘリューズ", "text": "ヘカティエ……？\nああ、また暴走してしまったのですね……。", "face": "u1919a1"}, {"name": "ヘカティエ", "text": "わざと、じゃないの？\nアスガルドに災禍をもたらすほどの魔力を、\n暴走させてでも、骸帝を倒そうとしたのでしょう。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "そんなことをしたら、\nまた自分が、悲哀と嘆きの音色で苦しむことになるのに。\nお人好し自己犠牲引きこもり亜神なんだから。", "face": "u1226a1"}, {"name": "ヘリューズ", "text": "えへ……褒められると照れますよ。", "face": "u1919a1"}, {"name": "ジェニー", "text": "……褒めてな……うぅん、確かに褒めてるね。", "face": "u1923a1"}, {"name": "パラベル", "text": "亜神ってめんどいですの……。", "face": "u1922a1"}, {"name": "白の皇帝", "text": "……どうやら、話は通じるようだな。", "face": "u418"}, {"name": "ヘリューズ", "text": "あなたは、白の皇帝ですね。\n骸帝と少しだけ似た音色を感じます。", "face": "u1919a1"}, {"name": "ヘリューズ", "text": "それから、そっちはセグナンドの娘さん。\n良かった、無事に戻って来られたのですね。", "face": "u1919a1"}, {"name": "イルヴィ", "text": "はい、ヘリューズ様。\n家族は――私の部族の皆は無事だろうか！？", "face": "u1918a1"}, {"name": "ヘリューズ", "text": "えぇ、大丈夫。\n第二層は封鎖階層ですから。", "face": "u1919a1"}, {"name": "ヘリューズ", "text": "ハイドースの築いたこの封鎖結界を破るのは、\n冥神たるハイドースそのものに反旗を翻すのと同じ。\n骸帝とて、そんなことはできないでしょう。", "face": "u1919a1"}, {"name": "レオナ", "text": "……いや、待て。\n結界を破ること自体は、可能なのか？", "face": "u311"}, {"name": "ヘリューズ", "text": "強大な魔力と、\n結界を抜けることによる苦痛に耐えられる精神があれば。\n……いえ、まさか……そんな者がいるはずが。", "face": "u1919a1"}, {"name": "レオナ", "text": "亜神ヘリューズ、\nダークエルフたちの居場所へ案内してくれ。", "face": "u311"}, {"name": "パラベル", "text": "…………嫌な予感は、当たるもの、ですの。", "face": "u1922a1"}]}], "hard": {"level": 110, "multiplier": 1.1, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "hp": 19800, "attack": 990, "damage_type": "physical", "armor_defense": 660, "pattern_id": 2146176}, {"enemy_id": 2, "hp": 132000, "attack": 5500, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2127520}, {"enemy_id": 3, "hp": 1100, "attack": 330, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2098672}, {"enemy_id": 4, "hp": 3300, "attack": 660, "damage_type": "physical", "armor_defense": 220, "pattern_id": 2098688}, {"enemy_id": 5, "hp": 94600, "attack": 1400, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "pattern_id": 2146208}, {"enemy_id": 6, "hp": 110000, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "pattern_id": 2146208}, {"enemy_id": 6, "form_index": 1, "hp": 110000, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "pattern_id": 2146208}, {"enemy_id": 6, "form_index": 2, "hp": 110000, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "pattern_id": 2146208}, {"enemy_id": 6, "form_index": 3, "hp": 110000, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "pattern_id": 2146208}, {"enemy_id": 6, "form_index": 4, "hp": 110000, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "pattern_id": 2146208}, {"enemy_id": 6, "form_index"