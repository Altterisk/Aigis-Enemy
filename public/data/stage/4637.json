ost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 110}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 143}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099440, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 84, "global_id": 83, "ranged": true, "spawn_sec": 151}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 2, "tags": ["アンデッド"], "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 60, "attack_wait": 40, "attack_interval": 201, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099376, "change_to": 7, "change_condition": 3, "master_id": 143, "global_id": 142, "to_condition": 3, "to_global_id": 143, "spawn_sec": 154}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 24, "attack_interval": 49, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099392, "special_effect_id": 222, "master_id": 144, "global_id": 143, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "どうやらここが先程の\nお爺さんが言っていた街のようですね。", "face": "l2e51ace5ef66"}, {"name": "アンナ", "text": "それにしても、なんて酷い有り様でしょう。\n魔物がこんなに沢山……。\nあ、あそこに人がいるようです、王子！", "face": "l2e51ace5ef66"}, {"name": "マオ", "text": "はぁ……はぁ……倒しても倒してもキリがない……。\nまさかこれ程の数のキョンシーが\nいるなんて……ッ！", "face": "u361"}, {"name": "アンナ", "text": "私達も加勢します！", "face": "l2e51ace5ef66"}, {"name": "マオ", "text": "貴方たちは……！？", "face": "u361"}, {"name": "マオ", "text": "いえ、そんなことよりも気をつけてください！\nキョンシーは一筋縄ではいかない魔物です！", "face": "u361"}, {"name": "ケイティ", "text": "キョンシー？\n見たことのない魔物ですね……。\nそれに人間の様にも見えるのですが……。", "face": "u114"}, {"name": "マオ", "text": "……キョンシーとは、死んだ人間を\n妖術によって使役しているものです……。\n死者の魂を弄する禁忌の外法なのです！", "face": "u361"}, {"name": "ケイティ", "text": "「アンデッド」という事ですね……。\n死者を弄ぶとは……なんて、ひどいことを……。\n助けることは、できないのですか？", "face": "u114"}, {"name": "マオ", "text": "方法は一つしかありません……。\nそれはキョンシーを無力化し、\n術から解放することです！", "face": "u361"}, {"name": "マオ", "text": "私ひとりではこれ以上戦えそうにありません……。\nどうか貴方の力をお貸し下さい！", "face": "u361"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "全てのキョンシーを鎮圧できたようですね！\n王子、お疲れ様でした。"}, {"name": "マオ", "text": "これで彼らの魂も、\n術者の妖術の拘束から解放されることでしょう。\n本当に、よかった……。", "face": "u361"}, {"name": "ケイティ", "text": "ですが、妖術によって操られていたということは\n当然、術者がいるということですよね？\nいったい誰がこんなひどいことを……。", "face": "u114"}, {"name": "マオ", "text": "相当な妖術の使い手でなくては\nキョンシーを使役することはできません。", "face": "u361"}, {"name": "マオ", "text": "この街を滅ぼして己の領地とした\n妖虎仙の仕業とみて間違いないと思います。", "face": "u361"}, {"name": "ケイティ", "text": "ということは、まだ多くの人々が\n妖虎仙の妖術によって苦しめられている\n可能性がありそうですね……。", "face": "u114"}, {"name": "アンナ", "text": "王子、これ以上\n妖虎仙を放っておいては危険です……。\n急ぎ街の奥へと進みましょう！", "face": "l2e51ace5ef66"}]}], "active": true}