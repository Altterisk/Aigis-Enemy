 true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 275, "change_to": 12, "master_id": 35853, "global_id": 9470, "to_global_id": 9471}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 8, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 1247, "change_to": 13, "master_id": 35854, "global_id": 9471, "to_global_id": 9472}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 9, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 275, "change_to": 14, "master_id": 35855, "global_id": 9472, "to_global_id": 9473}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 1248, "change_to": 15, "master_id": 35856, "global_id": 9473, "to_global_id": 9474}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 275, "change_to": 16, "master_id": 35857, "global_id": 9474}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――陛下、王国の者らが到着しました。", "face": "l02a0871d84cb"}, {"name": "華王、誅子", "text": "……来た、か。\n聞忠よ、この場は余のみで十分である。\n貴様は他の十天君を追うがよい。", "face": "lc7f1b4d09516"}, {"name": "聞忠", "text": "しかし、あちらには神仙郷の者がおります。\nもし戦闘となれば今の戦力では――", "face": "l02a0871d84cb"}, {"name": "華王、誅子", "text": "博打はもとより余の生き甲斐よ。\n今は何より、手数が惜しい。\n貴様の実力を遊ばせておくわけにはいかぬ。", "face": "lc7f1b4d09516"}, {"name": "聞忠", "text": "……はっ。御意に。\n――それにしても、随分と王らしくなられて。", "face": "l02a0871d84cb"}, {"name": "聞忠", "text": "美男美女に目のなかった遊び人のあなたが、\n今や華の国の王として、\n国家の復興のために戦おうとしているなんて。", "face": "l02a0871d84cb"}, {"name": "華王、誅子", "text": "ほざけ。\n貴様の顔を毎朝毎晩見ていれば、\n美男美女など興味もなくなるわ。", "face": "lc7f1b4d09516"}, {"name": "華王、誅子", "text": "さぁ行け。天の声は我らに味方した。\nこの好機を逃せば、華の国の未来は無いものと思え！", "face": "lc7f1b4d09516"}, {"name": "聞忠", "text": "はっ。それでは、我が王よ、ご武運を。", "face": "l02a0871d84cb"}]}, {"trigger": "start", "lines": [{"name": "太公望", "text": "――王子は、誅子とは面識が？", "face": "u603"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "魔物の復活以前には、\n頻度は多くありませんが、国交がありましたから。"}, {"name": "華王、誅子", "text": "――おぉ、久しいな王子よ！\nまだ戴冠しておらぬと聞いたが、随分と立派になった！", "face": "lc7f1b4d09516"}, {"name": "王子", "text": "――誅子も、随分と背丈が伸びたようだ。", "face": "u1"}, {"name": "華王、誅子", "text": "ははっ、もうかつての妹分ではないぞ。\n……あれから、背負うものも増えたからな。", "face": "lc7f1b4d09516"}, {"name": "華王、誅子", "text": "さて、世間話をするために\n国家会談を申し入れたわけではないのだ。\nさっそく本題へ進むとしよう。", "face": "lc7f1b4d09516"}, {"name": "華王、誅子", "text": "我が華の国は、いま十天君の討伐を進めておる。\n知ってのとおり、彼奴らは祖国の仇敵だからな。", "face": "lc7f1b4d09516"}, {"name": "アンナ", "text": "先程、フェイロンさんからお聞きしました。\n……中々に、強引な手段を用いているようですが。", "face": "l5c2dd51ae9b9"}, {"name": "華王、誅子", "text": "うむ、無礼を働いたならば謝ろう。\n此奴は忠義者にすぎるがゆえ、\n少々手段を選ばぬところがあってな。", "face": "lc7f1b4d09516"}, {"name": "フェイロン", "text": "…………。", "face": "u1720a1"}, {"name": "華王、誅子", "text": "して、ここまで話せば\n此度の会談における目的は分かるだろう？", "face": "lc7f1b4d09516"}, {"name": "華王、誅子", "text": "十天君、金光聖菩の身柄を、\nこちらへ渡してもらいたい。", "face": "lc7f1b4d09516"}, {"name": "金光聖菩", "text": "…………。", "face": "u630"}, {"name": "王子", "text": "――断る。", "face": "u1"}, {"name": "金光聖菩", "text": "なっ……王子よ、華の国と事を構えるつもりか！？\nあちらの要求は最初から分かっていただろう！", "face": "u630"}, {"name": "清源妙道真君", "text": "こちらとしては、あなたが自ら、\n華の国へ身売りしようと\n覚悟を決めていたことの方が驚きです。", "face": "u866"}, {"name": "金光聖菩", "text": "私ひとりならば、華の国を出し抜くことなど容易い。\n王子の面子を守るため、一度は頷いておいたほうが\nなにかと楽に話が進んだだろうに……。", "face": "u630"}, {"name": "清源妙道真君", "text": "王子に惚れ込んだあなたが妙なことを。\n王子が、一時的にとはいえ、\n仲間を売るような真似をするはずがないでしょう。", "face": "u866"}, {"name": "華王、誅子", "text": "やれやれ……決裂、か。\n見返りに、神との決戦には\n華の国の全軍を提供しようと思っていたのだが……。", "face": "lc7f1b4d09516"}, {"name": "太公望", "text": "仲間を売って得たような戦力など、\n王子は望みはしないでしょう。", "face": "u603"}, {"name": "華王、誅子", "text": "よかろう。\nならば実力にて、十天君がひとり、\n金光聖菩の首を貰い受けよう！", "face": "lc7f1b4d09516"}]}, {"trigger": "end", "lines": [{"name": "スーシェン", "text": "――戦況確認。\n敵戦力の空白が認められます。\n端的に言えば、逃げるなら今です。", "face": "u607"}, {"name": "アンナ", "text": "都の外まで至れば本隊と合流できます！\nこのまま城を抜け、街まで撤退を！", "face": "l5c2dd51ae9b9"}, {"name": "ケイティ", "text": "まさか、この状況で、\n華の国と戦端を開くことになるとは……。", "face": "u114"}, {"name": "太公望", "text": "これは、最初から見えていた未来ですから。\n邪仙に守られ、邪仙に翻弄されるのが、\n華の国という古き国である以上。", "face": "u603"}, {"name": "竜吉公主", "text": "この国にはね、遥かな過去からずっと、\n王家を守護し続けている邪仙がいるのよ。\nどうしようもないほど過保護な邪仙がね。", "face": "u663"}, {"name": "竜吉公主", "text": "問題は、十天君の襲来に際し、\nその邪仙――聞忠が誅子を匿ってしまったこと。\n敵を前に王が逃げた、この国の民はそう受け止めたの。", "face": "u663"}, {"name": "竜吉公主", "text": "誅子は紛れもない善王だったけれど、\nただ一度の過ちで、\n華の国は取り返しのつかない傷を負ったわ。", "face": "u663"}, {"name": "ナタク", "text": "大切な者を守ろうとする、\nその気持ちは分かるけど、ね。", "face": "u297"}, {"name": "清源妙道真君", "text": "……王子が金光聖菩を渡さないと決めたのも、\nまたひとつの過ちですからね。", "face": "u866"}, {"name": "金光聖菩", "text": "…………。", "face": "u630"}, {"name": "清源妙道真君", "text": "ははっ、あなたのそんな顔を見るのは初めてです。\nさぁ悪漢に追われる姫君よ、\nこの場は我らが守って差し上げましょう。", "face": "u866"}, {"name": "金光聖菩", "text": "……っ！　後で覚えておけ、妙道！", "face": "u630"}]}], "active": true}