{"quest_id": 7873, "name": "天の声", "description": "華の国に辿り着いた王子たちは金光聖菩の\n身柄を要求されるもそれを拒否する。\n襲い来る兵士たちを倒し退路を切り開け！\n上級（★１獲得の目安：平均Lv10）", "event": "華国演義・崑崙へ至る道", "event_category": "History", "mission_id": 920193, "map_no": 4694, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 35, "form_count": 1, "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "attack_range": 160, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142800, "race_id": 16, "change_to": 1, "change_condition": 1, "missile_id": 26, "master_id": 35837, "global_id": 9454, "ranged": true, "variants": [{"hp": 4000, "attack": 450, "base_hp": 4000, "base_attack": 450, "damage_type": "physical", "armor_defense": 250, "attack_speed": 70, "attack_wait": 60, "attack_interval": 231, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142816, "race_id": 16, "master_id": 35838, "global_id": 9455}], "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142784, "race_id": 16, "missile_id": 831, "missile": {"speed": 4.0, "splash": 133}, "master_id": 35836, "global_id": 9453, "ranged": true, "spawn_sec": 31}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["武狭"], "hp": 16000, "attack": 800, "base_hp": 16000, "base_attack": 800, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_speed": 10, "attack_wait": 20,