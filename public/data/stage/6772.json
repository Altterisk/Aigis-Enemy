"transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 32}, {"enemy_id": 8, "source": "local", "count": 12, "form_count": 2, "tags": ["ステルス"], "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103728, "race_id": 16, "special_effect_id": 61, "change_to": 8, "master_id": 472, "global_id": 471, "to_global_id": 472, "spawn_sec": 49}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109104, "race_id": 16, "special_effect_id": 61, "change_to": 7, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 473, "global_id": 472, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 9000, "attack": 320, "base_hp": 9000, "base_attack": 320, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115152, "race_id": 16, "special_effect_id": 54, "master_id": 31143, "global_id": 4762, "spawn_sec": 112}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 2, "tags": ["ステルス"], "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103744, "race_id": 16, "special_effect_id": 61, "change_to": 11, "master_id": 474, "global_id": 473, "to_global_id": 474, "spawn_sec": 138}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103712, "race_id": 16, "special_effect_id": 61, "change_to": 10, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 475, "global_id": 474, "ranged": true}], "popups": ["ファイブから受けたダメージは\n２倍になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ファイブ", "text": "――随分と手こずらせてくれたな。\nおとなしく捕まっていれば、\nこんな乱暴な手段を取るつもりはなかったのだが。", "face": "l466d8e3b2d92"}, {"name": "？？？", "text": "嘘ですっ！\n故郷の皆を連れ去ったのもあなたなのでしょう！？\n私達をどうするつもりなんですか……っ！！", "face": "u811"}, {"name": "ファイブ", "text": "何、優しいご主人様に飼われるだけさ。\n納品した後に何をされるのかは、\n私の知るところではないがね。", "face": "l466d8e3b2d92"}, {"name": "ファイブ", "text": "とはいえ、お前にもひとつの利用価値が出来た。\nどうやら王国の連中、お前を助ける気でいるらしい。\nわざわざ包囲網の中に飛び込んでくるのだからな。", "face": "l466d8e3b2d92"}, {"name": "？？？", "text": "…………えっ？", "face": "u811"}, {"name": "ソーマ", "text": "――そうです！　助けにきましたよ！\n王子、白い獣人さん、確認しました……！", "face": "u23"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "？？？", "text": "……えっ？　あ、あなた達は、さっきの……？", "face": "u811"}, {"name": "アイリーン", "text": "我々は王国の者です。\nあなたを助けるために、ここまで来ました。", "face": "u315"}, {"name": "？？？", "text": "……ほ、本当に？\nどうして人間が、私を……。", "face": "u811"}, {"name": "バシラ", "text": "困ったことに、困った人を見捨てられない人が、\n私達の王子ですからね！！\n待っててくださいね、すぐ助けちゃいますよ！", "face": "u28"}, {"name": "ファイブ", "text": "……クク、想定以上に馬鹿な奴らだ。\nだが、感謝を述べておこう。\n自ら狩られに来てくれたのだからな。", "face": "l466d8e3b2d92"}, {"name": "ファイブ", "text": "なれば万全を期すとしよう。\n私も出るぞ、陣を整えよ！", "face": "l466d8e3b2d92"}, {"name": "セブン", "text": "ファイブも出てくるのか……。\n王子、気をつけろよ。\nあいつは気配を断って攻撃してくるぞ。", "face": "u449"}, {"name": "アンナ", "text": "王子、この包囲網を突破しなければ、\n我々に勝利はありません。\n慎重な采配をお願いします！", "face": "l48eabfbe0a77"}]}, {"trigger": "end", "lines": [{"name": "ファイブ", "text": "（……ほう。\n想定が甘かったのはこちらの方か）", "face": "l466d8e3b2d92"}, {"name": "ファイブ", "text": "（――だが、そうだな、王国軍の情報を\n他の幹部にまで教えてやる必要もあるまい。\n精々私に影響の無い場所で潰しあえば良い……）", "face": "l466d8e3b2d92"}, {"name": "セブン", "text": "……ファイブの奴、\n部下を見捨てて逃げたみたいだな。", "face": "u449"}, {"name": "？？？", "text": "あ、あの、ありがとう、ございました……？\nで、良いのでしょうか……。\nほ、本当に私を、助けてくれたんですか……？", "face": "u811"}, {"name": "バシラ", "text": "当たり前じゃないですか！\nって、あぁー！　怪我してるじゃないですか！\n早く手当てしないと！！", "face": "u28"}, {"name": "ソーマ", "text": "はい、バシラさん。\n包帯と水、それに消毒薬に、\nそれから飴と焼き菓子もありますよ。", "face": "u23"}, {"name": "？？？", "text": "……あんな怖い人達の渦中に飛び込んで、\n本当に私を助けてくれる人がいるなんて。", "face": "u811"}, {"name": "フラフィー", "text": "あ、あの、私っ、フラフィーといいます。\nずっと、ずっとあいつらに追われててっ、\nそのっ、こ、怖くて……っ。", "face": "u811"}, {"name": "テティス", "text": "大丈夫ですよ、もうあなたを傷つける人はいません。\nその為にここに来たのですから。ね、バシラ？　", "face": "u37"}, {"name": "バシラ", "text": "そのとおりです！\n私達の王子は、こういう時に考えるより先に、\n行動に出てしまうお人好しですから。", "face": "u28"}, {"name": "フラフィー", "text": "……ありがとうございます。\n本当にっ、ほんとうにありがとうございます、王子さまっ！\nそしてみなさん……っ！！", "face": "u811"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アイリーン", "text": "さて、フラフィーさんの手当てをする必要もありますし、\n一旦王国へ帰還しましょうか。\n――闇の組織の動向も調べなくてはなりませんしね。", "face": "u315"}, {"name": "アンナ", "text": "そうですね……。\n今回の件が資金調達のためであれば、\n更なる暗躍が予想されますから……。", "face": "l48eabfbe0a77"}, {"name": "アンナ", "text": "ともかく王子、今回の遠征、お疲れ様でした！"}]}], "active": true}