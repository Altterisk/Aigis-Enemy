{"quest_id": 7258, "name": "玉座の決戦、狂えるアレクシア", "description": "彼女の信念に反し、狂気の魔法に染められて\r\nしまったアレクシア。悲痛な願いを王子に\r\n託さんとするアレクシアを救え！\n極級（★１獲得の目安：平均Lv25）", "event": "背教の剣と信仰の騎士団", "event_category": "History", "mission_id": 920157, "map_no": 5890, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 3500, "attack": 240, "base_hp": 3500, "base_attack": 240, "damage_type": "magical", "armor_defense": 1500, "attack_range": 180, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127424, "special_effect_id": 510, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 33527, "global_id": 7144, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 10, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 1, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 60, "attack_range": 100, "attack_speed": 80, "attack_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097760, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 33, "global_id": 32, "ranged": true, "spawn_sec": 8}, {"enemy_id": 4, "source": "local", "count": 16, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4200, "attack": 380, "base_hp": 4200, "base_attack": 380, "damage_type": "magical", "armor_defense": 1500, "attack_range": 140, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127440, "special_effect_id": 510, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33528, "global_id": 7145, "ranged": true, "spawn_sec": 34}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 40}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 2, "tags": ["アーマー", "神聖騎士団"], "hp": 9000, "attack": 1700, "base_hp": 9000, "base_attack": 1700, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 100, "attack_interval": 252, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124336, "special_effect_id": 510, "change_to": 6, "change_condition": 2, "master_id": 32735, "global_id": 6353, "to_condition": 2, "to_global_id": 6354, "spawn_sec": 67}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団", "アンデッド"], "hp": 100000, "attack": 1000, "base_hp": 100000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 10000, "magic_defense": 90, "attack_speed": 1, "attack_wait": 120, "attack_interval": 292, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124352, "special_effect_id": 562, "master_id": 32736, "global_id": 6354, "from_condition": 2}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "tags": ["忍者"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_interval": 76, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099968, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 208, "global_id": 207, "ranged": true, "spawn_sec": 86}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 800, "attack": 400, "base_hp": 800, "base_attack": 400, "damage_type": "magical", "attack_range": 60, "attack_speed": 1, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102480, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 334, "global_id": 333, "ranged": true, "spawn_sec": 113}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 12800, "attack": 820, "base_hp": 12800, "base_attack": 820, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 40, "attack_speed": 1, "attack_wait": 10, "attack_interval": 54, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2127616, "race_id": 16, "special_effect_id": 762, "master_id": 33539, "global_id": 7156, "spawn_sec": 200}], "popups": ["暴走したアレクシアは、\n戦場にいる神聖騎士の総数に応じて\n攻撃力と防御力がアップします。\n\nまた体力が\n徐々に減少していきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アリア", "text": "――王子、玉座の間に突入します！", "face": "u75"}, {"name": "コンラッド", "text": "おらァ！　どきやがれ！\nここは俺たちがカシラだって決めた男の居城だぞ！", "face": "u61"}, {"name": "フィグネリア", "text": "……あ、あれ？\nあの子、何か様子が変じゃない？", "face": "u18"}, {"name": "アレクシア", "text": "我らに、祈りを……我らが主に……栄光を……。", "face": "u1168a1"}, {"name": "アレクシア", "text": "あっ……あぁぁあああッ！！", "face": "u1168a1"}, {"name": "フローガ", "text": "こ、これ、まずいです！\nあの子の内側の魔力が暴走しています！！", "face": "u878"}, {"name": "アトナテス", "text": "ちっ……味方まで使い潰す気かよ、連中は！", "face": "u908"}, {"name": "アンブローズ", "text": "あんな魔力を注がれて、暴走させ続けたら……。\nどんどん生命力が削られちゃいますよぉ！？", "face": "u1088a1"}, {"name": "トゥアン", "text": "……あれだけの魔力を放出しているんだ。\nこのまま放置すれば、命に関わるぞ。", "face": "u1006a1"}, {"name": "フィナン", "text": "人の命だって、信仰のために捧げる。\nそれが今の教団のあり方……。", "face": "u1003a1"}, {"name": "コルム", "text": "自分の身体も、他人の身体も、\n心も、魂も、何もかも主のために捧げるつもりで……。", "face": "u1032a1"}, {"name": "コルム", "text": "信仰のあり方は自分が決めるもの。\nだけど……だから、誰かに押し付けられたものは、\n絶対に信仰心なんかじゃないはずです！！", "face": "u1032a1"}, {"name": "アレクシア", "text": "コ……ルム……。\nああ……お願い……私を……殺し――", "face": "u1168a1"}, {"name": "コルム", "text": "断固拒否します！\nアレクシア、信仰に疑いを持った私が、\n今の私が信じるものは――", "face": "u1032a1"}, {"name": "コルム", "text": "――手の届く限り、全てを諦めない。\n助けを求める者全てに手を差し伸べる。\n何の迷いもなく、そう言える人なのですから。", "face": "u1032a1"}, {"name": "コルム", "text": "王子殿下、どうか力を貸してください。\n心を支配された兵の皆さんも、\nアレクシアも、全員を取り戻すために！", "face": "u1032a1"}]}, {"trigger": "end", "lines": [{"name": "ドゥマルデ", "text": "――どうやら、間に合ったようですね。", "face": "u1266a1"}, {"name": "ケイティ", "text": "あなたは、神聖騎士団の……っ！！", "face": "u114"}, {"name": "スルーズ", "text": "ま、待ってください！\nこの方は、他の神聖騎士団員とは違う、と思うので……。", "face": "u1143a1"}, {"name": "ドゥマルデ", "text": "おや、先日のお嬢さんですか。\n元気な姿を見られて一安心といったところですね。", "face": "u1266a1"}, {"name": "ケイティ", "text": "……我々に、何か言いたいことでも？", "face": "u114"}, {"name": "ドゥマルデ", "text": "ええ、偉大なる我らが主に代わり、\n騎士アレクシアに、\n異端信仰による破門宣告をしに来たのですよ。", "face": "u1266a1"}, {"name": "アレクシア", "text": "……ドゥマルデ審問官、どういう、ことですか？", "face": "u1168a1"}, {"name": "ドゥマルデ", "text": "主の力を受けた上で戦うことを拒否し、\n己が使命を果たさぬその怠慢こそ、\n貴女が邪教の徒に堕ちた揺るがぬ証。", "face": "u1266a1"}, {"name": "ドゥマルデ", "text": "よって貴女には、\n破門の上、騎士団からの追放を言い渡します。\n――邪教の王国にでも逃げ込めば良いでしょう。", "face": "u1266a1"}, {"name": "アレクシア", "text": "……でも、それでは皆が。\n神聖騎士団の皆が目を覚まさないままです……。", "face": "u1168a1"}, {"name": "アレクシア", "text": "何もかもがおかしいのです、今の騎士団は。\nでも皆それを正しいと信じてしまっている。\nその目を覚まさせるのは、友としての、私の――", "face": "u1168a1"}, {"name": "ドゥマルデ", "text": "――異教の信徒たる、王国の王子よ。\nどうか、この哀れな娘に、慈悲の心を。", "face": "u1266a1"}, {"name": "ドゥマルデ", "text": "アレクシア、貴女の志は私が引き継ぎましょう。\n私ももう少しだけ、\n彼らを救うために抗ってみるつもりですから。", "face": "u1266a1"}, {"name": "アレクシア", "text": "……私は、私はどうすれば。\n信仰を、信じてきたものを捨てて、\nどう生きていけば良いというのですか……。", "face": "u1168a1"}, {"name": "コルム", "text": "アレクシア、それはあなたが一番よく知っているのでは？\n盲目的に神を信じることが救いになるのか、\nそれを自問し、決めるのは自分なのでしょう。", "face": "u1032a1"}, {"name": "フィナン", "text": "一緒に来ませんか、アレクシアさん。\n生きる理由を、戦う理由を、自分で探すために。", "face": "u1003a1"}, {"name": "アレクシア", "text": "……私は、異教徒ですよ？\nそれでも、本当に良いのですか……？", "face": "u1168a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}