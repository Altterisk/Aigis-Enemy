_effect_id": 222, "master_id": 130, "global_id": 129}], "spawn_sec": 108}, {"enemy_id": 9, "source": "local", "count": 2, "level": 90, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 111}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 75, "global_id": 74, "spawn_sec": 128}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 380, "base_hp": 4000, "base_attack": 380, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "master_id": 10021, "global_id": 1020, "spawn_sec": 130}, {"enemy_id": 12, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 133}, {"enemy_id": 13, "source": "local", "count": 6, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 135}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 142}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 154}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "真竜の卵が保管されているという\n洞窟はここですね。", "face": "l3edfd793cd9c"}, {"name": "アンナ", "text": "ここの魔物を一掃できれば、\n真竜の卵を奪還できるはずです。\n一気に攻め込みたい所ですが……。", "face": "l3edfd793cd9c"}, {"name": "アンナ", "text": "爆弾を持った魔物たちが\n卵の周りに陣取っているため、\n近づけそうにないですね。", "face": "l3edfd793cd9c"}, {"name": "アンナ", "text": "王子、爆弾による集中攻撃を受けると危険です。\nまずは魔物の動きを探り、攻勢に移りましょう。", "face": "l3edfd793cd9c"}]}, {"trigger": "battle", "at_sec": 110, "lines": [{"name": "ルシル", "text": "（この混乱に乗じて卵を……。）", "face": "u222"}, {"name": "魔物", "text": "ゲギャァア、オイ！\nオマエ！　怪シイ動キヲスルナ！", "face": "l9c713318c209"}, {"name": "魔物", "text": "サッサト王子ヲ倒セ！\n裏切ッテモ卵ヲコワス！\n少シデモ手ヲ抜イタラコワス！", "face": "l9c713318c209"}, {"name": "ルシル", "text": "（ここで見破られる訳には……。\n王子を信じて、全力でぶつかるしかない！）", "face": "u222"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "王子、魔物の撤退を確認。\nこの洞窟内の魔物は一掃されました。", "face": "l3edfd793cd9c"}, {"name": "魔物", "text": "オマエタチ！　コノ卵ヲ取リ返シニ\n来タンダロッ！", "face": "l9c713318c209"}, {"name": "アンナ", "text": "まだ魔物がいたというのですか……！", "face": "l3edfd793cd9c"}, {"name": "魔物", "text": "コウナッタラ仕方ガナイ！\nモッタイナイガ、卵ヲ割ッテヤル！", "face": "l9c713318c209"}, {"name": "？？？", "text": "待て！", "face": "u222"}, {"name": "魔物", "text": "オマエハ……！", "face": "l9c713318c209"}, {"name": "ルシル", "text": "この瞬間を待っていた。\n真竜の卵は絶対に取り返す。", "face": "u222"}, {"name": "ルシル", "text": "くらえッ！", "face": "u222"}, {"name": "魔物", "text": "グギャアアアア……！", "face": "l9c713318c209"}, {"name": "ルシル", "text": "卵は……！　よかった……。\n無事だな。", "face": "u222"}, {"name": "アンナ", "text": "ルシルさん！　やりましたね！\nしかし、なぜ魔物は真竜の卵を？\n壊そうと思えばいつでも壊せたはずでは……。", "face": "l3edfd793cd9c"}, {"name": "ルシル", "text": "真竜は力と知力を併せ持った\n強大な存在へと成長する。", "face": "u222"}, {"name": "ルシル", "text": "恐らく魔物は真竜の卵を魔界へ送り、\n悪に染まった真竜を作ることが\n目的だったのではないかと……。", "face": "u222"}, {"name": "アンナ", "text": "なるほど……。\nともあれ、未然に防げてよかったですね。", "face": "l3edfd793cd9c"}, {"name": "ルシル", "text": "あぁ……。おかげで卵の母親との誓いも\n守ることができた。\n本当にありがとう……。", "face": "u222"}, {"name": "ルシル", "text": "そういえば、卵を盗んだ真犯人の情報を\n魔物から聞き出すことができたんだ。\n私は、真犯人を追うことにする。", "face": "u222"}, {"name": "ルシル", "text": "今回は戦うことになってしまったが、\n今度は王子の元で戦わせてくれ。\nいつか……声をかけてほしい。", "face": "u222"}, {"name": "ルシル", "text": "次に会うその時まで、\n楽しみにしている。", "face": "u222"}]}], "active": true}