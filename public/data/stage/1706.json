e_attack": 2800, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 251, "move_speed": 4000.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2107424, "race_id": 6, "master_id": 574, "global_id": 573, "to_global_id": 570, "route_behaviour": {"transforms": [{"wait": 610}]}, "spawn_sec": 232}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 2800, "base_hp": 30000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 251, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107408, "race_id": 6, "master_id": 571, "global_id": 570}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 700, "base_hp": 25000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 25, "attack_range": 400, "attack_speed": 70, "attack_wait": 35, "attack_interval": 130, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105472, "race_id": 6, "special_effect_id": 73, "missile_id": 151, "missile": {"speed": 3.0}, "master_id": 652, "global_id": 651, "ranged": true, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 243}], "dialogue": [{"trigger": "start", "lines": [{"name": "天使", "text": "――ケラウノス様、準備は整いました。\nもう間もなく、人間達はここを通る筈です。", "face": "l6cf48072511f"}, {"name": "ケラウノス", "text": "準備は万全のようですね。人間に与する愚かなアイギスに、\nその行為がどれほど愚かな行いか、加護を受けし者達の\n死を以て知らしめなさい。", "face": "l82fd534d8438"}, {"name": "天使", "text": "しかし本当に宜しかったのですか。\nアイギス様はケラウノス様の妹神では。\nそれに、アダマス様の肉体にあのような……。", "face": "l6cf48072511f"}, {"name": "ケラウノス", "text": "私の命に逆らおうと言うのですか？", "face": "l82fd534d8438"}, {"name": "天使", "text": "……身の程を弁えぬ発言、\n失礼しました。\n全ては主の仰せのままに。", "face": "l6cf48072511f"}, {"name": "ケラウノス", "text": "しかし、こんな所にまで人間を招いてしまうとは。\nガリウスは全く使えませんね。これでは\n魔王の座に据えてやった意味がありません。", "face": "l82fd534d8438"}, {"name": "ケラウノス", "text": "私が直接力を行使できれば、あのような者\n使わずとも良かったのですが。この瘴気の中では\n精神体で会話をするのが精々、ままなりませんね。", "face": "l82fd534d8438"}, {"name": "天使", "text": "ケラウノス様、どうやら人間達が来たようです。\n精神体とはいえ、魔界に長居されていては\n御身体に障りかねません。ここはお任せ下さい。", "face": "l6cf48072511f"}, {"name": "ケラウノス", "text": "私の力を分け与えた新鋭天使の力を使えば、\n人間など造作もない筈です。\n良い報せを期待していますよ。", "face": "l82fd534d8438"}, {"name": "天使", "text": "主の御心のままに。", "face": "l6cf48072511f"}, {"name": "リエーレ", "text": "――レヴィアタンの体内に続く入り口は\nこの先の筈…………っ！？　\nな、なんだいアイツ等は！！", "face": "u490"}, {"name": "ケイティ", "text": "あれは……まさかこのような所にまで\n天使達の手が迫っているとは……。", "face": "u114"}, {"name": "アンナ", "text": "王子、至急戦闘の準備をお願いします！！", "face": "l712fde1e615d"}]}, {"trigger": "end", "lines": [{"name": "天使", "text": "人間達がまさかこれ程力をつけているとは。\n天界に戻り、主にご報告しなければ……。", "face": "l6cf48072511f"}, {"name": "ケイティ", "text": "――天使達は退けたようです。", "face": "u114"}, {"name": "リエーレ", "text": "い、一体何だってんだ。", "face": "u490"}, {"name": "ケイティ", "text": "あれは天使です……人々を滅ぼさんとする\n……神の御使いです。", "face": "u114"}, {"name": "リエーレ", "text": "……よく判んないけど、\nアタシが魔界にいる間に、\n物質界でも色々あったんだね。", "face": "u490"}, {"name": "アンナ", "text": "そういえば、リエーレさんは何故魔界に？"}, {"name": "リエーレ", "text": "アタシは元々傭兵稼業の根無し草さ。\n色々な所を渡り歩いてる内に、\n気付けば魔界に迷い込んじまってね。", "face": "u490"}, {"name": "リエーレ", "text": "行く当てもなかった所をヘンゼルに助けられ、\n奴隷地区で身を隠し生活してたってわけ。", "face": "u490"}, {"name": "アンナ", "text": "ヘンゼルさん……デーモンメイジの下で\n密偵をしているとの事ですが。\n危険ではないのでしょうか。", "face": "lc360781a29d4"}, {"name": "リエーレ", "text": "そりゃ危険だろうよ。ひどい傷を負って\n戻ってきた事もある。それでもアイツは、\nこのチャンスの為に密偵を続けてきたんだ。", "face": "u490"}, {"name": "リエーレ", "text": "……アイツを解放してやるためにも、\nどうかレヴィアタンの心臓を破壊して、\nデーモン共の目論見をぶっ潰してやってくれ。", "face": "u490"}, {"name": "アンナ", "text": "……はい。その役目、\n私達が果たしてみせます。", "face": "lc360781a29d4"}, {"name": "アンナ", "text": "王子、負けられない理由が増えましたね。\nレヴィアタンを倒し、\n必ずやデーモン達の野望を阻止しましょう！", "face": "l712fde1e615d"}]}], "hard": {"level": 1