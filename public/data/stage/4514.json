enemy_id": 4, "source": "local", "count": 14, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098160, "master_id": 92, "global_id": 91, "spawn_sec": 28}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098432, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 87, "global_id": 86, "ranged": true, "spawn_sec": 36}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 150, "attack_speed": 70, "attack_wait": 80, "attack_interval": 206, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104064, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 496, "global_id": 495, "ranged": true, "spawn_sec": 50}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 2800, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 52}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "スクハさんが宝剣を所持している限り、\n剣同士の因果によって互いを引き合い、\n必ず出会うことになる、ということでしたよね？", "face": "l077ae4c90c18"}, {"name": "スクハ", "text": "はい。ですので、我が祖国へと向かうことで、\n妖虎仙と出会うのは必定。\nこのまま歩みを進める事が一番の近道です。", "face": "u341"}, {"name": "エレイン", "text": "まるで磁石よね。\nどうしてそんな不思議な力が宿っているの？", "face": "u36"}, {"name": "スクハ", "text": "詳しい事は私も存じ上げないのですが、\nその昔、当時の我が国の大帝が、名工の夫婦に\n命じて作らせたものと聞いた事があります。", "face": "u341"}, {"name": "スクハ", "text": "しかし、大帝の望む宝剣を造るのは\nとても難しく、その宝剣の完成と引き換えに、\n夫婦ともにその命が尽きてしまったと……。", "face": "u341"}, {"name": "兵士", "text": "伝令！\n斥候部隊が敵影を確認。\n恐らく妖虎仙の追っ手かと思われます。", "face": "l199377a44b3f"}, {"name": "アンナ", "text": "妖虎仙は確実に私達に\n近づいているようですね。\n王子、お気を付けください！", "face": "l077ae4c90c18"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "敵、すべて撃破しました。\nお疲れ様です、王子。"}, {"name": "エレイン", "text": "はひぃー。もうヘトヘトだよ……。\n喉もからからだし！\n砂漠なんて大っ嫌い。", "face": "u36"}, {"name": "アサル", "text": "……。\n（エレインさん、\n馬に乗っているのに……）", "face": "u172"}, {"name": "スクハ", "text": "もうすぐ、この砂漠地帯を抜ける事が出来ます。\nそれまで、もう少々のご辛抱をお願いします。", "face": "u341"}, {"name": "エレイン", "text": "えっ！　本当？！\n良かったぁ～。", "face": "u36"}, {"name": "スクハ", "text": "はいっ。\nもうすぐ山岳地帯が見えてくるはずです。", "face": "u341"}, {"name": "エレイン", "text": "さ、山岳地帯……。\nまだまだ先は長そうね……。", "face": "u36"}]}], "active": true}