{"quest_id": 7518, "name": "特大温泉卵とデモシェフ商会", "description": "デーモンシェフと社員が一丸となり王子の\n前に立ち塞がる中、ついにドラコシーサウ\nルスの卵に孵化の瞬間が訪れる……！！\n神級（★１獲得の目安：平均Lv50）", "event": "温泉街決戦～悪魔の卵と命のお湯～", "event_category": "History", "mission_id": 920171, "map_no": 4062, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 3, "tags": ["水棲"], "hp": 9000, "base_hp": 9000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 60, "attack_interval": 194, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2132320, "race_id": 2, "special_effect_id": 916, "change_to": 1, "change_condition": 2, "master_id": 34456, "global_id": 8073, "to_condition": 2, "to_global_id": 8074, "commands": {"raw": "DoEnemy_RegistCommand(\"OnCommand\", \"DoEnemy_StayRoute(\"StayTime=18000\");\"); DoEnemy_RegistCommand(\"OnModeChanged\", \"SetStageFlag(0, 1);\nSetStageFlag(1, 1);DoEnemy_RemoveCommand( \"OnCommand\" );\");", "sets_flags": [[0, 1], [1, 1]], "on_mode_changed": true}, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["水棲", "狙う", "ブロック不可", "水面"], "hp": 230000, "attack": 1000, "base_hp": 230000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 800, "magic_defense": 10, "attack_range": 330, "attack_speed": 1, "attack_wait": 45, "attack_interval": 135, "move_speed": 1300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2132336, "race_id": 2, "special_effect_id": 623, "change_to": 2, "missile_id": 227, "missile": {"speed": 4.0}, "master_id": 34457, "global_id": 8074, "ranged": true, "from_condition": 2, "to_global_id": 8075}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["水棲"], "hp": 230000, "attack": 3200, "base_hp": 230