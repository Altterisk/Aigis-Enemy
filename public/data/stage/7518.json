gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2132304, "race_id": 3, "special_effect_id": 918, "change_to": 12, "change_condition": 4, "missile_id": 628, "missile": {"speed": 15.0, "heal": true}, "master_id": 34455, "global_id": 8072, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 15, "source": "local", "count": 10, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 77}, {"enemy_id": 16, "source": "local", "count": 20, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 83}, {"enemy_id": 17, "source": "local", "count": 9, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 17, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 95}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}], "dialogue": [{"trigger": "start", "lines": [{"name": "カノン", "text": "でっかいのがこっちに向かってくるわよ！？", "face": "u1417a1"}, {"name": "フィーヌ", "text": "みなさん注意してください！\nドラコシーサウルスは水中を移動できます！\n奇襲に遭わないよう立ち位置には気をつけて！", "face": "u1415a1"}]}, {"trigger": "start", "lines": [{"name": "フィーヌ", "text": "デーモンシェフさん！\nあなたは本当に裏切ったのですか！\n裏では私たちを笑っていたのですか！", "face": "u1415a1"}, {"name": "フィーヌ", "text": "いつか焼いてくれたおいしいステーキも！\nあれも全部……偽物だったと言うのですか！", "face": "u1415a1"}, {"name": "デーモンシェフ", "text": "ははは、あれは純王国産高級牛肉を使った、\n正真正銘本物のステーキだともフィーヌ嬢！", "face": "l1c8712e99c4e"}, {"name": "デーモンシェフ", "text": "そして、ここにいる我らも本物だ。\n悪いが私にも譲れないものがあってね。\nそれが今は亡き我が友との最後の約束だ。", "face": "l1c8712e99c4e"}, {"name": "フィーヌ", "text": "──っ、どういうことですか。", "face": "u1415a1"}, {"name": "デーモンシェフ", "text": "我らは、この卵を母親から託された。\n今際の際に、どうか我が子を救ってくれと。", "face": "l1c8712e99c4e"}, {"name": "デーモンシェフ", "text": "ゆえに我らには契約を遂行する義務がある。\nたとえそれが、正しくない行いだったとしても。\n友の忘れ形見を見捨てるわけにはいかんのだ。", "face": "l1c8712e99c4e"}, {"name": "フィーヌ", "text": "……詳しい事情は知りません。ですが、\n死にゆく命を見過ごせないという気持ちは、\n海に生きる者として、私にも理解できます。", "face": "u1415a1"}, {"name": "フィーヌ", "text": "その上で、人々を守るのが私の使命。\n全力で、あなたを止めさせてもらいます！", "face": "u1415a1"}]}, {"trigger": "end", "lines": [{"name": "フィーヌ", "text": "──制圧完了です、デーモンシェフさん。\nこれでようやく、事情を話してくれますね？", "face": "u1415a1"}, {"name": "デーモンシェフ", "text": "……デモシェフ商会が海に進出するに当たり、\n我らの商船の護衛を担ってくれていた友人がいた。\nそれが、このドラコシーサウルスたちの母親だ。", "face": "l1c8712e99c4e"}, {"name": "デーモンシェフ", "text": "本来は凶暴な魔物だが彼女は温厚な性格でな、\n人間とも上手に折り合いつけて共存していたらしい。\nそんな彼女が、先日浜辺で倒れているのが見つかった。", "face": "l1c8712e99c4e"}, {"name": "フィーヌ", "text": "──っ。", "face": "u1415a1"}, {"name": "デーモンシェフ", "text": "気づいたときには、もう手遅れだった。\n瀕死の状態でありながら大事に卵を抱えて、\n駆けつけた我らに彼女は目で訴えたのだ。", "face": "l1c8712e99c4e"}, {"name": "エマ", "text": "それが、我が子を救ってほしい……と？", "face": "u1137a1"}, {"name": "デーモンシェフ", "text": "ああ、彼女には大きな借りがあったからな。\nしかし、卵の孵化には繊細な温度管理が必要なのだが、\n機材を用意するまでに卵が死んでしまうことが判明した。", "face": "l1c8712e99c4e"}, {"name": "フィーヌ", "text": "それで、温泉を貸し切ったんですね。\nドラコシーサウルスの体温に、\nもっとも近い環境を用意するために。", "face": "u1415a1"}, {"name": "デーモンシェフ", "text": "……結果はこの有様だがな。\nこの償いには、商会総出で取り組ませてもらいたい。\nお前たちを含め、あまりに多くの人間に迷惑を掛けた。", "face": "l1c8712e99c4e"}, {"name": "エマ", "text": "その件については宿の者らと話すべきでしょう。\n我らとしては、王子に罰する気がなければなんとも。", "face": "u1137a1"}, {"name": "デーモンシェフ", "text": "恩に着るぞ、王子よ。そして子どもたちの\n命を奪わずにいてくれたこと、深く感謝する。", "face": "l1c8712e99c4e"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "ソーマ", "text": "えっと……一件落着、ですかね？", "face": "u1138a1"}, {"name": "フィーヌ", "text": "これで、これでようやく温泉に……きゅう。", "face": "u1415a1"}, {"name": "シュシュ", "text": "フィーヌさんが倒れちゃいましたー！？", "face": "u979"}, {"name": "フィーヌ", "text": "お腹が……お腹が空きました……。", "face": "u1415a1"}, {"name": "レアン", "text": "誰かー！　温泉まんじゅうを持って来てくれー！", "face": "u978"}, {"name": "カノン", "text": "……締まらないわねぇ。", "face": "u1417a1"}]}], "active": true}