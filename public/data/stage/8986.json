0, "transform_resist": 100, "pattern_id": 2106544, "race_id": 7, "change_to": 33, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 40785, "ranged": true, "to_condition": 4, "to_ticks": 1, "spawn_sec": 175}, {"enemy_id": 33, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 40786, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 34, "source": "local", "count": 9, "form_count": 1, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 40786, "spawn_sec": 181}], "popups": ["ルクシエがいる間は、\n全ての敵のHPが\n徐々に回復します。\n\nまたルクシエがいる間は、\n一定時間が経過するたびに\n魚人系の敵ユニットの\n攻撃と防御がアップします。", "ルクシエ、セイレーンは\n撃破数に含まれません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ラタトスク", "text": "たのもー！"}, {"name": "ルクシエ", "text": "ひょええええ！？　なななな、なんですかぁ！？", "face": "u2723a1"}, {"name": "アージェ", "text": "セイレーンのルクシエさんで間違いありませんね？\n王国プロダクションのアージェ★アルタと申します。"}, {"name": "ルクシエ", "text": "そ、そうですけど……。", "face": "u2723a1"}, {"name": "アルタ", "text": "オロバスカップ優勝候補者番付に名を連ねる、\n物質界の若者を中心に人気沸騰中の覆面バンド、\nシーレーン防衛隊のボーカルでもありますね？"}, {"name": "ルクシエ", "text": "ひぃいいいい！？　な、なんで知って……！？", "face": "u2723a1"}, {"name": "ポミエ", "text": "あ、あれルクシエさんだったんだ。", "face": "u2828a1"}, {"name": "ラタトスク", "text": "覆面バンドがアイドルってどういう意味じゃ？"}, {"name": "ルクシエ", "text": "私も別に自分でエントリーしたわけじゃ……。", "face": "u2723a1"}, {"name": "アンナ", "text": "それだけ歌と演奏が飛び抜けている、ということですね。"}, {"name": "ルクシエ", "text": "えっと、話がよく見えないのですが……。", "face": "u2723a1"}, {"name": "ユキヒメ", "text": "私たち王国プロダクションは……\nルクシエさんに野良オーディションを申し込むよ？"}, {"name": "ルクシエ", "text": "知らない単語を疑問形で言われても。", "face": "u2723a1"}, {"name": "？？？", "text": "──合意と見てよろしいですね？", "face": "l8cea18673728"}, {"name": "ルクシエ", "text": "今の会話に合意要素ありました！？　というか誰ぇ！？", "face": "u2723a1"}, {"name": "ボーカル審査員", "text": "失礼、通りすがりのボーカル審査員です。", "face": "l8cea18673728"}, {"name": "ホルミース", "text": "オロバスの部下ですよね？", "face": "u2292a1"}, {"name": "ボーカル審査員", "text": "野良オーディションの開催を承認されました。\nより多くの観衆を沸かせた方が勝利となります。", "face": "l8cea18673728"}, {"name": "ホルミース", "text": "無視！？", "face": "u2292a1"}, {"name": "ボーカル審査員", "text": "それではこれより、\n王国プロダクションとシーレーン防衛隊による、\n野良オーディションを開始します。", "face": "l8cea18673728"}, {"name": "ボーカル審査員", "text": "ミュージック、スタート！", "face": "l8cea18673728"}, {"name": "ルクシエ", "text": "なんでぇえええ！？", "face": "u2723a1"}]}, {"trigger": "end", "lines": [{"name": "ボーカル審査員", "text": "勝者、王国プロダクション！", "face": "l8cea18673728"}, {"name": "少女", "text": "キャー！　ユキヒメちゃーん！", "face": "l0a5b13274af9"}, {"name": "ユキヒメ", "text": "……勝った、の？"}, {"name": "ラタトスク", "text": "ルクシエ以外の演奏がガッタガタじゃったからのぅ。"}, {"name": "ルクシエ", "text": "だから覆面バンドに素面は無理ですって！！", "face": "u2723a1"}, {"name": "ラタトスク", "text": "そもそもなんで覆面バンドだったのじゃ？\nうぬは普段、顔出しで活動しておるじゃろ。"}, {"name": "ルクシエ", "text": "メンバーにシャイな子が多いのもありますが、\nセイレーンは色眼鏡で見られることも多いので……。", "face": "u2723a1"}, {"name": "ラタトスク", "text": "ああ、うぬらも苦労しておるのじゃなぁ……。"}, {"name": "ルクシエ", "text": "それでぇ……今のは何だったんですか？", "face": "u2723a1"}, {"name": "ユキヒメ", "text": "あの……歌のコツを、教えてほしくて。\nルクシエさん、すっごく上手だったから。"}, {"name": "ルクシエ", "text": "歌のコツ、ですか？", "face": "u2723a1"}, {"name": "ラタトスク", "text": "吾輩たちはオロバスカップで優勝せねばならんでな。\nそのために各地を巡って武者修行をしておるのじゃ。"}, {"name": "ルクシエ", "text": "はあ、そういうことだったんですね。\n技術的な助言は時間が足りませんし──", "face": "u2723a1"}, {"name": "ルクシエ", "text": "月並みですが、歌を楽しむことでしょうか？", "face": "u2723a1"}, {"name": "ユキヒメ", "text": "楽しむ？"}, {"name": "ルクシエ", "text": "ユキヒメさん、人前で歌うのは恥ずかしいですか？", "face": "u2723a1"}, {"name": "ユキヒメ", "text": "あう……少しだけ……。"}, {"name": "ルクシエ", "text": "音程を外したら、歌詞を間違えたら、声が裏返ったら。\nそう思うと身体が竦んで、練習の半分も力が出せない？", "face": "u2723a1"}, {"name": "ユキヒメ", "text": "……うん。"}, {"name": "ルクシエ", "text": "大丈夫ですよ、それはおかしなことではありません。\n注目を浴びる中で失敗するのはとても恐ろしいこと──", "face": "u2723a1"}, {"name": "ルクシエ", "text": "だからこそ、開き直るのが大事なんです。", "face": "u2723a1"}, {"name": "ルクシエ", "text": "そもそも自己表現なんてもの、\n大抵全部恥ずかしいんですから。", "face": "u2723a1"}, {"name": "ユキヒメ", "text": "──え。"}, {"name": "ルクシエ", "text": "だって、そうじゃないですか？\n自分の感情をアートとして表に出すなんて、\nとても傲慢で痛々しいに決まっています。", "face": "u2723a1"}, {"name": "ルクシエ", "text": "だったらどうしてそんなことをするのかって、\nやっぱりそれがすっごく楽しいからなんですよ。", "face": "u2723a1"}, {"name": "ルクシエ", "text": "人前で失敗したから何だって言うんです？\nステージに立った時点で恥ずかしいんですから、\nそれなら楽しんだ方がいいに決まっています。", "face": "u2723a1"}, {"name": "ユキヒメ", "text": "そ、そうかも……？"}, {"name": "ルクシエ", "text": "まあ、そう簡単に言うなよって話ですよね。\nそれでも、これだけは覚えて帰ってください。", "face": "u2723a1"}, {"name": "ルクシエ", "text": "伝えたいことがあるなら全力で。\nそれで失敗したって普通のことです。\nなにせ全力でやったんですからね。", "face": "u2723a1"}, {"name": "ユキヒメ", "text": "……うん。"}, {"name": "ルクシエ", "text": "恥ずかしげもなく観客に己をさらけ出し、\n声の限界まで歌い切った先に待つ景色は──", "face": "u2723a1"}, {"name": "ルクシエ", "text": "心臓が痛いぐらい、気持ちいいですよ。", "face": "u2723a1"}]}, {"trigger": "route", "lines": [{"name": "ユキヒメ", "text": "あっ、金色のセイレーンさんが倒れた。"}, {"name": "ルクシエ", "text": "これは……極度の緊張からの酸欠による気絶！\n覆面バンドが素面で演奏なんて無茶だったんです！", "face": "u2723a1"}, {"name": "ルクシエ", "text": "ちょっと控室の方に運んできますねー。", "face": "u2723a1"}]}], "active": true}