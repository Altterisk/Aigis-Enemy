{"quest_id": 6446, "name": "湖上に揺らぐ焔砂", "description": "二鬼を前に攻めあぐね、苛立ちを隠せぬ\n狛天君。諌める尊天君の制止も聞かず、\n強行策へと打って出るが……。\n極級（★１獲得の目安：平均Lv25）", "event": "龍穴の風水士", "event_category": "History", "mission_id": 920108, "map_no": 5333, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 1500, "base_hp": 20000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 250, "magic_defense": 30, "attack_range": 80, "attack_speed": 80, "attack_wait": 90, "attack_interval": 246, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112800, "missile_id": 235, "missile": {"speed": 4.0, "splash": 267}, "master_id": 30703, "global_id": 4322, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "hp": 30000, "base_hp": 30000, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 80, "attack_speed": 10, "attack_wait": 10, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113712, "special_effect_id": 260, "change_to": 2, "change_condition": 3, "master_id": 31012, "global_id": 4631, "to_condition": 3, "to_global_id": 4632, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "base_hp": 30000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113872, "special_effect_id": 261, "master_id": 31013, "global_id": 4632, "from_condition": 3}, {"enemy_id": 4, "source": "local", "count": 19, "form_count": 1, "hp": 2500, "attack": 350, "base_hp": 2500, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112624, "master_id": 30704, "global_id": 4323, "spawn_sec": 24}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105120, "race_id": 14, "change_to": 5, "change_condition": 5, "master_id": 602, "global_id": 601, "to_condition": 5, "to_global_id": 602, "spawn_sec": 77}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105136, "race_id": 14, "master_id": 603, "global_id": 602, "from_condition": 5}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "hp": 7000, "attack": 650, "base_hp": 7000, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114512, "race_id": 14, "change_to": 7, "change_condition": 3, "master_id": 31002, "global_id": 4621, "spawn_sec": 101}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112816, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30725, "global_id": 4344, "ranged": true, "spawn_sec": 127}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112832, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30726, "global_id": 4345, "ranged": true, "spawn_sec": 165}], "popups": ["尊天君はHPが50％以下になると\n一定範囲内のユニットへ与える\n継続ダメージ、防御力、魔法耐性が\n大幅に低下します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "狛天君", "text": "見損なったぞ、尊天君。\n勇猛と名高い鬼の一族とはいえ、\nたった二人の小娘に恐れをなすとは。", "face": "lf57f1f8e2e1f"}, {"name": "尊天君", "text": "うぬには耳がないのか？\nわしは淵天君からの連絡を待つべきだと\n云うておるだけではないか。", "face": "lf20018357329"}, {"name": "尊天君", "text": "そも、先刻送り出した尖兵たちが\nうぬの言う鬼の小娘どもに敗れておるのだ。\n敵戦力が未知数である以上、強行策は得策ではない。", "face": "lf20018357329"}, {"name": "狛天君", "text": "愚物めが。淵天君の司令がなければ何もできぬか。\nあの小娘どもを葬れば村まであと僅かというに……！", "face": "lf57f1f8e2e1f"}, {"name": "リンドウ", "text": "おう、来るなら来んかーい！\nけどな、この先は絶対に通さへんでぇッ！", "face": "u587"}, {"name": "鬼刃姫", "text": "ちょっ……リンドウ。あんまり煽りすぎないでよ？\n敵が本当に本気で来たらマズいし……それに、\nさっきの戦いであなたも疲れてるでしょう？", "face": "u435"}, {"name": "メイファ", "text": "――い、いました、邪仙たちですっ！\nって、あの大きな武器を持った女の子たちは……？", "face": "u618"}, {"name": "アンナ", "text": "リンドウさん、鬼刃姫さん！\nこの先の村を守っていてくださったのですね？"}, {"name": "リンドウ", "text": "……ま、まぁ、あんたら人間には借りがあるしな。\n鬼刃姫と遊ぶついでに、ちょいとやっつけたったわ！", "face": "u587"}, {"name": "ケイティ", "text": "ふふ、ありがとうございます。\nお疲れのようですし、後は我々にお任せください。", "face": "u114"}, {"name": "狛天君", "text": "ぐぬぅぅッ……もう辛抱ならん！\n道士ども、出陣だ！\nワシの『烈焔陣』で灰にされたくなければな！", "face": "lf57f1f8e2e1f"}, {"name": "尊天君", "text": "ま、待たぬか狛天君！\n……くっ、忍耐を知らぬ狂犬めが……。", "face": "lf20018357329"}, {"name": "アンナ", "text": "王子、敵軍の統率が乱れている今が好機です。\n敵の攻勢に怯まず、ここで敵将を討ちましょう。", "face": "l53980a73cb6a"}, {"name": "太公望", "text": "ですが、尊天君の周囲を取り巻く砂の守りは堅牢無比。\nあらゆる守りを貫くような攻撃なら突破できましょうが、\n生半可な攻撃では破れません。くれぐれもご注意を。", "face": "u603"}]}, {"trigger": "end", "lines": [{"name": "尊天君", "text": "グファアアァッ！！\nえ、淵天君からの連絡さえ来ておれば……ッ！", "face": "lf20018357329"}, {"name": "太公望", "text": "それは無理な望みです。\n彼は王子たちに敗れ、本陣から遁走したのですから。", "face": "u603"}, {"name": "狛天君", "text": "ぐぬぅぅッ……おのれ、太公望ッ！\nかくなる上は、貴様を巻き添えにして――", "face": "lf57f1f8e2e1f"}, {"name": "尊天君", "text": "は、早まるな狛天君！\nいまヤツと刺し違えたとて邪仙郷の為にはならぬ！\n此処は一旦退き、再起をはかるべきだ。", "face": "lf20018357329"}, {"name": "狛天君", "text": "くっ……この屈辱、必ず雪がせてもらうぞ！\n貴様ら全員、灰となるまで灼き尽くしてくれる！", "face": "lf57f1f8e2e1f"}, {"name": "ナタク", "text": "……邪仙郷に向かったみたいだね。\n当分は傷を癒やすのに専念するつもりだろう。", "face": "u297"}, {"name": "リンドウ", "text": "東の国も一歩、平和に近づいたってわけやな！", "face": "u587"}, {"name": "チズル", "text": "――あぁ、おかげさまでね。\n王子、お前らが敵の指揮官を倒してくれたんだろ？", "face": "u159"}, {"name": "アンナ", "text": "チズルさん！　\n各地の戦況は――"}, {"name": "チズル", "text": "どこも形勢逆転してるよ。\n指揮官からの司令が届かないっつって、\n邪仙どもの軍はどこもかしこも大わらわだ。", "face": "u159"}, {"name": "メイファ", "text": "で、でしたら、このままの勢いが続けば\n邪仙たちを東の国から追い出せるんですね？", "face": "u618"}, {"name": "太公望", "text": "いえ、そう単純な話ではありません。\n私の見立てでは、そろそろ――", "face": "u603"}, {"name": "ヒエン", "text": "――御注進！　火急の件にございます！\n十天君の残存勢力が集結し、都を急襲。\n数刻もせぬうちに都が制圧された模様。", "face": "u112"}, {"name": "メイファ", "text": "えぇっ！？　\nみ、都が……制圧……？", "face": "u618"}, {"name": "太公望", "text": "……そう来ましたか。\nおそらく指揮を執っているのは\n先に逃走した淵天君でしょう。", "face": "u603"}, {"name": "鬼刃姫", "text": "王子、この地はあてとリンドウに任せて、\n早く都にいる人たちを助けに行ってあげて！", "face": "u435"}]}], "active": true}