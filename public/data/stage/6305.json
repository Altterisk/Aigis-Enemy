l_id": 67, "ranged": true, "spawn_sec": 52}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 55}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 55}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 68}, {"enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 75}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 430, "base_hp": 6500, "base_attack": 430, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "master_id": 74, "global_id": 73, "spawn_sec": 99}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 110}], "dialogue": [{"trigger": "start", "lines": [{"name": "デシウス", "text": "ええい、らちが明かん！\n王子たちはまだ来ないのか！", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "あれは――デシウス！？\n王子、デシウスが女神の神殿を守って\n魔物と戦っています！", "face": "la7f94b5d2087"}, {"name": "デシウス", "text": "遅いッ！　なにをしていたのだ、王子！", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "わ、私たちは遠征から帰ってきたばかりで……。\n貴方こそ、なぜ神殿を守って――", "face": "la7f94b5d2087"}, {"name": "デシウス", "text": "話は後だ！　さっさと加勢しろ！\n魔物どもから神殿を守りたければな！", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "わかりました。\n王子、詳しい事情は不明ですが、\nここはデシウスに加勢しましょう！", "face": "la7f94b5d2087"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "……ふぅ。危ないところでした。\nしかし、なぜ神殿を守ってくださっていたのですか？", "face": "la7f94b5d2087"}, {"name": "デシウス", "text": "フン、行きかけの駄賃というやつだ。\n今回は貴様らに頼みがあって来たのでな。", "face": "l07c2a5a929a8"}, {"name": "ケイティ", "text": "私たちに頼み……？\nいままで私たちに敵対してきた貴方が、\nいまさらなにを言うのですか？", "face": "u114"}, {"name": "デシウス", "text": "まあ聞け。我輩はついに\nあのケラウノスを倒す方法を突き止めたのだ。", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "え……ケラウノス様を、倒す……？", "face": "la7f94b5d2087"}, {"name": "ケイティ", "text": "まさか……人間を滅ぼそうとしているとはいえ、\nケラウノス様は神の一柱なのですよ？\n現にあの御方は、何度追い詰めてもその都度……。", "face": "u114"}, {"name": "デシウス", "text": "その神を殺す方法を見つけたと言っているのだ。", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "…………！", "face": "la7f94b5d2087"}, {"name": "デシウス", "text": "だが、それを実行するには……、\n王子、貴様の軍に協力してもらう必要がある。\n我輩一人の手には負えん案件なのでな……。", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "そういうわけだ。王子、協力しろ。\n我輩だって貴様と共闘など不本意だが、\nあのケラウノスを葬れるのだ。悪い話ではあるまい？", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "……なに？\n詳細を聞いてからでないと決められんだと？\n貴様……この我輩が頼んでいるのだぞ！", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "ひ、ひとまずここではなく、\nもっと落ち着ける場所で話を伺いましょう。", "face": "la7f94b5d2087"}]}], "active": true}