{"quest_id": 10001, "name": "第1階層", "description": "【主な敵】\n？？？(英傑の幻影) / 塔の守護者\n＜ドロップなし＞＜編成内での同ユニット禁止＞\n%c[66ffff]スコア報酬で【★５】星を詠む者ソラス入手可能！%c[ffffff]", "modifier_notes": ["ドロップなし", "編成内での同ユニット禁止"], "event": "英傑の塔", "event_category": "Tower", "mission_id": 110001, "map_no": 35, "level": 100, "multiplier": 1.0, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [10], "expression": "IsOverlapMember() != 1;", "expression_human": "it is not a duplicate of another unit in your team"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["英傑"], "hp": 60000, "attack": 1500, "base_hp": 60000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_range": 400, "attack_speed": 1, "attack_wait": 30, "attack_interval": 193, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120288, "special_effect_id": 229, "change_to": 1, "change_condition": 3, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 21010, "global_id": 1304, "ranged": true, "to_condition": 3, "to_global_id": 1305, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["英傑"], "hp": 60000, "attack": 1500, "base_hp": 60000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_range": 400, "attack_speed": 1, "attack_wait": 30, "attack_interval": 193, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120288, "special_effect_id": 427, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 21011, "global_id": 1305, "ranged": true, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 2, "tags": ["英傑"], "hp": 12000, "attack": 1600, "base_hp": 12000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 25, "attack_speed": 1, "attack_