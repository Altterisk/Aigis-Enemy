1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 250, "magic_defense": 90, "attack_range": 150, "attack_speed": 26, "attack_interval": 31, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109520, "special_effect_id": 229, "missile_id": 40, "missile": {"speed": 7.0}, "master_id": 30193, "global_id": 3812, "ranged": true, "spawn_sec": 50}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "tags": ["英傑"], "hp": 9000, "attack": 1200, "base_hp": 9000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 200, "magic_defense": 90, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 185, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120144, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 21018, "global_id": 1312, "ranged": true, "spawn_sec": 82}], "popups": ["ソラスは長射程の\n遠距離攻撃を行います。\nまたHPが50％以下になると、\n攻撃対象が3体に増加します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シャディア", "text": "――戯れが過ぎるのではありませんか？\nソラス様が王子に試練を課したと聞いて来ましたが、\n今は力試しをしている場合では……。", "face": "u713"}, {"name": "ソラス", "text": "シャディアちゃんは相変わらず心配性ですねぇ。\n何も自分の興味本位で、\nこんな塔を作ったわけではありませんよ？", "face": "u904"}, {"name": "ソラス", "text": "私達も、あの魔王を真に滅ぼすことは出来ませんでした。\nただアイギス様のお力を借りて、\n一時的に封印し、未来にその対処を押し付けただけです。", "face": "u904"}, {"name": "シャディア", "text": "それは、そうですが……。", "face": "u713"}, {"name": "ソラス", "text": "あの英雄王の力を持ってしても、\nそれでも届かなかった魔王討伐……。", "face": "u904"}, {"name": "ソラス", "text": "なれば、王子君達に\nその実力の片鱗だけでも見いだせなければ、\nここで諦めるように諭すのも先人の役目。", "face": "u904"}, {"name": "シャディア", "text": "……王子達の力が及ばぬなら、\nここであなたが彼らを蹴散らし、\nこの世界を諦めるように言い聞かせる、と？", "face": "u713"}, {"name": "ソラス", "text": "さて、それは王子君たちの実力次第♪\nそのための英傑の塔、というわけですからね。", "face": "u904"}, {"name": "バルバストラフ", "text": "――ここが英傑の塔じゃな？\n目の前に見えるのは異界の門かのう。", "face": "u63"}, {"name": "ソラス", "text": "異界の門を知っているなんて、\n当代の魔術師も捨てたものではなさそうですね。\n別の場所と繋がる狭間という点では、似たようなものです。", "face": "u904"}, {"name": "ソラス", "text": "まずは王子君と、王子君が信じる仲間達が、\nこの塔に入るだけの資格があるかどうか、\n私と、塔の守護者達で見極めさせてもらいます。", "face": "u904"}, {"name": "バルバストラフ", "text": "ふむ……。\n塔に入るには相応の実力を見せよ、というわけじゃな。\n王子よ、油断するでないぞ。", "face": "u63"}, {"name": "ソラス", "text": "よろしい。\n狭間より現れる守護者と、私の魔術。\n見事退け、実力を見せてください！", "face": "u904"}]}, {"trigger": "end", "lines": [{"name": "ソラス", "text": "――おや、これは予想以上では……？", "face": "u904"}, {"name": "バルバストラフ", "text": "ワシらを見くびっては困る。\nこれより過酷な戦場はいくつもあったぞい。", "face": "u63"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ソラス", "text": "なるほど……。\nならば、この塔に入る資格があると認めましょう。", "face": "u904"}, {"name": "ソラス", "text": "それでは、どうぞ、英傑の塔へ――。", "face": "u904"}]}], "active": true}