{"quest_id": 4467, "name": "仙猿の子分", "description": "石を投げ攻撃を仕掛ける\n大猿の動きに注意し、仙猿が\n指揮する大猿の群れを突破せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "封じられた仙猿", "event_category": "History", "mission_id": 920058, "map_no": 3650, "level": 100, "multiplier": 1.0, "charisma": 50, "exp": 200, "gold": 1200, "drops": [{"card": 12, "c": 1}, {"card": 135, "c": 1}, {"card": 57, "c": 1}, {"item": 1007, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 20000, "attack": 700, "base_hp": 20000, "base_attack": 700, "damage_type": "physical", "armor_defense": 700, "magic_defense": 15, "attack_range": 200, "attack_speed": 100, "attack_wait": 30, "attack_interval": 103, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104192, "missile_id": 128, "missile": {"speed": 6.0, "deflectable": true}, "master_id": 524, "global_id": 523, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 36, "form_index": 0, "form_count": 2, "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104272, "race_id": 14, "change_to": 2, "master_id": 517, "global_id": 516, "to_condition": 0, "to_global_id": 517, "route_behaviour": {"transforms": [{"wait": 1000}]}, "spawn_sec": 9}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 105, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104320, "race_id": 14, "change_to": 1, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 518, "global_id": 517, "ranged": true, "from_condition": 0}], "dialogue": [{"trigger": "start", "lines": [{"name": "仙猿", "text": "ふわぁ……遅かったな、待ちくたびれたぜ。", "face": "u327"}, {"name": "アンナ", "text": "まずは話を聞いていただけませんか？", "face": "l4189aaf75d19"}, {"name": "仙猿", "text": "んなことよりさっさと始めようぜ！", "face": "u327"}, {"name": "ケイティ", "text": "こちらの言動は完全に無視のようですね。", "face": "u114"}, {"name": "ウィルフレッド", "text": "これがほんとの、見ざる聞かざる……。", "face": "u5"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "仙猿", "text": "さて！　\nオレたちの本気を見せてやるぜ！", "face": "u327"}]}, {"trigger": "battle", "at_sec": 13, "lines": [{"name": "ロイ", "text": "……！！\nあんなに多くの猿を、いったいどこから……。", "face": "u11"}, {"name": "仙猿", "text": "驚いたかい？　\nオレにも頼れる仲間がいるんだぜ！\nま、さっき思い出したんだけどな。", "face": "u327"}, {"name": "ウィルフレッド", "text": "ふざけたやつだ。", "face": "u5"}, {"name": "ローレン", "text": "だが、あれだけ体が大きいにも関わらず、あの\n軽快な身のこなし……。そこいらの野猿を\n引っ張ってきたってわけじゃなさそうだな。", "face": "u118"}, {"name": "ロイ", "text": "油断は禁物、ということですな。", "face": "u11"}, {"name": "仙猿", "text": "ごちゃごちゃ言うのは負けた後にしなッ！", "face": "u327"}, {"name": "仙猿", "text": "オラァッ！　いくぜッ！", "face": "u327"}]}, {"trigger": "end", "lines": [{"name": "仙猿", "text": "うぅぅ……あとチョットだったのによぉ……。", "face": "u327"}, {"name": "アンナ", "text": "ようやく落ち着いて話ができるようですね。\nよく聞いてください、私たちの敵は魔物です。\nだから、あなたと戦う理由などないのです。", "face": "l23373e4b2cfe"}, {"name": "仙猿", "text": "さっきもそんなこと言ってたな……。\n……ったく、\nオレもだんだんと思い出してきたぜ。", "face": "u327"}, {"name": "仙猿", "text": "そうだよ……。\nオレもあんたらと同じだった。\n仲間と一緒に魔物と戦ってたんだ。", "face": "u327"}, {"name": "アンナ", "text": "なら、私たちと共に、\n魔物と戦っていただけませんか？", "face": "l4189aaf75d19"}, {"name": "仙猿", "text": "……いや、ちょっと待てよ……？", "face": "u327"}, {"name": "アンナ", "text": "え？", "face": "l4189aaf75d19"}, {"name": "仙猿", "text": "おかしい！\n魔物はぜ～んぶ退治した記憶があるぞ。\nそうだ……平和になってオレは退屈してた。", "face": "u327"}, {"name": "仙猿", "text": "だから悪ふざけに人里でちょいと暴れたら、\n強すぎるオレの力を仙人たちが恐れて……。", "face": "u327"}, {"name": "ロイ", "text": "何やら様子がおかしいですぞ。", "face": "u11"}, {"name": "仙猿", "text": "あいつら……オレを騙して……。\n絶対許せねぇ！\n仕返ししてやる……！", "face": "u327"}, {"name": "アンナ", "text": "落ち着いてください。\n復讐はいけませんよ。", "face": "l4189aaf75d19"}, {"name": "仙猿", "text": "……だけど、その前にまずはあんたらだな！\nオレはまだ本気を出してないんだ。\n仲間にしたきゃもっと強い奴を出しやがれ！", "face": "u327"}, {"name": "仙猿", "text": "いいか、次が最後だ。上で待ってるぞ。", "face": "u327"}, {"name": "ロイ", "text": "またもや、行ってしまいましたな。", "face": "u11"}, {"name": "ウィルフレッド", "text": "猿はまた去る……ふふ。", "face": "u5"}]}], "map": {"image": "Map920058_3650", "w": 960, "h": 640, "spots": [{"k": "b", "x": 925, "y": 439}, {"k": "m", "x": 169, "y": 264, "id": 200}, {"k": "m", "x": 297, "y": 260, "id": 201}, {"k": "m", "x": 424, "y": 247, "id": 202}, {"k": "m", "x": 537, "y": 208, "id": 203}, {"k": "m", "x": 594, "y": 114, "id": 204}, {"k": "m", "x": 131, "y": 346, "id": 205}, {"k": "m", "x": 241, "y": 362, "id": 206}, {"k": "m", "x": 342, "y": 412, "id": 207}, {"k": "m", "x": 396, "y": 492, "id": 208}, {"k": "m", "x": 496, "y": 313, "id": 209}, {"k": "m", "x": 567, "y": 375, "id": 210}, {"k": "m", "x": 729, "y": 452, "id": 211}, {"k": "m", "x": 828, "y": 450, "id": 212}, {"k": "m", "x": 255, "y": 109, "id": 213}, {"k": "m", "x": 640, "y": 430, "id": 214}, {"k": "m", "x": 338, "y": 78, "id": 215}, {"k": "m", "x": 154, "y": 89, "id": 216}, {"k": "r", "x": 447, "y": 420, "id": 300}, {"k": "r", "x": 161, "y": 439, "id": 301}, {"k": "r", "x": 332, "y": 204, "id": 302}, {"k": "r", "x": 303, "y": 317, "id": 303}, {"k": "r", "x": 311, "y": 148, "id": 304}, {"k": "r", "x": 703, "y": 255, "id": 305}, {"k": "r", "x": 664, "y": 367, "id": 306}, {"k": "r", "x": 757, "y": 278, "id": 307}, {"k": "r", "x": 773, "y": 514, "id": 308}, {"k": "r", "x": 515, "y": 153, "id": 309}]}, "start_cost": 10, "active": true}