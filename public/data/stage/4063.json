{"quest_id": 4063, "name": "王都強襲", "description": "敵の部隊が王城を強襲！\n迫りくる敵から王都を\n守りぬけ！", "event": "熱砂の剣士", "event_category": "History", "mission_id": 920018, "map_no": 3826, "level": 95, "multiplier": 0.95, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "hp": 950, "attack": 142, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 16, "form_count": 1, "tags": ["アンデッド"], "hp": 950, "attack": 285, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 12}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 760, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 15}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 2850, "attack": 570, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 18}, {"enemy_id": 5, "source": "local", "count": 12, "form_count": 1, "tags": ["アンデッド"], "hp": 3800, "attack": 285, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 22}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 9500, "attack": 475, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 161, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098304, "special_effect_id": 227, "master_id": 90, "global_id": 89, "spawn_sec": 40}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 2375, "attack": 475, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 70, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 46, "global_id": 45, "spawn_sec": 86}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 9500, "attack": 950, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 15, "attack_interval": 201, "move_speed": 1200.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100992, "race_id": 16, "master_id": 20179, "global_id": 1254, "spawn_sec": 94}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "王子たちが帰ってくるまで\n守れ！　守りぬけ！！", "face": "l37447c9d4b29"}, {"name": "砂漠の戦士", "text": "（この城さえ攻め落とせれば、\n　後は王子を捕らえるのみ）", "face": "u175"}, {"name": "兵士", "text": "手強い！　このままでは……！", "face": "l37447c9d4b29"}, {"name": "アンナ", "text": "皆の者、よく耐えてくれました！"}, {"name": "兵士", "text": "……！　アンナ様！　王子も……！\nみんな！　王子が帰ってきたぞ！", "face": "l37447c9d4b29"}, {"name": "砂漠の戦士", "text": "（敵軍の空気が一変した？\n　なるほど、王子が帰ってきたか）", "face": "u175"}, {"name": "砂漠の戦士", "text": "この戦いでは私も出る！", "face": "u175"}, {"name": "砂漠の戦士", "text": "王城さえ落せばこちらの物だ！\n一気に決めるぞ！", "face": "u175"}, {"name": "アンナ", "text": "王子、戦の準備は整いました。\n迎撃の指揮をお願いします！", "face": "lc2f00ec74cd9"}]}, {"trigger": "end", "lines": [{"name": "砂漠の戦士", "text": "くっ、ここまでか……！\n……撤退する！", "face": "u175"}, {"name": "ホルエス", "text": "見事な戦でした。\n流石、我が王国の誇る戦士ですね。", "face": "u149"}, {"name": "砂漠の戦士", "text": "ホルエス様！　いらしていたのですね。\n申し訳ございません。\n残念ながら、負けてしまいました……。", "face": "u175"}, {"name": "砂漠の戦士", "text": "しかし、敵の戦力を削ぐ事には成功しています。\nもう少し、後一押しで勝てます！", "face": "u175"}, {"name": "ホルエス", "text": "もし勝てたとしても……。", "face": "u149"}, {"name": "ホルエス", "text": "私たちが成そうとしている事は\n砂漠の王国を襲った魔物と同じです……。", "face": "u149"}, {"name": "ホルエス", "text": "今度は私たちが憎しみの対象に\nなるのでしょうね……。", "face": "u149"}, {"name": "砂漠の戦士", "text": "ホルエス様、弱音を吐かれないでください。\n私たちには、この戦いに勝つしか\n選択肢が残されていないのです。", "face": "u175"}, {"name": "砂漠の戦士", "text": "人質を解放し、祖国を復興する事ができれば、\nあの魔物にも一矢報いるチャンスが訪れるはず。", "face": "u175"}, {"name": "ホルエス", "text": "……そうですね。\n今は行動するしかない。", "face": "u149"}, {"name": "ホルエス", "text": "今夜、最後の戦いを仕掛けます。\n皆さん、私についてきてください。", "face": "u149"}, {"name": "砂漠の戦士", "text": "御意。どこまでもお供いたします。\nたとえ、魔の力を借りようとも。", "face": "u175"}, {"name": "ホルエス", "text": "ありがとうございます。\nこんな私のために……。", "face": "u149"}, {"name": "ホルエス", "text": "戦の準備をはじめましょう。\n今夜の戦いに全てを懸けます！", "face": "u149"}]}], "active": true}