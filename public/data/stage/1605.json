50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 162}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 203}], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモン剣士", "text": "これがアイギスの神器か……。\n忌々しいガラクタめ。\n魔界の海にでも沈めてやる！", "face": "l4bfbc411ba99"}, {"name": "アンナ", "text": "……！　王子、あれを見てください！\nアイギス様の武具です！", "face": "l75d31e372db7"}, {"name": "デーモン剣士", "text": "ほう……人間どもめ。\nこの神器を魔界まで取り返しにきたか。\n面白い！　私を倒し、奪い返してみよ！", "face": "l4bfbc411ba99"}, {"name": "兵士", "text": "王子、ち、力が抜けて……。\nこれでは、まともに戦えません……。", "face": "ldf0741f19276"}, {"name": "デーモン剣士", "text": "だろうな、魔界の瘴気の中では貴様たち人間は\n本来の半分程度しか能力を発揮できない。\nご苦労にも殺されに来たということだ。", "face": "l4bfbc411ba99"}, {"name": "アンナ", "text": "……！　王子、あれを見てください！\nアイギス様の武具が光っています！", "face": "l75d31e372db7"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "アイギス", "text": "神器が主を求めているのです。\n力を失い、見守ることしかできない私ではなく……。", "face": "l1c759578affa"}, {"name": "アイギス", "text": "神器を手に取って、\n邪悪を撃ち払い、災いを跳ね返すことができる\n英雄を……。", "face": "l1c759578affa"}, {"name": "兵士", "text": "あれ？　体が軽くなった……？", "face": "ldf0741f19276"}, {"name": "アイギス", "text": "神器が王子を新たな主だと認めたのです。\nあの神器が戦場にある時は、自らとその仲間を\n魔界の瘴気から守ることができます。", "face": "l1c759578affa"}, {"name": "アイギス", "text": "さあ、王子よ。\nあの武具はあなたのものです。\n自らの手で取り返しなさい。", "face": "l1c759578affa"}, {"name": "デーモン剣士", "text": "少しは面白くなったな。\nさあ、我に近寄る愚かな人間は全て、\n魔界の雷で焼き払ってくれるわ！", "face": "l4bfbc411ba99"}]}, {"trigger": "end", "lines": [{"name": "デーモン剣士", "text": "グフッ……。\nく、くく……、私を倒したからと\nいい気に、なるな……。", "face": "l4bfbc411ba99"}, {"name": "デーモン剣士", "text": "もうすぐ『魔神レヴィアタン』が\n長い眠りから目を覚ます。\nその時が、お前ら人間どもの最後だ……！！", "face": "l4bfbc411ba99"}, {"name": "アンナ", "text": "息絶えたようですね……。\nですが、『魔神レヴィアタン』とは一体……。", "face": "l75d31e372db7"}, {"name": "ゼンメル", "text": "ここにいたか。また物騒な場所にいるものよのぅ。\nここが魔界か初めて来たぞい。", "face": "u284"}, {"name": "テルマ", "text": "申し訳ありません。ゼンメル師がどうしても\n魔界に来てみたいというもので……。", "face": "u296"}, {"name": "ゼンメル", "text": "なんじゃと、わしのせいにする気か。\nいや、それよりも大変じゃ！", "face": "u284"}, {"name": "ゼンメル", "text": "『魔神レヴィアタン』が……。", "face": "u284"}, {"name": "アンナ", "text": "『魔神レヴィアタン』が\n目を覚まそうとしているんですよね。", "face": "l75d31e372db7"}, {"name": "ゼンメル", "text": "なんじゃと！　なぜそれを知っておる。\n我々が魔法都市に残された魔界の観測記録を\n調べてやっとわかったというのに……。", "face": "u284"}, {"name": "シャロン", "text": "はい。それはもう何日も徹夜して。\n眠いのを我慢してここまでやってきました。", "face": "u283"}, {"name": "アンナ", "text": "い、いえ、これは先ほど戦ったデーモンが\n言い残しただけで……。\nそれで、どういう魔神なのでしょうか。", "face": "l75d31e372db7"}, {"name": "ゼンメル", "text": "な、なんじゃと。\nそうか、そうか、おぬしらレヴィアタンも知らんのか。\nならば教えてやらんでもないのぉ。", "face": "u284"}, {"name": "シャロン", "text": "『魔神レヴィアタン』。その別名は、終末の魔神。\nこの魔神が目を覚ます時\n全ての世界が終わる、と伝えられています。", "face": "u283"}, {"name": "ゼンメル", "text": "ああ、わしが、わしが教えてやるはずだったのに……。\nしかし、まだ情報はあるぞ……。", "face": "u284"}, {"name": "テルマ", "text": "『魔神レヴィアタン』は神々の手によって\n魔界の奥底に封印されていると言われていました。", "face": "u296"}, {"name": "テルマ", "text": "神々の封印はデーモンには\n解くことができないはずですが……。", "face": "u296"}, {"name": "ゼンメル", "text": "そ、それもわしが言いたかったこと……。", "face": "u284"}, {"name": "アンナ", "text": "ということは、魔界の奥底まで行って\n『魔神レヴィアタン』の復活を止めないと世界が\n滅んじゃうということですか！", "face": "l75d31e372db7"}, {"name": "ゼンメル", "text": "確実とは言えんが、その可能性は高いな。", "face": "u284"}, {"name": "アンナ", "text": "そ、そんな……。", "face": "l75d31e372db7"}, {"name": "アイギス", "text": "臆することはありません。\n神器があれば魔界でも力を発揮できます。\nそして、魔界の奥底はこの通路の先です。", "face": "l1c759578affa"}, {"name": "アンナ", "text": "しかし、神器はこのゲートを封印するために……。", "face": "l75d31e372db7"}, {"name": "シャロン", "text": "アンナ様。\nそこは私たちにお任せください。", "face": "u283"}, {"name": "カシス", "text": "少し時間をくれれば、結界を張ることができるわ。\n神器を使っている間は私たちがなんとかします。", "face": "u282"}, {"name": "ミトラ", "text": "私たちも微力だが協力しよう。\n世界が終ってしまったら元も子もないしな。", "face": "u276"}, {"name": "アンナ", "text": "みなさん……ありがとうございます！\nでは王子、いったん城に戻りましょう。"}]}, {"trigger": "end", "lines": [{"name": "帝国軍師", "text": "どうやら、神器は奪われずに済んだようです。\n魔界に持ち去られた時はどうなるかと思いましたが。", "face": "u311"}, {"name": "帝国軍師", "text": "神器はあの王子が受け継いだようですね。\n敵として戦うとしたら手ごわい相手となって\nしまいました。", "face": "u311"}, {"name": "帝国軍師", "text": "いざとなったら助けてやるおつもりだったのですか？\n……陛下、……陛下！\n聞こえていらっしゃいますか？", "face": "u311"}, {"name": "皇帝", "text": "……。", "face": "u312"}, {"name": "皇帝", "text": "全軍、帝国に帰投する。", "face": "u312"}, {"name": "帝国兵士", "text": "はっ！", "face": "u287"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 19, "params": [300]}], "enemies": [{"enemy_id": 1, "hp": 60000, "attack": 900, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "pattern_id": 2103488}, {"enemy_id": 3, "hp": 9000, "attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "pattern_id": 2103472}, {"enemy_id": 4, "hp": 9000, "attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "pattern_id": 2098272}, {"enemy_id": 5, "hp": 3000, "attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2100224}, {"enemy_id": 5, "form_index": 1, "hp": 3000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2100208}, {"enemy_id": 7, "hp": 22500, "attack": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "pattern_id": 2098288}, {"enemy_id": 8, "hp": 3000, "attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "pattern_id": 2100240}, {"enemy_id": 9, "hp": 15000, "attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "pattern_id": 2100352}]}, "active": true}