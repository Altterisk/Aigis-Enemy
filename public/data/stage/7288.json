[24, 1, 90], [25, 1, 90]]}, "spawn_sec": 163}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 420, "magic_defense": 15, "attack_range": 50, "attack_speed": 1, "attack_wait": 15, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123536, "special_effect_id": 548, "missile_id": 11, "master_id": 32649, "global_id": 6267, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 14, "source": "local", "count": 20, "form_count": 2, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122560, "special_effect_id": 242, "change_to": 14, "master_id": 33657, "global_id": 7274, "to_global_id": 7275, "route_behaviour": {"reroutes": ["Route=10", "Route=11", "Route=300", "Route=301", "Route=302", "Route=303", "Route=304", "Route=307", "Route=308", "Route=311", "Route=312", "Route=313", "Route=314", "Route=315", "Route=316", "Route=317", "Route=318", "Route=319", "Route=320", "Route=321", "Route=322", "Route=323", "Route=5", "Route=999"]}, "spawn_sec": 163}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122560, "change_to": 15, "change_condition": 1, "master_id": 33658, "global_id": 7275, "variants": [{"tags": ["アンデッド"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122608, "master_id": 33659, "global_id": 7276}]}], "popups": ["ヴァーニィの影は、\nブロックされている間\nHPが徐々に回復します。\n\nまたヴァーニィの影を倒すと\n以降、血の使い魔は\n生み出されません。", " 　　　悪天候：闇夜\n\n・敵の『移動速度』上昇", "血の使い魔(騎士)の攻撃は、\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――人の子でありながら、\nよくもここまで耐えるものだ。", "face": "l4b57584f8599"}, {"name": "？？？", "text": "だが、限りある生、定命の者たちなれば、\n絶え間なく襲い続ける不死者の群れに、\nいささか疲労の色が見えるのも確か……。", "face": "l4b57584f8599"}, {"name": "？？？", "text": "くく……王国の弱点とは王子でも、その臣下でもあらず。\n有象無象の雑兵どもが守る、\n小さな都市を抱えすぎたことよな。", "face": "l4b57584f8599"}, {"name": "ヒューナ", "text": "……王子、戦況報告よ。\n各戦線ともにアンデッドを押し留めているけれど、\n兵たちはもう疲れ切っているわ。", "face": "u627"}, {"name": "ルマリア", "text": "交代で休憩をとってもらっていますが、\nこのままではいずれ、どこかの戦線が崩れてしまいます。", "face": "u343"}, {"name": "ヴィンセント", "text": "……強力なアンデッドをぶつけるのではなく、\n無数のゾンビを絶え間なくぶつける戦法、か。", "face": "u103"}, {"name": "ヴィンセント", "text": "間違いない、この襲撃の背後には、\n誇りを捨ててまでこんな戦法を取るほどに、\n強い憎しみを抱いた存在がいるはずだ。", "face": "u103"}, {"name": "ヒューナ", "text": "例の公爵を名乗るヴァンパイア？\nそれとも強硬派の残党かしら？", "face": "u627"}, {"name": "エストリエ", "text": "強硬派の残党はありえないわ。\n長である私が、同族の血の香りを間違えるはずないもの。", "face": "u791"}, {"name": "ヴィンセント", "text": "ならば公爵――いや、\n公爵がくだったあの女ヴァンパイアこそ、\nこの襲撃の主犯と考えるべきか……。", "face": "u103"}, {"name": "エリザベート", "text": "ヴァンパイアの王国を滅ぼしたという、\n最初のヴァンパイアのひとり、だったかしら？", "face": "u104"}, {"name": "？？？", "text": "――その認識は、いささか異なる。\nこの身は血族にして、血族にあらざるものなれば。", "face": "l4b57584f8599"}, {"name": "エマ", "text": "ヴァーニィ、よく我らの前に姿を見せられましたね。\n我らが王国を失った悲しみ、忘れはしませんよ。", "face": "u582"}, {"name": "ヴァーニィ", "text": "その名で私を呼ぶな……！！\nまだ私の姉でいるつもりか！", "face": "la03a3b67f73a"}, {"name": "エストリエ", "text": "……姉？　どういうこと？\nエマ様、あの女はいったい何を……。", "face": "u791"}, {"name": "エマ", "text": "最初の血族たるあの御方は、\n自分の似姿として、\n幾人かの始祖たる血族を生み出しました。", "face": "u582"}, {"name": "エマ", "text": "それが私や、シルヴィア様に連なる王家の国父、\nラキュアたちに繋がる始祖の血筋の始まりです。", "face": "u582"}, {"name": "エマ", "text": "しかしあの御方は、\nただひとつだけ、迷いを抱えておりました。", "face": "u582"}, {"name": "シルヴィア", "text": "――あの御方は、人間に焦がれてしまったのですわ。\nそれゆえに、始祖たる者の最後に、\n人に似せた娘を生み出そうとしましたの。", "face": "u442"}, {"name": "ヴァーニィ", "text": "……黙れ。", "face": "la03a3b67f73a"}, {"name": "エマ", "text": "そうして紡がれたものは、\nヴァンパイアにあらず、さりとて人でもない。\n穢れた血の流れる徒花となったのです。", "face": "u582"}, {"name": "ヴァーニィ", "text": "黙れ、エマ。\n貴様にこの苦しみが分かるとでも言うのか。", "face": "la03a3b67f73a"}, {"name": "エマ", "text": "分かりませんとも。\nけれど、それでも私はあなたを妹として愛していた。\n――ヴァンパイアの王国を滅ぼすまでは。", "face": "u582"}, {"name": "ヴァーニィ", "text": "先に我が心を焼き尽くしたのは、お前たちだ。\nもはや、言葉を重ねるつもりもない。", "face": "la03a3b67f73a"}, {"name": "ヴァーニィ", "text": "すでに王国の弱点は理解した。\n此度の戦い、その目的は果たされた。", "face": "la03a3b67f73a"}, {"name": "ヴァーニィ", "text": "これならば、無尽蔵に手駒を増やせよう。\n――あとは、我が影とでも遊んでいくがいい。", "face": "la03a3b67f73a"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "エマ", "text": "王子、あの者の穢れた血は、\n無数の血の使い魔を生み出し続けます。", "face": "u582"}, {"name": "エマ", "text": "ヴァーニィの影を討ってしまえば、\nその召喚も止まりましょう。", "face": "u582"}, {"name": "シルヴィア", "text": "この暗がりでは、\nヴァーニィの手勢もより身軽になっていますわ。\n「闇夜」の間は特に気をつけてくださいな。", "face": "u442"}]}, {"trigger": "end", "lines": [{"name": "ヒューナ", "text": "……急に、静かになったわね。", "face": "u627"}, {"name": "ルマリア", "text": "あの人――ヴァーニィが退いたのでしょう。\n周囲のアンデッドも活動を停止したようです。", "face": "u343"}, {"name": "エマ", "text": "我らが愚妹がご迷惑をおかけしました、愛しきあなた。\nあの者が人の子らに手をかけるとなれば、\nもはや、血を分けた者とて見過ごすことはできません。", "face": "u582"}, {"name": "エマ", "text": "あの者は私がこの手で――", "face": "u582"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "エマ", "text": "……王子？\n私だけでなく、人類の戦いでもあると？", "face": "u582"}, {"name": "エマ", "text": "……甘いお人です、本当に。", "face": "u582"}, {"name": "エマ", "text": "ではラキュア、エストリエ、力を貸してくれますか？\n共存派、強硬派の長として。", "face": "u582"}, {"name": "ラキュア", "text": "無論だとも。\n始祖殿の頼みを断るはずもないだろう。", "face": "u344"}, {"name": "エストリエ", "text": "わ、私も、じょ、助力するわ。\nこれでも強硬派最後の長だもの！", "face": "u791"}, {"name": "シルヴィア", "text": "――エマ、私の助力は必要ありませんの？", "face": "u442"}, {"name": "エマ", "text": "……しかし姫よ、あなたの高貴なる手を煩わせるわけには。", "face": "u582"}, {"name": "シルヴィア", "text": "共存派、強硬派、始祖たるあなたが王国に助力して、\nヴァンパイアの王国\n最後の王族が静観するなんてありえませんわ！", "face": "u442"}, {"name": "エマ", "text": "……承知しました、姫よ。\n強情なところは、母君に似たのでしょうか。", "face": "u582"}, {"name": "アンナ", "text": "……ヴァンパイアの始祖、最後のひとり。\nヴァーニィは王国の弱点を見つけたと言っていました。", "face": "la1b6fd6cc52b"}, {"name": "アンナ", "text": "これからも激戦は続くと思いますが、\n必ず、民を守り抜き、勝利を掴みましょう、王子！"}]}], "story_talk": true, "active": true}