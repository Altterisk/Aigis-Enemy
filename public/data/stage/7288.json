{"quest_id": 7288, "name": "狂い咲く花", "description": "疲労の色が見え始めた王子たちの前に\nアンデッド達を統率する首魁が姿を現す。\n＜特定のタイミングで闇夜が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["特定のタイミングで闇夜が発生"], "event": "ゴールドラッシュ29(2021)", "event_category": "Reproduce", "mission_id": 300307, "map_no": 4043, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "hp": 1500, "attack": 20, "base_hp": 1500, "base_attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 35, "attack_speed": 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 633, "global_id": 632, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 13200, "attack": 1400, "base_hp": 13200, "base_attack": 1400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2128320, "change_to": 2, "master_id": 33628, "global_id": 7245, "route_behaviour": {"sets_flags": [[1, 0, 4800], [26, 1, 200]]}, "spawn_sec": 4}, {"enemy_id": 5, "source": "local", "count": 22, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 35}, {"enemy_id": 6, "source": "local", "count": 19, "form_count": 1, "tags": ["アンデッド"], 