: "local", "count": 14, "form_index": 0, "form_count": 2, "hp": 6500, "attack": 400, "base_hp": 6500, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 30, "attack_interval": 116, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130944, "race_id": 2, "change_to": 7, "missile_id": 608, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34110, "global_id": 7727, "to_condition": 0, "to_global_id": 7709, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 94}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6500, "attack": 400, "base_hp": 6500, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "attack_range": 270, "attack_speed": 1, "attack_wait": 30, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130944, "race_id": 2, "change_to": 8, "change_condition": 1, "missile_id": 608, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34092, "global_id": 7709, "ranged": true, "from_condition": 0, "variants": [{"hp": 6500, "attack": 600, "base_hp": 6500, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 30, "attack_wait": 20, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130960, "race_id": 2, "master_id": 34093, "global_id": 7710}]}, {"enemy_id": 13, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130992, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34095, "global_id": 7712, "ranged": true, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴルム", "text": "――うわぁ、大穴あけちゃってるー。", "face": "u527"}, {"name": "サザンカ", "text": "前の戦いを思い出すね。\nあの時も大変だったけど……。", "face": "u1347a1"}, {"name": "ジュディス", "text": "今回も大変ですよ。\n冥界から物質界のどこに繋がるかと思えば、\nここ、工業都市のすぐ近くじゃないですか！", "face": "u2089a1"}, {"name": "メフィスト", "text": "いやはや、相手の考えが手に取るように分かるね。\nただの都市を狙うだけじゃ効率が悪い、と。", "face": "u526"}, {"name": "マレブランケ", "text": "……帝国の工業都市は、\n職員とその家族の集まる人口過密地域だ。\n考えたくもないことだけど、つまり――", "face": "u1225a1"}, {"name": "オルフィー", "text": "……人の命を狩るならば、\n一番、都合のいい場所、ですね。", "face": "u2085a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "白の皇帝", "text": "貴様までつらそうな顔をするな。\n手を貸してくれているだけで、\n俺たちからすれば、十分すぎるほどだ。", "face": "u418"}, {"name": "白の皇帝", "text": "これは、俺の招いた失態だ。\nいずれこの首で、民には罪を償おう。", "face": "u418"}, {"name": "王子", "text": "…………っ！", "face": "u1"}, {"name": "メリュジアナ", "text": "待て、王子。\n我らが口出しすることではないだろう。", "face": "u740"}, {"name": "メリュジアナ", "text": "こちらは、こちらでできることをしよう。\n愚かな竜人の同胞たちは、\nどうやら続々とこちらへ進軍中らしい。", "face": "u740"}, {"name": "メリュジアナ", "text": "冥界からこの地へ至る穴も、\n時が経てばさらに増えていくはずだ。\n敵の侵攻経路には常に注意を払え。", "face": "u740"}, {"name": "ミュレ", "text": "穴掘りはこちらの専売特許だというのに！\n陛下、王子殿、ズガガガンと蹴散らしてやりましょう！", "face": "u1920a1"}]}, {"trigger": "end", "lines": [{"name": "メリュジアナ", "text": "――何とも汚い戦い方をするものだ。\n竜人の誇りも捨てたか。", "face": "u740"}, {"name": "ヴルム", "text": "不意打ちに奇襲に地下からの浸透戦術。\nやり口がただ勝つことしか考えてなくて、\n竜人っぽさがまったくないよね。", "face": "u527"}, {"name": "メリュジアナ", "text": "ああ。ならば――問うべきだろう。\n我が同胞たちよ！\n我が名はメリュジアナ、黒き長老を継ぐ者である！", "face": "u740"}, {"name": "メリュジアナ", "text": "汝ら、如何なる理由でこの地を踏み荒らすのか！\n誇りある竜人ならば答えるがいい！", "face": "u740"}, {"name": "竜人戦士", "text": "長老ナド知ったことカ！\n我ラ、真なる竜神を目指す雷霆の徒ナリ！", "face": "u95"}, {"name": "メリュジアナ", "text": "真なる竜神、だと……？", "face": "u740"}, {"name": "メリュジアナ", "text": "まさか、この部隊の指揮官は……。", "face": "u740"}, {"name": "アーニャ", "text": "竜将クロコ……！！", "face": "u99"}, {"name": "アーニャ", "text": "王子さま、このままじゃ工業都市が大変です！\n前の戦いでも、クロコは一時的に\n古代の雷竜の力を再現してみせました。", "face": "u99"}, {"name": "アーニャ", "text": "あんな力、戦えない人たちが受けたら……！", "face": "u99"}, {"name": "メリュジアナ", "text": "そんなこと、させるものか。\nヴルム殿、街へ急ぐぞ！", "face": "u740"}, {"name": "ヴルム", "text": "まっかせて！\nどけどけー！　ぶっ飛ばすぞー！！", "face": "u527"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [120]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 1200, "attack": 480, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2098592}, {"enemy_id": 2, "form_index": 0, "hp": 50400, "attack": 1500, "damage_type": "magical", "armor_defense": 600, "pattern_id": 2151376}, {"enemy_id": 3, "form_index": 0, "hp": 3360, "attack": 350, "damage_type": "magical", "armor_defense": 300, "pattern_id": 2097232}, {"enemy_id": 4, "form_index": 0, "hp": 4800, "attack": 840, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2098528}, {"enemy_id": 5, "form_index": 0, "hp": 7200, "attack": 500, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2140208}, {"enemy_id": 7, "form_index": 0, "hp": 9600, "attack": 900, "damage_type": "physical", "armor_defense": 400, "pattern_id": 2098560}, {"enemy_id": 8, "form_index": 0, "hp": 7800, "attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "pattern_id": 2130944}, {"enemy_id": 10, "form_index": 0, "hp": 7200, "attack": 300, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2130976}, {"enemy_id": 11, "form_index": 0, "hp": 7200, "attack": 500, "damage_type": "magical", "armor_defense": 400, "pattern_id": 2098544}, {"enemy_id": 12, "form_index": 0, "hp": 7800, "attack": 480, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "pattern_id": 2130944}, {"enemy_id": 12, "form_index": 1, "hp": 7800, "attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_de