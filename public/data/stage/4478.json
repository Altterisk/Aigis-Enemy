peed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104480, "race_id": 16, "missile_id": 6, "master_id": 536, "global_id": 535, "ranged": true, "spawn_sec": 119}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 149}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "民家近くにゴブリン達を発見！", "face": "l33933de3794d"}, {"name": "アンナ", "text": "被害が出る前に、至急迎撃を！", "face": "l1abcef41a141"}, {"name": "フィリス", "text": "あぁ、もう！　やっぱり力が抜ける……。\nそろそろどうにかしないと……！", "face": "u40"}, {"name": "レヴィ", "text": "……わたしの呪いは完璧。\nみんな、ぜったいに勝てるよ。", "face": "u328"}, {"name": "ゴブリン", "text": "ギャギャッ！　カテル！　カテル！", "face": "la13f277f1f6e"}, {"name": "ミトラ", "text": "……やはりそういうことか。", "face": "u276"}, {"name": "アンナ", "text": "どういうことですか？", "face": "l1abcef41a141"}, {"name": "ミトラ", "text": "ここ一帯の大気の淀み。皆の力の低下。\nすべての元凶はあの娘の仕業ってわけさ。", "face": "u276"}, {"name": "ケイティ", "text": "まさか！？\nあの方が魔物の一味だとでも言うのですか？", "face": "u114"}, {"name": "ミトラ", "text": "信じたくはないがな。……だが、妙だな。\n本来、呪術師の呪言は、\n術者の周囲でしか機能しないんだが……。", "face": "u276"}, {"name": "フィリス", "text": "それだけ彼女の力が強いってことじゃないのか？", "face": "u40"}, {"name": "ミトラ", "text": "それだけじゃ説明がつかないレベルさ。\nなにかほかにカラクリがあるはずだ。", "face": "u276"}, {"name": "アンナ", "text": "王子、戦闘の準備を！", "face": "l1abcef41a141"}]}, {"trigger": "end", "lines": [{"name": "レヴィ", "text": "――ッく。つよい……。\n……でも、だ、だいじょうぶ。\nあそこまで来てくれれば、わたしの勝ち……。", "face": "u328"}, {"name": "兵士", "text": "敵が逃げていきます！", "face": "l33933de3794d"}, {"name": "アンナ", "text": "追いましょう、王子！", "face": "l1abcef41a141"}]}], "active": true}