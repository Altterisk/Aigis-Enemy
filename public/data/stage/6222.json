"master_id": 30539, "global_id": 4158, "to_global_id": 4159, "route_behaviour": {"transforms": [{}], "calls_event": [2034, 2035]}, "spawn_sec": 116}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 6, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100976, "race_id": 16, "special_effect_id": 180, "change_to": 13, "master_id": 30540, "global_id": 4159, "to_global_id": 4160}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 6, "hp": 10000, "attack": 450, "base_hp": 10000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100976, "race_id": 16, "special_effect_id": 181, "change_to": 14, "master_id": 30541, "global_id": 4160, "to_global_id": 4161}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 3, "form_count": 6, "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100976, "race_id": 16, "special_effect_id": 182, "change_to": 15, "master_id": 30542, "global_id": 4161, "to_global_id": 4162}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 4, "form_count": 6, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100976, "race_id": 16, "special_effect_id": 183, "change_to": 16, "master_id": 30543, "global_id": 4162, "to_global_id": 4163}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 5, "form_count": 6, "hp": 10000, "attack": 1050, "base_hp": 10000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100976, "race_id": 16, "special_effect_id": 120, "master_id": 30544, "global_id": 4163}], "popups": ["『男たちの酒宴』に登場するダンは、\n屋台に立ち寄るたびに能力がアップします。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "コンラッド", "text": "おう野郎ども、こっちだぜ！\nこの先の屋台が俺の店だ。\n美味い酒と料理を楽しんでくれや。", "face": "u61"}, {"name": "兵士", "text": "山賊王さんの作られる山賊料理、\nすっごく楽しみです！　\nよぉっし、お腹いっぱい食べるぞー！", "face": "l23a9aa25cf54"}, {"name": "ロイ", "text": "まぁそう慌てなさんな。\nお酒も料理も逃げませんぞ。", "face": "u11"}, {"name": "ニコラウス", "text": "まぁロイ殿、楽しみに歩が軽くなるのは人として当然の事。\n武を極め、酒をたしなむ。男として当然の事ですぞ。\n後は華があれば完璧なのですがな。", "face": "u345"}, {"name": "リカルド", "text": "今回は男だけの交流会、\n女性が居ないのは仕方ないさ。", "face": "u205"}, {"name": "ダン", "text": "そうだぜ！　男同士、\n同じ釜の飯を食い、酒を酌み交わす！\nまさに友情だぜ！", "face": "u204"}, {"name": "弓兵", "text": "――王子、交流会の会場はこの先です。\n皆さん先に向かわれるとの事でしたが……。", "face": "u2"}, {"name": "山賊", "text": "ヒャッハーッ！　酒だぁーーーーッ！", "face": "l2e87a3a58592"}, {"name": "弓兵", "text": "……既にしっかり盛り上がってるようです。\nそれでは、自分も混ざらせて頂きます。", "face": "u2"}, {"name": "ニコラウス", "text": "おぉ！　王子殿ではありませんか！\nちょうどよかった！　今皆で誰が一番男らしいか\n語り合っていた所ですぞ！！", "face": "u345"}, {"name": "コンラッド", "text": "やっぱ男なら酒は強くなくっちゃな！\n見ろよ、この豪快な飲みっぷりを！\n……ゲェ～～～ップ。", "face": "u61"}, {"name": "ニコラウス", "text": "いやいやいや、男と言えばやはり筋肉。\nこの鍛え抜かれし肉体を見て下され。\n……フンッ！", "face": "u345"}, {"name": "リカルド", "text": "男らしさと言えば、やはり\n隙のない剣技につきるだろう。\n全てにおいて、俺に隙は無い！", "face": "u205"}, {"name": "ロイ", "text": "酒の強さと腕の強さ……男子たるものどちらも備えていて\n当然のもの。ここはひとつ、酒を飲み、王子に挑んで\n立っていられた者が男と言う事でどうですかな。", "face": "u11"}, {"name": "ダン", "text": "おぉ、いい考えじゃねーか！　酒もある事だし\nアレを見せる事も出来そうだ……。\n王子、久しぶりに全力の手合わせを頼むぜ！", "face": "u204"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "――まったく、男同士で交流を深める会、\nと聞いていましたが……。", "face": "u114"}, {"name": "兵士", "text": "うーん、もう飲めませんよ……ぐぅ。", "face": "l23a9aa25cf54"}, {"name": "ダン", "text": "うぅ、飲みすぎた……ぜ……。\n頭の中でドラが鳴り響いてやがる……。", "face": "u204"}, {"name": "王子", "text": "……Zzz。", "face": "u1"}, {"name": "ケイティ", "text": "王子軍たるもの、訓練や風紀は当然の事、\n礼節にも通じて貰わねばなりません。\n今一度、指導が必要のようですね。", "face": "u114"}, {"name": "アンナ", "text": "はい……ですが、激戦の日々の中、\n皆さん良い息抜きになったようで何よりです。"}, {"name": "ケイティ", "text": "……そうですね。指導については、\n目が覚めてから行うとしましょうか。", "face": "u114"}, {"name": "アンナ", "text": "はい、それがよさそうです。\n皆さん今はしっかりと疲れを癒されて下さいね。\nお疲れ様です。"}]}, {"trigger": "route", "enemy_ids": [12], "lines": [{"name": "ダン", "text": "ここの酒は城で飲む酒とは違うなぁ。\n凄いアルコールが強い感じがするけど、\n口当たりが良いから幾らでも飲めそうだぜ！", "face": "u204"}, {"name": "ダン", "text": "飲めば飲むほど……ヒック！", "face": "u204"}]}], "active": true}