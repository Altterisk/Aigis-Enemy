5952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 160}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "spawn_sec": 175}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100624, "race_id": 18, "special_effect_id": 220, "master_id": 272, "global_id": 271, "spawn_sec": 182}, {"enemy_id": 14, "source": "local", "count": 12, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098448, "race_id": 18, "special_effect_id": 220, "master_id": 96, "global_id": 95, "spawn_sec": 190}, {"enemy_id": 15, "source": "local", "count": 7, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 10, "attack_interval": 76, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100224, "race_id": 3, "change_to": 11, "change_condition": 4, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 233, "global_id": 232, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 231, "spawn_sec": 196}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 16, "source": "local", "count": 8, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 209}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112880, "race_id": 18, "special_effect_id": 220, "master_id": 30756, "global_id": 4375, "spawn_sec": 232}], "popups": ["デーモンロード、デモンポーンは\n倒されると、その場で復活します。\n\n2回まで復活し、\n復活するたびに強くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――い、生きて、る？\nお、王子！　王子っ、ご無事ですか！？"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ソラス", "text": "はぁ……はぁ……ま、間に合いました……。", "face": "u904"}, {"name": "サナラ", "text": "間一髪……でしたぁ……。", "face": "u921"}, {"name": "バルバストラフ", "text": "伝承に謳われし英傑……。\n星を詠む者と、大地を紡ぐ者……。\nそうか、天地の両方から結界を張ったのじゃな？", "face": "u63"}, {"name": "ソラス", "text": "偶然上手くいっただけ、ですけどね。\nもう一度狙ってやれって言われても無理でしょう……。", "face": "u904"}, {"name": "サナラ", "text": "でも、あくまで生き延びただけです。\nこの瘴気の濃度、完全に魔界そのものですね……。", "face": "u921"}, {"name": "アトナテス", "text": "瘴気の発生源は『破滅の力』そのものか。\nまるで俺がさまよってた、魔界の深淵みたいだぜ。", "face": "u908"}, {"name": "ソラス", "text": "今はまだ、魔界の入り口程度の瘴気ですが、\nこのまま侵食が進めば、\n地上の人々は皆衰弱し、いずれは……。", "face": "u904"}, {"name": "シャディア", "text": "……そうか、私達は、負けたのか。", "face": "u713"}, {"name": "ソーマ", "text": "世界が、ほろんじゃう、なんて……。\nぐすっ……やだ……いやです、そんなの……。", "face": "u23"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "王子", "text": "――まだ、諦めるわけにはいかない。", "face": "u1"}, {"name": "ソラス", "text": "王子君……でも、もう何も打つ手は……！", "face": "u904"}, {"name": "王子", "text": "あの時も、そうだった。\n魔物が復活し、王城を失ったあの日も。", "face": "u1"}, {"name": "王子", "text": "魔王ガリウス、お前を倒すと、俺は誓った。\nどんなに小さな可能性であっても、\nお前を滅ぼすのは、俺の使命だ。", "face": "u1"}, {"name": "アンナ", "text": "王子……っ。"}, {"name": "王子", "text": "俺は、絶対に諦めない。\n皆の力を、俺に貸してくれ。", "face": "u1"}, {"name": "ガリウス", "text": "……ほう、王子の戯言ひとつで、\n立ち上がってみせるか、物質界の残滓共が。", "face": "ld52e97de0357"}, {"name": "ガリウス", "text": "ならば、やってみせるが良い。\n門を開け、異界召喚士。", "face": "ld52e97de0357"}, {"name": "異界召喚士", "text": "ははぁっ！\nほれ、魔力を寄越せ不肖の弟子よ。", "face": "lc248e24c7892"}, {"name": "異界召喚士の弟子", "text": "うっ……ぁっ……いや……あぁぁッ！！", "face": "u942"}, {"name": "ガリウス", "text": "……後はお前達に任せよう。\n適当に遊んでやれ、いずれ死にゆく種族共だ。", "face": "ld52e97de0357"}, {"name": "デモンポーン", "text": "はぁ～い♪\nよわよわな王子ちゃん達とぉ、遊んであげまぁーす♪", "face": "u997"}, {"name": "デーモンロード", "text": "こら、魔王様の御前ですよ。\nそれにこれより死にゆく者達にも、\n一定の敬意は払うべきです。", "face": "u941"}, {"name": "アンナ", "text": "王子が諦めないのなら、\n私達が諦めるわけにはいきませんよね。", "face": "l34498d378b43"}, {"name": "アリシア", "text": "アンナお姉様の言うとおりです。\n今は魔物の軍勢を蹴散らして、\nこの場を切り抜けるのが先決です。", "face": "u372"}, {"name": "アトナテス", "text": "これだけの魔界の瘴気だ、\n今までの物質界と同じだと考えるんじゃないぞ。\nこれじゃ普段どおりの力は発揮できないだろう。", "face": "u908"}, {"name": "ケイティ", "text": "兵の士気にも影響が出ることでしょう。\nけれど、神々の神器ならば、\nこの瘴気から兵を守ることもできるかと。", "face": "u114"}, {"name": "王子", "text": "――行くぞ、皆。\n王国を取り戻したあの時のように、\n今度は、世界を取り戻しに。", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "デモンポーン", "text": "いったぁ～い！\nばかっ、ばかばかっ、ばか人間～！！", "face": "u997"}, {"name": "デーモンロード", "text": "油断するからですよ、まったく。\nですが、私達の役目は完遂できました。", "face": "u941"}, {"name": "デモンポーン", "text": "そうだね～♪\nよわよわ人間の邪魔したし、遊んであげたし、\n魔王様に報告しに帰ろ～♪", "face": "u997"}, {"name": "アンナ", "text": "……魔王軍、撤退していきます。"}, {"name": "ケイティ", "text": "……やることは、山積みですね。\n急ぎ世界各地に兵を派遣しましょう。\n地上にどれだけの被害があるのか確認しなければ。", "face": "u114"}, {"name": "レオナ", "text": "我々も協力しよう。\n瘴気の中でも飛空船は機能するはずだ。", "face": "u311"}, {"name": "アトナテス", "text": "…………。", "face": "u908"}, {"name": "サナラ", "text": "おや、どうして嬉しそうなんですかアトナテス。\n地上が魔界になっちゃったんですよ？", "face": "u921"}, {"name": "アトナテス", "text": "……おっと、悪いな。\nただ今の状況が千年戦争のときより酷いってのに、\n何とかなるような気がするのが、可笑しくてな。", "face": "u908"}, {"name": "アトナテス", "text": "人々を導き、勇気づけ、\n不可能に見えたことを可能にしていく。\n確かにあいつは、英雄王の系譜なんだ、ってな。", "face": "u908"}, {"name": "サナラ", "text": "むぅぅ、何だか分かったような顔してるのズルいです！\n私にも今まで起きたことを教えてくださいよぉ！", "face": "u921"}, {"name": "アンナ", "text": "情報共有は拠点に戻ってからにしましょう。\nまずは世界に起きた異変の調査をしなければ。"}]}, {"trigger": "route", "enemy_ids": [8], "lines": [{"name": "デーモンロード", "text": "これくらいの傷、どうということはありません。\nまさか、私を倒せたとでも思いましたか？", "face": "u941"}, {"name": "デーモンロード", "text": "しかし、少々癪に障るのも確か。\n私の本来の力を見せてあげましょうか……。", "face": "u941"}, {"name": "ラピス", "text": "如何に強力なデーモンであろうと、\n無傷ということはないだろう。", "face": "u436"}, {"name": "ラピス", "text": "王子、連中が起き上がってきたなら、\n復活できなくなるまで叩きのめしてやれ。", "face": "u436"}]}, {"trigger": "route", "enemy_ids": [5], "lines": [{"name": "デモンポーン", "text": "痛ぁ……くないも～ん♪\nだい、ふっ、かぁ～つ♪", "face": "u997"}, {"name": "デモンポーン", "text": "でもちょっとだけムカっとしたから、\nすこーしだけ本気出しちゃおうかなぁ？", "face": "u997"}, {"name": "ラピス", "text": "如何に強力なデーモンであろうと、\n無傷ということはないだろう。", "face": "u436"}, {"name": "ラピス", "text": "王子、連中が起き上がってきたなら、\n復活できなくなるまで叩きのめしてやれ。", "face": "u436"}]}], "active": true}