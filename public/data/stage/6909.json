{"quest_id": 6909, "name": "英雄が灯す希望", "description": "迫りくるデーモンの軍勢を迎撃せよ！\n＜魔界：味方の攻撃力と防御力が半減＞\n＜時間経過によるコスト回復量が低下＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["魔界：味方の攻撃力と防御力が半減", "時間経過によるコスト回復量が低下"], "event": "英雄王を継ぐ者", "event_category": "History", "mission_id": 920186, "map_no": 5119, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 27}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 2700, "attack": 350, "base_hp": 2700, "base_attack": 350, "damage_type": "physical", "armor_defense": 70, "magic_defense": 40, "attack_range": 10, "attack_speed": 40, "attack_wait": 3, "attack_interval": 49, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098704, "race_id": 3, "special_effect_id": 42, "missile_id": 45, "master_id": 157, "global_id": 156, "ranged": true, "spawn_sec": 48}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "