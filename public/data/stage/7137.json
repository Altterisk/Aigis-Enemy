": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 139}, {"enemy_id": 12, "source": "local", "count": 7, "form_count": 1, "tags": ["植物"], "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 667, "global_id": 666, "ranged": true, "spawn_sec": 143}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 398, "global_id": 397, "spawn_sec": 148}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "tags": ["植物"], "hp": 12000, "attack": 850, "base_hp": 12000, "base_attack": 850, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_wait": 50, "attack_interval": 139, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119376, "special_effect_id": 400, "master_id": 31845, "global_id": 5464, "spawn_sec": 159}], "dialogue": [{"trigger": "start", "lines": [{"name": "エスネア", "text": "あぁ！　デーモンシェフ見つけたよ！\nこらー！　カボチャの魔物なんて売っちゃだめだよー！", "face": "u997"}, {"name": "デーモンシェフ", "text": "むっ、元従業員のエスネアではないか。\nそれにアルバイトのリヴルまで。\nいったいどうしたというのだ？", "face": "lb18239fe1b38"}, {"name": "リヴル", "text": "デーモンシェフの仕入れたカボチャの木に、\nカボチャの魔物が大量に取り憑いてたんだ。", "face": "u1081a1"}, {"name": "リヴル", "text": "このままじゃハロウィンどころじゃない。\nお祭りが台無しになっちゃうじゃないか！", "face": "u1081a1"}, {"name": "デーモンシェフ", "text": "な、何！？\nよく動く活きの良いカボチャだぞ！\n台無しどころか喜ばれるのではないか！？", "face": "lb18239fe1b38"}, {"name": "リヴル", "text": "いいかデーモンシェフ、\n物質界のカボチャは動かないんだよ！！\nむしろ街の皆は怖がってたぞ！", "face": "u1081a1"}, {"name": "デーモンシェフ", "text": "ぐぬぬぬぬ……！\nまた商売失敗ということなのか……！？", "face": "lb18239fe1b38"}, {"name": "デーモンシェフ", "text": "しかし、ようやくこの森で\nカボチャの木の量産に成功したというのに……。", "face": "lb18239fe1b38"}, {"name": "リヴル", "text": "か、カボチャの木の……量産だってぇ！？", "face": "u1081a1"}, {"name": "カボチャの魔物", "text": "――カボカボカボ。\nデーモンシェフ、よく働いてくれたカボ。", "face": "lb6b194f94d39"}, {"name": "カボチャの魔物", "text": "おかげでボクらが取り憑くカボチャが、\nいーっぱい量産できたカボ！", "face": "lb6b194f94d39"}, {"name": "カボチャの魔物", "text": "その上オバケカボチャをいっぱい食べてくれたから、\nデーモンシェフの部下も\n既にボクらの手下になったカボ～♪", "face": "lb6b194f94d39"}, {"name": "デーモンシェフ", "text": "なっ……我社の従業員を……！？\nおのれっ、おのれカボチャの魔物めー！！", "face": "lb18239fe1b38"}, {"name": "リヴル", "text": "王子、カボチャの魔物に、\nデーモンシェフの部下までこっちに来てるぞ。", "face": "u1081a1"}, {"name": "リヴル", "text": "ハロウィンをめちゃくちゃにしようとするヤツらは、\nまとめて王子とリヴル様で薙ぎ払ってやるんだ！", "face": "u1081a1"}]}, {"trigger": "end", "lines": [{"name": "デーモンシェフ", "text": "また……また事業失敗か……。\n活きの良さばかりを求めてはいけないのだな……。", "face": "lb18239fe1b38"}, {"name": "リヴル", "text": "気を落とすなよ、デーモンシェフ。\nこのリヴル様ですら、何度も失敗してきたんだ。\nお前にだって次のチャンスはたくさんあるさ。", "face": "u1081a1"}, {"name": "リヴル", "text": "それより、カボチャの木はこれで全部なのか？", "face": "u1081a1"}, {"name": "デーモンシェフ", "text": "……いや、まだ一箇所、\n栽培実験に使った場所が残っている。\nそこには最も大規模なカボチャの木農場があるのだ。", "face": "lb18239fe1b38"}, {"name": "リヴル", "text": "へぇ、で、その場所は？", "face": "u1081a1"}, {"name": "ローレン", "text": "――王子！　ここにいたのか！\n大変だ、妖精郷にカボチャの魔物が……！", "face": "u118"}, {"name": "デーモンシェフ", "text": "……妖精郷だ。", "face": "lb18239fe1b38"}]}], "active": true}