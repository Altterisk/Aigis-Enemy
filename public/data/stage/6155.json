"damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "change_to": 13, "master_id": 30343, "global_id": 3962}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 10, "master_id": 30346, "global_id": 3965, "to_global_id": 3964, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 99}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 11, "master_id": 30345, "global_id": 3964}, {"enemy_id": 20, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103360, "race_id": 9, "master_id": 441, "global_id": 440, "spawn_sec": 130}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンクイーン", "text": "抜けるような青空……。\n輝く水面……。\nステキなレース場だわぁ博士！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "は、ハイ……。\nお気に召したようで、何よりでス……。", "face": "l16b6c88b22e6"}, {"name": "ゴブリン博士", "text": "ただ、頂いていた軍の予算を、\n大分使ってしまったものデ。\n追加の予算をご検討頂きたク――", "face": "l16b6c88b22e6"}, {"name": "ゴブリンプリンセス長女", "text": "――お母さまってば、こんな楽しそうなレースに\n私達姉妹を呼んでくれないなんて。\nまったく酷いじゃない！", "face": "l01370a5b793f"}, {"name": "ゴブリンクイーン", "text": "あら？　可愛い娘達じゃない。\nウフフ、ごめんなさいね。\nつい思い付きで始めちゃって。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンプリンセス三女", "text": "ふふ、お母さまらしいですね。\n急いで駆け付けてきたもので、\n縦巻きロールヘアも甘くなってしまいましたわ。", "face": "l7a8fa61fd429"}, {"name": "ゴブリンプリンセス次女", "text": "三女のロールヘアなんてどうでも良いのよ！\nそれよりお母さま、私達、考えたんですの。このレース\nゴールドを賭けたらもっと楽しくなるんじゃないかしら！", "face": "l298a0df0624c"}, {"name": "ゴブリンクイーン", "text": "それは名案ね！　さすが私の娘達！\n一位を当てた者が賭け金を総どり。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "――……長女は青、次女は赤、三女は緑ね。\n私はそうねぇ……あの人間かしらぁ！\nなかなか根性ありそうだし、見どころあるわぁ！", "face": "l86fc49ed0f43"}, {"name": "ゴブリンプリンセス長女", "text": "お母さまが人間を選ばれるなんて……でも、お母さまに\nそう言わせるだけの人間。少し楽しみだわ。\n……そうだ、折角だし博士も誰かに賭けなさい。", "face": "l01370a5b793f"}, {"name": "ゴブリン博士", "text": "へ……？　しかシ、私頂いた予算以外に\nゴールドを持ち合わせてハ……。", "face": "l16b6c88b22e6"}, {"name": "ゴブリンプリンセス次女", "text": "博士は三女と同じ緑で良いじゃない。あまりパッとしない\n博士らしい色よ……あ、そうだお母さま。応援のため、\n私達がレースに乱入しちゃってもいいのよね？", "face": "l298a0df0624c"}, {"name": "ゴブリンクイーン", "text": "ウフフフ！　勿論よぉ！\nそれじゃ、早速レース開始だわぁ！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "…………。\n（ぐぬヌ、勝手な事ばかり……魚人にゴールドを渡しテ、\n協力を仰がねば……なんとしても人間をビリに……！）", "face": "l16b6c88b22e6"}]}, {"trigger": "end", "lines": [{"name": "ティアル", "text": "ふぅ…………やったー！　三連勝ーッ！", "face": "u505"}, {"name": "アンナ", "text": "凄いですティアルさん！　レースをする度、\n速くなっているような気がします！"}, {"name": "ティアル", "text": "えへへ、やっぱり？　私もそう思ってたんだー♪\n私って、結構才能あったりしちゃうかなぁ……\n……あいたっ！？　", "face": "u505"}, {"name": "ティアル", "text": "……な、何するんですか先生！\nいきなりゲンコツだなんて！", "face": "u505"}, {"name": "ボリス", "text": "調子に乗りすぎだ。まだレースが\n終わったわけじゃねーんだ、\n気を引き締めていけ。", "face": "u360"}, {"name": "ティアル", "text": "……はぁい。", "face": "u505"}, {"name": "ケイティ", "text": "中々に手厳しいですね。", "face": "u114"}, {"name": "ティアル", "text": "……そうなんですよ！　先生って昔から\n私にばっかり厳しくて……少しくらい、\n優しくしてくれてもいいと思いません！？", "face": "u505"}, {"name": "ボリス", "text": "誉めるとすーぐ調子に乗るからだろうがっ！\nったく、才能だけなら昔から……いや、なんでもねぇ。\n兎に角だ、浮かれすぎて油断なんてすんじゃねーぞ！", "face": "u360"}, {"name": "ティアル", "text": "わ、わかりました！\nよーし、次のレースも頑張るぞー！！", "face": "u505"}, {"name": "ゴブリン博士", "text": "…………ギギギギッギィ。\n優秀な操縦士も、ゴールドも、私の手元から\n消えて行ク……なぜこんな事ニ……。", "face": "l16b6c88b22e6"}, {"name": "ゴブリン博士", "text": "最終レース場の設備費用も何もかも\n軍備から捻出し、クイーン様のお戯レにも\n付き合っテいると言うのニ……！", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "博士、何やっているの？\nさぁ最終レースの会場へ案内なさい！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "……ハイ。", "face": "l16b6c88b22e6"}]}], "active": true}