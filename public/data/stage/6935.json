{"quest_id": 6935, "name": "迷子を探す魔将", "description": "吹雪の中、デーモンロードは\n誰かを探しているようだが……？\n<特定のタイミングで吹雪が発生>\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "ゴールドラッシュ26(2019)", "event_category": "Reproduce", "mission_id": 300257, "map_no": 5835, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "hp": 5000, "attack": 200, "base_hp": 5000, "base_attack": 200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 80, "attack_interval": 127, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120624, "race_id": 3, "change_to": 1, "change_condition": 2, "master_id": 32228, "global_id": 5847, "to_condition": 2, "to_global_id": 5848, "spawn_sec": 19}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 6500, "attack": 400, "base_hp": 6500, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 80, "attack_interval": 127, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120624, "race_id": 3, "change_to": 2, "change_condition": 2, "master_id": 32229, "global_id": 5848, "from_condition": 2, "to_condition": 2, "to_global_id": 5849}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 10000, "attack": 650, "base_hp": 10000, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 80, "attack_interval": 127, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120624, "race_id": 3, "special_effect_id": 222, "master_id": 32230, "global_id": 5849, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical",