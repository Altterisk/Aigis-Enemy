 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 21}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 112}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 116}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 143}], "popups": ["　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――魔物がうろついている、ですか？", "face": "l736783066f8b"}, {"name": "一般兵Ａ", "text": "はい、巡回中に村人から報告があり、\n駆けつけてみたところ、\n確かに何かを探すかのように魔物がうろついていました。", "face": "u6"}, {"name": "クルル", "text": "こんな雪の中で、\nいったい何を探しているのかしら……？", "face": "u197"}]}, {"trigger": "start", "lines": [{"name": "ゴブリン", "text": "――ギャギャ！　マイゴ！　ミツカラナイ！", "face": "l7dda165ecec6"}, {"name": "デーモンロード", "text": "報告ありがとうございます。\nしかしそろそろ吹雪いてきそうです、\nもう少しだけ、捜索をお願いします。", "face": "u1941"}, {"name": "ゴブリン", "text": "ギャギャ！　リョウカイ！", "face": "l7dda165ecec6"}, {"name": "デーモンロード", "text": "（そろそろお腹を空かせて\n帰ってくる頃だと思っていたのですが、\nいったい何処に行ってしまったのでしょうか……）", "face": "u1941"}, {"name": "デーモンロード", "text": "（あの子が野生の動物に後れを取るはずがありませんし、\nやはりこの雪で帰り道が分からなく……？）", "face": "u1941"}, {"name": "ゴブリン", "text": "ギャギャ！　王子ハッケン！\nキョウリョク！　オネガイ！", "face": "l7dda165ecec6"}, {"name": "デーモンロード", "text": "あっ、こ、こらっ！\nそんな勢いで走っていったら……！？", "face": "u1941"}, {"name": "クルル", "text": "――きゃっ、お、王子、大変！\n向こうからゴブリンの群れが走ってくるわ！", "face": "u197"}, {"name": "アンナ", "text": "……何が起きているのかは分かりませんが、\n向かってくる以上見過ごすことはできませんね。", "face": "l736783066f8b"}, {"name": "クルル", "text": "王子、そろそろ吹雪がきそうよ。\n遠くを狙いにくくなると思うから、\n気をつけて皆に指示を出してね！", "face": "u197"}]}, {"trigger": "end", "lines": [{"name": "デーモンロード", "text": "――すみません、この子たちが\n紛らわしいことをしてしまって……。", "face": "u1941"}, {"name": "ゴブリン", "text": "ギャギャ……ゴメンナサイ……。", "face": "l7dda165ecec6"}, {"name": "アンナ", "text": "いえいえ、お互い怪我がなくてよかったです。\nところで、いったい何を探していたのですか？"}, {"name": "デーモンロード", "text": "それは……その……。", "face": "u1941"}, {"name": "ゴブリン", "text": "ギャギャ！　マイゴ！\nマイゴナッチャッタ！", "face": "l7dda165ecec6"}, {"name": "クルル", "text": "迷子……？\nもしかして、仲間が行方不明に……？", "face": "u197"}, {"name": "デーモンロード", "text": "は、はい……恥ずかしながら……。\nあの子はまだ子供同然なので、やはり心配で……。", "face": "u1941"}, {"name": "アンナ", "text": "なるほど……そういうことでしたら……。\n王子、一緒に迷子探しを手伝う\nというのはいかがでしょう？"}, {"name": "デーモンロード", "text": "えっ……？　よ、よろしいのですか？", "face": "u1941"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "困った時はお互い様です。\n今の私達は、敵ではないのですから。"}, {"name": "デーモンロード", "text": "うぅ、ありがとうございます！\n何とお礼を言えばよいのか……。", "face": "u1941"}, {"name": "ハルモニア", "text": "私はハルモニアと申します。\n元魔王軍の身ではありますが、\nこの御恩は必ずお返ししますので！", "face": "u941"}, {"name": "デモンポーン", "text": "（……むぅ～！\nお姉ちゃんばっかり楽しそうでずるいー！！）", "face": "u997"}, {"name": "デモンポーン", "text": "（でもでもぉ、あたしを子供扱いする\nお姉ちゃんとかよわよわ王子の所には、\nぜ～ったい帰ってあーげないっ♪）", "face": "u997"}, {"name": "デモンポーン", "text": "（ふふーん、ちょっと心配させてやるんだから。\nさぁて、どこに遊びに行こうかなー♪）", "face": "u997"}]}], "active": true}