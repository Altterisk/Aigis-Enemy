damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 45, "attack_interval": 148, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160640, "race_id": 16, "special_effect_id": 1795, "change_to": 22, "master_id": 39095, "global_id": 12712, "to_global_id": 12713, "spawn_sec": 208}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス", "ブロック不可"], "hp": 6000, "attack": 10, "base_hp": 6000, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 121, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2097392, "race_id": 16, "special_effect_id": 415, "change_to": 23, "master_id": 39096, "global_id": 12713, "to_global_id": 12714}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["ステルス", "ブロック不可"], "hp": 6000, "attack": 10, "base_hp": 6000, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 16, "change_to": 24, "master_id": 39097, "global_id": 12714, "to_global_id": 447}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 448, "global_id": 447, "ranged": true}], "popups": ["ガルヴェインは特定のタイミングで\nガルヴェインの残炎を発生させます。\n\nガルヴェインの残炎は一定範囲内の\nユニットに継続ダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "…………あぁ？", "face": "l3f028f309742"}, {"name": "？？？", "text": "……おい、どうして生きている。", "face": "l3f028f309742"}, {"name": "？？？", "text": "耐えきった……いや、違う……。\nこの力の感じは……。", "face": "l3f028f309742"}, {"name": "？？？", "text": "そうか、てめぇか。創――", "face": "l3f028f309742"}, {"name": "？？？", "text": "――おしゃべりが過ぎますよ。", "face": "lc88c5cbb5daf"}, {"name": "セーラ", "text": "なぜ、生きているのでしょう……？\n確かに私は、この身を焼き尽くされたはずですが。", "face": "u2627a1"}, {"name": "ミレイユ", "text": "あなたが、蘇らせてくれたのですか？\nえぇと……黒き導き……さん？", "face": "u2626a1"}, {"name": "？？？", "text": "今の私に、そこまでの力はありません。\n以前の戦いで、ギルガメッシュに\n無理やり力を引き剥がされてしまいましたから。", "face": "lc88c5cbb5daf"}, {"name": "白き導き", "text": "黒き破壊の力を奪われた、\nいわば、『白き導き』であるとでも名乗っておきましょうか。", "face": "lc88c5cbb5daf"}, {"name": "セーラ", "text": "しろき、みちびき……。", "face": "u2627a1"}, {"name": "白き導き", "text": "私はただ、あなた方の願いの背中を押しただけ。\n死をも怖れぬ願いと、死地であろうとも折れぬ意志。\n純粋なその願いを、新たな力に変えました。", "face": "lc88c5cbb5daf"}, {"name": "アラン", "text": "（この力は……なぜ、\n『神の楔』が、意思を持っているのですか……？）", "face": "u1511a1"}, {"name": "トラム", "text": "（あれは、似て非なるものよ。\n私たちがかつて用いた神の楔とは、本質が違うの）", "face": "u1110a1"}, {"name": "トラム", "text": "（黒き導きから引き剥がされて、\nようやくその姿が、微かに見え始めた。\nあれは……この世界の始まり。最初の神の楔）", "face": "u1110a1"}, {"name": "アラン", "text": "（創造神が、世界を生み出した力の欠片）", "face": "u1511a1"}, {"name": "白き導き", "text": "さぁ、英雄たる者の守護騎士、\n英雄たる者の従者よ。あなた方が何を願ったのか、\nその神器をもって証明してください。", "face": "lc88c5cbb5daf"}, {"name": "？？？", "text": "……ったく。騎士の戦いに、\n神の残りカスごときが口出ししてんじゃねぇよ。", "face": "l3f028f309742"}, {"name": "？？？", "text": "おいミレイユ、そっちのメイド！\n雑魚が神器を持とうが、雑魚のままだろうが。\nそうじゃねぇって言うなら、立ち向かってきやがれ。", "face": "l3f028f309742"}, {"name": "ミレイユ", "text": "えぇ、もとよりそのつもりです。\nそれに――今の私は、負ける気がしません。", "face": "u2626a1"}, {"name": "セーラ", "text": "ご主人様が、見ていてくれますから。だから、\nどんな願いだろうと貫き通せると、確信があります。", "face": "u2627a1"}, {"name": "ミレイユ", "text": "――私の願いは、王子の守護者であること。\n輝ける未来にたどり着き、それを永遠とする日まで、\n神槍をもって我が未来の王を守り続けること。", "face": "u2626a1"}, {"name": "セーラ", "text": "――私の願いは、ご主人様を支え続けること。\nいずれ世界を担うご主人様の前に立ちはだかる、\n全ての難事を片付けうる、メイドであること。", "face": "u2627a1"}, {"name": "ミレイユ", "text": "それでは、約束でしたね？\n名を名乗ってもらいましょうか。", "face": "u2626a1"}, {"name": "？？？", "text": "いいぜ。騎士は約束を違えないものだ。", "face": "l3f028f309742"}, {"name": "？？？", "text": "――よぉ、久しぶりだな。\nと言っても、お前に会ったのは、\n俺がもうすぐ死ぬって時だったが。", "face": "l73de0427a722"}, {"name": "ミレイユ", "text": "ッ！　あなたは……！", "face": "u2626a1"}, {"name": "？？？", "text": "英雄王が守護者のひとり。\n聖剣ガラティンを賜りし、太陽を担う者。", "face": "l73de0427a722"}, {"name": "ガルヴェイン", "text": "――騎士ガルヴェイン。\nここからは手抜きなしで行くぜ？", "face": "l73de0427a722"}]}, {"trigger": "end", "lines": [{"name": "ガルヴェイン", "text": "ちっ……なんだ、こいつら……！\nさっきまでとは別人じゃねぇか！", "face": "l73de0427a722"}, {"name": "ガルヴェイン", "text": "甘く見てたのはこっちだったな……。\nだが、ここからは――", "face": "l73de0427a722"}, {"name": "トラム", "text": "――こっちを向きなさい、ガルヴェイン。", "face": "u1110a1"}, {"name": "ガルヴェイン", "text": "は――？", "face": "l73de0427a722"}, {"name": "トラム", "text": "吠えろ――我が銀腕、リアファルッ！！", "face": "u1110a1"}, {"name": "ガルヴェイン", "text": "トラム、何を……。はっ！？\nなんで拳――痛ッ、ぐっ、ぐぉあぁああぁあああッ！？", "face": "l73de0427a722"}, {"name": "トレシア", "text": "と、飛んでいきました！\nあんな重装甲の騎士が一瞬で地平線の向こうに！？", "face": "u2314a1"}, {"name": "オークの戦士たち", "text": "あ、姉御ぉ……！？", "face": "l416422fb8140"}, {"name": "オークの副官", "text": "……撤退だ！\n姉御を拾いに行くッ！！", "face": "l56161b1c0d08"}, {"name": "オークの戦士たち", "text": "う、うおおおお？", "face": "l416422fb8140"}, {"name": "ソーマ", "text": "……せ、せーら、さん？", "face": "u2178a1"}, {"name": "セーラ", "text": "はい。", "face": "u2627a1"}, {"name": "アリシア", "text": "団長……。", "face": "u2558a1"}, {"name": "ミレイユ", "text": "はい、ここにいますよ。", "face": "u2626a1"}, {"name": "アイリーン", "text": "セーラ、身体は、何ともないのか？\nあれだけの攻撃にさらされて……。", "face": "u315"}, {"name": "セーラ", "text": "アイリーン、そんなに慌てふためくなんて、\nあなたらしくありませんよ。\nもっと黒幕らしくしていてください。", "face": "u2627a1"}, {"name": "アイリーン", "text": "む、むぅ……。", "face": "u315"}, {"name": "キリエ", "text": "おっと、感動のあまりハグするのは待ってくれ。\nまずはふたりの体調チェックだ。", "face": "u2355a1"}, {"name": "キリエ", "text": "一度死にかけたのに、\n魔力だか何かで無理やり再生したんだろう？\n急ぎ検査をするぞ！　医官と治癒術士は集合！", "face": "u2355a1"}, {"name": "ミレイユ", "text": "あ、あの、そんなに大変な事態では……。", "face": "u2626a1"}, {"name": "キリエ", "text": "患者は皆そう言うんだ！\nアイシャ、ふたりは下がらせるからな！", "face": "u2355a1"}, {"name": "アイシャ", "text": "うん、一度ここで休息を取ろう。\n負傷者の治療を最優先！\n体力に余裕のある人は手を貸して！", "face": "u181"}]}], "active": true}