{"quest_id": 8760, "name": "最初の神の楔", "description": "絶対的な死が王子たちに迫る……。\n＜魔力嵐(弱)：出撃時の初期HP減少(小)\n　爆風範囲、魔法ダメージが減少＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["魔力嵐(弱)：出撃時の初期HP減少(小)\n　爆風範囲、魔法ダメージが減少"], "event": "黒き導き、白き目覚め", "event_category": "History", "mission_id": 920240, "map_no": 7308, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 50, "params": [80]}, {"kind": "term", "influence": 22, "params": [80]}, {"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 172000, "attack": 2600, "base_hp": 172000, "base_attack": 2600, "damage_type": "magical", "armor_defense": 800, "magic_defense": 30, "attack_range": 220, "attack_speed": 1, "attack_wait": 55, "attack_interval": 157, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2165696, "race_id": 16, "missile_id": 1432, "missile": {"speed": 12.0}, "master_id": 39415, "global_id": 13032, "ranged": true, "commands": {"raw": "SetStageFlag(0, 1);", "sets_flags": [[0, 1]]}, "route_behaviour": {"sets_flags": [[1, 1, 0]]}}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 900000, "attack": 10, "base_hp": 900000, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2137216, "special_effect_id": 2261, "master_id": 39418, "global_id": 13035, "route_behaviour": {"reroutes": ["Route=200", "Route=201", "Route=202", "Route=203", "Route=204", "Route=205"]}}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wa