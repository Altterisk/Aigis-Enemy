 "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 600, "base_hp": 30000, "base_attack": 600, "damage_type": "magical", "armor_defense": 4000, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 120, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113008, "race_id": 6, "missile_id": 171, "missile": {"speed": 6.0, "splash": 267}, "master_id": 30755, "global_id": 4374, "ranged": true, "spawn_sec": 203}, {"enemy_id": 20, "source": "local", "count": 3, "form_count": 1, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107024, "race_id": 6, "master_id": 697, "global_id": 696, "spawn_sec": 237}, {"enemy_id": 21, "source": "local", "count": 4, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 21, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 252}, {"enemy_id": 23, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000000, "attack": 1, "base_hp": 1000000, "base_attack": 1, "damage_type": "magical", "armor_defense": 1500, "magic_defense": 50, "attack_speed": 1, "attack_wait": 10, "attack_interval": 120, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "pattern_id": 2148256, "race_id": 19, "special_effect_id": 1176, "master_id": 38040, "global_id": 11657, "route_behaviour": {"transforms": [{"wait": 180}]}, "spawn_sec": 282}, {"enemy_id": 24, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000000, "attack": 1, "base_hp": 1000000, "base_attack": 1, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 80, "attack_speed": 1, "attack_wait": 60, "attack_interval": 222, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "pattern_id": 2156912, "race_id": 19, "special_effect_id": 1176, "master_id": 38041, "global_id": 11658, "route_behaviour": {"transforms": [{"wait": -1}]}, "spawn_sec": 285}, {"enemy_id": 25, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000000, "attack": 1, "base_hp": 1000000, "base_attack": 1, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 80, "attack_speed": 20, "attack_wait": 110, "attack_interval": 301, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2157184, "race_id": 19, "special_effect_id": 1176, "change_to": 25, "master_id": 38042, "global_id": 11659, "route_behaviour": {"transforms": [{"wait": 500}]}, "spawn_sec": 290}], "popups": ["大神ディアスは\n拠点には向かわず、\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。", "ラッパを吹く天使がいる間は\n敵の天使の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ラムイエル", "text": "――ディアス様、ホルミースが離反しました。", "face": "lb985f043290b"}, {"name": "ディアス", "text": "離反……離反か。\nラムイエル、お前も冗談を言うようになったな。\nあれはもとより、余の臣下などではない。", "face": "l7b4853f3269d"}, {"name": "ラムイエル", "text": "いいえ、私に冗談を述べる機能はありません。\nディアス様、あなたがそう望まれましたから。", "face": "lb985f043290b"}, {"name": "ディアス", "text": "……そうだったな。", "face": "l7b4853f3269d"}, {"name": "ラムイエル", "text": "ディアス様、質問をお許しいただけますか。", "face": "lb985f043290b"}, {"name": "ディアス", "text": "好きにしろ。", "face": "l7b4853f3269d"}, {"name": "ラムイエル", "text": "なぜ、お眠りになる前、\n私に、彼らを集めるよう言付けたのですか？", "face": "lb985f043290b"}, {"name": "ラムイエル", "text": "自由を愛する亜神、戦場を求める者、\n理想を捨てきれぬ者、詩歌に命を捧げた者……。", "face": "lb985f043290b"}, {"name": "ラムイエル", "text": "彼らに、人類の未来に殉じる覚悟があったとは、\nどうしても思えません。", "face": "lb985f043290b"}, {"name": "ディアス", "text": "あの者らが、そう望んだからだ。\n英雄の敵として相対することをな。", "face": "l7b4853f3269d"}, {"name": "ラムイエル", "text": "……舞台を用意しただけ、だと？", "face": "lb985f043290b"}, {"name": "ディアス", "text": "神たる者は、他者に何かを委ねはしない。\n何かを願うこともない。\n真なる神とは、願いに応える者ゆえに。", "face": "l7b4853f3269d"}, {"name": "ラムイエル", "text": "では、私の思い過ごしだったようです。\nディアス様は、人が理想を追う姿に、\n人類の未来を見ておられたのだとばかり。", "face": "lb985f043290b"}, {"name": "ディアス", "text": "…………。\nやはり、お前は人間に似てきたようだ。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "しかしラムイエル、\n余に無断で神聖騎士団を使ったな。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "人類を学べと命じはしたが、\nあのような下郎、何の参考にもなるまい。", "face": "l7b4853f3269d"}, {"name": "ラムイエル", "text": "……いえ、欲望と理想とは、\n似て非なるものだと学びました。", "face": "lb985f043290b"}, {"name": "ディアス", "text": "学び……そうか、学びか。\nラムイエル、成長を望むのなら、お前も人類に付くか？", "face": "l7b4853f3269d"}, {"name": "ラムイエル", "text": "それこそ、ご冗談を。\nこの身は真に、\nディアス様にお仕えする唯一の天使なれば。", "face": "lb985f043290b"}, {"name": "ディアス", "text": "――ならば、まずは見るがよい。\nそして、己の道を定めよ。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "停滞せし安寧の世界か、\n希望の戦火が燃え盛る、正しき成長の世界か。\nお前がどちらの未来を望むのかを。", "face": "l7b4853f3269d"}]}, {"trigger": "start", "lines": [{"name": "アリア", "text": "――王子、要塞宮殿最奥の扉が開いています！\nこの先に……ディアスが……！", "face": "u2293a1"}, {"name": "ディアス", "text": "待ちわびたぞ、王子。", "face": "l7b4853f3269d"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ディアス", "text": "さぁ、続きを始めよう。\n前回はケラウノスに水を差されたが――", "face": "l7b4853f3269d"}, {"name": "王子", "text": "――ああ。\nここで、決着をつけよう。", "face": "u1"}]}, {"trigger": "battle", "at_sec": 285, "lines": [{"name": "ディアス", "text": "――王子よ。\n余はあの日、貴様に人類の輝きを見た。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "ただ、人の意志を束ねただけの力で、\nこの世界の法則を書き換えた、貴様の輝きに。", "face": "l7b4853f3269d"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ディアス", "text": "貴様は、世界を変えられると思うか。\n己に、それだけの力があると思うか。", "face": "l7b4853f3269d"}, {"name": "王子", "text": "……分からない。\nだが、諦めるつもりはない。", "face": "u1"}, {"name": "ディアス", "text": "正直者だな、貴様は。\n敵としておくには、本当に惜しい男だ。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "余は、貴様ならば世界を変えうると思っている。\nだがそのためには、人の器であり続けてはならぬ。", "face": "l7b4853f3269d"}, {"name": "ユリクセス", "text": "……人は、愚かだからな。\n王子が人のままであれば、\n悪意ある者にある種の勘違いを抱かせる。", "face": "u2193a1"}, {"name": "アイシャ", "text": "同じ人ならば、と。\n嫉妬と悪意の火種には、それだけで十分。", "face": "u181"}, {"name": "プリニース", "text": "現に、小さな火種から生じた戦乱は、\n幾度もこの世界を滅ぼしてきた。", "face": "u2173a1"}, {"name": "シビラ", "text": "それでも……。\n王子は、人のままでなければいけないわ。", "face": "u1981a1"}, {"name": "シビラ", "text": "神の庇護下にあり続ける世界では、\n今と何も、変わらないのだもの。", "face": "u1981a1"}, {"name": "ディアス", "text": "鳥籠の外が、素晴らしい世界だとは限らぬぞ。\n世界が真に破滅に向かった時、\nそれを止められる者が、いなくなるのだから。", "face": "l7b4853f3269d"}, {"name": "王子", "text": "……俺は、そうなった未来を、見た。", "face": "u1"}, {"name": "王子", "text": "人が何かを過てば、\nこの世界は、容易く終焉を迎える。", "face": "u1"}, {"name": "ディアス", "text": "……ならば、選べ、王子よ。", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "貴様の選択肢は、ふたつしかない。\n余の手を取り、創造神を継承するか――", "face": "l7b4853f3269d"}, {"name": "ディアス", "text": "ここで、その旅路を終えるかだ。", "face": "l7b4853f3269d"}, {"name": "王子", "text": "――大神ディアス。\nお前は、そのどちらも望んでいないだろう？", "face": "u1"}, {"name": "ディアス", "text": "ククッ……ハハハハッ！\nならば超えてみせよ！　人の器のまま、神の力を！", "face": "l7b4853f3269d"}]}, {"trigger": "battle", "at_sec": 289, "lines": [{"name": "ディアス", "text": "これこそが、貴様らの愛する三女神の力の原型である！", "face": "l7b4853f3269d"}, {"name": "フローガ", "text": "……ッ！？　三神器が出現！\n魔力の乱れが存在しない……いえ、感知できません！\n人が知りうる範囲を超えています！！", "face": "u878"}, {"name": "トラム", "text": "まずい……全員、何かに隠れて！\n神器の加護がなければ、この力には――", "face": "u1110a1"}, {"name": "ケラウノス", "text": "――いいえ。\nその必要はありません、愚かなる人の子らよ。", "face": "l4e9b178011e4"}]}], "active": true}