{"quest_id": 8405, "name": "大神ディアス", "description": "人の意志と誓いをもって神と引き分けた日。\n時は流れ、王子は再びディアスと相対する。\n今こそ、世界の未来を決する時。\n上級（★１獲得の目安：平均Lv10）", "event": "星降る黎明", "event_category": "History", "mission_id": 920222, "map_no": 4997, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 4, "hp": 230000, "attack": 2000, "base_hp": 230000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 1500, "magic_defense": 50, "attack_range": 300, "attack_speed": 1, "attack_wait": 80, "attack_interval": 259, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "pattern_id": 2148256, "race_id": 19, "special_effect_id": 1902, "change_to": 1, "missile_id": 957, "missile": {"speed": 15.0}, "master_id": 38058, "global_id": 11675, "ranged": true, "to_global_id": 11676, "to_flag": [4, 1], "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\"); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag(0, 1);\");", "sets_flags": [[0, 1]], "on_destroy": true}, "route_behaviour": {"transforms": [{"flag": 4, "val": 1}, {"flag": 5, "val": 1}, {"flag": 6, "val": 1}, {"flag": 7, "val": 1}, {}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルスII", "ブロック不可"], "hp": 230000, "base_hp": 230000, "damage_type": "magical", "armor_defense": 1500, "magic_defense": 50, "attack_speed": 1, "move_speed": 1.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "pattern_id": 2148272, "race_id": 19, "special_effect_id": 242, "change_to": 2, "master_id": 38059, "global_id": 11676, "to_global_id": 11677, "from_flag": [4, 1], "to_flag": [5, 1]}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["ブロック不可"], "hp": 230000, "attack": 500, "base_hp": 230000, "base_attack": 500, "damage_type": "magical", "armor_defense": 1500, "magic_defense": 50, "attack_range": 3000, "attack_speed": 1, "attack_wait": 10, "attack_interval": 189, "move_sp