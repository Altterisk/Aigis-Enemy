"attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 172}], "popups": ["東天君はダメージを受けると\n攻撃したユニットへ反撃を行います。\nまたHPが一定以下になると、\n攻撃力と反撃のダメージがアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "紅牡丹", "text": "観客も盛り上がってるし、\n役者もしっかり役に入り込んでる。\nこいつぁ最高の舞台になるに違いないね！", "face": "u661"}, {"name": "紅牡丹", "text": "さぁて、お次は酒呑童子が大暴れする場面……って、\nおいおい、なんか様子がおかしいぞ？\nふらふらしてやがるし、怪我してるような……。", "face": "u661"}]}, {"trigger": "start", "lines": [{"name": "東天君", "text": "弱い……弱すぎる……。\n酒呑童子が現れたと聞いて来てみたが、\n名を騙るだけの偽物だったか……。", "face": "l2e272421b258"}, {"name": "東天君", "text": "逃げ足だけは一人前だったが、\nもはや逃げ場はあるまい。ここで終わりだ。", "face": "l2e272421b258"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "紅牡丹", "text": "お、おいおいおい！　てめぇ何者だ！　", "face": "u661"}, {"name": "アンナ", "text": "あれは……東天君！\n華の国の邪仙、十天君の一人です……！！", "face": "l773934036516"}, {"name": "紅牡丹", "text": "ヤ、ヤバイ奴なのか……！？\n畜生、どうしてそんな奴が舞台を邪魔しやがるんだ。", "face": "u661"}, {"name": "紅牡丹", "text": "いや、今はそんなことを言ってる場合じゃねぇか……。\n悔しいが、舞台が失敗でも構わねぇ！\n早く観客の皆を逃さないと……！", "face": "u661"}, {"name": "アンナ", "text": "……王子、提案があります。", "face": "l773934036516"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "紅牡丹", "text": "……ん？　いったい何の用……って、何ィ！？\n芝居のフリをして、あいつを倒すだってぇ！？", "face": "u661"}, {"name": "紅牡丹", "text": "そりゃ確かに、出来るならスゴイことだが……。\nあんた達に、それが可能なのかい……？", "face": "u661"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "紅牡丹", "text": "…………わかったよ。\nその目を見りゃ嘘じゃないって分かる。", "face": "u661"}, {"name": "紅牡丹", "text": "それならいっちょ、やってやろうじゃないか！\n一世一代の大舞台、精一杯傾いてみせな！", "face": "u661"}, {"name": "東天君", "text": "この気配……ほう、久しいな王子。", "face": "l2e272421b258"}, {"name": "東天君", "text": "酒呑童子が相手ならば、\n新たに配下とした妖怪共の実力を試すのに\n良い機会と思ったのだが、偽物ではな。", "face": "l2e272421b258"}, {"name": "東天君", "text": "だが、王子が相手であれば、\n実地試験の相手に不足はないだろう。", "face": "l2e272421b258"}, {"name": "アンナ", "text": "王子、東天君が来ます。\n指揮をお願いします……！！", "face": "l773934036516"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "東天君！\nいったい何を企んでいるのですか……！", "face": "l773934036516"}, {"name": "東天君", "text": "語ってやる義理はない。\nしかし妖怪共を退けるとは、\n手を抜いてもいられないか……。", "face": "l2e272421b258"}, {"name": "東天君", "text": "ならば、次は妖怪と邪仙、\nふたつの勢力の精鋭共をぶつけてやろう。", "face": "l2e272421b258"}]}], "active": true}