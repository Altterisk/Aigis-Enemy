{"quest_id": 6538, "name": "波乱の都舞台", "description": "都での公演に挑む王子一座。\n盛り上がりを見せる舞台に、\n突如東天君が姿を現す。\n極級（★１獲得の目安：平均Lv25）", "event": "東方のかぶき姫", "event_category": "History", "mission_id": 920113, "map_no": 5371, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 25000, "attack": 400, "base_hp": 25000, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 60, "attack_wait": 97, "attack_interval": 305, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110448, "race_id": 4, "special_effect_id": 170, "change_to": 1, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 31218, "global_id": 4837, "to_global_id": 3942, "route_behaviour": {"transforms": [{"wait": 300}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 25000, "attack": 400, "base_hp": 25000, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_range": 220, "attack_speed": 60, "attack_wait": 97, "attack_interval": 245, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110448, "race_id": 4, "special_effect_id": 170, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 30323, "global_id": 3942, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 18, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112816, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30725, "global_id": 4344, "ranged": true, "spaw