e": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 29}, {"enemy_id": 9, "source": "local", "count": 9, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 52}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 450, "base_hp": 12000, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 4, "attack_interval": 63, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110384, "race_id": 16, "special_effect_id": 222, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 30293, "global_id": 3912, "ranged": true, "spawn_sec": 76}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100960, "race_id": 16, "special_effect_id": 222, "missile_id": 171, "missile": {"speed": 6.0, "splash": 267}, "master_id": 889, "global_id": 888, "ranged": true, "spawn_sec": 94}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 30, "attack_wait": 50, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101456, "race_id": 16, "missile_id": 6, "master_id": 304, "global_id": 303, "ranged": true, "spawn_sec": 95}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 30, "magic_defense": 25, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107792, "race_id": 16, "special_effect_id": 222, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 887, "global_id": 886, "ranged": true, "spawn_sec": 126}], "dialogue": [{"trigger": "start", "lines": [{"name": "リュリュ", "text": "えっと……、\n皆さん、お集まりいただいてありがとうございます。", "face": "u203"}, {"name": "パレス", "text": "気にしないで、ちょうど退屈してたところだし。\nそれで、私たちに相談っていうのは？", "face": "u129"}, {"name": "リノ", "text": "はいはーい、リノが説明するよ。\n実はリノたち、王子にバレンタインデーの\nチョコをプレゼントしようと思ってるの。", "face": "u350"}, {"name": "メメント", "text": "バレンタインデーのチョコ？\n……ああ、好きな人に贈るっていうやつだね。", "face": "u195"}, {"name": "リュリュ", "text": "は、はい……。\nでも私たち、手作りってよくわからなくて……。\nそれで、そういうのが得意そうな人たちに聞こうと……。", "face": "u203"}, {"name": "ガラニア", "text": "ええと……ご相談いただけて光栄ですが、\n私は魔力の研究以外のことは、あまり……。", "face": "u1079"}, {"name": "ベルディナート", "text": "私も、この身に宿る魔の力と\n幼馴染の他には何にも興味はないわ。", "face": "u266"}, {"name": "エステル", "text": "……え、ええと……、\nたとえば王子が好きなものの形をした\nチョコを作って贈るのはどうでしょうか？", "face": "u1245"}, {"name": "トワ", "text": "王子が好きなもの……はっ！\nか、可愛いものですね！", "face": "u1336"}, {"name": "ヴェルティ", "text": "（可愛いもの、か……。\n悪魔……いや、猫ね。猫以外にあり得ないわ）", "face": "u477"}, {"name": "アンナ", "text": "……皆さん、こんなところで何のご相談ですか？"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "リュリュ", "text": "――ふぇっ！？　お、王子様！\nあ、あのっ……それは、そのぅ……、\nちょ、ちょこっと王子様と手合わせしたいな……なんて。", "face": "u203"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "リュリュ", "text": "……え？　いまから手合わせしてくださるんですか？\n（ど、どうしましょう、リノさん……？）", "face": "u203"}, {"name": "リノ", "text": "（と、とにかく怪しまれないように全力で戦おう！\n当日までチョコのことは王子には内緒にしなくちゃ！）", "face": "u350"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "……そこまで。\n王子、皆さん、お疲れ様でした。"}, {"name": "リノ", "text": "（は、早く王子たちに帰ってもらって\nさっきの相談の続きをしなくちゃ……）", "face": "u350"}, {"name": "リノ", "text": "……あ、大変！　王子、服が汚れちゃってるよ！\n早くお風呂に入って着替えた方がいいよ！　ね？", "face": "u350"}, {"name": "アンナ", "text": "確かにそうですね。\nそろそろ帰りましょうか、王子。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "リュリュ", "text": "……あ、危ないところでした……。\n皆さん、ご協力ありがとうございます。", "face": "u203"}, {"name": "ヴェルティ", "text": "……別に大したことじゃないわ。\nそれにしても、どんだけ戦いが好きなのよ、あの男は。", "face": "u477"}, {"name": "パレス", "text": "……ええと、話を戻すわね。\nバレンタインデーに王子に贈るチョコを\n王子が好きなものの形にしようって話だったかしら。", "face": "u129"}, {"name": "ベルディナート", "text": "そして、王子は戦いが好き……と。", "face": "u266"}, {"name": "メメント", "text": "あ、ボクいいこと思いついちゃった♪\nみんな聞いて。あのね…………（ヒソヒソ）。", "face": "u195"}, {"name": "トワ", "text": "（………………え？\nそれはちょっと……チョコにするなら\nもっと可愛いもののほうがいいのでは？）", "face": "u1336"}, {"name": "エステル", "text": "（ですが、それが本当に王子のお好きなものなら……）", "face": "u1245"}, {"name": "リュリュ", "text": "……な、なんだか雲行きが怪しくなってきました。\nリノさん、どうしましょう？", "face": "u203"}, {"name": "リノ", "text": "……うん。リノたちはリノたちで、\n王子が喜んでくれそうなチョコを\nちゃんと用意しておこうね。", "face": "u350"}]}], "active": true}