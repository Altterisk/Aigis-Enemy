_id": 112, "master_id": 30039, "global_id": 3658}], "spawn_sec": 77}, {"enemy_id": 8, "source": "local", "count": 8, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 83}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 95}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 10, "attack_interval": 76, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100224, "race_id": 3, "change_to": 10, "change_condition": 4, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 233, "global_id": 232, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 231, "spawn_sec": 105}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 2, "hp": 9000, "attack": 900, "base_hp": 9000, "base_attack": 900, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108496, "race_id": 16, "special_effect_id": 116, "master_id": 30034, "global_id": 3653, "to_global_id": 3654, "route_behaviour": {"transforms": [{"wait": 2060}]}, "spawn_sec": 157}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108512, "race_id": 16, "special_effect_id": 116, "change_to": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 30035, "global_id": 3654, "ranged": true}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108544, "race_id": 16, "special_effect_id": 54, "master_id": 30038, "global_id": 3657, "spawn_sec": 164}], "dialogue": [{"trigger": "start", "lines": [{"name": "売人セブン", "text": "あぁ、どうしよう……なーんか、ドキドキしてきた。\n落ち着けぇ……この取引が成功すれば、\nこの商売から足を洗える額が手に入るんだ……。", "face": "l0dd435fdd151"}, {"name": "売人セブン", "text": "っと、そろそろ客が来る時間だな……。", "face": "l0dd435fdd151"}, {"name": "デーモン剣士", "text": "――待たせたな、人間よ。\nそれではさっそく商談といこう。\nして、強力な武器というのはどれだ？", "face": "l133017f80678"}, {"name": "売人セブン", "text": "へへ、単刀直入で話の分かりそうなヤツだぜ。\n見て驚くなよ、これが魔界マーケットでも\n一瞬で完売したアノ「呪いの武器」だ！", "face": "l0dd435fdd151"}, {"name": "売人セブン", "text": "これは、アンタにぴったりの貴重な大剣タイプだ。\n本当なら、100,000,000ゴールドの価値はあるけど、\n今回は特別に50,000,000ゴールドでいいぜ。", "face": "l0dd435fdd151"}, {"name": "デーモン剣士", "text": "ほう、それが本物であればこれ以上ない武器だ。\n……だが、随分と高いな。\n確証を得たい。この武器の性能を証明しろ。", "face": "l133017f80678"}, {"name": "売人セブン", "text": "……は、はぁ？　証明って、どうしろって言うんだよ？", "face": "l0dd435fdd151"}, {"name": "デーモン剣士", "text": "簡単なことだ。貴様がその武器を使い、\n人間を斬ればいいだけのことだ。", "face": "l133017f80678"}, {"name": "売人セブン", "text": "――なッ！？　ふざけるのも大概にしろってんだ！\n武器は売っても殺しは――", "face": "l0dd435fdd151"}, {"name": "エイミー", "text": "――ついに見つけましたよ、売人さん！\n持っている「呪いの武器」を全て渡しなさい！", "face": "u414"}, {"name": "デーモン剣士", "text": "ほう、都合良く人間の集団が来たじゃないか。\nさっそく我の前で斬り殺してみせろ。ふふふ。", "face": "l133017f80678"}, {"name": "売人セブン", "text": "く、くっそぉぉぉぉ……。\nこの取引は絶対に成功させるんだ……。\n絶対に……！", "face": "l0dd435fdd151"}]}, {"trigger": "battle", "at_sec": 75, "lines": [{"name": "デーモン剣士", "text": "ふん……「呪いの武器」とはこんなものか。\n大して強そうには見えんな。\nどうせゴミならば、タダで引き取ってやろう。", "face": "l133017f80678"}, {"name": "売人セブン", "text": "……なんだと！？\nて、てめぇ……ハナっからそのつもりで……！？", "face": "l0dd435fdd151"}, {"name": "デーモン剣士", "text": "さぁ、早く寄越せ。\nどうせ何の値打もない武器だ。\nそれとも……ここで屍になるか？　人間よ……ククク。", "face": "l133017f80678"}, {"name": "売人セブン", "text": "ふ、ふざけんな！\n――っな、なにするんだよ！\nくっそぉぉぉぉぉぉ……！", "face": "l0dd435fdd151"}, {"name": "エイミー", "text": "た、大変です王子……！\n「呪いの武器」がデーモンの手に……！\n取り返さないと……！", "face": "u414"}]}, {"trigger": "end", "lines": [{"name": "エイミー", "text": "すごい……「呪いの武器」を持った\nデーモンを倒すなんて。\nやっぱり王子はスゴイ人だったんですね！", "face": "u414"}, {"name": "エイミー", "text": "おかげで、\n武器も回収できたし、売人さんも捕まえられました！", "face": "u414"}, {"name": "売人セブン", "text": "はぁ……そんなキツく縛らないでくれよ。\n痕になったらどうするんだよぉ……責任とれんのかよー！", "face": "l0dd435fdd151"}, {"name": "エイミー", "text": "売人さん、いくらお金の為とはいえ、\n魔物にあんな危険な武器を売るなんて、\n絶対にしちゃいけない事なんですよ！？", "face": "u414"}, {"name": "売人セブン", "text": "……はッ。なに甘いこといってんだよ。\n覚えとけ！　金は命よりもずーっと重たいんだ！", "face": "l0dd435fdd151"}, {"name": "エイミー", "text": "――きゃっ！？\nそ、そんな……縄で縛り上げたのに、\nどうやって抜け出したのですか……！？", "face": "u414"}, {"name": "売人セブン", "text": "これくらい裏稼業の人間なら出来てとーぜんだっての！\nあばよ！", "face": "l0dd435fdd151"}, {"name": "ケイティ", "text": "逃げられてしまいましたね……。", "face": "u114"}, {"name": "エイミー", "text": "私が油断したばっかりに、ごめんなさい……。\nですが、当初の目的である武器回収はしっかりと\n果たせた訳ですし、めでたしめでたしです！", "face": "u414"}, {"name": "エイミー", "text": "というわけで王子！　お世話になったお礼に、\nこれからは、もっと安く色んな商品を提供しますので、\n今後も末永くごひいきにしてください！", "face": "u414"}]}], "active": true}