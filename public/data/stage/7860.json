{"quest_id": 7860, "name": "第五陣 白の帝国皇帝", "description": "亜神ラビリスが帝国軍に牙を剝く！！\n＜冥界：HPに継続ダメージ＞\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["冥界：HPに継続ダメージ", "広域戦闘：敵味方の射程減少"], "event": "帝国五陣", "event_category": "Empire", "mission_id": 940003, "map_no": 4692, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_speed": 30, "attack_wait": 10, "attack_interval": 87, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2138560, "race_id": 13, "change_to": 1, "change_condition": 2, "master_id": 35092, "global_id": 8709, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2, "spawned_on_death_by": [1, 18]}, {"enemy_id": 3, "source": "local", "count": 17, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127760, "race_id": 21, "change_to": 3, "change_condition": 4, "master_id": 33