cal", "count": 4, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 35000, "attack": 1000, "base_hp": 35000, "base_attack": 1000, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111888, "race_id": 12, "special_effect_id": 233, "master_id": 30630, "global_id": 4249, "spawn_sec": 72}, {"enemy_id": 18, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "tags": ["アンデッド"], "hp": 3500, "base_hp": 3500, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_interval": 50, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142464, "special_effect_id": 1179, "change_to": 1, "change_condition": 2, "master_id": 35805, "global_id": 9422, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 90}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 45000, "attack": 1800, "base_hp": 45000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2128592, "race_id": 12, "master_id": 33700, "global_id": 7317, "spawn_sec": 102}, {"enemy_id": 20, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "hp": 18000, "attack": 600, "base_hp": 18000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_interval": 34, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142480, "race_id": 19, "special_effect_id": 1238, "change_to": 20, "change_condition": 3, "master_id": 35806, "global_id": 9423, "to_condition": 3, "to_global_id": 9424, "spawn_sec": 143}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1000, "base_hp": 18000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 234, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142496, "race_id": 19, "special_effect_id": 86, "master_id": 35807, "global_id": 9424, "from_condition": 3}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 150000, "attack": 1500, "base_hp": 150000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 1, "attack_interval": 34, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2142432, "race_id": 19, "special_effect_id": 1235, "change_to": 22, "change_condition": 3, "master_id": 35803, "global_id": 9420, "to_condition": 3, "to_global_id": 9421, "spawn_sec": 155}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 150000, "attack": 4000, "base_hp": 150000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 1, "attack_wait": 90, "attack_interval": 234, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2142448, "race_id": 19, "special_effect_id": 1236, "master_id": 35804, "global_id": 9421, "from_condition": 3}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 60000, "attack": 1500, "base_hp": 60000, "base_attack": 1500, "damage_type": "true", "armor_defense": 1200, "magic_defense": 10, "attack_range": 190, "attack_speed": 1, "attack_wait": 30, "attack_interval": 117, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2142416, "race_id": 16, "special_effect_id": 216, "missile_id": 826, "missile": {"speed": 10.0}, "master_id": 35802, "global_id": 9419, "ranged": true, "spawn_sec": 191}], "dialogue": [{"trigger": "start", "lines": [{"name": "ラビリス", "text": "全員まとめて冥界送り、\n死後は仲良くオレと喧嘩と行こうぜ？", "face": "ld7c2bb5afc1d"}, {"name": "ハイデマリー", "text": "はぁ……はぁ……お断りね……。\nあなたみたいな粗暴な亜神とか、\n石頭で強情な魂の管理者さんより――", "face": "u1704a1"}, {"name": "ハイデマリー", "text": "そっちの、今も迷い続けている\n冥界の騎士さまのほうが、\nよっぽど気が合いそうだしね。", "face": "u1704a1"}, {"name": "ティルト", "text": "……私が、迷っている？\n馬鹿な……そんなこと……。", "face": "u1705a1"}, {"name": "ハイデマリー", "text": "顔に書いてあるじゃない。\nヘカティエ様大好き、置いていかないでってさ。", "face": "u1704a1"}, {"name": "ティルト", "text": "なっ……そんなことは……！\n私はただ――", "face": "u1705a1"}, {"name": "ハイデマリー", "text": "ただ、の続きは？", "face": "u1704a1"}, {"name": "ティルト", "text": "…………。\n置いていかれたく、なかった……。\n私が一番、ヘカティエ様のお力になれるはずなのに。", "face": "u1705a1"}, {"name": "ヘカティエ", "text": "……あなたたち、近衛を連れて行かなかったのは、\nこんなことに巻き込みたくなかったからよ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "私が紡いだ創造物たるあなたたちを、\n見捨てるわけ、ないじゃない。", "face": "u1226a1"}, {"name": "ラビリス", "text": "――けっ、これだから気に入らねぇんだ。\n思いやりと慈しみなんかで、\n無数に増え続ける死者を捌ききれるのかよ。", "face": "ld7c2bb5afc1d"}, {"name": "ヘカティエ", "text": "捌くんじゃないの。\n思いやって、慈しむのよ。", "face": "u1226a1"}, {"name": "ラビリス", "text": "……やれやれ。\nやっぱり、てめぇとは話が合わねぇな。", "face": "ld7c2bb5afc1d"}, {"name": "ラビリス", "text": "さぁ、そろそろ決着と行こうか。\n全員逃さねぇ、ひとり残らずオレが殺してやるよ！", "face": "ld7c2bb5afc1d"}]}, {"trigger": "battle", "at_sec": 188, "lines": [{"name": "ヘカティエ", "text": "――大気が、震えている？", "face": "u1226a1"}, {"name": "ラビリス", "text": "おいおい、なんだァこの気配は。\n死者のくせに、オレの領地で何してやがる！", "face": "ld7c2bb5afc1d"}, {"name": "ヘカティエ", "text": "ハイドース様の反魂の術……？\nいえ、そんな魔力は感じなかった。\nそれなのに、これは、この魂の圧力は――", "face": "u1226a1"}, {"name": "フローガ", "text": "――殿下、下がってください！\n何かが出現しようとしています！！", "face": "u878"}]}, {"trigger": "end", "lines": [{"name": "王子", "text": "…………！？", "face": "u1"}, {"name": "？？？", "text": "…………嘆かわしい。", "face": "lf035f042ddb3"}, {"name": "？？？", "text": "これが我が覇道の行き着く先、\n我が血を継ぐ帝国軍の、当代の姿だというのか。", "face": "lf035f042ddb3"}, {"name": "ハイデマリー", "text": "あ、れは……。\nまさか……うそ、そんなことって……。", "face": "u1704a1"}, {"name": "白の皇帝", "text": "――三代目、白の帝国皇帝。\n帝国領土を盤石のものとした、\n血と骸による勝利の上に立つ真なる皇帝、か。", "face": "u418"}, {"name": "レオナ", "text": "……骸帝。\nあの鎧、あの武具、まさに肖像画で見たお姿だ。", "face": "u311"}, {"name": "マレブランケ", "text": "子孫のために、助太刀しにきてくれた、\n……って雰囲気じゃなさそうだね。", "face": "u1225a1"}, {"name": "骸帝", "text": "それは、お前たちの実力次第だ。\n亜神ラビリスよ、まさか皇帝同士の戦いに、\n水を差すような真似はすまい？", "face": "lf035f042ddb3"}, {"name": "ラビリス", "text": "……ちっ。好きにしやがれ。\nだが、オレも好きにさせてもらうぞ。", "face": "ld7c2bb5afc1d"}, {"name": "骸帝", "text": "来るが良い、今代の帝国軍よ。\n戦乱の世にて磨かれし我が剣、\nその錆となりたい者から前に出よ。", "face": "lf035f042ddb3"}]}, {"trigger": "end", "lines": [{"name": "メフィスト", "text": "……で、どうするんだい。\nこれはまずいよ。\nあの姿を見た者は少ないが、兵に動揺が広がっている。", "face": "u526"}, {"name": "ディアナ", "text": "三代目、骸帝と言えば血なまぐさい逸話と共に、\n版図を拡大した帝国の英雄でもあります。\n……特に、帝国の貴族家からすれば。", "face": "u624"}, {"name": "アンジェリーネ", "text": "血統の正統性で言うのなら、\n陛下よりも、よほど帝国に相応しい存在ですものね。", "face": "u430"}, {"name": "レオナ", "text": "アンジェリーネ様、不用意なお言葉は……！", "face": "u311"}, {"name": "アンジェリーネ", "text": "事実ですわ。\nここにいる幹部は全員、それを受け止めなさい。", "face": "u430"}, {"name": "アンジェリーネ", "text": "ですが、こちらには私がいます。\n旗印の使い方くらい、心得ていますわね？", "face": "u430"}, {"name": "レオナ", "text": "あなたという人は……。\n――全軍、心して聞け！\n伝令はすべての前線へ伝えよ！", "face": "u311"}, {"name": "レオナ", "text": "これより帝国軍は物質界へ撤退する！\nこれは、陛下と、アンジェリーネ様の命令である！", "face": "u311"}, {"name": "マレブランケ", "text": "脱出経路は？\n冥界の門までの間にも、\n敵軍は兵を配置しているはずだろう。", "face": "u1225a1"}, {"name": "アンジェリーネ", "text": "その心配はいりませんわ。\n何のために、掘削部隊を連れてきたと？", "face": "u430"}, {"name": "アンジェリーネ", "text": "冥界の門とは言えど、\n門の形を取っているわけではなく、\n一種の座標のようなものに過ぎないのであれば――", "face": "u430"}, {"name": "ヘーレ", "text": "おっ待たせしましたー！\n帝国軍掘削部隊、冥界にトンネルぶち抜いてきました！", "face": "u1708a1"}, {"name": "アンジェリーネ", "text": "――地下からでも、\n物質界に戻れるのではなくて？", "face": "u430"}, {"name": "ラビリス", "text": "あぁ？　てめぇら、逃げるつもりか！？", "face": "ld7c2bb5afc1d"}, {"name": "ハイデマリー", "text": "当然！\n砲兵、全弾ぶち込めェ！！\n地下まで追手を出されたら終わりだからね！！", "face": "u1704a1"}, {"name": "ラビリス", "text": "くそっ、砲弾が痛ェ！\nオレの領地に何しやがる！？", "face": "ld7c2bb5afc1d"}, {"name": "ハイデマリー", "text": "それからティルト！　早くこっちへ！\n――ヘカティエ様のところに、戻りたいんでしょ？", "face": "u1704a1"}, {"name": "ティルト", "text": "……………あぁ。\nありがとう、砲を担う美しき騎士よ。", "face": "u1705a1"}, {"name": "ハイデマリー", "text": "……照れるなぁ、それ。\nさぁ、走るよ！　物質界に帰ろう！", "face": "u1704a1"}, {"name": "白の皇帝", "text": "…………骸帝。\n白の帝国は、もはや貴様のものではない。\n帝国の民が担うものだ。", "face": "u418"}, {"name": "骸帝", "text": "否、国家とは皇帝の所有物である。\n――違うというのならば、\n次に相まみえる時、その実力で示すが良い。", "face": "lf035f042ddb3"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}, {"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 2000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 1, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 3, "form_index": 0, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 3, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 7, "form_index": 0, "hp": 30000, "attack": 1100, "damage_type": "physical", "pattern_id": 2103568}, {"enemy_id": 8, "form_index": 0, "hp": 20000, "attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128624}, {"enemy_id": 8, "form_index": 1, "hp": 20000, "attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128640}, {"enemy_id": 12, "form_index": 0, "hp": 2500, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 12, "form_index": 1, "hp": 2500, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 16, "form_index": 0, "hp": 70000, "attack": 2500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2108064}, {"enemy_id": 17, "form_index": 0, "hp": 35000, "attack": 1000, "damage_type": "physical", "pattern_id": 2111888}, {"enemy_id": 18, "form_index": 0, "hp": 3500, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2142464}, {"enemy_id": 19, "form_index": 0, "hp": 45000, "attack": 1800, "damage_type": "physical", "armor_defense": 1200, "pattern_id": 2128592}, {"enemy_id": 20, "form_index": 0, "hp": 18000, "attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2142480}, {"enemy_id": 20, "form_index": 1, "hp": 18000, "attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2142496}, {"enemy_id": 22, "form_index": 0, "hp": 150000, "attack": 1500, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "pattern_id": 2142432}, {"enemy_id": 22, "form_index": 1, "hp": 150000, "attack": 4000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "pattern_id": 2142448}, {"enemy_id": 24, "form_index": 0, "hp": 60000, "attack": 1500, "damage_type": "true", "armor_defense": 1200, "magic_defense": 10, "pattern_id": 2142416}]}, "active": true}