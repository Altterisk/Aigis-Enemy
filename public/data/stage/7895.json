300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121616, "race_id": 16, "change_to": 1, "change_condition": 2, "master_id": 32321, "global_id": 5940, "to_condition": 2, "to_global_id": 403, "spawn_sec": 14}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102528, "race_id": 16, "change_to": 1, "change_condition": 2, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 257, "global_id": 256, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 49}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――大量の、ピンク髪の少女、ですか？"}, {"name": "ソーマ", "text": "はい……目撃情報によれば、\nすごい人数の、ピンク髪の女の子が現れたと……。", "face": "u23"}, {"name": "アンナ", "text": "何にせよ、この辺りには魔物が出ますし、\nその少女……たち？　を保護しにいきましょう。", "face": "lfe3fe8d5cb21"}, {"name": "フィリス", "text": "……ん、いや、待ってくれ。\nこの先にいるの、そのピンク髪の子たちじゃないか？", "face": "u40"}]}, {"trigger": "start", "lines": [{"name": "ソーマ", "text": "あっ、本当ですね。\nでもなんだか、様子がおかしいような……？", "face": "u23"}, {"name": "シーラ", "text": "――シィルさん、正気に戻ってください！\nというか、いつの間にそんなに数が増えたのですか！？", "face": "u1758a1"}, {"name": "ドッペルゲンガー", "text": "ククク……まんまと騙されたな……。\nやはりこの姿は、お前の仲間のものだったか。", "face": "u581"}, {"name": "ドッペルゲンガー", "text": "これも我ら、ドッペルゲンガー隆盛のための必要な犠牲。\n大人しく我らの餌食になるがいい！", "face": "u581"}, {"name": "アンナ", "text": "王子、どうやらピンク髪の少女は\nドッペルゲンガーが化けたもののようです！\n急いであの方を助けに行きましょう！", "face": "lfe3fe8d5cb21"}]}, {"trigger": "end", "lines": [{"name": "シーラ", "text": "助けていただき、ありがとうございました。\nまさかシィルさんに化けるモンスターがいるとは。", "face": "u1758a1"}, {"name": "アンナ", "text": "ドッペルゲンガーは人に化け、\n騙し討ちを仕掛けてきますから。\n本当にご無事で何よりでした。", "face": "la91db6d5e5fa"}, {"name": "シーラ", "text": "はっ……つかぬことをお尋ねするのですが、\nこのあたりで、異世界……？\nから迷い込んだ方を知りませんか？", "face": "u1758a1"}, {"name": "シーラ", "text": "どうやら私たちは、魔神セーレという者によって、\nこの世界に呼び出されてしまったようなのです。", "face": "u1758a1"}, {"name": "シーラ", "text": "突然、こんな話をすると\n驚かれてしまうかもしれませんが……。", "face": "u1758a1"}, {"name": "ケイティ", "text": "……魔神、ですか。", "face": "u114"}, {"name": "ケイティ", "text": "驚きはしましたが、あなたの言葉を信じます。\n魔神にはこれまで、何度も苦戦させられてきましたから。", "face": "u114"}, {"name": "アンナ", "text": "しかし、異世界からの召喚を可能とする魔神とは、\nこれは厄介なことになりそうですね……。", "face": "la91db6d5e5fa"}, {"name": "アンナ", "text": "ともあれ、一度拠点に戻りましょうか。\n捜索をするにも、人手は多いほうが良いですから。", "face": "lfe3fe8d5cb21"}]}], "active": true}