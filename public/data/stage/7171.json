"count": 4, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 17}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 21}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 100}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 101}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 161}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 174}], "dialogue": [{"trigger": "start", "lines": [{"name": "メカゴブリンクイーン", "text": "――オ～ホッホ！\nまさか人間と模擬戦をする日が来るとはねぇ！", "face": "l54a5fa2e0e9d"}, {"name": "ゴブリン博士", "text": "シカシ、理にかなってオリマス。\n王国は局地的な戦闘経験は豊富デスガ、\n軍団同士の戦闘経験に乏しイ。", "face": "la365b5504d77"}, {"name": "ゴブリン博士", "text": "我々ゴブリン軍団コソ、\n今後の天界との戦いの予行演習にぴったりデショウ。", "face": "la365b5504d77"}, {"name": "ケイティ", "text": "……そこまで見抜いているとは。\nその分析力と技術力、\n王国に貸すつもりはありませんか？", "face": "u114"}, {"name": "ゴブリン博士", "text": "笑止！　ワタクシは\nメカゴブリンクイーン様に忠誠を誓っているのでアル！", "face": "la365b5504d77"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、昔は泣き言ばかり言っていたのに、\n随分と頼もしくなったものねぇ。", "face": "l54a5fa2e0e9d"}, {"name": "ゴブリン博士", "text": "ハッ、アリガタキお言葉……ッ！！", "face": "la365b5504d77"}, {"name": "ケイティ", "text": "仕方ありませんね……。\nそれでは王子、そろそろ模擬戦開始です。\n双方、準備をお願いします！", "face": "u114"}]}, {"trigger": "battle", "at_sec": 12, "lines": [{"name": "グリム", "text": "あーあ、また異界召喚術を禁止されました。\nつまんないです。つまんなーい。", "face": "u942"}, {"name": "グリム", "text": "……あっ、そういえば人気闘兵の時の箱って、\n並行世界とも繋がってるって言ってましたよね。", "face": "u942"}, {"name": "グリム", "text": "異界じゃなくて、同じ世界なら召喚おっけー？\nふっふっふ、ひらめきましたよー。", "face": "u942"}, {"name": "アンナ", "text": "あら？　あそこにいるのはグリムさんでは？\nいったい何をして――"}, {"name": "グリム", "text": "――歴代ゴブリンクイーンさん、召喚ー！！", "face": "u942"}, {"name": "アンナ", "text": "……えっ？", "face": "ladc064ee9121"}, {"name": "ゴブリンクイーンＡ", "text": "『ウフフ……このあたりの岩盤は全て\n爆弾で破壊』――って、あら？　ここは……？", "face": "le002a75f4cc4"}, {"name": "ゴブリンクイーンＢ", "text": "『最新型の騎獣戦車でもって、次こそは王子たちを』\n――ってここはどこなの！？", "face": "le002a75f4cc4"}, {"name": "メカゴブリンクイーン", "text": "『娘たちと一緒に、私の居ない人気闘兵なんて、\nめっちゃくちゃに』――って、あら？\n人気闘兵会場はどこへ？", "face": "lcf83ba773824"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、\nなるほど、他の時間軸の私たちを喚んだのねぇ？", "face": "l54a5fa2e0e9d"}, {"name": "ゴブリンクイーン軍団", "text": "『ウフフッ、美人が四人も揃うと壮観ねぇ♪』", "face": "lcf83ba773824"}, {"name": "ケイティ", "text": "……お、王子、想定外の事態です！\n急ぎゴブリンクイーン軍団を倒しましょう！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンクイーンA", "text": "……なるほどね。\nまさかこの私が、王子と手を組んでいるなんて。\n未来というのは分からないものねぇ。", "face": "le002a75f4cc4"}, {"name": "メカゴブリンクイーン", "text": "けれど、天界に殴り込みなんて素敵じゃない？\nゴブリン軍団が、お綺麗な天界を蹂躙するのよぉ？", "face": "lcf83ba773824"}, {"name": "ゴブリンクイーンA", "text": "ウフフッ、それもそうねぇ♪\nそれじゃあ今の時代の私、\nゴブリン軍団の未来は任せたわよ！", "face": "le002a75f4cc4"}, {"name": "メカゴブリンクイーン", "text": "えぇ、任せておきなさい。\nゴブリンの未来は、この私が切り開いてやるから。\nオ～ッホッホッホッホ！！", "face": "l54a5fa2e0e9d"}, {"name": "アンナ", "text": "ふぅ……なんとか一段落ですね。\nそれにしても、いったい誰がこんなことを……。", "face": "lda062e86784f"}, {"name": "グリム", "text": "……こそこそ。", "face": "u942"}, {"name": "ガオレオン", "text": "ムムッ、そこにいるのはグリムではないかッ！？", "face": "leab42ca8b3e3"}, {"name": "グリム", "text": "はっ、ばれちゃったです。\nお仕置きをされる前に逃げますよー。", "face": "u942"}, {"name": "アンナ", "text": "グリムさん！　また異界召喚術を使いましたね！？", "face": "ladc064ee9121"}, {"name": "グリム", "text": "異界じゃないですよー。\n並行世界ですよー。", "face": "u942"}, {"name": "グリム", "text": "召喚術は楽しいですねー。\nさぁ、次はどんな実験をしましょうかー。", "face": "u942"}, {"name": "グリム", "text": "王子さま、楽しみにしていてくださいねー♪", "face": "u942"}]}], "active": true}