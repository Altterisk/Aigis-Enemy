"global_id": 444, "ranged": true, "from_condition": 3}, {"enemy_id": 19, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103376, "race_id": 8, "change_to": 19, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 442, "global_id": 441, "ranged": true, "to_condition": 3, "to_global_id": 442, "spawn_sec": 100}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 443, "global_id": 442, "ranged": true, "from_condition": 3}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102640, "race_id": 8, "change_to": 21, "change_condition": 3, "master_id": 383, "global_id": 382, "to_condition": 3, "to_global_id": 383, "spawn_sec": 112}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 450, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102656, "race_id": 8, "master_id": 384, "global_id": 383, "from_condition": 3}, {"enemy_id": 23, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 25000, "attack": 2500, "base_hp": 25000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102928, "race_id": 8, "change_to": 23, "change_condition": 3, "master_id": 405, "global_id": 404, "to_condition": 3, "to_global_id": 405, "spawn_sec": 117}, {"enemy_id": 23, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 25000, "attack": 2500, "base_hp": 25000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102944, "race_id": 8, "master_id": 406, "global_id": 405, "from_condition": 3}, {"enemy_id": 25, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105088, "race_id": 8, "special_effect_id": 567, "master_id": 382, "global_id": 381, "spawn_sec": 158}], "dialogue": [{"trigger": "start", "lines": [{"name": "シュテフィ", "text": "――ここは、古戦場、ですか？", "face": "u1709a1"}, {"name": "ハイデマリー", "text": "魔王決戦の時のものにしては古い……。\n千年戦争当時のものかな？", "face": "u1704a1"}, {"name": "リッチ", "text": "いやいや、ここは千年戦争の後、\n人類同士が殺し合った、戦乱の時代の古戦場ですぞ。", "face": "labdc1fa49bee"}, {"name": "ハイデマリー", "text": "ま、魔物……！？", "face": "u1704a1"}, {"name": "リッチ", "text": "砲を収められよ！\nこちらに敵意はありませぬ。", "face": "labdc1fa49bee"}, {"name": "ルイン", "text": "お久しぶりです、墓守のリッチさん。\nお騒がせしてすみません。", "face": "u1180a1"}, {"name": "リッチ", "text": "おぉ、おぉ、殺人機械の――こほん、\nこれは失礼な呼び名ですな。\nルイン嬢、ご健勝なようで何より。", "face": "labdc1fa49bee"}, {"name": "ルイン", "text": "ルインは自動人形ですから、いつでも健康です。\n――儀式の方は順調ですか？", "face": "u1180a1"}, {"name": "リッチ", "text": "えぇ、以前冥界の門が開いた時より、\nむしろ安定しているくらいですな。", "face": "labdc1fa49bee"}, {"name": "ハイデマリー", "text": "この地で、いったい何が……？\n冥界の門が開いた正式な記録は、\n白の帝国にはなかったはずだけど……。", "face": "u1704a1"}, {"name": "リッチ", "text": "……人同士が殺しあった、憎しみと後悔、\n悲哀と苦痛の満ちるこの地より、\n冥界の門が開いたことがあったのですよ。", "face": "labdc1fa49bee"}, {"name": "リッチ", "text": "ですが、その情報は王国において\n秘匿されたと聞いております。", "face": "labdc1fa49bee"}, {"name": "シュテフィ", "text": "……いったいなぜ？", "face": "u1709a1"}, {"name": "ルイン", "text": "この地が冥界に最も近い場所である理由、\n数多の戦士が眠る場所である理由、\nそして今も、怨念が渦巻く場所である理由――", "face": "u1180a1"}, {"name": "ルイン", "text": "その元凶こそが、ルインですから。\n王子はルインを守るために、\nすべての情報を非公開にしてくれました。", "face": "u1180a1"}, {"name": "ハイデマリー", "text": "……ごめん。\n帝国のために、あなたの過去を……。", "face": "u1704a1"}, {"name": "ルイン", "text": "気にする必要はありません。\nルインは、自分からこの作戦を提案しました。", "face": "u1180a1"}, {"name": "ルイン", "text": "平和のために、争う者をすべて排除する……。\nそれ以外の手段を、ルインは手にする必要があります。", "face": "u1180a1"}, {"name": "ルイン", "text": "ですから、まずはこの戦争を止める手段を、\n模索してみようと思っただけです。", "face": "u1180a1"}, {"name": "リッチ", "text": "……その志、このリッチも助力いたしますぞ。\n平和なる世界は我が主の望みでもありますからな！", "face": "labdc1fa49bee"}, {"name": "リッチ", "text": "さて、ではそろそろ、\n我が死者たる魔力を注いで、冥界の門を――", "face": "labdc1fa49bee"}, {"name": "シュテフィ", "text": "――待って、まだだめ。", "face": "u1709a1"}, {"name": "オークロード", "text": "……そうだ。\nまだ冥界へ向かってもらっては困る。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "魔界と物質界ではない、\n物質界の者同士による古戦場が、オレの死に場所か。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "悪くない……戦士たちの怨嗟の声が、\n殺せと、砕けと、オレに求めてくる。", "face": "l7abef6f2023c"}, {"name": "白の皇帝", "text": "…………ここで、死ぬ気か。", "face": "u418"}, {"name": "オークロード", "text": "応ッ！\nそして白の皇帝よ、貴様もここで死ぬのだ。\n戦士として最後の戦いを、始めようか。", "face": "l7abef6f2023c"}]}, {"trigger": "battle", "at_sec": 81, "lines": [{"name": "ハイデマリー", "text": "……あの傷じゃ、もう助からない。\nそれなのに、どうしてまだ戦おうと……。", "face": "u1704a1"}, {"name": "シュテフィ", "text": "傷つくほどに、力が増している……。\nあれが、オークロードの力？", "face": "u1709a1"}, {"name": "アナトリア", "text": "いいや、あいつは死に場所を決めたんだ。\n傷なんて、もはや勲章が\n増えたくらいにしか思ってないだろうね。", "face": "u522"}, {"name": "アナトリア", "text": "さぁ、ヤツが真っすぐ突っ込んでくるよ。\nオークの王の死に様、受け止めてやりな！", "face": "u522"}]}, {"trigger": "end", "lines": [{"name": "オークロード", "text": "――見、事だ……。", "face": "l7abef6f2023c"}, {"name": "白の皇帝", "text": "…………名を聞こう。", "face": "u418"}, {"name": "オークロード", "text": "不要……だ……。\n我が名は……部族の若き戦士たちが……受け継ぐ……。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "名が残る限り……我が名誉と武勲は……くっ……。\n未来を生きる、戦士が、受け継……ぐ……。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "――騎士よ……ぐっ、ぐぉぉぉ……。\nティルト、よ……！　見ているのだろう！？", "face": "l7abef6f2023c"}, {"name": "ティルト", "text": "…………。", "face": "u1705a1"}, {"name": "オークロード", "text": "ハイドース様に、\nオレを連れ戻すよう、言われたのだろう……？", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "だが……オレは、ここで死ぬ……。\n冥界には……戦士たちだけ、連れて行ってやってくれ……。", "face": "l7abef6f2023c"}, {"name": "ハイオーク", "text": "王よ、そんな……！\n俺たちもここでお供します！！", "face": "l7bf980320ebd"}, {"name": "ティルト", "text": "……彼の、最後の王命だ。\n臣下ならば、それに応えてみせよ。", "face": "u1705a1"}, {"name": "ハイオーク", "text": "……最後の……我が、王の……。", "face": "l7bf980320ebd"}, {"name": "白の皇帝", "text": "……行け。\nこの者は、俺たちが丁重に弔っておこう。", "face": "u418"}, {"name": "ティルト", "text": "……かたじけない。", "face": "u1705a1"}, {"name": "オークロード", "text": "…………。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "…………ああ、親父、久しぶり、だ――", "face": "l7abef6f2023c"}, {"name": "白の皇帝", "text": "――兵には、小休止を取らせろ。\nこの男は、俺が弔う。", "face": "u418"}, {"name": "レオナ", "text": "……はっ。", "face": "u311"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 20, "params": [150]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 4000, "attack": 400, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102224}, {"enemy_id": 1, "form_index": 1, "hp": 4000, "attack": 600, "damage_type": "physical", "armor_defense": 450, "pattern_id": 2102240}, {"enemy_id": 3, "form_index": 0, "hp": 3000, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102544}, {"enemy_id": 3, "form_index": 1, "hp": 3000, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102560}, {"enemy_id": 5, "form_index": 0, "hp": 10, "attack": 550, "damage_type": "physical", "pattern_id": 2142304}, {"enemy_id": 10, "form_index": 0, "hp": 5000, "attack": 250, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2102608}, {"enemy_id": 11, "form_index": 0, "hp": 2500, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102576}, {"enemy_id": 11, "form_index": 1, "hp": 2500, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102592}, {"enemy_id": 13, "form_index": 0, "hp": 18000, "attack": 800, "damage_type": "physical", "armor_defense": 500, "pattern_id": 2102672}, {"enemy_id": 13, "form_index": 1, "hp": 18000, "attack": 1600, "damage_type": "physical", "armor_defense": 700, "pattern_id": 2102688}, {"enemy_id": 15, "form_index": 0, "hp": 108000, "attack": 2400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 35, "pattern_id": 2142384}, {"enemy_id": 17, "form_index": 0, "hp": 8000, "attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2103408}, {"enemy_id": 17, "form_index": 1, "hp": 8000, "attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2103424}, {"enemy_id": 19, "form_index": 0, "hp": 10000, "attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2103376}, {"enemy_id": 19, "form_index": 1, "hp": 10000, "attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2103392}, {"enemy_id": 21, "form_index": 0, "hp": 15000, "attack": 2000, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102640}, {"enemy_id": 21, "form_index": 1, "hp": 15000, "attack": 2000, "damage_type": "physical", "armor_defense": 450, "pattern_id": 2102656}, {"enemy_id": 23, "form_index": 0, "hp": 25000, "attack": 2500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "pattern_id": 2102928}, {"enemy_id": 23, "form_index": 1, "hp": 25000, "attack": 2500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "pattern_id": 2102944}, {"enemy_id": 25, "form_index": 0, "hp": 20000, "attack": 400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "pattern_id": 2105088}]}, "active": true}