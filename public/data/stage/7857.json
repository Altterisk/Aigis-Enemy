{"quest_id": 7857, "name": "第五陣 古戦場の死闘", "description": "古戦場に辿り着いた皇帝の前に死に場所を\n定めたオークロードが姿を現す……。\n命を賭した戦いを制し、勝利をつかみ取れ！\n神級（★１獲得の目安：平均Lv50）", "event": "帝国五陣", "event_category": "Empire", "mission_id": 940003, "map_no": 4689, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_index": 0, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102224, "race_id": 8, "change_to": 1, "change_condition": 3, "master_id": 366, "global_id": 365, "to_condition": 3, "to_global_id": 366, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "physical", "armor_defense": 450, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102240, "race_id": 8, "master_id": 367, "global_id": 366, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102544, "race_id": 8, "change_to": 3, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 377, "global_id": 376, "ranged": true, "to_condition": 3, "to_global_id": 377, "spawn_sec": 26}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 378, "global_id": 377, "ranged": true, "from_condition": 3}, {"enemy_id": 5, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 10, "attack": 550, "base_hp": 10, "base_attack": 550, "damage_type": "physical", "attack_range": 220, "attack_speed": 100, "attack_wait": 30, "attack_interval": 106, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142304, "race_id": 8, "change_to": 5, "change_condition": 2, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 35795, "global_id": 9412, "ranged": true, "spawn_sec": 38}, {"enemy_id": 10, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 250, "base_hp": 5000, "base_attack": 250, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102608, "race_id": 8, "special_effect_id": 567, "master_id": 381, "global_id": 380, "spawn_sec": 47}, {"enemy_id": 11, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "cha