l", "armor_defense": 1650, "magic_defense": 60, "attack_speed": 1, "attack_wait": 40, "attack_interval": 200, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152800, "race_id": 3, "special_effect_id": 1160, "change_to": 35, "master_id": 37438, "global_id": 11055, "route_behaviour": {"transforms": [{"flag": 12, "val": 1}]}, "spawn_sec": 195}, {"enemy_id": 37, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 20, "attack_interval": 82, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152656, "special_effect_id": 1160, "master_id": 37434, "global_id": 11051, "spawn_sec": 197}, {"enemy_id": 38, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 90, "attack_speed": 40, "attack_wait": 10, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "pattern_id": 2113808, "special_effect_id": 1160, "master_id": 37395, "global_id": 11012, "spawn_sec": 198}, {"enemy_id": 39, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 240000, "attack": 1500, "base_hp": 240000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 90, "attack_speed": 1, "attack_wait": 40, "attack_interval": 182, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152608, "special_effect_id": 1160, "master_id": 37440, "global_id": 11057, "spawn_sec": 202}], "dialogue": [{"trigger": "start", "lines": [{"name": "魔神セーレ", "text": "……遅かったな。\nククク、異世界の戦士ランス、王国の王子よ。", "face": "l70921f716695"}, {"name": "ランス", "text": "きさまぁ……貴様のせいで、\n俺様がどれだけつらい目にあったかぁ……！", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "ムム……なんだその腑抜けた様子は……。\nまぁいい、貴様の息の根を止めるには都合が良い。", "face": "l70921f716695"}, {"name": "フェリス", "text": "まぁ、アレが無くなったくらいで、\nこんなしおしおになるとか思わないわよね。", "face": "u2159a1"}, {"name": "魔神セーレ", "text": "アレ……？", "face": "l70921f716695"}, {"name": "ホーネット", "text": "気にしないでください。\nどちらにせよ、あなたはここで終わりです。", "face": "u2157a1"}, {"name": "グリム", "text": "ですです！\nとにかくここで決着をつけますよー。\nこれ以上強くなられると困るので！！", "face": "u942"}, {"name": "魔神セーレ", "text": "ほう……ハニワ体質の力を解析したことを、\nもう知っているのか。", "face": "l70921f716695"}]}, {"trigger": "start", "lines": [{"name": "魔神セーレ", "text": "だが、ランスなき貴様らなど、\n我が第二形態で十分！　ここで葬ってくれる！！", "face": "l70921f716695"}, {"name": "ウルザ", "text": "魔物の姿になった！？", "face": "u2158a1"}, {"name": "上杉謙信", "text": "やつが慢心している内に勝負を付ける。\n行くぞ皆。毘沙門天の加護ぞある！！", "face": "u2156a1"}]}, {"trigger": "battle", "at_sec": 198, "lines": [{"name": "魔神セーレ", "text": "ククク……ここまでは想定通りだ……。\n勝ったと思っただろう、\n我を打ち破ったと、そう思っただろう！？", "face": "lf83406422d06"}, {"name": "魔神セーレ", "text": "絶望とは、希望を見た直後にこそ映えるもの。\n我が第三形態をもって、\n貴様らに引導を渡してくれる！", "face": "lf83406422d06"}, {"name": "魔神セーレ", "text": "リズナよ、その身体を私に――", "face": "lf83406422d06"}, {"name": "魔神セーレ", "text": "…………ん？\nおい、リズナ、どこだ？　どこへ行った？", "face": "lf83406422d06"}, {"name": "ハニーＤ", "text": "僕たちが運んだよー。", "face": "l0a288895e9cd"}, {"name": "魔神セーレ", "text": "えっ。", "face": "lf83406422d06"}, {"name": "ハニーＥ", "text": "女の子を硬い床に寝かせるとかひどーい。", "face": "l0a288895e9cd"}, {"name": "リズナ", "text": "えっと、はい、\nその後こうして、助けていただきました。", "face": "u2155a1"}, {"name": "魔神セーレ", "text": "…………どこまでも、\nどこまでも私をコケにしおって。", "face": "lf83406422d06"}, {"name": "魔神セーレ", "text": "だが、ハニワ体質であるのはリズナだけではない。\nハニーよ、貴様の身体をいただくぞ！！", "face": "lf83406422d06"}]}, {"trigger": "battle", "at_sec": 201, "lines": [{"name": "犠牲者ハニー", "text": "えーっ、やだー！　きゃーっ！", "face": "l0a288895e9cd"}]}, {"trigger": "end", "lines": [{"name": "ウルザ", "text": "魔神が……ハニーの姿に……？", "face": "u2158a1"}, {"name": "フェリス", "text": "ふざけた姿だけど、\n魔神の力に、ハニーの魔法耐性があるってことは……。", "face": "u2159a1"}, {"name": "上杉謙信", "text": "……一筋縄で行く相手ではない。", "face": "u2156a1"}, {"name": "魔神セーレ", "text": "ハーッハッハッハッハ！\n見よこの……くっ……少々丸っこいが、まぁいい。\n貴様らを殺し、身体を奪えば済む話だ！", "face": "lf83406422d06"}, {"name": "魔神セーレ", "text": "さぁ、誰から殺してやろうか……ハニホー！！", "face": "lf83406422d06"}]}], "active": true}