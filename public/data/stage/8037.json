{"quest_id": 8037, "name": "第六陣 皇帝の器", "description": "人質を取られたセグナンドが襲い来る。\n＜冥界：HPに継続ダメージ＞\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["冥界：HPに継続ダメージ", "広域戦闘：敵味方の射程減少"], "event": "帝国六陣", "event_category": "Empire", "mission_id": 940002, "map_no": 4780, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 37000, "attack": 1800, "base_hp": 37000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "special_effect_id": 793, "change_to": 1, "change_condition": 4, "master_id": 36426, "global_id": 10043, "to_condition": 4, "to_ticks": 3, "to_global_id": 10046, "commands": {"raw": "CreateMapEffectObject2(\"obj_00\", \"StageOccupationFlag\", 5, 0, 60, 37, 276); SetStageFlag(0, 1); if (IsStageFlag(1) == 1) { SetStageFlag(3, 1); } DeleteMapEffectObject(\"obj_00\", 60); CreateMapPlaceObject(\"locPlc_360\", 360, 37, 276); CreateGuestUnit(\"ゲストID=0\", \"配置ID=360\", \"演出=1\", \"フェード時間=0\");", "sets_flags": [[0, 1], [3, 1]]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 37000, "attack": 500, "base_hp": 37000, "base_attack": 500, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 1476, "missile_id": 45, "master_id": 36429, "global_id": 10046, "from_condition": 4, "trigger_ticks":