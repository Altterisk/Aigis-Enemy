te": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 296, "master_id": 31084, "global_id": 4703, "spawn_sec": 200}, {"enemy_id": 15, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_range": 30, "attack_speed": 1, "attack_wait": 30, "attack_interval": 116, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130864, "missile_id": 597, "missile": {"speed": 17.0, "on_hit": {"kind": "DOT", "duration_f": 1200, "interval_f": 30, "flat": 5, "expire_duration_only": true, "relief": true, "effect_name": "DebuffEffectPoison"}}, "master_id": 34055, "global_id": 7672, "ranged": true, "spawn_sec": 206}, {"enemy_id": 16, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 236, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103248, "change_to": 16, "change_condition": 1, "missile_id": 6, "master_id": 424, "global_id": 423, "ranged": true, "variants": [{"hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "master_id": 423, "global_id": 422}], "spawn_sec": 294}, {"enemy_id": 18, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "hp": 24000, "attack": 350, "base_hp": 24000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130848, "special_effect_id": 38, "master_id": 34054, "global_id": 7671, "spawn_sec": 346}], "popups": ["　　　　　【冥界】\n・味方ユニットのHPが徐々に減少\n\n※このダメージは風水使いなど\n　地形効果を軽減する能力を\n　もったユニットを配置することで\n　軽減可能です。", "敵に占領されているマスは、\n占領している敵を倒すことで、\n使用可能になります。\nマスを占領している敵には、\n旗のマークがついています。", "黒炎のセグナンドは\n自身が通過したマスを占領します。\n\n占領されたマスに\n配置していたユニットは、\n撤退をしますが\n再出撃が可能です。", "黒炎のセグナンドは、\n特定の地点に到達すると\n攻撃と同時に周囲のマスを\n一気に占領します。", "　　　悪天候：猛吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇", "ダークエルフナイトは\nダメージを受けると\n攻撃したユニットへ反撃を行います。", "ダークエルフドルイドから攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n複数のダークエルフドルイドから\n攻撃を受けた場合、\n継続ダメージ効果が重複します。\n　　　　　　(1/2)", "ダークエルフドルイドの\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "セグナンド", "text": "なぜ、こんなことをする。\nダークエルフの居留地を焼き、\n戦士でない者まで殺し、ついにはこの封鎖階層まで……。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "ハイドース様に反逆するつもりか？\nまさか、冥界軍を乗っ取るつもりで――", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "――反逆？\nどうやら勘違いしているようだな。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "我が上に立つ者など、最初からいるはずがなかろう。\n皇帝こそ世界の全て、あらゆる命の上に立つ者だ。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "裏切ったのではなく、最初から仲間ではなかったと？\nだが貴様を崇める国など、この時代のどこにもない！\n国家なき皇帝が、いまさら何のつもりだ！！", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "分かりきったことを……。\n貴様は、あの腑抜けきった当代の皇帝を見たか？", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "――は？", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "我が国を受け継いだ男が、\n英雄王の子孫如きに絆され、\n牙を抜かれ、まるで子犬のような有り様だった。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "弱き皇帝に、民は従わぬ。\n冥界対帝国の、反逆ごっこがまさにそれを示している。\n皇帝が偉大でなければ、民は思い上がり、つけあがるのだ。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "我らの誇りをかけた戦いを、ごっこ遊びだと……！？", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "事実だろう。\nそれゆえに、こんな人質を取られただけで、\nその剣を振るえなくなっているのではないか？", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "…………ッ。", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "故に、貴様らは贄となってもらう。\n死ぬ気であの小童を殺しに行け。\n見事首を刈り取ってくるといい。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "……奴を殺せば、皆を助けてくれるのか。", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "ああ、そこで死ぬのなら、奴はそこまでの男だからな。\n貴様らも死力を尽くした褒美として見逃してやろう。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "あやつには、罪なき無力な民が、\n必死に武器を振りかざして己を殺しに来るという、\n心踊る経験が足りていないと見える。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "そして、その無力な民を薙ぎ払い、\n血の丘で美酒に酔いしれる、\nあの得も言われぬひとときの味わいも、な。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "……愚かな。", "face": "l20ac59a2a223"}, {"name": "骸帝", "text": "お前の部族が全滅すれば、\n皇帝としての器を手に入れた奴と戦える。\nそうでないのなら、再び骸帝の時代が始まるだけ。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "クク……楽しいなァ。\nそうだろう、セグナンド。\n楽しめ、笑え、笑いながら死にに行け。", "face": "lf035f042ddb3"}, {"name": "セグナンド", "text": "（――すまない、イルヴィ。\n我が娘よ、どうかお前だけでも、生き延びてくれ）", "face": "l20ac59a2a223"}, {"name": "イルヴィ", "text": "――皆、こっちだ！\nあの氷原の向こうに、私たちの野営地がある！", "face": "u1918a1"}]}, {"trigger": "start", "lines": [{"name": "トゥーダ", "text": "イルヴィ、嬉しそうですね。", "face": "u1554a1"}, {"name": "ジークリンデ", "text": "命がけで冥界を抜けて、助けを求めに来た後なんだ。\n家族との再会も、一層嬉しくなるというものだろう。", "face": "u429"}, {"name": "ヘリューズ", "text": "そんなに急ぐと転びますよ？\nただでさえ冥界に縁のない者は体力を削られるのに、\nそのうえ、凍結した川の上は滑りやすいのですから。", "face": "u1919a1"}, {"name": "イルヴィ", "text": "なに、むしろ素早く滑って移動できるというものだ！\n早く皆のところへ――んっ……なんだ、あれは……？", "face": "u1918a1"}, {"name": "ヘリューズ", "text": "私の館が……燃えて、いる……？\nそれに、あの砦にいるのは――", "face": "u1919a1"}, {"name": "セグナンド", "text": "…………来てしまったか、イルヴィ。", "face": "l20ac59a2a223"}, {"name": "イルヴィ", "text": "父上！　いったい何が……皆は――", "face": "u1918a1"}, {"name": "セグナンド", "text": "白の皇帝、貴様の命を貰い受ける！\nこれは我が部族、我が父祖の血、\nそして我が剣の誇りをかけた決闘だ！！", "face": "l20ac59a2a223"}, {"name": "カーナ", "text": "――やられました。\n陛下、ダークエルフの野営地は、\n骸帝の配下と思しき部隊に占拠されています。", "face": "u1107a1"}, {"name": "白の皇帝", "text": "……人質をとられたか、セグナンド。\nだが、こちらも大人しく\n首を差し出すわけにはいかない。", "face": "u418"}, {"name": "白の皇帝", "text": "野営地を解放するぞ。\nそうすれば、あの男も戦う理由がなくなるだろう。", "face": "u418"}, {"name": "レオナ", "text": "はっ！　総員、陣形を整えよ！\n敵は……もう、兵たちにも隠す必要もないだろう。\n我らが血に濡れた過去の象徴、骸帝の軍だ！！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "セグナンド", "text": "……白の皇帝。", "face": "l20ac59a2a223"}, {"name": "白の皇帝", "text": "……こちらへ降れ、セグナンド。\nこれから先の帝国は、民のための国になると約束する。", "face": "u418"}, {"name": "セグナンド", "text": "信じよう。\nイルヴィを匿ってくれた、それが十分すぎる証拠だ。", "face": "l20ac59a2a223"}, {"name": "イルヴィ", "text": "父上……良かった……。\nそうだ、皆は……？", "face": "u1918a1"}, {"name": "セグナンド", "text": "……犠牲者は、多い。\nだが、我らも父祖の誇りを継ぐ者だ。\nまだここから、やり直せる。", "face": "l20ac59a2a223"}, {"name": "ヘリューズ", "text": "私の館は……燃え尽きてしまいましたけどねー……。", "face": "u1919a1"}, {"name": "ヘカティエ", "text": "……ここが戦場になった以上、\nもう封鎖階層にいる理由もないでしょう？\nあなたも物質界に移住すればいいのよ。", "face": "u1226a1"}, {"name": "ヘリューズ", "text": "そうしちゃいましょうかねぇ。\n幸い、波長のあう者もいるようですし……。", "face": "u1919a1"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "レオナ", "text": "よし、ダークエルフたちの救出は完了した。\nミュレとフォーラの部隊に連絡しろ。\nここまでの通路をこじ開けて撤退するぞ。", "face": "u311"}, {"name": "骸帝", "text": "…………。\n嘆かわしい。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "――ここまで、堕ちたか。\n仇を討つでもなく、強き者との戦いを望むでもなく、\nただ尻尾を巻いて逃げる算段を始めるとは。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "白の帝国は、もはや名ばかり……。\nならば、その首すげ替えてしまおうか。", "face": "lf035f042ddb3"}, {"name": "白の皇帝", "text": "第三代、白の皇帝……骸帝……！", "face": "u418"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}, {"kind": "term", "influence": 20, "params": [200]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 44400, "attack": 2160, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127824}, {"enemy_id": 1, "form_index": 1, "hp": 44400, "attack": 600, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127840}, {"enemy_id": 5, "form_index": 0, "h