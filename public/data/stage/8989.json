{"quest_id": 8989, "name": "最後の好敵手", "description": "新人アイドルによるツアーも遂にラスト。\nそんな一行に立ちはだかる最後のライバル\nは、超アイドルメカゴブリンクイーン！\n極級（★１獲得の目安：平均Lv25）", "event": "新星たちのトリニティライブ", "event_category": "Emergency", "mission_id": 200572, "map_no": 7458, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー", "機械", "女性", "アイドルメカゴブリンクイーン"], "hp": 28000, "attack": 1050, "base_hp": 28000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 230, "attack_speed": 200, "attack_wait": 80, "attack_interval": 215, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2150368, "race_id": 9, "special_effect_id": 216, "change_to": 1, "change_condition": 3, "missile_id": 1000, "missile": {"speed": 4.0}, "master_id": 37105, "global_id": 10722, "ranged": true, "to_condition": 3, "to_global_id": 10723}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "機械", "女性", "アイドルメカゴブリンクイーン"], "hp": 28000, "attack": 300, "base_hp": 28000, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 20, "attack_range": 230, "attack_speed": 200, "attack_wait": 80, "attack_interval": 223, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2150528, "race_id": 9, "special_effect_id": 1654, "missile_id": 1003, "missile": {"speed": 8.0}, "master_id": 37106, "global_id": 10723, "ranged": true, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.299999952316