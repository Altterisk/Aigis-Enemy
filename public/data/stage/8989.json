ck_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102672, "race_id": 8, "change_to": 23, "change_condition": 3, "master_id": 385, "global_id": 384, "to_condition": 3, "to_global_id": 385, "spawn_sec": 151}, {"enemy_id": 23, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1600, "base_hp": 18000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 700, "attack_speed": 20, "attack_wait": 15, "attack_interval": 116, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "master_id": 386, "global_id": 385, "from_condition": 3}, {"enemy_id": 25, "source": "local", "count": 1, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 154}, {"enemy_id": 26, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 717, "global_id": 716, "spawn_sec": 172}], "popups": ["超アイドルメカゴブリンクイーンは、\n戦場にいるゴブリンの応援団の\n総数に応じて\n攻撃と防御がアップします。\n\nさらに戦場にゴブリン博士がいると\n攻撃と防御が大幅にアップします。", "アイドル衣装を着た\nゴブリンプリンセス三姉妹がいる間は\n敵のゴブリンの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーヴ", "text": "──王国プロダクションの物質界ツアーも遂に終着点。", "face": "u454"}, {"name": "レーヴ", "text": "各地で多くの好敵手と出会い、熱闘を繰り広げ、\nそして己の課題と向き合い続けた三組のアイドル。", "face": "u454"}, {"name": "レーヴ", "text": "彼女たちに立ち塞がる最後の壁は──", "face": "u454"}, {"name": "メカゴブリンクイーン", "text": "いらっしゃい、ここがあなたたちの夢の墓場よ。", "face": "l14834e85ef45"}, {"name": "レーヴ", "text": "超アイドル、メカゴブリンクイーン……ッ！！", "face": "u454"}, {"name": "ウルカノ", "text": "あれのどこが新人アイドルなんだよ。\n大御所の風格醸し出してんじゃねぇか。", "face": "u1669a1"}, {"name": "アンナ", "text": "あくまでもオロバスカップのエントリー条件は、\nトップアイドルの称号を手にしたことがない女性。", "face": "l55d022a50766"}, {"name": "アンナ", "text": "つまりメカゴブリンクイーンも有資格者なのです！", "face": "lfbb03cc8a7e9"}, {"name": "メカゴブリンクイーン", "text": "ウフフ、まさかこんな小娘たちが私の相手なんてねぇ。", "face": "l14834e85ef45"}, {"name": "ゴブリン博士(ドルオタ)", "text": "王国民的アイドル女王子、帝国歌姫ツキコ★トゥーダ。\nこの二組ガいない以上、優勝ハ既に決まっタようなモノ。", "face": "l31d135185c2f"}, {"name": "ゴブリン博士(ドルオタ)", "text": "お前タチ！　女王の花道ヲ飾るノダ！", "face": "l31d135185c2f"}, {"name": "ゴブリン", "text": "ギャギャギャ―！！", "face": "l53590f1acc2e"}, {"name": "アージェ", "text": "なんと一糸乱れぬ統率力……\nあのレベルのアイドルにもなると、\nファンすらも演出の一部なのですね。"}, {"name": "ユキヒメ", "text": "（でも前の大きな衣装じゃないんだ……）"}, {"name": "キュウビ", "text": "ふん、上等ではないか。\nわらわたちは厳しいレッスンの日々を乗り越えてきた。"}, {"name": "キュウビ", "text": "時代遅れのロートルアイドルに、\n新時代というものを教えてやろう。"}, {"name": "ラタトスク", "text": "吾輩たち毎日エステサロンに行きながら、\nぐっすり昼寝してばっかりじゃったけどな。"}, {"name": "キュウビ", "text": "たわけ、三時のおやつを控え目にした屈辱を忘れたか！"}, {"name": "ポミエ", "text": "（食べてるじゃん）", "face": "u2828a1"}, {"name": "アルタ", "text": "おやつはともかく、我々が積み重ねた努力は本物です。"}, {"name": "アージェ", "text": "たとえ女王が相手だろうと、引けは取りません。"}, {"name": "ユキヒメ", "text": "私たちは、負けない……！"}, {"name": "メカゴブリンクイーン", "text": "ウフフ……いいわ、そこまで言うなら相手になってあげる。", "face": "l14834e85ef45"}, {"name": "審査員", "text": "──合意と見てよろしいですね？", "face": "l8cea18673728"}, {"name": "ポミエ", "text": "おじさん！", "face": "u2828a1"}, {"name": "審査員", "text": "これより王国プロダクションと、\n超アイドルゴブリンクイーンによる、\n野良オーディションを開始します。", "face": "l8cea18673728"}, {"name": "審査員", "text": "それではミュージック、スタート！", "face": "l8cea18673728"}, {"name": "メカゴブリンクイーン", "text": "王国アイドルとしてのプライド、\nこの女王に見せてごらんなさぁい！", "face": "l14834e85ef45"}]}, {"trigger": "end", "lines": [{"name": "メカゴブリンクイーン", "text": "………………。", "face": "l14834e85ef45"}, {"name": "ユキヒメ", "text": "………………。"}, {"name": "メカゴブリンクイーン", "text": "ふぅ……帰るわよ、博士。", "face": "l14834e85ef45"}, {"name": "ゴブリン博士(ドルオタ)", "text": "ク、クイーンさま……ッ！", "face": "l31d135185c2f"}, {"name": "メカゴブリンクイーン", "text": "敗者はただ去るのみ、勝負の掟よぉ。", "face": "l14834e85ef45"}, {"name": "ゴブリン博士(ドルオタ)", "text": "デ、ですガ……！！", "face": "l31d135185c2f"}, {"name": "メカゴブリンクイーン", "text": "別にこんな大会で勝てなかったからと、\n女王の価値が毀損されるわけではないわ。", "face": "l14834e85ef45"}, {"name": "メカゴブリンクイーン", "text": "私が何者であるかは、私たちが知っていればいい。", "face": "l14834e85ef45"}, {"name": "メカゴブリンクイーン", "text": "そうよね、博士。", "face": "l14834e85ef45"}, {"name": "ゴブリン博士(ドルオタ)", "text": "──ッ、モチロンでございマス！！", "face": "l31d135185c2f"}, {"name": "ゴブリン", "text": "ギャギャ！！　ギャギャ！！", "face": "l53590f1acc2e"}, {"name": "メカゴブリンクイーン", "text": "……そこの小さいお嬢さん。", "face": "l14834e85ef45"}, {"name": "ユキヒメ", "text": "わ、私……？"}, {"name": "メカゴブリンクイーン", "text": "良いライブだったわ。大会本番が楽しみね。", "face": "l14834e85ef45"}, {"name": "ユキヒメ", "text": "あ、ありがとう……。"}, {"name": "メカゴブリンクイーン", "text": "王子を救うのでしょう？\nこの女王に勝利したのだから、\n誇りを持って胸を張りなさぁい？", "face": "l14834e85ef45"}, {"name": "メカゴブリンクイーン", "text": "オーッホッホッホホッ！！", "face": "l14834e85ef45"}, {"name": "ユキヒメ", "text": "……行っちゃった。"}, {"name": "アージェ", "text": "メカゴブリンクイーン、強敵でした。"}, {"name": "アルタ", "text": "もしかしたら彼女は我々にとって最後の壁として\n『立ちはだかってくれた』のかもしれませんね……。"}, {"name": "ケイティ", "text": "なんにせよ、これでツアーの目的は完遂しました。", "face": "u2433a1"}, {"name": "アンナ", "text": "実力も人気も十分、トップアイドルに不足なしです。"}, {"name": "アンナ", "text": "行きましょう、オロバスカップへ！", "face": "lfbb03cc8a7e9"}, {"name": "ユキヒメ", "text": "お、おーっ！"}]}], "active": true}