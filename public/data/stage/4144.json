{"quest_id": 4144, "name": "囚われた踊り子", "description": "旅の一座を見に街に来た\n王子達。しかし束の間の\n安息にも魔の手が…。", "event": "暗黒舞踏会", "event_category": "History", "mission_id": 920028, "map_no": 3049, "level": 85, "multiplier": 0.85, "charisma": 15, "exp": 140, "gold": 500, "drops": [{"card": 186, "c": 1}, {"card": 6, "c": 1}, {"card": 65, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "hp": 544, "attack": 119, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 850, "attack": 128, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 10}, {"enemy_id": 3, "source": "local", "count": 1, "level": 50, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 2380, "attack": 340, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 41}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 3400, "base_hp": 4000, "damage_type": "physical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107136, "race_id": 16, "special_effect_id": 741, "master_id": 198, "global_id": 197, "spawn_sec": 46}, {"enemy_id": 5, "source": "local", "count": 1, "level": 80, "form_index": 0, "form_count": 1, "hp": 1275, "attack": 255, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 49}], "dialogue": [{"trigger": "start", "lines": [{"name": "ワルツ", "text": "さて、そろそろかしらね。\n今日も私の踊りで皆を元気づけなくちゃ！", "face": "u186"}, {"name": "ワルツ", "text": "魔物が多く人々も疲れきってるものね。\nこんな時だからこそ、人々が楽しみや喜びを\n思い出してくれたらいいな…。", "face": "u186"}, {"name": "ワルツ", "text": "私の踊りで、一時でも心の安息を\n感じてくれたらいいのだけれど……。", "face": "u186"}, {"name": "ワルツ", "text": "今、踊り子の私が出来る事は、\nこんな事くらいだもの。\n頑張らなくちゃ…！", "face": "u186"}, {"name": "アンナ", "text": "王子、この街に旅の一座が\nいらっしゃっているようですよ。"}, {"name": "アンナ", "text": "普段がんばってもらってる\n兵士たちにも楽しんでもらいましょう。\nあ、そろそろ始まるようですね！"}, {"name": "暗黒騎士", "text": "ククク……。\n愚民どもが続々と集まりよったわ。\nそろそろだな。", "face": "lf7e57276aa4b"}, {"name": "暗黒騎士", "text": "あの踊り子の楽器も既に……。\nこれでこの街は我が物ぞ。\nグフフ。", "face": "lf7e57276aa4b"}, {"name": "暗黒騎士", "text": "よしいけ！　魔物たち！", "face": "lf7e57276aa4b"}, {"name": "アンナ", "text": "魔物！？\n王子、敵です！\n住民に危害が及ぶ前に迎撃しなくては！", "face": "lf8b2ab917c80"}]}, {"trigger": "battle", "at_sec": 45, "lines": [{"name": "ワルツ", "text": "……！　何！？\nリュートが勝手に……？", "face": "u186"}, {"name": "ワルツ", "text": "体が言うことを聞かない！？\n足が勝手に……あぁ手も……！\n一体どうして！", "face": "u186"}, {"name": "暗黒騎士", "text": "ククク。\n我が暗黒の呪いをご堪能いただけているようだな。\nこれで貴様は我らのもの。", "face": "lf7e57276aa4b"}, {"name": "ワルツ", "text": "いやっ、いやですっ！\nあなた達の為に踊りたくは\nありません！", "face": "u186"}, {"name": "暗黒騎士", "text": "何を言っても無駄だ。\n我が暗黒の呪いからは逃れられんのだ。\nそら。我らの為に踊ってみせよ！", "face": "lf7e57276aa4b"}, {"name": "ワルツ", "text": "あぁ、また勝手に体がっ……。\n誰か……助けて……！", "face": "u186"}, {"name": "暗黒騎士", "text": "フハハハ！　素晴らしい…！\nこやつの踊りで\n我らの力はより強大になるぞ！", "face": "lf7e57276aa4b"}, {"name": "アンナ", "text": "力が強大に……？", "face": "lf8b2ab917c80"}, {"name": "アンナ", "text": "王子、どうやらあの方の踊りは\n魔物の力を強めてしまうようです。\n采配にご注意を！", "face": "lf8b2ab917c80"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士", "text": "しくじったか……。\nまさか王子まで来ておったとはな。\nここは一旦引くことにしよう。", "face": "lf7e57276aa4b"}, {"name": "暗黒騎士", "text": "さぁ、お前も来るんだ！", "face": "lf7e57276aa4b"}, {"name": "ワルツ", "text": "きゃぁーーー！\n誰か助けて…！", "face": "u186"}, {"name": "アンナ", "text": "あっ、行ってしまいます！\n王子、あの踊り子の方が心配です。\n追いかけましょう！", "face": "lf8b2ab917c80"}]}], "map": {"image": "Map920028_3049", "w": 960, "h": 640, "spots": [{"k": "b", "x": 900, "y": 441}, {"k": "b", "x": 903, "y": 239}, {"k": "m", "x": 251, "y": 177, "id": 200}, {"k": "m", "x": 403, "y": 118, "id": 201}, {"k": "m", "x": 349, "y": 190, "id": 202}, {"k": "m", "x": 336, "y": 279, "id": 203}, {"k": "m", "x": 313, "y": 349, "id": 204}, {"k": "m", "x": 248, "y": 408, "id": 205}, {"k": "m", "x": 353, "y": 417, "id": 206}, {"k": "m", "x": 448, "y": 417, "id": 207}, {"k": "m", "x": 527, "y": 434, "id": 208}, {"k": "m", "x": 617, "y": 463, "id": 209}, {"k": "m", "x": 670, "y": 388, "id": 210}, {"k": "m", "x": 791, "y": 395, "id": 211}, {"k": "m", "x": 652, "y": 322, "id": 212}, {"k": "m", "x": 648, "y": 242, "id": 213}, {"k": "m", "x": 759, "y": 217, "id": 214}, {"k": "m", "x": 654, "y": 167, "id": 215}, {"k": "m", "x": 555, "y": 176, "id": 216}, {"k": "m", "x": 459, "y": 182, "id": 217}, {"k": "r", "x": 181, "y": 234, "id": 300}, {"k": "r", "x": 265, "y": 245, "id": 301}, {"k": "r", "x": 264, "y": 304, "id": 302}, {"k": "r", "x": 213, "y": 349, "id": 303}, {"k": "r", "x": 430, "y": 240, "id": 304}, {"k": "r", "x": 556, "y": 237, "id": 305}, {"k": "r", "x": 509, "y": 125, "id": 306}, {"k": "r", "x": 755, "y": 139, "id": 307}, {"k": "r", "x": 716, "y": 459, "id": 308}, {"k": "r", "x": 709, "y": 263, "id": 309}, {"k": "r", "x": 780, "y": 281, "id": 310}, {"k": "r", "x": 716, "y": 333, "id": 311}, {"k": "r", "x": 790, "y": 343, "id": 312}]}, "sta