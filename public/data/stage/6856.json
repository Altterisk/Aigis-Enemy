master_id": 31941, "global_id": 5560, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 63}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "change_to": 9, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31942, "global_id": 5561, "to_global_id": 5562, "spawn_sec": 92}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 4, "special_effect_id": 415, "change_to": 10, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31943, "global_id": 5562, "ranged": true, "to_global_id": 5563}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 10000, "attack": 450, "base_hp": 10000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "special_effect_id": 232, "change_to": 11, "master_id": 31944, "global_id": 5563, "to_global_id": 5564}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 10000, "attack": 200, "base_hp": 10000, "base_attack": 200, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106976, "race_id": 4, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 31945, "global_id": 5564, "ranged": true}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 96, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117280, "race_id": 4, "master_id": 31493, "global_id": 5112, "spawn_sec": 118}], "dialogue": [{"trigger": "start", "lines": [{"name": "迅雷の四天王", "text": "グハハハハ！\nこの里に大通連が隠されていることはお見通しだ！\n早く隠し場所を吐かぬと、たぬき鍋にしてやるぞ！", "face": "lfb551e44423c"}, {"name": "豪風の四天王", "text": "たぬきの脂身は食えたものではないぞ雷の。\nここはバラして串焼きにしてしまおう。", "face": "l211dcec59e4f"}, {"name": "妖狸", "text": "たぬぅぅぅぅぅっ！？\nボクは美味しくないぽんー！！\n長さまぁー！　助けてぽんー！！", "face": "lb11a98406858"}, {"name": "マオ", "text": "――迅雷の四天王に、豪風の四天王っ！！\n今すぐその子を離しなさい！！", "face": "u867"}, {"name": "豪風の四天王", "text": "むぅ？　何故化けだぬきの里に人間がいる。\n――ははぁ、さては妖狸の長よ、\n貴様人間に助けを求めに行ったな？", "face": "l211dcec59e4f"}, {"name": "迅雷の四天王", "text": "ハッ、人に助けを求めるとは妖怪の恥晒しよ！\n人を化かす者が、人に隷属するとはなァ！！\nそれに王子共もいい迷惑だろう！　グハハッ！", "face": "lfb551e44423c"}, {"name": "たぬきの里の長", "text": "た、たぬ……違うぽん……！\nマオさま達は、\nボクさま達を助けに来てくれたんだぽん……！！", "face": "u1019a1"}, {"name": "マオ", "text": "そうです。\n種族の違いが何だって言うんですか！", "face": "u867"}, {"name": "マオ", "text": "困ったことがあったときに助け合う関係は、\n隷属ではなく、仲間っていうんですよ！", "face": "u867"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "迅雷の四天王", "text": "グハハッ！　他の種族に頼らねば生きていけぬなら、\nそれを妖怪の恥晒しと呼んで何が悪い！", "face": "lfb551e44423c"}, {"name": "豪風の四天王", "text": "左様。宝剣の隠し場所も吐かぬ上、\n人間なぞに助けを求めるとは、\nもはや妖狸に生きる価値などありはしまい。", "face": "l211dcec59e4f"}, {"name": "迅雷の四天王", "text": "なれば王子の首共々、\n大嶽丸様への手土産としてやろう！\nグハハッ、ハハハハハハッ！！", "face": "lfb551e44423c"}, {"name": "たぬきの里の長", "text": "たぬっ、たぬぬぬっ！\nマオさま……ボクさま、悔しいぽん……っ。", "face": "u1019a1"}, {"name": "マオ", "text": "大丈夫、私も、王子もみんなの味方です！\n無理やり従わされている子達も、\nすぐに助け出してあげますからね……！", "face": "u867"}]}, {"trigger": "battle", "at_sec": 124, "lines": [{"name": "大嶽丸", "text": "……騒々しいぞ。\nようやく……二振り目の剣を取り戻したというのに……。", "face": "l5667c09dfe35"}, {"name": "豪風の四天王", "text": "おぉ、とうとう大通連を……！！\nやはりこの里に隠されておりましたか。", "face": "l211dcec59e4f"}, {"name": "妖狸", "text": "たぬぬ……ごめんなさい長さま……。\n皆を守るには、こうするしかなかったぽん……。", "face": "lb11a98406858"}, {"name": "迅雷の四天王", "text": "グハハ！　二振り目の宝剣を手にしたとなれば、\nもはや王子など敵ではないなァ！！", "face": "lfb551e44423c"}, {"name": "大嶽丸", "text": "むぅ……？\n迅雷の……王子が来ているのか……？\nクク……そうか……あの人間がいるのか……。", "face": "l5667c09dfe35"}, {"name": "大嶽丸", "text": "ならばまずは、姿を見ぬ内に\nどれだけ力を伸ばしたか……。\nクク……大通連を抜かずに相手をしてやろう……。", "face": "l5667c09dfe35"}, {"name": "マオ", "text": "王子、大嶽丸の金棒から、\n強力な魔力……いえ、気の流れを感じます！\n鎧では防げないかもしれませんよ……！", "face": "u867"}]}, {"trigger": "end", "lines": [{"name": "大嶽丸", "text": "ククク……負けた……負けたぞ迅雷の、豪風の！\nククッ、クハハハっ！！\n愉快……実に、実に愉快だ……！！", "face": "l5667c09dfe35"}, {"name": "マオ", "text": "慢心するからですっ！！\nさぁ里を解放し、投降してください！", "face": "u867"}, {"name": "大嶽丸", "text": "慢心……慢心か……ククク……。", "face": "l5667c09dfe35"}, {"name": "たぬきの里の長", "text": "な、何がおかしいぽん！\nマオさま達なら、お前なんて\nぽぽぽんのぽーん！　だぽん！", "face": "u1019a1"}, {"name": "大嶽丸", "text": "鬼とは支配する者に非ず……。\nただ暴れ、恐怖される者なれば……。", "face": "l5667c09dfe35"}, {"name": "大嶽丸", "text": "人を警戒すること自体が\n俺達にとっては些末なことよ……。", "face": "l5667c09dfe35"}, {"name": "大嶽丸", "text": "ただ、暴れ、奪い、喰らいつくすッ！！\nその暴虐を味わいたいというのなら、\n今ここで、二本目の宝剣を抜いてやろう……ッ！！", "face": "l5667c09dfe35"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "マオ", "text": "王子っ、大嶽丸の気がどんどん強くなっています！", "face": "u867"}, {"name": "たぬきの里の長", "text": "たぬぬぬっ！！\n大通連が……ご先祖様が封印した鬼の剣の封印が！\n解けてしまうぽん……っ！！", "face": "u1019a1"}]}], "active": true}