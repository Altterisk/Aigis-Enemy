{"quest_id": 6856, "name": "里を襲う豪風迅雷", "description": "妖狸の里へと駆け付けた王子たち。\n鬼の四天王に支配されし里を救わんと\n戦う一行の前に、鬼神大嶽丸が姿を現す。\n極級（★１獲得の目安：平均Lv25）", "event": "あやかし狸と浴衣の拳士", "event_category": "History", "mission_id": 920132, "map_no": 5511, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106976, "race_id": 4, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 559, "global_id": 558, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1200, "base_hp": 15000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105904, "race_id": 4, "special_effect_id": 232, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 30907, "global_id": 4526, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 18, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 16, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_at