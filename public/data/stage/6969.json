lobal_id": 5923, "to_global_id": 5910, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 27}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 39, "change_to": 6, "missile_id": 6, "master_id": 32291, "global_id": 5910, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 12, "form_count": 1, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121408, "special_effect_id": 308, "change_to": 9, "master_id": 32303, "global_id": 5922, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 54}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 39, "change_to": 6, "missile_id": 6, "master_id": 32291, "global_id": 5910, "ranged": true, "to_global_id": 5923, "spawn_sec": 101}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 7, "missile_id": 6, "master_id": 32304, "global_id": 5923}], "popups": ["2人の悪魔従業員は倒されると、\nその場で復活します。\n2回まで復活し、\n復活するたびに強くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デモンポーン", "text": "――どうしよぉぉっ！\nよわよわ王子どころか、お姉ちゃんまで来てたよぉ！", "face": "u997"}, {"name": "工場職員", "text": "まぁまぁ落ち着いて。\nほらチョコ食べます？　はい、あーん♪", "face": "u969"}, {"name": "デモンポーン", "text": "ぐすっ、たべりゅ……もぐもぐ……。\nはぁ、どうしようかなぁ。\nお仕事はしないとだけど、王子達と戦うのは……。", "face": "u997"}, {"name": "工場職員", "text": "まったく、ついこの間まで\n魔王軍として戦う仲だったのに、\nすっかり人間の王子に懐いてしまったんですねぇ。", "face": "u969"}, {"name": "デモンポーン", "text": "懐いてないし！\nあんなヘナチョコよわよわ王子！\n全然懐いてなんかいないから！！", "face": "u997"}, {"name": "工場職員", "text": "ふふふ、はいはい♪\nでもこれも、実は良い機会ではありませんか？\n実戦でこそ実力は見せられるものですし。", "face": "u969"}, {"name": "デモンポーン", "text": "な、なるほど……？\n言われてみればそのとおりかも……？", "face": "u997"}, {"name": "デモンポーン", "text": "ふふーん、そうと決まれば迎撃準備だね！\nまぁ所詮はよわよわ王子だし、工場をよく知る\n従業員のあたし達に勝つなんてぜ～ったい無理だもん♪", "face": "u997"}, {"name": "デーモンシェフ", "text": "――えぇい！　いつまで無駄話をしている！\n早く王子達を迎撃しろ！", "face": "l1cb44203deef"}, {"name": "デモンポーン", "text": "は～い♪\nあたし達の実力、見せつけてあげようね！", "face": "u997"}, {"name": "工場職員", "text": "はいはい、ボク達の\n仲の良さも一緒に見せつけてあげましょうね♪", "face": "u969"}]}, {"trigger": "start", "lines": [{"name": "シャルキー", "text": "――王子様、そろそろ工場の最深部です！\n何が出てくるか分かりませんし、\nしっかり警戒して進みましょうね。", "face": "u965"}, {"name": "デモンポーン", "text": "警戒なんて無駄無駄だよ♪\nあたし達ふたりの前じゃ、人間なんて\nざこざこのよわよわになっちゃうんだから♪", "face": "u997"}, {"name": "工場職員", "text": "そうそう。チョコよりあまーいボク達の可愛さで、\nめろめろにして、ぼっこぼこにしちゃいますね♪", "face": "u969"}, {"name": "シャルキー", "text": "な、何だかすごく煽ってきますよぉ……！？\n王子様、あんな挑発に負けないように、\n慎重に戦いましょうね！", "face": "u965"}, {"name": "ハルモニア", "text": "おや？　あの子は確か……。\n王子、あの魔術師の少女にはご注意を。", "face": "u941"}, {"name": "ハルモニア", "text": "幾度も蘇生する力と同時に、蘇生を重ねる毎に\n魔力を強大化する秘技を備えていたはずです。\n倒したからと油断しないようにしましょう。", "face": "u941"}]}, {"trigger": "end", "lines": [{"name": "デーモンシェフ", "text": "くっ……こいつらを使ってなお、\n王子達にとどめを刺すことはできないのか……！\nだが、次の事業では大成功してやるぞ……！！", "face": "l1cb44203deef"}, {"name": "シャルキー", "text": "あっ、待ちなさーい！！\n空を飛んでいくなんてずるいですよー！！", "face": "u965"}, {"name": "シャルキー", "text": "うぅぅ、王子様、\nデーモンシェフに逃げられてしまいました……。", "face": "u965"}, {"name": "工場職員", "text": "いたたた……さすがは魔王様を倒した王子ですね。\nこれは懐いちゃうのもわかります……。", "face": "u969"}, {"name": "デモンポーン", "text": "だから懐いてないし！\n――よ、よわよわ王子にしてはよくやったじゃない！\nでも、次は簡単にはいかないんだからね！！", "face": "u997"}, {"name": "シャルキー", "text": "……王子様、ハルモニアさん、\n追わなくて良いんですか？", "face": "u965"}, {"name": "ハルモニア", "text": "えぇ。あの子が大人になろうと足掻いているのを、\n私が抑えつけてしまってはいけませんから。\n我が主も、ご配慮ありがとうございます。", "face": "u941"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "シャルキー", "text": "王子様がそう言うなら……。\nともかく、これで事件も一段落、\n安心してチョコ作りができますね♪", "face": "u965"}, {"name": "アリス", "text": "ところで、シャルキーちゃんは\n誰にチョコをあげるんですか？", "face": "u589"}, {"name": "シャルキー", "text": "わっ、わわっ、アリスさん！\n分かってて言ってますよねー！？", "face": "u965"}, {"name": "アンナ", "text": "ふふっ、それでは王子、\nそろそろ王国へ帰還しましょうか。\n此度の遠征、お疲れさまでした！"}]}, {"trigger": "end", "lines": [{"name": "工場職員", "text": "（なるほどなぁ……これが王国、そして王子。\nボクの大事な友達を取られた気分だったけど、\n確かにこれなら、興味が出ちゃいますね）", "face": "u969"}, {"name": "工場職員", "text": "（ボクも物質界で生きていくしかないですし、\nまじめに働くのも飽きてきましたし、\nそろそろ人間のことを学んでも良いかもですね……）", "face": "u969"}]}], "story_talk": true, "active": true}