terval": 246, "move_speed": 300.0, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138224, "race_id": 5, "change_to": 55, "change_condition": 2, "master_id": 21387, "global_id": 1680, "to_condition": 2, "to_global_id": 1681, "spawn_sec": 111}, {"enemy_id": 55, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 39200, "attack": 1, "base_hp": 28000, "base_attack": 1, "damage_type": "magical", "armor_defense": 600, "magic_defense": 90, "attack_speed": 1, "attack_wait": 90, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2138240, "race_id": 5, "special_effect_id": 1086, "change_to": 56, "change_condition": 1, "master_id": 21388, "global_id": 1681, "from_condition": 2, "variants": [{"hp": 39200, "attack": 1, "base_hp": 28000, "base_attack": 1, "damage_type": "magical", "armor_defense": 600, "magic_defense": 90, "attack_speed": 1, "attack_wait": 90, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2138352, "race_id": 5, "special_effect_id": 1086, "master_id": 21389, "global_id": 1682}]}, {"enemy_id": 58, "source": "local", "count": 6, "form_count": 1, "hp": 14000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 149}, {"enemy_id": 59, "source": "local", "count": 3, "form_count": 1, "hp": 21000, "attack": 1400, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 159}, {"enemy_id": 60, "source": "local", "count": 4, "form_count": 1, "hp": 98000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 280, "attack_speed": 1, "attack_wait": 90, "attack_interval": 261, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1000, "pattern_id": 2138192, "race_id": 5, "special_effect_id": 86, "missile_id": 744, "missile": {"speed": 3.0}, "master_id": 21406, "global_id": 1699, "ranged": true, "spawn_sec": 174}, {"enemy_id": 61, "source": "local", "count": 3, "form_count": 1, "tags": ["機械"], "hp": 12600, "attack": 840, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 900, "attack_speed": 1, "attack_wait": 20, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2138208, "race_id": 5, "special_effect_id": 773, "master_id": 21384, "global_id": 1677, "spawn_sec": 261}], "dialogue": [{"trigger": "start", "lines": [{"name": "ウルカノ", "text": "──隠れ家って言う割には、普通の洞窟だな。\nお前、普段からこんなところに住んでんのかよ。", "face": "u1669a1"}, {"name": "ヒュープ", "text": "眠るには静かでいい場所だよ、\n魔神さえいなければの話だけどね。", "face": "u2336a1"}, {"name": "ヒュープ", "text": "それよりも油断しないように。\n見ての通り洞窟の中はこの広さだ、\nどこに敵が潜んでいるか分からない。", "face": "u2336a1"}, {"name": "アンリ", "text": "──ッ、ゴーレムの魔力反応近いです！　接敵間近！", "face": "u571"}, {"name": "ジェローム", "text": "こっちも同様、あの忌々しい鹿頭の匂いがします。", "face": "u62"}, {"name": "リオン", "text": "あの二体を同時に相手なんて、本当に悪夢だわ……。", "face": "u251"}, {"name": "ウズメ", "text": "叶うならば各個撃破をしたかったところですが、\nやはり二体は連携しながら動いているようですね。", "face": "u125"}, {"name": "アイシャ", "text": "反撃のフールフールと、反射のモラクスか。\nさて、ボクたちの戦術がどこまで通用するか……。", "face": "u181"}, {"name": "アルティア", "text": "──ナナリーさん、どうされました？", "face": "u261"}, {"name": "ナナリー", "text": "いえ、指に少し違和感があるような気がして……。", "face": "u29"}, {"name": "イリス", "text": "……気のせい、ではないかもしれません。\n洞窟の奥から魔界に似た瘴気が漂っています。", "face": "u17"}, {"name": "ヒュープ", "text": "少なくとも、この洞窟由来のものではないよ。\nおそらくは何処かに魔界の門が開かれているんだろう。\nこの島に魔神を呼び寄せた、何者かの手によってね。", "face": "u2336a1"}, {"name": "フローガ", "text": "そこから漏れ出た瘴気が魔神の魔力と混じり、\n洞窟内部を侵食しているということでしょうか？", "face": "u878"}, {"name": "ヒュープ", "text": "おおむねその通りだと思うよ。\nこのまま瘴気を放置すれば外部に溢れ出し、\nやがては島全体を覆ってしまうかもしれない。", "face": "u2336a1"}, {"name": "ディエーラ", "text": "レームノス島は世界でも随一となる工芸品の名産地、\nこの島の文化と伝統を失うわけにはいきません！", "face": "u538"}, {"name": "ウルカノ", "text": "上等だ、宝石野郎も鹿頭もまとめて材料にしてやらぁ！", "face": "u1669a1"}, {"name": "アンリ", "text": "行きましょう、王子。\nフールフールとの長き因縁、\nそしてモラクスの苦しみを──", "face": "u571"}, {"name": "アンリ", "text": "今ここで、終わらせるんです！", "face": "u571"}]}, {"trigger": "end", "lines": [{"name": "フローガ", "text": "フールフール沈黙！　モラクスも行動停止しました！", "face": "u878"}, {"name": "リオン", "text": "最後まで油断しない！　念には念を──", "face": "u251"}, {"name": "イリス", "text": "いいえ、もう終わりのようです。\nモラクスの身体が、崩壊して……。", "face": "u17"}, {"name": "アンリ", "text": "………………。", "face": "u571"}, {"name": "ヒュープ", "text": "人類の盾となった誇り高き魔神よ、\n君の永き夜はこのヒュープが預かる。", "face": "u2336a1"}, {"name": "ヒュープ", "text": "もう二度と、苦しみに目を覚ますこともない。\n今はただ安らかに、ゆっくりと眠りたまえ。", "face": "u2336a1"}, {"name": "アンリ", "text": "（さようなら、おとぎ話の優しい魔神──）", "face": "u571"}, {"name": "ジェローム", "text": "さて、フールフールの方ですが……。", "face": "u62"}, {"name": "ミネルバ", "text": "首を獲って柱にでも吊るそうかしら？", "face": "u91"}, {"name": "マーニー", "text": "怖いよ！？", "face": "u155"}, {"name": "ジェローム", "text": "首は冗談にしても、骨ぐらいは拾ってやりますかね。\n墓でも建てればちょっとした名所になるかもしれません。", "face": "u62"}, {"name": "トトノ", "text": "いい考えですね！　経済効果がありそうです！", "face": "u316"}, {"name": "ヒュープ", "text": "僕の島がうるさくなるのは困るんだけどね……。", "face": "u2336a1"}, {"name": "ウルカノ", "text": "お前の島ではねーだろ。", "face": "u1669a1"}, {"name": "フローガ", "text": "洞窟内部の瘴気も徐々に薄まっていますね、\n魔神が倒れて魔界の門も閉じられたようです。", "face": "u878"}, {"name": "シャルロット", "text": "つまり今回も一件落着、ですわね？", "face": "u128"}, {"name": "アンナ", "text": "無事に戦いを終えられてよかったです。\n今回もお疲れさまでした、王子。"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "アルティア", "text": "──モラクスに異変！　総員警戒態勢！", "face": "u261"}, {"name": "アンリ", "text": "あれは……千年戦争で最後に見せたという暴走状態！？", "face": "u571"}, {"name": "アンリ", "text": "今のモラクスに手を出してはいけません！\nありとあらゆる攻撃が跳ね返されてしまいます！", "face": "u571"}, {"name": "ウルカノ", "text": "はぁああっ！？　んなもんどうやって倒すんだよ！？", "face": "u1669a1"}, {"name": "アンリ", "text": "命を燃料に無理やり盾の力を増幅させているんです！\nあんな状態、長時間維持できるわけがありません！", "face": "u571"}, {"name": "アルティア", "text": "我々の全滅が先か、モラクスの自滅が先か。\nここからは我慢勝負というわけですか。", "face": "u261"}, {"name": "コーネリア", "text": "奴のためにも、私たちがここで死ぬわけにはいかんな。", "face": "u209"}, {"name": "ヒュープ", "text": "心を失いし悲しき魔神よ。\nせめてその散り際、ヒュープが見届けよう。", "face": "u2336a1"}]}, {"trigger": "route", "enemy_ids": [24], "lines": [{"name": "ジェローム", "text": "──ちっ、奴さんも本気になったようですね。", "face": "u62"}, {"name": "フローガ", "text": "新たな敵勢反応！　結晶の中から追加の眷属が出現！", "face": "u878"}, {"name": "リオン", "text": "はぁああ！？　あれも動くんなら最初に言いなさいよ！？", "face": "u251"}, {"name": "ジェローム", "text": "いいや、その場から動く気配はなさそうですね。\nとはいえ、じゃあ置物かっていうと──", "face": "u62"}, {"name": "アイシャ", "text": "うん、どうしてもあの目から視線を逸らせない。\nどういう原理なのか現時点では分からないけれど、\nまずはあの眷属を先に倒すしかなさそうだ。", "face": "u181"}, {"name": "ナナリー", "text": "ですが、例の如く反撃機能も持っていそうですよね……。", "face": "u29"}, {"name": "ジェローム", "text": "王子、難しい注文にはなりますが、\n火力の出し方には気を付けてくださいよ！", "face": "u62"}]}], "active": true}