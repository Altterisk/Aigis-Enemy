ge_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 22170, "global_id": 2453, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 18, "source": "local", "count": 26, "form_count": 2, "hp": 4500, "attack": 950, "base_hp": 4500, "base_attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 126, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159616, "race_id": 21, "change_to": 18, "change_condition": 4, "master_id": 38609, "global_id": 12226, "to_condition": 4, "to_ticks": 3, "to_global_id": 12229, "spawn_sec": 219}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "true", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 200, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159632, "race_id": 21, "special_effect_id": 1540, "master_id": 38612, "global_id": 12229, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 22, "source": "local", "count": 6, "form_count": 2, "hp": 12000, "attack": 1250, "base_hp": 12000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 126, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159648, "race_id": 20, "change_to": 22, "change_condition": 4, "master_id": 38613, "global_id": 12230, "to_condition": 4, "to_ticks": 3, "to_global_id": 12233, "spawn_sec": 260}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "true", "armor_defense": 350, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 200, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159664, "race_id": 20, "special_effect_id": 1540, "master_id": 38616, "global_id": 12233, "from_condition": 4, "trigger_ticks": 3}], "popups": ["カルペムの\n攻撃を受けた味方ユニットは\n3秒間、防御力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。\n　　　　　　(1/2)", "カルペムから\n攻撃を複数回受けると、\n麻痺状態になります。\n\n\n\n\n　　　　　　(2/2)", "冥界のケルベロス、\n冥界のウルフは、\n倒されると黒炎に変化します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ホルミース", "text": "この異常事態の原因は、\n『タルタロス』の門が開かれつつあることにあります。", "face": "u2292a1"}, {"name": "メーア", "text": "たるたる……？", "face": "u2404a1"}, {"name": "ホルミース", "text": "タルタロスです。\n要塞宮殿――いえ、終焉要塞ゼウスのように、\n世界に滅びをもたらしうる遺構のひとつ。", "face": "u2292a1"}, {"name": "ティルト", "text": "ヘカティエ様、ご存知ですか？", "face": "u1705a1"}, {"name": "ヘカティエ", "text": "名前だけはね。\nただ、本当に古いおとぎ話よ。\n冥界の神々であっても、実在を否定する類の。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "でも、そんなものが存在するなら、\nこの放出される膨大な魔力量で\n私がすぐに気付いたはずよ？", "face": "u1226a1"}, {"name": "ホルミース", "text": "それはそうでしょう。\n何しろ、魔力の一欠片とて零れ落ちないよう、\n厳重に封印されていた場所だそうですから。", "face": "u2292a1"}, {"name": "ホルミース", "text": "要塞宮殿のデータベースにも、\nごくわずかな記述しか存在しませんでしたが――", "face": "u2292a1"}, {"name": "ホルミース", "text": "――曰く、\n暗黒の奈落、無限の回廊、滅びをもたらすもの、\nある存在が封印された、開いてはならぬ扉。", "face": "u2292a1"}, {"name": "アンナ", "text": "終焉要塞ゼウスに並ぶ規模の、\n世界の滅びをもたらす兵器ということですか？"}, {"name": "ホルミース", "text": "さぁ、兵器であるとはどこにも……。\n中から何かが出てくるのか、\n膨大な魔力量で何もかも消し飛ばしてしまうのか。", "face": "u2292a1"}, {"name": "ホルミース", "text": "ともあれ、この冥界による侵食は、\nタルタロスの解放が始まり、\n冥界がこちらへ溢れ出しつつあるのが原因でしょう。", "face": "u2292a1"}, {"name": "ユリクセス", "text": "放っておけば、物質界はまず冥界に呑まれ、\n続けてタルタロスに呑まれ、\n何もかもがおしまい、ということか。", "face": "u2193a1"}, {"name": "ヴァルデ", "text": "その予想が事実だとして、どうやって乗り込むんだ？\n場所が分からないと、突撃しようもないぞ？", "face": "u2403a1"}, {"name": "アキレア", "text": "……それなら、敵将に聞けばいい。\nおあつらえ向きに、自分から出てきた奴がいるぜ？", "face": "u1972a1"}, {"name": "？？？", "text": "…………。", "face": "u2401a1"}, {"name": "レオナ", "text": "どうやら、あちらも一戦交えるつもりらしい。\n総員、戦闘準備！\n目標は敵将、あの竜人の少女だ！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "…………。", "face": "u2401a1"}, {"name": "ハイデマリー", "text": "素早い……！\n包囲を抜けられる！", "face": "u1704a1"}, {"name": "ヴルム", "text": "……なんだろ。何だか変な感じ。\nハイドースの配下にしては、敵意を感じない。", "face": "u527"}, {"name": "ジークリンデ", "text": "殺すつもりだが、死んでもらっては困る、\nとでも思っているような戦いぶりだな。", "face": "u429"}, {"name": "ラビリス", "text": "めんどくさい奴だな……。\n叩き潰してから何を言いたいのか訊いた方が早そうだ。", "face": "u2087a1"}, {"name": "サザンカ", "text": "ん……？\n聞き出すんじゃなくて、言いたいことを訊く……？", "face": "u1347a1"}, {"name": "ハリナ", "text": "あやつの戦いぶりは、こちらを試すものだ。\n裏切り先を探しているのか、\n他の理由があるのかは分からぬがな。", "face": "u988"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "白の皇帝", "text": "ああ、この場は任せる。\n冥界軍の相手は頼んだ。", "face": "u418"}, {"name": "白の皇帝", "text": "何人か、俺について来い。\nあの竜人の真意を問う。", "face": "u418"}, {"name": "レオナ", "text": "危険です、陛下！", "face": "u311"}, {"name": "白の皇帝", "text": "あの瞳には、見覚えがある。\n大切な何かを背負い、彷徨う者の目だ。", "face": "u418"}, {"name": "白の皇帝", "text": "受け止めるならば、俺が最適だろう。", "face": "u418"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 11, "params": [200]}], "enemies": [{"enemy_id": 1, "hp": 156000, "attack": 2250, "damage_type": "physical", "armor_defense": 800, "magic_defense": 40, "pattern_id": 2159680}, {"enemy_id": 2, "hp": 26000, "attack": 455, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128624}, {"enemy_id": 2, "form_index": 1, "hp": 26000, "attack": 910, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128640}, {"enemy_id": 6, "hp": 9750, "attack": 7