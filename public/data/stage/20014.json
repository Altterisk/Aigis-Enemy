transform_resist": 100, "pattern_id": 2172464, "race_id": 16, "special_effect_id": 2497, "change_to": 7, "change_condition": 1, "missile_id": 1689, "missile": {"speed": 12.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 180, "attack_interval_f": 180, "effect_name": "HitEffectSlow"}}, "master_id": 41050, "ranged": true, "variants": [{"tags": ["式神"], "hp": 378000, "attack": 3350, "base_hp": 378000, "base_attack": 3350, "damage_type": "physical", "armor_defense": 360, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 182, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2172480, "race_id": 16, "master_id": 41051}], "spawn_sec": 123}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 2, "hp": 27000, "attack": 850, "base_hp": 27000, "base_attack": 850, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 1, "attack_wait": 45, "attack_interval": 140, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2171872, "race_id": 4, "change_to": 9, "change_condition": 3, "master_id": 41058, "to_condition": 3, "spawn_sec": 181}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 27000, "attack": 650, "base_hp": 27000, "base_attack": 650, "damage_type": "magical", "armor_defense": 400, "magic_defense": 15, "attack_range": 160, "attack_speed": 1, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2171888, "race_id": 4, "missile_id": 683, "missile": {"speed": 8.0, "on_hit": {"kind": "DOT", "duration_f": 360, "interval_f": 30, "flat": 35, "expire_duration_only": true, "effect_name": "DebuffEffectMagma"}}, "master_id": 41059, "ranged": true, "from_condition": 3}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 55000, "attack": 1250, "base_hp": 55000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 650, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099360, "race_id": 4, "master_id": 39542, "global_id": 13159, "spawn_sec": 311}], "popups": ["武闘派の陰陽師から\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\n\nまた武闘派の陰陽師は\nブロックされていない間、\n味方ユニットから受ける\n全てのダメージを50％軽減します。", "熱くなった鳴釜から\n攻撃を受けると\n「マグマ付着」状態になります。\nマグマ付着によるダメージは、\n女神の加護やユニットの\n能力によって軽減、解除する\nことができません。\n　　　　　　(1/2)", "　 　　【マグマ付着】\n・攻撃を受けると徐々にHPが減少\n\n・複数の敵から攻撃を受けた\n　場合、継続ダメージ効果が重複\n\n・一定時間の経過でのみ解除可能\n　　　　　　(2/2)", "決勝戦が\n解放されました。\n\n緊急ミッション画面右下にある\n決勝ミッションのメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "兵部省の陰陽師", "text": "──止まれ、何者か。", "face": "l17ba454a069a"}, {"name": "ノリモチ", "text": "ぼく！　ぼくだよ！", "face": "u2881a1"}, {"name": "兵部省の陰陽師", "text": "ああ、兵部卿でしたか。\n夜分遅くまでお疲れ様です。\nこんな時間にどうされました？", "face": "l17ba454a069a"}, {"name": "ノリモチ", "text": "いやー、ドウマン様から明日朝一で\nヨシノの追撃隊を出せって言われてさ。", "face": "u2881a1"}, {"name": "ノリモチ", "text": "今から徹夜で準備だよ、トホホ……。", "face": "u2881a1"}, {"name": "兵部省の陰陽師", "text": "あー、それは大変ですね。\nドウマン様も人使いが荒い。", "face": "l17ba454a069a"}, {"name": "ノリモチ", "text": "それだけ期待されてるってことだと思うようにするよ。", "face": "u2881a1"}, {"name": "兵部省の陰陽師", "text": "はは、頑張ってください。応援してますよ。", "face": "l17ba454a069a"}, {"name": "ノリモチ", "text": "うん、ありがとう──それと、ごめんね？", "face": "u2881a1"}, {"name": "チヨメ", "text": "はい、チクっとしますよー。", "face": "u1144a1"}, {"name": "兵部省の陰陽師", "text": "えっ──", "face": "l17ba454a069a"}, {"name": "ヨシノ", "text": "よーし、潜入完了！", "face": "u1104a1"}, {"name": "シズカ", "text": "夜中に大内裏へ忍び込むなんて、バレたら打ち首ね。", "face": "u101"}, {"name": "ジュウベエ", "text": "ここから何を探すのですか？", "face": "u699"}, {"name": "ヨシノ", "text": "今後一週間の帝やドウマンの予定に関連するもの。\nとりあえず手当たり次第にね、内容は私が判断する。", "face": "u1104a1"}, {"name": "ジュウベエ", "text": "承知。", "face": "u699"}, {"name": "ポミエ", "text": "あの、敵に見つかったら？", "face": "u1099a1"}, {"name": "ヨシノ", "text": "殺さない程度に眠らせて、処理はチヨメがする。", "face": "u1104a1"}, {"name": "ノリモチ", "text": "うっうっ、公家のご先祖様ごめんなさい……。", "face": "u2881a1"}, {"name": "ヨシノ", "text": "大丈夫大丈夫、武家で面倒見てあげるからねー。", "face": "u1104a1"}, {"name": "陰陽師", "text": "貴様ら、何をして──", "face": "l17ba454a069a"}, {"name": "チヨメ", "text": "おやすみなさーい！", "face": "u1144a1"}, {"name": "ヨシノ", "text": "さーて、行動開始！", "face": "u1104a1"}]}, {"trigger": "end", "lines": [{"name": "ジュウベエ", "text": "──ヨシノ殿、こちらはどうでしょう？", "face": "u699"}, {"name": "ヨシノ", "text": "……うん、いい感じの情報だね。\nこれだけあればドウマンの動きを割り出せる。\n重要な部分だけ写し取って、元の場所に戻そう。", "face": "u1104a1"}, {"name": "シズカ", "text": "で、この現場をどうするかだけど。", "face": "u101"}, {"name": "サクラ", "text": "死屍累々ですね……。", "face": "u1170a1"}, {"name": "チェルシー", "text": "事前に結界を張っておいたので、\n音は外部に漏れていないはずです。\n師匠の術には遠く及びませんが──", "face": "u2369a1"}, {"name": "ヨシノ", "text": "チェルシーちゃん偉い！　百年無税！", "face": "u1104a1"}, {"name": "シズカ", "text": "そもそもうちの子じゃないわよ。", "face": "u101"}, {"name": "チヨメ", "text": "ではでは、まず倒れている方々にこの針を打ちます。", "face": "u1144a1"}, {"name": "シンディ", "text": "それは？", "face": "u1098a1"}, {"name": "チヨメ", "text": "王国で仕入れた直近三刻の記憶が飛ぶ魔法の針です。\nそして現場にお酒の徳利やおつまみを散乱させてから、\n不自然にならないよう適当にこうこうこうすると──", "face": "u1144a1"}, {"name": "チヨメ", "text": "酔って大喧嘩になり全員気絶した宴会場の完成です。", "face": "u1144a1"}, {"name": "シズカ", "text": "あらすご……いや、さすがに誤魔化しきれないでしょ。", "face": "u101"}, {"name": "ヨシノ", "text": "少しの間だけでも情報を撹乱できるだけで上々だよ。", "face": "u1104a1"}, {"name": "ノリモチ", "text": "大罪だ、逆賊だ、ぼくはもう終わりなんだぁ……。", "face": "u2881a1"}, {"name": "ノリモチの側近A", "text": "まあまあ、どうせ御上に使い潰されるのがオチでしたよ。", "face": "l040cea8008c4"}, {"name": "ノリモチの側近B", "text": "公家文化に憧れるのは結構ですけどね、\n腹芸のできない殿には朝廷は無理です。", "face": "l040cea8008c4"}, {"name": "ノリモチ", "text": "ひん！", "face": "u2881a1"}, {"name": "ヨシノ", "text": "よしよし、それじゃあ帰んべ帰んべ。", "face": "u1104a1"}]}], "active": true}