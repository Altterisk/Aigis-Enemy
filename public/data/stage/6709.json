: 2103792, "race_id": 2, "missile_id": 39, "missile": {"splash": 133}, "master_id": 31576, "global_id": 5195, "ranged": true, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 15, "level": 80, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 30}, {"enemy_id": 5, "source": "local", "count": 7, "level": 80, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 70, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104096, "race_id": 3, "master_id": 498, "global_id": 497, "spawn_sec": 66}, {"enemy_id": 6, "source": "local", "count": 3, "level": 80, "form_count": 1, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 42, "global_id": 41, "ranged": true, "spawn_sec": 75}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 11000, "attack": 350, "base_hp": 11000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114288, "race_id": 16, "master_id": 30960, "global_id": 4579, "spawn_sec": 116}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 448, "global_id": 447, "ranged": true, "spawn_sec": 158}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 200, "base_hp": 4500, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_range": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105376, "race_id": 16, "special_effect_id": 72, "change_to": 9, "change_condition": 2, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 639, "global_id": 638, "ranged": true, "spawn_sec": 192}], "popups": ["　　　　【魔界の瘴気】\n攻撃力と防御力が低下します。\n王子【神器装備】王子【ケラウノス】\n皇帝を配置すると攻撃力と防御力の\n低下について無効化することが\nできます。\n一部ユニットも無効化できます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マンモン", "text": "――ほらほら、こっちですよ♪\n金銀財宝ざっくざく～♪", "face": "u767"}, {"name": "モーティマ", "text": "――ちぃっ、瘴気のせいで身体が重いぜ。\nおいマンモン、本当に財宝を蓄えたドラゴンが\nこの辺にいるんだろうなっ！？", "face": "u14"}, {"name": "マンモン", "text": "もちろんです。\nこの先に山程財宝を蓄えた、\n巨大なドラゴンが待っていますからね♪", "face": "u767"}, {"name": "モーティマ", "text": "今後の軍資金になるからって、\n王子達を無理やり説得したんだからな。\nそこんとこ、しっかり頼むぜ？", "face": "u14"}, {"name": "レダ", "text": "そうそう、王子の戦いはまだまだ続くんだから、\nお宝いっぱいゲットして助けてあげなくちゃね♪", "face": "u254"}, {"name": "兵士", "text": "――王子、斥候がこの先で、\nドラゴンの群れを発見したそうです！", "face": "u6"}, {"name": "モーティマ", "text": "よぉし、来やがったな！\n王子、お宝ブン取ってやろうぜ！", "face": "u14"}, {"name": "レダ", "text": "あぁっ、モーティマなんかに負けないんだから！\n王子が持ちきれないくらい、\n財宝を手に入れなくっちゃ！", "face": "u254"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "……けれど、相手はドラゴンです。\n何より魔界の瘴気の中での戦いですから……。\n絶対に油断はしないでくださいね？", "face": "lf7b6129804c2"}]}, {"trigger": "end", "lines": [{"name": "モーティマ", "text": "よぉーし、ドラゴンをぶちのめしてやったぜ。\nさぁてお宝お宝っと……。", "face": "u14"}, {"name": "レダ", "text": "あれ……？　おかしいなぁ……。\nどこにも財宝なんて見当たらないんだけど……。", "face": "u254"}, {"name": "マンモン", "text": "あら、あらあら……？\nどうしましょう、もしかして……。", "face": "u767"}, {"name": "ケイティ", "text": "財宝を求めて寄ってくる者を食う為の、\n罠だった……ということでしょうか……。", "face": "u114"}, {"name": "レダ", "text": "そんなぁ……っ！？\nせっかく頑張って来たのにぃ！？", "face": "u254"}, {"name": "マンモン", "text": "あは、あはは……うぅぅぅ……。\nご、ごめんなさいぃ……。", "face": "u767"}, {"name": "フィリス", "text": "それにしても、こんなドラゴンが\n魔界にいたなんて、ちょっと驚いたな。\n今後は警戒が必要かもしれないぞ……。", "face": "u40"}, {"name": "マンモン", "text": "うぅぅ……ぐすっ……ふぇっ？\nあっ、魔界にはもっと強い生き物が\nいーっぱいいますよ……？", "face": "u767"}, {"name": "フィリス", "text": "な、なんだって？\nこれより強い魔物までいるのか！？", "face": "u40"}, {"name": "ケイティ", "text": "財宝のことはともかく、\n魔界に棲息する魔物の強さは底が知れませんね……。\nその一端を垣間見れたことが、今回の収穫でしょう。", "face": "u114"}, {"name": "レダ", "text": "はぁ……そういうことにしておこっか。\nごめんね王子、危険な目に遭わせちゃって。", "face": "u254"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "アンナ", "text": "それでは、他の魔物に見つかる前に、\n王国へ帰還しましょうか。"}]}], "active": true}