"magic_defense": 10, "attack_speed": 1, "attack_wait": 17, "attack_interval": 62, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110816, "race_id": 16, "master_id": 30414, "global_id": 4033, "spawn_sec": 68}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 1, "attack_wait": 33, "attack_interval": 128, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 70, "change_to": 5, "change_condition": 5, "master_id": 30401, "global_id": 4020, "to_condition": 5, "to_global_id": 4021, "spawn_sec": 112}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 230, "attack_speed": 1, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30402, "global_id": 4021, "ranged": true, "from_condition": 5}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 2, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 70, "attack_wait": 33, "attack_interval": 197, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 70, "change_to": 7, "change_condition": 5, "master_id": 30403, "global_id": 4022, "to_condition": 5, "to_global_id": 4023, "spawn_sec": 124}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 220, "attack_speed": 70, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30404, "global_id": 4023, "ranged": true, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "フィリス", "text": "よしっ。\nここの櫓も完成だ。みんな、お疲れ様。", "face": "u506"}, {"name": "兵士", "text": "はい！　勢いで４つも作ってしまいましたね。", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "あぁ、これなら王子もびっくりするだろうな。", "face": "u506"}, {"name": "セノーテ", "text": "フィリスさ～ん、水かけ大会の会場は\nこちらになったのですか？", "face": "u1502"}, {"name": "フィリス", "text": "セノーテ、来てくれたか。\n川が近くに流れてるから丁度良いと思ったのだが。\n……ここで大丈夫だろうか？", "face": "u506"}, {"name": "セノーテ", "text": "バッチリです！\nお水さん達の声も、沢山聞こえます！", "face": "u1502"}, {"name": "フィリス", "text": "そうか、それなら良かった。それじゃ、\nリハーサルは私とセノーテでやっておくから、\nみんなは先に帰ってていいぞ。", "face": "u506"}, {"name": "兵士", "text": "自分たちもお付き合いします！\nえっと……櫓作りで汗をかいたので、\n水を頭からかぶりたい気分なんです！", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "みんな、気持ちは嬉しいが無理は禁物だぞ。\n疲れてる時はしっかり休まないと……。", "face": "u506"}, {"name": "兵士", "text": "セノーテさん、\n自分たちは奥で待っていますから、\n沢山の水をお願いします！", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "お、おい、お前たち！\n行ってしまった……。\n無理してるんじゃないか……。", "face": "u506"}, {"name": "アンナ", "text": "――王子、こちらが水かけ大会の会場のようです。\nセノーテさんと水霊の舞いで、見る人の心を\n涼やかにしてくれる納涼のお祭りとの事ですよ。", "face": "lf5ef35ae91ca"}, {"name": "フィリス", "text": "王子！　ちょうどいい所に来てくれたな。良ければ、\n水かけ祭りのリハーサルに参加してはくれないか。\n兵の者達につき合わせるのは、忍びなくて……。", "face": "u506"}, {"name": "セノーテ", "text": "一般の方にも舞にご参加頂こうと思っているのですが、\nお怪我などがあっては大変ですので。練習をして\nおきたいと思うのですが……ダメでしょうか？", "face": "u1502"}, {"name": "アンナ", "text": "いえ、構いませんよ。王子、しっかりと汗をかいて、\n涼んできてください！　応援しています！"}]}, {"trigger": "end", "lines": [{"name": "セノーテ", "text": "王子さま、\n水かけ祭りのリハーサル、お疲れ様でした。\nどうでしょう、涼しくなれましたでしょうか？", "face": "u1502"}, {"name": "フィリス", "text": "付き合ってくれてありがとう、王子。\nおかげで兵の者達を休ませることが出来たよ。", "face": "u506"}, {"name": "兵士", "text": "フィリスさん、私達に頼ってくれても……\n……いえ、我々の力不足が原因ですね。", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "そ、そうじゃない！　みんなで櫓を完成させたように、\n力を合わせるのが大切なんだ。その為にも無理は\nしないでほしいんだ。怪我人がでないように……。", "face": "u506"}, {"name": "アンナ", "text": "お祭りの準備は着々と進んでいるようですね。\nこれもフィリスさんと皆さんが、力を合わせた賜物です。"}, {"name": "アンナ", "text": "ですが、お祭りの本番はまだまだこれからです。\nこれだけ立派な櫓を立てたんです、怪我でお祭りに\n参加できないなんて事になれば、元も子もありません！", "face": "lf5ef35ae91ca"}, {"name": "フィリス", "text": "ああそうだ、\n私は皆と共にお祭りを楽しみたいんだ。\n……だから、無理はしないと約束してくれ。", "face": "u506"}, {"name": "兵士", "text": "フィリスさん……はい！\n心遣い、ありがとうございます！", "face": "l8bd3049f618e"}, {"name": "兵士", "text": "これからは無理せず、\n力を合わせて物事に当たっていきます。\n王子、フィリスさん、改めてありがとうございました！", "face": "l8bd3049f618e"}]}], "active": true}