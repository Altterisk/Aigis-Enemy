{"quest_id": 6166, "name": "水かけ大会準備", "description": "セノーテと水霊による納涼の舞い。\n来る水かけ祭り本番に備え、\n予行演習をやり遂げよ！！\n上級（★１獲得の目安：平均Lv10）", "event": "王子軍の夏祭り", "event_category": "History", "mission_id": 920093, "map_no": 3246, "level": 100, "multiplier": 1.0, "charisma": 65, "exp": 360, "gold": 1500, "drops": [{"card": 506, "c": 1}, {"card": 24, "c": 1}, {"card": 8, "c": 1}, {"item": 1001, "c": 2}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 7000, "base_hp": 7000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111040, "race_id": 16, "special_effect_id": 266, "master_id": 30415, "global_id": 4034, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 25, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 80, "base_hp": 3000, "base_attack": 80, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 1, "attack_wait": 33, "attack_interval": 128, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 70, "change_to": 2, "change_condition": 5, "master_id": 30399, "global_id": 4018, "phases": [{"hp": 3000, "attack": 80, "base_hp": 3000, "base_attack": 80, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 200, "attack_speed": 1, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30400, "global_id": 4019, "ranged": true, "condition": 5}], "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 8500, "attack": 300, "base_hp": 8500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 17, "attack_interval": 62, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110816, "race_id": 16, "master_id": 30414, "global_id": 4033, "spawn_sec": 68}, {"enemy_id": 5, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 1, "attack_wait": 33, "attack_interval": 128, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 70, "change_to": 5, "change_condition": 5, "master_id": 30401, "global_id": 4020, "phases": [{"hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 230, "attack_speed": 1, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30402, "global_id": 4021, "ranged": true, "condition": 5}], "spawn_sec": 112}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 70, "attack_wait": 33, "attack_interval": 197, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 70, "change_to": 7, "change_condition": 5, "master_id": 30403, "global_id": 4022, "phases": [{"hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 220, "attack_speed": 70, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30404, "global_id": 4023, "ranged": true, "condition": 5}], "spawn_sec": 124}], "dialogue": [{"trigger": "start", "lines": [{"name": "フィリス", "text": "よしっ。\nここの櫓も完成だ。みんな、お疲れ様。", "face": "u506"}, {"name": "兵士", "text": "はい！　勢いで４つも作ってしまいましたね。", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "あぁ、これなら王子もびっくりするだろうな。", "face": "u506"}, {"name": "セノーテ", "text": "フィリスさ～ん、水かけ大会の会場は\nこちらになったのですか？", "face": "u1502"}, {"name": "フィリス", "text": "セノーテ、来てくれたか。\n川が近くに流れてるから丁度良いと思ったのだが。\n……ここで大丈夫だろうか？", "face": "u506"}, {"name": "セノーテ", "text": "バッチリです！\nお水さん達の声も、沢山聞こえます！", "face": "u1502"}, {"name": "フィリス", "text": "そうか、それなら良かった。それじゃ、\nリハーサルは私とセノーテでやっておくから、\nみんなは先に帰ってていいぞ。", "face": "u506"}, {"name": "兵士", "text": "自分たちもお付き合いします！\nえっと……櫓作りで汗をかいたので、\n水を頭からかぶりたい気分なんです！", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "みんな、気持ちは嬉しいが無理は禁物だぞ。\n疲れてる時はしっかり休まないと……。", "face": "u506"}, {"name": "兵士", "text": "セノーテさん、\n自分たちは奥で待っていますから、\n沢山の水をお願いします！", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "お、おい、お前たち！\n行ってしまった……。\n無理してるんじゃないか……。", "face": "u506"}, {"name": "アンナ", "text": "――王子、こちらが水かけ大会の会場のようです。\nセノーテさんと水霊の舞いで、見る人の心を\n涼やかにしてくれる納涼のお祭りとの事ですよ。", "face": "l148a1a15f382"}, {"name": "フィリス", "text": "王子！　ちょうどいい所に来てくれたな。良ければ、\n水かけ祭りのリハーサルに参加してはくれないか。\n兵の者達につき合わせるのは、忍びなくて……。", "face": "u506"}, {"name": "セノーテ", "text": "一般の方にも舞にご参加頂こうと思っているのですが、\nお怪我などがあっては大変ですので。練習をして\nおきたいと思うのですが……ダメでしょうか？", "face": "u1502"}, {"name": "アンナ", "text": "いえ、構いませんよ。王子、しっかりと汗をかいて、\n涼んできてください！　応援しています！"}]}, {"trigger": "end", "lines": [{"name": "セノーテ", "text": "王子さま、\n水かけ祭りのリハーサル、お疲れ様でした。\nどうでしょう、涼しくなれましたでしょうか？", "face": "u1502"}, {"name": "フィリス", "text": "付き合ってくれてありがとう、王子。\nおかげで兵の者達を休ませることが出来たよ。", "face": "u506"}, {"name": "兵士", "text": "フィリスさん、私達に頼ってくれても……\n……いえ、我々の力不足が原因ですね。", "face": "l8bd3049f618e"}, {"name": "フィリス", "text": "そ、そうじゃない！　みんなで櫓を完成させたように、\n力を合わせるのが大切なんだ。その為にも無理は\nしないでほしいんだ。怪我人がでないように……。", "face": "u506"}, {"name": "アンナ", "text": "お祭りの準備は着々と進んでいるようですね。\nこれもフィリスさんと皆さんが、力を合わせた賜物です。"}, {"name": "アンナ", "text": "ですが、お祭りの本番はまだまだこれからです。\nこれだけ立派な櫓を立てたんです、怪我でお祭りに\n参加できないなんて事になれば、元も子もありません！", "face": "l148a1a15f382"}, {"name": "フィリス", "text": "ああそうだ、\n私は皆と共にお祭りを楽しみたいんだ。\n……だから、無理はしないと約束してくれ。", "face": "u506"}, {"name": "兵士", "text": "フィリスさん……はい！\n心遣い、ありがとうございます！", "face": "l8bd3049f618e"}, {"name": "兵士", "text": "これからは無理せず、\n力を合わせて物事に当たっていきます。\n王子、フィリスさん、改めてありがとうございました！", "face": "l8bd3049f618e"}]}], "map": {"image": "Map920093_3246", "w": 960, "h": 640, "spots": [{"k": "b", "x": 22, "y": 309}, {"k": "m", "x": 703, "y": 412, "id": 200}, {"k": "m", "x": 738, "y": 252, "id": 201}, {"k": "m", "x": 571, "y": 317, "id": 202}, {"k": "m", "x": 603, "y": 234, "id": 203}, {"k": "m", "x": 517, "y": 204, "id": 204}, {"k": "m", "x": 428, "y": 188, "id": 205}, {"k": "m", "x": 263, "y": 225, "id": 206}, {"k": "m", "x": 616, "y": 406, "id": 207}, {"k": "m", "x": 451, "y": 428, "id": 208}, {"k": "m", "x": 360, "y": 417, "id": 209}, {"k": "m", "x": 273, "y": 383, "id": 210}, {"k": "m", "x": 236, "y": 310, "id": 211}, {"k": "m", "x": 537, "y": 400, "id": 212}, {"k": "m", "x": 872, "y": 248, "id": 213}, {"k": "m", "x": 814, "y": 422, "id": 214}, {"k": "m", "x": 881, "y": 335, "id": 215}, {"k": "m", "x": 342, "y": 187, "id": 216}, {"k": "m", "x": 146, "y": 294, "id": 217}, {"k": "r", "x": 645, "y": 330, "id": 300}, {"k": "r", "x": 812, "y": 332, "id": 301}, {"k": "r", "x": 482, "y": 246, "id": 302}, {"k": "r", "x": 334, "y": 344, "id": 303}, {"k": "r", "x": 516, "y": 153, "id": 304}, {"k": "r", "x": 433, "y": 136, "id": 305}, {"k": "r", "x": 338, "y": 133, "id": 306}, {"k": "r", "x": 250, "y": 154, "id": 307}, {"k": "r", "x": 192, "y": 209, "id": 308}, {"k": "r", "x": 468, "y": 479, "id": 309}, {"k": "r", "x": 304, "y": 470, "id": 310}, {"k": "r", "x": 189, "y": 384, "id": 311}, {"k": "r", "x": 119, "y": 190, "id": 312}, {"k": "r", "x": 488, "y": 338, "id": 313}, {"k": "r", "x": 324, "y": 250, "id": 314}]}, "start_cost": 10, "active": true}