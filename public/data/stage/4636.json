id": 604, "global_id": 603, "phases": [{"hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "master_id": 605, "global_id": 604, "condition": 5}], "spawn_sec": 107}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "change_to": 8, "master_id": 844, "global_id": 843, "to_condition": 0, "to_global_id": 603, "route_behaviour": {"transforms": [{"wait": 20}]}, "spawn_sec": 198}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105152, "race_id": 14, "change_to": 9, "change_condition": 5, "master_id": 604, "global_id": 603, "from_condition": 0, "phases": [{"hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "master_id": 605, "global_id": 604, "condition": 5}]}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "申し訳ありません、王子。\n妖虎仙を追いかけていましたが、\nどうやら道に迷ってしまったようです。", "face": "l68d23b557d5d"}, {"name": "ケイティ", "text": "これ以上無闇に進んでも意味が\nありませんね……どうしたらいいのでしょうか。", "face": "u114"}, {"name": "？？？", "text": "何やらお困りのようですなぁ……。\n妖虎仙がどうのと口にしていたようじゃが、もしや\n先程ここを通った妖虎仙を追っておるのかな？", "face": "lac467bfee065"}, {"name": "アンナ", "text": "あなたはいったい……。\nいえ、それよりも妖虎仙を見かけたのですか？", "face": "l68d23b557d5d"}, {"name": "？？？", "text": "ああ、しかとこの目でな。\n……なるほど、どうやら本当に\n妖虎仙を追う者たちというわけか。", "face": "lac467bfee065"}, {"name": "？？？", "text": "ならば、あちらの方角へ向かうといい。", "face": "lac467bfee065"}, {"name": "？？？", "text": "あの道の先に妖虎仙に滅ぼされた街がある。\nそこが妖虎仙の領地となっているのじゃ……。\n向かうのであれば、気をつけて進まれよ。", "face": "lac467bfee065"}, {"name": "アンナ", "text": "妖虎仙の領地……。\n王子、急いでその街へ向かいましょう！", "face": "l68d23b557d5d"}, {"name": "兵士", "text": "伝令！\n斥候部隊が敵影を確認しました！\nどうやら、妖虎のようです！", "face": "ld2df2dded702"}, {"name": "妖虎", "text": "――グルルル……。\n街へは向かわせん。\nこれ以上、妖虎仙様の邪魔はさせぬぞ！", "face": "l2a0e420b13d8"}, {"name": "アンナ", "text": "どうやら私達の追撃を退ける為の\n後陣のようですね。\n王子、戦いの準備をお願い致します！", "face": "l68d23b557d5d"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "王子、お見事です。\n無事に敵を退けることができたようですね！"}, {"name": "？？？", "text": "ほぉ、おぬしらは随分と強いのじゃなぁ……。\nこれなら妖虎仙から街を救えるかもしれんのぉ。", "face": "lac467bfee065"}, {"name": "ケイティ", "text": "お爺さん、これより私達は街に向かいます。\n帰途に不安があれば、\n護衛をつけますが、どうしますか？", "face": "u114"}, {"name": "？？？", "text": "老い先の短い身ゆえ、\nそのような足労をかける意はどこにもありはせん。\nさ、気にせず正道を歩まれよ。", "face": "lac467bfee065"}, {"name": "アンナ", "text": "わかりました……。\nそれでは、私達はこれで。\nくれぐれも魔物には気をつけてくださいね。", "face": "l68d23b557d5d"}, {"name": "？？？", "text": "………………ふむ、行ったようじゃな。", "face": "lac467bfee065"}, {"name": "？？？", "text": "さて、一先ずの膳立ては済んだようじゃな。\nこれで戦う意思に火がついたじゃろうて……。\n……どうなるか楽しみじゃ。", "face": "lac467bfee065"}]}], "map": {"image": "Map920071_3715", "w": 960, "h": 640, "spots": [{"k": "b", "x": 8, "y": 374}, {"k": "m", "x": 282, "y": 380, "id": 200}, {"k": "m", "x": 293, "y": 449, "id": 201}, {"k": "m", "x": 358, "y": 289,