, "base_attack": 320, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115152, "race_id": 16, "special_effect_id": 54, "master_id": 31143, "global_id": 4762, "spawn_sec": 46}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 24000, "attack": 840, "base_hp": 24000, "base_attack": 840, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_wait": 1, "attack_interval": 27, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118672, "race_id": 16, "special_effect_id": 525, "change_to": 8, "change_condition": 1, "missile_id": 358, "missile": {"speed": 10.0}, "master_id": 32549, "global_id": 6168, "ranged": true, "variants": [{"hp": 24000, "attack": 336, "base_hp": 24000, "base_attack": 336, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118688, "race_id": 16, "special_effect_id": 525, "missile_id": 358, "missile": {"speed": 10.0}, "master_id": 32550, "global_id": 6169}], "spawn_sec": 72}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 2, "tags": ["ステルス"], "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103728, "race_id": 16, "special_effect_id": 61, "change_to": 10, "master_id": 472, "global_id": 471, "to_global_id": 472, "route_behaviour": {"transforms": [{"wait": 1500}]}, "spawn_sec": 83}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109104, "race_id": 16, "special_effect_id": 61, "change_to": 9, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 473, "global_id": 472, "ranged": true}], "popups": ["警戒中の見張りローグが、\n一度攻撃を行うと全ての敵の\n攻撃力と防御力がアップします。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "ファイブ", "text": "――ちっ、フォーの奴め、\nこちらの仕事は手伝わないくせに、\nこういう時だけ助力を求めてくるとはな。", "face": "l353dba63bff2"}, {"name": "シックス", "text": "彼は常にどこにいるか分かりませんから。\nとはいえ互助は闇ギルドからの伝統、\nしっかり手伝ってやりましょう。", "face": "lefb766efc38d"}, {"name": "ファイブ", "text": "……なんだ、闇ギルドを懐かしんでいるのか？", "face": "l353dba63bff2"}, {"name": "シックス", "text": "ふふっ、まさか。\n幹部同士は友好的でいたいだけですよ。\n内紛で滅びては元も子もないですからね。", "face": "lefb766efc38d"}, {"name": "ファイブ", "text": "違いない。\nさて、後はこちらで片付けておこう。\nお前も次の仕事があるだろう？", "face": "l353dba63bff2"}, {"name": "シックス", "text": "えぇ。それではここは任せました。\nクリスマス破壊――いえ、\nクリスマス爆破作戦、どうなることやら……。", "face": "lefb766efc38d"}]}, {"trigger": "start", "lines": [{"name": "サンタヘイオス", "text": "（く、クリスマス爆破作戦……？\n爆破……爆破って何をするつもりなのでしょう！？）", "face": "u1116a1"}, {"name": "セブン", "text": "（さすがにプレゼントを盗むだけじゃ終わらないか。\n爆破って言うからには……んー、\n爆弾でも仕掛けるんじゃないか？）", "face": "u449"}, {"name": "サンタヘイオス", "text": "（……絶対に阻止しなければ。\n王子殿下、敵の見張りを避けつつ、\n迅速にこの拠点を制圧しましょう）", "face": "u1116a1"}, {"name": "セブン", "text": "（見張りに気付かれたら、確実に抵抗は強くなる。\n見張りの行動範囲にはよく注意するんだよ）", "face": "u449"}]}, {"trigger": "end", "lines": [{"name": "ファイブ", "text": "――また王国、また王子か。\nこんな小さな犯罪組織相手に、\n国の長が出てくるとは大層な歓迎だ。", "face": "l353dba63bff2"}, {"name": "ファイブ", "text": "だが、こちらも次の仕事があるんでね。\n先にお暇させてもらうとしよう。", "face": "l353dba63bff2"}, {"name": "セブン", "text": "くっ、待てファイブ！！\n……ちっ、船で逃げやがった。", "face": "u449"}, {"name": "サンタヘイオス", "text": "他の船は全て破壊されていました。\nこれでは後を追うこともできませんね……。", "face": "u1116a1"}, {"name": "アイリーン", "text": "――ですが、重要な証拠を手に入れました。\n王子、この手紙を。", "face": "u315"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "サンタヘイオス", "text": "読めませんね……。\nもしやこれは、暗号ですか……？", "face": "u1116a1"}, {"name": "アイリーン", "text": "闇ギルド時代の古い暗号ですね。\nファイブめ、まだこれを使っていたとは。", "face": "u315"}, {"name": "サンタヘイオス", "text": "何か思うところがあったのでしょうか。\nそ、それはともかく！　何が書かれているんですか？", "face": "u1116a1"}, {"name": "アイリーン", "text": "――クリスマス爆破計画。\n次なる段階は、雪の国の襲撃。", "face": "u315"}, {"name": "アイリーン", "text": "王子、フォーはおもちゃ工場を狙っているようです。", "face": "u315"}, {"name": "アンナ", "text": "またおもちゃ工場、ですか……。\n王子、急いで雪の国へ向かいましょう。\nフォーの犯行を止めるために！", "face": "l383b003f930b"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "見張り", "text": "――ん、あれは……。\n気をつけろ！　侵入者だ！！", "face": "l0856284cfbe7"}, {"name": "サンタヘイオス", "text": "……見つかってしまいましたか。\n王子殿下、敵の抵抗が激しくなると思われます。\n指揮には細心の注意を！", "face": "u1116a1"}]}], "story_talk": true, "active": true}