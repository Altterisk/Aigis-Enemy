{"quest_id": 7115, "name": "立ち塞がりし巨獣と神鳥", "description": "天界への進攻を拒むべく、新たに2体の\n神獣が王子たちの前に立ちはだかる。\n＜？？？がいる間、強風が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["？？？がいる間、強風が発生"], "event": "開かれし扉と集う戦士たち", "event_category": "History", "mission_id": 920149, "map_no": 5755, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 24}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 44}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 2000, "base_hp": 60000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 50, "attack_interval": 166, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "pattern_id": 2116000, "race_id": 15, "special_effect_id": 564, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 32756, "global_id": 6374, "ranged": true, "spawn_sec": 50}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "d