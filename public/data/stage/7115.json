: 76}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 7, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 87}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 236, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114224, "race_id": 6, "change_to": 9, "master_id": 30949, "global_id": 4568, "to_global_id": 4567, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 103}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_range": 180, "attack_speed": 55, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114192, "race_id": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30948, "global_id": 4567, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 11, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 109}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 13, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 139}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_range": 180, "attack_speed": 55, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114192, "race_id": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30948, "global_id": 4567, "ranged": true, "spawn_sec": 167}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107600, "race_id": 6, "master_id": 879, "global_id": 878, "spawn_sec": 169}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 4500, "base_hp": 60000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 50, "attack_wait": 50, "attack_interval": 266, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "transform_resist": 1, "pattern_id": 2114144, "race_id": 15, "special_effect_id": 86, "master_id": 30944, "global_id": 4563, "spawn_sec": 175}], "popups": ["ガルダが飛んでいる間は\n悪天候『強風』が発生します。\n\n 　　　悪天候：強風\n\n・敵の『移動速度』上昇\n・味方の『射程』減少\n・一部の敵味方は影響を受けない"], "dialogue": [{"trigger": "start", "lines": [{"name": "アトナテス", "text": "――ふぅ、ようやくここに戻ってきたぜ。\n今度は門前払いなんてされねぇからな！", "face": "u908"}, {"name": "サナラ", "text": "神の楔の加護がありますから、障壁も超えられますね。\n――あれ？　でも前のときとは、\nちょっとだけ風景が違うような……。", "face": "u921"}, {"name": "鷲翼の鳥人", "text": "この辺りは魔力を帯びた雲が大地となっているからな。\n風や魔力の変化によって、\n風景が変わるのはよくあることなんだ。", "face": "u1086a1"}, {"name": "トゥアン", "text": "さすがは天界だな。物質界の常識が通用しない。\nこんな場所から来たなら、\n『あいつ』が変わり者だったのも頷ける。", "face": "u1006a1"}, {"name": "ソラス", "text": "あいつ……？　あぁ、千年戦争のとき、\n一緒に戦った『あの子』のことですか。\nこんな状況ですから、きっとここでも思い悩んで――", "face": "u904"}, {"name": "ユージェン", "text": "……ん、雑談している暇はなさそうだ。\n王子、盛大なお迎えが来たみたいだぞ。", "face": "u906"}, {"name": "大天使長", "text": "――まさか創造主たる神に弓を引くとは。\n人の子よ、その罪の重さを理解しているのですか。", "face": "l5bfb49a98659"}, {"name": "鷲翼の鳥人", "text": "……何が創造主だ！\n物質界を形作った神々は、今は永き眠りについている。\n天界で争っているのは亜神ばかりではないか！", "face": "u1086a1"}, {"name": "大天使長", "text": "おや、裏切り者ではありませんか。\nまだ生きていたとは、鳥人どもの隠れ里と同じく、\n随分としぶといようですね。", "face": "l5bfb49a98659"}, {"name": "大天使長", "text": "それもこれも、王国軍の――いいえ、\n王子、あなたの力によるものなのでしょう。\n我々はあなたをあなどり過ぎました。", "face": "l5bfb49a98659"}, {"name": "大天使長", "text": "ゆえに此度は、いまの私が行使できうる権限の、\n最高位命令をもってお相手しましょう。", "face": "l5bfb49a98659"}, {"name": "ノーマ", "text": "お、王子……？　何かおかしくない？\n急に風が強くなってきたみたい……。", "face": "u1047a1"}, {"name": "ロヴィニア", "text": "わっ、わわわ……っ！\n下がってノーマちゃん！　まずいよこれ！！\nこの風、世界樹の時と同じ！　神獣ガルダの風だ！", "face": "u662"}, {"name": "ニエル", "text": "それだけじゃないよ。唸り声、聞こえるでしょ？\nこれはあの時と同じ、ベヒモスのものだよ。", "face": "u206"}, {"name": "ノーマ", "text": "べ、ベヒモスに、ガルダ……？\n神獣を複数相手にするなんて、そんなの――", "face": "u1047a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ノーマ", "text": "……うぅぅぅ、どうしてそんな自信満々なの！\nそんな顔されたら、私も頑張るしかないじゃない！", "face": "u1047a1"}, {"name": "女王子", "text": "それが、私たちの国の「王子」ですから。\n王子、私も共に戦います。\nあなたの誓いを、共に果たすために！", "face": "le1a0323ff10f"}, {"name": "メカゴブリンクイーン", "text": "オーッホッホホ！！\n一番槍の名誉はゴブリン族のものよ！\nさぁ王子、人とゴブリンの力を見せてやるわよぉ！", "face": "le219b5be753d"}, {"name": "ゴブリン博士", "text": "王子、今だけハ我が知識を貸してやろウ！\nガルダの羽ばたきにヨル、異常な風速を検知シタ！\n遠隔攻撃の照準ハ著しく難しくなるだロウ！", "face": "l6f1c08263e70"}, {"name": "ノーマ", "text": "ガオレオン様が、時代のスターと呼んだ王子の力！\n時代に輝く一番星たる私に見せてみなさい！\nし、神獣相手なら！　不足はないでしょ！！", "face": "u1047a1"}]}, {"trigger": "end", "lines": [{"name": "ノーマ", "text": "はぁ……はぁ……っ！\nし、神獣と戦って勝ったって、\n開拓村に帰ったら全力で自慢しなくちゃ……。", "face": "u1047a1"}, {"name": "女王子", "text": "えぇ、それもガルダとベヒモスを同時にです。\nこれは一生の自慢にできますよ……。", "face": "le1a0323ff10f"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、気を抜いている暇はないわよ？\nここは敵地のど真ん中なんだから。", "face": "le219b5be753d"}, {"name": "メカゴブリンクイーン", "text": "さぁ王子、いつものように、\n助けを求める鳥人たちを救いに行きなさい。\nこの地点は私とこの子で防衛しておくわ。", "face": "le219b5be753d"}, {"name": "女王子", "text": "ゴブリン族と王国軍の即席混成部隊ですが、\n皆、士気はとても高いです。\n退路はしっかり確保しておきますので。", "face": "le1a0323ff10f"}, {"name": "鷲翼の鳥人", "text": "では、隠れ里に案内しよう。\n物質界の王子よ、付いてきてくれ！", "face": "u1086a1"}, {"name": "ソラス", "text": "（……これだけの騒ぎが起きて、神獣まで暴れて、\n『あの子』が気付かないはずがないのですが……）", "face": "u904"}, {"name": "トゥアン", "text": "（とは言っても、『あいつ』も亜神だ。\nどうせ何か、面倒なしがらみでもあるんだろうさ）", "face": "u1006a1"}, {"name": "アトナテス", "text": "（昔の仲間にばかり頼らなくても良いだろ？\nそれより俺たちは、王子を助けてやらなくちゃな。\n強くはなったが、目を離すにはまだ早いだろ）", "face": "u908"}, {"name": "ノーマ", "text": "……ねぇ、何を話してるの？\nもう王子たち行っちゃったわよ？", "face": "u1047a1"}, {"name": "ユージェン", "text": "なに、ちょっとした昔話だ。\nさぁノーマ、置いていくぞ！\nここからが本番だからな！", "face": "u906"}, {"name": "ノーマ", "text": "えっ、えぇ！？\nちょっと、置いてかないでよ！！", "face": "u1047a1"}]}], "active": true}