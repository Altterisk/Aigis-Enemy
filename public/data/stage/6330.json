{"quest_id": 6330, "name": "空に轟く爆砲", "description": "所属不明の飛空船へと追いついた\n王子たち。追手を払わんと迫り来る、\n敵の刺客を迎撃せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "帝都を揺らす重装砲軍", "event_category": "History", "mission_id": 920101, "map_no": 5274, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 34, "form_count": 1, "tags": ["帝国", "女性"], "hp": 2000, "attack": 500, "base_hp": 2000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_range": 40, "attack_speed": 80, "attack_wait": 30, "attack_interval": 91, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102496, "race_id": 16, "special_effect_id": 229, "missile_id": 45, "master_id": 335, "global_id": 334, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 7, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 45}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098928, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 119, "global_id": 118, "ranged": true, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 69}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 1400, "base_hp": 1400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 60, "attack_wait": 10, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097728, "master_id": 41, "global_id": 40, "spawn_sec": 69}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 800, "base_hp": 1500, "base_attack": 800, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099056, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 120, "global_id": 119, "ranged": true, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 70}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "帝国"], "hp": 12000, "attack": 700, "base_hp": 12000, "base_attack": 700, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 321, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113136, "race_id": 16, "change_to": 7, "change_condition": 1, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 30779, "global_id": 4398, "ranged": true, "variants": [{"tags": ["アーマー", "帝国"], "hp": 12000, "attack": 700, "base_hp": 12000, "base_attack": 700, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 206, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113152, "race_id": 16, "master_id": 30780, "global_id": 4399}], "spawn_sec": 191}], "dialogue": [{"trigger": "start", "lines": [{"name": "ディルク", "text": "報告！　船首前方に所属不明の飛空船を発見！", "face": "u287"}, {"name": "アンナ", "text": "飛空船……逃走中のベラートが\n秘密裏に所有していたものでしょうか？", "face": "lbd47455882a3"}, {"name": "レオナ", "text": "所属不明の飛空船がそう幾つもあってたまるか。\n全速力で接近するよう操舵手に伝えろ！", "face": "u311"}, {"name": "ディルク", "text": "はっ。只今――。", "face": "u287"}, {"name": "キャリー", "text": "ひぇえ～～っ！\nちょ、ちょっと速度出し過ぎじゃありませんか！？", "face": "u26"}, {"name": "フリーデ", "text": "――くっ、追いつかれたか。\nでも、ベラート様には指一本触れさせない！", "face": "u1566"}, {"name": "フリーデ", "text": "黒の軍団、準備しな！\nこっちの飛空船に乗り込まれないように\nあいつらをここで叩くよっ！", "face": "u1566"}, {"name": "レオナ", "text": "黒の軍団だと！？\nくっ……最近奴らの部隊の幾つかが消息を絶ったと\n聞いていたが、ベラートたちに手懐けられていたか！", "face": "u311"}, {"name": "ディルク", "text": "敵の接近を確認！\n黒の軍団、ならびに天馬騎士の部隊のようです！", "face": "u287"}, {"name": "アンナ", "text": "とにかく、飛来する敵を迎え撃ちましょう！\nベラートの身柄確保はそれからです。", "face": "lbd47455882a3"}]}, {"trigger": "battle", "at_sec": 193, "lines": [{"name": "フリーデ", "text": "――よっ、と！", "face": "u1566"}, {"name": "ルーテ", "text": "な……天馬騎士の後ろに乗って飛んでくるなんて！\n命が惜しくはないのですか？　この高さから落ちたら……。", "face": "u529"}, {"name": "フリーデ", "text": "……命がけなんだよ、こっちは。\nベラート様の援助がないと、守りたいものも守れないんだ！", "face": "u1566"}, {"name": "フリーデ", "text": "さぁ、誰からでもかかってきな！\nコイツで雲の彼方までぶっ飛ばしてやるっ！", "face": "u1566"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "よし、そこまでだ。\n天馬騎士部隊、敵の飛空船に乗り込み船内を捜索しろ。　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　", "face": "u311"}, {"name": "フリーデ", "text": "……残念だったね。\nベラート様はその飛空船には乗ってないよ。", "face": "u1566"}, {"name": "レオナ", "text": "なんだと？", "face": "u311"}, {"name": "クラーラ", "text": "ほ、報告でし……でしゅっ！\n船内を捜索しましたが、目標は見つかりませんでした。", "face": "u420"}, {"name": "レオナ", "text": "なにッ！？　どういうことだ？", "face": "u311"}, {"name": "フリーデ", "text": "どうもこうも、ベラート様は最初から\nこの飛空船には乗ってなかったのさ。", "face": "u1566"}, {"name": "フリーデ", "text": "あの御方にお仕えしてるあたしが乗ってるのを見て、\nあんたらはまんまと騙されてくれたみたいだけどね。", "face": "u1566"}, {"name": "アンナ", "text": "なッ……ではこの飛空船は、\n私たちを欺くおとりだったのですか。", "face": "lbd47455882a3"}, {"name": "レオナ", "text": "なら、奴はいまどこに……？", "face": "u311"}, {"name": "フリーデ", "text": "ベラート様なら、今頃は大軍を率いて\n手薄になった帝都を襲撃してるところじゃない？", "face": "u1566"}, {"name": "ユリアン", "text": "チッ。俺たちはあのハゲ親父の\n手のひらで踊らされてたってわけか。", "face": "u7"}, {"name": "フリーデ", "text": "――そんじゃ、あたしそろそろ行くから。\nじゃーね！", "face": "u1566"}, {"name": "ロイ", "text": "おわっ！？　ま、待ちなさいお嬢さん！", "face": "u11"}, {"name": "ケイティ", "text": "くっ……まだ動ける天馬騎士がいたとは。\nですが、いまは逃げたフリーデさんを\n追っている場合ではありません。", "face": "u114"}, {"name": "レオナ", "text": "ああ。可及的速やかに帝都に向かおう。\nベラート如きに陛下の威光を傷つけられてなるものか！", "face": "u311"}]}], "active": true}