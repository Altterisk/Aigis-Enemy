ge_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 201, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115696, "race_id": 7, "special_effect_id": 310, "change_to": 13, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 31241, "global_id": 4860, "ranged": true}, {"enemy_id": 16, "source": "local", "count": 26, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 155}, {"enemy_id": 17, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "attack": 3000, "base_hp": 1000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_range": 10, "attack_speed": 65, "attack_wait": 80, "attack_interval": 197, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098864, "race_id": 16, "special_effect_id": 229, "missile_id": 56, "missile": {"speed": 1.0, "splash": 80}, "master_id": 127, "global_id": 126, "ranged": true, "spawn_sec": 183}, {"enemy_id": 18, "source": "local", "count": 11, "form_count": 1, "tags": ["忍者"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_interval": 76, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099968, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 208, "global_id": 207, "ranged": true, "spawn_sec": 192}], "popups": ["変異した魔界ボアは、\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。\n\n\n\n　　　　　　(1/2)", "また、一定範囲内のユニットは\n継続ダメージを受けます。\n一定時間継続ダメージを受けると、\n麻痺状態になります。\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "絡繰り忍者", "text": "獰猛の黒、駆ける者たる四肢、砕く牙……。\n魔界に住まう蹂躙の化身。\n忍法、口寄せの術――魔界ボアッ！！", "face": "l2e284737c971"}]}, {"trigger": "battle", "at_sec": 9, "lines": [{"name": "ソーマ", "text": "ま、魔界ボアが変異種になりましたよ！？", "face": "u23"}, {"name": "サオシュ", "text": "……いつもの変異種と気配が違います。\nびりびり……雷をまとってます……！", "face": "u968"}, {"name": "レアン", "text": "魔界ボアが帯電だって？\nいったいどんな変異をしたっていうんだ。", "face": "u50"}, {"name": "ニコル", "text": "あー、あれは見覚えがある、かも……？\nうぇぇぇ、生物化学は本業じゃないんだけどなぁ。", "face": "u994"}, {"name": "ニコル", "text": "王子さま、電気を放つ魚って見たことある？\nあいつ変異で、その放電器官を得たんだよ。", "face": "u994"}, {"name": "ニコル", "text": "大気中で目視できる程の、あの放電量！\n近付くだけで絶対ヤバイし、\nずっと電気浴び続けたら動けなくなっちゃうかも！", "face": "u994"}, {"name": "絡繰り忍者", "text": "科学者――否、錬金術士か。\nしかし残念にござるな、\n敵とはいえ、叡智の担い手を殺すことになるとは。", "face": "l2e284737c971"}, {"name": "ソーマ", "text": "誰も、傷つけさせませんよ！\nそれに温泉も元に戻します！", "face": "u23"}, {"name": "サオシュ", "text": "ですっ……わ、私たちは、\nこの温泉の若女将……ですからっ！", "face": "u968"}, {"name": "絡繰り忍者", "text": "若女将とは……戦場に似つかわしくない\n言葉もあったものにござるな。", "face": "l2e284737c971"}, {"name": "絡繰り忍者", "text": "――なれば死にゆく者達よ、ご笑覧あれ。\nこれより先は死地、戦場にござるゆえ。", "face": "l2e284737c971"}]}, {"trigger": "end", "lines": [{"name": "絡繰り忍者", "text": "……見誤ったか。\n良い戦士たちとは思ったが、\nまさかこれ程の実力を備えていたとは。", "face": "l2e284737c971"}, {"name": "絡繰り忍者", "text": "しかし、核には届かなかったか。\nあと拳ひとつ逸れていたなら、\n拙者の機関を止めることもできたでござろうに。", "face": "l2e284737c971"}, {"name": "サオシュ", "text": "あなたが……ちょこまか逃げ回るからです。\nまだ続けますか……？", "face": "u968"}, {"name": "絡繰り忍者", "text": "くくっ……愉快なり。\nひ弱な娘だと思えば、そんな顔をするのでござるか。", "face": "l2e284737c971"}, {"name": "絡繰り忍者", "text": "既に実験の第一段階は完了した。\nもはやこの地に残る理由はござらぬ。\n――ゆえに、この場の勝利は譲るとしよう。", "face": "l2e284737c971"}, {"name": "絡繰り忍者", "text": "忍法――煙隠れの術ッ！！", "face": "l2e284737c971"}, {"name": "ソーマ", "text": "なっ……けほっ、けほっ！\n絡繰り忍者さんはどこに……！？", "face": "u23"}, {"name": "サオシュ", "text": "けほっ、けほっ……うぅ、\nすみません、見失ってしまいました……。", "face": "u968"}, {"name": "シュシュ", "text": "……あれ？　温泉の色、もとに戻っていませんか？", "face": "u656"}, {"name": "ソーマ", "text": "絡繰り忍者さんが\n戻していってくれたのでしょうか……？", "face": "u23"}, {"name": "エマ", "text": "……あの男、親切心や酔狂で動く者ではありません。\n変異薬を我々に採取されぬよう、\n中和していったと考えるべきでしょうね。", "face": "u1137a1"}, {"name": "アンナ", "text": "絡繰り忍者……いったい\n何を目的にしているのでしょうか……。", "face": "l0985a2e9e858"}, {"name": "エマ", "text": "引き際を心得た相手ほど、戦場では恐ろしいもの。\n王子、あの者には警戒を怠らぬよう。", "face": "u1137a1"}, {"name": "エマ", "text": "それでは若女将たち、宿に戻りましょうか。\n宿の温泉がもとに戻ったか、\n確認しないといけませんからね。", "face": "u1137a1"}, {"name": "ソーマ", "text": "はいっ、女将さん！", "face": "u23"}, {"name": "サオシュ", "text": "帰りましょう、女将さんっ！", "face": "u968"}]}], "story_talk": true, "active": true}