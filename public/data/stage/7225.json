{"quest_id": 7225, "name": "温泉宿に平穏を", "description": "絡繰り忍者に口寄せされた魔界ボアが\n変異の湯によって姿を変える！？\n魔猪と忍を倒し、健やかな湯を取り戻せ！\n神級（★１獲得の目安：平均Lv50）", "event": "王国おんせん繁盛記", "event_category": "History", "mission_id": 920154, "map_no": 5851, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 32000, "attack": 1050, "base_hp": 32000, "base_attack": 1050, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126672, "race_id": 16, "special_effect_id": 663, "change_to": 1, "master_id": 33332, "global_id": 6949, "to_condition": 2, "to_global_id": 6936, "route_behaviour": {"transforms": [{"wait": 120}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "ステルス"], "hp": 90000, "attack": 1200, "base_hp": 90000, "base_attack": 1200, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 58, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126688, "race_id": 16, "special_effect_id": 664, "master_id": 33319, "global_id": 6936, "from_condition": 2}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 2, "hp": 100000, "attack": 4500, "base_hp": 100000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 115, "attack_wait": 100, "attack_interval": 401, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109424, "race_id": 13, "change_to": 5, "master_id": 33320, "global_id": 6937, "to_global_id": 6940, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 100000, "attack": 3200, "base_hp": 100000, "base_attack