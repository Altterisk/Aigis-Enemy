{"quest_id": 6313, "name": "深淵より現れし者", "description": "激戦の末ケラウノスを討ち果たした\n王子たち。喜び帰還する一行だが、\n新たなる脅威が迫り来る……！\n神級（★１獲得の目安：平均Lv50）", "event": "神殺しの聖槍", "event_category": "History", "mission_id": 920185, "map_no": 5114, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 35000, "attack": 1800, "base_hp": 35000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 84, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111568, "master_id": 30601, "global_id": 4220, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 900, "base_hp": 40000, "base_attack": 900, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 190, "attack_speed": 50, "attack_wait": 10, "attack_interval": 86, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103488, "race_id": 3, "special_effect_id": 232, "change_to": 2, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 449, "global_id": 448, "ranged": true, "variants": [{"hp": 40000, "attack": 2200, "base_hp": 40000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 70, "attack_speed": 50, "attack_wait": 30, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103504, "race_id": 3, "master_id": 450, "global_id": 449}], "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 6}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 24}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 3, "tags": ["アーマー"], "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_range": 250, "attack_speed": 90, "attack_wait": 45, "attack_interval": 136, "move_speed": 450.0, "dot_rate": 1.5, "pattern_id": 2105648, "special_effect_id": 232, "change_to": 6, "change_condition": 2, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 805, "global_id": 804, "ranged": true, "to_condition": 2, "to_global_id": 805, "spawn_sec": 45}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 40000, "attack": 3000, "base_hp": 40000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 120, "attack_interval": 476, "move_speed": 300.0, "dot_rate": 1.5, "pattern_id": 2105664, "change_to": 7, "change_condition": 2, "master_id": 806, "global_id": 805, "from_condition": 2, "to_condition": 2, "to_global_id": 806}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 80000, "attack": 3500, "base_hp": 80000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 20, "attack_speed": 50