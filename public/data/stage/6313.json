d": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 20, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 185}, {"enemy_id": 21, "source": "local", "count": 2, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 185}, {"enemy_id": 22, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 189}, {"enemy_id": 23, "source": "local", "count": 2, "form_count": 1, "hp": 20000, "attack": 2000, "base_hp": 20000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 321, "global_id": 320, "spawn_sec": 201}, {"enemy_id": 24, "source": "local", "count": 1, "form_count": 2, "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 260, "attack_speed": 70, "attack_wait": 60, "attack_interval": 162, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103808, "race_id": 16, "change_to": 24, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 339, "global_id": 338, "ranged": true, "to_global_id": 480, "spawn_sec": 224}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 70, "attack_wait": 60, "attack_interval": 232, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103808, "race_id": 16, "change_to": 23, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 481, "global_id": 480}], "popups": ["魔王は、拠点には向かわず\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デシウス", "text": "…………。", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "……どうかされましたか？\n急に立ち止まったりして。\n王国はまだ先ですよ？"}, {"name": "デシウス", "text": "あ……いや、大したことではないのだが……。", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "（……なぜ我輩は王国へ行こうとしている？\n共にケラウノスを打倒した我輩に\n王子が王国軍入りを勧めてきたのは事実だが……）", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "（……とはいえ、いまさら彼らと共に\n陽の光の下を歩む資格があるだろうか？\n力を得るために手段を選ばず、闇に染まった我輩に）", "face": "l07c2a5a929a8"}, {"name": "シャディア", "text": "探したぞ、デシウス。\n愚神ケラウノス誅殺の最大の功労者よ。", "face": "u713"}, {"name": "デシウス", "text": "シャディア！？\n魔王親衛隊の貴様が、なぜここに……？", "face": "l07c2a5a929a8"}, {"name": "シャディア", "text": "迎えに来たのだ。\n魔王様の御力を抑制していた愚かな女神を殺し、\nその忌々しい呪縛を解くための鍵となった男をな。", "face": "u713"}, {"name": "デシウス", "text": "なん……だと？", "face": "l07c2a5a929a8"}, {"name": "シャディア", "text": "貴様の功績は魔王様も高く評価している。\nなにせ、おかげであの御方はケラウノスの呪縛から\n解放され、真の力を取り戻しつつあるのだからな。", "face": "u713"}, {"name": "シャディア", "text": "その功労者を是非取り立てたい。\nデシウスよ、魔王軍に入れ。\nそこが貴様の在るべき場所だ。", "face": "u713"}, {"name": "アンナ", "text": "か……勝手なことを言わないでください！\nデシウスはこれから、私たちと共に――", "face": "la7f94b5d2087"}, {"name": "デシウス", "text": "ふ……フハハハハ！　我輩は暗黒騎士……！\n馬鹿め、我輩は仲間になったフリをしていただけだ。\n王子、さんざん邪魔をしてくれた貴様を倒すためにな！", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "なっ……！\nそんな……デシウスが寝返るなんて。", "face": "la7f94b5d2087"}, {"name": "デシウス", "text": "寝返る？　勘違いをするな。\n貴様らなど最初から利用するつもりでしかなかったのだ。\nフハハハハ！　せいぜい卑怯だと罵るがいい！", "face": "l07c2a5a929a8"}]}, {"trigger": "battle", "at_sec": 84, "lines": [{"name": "ケイティ", "text": "――ッ！？\nあの姿は、まさか――！", "face": "u114"}, {"name": "シャディア", "text": "ま……魔王様！\nお出迎えもせず、面目次第もございません！\nおいでになるとはいざ知らず……。", "face": "u713"}, {"name": "魔王ガリウス", "text": "……面を上げよ、我が忠実なるしもべよ。\n予は汝の働きに満足しておる。", "face": "l55d901d48a4f"}, {"name": "魔王ガリウス", "text": "ケラウノス亡き今、かつての力が予に戻りつつある。\n実に良き気分ゆえ、予を滅ぼさんと欲する\n愚物どもを相手に小手調べをしたくなって来たのだ。", "face": "l55d901d48a4f"}, {"name": "シャディア", "text": "さ……左様でございますか。\nでしたらその御力、存分にお揮いくださいませ。", "face": "u713"}, {"name": "ケイティ", "text": "……王子、今の魔王ガリウスには\n我々を本気で滅ぼすつもりはないようです。\nですが、警戒だけは十分にいたしましょう。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "シャディア", "text": "……これ以上は消耗戦だ。\nここは退くぞ、デシウス。", "face": "u713"}, {"name": "デシウス", "text": "うむ、やむを得まい。", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "デシウス……どうしても行ってしまうのですか？", "face": "la7f94b5d2087"}, {"name": "デシウス", "text": "……力を得る為に重ねた罪を償うことはできん。", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "闇に身を落とした我輩には、\n闇の世界こそが相応しいのだ……。", "face": "l07c2a5a929a8"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "そんな……やっとわかりあえたと思ったのに。", "face": "l4dbe6965e306"}, {"name": "依り代の少女", "text": "ま……待ってください！", "face": "ld3e1ccb68393"}, {"name": "デシウス", "text": "――ッ！？\n貴様……眠っていたはずでは！？", "face": "l07c2a5a929a8"}, {"name": "依り代の少女", "text": "……詳しい事情はよくわかりません。\nですが、貴方が私を救ってくれた\n恩人だということだけは、はっきりと覚えています。", "face": "ld3e1ccb68393"}, {"name": "依り代の少女", "text": "ですから、その……。\n一言だけ、お礼を言わせていただけますか？", "face": "ld3e1ccb68393"}, {"name": "デシウス", "text": "…………忘れろ。\n我輩の望みはそれだけだ。", "face": "l07c2a5a929a8"}, {"name": "依り代の少女", "text": "……っ。", "face": "ld3e1ccb68393"}, {"name": "デシウス", "text": "……さらばだ、王子！\n我輩は我輩の道を往く！\n貴様は貴様の道を往くがいい！", "face": "l07c2a5a929a8"}]}, {"trigger": "route", "enemy_ids": [13], "lines": [{"name": "魔王ガリウス", "text": "ふむ……いまはまだこんなものか。", "face": "l55d901d48a4f"}, {"name": "魔王ガリウス", "text": "予は帰還する。\n臣下たちよ、後はうまくやるがいい。", "face": "l55d901d48a4f"}]}, {"trigger": "route", "enemy_ids": [13], "lines": [{"name": "魔王ガリウス", "text": "……つまらぬ。\n予を苦しめた男の末裔ですら、所詮はこの程度か。", "face": "l55d901d48a4f"}, {"name": "魔王ガリウス", "text": "興ざめだ。予は帰還する。\n臣下たちよ、後は適当にやるがいい。", "face": "l55d901d48a4f"}]}], "active": true}