{"quest_id": 20024, "name": "猫様たちの遊び相手", "description": "博物館にキャスパリーグと猫たちが登場！？\n眠る猫たちに驚いていたその時、一行に\n話しかけてくる猫耳の女の子が現れて？\n神級EX（★１獲得の目安：平均覚醒Lv25）", "event": "メイド・イン・プロミス", "event_category": "Emergency", "mission_id": 200581, "map_no": 7490, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 2, "tags": ["猫", "ステルス"], "hp": 26000, "attack": 600, "base_hp": 26000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160096, "race_id": 13, "special_effect_id": 2053, "change_to": 1, "master_id": 41090, "route_behaviour": {"transforms": [{}, {"to": 41090, "wait": 2700}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["猫"], "hp": 26000, "attack": 600, "base_hp": 26000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160080, "race_id": 13, "master_id": 41089}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["猫", "ステルス"], "hp": 83000, "attack": 450, "base_hp": 83000, "base_attack": 450, "damage_type": "true", "armor_defense": 1000, "magic_defense": 30, "attack_speed": 45, "attack_wait": 70, "attack_interval": 244, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160160, "race_id": 13, "special_effect_id": 2051, "change_to": 3, "master_id": 38713, "global_id": 12330, "to_global_id": 12329, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1,