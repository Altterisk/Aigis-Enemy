n": 5, "master_id": 41085, "sp_change_to": [41087], "route_behaviour": {"transforms": [{"to": 41087, "wait": 500}, {}, {"to": 41090, "wait": 500}]}, "spawn_sec": 2}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["猫", "ステルス"], "hp": 8200, "attack": 380, "base_hp": 8200, "base_attack": 380, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160064, "race_id": 13, "special_effect_id": 2052, "change_to": 7, "master_id": 41087, "from_condition": "sp_change", "timed_wait": 500}, {"enemy_id": 10, "source": "local", "count": 25, "form_count": 1, "hp": 15000, "attack": 400, "base_hp": 15000, "base_attack": 400, "damage_type": "magical", "armor_defense": 100, "magic_defense": 30, "attack_range": 160, "attack_speed": 70, "attack_wait": 60, "attack_interval": 185, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2151936, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 40555, "global_id": 14172, "ranged": true, "spawn_sec": 7}, {"enemy_id": 11, "source": "local", "count": 17, "form_count": 2, "tags": ["猫"], "hp": 26000, "attack": 600, "base_hp": 26000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160080, "race_id": 13, "change_to": 1, "change_condition": 5, "master_id": 41088, "sp_change_to": [41090], "route_behaviour": {"transforms": [{"to": 41090, "wait": 500}, {}]}, "spawn_sec": 60}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["猫", "ステルス"], "hp": 26000, "attack": 600, "base_hp": 26000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160096, "race_id": 13, "special_effect_id": 2053, "change_to": 1, "master_id": 41090, "from_condition": "sp_change", "timed_wait": 500}, {"enemy_id": 12, "source": "local", "count": 12, "form_count": 1, "hp": 12000, "attack": 650, "base_hp": 12000, "base_attack": 650, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 160, "attack_speed": 70, "attack_wait": 60, "attack_interval": 185, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2151952, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 40556, "global_id": 14173, "ranged": true, "spawn_sec": 120}], "dialogue": [{"trigger": "enemy_spawn", "enemy_id": 5, "lines": [{"name": "アンナ", "text": "――きゃっ！？　あの子、\n白い毛に覆われて、爪が伸びて……！"}, {"name": "アキレア", "text": "人型の獣……？\n遊びの相手ってのは、こういう意味かよ！", "face": "u1972a1"}, {"name": "アナベラ", "text": "獣に変じる獣人……！\n文献でしか読んだことがない……本物だ……！", "face": "u1309a1"}, {"name": "ジタリス", "text": "で、でも、動きが楽しそうです……。\nあれはたぶん、遊びの本気モードです……！", "face": "u1915a1"}, {"name": "王子", "text": "…………！", "face": "u1"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "警備の方からの報告では、\n休館日の夜に、\n館内から猫の鳴き声が響いていると……。"}, {"name": "アキレア", "text": "鳴き声どころじゃねぇな、これ。\n見ろよ、床一面、猫、猫、猫だ。最高かよ。", "face": "u1972a1"}, {"name": "アナベラ", "text": "今のところは落ち着いてて何よりだけど、\nこれ、暴れ出したら大変なことになるんじゃ……。", "face": "u1309a1"}, {"name": "アンナ", "text": "ま、まずいです。\n今日は展示品さんたちが自由に動いていい日ですよ？"}, {"name": "アナベラ", "text": "休館日は動いていいって約束だからね。\nでも猫が暴れ出したら、展示室が――", "face": "u1309a1"}, {"name": "ジタリス", "text": "――王子様！　あの、こちらにうちの子は……！", "face": "u1915a1"}, {"name": "アキレア", "text": "あんたは……鳥人の里の。\nえぇっと、うちの子っていうと？", "face": "u1972a1"}, {"name": "ジタリス", "text": "キャスパリーグです。\n猫の魔物さんたちを連れて、\n里をとび出て行ってしまって。", "face": "u1915a1"}, {"name": "アナベラ", "text": "つまりこの猫たちは、あの巨大猫のお供……。\n真ん中に寝てる大きな影は――", "face": "u1309a1"}, {"name": "？？？", "text": "――しーっ。声が大きいよ、みんな。", "face": "u2890a1"}, {"name": "アンナ", "text": "えっ……白い猫耳の、女の子？\nあなたはいったい……。"}, {"name": "？？？", "text": "見ての通り、猫様たちの遊び相手。\nほら、この子見て？\n傘の先を追いかけるの、上手でしょ？", "face": "u2890a1"}, {"name": "アキレア", "text": "遊び相手って……おい、まさか。\n猫をここに集めて、仕切ってるのはお前か！？", "face": "u1972a1"}, {"name": "？？？", "text": "仕切ってるのは私。集めたのは、真ん中で寝てる子。\n……あの子が起きる前に、みんな遊び疲れるといいな。", "face": "u2890a1"}, {"name": "アナベラ", "text": "それ、遊ばせてる間に展示物が壊れたら\nどうするつもりなんだい……！？", "face": "u1309a1"}, {"name": "？？？", "text": "壊れそうな物の前では、遊ばせてないよ。\n猫様は、遊びの途中で止められるのが一番嫌いなの。", "face": "u2890a1"}, {"name": "？？？", "text": "だから王子様。どうしても止めたいなら――\nまずは私と遊んでからにしてくれる？", "face": "u2890a1"}, {"name": "ジタリス", "text": "王子様、あの子たちは遊んでいるだけです。\nどうか、手加減を……！", "face": "u1915a1"}, {"name": "アキレア", "text": "手加減しながら、猫の群れと猫耳の相手か……。\n上等だ。王子、静かに、丁寧にいくぞ！", "face": "u1972a1"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "……はぁ、はぁ。負けた、にゃーん。\n王子様、遊び相手として合格だよ。", "face": "u2890a1"}, {"name": "ノヴァリス", "text": "改めまして、ノヴァリスだよ。\n最高に可愛い、猫様の獣人！", "face": "u2890a1"}, {"name": "アナベラ", "text": "ふぅ……壊れた展示物はひとつもなさそうだ。\n本当に、割れ物の前では遊ばせていなかったのか。", "face": "u1309a1"}, {"name": "ノヴァリス", "text": "当然でしょ。展示物も猫様も可愛いのに、\nどっちかが壊れるなんて嫌じゃん。", "face": "u2890a1"}, {"name": "アンナ", "text": "それじゃあ、あなたは騒動の原因じゃなくて……。"}, {"name": "ノヴァリス", "text": "夜の街で、猫様の群れが博物館に向かってたの。\n群れを止めるのは無理だから、\n中で遊ばせることにしたんだ。", "face": "u2890a1"}, {"name": "ノヴァリス", "text": "遊び疲れたら、猫様は勝手に帰る。\nそれが一番、誰も傷つかない終わり方だからね。", "face": "u2890a1"}, {"name": "アキレア", "text": "……疑って悪かったな。\nで、肝心の親玉は――", "face": "u1972a1"}, {"name": "キャスパリーグ", "text": "……ニャァーッ♪", "face": "l0ef8479eba19"}, {"name": "ジタリス", "text": "あっ、寝ぼけてたけど、目を覚ましたみたい。\nしかもこの顔は……！\n王子様と模擬戦がしたい時の顔です……！", "face": "u1915a1"}, {"name": "アナベラ", "text": "展示室で模擬戦は駄目だ……絶対に駄目だ……！\n…………（くらっ）", "face": "u1309a1"}, {"name": "ノヴァリス", "text": "あは、可愛い♪　みんな遊び足りないみたい。\nじゃあ王子様、猫様のお見送りまで付き合ってくれる？", "face": "u2890a1"}, {"name": "ノヴァリス", "text": "そのかわり、これからは私も、あなたと遊んであげる。\n……ううん、あなたの手伝いをしてあげる。", "face": "u2890a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ノヴァリス", "text": "決まり。最高に可愛い私を、\nこれからよろしくね、王子様♪", "face": "u2890a1"}]}], "active": true}