, "master_id": 34630, "global_id": 8247, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 46000, "attack": 1800, "base_hp": 46000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133328, "race_id": 16, "master_id": 34631, "global_id": 8248}], "spawn_sec": 243}, {"enemy_id": 30, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "attack_range": 210, "attack_speed": 1, "attack_wait": 25, "attack_interval": 141, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130976, "race_id": 2, "missile_id": 609, "missile": {"speed": 10.0}, "master_id": 34094, "global_id": 7711, "ranged": true, "spawn_sec": 249}], "popups": ["飛空戦艦が特定の位置に到着すると、\n艦内から増援が出現します。\n飛空戦艦を撃破すると、艦内の\n敵も同時に倒すことができます。\n\nまた飛空戦艦は、増援を降下中は\n砲撃を行いません。", "飛翔するクロコは、\n移動中は攻撃を行いません。"], "dialogue": [{"trigger": "battle", "at_sec": 35, "lines": [{"name": "クロコ", "text": "――人ガ空を飛ぶ時代カ……。\n不敬ダト言ってやりたいトコロダガ、\nむしろコレコソが、人の力なのダロウカ。", "face": "l9164578f1e0d"}, {"name": "ベラート", "text": "人は脆い……どこまでも強くなることはできても、\n脆さだけは克服することができないものでしてな。", "face": "l21787b277675"}, {"name": "クロコ", "text": "硬きウロコもナク、強大な体躯モ持たぬがユエか。\nソレガ、空をユクことと何の関係ガ？", "face": "l9164578f1e0d"}, {"name": "ベラート", "text": "人より強き者がいくらでもいる世界。\nだからこそ、人は己の持つ最大の強みを\nこれでもかと伸ばし続けたのです。", "face": "l21787b277675"}, {"name": "ベラート", "text": "それが魔法であり、機械である。\n己を、大切なものを守るために、\n鎧となり、剣となり、翼となる力を伸ばしたのですな。", "face": "l21787b277675"}, {"name": "クロコ", "text": "……諦めぬコトコソ、人の強さカ。\nナラバ同じ空デ、ソノ戦いぶりヲ見せてもらオウ。", "face": "l9164578f1e0d"}]}, {"trigger": "battle", "at_sec": 36, "lines": [{"name": "？？？", "text": "陛下！　東の方角より、飛空船が接近中です！\nそれから、な、なんというのか……。", "face": "u1552a1"}, {"name": "レオナ", "text": "どうしたウルスラ、何が来たというのだ。", "face": "u311"}, {"name": "ウルスラ", "text": "バチバチ光ってる、竜人……？　も、\n飛空船と同時に接近中です！", "face": "u1552a1"}, {"name": "レオナ", "text": "空を行く、竜人……？\n竜将クロコか！！", "face": "u311"}, {"name": "レオラ", "text": "まずいわね……。\nこちらの航空戦力は分散しているわ。\n一点突破で戦力を投入されたら――", "face": "u464"}, {"name": "レオナ", "text": "最初から想定済みだ。\n……悪い想定の方ばかりが当たっているが。", "face": "u311"}, {"name": "レオラ", "text": "ふふ、そうね。\nこれはまだ、こちらの作戦の範疇。", "face": "u464"}, {"name": "レオラ", "text": "前線に伝達！\n敵は飛空船から降下してくるわ！\nその前に飛空船の護衛と、本体を叩きなさい！", "face": "u464"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "……一進一退、ってところ？", "face": "u1553a1"}, {"name": "マレブランケ", "text": "おやアブグルント。……前線による、かな。\n総じて言えばこちらの方が押されているが、\nそれも作戦の内というやつだよ。", "face": "u1225a1"}, {"name": "アブグルント", "text": "誘い込んで叩く、というわけね。\n……勝てると思う？", "face": "u1553a1"}, {"name": "マレブランケ", "text": "さて、戦いの勝敗は誰にも分からないものだからね。\n兵のひとりとしては勝つつもりでやっているよ。\n……ただ、懸念があるとすれば、アダマス様だ。", "face": "u1225a1"}, {"name": "アブグルント", "text": "眠りについたまま、か……。\nでも、最初から三女神を頼るつもりはないでしょう？", "face": "u1553a1"}, {"name": "マレブランケ", "text": "まぁね、これは帝国が受け止めなければならない、\n帝国がなしてきた事の終着点なんだから。\nそのツケは、ずいぶんと重いようだけど。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "（アダマス様は、本当に眠っているのか？\nそれとも、あえてこの戦いに目を瞑っているのか……）", "face": "u1225a1"}]}, {"trigger": "end", "lines": [{"name": "ハイドース", "text": "――傷つき、倒れ、命が散っていく。\n悲しいものだな、我が冥界の力が満ちるほどに、\nこの地上には悲劇の連鎖が蔓延っていくのだから。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "人の子らよ、志を同じくする友たちよ、\n大切な者を失う悲しみは、我もよく分かる。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "だが、願いのために犠牲は必要なのだ。\nその願いを阻まんとする者がいる限り。\n我らは、戦わねばならぬのだ。", "face": "le4066daa294e"}, {"name": "リンクス", "text": "――ハイドース様。\n帝国の防衛網が偏り始めたわ。", "face": "u1561a1"}, {"name": "ハイドース", "text": "……時が満ちようとしている、か。", "face": "le4066daa294e"}, {"name": "リンクス", "text": "帝国軍の練度は極めて高いわ。\nだからこそ、こちらが兵を割けば、\nそこへ迅速に兵を差し向けてくれる。", "face": "u1561a1"}, {"name": "ハイドース", "text": "敵が強くて助かった、と言ったところか。\n何とも滑稽な話だが、人の身からすれば天災も同然か。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "亜神がその権能を振るうことまで、\n戦闘教義に記されてはいないだろうからな。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "――ところで、リンクスよ。\nそろそろ、良いのではないか？", "face": "le4066daa294e"}, {"name": "リンクス", "text": "……良い、とは？\nなんのことかしら？", "face": "u1561a1"}, {"name": "ハイドース", "text": "戦争など、強がりで参戦するものではない。\n誇りと虚勢を取り違えたままでは、\nいずれ、引き返せない日が来るだろう。", "face": "le4066daa294e"}, {"name": "リンクス", "text": "……何を仰っているか、分からないわ。", "face": "u1561a1"}, {"name": "ハイドース", "text": "ハハッ、亜神の戯言だ。\nあの男といい、リンクスといい、どうにも、\n我の言葉を素直に受け取る者は少ないようだな。", "face": "le4066daa294e"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 20, "params": [150]}], "enemies": [{"enemy_id": 1, "hp": 92000, "attack": 1200, "damage_type": "physical", "armor_defense": 650, "magic_defense": 10, "pattern_id": 2133072}, {"enemy_id": 1, "form_index": 1, "hp": 92000, "damage_type": "physical", "armor_defense": 650, "magic_defense": 10, "pattern_id": 2133088}, {"enemy_id": 3, "hp": 10000, "attack": 560, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2133008}, {"enemy_id": 3, "form_index": 1, "hp": 10000, "attack": 560, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2133008}, {"enemy_id": 3, "form_index": 2, "hp": 10000, "attack": 560, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2133008}, {"enemy_id": 3, "form_index": 3, "hp": 10000, "attack": 560, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2132992}, {"enemy_id": 7, "hp": 40000, "attack": 800, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2133248}, {"enemy_id": 7, "form_index": 1, "hp": 40000, "attack": 800, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2133248}, {"enemy_id": 7, "form_index": 2, "hp": 40000, "attack": 800, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2133248}, {"enemy_id": 7, "form_index": 3, "hp": 40000, "attack": 800, "damage_type": "physical", "armor_defense": 650, "patte