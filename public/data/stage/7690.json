0944}, {"enemy_id": 28, "hp": 46000, "attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133312}, {"enemy_id": 30, "hp": 6000, "attack": 300, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2130976}]}, "active": true}