{"quest_id": 1934, "name": "アトランティスの巨人兵", "description": "一行を妨害するポセイオスの眷属を倒し、\nアトランティスの巨人兵への道を切り開け！\n＜深海（強）：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海（強）：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション11", "event_category": "Story", "mission_id": 100011, "map_no": 1154, "level": 100, "multiplier": 1.0, "charisma": 57, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 6], "ext": "攻撃待ち増加=90,ダメージ開始待ち=900"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["機械", "水棲", "アトランティスの機械巨人"], "hp": 550000, "attack": 6000, "base_hp": 550000, "base_attack": 6000, "damage_type": "magical", "armor_defense": 5500, "magic_defense": 50, "attack_speed": 200, "attack_wait": 75, "attack_interval": 456, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2153440, "race_id": 10, "special_effect_id": 516, "change_to": 1, "change_condition": 5, "missile_id": 1082, "missile": {"speed": 8.0}, "master_id": 37564, "global_id": 11181, "to_condition": 5, "to_global_id": 11182, "commands": {"raw": "DoEnemy_RegistCommand(\"OnModeChanged\", \" SetStageFlag( 1 , 1 ); \nCallEvent(2461,2462,2463,2464,2465,2466,2467);\nDoEnemy_RouteMoveChange(\"ID=200\", \"永久停止解除=1\");\n\"); SetStageFlag(1, 0);", "sets_flags": [[1, 1], [1, 0]], "on_mode_changed": true}, "route_behaviour": {"transforms": [{"val": 1}], "calls_event": [2461, 2462, 2463, 2464, 2465, 2466, 2467]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "水棲", "アトランティスの機械巨人"], "hp": 550000, "attack": 6000, "base_hp": 550000, "base_attack": 6000, "damage_type": "magical", "armor_defense": 5500, "magic_defense": 50, "attack_range": 300, "attack_speed": 200, "attack_wait": 75, "attack_interval": 256, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assass