sical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 9, "source": "local", "count": 9, "form_count": 1, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349, "spawn_sec": 154}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5250, "attack": 750, "base_hp": 5250, "base_attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 97, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123792, "race_id": 7, "missile_id": 45, "master_id": 32765, "global_id": 6383, "ranged": true, "spawn_sec": 196}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 15000, "attack": 800, "base_hp": 15000, "base_attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 250, "attack_speed": 1, "attack_wait": 50, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124416, "race_id": 7, "special_effect_id": 220, "missile_id": 480, "missile": {"speed": 3.0}, "master_id": 32768, "global_id": 6386, "ranged": true, "spawn_sec": 310}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 20000, "attack": 1000, "base_hp": 20000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 35, "attack_speed": 60, "attack_wait": 100, "attack_interval": 321, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106208, "race_id": 7, "master_id": 32625, "global_id": 6243, "spawn_sec": 324}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "hp": 20000, "attack": 2000, "base_hp": 20000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 600, "magic_defense": 35, "attack_range": 220, "attack_speed": 60, "attack_wait": 100, "attack_interval": 261, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106592, "race_id": 7, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 32626, "global_id": 6244, "ranged": true, "spawn_sec": 355}], "popups": ["アトランティスの巨人兵は\n一定時間の経過、\nもしくはHPを減らすと起動し、\n強烈な遠距離攻撃をしてきます。\n\n起動したアトランティスの巨人兵は\n攻撃力2500以下の\nあらゆる攻撃を受け付けません。", "アトランティスの巨人兵は、\n戦場にいる\nクリオネの魔物の総数に応じて\n攻撃力と防御力がアップします。"], "dialogue": [{"trigger": "enemy_spawn", "enemy_id": 1, "lines": [{"name": "アトランティスの巨人兵", "text": "#C*H$JGFBSO%9ME?O*%#", "face": "l6b6d860e92b3"}, {"name": "イブキ", "text": "ッ、巨人兵が起動した……！？", "face": "u511"}, {"name": "ティマ", "text": "巨人兵はアトランティス防衛システムの要。\n都市の危機に立ち上がるのは当然のことです。", "face": "u2172a1"}, {"name": "アトランティスの巨人兵", "text": "1%1F?#N#!ZXRL**?6M.M", "face": "l6b6d860e92b3"}, {"name": "ヴェロッテ", "text": "なに！？　なにやってんのあれ！？\nなんか急に目が光り始めたんだけど！？", "face": "u150"}, {"name": "ヴィアベル", "text": "クリオネの発する光を吸収しているみたい。\nもしかして、エネルギーを溜めてるとか……？", "face": "u1247a1"}, {"name": "リーンベル", "text": "そうだとしたら止めなければ危険だな。\nあのクリオネたちを優先的に殲滅しよう。", "face": "u268"}]}, {"trigger": "start", "lines": [{"name": "ティマ", "text": "………………。", "face": "u2172a1"}, {"name": "ミネルバ", "text": "……随分、大人しくなったわね。", "face": "u91"}, {"name": "ティマ", "text": "あなた方の言葉を信じたわけではありません。\nですが、もしも彼女の血が真実を証明するのなら──", "face": "u2172a1"}, {"name": "ティマ", "text": "私の忠誠の在処は、別にあります。", "face": "u2172a1"}, {"name": "ジョヴァンニ", "text": "……どういうことだ？", "face": "u123"}, {"name": "イヴリール", "text": "元々、そいつらはポセイオスの眷属じゃあないんだよ。\nあの男は家主の不在に乗じて玉座を掠め取ったコソ泥だ。", "face": "u1959a1"}, {"name": "ティマ", "text": "言葉を慎んでください。\nあの方は行く先を失った我ら一族に、\n標を示してくださった偉大なる海の神。", "face": "u2172a1"}, {"name": "ティマ", "text": "侮辱は許しませんよ。", "face": "u2172a1"}, {"name": "イブキ", "text": "まあ、事実は直に分かることだろう。\nそろそろ目的地に到着する頃合いだぞ。", "face": "u511"}, {"name": "ムルーア", "text": "──あーっ！　あれ、あれじゃない！？", "face": "u1568a1"}, {"name": "？？？", "text": "──────。", "face": "l6b6d860e92b3"}, {"name": "キュステ", "text": "ゴーレム……いや、もしかして機械？\nあんなの、鋼の都でも見たことない……。", "face": "u1248a1"}, {"name": "デューオ", "text": "アトランティスの巨人兵……。", "face": "u594"}, {"name": "イブキ", "text": "古代アトランティス人が遺した、\n人型自律防衛兵器というやつかッ！", "face": "u511"}, {"name": "ミネルバ", "text": "探していた相手……でも、かなりの人気者みたいね。", "face": "u91"}, {"name": "ポセイオスの眷属", "text": "………………。", "face": "l3fd0fcf6776b"}, {"name": "デューオ", "text": "護衛の数がとんでもないなぁ……\nこりゃあ簡単には近づけそうにないや。", "face": "u594"}, {"name": "イヴリール", "text": "そうか、では行くぞ。", "face": "u1959a1"}, {"name": "デューオ", "text": "おおっとぉ！？　正面突破！？", "face": "u594"}, {"name": "イヴリール", "text": "目当ての宝を前に躊躇する海賊がいるのか？\n怖いなら、船でおれの帰りを待っていてもいいぞ。", "face": "u1959a1"}, {"name": "デューオ", "text": "……ハッ、冗談キツイね！　\nアタシは『無双』を冠する海賊だよ？\nあんなのこれっぽっちも怖くないさ！", "face": "u594"}, {"name": "デューオ", "text": "行くよ、王子！　みんなも！\n誰が一番乗りか競争だかんね！", "face": "u594"}]}, {"trigger": "end", "lines": [{"name": "イヴリール", "text": "──今だ！　走れ！", "face": "u1959a1"}, {"name": "デューオ", "text": "王子！　援護お願い！", "face": "u594"}, {"name": "王子", "text": "…………ッ(こくり)", "face": "u1"}, {"name": "ポセイオスの眷属", "text": "そいつらを止めろッ！　絶対に行かせるなッ！", "face": "l3fd0fcf6776b"}, {"name": "スカー", "text": "シャァァァァァックッ！\nカミサマの使いがビビッてんじゃねェ！\nそういうときはテメェで前を張んだよッ！", "face": "u1396a1"}, {"name": "ポセイオスの眷属", "text": "──グハッ！？　こんのっ、ギルマン風情がァ！\nポセイオス様に歯向かう意味を分かっているのか！", "face": "l3fd0fcf6776b"}, {"name": "スカー", "text": "ンなもん知るかァァァァッ！！", "face": "u1396a1"}, {"name": "フィーヌ", "text": "ギルマンだけではありませんよ！", "face": "u1262a1"}, {"name": "ムルーア", "text": "デューオちゃん！　行って！", "face": "u1568a1"}, {"name": "デューオ", "text": "ありがとう！　おーい、巨人兵っ！", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "G0T-Y_!W6!8#OTZL!EKF", "face": "l6b6d860e92b3"}, {"name": "デューオ", "text": "大昔の約束ッ！　アタシが果たしにきたよっ！", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "?KEU+UA23QH?3IWYK+94\nS9UFU$M&DNR3TP#L8UWC\n9Z.D9!BZLAZZ*DW0CXU.", "face": "l6b6d860e92b3"}, {"name": "アトランティスの巨人兵", "text": "──────。", "face": "l6b6d860e92b3"}]}, {"trigger": "end", "lines": [{"name": "リーンベル", "text": "……巨人兵の動きが、止まった？", "face": "u268"}, {"name": "アトランティスの巨人兵", "text": "──おはようございます。", "face": "l6b6d860e92b3"}, {"name": "デューオ", "text": "喋ったー！？", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "初めまして、尊き海風の人よ。\nあなたの名前を教えてください。", "face": "l6b6d860e92b3"}, {"name": "デューオ", "text": "え……えっと、アタシはデューオだよ。", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "新規登録者名──デューオを確認。\n都市管理者権限の委譲を開始します。", "face": "l6b6d860e92b3"}, {"name": "アトランティスの巨人兵", "text": "──────完了。", "face": "l6b6d860e92b3"}, {"name": "ティマ", "text": "まさか、本当に……？　本当に生き残りが──", "face": "u2172a1"}, {"name": "アトランティスの巨人兵", "text": "──アトランティスを起動しますか？", "face": "l6b6d860e92b3"}, {"name": "デューオ", "text": "………………。", "face": "u594"}, {"name": "王子", "text": "…………(こくり)。", "face": "u1"}, {"name": "デューオ", "text": "──お願い。", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "管理者権限による起動申請を受諾──承認。\n全行程のシミュレートを実行中──\nシステムオールグリーン、問題ありません。", "face": "l6b6d860e92b3"}, {"name": "アトランティスの巨人兵", "text": "──アトランティスを起動します。", "face": "l6b6d860e92b3"}, {"name": "ムルーア", "text": "わわわわっ！？　地面が揺れてるよー！", "face": "u1568a1"}, {"name": "ティマ", "text": "目の前の建物に入ってください！\n極めて強い海流の発生が予想されます！\n流される前に、安全な場所に退避を！", "face": "u2172a1"}, {"name": "デューオ", "text": "ええっ！？　みっ、みんな急いでー！", "face": "u594"}, {"name": "カウリオ", "text": "もっ、もうすでにやべぇんだがー！？", "face": "u2081a1"}, {"name": "ムルーア", "text": "たすけてクラールフ様ー！？", "face": "u1568a1"}, {"name": "ティマ", "text": "アトランティス、浮上します！", "face": "u2172a1"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 15, 6], "ext": "攻撃待ち増加=120,ダメージ開始待ち=600"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}, {"kind": "term", "influence": 20, "params": [200]}], "enemies": [{"enemy_id": 1, "hp": 660000, "attack": 7200, "damage_type": "magical", "armor_defense": 5500, "magic_defense": 50, "pattern_id": 2153440}, {"enemy_id": 1, "form_index": 1, "hp": 660000, "attack": 6000, "damage_type": "magical", "armor_defense": 5500, "magic_defense": 50, "pattern_id": 2153456}, {"enemy_id": 3, "hp": 12000, "attack": 800, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "pattern_id": 2153376}, {"enemy_id": 3, "form_index": 1, "hp": 12000, "attack": 800, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "pattern_id": 2153376}, {"enemy_id": 5, "hp": 16800, "attack": 1000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "pattern_id": 2153392}, {"enemy_id": 6, "hp": 7200, "attack": 720, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 7, "hp": 33600, "attack": 2400, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 15, "pattern_id": 2153408}, {"enemy_id": 8, "hp": 7200, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 8, "form_index": 1, "hp": 7200, "attack": 720, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 9, "hp": 12000, "attack": 900, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "pattern_id": 2101936}, {"enemy_id": 10, "hp": 6300, "attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "pattern_id": 2123792}, {"enemy_id": 11, "hp": 18000, "attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "pattern_id": 2124416}, {"enemy_id": 12, "hp": 24000, "attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 35, "pattern_id": 2106208}, {"enemy_id": 13, "hp": 24000, "attack": 2000, "damage_type": "magical", "armor_defense": 600, "magic_defense": 35, "pattern_id": 2106592}]}, "active": true}