{"quest_id": 7513, "name": "貸し切り宿の温泉卵", "description": "魔物の出どころについて調査を開始した\n王子たちは、たった一人が貸し切っている\nという怪しげな宿へと向かう……。\n極級（★１獲得の目安：平均Lv25）", "event": "温泉街決戦～悪魔の卵と命のお湯～", "event_category": "History", "mission_id": 920171, "map_no": 4057, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 32000, "attack": 1200, "base_hp": 32000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 150, "magic_defense": 40, "attack_range": 300, "attack_speed": 50, "attack_wait": 50, "attack_interval": 158, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2121664, "race_id": 3, "special_effect_id": 232, "change_to": 1, "missile_id": 445, "missile": {"speed": 4.0}, "master_id": 32338, "global_id": 5957, "ranged": true, "to_global_id": 5958, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 32000, "attack": 900, "base_hp": 32000, "base_attack": 900, "damage_type": "physical", "armor_defense": 150, "magic_defense": 40, "attack_speed": 10, "attack_wait": 1, "attack_interval": 64, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2121680, "race_id": 3, "master_id": 32339, "global_id": 5958}, {"enemy_id": 3, "source": "local", "count": 19, "form_count": 3, "tags": ["水棲"], "hp": 6000, "base_hp": 6000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 10, "attack_interval": 78, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132192, "race_id": 2, "special_effect_id": 911, "change_to": 3, "change_condition": 2, "master_id": 34428, "global_id": 8045, "to_condition": 2, "to_global_id": 8046, "route_behaviour": {"transforms": [{}]}, "spawn