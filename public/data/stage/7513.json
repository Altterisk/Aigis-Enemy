resist": 1000, "transform_resist": 1000, "pattern_id": 2104320, "race_id": 14, "change_to": 5, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 518, "global_id": 517, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 18, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 322, "global_id": 321, "ranged": true, "spawn_sec": 28}, {"enemy_id": 9, "source": "local", "count": 11, "form_count": 2, "hp": 8000, "attack": 1100, "base_hp": 8000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104400, "race_id": 14, "change_to": 9, "master_id": 522, "global_id": 521, "to_global_id": 522, "route_behaviour": {"transforms": [{"wait": 300}]}, "spawn_sec": 96}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 5, "attack_interval": 55, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104416, "race_id": 14, "change_to": 8, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 523, "global_id": 522, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "フィーヌ", "text": "まだ調べていない場所と言えば、\nこの貸し切りになっている宿ですが……。", "face": "u1415a1"}, {"name": "ソーマ", "text": "変ですね……従業員の方もいません。", "face": "u1138a1"}, {"name": "エマ", "text": "他の宿の方に聞き込みしたところ、\n経営者一家は現在遠方に旅行中だとか。\nかなりの高額で宿全体を貸し出したようですね。", "face": "u1137a1"}, {"name": "カノン", "text": "ますます怪しいわね……って、\nみんな！　あそこに誰かいるわよ！", "face": "u1417a1"}, {"name": "グレーターデーモン", "text": "──ふむ、お客人かい？\n残念ながらこの宿は現在貸し切り中──と、\nなんだい、ずいぶん珍しい来客があったものだ。", "face": "lc424592c17e2"}, {"name": "フィーヌ", "text": "グレーターデーモン！？\nあなたがドラコリザードを、\n温泉街に放った黒幕なのですか！！", "face": "u1415a1"}, {"name": "エマ", "text": "周りにあるのは卵……ですね。\n温泉の熱で孵化させるつもりでしょうか。\n即刻、危険行為の中断を要請します。", "face": "u1137a1"}, {"name": "グレーターデーモン", "text": "ああ、数匹逃げてしまっていたのかい。\nその点については謝罪し、損害を補填しよう。", "face": "lc424592c17e2"}, {"name": "グレーターデーモン", "text": "だが、孵化の中断は無理な相談だ。\nそういう契約でね、それにほら──", "face": "lc424592c17e2"}, {"name": "グレーターデーモン", "text": "まさに孵化しようという頃合いだ。\n今更止められるようなものではないよ。", "face": "lc424592c17e2"}, {"name": "フィーヌ", "text": "この温泉街を滅茶苦茶にするつもりですね！？\nそんなことはさせません！　まだ入ってないのに！", "face": "u1415a1"}, {"name": "エマ", "text": "皆さんドラコリザードの卵には注意を。\n衝撃を与えればそれだけ孵化も早まります、\n一斉に孵化させてしまえば迎撃も難しい。", "face": "u1137a1"}, {"name": "フィーヌ", "text": "よくも……よくも私の初めての温泉旅行をー！！", "face": "u1415a1"}]}, {"trigger": "end", "lines": [{"name": "グレーターデーモン", "text": "……これ以上の業務遂行は不可能だね。\nそもそも王子の相手は契約に含まれていない。\nワシはこのあたりで退散させてもらうよ。", "face": "lc424592c17e2"}, {"name": "フィーヌ", "text": "ちょ、ちょっと待ってください！！\nあなたが黒幕ではないのですか！？", "face": "u1415a1"}, {"name": "グレーターデーモン", "text": "ワシは業務を委託されただけで、\n今回ばかりはただの雇われ悪魔だよ。\nドラコリザードの孵化は雇用主の希望さ。", "face": "lc424592c17e2"}, {"name": "フィーヌ", "text": "ではその雇用主とは誰なんですか！？\n私の！　温泉旅行を！　台無しにした犯人は！", "face": "u1415a1"}, {"name": "グレーターデーモン", "text": "守秘義務の関係上、言えないね。\nなに、これだけの騒ぎを起こしたんだ、\nすぐにあちらも見つけてくれるだろうさ。", "face": "lc424592c17e2"}, {"name": "グレーターデーモン", "text": "ではさらばだ、王子諸君。\n賠償金については雇用主に請求してくれたまえ。\n間違ってもワシの方には送らないように。", "face": "lc424592c17e2"}, {"name": "カノン", "text": "……帰っちゃったわね。", "face": "u1417a1"}, {"name": "エマ", "text": "それならそれで好都合です、\n私たちは黒幕の捜索に戻りましょう。", "face": "u1137a1"}, {"name": "サオシュ", "text": "あとで温泉の掃除もしないとですね、\nたくさん散らかしちゃいましたから……。", "face": "u1139a1"}, {"name": "フィーヌ", "text": "疲れを癒しに来たはずが、\n余計に疲れている気がします……。", "face": "u1415a1"}, {"name": "フィーヌ", "text": "あーもー！　犯人は誰なんですかー！？", "face": "u1415a1"}]}], "active": true}