08, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "tags": ["タルタロスの呪縛", "置物"], "fixture": true, "uncounted": true, "hp": 30000, "attack": 100, "base_hp": 30000, "base_attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "attack_speed": 1, "attack_wait": 90, "attack_interval": 222, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2168544, "special_effect_id": 2345, "master_id": 40011, "global_id": 13628, "spawn_sec": 229}, {"enemy_id": 11, "source": "local", "count": 12, "form_count": 1, "tags": ["タルタロスの呪縛"], "hp": 15000, "attack": 550, "base_hp": 15000, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 75, "attack_interval": 240, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2173696, "race_id": 11, "special_effect_id": 2525, "master_id": 41224, "spawn_sec": 249}, {"enemy_id": 12, "source": "local", "count": 5, "form_count": 1, "tags": ["タルタロスの呪縛"], "hp": 62000, "attack": 350, "base_hp": 62000, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 75, "attack_interval": 199, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2168528, "special_effect_id": 2344, "missile_id": 11, "master_id": 40010, "global_id": 13627, "ranged": true, "spawn_sec": 278}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 200000, "attack": 3500, "base_hp": 200000, "base_attack": 3500, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_range": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 343, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173504, "race_id": 10, "special_effect_id": 2522, "missile_id": 45, "master_id": 41210, "ranged": true, "spawn_sec": 351}], "popups": ["影のレオナがいる間、\n全ての敵ユニットの\n攻撃力がアップします。\n\nまた影のレオナがいる間、\n味方ユニットの魔法耐性を\n30％ダウンさせます。\n　　　　　　(1/2)", "影のレオナは、\n戦場にいる呪いの泥の総数に応じて\n攻撃と防御がアップします。\n\n\n\n\n　　　　　　(2/2)", "影のレオナの黒鳥は\n拠点には向かわず、\nしばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "チレン", "text": "……うわぁ。\n帝都と、そっくりっすね。\n道、間違えそうっす……。", "face": "u2917a1"}, {"name": "サスキア", "text": "無人の都じゃなさそうですね。\nあちらの家にも、こっちにも、ずいぶん大勢の人が。\nそれも帝都で見かけたことのない方ばかりです。", "face": "u2918a1"}, {"name": "チレン", "text": "あっ、巨人族の連中もいるっす。\nおーい！　そっちも黒い泥に困って――", "face": "u2917a1"}, {"name": "影の帝国巨兵", "text": "――止まれ！\n白の帝国の軍勢が、何用であるか！", "face": "l322ed888eb2d"}, {"name": "チレン", "text": "……えっ。\nあの、あれ？　どういうことっすか？", "face": "u2917a1"}, {"name": "影の帝国巨兵", "text": "故郷に住み続けたければ、帝国に従え。\nそれを拒めば、土地を捨てろと？\n我らは、そのどちらも選ばぬ！", "face": "l322ed888eb2d"}, {"name": "チレン", "text": "うぇぇぇ！？　待って！？\nそんな話ぜんぜんしてないっすよ！？", "face": "u2917a1"}, {"name": "影のディアナ", "text": "――お待ちなさい。\nその方々は、私がお招きした客人です。", "face": "u2914a1"}, {"name": "影の帝国巨兵", "text": "……はっ。女皇陛下。", "face": "l322ed888eb2d"}, {"name": "ディアナ", "text": "女皇、ですか。\nずいぶんと出世なさいましたね。", "face": "u624"}, {"name": "影のディアナ", "text": "借り物の玉座では、できないこともありますので。\nいかがです？　私の国は。", "face": "u2914a1"}, {"name": "ディアナ", "text": "タルタロスの魔力を帯びた者。\n帝国に恨みを持つ者、帝国を頼れぬ者……。\nそうした方々を、迎え入れたのですね。", "face": "u624"}, {"name": "影のディアナ", "text": "ええ。追い払われずに眠れる場所と、明日の食事を。\nまずは、それだけでもと。", "face": "u2914a1"}, {"name": "白の皇帝", "text": "その者たちに、武器を持たせたのか？", "face": "u418"}, {"name": "影の帝国巨兵", "text": "黙れ、偽りの皇帝！　武器持つは我らの意思！\n家族を連れて、どこへ行けばよいかも分からぬ時、\nこの地に住めと言ってくださったのは、女皇陛下だ！", "face": "l322ed888eb2d"}, {"name": "影の帝国巨兵", "text": "ようやく得た安住の地を、また手放せというのなら。\n今度こそ、我らは戦う！", "face": "l322ed888eb2d"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "レオナ", "text": "だからといって、\n帝都を襲ってよい理由には――", "face": "u2600a1"}, {"name": "？？？", "text": "――ならない。\nああ、分かっているとも、オリジナル。", "face": "u2915a1"}, {"name": "レオナ", "text": "……っ。\nやはり、私もか……。", "face": "u2600a1"}, {"name": "影のレオナ", "text": "顔を見た途端、それか。\n互いに、歓迎できる相手ではないらしい。", "face": "u2915a1"}, {"name": "レオナ", "text": "私の願いから生まれたのなら、分かるだろう。\nこの国にいる者たちを、戦に巻き込んでどうする。", "face": "u2600a1"}, {"name": "影のレオナ", "text": "では、望むなと？\n国のため、立場のため、誰かのため。\nそうして黙っていれば、いつか報われるとでも？", "face": "u2915a1"}, {"name": "レオナ", "text": "…………。", "face": "u2600a1"}, {"name": "影のレオナ", "text": "……お前の答えは、分かっている。\n私は、その答えを選べなかったものだ。\nそれ以上、言わせるな。", "face": "u2915a1"}, {"name": "影のディアナ", "text": "レオナ。\n……そこまでにしておきなさい。", "face": "u2914a1"}, {"name": "ディアナ", "text": "あなたも、同じだと言いたいのですか。\n私の中にあった願いは、\n民を戦わせてでも、叶えるべきものだと。", "face": "u624"}, {"name": "影のディアナ", "text": "次の皇帝が、民を見捨てる者だったら。\nその次が、また闘争を望む者だったら。\nあなたにも、その懸念はあったはずです。", "face": "u2914a1"}, {"name": "ディアナ", "text": "……ええ。\n帝国が強さを求めたのは、乱世ゆえ。\nしかし平和な世が訪れれば、その制度すら毒になる。", "face": "u624"}, {"name": "影のディアナ", "text": "ならば、私が治めればよい。\n何者にも脅かされぬだけの力で、\n私の民を、守り続ければ――", "face": "u2914a1"}, {"name": "フローガ", "text": "……お待ちを。\nどうか、双方剣をおさめてください。", "face": "u878"}, {"name": "影のディアナ", "text": "……何のつもりですか？", "face": "u2914a1"}, {"name": "フローガ", "text": "ここに来てからですね、\n影のおふたりの魔力が、どんどん強くなっているんです。\nたぶん、皇帝陛下と、オリジナルと接触したから。", "face": "u878"}, {"name": "フローガ", "text": "このままじゃ、ふたりとも、\nタルタロスの呪いに蝕まれて、\nただの魔物に成り果ててしまいますよ！", "face": "u878"}, {"name": "影のレオナ", "text": "承知の上だ。\n力を借りねば、望むことさえ許されぬのならな。", "face": "u2915a1"}, {"name": "白の皇帝", "text": "……ならば、まず、その呪いを断つ。\nディアナとレオナが原型ならば、話は通じるだろう。", "face": "u418"}, {"name": "影のディアナ", "text": "でしたら、やって見せてください。\n弱き者を蹂躙したその力で。", "face": "u2914a1"}]}, {"trigger": "end", "lines": [{"name": "ディアナ", "text": "どうにも、腹が立ちますね……。", "face": "u624"}, {"name": "マルゴット", "text": "ディアナ様の欲望って、\n帝国のことだけではないですからね。", "face": "u1343a1"}, {"name": "マルゴット", "text": "おやすみの日は昼過ぎまで眠りたいとか、\n王子殿下とおでかけしたいとか――", "face": "u1343a1"}, {"name": "ディアナ", "text": "マルゴット、場を和ます必要はありません。", "face": "u624"}, {"name": "マルゴット", "text": "はっ、ここで止めておきます！", "face": "u1343a1"}, {"name": "影のディアナ", "text": "――戦えない方々を、奥へ。\nあなたの一族も、負傷者はもう下がらせなさい。", "face": "u2914a1"}, {"name": "影の帝国巨兵", "text": "承知しました。\n……女皇陛下は、どうなさるので？", "face": "l322ed888eb2d"}, {"name": "影のディアナ", "text": "私は、ここに。\nあなたも、皆を頼みますよ。", "face": "u2914a1"}, {"name": "影の帝国巨兵", "text": "我らを置いて、おふたりだけで白の帝国と戦われると？\nその命令には、従えませぬな。", "face": "l322ed888eb2d"}, {"name": "影のディアナ", "text": "……聞き分けのない方ですね。\nあなた方を守るためには、こうするのが――", "face": "u2914a1"}, {"name": "影の帝国巨兵", "text": "そのために、家族を守る場所を得た代わりに、\n女皇陛下を見捨ててきたと。\n我が子らに、そう語れと仰せですか。", "face": "l322ed888eb2d"}, {"name": "影のディアナ", "text": "…………。", "face": "u2914a1"}, {"name": "影のレオナ", "text": "……負傷者を送り届けろ。\n戻ったら、私の指示に従え。それでいいな。", "face": "u2915a1"}, {"name": "影の帝国巨兵", "text": "……はっ！　参謀殿！", "face": "l322ed888eb2d"}, {"name": "ディアナ", "text": "――気に入らない。\n本当に、心底仲良くなれる気はしませんが……。", "face": "u624"}, {"name": "ディアナ", "text": "どうやら、民にとってはよき女皇であるようですね。\n少しだけ、安心しました。", "face": "u624"}, {"name": "影のディアナ", "text": "では、決着を付けましょう。\nもうひとりの私。", "face": "u2914a1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 18, "params": [150]}], "enemies": [{"enemy_id": 1, "hp": 300000, "attack": 1000, "damage_type": "magical", "armor_defense": 350, "magic_defense": 10, "pattern_id": 2173440}, {"enemy_id": 1, "form_index": 1, "hp": 300000, "attack": 1000, "damage_type": "magical", "armor_defense": 350, "magic_defense": 10, "pattern_id": 2173440}, {"enemy_id": 3, "hp": 21000, "attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "pattern_id": 2173680}, {"enemy_id": 4, "hp": 120000, "attack": 800, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "pattern_id": 2173648}, {"enemy_id": 4, "form_index": 1, "hp": 120000, "attack": 1000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "pattern_id": 2173648}, {"enemy_id": 4, "form_index": 2, "hp": 120000, "attack": 1200, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "pattern_id": 2173648}, {"enemy_id": 7, "hp": 14000, "attack": 1700, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "pattern_id": 2173488}, {"enemy_id": 8, "hp": 35000, "attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2159904}, {"enemy_id": 8, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 10, "hp": 30000, "attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "pattern_id": 2168544}, {"enemy_id": 11, "hp": 15000, "attack": 550, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "pattern_id": 2173696}, {"enemy_id": 12, "hp": 62000, "attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2168528}, {"enemy_id": 13, "hp": 200000, "attack": 3500, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2173504}]}, "active": true}