ot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2122704, "race_id": 16, "special_effect_id": 491, "missile_id": 26, "master_id": 32522, "global_id": 6141, "ranged": true, "spawn_sec": 62}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 64}, {"enemy_id": 10, "source": "local", "count": 13, "form_count": 1, "tags": ["傭兵"], "hp": 2000, "attack": 400, "base_hp": 2000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 136, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121808, "master_id": 32384, "global_id": 6003, "spawn_sec": 90}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "hp": 1500, "attack": 20, "base_hp": 1500, "base_attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 35, "attack_speed": 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 633, "global_id": 632, "ranged": true, "spawn_sec": 138}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2122688, "race_id": 3, "special_effect_id": 233, "change_to": 1, "change_condition": 1, "master_id": 32521, "global_id": 6140, "variants": [{"tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112032, "race_id": 3, "special_effect_id": 233, "master_id": 30634, "global_id": 4253}], "spawn_sec": 142}], "popups": ["ディエーラがいる間は、\nマーセナリーの\n攻撃力と防御力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴィンセント", "text": "――王子、そろそろ洞窟の終端が近い。\n戦闘の準備をしておけ。", "face": "u103"}, {"name": "ヴァンパイア公爵", "text": "――ほう、来たか。\n王子、そして我が愚昧なる先達たちよ。", "face": "lee015c5a5de2"}, {"name": "アンナ", "text": "ヴァンパイア公爵……！\nあなたが花嫁達をさらっていたんですね。\nもう逃げ場はありません。皆さんを解放してください。", "face": "l25e4b61a34c7"}, {"name": "ラキュア", "text": "待てアンナ。事態はそう簡単でもない。\n――さぁ、どうした公爵よ。\n今日は随分と卑屈な顔をしているではないか。", "face": "u344"}, {"name": "ヴァンパイア公爵", "text": "……ラキュアよ、お前も気付いているのだろう？\nあの御方が、とうとう目を覚ましたのだ。\n我が氏族に力を与えてくださったあの御方が。", "face": "lee015c5a5de2"}, {"name": "ラキュア", "text": "何が『あの御方』か。\nあの女こそ、予らの父祖が築いた\nヴァンパイアの王国が、滅んだ元凶ではないか。", "face": "u344"}, {"name": "ヴァンパイア公爵", "text": "だが、それ故に古き血脈は多くが滅び、\n我らが世代の時が始まったのだろう。\nさぁラキュアよ、お前もこちらへ来い。", "face": "lee015c5a5de2"}, {"name": "ラキュア", "text": "……断る。\n予はお前に、一度たりとも理解を示さぬ。\nそしてこれからも、手を組むことはない。", "face": "u344"}, {"name": "ヴァンパイア公爵", "text": "そうか、残念だラキュアよ。\nまがい物でない、純血のヴァンパイアたるお前なら、\n最後には理解してくれると思っていたのだが……。", "face": "lee015c5a5de2"}, {"name": "ヴァンパイア公爵", "text": "まぁ良い……。敵対するというのなら、\nあの御方の邪魔をさせるわけにはいくまい。\nここで足止めをさせてもらうとしよう。", "face": "lee015c5a5de2"}, {"name": "ヴァンパイア公爵", "text": "我が配下の者共よ、あの花嫁を放て。\nブラッドストーンの力があれば、\n精神支配に抗った意志の強さが逆効果となるだろう。", "face": "lee015c5a5de2"}, {"name": "ディエーラ", "text": "……はぁ……はぁ……っ！\n王子、逃げて、ください……っ！", "face": "u1010a1"}, {"name": "トトノ", "text": "ディエーラさん！\nそれにあの傭兵さん達は、\nディエーラさんの捜索に出ていた方々では……！？", "face": "u316"}, {"name": "ラキュア", "text": "……ブラッドストーンは精神支配の宝玉ではなく、\nその者の理性を奪い、欲望をくすぐる魔性の存在。", "face": "u344"}, {"name": "ラキュア", "text": "公爵の精神支配を跳ね除けたとしても、\n今のディエーラでは戦闘本能のみを顕在化され、\nこちらに銃を向けてくることだろう。", "face": "u344"}, {"name": "ヴィンセント", "text": "スイレンの時と同じ、ということか。\n王子、彼女は商人にしておくには惜しい\n銃の名手にして用兵の専門家だ。", "face": "u103"}, {"name": "ヴィンセント", "text": "吸血鬼だけでなく、彼女の能力にも注意しろ。\n絶対に気を抜くな。\n全員、無事に連れて帰るぞ。", "face": "u103"}]}, {"trigger": "end", "lines": [{"name": "ヴァンパイア公爵", "text": "ぐっ……やはり強い……。\n我ら血族を凌駕するとは、\n当代の人間はどこまで成長するのだ。", "face": "lee015c5a5de2"}, {"name": "エマ", "text": "離散した我らが王国と、未だ歩みを続ける人間。\nその間にある差を理解できていないとは、\n何と哀れなる子でありましょうか……。", "face": "u582"}, {"name": "ディエーラ", "text": "はぁ……はぁ……。\nきっと、助けに来てくれると信じていました……。\nちゃんと、囮役は果たせていましたか……？", "face": "u1010a1"}, {"name": "王子", "text": "…………。\n…………（こくり）", "face": "u1"}, {"name": "ディエーラ", "text": "ふふ、私が自分で望んだことです……。\n王子、そんなに辛そうなお顔をしないでください。", "face": "u1010a1"}, {"name": "シルヴィア", "text": "……エマ、このまま見過ごせば、\nきっとまた被害者が出てしまいますわ。\n高貴なるあなたの手を汚させるのは不本意ですが……。", "face": "u442"}, {"name": "エマ", "text": "――いいえ、御意に、我らが姫よ。\nそれがヴァンパイアの王国、最後の王家の命なれば。", "face": "u582"}, {"name": "ヴァンパイア公爵", "text": "くっ……まだだ、まだ滅びるわけにはいかない。\nおぉ、おぉ、ブラッドストーンよ、我に力を！！", "face": "lee015c5a5de2"}, {"name": "ラキュア", "text": "なっ……自らブラッドストーンに身を委ねるとは！\nそこまで堕ちたか、公爵よ……！！", "face": "u344"}, {"name": "ヴァンパイア公爵", "text": "ほざけぇ……ッ！！\n恩義ある主のため、身を捧ぐのが臣下なれば……ッ！！", "face": "lee015c5a5de2"}, {"name": "ヴァンパイア公爵", "text": "ぐっ、ぐぉぉッ！\nブラッドストーンの力が暴走する……ッ！！\n我に、我に古き血脈の力をォ……ッ！！", "face": "lee015c5a5de2"}]}], "active": true}