{"quest_id": 7047, "name": "美しき凶弾", "description": "洞窟へ突入した一行はヴァンパイア公爵に\n囚われたディエーラと相対する。\n襲い来る不死者を退け、花嫁を奪還せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "ジューンブライド・ミッドナイト", "event_category": "History", "mission_id": 920145, "map_no": 5560, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 20, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112032, "race_id": 3, "special_effect_id": 233, "master_id": 30634, "global_id": 4253, "spawn_sec": 22}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111632, "race_id": 11, "special_effect_id": 233, "master_id": 30613, "global_id": 4232, "spawn_sec": 36}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "a