_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 97}, {"enemy_id": 9, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 99}, {"enemy_id": 10, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 113}, {"enemy_id": 11, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 140}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "デシウスはこちらに進んで行ったようです。\n王子、急ぎましょう！", "face": "l4f471a324987"}, {"name": "セシリー", "text": "……ん？　なんだあの跡は。\n戦車の轍の様に見えるが……。", "face": "u21"}, {"name": "ゴブリン", "text": "ギャギャ！　ミツケタ！　ニンゲン！　ミツケタ！\nシンヘイキ！　タメス！", "face": "l8842a0a56f90"}, {"name": "ゴブリン博士", "text": "……フフフ。早速コレを使う相手がきたナ。\n常闇の聖霊により授かっタ、新たな叡智にヨリ、\n我らゴブリン族は更なる高みへと進むのダ！", "face": "l62c52925fb19"}, {"name": "ゴブリン", "text": "イシ！　ナゲル！\nイシ！　ナゲル！", "face": "l8842a0a56f90"}, {"name": "アンナ", "text": "王子、ゴブリン達が向かってきます！\n戦闘のご準備を！", "face": "l4f471a324987"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "そ、そんナ……新兵器カタパルトが……ッ！\n常闇の聖霊から得た叡智の結晶が……。", "face": "l62c52925fb19"}, {"name": "ゴブリン", "text": "ギャギャ、カタパルト、コワレタ……！\n博士、ニゲル……ハヤク、ニゲル！", "face": "l8842a0a56f90"}, {"name": "ゴブリン博士", "text": "そうダ、気落ちしている場合ではナイ！\n失敗は成功のモト……。\n強度が足りなかったノダ。今度は材質を変エテ……。", "face": "l62c52925fb19"}, {"name": "兵士", "text": "ゴブリン軍、撤退していきます！", "face": "l86b54cad43ba"}, {"name": "ケイティ", "text": "なんとかなりましたね。ですが、\nゴブリンが大型兵器を使いこなす様になるとは……。\nカタパルトの使用は人間でも訓練が必要です。", "face": "u114"}, {"name": "セシリー", "text": "さっきのゴブリン達だが、\n常闇の聖霊から力を与えられたと言っていたぞ。", "face": "u21"}, {"name": "ケイティ", "text": "もし、それが本当なら、厄介ですね。\nまだ確証が得られた訳ではないですが、\n注意して先に進みましょう。", "face": "u114"}]}], "map": {"image": "Map5429", "w": 960, "h": 640, "spots": [{"k": "b", "x": 30, "y": 419}, {"k": "m", "x": 715, "y": 171, "id": 200}, {"k": "m", "x": 564, "y": 152, "id": 201}, {"k": "m", "x": 427, "y": 184, "id": 202}, {"k": "m", "x": 306, "y": 279, "id": 203}, {"k": "m", "x": 177, "y": 347, "id": 204}, {"k": "m", "x": 391, "y": 440, "id": 205}, {"k": "m", "x": 550, "y": 453, "id": 206}, {"k": "m", "x": 709, "y": 486, "id": 207}, {"k": "r", "x": 706, "y": 99, "id": 300}, {"k": "r", "x": 568, "y": 87, "id": 301}, {"k": "r", "x": 480, "y": 90, "id": 302}, {"k": "r", "x": 344, "y": 150, "id": 303}, {"k": "r", "x": 204, "y": 258, "id": 304}, {"k": "r", "x": 104, "y": 304, "id": 305}, {"k": "r", "x": 275, "y": 378, "id": 306}, {"k": "r", "x": 625, "y": 407, "id": 307}, {"k": "r", "x": 432, "y": 261, "id": 308}, {"k": "r", "x": 533, "y": 217, "id": 309}]}, "start_cost": 10, "active": true, "name_en": "Goblin Army's New Weapon"}