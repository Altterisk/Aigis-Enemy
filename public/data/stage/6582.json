orm_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 20, "attack_interval": 166, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104576, "master_id": 803, "global_id": 802, "spawn_sec": 54}, {"enemy_id": 5, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 600, "base_hp": 2800, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097712, "master_id": 40, "global_id": 39, "spawn_sec": 124}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 90, "attack_interval": 261, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098480, "missile_id": 41, "missile": {"speed": 4.0, "splash": 133}, "master_id": 98, "global_id": 97, "ranged": true, "spawn_sec": 141}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 22000, "attack": 1500, "base_hp": 22000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "special_effect_id": 317, "master_id": 31289, "global_id": 4908, "spawn_sec": 162}], "dialogue": [{"trigger": "start", "lines": [{"name": "カゲロウ", "text": "――待て、王子。\nこの先にサイクロプスがいるようだ。", "face": "u139"}, {"name": "エレーヌ", "text": "サイクロプスだって……？\nこの辺りに巨人が出現するなんて……。\n何かの異変の兆候だろうか……。", "face": "u481"}, {"name": "フィリス", "text": "もしかして「封印晶」の影響だったりな。", "face": "u40"}, {"name": "ノワール", "text": "……いや、そのまさかだ。\n微かに「封印晶」の魔力を感じる……。", "face": "u679"}, {"name": "フィリス", "text": "魔界の迷宮から持ち出したのか、\n持ち出した魔物から奪ったのかってとこか？", "face": "u40"}, {"name": "ケイティ", "text": "どちらにせよ、サイクロプスが\n「封印晶」を持っているのなら、\nいつも以上に警戒が必要ですね。", "face": "u114"}, {"name": "アンナ", "text": "はい。放置すれば近隣の村に、\n被害が出るかもしれません。\n王子、ここで討伐しておきましょう。", "face": "l2fe133ccbf94"}]}, {"trigger": "end", "lines": [{"name": "ノワール", "text": "……やはり「封印晶」の欠片を持っていたか。", "face": "u679"}, {"name": "バルバストラフ", "text": "しっかり回収しておくのじゃぞ。\n他の魔物が拾ったら大変なことになるからの。", "face": "u63"}, {"name": "ケイティ", "text": "魔物がここまで凶暴化するなんて、\n欠片の状態でも「封印晶」は危険ですね……。", "face": "u114"}, {"name": "アンナ", "text": "周辺の安全確保の為にも\n「封印晶」の回収が急務ですね。", "face": "l2fe133ccbf94"}, {"name": "アンナ", "text": "王子、この周辺にも「封印晶」を\n所持した魔物がいるかもしれません。\n警戒を怠らないようにしましょう。", "face": "l2fe133ccbf94"}]}], "map": {"image": "Map920115_5482", "w": 960, "h": 640, "spots": [{"k": "b", "x": 888, "y": 461}, {"k": "m", "x": 311, "y": 155, "id": 200}, {"k": "m", "x": 460, "y": 133, "id": 201}, {"k": "m", "x": 608, "y": 122, "id": 202}, {"k": "m", "x": 760, "y": 155, "id": 203}, {"k": "m", "x": 832, "y": 253, "id": 204}, {"k": "m", "x": 770, "y": 334, "id": 205}, {"k": "m", "x": 636, "y": 324, "id": 206}, {"k": "m", "x": 517, "y": 312, "id": 207}, {"k": "m", "x": 386, "y": 296, "id": 208}, {"k": "m", "x": 232, "y": 302, "id": 209}, {"k": "m", "x": 134, "y": 387, "id": 210}, {"k": "m", "x": 219, "y": 454, "id": 211}, {"k": "m", "x": 347, "y": 451, "id": 212}, {"k": "m", "x": 477, "y": 438, "id": 213}, {"k": "m", "x": 607, "y": 424, "id": 214}, {"k": "m", "x": 747, "y": 423, "id": 215}, {"k": "r", "x": 272, "y": 224, "id": 300}, {"k": "r", "x": 350, "y": 227, "id": 301}, {"k": "r", "x": 691, "y": 198, "id": 302}, {"k": "r", "x": 750, "y": 250, "id": 303}, {