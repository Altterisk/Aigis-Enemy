{"quest_id": 7493, "name": "魔王の威光を広める新商品？", "description": "王子たちは街の中に邪教徒の隠れ家が\nあると聞きつけ調査を開始する……。\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ30(2021)", "event_category": "Reproduce", "mission_id": 300333, "map_no": 4047, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 700, "attack": 120, "base_hp": 700, "base_attack": 120, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 126, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121600, "race_id": 16, "master_id": 32453, "global_id": 6072, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 16, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 5}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 21}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 23}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 2, "tags": ["エスネア＆エフネのファン"], "hp": 7000, "attack": 550, "base_hp": 7000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 150, "attack_speed": 1, "attack_wait": 75, "attack_interval": 225, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131984, "race_id": 3, "special_effect_id": 906, "change_to": 7, "change_condition": 1, "missile_id": 644, "missile": {"speed": 8.0}, "master_id": 34422, "global_id": 8039, "ranged": true, "variants": [{"tags": ["エスネア＆エフネのファン"], "hp": 7000, "attack": 50, "base_hp": 7000, "base_attack": 50, "damage_type": "magical", "armor_defense": 200, "magic_defense": 10, "attack_wait": 4, "attack_interval": 67, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2132000, "race_id": 3, "special_effect_id": 906, "master_id": 34423, "global_id": 8040}], "sp_change_to": [34812], "spawn_sec": 52}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 7000, "attack": 550, "base_hp": 7000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 75, "attack_interval": 226, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131984, "race_id": 3, "special_effect_id": 1000, "change_to": 6, "missile_id": 644, "missile": {"speed": 8.0}, "master_id": 34812, "global_id": 8429, "from_condition": "sp_change"}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 8000, "attack": 300, "base_hp": 8000, "base_attack": 300, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 180, "attack_speed": 1, "attack_wait": 60, "attack_interval": 187, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2132016, "race_id": 3, "change_to": 10, "change_condition": 1, "missile_id": 645, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34424, "global_id": 8041, "ranged": true, "variants": [{"tags": ["エスネア＆エフネのファン"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_speed": 1, "attack_wait": 50, "attack_interval": 162, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2132032, "race_id": 3, "master_id": 34425, "global_id": 8042}], "spawn_sec": 53}], "popups": ["デーモンシェフがいる間は\n全ての敵の攻撃と防御が\n固定値で150アップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ケイティ", "text": "――ここが通報のあった、邪教徒の隠れ家ですか。\n街の中に潜伏しているとは、大胆ですね。", "face": "u114"}, {"name": "ランヒルド", "text": "確かに魔物の気配がするわね……。\nちょっと堂々とし過ぎな気もするけど。", "face": "u1311a1"}, {"name": "？？？", "text": "クックック……素晴らしい出来だ……。\nこれなら高値が付くこと間違いなしだぞ……。", "face": "l3870de03ebd9"}, {"name": "？？？", "text": "ありがたきお言葉……。\nこれで魔王様の威光を、\n物質界に広めることができるでしょう。", "face": "le77de8321ff5"}, {"name": "ランヒルド", "text": "……魔王だって？\n魔王ガリウスの信奉者ってことかしら。", "face": "u1311a1"}, {"name": "ケイティ", "text": "誤報の可能性もありますが、\n魔王ガリウスの名を聞いた以上、\n見過ごすことはできませんね。", "face": "u114"}, {"name": "ランヒルド", "text": "そうね。それじゃあ行くわよ……。\n――全員動くな！　強制捜査だッ！！", "face": "u1311a1"}, {"name": "ゴブリン", "text": "ギャギャ！？　ガサイレ！？", "face": "la10cbeb95b94"}, {"name": "デーモン", "text": "まずい！　発売前の商品を見られたら……。\n急いで隠すのだ！！", "face": "lfcb7391e08e0"}, {"name": "ランヒルド", "text": "……この慌てよう、大当たりみたいね。\n王子、ガサイレ開始よ！", "face": "u1311a1"}]}, {"trigger": "end", "lines": [{"name": "デーモンシェフ", "text": "――待て待て待て！\n王子、降伏する！　お前たちも落ち着け！", "face": "l3870de03ebd9"}, {"name": "ランヒルド", "text": "で、デーモンシェフ！？\nいったいどういうこと？", "face": "u1311a1"}, {"name": "デーモンシェフ", "text": "やれやれ……人間を怯えさせないよう、\n隠れて新規事業の準備をしていたのが裏目に出たか。", "face": "l3870de03ebd9"}, {"name": "デーモンシェフ", "text": "実は、副デーモンシェフが新たな技術を身に着けてな。\nその……フィギュアの作成技術なのだが……。", "face": "l3870de03ebd9"}, {"name": "ランヒルド", "text": "人形の……？\nんん……デモシェフ商会は営業許可を取っているし、\n堂々と作って売れば良かったんじゃないの？", "face": "u1311a1"}, {"name": "デーモンシェフ", "text": "むむむ……そうはいかず……。\n何しろ作っているモノがモノだけにな……。", "face": "l3870de03ebd9"}, {"name": "副デーモンシェフ", "text": "……もう、隠すことはできないでしょう。\n我々は魔王ガリウス様の人形を作っていたのです。", "face": "le77de8321ff5"}, {"name": "副デーモンシェフ", "text": "物質界で共存していくことを選んだとはいえ、\n故郷を離れたデーモンたちには、\n心の拠り所が必要不可欠……。", "face": "le77de8321ff5"}, {"name": "副デーモンシェフ", "text": "そんな同胞たちに、\n懐かしき魔界を思い出すアイテムを与えられたら、と。", "face": "le77de8321ff5"}, {"name": "デーモンシェフ", "text": "しかし、魔王様は人間にとっては侵略者。\nそんなフィギュアを堂々と並べては、\n市民を怖がらせてしまうだろう？", "face": "l3870de03ebd9"}, {"name": "ランヒルド", "text": "なるほど……それで隠れて製造してたのね。\nまったく、ひとこと相談してくれれば……。", "face": "u1311a1"}, {"name": "デーモンシェフ", "text": "面目ない。\n王子たちにとっても、良い思い出ではないと思ってな……。", "face": "l3870de03ebd9"}, {"name": "デーモンシェフ", "text": "それにしてもお前たち、\n捜査に対して、慌てて品物を隠したら\n怪しまれるに決まっているだろう！", "face": "l3870de03ebd9"}, {"name": "ゴブリン", "text": "ギャギャ……ゴメンナサイ……。", "face": "la10cbeb95b94"}, {"name": "ケイティ", "text": "いえ、こちらも調査不足でしたから。\n双方けが人がいなくて何よりです。", "face": "u114"}, {"name": "ランヒルド", "text": "それじゃ、荒らしちゃったし\n片付けを手伝ってから帰ろうかしら。", "face": "u1311a1"}, {"name": "デーモンシェフ", "text": "いやいや、怪しまれることをしたのはこちらだから――", "face": "l3870de03ebd9"}, {"name": "ランヒルド", "text": "良いんだってば。\nこういうのはお互い様なんだから。\nねっ、そうでしょ王子？", "face": "u1311a1"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "デーモンシェフ", "text": "お、王子まで……。\nうむっ、それでは手早く片付けてしまおう！\n終わったら全員に特別ボーナスを出すぞ！", "face": "l3870de03ebd9"}]}], "active": true}