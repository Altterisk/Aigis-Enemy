{"quest_id": 8312, "name": "暗黒ビフビフ盆踊り", "description": "新鮮な魔神ビフロンスの欠片をごくりした\n鬼刃衆は不意に踊り出し、さらにはそれに\n釣られるように不死者が現れて！？\n上級（★１獲得の目安：平均Lv10）", "event": "鬼刃と死霊と夏祭り", "event_category": "History", "mission_id": 920218, "map_no": 4919, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "missile_id": 6, "master_id": 355, "global_id": 354, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 300, "base_hp": 12000, "base_attack": 300, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_wait": 20, "attack_interval": 91, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109360, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30182, "global_id": 3801, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 161, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098304, "special_effect_id": 227, "master_id": 90, "global_id": 89}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス", "置物"], "fixture": true, "hp": 1000, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attac