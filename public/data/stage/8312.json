"physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108080, "master_id": 991, "global_id": 990, "spawn_sec": 153}, {"enemy_id": 17, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108096, "master_id": 992, "global_id": 991, "spawn_sec": 157}, {"enemy_id": 18, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106672, "master_id": 842, "global_id": 841, "spawn_sec": 158}, {"enemy_id": 19, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106688, "master_id": 849, "global_id": 848, "spawn_sec": 162}, {"enemy_id": 20, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099440, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 84, "global_id": 83, "ranged": true, "spawn_sec": 209}], "popups": ["アンデッド系から\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "鬼刃衆", "text": "あそれ、ビフロンス♪　ビフロンス♪", "face": "l3202663e4ef1"}, {"name": "落ち武者", "text": "ビフロンス♪　ビフロンス♪", "face": "lca06fa1777bd"}, {"name": "ヴィクトリア", "text": "……何だあれは？", "face": "u2203a1"}, {"name": "シロガネ", "text": "説明するっす、あの踊りの名は暗黒ビフビフ盆踊り。", "face": "u2126a1"}, {"name": "シロガネ", "text": "死霊の王であるビフロンスの力の残滓を使い、\n常世から呼び出した魂魄を不死者として蘇らせる、\n世にも恐ろしい儀式として知られているっすよ。", "face": "u2126a1"}, {"name": "フーイェン", "text": "おー、詳しいですね。", "face": "u2201a1"}, {"name": "シロガネ", "text": "今考えたっす。", "face": "u2126a1"}, {"name": "祭りの参加者A", "text": "なんだぁ、新しい出し物か？", "face": "l0e195da3b369"}, {"name": "祭りの参加者B", "text": "衣装が凝ってるなぁ、本物みたいだ。", "face": "l0f420af24b07"}, {"name": "ヴィクトリア", "text": "……幸い踊るだけで暴れる様子はないな。\n周囲もまだトラブルだとは認識していない。\n今のうちにどうにかして事態を収束させる。", "face": "u2203a1"}, {"name": "ヴィクトリア", "text": "クレール、できるだけ観客を避難させてくれ。", "face": "u2203a1"}, {"name": "クレール", "text": "は、はい……って、あそこにいるのは、カーニア？", "face": "u2200a1"}, {"name": "鬼刃衆", "text": "ビフロンス♪　ビフロンス♪\nビッフビッフビッフビッフ──♪", "face": "l3202663e4ef1"}, {"name": "串焼き屋台", "text": "ビーフオアチキン？", "face": "l0e195da3b369"}, {"name": "カーニア", "text": "フィッシュで。", "face": "u1685a1"}, {"name": "鬼刃衆", "text": "ノォオオオオッ！　ノーフィッシュッ！\nビーフ！　ビーフ！　ビーフ！　ビーフ！", "face": "l3202663e4ef1"}, {"name": "カーニア", "text": "え？　え、え、え、にゃーーーーーっ！？", "face": "u1685a1"}, {"name": "ヴィクトリア", "text": "おい、意味の分からん理由で人を襲い始めたぞ！", "face": "u2203a1"}, {"name": "シロガネ", "text": "意味が分からんのはいつも通りっすね。", "face": "u2126a1"}, {"name": "フーイェン", "text": "あの鳥さんもキャラが迷走してますねぇ。", "face": "u2201a1"}, {"name": "クレール", "text": "お、落ち着いてないで助けないと！？", "face": "u2200a1"}]}, {"trigger": "end", "lines": [{"name": "落ち武者", "text": "ビ、ビフロ、ンス……。", "face": "lca06fa1777bd"}, {"name": "クレール", "text": "あ、アンデッドたちの動きが止まりましたよ！", "face": "u2200a1"}, {"name": "カーニア", "text": "私は！　お魚が！　食べたかっただけなのにっ！", "face": "u1685a1"}, {"name": "フーイェン", "text": "哀れな鳥さんですね。", "face": "u2201a1"}, {"name": "ヴィクトリア", "text": "そうか、それはすまなかったな。\n鬼刃衆を御し切れなかったこの私の不手際だ。\n夏祭り実行委員会警備部門の長としてお詫びする。", "face": "u2203a1"}, {"name": "ヴィクトリア", "text": "代わりと言っては何だが、ここは私が奢ろう。", "face": "u2203a1"}, {"name": "カーニア", "text": "えっ、わーい！　やったーい！", "face": "u1685a1"}, {"name": "串焼き屋台", "text": "ちなみにうちは魚はやってないよ。", "face": "l0e195da3b369"}, {"name": "カーニア", "text": "うおーっ、そんなー！？", "face": "u1685a1"}, {"name": "ヴィクトリア", "text": "……待て、鬼刃衆は何処に行った？", "face": "u2203a1"}, {"name": "シロガネ", "text": "踊りながら向こう行ったっすよ？", "face": "u2126a1"}, {"name": "ヴィクトリア", "text": "追うぞ、これ以上の被害が出る前に、\n鬼刃衆の暗黒ビフビフ盆踊りを止める！", "face": "u2203a1"}, {"name": "フーイェン", "text": "了解です！", "face": "u2201a1"}, {"name": "クレール", "text": "（締まらない名前だなぁ……）", "face": "u2200a1"}]}], "active": true}