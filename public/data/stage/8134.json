ack_wait": 60, "attack_interval": 175, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2135808, "race_id": 11, "special_effect_id": 229, "change_to": 11, "change_condition": 4, "missile_id": 692, "missile": {"speed": 1.0}, "master_id": 34781, "global_id": 8398, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 8399, "spawn_sec": 178}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 9000, "base_hp": 9000, "damage_type": "physical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2135824, "race_id": 11, "master_id": 34782, "global_id": 8399, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 800, "base_hp": 9000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114592, "race_id": 14, "change_to": 13, "change_condition": 3, "master_id": 31017, "global_id": 4636, "spawn_sec": 190}], "popups": ["温泉に入った大猿は\nHPが徐々に回復します。\n\nまた温泉から上がった大猿は\n攻撃力が上昇します。", "岩を掴んでいるハゲワシは\n一度だけ攻撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ミカ", "text": "ここが温泉郷ー！　やば、めっちゃ種類あんじゃん！", "face": "u2045a1"}, {"name": "アカネ", "text": "目視できるだけでも二十以上はありますね。\nこの中のどれか一つが仙薬湯のはずですが……。", "face": "u1678a1"}, {"name": "ミカ", "text": "んー、全部入っちゃえばいいんじゃない？\nほら、とりまあそこのちょー広い温泉とか──", "face": "u2045a1"}, {"name": "モモ", "text": "──ミカちゃん危ない！", "face": "u597"}, {"name": "王子", "text": "────ッ！", "face": "u1"}, {"name": "ミカ", "text": "わわわっ！？　あ、ありがと王子！", "face": "u2045a1"}, {"name": "アカネ", "text": "……どうやら先約がいたようです。\n温泉がお猿さんに占拠されています。", "face": "u1678a1"}, {"name": "ミカ", "text": "どう見てもお猿さんってレベルじゃなくない！？", "face": "u2045a1"}, {"name": "モモ", "text": "麓の村で会った人たちみたいに、\n温泉効果で元気になってるのかも！", "face": "u597"}, {"name": "フィーヌ", "text": "あ、ここに立て看板がありますよ！\nええと、ふむふむ……攻め力向上の湯？", "face": "u1415a1"}, {"name": "モモ", "text": "たぶん、攻撃力アップってことだね！\nお風呂に入ったお猿さんに気を付けて！", "face": "u597"}, {"name": "アカネ", "text": "来ます！　皆さん迎撃の準備を！", "face": "u1678a1"}]}, {"trigger": "end", "lines": [{"name": "モモ", "text": "筋肉モリモリのお猿さんたちだった……。", "face": "u597"}, {"name": "ミカ", "text": "温泉の力ってすごいなー！", "face": "u2045a1"}, {"name": "フィーヌ", "text": "でも、この辺りの温泉は仙薬湯じゃないみたいです。", "face": "u1415a1"}, {"name": "ミカ", "text": "いろんな効能の温泉があるっぽいねー。\nこりゃ結構お目当て見つけるの大変かも？", "face": "u2045a1"}, {"name": "アカネ", "text": "時間はありますからゆっくり探しましょう。\nちょっとした慰安旅行だと思えば気も楽です。", "face": "u1678a1"}, {"name": "ミカ", "text": "そだねー、手分けしてもいいけど、\nせっかくだから王子も一緒に入っちゃう？\nここの温泉って全部混浴みたいだけど！", "face": "u2045a1"}, {"name": "モモ", "text": "ここここ、混浴っ！？", "face": "u597"}, {"name": "王子", "text": "…………(悩み)", "face": "u1"}, {"name": "フィーヌ", "text": "混浴ッ！　それはとても名案ですね！\n早速そこの温泉に入っちゃいましょう！", "face": "u1415a1"}, {"name": "ミカ", "text": "オッケー！　って、ちょい待ちフィーヌん！\nここ、激熱大熱湯地獄温泉って書いてある──", "face": "u2045a1"}, {"name": "フィーヌ", "text": "熱っぢっっっっっっ！？", "face": "u1415a1"}, {"name": "ミカ", "text": "フィーヌーん！？", "face": "u2045a1"}, {"name": "モモ", "text": "きゅきゅきゅ、救出ー！", "face": "u597"}, {"name": "アカネ", "text": "これは、長丁場になりそうですね……。", "face": "u1678a1"}]}], "map": {"image": "Map920208_4826", "w": 960, "h": 640, "spots": [{"k": "b", "x": 926, "y": 397}, {"k": "m", "x": 93, "y": 167, "id": 200}, {"k": "m", "x": 131, "y": 117, "id": 201}, {"k": "m", "x": 173, "y": 185, "id": 202}, {"k": "m", "x": 213, "y": 138, "id": 203}, {"k": "m", "x": 256, "y": 209, "id": 204}, {"k": "m", "x": 295, "y": 162, "id": 205}, {"k": "m", "x": 85, "y": 424, "id": 206}, {"k": "m", "x": 182, "y": 441, "id": 207}, {"k": "m", "x": 275, "y": 457, "id": 208}, {"k": "m", "x": 342, "y": 420, "id": 209}, {"k": "m", "x": 3