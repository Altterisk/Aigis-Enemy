{"quest_id": 7542, "name": "第三陣 白の王国の貴族騎士", "description": "帝国に反旗を翻した白の王国\n貴族騎士が率いる反乱軍を倒せ！\n＜広域戦闘：敵味方の射程減少＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国三陣", "event_category": "Empire", "mission_id": 940005, "map_no": 4588, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 20, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 45, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111792, "race_id": 16, "master_id": 30637, "global_id": 4256, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 18000, "attack": 500, "base_hp": 18000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133056, "race_id": 16, "change_to": 2, "change_condition": 1, "missile_id": 26, "master_id": 34628, "global_id": 8245, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133264, "race_id": 16, "master_id": 34629, "global_id": 8246}], "spawn_sec": 8}, {"enemy_id": 4, "source": "local", "count": 30, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 11}, {"enemy_id": 5, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 20000, "attack": 450, "base_hp": 20000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130064, "race_id": 16, "master_id": 34058, "global_id": 7675, "spawn_sec": 85}, {"enemy_id": 6, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "spawn_sec": 131}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 46000, "attack": 650, "base_hp": 46000, "base_attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 210, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133312, "race_id": 16, "change_to": 7, "change_condition": 1, "missile_id": 26, "master_id": 34630, "global_id": 8247, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 46000, "attack": 1800, "base_hp": 46000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133328, "race_id": 16, "master_id": 34631, "global_id": 8248}], "spawn_sec": 140}], "dialogue": [{"trigger": "start", "lines": [{"name": "ディルク", "text": "――報告！\n敵軍が回り込む形で、工場地帯に侵入とのこと！", "face": "u287"}, {"name": "レオナ", "text": "……敵勢力が多すぎる。\n白の王国時代の貴族どもめ、\nこれを好機と見て、反旗を翻したか。", "face": "u311"}, {"name": "？？？", "text": "その言葉には、否と答えましょうぞ。\n叛逆軍の軍師レオナ殿。", "face": "l36511b202f8c"}, {"name": "レオナ", "text": "貴様は……どうしてそちら側に立っている。\n子爵よ、帝国騎士の誇りを忘れたか！", "face": "u311"}, {"name": "貴族騎士", "text": "――誇り。\n誇りと言いましたか。これは笑わせる。", "face": "l36511b202f8c"}, {"name": "貴族騎士", "text": "我ら白の王国貴族、先王への忠義は誓えども、\n生まれも知れぬ傭兵などに\n仕えたつもりなど、欠片もありませぬ。", "face": "l36511b202f8c"}, {"name": "貴族騎士", "text": "むしろ、実力主義などというその詭弁が、\n我ら白の王国貴族の誇りをどれほど貶めたことか！", "face": "l36511b202f8c"}, {"name": "レオナ", "text": "……覚悟はできているようだな。\nならば容赦は――", "face": "u311"}, {"name": "アンジェリーネ", "text": "――お待ちなさい。", "face": "u430"}, {"name": "貴族騎士", "text": "おぉ……アンジェリーネ様。\nご機嫌麗しゅう。", "face": "l36511b202f8c"}, {"name": "アンジェリーネ", "text": "えぇ、子爵、あなたも。\nしかし驚きましたわ。\n誰よりも忠義を重んじるあなたが、そちらに立つなんて。", "face": "u430"}, {"name": "貴族騎士", "text": "先王の忘れ形見たる、アンジェリーネ様に\n剣を向けることだけが唯一の心残りですとも。", "face": "l36511b202f8c"}, {"name": "貴族騎士", "text": "それでもなお、白の帝国は歪に肥大化しすぎた。\nそろそろ、清算しなければなりますまい。", "face": "l36511b202f8c"}, {"name": "アンジェリーネ", "text": "えぇ、私も同意見よ。\nけれどそれは、今ではないの。", "face": "u430"}, {"name": "アンジェリーネ", "text": "白の帝国がその清算を終わらせる、\nその長くも短い時間を、\n物質界を狙う亜神たちは待ってくれませんわ。", "face": "u430"}, {"name": "アンジェリーネ", "text": "歪んで、傾いて、反旗を翻されてもなお、\nその異形のままに走り続けることしか、\n今の帝国にはできないのですもの。", "face": "u430"}, {"name": "貴族騎士", "text": "……そこまで、分かった上で帝国に与するのですな。\n感服いたしました、アンジェリーネ様。", "face": "l36511b202f8c"}, {"name": "貴族騎士", "text": "世界の為に祖国を犠牲とするか、\n故国の為に、世界を危険にさらすのか……。\nそれでもなお、我らは祖国を捨てることなどできませぬ。", "face": "l36511b202f8c"}, {"name": "アンジェリーネ", "text": "……そう。\nその忠義、見事ですわ。\nだからこそ、反乱の芽はここで摘み取りましょう。", "face": "u430"}, {"name": "ルーテ", "text": "陛下、王子殿下、お気をつけを。\n子爵は帝国屈指の武人の家系。\n当主たるあの方も、優れた武技を持っています。", "face": "u529"}, {"name": "ルーテ", "text": "私には、どちらが正しいのか分かりませんが……。\nどうかご武運を！", "face": "u529"}]}, {"trigger": "end", "lines": [{"name": "貴族騎士", "text": "初めて剣を交えたが……。\nなるほど、これが英雄王の系譜……。", "face": "l36511b202f8c"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "貴族騎士", "text": "武技も、器も優れた男、か。\nそれだけに惜しいな……。", "face": "l36511b202f8c"}, {"name": "貴族騎士", "text": "総員、後退せよ！　次の作戦に移るぞ！\n伯爵殿に花道をあけてやれ！", "face": "l36511b202f8c"}, {"name": "白の皇帝", "text": "……どうした王子、おかしな顔をしているな。", "face": "u418"}, {"name": "白の皇帝", "text": "白の帝国が限界に達していることなど、\n俺も既に、理解している。", "face": "u418"}, {"name": "白の皇帝", "text": "それでも、お前には――いや、\nこの世界には、亜神に抗う戦力が必要だろう。", "face": "u418"}, {"name": "レオナ", "text": "……陛下。", "face": "u311"}, {"name": "白の皇帝", "text": "案ずるな、別働隊も制したと報告があった。\nまだ帝国は、戦い続けられる。", "face": "u418"}, {"name": "白の皇帝", "text": "――敵は市街に侵入した可能性がある。\n帝国の兵よ、民を守ることを最優先としろ！", "face": "u418"}]}], "active": true}