obal_id": 7652, "to_global_id": 7653}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アンデッド", "ステルス"], "hp": 50000, "attack": 2900, "base_hp": 50000, "base_attack": 2900, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 30, "attack_wait": 50, "attack_interval": 209, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130720, "special_effect_id": 43, "change_to": 14, "change_condition": 1, "master_id": 34036, "global_id": 7653, "variants": [{"tags": ["アンデッド"], "hp": 50000, "attack": 2900, "base_hp": 50000, "base_attack": 2900, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 30, "attack_wait": 50, "attack_interval": 209, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130736, "special_effect_id": 43, "master_id": 34037, "global_id": 7654}]}, {"enemy_id": 16, "source": "local", "count": 22, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 92}, {"enemy_id": 17, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 109}, {"enemy_id": 18, "source": "local", "count": 23, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 145}, {"enemy_id": 19, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31059, "global_id": 4678, "ranged": true, "spawn_sec": 170}], "popups": ["ヴァーニィは、\nブロックされている間\nHPが徐々に回復します。\n\nまたヴァーニィを倒すと\n以降、血の使い魔は\n生み出されません。", "血の使い魔(騎士)の攻撃は、\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。", "血の使い魔(ヴァンパイア公爵)の\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "battle", "at_sec": 8, "lines": [{"name": "ヴァーニィ", "text": "――ああ、母よ、憎き我が創造主よ……。\nなぜ人間などに憧れたのか。\nなぜ私を、人間にしようなどと考えたのか……。", "face": "l058112bdb6bb"}, {"name": "村娘", "text": "知り、ません……。\n私は……ぁっ、ぐぅぅ……。", "face": "le7266fbc54dd"}, {"name": "ヴァーニィ", "text": "そうして人間のフリをするためか？\n創造主の肉体を捨て、人間として生きるために、\n私を実験体としたのか……！", "face": "l058112bdb6bb"}, {"name": "村娘", "text": "やめっ……あぁっ、いやぁぁあぁッ！？", "face": "le7266fbc54dd"}, {"name": "ヴァーニィ", "text": "その身に封じられし始祖の力、\n今こそ私のものとしよう……。", "face": "l058112bdb6bb"}, {"name": "ヴァーニィ", "text": "私が新たな始祖となり、\n血族すべてに、我が身の呪いを――", "face": "l058112bdb6bb"}, {"name": "ジュリア", "text": "ヴァーニィ！！\n今度こそ、その企み止めさせてもらうわ！！", "face": "u1583a1"}, {"name": "ヴァーニィ", "text": "……ほう、我が祝福より脱したか。", "face": "l058112bdb6bb"}, {"name": "ジュリア", "text": "……ヴァーニィ、こっちに来ない？\nあなたの苦しさも悲しみも、\n私たちじゃ癒やすことはできないけど……。", "face": "u1583a1"}, {"name": "エマ", "text": "ジュリア、いったい何を――", "face": "u582"}, {"name": "ジュリア", "text": "――お願い、話をさせて。\nヴァーニィ、こんなに苦しんできたのに、\nそこに救いがないなんて、絶対だめよ！", "face": "u1583a1"}, {"name": "ヴァーニィ", "text": "…………私を憐れむつもりか？", "face": "l058112bdb6bb"}, {"name": "ジュリア", "text": "違うわ！\n一緒に歩いて行こうって言っているのよ！", "face": "u1583a1"}, {"name": "ヴァーニィ", "text": "――同じことを、そこの愚かな姉にも言われたな。\nだが、輝ける道を歩む者たちに、\nこの苦しみは共有できぬと知るがいい。", "face": "l058112bdb6bb"}, {"name": "ヴァーニィ", "text": "されど、今の私には\nその身すら捧げんとする臣下がいる。\n滅びの道など、ふたりで歩むのがちょうどいい。", "face": "l058112bdb6bb"}, {"name": "ヴァンパイア公爵", "text": "……どこまでもお供しましょう。\nヴァーニィ様、血族の誇りを抱く最後の御方。", "face": "lbc1172a2503d"}, {"name": "ジュリア", "text": "ヴァーニィ……。\nお願い、きっとわかり合えるはずだから……。", "face": "u1583a1"}, {"name": "ヴァーニィ", "text": "しつこいぞ、娘。\nさぁ、始祖の血をすする前に、\nまずは邪魔者を蹴散らしてやろう！", "face": "l058112bdb6bb"}, {"name": "セブン", "text": "ジュリア、暗がりに生きるやつには、\nただ眩しいだけの言葉は届かないさ。\nどうしても話がしたいなら、ぶっ倒さないとな。", "face": "u1333a1"}, {"name": "セブン", "text": "王子、ヴァーニィが血の使い魔を放ってくるぞ！\n前と同じなら、ヴァーニィ本体をぶっ倒せば\nそれ以上は使い魔を出してこないはずだ！", "face": "u1333a1"}]}, {"trigger": "end", "lines": [{"name": "ヴァーニィ", "text": "くっ……やはり私の力では届かないというのか……。\n公爵よ、お前の力を捧げさせてもなお、\n私は母にも、姉にも届かぬ失敗作なのか……！", "face": "l058112bdb6bb"}, {"name": "ヴァーニィ", "text": "ああ、母よ、憎くも愛しき我が母よ……。\nその血の精髄、今ここにもらい受ける……！！", "face": "l058112bdb6bb"}, {"name": "エマ", "text": "やめなさい、ヴァーニィ！\nあなたでは始祖の血を受け止められな――", "face": "u582"}, {"name": "村娘", "text": "ぁっ……ぅ……。", "face": "le7266fbc54dd"}, {"name": "ヴァーニィ", "text": "…………なんだ、これは。\nこの力……ヴァンパイアとは違う……。\nぐっ、あぁあっ、くぅっ、ぐぁぁああぁあッ！？", "face": "l058112bdb6bb"}, {"name": "エマ", "text": "……ヴァーニィ！\nくっ……まだ間に合うはず、\nその血を私に分けなさい！！", "face": "u582"}, {"name": "ヴァーニィ", "text": "いつまで、姉を気取るつもりだァ……！！\nぐぅぅッ、優しい言葉をかけながら、\nいつも……私を見下していたのだろう！？", "face": "l058112bdb6bb"}, {"name": "ジュリア", "text": "いったい、何が起きているの……？", "face": "u1583a1"}, {"name": "ラキュア", "text": "ヴァンパイアの同族喰らいとはわけが違う……。\n始祖とはヴァンパイアにあらず、\n我らの創造主そのものなのだから。", "face": "u344"}, {"name": "シルヴィア", "text": "同族の血ならいざ知らず、\n彼女は、神の血をすするに等しい、\n己の身を滅ぼす劇薬を口にしたのですわよ……。", "face": "u442"}, {"name": "エマ", "text": "妹を見下す姉など、いるものですか……。\nあなたの罪を許すことはできません。\nけれど、あなたを愛さなかったことなど一度も――", "face": "u582"}, {"name": "ヴァーニィ", "text": "姉さんの……そういう態度が嫌いだった！\nあなたは何だってできた、強く美しかった！\nそんなあなたと比べられるのが、何より辛かった！", "face": "l058112bdb6bb"}, {"name": "ヴァーニィ", "text": "他の誰かに蔑まれることよりも！\n姉さんの隣に立てないのが、私は――", "face": "l058112bdb6bb"}, {"name": "エマ", "text": "ヴァーニィ……ッ！！", "face": "u582"}]}], "active": true}