{"quest_id": 7723, "name": "始祖の力", "description": "ついに始祖の宮殿へと辿り着き、一行は\nヴァーニィと対峙する……。\n\n極級（★１獲得の目安：平均Lv25）", "event": "永き後日談の終わり", "event_category": "History", "mission_id": 920182, "map_no": 4155, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 18000, "attack": 1800, "base_hp": 18000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 100, "attack_speed": 50, "attack_wait": 80, "attack_interval": 211, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2139120, "missile_id": 758, "missile": {"speed": 3.0}, "master_id": 35172, "global_id": 8789, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 12, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 1, "level": 120, "form_count": 1, "tags": ["アンデッド"], "hp": 13200, "attack": 1400, "base_hp": 13200, "base_attack": 1400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2128160, "change_to": 3, "change_condition": 1, "master_id": 33629, "global_id": 7246, "variants": [{"tags": ["アンデッド"], "hp": 13200, "attack": 1400, "base_hp": 13200, "base_attack": 1400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 300.0, "gain_cost": 3, "do