_id": 23508, "spawn_sec": 341}, {"enemy_id": 41, "source": "local", "count": 5, "form_count": 2, "hp": 30000, "attack": 1400, "base_hp": 30000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 1600, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 350.0, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118480, "race_id": 18, "change_to": 41, "change_condition": 2, "master_id": 23506, "to_condition": 2, "spawn_sec": 353}, {"enemy_id": 41, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 1400, "base_hp": 30000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 1600, "magic_defense": 30, "attack_range": 260, "attack_speed": 1, "attack_wait": 20, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118496, "race_id": 18, "missile_id": 351, "missile": {"speed": 10.0}, "master_id": 23507, "ranged": true, "from_condition": 2}], "popups": ["フンババは出撃コストが上限を\n上回るか下限を下回ると、\n強化状態に移行します。\n\n上限：150\n下限：50\n\n　　　　　　(1/2)", "フンババは強化状態移行後、\n出撃コストが上限を下回るか\n下限を上回ると、\n再び通常状態に戻ります。\n\n\n\n　　　　　　(2/2)", "キラーマンティスは倒されると、\nその場で復活します。\n\n復活後、キラーマンティスは\n飛行を開始します。"], "dialogue": [{"trigger": "route", "lines": [{"name": "スプラ", "text": "フンババの雰囲気が変わった……！？", "face": "u355"}, {"name": "ソラス", "text": "私たちを絶対に殺すという気になったようですね。"}, {"name": "ソラス", "text": "ここから先は注意してください。\nフンババはこちらの状態に合わせて、\n強化形態に移行しますから。"}, {"name": "リナリア", "text": "こちらの状態に合わせて、って……どういうことですか？", "face": "u592"}, {"name": "モリグナン", "text": "フンババは常に私たちを監視して、\nどれくら余力があるかを測っているの。"}, {"name": "モリグナン", "text": "余力がありすぎれば、\nこちらの優勢を崩すために全力以上の力を発揮する。"}, {"name": "モリグナン", "text": "逆になさすぎれば、一気に勝負を決めるために、\n強化形態で襲いかかってくる、というわけよ。"}, {"name": "ソラス", "text": "フンババが余力を測る指標としているものは、\n部隊を展開するためのリソース……つまりコストです。"}, {"name": "ケイティ", "text": "なるほど、コストを溜めすぎても駄目。\n減らしすぎても駄目なようですね。", "face": "u2433a1"}, {"name": "ココン", "text": "戦う以外にも気を配らなきゃないけないことがあるなんて。\n本当に厄介な神獣なんだね、フンババは。", "face": "u2572a1"}, {"name": "モリグナン", "text": "けれど、その厄介な神獣を追い詰めているのも事実よ。"}, {"name": "ソラス", "text": "本気を出さざるを得なくなっているわけですからね。\nこの勢いのまま、フンババを仕留めてやりましょう。"}]}], "active": true}