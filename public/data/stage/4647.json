{"quest_id": 4647, "name": "復活の魔蝿", "description": "力と体力を奪う、\n魔神ベルゼビュートの\n進攻を止めろ！\n極級（★１獲得の目安：平均Lv25）", "event": "魔蝿の森と呪われた番人", "event_category": "History", "mission_id": 920072, "map_no": 3201, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_speed": 60, "attack_wait": 80, "attack_interval": 321, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2106928, "race_id": 3, "special_effect_id": 93, "master_id": 663, "global_id": 662, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "hp": 1800, "attack": 200, "base_hp": 1800, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 101, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101552, "race_id": 16, "missile_id": 6, "master_id": 315, "global_id": 314, "ranged": true, "spawn_sec": 26}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 180, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106912, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 665, "global_id": 664, "ranged": true, "spawn_sec": 26}, {"enemy_id": 4, "source": "local", "count": 13, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 1300, "attack": 150, "base_hp": 1300, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 130, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106896, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 666, "global_id": 665, "ranged": true, "spawn_sec": 26}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 1000, "base_hp": 8000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 280, "magic_defense": 50, "attack_speed": 100, "attack_wait": 10, "attack_interval": 211, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106960, "special_effect_id": 94, "master_id": 668, "global_id": 667, "spawn_sec": 26}, {"enemy_id": 6, "source": "local", "count": 8, "form_count": 1, "tags": ["植物"], "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 667, "global_id": 666, "ranged": true, "spawn_sec": 59}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 1800, "attack": 300, "base_hp": 1800, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 141, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 314, "global_id": 313, "ranged": true, "spawn_sec": 71}], "popups": ["ベルゼビュートの\n一定範囲内のユニットは攻撃力低下と\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "教団員", "text": "こ……このさなぎが、ベルゼビュート様……？\n伝え聞く姿とは随分と違うように見えるが？", "face": "lfc9619810aa7"}, {"name": "アイーダ", "text": "ど、どういうことなんだ……？\nおい、説明しろ！", "face": "u381"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……早すぎたのだ……。\nまだ完全に復活する程のエネルギーを、\n充分に供給することはできていなかった……。", "face": "l60231936c46a"}, {"name": "ベルゼビュートの配下", "text": "恐らく……危険が迫っているのを察して、\n自らさなぎの状態での復活を\n選ばれたのだろう……。", "face": "l60231936c46a"}, {"name": "ベルゼビュートの配下", "text": "……これは、我らの不甲斐なさが招いた事態。\n何としても完全体として羽化するまで、\n我らが御守りしなくては……ブブッ！！", "face": "l60231936c46a"}, {"name": "アイーダ", "text": "（ベルゼビュート様……ご安心ください。\n私が、一族の誇りにかけて、\n必ず貴方様を守り抜いてみせます……！）", "face": "u381"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、ご覧下さい！\nあそこにアイーダさん達がいます！", "face": "l8de2e2200bf7"}, {"name": "バシラ", "text": "……あ、あのさなぎは……？\nまさか、あれがベルゼビュート！？", "face": "u28"}, {"name": "アンナ", "text": "敵が一斉に攻めてきます！\n王子、何としてでもここでベルゼビュートを\n倒しましょう！", "face": "l8de2e2200bf7"}]}, {"trigger": "end", "lines": [{"name": "アイーダ", "text": "そ、そんな……ベルゼビュート様が……、\n動かない……くっ、うぅぅ……。\n守り切ることが、できなかった……。", "face": "u381"}, {"name": "教団員", "text": "終わりだ……全て終わってしまったのだ……。\n我らの神は死んだ……。", "face": "lfc9619810aa7"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……。\nベルゼビュート様を運ぶのだ……ブブッ！\n（こうなれば……もはや、奴らを糧とするしかない）", "face": "l60231936c46a"}, {"name": "教団員", "text": "運ぶ？　そうか、確かにベルゼビュート様が\n安らかに眠れるよう、埋葬しなければならぬな……。", "face": "lfc9619810aa7"}, {"name": "アイーダ", "text": "そうだな。ベルゼビュート様は強い神だ。\nお亡くなりになっても、\nずっと我々を守ってくださるに違いない。", "face": "u381"}, {"name": "バシラ", "text": "王子！\nアイーダさん達がベルゼビュートを\n抱えて逃げていきます！", "face": "u28"}, {"name": "ケイティ", "text": "ベルゼビュートの命は\nもはや尽きたと思いましたが……。\n何を企んでいるのでしょうか……。", "face": "u114"}, {"name": "アンナ", "text": "心配ですね。\n王子、念のために、彼らの後を追いましょう。", "face": "l8de2e2200bf7"}]}], "active": true}