{"quest_id": 6258, "name": "迫り来る悪夢", "description": "襲い来る吸血鬼の群れから\n命からがら逃げ延びた王子たち。\nバリケードを盾に、吸血鬼達を退けろ！\n上級（★１獲得の目安：平均Lv10）", "event": "カリオペと恐怖の夜", "event_category": "History", "mission_id": 920096, "map_no": 3252, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 21}, {"enemy_id": 2, "source": "local", "count": 23, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 30}, {"enemy_id": 3, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111632, "race_id": 11, "special_effect_id": 233, "master_id": 30613, "global_id": 4232, "spawn_sec": 54}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 350, "base_hp": 6000, "base_attack": 350, "damage_type": "magical", "armor_defense": 120, "magic_defense": 10, "attack_range": 230, "attack_speed": 70, "attack_wait": 60, "attack_interval": 175, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111648, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 30615, "global_id": 4234, "ranged": true, "spawn_sec": 104}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 650, "base_hp": 20000, "base_attack": 650, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 180, "attack_speed": 70, "attack_wait": 50, "attack_interval": 171, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111664, "race_id": 13, "change_to": 5, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 30617, "global_id": 4236, "ranged": true, "variants": [{"tags": ["アンデッド"], "hp": 20000, "attack": 1300, "base_hp": 20000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111680, "race_id": 13, "special_effect_id": 233, "master_id": 30618, "global_id": 4237}], "spawn_sec": 108}], "popups": ["バリケードは破壊されても\n★の評価には影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヘクター", "text": "はぁ、はぁ……な、何とか村人達の避難は完了……。\n他の隊の首尾は、どうなってるんだ？", "face": "u74"}, {"name": "レオ", "text": "各自、担当箇所にそれぞれバリケードを作成し、\nヴァンパイアの侵入経路を塞ぐには塞いだが、\n如何せん急ごしらえだ……心許ないのが本音だよ。", "face": "u72"}, {"name": "兵士A", "text": "何とか食料も掻き集めたから当分は立てこもれるけど\n……ぐすっ……いったい……どうしてこんな事に……。\n悪い夢なら、はやく醒めてよ……。", "face": "u6"}, {"name": "兵士B", "text": "皆、静かに！　向こうから誰かが――むっ！？\nあれは……お、王子！？", "face": "u64"}, {"name": "アンナ", "text": "よかった……皆さん、無事だったのですね！"}, {"name": "兵士C", "text": "おぉぉ！　アンナ殿も、よくぞご無事で！\n……おや？　カリオペ殿の姿が見当たりませんね？\nてっきりご一緒なのだとばかり思っていましたが……。", "face": "u65"}, {"name": "メメント", "text": "はぁ？　なに冗談言ってるのさぁ？　\nカリオペなら、ずっとボクの傍で――って、あれぇ！？\nそんな……本当にどこにもいないよ、王子！！", "face": "u195"}, {"name": "メトゥス", "text": "此処に来るまで何度もヴァンパイアに襲撃されたから、\n皆が恐慌の中にあったのは間違いないけれど……でも、\n仲間がはぐれた事にも気づけなかったなんて……不覚だわ。", "face": "u329"}, {"name": "モーティマ", "text": "おい、今は嘆いてる場合じゃねぇぞ！\n見ろよ、ヴァンパイアのやつら\nバリケード破って、こっちに向かってきてやがる！", "face": "u14"}, {"name": "アンナ", "text": "王子、戦闘の準備をお願いします！\nこれ以上の侵攻は何としても防がねばなりません！", "face": "la78924dc8c4e"}]}, {"trigger": "battle", "at_sec": 106, "lines": [{"name": "カリオペ", "text": "……ウゥ…………王子ィ…………ゥゥゥ……。", "face": "u524"}, {"name": "アンナ", "text": "あ、あれは……カリオペさん！？\n王子、ご覧ください！　あそこにカリオペさんの姿が！\nすぐに助けに行きましょう！", "face": "la78924dc8c4e"}, {"name": "ラキュア", "text": "――待て、アンナ！\n不用意に彼女に近づいてはならぬ。", "face": "u344"}, {"name": "ラキュア", "text": "あの表情に言動……間違いない、\nカリオペの心身は、公爵の手中にあるようだ。", "face": "u344"}, {"name": "メトゥス", "text": "まったく、厄介な敵に捕まってしまったものね。\nダーリン、さっさと雑魚を倒して、\nカリオペを助けにいくわよ！", "face": "u329"}]}, {"trigger": "end", "lines": [{"name": "カリオペ", "text": "ウ、ゥゥ……ドウ、シテ……？\nドウシテ……ワタシ、ヲ……イジメルノ、王子……。", "face": "u524"}, {"name": "メメント", "text": "ね、ねえって！　カリオペ！　ちょっと待ってよぉ！　\nいったい何処に行こうってのさぁ！！", "face": "u195"}, {"name": "メトゥス", "text": "くっ……ヴァンパイアの数が多すぎる……！\nこれ以上カリオペを追うのは危険すぎるわ！", "face": "u329"}, {"name": "アンナ", "text": "そんな……カリオペさんが、\nヴァンパイアと共に退いていってしまいました……。", "face": "l85338b31cbec"}, {"name": "メメント", "text": "ボクらの声に、ぜんぜん反応してくれなかったし、\nもしかして……カリオペは吸血鬼になったんじゃ……？", "face": "u195"}, {"name": "ラキュア", "text": "いや、その可能性ほとんどゼロと言っていいだろう。", "face": "u344"}, {"name": "メトゥス", "text": "やけに自信があるようだけど、根拠はあるのかしら？", "face": "u329"}, {"name": "ラキュア", "text": "吸血鬼にとって、魔物復活を契機とする物質界の人口減少が\n人間そのものの価値を高めている現在、理由無しに\n人間を吸血鬼化させるメリットは皆無と言えよう。", "face": "u344"}, {"name": "ラキュア", "text": "それに、せっかく生け捕りにした人間となれば、\n計算され尽くした暴力の下で長期に渡る血液採取を行い、\n渇きを満たすことこそ、公爵にとっての最適解となる……。", "face": "u344"}, {"name": "ラキュア", "text": "――血液採取の永久機関。\nヤツは嘗て、己が野望をそう明言したが、\nきっと此の一連の進撃もまた、その過程の一部なのだろう。", "face": "u344"}, {"name": "フーリ", "text": "そう考えれば、王子の統治によって大勢の人間が住む\n此の地に目を付けたのも頷ける……魔物を吸血鬼化して\n軍隊として襲わせたのも、全ては計算の上だったのですね。", "face": "u174"}, {"name": "アンナ", "text": "王子、何としても公爵の計画を阻止せねばなりません！\n王国の人々のためにも、何としても此処を\n守り抜きましょう！", "face": "la78924dc8c4e"}]}], "map": {"image": "Map920096_3252", "w": 960, "h": 640, "spots": [{"k": "b", "x": 132, "y": 258}, {"k": "m", "x": 238, "y": 424, "id": 200}, {"k": "m", "x": 177, "y": 359, "id": 201}, {"k": "m", "x": 256, "y": 176, "id": 202}, {"k": "m", "x": 199, "y": 293, "id": 203}, {"k": "m", "x": 648, "y": 268, "id": 204}, {"k": "m", "x": 330, "y": 145, "id": 205}, {"k": "m", "x": 388, "y": 171, "id": 206}, {"k": "m", "x": 449, "y": 203, "id": 207}, {"k": "m", "x": 572, "y": 250, "id": 208}, {"k": "m", "x": 573, "y": 320, "id": 209}, {"k": "m", "x": 509, "y": 342, "id": 210}, {"k": "m", "x": 376, "y": 382, "id": 211}, {"k": "m", "x": 409, "y": 431, "id": 212}, {"k": "m", "x": 483, "y": 433, "id": 213}, {"k": "m", "x": 556, "y": 435, "id": 214}, {"k": "m", "x": 630, "y": 440, "id": 215}, {"k": "m", "x": 827, "y": 293, "id": 216}, {"k": "m", "x": 706, "y": 202, "id": 217}, {"k": "m", "x": 741, "y": 286, "id": 218}, {"k": "m", "x": 705, "y": 447, "id": 219}, {"k": "m", "x": 83, "y": 418, "id": 220}, {"k": "m", "x": 224, "y": 234, "id": 221}, {"k": "m", "x": 442, "y": 363, "id": 222}, {"k": "m", "x": 306, "y": 400, "id": 223}, {"k": "m", "x": 781, "y": 461, "id": 224}, {"k": "m", "x": 780, "y": 151, "id": 225}, {"k": "m", "x": 160, "y": 425, "id": 226}, {"k": "m", "x": 508, "y": 229, "id": 227}, {"k": "r", "x": 109, "y": 348, "id": 300}, {"k": "r", "x": 268, "y": 307, "id": 301}, {"k": "r", "x": 321, "y": 337, "id": 302}, {"k": "r", "x": 619, "y": 195, "id": 303}, {"k": "r", "x": 485, "y": 285, "id": 304}, {"k": "r", "x": 815, "y": 235, "id": 305}, {"k": "r", "x": 771, "y": 350, "id": 306}, {"k": "r", "x": 584, "y": 376, "id": 307}, {"k": "r", "x": 180, "y": 186, "id": 308}]}, "active": true}