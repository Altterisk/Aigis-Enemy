st": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2168528, "special_effect_id": 2344, "missile_id": 11, "master_id": 40010, "global_id": 13627, "ranged": true, "route_behaviour": {"sets_flags": [[100, 1, 0]]}, "spawn_sec": 60}, {"enemy_id": 10, "source": "local", "count": 10, "form_count": 1, "tags": ["アーマー", "帝国", "タルタロスの呪縛"], "hp": 21000, "attack": 1400, "base_hp": 21000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 80, "attack_interval": 217, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2173680, "race_id": 16, "special_effect_id": 2526, "missile_id": 1665, "missile": {"speed": 12.0}, "master_id": 41223, "ranged": true, "spawn_sec": 105}, {"enemy_id": 11, "source": "local", "count": 11, "form_count": 1, "tags": ["影の帝国", "タルタロスの呪縛", "置物"], "fixture": true, "uncounted": true, "hp": 120000, "attack": 1200, "base_hp": 120000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "attack_range": 250, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2173648, "special_effect_id": 2530, "missile_id": 1725, "missile": {"speed": 8.0}, "master_id": 41218, "ranged": true, "spawn_sec": 109}, {"enemy_id": 12, "source": "local", "count": 8, "form_count": 1, "tags": ["タルタロスの呪縛"], "hp": 15000, "attack": 550, "base_hp": 15000, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 75, "attack_interval": 240, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2173696, "race_id": 11, "special_effect_id": 2525, "master_id": 41224, "route_behaviour": {"sets_flags": [[100, 1, 0]]}, "spawn_sec": 117}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 200000, "attack": 3500, "base_hp": 200000, "base_attack": 3500, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_range": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 343, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173504, "race_id": 10, "special_effect_id": 2522, "missile_id": 45, "master_id": 41210, "ranged": true, "spawn_sec": 163}, {"enemy_id": 14, "source": "local", "count": 6, "form_count": 1, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 25000, "attack": 1800, "base_hp": 25000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2173488, "race_id": 16, "missile_id": 1665, "missile": {"speed": 12.0}, "master_id": 23606, "ranged": true, "spawn_sec": 273}], "dialogue": [{"trigger": "start", "lines": [{"name": "影の帝国巨兵", "text": "――女皇陛下！　一族の者は揃いました。\n皆、正々堂々と白の帝国とやりあえると気合充分です！\nして、我らはどの前線に？", "face": "l322ed888eb2d"}, {"name": "影のディアナ", "text": "元女皇、です。\n配置はレオナから。", "face": "u2914a1"}, {"name": "影のレオナ", "text": "まずは事前の作戦会議どおりだ。\n敵を追って、味方から離れすぎるなよ。\n勇猛果敢なのは美徳だが、死に急ぐ者は厳罰だ。", "face": "u2915a1"}, {"name": "影の帝国巨兵", "text": "委細承知！\n……しかし、その前にひとつだけ。", "face": "l322ed888eb2d"}, {"name": "影の帝国巨兵", "text": "我らが敗れたとしても、本当に\n故郷を明け渡せと言われることは、ないのでしょうか。", "face": "l322ed888eb2d"}, {"name": "影のディアナ", "text": "ええ。これは、双方が合意した演習です。\nあなた方の土地も、家族の暮らしも、\n勝負に賭けてはいませんよ。", "face": "u2914a1"}, {"name": "影の帝国巨兵", "text": "それならば、存分に戦えますな。\n一族の戦士たちにも、そう伝えます。", "face": "l322ed888eb2d"}, {"name": "影のレオナ", "text": "戦えぬ者たちが、\nようやく声をあげられる、か……。\n影の帝国を立ち上げたこと、報われたな。", "face": "u2915a1"}, {"name": "影のディアナ", "text": "えぇ、本当に。", "face": "u2914a1"}, {"name": "影の帝国巨兵", "text": "――むっ。\nいや、誤解しないでいただきたい。", "face": "l322ed888eb2d"}, {"name": "影の帝国巨兵", "text": "これは我ら、巨人族だけの戦いではありませぬ。\n「影の帝国」の民が、白の帝国に対し、\nここに国家を揺るがしうる戦士がいると見せる為のもの。", "face": "l322ed888eb2d"}, {"name": "影の帝国巨兵", "text": "たとえ女皇の位を退こうとも、人質扱いであろうとも、\n我らが女皇陛下と参謀殿に不遇な扱いをすれば、\n即断即決で帝都を攻め滅ぼすぞという意思表示なれば。", "face": "l322ed888eb2d"}, {"name": "影のレオナ", "text": "貴様らは、本当に……。", "face": "u2915a1"}, {"name": "影のディアナ", "text": "頭の硬さは、きっとあなたに似たのですね。", "face": "u2914a1"}, {"name": "影のレオナ", "text": "その言葉、そっくりお返しする。", "face": "u2915a1"}]}, {"trigger": "start", "lines": [{"name": "レオナ", "text": "――そちらの準備は整ったか？", "face": "u2600a1"}, {"name": "影のレオナ", "text": "ああ。待たせたな、オリジナル。\nこちらは皆、やる気に満ちているぞ。", "face": "u2915a1"}, {"name": "アンジェリーネ", "text": "えぇ、そのようですわね。\nそれから、演習には王国軍も参戦します。\n――意味は、おわかりですね？", "face": "u430"}, {"name": "影のディアナ", "text": "……影の帝国の実力を、\n第三国にも知らしめておけ、と。\n感謝いたします、アンジェリーネ様。", "face": "u2914a1"}, {"name": "アンジェリーネ", "text": "では、双方悔いのないように。\n配置につきなさい！", "face": "u430"}, {"name": "影のディアナ", "text": "全軍、前へ！\nその力を、白の帝国軍に叩きつけてやるのです！", "face": "u2914a1"}, {"name": "ディアナ", "text": "総員、抜剣！\n白の帝国の誇りと意志、いまこそ見せるとき！", "face": "u624"}]}], "active": true}