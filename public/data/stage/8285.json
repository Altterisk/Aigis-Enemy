rm_resist": 2000, "pattern_id": 2153984, "race_id": 9, "special_effect_id": 789, "change_to": 7, "change_condition": 1, "missile_id": 11, "master_id": 37573, "global_id": 11190, "ranged": true, "variants": [{"hp": 1000, "attack": 200, "base_hp": 1000, "base_attack": 200, "damage_type": "physical", "attack_speed": 40, "attack_interval": 65, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2153888, "race_id": 9, "special_effect_id": 1090, "master_id": 37574, "global_id": 11191}], "route_behaviour": {"sets_flags": [[3, 1, 0], [1, 1, 0], [2, 1, 0]]}, "spawn_sec": 69}, {"enemy_id": 9, "source": "local", "count": 11, "form_count": 3, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123904, "race_id": 2, "change_to": 9, "missile_id": 476, "master_id": 34108, "global_id": 7725, "ranged": true, "to_global_id": 6318, "route_behaviour": {"sets_flags": [[3, 1, 0], [1, 1, 0], [2, 1, 0]]}, "spawn_sec": 82}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123904, "race_id": 2, "special_effect_id": 232, "change_to": 10, "change_condition": 4, "missile_id": 476, "master_id": 32700, "global_id": 6318, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6319}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 87, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123920, "race_id": 2, "master_id": 32701, "global_id": 6319, "from_condition": 4, "trigger_ticks": 1}], "popups": ["岩を掴んでいる\nプテラノドラゴンは\n一度だけ攻撃を行います。", "ドラコラプトルは味方ユニットを\n発見すると、咆哮を行います。\n咆哮後、移動速度が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リゾート従業員", "text": "──敵襲！　敵襲！　魔獣が施設内に侵入したぞ！", "face": "l306d4cb91f3c"}, {"name": "メーア", "text": "知ってました。", "face": "u1038a1"}, {"name": "デーモンシェフ", "text": "馬鹿な！？　施設の警備体制は完璧なはず……！", "face": "l993fb1fcf3bc"}, {"name": "デーモンシェフ", "text": "グルメジャングルの魔獣たちを刺激せぬように、\nこれまでどれほど細心の注意を払ってきたと……！", "face": "l993fb1fcf3bc"}, {"name": "トゥアン", "text": "またお前んとこの眼鏡が何かしたんじゃないのか？", "face": "u2189a1"}, {"name": "副デーモンシェフ", "text": "インテリデーモンなら別件の対応中です、\nこのリゾートには一度も来ておりません。", "face": "lba3493f7bf22"}, {"name": "観光客のゴブリン", "text": "ギャギャ！　イタイ！　イタイ！　アッチイケ！", "face": "l747c5179b17d"}, {"name": "コーネリア", "text": "陽気なゴブリンたちが襲われているぞ！\n見たことのないタイプのドラゴンだ！", "face": "u2179a1"}, {"name": "レギーナ", "text": "あれは……プテラノドラゴン！", "face": "u1045a1"}, {"name": "トゥアン", "text": "知ってんのか！？", "face": "u2189a1"}, {"name": "レギーナ", "text": "手羽先の唐揚げが美味しい翼竜だ！\n甘辛いタレに絡めると実に美味だぞ！", "face": "u1045a1"}, {"name": "ティルト", "text": "味は聞いてないぞ。", "face": "u2187a1"}, {"name": "レギーナ", "text": "上空から岩をぶつけることで獲物を弱らせ、\n巣に運んで食べてしまう凶悪なドラゴンだな。", "face": "u1045a1"}, {"name": "トゥアン", "text": "先にそれを言え！　アイツら連れ去られるぞ！", "face": "u2189a1"}, {"name": "エマ", "text": "ひとまず宿泊客の避難誘導から始めましょう。\nこうなっては休暇などと言ってもいられません。", "face": "u2180a1"}, {"name": "アスバール", "text": "大丈夫ですか？　日射しが強いようですけど……。", "face": "u2184a1"}, {"name": "エマ", "text": "ふふ、お気遣いありがとうございます。\nですが、この程度の陽光であれば問題ありません。", "face": "u2180a1"}, {"name": "アスバール", "text": "分かりました、私も前に出ますので、\n辛くなったらすぐに言ってくださいね？", "face": "u2184a1"}, {"name": "アスバール", "text": "頑張ってこの島の天気を嵐にしちゃいますので！", "face": "u2184a1"}, {"name": "副デーモンシェフ", "text": "後生ですから嵐雨はおやめください。", "face": "lba3493f7bf22"}]}, {"trigger": "end", "lines": [{"name": "観光客のゴブリン", "text": "アリガトウ！　アリガトウ！", "face": "l747c5179b17d"}, {"name": "トゥアン", "text": "礼はいいから早く建物に入れ！\n連れて行かれても知らねぇからな！", "face": "u2189a1"}, {"name": "ラーワル", "text": "転んで怪我しないように気を付けて！", "face": "u2181a1"}, {"name": "観光客のゴブリン", "text": "ギャギャ！　オサナイ！　カケナイ！　シャベラナイ！", "face": "l747c5179b17d"}, {"name": "デーモンシェフ", "text": "ぐぬぬ……どうして今になって魔獣が暴走を……。", "face": "l993fb1fcf3bc"}, {"name": "副デーモンシェフ", "text": "シェフ！　施設内に逃げ遅れた宿泊客が！", "face": "lba3493f7bf22"}, {"name": "デーモンシェフ", "text": "急いで警備員を向かわせろ！\n怪我人が出る前に避難を完了させるのだ！", "face": "l993fb1fcf3bc"}, {"name": "ラーワル", "text": "待って、ただでさえ魔獣の侵攻が激しいってのに、\nここで二手に分かれちゃあ各個撃破されるだけだよ。", "face": "u2181a1"}, {"name": "デーモンシェフ", "text": "だが、我々には宿泊客を守る義務がある！\n誰かを見捨てることなどあってはならない！", "face": "l993fb1fcf3bc"}, {"name": "ソラス", "text": "では、逃げ遅れた方々は私たちの方で請け負いましょう。", "face": "u2185a1"}, {"name": "デーモンシェフ", "text": "いいや、この場では力を借りてしまったが、\n諸君もまた我々が守るべき宿泊客に変わりない。\nこれ以上、お客様を危険な目に晒すわけには──", "face": "l993fb1fcf3bc"}, {"name": "トゥアン", "text": "心意気は立派だが、実力が伴わねぇとな。\n無理なら無理と言うのも勇気の一つだぜ。", "face": "u2189a1"}, {"name": "ラーワル", "text": "そんな意地悪な言い方しなくていいじゃん。\n正義の味方は困ってる人を見捨てないものさ！", "face": "u2181a1"}, {"name": "リムリィ", "text": "どうか我々にお任せを、それが今できる最善です。", "face": "u2188a1"}, {"name": "デーモンシェフ", "text": "すまん……どうか無茶だけはしてくれるな。\n危なければいつでもホテルに退避するように。", "face": "l993fb1fcf3bc"}, {"name": "トゥアン", "text": "そう気にすんな、こんなんいつものことだろ？\n美味い飯の前のちょっとしたアトラクションだ。", "face": "u2189a1"}, {"name": "トゥアン", "text": "勝って、食って、気持ちよく寝るぞ！", "face": "u2189a1"}, {"name": "ラーワル", "text": "おー！", "face": "u2181a1"}]}], "active": true}