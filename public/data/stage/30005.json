000, "attack": 11250, "base_hp": 22000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 60, "attack_interval": 150, "move_speed": 9000.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2165632, "change_to": 48, "change_condition": 4, "master_id": 23404, "to_condition": 4, "to_ticks": 1}, {"enemy_id": 47, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["ステルス"], "hp": 55000, "attack": 2000, "base_hp": 22000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 60, "attack_interval": 174, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2165616, "master_id": 23405, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 50, "source": "local", "count": 1, "form_count": 1, "hp": 45000, "attack": 5750, "base_hp": 18000, "base_attack": 2300, "damage_type": "physical", "armor_defense": 500, "magic_defense": 25, "attack_speed": 1, "attack_wait": 15, "attack_interval": 70, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160496, "special_effect_id": 64, "master_id": 23423, "spawn_sec": 850}, {"enemy_id": 51, "source": "local", "count": 1, "form_count": 1, "hp": 37500, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 200, "magic_defense": 90, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 185, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2160512, "special_effect_id": 64, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 23424, "ranged": true, "spawn_sec": 861}], "popups": ["トウノシュゴシャを撃破すると\n別形態に変身します。\n\n英傑の塔状態では\n物理攻撃によるダメージを受けると\n攻撃したユニットへ反撃を行います。\n\n　　　　　　(1/3)", "統帥の塔状態では\n魔法攻撃によるダメージを受けると\n攻撃したユニットへ反撃を行います。\n\n悪霊の塔状態では\n味方ユニットから受ける\n全てのダメージを50％軽減します。\n　　　　　　(2/3)", "トウノシュゴシャは\n撃破数に含まれません。\n\nまた、撃破するとその時点で\nミッションクリアになります。\n※討伐数は最大数で\n　カウントされます。\n　　　　　　(3/3)"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンブローズ", "text": "なにか、特別強そうな守護者がいませんか……？"}, {"name": "ファリエ", "text": "えーっと、あれは私も見たことがないんですが、\nニミュエ様たちは知ってます？", "face": "u2533a1"}, {"name": "ニミュエ", "text": "い、いえ、私も見たことがないですよ……？", "face": "u1175a1"}, {"name": "ソラス", "text": "同じくですね。\nおそらくは塔が混ざり合った際に生まれた、\n新しい守護者なのでしょう。"}, {"name": "ニミュエ", "text": "製作者の知らない敵が出てくるのは、\n怖いような、面白いような……。", "face": "u1175a1"}, {"name": "ユージェン", "text": "襲いかかってくるみたいだから対応するが、\nその新しい守護者とやらは倒しても構わないよな？"}, {"name": "ニミュエ", "text": "あっ、はい。\nむしろ積極的に倒すべきだと思います。", "face": "u1175a1"}, {"name": "パルセ", "text": "というと？", "face": "u2276a1"}, {"name": "ニミュエ", "text": "この塔は三つの塔が合体している都合上、\n非常に歪で脆い作りになっています。", "face": "u1175a1"}, {"name": "ニミュエ", "text": "そんな脆弱な塔を崩れないように維持しているのが、\nあの守護者だと思われるからです。", "face": "u1175a1"}, {"name": "アンブローズ", "text": "つまりあの守護者さえ倒せば、塔は自然と元通りになって、\nこの事件は全部まるっと解決するってわけですねぇ。"}, {"name": "シャディア", "text": "となると、あれを優先して狙うほうが良さそうだな。", "face": "u713"}, {"name": "シャディア", "text": "それを踏まえて、指揮を頼むぞ、王子！", "face": "u713"}]}, {"trigger": "end", "lines": [{"name": "ファリエ", "text": "……守護者が活動を停止しました。", "face": "u2533a1"}, {"name": "ソラス", "text": "融合した際の機構の欠陥で生まれたようなものですから、\n長期間稼働することはできなかったみたいですね。"}, {"name": "ユージェン", "text": "これで塔は元に戻るのですか？"}, {"name": "アンブローズ", "text": "塔たちのそれぞれの部品が、\n元ある場所に戻っていく感じがしますし、\nもう大丈夫だと思いますよぉ。"}, {"name": "ニミュエ", "text": "それに、塔が合体した原因も分かりましたから。", "face": "u1175a1"}, {"name": "ファリエ", "text": "本当ですか！？", "face": "u2533a1"}, {"name": "ニミュエ", "text": "はい、どうやら今回の事件の犯人は、\nこの子だったみたいです。", "face": "u1175a1"}, {"name": "キューティレイス", "text": "（ズモモモモモ……！！）", "face": "l6f39ba2bc7f1"}, {"name": "パルセ", "text": "それは……あなたが連れている幽霊、ですか？", "face": "u2276a1"}, {"name": "ニミュエ", "text": "この子が急に茶目っ気を発揮したみたいで、\n塔を全部融合させるっていう悪戯をしたようです。", "face": "u1175a1"}, {"name": "ニミュエ", "text": "一応反省してるみたいですし、\n私の方からも叱っておくので、\n許してもらえないでしょうか……？", "face": "u1175a1"}, {"name": "キューティレイス", "text": "（ズモズモ……）", "face": "l6f39ba2bc7f1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンブローズ", "text": "どうやら、全部解決したみたいですね。"}, {"name": "ファリエ", "text": "やったぁ！\nこれでまた王子さまたちに挑んでもらえますね！", "face": "u2533a1"}, {"name": "ソラス", "text": "一応点検はしないといけませんが、\nすぐに各塔を利用できる状態にはしておくので、\nどうか安心してくださいね。"}, {"name": "アンナ", "text": "ありがとうございます。\n英傑の塔たちは、軍の強化に欠かせないものですからね。"}, {"name": "アンナ", "text": "それでは、私たちも帰るとしましょうか。", "face": "l60362c483024"}, {"name": "アンナ", "text": "王子、此度の討伐お疲れ様でした！", "face": "lab0e64136ede"}]}], "active": true}