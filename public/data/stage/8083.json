{"quest_id": 8083, "name": "運命邂逅", "description": "遥かな過去、時の女神の試練が始まる。\n＜天界（弱）：攻撃力がダウン＞\n＜広域戦闘：敵味方の射程減少＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["天界（弱）：攻撃力がダウン", "広域戦闘：敵味方の射程減少"], "event": "神の時代、人の時代", "event_category": "History", "mission_id": 920205, "map_no": 4800, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 45, "params": [100, -70]}, {"kind": "term", "influence": 41, "params": [0, 60, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 10, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 400, "base_hp": 12000, "base_attack": 400, "damage_type": "magical", "armor_defense": 60, "magic_defense": 30, "attack_range": 260, "attack_wait": 30, "attack_interval": 97, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2148080, "special_effect_id": 1552, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 36631, "global_id": 10248, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "アンデッド"], "hp": 42000, "attack": 1800, "base_hp": 42000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 137, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2117520, "race_id": 15, "special_effect_id": 86, "master_id": 31564, "global_id": 5183, "spawn_sec": 45}, {"enemy_id": 3, "source": "local", "co