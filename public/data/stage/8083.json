sform_resist": 1000, "pattern_id": 2124192, "race_id": 20, "change_to": 8, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32923, "global_id": 6540, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6543, "spawn_sec": 96}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124208, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32926, "global_id": 6543, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "アンデッド"], "hp": 40000, "attack": 660, "base_hp": 40000, "base_attack": 660, "damage_type": "true", "armor_defense": 800, "magic_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2117536, "race_id": 15, "special_effect_id": 86, "change_to": 12, "master_id": 31565, "global_id": 5184, "spawn_sec": 148}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 18000, "attack": 300, "base_hp": 18000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 25, "attack_range": 180, "attack_speed": 20, "attack_wait": 60, "attack_interval": 195, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2117568, "race_id": 15, "special_effect_id": 353, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 31580, "global_id": 5199, "ranged": true, "spawn_sec": 149}], "popups": ["クロノシアは一定確率で\n物理攻撃を回避します。\n\nまたクロノシアは自身が受けた\n停止の効果を無効化します。", "癒し手の姿をした\nエインヘリヤル(分身体)がいる間は、\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――ここは……？"}, {"name": "エフトラ", "text": "観測不能です。\nしかし、先程までの法則改変による異常ではありません。\nこれは計器に、記録のない時代だから……？", "face": "u1468a1"}, {"name": "アンブローズ", "text": "エフトラちゃんが、生まれる前ということ、ですかぁ！？\n古代文明より前の時代に来ちゃったと……？", "face": "u1088a1"}, {"name": "ニミュエ", "text": "…………むにーっ。", "face": "u1175a1"}, {"name": "アンブローズ", "text": "いたたたたたた！？\nなにするんでひゅかー！？", "face": "u1088a1"}, {"name": "ニミュエ", "text": "どうやら夢ではなく、現実のようです。", "face": "u1175a1"}, {"name": "クロノシア", "text": "――ふふっ。\n仲が良いのですね。", "face": "u1986a1"}, {"name": "イコル", "text": "クロノシア！\n良かった、無事で――いや、違う、のか？", "face": "u1988a1"}, {"name": "クロノシア", "text": "えぇ、私は死にました。\nその身を神の楔に変え、あなたたちをここに送るために。", "face": "u1986a1"}, {"name": "クロノシア", "text": "ここにいるのは、遥かな未来の私が「そうする」と、\n未来視によって知った、過去の私です。", "face": "u1986a1"}, {"name": "トゥアン", "text": "……過去に戻ったのはいいが、\nいったいどうするつもりなんだ？", "face": "u1006a1"}, {"name": "ランシェ", "text": "この時代から鍛えまくって、\n数千、いや、数万年後？\nのディアスを倒せるくらいになるとか……。", "face": "u1957a1"}, {"name": "ヴィディア", "text": "……先に王子の寿命が尽きるぞ、ランシェ。", "face": "u1894a1"}, {"name": "イコル", "text": "王子を延命させる方法は、いくつかあるが。", "face": "u1988a1"}, {"name": "エマ", "text": "…………。", "face": "u582"}, {"name": "メルアビス", "text": "…………。", "face": "u675"}, {"name": "アラン", "text": "…………。", "face": "u1511a1"}, {"name": "クロノシア", "text": "いいえ、もうひとつの手段があります。", "face": "u1986a1"}, {"name": "クロノシア", "text": "アンナ、さん？\nあなたの力で、未来の私を守ってほしいのです。", "face": "u1986a1"}, {"name": "アンナ", "text": "……わ、私ですか！？", "face": "ld3df6a18ddda"}, {"name": "クロノシア", "text": "あなたの運命は、ひどく複雑なのです。\n例えば、神獣ニーズヘッグとの深い縁や――", "face": "u1986a1"}, {"name": "アンナ", "text": "ま、ま、待ってください！\n確かに、私ではなく、ダークアンナさんは\n神獣ニーズヘッグを使役していましたが……。", "face": "ld3df6a18ddda"}, {"name": "クロノシア", "text": "元は、同一の存在でしょう？", "face": "u1986a1"}, {"name": "アンナ", "text": "……それは、たしかに。"}, {"name": "クロノシア", "text": "おそらくは、時間を何度も飛び越えて、\n神獣との縁を綴織のように、\n世界に編み込んでしまったのでしょうね。", "face": "u1986a1"}, {"name": "クロノシア", "text": "魔物を引き寄せやすい体質も、\nきっとそれが原因のひとつでしょう。", "face": "u1986a1"}, {"name": "クロノシア", "text": "今回は、その体質――いえ、運命を利用させてください。\nあなたに、神獣の加護を授けます。", "face": "u1986a1"}, {"name": "アンナ", "text": "私が……神獣を……？"}, {"name": "クロノシア", "text": "――えぇ、ですから、死なないでくださいね。", "face": "u1986a1"}, {"name": "アンナ", "text": "……えっ？"}, {"name": "ソラス", "text": "お、王子くん！　戦闘準備を！\nクロノシアは――試練を授けるつもりです！！", "face": "u904"}]}, {"trigger": "end", "lines": [{"name": "クロノシア", "text": "――さすがは王子と共に、\nいくつもの戦場を乗り越えてきた者です。\nあなたの身体に、確かに神獣との縁が刻まれました。", "face": "u1986a1"}, {"name": "アンナ", "text": "私に、神獣の力が……。", "face": "ld3df6a18ddda"}, {"name": "クロノシア", "text": "その神獣の名は、エインヘリヤル。\n遥かな未来で歪み、壊れてしまう前の、\n純粋なままの戦士たちの魂の形。", "face": "u1986a1"}, {"name": "クロノシア", "text": "エインヘリヤルとは、過去の魂ではありません。\n現在、過去、未来、すべての時代に生きた、\n気高き戦士たちの魂の受け皿です。", "face": "u1986a1"}, {"name": "クロノシア", "text": "あらゆる戦場で、生きることを願い、\n守ることを誓った戦士たちの魂が、\n必ず、あなたの力になってくれます。", "face": "u1986a1"}, {"name": "クロノシア", "text": "それでは、あなた方を未来に――", "face": "u1986a1"}, {"name": "イコル", "text": "――クロノシア！\nその……ぼくは……。", "face": "u1988a1"}, {"name": "クロノシア", "text": "あなたを叱るのは、今の私の役割ではありませんよ。\n己に課した使命をなしとげ、\nその後に――未来の私に叱ってもらいなさい。", "face": "u1986a1"}, {"name": "イコル", "text": "……ああ、分かった。", "face": "u1988a1"}, {"name": "クロノシア", "text": "では、未来の私をよろしくお願いします。\n未来の――王たる――", "face": "u1986a1"}]}], "active": true}