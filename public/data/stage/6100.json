{"quest_id": 6100, "name": "滑走する機甲兵", "description": "運び屋を追い氷窟へと赴いた王子たちに、\n眠っていたはずの機甲兵が襲いかかる。\n暴走する機甲兵を鎮圧せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "奪われたグリモワール", "event_category": "History", "mission_id": 920089, "map_no": 3967, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 23, "form_count": 1, "tags": ["機械"], "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 120, "attack_wait": 45, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100752, "master_id": 283, "global_id": 282, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 5}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 69}, {"enemy_id": 4, "source": "local", "count": 13, "form_count": 1, "tags": ["スライム"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100576, "master_id": 269, "global_id": 268, "spawn_sec": 78}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 2, "tags": ["機械"], "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 250, "attack_speed": 70, "attack_wait": 45, "attack_interval": 121, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100768, "change_to": 5, "missile_id": 26, "master_id": 30253, "global_id": 3872, "ranged": true, "to_global_id": 3873, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 115}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 250, "attack_speed": 70, "attack_wait": 45, "attack_interval": 121, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100768, "special_effect_id": 229, "change_to": 4, "missile_id": 26, "master_id": 30254, "global_id": 3873, "ranged": true}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "tags": ["機械"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 15, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101056, "race_id": 16, "master_id": 312, "global_id": 311, "spawn_sec": 133}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――書片の運び屋が逃げたのはこちらの方角でしたね。\n王子、氷の上は滑るので\n気を付けて進まれてください。", "face": "lef34b07dc8a4"}, {"name": "ケイティ", "text": "この近辺では未起動の機甲兵も、\n見つかっています。\n恐らく、まだ多くの機甲兵が眠っている事でしょう。", "face": "u114"}, {"name": "リッカ", "text": "王子、不用意に機甲兵を起動させてしまうと、\n暴走する危険性があります。\n慎重に進んでくださいね！", "face": "u152"}, {"name": "リッカ", "text": "……あれ、前から何かが。", "face": "u152"}, {"name": "デシウス", "text": "――う、うおおおおおぉぉっ！？\n滑る、地面が滑るぞっ！　だが、これなら\nあの機甲兵から逃げきれそうだっ！", "face": "l088e89f48263"}, {"name": "ケイティ", "text": "あれは、デシウス！", "face": "u114"}, {"name": "デシウス", "text": "おぉ、いいところで会ったな王子！！\n我輩は探し物で忙しい、奴らの相手は\n頼んだぞ、さらばだっ！！", "face": "l088e89f48263"}, {"name": "ケイティ", "text": "……凄い勢いで滑り去っていきましたね。\n一体何が…………。\n――！　皆さん、前方に敵影が！", "face": "u114"}, {"name": "アンナ", "text": "あれは……機甲兵！", "face": "lef34b07dc8a4"}, {"name": "リッカ", "text": "今の方が起動させてしまったのでしょうか……\n完全に暴走しています。可哀そうですが\nここは戦って動きを止めるしかなさそうです。", "face": "u152"}, {"name": "ケイティ", "text": "王子、戦闘のご準備をお願いします。\n運び屋も現れるかもしれません、\n見つけ次第書片を取り戻しましょう。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "リッカ", "text": "……ごめんね、皆。\n後で直してあげるから。", "face": "u152"}, {"name": "ケイティ", "text": "ひとまずは機甲兵を\n鎮圧できたようですね。", "face": "u114"}, {"name": "アンナ", "text": "一安心ですね。"}, {"name": "ケイティ", "text": "はい。ですが、まだ辺りには運び屋が\n潜んでいるかもしれませんし、\n兵達には引き続き捜索を指示しておきます。", "face": "u114"}]}], "active": true}