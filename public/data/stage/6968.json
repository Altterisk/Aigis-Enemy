5921, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 136}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "tags": ["バレンタイン"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121328, "race_id": 3, "change_to": 9, "master_id": 32294, "global_id": 5913, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 151}], "popups": ["デモンポーンは倒されると、\nその場で復活します。\n2回まで復活し、\n復活するたびに強くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デモンポーン", "text": "――お菓子工場のお仕事なら、\nあまーいお菓子が食べ放題だと思ったんだけどなぁ。", "face": "u997"}, {"name": "デモンポーン", "text": "コンベアで流れてくお菓子は美味しそうなのに、\n仕事中は食べちゃダメなんて酷いよぉ……。", "face": "u997"}, {"name": "デモンポーン", "text": "でもくじけちゃだめだめっ！\nまだお家には帰ってあげないんだから！\nそのためにもお金をちゃんと稼いで――", "face": "u997"}, {"name": "デーモンシェフ", "text": "――特別ボーナスが欲しいかね？", "face": "l1cb44203deef"}, {"name": "デモンポーン", "text": "と、特別ボーナス！？\nってなぁんだ、工場長ちゃんじゃん。", "face": "u997"}, {"name": "デーモンシェフ", "text": "おしゃれで素敵なデーモンシェフと呼べ！！\nともかく、工場に侵入した王子達を排除すれば、\nたんまりと特別ボーナスを出してやるぞ……！", "face": "l1cb44203deef"}, {"name": "デモンポーン", "text": "えっ……王子達を、排除……？\nボーナスは欲しいけど、そんなのだめー！", "face": "u997"}, {"name": "デーモンシェフ", "text": "くっくっく、これは業務命令だ！\n上司の命令に逆らうつもりか新入社員よ……！", "face": "l1cb44203deef"}, {"name": "デーモンシェフ", "text": "もしどうしても嫌だと言うのなら、\nチョコまみれにして無理やり戦わせ――", "face": "l1cb44203deef"}, {"name": "デモンポーン", "text": "ひっ……そ、それはそれで嫌～！？\nうぅぅぅ……よわよわだけど、\nあの王子達なら大丈夫、だよね……？", "face": "u997"}]}, {"trigger": "start", "lines": [{"name": "シャルキー", "text": "――むぅぅ、デーモンシェフは\nいったいどこに隠れているのでしょうか……？", "face": "u965"}, {"name": "アリス", "text": "シャルキーちゃん、気をつけてください！\nいつの間にか周囲にチョコトレントが！", "face": "u589"}, {"name": "シャルキー", "text": "わっ、わわー！？\n危うくど真ん中に突撃するところでした……。", "face": "u965"}, {"name": "アンナ", "text": "デーモンシェフの捜索を続けるためにも、\nまずはチョコトレントを排除しましょうか。\n王子、指揮をお願いします！", "face": "lff330ed655d9"}]}, {"trigger": "end", "lines": [{"name": "デモンポーン", "text": "――あっ、見つかっちゃった！", "face": "u997"}, {"name": "ハルモニア", "text": "こらっ！　そこで何をしているんですか！", "face": "u941"}, {"name": "デモンポーン", "text": "お、お姉ちゃんには関係ないもん！\nもう子供扱いなんてさせないんだから！", "face": "u997"}, {"name": "シャルキー", "text": "あっ……工場の奥へ逃げていってしまいました……。\nどうしてデーモンシェフの\n味方をしているのでしょう……？", "face": "u965"}, {"name": "ハルモニア", "text": "子供扱い……なるほど……。\nあの子の家出の原因は、\n私にあるのかもしれませんね……。", "face": "u941"}, {"name": "ドルカ", "text": "……子供というのは、難しいものね。\nけれど悪事の片棒を担がされているのなら、\nそこから救い出すのは保護者の役割よ？", "face": "u44"}, {"name": "ハルモニア", "text": "そう、ですね。\nあの子が一人で頑張ろうとしているのなら、\n私はそれを助け、応援してあげなければ。", "face": "u941"}, {"name": "シャルキー", "text": "（大人って、難しそうですねぇ……）", "face": "u965"}, {"name": "リノ", "text": "（ふふん、そんなのは、\n大人になってから考えればいいんだよ♪　でも――）", "face": "u590"}, {"name": "シャルキー", "text": "（はいっ、あの子の気持ち、分かる気がします。\n年下だからって助けられるばかりだったり、\nそういうの、私も早く卒業したいですから！）", "face": "u965"}, {"name": "アンナ", "text": "王子、工場の奥には\nチョコの魔物がさらに多くいるはずです。\nこの先も慎重に進軍していきましょう。", "face": "lff330ed655d9"}]}], "story_talk": true, "active": true}