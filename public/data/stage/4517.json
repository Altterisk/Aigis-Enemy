{"quest_id": 4517, "name": "崖下より迫る影", "description": "奈落の底より這い出る\n無数の影とは……。\n硬き外殻を持つアリを撃破せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "莫邪の宝剣", "event_category": "History", "mission_id": 920062, "map_no": 3669, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 16, "level": 95, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 2, "master_id": 626, "global_id": 625, "to_global_id": 484, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 11}, {"enemy_id": 2, "source": "local", "count": 1, "level": 95, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 1, "master_id": 485, "global_id": 484}, {"enemy_id": 3, "source": "local", "count": 7, "level": 95, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 1, "master_id": 485, "global_id": 484, "to_global_id": 625, "spawn_sec": 15}, {"enemy_id": 3, "source": "local", "count": 1, "level": 95, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 2, "master_id": 626, "global_id": 625}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 33}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 56}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "base_hp": 4000, "damage_type": "physical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 10, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105296, "race_id": 16, "special_effect_id": 70, "master_id": 631, "global_id": 630, "spawn_sec": 68}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 7, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 93}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "依然として、険しい山道が続いていますね。\n一歩踏み外せば谷底へと落ちるのは必至……。\n皆さん、注意して進みましょう。", "face": "l077ae4c90c18"}, {"name": "アサル", "text": "ですが危険な山道であるが故に、敵の襲撃は\n前方のみに絞られますので、迎撃は容易です。", "face": "u172"}, {"name": "ハシム", "text": "そりゃそうだ。俺の経験則からいくと、\nこんな絶壁をよじ登ってくる魔物は存在しない。\nま、楽な進軍で何よりだな。がっはっは！", "face": "u170"}, {"name": "ケイティ", "text": "油断は禁物です。\nここは私達にとっては不慣れな地……、\nまだ見ぬ魔物がいるかもしれませんよ。", "face": "u114"}, {"name": "兵士", "text": "前方に敵の姿を確認！\nどうやらまた、妖虎のようです！", "face": "l199377a44b3f"}, {"name": "アンナ", "text": "皆さん、お喋りはそこまでです。\n即時、臨戦態勢をとってください！\n王子も、戦いのご準備を！", "face": "l077ae4c90c18"}]}, {"trigger": "battle", "at_sec": 12, "lines": [{"name": "砂漠兵士", "text": "うわぁッ！\nなんだあの大きなアリは……！", "face": "u169"}, {"name": "ハシム", "text": "そ、そんな馬鹿な……！　う、うろたえるな！\nたかがアリだ！　崖に引っ付いてる間に\n遠矢による攻撃を！　頼むアルス！　", "face": "u170"}, {"name": "アルス", "text": "もうやってるって！\nでも外殻が硬すぎて、矢が刺さらねえ！", "face": "u73"}, {"name": "ハシム", "text": "……ぐ。こうなったら、力尽くよ。\n砂漠の戦士は臆さない！\n最後に頼れるのは鍛え上げた己の肉体のみ！", "face": "u170"}, {"name": "バルバストラフ", "text": "ほっほ。待たれよ砂漠の猛者よ。\nアリの硬い外殻を打ち破るには魔法が有効じゃて。", "face": "u63"}, {"name": "バルバストラフ", "text": "経験豊富とは言わぬが、\nこの老いぼれの魔法もなかなかのもんじゃぞ。\nさぁ、ハシムどの参りましょうぞ。", "face": "u63"}, {"name": "ハナ", "text": "アタシも手伝いますよ！　この踊りで魔物\nだって見惚れさせてみせま――わわッ！　目が\n回って……だ、誰か～！？　止めて下さいぃッ！　", "face": "u212"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "敵、すべて討ち払いました。\n王子、お疲れ様でした。"}, {"name": "バルバストラフ", "text": "まさか魔界アリが現れるとはのぅ。\n千年戦争の時に封じられ滅びたと思っておったが、\nやっかいなやつらに出くわしたものじゃ。", "face": "u63"}, {"name": "スクハ", "text": "それにしても、おかしいですね……。\n私がここを通った時は、あの様な魔物は\nいなかったのですが……。", "face": "u341"}, {"name": "バルバストラフ", "text": "封印が解かれたのやもしれぬな。\nじゃが、一体何者が\n封印を解いたというのか……。", "face": "u63"}, {"name": "スクハ", "text": "先ほどから、微弱ながらも莫邪の剣から\n何か不思議な力を感じています。\nもしかしたら妖虎仙が……。", "face": "u341"}, {"name": "アンナ", "text": "敵はすぐそこまで迫っているやもしれません。\n皆さん、気を引き締めていきましょう。", "face": "l077ae4c90c18"}]}], "active": true}