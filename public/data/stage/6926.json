eed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 27}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 4, "hp": 3200, "attack": 140, "base_hp": 3200, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "special_effect_id": 222, "change_to": 5, "master_id": 32161, "global_id": 5780, "to_global_id": 5781, "spawn_sec": 57}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "hp": 18000, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 100, "attack_wait": 10, "attack_interval": 196, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114032, "race_id": 9, "special_effect_id": 415, "change_to": 6, "master_id": 32162, "global_id": 5781, "to_global_id": 5782}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 18000, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 100, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 9, "change_to": 7, "master_id": 32163, "global_id": 5782, "to_global_id": 5783}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 18000, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 190, "attack_speed": 100, "attack_wait": 30, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114032, "race_id": 2, "special_effect_id": 248, "change_to": 8, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 32164, "global_id": 5783, "ranged": true, "variants": [{"hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 100, "attack_wait": 20, "attack_interval": 203, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114048, "race_id": 2, "special_effect_id": 222, "master_id": 32165, "global_id": 5784}]}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 76}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 87}, {"enemy_id": 12, "source": "local", "count": 8, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 99}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097312, "race_id": 9, "master_id": 53, "global_id": 52, "spawn_sec": 129}, {"enemy_id": 14, "source": "local", "count": 2, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 135}], "popups": ["デモンポーンは倒されると、\nその場で復活します。\n2回まで復活し、\n復活するたびに強くなります。\n\n倒さなくても★の評価には影響せず、\n拠点にも向かいません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンロード", "text": "――対魔王軍残党を想定した演習、ですか？", "face": "u941"}, {"name": "アンナ", "text": "はい。おふたりに演習の相手を\nお願いできたらと思うのですが、いかがでしょうか？"}, {"name": "デーモンロード", "text": "しかし我々は少し前まで敵だった身。\n本当に演習相手として相応しいかどうか……。", "face": "u941"}, {"name": "レオナ", "text": "ふむ。かつて敵だったということより、\n今後良好な関係を築けるかどうかの方が重要だろう。", "face": "u311"}, {"name": "レオラ", "text": "王国と帝国も、敵対していた頃があったものね♪\nそれよりレオナちゃん、\nこの子、すっごく可愛くないかしら～♪", "face": "u464"}, {"name": "デーモンロード", "text": "わわっ、お、おやめ下さいっ！\n王子が見ていますから！\n――こ、こほん。そういう事でしたらご協力しましょう。", "face": "u941"}, {"name": "デモンポーン", "text": "ごぶごぶちゃんたちも連れてきたから、\nちょっとした元魔王軍ごっこもできちゃうよ～？", "face": "u997"}, {"name": "デモンポーン", "text": "まぁよわよわ王子たちが相手なら、\nあたしだけでも十分なんだけどね。\n今回は秘密兵器も持ってきたし……ふっふっふ……。", "face": "u997"}, {"name": "デーモンロード", "text": "こら、これから仲良くしようと\n言ってくれている方々に失礼ですよ。", "face": "u941"}, {"name": "デモンポーン", "text": "はーい。ごめんなさーい♪", "face": "u997"}, {"name": "デモンポーン", "text": "（でもでもぉ、よわよわ王子たち、\nこの秘密兵器を見たらぜーったいびっくりするよぉ♪）", "face": "u997"}, {"name": "デモンポーン", "text": "（はい、あんたたちがコレ持っててね。\nあたしが合図したら、たぬぬぽーんと変身しちゃって！）", "face": "u997"}, {"name": "ゴブリン", "text": "（ギャギャ？　ヘンシン？　タヌヌポン？）", "face": "lc9b0398d63ea"}, {"name": "デモンポーン", "text": "（そうそう♪　戦うのは楽しいけど、\n演習とか真面目なのはお断りだからねー。\nもっと面白おかしくしなくちゃ！）", "face": "u997"}, {"name": "アンナ", "text": "それでは、戦闘訓練を始めます。\n双方大怪我のないように、全力を出し合いましょう！", "face": "le527dc289920"}]}, {"trigger": "battle", "at_sec": 39, "lines": [{"name": "デモンポーン", "text": "あーあ、飽きちゃったぁ。\nねぇあんた達、後はいい感じにお願いねー？", "face": "u997"}, {"name": "ゴブリン", "text": "ギャギャ！？　フマジメ！？", "face": "lc9b0398d63ea"}, {"name": "デモンポーン", "text": "しーらない♪\n適当に皆をからかってくるから、\nさっきあげた木の葉を使って大暴れしてきてね！", "face": "u997"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "そこまで！　戦闘訓練終了です！"}, {"name": "デモンポーン", "text": "あー、すっきりした♪\nやっぱり暴れると気持ちいいね！", "face": "u997"}, {"name": "デーモンロード", "text": "しかし、途中でこっそり戦場を離れたのは、\n見逃していませんからね。", "face": "u941"}, {"name": "デモンポーン", "text": "うっ……お姉ちゃんのいじわる～！", "face": "u997"}, {"name": "アンナ", "text": "ふふっ。あくまで実戦ではなく、演習ですから。\nそれよりも、我々の訓練に協力していただき、\n本当にありがとうございました。"}, {"name": "デーモンロード", "text": "いえ、我々も物質界に間借りして、\nひっそりと暮らしている身です。\nこれくらいの恩返しはさせていただかなければ。", "face": "u941"}, {"name": "デモンポーン", "text": "ひっそり生活とかやーだー。\nもっと色んなところ行って遊ぼうよー！", "face": "u997"}, {"name": "デーモンロード", "text": "私達が出歩いては怖がる方がいるかもしれません。\n我々は敗軍なのですよ？\nそういう自覚をしっかりと持たなければ。", "face": "u941"}, {"name": "デモンポーン", "text": "う～！　けちけち！　お姉ちゃんのけちー！", "face": "u997"}, {"name": "アンナ", "text": "いつかは、手を取り合って\nこの世界を歩めると良いのですが……。", "face": "l48e06ddcbb07"}, {"name": "デーモンロード", "text": "ふふ、それはもう少し先のことでしょう。\nしかしそのご厚意は、ありがたく受け取っておきます。", "face": "u941"}, {"name": "アンナ", "text": "それでは、少し休憩を挟んでから、\n第二回戦に移りましょうか。\n王子も十分に休息をとっておいてくださいね。"}, {"name": "デモンポーン", "text": "えっ、休憩？\nじゃあよわよわ王子、一緒にあそぼ～？", "face": "u997"}, {"name": "デーモンロード", "text": "こ、こら！　失礼ですよ！\nまったく、いきなり元気になるんですから……。", "face": "u941"}, {"name": "デモンポーン", "text": "えー？　でも王子も遊んでくれるって言ってるよ～？", "face": "u997"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "アンナ", "text": "ふふっ、それでは休憩は長めにしておきます。\nあまりハメを外さないように、気をつけてくださいね？"}]}], "active": true}