{"quest_id": 6606, "name": "竜将の使命", "description": "魔王軍幹部、竜将クロコの不穏な動きを\n察知した王子たちはその企みを阻止すべく\n目撃情報のあった渓谷へと急行する……。\n神級（★１獲得の目安：平均Lv50）", "event": "雄飛せし鷲獅騎兵", "event_category": "History", "mission_id": 920117, "map_no": 3331, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 50000, "attack": 1200, "base_hp": 50000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 190, "attack_speed": 100, "attack_wait": 30, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114032, "race_id": 2, "special_effect_id": 232, "change_to": 1, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30919, "global_id": 4538, "ranged": true, "variants": [{"hp": 50000, "attack": 3000, "base_hp": 50000, "base_attack": 3000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 100, "attack_wait": 20, "attack_interval": 203, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114048, "race_id": 2, "master_id": 30920, "global_id": 4539}]}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_