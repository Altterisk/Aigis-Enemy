ttack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_range": 180, "attack_speed": 40, "attack_wait": 30, "attack_interval": 87, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113968, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30910, "global_id": 4529, "ranged": true, "spawn_sec": 135}, {"enemy_id": 21, "source": "local", "count": 3, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 152}, {"enemy_id": 22, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 152}, {"enemy_id": 23, "source": "local", "count": 4, "form_count": 1, "hp": 2700, "attack": 350, "base_hp": 2700, "base_attack": 350, "damage_type": "physical", "armor_defense": 70, "magic_defense": 40, "attack_speed": 40, "attack_wait": 3, "attack_interval": 89, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098704, "race_id": 3, "special_effect_id": 42, "master_id": 111, "global_id": 110, "spawn_sec": 152}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、魔王軍の竜人、\nクロコが目撃されたという地点に到着しました。", "face": "l513e4e03b3fb"}, {"name": "フィリス", "text": "魔王軍め、こんな所で\nいったい何を企んでいるんだ？", "face": "u40"}, {"name": "カゲロウ", "text": "何かを企む、と言うよりも、\n各地で何者かを探している様子だったらしい。", "face": "u139"}, {"name": "ゴライア", "text": "ケッ、魔王に尻尾振った腰抜けのことダ。\nドウセいけ好かネェ陰謀に決まってやがるゼ。", "face": "u385"}, {"name": "フィリス", "text": "まぁ、何にしたって野放しにはしておけない。\nまずはこの周辺を探って――", "face": "u40"}]}, {"trigger": "start", "lines": [{"name": "クロコ", "text": "――ホウ、詰まらナイ任務だと思っていたガ、\nマサカ王子と遭遇するとはナ……。", "face": "l918ea865e833"}, {"name": "ゴライア", "text": "クロコ……！！\nテメェ、ヨクも顔を見せられたナァ！", "face": "u385"}, {"name": "クロコ", "text": "弱キ者ホド、ヨク吠えるものだナ……。\nシカシ王子、残念だが今日は相手をしてやれヌ。\n私は武人であると同時に、魔王様の部下だからナ。", "face": "l918ea865e833"}, {"name": "ゴライア", "text": "ケッ、悪巧みしてるっテ、\n自分で言ってるようなもんダゼ。\n能書きは良いから掛かってきたらドウダ！！", "face": "u385"}, {"name": "クロコ", "text": "相手をしてやる暇ハ無いと言ったノダ。\n王子ヨ、再戦は別の機会に預けさせてもらオウ。", "face": "l918ea865e833"}, {"name": "クロコ", "text": "我が配下の者ドモヨ、\nしばらく王子達を足止めしてオケ。", "face": "l918ea865e833"}, {"name": "フィリス", "text": "くっ、逃げる気か……！", "face": "u40"}, {"name": "アンナ", "text": "王子、魔王軍のデーモンが出現しました。\nどうやら応戦するしかなさそうです。\n急ぎ、戦闘の準備をお願いします！", "face": "l513e4e03b3fb"}]}, {"trigger": "battle", "at_sec": 118, "lines": [{"name": "デーモン", "text": "クロコ様、先程の飛行物体、\nこちらの方へ飛んでいった様です。", "face": "l26655100269b"}, {"name": "ゴブリン", "text": "ギャギャッ！　王子！　ミツケタ！", "face": "lbd7402b2a701"}, {"name": "クロコ", "text": "あの見慣れぬ兵器……マサカ、\nゴブリン達が自ら発明したというのカ？", "face": "l918ea865e833"}, {"name": "デーモン", "text": "おそらくは……。連中には、\nゴブリン博士なる知恵者がいるとのことです。", "face": "l26655100269b"}, {"name": "クロコ", "text": "魔王軍幹部トシテ並び立つ強者探シ、\n飽いてキタところだったガ、興が乗っタゾ！", "face": "l918ea865e833"}, {"name": "クロコ", "text": "あの兵器の力、間近で見極めタイ。\n私もこの戦い、参戦スルゾ！\n我が雷槍の力、再び見せてやロウ！", "face": "l918ea865e833"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン", "text": "ギャギャッ！　テッタイ！　テッタイー！！", "face": "lbd7402b2a701"}, {"name": "クロコ", "text": "――成る程、ゴブリンか。\n最弱の種族と聞いていたガ……。\n実に興味深い存在デアッタ。", "face": "l918ea865e833"}, {"name": "クロコ", "text": "それに加え、王子ノ腕も落ちるドコロか、\n更に磨きがかかっていた。\n次の戦いが実に楽しみダ……！", "face": "l918ea865e833"}, {"name": "ゴライア", "text": "クロコ！　テメェまた逃げルつもりカ！？", "face": "u385"}, {"name": "クロコ", "text": "これが逃亡に見えルのナラ、\nどうとデモほざくが良い、名も知らぬ竜人ヨ。", "face": "l918ea865e833"}, {"name": "クロコ", "text": "私は魔王様に報告を急がねばならヌ。\nさらばだ王子、次の戦いを心待ちにしてイルゾッ！！", "face": "l918ea865e833"}, {"name": "フィリス", "text": "……すまない王子、逃してしまった。", "face": "u40"}, {"name": "ケイティ", "text": "こちらにも多数の負傷者がいます。\n深追いは悪手でしょう。仕方ありません。", "face": "u114"}, {"name": "アンナ", "text": "それにしても、魔王軍は\nいったい何を企んでいるのでしょうか……。\n今後も警戒を怠らないようにしましょう、王子。", "face": "l513e4e03b3fb"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}