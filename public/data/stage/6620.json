{"quest_id": 6620, "name": "裏切りの将を巡って", "description": "シャディアの処遇について割れる両軍。\n王子に賛同した帝国治癒士長アウローラと\n共に帝国式の対話で結論を出せ！\n神級（★１獲得の目安：平均Lv50）", "event": "叛逆の槍と覚醒の魔王", "event_category": "History", "mission_id": 920118, "map_no": 5399, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["帝国"], "hp": 7500, "attack": 700, "base_hp": 7500, "base_attack": 700, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 25, "attack_interval": 72, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114416, "race_id": 16, "special_effect_id": 54, "master_id": 31021, "global_id": 4640, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 450, "base_hp": 5000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 137, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109792, "race_id": 16, "special_effect_id": 54, "master_id": 30215, "global_id": 3834, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 1, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100976, "race_id": 16, "special_effect_id": 54, "master_id": 30217, "global_id": 3836, "spawn_sec": 6}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "帝国"], "hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 700, "attack_speed": 1, "attack_wait": 20, "attack_interval": 82, "move_speed": 450.0