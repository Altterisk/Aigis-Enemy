0, "base_hp": 25000, "base_attack": 700, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 120, "attack_interval": 322, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2108736, "race_id": 16, "special_effect_id": 53, "change_to": 16, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 31039, "global_id": 4658, "to_global_id": 3780, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 138}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 25000, "attack": 700, "base_hp": 25000, "base_attack": 700, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 300, "attack_speed": 1, "attack_wait": 120, "attack_interval": 321, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108736, "race_id": 16, "special_effect_id": 53, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 30161, "global_id": 3780, "ranged": true}, {"enemy_id": 18, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー", "帝国"], "hp": 3500, "attack": 250, "base_hp": 3500, "base_attack": 250, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 321, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113104, "race_id": 16, "change_to": 18, "change_condition": 1, "missile_id": 244, "missile": {"speed": 4.0, "splash": 53}, "master_id": 30775, "global_id": 4394, "ranged": true, "variants": [{"tags": ["アーマー", "帝国"], "hp": 3500, "attack": 250, "base_hp": 3500, "base_attack": 250, "damage_type": "physical", "armor_defense": 250, "attack_speed": 60, "attack_wait": 60, "attack_interval": 206, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113120, "race_id": 16, "master_id": 30776, "global_id": 4395}], "spawn_sec": 155}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 2400, "base_hp": 30000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 550, "magic_defense": 10, "attack_range": 260, "attack_speed": 1, "attack_wait": 100, "attack_interval": 267, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109024, "race_id": 16, "special_effect_id": 129, "missile_id": 186, "missile": {"speed": 12.0}, "master_id": 30156, "global_id": 3775, "ranged": true, "spawn_sec": 158}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 1, "hp": 50000, "attack": 1500, "base_hp": 50000, "base_attack": 1500, "damage_type": "true", "armor_defense": 1300, "magic_defense": 20, "attack_range": 190, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108352, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30500, "global_id": 4119, "ranged": true, "spawn_sec": 183}], "popups": ["白の皇帝の攻撃は\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "エルミラ", "text": "――信用できません。\n魔王の配下だった者を側におくなど、\n酔狂の域を超えています。", "face": "u1427"}, {"name": "フレデリカ", "text": "魔王への背信は演技で、\n王子を暗殺するべく懐に潜り込んだ\nとは考えないのですか？", "face": "u362"}, {"name": "リーゼロッテ", "text": "その可能性を考えていないわけでもあるまい。\nだが、王子はそれでも\n手を伸ばすことを選んだのだろう？", "face": "u305"}, {"name": "リーザ", "text": "うぅぅ……納得出来ないわ！\n王子だけじゃなくて、王国の皆まで\n危険にさらされるかもしれないのに！", "face": "u1622"}, {"name": "ジークリンデ", "text": "むしろ信用出来ないなら、王子という\n強者の許に置いておくのは良い案だと思うがな。\nお前はどう思う、アウローラ？", "face": "u1429"}, {"name": "アウローラ", "text": "王子の判断は極めて合理的だと思います。\nもはや魔王を倒す為に、\n手段を選べる段階にはないかと思います。", "face": "u1711"}, {"name": "ディアナ", "text": "はぁ……仲間同士で言い争っていても始まりません。\n力を以て覇を示すのが帝国なれば、\n剣で語るより他に、選択肢は無いのでしょう？", "face": "u1624"}, {"name": "白の皇帝", "text": "……そのとおりだ。\n話し合いで解決するなら、人は戦を選ぶことはない。", "face": "u418"}, {"name": "白の皇帝", "text": "……貴様の判断だ。俺は信じよう。\nだが、わだかまりを抱えたまま共闘すれば、\n皆の心に禍根が残るのもまた事実だ。", "face": "u418"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "白の皇帝", "text": "シャディアを信じられぬ者、\n王子の身を案じる者は俺に付け。\n信じると断言するならば王子に付け。", "face": "u418"}, {"name": "アンナ", "text": "白の皇帝……王子、\nあなた方はもしや……。", "face": "ld917fb20258a"}, {"name": "白の皇帝", "text": "俺達が全力を以て打ち合い、\n出した結論ならば、誰も異論を挟むことはあるまい。\nそれがシャディアの身を守ることにもなる。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "分かりました。\nそこまでの考えがあるのなら止めはしません。\n双方、模擬戦の準備をお願いします！", "face": "ld917fb20258a"}]}, {"trigger": "end", "lines": [{"name": "ディアナ", "text": "――そこまで！！\n双方、剣を収められよ！！", "face": "u624"}, {"name": "アンナ", "text": "……本当に、これで大丈夫なのでしょうか。", "face": "ld917fb20258a"}, {"name": "ジェリウス", "text": "ここにいる皆は、王子を信じてついてきた者達だ。\nもはや誰も、異を唱えることはないさ。", "face": "u83"}, {"name": "フィリーネ", "text": "帝国もそうだろう。\nそれに両国の長が剣をもって示した以上、\n賽は投げられてしまったのだから。", "face": "u621"}, {"name": "白の皇帝", "text": "……一度裏切った者は何度だって裏切る。\nだが、お前がその娘を信じたというのなら、\n俺はその決定を下した、お前自身を信じよう。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "シャディア", "text": "千年戦争以前にも、\nこんな馬鹿共はいなかった。\nだが……嗚呼……くそっ……。", "face": "u713"}, {"name": "シャディア", "text": "…………ありがとう。\n礼は、言っておく。", "face": "u713"}, {"name": "ケイティ", "text": "皆さん、王子がどれだけ本気なのか、\nそれを見たかったのでしょうか……。", "face": "u114"}, {"name": "アンナ", "text": "これからの戦いは、更に過酷になると思います。\nしかし、我々は必ず、王子についていきます。", "face": "ld917fb20258a"}, {"name": "アンナ", "text": "王子、これからもよろしくお願いします！", "face": "ld917fb20258a"}]}], "story_talk": true, "active": true}