{"quest_id": 70005, "name": "神級", "description": "・時間経過によるコスト回復なし\n・ＥＸＰ/ゴールド/ドロップなし\n・ライフが０でもミッションクリア\n", "event": "天覆う竜の序曲", "event_category": "Subjugation", "mission_id": 400590, "map_no": 7519, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 10, "modifiers": [{"kind": "term", "influence": 17}], "enemies": [{"enemy_id": 1, "source": "local", "count": 223, "form_index": 0, "form_count": 1, "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 40724, "global_id": 14341, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 12, "form_index": 0, "form_count": 2, "hp": 45000, "attack": 800, "base_hp": 45000, "base_attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100864, "race_id": 2, "change_to": 2, "change_condition": 2, "missile_id": 33, "missile": {"speed": 5.0}, "master_id": 41242, "ranged": true, "to_condition": 2, "spawn_sec": 46}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 55000, "attack": 800, "base_hp": 55000, "base_attack": 800, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100880, "race_id": 2, "missile_id": 34, "missile": {"speed": 5.0}, "master_id": 41243, "ranged": true, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 180, "form_index": 0, "form_count": 2, "hp": 8500, "attack": 600, "base_hp": 8500, "base_attack": 600, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 10, "attack_interval": 88, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2174000, "race_id": 2, "change_to": 4, "change_condition": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 41251, "to_condition": 2, "spawn_sec": 62}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 13000, "attack": 300, "base_hp": 13000, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "attack_range": 100, "attack_speed": 1, "attack_wait": 80, "attack_interval": 216, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2174016, "race_id": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 41252, "ranged": true, "from_condition": 2}, {"enemy_id": 6, "source": "local", "count": 101, "form_index": 0, "form_count": 2, "hp": 25000, "attack": 700, "base_hp": 25000, "base_attack": 700, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100256, "race_id": 2, "change_to": 6, "change_condition": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 41244, "ranged": true, "to_condition": 2, "spawn_sec": 186}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 700, "base_hp": 30000, "base_attack": 700, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100272, "race_id": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 41245, "ranged": true, "from_condition": 2}, {"enemy_id": 8, "source": "local", "count": 48, "form_index": 0, "form_count": 2, "hp": 38000, "attack": 1000, "base_hp": 38000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 200, "magic_defense": 70, "attack_range": 180, "attack_speed": 60, "attack_wait": 50, "attack_interval": 243, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100896, "race_id": 2, "special_effect_id": 228, "change_to": 8, "change_condition": 2, "missile_id": 201, "missile": {"speed": 2.0}, "master_id": 41246, "ranged": true, "to_condition": 2, "spawn_sec": 214}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 46000, "attack": 1000, "base_hp": 46000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 300, "magic_defense": 70, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 203, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100912, "race_id": 2, "special_effect_id": 228, "missile_id": 202, "missile": {"speed": 2.0}, "master_id": 41247, "ranged": true, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 16, "form_index": 0, "form_count": 2, "hp": 12000, "attack": 650, "base_hp": 12000, "base_attack": 650, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_speed": 45, "attack_wait": 50, "attack_interval": 196, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160832, "race_id": 13, "special_effect_id": 2091, "change_to": 10, "change_condition": 3, "master_id": 38824, "global_id": 12441, "to_condition": 3, "to_global_id": 12442, "spawn_sec": 240}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1050, "base_hp": 12000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_speed": 45, "attack_wait": 30, "attack_interval": 146, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160848, "race_id": 13, "special_effect_id": 2091, "master_id": 38825, "global_id": 12442, "from_condition": 3}, {"enemy_id": 12, "source": "local", "count": 73, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 41241, "ranged": true, "spawn_sec": 344}, {"enemy_id": 13, "source": "local", "count": 20, "form_index": 0, "form_count": 1, "hp": 35000, "attack": 500, "base_hp": 35000, "base_attack": 500, "damage_type": "magical", "armor_defense": 250, "attack_range": 150, "attack_speed": 1, "attack_wait": 80, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174032, "race_id": 2, "special_effect_id": 2574, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 41254, "ranged": true, "spawn_sec": 406}, {"enemy_id": 14, "source": "local", "count": 49, "form_index": 0, "form_count": 2, "hp": 40000, "attack": 500, "base_hp": 40000, "base_attack": 500, "damage_type": "magical", "armor_defense": 600, "magic_defense": 80, "attack_range": 400, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103776, "race_id": 2, "change_to": 14, "change_condition": 2, "missile_id": 39, "missile": {"splash": 133}, "master_id": 40728, "global_id": 14345, "ranged": true, "to_condition": 2, "to_global_id": 14346, "spawn_sec": 531}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 68000, "attack": 750, "base_hp": 68000, "base_attack": 750, "damage_type": "magical", "armor_defense": 900, "magic_defense": 80, "attack_range": 90, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103792, "race_id": 2, "missile_id": 39, "missile": {"splash": 133}, "master_id": 40729, "global_id": 14346, "ranged": true, "from_condition": 2}, {"enemy_id": 16, "source": "local", "count": 21, "form_index": 0, "form_count": 2, "hp": 58000, "attack": 600, "base_hp": 58000, "base_attack": 600, "damage_type": "magical", "armor_defense": 600, "magic_defense": 80, "attack_range": 400, "attack_speed": 60, "attack_wait": 30, "attack_interval": 151, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174064, "race_id": 2, "special_effect_id": 72, "change_to": 16, "change_condition": 2, "missile_id": 1735, "missile": {"speed": 5.0}, "master_id": 41259, "ranged": true, "to_condition": 2, "spawn_sec": 1055}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 80000, "attack": 850, "base_hp": 80000, "base_attack": 850, "damage_type": "physical", "armor_defense": 900, "magic_defense": 80, "attack_speed": 60, "attack_wait": 10, "attack_interval": 171, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174080, "race_id": 2, "special_effect_id": 821, "master_id": 41260, "from_condition": 2}, {"enemy_id": 18, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "hp": 75000, "attack": 600, "base_hp": 75000, "base_attack": 600, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 50, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174048, "race_id": 2, "special_effect_id": 2573, "missile_id": 777, "missile": {"splash": 40}, "master_id": 41256, "ranged": true, "spawn_sec": 1070}], "popups": ["成体の結晶の魔物は\n一定範囲内のユニットから\nダメージを受けると\n受けたダメージの25%のダメージで\n攻撃したユニットへ反撃を行います。\n\n\n　　　　　　(1/2)", "成体の結晶の魔物は\nHPが50％以下になると\n攻撃力と移動速度がアップします。\n\n\n\n\n　　　　　　(2/2)", "サファイアドラゴンは\n自身の攻撃力の値で\n自身を含む周囲の敵を回復します。\nまたサファイヤドラゴンがいる間、\n全ての敵のHPが徐々に回復します。", "ルビードラゴンがいる間は、\n全てのドラゴンの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ラージヴィール", "text": "――来てくれたか、王子よ！\n見よ、城壁の外は見渡す限り竜、竜、竜だ！", "face": "l4ebe7bd5270c"}, {"name": "アナーニャ", "text": "ドラゴンの国との直接対決、\n歴史上なかったことではないですが……。\nそれでも、自分がそこに立つのは初めてですね。", "face": "u2873a1"}, {"name": "ラージヴィール", "text": "ニハラよ、民の避難は進んでいるか？", "face": "l4ebe7bd5270c"}, {"name": "ニハラ", "text": "はい。その、実はスカベンジャーの方々が\n手を貸してくださって……。", "face": "u2888a1"}, {"name": "プリヤンカ", "text": "親友が困ってるって言ったら、\nみんな大喜びで協力してくれたよ！", "face": "u2808a1"}, {"name": "ニハラ", "text": "あれは「しょうがないなぁ、うちの問題児は」\nという表情だったかと……。", "face": "u2888a1"}, {"name": "ラージヴィール", "text": "では、あとは全力で戦うのみだな。\n長らく甘やかされてきた他の貴族連中も、\nようやく現実を直視できるというものだ。", "face": "l4ebe7bd5270c"}, {"name": "ソラス", "text": "――はぁ、はぁ……ふぇぇ……。\nま、間に合ったようですね……。", "face": "u904"}, {"name": "ラージヴィール", "text": "むっ、占星術師殿か。\nそんなに急いでどうしたのだ。", "face": "l4ebe7bd5270c"}, {"name": "ソラス", "text": "えっと……昔の仲間――と言っても、\n天眼ノ国の方には伝わらないですよね……。", "face": "u904"}, {"name": "ソラス", "text": "古い知り合いが突然訪ねてきて、\n天眼ノ国の民を守る戦いに助力したい、と……。", "face": "u904"}, {"name": "クローディア", "text": "（ソラスさんの古い知り合いというと、つまり……）", "face": "u163"}, {"name": "トトノ", "text": "（英傑、ということですよね？）", "face": "u316"}, {"name": "ケルドラ", "text": "初めまして、皆さま。\n私はケルドラ、古き時代より生きるただの――", "face": "u2869a1"}, {"name": "ラージヴィール", "text": "むっ……天眼があるではないか。\nそなた、天眼ノ民なのか？", "face": "l4ebe7bd5270c"}, {"name": "ケルドラ", "text": "あっ、えっと、それは……。", "face": "u2869a1"}, {"name": "ソラス", "text": "まぁまぁ、後で説明しますから！\nともかく彼女は信頼できる人ですから、\n民間人の護衛は任せちゃいましょう！", "face": "u904"}, {"name": "トラハイア", "text": "――おっと、ちょうど話が終わったところか？\n一応、戦争にはお題目が必要だからな。\nこちらの要求を伝えておくが……。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "天眼核を渡せ。\nうちの姫様も返してくれると助かるが、\nこればかりは、本人が決めることか。", "face": "l806a436e82bf"}, {"name": "アナーニャ", "text": "断ります。天眼核の譲渡など、\nそれは即ち、民を守る力を譲るに等しい。", "face": "u2873a1"}, {"name": "アンウェン", "text": "わらわも戻らぬ。\n太守には、トラハイアよ、\nそなたの口からも戦争を止めるよう伝えてほしい。", "face": "u2934a1"}, {"name": "トラハイア", "text": "やれやれ……無理だとわかっていて、\n綺麗事を仰るものだ。\nそういう姫様だから、兵からも離反者が出たわけだ。", "face": "l806a436e82bf"}, {"name": "アンウェン", "text": "他国の力ある結晶を奪ったとて、\n竜都が再び力を取り戻すとは限らぬだろう！\nどうせあの男、モードリオンの差し金だろうに！", "face": "u2934a1"}, {"name": "トラハイア", "text": "……策略だろうと泥舟だろうと、\n乗らねばならぬ時もあるということです、姫様。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "さぁ、やろうか。\n共に民の命運を背負った者同士、\n退くことなど最初からありえんだろう。", "face": "l806a436e82bf"}, {"name": "アナーニャ", "text": "……交渉は、無駄でしょうね。", "face": "u2873a1"}, {"name": "トラハイア", "text": "竜都の戦士たちよ、\n故郷のため、その命を捧げよ。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "全軍、咆哮をあげよ！\n空の覇者が誰であるか、見せてやれ！", "face": "l806a436e82bf"}]}, {"trigger": "end", "lines": [{"name": "トラハイア", "text": "――なるほど。確かに強い。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "姫様が惚れ込むのも分かる。\n絆だの仲間だの、数を頼る力はあまりにも暴力的だ。", "face": "l806a436e82bf"}, {"name": "アンウェン", "text": "わらわはそのような考えで\nこちらに味方したわけではない！", "face": "u2934a1"}, {"name": "トラハイア", "text": "えぇ、わかっていますよ姫様。\n――だが、竜都の民は、そうは考えない。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "竜都が、空中都市リヴァイアサンが\nその動力を失い、地に墜ちたなら、\n人類は間違いなく我らを狩りにかかる。", "face": "l806a436e82bf"}, {"name": "アナーニャ", "text": "ゆえに、これは避けられぬ戦いだと？", "face": "u2873a1"}, {"name": "トラハイア", "text": "然り。", "face": "l806a436e82bf"}, {"name": "ラージヴィール", "text": "だが、此度の勝利はこちらに――いや、\nそういうことか……。", "face": "l4ebe7bd5270c"}, {"name": "ラージヴィール", "text": "あえてこれだけの軍勢を送り込み、\nこちらの主力を一箇所に集中させた。\nその真意があるとすれば、ふたつのみ。", "face": "l4ebe7bd5270c"}, {"name": "ユリクセス", "text": "……ひとつ。手薄になった地域へ侵攻し、\n領土を切り取らんと考える。\nこれは互いに地上に領土を持つ場合だ。", "face": "u2193a1"}, {"name": "ラージヴィール", "text": "うむ。そしてもうひとつは――", "face": "l4ebe7bd5270c"}, {"name": "ケルドラ", "text": "――竜都そのものをここへ移動させ、\nドラゴンの国すべての戦力をもって\n天眼ノ国を押しつぶす。そうですね？", "face": "u2869a1"}, {"name": "トラハイア", "text": "もとより、全員死ぬまで終わらない戦争だ。\n種の存続がかかってるからな。", "face": "l806a436e82bf"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "トラハイア", "text": "聞いてるぜ、異世界の王子。\n敵にすら手を差し伸べるお人好しってな。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "悪いが、滅ぶことを恐れる者に、\n憎しみではなく恐怖によって戦いを選ぶ者に、\nお前の手は届かない。", "face": "l806a436e82bf"}, {"name": "王子", "text": "――試してみるか、トラハイア。", "face": "u1"}, {"name": "トラハイア", "text": "…………。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "竜の民、その全てを救えるっていうのなら、\nやってみればいいさ。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "そのときは、素直に負けを認めてやるよ。", "face": "l806a436e82bf"}, {"name": "トラハイア", "text": "――だが、この戦いは、ここで終わりだ！", "face": "l806a436e82bf"}]}, {"trigger": "end", "lines": [{"name": "シャルロット", "text": "……あれ？　何だか空が暗くなってきたような？", "face": "u2827a1"}, {"name": "プリヤンカ", "text": "まずい……やばいよこれ！\nあれ！　空みて！　こっちに向かってる！", "face": "u2808a1"}, {"name": "ユリクセス", "text": "なんだ、あの巨大な……ドラゴン、なのか……？", "face": "u2193a1"}, {"name": "ケルドラ", "text": "竜都、ドラゴンの国、天飛ぶ大地。\n呼び名は数多くありますが……。", "face": "u2869a1"}, {"name": "ケルドラ", "text": "あれなるは、創生の戦いにて生み出されし、\n世界を砕き、紡ぎ直すもの。", "face": "u2869a1"}, {"name": "ケルドラ", "text": "――神造兵器、リヴァイアサン。", "face": "u2869a1"}]}], "active": true}