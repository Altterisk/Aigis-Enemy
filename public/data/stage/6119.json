{"quest_id": 6119, "name": "一つ目の巨人", "description": "サイクロプス発見の報を受け討伐に\n訪れた王子たち。巨体から放たれる\n強力な一撃に注意し敵を撃破せよ！\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "巨人殺しの剣", "event_category": "History", "mission_id": 920090, "map_no": 3971, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 150, "gold": 700, "drops": [{"card": 2, "c": 2}, {"card": 55, "c": 1}, {"item": 1005, "c": 1}, {"item": 5002, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_index": 0, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 49}, {"enemy_id": 3, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 56}, {"enemy_id": 4, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 73}, {"enemy_id": 5, "source": "local", "count": 1, "level": 80, "form_index": 0, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 151}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "――こちらになります！\nサイクロプス発見の報告があった地は！", "face": "laf840bed104f"}, {"name": "ケイティ", "text": "案内ご苦労様です。\n引き続き周囲の警戒に\n当たって貰えればと思います。", "face": "u114"}, {"name": "兵士", "text": "はっ！", "face": "laf840bed104f"}, {"name": "アンナ", "text": "それにしても、まさかこの地域に\nサイクロプスが現れるなんて……。", "face": "l4680010083c3"}, {"name": "ケイティ", "text": "普段は小型の魔物程度の報告しか\nない地域……それだけ魔物達の動きが\n活性化してきているということなのでしょうか。", "face": "u114"}, {"name": "魔物", "text": "ギャギャーッ！", "face": "la2cee221dd57"}, {"name": "アンナ", "text": "どうやら魔物が現れたようですね。\n王子、戦いのご準備をお願いします。", "face": "l4680010083c3"}, {"name": "ケイティ", "text": "……この地鳴り、サイクロプスも\n近づいてきているようです。\n王子、ご注意ください。", "face": "u114"}]}, {"trigger": "battle", "at_sec": 75, "lines": [{"name": "兵士", "text": "報告！　サイクロプスが現れました！", "face": "laf840bed104f"}, {"name": "ケイティ", "text": "王子、奴らの強力な攻撃にはくれぐれもご注意を。\n近づかれる前に、しっかりと敵の体力を\n削っておいた方が良いかと思われます。", "face": "u114"}, {"name": "バシラ", "text": "……となると私達の出番ですね！\nバシバシ射抜いちゃいますので\nドーンと任せてください！　行きますよー！", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "無事に魔物達は退けたようですね。\nお疲れ様で――"}, {"name": "兵士", "text": "――別の部隊より伝令！　\nサイクロプス達が群れを成し、\n北の砂漠を進行中との事です！", "face": "laf840bed104f"}, {"name": "バシラ", "text": "そんなぁ～。ようやく\n一息つけると思ったのに～……。", "face": "u28"}, {"name": "アンナ", "text": "しかし放置している訳にはいきません。\n王子、急ぎ報告のあった地へと向かいましょう！", "face": "l4680010083c3"}]}], "map": {"image": "Map920090_3971", "w": 960, "h": 640, "spots": [{"k": "b", "x": 937, "y": 192}, {"k": "m", "x": 165, "y": 117, "id": 200}, {"k": "m", "x": 278, "y": 134, "id": 201}, {"k": "m", "x": 390, "y": 151, "id": 202}, {"k": "m", "x": 509, "y": 169, "id": 203}, {"k": "m", "x": 625, "y": 173, "id": 204}, {"k": "m", "x": 733, "y": 185, "id": 205}, {"k": "m", "x": 728, "y": 254, "id": 206}, {"k": "m", "x": 633, "y": 272, "id": 207}, {"k": "m", "x": 515, "y": 287, "id": 208}, {"k": "m", "x": 388, "y": 312, "id": 209}, {"k": "m", "x": 263, "y": 336, "id": 210}, {"k": "m", "x": 180, "y": 395, "id": 211}, {"k": "m", "x": 271, "y": 435, "id": 212}, {"k": "m", "x": 376, "y": 463, "id": 213}, {"k": "m", "x": 488, "y": 475, "id": 214}, {"k": "m", "x": 610, "y": 473, "id": 215}, {"k": "m", "x": 722, "y": 468, "id": 216}, {"k": "m", "x": 838, "y": 465, "id": 217}, {"k": "m", "x": 840, "y": 220, "id": 218}, {"k": "r", "x": 564, "y": 119, "id": 300}, {"k": "r", "x": 705, "y": 127, "id": 301}, {"k": "r", "x": 819, "y": 165, "id": 302}, {"k": "r", "x": 781, "y": 423, "id": 303}, {"k": "r", "x": 656, "y": 430, "id": 304}, {"k": "r", "x": 522, "y": 438, "id": 305}, {"k": "r", "x": 134, "y": 457, "id": 306}, {"k": "r", "x": 456, "y": 105, "id": 307}]}, "start_cost": 10, "active": true}