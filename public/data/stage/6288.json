": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110624, "race_id": 9, "special_effect_id": 49, "change_to": 14, "change_condition": 2, "missile_id": 26, "master_id": 30377, "global_id": 3996, "ranged": true, "to_condition": 2, "to_global_id": 3973, "spawn_sec": 4}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110640, "race_id": 9, "special_effect_id": 49, "missile_id": 26, "master_id": 30354, "global_id": 3973, "ranged": true, "from_condition": 2}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 40000, "attack": 1200, "base_hp": 40000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 250, "attack_speed": 30, "attack_wait": 110, "attack_interval": 261, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112400, "race_id": 9, "special_effect_id": 242, "change_to": 17, "change_condition": 2, "missile_id": 234, "missile": {"speed": 4.0, "splash": 120}, "master_id": 30681, "global_id": 4300, "ranged": true, "to_condition": 2, "to_global_id": 4301, "route_behaviour": {"calls_event": [2100, 2101, 2102]}, "spawn_sec": 13}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 40000, "attack": 1200, "base_hp": 40000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 200, "attack_speed": 30, "attack_wait": 110, "attack_interval": 271, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112464, "race_id": 9, "special_effect_id": 83, "missile_id": 104, "master_id": 30682, "global_id": 4301, "ranged": true, "from_condition": 2}], "popups": ["くぐつに搭乗したゴブリン、\nゴブリン博士は拠点に向かわず、\n倒さなくても★の評価には影響\nしません。  "], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "皆の者、聞くがヨイ！\n今回の飛行訓練は、ワタクシが改良、量産化に成功した\n飛行型くぐつの実用化を図るためのものデアル！", "face": "l8c59211033ce"}, {"name": "ゴブリン", "text": "ギャギャッ！\nヒコウ、クンレン！　クグツ、トバス！", "face": "la935dd3d3374"}, {"name": "ゴブリン博士", "text": "我が天才的頭脳の所産、飛行型くぐつノ\n実用化が進めバ、あの憎き人間の王子たちヲ\n上空から奇襲スルことガ可能となるのデアル！", "face": "l8c59211033ce"}, {"name": "ゴブリン博士", "text": "これでプリンセ……いや、クイーン三姉妹様ニ\nワタクシの才能を認めて頂けるハズ……。\nそうなれば、きっと開発予算も倍増して……グフフ。", "face": "l8c59211033ce"}, {"name": "エレット", "text": "――いたいた、ゴブリンたちだ！\nこらーっ、みんなが使う道を独り占めするなーっ！", "face": "u217"}, {"name": "アンナ", "text": "エレットさんの報告の通り、道を占拠しているのは\nゴブリン博士とその手勢のようですね。\nそれにあれは……いつぞやの飛行型くぐつでしょうか？", "face": "l1c6b76d902c7"}, {"name": "ゴブリン博士", "text": "グギギギギ……これから訓練という時ニ！\n人間どもメ……まさに目の上のタンコブなのデアル！", "face": "l8c59211033ce"}, {"name": "ケイティ", "text": "なにを企んでいるのかは知りませんが、\n速やかに道を明け渡せば\n今回は見逃してあげますよ。", "face": "u114"}, {"name": "ゴブリン博士", "text": "……フン、断るのデアル！\nこれほど飛行訓練に適した場所は二つとナイ！\nなんとシテもここで訓練を強行シテヤルのデアル！", "face": "l8c59211033ce"}, {"name": "ゴブリン博士", "text": "ゴブリン兵各員、戦闘配置に就くノダ！\n操縦士は飛行型くぐつへ！　訓練を敢行シロ！\n邪魔する者には容赦なく銃弾を浴びせるノダ！", "face": "l8c59211033ce"}, {"name": "ゴブリン", "text": "ギャギャッ！\nクンレン、カンコウ！　クンレン、カンコウ！", "face": "la935dd3d3374"}, {"name": "アンナ", "text": "本当に訓練を強行するなんて……。\nこうなってしまっては、\n力ずくで退散させるしかありませんね。", "face": "l1c6b76d902c7"}, {"name": "ケイティ", "text": "飛行型くぐつはこちらへ攻め込む意図はないようです。\nですが、上空からの銃撃には十分にご注意ください。", "face": "u114"}, {"name": "エレット", "text": "地上の守りと回復は任せて！\nみんなで仲良く使うための道を\nゴブリンたちの独り占めになんてさせないんだから！", "face": "u217"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "（クッ……コノままデハ、\n開発予算の大半を注ぎ込んダくぐつが壊れてシマウ……。\nそうナレバ、クイーン様たちにナント言われるカ……）", "face": "l8c59211033ce"}, {"name": "ゴブリン博士", "text": "わ……悪かっタ！\nモウこの場所で訓練はシない！\nスグに撤退スルから許してクレ！", "face": "l8c59211033ce"}, {"name": "王子", "text": "…………（こくり）。", "face": "u1"}, {"name": "ゴブリン", "text": "ゼングン、テッタイ！\nハカセニ、ツヅケ！", "face": "la935dd3d3374"}, {"name": "ボリス", "text": "……やれやれ。逃してよかったのか、王子？\nさっきあのゴブリン博士だかが造ったくぐつを見たが、\nありゃあなかなか大したシロモノだぜ？", "face": "u360"}, {"name": "アンナ", "text": "飛行型くぐつへの対処も必要となると、\n今後のゴブリンたちとの戦いは\nより厳しいものになるかもしれませんね……。", "face": "l1c6b76d902c7"}, {"name": "エレット", "text": "でも、あたしは王子の決断に賛成だよ。\nだって、厳しいだけじゃ人はついてこないもの。", "face": "u217"}, {"name": "エレット", "text": "あたしは優しい王子が好き。\nみんなもそうでしょ？", "face": "u217"}]}, {"trigger": "route", "enemy_ids": [17], "lines": [{"name": "ゴブリン博士", "text": "そ、そんナ……手塩にかけて育てタ、\nワタクシの愛機が墜とされるだナンテ……。", "face": "l8c59211033ce"}, {"name": "ゴブリン博士", "text": "お……おのれ人間どもメ！\nこうなったら奥の手を使うのデアル！", "face": "l8c59211033ce"}, {"name": "ゴブリン博士", "text": "秘密のスイッチを――ポチッとナ。\nフフフ……科学の雷に貫かれ、\nワタクシの天才を思い知ルがイイ！", "face": "l8c59211033ce"}]}], "active": true}