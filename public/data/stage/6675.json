{"quest_id": 6675, "name": "幻獣顕現", "description": "カリンの清らかな心に呼応し、ついに姿を\n現したハクタク。白き幻獣の加護を受け、\n一行は二人の邪仙との決戦に挑む。\n神級（★１獲得の目安：平均Lv50）", "event": "ハクタクに選ばれし者", "event_category": "History", "mission_id": 920120, "map_no": 3340, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "form_count": 1, "hp": 8500, "base_hp": 8500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_wait": 10, "move_speed": 350.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116848, "special_effect_id": 345, "master_id": 31455, "global_id": 5074, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 14, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106672, "master_id": 842, "global_id": 841, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106688, "master_id": 849, "global_id": 848, "spawn_sec": 51}, {"enemy_id": 4, "source": "local", "count": 7, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108080, "master_id": 991, "global_id": 990, "spawn_sec": 61}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 55, "attack_wait": 50, "attack_interval": 236, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114384, "master_id": 31001, "global_id": 4620, "spawn_sec": 78}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108096, "master_id": 992, "global_id": 991, "spawn_sec": 92}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 2, "hp": 60000, "base_hp": 60000, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 80, "attack_speed": 10, "attack_wait": 10, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2113712, "special_effect_id": 260, "change_to": 7, "change_condition": 3, "master_id": 30880, "global_id": 4499, "to_condition": 3, "to_global_id": 4500, "spawn_sec": 134}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 60000, "base_hp": 60000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113872, "special_effect_id": 261, "master_id": 30881, "global_id": 4500, "from_condition": 3}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 900, "attack_speed": 1, "attack_wait": 120, "attack_interval": 821, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114576, "special_effect_id": 280, "missile_id": 274, "master_id": 31036, "global_id": 4655, "ranged": true, "spawn_sec": 135}, {"enemy_id": 10, "source": "local", "count": 8, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112816, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30725, "global_id": 4344, "ranged": true, "spawn_sec": 164}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112832, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30726, "global_id": 4345, "ranged": true, "spawn_sec": 196}], "popups": ["尊天君はHPが50％以下になると\n一定範囲内のユニットへ与える\n継続ダメージ、防御力、魔法耐性が\n大幅に低下します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "太公望", "text": "教え子の身を案じる優しき心、\n戦う力を持たぬにも関わらず、\n怖れることなくこの旅路を歩んだ勇気。", "face": "u603"}, {"name": "太公望", "text": "この場でハクタクに選ばれし者。\n――ハクタクが願いに応えるとすれば、\nそれはカリンさんをおいて他にはいないでしょう。", "face": "u603"}, {"name": "メイファ", "text": "ま、幻でしょうか……？\nか、カリンさんの隣に、\nいつの間にか動物さんが見えるような……。", "face": "u618"}, {"name": "太公望", "text": "動物さんではありません。\nかの幻獣こそ、森羅万象に通ずる智慧を持ち、\n病魔と災厄を祓うとされるハクタクそのものです。", "face": "u603"}, {"name": "淵天君", "text": "ハ、ハクタクですってェ……ッ！？\nくぅっ、周囲に張った病の気がかき消されていくゥ！？", "face": "l36fdb06108fc"}, {"name": "尊天君", "text": "……狼狽えるでない。ここでハクタクを捕らえれば、\nその力を超える病の宝貝すら作れよう。\n淵天君よ、これはむしろ好機と知れぃ！", "face": "la10bec6ce5f2"}, {"name": "淵天君", "text": "な、成る程、確かにィ！　病の気が祓われようと、\n宝貝自体は無力化されていませんからネェ！\n王子たちを再度病に侵し、小娘を捕らえてやりましょう！", "face": "l36fdb06108fc"}, {"name": "カリン", "text": "…………ど、どどど、どうしましょう！？\nさっきから頭の中に、\nハクタク様が話しかけてくるのですが……！？", "face": "u734"}, {"name": "太公望", "text": "ハクタクがあなたを認めたということでしょう。\nカリンさんが正しき道を歩む限り、\nきっとハクタクは力を貸してくれるはずです。", "face": "u603"}, {"name": "カリン", "text": "は、はい……！　それから、その、王子殿下。\nハクタク様が殿下に伝えたいことがあると……。", "face": "u734"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "カリン", "text": "民を守護せんとする志、人を導くに相応しきものなり。\nこの娘に我が魔祓いの力を貸し与える。\n正義を成す助けとするがよい――と。", "face": "u734"}, {"name": "カリン", "text": "って、あ、あれ？　この娘って、私ですか！？\n……う、うぅ、分かりました。\n王子殿下、私も共に戦わせてください……！！", "face": "u734"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "太公望", "text": "ハクタクの加護、魔祓いの力があれば、\n邪仙の術や魔法による攻撃を防ぐ事も可能でしょう。\n王子、必要な際はカリンさんに指示してあげて下さい。", "face": "u603"}, {"name": "アンナ", "text": "自分たちの欲望の為だけに、\n子供らや多くの民を苦しめた邪仙の目論見、\nここで打倒しましょう、王子！", "face": "lace48cea1f67"}]}, {"trigger": "battle", "at_sec": 140, "lines": [{"name": "メイファ", "text": "王子様！　尊天君と淵天君が現れました！", "face": "u618"}, {"name": "太公望", "text": "……ここが正念場ですね。\n王子、尊天君が纏う宝貝『禍血陣』は\n周囲の者を切り刻む砂の刃にして、堅牢な防御陣です。", "face": "u603"}, {"name": "太公望", "text": "弓矢はおろか、魔法すらも防ぐ砂の護り。\nあの砂を貫けるような攻撃があれば良いのですが……。\nとにかく、『禍血陣』の外から集中攻撃を図りましょう。", "face": "u603"}, {"name": "淵天君", "text": "ふふ、そう好き勝手させると思ってるんですかァ？\nその前に、私の宝貝『棺氷陣』でこの戦場を\n氷漬けにしてあげますヨ！", "face": "l36fdb06108fc"}, {"name": "太公望", "text": "……厄介な状況ですが、死中にこそ活路もあります。\nここで邪仙を倒し、華の国に平和を取り戻しましょう！\n王子、勝利への采配をお願いします！", "face": "u603"}]}, {"trigger": "end", "lines": [{"name": "尊天君", "text": "グァアアアアアッ！？\nハクタクめ……貴様が病毒を祓いさえしなければッ！\nこちらの勝利は確実であったものをォ……！！", "face": "la10bec6ce5f2"}, {"name": "淵天君", "text": "し、新型宝貝の実地試験は既に十分ッ！\n撤退、撤退ですヨォ！！\n尊天君、しっかりしなさい、置いていきますヨォ！？", "face": "l36fdb06108fc"}, {"name": "アンナ", "text": "邪仙の軍勢、撤退していきます……。", "face": "lace48cea1f67"}, {"name": "カリン", "text": "ひぁ……っ、こ、腰が抜けてしまいました……。\n私達、勝てたのですよね……？", "face": "u734"}, {"name": "メイファ", "text": "はい！　病の宝貝の気が消えて、\nこの辺りの空気も綺麗になっていきます！", "face": "u618"}, {"name": "太公望", "text": "しかし安堵している暇はありませんよ。\n急ぎ人々の病を癒やしてあげなければ。\nハクタクは協力してくれそうですか？", "face": "u603"}, {"name": "カリン", "text": "…………はい。私に付いてきてくれるそうです。\n良かった、これで子供たちや皆の病が治せます！", "face": "u734"}, {"name": "カリン", "text": "王子殿下、太公望様、王国の皆さんも、\n本当にありがとうございました……！", "face": "u734"}, {"name": "アンナ", "text": "これで一安心ですね、王子、カリンさん。\nそれでは、急いで道を戻りましょうか。\n一刻も早く、皆さんの病を治してあげましょう。"}]}], "active": true}