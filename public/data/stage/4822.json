{"quest_id": 4822, "name": "鬼刃姫の決意", "description": "鬼刃衆が殺された地で、\n豪風の四天王が怪しい動きを\nしているようだが……。\n神級（★１獲得の目安：平均Lv50）", "event": "討妖の狙撃手", "event_category": "History", "mission_id": 920082, "map_no": 3940, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 2, "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 160, "attack_speed": 40, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108848, "race_id": 4, "special_effect_id": 54, "change_to": 1, "change_condition": 2, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 30107, "global_id": 3726, "ranged": true, "to_condition": 2, "to_global_id": 3727, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 1100, "base_hp": 10000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 160, "attack_speed": 40, "attack_wait": 5, "attack_interval": 51, "move_speed": 650.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108832, "race_id": 4, "special_effect_id": 54, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 30108, "global_id": 3727, "ranged": true, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 24, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 9500, "attack": 1500, "base_hp": 9500, "base_attack": 1500, "damage_type": "physical", "armor_defense": 100, "attack_range": 80, "attack_speed": 60, "attack_wait": 45, "attack_interval": 195, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108688, "race_id": 4, "special_effect_id": 232, "missile_id": 11, "master_id": 30063, "global_id": 3682, "ranged": true, "spawn_sec": 25}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 31}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "tags": ["忍者"], "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 160, "attack_speed": 37, "attack_wait": 5, "attack_interval": 47, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098816, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 123, "global_id": 122, "ranged": true, "spawn_sec": 40}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "tags": ["忍者"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098896, "race_id": 16, "master_id": 436, "global_id": 435, "spawn_sec": 53}, {"enemy_id": 8, "source": "local", "count": 5, "form_count": 1, "hp": 1000, "attack": 3000, "base_hp": 1000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_range": 10, "attack_speed": 65, "attack_wait": 80, "attack_interval": 197, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098864, "race_id": 16, "special_effect_id": 229, "missile_id": 56, "missile": {"speed": 1.0, "splash": 80}, "master_id": 127, "global_id": 126, "ranged": true, "spawn_sec": 90}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 4000, "attack": 750, "base_hp": 4000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098832, "race_id": 16, "master_id": 124, "global_id": 123, "spawn_sec": 134}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 164}], "dialogue": [{"trigger": "start", "lines": [{"name": "豪風の四天王", "text": "しかし、やっかいだな。\nまさか、天狗と人間、それもあの王子が手を組むとは。", "face": "l13e2c73ee0a0"}, {"name": "豪風の四天王", "text": "いくら酒呑童子様といえど、\n奴らを確実に塵に出来ると言えるであろうか……？", "face": "l13e2c73ee0a0"}, {"name": "豪風の四天王", "text": "（いざとなれば彼奴らを使う事も考えねばな……。\n酒呑童子様の血肉を与えたとはいえ、\n未だ彼奴らの肉体の再生は完全ではないがな……）", "face": "l13e2c73ee0a0"}, {"name": "カゲロウ", "text": "王子、鬼刃姫、こっちだ。\n見てくれ。以前、鬼刃衆が捕らえられていた場所を\n未だに酒呑童子の配下が見張っている……。", "face": "u139"}, {"name": "鬼刃姫", "text": "確かにそうみたいね……。豪風の四天王も\n定期的に出入りしているという事だけど、\n彼処にはまだ何かが隠されているの……？", "face": "u435"}, {"name": "カゲロウ", "text": "（――！　皆静かに。\n豪風の四天王が出てきたぞ……）", "face": "u139"}, {"name": "豪風の四天王", "text": "ぬぅ……。彼奴ら、まだ自我が残っておったか……。\nもう少し時間がかかる様だな。\n致し方ない。今日は帰るとしよう。", "face": "l13e2c73ee0a0"}, {"name": "ユリアン", "text": "（――おい！　豪風の四天王が帰っていくぞ……！\nどうする？　とっ捕まえた方が良いんじゃないか！？）", "face": "u7"}, {"name": "鬼刃姫", "text": "……好機であることは間違いないわ。\n行きましょう！", "face": "u435"}, {"name": "豪風の四天王", "text": "――むっ！？　なぜこの様な場所に人間たちが！？\nそれに茨木童子様まで……！　", "face": "l13e2c73ee0a0"}, {"name": "豪風の四天王", "text": "くっ、多勢に無勢か……。\nぬぅううう……。今、王子と戦えば敗北は必至……。\nこの場は、去るしかあるまい……！", "face": "l13e2c73ee0a0"}, {"name": "ユリアン", "text": "おいおい！\n豪風の四天王が逃げていくぞ！\n臆病風に吹かれたって訳か？", "face": "u7"}, {"name": "鬼刃姫", "text": "逃がすものか、豪風の四天王――\nって……あ、あれは……！？", "face": "u435"}]}, {"trigger": "start", "lines": [{"name": "鬼刃衆", "text": "シ、酒呑童子様……ノ……血肉ヲ得……\n我ラ……修羅……畜生……ラセツ、ガ道ヲ、駆ケル……\n一陣ノ……風ト、ナラン……イザ……参ル……。", "face": "l865f0e8583a6"}, {"name": "鬼刃姫", "text": "――鬼刃衆！？\nよかった……みんな生きてたのね！\nもう、あてがどれだけ心配したと思って――。", "face": "u435"}, {"name": "カゲロウ", "text": "――危ないッ！", "face": "u139"}, {"name": "鬼刃姫", "text": "そんな……！\n鬼刃衆があてに刃を向けるなんて……！？", "face": "u435"}, {"name": "鬼刃衆", "text": "…………キバヒメ……酒呑童子様ヲ阻ム者……。\n其ノ悉ク……我ラガ……\n酒呑童子様ノ力……ニテ……滅ス……覚悟、セヨ……。", "face": "l865f0e8583a6"}, {"name": "鬼刃姫", "text": "酒呑童子……！？　\n一体何を言っているの……？", "face": "u435"}, {"name": "カゲロウ", "text": "鬼刃姫、近づくんじゃない！　\n何か様子がおかしい。\n彼らは明らかに敵意を持っている。", "face": "u139"}, {"name": "ケイティ", "text": "操られているのかもしれませんね……。\n今は、無力化することに専念しましょう。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "鬼刃衆", "text": "――ハァ……ハァ……キバヒメ……サ、マ……。\n我ラハ……オニ……トナッテシマ……ッタ。\n……チ……チカヅカナイデ……クダサイ……。", "face": "l865f0e8583a6"}, {"name": "鬼刃姫", "text": "待って！　みんな、待ってよ！\nあてを置いていかないで……！", "face": "u435"}, {"name": "カゲロウ", "text": "――止せ！\n無闇な追伐にて命を散らす気か！？", "face": "u139"}, {"name": "鬼刃姫", "text": "だって……みんなが……\n鬼刃衆が生きてたんだ……！", "face": "u435"}, {"name": "ケイティ", "text": "鬼刃姫さん、冷静になってください！\nあの状態では、今は放っておくしかありません。", "face": "u114"}, {"name": "ケイティ", "text": "それに、酒呑童子の血肉を得た……と、言っていました。\n同族となったのであれば、酒呑童子の一派も\nそう簡単に殺す事はしないはず。", "face": "u114"}, {"name": "鬼刃姫", "text": "…………。\nごめん、取り乱して……。", "face": "u435"}, {"name": "鬼刃姫", "text": "そうだね……。\n今は生きていると分かっただけで良いよ……。", "face": "u435"}, {"name": "鬼刃姫", "text": "いずれ、絶対に鬼刃衆を助け出す……。\nそして――。", "face": "u435"}, {"name": "鬼刃姫", "text": "――父上を殺す。", "face": "u435"}, {"name": "アンナ", "text": "……全てを一人で抱え込まないで下さい。\n今は私たちも、鬼刃姫さんの味方なのですから。", "face": "lb5bc984c364c"}, {"name": "鬼刃姫", "text": "ありがとう……。\n王子の力を借りてばかりだね……。\nでも、今は素直に嬉しい……。", "face": "u435"}, {"name": "アンナ", "text": "いつでも頼ってください！\nそれでは、王子帰還しましょう。"}]}], "active": true}