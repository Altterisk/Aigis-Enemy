{"quest_id": 7032, "name": "開拓村の罠", "description": "レティシアと共にガオレオンの開拓村まで\n辿り着いた王子たちであったが……？\n＜男性ユニット出撃不可＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["男性ユニット出撃不可"], "event": "流浪の傭兵と進化せし女王蟻", "event_category": "History", "mission_id": 920143, "map_no": 5745, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [3], "expression": "((IsGender(0) == 0) && (IsToken()) || IsGender(1) || IsPlayerSupportUnit();", "expression_human": "((it is not male) and (it is a token) or it is female or it is a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 2, "hp": 75000, "attack": 1800, "base_hp": 75000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 300, "attack_speed": 20, "attack_wait": 75, "attack_interval": 241, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118528, "race_id": 12, "special_effect_id": 64, "change_to": 1, "change_condition": 3, "master_id": 32488, "global_id": 6107, "to_condition": 3, "to_global_id": 6108, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 75000, "attack": 1400, "base_hp": 75000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 300, "attack_range": 200, "attack_speed": 20, "attack_wait": 50, "attack_interval": 137, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118544, "race_id": 12, "special_effect_id": 508, "missile_id": 357, "missile": {"speed": 10.0}, "master_id": 32489, "global_id": 6108, "ranged": true, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 7, "form_count": 1, "hp": 7200, "attack": 750, "base_hp": 7200, "base_attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 48, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112016, "race_id": 12, "special_effect_id": 64, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 32486, "global_id": 6105, "ranged": true, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 34, "form_count": 1, "hp": 2400, "attack": 360, "base_hp": 2400, "base_attack": 360, "damage_type": "magical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 190, "attack_interval": 442, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115088, "race_id": 11, "special_effect_id": 64, "master_id": 32485, "global_id": 6104, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 36000, "attack": 1300, "base_hp": 36000, "base_attack": 1300, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103568, "race_id": 12, "special_effect_id": 64, "master_id": 32487, "global_id": 6106, "spawn_sec": 84}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 1800, "attack": 600, "base_hp": 1800, "base_attack": 600, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "special_effect_id": 64, "master_id": 32490, "global_id": 6109, "spawn_sec": 130}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 3600, "attack": 600, "base_hp": 3600, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "special_effect_id": 64, "master_id": 32493, "global_id": 6112, "spawn_sec": 132}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 2200, "attack": 400, "base_hp": 2200, "base_attack": 400, "damage_type": "magical", "armor_defense": 20, "attack_range": 150, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "special_effect_id": 64, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 32491, "global_id": 6110, "ranged": true, "spawn_sec": 133}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 2400, "attack": 450, "base_hp": 2400, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "special_effect_id": 64, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 32492, "global_id": 6111, "ranged": true, "spawn_sec": 135}], "popups": ["熊型の獣人は\nHPが50％以下になると\n攻撃速度が上昇し、\n遠距離攻撃を行うようになります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レティシア", "text": "――開拓村に到着しましたが、随分と静かですね。", "face": "u1001a1"}, {"name": "サオシュ", "text": "ガオレオン様の遠吠えが聞こえない開拓村とか、\nこの上なく不気味です。\n完全に操られてしまったのでしょうか……。", "face": "u968"}, {"name": "レティシア", "text": "事あるごとに叫びますからね、あの男は。\nともあれここまで来たら、\nあとは女王アリを討伐するのみです。早く村の中に――", "face": "u1001a1"}, {"name": "冒険者", "text": "――よぉ、レティシア。\n戻ってきたのか。", "face": "l33405872b8d9"}, {"name": "レティシア", "text": "あなたは……！\n良かった、女王アリの\nフェロモンから逃れていたんですね！", "face": "u1001a1"}, {"name": "ポーラ", "text": "…………？\n待つですレティシア。誰もいない村で、\n一人でふらふらしてるなんておかしいです。", "face": "u253"}, {"name": "冒険者", "text": "くくくっ……何だ、鋭いじゃないか。\nだがもう手遅れだ！　わざわざ女王アリ様の\n愛の巣の最深部まで招いてやったんだからな！", "face": "l33405872b8d9"}, {"name": "レティシア", "text": "いったいどういう――お、王子殿っ！？\nどうしたのですか！？", "face": "u1001a1"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "ジェイク", "text": "そ、そうか……俺達が近付くのを待ってから、\nフェロモンを解放しやがったな……！？", "face": "u367"}, {"name": "オスカー", "text": "……くっ、か、身体が熱い。\nジェイク、王子、意識を強く持ってください……！", "face": "u366"}, {"name": "ニコル", "text": "そんな、対抗ポーションが効いてないなんて！？\n女王アリはさらに進化したってこと！？", "face": "u994"}, {"name": "レティシア", "text": "……なるほど、虫らしい姑息な考えです。\nですが、女王の首を落とせば済む話でしょう。", "face": "u1001a1"}, {"name": "冒険者", "text": "くくっ、そう簡単に行くかな……？\n我ら、女王アリ様のために！！", "face": "l33405872b8d9"}, {"name": "アンナ", "text": "このフェロモンの中では男性は戦えません……。\nレティシアさん、手分けをして対処しましょう。", "face": "lc54186a1690f"}, {"name": "レティシア", "text": "もとよりそのつもりです。\nここは任せました。私はあちら側を！\n王子殿、しばしの辛抱ですよ！", "face": "u1001a1"}]}, {"trigger": "end", "lines": [{"name": "冒険者", "text": "じょ、女王アリ……さまぁ……ッ！！", "face": "l33405872b8d9"}, {"name": "ポーラ", "text": "レティシア！　対抗ポーションを飲ませるです！", "face": "u253"}, {"name": "レティシア", "text": "えぇ。さぁこれを飲みなさい。\n戦うことは出来ないでしょうが、\nこれで操られることはなくなるはずです。", "face": "u1001a1"}, {"name": "冒険者", "text": "むぐっ！？　ごく……ごく……。\nうっ……お、俺はいったい何を……。", "face": "l33405872b8d9"}, {"name": "サオシュ", "text": "これで開拓村の皆は救出できましたが……。\n女王アリとガオレオン様はどこにいるのでしょうか。", "face": "u968"}, {"name": "レティシア", "text": "…………もしかして。\n村の内部へ私たちを招き入れるのも、\n女王アリの戦術だと彼が言っていましたよね。", "face": "u1001a1"}, {"name": "レティシア", "text": "こちらには負傷者と、\nフェロモンによって動けない殿方たち。\nもしや女王アリは、この状況を狙って……？", "face": "u1001a1"}, {"name": "魔界アリの女王", "text": "――くふふ、いまさら気付いても遅いわ。\n同族の命を何よりも重んずる王国のあり方では、\n動けぬ者達を置いて逃げることもできまい。", "face": "lc4ff8a15531b"}, {"name": "魔界アリの女王", "text": "王子よ、王国の歴史もここで終わりよ。\n歓喜に打ち震えながら、妾の下僕となるがよい！", "face": "lc4ff8a15531b"}]}], "active": true}