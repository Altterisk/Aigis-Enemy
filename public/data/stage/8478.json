ttack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_global_id": 624, "spawn_sec": 65}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 1, "master_id": 625, "global_id": 624}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 6000, "attack": 900, "base_hp": 6000, "base_attack": 900, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112544, "race_id": 18, "master_id": 30694, "global_id": 4313, "spawn_sec": 70}, {"enemy_id": 6, "source": "local", "count": 7, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 4, "master_id": 626, "global_id": 625, "to_global_id": 484, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 111}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 5, "master_id": 485, "global_id": 484}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "tags": ["ステルス"], "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "physical", "armor_defense": 550, "magic_defense": 10, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099568, "master_id": 11, "spawn_sec": 116}], "dialogue": [{"trigger": "start", "lines": [{"name": "エレイン", "text": "――魔界アリが砂糖を狙ってる？", "face": "u2365a1"}, {"name": "アデライド", "text": "あぁ、砂糖の輸送ルート上に魔界アリの群れが確認された。\nつまりそういうことだ。", "face": "u2362a1"}, {"name": "ノストラ", "text": "魔界アリといえど、\n砂糖に群がろうとするところは普通にアリなのね。", "face": "u2364a1"}, {"name": "エレイン", "text": "それで砂糖を守るために、\n魔界アリの掃討に来たってわけね。", "face": "u2365a1"}, {"name": "マツリ", "text": "もし砂糖がすべて食べられてしまえば、\nチョコ作りもままなりません。\nそれに輸送を担う商人たちも危険です。", "face": "u2363a1"}, {"name": "ミア", "text": "商人さんたちの安全のためにも、\nそしてカカオ豆さんを美味しいチョコにするためにも、\n頑張りましょう！", "face": "u2361a1"}, {"name": "ノストラ", "text": "私に言ってくれれば、\nもっと安全な輸送ルートを提案できたのに。", "face": "u2364a1"}, {"name": "アデライド", "text": "違法ルートの気配しかしないのだが。", "face": "u2362a1"}, {"name": "ノストラ", "text": "罪に問われないようにやる、とだけ言っておくわ。", "face": "u2364a1"}, {"name": "エレイン", "text": "それはともかく、魔界アリはどこにいるわけ？\n早く倒してあげないと――", "face": "u2365a1"}, {"name": "村人", "text": "――あ、アリだー！！", "face": "lbb0c716bc35a"}, {"name": "ノストラ", "text": "……あっちで現れたみたいね。\nさて、アリ退治をはじめましょうか。", "face": "u2364a1"}]}, {"trigger": "end", "lines": [{"name": "エレイン", "text": "よし！　これで全部片付いたわね！", "face": "u2365a1"}, {"name": "アデライド", "text": "商人も砂糖も無事みたいだな。\n魔界アリももういないし、\n輸送ルートの安全は確保できたと考えていいだろう。", "face": "u2362a1"}, {"name": "ミア", "text": "砂糖がなくてチョコが作れないなんて、\n悲しい事態になるところでしたね。", "face": "u2361a1"}, {"name": "カカオ豆の魔物", "text": "おお……砂糖がいっぱい……。", "face": "le1ad1420c9f0"}, {"name": "ノストラ", "text": "勝手に食べたら駄目よ？\nいや、貴方の場合は取り込むことになるのかしら。", "face": "u2364a1"}, {"name": "カカオ豆の魔物", "text": "勝手に食べたり取り込んだりしないよ！\n砂糖がなくなったらみんな悲しむんだから！", "face": "le1ad1420c9f0"}, {"name": "カカオ豆の魔物", "text": "ていうかこんな大量の砂糖と混ざっちゃったら、\n甘すぎて美味しく食べてもらえないよ。", "face": "le1ad1420c9f0"}, {"name": "マツリ", "text": "過ぎたるは、なお及ばざるが如しと言いますしね。\nそれはチョコ作りでも同じことでしょう。", "face": "u2363a1"}, {"name": "ノストラ", "text": "ともかく、\nそろそろ王城に戻りましょうか。", "face": "u2364a1"}, {"name": "ミア", "text": "はい。戻ってチョコレートを完成させましょう！", "face": "u2361a1"}]}], "active": true}