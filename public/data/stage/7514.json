base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 36, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126960, "race_id": 16, "change_to": 8, "change_condition": 1, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 33370, "global_id": 6987, "ranged": true, "variants": [{"tags": ["忍者"], "hp": 16000, "attack": 800, "base_hp": 16000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 36, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127008, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 33371, "global_id": 6988, "ranged": true}], "spawn_sec": 97}, {"enemy_id": 10, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "tags": ["忍者"], "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 160, "attack_speed": 37, "attack_wait": 5, "attack_interval": 47, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098816, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 123, "global_id": 122, "ranged": true, "spawn_sec": 99}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["女性"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 350, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2126720, "race_id": 16, "special_effect_id": 665, "master_id": 33071, "global_id": 6688, "spawn_sec": 103}, {"enemy_id": 12, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "tags": ["忍者"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_interval": 76, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099968, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 208, "global_id": 207, "ranged": true, "spawn_sec": 163}], "popups": ["フジムラサキがいる間は、\n全ての敵ユニットの\n防御がアップします。\n\nまた物理攻撃による\nダメージを受けると\n攻撃したユニットへ反撃を行います。", "シズカは\nブロックされている間、\nHPが徐々に回復します。", "ヨシノがいる間は、\n忍者、サムライ、妖怪系の敵の\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "チヨメ", "text": "お仕事を休んで入る温泉は最高ですねぇ……。", "face": "u1416a1"}, {"name": "ヨシノ", "text": "まさかコウメちゃんの実家に、\nこんな秘湯が隠されてたなんてね。\nいやぁ、持つべきものは優秀な民草。", "face": "u1104a1"}, {"name": "コウメ", "text": "ははぁ、ありがたき幸せ。\nそれでお姫様、お代の方は──", "face": "u1312a1"}, {"name": "ヨシノ", "text": "よーし、ヨシノお姉さん。\nこの村の年貢免除しちゃうぞー。", "face": "u1104a1"}, {"name": "コウメ", "text": "ひゅー！　うちのお姫様は最高だぜぇ！\nコマちゃん！　今日のご飯は大盛ですよ！", "face": "u1312a1"}, {"name": "コマ", "text": "きゃー♪", "face": "u1119a1"}, {"name": "シズカ", "text": "通るわけないでしょ！　そんなこと！\nよくも私に仕事を押し付けてくれたわね！", "face": "u101"}, {"name": "ヨシノ", "text": "げっ、シズカじゃん、やっば。\nなんでこんなところにいるのさ。\n行き先誰にも知らせてないのに。", "face": "u1104a1"}, {"name": "フジムラサキ", "text": "私が教えたの、残念だったわねお姫様。", "face": "u1292a1"}, {"name": "シズカ", "text": "そういうこと、観念しなさい。\nさあ帰るわよヨシノ、チヨメもね。", "face": "u101"}, {"name": "チヨメ", "text": "むぅ、見つかったからには仕方ありません。\nですが、コマちゃんがそれを許すでしょうか？", "face": "u1416a1"}, {"name": "コマ", "text": "わふ！？", "face": "u1119a1"}, {"name": "ヨシノ", "text": "まさかコマちゃんの縄張りを荒らしておいて、\nただで帰れるなんて思っちゃってるのかなー？", "face": "u1104a1"}, {"name": "コマ", "text": "わふわふ！？！？", "face": "u1119a1"}, {"name": "コウメ", "text": "さあコマちゃん、やっちゃってください！\nいつもの狛犬パンチでノックダウンですよ！", "face": "u1312a1"}, {"name": "コマ", "text": "え、えっと……コマは、コマはぁ……。", "face": "u1119a1"}, {"name": "シズカ", "text": "コマちゃんが困ってるでしょうが！！", "face": "u101"}, {"name": "シズカ", "text": "……もう怒ったわ、\n何としても連れ帰ります。\n覚悟しなさい、国主代理！", "face": "u101"}]}, {"trigger": "end", "lines": [{"name": "旅館の主人", "text": "当館での行き過ぎた乱暴狼藉。\nいくら領主さまとて許せませぬ。\n恐れながら出禁とさせていただきます。", "face": "l1f0f87cbdc01"}, {"name": "ヨシノ", "text": "……追い出されちゃった、シズカのせいで。", "face": "u1104a1"}, {"name": "シズカ", "text": "ヨシノのせいでしょ！", "face": "u101"}, {"name": "ヨシノ", "text": "そもそもフジムラサキは私の刀じゃん。\nなんで普通に裏切ってシズカの方にいたの。", "face": "u1104a1"}, {"name": "フジムラサキ", "text": "お姫さまが私を置いて行くからよ、\n私も温泉に入ってみたかったのに。", "face": "u1292a1"}, {"name": "ヨシノ", "text": "だって錆びるじゃん。", "face": "u1104a1"}, {"name": "フジムラサキ", "text": "錆びないわ、私の方が強いし。", "face": "u1292a1"}, {"name": "シズカ", "text": "何と戦ってるのよ……。", "face": "u101"}, {"name": "ヨシノ", "text": "んー、まあ温泉は入ったし。\nそろそろ帰って仕事するかー。", "face": "u1104a1"}]}, {"trigger": "end", "lines": [{"name": "コウメ", "text": "チヨメさんは帰らないんですか？", "face": "u1312a1"}, {"name": "チヨメ", "text": "チヨメさんはお姫さんと違って、\nちゃんと休暇を申請してるのでー。", "face": "u1416a1"}, {"name": "チヨメ", "text": "あのお二方が側にいる以上は、\n代わりの護衛も必要ないでしょう！\n私はゆっくり温泉を楽しませてもらいますねー♪", "face": "u1416a1"}, {"name": "チヨメ", "text": "コマちゃーん、お水おかわりー！", "face": "u1416a1"}, {"name": "コマ", "text": "はーい！", "face": "u1119a1"}, {"name": "コウメ", "text": "本当に水なんでしょうか……？", "face": "u1312a1"}, {"name": "チヨメ", "text": "ふんふふふ～ん♪　良いお湯ですねぇ♪", "face": "u1416a1"}]}], "map": {"image": "Map920171_4058", "w": 960, "h": 640, "spots": [{"k": "b", "x": 931, "y": 483}, {"k": "m", "x": 754, "y": 424, "id": 200}, {"k": "m", "x": 660, "y": 397, "id": 201}, {"k": "m", "x": 712, "y": 321, "id": 202}, {"k": "m", "x": 751, "y": 261, "id": 203}, {"k": "m", "x": 791, "y": 193, "id": 204}, {"k": "m", "x": 835, "y": 450, "id": 205}, {"k": "m", "x": 646, "y": 152, "id": 206}, {"k": "m", "x": 571, "y": 126, "id": 207}, {"k": "m", "x": 567, "y": 264, "id": 208}, {"k": "m", "x": 524, "y": 178, "id": 209}, {