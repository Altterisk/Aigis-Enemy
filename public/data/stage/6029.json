ot_rate": 1.899999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 20033, "global_id": 1108, "spawn_sec": 67}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 30, "attack_interval": 212, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 2.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 20029, "global_id": 1104, "spawn_sec": 72}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 4500, "attack": 650, "base_hp": 4500, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 40, "attack_interval": 232, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 2.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 20030, "global_id": 1105, "spawn_sec": 75}, {"enemy_id": 11, "source": "local", "count": 10, "form_count": 1, "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 40, "attack_interval": 191, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 20035, "global_id": 1110, "spawn_sec": 81}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "magical", "armor_defense": 20, "attack_range": 160, "attack_speed": 70, "attack_wait": 90, "attack_interval": 217, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 20036, "global_id": 1111, "ranged": true, "spawn_sec": 96}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "magical", "armor_defense": 20, "attack_range": 150, "attack_speed": 70, "attack_wait": 90, "attack_interval": 226, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 20038, "global_id": 1113, "ranged": true, "spawn_sec": 125}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 40000, "attack": 2500, "base_hp": 40000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 90, "attack_wait": 40, "attack_interval": 201, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 2.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104016, "master_id": 20039, "global_id": 1114, "spawn_sec": 126}], "dialogue": [{"trigger": "start", "lines": [{"name": "カグラ", "text": "神器の反応はこちらから発せられているようです。\n……すみません、盗まれた神器を取り返すのに\n協力させてしまって。", "face": "u143"}, {"name": "カグラ", "text": "あれは念じるだけで、生き物の大きさを\n変えることができる強力なもの。ですが、\n大きくなる代わりに自我を失ってしまう……。", "face": "u143"}, {"name": "カグラ", "text": "欠陥品……いわば呪われた神器なのです。", "face": "u143"}, {"name": "アンナ", "text": "そのような危険な神器、放置する訳には参りません。\n協力する事は惜しみないですよ。", "face": "l9d6a0fdd4bae"}, {"name": "暗黒騎士", "text": "――ふふふ、これは強力な\n道具を手に入れたぞ……。これさえあれば、\n我が軍の力をもっと強大にする事ができる……！", "face": "u210"}, {"name": "カグラ", "text": "……あ！　あそこにいるのは！\n盗んだのはあの男です！", "face": "u143"}, {"name": "カグラ", "text": "返しなさい！　それは呪われた神器。\n周りだけじゃない、あなた自身も不幸に\nするものです！", "face": "u143"}, {"name": "暗黒騎士", "text": "知った事か！　さぁ、神器よ！　\n私に力を貸すのだ！ふぅううんっっ！！", "face": "u210"}, {"name": "暗黒騎士", "text": "ふふふ、巨大になったぞ……！\nさぁ、お前達を踏みつぶ………む？", "face": "u210"}, {"name": "暗黒騎士", "text": "なんだ……！？　\nなぜこんなに身体が重いのだ！\nこれでは戦いにくいではないか！", "face": "u210"}, {"name": "カグラ", "text": "愚かな……。", "face": "u143"}, {"name": "暗黒騎士", "text": "おのれ……！　しかし力自体は上がっているはず！\n戦いはパワーだ！　それを証明してやる！", "face": "u210"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士", "text": "グ……はっ………お、おのれぇ！　覚えておれよ！", "face": "u210"}, {"name": "カグラ", "text": "王子、神器を取り戻すことに協力頂いたこと、\n真に感謝いたします。", "face": "u143"}, {"name": "カグラ", "text": "自我を失ってしまう程強力な力があるとはいえ、わが一族の\n神器、壊してしまう訳には参りません。それにきっといつか\n人々の為に使う事もできると思っております。", "face": "u143"}, {"name": "カグラ", "text": "再び悪用されることが無きよう、\n一層厳重に保管しておきますので。\n王子、此度は本当にありがとうございました。", "face": "u143"}, {"name": "レーヴ", "text": "…………どのような力であっても、\nそれを振るう者次第で善にも悪にもなる……。\n今回の記憶で、それを強く感じました。", "face": "u454"}, {"name": "レーヴ", "text": "もしかしたら、カグラさんの一族が守り続けた神器も、\nかつては呪われた神器などではなく、\n善の為に使われたものかもしれません……。", "face": "u454"}, {"name": "レーヴ", "text": "……そうですね、王子。いつの日か、良き未来の為\nあの神器が使われることを願ってやみません。", "face": "u454"}, {"name": "レーヴ", "text": "それでは、次の記憶へと参りましょう。\nさあ、王子。お手をどうぞ。", "face": "u454"}]}], "active": true}