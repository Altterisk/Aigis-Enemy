{"quest_id": 20022, "name": "天眼ノ国の暗部", "description": "天眼ノ国の都の移動する王子一行に、\n貴族院直属の刺客が襲い来る……。\nニハラと協力して敵の集団を撃退せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "メイド・イン・プロミス", "event_category": "Emergency", "mission_id": 200581, "map_no": 7488, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 1, "tags": ["三つ目の種族"], "hp": 4000, "attack": 440, "base_hp": 4000, "base_attack": 440, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "attack_speed": 1, "attack_wait": 50, "attack_interval": 152, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2169728, "master_id": 40472, "global_id": 14089, "spawn_sec": 52}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "tags": ["三つ目の種族", "置物"], "fixture": true, "hp": 8000, "attack": 100, "base_hp": 8000, "base_attack": 100, "damage_type": "magical", "armor_defense": 20, "magic_defense": 20, "attack_range": 200, "attack_speed": 70, "attack_wait": 75, "attack_interval": 231, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2169840, "special_effect_id": 2404, "missile_id": 1583, "missile": {"on_hit": {"kind": "攻撃遅延", "duration_f": 240, "attack_interval_f": 120, "effect_name": "HitEffectSlow"}}, "master_id": 40489, "global_id": 14106, "ranged": true, "spawn_sec": 109}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 1, "tags": ["三つ目の種族"], "hp": 5000, "attack": 420, "base_hp": 5000, "base_attack": 420, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "attack_range": 200, "attack_speed": 90, "attack_wait": 55, "attack_interval": 145, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2172624, "race_id": 16, "special_effect_id": 2508, "missile_id": 1233, "missile": {"speed": 5.0}, "master_id": 41074, "ranged": true, "spawn_sec": 110}, {"enemy_id": 4, "source": "local", "count": 7, "form_count": 1, "tags": ["三つ目の種族"], "hp": 9000, "attack": 660, "base_hp": 9000, "base_attack": 660, "damage_type": "physical", "armor_defense": 120, "magic_defense": 5, "attack_range": 200, "attack_speed": 1, "attack_wait": 45, "attack_interval": 141, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2170320, "change_to": 4, "change_condition": 1, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 40547, "global_id": 14164, "ranged": true, "variants": [{"tags": ["三つ目の種族"], "hp": 9000, "attack": 660, "base_hp": 9000, "base_attack": 660, "damage_type": "physical", "armor_defense": 120, "magic_defense": 5, "attack_speed": 1, "attack_wait": 22, "attack_interval": 96, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2170320, "master_id": 40548, "global_id": 14165}], "spawn_sec": 125}, {"enemy_id": 6, "source": "local", "count": 8, "form_count": 1, "tags": ["三つ目の種族"], "hp": 3400, "attack": 350, "base_hp": 3400, "base_attack": 350, "damage_type": "magical", "armor_defense": 100, "magic_defense": 20, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 161, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2172672, "missile_id": 1583, "missile": {"on_hit": {"kind": "攻撃遅延", "duration_f": 240, "attack_interval_f": 120, "effect_name": "HitEffectSlow"}}, "master_id": 41077, "ranged": true, "spawn_sec": 155}], "popups": ["\n\n\n\n　　――都の外縁、荒野への道"], "dialogue": [{"trigger": "start", "lines": [{"text": "――都の外縁、荒野への道"}, {"name": "刺客", "text": "…………。", "face": "l2c9accf87125"}, {"name": "刺客", "text": "――追え。\n反逆者の娘ごと、ここで始末する。", "face": "l2c9accf87125"}, {"name": "ロイジィ", "text": "ふぇぇ……なんで僕まで走ってるのぉ……。\n遺物調査のはずだったのにぃ……。", "face": "u2522a1"}, {"name": "アルレット", "text": "捕まりたいなら寝ててもいいよ！", "face": "u1453a1"}, {"name": "ロイジィ", "text": "それもいーやーぁぁぁ。", "face": "u2522a1"}, {"name": "ニハラ", "text": "殿下。後方に気配が。\n数は……十、いえ、もっと。", "face": "u2888a1"}, {"name": "プリヤンカ", "text": "ニハラちゃん、すごい。\nあたし、全然分かんなかったよ。", "face": "u2808a1"}, {"name": "ニハラ", "text": "閣下のお側で、長く戦ってきましたから。\nあの人、周囲に煙たがられて\nよく暗殺者を送り込まれていますので。", "face": "u2888a1"}, {"name": "プリヤンカ", "text": "うわぁ……。\nあっ、そうだ。ニハラちゃんって、\n天眼の民じゃなくて、あたしと同じ人間だよね？", "face": "u2808a1"}, {"name": "ニハラ", "text": "はい。私は人間です。\n閣下が戦場で拾い、育ててくださいました。", "face": "u2888a1"}, {"name": "プリヤンカ", "text": "そっか。じゃあ、あたしと同じだ。\n同じなら、もっと気楽に話そうよ！", "face": "u2808a1"}, {"name": "ニハラ", "text": "お気持ちだけ、いただきます。\n私は閣下の従者です。\nそれ以上でも、以下でもありません。", "face": "u2888a1"}, {"name": "アナーニャ", "text": "ふふ。あの男の愛娘は、真面目で結構なことです。", "face": "u2873a1"}, {"name": "ニハラ", "text": "アナーニャ様。私はただの従者です。", "face": "u2888a1"}, {"name": "アナーニャ", "text": "はいはい。――殿下、来ましたよ。\n魔眼と、影から刃。暗部のお出ましです。", "face": "u2873a1"}, {"name": "ニハラ", "text": "私が前に出ます。\n閣下の命ですから。――殿下、ご指示はおまかせします。", "face": "u2888a1"}]}, {"trigger": "end", "lines": [{"name": "ロイジィ", "text": "はぁ、はぁ……。\nねぇ、みんな。いま、変な魔力を感じなかった？", "face": "u2522a1"}, {"name": "ニハラ", "text": "変な魔力、とは？", "face": "u2888a1"}, {"name": "ロイジィ", "text": "ほら、えーっと、\nゼウスとか、ヴィマーナと同じ匂い。", "face": "u2522a1"}, {"name": "アルレット", "text": "んっ……うわっ、計器が振り切れてる！\n一個一個は小さいけど、すごい数の――\nなんかこう、ちっちゃいヴィマーナがいるみたいな……。", "face": "u1453a1"}, {"name": "ユリクセス", "text": "おい、冗談で済む話じゃないぞ。\n小さい古代兵器が山盛りだって？", "face": "u2193a1"}, {"name": "アナーニャ", "text": "……冗談ではありませんよ。\n貴族院は、砕けたヴィマーナの残骸を回収していました。", "face": "u2873a1"}, {"name": "アナーニャ", "text": "おそらくは、神の亡骸を、\n小さな神に作り替えるために。", "face": "u2873a1"}, {"name": "アイシャ", "text": "量産型の神像兵器……？\nそれを、講和会議の裏で準備してたんだ。\nだからラージヴィールの根回しを蹴ったんだね。", "face": "u181"}, {"name": "ニハラ", "text": "閣下は、ずっと反対しておられました。\n貴族院が耳を貸さなかっただけで。", "face": "u2888a1"}, {"name": "アナーニャ", "text": "だから私は、王国に投資したのです。\n神より、殿下の方がよほど、\n利回りが良さそうでしたから。", "face": "u2873a1"}, {"name": "ニハラ", "text": "……殿下。\n閣下の命も狙われているかもしれません。\nどうか父を――", "face": "u2888a1"}, {"name": "ニハラ", "text": "いえ……失礼しました。\n閣下なら、ご自分で何とかなさいます。", "face": "u2888a1"}, {"name": "アナーニャ", "text": "心配なら、心配だと言えばいいのに。\n本当に、似た者親子ですね。", "face": "u2873a1"}, {"name": "ニハラ", "text": "親子では、ありません。従者です。", "face": "u2888a1"}, {"name": "アイシャ", "text": "はいはい、その話はあとで。\n王子、魔力反応の方へ向かうよ。", "face": "u181"}]}], "map": {"image": "Map7488", "w": 960, "h": 640, "spots": [{"k": "b", "x": 16, "y": 238}, {"k": "b", "x": 10, "y": 479}, {"k": "m", "x": 233, "y": 270, "id": 200}, {"k": "m", "x": 121, "y": 262, "id": 201}, {"k": "m", "x": 108, "y": 184, "id": 202}, {"k": "m", "x": 112, "y": 483, "id": 203}, {"k": "m", "x": 269, "y": 145, "id": 204}, {"k": "m", "x": 382, "y": 239, "id": 205}, {"k": "m", "x": 454, "y": 163, "id": 206}, {"k": "m", "x": 432, "y": 88, "id": 207}, {"k": "m", "x": 416, "y": 202, "id": 208}, {"k": "m", "x": 327, "y": 143, "id": 209}, {"k": "m", "x": 281, "y": 472, "id": 210}, {"k": "m", "x": 342, "y": 474, "id": 211}, {"k": "m", "x": 524, "y": 479, "id": 212}, {"k": "m", "x": 590, "y": 469, "id": 213}, {"k": "m", "x": 734, "y": 495, "id": 214}, {"k": "m", "x": 839, "y": 484, "id": 215}, {"k": "m", "x": 860, "y": 377, "id": 216}, {"k": "m", "x": 215, "y": 474, "id": 217}, {"k": "m", "x": -239, "y": 932, "id": 218}, {"k": "r", "x": 586, "y": 388, "id": 300}, {"k": "r", "x": 582, "y": 128, "id": 301}, {"k": "r", "x": 795, "y": 335, "id": 302}, {"k": "r", "x": 181, "y": 307, "id": 303}, {"k": "r", "x": 534, "y": 418, "id": 304}, {"k": "r", "x": 225, "y": 199, "id": 305}, {"k": "r", "x": 530, "y": 162, "id": 306}], "events": [{"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "StageTowerPowerUp", "x": 582, "y": 160}]}, {"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_01", "fx": "StageTowerPowerUp2", "x": 582, "y": 130}]}, {"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_02", "fx": "StageTowerPowerUp", "x": 588, "y": 422}]}, {"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_03", "fx": "StageTowerPowerUp2", "x": 588, "y": 391}]}, {"when": "defeat", "ops": [{"op": "-s", "name": "locPlc_280"}], "by": [6]}, {"when": "defeat", "ops": [{"op": "-s", "name": "locPlc_281"}], "by": [6]}, {"when": "route", "ops": [{"op": "+s", "name": "locPlc_230", "id": 230, "k": "m", "x": 653, "y": 376}, {"op": "+fx", "name": "obj_04", "fx": "GuestUnitEntry2", "x": 689, "y": 368}], "by": [1]}, {"when": "route", "ops": [{"op": "-fx", "name": "obj_04"}], "by": [1]}, {"when": "route", "ops": [{"op": "+s", "name": "locPlc_231", "id": 231, "k": "m", "x": 330, "y": 205}, {"op": "+fx", "name": "obj_05", "fx": "GuestUnitEntry2", "x": 305, "y": 193}], "by": [1]}, {"when": "route", "ops": [{"op": "-fx", "name": "obj_05"}], "by": [1]}, {"when": "route", "ops": [{"op": "-fx", "name": "obj_04"}], "by": [10]}, {"when": "route", "ops": [{"op": "-fx", "name": "obj_05"}], "by": [10]}]}}