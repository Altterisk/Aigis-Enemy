l_effect_id": 222, "master_id": 32070, "global_id": 5689, "from_condition": 2}, {"enemy_id": 11, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 57}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "magical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 30, "attack_interval": 69, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2111488, "race_id": 3, "change_to": 12, "change_condition": 2, "master_id": 30589, "global_id": 4208, "to_condition": 2, "to_global_id": 4213, "spawn_sec": 143}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 800, "base_hp": 3000, "base_attack": 800, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 35, "attack_speed": 30, "attack_interval": 69, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111488, "race_id": 3, "special_effect_id": 121, "master_id": 30594, "global_id": 4213, "from_condition": 2}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 32000, "attack": 800, "base_hp": 32000, "base_attack": 800, "damage_type": "magical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 30, "attack_interval": 69, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117600, "race_id": 3, "master_id": 31558, "global_id": 5177, "spawn_sec": 143}, {"enemy_id": 19, "source": "local", "count": 13, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 400, "base_hp": 2000, "base_attack": 400, "damage_type": "magical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 40, "attack_wait": 60, "attack_interval": 199, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105872, "race_id": 3, "change_to": 19, "change_condition": 2, "master_id": 753, "global_id": 752, "spawn_sec": 147}, {"enemy_id": 25, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 5000, "attack": 950, "base_hp": 5000, "base_attack": 950, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "attack_speed": 30, "attack_interval": 69, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2111456, "race_id": 3, "change_to": 25, "change_condition": 2, "master_id": 30577, "global_id": 4196, "to_condition": 2, "to_global_id": 4201, "spawn_sec": 220}, {"enemy_id": 25, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1200, "base_hp": 5000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 350, "magic_defense": 30, "attack_speed": 30, "attack_interval": 69, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111616, "race_id": 3, "special_effect_id": 187, "master_id": 30582, "global_id": 4201, "from_condition": 2}], "popups": ["デモンポーン、エフネ、\nハルモニアは倒されると\nその場で復活します。\n\n2回まで復活し、\n復活するたびに強くなります。", "ラクシャーサ、ラクシャーサの配下、\nバロウスは倒されると\nその場で復活します。\n復活は5回まで行われます。\n\nオーラをまとったラクシャーサは\n倒されると、自身の周囲に\nダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンシェフ", "text": "――なるほど、転職ということか。\nお前は我社にとって掛け替えのない職員だった。\n引き止めたいのが本音だが……。", "face": "l250e6aa32dd0"}, {"name": "デモンポーン", "text": "……うん、ごめんなさい。\nでも、やりたいことが見つかっちゃって。", "face": "u997"}, {"name": "デーモンシェフ", "text": "いや、良い。あの錬金術士のもとへ派遣して以来、\nお前は随分と楽しそうに仕事をしていたからな。", "face": "l250e6aa32dd0"}, {"name": "デーモンシェフ", "text": "だが、我々が世界的大企業となったあかつきには、\n必ずお前をもう一度スカウトしに行くぞ。\nその時はまた、少し考えてくれると嬉しい。", "face": "l250e6aa32dd0"}, {"name": "デモンポーン", "text": "うん！　デーモンシェフも元気でね。\nでもあんまり悪いことしちゃだめだよ？", "face": "u997"}, {"name": "デーモンシェフ", "text": "ハハハッ！　それは約束できないぞ！\n経営者とは社員と利益のためには悪にもなるのだ！", "face": "l250e6aa32dd0"}]}, {"trigger": "start", "lines": [{"name": "エフネ", "text": "――おはなし、終わりましたか？", "face": "u969"}, {"name": "デモンポーン", "text": "うん、ちゃんとお話してきたよ。\n後はよわよわ王子に、あたしの実力を見せるだけ！", "face": "u997"}, {"name": "エフネ", "text": "仲間の歓迎会が模擬戦だなんて、\n王国も変な風習があるものですよね。", "face": "u969"}, {"name": "ハルモニア", "text": "そんな風習が出来たのは、\n王国が私たち元魔王軍との戦いの中で、\n絆を紡いできた国家だからなのでしょう。", "face": "u941"}, {"name": "ラクシャーサ", "text": "ふふっ、あいつも先祖に似たのだろうな。\nさぁ、そろそろ件の王子たちが到着するぞ。", "face": "u306"}, {"name": "エフネ", "text": "ざこざこ王子をびっくりさせちゃいましょう。\nいくらお気に入りだからって、\n手加減とかしちゃだめですよ？", "face": "u969"}, {"name": "デモンポーン", "text": "お、お気に入りじゃないもん！\nでも本当の本当に、\n本気で全力のあたしを見せちゃうんだから！", "face": "u1997"}, {"name": "アンナ", "text": "どちらも準備は良さそうですね。\nそれでは王子、どうか全力で！\n模擬戦――開始です！！"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "そこまで！　模擬戦終了です！"}, {"name": "デモンポーン", "text": "うぅぅぅ、ぼっこぼこにするつもりだったのに～！\n負けちゃったよぉ……。", "face": "u997"}, {"name": "ハルモニア", "text": "さすがは王国の精鋭ですね……。\nけれど、共に戦って改めて思いましたが――", "face": "u941"}, {"name": "エフネ", "text": "――すっごく、強くなりましたよね。\n戦闘だけじゃなくて、心まで！", "face": "u969"}, {"name": "デモンポーン", "text": "えっ、そ、そう？　そうかな？", "face": "u997"}, {"name": "ハルモニア", "text": "えぇ。\n魔王軍にいた時よりも、ずっとずっと強くなりました。\nこれまでは、私が過保護すぎたのかもしれませんね。", "face": "u941"}, {"name": "デモンポーン", "text": "うぅん、お姉ちゃんがいてくれなかったら、\nきっとあたし、好き勝手に人間を襲って、\n今頃王子たちに討伐されちゃってたと思うよ。", "face": "u997"}, {"name": "デモンポーン", "text": "だからね、ありがとう、ハルモニアお姉ちゃん。\nこれからも、よろしくね？", "face": "u997"}, {"name": "ハルモニア", "text": "ふふ、こちらこそ。\n頼りない姉貴分かもしれませんが、\nこれからも一緒に歩んでいきましょう。", "face": "u941"}, {"name": "デモンポーン", "text": "うんっ♪　え、えっと、それから……。\nよわよわ王子にも、ごめんなさい、しなくちゃね。", "face": "u997"}, {"name": "デモンポーン", "text": "よ、よわよわ王子……？\nこれまで、迷惑ばかりかけてごめんなさい。", "face": "u997"}, {"name": "デモンポーン", "text": "前は逃げ出しちゃったけど、\n今度は……、\nあ、あたしも、王子たちについて行っていい……？", "face": "u997"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "デモンポーン", "text": "あ、あり、がと……。\nうぅぅ～！　やだ！　こういうの何だか恥ずかしいよ～！", "face": "u997"}, {"name": "アンナ", "text": "あっ……また逃げていってしまいました……。\n――ともかく、また心強い仲間が増えましたね。\n王子、模擬戦お疲れさまでした！"}]}], "map": {"image": "Map920142_5728", "w": 960, "h": 640, "spots": [{"k": "b", "x": 937, "y": 126}, {"k": "b", "x": 937, "y": 256}, {"k": "b", "x": 936, "y": 450}, {"k": "m", "x": 805, "y": 124, "id": 200}, {"k": "m", "x": 655, "y": 121, "id": 201}, {"k": "m", "x": 539, "y": 121, "id": 202}, {"k": "m", "x": 419, "y": 121, "id": 203}, {"k": "m", "x": 283, "y": 125, "id": 204}, {"k": "m", "x": 171, "y": 115, "id": 205}, {"k": "m", "x": 710, "y": 205, "id": 206}, {"k": "m", "x": 757, "y": 317, "id": 207}, {"k": "m", "x": 503, "y": 439, "id": 208}, {"k": "m", "x": 460, "y": 341, "id": 209}, {"k": "m", "x": 350, "y": 193, "id": 210}, {"k": "m", "x": 408, "y": 268, "id": 211}, {"k": "m", "x": 579, "y": 186, "id": 212}, {"k": "m", "x": 536, "y": 269, "id": 213}, {"k": "m", "x": 605, "y": 427, "id": 214}, {"k": "m", "x": 693, "y": 383, "id": 215}, {"k": "m", "x": 397, "y": 431, "id": 216}, {"k": "m", "x": 267, "y": 420, "id": 217}, {"k": "m", "x": 341, "y": 359, "id": 218}, {"k": "m", "x": 259, "y": 292, "id": 219}, {"k": "m", "x": 193, "y": 225, "id": 220}, {"k": "m", "x": 813, "y": 409, "id": 221}, {"k": "m", "x": 843, "y": 272, "id": 222}, {"k": "r", "x": 362, "y": 302, "id": 300}, {"k": "r", "x": 227, "y": 175, "id": 301}, {"k": "r", "x": 187, "y": 362, "id": 302}, {"k": "r", "x": 636, "y": 208, "id": 303}, {"k": "r", "x": 543, "y": 351, "id": 304}, {"k": "r", "x": 598, "y": 280, "id": 305}, {"k": "r", "x": 741, "y": 418, "id": 306}, {"k": "r", "x": 316, "y": 471, "id": 307}, {"k": "r", "x": 439, "y": 479, "id": 308}, {"k": "r", "x": 776, "y": 179, "id": 309}, {"k": "r", "x": 795, "y": 468, "id": 310}, {"k": "r", "x": 421, "y": 174, "id": 311}, {"k": "r", "x": 190, "y": 279, "id": 312}]}, "start_cost": 10, "active": true, "name_en": "Welcome Back and Best Wishes", "description_en": "The Demon Prawn has returned to Harmonia after gaining\nvarious experiences. Grandly welcome her, who has grown\na size, in a training battle!\nDivine (Benchmark for 1★: Avg Lv50)"}