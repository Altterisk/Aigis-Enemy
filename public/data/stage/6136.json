rm_index": 3, "form_count": 4, "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 100, "attack_interval": 236, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108768, "race_id": 16, "special_effect_id": 248, "change_to": 4, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30075, "global_id": 3694, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "magical", "magic_defense": 30, "attack_speed": 1, "attack_wait": 1, "attack_interval": 29, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108656, "special_effect_id": 120, "master_id": 30068, "global_id": 3687, "spawn_sec": 10}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110352, "race_id": 16, "special_effect_id": 166, "master_id": 30287, "global_id": 3906, "spawn_sec": 12}], "popups": ["メルヴィナは倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "メルヴィナ", "text": "今日は、誘ってくれてありがとう。\nテミスが用意してくれたお茶とパイ、\n凄く美味しかった。", "face": "u326"}, {"name": "シビラ", "text": "ごちそうさま、美味しかったわ。", "face": "u1039"}, {"name": "テミス", "text": "たまたま良いお茶が取れまして。\n是非皆さんで茶会をと思ったのですが、\n喜んで頂けたのでしたら、何よりですわ。", "face": "u38"}, {"name": "メルヴィナ", "text": "あぁ、おかげでつい食べ過ぎてしまった。\nしかし、本当に私なんかが\n参加しても良かったのだろうか……。", "face": "u326"}, {"name": "シビラ", "text": "何言ってるのよ、同じプリンセス同士、\n気兼ねなんてしないでちょうだい。\n……それじゃあ始めましょうか。", "face": "u1039"}, {"name": "メルヴィナ", "text": "待ってくれ、剣を抜いて一体何を……？", "face": "u326"}, {"name": "テミス", "text": "プリンセスたるもの、いついかなる時も\n人に見られて恥ずかしくない身体を心掛けないと。\nお茶会の後は、皆でこうして運動をしてますのよ。", "face": "u38"}, {"name": "シビラ", "text": "その為に王子だって呼んでるんだから。\n王子、今日はよろしくね。", "face": "u1039"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "シビラ", "text": "さあ、あなたも早く準備して。\nこれ、あなたの剣なんでしょ。", "face": "u1039"}, {"name": "メルヴィナ", "text": "ま、待ってくれ、私は剣の力を使う訳には――", "face": "u326"}, {"name": "メルヴィナ", "text": "――ふ、ふはは、ふははは！！\n上等だ、余分な糖など、\n全てこの魔剣の糧にしてくれる！！", "face": "u1326"}, {"name": "シビラ", "text": "凄いやる気じゃない。\n……それじゃ、行くわよ、王子！！", "face": "u1039"}]}, {"trigger": "end", "lines": [{"name": "メルヴィナ", "text": "あぁ、またやってしまった。\nすまない、どうにも戦闘中は\n自分を抑える事が出来なくて……", "face": "u326"}, {"name": "メルヴィナ", "text": "……やはり、私は皆とは関わらずにいたほうが\n良いのかもしれないな……今日は誘ってくれて\n嬉しかった……それじゃあ……。", "face": "u326"}, {"name": "テミス", "text": "お待ちになって。", "face": "u38"}, {"name": "シビラ", "text": "そうよ、勝手に一人で\n納得しないでちょうだい。", "face": "u1039"}, {"name": "メルヴィナ", "text": "……え？", "face": "u326"}, {"name": "テミス", "text": "最初はビックリしましたが、\nおかげで良い運動になりましたわ。", "face": "u38"}, {"name": "シビラ", "text": "あなたに剣を持たせちゃったのは\n私だし……その、こっちこそごめんなさい。", "face": "u1039"}, {"name": "テミス", "text": "また美味しいお茶が入りましたら、\n皆さんをお誘い致しますので。その時は\nぜひまた参加して頂けないかしら？", "face": "u38"}, {"name": "シビラ", "text": "今度は、私の国のとっておきの\nお菓子を用意するわ。", "face": "u1039"}, {"name": "メルヴィナ", "text": "みんな……ありがとう。\nまた誘ってくれると嬉しい。\n今日はありがとう、ごちそうさま。", "face": "u326"}]}], "active": true}