l_effect_id": 248, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 301, "global_id": 300, "ranged": true, "from_condition": 3}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099440, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 84, "global_id": 83, "ranged": true, "spawn_sec": 205}], "popups": ["陰陽師コヨミのいる間は、\n味方ユニットの防御力と魔法耐性が、\n『30%』低下します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヒエン", "text": "主、妖天君が向かったのは\nあちらの方角……どうやら\n都に向かっている様でござる。", "face": "u112"}, {"name": "ケイティ", "text": "妖天君といいましたか。各地で鬼門が\n出現していたのは、彼の仕業のようですね。", "face": "u114"}, {"name": "ミコト", "text": "鬼門を封じる事が出来るコヨミさんを狙ったのは\n分かります。ですが、そのまま連れ去ってしまうとは。\n妖天君、一体何を企んでるのでしょう……。", "face": "u130"}, {"name": "兵士", "text": "伝令、前方より妖怪の群れが接近中との事！", "face": "l29763d6fd7f7"}, {"name": "アンナ", "text": "王子、戦闘のご準備をお願いします！", "face": "lca2c86f2c187"}]}, {"trigger": "battle", "at_sec": 83, "lines": [{"name": "兵士", "text": "報告！　戦場に鬼門が発生！", "face": "l29763d6fd7f7"}, {"name": "コヨミ", "text": "…………。", "face": "u471"}, {"name": "アンナ", "text": "あれは……コヨミさん！\n良かった無事だったのですね！"}, {"name": "ヒエン", "text": "お待ちくだされアンナ殿！　何やら\n様子がおかしいようでござる！", "face": "u112"}, {"name": "コヨミ", "text": "臨……滅……邪……葬……！", "face": "u471"}, {"name": "レアン", "text": "い、一体何を……ぐッ……\n力が……抜けて……！", "face": "u50"}, {"name": "ミコト", "text": "コヨミさんの身から感じる陰の気……妖天君に\n完全に操られてしまっているようです。", "face": "u130"}, {"name": "アンナ", "text": "……この場は一旦、戦ってコヨミさんを\n無力化するしかなさそうですね。", "face": "lca2c86f2c187"}, {"name": "ミコト", "text": "コヨミさんの使う霊符術は、\n攻撃への耐性を奪います。\n皆さんどうかお気をつけください！", "face": "u130"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "妖怪は全て倒しましたが……\n……コヨミさんの姿は見当たりませんね。", "face": "u114"}, {"name": "アンナ", "text": "コヨミさんが鬼門の奥へと姿を消すのを見ました。\nあの先は一体どこに繋がっているのでしょうか……。", "face": "lca2c86f2c187"}, {"name": "ヒエン", "text": "お話中の所失礼。配下の忍より\n妖天君、それとコヨミ殿が都に現れたとの\n報告でござる。", "face": "u112"}, {"name": "ケイティ", "text": "……先ほどまでこちらにいたのに……どうやら\n鬼門を通り移動をしているようですね。", "face": "u114"}, {"name": "モーティマ", "text": "っつーことはよ、あれを通れば\n俺達もすぐ都へ行けるんじゃねーのか！？", "face": "u14"}, {"name": "ミコト", "text": "……やめておいたほうが良いかと。\n鬼門を通っての移動など、聞いた事がありません。\n恐らくはあの仙人の力あっての事でしょう。", "face": "u130"}, {"name": "アンナ", "text": "急ぎコヨミさんを救い出さなければ。\n王子、都へと急ぎましょう！", "face": "lca2c86f2c187"}]}], "active": true}