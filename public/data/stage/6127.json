ist": 1000, "pattern_id": 2099360, "race_id": 4, "master_id": 104, "global_id": 103, "spawn_sec": 133}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["帝国"], "hp": 14000, "attack": 1000, "base_hp": 14000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 15, "attack_range": 60, "attack_speed": 70, "attack_wait": 30, "attack_interval": 91, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102464, "race_id": 16, "special_effect_id": 229, "missile_id": 45, "master_id": 337, "global_id": 336, "ranged": true, "spawn_sec": 136}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 1000, "base_hp": 40000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 260, "attack_range": 300, "attack_speed": 60, "attack_wait": 50, "attack_interval": 137, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110192, "race_id": 4, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30268, "global_id": 3887, "ranged": true, "spawn_sec": 136}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 350, "base_hp": 25000, "base_attack": 350, "damage_type": "physical", "armor_defense": 400, "magic_defense": 30, "attack_range": 210, "attack_speed": 1, "attack_wait": 50, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109728, "special_effect_id": 142, "missile_id": 194, "missile": {"speed": 15.0}, "master_id": 30210, "global_id": 3829, "ranged": true, "spawn_sec": 136}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "base_hp": 4000, "damage_type": "physical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 10, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105296, "race_id": 16, "special_effect_id": 70, "master_id": 631, "global_id": 630, "spawn_sec": 157}], "dialogue": [{"trigger": "start", "lines": [{"name": "イロハ", "text": "――遅くなってすみません！\n救援に来ました！", "face": "u242"}, {"name": "サノスケ", "text": "イロハ殿、それに王国の方々も！\nご尽力感謝致します！", "face": "u126"}, {"name": "コジュウロウ", "text": "感謝されるにはまだ早いかと。\n妖の群れはすぐそこに\n迫ってきてるでござる！", "face": "u102"}, {"name": "シノ", "text": "何故妖怪達が都を襲撃など……いや、\n今は考え事をしている場合ではないか。", "face": "u403"}, {"name": "アンナ", "text": "王子、戦闘のご準備をお願いします！", "face": "l90c9fc82386e"}]}, {"trigger": "battle", "at_sec": 140, "lines": [{"name": "妖天君", "text": "――全く、君達はどうしてボクの\n邪魔ばかりするのかネェ。", "face": "l2bcdad236604"}, {"name": "アンナ", "text": "あれは鬼門……それに妖天君！", "face": "l90c9fc82386e"}, {"name": "イロハ", "text": "あれが話に聞く……まだこの国の支配を\n諦めていなかったのですか！", "face": "u242"}, {"name": "妖天君", "text": "そう簡単に諦めるわけにはいかないヨ。\n酒呑童子がいないこの千載一遇のチャンス、\n逃す訳にはいかないからネェ。", "face": "l2bcdad236604"}, {"name": "妖天君", "text": "さぁお前達、あの連中を\nやってしまうといいヨ！", "face": "l2bcdad236604"}, {"name": "？？？", "text": "…………。", "face": "u480"}, {"name": "妖天君", "text": "強力な雷を操る妖怪の娘だヨ！\n雷に打たれて\n焼き焦げてしまうといいネェ！", "face": "l2bcdad236604"}, {"name": "イロハ", "text": "あの様子……どうやら妖天君に\n操られた方々がいるようですね。\n王子、どうかお気を付けください！", "face": "u242"}]}, {"trigger": "end", "lines": [{"name": "イロハ", "text": "……！　妖天君、また鬼門の中へ……！！", "face": "u242"}, {"name": "コジュウロウ", "text": "……妖の追撃はないようでござる。\nどうやら、妖天君も逃げたようでござるな。", "face": "u102"}, {"name": "？？？", "text": "うーん……う……ん？　\nあ、あれ？　ここは……？", "face": "u480"}, {"name": "シノ", "text": "気が付いたか。もしやとは思ったが、\nお前、雷神様の娘のラミィであろう。", "face": "u403"}, {"name": "イロハ", "text": "（雷神の娘……！？）", "face": "u242"}, {"name": "ラミィ", "text": "うん、そうだけど……あれ？\nもしかして、シノねーちゃん？　てことは、\n一緒にいる人達は……まさか、王子軍！？", "face": "u480"}, {"name": "アンナ", "text": "はい、そうですが？", "face": "l90c9fc82386e"}, {"name": "ラミィ", "text": "ってことはとーちゃんの言ってた敵じゃないか！\n敵に助けられちゃうなんて、とーちゃんに\nまた雷落とされる～……うぅ～……。", "face": "u480"}, {"name": "シノ", "text": "……助けて貰った者達に対し、\nそのような態度は看過できん。ラミィよ、\nまず先に言うべき事があるのではないか？", "face": "u403"}, {"name": "ラミィ", "text": "え？　あ、そ、そっか、そうだよね！\nえっと……助けてくれてありがと！\nそれと、敵とか言っちゃってごめんなさい！", "face": "u480"}, {"name": "イロハ", "text": "…………。", "face": "u242"}, {"name": "ラミィ", "text": "や、やっぱり怒ってるよね……\nで、でもとーちゃんから人間は敵だって\n聞いてるし……ど、どうしよぅ……。", "face": "u480"}, {"name": "シノ", "text": "……ラミィ、ここはひとまず帰れ。\nまた後日、礼にでも来ると良い。", "face": "u403"}, {"name": "ラミィ", "text": "う、うん、判った、そうするよ。\n……それじゃ皆ばいばい、またね～！", "face": "u480"}, {"name": "シノ", "text": "行ったか……雷神様がこの地で\nやった所業については存じています。ですが、\n彼女は戦いには参加していないと聞いています。", "face": "u403"}, {"name": "イロハ", "text": "……彼女がそのような行いを\nするような娘でない事は、見ていて判りました。", "face": "u242"}, {"name": "イロハ", "text": "……ですが、雷神の娘と聞くと、\nそう簡単には受け入れる事は\n難しいものですね……。", "face": "u242"}, {"name": "シノ", "text": "……私が総大将となった今、\n二度とあのような事はさせないと\n重く受け止めておきます。", "face": "u403"}, {"name": "イロハ", "text": "シノさん……はい、\nどうかよろしくお願いします。", "face": "u242"}]}], "active": true}