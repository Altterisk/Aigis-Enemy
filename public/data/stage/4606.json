": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102544, "race_id": 8, "change_to": 8, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 377, "global_id": 376, "ranged": true, "to_condition": 3, "to_global_id": 377, "spawn_sec": 74}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102560, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 378, "global_id": 377, "ranged": true, "from_condition": 3}], "popups": ["オーク旗手が持つ\n敵の攻撃と防御アップの能力は、\nオーク旗手の数に応じて効果が\n重複します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "ようやく人間の村を占領できたようだな。", "face": "l1b60b704868b"}, {"name": "オーク", "text": "これでジャングルの中の狙撃から\n安心して身を守ることが出来るだろう。", "face": "l1b60b704868b"}, {"name": "オーク", "text": "人間の集落などに興味はないが、\nこの地は戦いに適した開けた場所だ。\nこれで戦いが有利になるぞ……。", "face": "l1b60b704868b"}, {"name": "レーゼル", "text": "(何てことだ……私の狙撃のせいで、\n村が襲われただなんて……)", "face": "u371"}, {"name": "レーゼル", "text": "(こうなったら……)", "face": "u371"}, {"name": "レーゼル", "text": "オーク！　今すぐ村を開放するんだ！\nジャングルの中からの狙撃は全て\n私によるものだ！　これで満足だろう？", "face": "u371"}, {"name": "オーク", "text": "自ら地の利を捨てるとは間抜けな人間め。\nなぜ我らの前に現れた……。\nまあいい、ここで倒させてもらうぞ。", "face": "l1b60b704868b"}, {"name": "ルナール", "text": "――王子！\nあそこを見て！　レーゼルだ！\n早く助けに行こう！", "face": "u300"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "やりましたね、王子。\nオークが撤退していきます。\n村を取り戻すことができました！"}, {"name": "レーゼル", "text": "力を貸してくれて……ありがとう。\nあのままでは、きっとやられていた……。", "face": "u371"}, {"name": "ダナン", "text": "礼はいい。\nそれよりもあんたが無事でよかった。\nこれからは協力してオークを倒していこう。", "face": "u299"}, {"name": "レーゼル", "text": "悪いけど……それはできない。\n帝国と敵対している王子たちと\n馴れ合うことはできないんだ……。", "face": "u371"}, {"name": "アンナ", "text": "帝国とは戦ったこともありますが、\n共に協力して魔物を倒したこともあります。\nどうか私達を信じてください。", "face": "l878f496a6c7b"}, {"name": "レーゼル", "text": "好意は嬉しいが……すまない。\n私はこのまま独りでいくよ。\nそれじゃあ……。", "face": "u371"}, {"name": "ダナン", "text": "融通の利かないやつだな。\nだがそれでこそ帝国兵だとも思ってしまう……。\nなかなかに彼女も複雑というわけか。", "face": "u299"}, {"name": "アンナ", "text": "ここまで来て、レーゼルさんを\n放っておくことはできませんね。\n王子、彼女を追いかけましょう！", "face": "l878f496a6c7b"}]}], "active": true}