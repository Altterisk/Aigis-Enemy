{"quest_id": 4427, "name": "奇怪な魔群", "description": "迫る魔群！\n奇怪な隊列を組んだ\n魔物の群集の真意とは……。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "光と闇の聖霊", "event_category": "History", "mission_id": 920055, "map_no": 5390, "level": 90, "multiplier": 0.9, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 143, "form_count": 1, "hp": 576, "attack": 126, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 10, "form_count": 1, "hp": 900, "attack": 135, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 115}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 1260, "attack": 135, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103360, "race_id": 9, "master_id": 20213, "global_id": 1288, "spawn_sec": 115}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 13500, "attack": 900, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 6000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2101616, "race_id": 16, "special_effect_id": 222, "master_id": 268, "global_id": 267, "spawn_sec": 132}], "dialogue": [{"trigger": "start", "lines": [{"name": "常闇の聖霊", "text": "うーむ……。\n武具や技を授けても、それを\n使いこなせねば意味がない。", "face": "u397"}, {"name": "常闇の聖霊", "text": "必要なものは個々の力よりも\n集団として戦える連携かもしれんな。\nそうだ、次は知恵をさずけてやろうか。", "face": "u397"}, {"name": "魔物", "text": "ニンゲン、倒ス！　倒ス！", "face": "l6d57084cbee7"}, {"name": "常闇の聖霊", "text": "ハハハ！\nこれはちょうどよいところに魔物の群れが。\nさあ、貴様たち！　一糸乱れぬ隊列を見せてみよ！", "face": "u397"}, {"name": "常闇の聖霊", "text": "永久に揺蕩う深淵の闇の力よ、わが下に集え！\nわがしもべに肩を並べ戦列を作る知恵を与えん……！", "face": "u397"}, {"name": "兵士", "text": "報告！　魔物たちが隊列を組んで\nこちらに向かってきています！", "face": "l015ada40551a"}, {"name": "アンナ", "text": "王子、あの動きには何か意味が\nあるのかもしれませんよ。", "face": "le29c9a406493"}]}, {"trigger": "battle", "at_sec": 132, "lines": [{"name": "キャリー", "text": "王子！\n胸をお貸しください！", "face": "u1026"}]}, {"trigger": "end", "lines": [{"name": "常闇の聖霊", "text": "何だったのだ今のは……。\nあの動きに何の意味が。\n最後に出てきた騎馬は一体！？", "face": "u397"}, {"name": "ハッピー", "text": "あれは僕が教えてあげたんだよ。\nえへへ！\nみんなありがとうね！", "face": "u194"}, {"name": "常闇の聖霊", "text": "き、貴様は！\n再び人間たちに力を与えるために\nのこのこ戻ってきたのか！", "face": "u397"}, {"name": "ハッピー", "text": "そうだよ。\nみんなが喜んでくれるのが僕の幸せ。", "face": "u194"}, {"name": "常闇の聖霊", "text": "世迷い事を言うな！\n人間は聖霊を幸せになどしない！\n私は、私は……。", "face": "u397"}, {"name": "ハッピー", "text": "幸せがある限り、僕は力を取り戻せる。\n何度でもね。", "face": "u194"}, {"name": "常闇の聖霊", "text": "うるさい！\n私は認めない、認めないぞ！", "face": "u397"}]}], "active": true}