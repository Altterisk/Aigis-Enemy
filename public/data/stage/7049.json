{"quest_id": 7049, "name": "模擬戦ダンスパーティ！？", "description": "ジューンブライドの祝祭を楽しむ王国軍の\n面々。お祭りは珍しくも、武力を競うこと\nなく平和に進行……するはずが……！？\n神級（★１獲得の目安：平均Lv50）", "event": "ジューンブライド・ミッドナイト", "event_category": "History", "mission_id": 920145, "map_no": 5562, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 1000, "base_hp": 13000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 20, "attack_range": 160, "attack_speed": 50, "attack_wait": 30, "attack_interval": 127, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122592, "race_id": 2, "special_effect_id": 222, "change_to": 1, "change_condition": 1, "missile_id": 227, "missile": {"speed": 4.0}, "master_id": 32525, "global_id": 6144, "ranged": true, "variants": [{"hp": 13000, "attack": 600, "base_hp": 13000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 50, "attack_wait": 40, "attack_interval": 187, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122576, "race_id": 2, "special_effect_id": 222, "master_id": 32524, "global_id": 6143}], "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "attack_range": 160, "attack_speed": 1, "attack_wait": 40, "attack_interval": 143, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110128, "race_id": 2, "change_to": 3, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 30318, "global_id": 3937, "ranged": true, "variants": [{"hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defens