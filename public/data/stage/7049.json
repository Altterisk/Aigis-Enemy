": 29, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108656, "special_effect_id": 120, "master_id": 30068, "global_id": 3687, "spawn_sec": 194}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 50, "attack_wait": 50, "attack_interval": 205, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121840, "race_id": 16, "special_effect_id": 222, "master_id": 32527, "global_id": 6146, "spawn_sec": 195}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 800, "base_hp": 15000, "base_attack": 800, "damage_type": "magical", "armor_defense": 30, "magic_defense": 25, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 131, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122720, "race_id": 16, "special_effect_id": 519, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 32526, "global_id": 6145, "ranged": true, "spawn_sec": 218}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 150, "attack_speed": 70, "attack_wait": 80, "attack_interval": 206, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098000, "race_id": 16, "special_effect_id": 222, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 31679, "global_id": 5298, "ranged": true, "spawn_sec": 219}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 30, "magic_defense": 25, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107792, "race_id": 16, "special_effect_id": 222, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 887, "global_id": 886, "ranged": true, "spawn_sec": 244}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 360, "base_hp": 8000, "base_attack": 360, "damage_type": "magical", "armor_defense": 30, "magic_defense": 25, "attack_range": 210, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106576, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 837, "global_id": 836, "ranged": true, "spawn_sec": 245}, {"enemy_id": 18, "source": "local", "count": 7, "form_count": 1, "hp": 900, "attack": 300, "base_hp": 900, "base_attack": 300, "damage_type": "magical", "armor_defense": 20, "attack_range": 160, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102720, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 10042, "global_id": 1041, "ranged": true, "spawn_sec": 250}], "popups": ["ディエーラ、トトノがいる間は、\nマーセナリーの\n攻撃力と防御力がアップします。", "エターナーがいる間は、\n全ての敵のHPが\n徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アリシア", "text": "――司会進行って緊張しますね……。\nえぇと、次はダンスパーティでしたよね……。", "face": "u1372"}, {"name": "エターナー", "text": "済まないな、アリシア。\nスイレンが遅れていて、\n司会の手が足りなくなってしまったんだ。", "face": "u1011a1"}, {"name": "アリシア", "text": "ふふ、大丈夫ですよ。\n城下の皆さんのためにも、司会は\n王国軍が務めなければなりませんからね。", "face": "u1372"}, {"name": "スイレン", "text": "わぁ～！！　ごめんっ、ごめんねアリシアー！\n司会の台本どこにしまったか思い出せなくて～！！", "face": "u1013a1"}, {"name": "エターナー", "text": "おっと、噂をすればようやく到着か。\n遅いぞスイレン――っと、ま、待て！\nそのままじゃぶつかる――", "face": "u1011a1"}, {"name": "スイレン", "text": "きゃぁ～～～～～ッ！？", "face": "u1013a1"}, {"name": "アリシア", "text": "わ、わわっと！？　大丈夫ですか！？", "face": "u1372"}, {"name": "スイレン", "text": "だ、大丈夫ぅ……。\nでも台本が散らばっちゃったよぉ……。\nごめんねアリシア、エターナー。", "face": "u1013a1"}, {"name": "ディエーラ", "text": "――こちらから何だか\nすごい音がしましたけど、大丈夫でしたか？", "face": "u1010a1"}, {"name": "スイレン", "text": "へーきへーき♪\nアリシアが掴まえてくれたからねー！", "face": "u1013a1"}, {"name": "ディエーラ", "text": "ふふっ、それなら良かったです。\nあ、スイレンさん、次の演目は何でしょうか？\nそろそろ皆さんに伝えに行かないと……。", "face": "u1010a1"}, {"name": "スイレン", "text": "えっとねー……あれ、台本が混ざって……。\nあっ、模擬戦ダンスパーティだって！", "face": "u1013a1"}, {"name": "ディエーラ", "text": "なるほど……ジューンブライドの祝祭とは、\n思ったよりも激しいお祭りだったんですね……。\nそれでは、皆さんに伝えてきますね！", "face": "u1010a1"}, {"name": "エターナー", "text": "……い、いや待て！\nただのダンスパーティじゃなかったのか？", "face": "u1011a1"}, {"name": "スイレン", "text": "……あっ。\n…………てへっ。", "face": "u1013a1"}, {"name": "リッカ", "text": "スイレン～！！\nわ、私、王子に伝えてきます！\n皆が暴れすぎないように止めてあげてって！", "face": "u1014a1"}, {"name": "エターナー", "text": "……とはいえ、これも王子と手合わせをする好機か。\nせっかくの機会、活用させてもらうとしよう。", "face": "u1011a1"}, {"name": "アリシア", "text": "エターナーさんまで……。\nそれなら私も参戦しちゃいます！\nさぁ皆さん、いきますよー！！", "face": "u1372"}]}, {"trigger": "end", "lines": [{"name": "トトノ", "text": "……あの、私がもらった台本には、\n模擬戦ダンスパーティではなく、\n普通のダンスパーティと書かれているんですけど？", "face": "u316"}, {"name": "スイレン", "text": "あは、あはは……。\nごめんなさいー！", "face": "u1013a1"}, {"name": "エターナー", "text": "やれやれ。\nだが結果としては良かったのかもしれないぞ？", "face": "u1011a1"}, {"name": "アリシア", "text": "市民の皆さんにとっては、\n王国軍総出の良い余興に見えたみたいですね。", "face": "u1372"}, {"name": "ディエーラ", "text": "ふふ、お祭りの日ですからね。\nこれくらい羽目を外しても許されると思いますよ？", "face": "u1010a1"}, {"name": "スイレン", "text": "だよね、だよね♪\nよぉし、じゃあ次の演目にいってみよー！", "face": "u1013a1"}, {"name": "エターナー", "text": "次は間違えないようにしてくれよ？\nドレスが汚れないように戦うのも大変なんだ。", "face": "u1011a1"}, {"name": "スイレン", "text": "はーい。\nえぇと次の演目は――\nベストカップルコンテストだって！", "face": "u1013a1"}, {"name": "ディエーラ", "text": "――ベスト。", "face": "u1010a1"}, {"name": "リッカ", "text": "――カップル。", "face": "u1014a1"}, {"name": "エターナー", "text": "――コンテスト、だと？", "face": "u1011a1"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "ディエーラ", "text": "ま、まぁまぁ。ここは公平に決めましょう。\nさぁ王子、誰と一緒に舞台に上がりますか？", "face": "u1010a1"}, {"name": "ディエーラ", "text": "真剣に選んでください、ね♪", "face": "u1010a1"}]}], "active": true}