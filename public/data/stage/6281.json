p": 15000, "base_attack": 525, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 80, "attack_interval": 111, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103280, "special_effect_id": 195, "master_id": 30658, "global_id": 4277, "spawn_sec": 136}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 450, "base_hp": 4000, "base_attack": 450, "damage_type": "physical", "armor_defense": 800, "magic_defense": 90, "attack_speed": 90, "attack_wait": 20, "attack_interval": 181, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100992, "race_id": 16, "special_effect_id": 227, "master_id": 308, "global_id": 307, "spawn_sec": 136}], "dialogue": [{"trigger": "start", "lines": [{"name": "サバル", "text": "皆、急いでくれ！　追っ手が来る前に\n呪われた宝石の欠片を盗み出さなくちゃ！\n――って、おや？　向こうにいるのは……？", "face": "u536"}, {"name": "？？？", "text": "むッ！　貴方はあの時の……！", "face": "u551"}, {"name": "サバル", "text": "しまった！　私としたことが\n警戒を怠ってしまっていた！\n皆、ひとまず逃げるんだ！", "face": "u536"}, {"name": "？？？", "text": "逃がすものですか！\n皆の者、行きなさい！\n神の復活を妨げる愚か者どもを排除するのです！", "face": "u551"}, {"name": "ユリアン", "text": "くそっ、囲まれちまったか！\nバステトを崇める信者どもと……呪いの宝石の力で\n操られた魔物どももいるみてーだな。", "face": "u7"}, {"name": "？？？", "text": "私がバステト様復活の儀を執り行います！\n信徒たちはその間、時間を稼ぎなさい！\nさぁ、今こそ我らの信心が試される時です！", "face": "u551"}, {"name": "ケイティ", "text": "復活の儀……？\nバステト神を蘇らせる準備が\nすでに整ったというのですか！？", "face": "u114"}, {"name": "アンナ", "text": "そうはさせません！\n王子、敵の包囲を突破して\nなんとしても復活の儀を阻止しましょう！", "face": "lbfab4fba6540"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "バシラ", "text": "――ひぃいッ！？\nひ、棺の中から敵が出てきましたッ！", "face": "u28"}, {"name": "ケイティ", "text": "気をつけてください！\nフタの開いた棺からはマミーが現れるようです！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "なッ……あれだけの劣勢を覆すなんて！\n貴方たち、一体何者ですか……？", "face": "u551"}, {"name": "？？？", "text": "……いえ、何者であろうと最早関係ありません。\nすでにバステト様の復活の儀は完了したのですから。", "face": "u551"}, {"name": "サバル", "text": "そんな……っ！\n間に合わなかったというのか。", "face": "u536"}, {"name": "？？？", "text": "ふふ……そろそろお目覚めになります。\n神の再臨を妨げようとした罪過を、\nその血をもってあがなわせてあげましょう。", "face": "u551"}]}], "active": true}