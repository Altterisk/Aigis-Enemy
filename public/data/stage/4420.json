{"quest_id": 4420, "name": "偽りの英雄", "description": "王子に化けた\nドッペルゲンガーたちを打ち倒し\n自由都市から排除せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "白の帝国と偽りの都市", "event_category": "History", "mission_id": 920054, "map_no": 3139, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 18, "form_count": 2, "hp": 7000, "attack": 440, "base_hp": 7000, "base_attack": 440, "damage_type": "physical", "armor_defense": 340, "magic_defense": 20, "attack_speed": 10, "attack_wait": 10, "attack_interval": 66, "move_speed": 350.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2102976, "race_id": 16, "change_to": 1, "change_condition": 2, "master_id": 409, "global_id": 408, "to_condition": 2, "to_global_id": 403, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1500, "attack": 100, "base_hp": 1500, "base_attack": 100, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2102912, "master_id": 404, "global_id": 403, "from_condition": 2, "spawned_on_death_by": [1, 3, 4, 5, 6]}, {"enemy_id": 3, "source": "local", "count": 12, "form_count": 2, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103104, "race_id": 16, "change_to": 1, "change_condition": 2, "master_id": 417, "global_id": 416, "to_condition": 2, "to_global_id": 403, "spawn_sec": 15}, {"enemy_id": 4, "source": "local", "count": 7, "form_count": 2, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103120, "race_id": 16, "change_to": 1, "change_condition": 2, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 418, "global_id": 417, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 16}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 2, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103136, "race_id": 16, "change_to": 1, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 419, "global_id": 418, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 30}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 2, "hp": 2500, "attack": 600, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103152, "race_id": 16, "change_to": 1, "change_condition": 2, "master_id": 420, "global_id": 419, "to_condition": 2, "to_global_id": 403, "spawn_sec": 36}], "dialogue": [{"trigger": "start", "lines": [{"name": "ドッペルゲンガー", "text": "見つけたぞ！\nそう簡単に逃げられると思っているのか？", "face": "l5ccaf5d84e01"}, {"name": "アンナ", "text": "……！\n帝国の方はどうされたんですか！", "face": "l60b3e23a5d71"}, {"name": "ドッペルゲンガー", "text": "あの女は、我々が捕らえた。\nこれから色々利用できそうだしな。", "face": "l5ccaf5d84e01"}, {"name": "アンナ", "text": "そんな……！", "face": "l60b3e23a5d71"}, {"name": "ドッペルゲンガー", "text": "ククッ……。\n王子。お前の顔はしっかり記憶しているぞ。\nそっくりそのまま変身してやる。", "face": "l5ccaf5d84e01"}, {"name": "偽王子", "text": "どうだ。自分とそっくりな人間と対面する気分は。\n我らの種の変身能力を目の当たりにできて、\n光栄に思うのだな。　", "face": "u1"}, {"name": "偽王子", "text": "さぁ、王子。自身の力をとくと味わうのだな！", "face": "u1"}]}, {"trigger": "battle", "at_sec": 41, "lines": [{"name": "ケイティ", "text": "王子。\nあの偽王子ですが、\n戦いぶりを見ていて気が付いた事があります。", "face": "u114"}, {"name": "ケイティ", "text": "私たちは王子が戦場にいらっしゃるだけで士気が\n上がりますが、どうやら偽王子は魔物たちの士気を\n上げる事は出来ないようですね。", "face": "u114"}, {"name": "アンナ", "text": "そうとわかれば、手強い敵ではありませんね！"}, {"name": "王子(本物)", "text": "……。", "face": "u1"}, {"name": "アンナ", "text": "ち、ちょっと……！\n王子、気にされないでくださいね！", "face": "l60b3e23a5d71"}]}, {"trigger": "end", "lines": [{"name": "帝国軍師", "text": "一足遅くなったが、ここも片付いたようだな。\n他の場所にいたドッペルゲンガーどもは\nわれら白の帝国が、すべて排除した。", "face": "u311"}, {"name": "アンナ", "text": "帝国の方！　ご無事でよかったです。\nこの辺りのドッペルゲンガーは倒す事が出来ました。"}, {"name": "帝国軍師", "text": "良かった。\nこれで、この自由都市に巣食っていた\nドッペルゲンガーは全て滅ぼす事が出来たようだな。", "face": "u311"}, {"name": "アンナ", "text": "ありがとうございます。\n帝国の方々の機転のお陰で、\n助かりました。", "face": "l60b3e23a5d71"}, {"name": "帝国軍師", "text": "礼には及ばん。\n今回は協力したが、次会うときは敵かもしれんからな。", "face": "u311"}, {"name": "リーゼロッテ", "text": "まさかお前たちに助けられるとは……。\nありがとう。助かった。\n私は名をリーゼロッテという。", "face": "u305"}, {"name": "リーゼロッテ", "text": "国は違えど、お互いに共通の敵がいる間柄だ。\n今後何かあればいつでも手を貸す。", "face": "u305"}, {"name": "アンナ", "text": "とても心強いです。ありがとうございます。"}, {"name": "アンナ", "text": "では、王子。私たちも城に戻りましょうか。"}]}], "active": true}