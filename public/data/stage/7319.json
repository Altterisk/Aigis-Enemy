lobal_id": 7317, "spawn_sec": 134}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 2, "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128624, "race_id": 21, "change_to": 14, "change_condition": 4, "master_id": 33702, "global_id": 7319, "to_condition": 4, "to_ticks": 3, "to_global_id": 7322, "spawn_sec": 144}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 700, "base_hp": 20000, "base_attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128640, "race_id": 21, "special_effect_id": 127, "master_id": 33705, "global_id": 7322, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 2, "hp": 8000, "attack": 1400, "base_hp": 8000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "change_to": 18, "change_condition": 4, "master_id": 33563, "global_id": 7180, "to_condition": 4, "to_ticks": 3, "to_global_id": 7183, "spawn_sec": 162}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}], "popups": ["敵に占領されているマスは、\n占領している敵を倒すことで、\n使用可能になります。\nマスを占領している敵には、\n旗のマークがついています。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リンクス", "text": "――聞け！　百獣の民たちよ！", "face": "u1561a1"}, {"name": "リンクス", "text": "白の帝国に奪われし、父祖の地を取り戻す時が来た！\n狼の民よ、牛の民よ、今こそ先祖に伝えよう！\n我らの手で、故郷を取り戻しに来たのだと！", "face": "u1561a1"}, {"name": "レオナ", "text": "――陛下！　獣人の部隊が街道沿いに展開しています！\nこれは……帝国の庇護下にある獣人たちです！", "face": "u311"}, {"name": "白の皇帝", "text": "……連中は庇護とは思うまい。\n侵略戦争を仕掛けたのは、俺たちなのだからな。", "face": "u418"}, {"name": "レオナ", "text": "ですが……！", "face": "u311"}, {"name": "白の皇帝", "text": "……事実は変わらない。\nだが、冥界軍に与するというのなら、\n再び剣を向けるしかないだろう。", "face": "u418"}, {"name": "ディアナ", "text": "交渉とは、剣を向けあったままでは出来ないものです。\n今はこの戦闘を終わらせ、交渉のテーブルに\n引きずり出すことを考えましょう。", "face": "u624"}, {"name": "マレブランケ", "text": "……剣を向けたまま交渉を迫るのが帝国流では？\nなんて思っていたけれど、\n陛下もディアナも随分と丸くなったものだね。", "face": "u1225a1"}, {"name": "ヘカティエ", "text": "……剣を向けて交渉って、\nそれ脅迫って言わないかしら？", "face": "u1226a1"}, {"name": "ディアナ", "text": "交渉は言葉と知略で進めるもの。\n私が剣を抜くときは交渉ではなく、\n私の敵を斬り捨てる時だけ――何も変わっていませんよ。", "face": "u624"}, {"name": "マレブランケ", "text": "フフッ、陛下を斬り殺そうとした女傑は言うことが違う。\nさて、それじゃあ戦闘準備を開始しようか。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "王子、敵は帝都の周辺に陣を張っている。\n旗持ちのミノタウロスがここからでも見えるだろう？", "face": "u1225a1"}, {"name": "マレブランケ", "text": "あの拠点を潰さないと、こちらの展開も難しい。\n敵の支配力を削るためにも、\n敵の拠点を優先して潰していこう。", "face": "u1225a1"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "――よし、敵拠点を潰せたか。\nこれで多少は動きやすくなるな。", "face": "u311"}, {"name": "ヘカティエ", "text": "でも敵の本隊は残ったままよ？", "face": "u1226a1"}, {"name": "マレブランケ", "text": "フフッ、戦争とは数と配置でするものさ。\n数だけ多くても、\nそれを配する場所がなければ意味がない。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "こちらの兵を展開できる隙間ができたのだから、\nここからは反撃、というわけだよお嬢さん。", "face": "u1225a1"}, {"name": "レオナ", "text": "……とはいえ、だ。\nおそらく敵は、獣人以外にも\n他種族を仲間に引き入れていることだろう。", "face": "u311"}, {"name": "レオナ", "text": "帝都周辺を確保できたとしても、\nこの戦は長引きそうだな……。", "face": "u311"}, {"name": "マレブランケ", "text": "国の歴史とはそういったものでしょうとも。\n悩むより、まずは目の前の獣人と、\n冥界人の部隊を叩くのが先決だ。", "face": "u1225a1"}, {"name": "レオナ", "text": "……そうだな。\nメフィストめ、思ったより\n部下には良い教育をしていたようだな。", "face": "u311"}, {"name": "メフィスト", "text": "おや、お褒めに預かり恐悦至極。\n今の喜びをパーセントで表そうか？", "face": "u526"}, {"name": "レオナ", "text": "結構だ。\nマレブランケ、王子を呼んできてくれ。\n次の戦闘に備えるぞ！", "face": "u311"}, {"name": "マレブランケ", "text": "おまかせあれ。\n私の王子様を呼んでこよう♪", "face": "u1225a1"}, {"name": "レオナ", "text": "……私の、王子様？", "face": "u311"}, {"name": "メフィスト", "text": "何か悪いものでも食べたんだろう。\nマレブランケにはよくあることだとも。", "face": "u526"}]}], "active": true}