{"quest_id": 7185, "name": "神砕の槍グングニル", "description": "聖槍の新たなる力を見せつけよ！\n＜初期HP減少：小＞＜味方獣人、竜人、\nデーモン、アンデッドの攻防70％ダウン＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["初期HP減少：小", "味方獣人、竜人、\nデーモン、アンデッドの攻防70％ダウン"], "event": "新たなる千年戦争", "event_category": "History", "mission_id": 920187, "map_no": 5129, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\") || IsRace(\"獣人\") || IsRace(\"竜人\")) == 1;", "expression_human": "(it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]] or its race is [[tag:獣人]] or its race is [[tag:竜人]])"}, {"kind": "term", "influence": 13, "params": [30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\") || IsRace(\"獣人\") || IsRace(\"竜人\")) == 1;", "expression_human": "(it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]] or its race is [[tag:獣人]] or its race is [[tag:竜人]])"}, {"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["鳥"], "hp": 25000, "base_hp": 25000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "move_speed": 6000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125856, "race_id": 12, "special_effect_id": 620, "change_to": 1, "missile_id": 45, "master_id": 32934, "global_id": 6551, "ranged": true, "to_global_id": 6550, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 25000, "base_hp": 25000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 1, "attack_wait": 3, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 212