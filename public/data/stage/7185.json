transforms": [{"wait": 500}]}, "spawn_sec": 168}, {"enemy_id": 19, "source": "local", "count": 4, "form_count": 1, "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "magical", "armor_defense": 400, "magic_defense": 25, "attack_range": 240, "attack_speed": 70, "attack_wait": 35, "attack_interval": 101, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112688, "race_id": 6, "special_effect_id": 234, "missile_id": 236, "missile": {"speed": 8.0}, "master_id": 31369, "global_id": 4988, "ranged": true, "spawn_sec": 176}, {"enemy_id": 20, "source": "local", "count": 2, "form_count": 2, "hp": 30000, "attack": 2800, "base_hp": 30000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 251, "move_speed": 4000.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2107424, "race_id": 6, "change_to": 20, "master_id": 574, "global_id": 573, "to_global_id": 570, "route_behaviour": {"transforms": [{"wait": 1750}], "battle_styles": ["ENBSTL_Default", "ENBSTL_StandMotion"]}, "spawn_sec": 185}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 2800, "base_hp": 30000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 251, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107408, "race_id": 6, "master_id": 571, "global_id": 570}, {"enemy_id": 22, "source": "local", "count": 1, "form_count": 1, "tags": ["神聖騎士団"], "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 45, "attack_speed": 1, "attack_wait": 100, "attack_interval": 252, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124368, "race_id": 16, "special_effect_id": 561, "master_id": 32737, "global_id": 6355, "spawn_sec": 254}], "popups": ["ホワイトクルセイダーは倒されると、\nその場で復活します。\n\n復活後、ホワイトクルセイダーは\n強くなりますが、HPが徐々に減少し\nいずれ自滅します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ドゥマルデ", "text": "（……やはり神はいないのか？\n我らの信じた神は、死んだのか……？）", "face": "u1266a1"}, {"name": "ドゥマルデ", "text": "（いや、もしや神と信じていたものは、\n遠い昔に、もう神ではなくなっていたのか……？）", "face": "u1266a1"}, {"name": "ドゥマルデ", "text": "（ケラウノス、アイギス、アダマス……。\n三女神に力を分かたれたという我らが主よ。\n地上を害するあなたを、もう信じることはできない）", "face": "u1266a1"}, {"name": "神聖騎士団員", "text": "ドゥマルデ審問官！\n神が、我らが主が！　天使を遣わせてくれたぞ！！", "face": "lccd6497cc3fb"}, {"name": "ドゥマルデ", "text": "（だが、彼らを置いていくことはできない。\n信仰に身を捧げた被害者たる彼らに、\nこの残酷な事実を突きつけるわけには）", "face": "u1266a1"}, {"name": "ドゥマルデ", "text": "（主よ、信仰とは人を救うものではなかったのか……？）", "face": "u1266a1"}, {"name": "アンナ", "text": "――王子、神聖騎士団、\nおよび上空からの天使の攻勢がやみません。", "face": "l0ade8018550d"}, {"name": "ソーマ", "text": "それにあちらには、さっきの異端審問官もいます！\n獣人さんに、竜人さんに――", "face": "u23"}, {"name": "ノーマ", "text": "くっ……それにデーモンとアンデッドにも、\n例の戦力を削ぐ祈りの効果を広げたようね。", "face": "u1047a1"}, {"name": "アリサ", "text": "……でも、もう聖槍はこちらにあります。\nあとはいつもと同じ、ですよね、王子！", "face": "u24"}, {"name": "王子", "text": "――ああ。", "face": "u1"}, {"name": "王子", "text": "いつもどおりだ、皆。\n俺たちはもう、何も奪わせない。\nこの包囲を切り抜け、亜神ゴルゴーンを討つ。", "face": "u1"}, {"name": "王子", "text": "――皆の力を、俺に貸してくれ。", "face": "u1"}, {"name": "パリオス", "text": "かっこいいこと、言ってるけど……。\n勝つのはぼくたちだよ……。", "face": "l3c2d6d31457e"}, {"name": "パリオス", "text": "アラエルさまに……勝利を……。\nぼくたちを虐める王子に、敗北を……！", "face": "l3c2d6d31457e"}, {"name": "アンナ", "text": "王子、戦闘準備を！\nこの戦いを制し、天界へ向かうために！", "face": "l0ade8018550d"}]}, {"trigger": "end", "lines": [{"name": "ドゥマルデ", "text": "……潮時か。\n全軍、撤退しますよ。", "face": "u1266a1"}, {"name": "神聖騎士団員", "text": "なっ……ドゥマルデ審問官！\n邪教の徒を見過ごせと！？", "face": "lccd6497cc3fb"}, {"name": "ドゥマルデ", "text": "次なる戦いに備えるのが我らのつとめ。\nここで命を落とし、\n真に必要な戦いに臨まないのがあなたの信仰ですか？", "face": "u1266a1"}, {"name": "神聖騎士団員", "text": "くっ……撤退、撤退だ！\n全軍撤退せよ！！", "face": "lccd6497cc3fb"}, {"name": "アンナ", "text": "――王子、神聖騎士団、\nおよび天使たちが撤退していきます。"}, {"name": "パリオス", "text": "……あ、れ？　ここは……？", "face": "u1109a1"}, {"name": "ライノー", "text": "パリオス！　正気に戻ったのか！？", "face": "u1086a1"}, {"name": "パリオス", "text": "んん……えぇと、どういうこと……？\nアラエルさまは？　銀腕さまは？\nさっきまで一緒にいた気がするんだけど……。", "face": "u1109a1"}, {"name": "サナラ", "text": "パリオスさん、あなたは操られていたんです。\n亜神ゴルゴーンの手によって。", "face": "u921"}, {"name": "パリオス", "text": "……そっか。\nえっと、ごめん……ごめんね。", "face": "u1109a1"}, {"name": "シャルロット", "text": "いいんですのよ。\nさぁ傷を手当しませんと！", "face": "u128"}, {"name": "アンナ", "text": "……王子、これで亜神の不死性を破ることができます。\n私たちの手で、意志で、\n天界の戦いに介入することになります。", "face": "l71a783f44496"}, {"name": "アンナ", "text": "本当に、これで良いのですよね？\n人類が、天界に抗うことは、正しいのですよね？", "face": "l71a783f44496"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "……わかりました。\n王子、それでは天界へ向かいましょう！\n物質界を守るために、世界を救うために！", "face": "l0ade8018550d"}]}], "active": true}