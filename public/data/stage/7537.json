age_type": "physical", "armor_defense": 220, "magic_defense": 10, "attack_range": 240, "attack_speed": 90, "attack_wait": 30, "attack_interval": 121, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133024, "race_id": 16, "change_to": 7, "missile_id": 26, "master_id": 34612, "global_id": 8229, "ranged": true, "from_condition": 0}, {"enemy_id": 10, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 45, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111792, "race_id": 16, "master_id": 30637, "global_id": 4256, "spawn_sec": 82}, {"enemy_id": 11, "source": "local", "count": 18, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 86}, {"enemy_id": 12, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "tags": ["帝国"], "hp": 18000, "attack": 600, "base_hp": 18000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "magic_defense": 10, "attack_range": 240, "attack_speed": 90, "attack_wait": 30, "attack_interval": 121, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133120, "race_id": 16, "change_to": 12, "missile_id": 26, "master_id": 34622, "global_id": 8239, "ranged": true, "to_condition": 0, "to_global_id": 8238, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 145}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["帝国"], "hp": 18000, "attack": 600, "base_hp": 18000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "magic_defense": 10, "attack_range": 240, "attack_speed": 90, "attack_wait": 30, "attack_interval": 121, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133136, "race_id": 16, "special_effect_id": 947, "change_to": 11, "missile_id": 26, "master_id": 34621, "global_id": 8238, "ranged": true, "from_condition": 0}], "popups": ["　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーネ", "text": "…………マルレーン、別人みたいだったな。\n軍人になると、変わっちゃうものなのかなぁ。\nふたりでパンを盗んで叱られてたのが嘘みたいだ。", "face": "u1432a1"}, {"name": "レーネ", "text": "帝国軍も王国軍も、雪山の方に向かったのかな。\n……ふふん、これでボクは安全に逃げられ――", "face": "u1432a1"}, {"name": "レーネ", "text": "――あ、あれ？\nあの雪上部隊って、帝国軍とは違うよね……。\nベラート伯爵の紋章をつけてるし……。", "face": "u1432a1"}, {"name": "レーネ", "text": "……まずい。まずいのは分かる。\n敵に雪上装備の部隊がいるとか、誰も気付いてないよね。\nでも報告になんて行ったら、ボクが戦場のど真ん中に……。", "face": "u1432a1"}, {"name": "レーネ", "text": "あぁ……もうっ！\n覚えてろよマルレーン！\nあんたを！　助けに行くんだから！　貸しひとつだ！！", "face": "u1432a1"}, {"name": "クルル", "text": "――王子、吹雪が迫ってるよ。\nこのままだと、遠距離がより狙いにくくなるかも……。", "face": "u197"}, {"name": "フィリス", "text": "今回の合同演習は雪上訓練のためだったけど、\nやっぱり雪道はうまく進めないな。\n行軍速度もいつもの半分ってとこじゃないか？", "face": "u40"}, {"name": "ジェローム", "text": "それは敵も同じこと。\n戦術教官殿も、それを狙っての後退指示でしょう。\nただ……ひとつだけ気になりますねぇ……。", "face": "u62"}, {"name": "アルティア", "text": "……白の帝国の、雪上部隊のことですか？\nしかし、ベラート伯爵の領地には、\n積雪地帯は含まれていなかったはず……。", "face": "u261"}, {"name": "ジェローム", "text": "いえね、ベラート伯爵についたのは、\n果たして、伯爵領の兵だけだったのだろうか、とね。", "face": "u62"}, {"name": "レーネ", "text": "――マルレーン！　陛下っ！　王子殿下ぁ！！\nはぁっ……はぁ……っ！！\nほ、報告！　報告だよ！！", "face": "u1432a1"}, {"name": "レーネ", "text": "雪上装備の兵が迫ってるんだ！\n雪の上でも関係なく、高速で突っ込んでくるよ！！", "face": "u1432a1"}, {"name": "マルレーン", "text": "レーネ！？　逃げてって言ったのに……！", "face": "u1434a1"}, {"name": "レーネ", "text": "親友置いて逃げるわけないじゃん！\nそれより、急いで戦闘準備を！\n雪上兵はすぐに追いついてくるよ！", "face": "u1432a1"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "……想定以上に、帝国軍からの離反者は多いようだな。", "face": "u311"}, {"name": "レオラ", "text": "あら、それは分かっていたことよ？\nかつての白の王国を取り戻そうだなんて、\n貴族たちからしたら、甘い蜜のような誘いだもの。", "face": "u464"}, {"name": "ディアナ", "text": "ベラート伯爵は、この地で皇帝陛下と王子殿下を、\n一度に仕留めるつもりでいるのでしょう。\nそれゆえの、この大戦力だと思えば納得できます。", "face": "u624"}, {"name": "レオナ", "text": "……やはり、最初の叛逆の折、\n領地と兵は取り上げておくべきでした。\nもっと強く、私が進言していれば……。", "face": "u311"}, {"name": "レオラ", "text": "いいえ、レオナちゃん。\nそんなことをしていたら、\nより精強な軍勢が、命を捨てて挑んできたはずよ？", "face": "u464"}, {"name": "白の皇帝", "text": "……ベラート伯爵は、ああ見えて人望の厚い男だ。\n少々自己顕示欲が強すぎるがな。", "face": "u418"}, {"name": "レオナ", "text": "領民や、伯爵領の兵にとって見れば、\n私たちこそ悪役だ、ということか……。\nそうだな、少し、頭を冷やすとしよう。", "face": "u311"}, {"name": "レオラ", "text": "えぇ、感情にまかせて焦るなんて、\nレオナちゃんらしくないわ♪", "face": "u464"}, {"name": "ディアナ", "text": "では、迅速に後退しましょう。\nこちらの作戦が失敗した以上、\n装備の潤沢な敵に合わせて、留まる必要はありません。", "face": "u624"}, {"name": "マルゴット", "text": "えぇ、それでは楽しい山越えの時間、ですね。\n各員、吹雪ではぐれないよう、連絡を密にとるように！", "face": "u1343a1"}]}], "active": true}