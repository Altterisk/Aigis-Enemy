{"quest_id": 7831, "name": "魔界カカオの妖精", "description": "カカオ農園を調査していると魔界カカオの\n妖精の痕跡を発見。後を追おうとするも、\n操られたチョコレート騎士団が立ち塞がる。\n上級（★１獲得の目安：平均Lv10）", "event": "花咲く想いのバレンタイン", "event_category": "History", "mission_id": 920192, "map_no": 4679, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142080, "special_effect_id": 1224, "change_to": 1, "master_id": 35757, "global_id": 9374, "to_global_id": 9375, "route_behaviour": {"transforms": [{"wait": 15}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 5, "tags": ["植物", "バレンタイン", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142096, "change_to": 2, "master_id": 35758, "global_id": 9375, "to_global_id": 9376}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142112, "special_effect_id": 1225, "change_to": 3, "master_id": 35759, "global_id": 9376, "to_global_id": 9377}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 3, "form_count": 5, "tags": ["植物", "バレンタイン", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142128, "change_to": 4, "master_id": 35760, "global_id": 9377, "to_global_id": 9378}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 4, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142144, "special_effect_id": 1226, "master_id": 35761, "global_id": 9378}, {"enemy_id": 6, "source": "local", "count": 17, "form_count": 1, "tags": ["アーマー", "バレンタイン", "チョコレート騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132720, "master_id": 34530, "global_id": 8147, "spawn_sec": 3}, {"enemy_id": 7, "source": "local", "count": 13, "form_count": 1, "tags": ["バレンタイン"], "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 30, "attack_range": 170, "attack_speed": 26, "attack_wait": 20, "attack_interval": 89, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142160, "missile_id": 815, "missile": {"speed": 7.0}, "master_id": 35762, "global_id": 9379, "ranged": true, "spawn_sec": 4}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 39, "change_to": 8, "missile_id": 6, "master_id": 32291, "global_id": 5910, "ranged": true, "to_global_id": 5923, "spawn_sec": 74}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 7, "missile_id": 6, "master_id": 32304, "global_id": 5923}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "tags": ["アーマー", "バレンタイン", "チョコレート騎士団"], "hp": 10000, "attack": 650, "base_hp": 10000, "base_attack": 650, "damage_type": "physical", "armor_defense": 350, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132736, "master_id": 34531, "global_id": 8148, "spawn_sec": 93}], "dialogue": [{"trigger": "start", "lines": [{"name": "グレーターデーモン", "text": "──これはとても拙いねぇ、\n魔界カカオの妖精の痕跡だよ。", "face": "l45969ed547e2"}, {"name": "ポミエ", "text": "えっと、それはいったい……。", "face": "u1422a1"}, {"name": "グレーターデーモン", "text": "開花した魔界カカオから、\n稀に誕生する妖精のことさ。", "face": "l45969ed547e2"}, {"name": "グレーターデーモン", "text": "あらゆるカカオを操る力と、\n他者の思考に干渉する力を持つ、\nひどく厄介ないたずら者たちでね。", "face": "l45969ed547e2"}, {"name": "グレーターデーモン", "text": "ワシも魔界では手酷くやられたものだよ。\n彼らを野放しにするのはあまりにも危険だ。", "face": "l45969ed547e2"}, {"name": "ラタトスク", "text": "ふぅむ、よく分からぬが、\n要はその妖精を捕まえれば良いのじゃろう？", "face": "u1693a1"}, {"name": "ローリエ", "text": "妖精さんが逃げた方角は把握しています。\n今すぐ追えばきっと間に合うはずで──", "face": "u1692a1"}, {"name": "ミリアム", "text": "──残念ですが、そうはいかないようです。", "face": "u1694a1"}, {"name": "チョコレート騎士", "text": "………………。", "face": "l42d1e87cae0d"}, {"name": "ポミエ", "text": "うわっ、チョコレート騎士団！", "face": "u1422a1"}, {"name": "ラタトスク", "text": "足止めか、随分と手際が良いらしいのぉ。", "face": "u1693a1"}, {"name": "ミリアム", "text": "時間がありません、迅速に排除しましょう。", "face": "u1694a1"}]}, {"trigger": "end", "lines": [{"name": "チョコレート騎士", "text": "──はっ！？　我々は一体何を……！？\n今年こそはキュートなガールからチョコを貰うため、\nクールなモテナイトを目指していたはずでは……？", "face": "l42d1e87cae0d"}, {"name": "ラタトスク", "text": "絶妙にモテなさそうな名前じゃな。", "face": "u1693a1"}, {"name": "グレーターデーモン", "text": "これが魔界カカオの妖精の権能さ。\n他にも操られたカカオがいるだろう。", "face": "l45969ed547e2"}, {"name": "ラタトスク", "text": "とはいえ、これだけではないのであろう？\n思考への干渉、具体的にどういうことじゃ？", "face": "u1693a1"}, {"name": "グレーターデーモン", "text": "……魔界カカオの妖精には、不特定多数に対して、\nとある感情を強制的に暴走させる能力があるんだよ。", "face": "l45969ed547e2"}, {"name": "ポミエ", "text": "とある感情……？", "face": "u1422a1"}, {"name": "グレーターデーモン", "text": "恋心さ。とりわけ、女性にはよく効く。", "face": "l45969ed547e2"}, {"name": "ローリエ", "text": "恋っ──！？", "face": "u1692a1"}, {"name": "ラタトスク", "text": "なるほどのぉ……見えてきた。\n吾輩、実に嫌な予感がするぞい。", "face": "u1693a1"}, {"name": "ミリアム", "text": "対女性特攻の精神干渉、恋心の暴走。\n本日の王城内人員の男女比を鑑みるに、\nおそらく、このままでは非常に高確率で──", "face": "u1694a1"}, {"name": "ローリエ", "text": "──王子が、危ない？", "face": "u1692a1"}]}], "active": true}