ase_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124096, "race_id": 20, "change_to": 14, "change_condition": 4, "master_id": 32748, "global_id": 6366, "to_condition": 4, "to_ticks": 3, "to_global_id": 6369, "spawn_sec": 113}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1400, "base_hp": 5000, "base_attack": 1400, "damage_type": "true", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 32751, "global_id": 6369, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 2, "hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124224, "race_id": 20, "change_to": 18, "change_condition": 4, "master_id": 32752, "global_id": 6370, "to_condition": 4, "to_ticks": 3, "to_global_id": 6375, "spawn_sec": 125}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 405, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124240, "race_id": 20, "special_effect_id": 563, "change_to": 21, "change_condition": 1, "master_id": 32757, "global_id": 6375, "from_condition": 4, "trigger_ticks": 3, "variants": [{"hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124240, "race_id": 20, "special_effect_id": 563, "missile_id": 45, "master_id": 32755, "global_id": 6373}]}, {"enemy_id": 23, "source": "local", "count": 4, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124160, "race_id": 20, "change_to": 23, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32915, "global_id": 6532, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6535, "spawn_sec": 210}, {"enemy_id": 23, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 800, "base_hp": 5500, "base_attack": 800, "damage_type": "true", "armor_defense": 600, "magic_defense": 15, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124176, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32918, "global_id": 6535, "ranged": true, "from_condition": 4, "trigger_ticks": 3}], "popups": ["　　　　　【天界】\n・味方攻撃力が最終値から-500。\n・アンデッド、デーモン系を除く\n　味方、敵ユニットの\n　HPが徐々に回復。\n※これらは、風水使いなどがもつ\n　地形効果を軽減する能力では\n　軽減できません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アラエル", "text": "（――僕を惑わすとは、\n物質界の者たちはどれだけ卑劣なんだ……）", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "（神がもういない？\n僕ら天使は、悪意ある亜神に操られている？\n馬鹿な……そんな馬鹿な話があるものか！）", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "（僕の神は健在だ！\n我が主よ、その存在を疑ったことをお詫びします。\n罪深き物質界の者共の血をもって贖います！！）", "face": "l7c04f1b6c641"}, {"name": "パリオス", "text": "アラ……エル……さま……。\n進軍の……準備は……整いました……。", "face": "l071c3621fe6f"}, {"name": "アラエル", "text": "……ご苦労。\n僕の小鳥よ、僕らの神に反逆する、\nすべての者を抹殺するのです。", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "これは正しき戦い……。\n神は未だ生きておられる……。\n僕らが亜神に従わされることなどありえない……。", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "全軍、鳥人の集落を殲滅せよ！\n我らが神は、鳥人の血をお望みだ！！", "face": "l7c04f1b6c641"}, {"name": "シャディア", "text": "――王子、斥候から連絡だ。\nアラエルの軍勢が、再度こちらに進軍している。", "face": "u713"}, {"name": "ライノー", "text": "おそらく、操られたパリオスもあちらにいるはずだ。\n「怪物化」によって凶暴になったあの子の突撃は、\n真正面から受け止めないよう注意してくれ。", "face": "u1086a1"}, {"name": "シャルロット", "text": "怪物化、ですの？", "face": "u128"}, {"name": "ライノー", "text": "神や亜神による強制的な戦闘状態、とでも言えばいいか。\n物質界にも荒ぶる怪物の逸話が\nいくつか残っているんじゃないか？", "face": "u1086a1"}, {"name": "レーヴ", "text": "なるほど、怪物の伝承は天界の介入の可能性が……。\nっと、その前に迎撃でした！", "face": "u454"}, {"name": "レーヴ", "text": "王子、パリオスさんの進行方向を見極め、\n兵の配置には十分に注意してくださいね！", "face": "u454"}, {"name": "ノーマ", "text": "それから王子、すごーく言いにくいんだけど、\nこの集落の中って天界の抑止の力が更に強いみたい。\nデーモンやアンデッドの子には注意してあげてね。", "face": "u1047a1"}]}, {"trigger": "end", "lines": [{"name": "アラエル", "text": "なぜです……なぜ……なぜですか……ッ！！\n神の命を受けたこの僕に\n物質界のゴミクズどもが匹敵するというとでも！？", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "主よ！　なぜです！\nなぜ応えてくれないのですか！？", "face": "l7c04f1b6c641"}, {"name": "ライノー", "text": "……私たちの神は、もういないからです。\nアラエル様、天使とは創造主を助けるもの。\n神なき今、あなたを操っているのは何者なのですか！", "face": "u1086a1"}, {"name": "アラエル", "text": "……またくだらない話を。\n僕の小鳥よ、君なら神の存在を感じられますね？", "face": "l7c04f1b6c641"}, {"name": "パリオス", "text": "はい……アラエルさま……。", "face": "l071c3621fe6f"}, {"name": "フォニア", "text": "……天使とは意思ある兵器。\n創造主以外の命を聞くとすれば、\n堕天か、他の者によって支配された時だけ。", "face": "u548"}, {"name": "フォニア", "text": "私は幸いにも、堕天した後あなたに出会いました。\nけれどきっと彼は、\n望まぬ主に従わされているのでしょう。", "face": "u548"}, {"name": "シャルロット", "text": "……そんなの可哀想すぎますわ。\n王子、あの子も助けてあげないとですわよね？", "face": "u128"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}