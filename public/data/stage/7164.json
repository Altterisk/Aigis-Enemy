{"quest_id": 7164, "name": "白翼の怪物", "description": "異質な様相のパリオスが一行を襲う！\n＜天界：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["天界：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復"], "event": "縛られた空、解放の戦端", "event_category": "History", "mission_id": 920151, "map_no": 3481, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -500]}, {"kind": "term", "influence": 41, "params": [0, 100, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 20, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["鳥"], "hp": 25000, "base_hp": 25000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 1, "attack_wait": 3, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125840, "race_id": 12, "special_effect_id": 551, "change_to": 1, "missile_id": 45, "master_id": 32933, "global_id": 6550, "to_global_id": 6551, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 28}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 25000, "base_hp": 25000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "move_speed": 6000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125856, "race_id": 12, "special_effect_id": 620, "missile_id": 45, "master_id": 32934, "global_id": 6551, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_att