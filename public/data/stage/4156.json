sin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 20212, "global_id": 1287, "ranged": true, "spawn_sec": 47}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 700, "base_hp": 12000, "base_attack": 700, "damage_type": "magical", "armor_defense": 500, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105072, "race_id": 16, "special_effect_id": 222, "master_id": 590, "global_id": 589, "spawn_sec": 48}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 20207, "global_id": 1282, "spawn_sec": 61}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 73}], "dialogue": [{"trigger": "start", "lines": [{"name": "シェリー", "text": "あらら。あなた達はどちら様？\nここは私たち高貴な生まれの姫\nしか入れないところですよ。", "face": "u1027"}, {"name": "アンナ", "text": "すいません。そうとは知らず。\n道に迷ってしまいました。", "face": "l2d04745ddd90"}, {"name": "アンナ", "text": "私はアンナと申します。\nこちらは私が仕えている王子です。\nかつての千年戦争の英雄の末裔です。", "face": "l2d04745ddd90"}, {"name": "リリア", "text": "へえ。でも貴方本当に英雄の末裔なのですか？\nねぇシェリー。\nもしかして嘘ついてるかもしれないよ！", "face": "u1020"}, {"name": "シェリー", "text": "そうね。\n貴方が本当に英雄の末裔なのか\n試させていただきます。", "face": "u1027"}, {"name": "シェリー", "text": "お姫様だと思って油断しないでくださいね。\n私たちの持つ伝説の宝剣は\nどれも魔法の力が宿っておりますので。", "face": "u1027"}, {"name": "アンナ", "text": "魔法の力……？！\n王子、お気を付けください。彼女達の持つ剣には\n不思議な力が宿っているようです。", "face": "l2d04745ddd90"}]}, {"trigger": "end", "lines": [{"name": "リリア", "text": "貴方達、とってもお強いのですね！\nびっくりしちゃいました！", "face": "u1020"}, {"name": "シェリー", "text": "英雄の末裔というのは本当の様ですね。\nお会いできて光栄でした。", "face": "u1027"}, {"name": "シェリー", "text": "殿方がここに立ち入るなんて\n本当は絶対ダメなのですけど、\n今日は特別に不問にいたします。", "face": "u1027"}, {"name": "シェリー", "text": "今度いらっしゃる時は正式に\n王宮までご連絡くださいね！", "face": "u1027"}, {"name": "アンナ", "text": "王子、分かっていただけて良かったですね。\nさぁ、次の地へ行きましょう！"}]}], "active": true}