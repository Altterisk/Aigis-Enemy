5, "pattern_id": 2172928, "race_id": 3, "change_to": 66, "master_id": 41176, "route_behaviour": {"transforms": [{"wait": 200}], "force_dead": true}, "spawn_sec": 259}, {"enemy_id": 68, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 90, "attack_speed": 1, "attack_wait": 40, "attack_interval": 206, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2173056, "race_id": 3, "master_id": 41179, "route_behaviour": {"transforms": [{"wait": 200}], "force_dead": true}, "spawn_sec": 259}, {"enemy_id": 69, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 107, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2173072, "race_id": 16, "change_to": 69, "master_id": 41180, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 259}], "popups": ["完全体になった\n魔神セーレの右手がいる間は\n敵のハニーの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "魔神セーレ", "text": "ハーッハッハッハ！　効かぬ、効かぬぞ！", "face": "lf6eef03410c8"}, {"name": "フローガ", "text": "攻撃は通っているはずなのに……！\nまったく効いていないように見えます！", "face": "u878"}, {"name": "志津香", "text": "不死性……魂が炉と繋がってる。\n外からじゃ、いくら削っても戻るわ。", "face": "u1759a1"}, {"name": "魔剣カオス", "text": "むぅ、こいつは厄介じゃのー。\n内側から砕かんと、きりがないぞ。", "face": "le2e11fea1f65"}, {"name": "ランス", "text": "内側だと？", "face": "u2897a1"}, {"name": "リア", "text": "……ねえ、シィル。ダーリンの呪印、\nまだセーレと繋がってるのよね？", "face": "u2901a1"}, {"name": "シィル", "text": "は、はい。細い糸みたいに、ずっと……。", "face": "u2900a1"}, {"name": "志津香", "text": "……そういうこと。\n呪印を通して、内側に魔力を流し込めば。", "face": "u1759a1"}, {"name": "シルキィ", "text": "セーレの不死性を、内側から破壊できる。\n……ただし、大量の魔力が要るわ。", "face": "u2902a1"}, {"name": "グリム", "text": "呪いに魔力を流すということは……。\n爆発しますよ？　ランスさんのランスさんが。", "face": "u942"}, {"name": "ランス", "text": "…………。", "face": "u2897a1"}, {"name": "ランス", "text": "……やれ。", "face": "u2897a1"}, {"name": "シィル", "text": "ら、ランス様！？", "face": "u2900a1"}, {"name": "ランス", "text": "俺様のハイパー兵器は、俺様の物だ！\n魔神なんかに好きにされてたまるか！", "face": "u2897a1"}, {"name": "ランス", "text": "一発ぶっ飛ばして呪いごと消し飛ばしてやる！\n全員、俺様に魔力を流し込め！", "face": "u2897a1"}, {"name": "シィル", "text": "……はいっ！\nランス様、失礼しますっ！", "face": "u2900a1"}, {"name": "リア", "text": "ダーリン、リアも！", "face": "u2901a1"}, {"name": "シルキィ", "text": "……仕方ないわね。", "face": "u2902a1"}, {"name": "志津香", "text": "何で私まで……ああもう！", "face": "u1759a1"}, {"name": "魔剣カオス", "text": "おおっ、女の子たちが心の友に殺到しておる！", "face": "le2e11fea1f65"}, {"name": "ランス", "text": "ぬおおおおおおおおっ！！！", "face": "u2897a1"}]}, {"trigger": "start", "lines": [{"name": "魔神セーレ", "text": "ぐっ……がぁぁぁっ！？\nな、何だ、この魔力は……内側から……！", "face": "lf6eef03410c8"}, {"name": "グリム", "text": "……あっ、砕けました！\nセーレの不死性、消えましたよー！", "face": "u942"}, {"name": "アンナ", "text": "王子、今です！　総攻撃を！"}, {"name": "ランス", "text": "……はらほろ……ま、まだだ……。\nまじんなんとか、覚悟しろぉぉぉ……。", "face": "u2897a1"}]}, {"trigger": "end", "lines": [{"name": "魔神セーレ", "text": "ぐ、ぐぉぉ……なぜだ……三度も……。", "face": "lf6eef03410c8"}, {"name": "ランス", "text": "貴様、俺様に迷惑ばかりかけおって。", "face": "u2897a1"}, {"name": "ランス", "text": "俺様の呪い。俺様の時間。\nそして、俺様のハイパー兵器の恨み。", "face": "u2897a1"}, {"name": "ランス", "text": "まとめて返してやる！\n俺様にあわせろ王子！　行くぞー！！", "face": "u2897a1"}, {"name": "ランス", "text": "ランスあたたたーーーっく！！", "face": "u2897a1"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "魔神セーレ", "text": "ぐわぁぁぁぁぁぁッ！！", "face": "lf6eef03410c8"}, {"name": "魔神セーレ", "text": "おのれ……おのれぇ……ラン、ス……。", "face": "lf6eef03410c8"}, {"name": "魔神セーレ", "text": "…………。\n……………………。", "face": "lf6eef03410c8"}]}, {"trigger": "end", "lines": [{"name": "グリム", "text": "今度こそ、魂まで砕けましたねー。\nさすがにもう、復活はできないと思いますー。\n……たぶん。", "face": "u942"}, {"name": "シィル", "text": "ランス様！　やりました！\nぱちぱちぱち！", "face": "u2900a1"}, {"name": "ランス", "text": "がははは……はらほろ……。", "face": "u2897a1"}, {"name": "リア", "text": "ダーリン、大丈夫？　ねえ、ダーリン。", "face": "u2901a1"}, {"name": "ランス", "text": "……来るな。まだ呪いが……あ、いや。\n……何も起きんな？", "face": "u2897a1"}, {"name": "志津香", "text": "セーレが消えたから、呪いも解けたのよ。\nよかったわね、ランス。", "face": "u1759a1"}, {"name": "ランス", "text": "…………。", "face": "u2897a1"}, {"name": "ランス", "text": "がはははははは！　俺様、復活ー！！", "face": "u2897a1"}, {"name": "シルキィ", "text": "……はいはい。\nさあ、帰りましょう。門が閉じる前に。", "face": "u2902a1"}, {"name": "グリム", "text": "次元の狭間、崩れてきてますー。\n王国へ戻りますよー、皆さんこっちですー！", "face": "u942"}]}], "active": true}