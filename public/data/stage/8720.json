8000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133264, "race_id": 16, "master_id": 34629, "global_id": 8246}], "spawn_sec": 96}, {"enemy_id": 12, "source": "local", "count": 7, "form_index": 0, "form_count": 2, "tags": ["帝国"], "hp": 15000, "attack": 1850, "base_hp": 15000, "base_attack": 1850, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 75, "attack_interval": 226, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2164544, "race_id": 16, "change_to": 12, "change_condition": 3, "master_id": 39233, "global_id": 12850, "to_condition": 3, "to_global_id": 12851, "spawn_sec": 96}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["帝国"], "hp": 15000, "attack": 1050, "base_hp": 15000, "base_attack": 1050, "damage_type": "true", "armor_defense": 1500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 85, "attack_interval": 246, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2164560, "race_id": 16, "master_id": 39234, "global_id": 12851, "from_condition": 3}, {"enemy_id": 14, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "tags": ["機械", "帝国"], "hp": 10000, "attack": 560, "base_hp": 10000, "base_attack": 560, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 185, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2132992, "race_id": 16, "special_effect_id": 957, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34610, "global_id": 8227, "ranged": true, "spawn_sec": 198}], "popups": ["ベラートがいる間は\n全ての敵の攻撃力と\n防御力がアップします。", "帝国戦槌兵は\n体力が50％以下になると\n攻撃性能が変化します。"], "dialogue": [{"trigger": "enemy_death", "enemy_id": 4, "lines": [{"name": "ベラート", "text": "ぐはぁぁぁぁッ！？\nわ、我がパーフェクトベラートの装甲がぁ！？", "face": "lc1cc7aaf9a82"}, {"name": "伯爵領騎士", "text": "閣下、下がってください！\nここは我々が――", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "否ッ！！\n我が伯爵領には――奥の手があるッ！！", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "行きますぞ、皇帝陛下。\nこれこそが最強無敵の黄金戦車ッ！\n伯爵領が誇る最高戦力なりィ！！", "face": "lc1cc7aaf9a82"}]}, {"trigger": "start", "lines": [{"name": "ベラート", "text": "（……我が人生、果たして何を残すことができたのか）", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "（娘たちは皆嫁ぎ、孫の顔も見ることができた。\n男児には恵まれなかったが、\n末娘は館に残り、私を支えんとしてくれている）", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "（私腹を肥やし、人脈をつくり、\nおよそ伯爵家として想像しうる、\nありとあらゆる権益を貪りつくした！）", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "これ以上など、\n望むべきではないのかもしれない……か。", "face": "lc1cc7aaf9a82"}, {"name": "伯爵領騎士", "text": "何をおっしゃいますか、伯爵殿。\n伯爵領には閣下がこれからも必要なのですぞ。", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "何をいう、悪徳貴族という語を辞書で引くといい。\nそこには私の名が最初に載っていよう。", "face": "lc1cc7aaf9a82"}, {"name": "伯爵領騎士", "text": "閣下がどうしようもない腹黒で、\n底なしの野心家で、金と利権に\n目のない男だということくらい、領民は知っております。", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "……いや、そこまで言わんでも。", "face": "lc1cc7aaf9a82"}, {"name": "伯爵領騎士", "text": "窮地にはすぐに部下を切り捨てるし、\n汚い手段も涼しい顔をして選ぶし、\nおよそ帝国貴族にはふさわしくないお方だ。", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "…………。", "face": "lc1cc7aaf9a82"}, {"name": "伯爵領騎士", "text": "しかし、領民は幸せな生活を送っております。\n伯爵領は、帝国内でも指折りの豊かな領地です。\nそれもすべて、閣下の手腕があってこそ。", "face": "l36511b202f8c"}, {"name": "伯爵領騎士", "text": "決して、ここですべての責任を取って散ろう、\nなどとは思わんでください。", "face": "l36511b202f8c"}, {"name": "伯爵領騎士", "text": "皇帝の首を取れと命じてくだされば、\n我ら伯爵領に御恩ある騎士一同、\n閣下の代わりにいくらでも命を捧げましょう。", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "…………馬鹿ものどもめ。", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "せめて我が末娘と、領民、\nそして兵たちの家族の未来くらいは勝ち取ろう。", "face": "lc1cc7aaf9a82"}, {"name": "伯爵領騎士", "text": "おや、もっと甘い汁を、と望まれないので？", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "ふん。次は冥界で成り上がればよい。\nハイドース亡き冥界など、\n我々にかかればちょろいものよ！", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "――さぁ、白の皇帝よ！\n帝国法にのっとり、ここに決闘を申し込む！", "face": "lc1cc7aaf9a82"}, {"name": "白の皇帝", "text": "ああ、待っていたぞ伯爵。\nそちらが伯爵領の全軍で来るのなら――", "face": "u418"}, {"name": "ベラート", "text": "――うむ。\n帝国軍との戦いであれば望むところ。\n偽りの皇帝よ！　その首、ここに貰い受ける！！", "face": "lc1cc7aaf9a82"}]}, {"trigger": "end", "lines": [{"name": "ベラート", "text": "なっ……我が黄金戦車がぁ……！？", "face": "lc1cc7aaf9a82"}, {"name": "ダグマール", "text": "なるほど、黄金戦車の装甲を前に、\n通常兵器では苦戦することもあるでしょう。", "face": "u2402a1"}, {"name": "ダグマール", "text": "しかし、今の帝国軍には火力！\n火力があるのです！", "face": "u2402a1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "レオナ", "text": "陛下、勝負はつきました。\nベラート伯爵の沙汰は――", "face": "u2600a1"}, {"name": "白の皇帝", "text": "……ベラート。", "face": "u418"}, {"name": "ベラート", "text": "な、何ですかな、偽りの皇帝殿。", "face": "lc1cc7aaf9a82"}, {"name": "白の皇帝", "text": "貴様は、ここで諦めるような男だったか？\nもしそうであれば、期待外れだが……。", "face": "u418"}, {"name": "ベラート", "text": "ふっ……ふ……。", "face": "lc1cc7aaf9a82"}, {"name": "ベネー", "text": "ふ？", "face": "u2604a1"}, {"name": "ベラート", "text": "ふ、ふ、ふ、ふざけるなァッ！\n誰が潔く死んでなどやるものかァ！！", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "アンジェリーネ様が、\nヴィラヘルム様が貴様を認めようと！\n私はぜぇぇぇぇったいに！　貴様を認めんッ！！", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "我が黄金戦車よ！\n咆哮をあげよ！\n我が黄金の道は未だ途切れてはいないッ！！", "face": "lc1cc7aaf9a82"}, {"name": "サザンカ", "text": "……わぁ、すごい執念。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "金と名誉、欲望で生きてきた男だ。\n欲望というのはね、人が生きていく上で\n絶対に欠かせない、強い力であるわけで――", "face": "u1225a1"}, {"name": "メフィスト", "text": "うむ。ここからが本番のようだね。", "face": "u526"}]}, {"trigger": "route", "lines": [{"name": "伯爵領騎士", "text": "閣下のパーフェクトベラート装備が、耐えている！\n行ける、勝てるぞこの戦い！！", "face": "l36511b202f8c"}, {"name": "ベラート", "text": "攻撃の手を緩めるな！\n今こそ秘密兵器を繰り出す時ッ！！", "face": "lc1cc7aaf9a82"}, {"name": "ベラート", "text": "行きますぞ、皇帝陛下。\nこれこそが最強無敵の黄金戦車ッ！\n伯爵領が誇る最高戦力なりィ！！", "face": "lc1cc7aaf9a82"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 20, "params": [150]}, {"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 144000, "attack": 2400, "damage_type": "physical", "armor_defense": 1000, "pattern_id": 2133280}, {"enemy_id": 1, "form_index": 1, "hp": 144000, "attack": 2400, "damage_type": "physical", "armor_defense": 1000, "pattern_id": 2133280}, {"enemy_id": 1, "form_index": 2, "hp": 144000, "attack": 2400, "damage_type": "physical", "armor_defense": 1000, "pattern_id": 2133296}, {"enemy_id": 4, "form_index": 0, "hp": 45000, "attack": 1500, "damage_type": "physical", "armor_defense": 1400, "magic_defense": 40, "pattern_id": 2123472}, {"enemy_id": 4, "form_index": 1, "hp": 45000, "attack": 400, "damage_type": "physical", "armor_defense": 1400, "magic_defense": 40, "pattern_id": 2123456}, {"enemy_id": 7, "form_index": 0, "hp": 7500, "attack": 825, "damage_type": "physical", "armor_defense": 400, "pattern_id": 2155120}, {"enemy_id": 8, "form_index": 0, "hp": 3000, "attack": 525, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2102256}, {"enemy_id": 9, "form_index": 0, "hp": 3750, "attack": 720, "damage_type": "physical", "armor_defense": 250, "pattern_id": 2111792}, {"enemy_id": 10, "form_index": 0, "hp": 27000, "attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133056}, {"enemy_id": 12, "form_index": 0, "hp": 22500, "attack": 2775, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 5, "pattern_id": 2164544}, {"enemy_id": 12, "form_index": 1, "hp": 22500, "attack": 1575, "damage_type": "true", "armor_defense": 1500, "magic_defense": 5, "pattern_id": 2164560}, {"enemy_id": 14, "form_index": 0, "hp": 15000, "attack": 560, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2132992}]}, "active": true}