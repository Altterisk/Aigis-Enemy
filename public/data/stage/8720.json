{"quest_id": 8720, "name": "第十陣 伯爵の覚悟", "description": "覚悟を決めたベラート伯爵は帝国法に則り、\n白の皇帝が率いる帝国軍に決闘を申し込む。\n伯爵領の全軍との熾烈な戦いに勝利せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "帝国十陣", "event_category": "Empire", "mission_id": 940010, "map_no": 9432, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 3, "tags": ["機械", "帝国"], "hp": 96000, "attack": 2400, "base_hp": 96000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 1000, "attack_range": 300, "attack_wait": 200, "attack_interval": 461, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133280, "race_id": 16, "change_to": 1, "missile_id": 673, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34625, "global_id": 8242, "ranged": true, "to_condition": 0, "to_global_id": 8243}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械", "帝国"], "hp": 96000, "attack": 2400, "base_hp": 96000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 1000, "attack_range": 300, "attack_wait": 200, "attack_interval": 461, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133280, "race_id": 16, "special_effect_id": 958, "change_to": 2, "missile_id": 673, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34626, "global_id": 8243, "ranged": true, "from_condition": 0, "to_condition": 0, "to_global_id": 8244}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["機械", "帝国"], "hp": 96000, "attack": 2400, "base_hp": 96000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 1000, "attack_range": 300, "attack_wait": 200, "attack_interval": 461, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2133296, "race_id": 16, "special_effect_id": 958, "missil