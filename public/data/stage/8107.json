.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2144320, "special_effect_id": 1375, "master_id": 36168, "global_id": 9785, "commands": {"raw": "SetStageFlag(9, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 9, 1 );\");", "sets_flags": [[9, 0], [9, 1]], "on_destroy": true}, "spawn_sec": 112}, {"enemy_id": 20, "source": "local", "count": 8, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "commands": {"raw": "SetStageFlag(22, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 22, 1 );\");", "sets_flags": [[22, 0], [22, 1]], "on_destroy": true}, "spawn_sec": 184}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "commands": {"raw": "SetStageFlag(30, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 30, 1 );\");", "sets_flags": [[30, 0], [30, 1]], "on_destroy": true}, "spawn_sec": 210}, {"enemy_id": 22, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "commands": {"raw": "SetStageFlag(31, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 31, 1 );\");", "sets_flags": [[31, 0], [31, 1]], "on_destroy": true}, "spawn_sec": 210}], "popups": ["空飛ぶメカトナカイのおもちゃは\n攻撃力800以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "battle", "at_sec": 5, "lines": [{"name": "インテリデーモン", "text": "クククク……愚かなオルカ科学ラボめ。\n暴走装置入りと知らず、\n今頃呑気におもちゃを配っていることでしょう。", "face": "l815517a11268"}, {"name": "アエロ", "text": "空から発見！　見つけましたよデモシェフ商会！\nいえ、インテリデーモン！", "face": "u2004a1"}, {"name": "インテリデーモン", "text": "おや、王国軍の皆さまではありませんか。\n血相を変えて……どんなご用件で？", "face": "l815517a11268"}, {"name": "クルス", "text": "オルカ科学ラボの純正おもちゃを\n魔改造おもちゃにすり替えたのはあんたたちね！", "face": "u2006a1"}, {"name": "インテリデーモン", "text": "お……おやおや……、もうバレていましたか……ッ！\nこれは想定外の事態となりましたね……！", "face": "l815517a11268"}, {"name": "ブランシュ", "text": "さてと、お話はお縄についてから、\nたーっぷり聞かせてもらうわよ。", "face": "u2005a1"}, {"name": "インテリデーモン", "text": "は……ははは……ッ！　\nシャチどもがおもちゃをばら撒くせいで、\n我々の製品の売り上げががた落ちなのです！", "face": "l815517a11268"}, {"name": "インテリデーモン", "text": "クリスマス前後だけにしておけば許せたものの、\n毎日毎日配り歩き、迷惑甚だしい！", "face": "l815517a11268"}, {"name": "インテリデーモン", "text": "お陰様で減らぬ在庫の山を眺める毎日。\nこのままでは生産規模の縮小を余儀なくされる。\nそうすれば、どれ程の従業員が路頭に迷うことか！", "face": "l815517a11268"}, {"name": "インテリデーモン", "text": "我々だけではない！　\n多くのおもちゃ企業が迷惑を被っている！", "face": "l815517a11268"}, {"name": "インテリデーモン", "text": "市場崩壊を招く愚行、許すまじ！\n経済基礎を学んでから業界参入しなさい理系どもがァ！", "face": "l815517a11268"}, {"name": "マルティナ", "text": "なんて至極真っ当な理由……！　そうですわよね、\n経済の形成はどんな社会においても重要……。", "face": "u2003a1"}, {"name": "マルティナ", "text": "ですが、それはおもちゃを暴走させていい\n理由にはなりませんわ！　お覚悟くださいまし！", "face": "u2003a1"}]}, {"trigger": "battle", "at_sec": 63, "lines": [{"name": "シャチのギルマン", "text": "キュ！？　あれは我がラボの叡智の結晶、\n空飛ぶメカトナカイのおもちゃではないか！？", "face": "l9987c2f5a8b6"}, {"name": "ブランシュ", "text": "あのトナカイ、空から雪玉を発射してるわ！？\n当たったら絶対痛いじゃない！", "face": "u2005a1"}, {"name": "シャチのギルマン", "text": "気を付けるのだ王国軍！\nあれは機械仕掛けのおもちゃ。\n落下すれば爆発の可能性もあるキュ！", "face": "l9987c2f5a8b6"}]}, {"trigger": "end", "lines": [{"name": "インテリデーモン", "text": "クックック……まんまと罠にかかりましたね。あいてて。", "face": "l815517a11268"}, {"name": "クルス", "text": "罠、ですって……！？", "face": "u2006a1"}, {"name": "インテリデーモン", "text": "そう、私はいわばデコイ、囮なのですよ。\n一時的にターゲットの気を引き、本懐を遂げるための！", "face": "l815517a11268"}, {"name": "インテリデーモン", "text": "本隊は諸悪の根源へと向かっています。ククク……。\nシャチ共のおもちゃ工場は、どうなっていることやら……。", "face": "l815517a11268"}, {"name": "アエロ", "text": "どうしてひどいことをするんですか！？\n私の知ってるデモシェフ商会は、\n子供の夢を奪うようなことは絶対にしないですちゅん！", "face": "u2004a1"}, {"name": "インテリデーモン", "text": "ああ、デーモンシェフ様はお考えにならないでしょう。\nこれは全て、私が計画した事業立て直し極秘ミッション！", "face": "l815517a11268"}, {"name": "ブランシュ", "text": "あんたたち……！　\nこんなことしてデモシェフさんが喜ぶと思っているの！？", "face": "u2005a1"}, {"name": "インテリデーモン", "text": "私は私にできる方法で企業を守るのみ。\nそれが、魔界ズビジネスマンの鋼の忠誠！", "face": "l815517a11268"}, {"name": "アエロ", "text": "あ！　逃げましたですちゅん！\nふ、吹雪のせいで追えません……！", "face": "u2004a1"}, {"name": "マルティナ", "text": "デモシェフ商会のホワイトさは\n今宵の雪のようと存じておりますわ。", "face": "u2003a1"}, {"name": "マルティナ", "text": "されど、聖前夜を騒がすなど、何人たりとも許されません！\nさあ皆さま、然るべき対処を！", "face": "u2003a1"}, {"name": "アンナ", "text": "幸運なことに、彼らの目的はわかりました。\nこれ以上の被害を出さない為、\nオルカ科学ラボへと向かいましょう！"}]}], "active": true}