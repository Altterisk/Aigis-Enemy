{"quest_id": 8107, "name": "叡智の結晶、空飛ぶおもちゃ", "description": "オルカ科学ラボによる市場崩壊を憂い、\n暴走するインテリデーモンを倒せ！\n＜特定のタイミングで吹雪が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "聖夜のメカニカルおもちゃ戦線", "event_category": "History", "mission_id": 920207, "map_no": 4809, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 3000, "attack": 1, "base_hp": 3000, "base_attack": 1, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2148736, "special_effect_id": 70, "master_id": 36724, "global_id": 10341, "commands": {"raw": "SetStageFlag(101, 0); DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 101 , 1 );\");", "sets_flags": [[101, 0], [101, 1]], "on_destroy": true}}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 4, "tags": ["機械"], "hp": 12000, "attack": 1, "base_hp": 12000, "base_attack": 1, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_wait": 60, "attack_interval": 224, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120704, "race_id": 2, "special_effect_id": 242, "change_to": 2, "missile_id": 415, "missile": {"speed": 10.0, "splash": 120}, "master_id": 36725, "global_id": 10342, "to_global_id": 10363, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag( 111 , 1 );\");", "sets_flags": [[111, 1]], "on_destroy": true}, "route_behaviour": {"sets_flags": [[111, 1, 2], [112, 1, 2], [113, 1, 2]]}}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["機械"], "hp": 12000, "attack": 1, "base_hp": 12000, "base_attack": 1, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_wait": 60, "attack_interva