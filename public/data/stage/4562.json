o": 4, "change_condition": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 325, "global_id": 324, "ranged": true, "variants": [{"tags": ["アーマー"], "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 194, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103856, "master_id": 326, "global_id": 325}], "spawn_sec": 13}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 1, "attack_wait": 1, "attack_interval": 38, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105696, "special_effect_id": 222, "master_id": 724, "global_id": 723, "spawn_sec": 42}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104592, "special_effect_id": 235, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 722, "global_id": 721, "ranged": true, "spawn_sec": 94}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 150, "base_hp": 2800, "base_attack": 150, "damage_type": "magical", "armor_defense": 700, "magic_defense": 40, "attack_range": 110, "attack_speed": 90, "attack_wait": 10, "attack_interval": 59, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105728, "special_effect_id": 222, "missile_id": 158, "missile": {"speed": 6.0, "splash": 93}, "master_id": 731, "global_id": 730, "ranged": true, "spawn_sec": 98}], "dialogue": [{"trigger": "start", "lines": [{"name": "暗黒騎士デシウス", "text": "新たな英霊を見つけはしたが……違う。\nこれではないのだ……我輩が求める魂は……。", "face": "la8e17ee8dc36"}, {"name": "レシア", "text": "ようやく見つけたぞ、デシウス！\nこれ以上の蛮行を許しはしない……。\n悪いが、ここで決着をつけさせてもらうぞ。", "face": "u358"}, {"name": "暗黒騎士デシウス", "text": "しつこいやつらだ。\nなぜ我輩の邪魔をする？\nなぜ我輩が強くなりたいと思う意志を阻むのだ？", "face": "la8e17ee8dc36"}, {"name": "レシア", "text": "強くありたいというその心意気は認めよう。\nだが、そのやり方が間違っているのだ。", "face": "u358"}, {"name": "暗黒騎士の手下", "text": "何も知らないくせに、勝手なことを言うな！\n団長の正しさは、自分が証明してみせる……。\n団長、私に英霊の力をお与え下さい。", "face": "l7fd7fe66ea49"}, {"name": "暗黒騎士デシウス", "text": "よし、お前にはこの魂を授けよう。\nこの力を使って、王子たちを倒すのだ！", "face": "la8e17ee8dc36"}, {"name": "暗黒騎士の手下", "text": "あ、ぐッ……おぉぉぉおッ！？\nち、力が……魔力が溢れてきます。\nこ、これはまさか『コキュートス』！！", "face": "l7fd7fe66ea49"}, {"name": "デスピア", "text": "――『コキュートス』！？\n私の最高位魔法をあんなやつが……？", "face": "u1049"}, {"name": "デスピア", "text": "……いいでしょう。\n最強の魔女を目指す私への挑戦状ですね。\n誰であろうと容赦はしない。", "face": "u1049"}, {"name": "アンナ", "text": "またも英霊の魂を利用するなんて……。\n王子、敵は新たな力を身につけています。\n細心の注意を払いつつ、戦いに臨んで下さい！", "face": "l8f152b1c44c6"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士の手下", "text": "負け、ですか……しかし、後悔などありません。\n一瞬でも、私は『コキュートス』を我が力とし、\n存分に、振るうことができたの……ですから……。", "face": "l7fd7fe66ea49"}, {"name": "デスピア", "text": "……理解に苦しみます。\nそれは力ではなく、英霊たちの記憶……。\n私は、自分の力で最強を勝ち取ってみせます。", "face": "u1049"}, {"name": "暗黒騎士デシウス", "text": "くそっ……。\n英霊たちの力を得て、どうして勝てない……？", "face": "la8e17ee8dc36"}, {"name": "レシア", "text": "観念しろ、デシウス。\n貴様の力への求道は、その進路を誤っている。\n果てには空虚しかないと分かっているだろう？", "face": "u358"}, {"name": "暗黒騎士デシウス", "text": "黙れ、英霊の守り手風情が言葉を向けるな！\n貴様らとの会話こそ虚言よ。\nさらばだッ――！！", "face": "la8e17ee8dc36"}, {"name": "レシア", "text": "退路を確保していたか……。\nだが奴らの戦力も大分削がれている。\n追撃を続行し、このまま追い詰めるぞ！", "face": "u358"}, {"name": "アンナ", "text": "分かりました！\n王子、レシアさんと共に、\nデシウスの後を追いましょう！", "face": "l8f152b1c44c6"}]}], "active": true}