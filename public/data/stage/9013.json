armor_defense": 200, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 133, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100592, "race_id": 10, "special_effect_id": 232, "missile_id": 44, "missile": {"speed": 8.0}, "master_id": 270, "global_id": 269, "ranged": true, "spawn_sec": 49}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 2000, "base_hp": 20000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 321, "global_id": 320, "spawn_sec": 67}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 2500, "base_hp": 30000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "special_effect_id": 222, "master_id": 20000, "global_id": 1075, "spawn_sec": 96}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 1, "hp": 20000, "attack": 700, "base_hp": 20000, "base_attack": 700, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 50, "attack_interval": 111, "move_speed": 400.0, "dot_rate": 1.5, "pattern_id": 2104256, "race_id": 14, "special_effect_id": 230, "master_id": 516, "global_id": 515, "spawn_sec": 126}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 1200, "base_hp": 40000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 50, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104224, "race_id": 14, "special_effect_id": 231, "master_id": 514, "global_id": 513, "spawn_sec": 168}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "ゴモモモモ！！\nオマエたちだな……。\n可愛い弟を倒したのは！", "face": "l3e3b29fec0ee"}, {"name": "シュウカ", "text": "弟？　可愛い？\n誰の事を言っている。\nそんなやつ見たことがない！！", "face": "u179"}, {"name": "シャオ", "text": "シュウカ様。\nそれって前に倒した\n黒い牛頭の魔物では？", "face": "u180"}, {"name": "牛頭の魔物（兄）", "text": "オマエたち絶対に許さん！\n跡形もなくなるまで\nぶっ潰してくれるっ！！", "face": "l3e3b29fec0ee"}, {"name": "シュウカ", "text": "復讐にかられた者は、\n周りが見えなくなってしまうのは\n良く知っている……。", "face": "u179"}, {"name": "シュウカ", "text": "改めてあなたたちの力を借りたい。\n私は復讐者ではなく、\n一人の将として戦いたい。", "face": "u179"}]}, {"trigger": "battle", "at_sec": 124, "lines": [{"name": "牛頭の魔物（兄）", "text": "潰す！　叩き潰す！\n弟の仇をオレがぁッ！！！！", "face": "l3e3b29fec0ee"}, {"name": "シュウカ", "text": "妖術で発生した影を消すには\n弟の時と同じく、本体を叩けばいいはずだ。\nやつに集中攻撃だ！", "face": "u179"}]}, {"trigger": "end", "lines": [{"name": "シュウカ", "text": "勝った……。", "face": "u179"}, {"name": "シュウカ", "text": "追っ手を指揮していたのは\nあの魔物だったのだろう。\nひとまずは安心といった所か。", "face": "u179"}, {"name": "シュウカ", "text": "あなた方のおかげで国を滅ぼした\n魔物を倒し、復讐という悪しき心に\nも打ち克つことができた。", "face": "u179"}, {"name": "シュウカ", "text": "あなた方と出会えてよかった。\n心から礼を言う。", "face": "u179"}, {"name": "シュウカ", "text": "……ありがとう。", "face": "u179"}, {"name": "シャオ", "text": "シュウカ様……。", "face": "u180"}, {"name": "アンナ", "text": "魔物に人生を狂わされても、\nこうして救うことができて\nよかったですね、王子……。"}]}], "story_talk": true, "active": true}