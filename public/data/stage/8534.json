{"quest_id": 8534, "name": "祝祭を彩る模擬戦と猫", "description": "祝祭のメインイベント模擬戦で武威を示せ！\n＜天界（弱）：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["天界（弱）：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復"], "event": "ぴょんぴょんキャットパニック", "event_category": "History", "mission_id": 920229, "map_no": 9328, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -70]}, {"kind": "term", "influence": 41, "params": [0, 60, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 10, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 72000, "attack": 1550, "base_hp": 72000, "base_attack": 1550, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 260, "attack_speed": 1, "attack_wait": 70, "attack_interval": 213, "move_speed": 1250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2160176, "race_id": 12, "special_effect_id": 2054, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 38708, "global_id": 12325, "ranged": true, "spawn_sec": 47}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 86000, "attack": 2400, "base_hp": 86000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 15, "attack_speed": 1, "attack_wait": 30, "attack_interval": 102, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2160192, "race_id": 16, "special_effect_id": 639, "master_id": 38709, "global_id": 12326, "spawn_sec": 47}, {"enemy_id": 3, "source": "local", "count": 1, "form_co