624, "race_id": 11, "master_id": 36232, "global_id": 9849, "spawn_sec": 192}, {"enemy_id": 16, "source": "local", "count": 6, "form_count": 1, "tags": ["鳥"], "hp": 8000, "base_hp": 8000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 1, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2144640, "race_id": 11, "master_id": 36233, "global_id": 9850, "spawn_sec": 194}, {"enemy_id": 17, "source": "local", "count": 10, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "attack_range": 40, "attack_speed": 60, "attack_wait": 15, "attack_interval": 71, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111744, "race_id": 13, "special_effect_id": 191, "missile_id": 45, "master_id": 30621, "global_id": 4240, "ranged": true, "spawn_sec": 208}, {"enemy_id": 18, "source": "local", "count": 7, "form_count": 2, "hp": 30000, "attack": 800, "base_hp": 30000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 20, "attack_interval": 91, "move_speed": 300.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116208, "race_id": 13, "change_to": 18, "change_condition": 2, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 31316, "global_id": 4935, "ranged": true, "to_condition": 2, "to_global_id": 4936, "spawn_sec": 261}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 3000, "base_hp": 20000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 150, "attack_wait": 20, "attack_interval": 256, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2116224, "race_id": 13, "master_id": 31317, "global_id": 4936, "from_condition": 2}, {"enemy_id": 20, "source": "local", "count": 7, "form_count": 1, "tags": ["鳥"], "hp": 3200, "attack": 300, "base_hp": 3200, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_range": 130, "attack_speed": 1, "attack_wait": 3, "attack_interval": 49, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123008, "race_id": 12, "special_effect_id": 234, "missile_id": 474, "missile": {"speed": 10.0}, "master_id": 32635, "global_id": 6253, "ranged": true, "spawn_sec": 268}], "popups": ["\n\n\n　　――エッグパーティ当日", "　　　　【天界(弱)】\n・味方攻撃力が最終値から-70。\n・アンデッド、デーモン系を除く\n　味方、敵ユニットの\n　HPが徐々に回復。\n※これらは、風水使いなどがもつ\n　地形効果を軽減する能力では\n　軽減できません。", "エクスがいる間は\n全ての敵のHPが\n徐々に回復します。\n\nまた、エクスの\n周囲にいる敵は\n防御力が上昇します。", "天界では、時間経過によって\n雲の足場が出現する\nことがあります。\n\n出現した雲の足場には、\n遠距離ユニットを\n配置できるようになります。", "グリフィンは一定確率で\n物理攻撃を回避します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――エッグパーティ当日"}, {"name": "リュティエ", "text": "それで結局、キャスパリーグはどうなったの？", "face": "u2418a1"}, {"name": "エクス", "text": "完全にジタリスさんをお母さんだと思っているようで、\n人を襲ったりすることもなく、むしろ番犬……番猫？\nといった感じで鳥人の里を守ってくれていますよ。", "face": "u2417a1"}, {"name": "ジタリス", "text": "ただあの子は、\n模擬戦が大好きになっちゃったみたいで――", "face": "u2416a1"}, {"name": "シュシュ", "text": "これより、エッグパーティのメインイベント、\n王国軍を交えての模擬戦をとりおこないまーす！", "face": "u656"}, {"name": "リュティエ", "text": "おっと、そろそろ出番だ！\nみんな、かっこいいところみせるよ！", "face": "u2418a1"}, {"name": "ジタリス", "text": "えぇ、分かりましたっ。\nうふふっ、リュティエさんとエクスさんと、\n一緒に戦えて、嬉しいですっ！", "face": "u2416a1"}, {"name": "ジタリス", "text": "ほら、今回の騒動では、\nおふたりと戦ってばかりでしたから……。", "face": "u2416a1"}, {"name": "リュティエ", "text": "そういえばそうだっけ。\nなら、ボクもジタリスと一緒に戦えて嬉しいよ！", "face": "u2418a1"}, {"name": "エクス", "text": "ふふっ、それは私も同じですよ。\nでは私たちで、王子様たちに挑みましょうか！", "face": "u2417a1"}]}, {"trigger": "battle", "at_sec": 170, "lines": [{"name": "キャスパリーグ", "text": "――ンニャっ♪　ニャアーーン♪", "face": "l0ef8479eba19"}, {"name": "エクス", "text": "キャスパリーグ……！？\nそれに猫の魔物たちまで……！", "face": "u2417a1"}, {"name": "ジタリス", "text": "どうやら、また遊んでもらいたくて\nここまで来たみたいですね。", "face": "u2416a1"}, {"name": "ジタリス", "text": "とはいえ今は模擬戦の最中ですし、\nこの子の相手をしてあげられるかは……。", "face": "u2416a1"}, {"name": "王子", "text": "…………（にこにこ）", "face": "u1"}, {"name": "リュティエ", "text": "うん、さすが王子！\nキャスパリーグが来ても問題ないってさ！", "face": "u2418a1"}, {"name": "キャスパリーグ", "text": "クルルルル♪　ニャオーーンッ♪", "face": "l0ef8479eba19"}, {"name": "ジタリス", "text": "うふふっ、この子ったら王子様が大好きみたいですね。\nはやく遊んで欲しいって言っているみたいですっ。", "face": "u2416a1"}, {"name": "リュティエ", "text": "なら満足させてあげないとね！\nキャスパリーグたちの相手も頼んだよ！", "face": "u2418a1"}]}, {"trigger": "end", "lines": [{"name": "キャスパリーグ", "text": "ニャアっ♪　ンニャァーーっ♪", "face": "l0ef8479eba19"}, {"name": "エクス", "text": "キャスパリーグたちも満足したようですし、\n模擬戦はここまでですわね。", "face": "u2417a1"}, {"name": "リュティエ", "text": "可愛い猫の魔物さんたちも間近で見れたし、\n最高の一時だったよ！", "face": "u2418a1"}, {"name": "ジタリス", "text": "そうですね……あっ！駄目ですよっ。\nまた卵飾りを持っていったら！", "face": "u2416a1"}, {"name": "キャスパリーグ", "text": "ニャァン……。", "face": "l0ef8479eba19"}, {"name": "エクス", "text": "キャスパリーグは本当に卵飾りが気に入ったのですね。\n今は祝祭の最中ですから渡せませんが、\n終わったら卵をいくつかあげましょうか。", "face": "u2417a1"}, {"name": "キャスパリーグ", "text": "ニャアっ♪　ニャァアンっ♪", "face": "l0ef8479eba19"}, {"name": "リュティエ", "text": "とっても嬉しそうだね。\nそれにジタリスの言うこともちゃんと聞いてるし、\nこの子が悪さをすることは、なさそうだね。", "face": "u2418a1"}, {"name": "ジタリス", "text": "もちろん私たちが、\n都市を滅ぼすような怪物にならないよう、\nしっかり面倒を見る必要はありますが……。", "face": "u2416a1"}, {"name": "キャスパリーグ", "text": "ニャァン♪", "face": "l0ef8479eba19"}, {"name": "王子", "text": "…………（なでなで）", "face": "u1"}, {"name": "ジタリス", "text": "こうして王子様と仲良くしている姿を見ると、\nきっとこの子は大丈夫だって、そう思うんです。", "face": "u2416a1"}, {"name": "リュティエ", "text": "うん、そうだね。\n悪さをしたご先祖さまとは別の子だもん。\n同じようになるとは限らないよ。", "face": "u2418a1"}, {"name": "ジタリス", "text": "えぇ、絶対に。\n私が主治医として、そして親代わりとして、\n怪物にならないように面倒を見ます。", "face": "u2416a1"}, {"name": "ジタリス", "text": "だから今は、この子も含めて、\nエッグパーティを楽しみましょう♪", "face": "u2416a1"}]}], "active": true}