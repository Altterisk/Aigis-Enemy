{"quest_id": 7096, "name": "深海の御使い", "description": "深海に暗躍する強大な天使を退けよ！\n＜深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "真夏のロスト・バカンス", "event_category": "History", "mission_id": 920147, "map_no": 5718, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "tags": ["水中"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 5, "attack_interval": 60, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2123616, "race_id": 7, "master_id": 32682, "global_id": 6300, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "magical", "armor_defense": 150, "attack_range": 200, "attack_speed": 70, "attack_wait": 25, "attack_interval": 83, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100640, "race_id": 16, "special_effect_id": 225, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 274, "global_id": 273, "ranged": true, "spawn_sec": 20}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 3, "tags": ["ブロック不可", "狙う", "水中"], "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "physical", "armor_defense": 700, "magic_defense": 5, "attack_range": 80, "attack_speed": 1, "attack_wait": 180, "attack_interval": 404, "move_speed": 300.0, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "patt