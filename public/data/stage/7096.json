_id": 222, "missile_id": 26, "master_id": 352, "global_id": 351, "ranged": true, "spawn_sec": 52}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "tags": ["水中"], "hp": 25000, "attack": 1600, "base_hp": 25000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 150, "attack_interval": 358, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123680, "race_id": 7, "master_id": 32684, "global_id": 6302, "spawn_sec": 84}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["水中"], "hp": 120000, "attack": 1000, "base_hp": 120000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 60, "attack_range": 80, "attack_interval": 79, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2123664, "race_id": 6, "special_effect_id": 553, "missile_id": 45, "master_id": 32683, "global_id": 6301, "ranged": true, "spawn_sec": 120}], "popups": ["ギガエルがいる間は、\n魚人を含む水棲の魔物の\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――やれやれ、何事かと思えば。\n所詮は魚人、足止めにもならなかったか。", "face": "lfc9c40764bd1"}, {"name": "ローザ", "text": "……何者ですか、と問うまでもなさそうですね。\nあなたが天使ギガエル……襲撃の主犯ですか。", "face": "u1040a1"}, {"name": "ギガエル", "text": "ほう、人の子にしては頭が回るものよ。\nだが知恵のある有象無象は、極めて目障りだ。", "face": "lfc9c40764bd1"}, {"name": "ギガエル", "text": "クラールフも、神殿に民をかくまい、\n結界を展開して隠れる始末……。", "face": "lfc9c40764bd1"}, {"name": "ギガエル", "text": "かつての主であれば、最前線に立っていたというのに。\nあの蛮勇をいったいどこに忘れてしまったのか。", "face": "lfc9c40764bd1"}, {"name": "人魚の大使", "text": "……かつての、主？\n何を言っているんですか？", "face": "u1118a1"}, {"name": "ギガエル", "text": "クラールフから聞いていないのかね。\nかつての主、クラールフは、\n深海の民を生み出した折に、私を創造したのだ。", "face": "lfc9c40764bd1"}, {"name": "ギガエル", "text": "あまねく海に生きる民は、\nあやつが神の一柱だった頃の被造物なのだよ。\nそして私は、それを補佐すべく作られた天使だ。", "face": "lfc9c40764bd1"}, {"name": "ギガエル", "text": "だがそれも、『神の楔』を生み出す権能を奪われ、\nクラールフめが天界を追放されるまでのこと。\n今や私は、より大いなる力に抱かれている。", "face": "lfc9c40764bd1"}, {"name": "ミルノ", "text": "堕ちる前の天使とは、神の兵器のようなもの。\nただクラールフから、別の存在へ\n所有権が移っただけのことではありませんか。", "face": "u838"}, {"name": "ギガエル", "text": "堕ちた天使には、この愛が分からぬか……。\nまぁよい、いずれお前たちにも、\n深海と同じく攻撃を仕掛けるつもりだったのだ。", "face": "lfc9c40764bd1"}, {"name": "ギガエル", "text": "何しろ、世界樹の魔物化だけで、\nお前たちの歩みを止められるとは思っていないからな。", "face": "lfc9c40764bd1"}, {"name": "ギガエル", "text": "――さぁ、深海にて滅び、その身を藻屑と化すが良い。\n我が名はギガエル、海の命を司る天使なり。", "face": "lfc9c40764bd1"}]}, {"trigger": "battle", "at_sec": 131, "lines": [{"name": "ローザ", "text": "王子、魚人たちの様子がおかしいです。\nギガエルが姿を見せてから、\n動きがさらに活発になっています！", "face": "u1040a1"}, {"name": "アウローラ", "text": "確か、海の命を司る、と言っていましたね。\nあの天使が魚人に祝福を与えているのかもしれません。", "face": "u1035a1"}, {"name": "ギガエル", "text": "怯える必要はない、人の子よ。\n天界で何が起きているのか、\nそれすら知らぬままに、深海に消えていくがよい。", "face": "lfc9c40764bd1"}]}, {"trigger": "end", "lines": [{"name": "ギガエル", "text": "……私の祝福を受けた魚人を、倒した、だと？", "face": "lfc9c40764bd1"}, {"name": "ギガエル", "text": "なるほど……ガリウスを討ち果たしたのは、\n三女神の力によるものだと思っていたが……。\nこれはどうやら、考えを改めた方が良さそうだな。", "face": "lfc9c40764bd1"}, {"name": "ギガエル", "text": "――兵を退け。\nまずは我が主に、この事実を報告せねばならん。", "face": "lfc9c40764bd1"}, {"name": "ギガエルの配下", "text": "……は、はっ！！　ギガエル様！！\n撤退だ！　撤退するぞ！！", "face": "l25a1785c88ad"}, {"name": "アンナ", "text": "……ギガエル、魚人の軍勢、撤退していきます。", "face": "ld56c815f1cd5"}, {"name": "人魚の大使", "text": "わ、私！　皆の無事を確認してきます！！", "face": "u1118a1"}, {"name": "アウローラ", "text": "あっ、私もついていきます。\n怪我人がいるかもしれませんし。\nエリアスも手を貸してください。", "face": "u1035a1"}, {"name": "エリアス", "text": "はいっ！　それから衛兵の方々もこちらへ！\n応急処置程度ですが、手当しますから。", "face": "u1039a1"}, {"name": "ローザ", "text": "いったい、天界で何が起きているというのでしょうか。\nまさか深海にまで、天使の手が伸びているなんて。", "face": "u1040a1"}, {"name": "アンナ", "text": "分かりません……。\nですが、アイギス様たちが力を失っている今でも、\n天使たちが暗躍しているということは……。", "face": "lab9dbca76d69"}, {"name": "ローザ", "text": "――天使を配下に従えるほどの存在が、\n未だ天界で、何かを企んでいるということですね。", "face": "u1040a1"}, {"name": "ローザ", "text": "王子、ひとまず神殿の奥へ向かいましょう。\nクラールフ殿なら、何か知っているかもしれません。", "face": "u1040a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}