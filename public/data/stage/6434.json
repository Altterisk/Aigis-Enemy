"hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 8, "master_id": 986, "global_id": 985, "to_global_id": 987, "spawn_sec": 19}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 7, "master_id": 988, "global_id": 987}, {"enemy_id": 10, "source": "local", "count": 34, "form_count": 1, "tags": ["スライム"], "hp": 1600, "attack": 300, "base_hp": 1600, "base_attack": 300, "damage_type": "magical", "armor_defense": 1600, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097296, "master_id": 22, "global_id": 21, "spawn_sec": 75}, {"enemy_id": 11, "source": "local", "count": 22, "form_count": 1, "tags": ["スライム"], "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097456, "master_id": 10, "spawn_sec": 88}, {"enemy_id": 12, "source": "local", "count": 7, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 5, "master_id": 796, "global_id": 795, "to_global_id": 484, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 133}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 6, "master_id": 485, "global_id": 484, "to_global_id": 625}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 5, "master_id": 626, "global_id": 625}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "あれは――スライムと魔界蟻！\nそれも、あんな大量に群れているなんて。", "face": "l0a243861aec8"}, {"name": "ジョヴァンニ", "text": "おいおい、こいつはヤベえんじゃねえか？\nあんな大群、一匹ずつ対処してたんじゃ\nそのうち数で押し切られちまうぞ。", "face": "u611"}, {"name": "レーレン", "text": "そういう時こそ、\n広い範囲を一気に焼き尽くす魔法を得意とする\n魔術師の出番だぜ！", "face": "u614"}, {"name": "メーリス", "text": "で、でも、さすがに私一人じゃ……。", "face": "u609"}, {"name": "レーレン", "text": "大丈夫！　\n前線は王子たちが守ってくれるから。な、王子？", "face": "u614"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "王子！？\nいつの間にレーレンさんと\n目線で対話するほどの仲に……？", "face": "l0a243861aec8"}, {"name": "メーリス", "text": "……うん、わかったわ。\n敵の進行を止める役目は、王子たちに任せたわよ！", "face": "u609"}, {"name": "メーリス", "text": "魔術師の私が果たすべき役割は、\n敵の大群を一気に焼き払うこと……。", "face": "u609"}, {"name": "メーリス", "text": "……ふふっ、それって最高に燃えるじゃない！", "face": "u609"}]}, {"trigger": "end", "lines": [{"name": "メーリス", "text": "……ふぅ。あー、気持ちよかった♪\n同じ魔法でも、使い方次第でさらに効果が上がるのね。", "face": "u609"}, {"name": "レーレン", "text": "うむ、さすがは私の教え子。飲み込みが早いぜ！\n……ん？　誰だ、あの怪しい黒ヒゲのおっさんは？", "face": "u614"}, {"name": "メーリス", "text": "ぎくっ……怪しい黒ヒゲって、もしかして――", "face": "u609"}, {"name": "サイラス", "text": "はぁ、はぁ……こら、メーリス！\n魔術の講義をサボってどこに行ったかと思えば、\nこんな所で油を売っておったとは……。", "face": "u13"}, {"name": "メーリス", "text": "ご、ごめんなさい。\n学園の体験授業が思ったより長引いちゃって……。", "face": "u609"}, {"name": "レーレン", "text": "わ、私からも謝るぜ。\nメーリスを課外授業に連れ出したのは私だからな。", "face": "u614"}, {"name": "サイラス", "text": "な……そうだったのか。\nどなたかは存じ上げないが、危険を伴う指導の際には\nメーリスの師である私に一言通していただきたい。", "face": "u13"}, {"name": "メーリス", "text": "待って、レーレン先生は悪くないの！\n課外授業の延長は私がお願いしたことなんだから。", "face": "u609"}, {"name": "メーリス", "text": "それに、その……すっごく為になる授業だったし……。", "face": "u609"}, {"name": "サイラス", "text": "……まぁ、学ぶ意志があること自体は良いことだ。\n今回のところは大目に見るとしよう。", "face": "u13"}, {"name": "ジョヴァンニ", "text": "おう、難しい話は終わったか？\nそんじゃ、今後もよろしく頼むぜ、\nレーレン先生よぉ！", "face": "u611"}, {"name": "レーレン", "text": "もちろんだぜ！\n次はもっと面白い授業をするから、期待しとけよ～？\nそんじゃ、今度こそ解散っ！", "face": "u614"}, {"name": "ネーニャ", "text": "またね～！　ばいば～い！", "face": "u610"}, {"name": "アンナ", "text": "ふふっ……レーレンさん、\nもう未来の生徒たちの支持を得ているようです。\n講師としての正式な就任が待たれますね。"}, {"name": "ケイティ", "text": "（ですが、先ほどの授業は我々がいなければ危険でした。\n今後も彼女の授業には監督が必要そうですね……）", "face": "u114"}]}], "story_talk": true, "active": true}