 "race_id": 16, "special_effect_id": 2200, "missile_id": 45, "master_id": 39223, "global_id": 12840, "ranged": true, "spawn_sec": 3}, {"enemy_id": 12, "source": "local", "count": 28, "form_count": 1, "tags": ["アンデッド"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 150, "attack_interval": 535, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2146288, "race_id": 16, "special_effect_id": 1484, "master_id": 36448, "global_id": 10065, "spawn_sec": 74}, {"enemy_id": 13, "source": "local", "count": 24, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 1200, "base_hp": 6000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 70, "attack_speed": 70, "attack_wait": 150, "attack_interval": 425, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2146304, "race_id": 16, "special_effect_id": 1486, "master_id": 36450, "global_id": 10067, "spawn_sec": 115}, {"enemy_id": 14, "source": "local", "count": 8, "form_count": 1, "hp": 21000, "attack": 200, "base_hp": 21000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2149264, "special_effect_id": 1599, "change_to": 14, "change_condition": 1, "master_id": 36791, "global_id": 10408, "variants": [{"hp": 21000, "attack": 200, "base_hp": 21000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2149376, "special_effect_id": 1597, "master_id": 36792, "global_id": 10409}], "spawn_sec": 120}, {"enemy_id": 16, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111632, "race_id": 11, "special_effect_id": 233, "master_id": 30613, "global_id": 4232, "spawn_sec": 135}, {"enemy_id": 17, "source": "local", "count": 14, "form_count": 1, "tags": ["アンデッド"], "hp": 4000, "attack": 800, "base_hp": 4000, "base_attack": 800, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111904, "race_id": 12, "special_effect_id": 233, "master_id": 30633, "global_id": 4252, "spawn_sec": 162}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 1, "hp": 36000, "attack": 400, "base_hp": 36000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149264, "special_effect_id": 1599, "change_to": 18, "change_condition": 1, "master_id": 36798, "global_id": 10415, "variants": [{"hp": 36000, "attack": 400, "base_hp": 36000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149376, "special_effect_id": 1597, "master_id": 36799, "global_id": 10416}], "spawn_sec": 182}], "popups": ["くまさん人形は起き上がると\n一定範囲内のユニットの\n攻撃力と防御力を\n70％ダウンさせます。\n\nまた複数のくまさん人形による\nこの効果は重複しません。", "チェインソン男は倒されると、\nその場で復活します。\n復活は２回まで行われます。\n\n１回目の復活後の\nチェインソン男から\n攻撃を受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "battle", "at_sec": 5, "lines": [{"name": "ミリアム", "text": "――ずっと思っていたのですが、\nベアッカさんの武装、すごいことになっていますね。", "face": "u2593a1"}, {"name": "ニコル", "text": "一見すると可愛いクマさんの仮装だけど、\n色々物騒なものがついてるよねー。", "face": "u2592a1"}, {"name": "ベアッカ", "text": "そ、そうかなぁ？\n物騒なものなんて、チェーンソーくらいだよ？", "face": "u2591a1"}, {"name": "ニコル", "text": "それが一番物騒なんだけどねぇ。\nでも破壊力がありそうでいいと思うよ。", "face": "u2592a1"}, {"name": "ミリアム", "text": "ですが偵察兵の私としては、騒音が気になります。\n威力は申し分なさそうですが、\n音に釣られて魔物がよってきそうで――", "face": "u2593a1"}, {"name": "チェインソン男", "text": "――で、俺が来たってわけ！", "face": "l2ee2e2041d15"}, {"name": "ニコル", "text": "きゃあぁぁぁっ！　おばっ、おばけっ！？\nチェーンソーのおばけぇぇえっ！？", "face": "u2592a1"}, {"name": "チェインソン男", "text": "チェーンソッソッソォ！！　俺はおばけじゃないぜェ！！\nチェーンソーの気配と音に釣られてやってきた、\nただのチェインソン男だぜェ！！", "face": "l2ee2e2041d15"}, {"name": "ニコル", "text": "な、なんだ……ただのチェインソン男か……。\nまったく、驚かせてくれちゃって……。", "face": "u2592a1"}, {"name": "ミリアム", "text": "あの……ただのチェインソン男も、\n驚くに値するおかしな存在だと思うのですが……。", "face": "u2593a1"}, {"name": "ベアッカ", "text": "そんなことより、チェインソン男さんはなにをしに来たの？\n少し早いけど、ハロウィンを楽しみに来たとか？", "face": "u2591a1"}, {"name": "チェインソン男", "text": "ああ！　今回のハロウィンは\nカボチャとカブが暴れてたからよォ！\n俺も派手に楽しみに来たぜェ！", "face": "l2ee2e2041d15"}, {"name": "チェインソン男", "text": "そう――ハロウィンという名の暴力の祭典をなァ！！", "face": "l2ee2e2041d15"}, {"name": "ベアッカ", "text": "暴力なんてダメだよー！\nハロウィンは楽しいお祭りなんだから、\n誰かを傷つけるのはいけないんだよー！", "face": "u2591a1"}, {"name": "チェインソン男", "text": "……暴力の祭典は言葉選びを間違えたぜ！\n楽しい模擬戦で王国のハロウィンを盛り上げたい、\nって言いたかったんだぜ！！", "face": "l2ee2e2041d15"}, {"name": "ベアッカ", "text": "うーん、模擬戦ならいっか！", "face": "u2591a1"}, {"name": "チェインソン男", "text": "じゃあ合意を得れたことだし……。\n喰らえッ！　デスハロウィン洗脳ビームッ！！", "face": "l2ee2e2041d15"}, {"name": "ベアッカ", "text": "あばばばばばばば！？", "face": "u2591a1"}, {"name": "ベアッカ", "text": "ベアァー！！\nトリック・オア・くまさん！\nトリック・オア・くまさん！", "face": "u2591a1"}, {"name": "ニコル", "text": "言いくるめたんだから洗脳する必要はなかったよね！？", "face": "u2592a1"}, {"name": "アンナ", "text": "シャルロットさん！　あれは洗脳ですか！？", "face": "l7cf7d585f00f"}, {"name": "シャルロット", "text": "洗脳ですわ！！", "face": "u128"}, {"name": "ニコル", "text": "確認を取らなくても分かり切ってる……。\nいやもう、ツッコミどころが多すぎるよ！？", "face": "u2592a1"}, {"name": "ミリアム", "text": "まさか、カボチャとカブ以上に\nわけのわからない存在がいるとは思いませんでした……。", "face": "u2593a1"}, {"name": "ニコル", "text": "と、とりあえずベアッカを落ち着かせて……。\nそれとチェインソン男を早く倒そう！\nこれ以上はニコルちゃんじゃ処理できない！", "face": "u2592a1"}, {"name": "チェインソン男", "text": "さぁ、ハロウィンの時間だぜ！！\n３、２、１、ことよろォォォォォッッ！！\nそしてトリック・オア・トリートォォォォッ！！", "face": "l2ee2e2041d15"}, {"name": "ニコル", "text": "正月なのかハロウィンなのかはっきりさせなよぉ！", "face": "u2592a1"}]}, {"trigger": "end", "lines": [{"name": "ベアッカ", "text": "あ、あれ……？\nベアッカは、今までなにをして……？", "face": "u2591a1"}, {"name": "ニコル", "text": "よし！　洗脳が解けたみたいだよ！", "face": "u2592a1"}, {"name": "チェインソン男", "text": "う、うわぁぁあぁぁああッ！？\n死んだぜッ！！", "face": "l2ee2e2041d15"}, {"name": "ミリアム", "text": "ちぇ、チェインソン男が……爆発四散しました……！", "face": "u2593a1"}, {"name": "ニコル", "text": "チェインソン男が爆発四散！？！？", "face": "u2592a1"}, {"name": "チェインソン男", "text": "いやー、楽しい模擬戦……もといハロウィンだったぜ！", "face": "l2ee2e2041d15"}, {"name": "ニコル", "text": "ニコルちゃんはもうツッコまないよ？\nなんで生きてるのとか言わないよ？", "face": "u2592a1"}, {"name": "ミリアム", "text": "と、とにかく、\nこれで事件は解決……でいいのでしょうか？", "face": "u2593a1"}, {"name": "ベアッカ", "text": "その前にチェインソン男さんにはお説教だよ！\n洗脳っていうのは悪いことなんだからね！！", "face": "u2591a1"}, {"name": "チェインソン男", "text": "ド正論すぎて言い返せねぇや。", "face": "l2ee2e2041d15"}, {"name": "ニコル", "text": "はぁ……どっと疲れたよ……。\nこの後、カボチャとカブが荒らした街の修理もあるのに。", "face": "u2592a1"}, {"name": "チェインソン男", "text": "チェーンソッソッソォ！！\nだったら俺も手伝うぜェ！！\n後片付けまでがハロウィンだからな！！", "face": "l2ee2e2041d15"}, {"name": "ミリアム", "text": "……人手が増えたと、喜んでおきましょうか。", "face": "u2593a1"}, {"name": "ニコル", "text": "割に合わないことをした気もするけど……。\nまぁ、それでいいや。", "face": "u2592a1"}, {"name": "ニコル", "text": "今回はすっごく大変だったなぁ……。\nご褒美のひとつでも欲しいところだよー。", "face": "u2592a1"}, {"name": "ベアッカ", "text": "じゃあ、ハロウィンの日に\n王子さまからもらっちゃおうよ♪", "face": "u2591a1"}, {"name": "ニコル", "text": "……そうだね。\nお菓子でももらうとするかな。", "face": "u2592a1"}, {"name": "ベアッカ", "text": "じゃあ少し早いけど王子さまっ。\nトリック・オア・トリートだよー♪", "face": "u2591a1"}, {"name": "ミリアム", "text": "で、では私も……トリック・オア・トリートです。", "face": "u2593a1"}, {"name": "ニコル", "text": "ふっふっふ、お菓子を用意しておかないと、\n当日はたくさん悪戯されそうだねぇ。", "face": "u2592a1"}, {"name": "ニコル", "text": "ニコルちゃんも、トリック・オア・トリート♪", "face": "u2592a1"}, {"name": "ニコル", "text": "三人ともたくさん頑張ったんだから、\n素敵なご褒美を期待してるよー♪", "face": "u2592a1"}]}], "active": true}