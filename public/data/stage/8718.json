{"quest_id": 8718, "name": "混沌とした祭典", "description": "事件後、王子たちの前にチェインソン男が\n出現。なにやらハロウィンを暴力もとい、\n模擬戦で盛り上げたいと言っており……？\n神級EX（★１獲得の目安：平均覚醒Lv25）", "event": "ハロウィンナイト・カボカブ大決戦", "event_category": "History", "mission_id": 920238, "map_no": 9430, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 2, "tags": ["アンデッド"], "hp": 10, "base_hp": 10, "damage_type": "physical", "attack_speed": 1, "attack_wait": 30, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130656, "special_effect_id": 516, "change_to": 1, "change_condition": 2, "master_id": 34026, "global_id": 7643, "to_condition": 2, "to_global_id": 7644, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8500, "attack": 700, "base_hp": 8500, "base_attack": 700, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 188, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2130672, "special_effect_id": 854, "master_id": 34027, "global_id": 7644, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 4, "tags": ["アンデッド", "機械"], "hp": 100000, "attack": 1200, "base_hp": 100000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "attack_speed": 1, "attack_wait": 150, "attack_interval": 466, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "pattern_id": 2127088, "special_effect_id": 1489, "change_to": 3, "change_condition": 2, "master_id": 36455, "global_id": 10072, "to_condition": 2, "to_global_id": 10073, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["アンデッド", "機械"], "hp": 140000, "attack": 1200, "base_hp": 140000, "base_attack"