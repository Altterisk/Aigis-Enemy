{"quest_id": 4306, "name": "目覚めし機甲兵", "description": "爆発する恐れのある\n壊れかけの個体に注意し\n機甲兵の暴走を食い止めろ！\n極級（★１獲得の目安：平均Lv25）", "event": "神官戦士とミスリルの巨兵", "event_category": "History", "mission_id": 920044, "map_no": 3580, "level": 100, "multiplier": 1.0, "charisma": 100, "exp": 350, "gold": 1700, "drops": [{"item": 5003, "c": 3}, {"item": 5002, "c": 1}, {"card": 24, "c": 1}, {"item": 1003, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 25, "form_index": 0, "form_count": 1, "tags": ["機械"], "hp": 1500, "attack": 500, "base_hp": 1500, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 120, "attack_wait": 45, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100816, "special_effect_id": 241, "master_id": 291, "global_id": 290, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 32, "form_index": 0, "form_count": 1, "tags": ["機械"], "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 120, "attack_wait": 45, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100752, "master_id": 283, "global_id": 282, "spawn_sec": 8}, {"enemy_id": 3, "source": "local", "count": 16, "form_index": 0, "form_count": 1, "tags": ["機械"], "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 250, "attack_speed": 70, "attack_wait": 45, "attack_interval": 121, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100768, "missile_id": 26, "master_id": 284, "global_id": 283, "ranged": true, "spawn_sec": 10}, {"enemy_id": 4, "source": "local", "count": 4, "level": 120, "form_index": 0, "form_count": 1, "tags": ["機械"], "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 120, "attack_wait": 45, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100752, "special_effect_id": 222, "master_id": 303, "global_id": 302, "spawn_sec": 36}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "あれは……機甲兵！\nこんな洞窟で遭遇するなんて……。", "face": "l2de784a6429d"}, {"name": "アンナ", "text": "それにしても、あの機甲兵、壊れかけて\nいるようですね。\n強い衝撃を与えると爆発する恐れがあります。", "face": "l2de784a6429d"}, {"name": "アンナ", "text": "あの機甲兵を近距離で対処される際はご注意を。", "face": "l2de784a6429d"}]}, {"trigger": "end", "lines": [{"name": "グスタフ", "text": "いやーすまんすまん。", "face": "u153"}, {"name": "グスタフ", "text": "ミスリル鉱の使い方を教えたら用無し扱いされて、\nダークエルフ共に仕返しするつもりでこの洞窟に眠る\n機甲兵を叩き起こしたんだが……。", "face": "u153"}, {"name": "グスタフ", "text": "起こし方がまずかったのか\n暴走状態で起動してしまってな。\nえらい目にあったわい。", "face": "u153"}, {"name": "アンナ", "text": "そ、そうでしたか……。\n経緯はともかく、地上に被害が及ぶ前でよかったです。", "face": "l2de784a6429d"}, {"name": "グスタフ", "text": "怒りで我を忘れていたとはいえ、\nいろいろ巻き込んですまなかったな！", "face": "u153"}, {"name": "グスタフ", "text": "がっはっはっ！！", "face": "u153"}, {"name": "グスタフ", "text": "まぁ助けてもらった礼だ。\nダークエルフが作りだそうとしている\n兵器について教えてやる！", "face": "u153"}, {"name": "グスタフ", "text": "どうやらそいつはゴーレムと呼ばれる古代兵器でな。\n巨大で頑強な体を持ち、一体で国を滅ぼせるほどの\n戦力を持つ。", "face": "u153"}, {"name": "グスタフ", "text": "そして、魔の力に反応するミスリル鉱で\n作られたものは石や鉄でできたゴーレムとは\n比べ物にならねぇ。", "face": "u153"}, {"name": "グスタフ", "text": "さっきダークエルフが、ミスリル鉱をもった魔物を\n従えてこの洞窟の奥に進みよったぞ。", "face": "u153"}, {"name": "アンナ", "text": "先に進むしかないようですね。\n王子、参りましょう。", "face": "l2de784a6429d"}]}], "map": {"image": "Map920044_3580", "w": 960, "h": 640, "spots": [{"k": "b", "x": 930, "y": 241}, {"k": "m", "x": 143, "y": 433, "id": 200}, {"k": "m", "x": 247, "y": 395, "id": 201}, {"k": "m", "x": 354, "y": 432, "id": 202}, {"k": "m", "x": 480, "y": 424, "id": 203}, 