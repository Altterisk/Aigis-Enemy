"spawn_sec": 49}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102752, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 394, "global_id": 393, "ranged": true, "spawn_sec": 69}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 90, "attack_interval": 261, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098480, "missile_id": 41, "missile": {"speed": 4.0, "splash": 133}, "master_id": 98, "global_id": 97, "ranged": true, "spawn_sec": 86}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 30, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102752, "special_effect_id": 130, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 31779, "global_id": 5398, "ranged": true, "spawn_sec": 92}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 20, "attack_interval": 166, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104576, "master_id": 803, "global_id": 802, "spawn_sec": 102}, {"enemy_id": 12, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 600, "base_hp": 2800, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 60, "attack_wait": 10, "attack_interval": 129, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097424, "master_id": 20, "global_id": 19, "spawn_sec": 121}], "popups": ["『不屈の大爪』では\nクロコは拠点には向かわず\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ベルナ", "text": "うん、こっちの方向で間違いなさそう。\n足音が近くなってるよ。", "face": "u46"}, {"name": "バルバストラフ", "text": "『祝福の魔力糸』の魔力も強くなってきておる。\n迷宮の中心部に近付いたとみて間違いなかろうて。", "face": "u63"}, {"name": "シャディア", "text": "ここまで魔王軍が先行しているとなれば、\n魔力糸は大半が奪われている可能性も高い。\n直接戦闘で奪取する必要もありそうだな……。", "face": "u713"}, {"name": "ベルナ", "text": "その時は私にお任せ♪\nがっつり奪い取ってくるよ。", "face": "u46"}, {"name": "シャディア", "text": "……ふふっ、頼りにしているよベルナ。\nさて、そろそろ追いつく頃合いだ。\n王子、油断するなよ。", "face": "u713"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "start", "lines": [{"name": "クロコ", "text": "――ホウ、騒がしいと思えば、\n本当に王子達ガ迷宮に来ていたとはナ。", "face": "led8387489060"}, {"name": "デシウス", "text": "だからそう報告したであろう！\n何故貴様は我輩の言葉を信じぬのだ！！", "face": "ld808e5ba7a68"}, {"name": "ゴライア", "text": "アイツは……クロコ！\nテメェよくもノコノコと顔を出せたナァ！！", "face": "u385"}, {"name": "クロコ", "text": "……雑兵が騒がしいナ。\nデシウス、此奴ラは任せルぞ。\n我らの使命は魔力糸ノ奪取ノミダ。", "face": "led8387489060"}, {"name": "デシウス", "text": "……な、何っ？\nおい、戦わないつもりか貴様！？", "face": "ld808e5ba7a68"}, {"name": "クロコ", "text": "今の私は戦士である前に、\n魔王様の忠実ナル臣下ダ。", "face": "led8387489060"}, {"name": "クロコ", "text": "世界ノ趨勢ト、己ノ欲に任せた戦イ。\nどちらが重要かは自明ト言うモノ。\n私は先に進ませテもらオウ。", "face": "led8387489060"}, {"name": "デシウス", "text": "ムゥゥゥッ！！　やはり我輩はいつも貧乏くじか！！\nだが、この魔力糸の力を試すには良い機会だ。\n王子よ、此度の勝負、容易く勝てると思うなよ！！", "face": "ld808e5ba7a68"}, {"name": "ゴライア", "text": "チィッ、王子、クロコのクソ野郎は\n迷宮の奥へ逃げていくみてェダ。\nさっさとデシウスを倒しテ後を追おうゼ！！", "face": "u385"}]}, {"trigger": "end", "lines": [{"name": "デシウス", "text": "――ぐふっ……。\nやはり慣れぬ力には頼るものではないな……。\n糸でも何でも持っていくがいい……。", "face": "ld808e5ba7a68"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "デシウス", "text": "フンッ、何か言いたそうな顔だな。\nだが我輩と茶飲み話をしている暇があるのか？", "face": "ld808e5ba7a68"}, {"name": "ベルナ", "text": "――王子、斥候から報告があったよ！\nクロコが迷宮の最深部に到達したって！", "face": "u46"}, {"name": "アンナ", "text": "王子、先を急ぎましょう。\n『祝福の魔力糸』を魔王軍に渡すわけにはいきません。", "face": "l709026bf7534"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "デシウス", "text": "…………。", "face": "ld808e5ba7a68"}, {"name": "デシウス", "text": "……行ったか。\nやれやれ、我輩はどうしてこう、\n貧乏くじばかりなのだろうなぁ……。", "face": "ld808e5ba7a68"}]}, {"trigger": "route", "enemy_ids": [2], "lines": [{"name": "デシウス", "text": "（お、思ったよりも、\nこの糸の魔力、制御が難しいぞ……！？\n仕方ない……かくなる上は……っ！！）", "face": "le4c7bbb727ff"}, {"name": "ベルナ", "text": "王子、デシウスの姿が変わっていくよ！\nあの姿は前にも戦った――", "face": "u46"}, {"name": "シャディア", "text": "――巨大な爪を備えた鎧か。\nあの重量を接近戦でぶつけられたら、\nしばらくは衝撃で身体が動かなくなるぞ。", "face": "u713"}, {"name": "アンナ", "text": "近接戦闘には注意が必要そうですね。\n王子、兵への指示は慎重にお願いします！", "face": "l709026bf7534"}]}], "active": true}