t": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2174528, "race_id": 16, "special_effect_id": 127, "change_to": 37, "missile_id": 186, "missile": {"speed": 12.0}, "master_id": 41280, "ranged": true, "from_condition": 0}, {"enemy_id": 40, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 299999, "attack": 10, "base_hp": 299999, "base_attack": 10, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 20, "attack_interval": 228, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2166128, "race_id": 16, "master_id": 39490, "global_id": 13107, "spawn_sec": 378}], "popups": ["黒い光冠を纏ったギルガメッシュは\n攻撃力2000以下の\nあらゆる攻撃を受け付けません。\n\nまた黒い光冠を纏った\nギルガメッシュは倒されると\nその場で強くなって復活します。\n　　　　　　(1/2)", "黒い光冠を纏った\nギルガメッシュがいる間は\n全ての敵の攻撃力と\n防御力が大幅にアップします。\n\n\n\n　　　　　　(2/2)", "魔法障壁は\n味方ユニットから受ける\n全てのダメージを50％軽減します。\n\nまた、一定範囲内のユニットは\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "モードリオン", "text": "――いったい何が……。\n天竜核の暴走が、収まっていく……？", "face": "ld14a7c1a4050"}, {"name": "シビラ", "text": "ふぅ……やっと追いついたわ。\nありがとうクリッサ。", "face": "u2940a1"}, {"name": "クリッサ", "text": "うん、やっぱりこっちについてきて正解だった。", "face": "u52"}, {"name": "アトナテス", "text": "そらよ。\n王子、あとはお前が決めるだけだぜ。", "face": "u908"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "モードリオン", "text": "ユニコーンに、魔竜ですか……。", "face": "ld14a7c1a4050"}, {"name": "クリッサ", "text": "地上の魔力嵐は収まって、\n暴走の残滓も王国と天眼ノ国で鎮めてる。\nあとは――黒幕を止めるだけ。", "face": "u52"}, {"name": "モードリオン", "text": "いったいどんな手段を？", "face": "ld14a7c1a4050"}, {"name": "シビラ", "text": "ただ止めただけよ。\n天竜核にお願いしてね。\n――これ以上、ふたつの国を壊させはしないわ。", "face": "u2940a1"}, {"name": "ギルガメッシュ", "text": "……我が力を従えたのか。\n創造神の加護が、その身に宿っているということか？", "face": "l58384827c551"}, {"name": "モードリオン", "text": "……破壊神の、我が王の力を支配下に？\n馬鹿な……そんなことが……。", "face": "ld14a7c1a4050"}, {"name": "アトナテス", "text": "悔しいんだろ。\n自分でも手が届かない力を、\nこいつらが平気な顔で従えてるのが。", "face": "u908"}, {"name": "モードリオン", "text": "……ふざけたことを。", "face": "ld14a7c1a4050"}, {"name": "モードリオン", "text": "トラハイア、手始めにこいつらを蹴散らしなさい。\nあなたとの約束を果たすかどうか、\nその可否はこの戦いで決めましょう。", "face": "ld14a7c1a4050"}, {"name": "トラハイア", "text": "…………。", "face": "u2944a1"}, {"name": "アンウェン", "text": "なっ……トラハイア！\nなぜ斯様な連中の味方をする！？", "face": "u2934a1"}, {"name": "ギルガメッシュ", "text": "この男は、国のために命を差し出した。", "face": "l58384827c551"}, {"name": "ギルガメッシュ", "text": "――リヴァイアサンの再起動計画。\nそれの契約を結んだのは、太守ではない。\nこの男が、自ら魂を差し出したのだ。", "face": "l58384827c551"}, {"name": "アンウェン", "text": "なぜ、そんなことを……。", "face": "u2934a1"}, {"name": "ガルヴェイン", "text": "愛していたんだろうさ、この国を。\nそいつ、飛べない翼なしのドラゴンなんだろ？", "face": "u2778a1"}, {"name": "ガルヴェイン", "text": "それに、ドラゴンの姿が本質で、\n人型を取るのは信頼に値するヤツの前か、\n服従を示すときだけってこの種族の中で――", "face": "u2778a1"}, {"name": "ガルヴェイン", "text": "――こいつは、人の姿しか取れないドラゴンだ。", "face": "u2778a1"}, {"name": "アンウェン", "text": "……知っておる。\nだが、トラハイアは、その苦境をすべて\n己の力として将軍にまで成り上がったのだ！", "face": "u2934a1"}, {"name": "ガルヴェイン", "text": "だから、だろうさ。\nそんなテメェを愛してくれた太守と、その娘。\n将軍と慕ってくれた部下たち……。", "face": "u2778a1"}, {"name": "ガルヴェイン", "text": "そいつらのためになら、\nどう見ても怪しい契約にだって乗るものさ。", "face": "u2778a1"}, {"name": "ガルヴェイン", "text": "おい、モードリオン、俺様は戦わないからな。\n胸糞悪い……戦士に対する冒涜だ、こんなの。", "face": "u2778a1"}, {"name": "モードリオン", "text": "……えぇ。わかっています。", "face": "ld14a7c1a4050"}, {"name": "シャルロット", "text": "王子、この方……以前見た呪いよりも、\nさらに強固な服従の呪いをかけられていますわ……。", "face": "u2827a1"}, {"name": "シャルロット", "text": "こうなってしまっては、\nもう、命を断つしか……。", "face": "u2827a1"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "シビラ", "text": "今日だけで、何度奇跡を起こしたと思っているの？\n大丈夫、私たちを信じて。", "face": "u2940a1"}, {"name": "王子", "text": "――行くぞ、シビラ。\n答えを掴み取るときだ。", "face": "u1"}]}, {"trigger": "battle", "at_sec": 368, "lines": [{"name": "トラハイア", "text": "――ぐっ、がはっ……。\nひめ、さま……俺、は……。", "face": "u2944a1"}, {"name": "アンウェン", "text": "喋るな！　絶対に助けてやる！", "face": "u2934a1"}, {"name": "ラピス", "text": "アンウェン、ここは代わる。\n急いで地上へ飛べ。\n最強の神官戦士と、王国の癒し手たちが来ている。", "face": "u2941a1"}, {"name": "アンウェン", "text": "わかった！\nすまぬ、あとを頼む！", "face": "u2934a1"}]}, {"trigger": "battle", "at_sec": 370, "lines": [{"name": "ギルガメッシュ", "text": "……その力、創造神の残滓か。\n死にぞこないが、まだ人を愛しているのだな。", "face": "l58384827c551"}, {"name": "ギルガメッシュ", "text": "いや、死にぞこないはこちらも同じだったか。", "face": "l58384827c551"}, {"name": "シビラ", "text": "天竜核に、天眼核……。\n破滅の力を集めてどうするつもり？", "face": "u2940a1"}, {"name": "ギルガメッシュ", "text": "もとより、これらは我が力。\nただ取り戻しているに過ぎぬ。", "face": "l58384827c551"}, {"name": "ラピス", "text": "元の力を取り戻すのが目的か。\nわかりやすいな。", "face": "u2941a1"}, {"name": "ギルガメッシュ", "text": "……それはただの過程に過ぎぬ。", "face": "l58384827c551"}, {"name": "シビラ", "text": "……どういうこと？", "face": "u2940a1"}, {"name": "モードリオン", "text": "我が王、いささか言葉をかけすぎかと。", "face": "ld14a7c1a4050"}, {"name": "ラピス", "text": "（……王子、ヤツの障壁を砕けるか。\nわたしの魔力を貸してやる）", "face": "u2941a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ラピス", "text": "（障壁が砕けたら……あとは任せる。\n今この場で、神を殺せるのは\nグングニル、フラガラッハとアンサラーだけだ）", "face": "u2941a1"}, {"name": "シビラ", "text": "（えぇ、任せて）", "face": "u2940a1"}, {"name": "ラピス", "text": "（おそらく、これが最後の好機だ。\nヤツが破滅の力を集め始めたのなら、\n本来の神としての力を取り戻さんとしているということ）", "face": "u2941a1"}, {"name": "ラピス", "text": "（今ここで、仕留める。\nお前たちなら、できるはずだ。――行くぞ）", "face": "u2941a1"}]}, {"trigger": "battle", "at_sec": 371, "lines": [{"name": "王子", "text": "――ギルガメッシュ、\nこれ以上、世界を壊させはしない……ッ！！", "face": "u1"}]}, {"trigger": "battle", "at_sec": 374, "lines": [{"name": "ギルガメッシュ", "text": "……ほう、我が障壁を砕くか。\n我が武器を良くぞ使いこなすものだ。", "face": "l58384827c551"}, {"name": "シビラ", "text": "フラガラッハ・アンサラー！\n私の翼よ――応えてッ！！", "face": "u2940a1"}]}, {"trigger": "battle", "at_sec": 378, "lines": [{"name": "ギルガメッシュ", "text": "…………ッ！！", "face": "l58384827c551"}, {"name": "ラピス", "text": "届いた……！", "face": "u2941a1"}, {"name": "ギルガメッシュ", "text": "――ほう、人の身で、よく届かせた。", "face": "l58384827c551"}, {"name": "ギルガメッシュ", "text": "小娘、褒美だ。この傷は覚えておこう。", "face": "l58384827c551"}, {"name": "ラピス", "text": "……わたしたちをなめているな。\nふざけるなよ。デモニック――", "face": "u2941a1"}]}, {"trigger": "end", "lines": [{"name": "モードリオン", "text": "我が王！", "face": "ld14a7c1a4050"}, {"name": "ギルガメッシュ", "text": "うろたえるな。\n実に喜ばしいことだ。\n王子よ、我らを追ってくるがいい。", "face": "l58384827c551"}, {"name": "モードリオン", "text": "なっ……なぜ天竜核を……。", "face": "ld14a7c1a4050"}, {"name": "ギルガメッシュ", "text": "この核の力の大半は取り戻した。\n残るは残滓のみだ。", "face": "l58384827c551"}, {"name": "モードリオン", "text": "……はっ。", "face": "ld14a7c1a4050"}]}, {"trigger": "end", "lines": [{"name": "ギルガメッシュ", "text": "――見せてみよ。\nこの世界で、貴様らが何をできるのか。", "face": "l58384827c551"}]}, {"trigger": "end", "lines": [{"name": "ラピス", "text": "……逃がした、いや、見逃されたのか。", "face": "u2941a1"}, {"name": "シビラ", "text": "でも……私たちの勝利よ。\n――ただ……。", "face": "u2940a1"}, {"name": "クリッサ", "text": "……まずい。\nリヴァイアサンの墜落が止まらない。", "face": "u52"}, {"name": "アトナテス", "text": "王子、どうするか決めろ！\n逃げるか、それとも――", "face": "u908"}, {"name": "アカツキ", "text": "じゃっじゃーん！！\n世界最高に美しい姉さまの妹！\nアカツキちゃん参上でーす！！", "face": "u2578a1"}, {"name": "シャルロット", "text": "なっ……ど、ドーンブリンガーですの！？", "face": "u2827a1"}, {"name": "パルセ", "text": "王子殿下！　ラージヴィール卿より、\n天眼核のお届けです！！", "face": "u2276a1"}]}], "map": {"image": "Map7527", "w": 960, "h": 640, "spots": [{"k": "b", "x": 48, "y": 467}, {"k": "m", "x": 190, "y": 176, "id": 200}, {"k": "m", "x": 179, "y": 289, "id": 201}, {"k": "m", "x": 406, "y": 152, "id": 202}, {"k": "m", "x": 181, "y": 395, "id": 204}, {"k": "m", "x": 245, "y": 348, "id": 205}, {"k": "m", "x": 282, "y": 442, "id": 206}, {"k": "m", "x": 363, "y": 291, "id": 207}, {"k": "m", "x": 368, "y": 397, "id": 208}, {"k": "m", "x": 466, "y": 226, "id": 209}, {"k": "m", "x": 443, "y": 352, "id": 210}, {"k": "m", "x": 541, "y": 295, "id": 211}, {"k": "m", "x": 376, "y": 502, "id": 212}, {"k": "m", "x": 639, "y": 323, "id": 213}, {"k": "m", "x": 738, "y": 354, "id": 214}, {"k": "m", "x": 833, "y": 406, "id": 215}, {"k": "m", "x": 518, "y": 491, "id": 216}, {"k": "m", "x": 701, "y": 206, "id": 217}, {"k": "m", "x": 633, "y": 424, "id": 218}, {"k": "m", "x": 795, "y": 149, "id": 219}, {"k": "r", "x": 589, "y": 367, "id": 300}, {"k": "r", "x": 454, "y": 442, "id": 301}, {"k": "r", "x": 269, "y": 220, "id": 302}, {"k": "r", "x": 528, "y": 164, "id": 303}, {"k": "r", "x": 531, "y": 402, "id": 306}], "events": [{"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "Giantscales1", "x": 863, "y": 226}, {"op": "+fx", "name": "obj_01", "fx": "Giantscales2", "x": 684, "y": 535}, {"op": "+fx", "name": "obj_02", "fx": "Giantscales3", "x": 103, "y": 338}]}, {"t": 365.4, "when": "time", "ops": [{"op": "-s", "name": "locPlc_200"}, {"op": "-s", "name": "locPlc_201"}, {"op": "-s", "name": "locPlc_202"}, {"op": "-s", "name": "locPlc_203"}, {"op": "-s", "name": "locPlc_204"}, {"op": "-s", "name": "locPlc_205"}, {"op": "-s", "name": "locPlc_206"}, {"op": "-s", "name": "locPlc_207"}, {"op": "-s", "name": "locPlc_208"}, {"op": "-s", "name": "locPlc_209"}, {"op": "-s", "name": "locPlc_210"}, {"op": "-s", "name": "locPlc_211"}, {"op": "-s", "name": "locPlc_212"}, {"op": "-s", "name": "locPlc_213"}, {"op": "-s", "name": "locPlc_214"}, {"op": "-s", "name": "locPlc_215"}, {"op": "-s", "name": "locPlc_216"}, {"op": "-s", "name": "locPlc_217"}, {"op": "-s", "name": "locPlc_218"}, {"op": "-s", "name": "locPlc_219"}, {"op": "-s", "name": "locPlc_300"}, {"op": "-s", "name": "locPlc_301"}, {"op": "-s", "name": "locPlc_302"}, {"op": "-s", "name": "locPlc_303"}, {"op": "-s", "name": "locPlc_304"}, {"op": "-s", "name": "locPlc_305"}, {"op": "-s", "name": "locPlc_306"}]}, {"t": 380.2, "when": "time", "ops": [{"op": "+fx", "name": "obj_04", "fx": "StageMagicCircle2", "x": 721, "y": 348}]}, {"t": 380.2, "when": "time", "ops": [{"op": "+fx", "name": "obj_05", "fx": "StageMagicCircle2", "x": 707, "y": 289}]}, {"t": 381.2, "when": "time", "ops": [{"op": "+fx", "name": "obj_03", "fx": "WhiteOut", "x": 487, "y": 386}]}, {"t": 383.9, "when": "time", "ops": [{"op": "-fx", "name": "obj_03"}]}, {"t": 383.9, "when": "time", "ops": [{"op": "-fx", "name": "obj_05"}]}, {"t": 383.9, "when": "time", "ops": [{"op": "-fx", "name": "obj_04"}]}]}, "active": true}