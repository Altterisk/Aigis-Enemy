{"quest_id": 7609, "name": "怒れる銀月", "description": "より多くの資格証を求めてピラミッドの\n奥へと向かった王子たちだったが、\nそこには既に二人の先客の姿が……。\n神級（★１獲得の目安：平均Lv50）", "event": "戦神からの招待状", "event_category": "History", "mission_id": 920176, "map_no": 4116, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アリアンロッド", "ステルスII", "ブロック不可"], "hp": 42000, "attack": 1000, "base_hp": 42000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_speed": 1, "attack_wait": 25, "attack_interval": 88, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2136720, "race_id": 19, "special_effect_id": 1039, "change_to": 1, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 34865, "global_id": 8482, "variants": [{"tags": ["アリアンロッド"], "hp": 42000, "attack": 1000, "base_hp": 42000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 25, "attack_interval": 87, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2136720, "race_id": 19, "special_effect_id": 1039, "change_to": 3, "change_condition": 2, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 34867, "global_id": 8484, "ranged": true}], "sp_change_to": [34867], "route_behaviour": {"transforms": [{"wait": 32}, {"to": 34867, "wait": 1600}]}}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 50000, "attack": 1800, "base_hp": 50000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 25, "attack_speed": 10, "attack_wait": 10, "attack_interval": 71, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2136752, "race_id": 16, "special_effect_id": 230, "change_to": 7, "master_id": 34882, "g