"special_effect_id": 1033, "change_to": 23, "master_id": 34876, "global_id": 8493, "to_global_id": 8510}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 6000, "base_hp": 6000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2136720, "special_effect_id": 275, "change_to": 24, "master_id": 34893, "global_id": 8510, "to_global_id": 8494}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 6000, "base_hp": 6000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2136720, "special_effect_id": 1034, "change_to": 25, "master_id": 34877, "global_id": 8494}, {"enemy_id": 34, "source": "local", "count": 29, "form_count": 1, "tags": ["アンデッド"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 38}, {"enemy_id": 35, "source": "local", "count": 9, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098448, "race_id": 18, "special_effect_id": 220, "master_id": 96, "global_id": 95, "spawn_sec": 40}, {"enemy_id": 36, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 40000, "attack": 500, "base_hp": 40000, "base_attack": 500, "damage_type": "magical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 181, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2098464, "special_effect_id": 227, "missile_id": 14, "missile": {"speed": 6.0, "splash": 147}, "master_id": 97, "global_id": 96, "ranged": true, "spawn_sec": 161}, {"enemy_id": 37, "source": "local", "count": 13, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 80, "attack_interval": 111, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103280, "special_effect_id": 227, "master_id": 425, "global_id": 424, "spawn_sec": 171}, {"enemy_id": 38, "source": "local", "count": 7, "form_count": 1, "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100624, "race_id": 18, "special_effect_id": 220, "master_id": 272, "global_id": 271, "spawn_sec": 173}, {"enemy_id": 39, "source": "local", "count": 2, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112880, "race_id": 18, "special_effect_id": 220, "master_id": 30756, "global_id": 4375, "spawn_sec": 213}], "popups": ["アランは\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ\n\nまた、アランは倒されると\nその場で復活します。\n復活は３回まで行われます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――いやはや、さすがは銀月の亜神殿。\n見事に一本取られてしまったなぁ。", "face": "l63f1d1ec00a7"}, {"name": "銀月の亜神？", "text": "あなたも、人間にしては見事な戦いでした。\nその蛮勇に免じて、最期の言葉を聞きましょう。", "face": "u1511a1"}, {"name": "？？？", "text": "それは格別にすぎる慈悲だなぁ。\nいやぁ、本音を言えばもう少し生きたかったけど、\nかの銀月の亜神に討たれたとなれば名誉なことだ。", "face": "l63f1d1ec00a7"}, {"name": "？？？", "text": "では、最期にもう一発、\n反撃の機会をくれると嬉しいな――っとぉ！？", "face": "l63f1d1ec00a7"}, {"name": "銀月の亜神？", "text": "どこまでも勝利に貪欲な……。\nちっ、あの男を思い出しますね。\n本当に虫唾が走る……。", "face": "u1511a1"}, {"name": "？？？", "text": "あいたたたた……。\nあの男っていうと、亜神マレス殿かな？\nははぁん、銀月の亜神殿とは相性が悪そうだ。", "face": "l63f1d1ec00a7"}, {"name": "銀月の亜神？", "text": "本当に、まったく、そのとおりです……。\n私は怒っているんです。", "face": "u1511a1"}, {"name": "銀月の亜神？", "text": "亜神ディアスを討たねばならぬという時に、\n何が大祭、何がコロッセウムですか……！", "face": "u1511a1"}, {"name": "銀月の亜神？", "text": "それに乗る武人たちもそうです！\nそんなに戦いたいなら、\n天界との戦いに参じればいいでしょう！", "face": "u1511a1"}, {"name": "？？？", "text": "……亜神殿、思ったより優しいんだなぁ。\n物質界のために戦おうとしてくれたってことだよねぇ。\nいや、そりゃ怒るよ、うん、わかる。", "face": "l63f1d1ec00a7"}, {"name": "銀月の亜神？", "text": "なっ……誰が優しいと……！？\nあぁもうっ、そのにまにました笑い方をやめなさい！\n今度こそ本当にトドメを刺しますよ！？", "face": "u1511a1"}, {"name": "？？？", "text": "わぁぁぁっ！？　待った！　まじで待って！\n照れ隠しの威力が尋常じゃないんだけど！？", "face": "l63f1d1ec00a7"}, {"name": "アンナ", "text": "…………えぇと、あの方々は\nいったい何をしているのでしょう？", "face": "lc119340f5565"}, {"name": "シェミア", "text": "どうやら、先客のようですね。\nというかこのまま放置すると、\nあちらの戦士が照れ隠しで斬殺されそうなのですが。", "face": "u1505a1"}, {"name": "トラム", "text": "……えぇ、あの子は本気でやりかねないわ。\n王子、手を貸して！\n身内に照れ隠しで殺人はさせたくないわ！！", "face": "u1110a1"}, {"name": "銀月の亜神？", "text": "…………その声。\n姉さま？　トラム姉さままで\nマレスの悪ふざけに参戦していたのですね！？", "face": "u1511a1"}, {"name": "アラン", "text": "いいでしょう、悪ふざけに乗る武人たち、\n王国、トラム姉さま、亜神マレスもまとめて、\n銀月の亜神アランが斬り殺してやりますからッ！！", "face": "u1511a1"}, {"name": "トラム", "text": "ご、ごめんなさい王子！\n余計に怒らせちゃったみたい……！", "face": "u1110a1"}, {"name": "トラム", "text": "アランの力は、時が経つほど増幅していくわ。\n短期決戦で片付けないと大変なことになるわよ！", "face": "u1110a1"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "……いやはや、これが九死に一生というやつかなぁ。\n誰かは知らないけど助かったよ、ほんとに。", "face": "l63f1d1ec00a7"}, {"name": "アラン", "text": "…………はぁ……はぁ、ふぅ。\n姉さま、事情を説明してくれますか？", "face": "u1511a1"}, {"name": "アラン", "text": "私は今、かなり怒っているんです。\n姉さまだけは、\nこんな悪ふざけに乗らないと思っていたのですが。", "face": "u1511a1"}, {"name": "トラム", "text": "落ち着いてアラン。いい、よく聞いて。\n私たちが乗ろうと、乗るまいと、\n勝手に巻き込んでくるのが戦神マレスなのよ？", "face": "u1110a1"}, {"name": "アラン", "text": "…………確かに。", "face": "u1511a1"}, {"name": "トラム", "text": "アラン、あなたもどうせ、\n勝手に招待状渡されて、そのまま神殿に\n出場資格証付きの魔物を送り込まれたりしたんでしょう？", "face": "u1110a1"}, {"name": "アラン", "text": "…………完全にそのとおりです。", "face": "u1511a1"}, {"name": "アラン", "text": "はぁ……では、どうあがいても、\n戦神コロッセウムには、巻き込まれるしかなかったと。", "face": "u1511a1"}, {"name": "レーヴ", "text": "あの、トラム様……？\nそちらの亜神様はいったい……。", "face": "u454"}, {"name": "トラム", "text": "この子はアラン、私の妹よ。\nどうやら亜神にも、招待状は送られていたみたいね。", "face": "u1110a1"}, {"name": "アラン", "text": "……この人間たちが、姉さまのお気に入りですか。\nそしてこのお人好しっぽい顔をしたのが、王子と。", "face": "u1511a1"}, {"name": "アラン", "text": "実力は確かなようですね。\nこの大祭に参加させられたのも、\n無駄ではなかったのかもしれません。", "face": "u1511a1"}, {"name": "トラム", "text": "えぇ、ところでアラン、\n今までいったいどこに――", "face": "u1110a1"}, {"name": "アラン", "text": "無駄話は今度にしましょう、姉さま。\n――さぁそこの武人、外へ連れて行ってあげます。\n手当てが必要ですよね？", "face": "u1511a1"}, {"name": "？？？", "text": "おっと、いいのかい？\n――不意打ちでザクッと斬ったりしない？", "face": "l63f1d1ec00a7"}, {"name": "アラン", "text": "しません！　私を何だと思っているのですか！", "face": "u1511a1"}, {"name": "？？？", "text": "照れ隠しに刃をぶんぶん振る亜神――わぁあっ！？\nやめっ、待って！　謝る！　すとーっぷ！！", "face": "l63f1d1ec00a7"}, {"name": "？？？", "text": "やれやれ、これは本戦もたっぷり楽しめそうだ。\nそれじゃあ命の恩人たる王国軍諸君、\n次は戦神コロッセウム、本戦でまみえるとしよう！", "face": "l63f1d1ec00a7"}, {"name": "トラム", "text": "あっ……まったく、話を聞かないんだから。", "face": "u1110a1"}, {"name": "シェミア", "text": "……先程の武人さんの無事を祈りましょう。\nさて王子、それでは次の予選会場へ参りましょうか。", "face": "u1505a1"}]}], "active": true}