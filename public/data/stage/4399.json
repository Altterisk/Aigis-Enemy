id": 6, "master_id": 395, "global_id": 394, "ranged": true, "commands": {"raw": "SetStageFlag( 1 , 1 , 1 );\nDoEnemy_RegistCommand(\"OnDestroy\",\"SetStageFlag( 1 , 0 , 1 );\");", "sets_flags": [[1, 1], [1, 0]], "on_destroy": true}, "spawn_sec": 89}, {"enemy_id": 12, "source": "local", "count": 10, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 91}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 122}], "dialogue": [{"trigger": "start", "lines": [{"name": "グレーターデーモン", "text": "ふむふむ。うまくやっているようだね。\n新団長のデシウス君。", "face": "lf2dd1f8513ee"}, {"name": "暗黒騎士デシウス", "text": "はい。新しく作っていただいた団長の証のおかげです。", "face": "ld557750182f4"}, {"name": "暗黒騎士デシウス", "text": "王子どもは我輩の陽動にまんまと騙されました。", "face": "ld557750182f4"}, {"name": "暗黒騎士デシウス", "text": "このまま街へ向かい、\nあの女の力を利用して住民どもに\n暗黒騎士団の怖さを思い知らせてやります。", "face": "ld557750182f4"}, {"name": "グレーターデーモン", "text": "ふふふ。楽しみにしているよ。", "face": "lf2dd1f8513ee"}, {"name": "暗黒騎士デシウス", "text": "はい！　必ずやご期待に応えて見せましょう。", "face": "ld557750182f4"}, {"name": "兵士", "text": "前方に暗黒騎士団を発見！", "face": "l887558b5e625"}, {"name": "暗黒騎士デシウス", "text": "ほう、もう来たのか。さすが英雄の末裔の王子。\n重装の暗黒騎士の足止めをものともせぬとはな。\nしかし、我輩にはまだ奥の手があるのだ。", "face": "ld557750182f4"}, {"name": "暗黒騎士デシウス", "text": "さぁ団員たちよ、我輩から素敵な武器を支給しよう。\n鎧に身を包む我々が飛び道具を持てば\n王子を葬る事などたやすいものよ。", "face": "ld557750182f4"}, {"name": "アンナ", "text": "王子！　お気を付けください。\n暗黒騎士団の者が何やら新しい武器を\n手にしているようです……！", "face": "l5b8011f24f83"}]}, {"trigger": "battle", "at_sec": 90, "lines": [{"name": "ユーノ", "text": "う……、あ、ぁ……ッ！！", "face": "u291"}, {"name": "ユーノ", "text": "これはっ、闇の力……！\n身体の奥から……、\n闇の力があふれてきて、いますッ……！", "face": "u291"}, {"name": "イーリス", "text": "お姉ちゃん……、力がうまく出せない……！\nどうして……。", "face": "u31"}, {"name": "カミラ", "text": "（癒しの力が奪われていく……）\nしっかりなさい、イーリス！\n今こそ修行の成果を見せるのです！", "face": "u32"}, {"name": "アンナ", "text": "どうやら闇の力の影響で、癒し手の力が抑えられて\nいるようです。お気をつけください。", "face": "l5b8011f24f83"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "あなたの野望もここまでです。\n降参してください。", "face": "l5b8011f24f83"}, {"name": "暗黒騎士デシウス", "text": "さっすが王子だ！　\nこうなっては我輩も降参せざるをえないな。", "face": "ld557750182f4"}, {"name": "暗黒騎士デシウス", "text": "……なーんて我輩が言うとでも思ったか！\n愚か者め！", "face": "ld557750182f4"}, {"name": "ユーノ", "text": "いやっ！　離してください……！", "face": "u291"}, {"name": "アンナ", "text": "王子！　暗黒騎士がユーノさんを連れて\n森の中へ逃げていきます！　なんて卑劣な……！", "face": "l5b8011f24f83"}, {"name": "アンナ", "text": "急ぎ後を追いましょう！", "face": "l5b8011f24f83"}]}], "active": true}