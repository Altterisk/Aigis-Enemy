: 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 141, "move_speed": 900.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109840, "race_id": 16, "change_to": 4, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30242, "global_id": 3861, "ranged": true, "to_condition": 2, "to_global_id": 3862, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 50, "attack_speed": 30, "attack_wait": 40, "attack_interval": 222, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109856, "race_id": 16, "special_effect_id": 148, "master_id": 30243, "global_id": 3862, "from_condition": 2}, {"enemy_id": 6, "source": "local", "count": 19, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 23}, {"enemy_id": 7, "source": "local", "count": 1, "level": 90, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 55, "attack_wait": 10, "attack_interval": 172, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097248, "race_id": 3, "master_id": 6, "spawn_sec": 124}, {"enemy_id": 8, "source": "local", "count": 1, "level": 90, "form_count": 1, "hp": 5200, "attack": 900, "base_hp": 5200, "base_attack": 900, "damage_type": "physical", "armor_defense": 400, "magic_defense": 5, "attack_speed": 60, "attack_wait": 10, "attack_interval": 177, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097408, "race_id": 3, "master_id": 19, "global_id": 18, "spawn_sec": 169}], "popups": ["ベルゼビュートと契約する\n教団員は変身後\n一定範囲内のユニットに\n継続ダメージを与え\n攻撃力を低下させます。  "], "dialogue": [{"trigger": "start", "lines": [{"name": "教団員", "text": "どうだ、ヴェルティ。\nグリモワールの解読は進んでいるか？", "face": "l99e65735e27d"}, {"name": "ヴェルティ", "text": "……。", "face": "u477"}, {"name": "教団員", "text": "おい、聞いているのか？", "face": "l99e65735e27d"}, {"name": "ヴェルティ", "text": "……。", "face": "u477"}, {"name": "教団員", "text": "おいっ！！", "face": "l99e65735e27d"}, {"name": "ヴェルティ", "text": "……うるさいわね。今いい所なのよ、\n邪魔しないでくれない？", "face": "u477"}, {"name": "教団員", "text": "き、貴様。\n多額の報酬を支払っているというのに。\n依頼主に向かってその態度は何だ！", "face": "l99e65735e27d"}, {"name": "ヴェルティ", "text": "……別に報酬なんてどうでもいいわよ。\n私はグリモワールの研究ができれば\nそれで充分。邪魔するならどこかに行って頂戴。", "face": "u477"}, {"name": "ドルチェ", "text": "――王子、悪魔研究者の棲家はここよ。\nあれはっ！！", "face": "u359"}, {"name": "教団員", "text": "ちっ、奴らここまで嗅ぎ付けるとは……ここで\n書片を奪われては元も子もない。\nおい、お前も戦え！　", "face": "l99e65735e27d"}, {"name": "ヴェルティ", "text": "……面倒ねぇ……まぁでも、\n研究の邪魔をされるのも、うっとうしいわ。\n邪魔者にはさっさと消えてもらおうかしらね。", "face": "u477"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "敵は全て倒したようですが……。", "face": "l546252706e34"}, {"name": "ドルチェ", "text": "教団員の連中、それにヴェルティにも\n逃げられてしまったわね。", "face": "u359"}, {"name": "ケイティ", "text": "……ここで彼女を捕らえておけば、\n奴らの研究を止めることもできていたかも\nしれないのに……申し訳ありません。", "face": "u114"}, {"name": "ドルチェ", "text": "嘆いてたってしょうがないわ。\n私の方で、引き続き奴らの足取りを\n探ってみる事にする。何か判れば連絡するわね。", "face": "u359"}, {"name": "アンナ", "text": "ありがとうございます、ドルチェさん。\n王子、一旦戻りドルチェさんからの\n報告を待ちましょう。"}]}], "active": true}