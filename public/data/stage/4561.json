{"quest_id": 4561, "name": "王の爆砲とカボチャの魔法剣士", "description": "英霊の魂によって、\n新たな力を得たカボチャ達を\n撃退せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "暗黒騎士団と英霊の守り手", "event_category": "History", "mission_id": 920066, "map_no": 3688, "level": 100, "multiplier": 1.0, "charisma": 115, "exp": 370, "gold": 1800, "drops": [{"item": 5003, "c": 4}, {"card": 205, "c": 1}, {"card": 133, "c": 1}, {"item": 2002, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 200, "attack_speed": 30, "attack_wait": 20, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "special_effect_id": 225, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 726, "global_id": 725, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 20, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 398, "global_id": 397, "spawn_sec": 18}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 40, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 209, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102832, "special_effect_id": 222, "missile_id": 154, "missile": {"speed": 6.0, "splash": 333}, "master_id": 727, "global_id": 726, "ranged": true, "spawn_sec": 88}], "dialogue": [{"trigger": "start", "lines": [{"name": "カボチャの魔物", "text": "魂ハコベ！　沢山ハコベ！\n魂ハコベ！　沢山ハコベ！", "face": "ld2ccff4b60b9"}, {"name": "カボチャの魔物", "text": "キング様！\n生キノ良イ魂ミツケタヨ！", "face": "ld2ccff4b60b9"}, {"name": "パンプキンキング", "text": "クヒュヒューー！\nカボチャ達、よくやったカボ！", "face": "le15e96510355"}, {"name": "カボチャの魔物", "text": "コノ魂は炎ノパワーガ湧イテクルヨ！\nキング様ニピッタリダヨ！", "face": "ld2ccff4b60b9"}, {"name": "パンプキンキング", "text": "クヒュヒュー！　\n炎のパワーが高まるのを感じるカボ！　\nいつもより３段階も広い範囲を焼き尽くせそうカボ！", "face": "le15e96510355"}, {"name": "パンプキンキング", "text": "全てを灰に帰してやるカボ！！", "face": "le15e96510355"}, {"name": "ガラニア", "text": "全てを灰に、とは随分と物騒ですね……。\n本当にその様な炎を操れるのですか？\nその魔力、実に興味深い。相手になりましょう。", "face": "u79"}, {"name": "リカルド", "text": "おおっと、いくらガラニアさんと言えど、\nあの数の魔物相手では手に余ろう？\nこの戦いに完全無欠の俺の力を添えさせてくれ。", "face": "u205"}, {"name": "パンプキンキング", "text": "クヒューッ！　いいところに来たカボ！？\nボクの新しい力を見せてアゲルカボ！\nぜんぶぜーんぶヤキ払っちゃうカボーー！", "face": "le15e96510355"}]}, {"trigger": "end", "lines": [{"name": "パンプキンキング", "text": "負けてしまったカボ……。\n悔しいガボ……何で勝てないガボ……？", "face": "le15e96510355"}, {"name": "リカルド", "text": "答えは単純さ。\nこのリカルドに、隙など一切無かったからだ！", "face": "u205"}, {"name": "ガラニア", "text": "ですが、確かにあのカボチャ達の繰り出す\n炎の魔力には目を見張るべき部分がありました。\n興味深いです……一度分解してみましょうか。", "face": "u79"}, {"name": "パンプキンキング", "text": "ぶ、ぶぶ、分解ッ！？？\nクヒュぅ……食べられるわけにはいかんガボ。\n……逃げるしかないガボ……。", "face": "le15e96510355"}, {"name": "リカルド", "text": "な、なあガラニアさん……？\nいくら魔力の精髄を極めるのが使命とはいえ、\nあんまり物騒なことは止めにしないか？", "face": "u205"}, {"name": "ガラニア", "text": "何も問題はありません。\nですから、貴方のその刃こぼれ一つ無い\n完璧な剣を私めにお貸し下さい。さあ。", "face": "u79"}, {"name": "リカルド", "text": "そう俺の剣は完璧だッ！\nって、そういう問題じゃなくてだね。\n――っあ、ああ！？　奴らが逃げ出したぞ！？", "face": "u205"}, {"name": "パンプキンキング", "text": "退散カボ！！\nこうなったら、もっともっと魂を集めるガボ！\nそして、もっともっと世界をモやすガボー！", "face": "le15e96510355"}, {"name": "ガラニア", "text": "逃げられてしまいましたね……残念です。\nせっかく魔力の根源へと至る新たな道を\n創出する鍵になると思いましたのに……。", "face": "u79"}, {"name": "リカルド", "text": "まあまあ、悪さをしようとしていた魔物を\n掃討することができたんだ。この完璧な勝利を、\n喜ぼうよ。", "face": "u205"}, {"name": "ガラニア", "text": "ふふ、そうですね。\n王子、それでは、戻りましょうか。\nこの度のお力添え、改めて感謝します。", "face": "u79"}]}], "map": {"image": "Map920066_3688", "w": 960, "h": 640, "spots": [{"k": "b", "x": 107, "y": 85}, {"k": "m", "x": 311, "y": 155, "id": 200}, {"k": "m", "x": 460, "y": 133, "id": 201}, {"k": "m", "x": 608, "y": 122, "id": 202}, {"k": "m", "x": 760, "y": 155, "id": 203}, {"k": "m", "x": 832, "y": 253, "id": 204}, {"k": "m", "x": 770, "y": 334, "id": 205}, {"k": "m", "x": 636, "y": 324, "id": 206}, {"k": "m", "x": 517, "y": 312, "id": 207}, {"k": "m", "x": 386, "y": 296, "id": 208}, {"k": "m", "x": 232, "y": 302, "id": 209}, {"k": "m", "x": 134, "y": 387, "id": 210}, {"k": "m", "x": 219, "y": 454, "id": 211}, {"k": "m", "x": 347, "y": 451, "id": 212}, {"k": "m", "x": 477, "y": 438, "id": 213}, {"k": "m", "x": 607, "y": 424, "id": 214}, {"k": "m", "x": 747, "y": 423, "id": 215}, {"k": "m", "x": 189, "y": 141, "id": 216}, {"k": "r", "x": 272, "y": 224, "id": 300}, {"k": "r", "x": 350, "y": 227, "id": 301}, {"k": "r", "x": 691, "y": 198, "id": 302}, {"k": "r", "x": 750, "y": 250, "id": 303}, {"k": "r", "x": 660, "y": 258, "id": 304}, {"k": "r", "x": 471, "y": 371, "id": 305}, {"k": "r", "x": 376, "y": 357, "id": 306}, {"k": "r", "x": 297, "y": 390, "id": 307}, {"k": "r", "x": 215, "y": 381, "id": 308}]}, "start_cost": 10, "active": true}