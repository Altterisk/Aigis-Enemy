d": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}, {"enemy_id": 30, "source": "local", "count": 24, "form_index": 0, "form_count": 2, "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102672, "race_id": 8, "change_to": 30, "change_condition": 3, "master_id": 385, "global_id": 384, "to_condition": 3, "to_global_id": 385, "spawn_sec": 179}, {"enemy_id": 30, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1600, "base_hp": 18000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 700, "attack_speed": 20, "attack_wait": 15, "attack_interval": 116, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "master_id": 386, "global_id": 385, "from_condition": 3}, {"enemy_id": 32, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103376, "race_id": 8, "change_to": 32, "change_condition": 3, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 442, "global_id": 441, "ranged": true, "to_condition": 3, "to_global_id": 442, "spawn_sec": 241}, {"enemy_id": 32, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 443, "global_id": 442, "ranged": true, "from_condition": 3}], "popups": ["オークロードは\nHPが50％以下になると\n攻撃速度が上昇し、\n遠距離攻撃を行うようになります。", "オークシールダーは\n味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nブロックされている間、\n引き付けの効果を失います。\n　　　　　　(1/2)", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "デリア", "text": "――冥界、どうやって行くんだろう。", "face": "u1707a1"}, {"name": "トリシャ", "text": "こら、無駄口を叩かない。\n周辺警戒を厳となせと言われたばかりだろう？", "face": "u1706a1"}, {"name": "デリア", "text": "上層部は確信があって進軍しているみたいだけど、\n冥界にそんな簡単に行ける方法があるなら、\n噂でそういう情報を少しくらい聞いたことがあるはず。", "face": "u1707a1"}, {"name": "デリア", "text": "でも、冥界に行けるような秘術や\n秘密の抜け穴なんて、聞いたことがない。", "face": "u1707a1"}, {"name": "マレブランケ", "text": "――お困りのようだね、お嬢さんたち。", "face": "u1225a1"}, {"name": "デリア", "text": "魔神副団長殿……。\nすみません、つい不安になってしまって。", "face": "u1707a1"}, {"name": "マレブランケ", "text": "ではひとつ、ヒントをあげよう。\n冥界と物質界が繋がる、\nそんな噂を、お嬢さんたちはもう聞いたことがあるはずだ。", "face": "u1225a1"}, {"name": "トリシャ", "text": "ん……聞いたことが、ある？", "face": "u1706a1"}, {"name": "マレブランケ", "text": "死者が、この世に現れる。\n悪霊怨霊、地縛霊に、夢枕に立つご先祖さま。\nまさか聞いたことがないとでも？", "face": "u1225a1"}, {"name": "トリシャ", "text": "……おばけ？\nまさか、おばけや幽霊が、冥界と繋がる証拠だとか――", "face": "u1706a1"}, {"name": "マレブランケ", "text": "そのまさか、さ。\nヘカティエによると、冥界は、天界や魔界とは\nその根本が異なる場所であるらしい。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "何しろ冥界とは、死した者の魂が行く場所だ。\n死ねば誰でも冥界へ行けるのだよ。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "そして、物質界においても、\n死の香りの強まる場所であれば、\n擬似的な冥界の門が、偶発的に開くのだという。", "face": "u1225a1"}, {"name": "トリシャ", "text": "……なるほど。\nつまりこれから向かうのは……。", "face": "u1706a1"}, {"name": "デリア", "text": "……心霊スポット？", "face": "u1707a1"}, {"name": "マレブランケ", "text": "そういうわけだ。\n心霊スポットというと聞こえが悪いけど、\nつまりは誰よりも多く人が死んだ場所さ。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "さぁ、疑問が解けたのなら、\nちゃんと周囲を警戒していておくれよ。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "――ほら、そこから\nこちらを見張っている、伏兵がいたりするからね！", "face": "u1225a1"}, {"name": "ハイオーク", "text": "ちっ……さすがは魔神副団長、気付かれたか！\n攻撃を仕掛ける！　俺に続けェ！！", "face": "l7bf980320ebd"}]}, {"trigger": "end", "lines": [{"name": "オーク", "text": "我が王、こちらの戦力は各個撃破されています。\nしかし同時に、確実に\n帝国軍の歩みは遅くなっているようです。", "face": "le8d3f3acf4c9"}, {"name": "オークロード", "text": "…………我が同胞ながら、無茶ばかりするものだ。", "face": "l7abef6f2023c"}, {"name": "オーク", "text": "……先輩方は、いったいどんな戦法で、\n帝国軍の足止めをしているのですか？", "face": "le8d3f3acf4c9"}, {"name": "オークロード", "text": "そうか、お前は戦場に出てまだ短かったな。\n戦場における、最強の存在がどんなものか分かるか？", "face": "l7abef6f2023c"}, {"name": "オーク", "text": "……我が王のような、勇者では？\nいくつもの戦場を駆け抜け、\n勝利をその手にもぎ取ってきたような。", "face": "le8d3f3acf4c9"}, {"name": "オークロード", "text": "いや、勇者とはあくまで旗印に過ぎない。\n戦働きを見届け、その死に様を看取り、\nそしてその魂を、共に輝ける勝利へと連れていく者だ。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "そんな存在のために、命を賭してでも\n勝利への礎となることを決めた者。\nそれこそが、戦場で最も強い者たち。", "face": "l7abef6f2023c"}, {"name": "オーク", "text": "死兵……捨て駒となることを決めた者こそ、\n最も強い戦士である、と……？", "face": "le8d3f3acf4c9"}, {"name": "オークロード", "text": "生きて帰るつもりがないのなら、\n戦士はその、本当の実力というものを発揮する。\n新兵が敵軍の将を討ち取ることだってある。", "face": "l7abef6f2023c"}, {"name": "オークロード", "text": "他の戦士たちに伝令を。\n帝国軍は山岳地帯を抜けた。\nこの先の古戦場を、白の皇帝の墓所としよう。", "face": "l7abef6f2023c"}]}], "hard": {"level": 140, "multiplier": 1.4, "modifiers": [{"kind": "term", "influence": 12, "params": [200]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 21, "params": [0, 60]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 28000, "attack": 700, "damage_type": "physical", "armor_defense": 2400, "magic_defense": 60, "pattern_id": 2118880}, {"enemy_id": 3, "form_index": 0, "hp": 6300, "attack": 420, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 50, "pattern_id": 2118848}, {"enemy_id": 5, "form_index": 0, "hp": 2520