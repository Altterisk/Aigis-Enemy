{"quest_id": 4380, "name": "白の帝国の騎士", "description": "不意に王子たちの前に現れ\n手合せを挑んできた騎士の\n正体とは……。\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "帝国の天馬騎士", "event_category": "History", "mission_id": 920050, "map_no": 3117, "level": 90, "multiplier": 0.9, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "hp": 576, "attack": 126, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 8, "form_count": 1, "hp": 810, "attack": 180, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 9, "form_count": 1, "hp": 900, "attack": 135, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 14}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 576, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 23}, {"enemy_id": 5, "source": "local", "count": 2, "level": 90, "form_count": 1, "hp": 4500, "attack": 360, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 72}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["帝国"], "hp": 5400, "attack": 360, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_speed": 70, "attack_wait": 40, "attack_interval": 181, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102448, "race_id": 16, "master_id": 332, "global_id": 331, "spawn_sec": 86}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "報告します！　領内に魔物が侵入！", "face": "l04f957c3f991"}, {"name": "アンナ", "text": "魔物はここで食い止めましょう！\n王子、戦闘の準備を！", "face": "lf42ad8a82a7e"}]}, {"trigger": "battle", "at_sec": 85, "lines": [{"name": "アンナ", "text": "魔物の撃退を確認しました。\n王子、お疲れ様です。"}]}, {"trigger": "end", "lines": [{"name": "謎の騎士", "text": "魔物の群れが暴れていると聞いてきたのですが……。\nどうやら倒された後のようですね。", "face": "u286"}, {"name": "謎の騎士", "text": "まだ魔物と戦う軍隊が残っていたとは……。\n……なるほど面白い。申し訳ありませんが少しだけ\nその腕前を拝見させていただきます！", "face": "u286"}, {"name": "イザベル", "text": "私は白の帝国の騎士、名をイザベル！！", "face": "u286"}, {"name": "アンナ", "text": "白の帝国ですって……！\nちょっとお待ちくださいっ。一体なぜ……。", "face": "lf42ad8a82a7e"}, {"name": "イザベル", "text": "あなた方がどなたかは存じませんが、\nその風貌。どこかの国の兵士とお見受けします。", "face": "u286"}, {"name": "イザベル", "text": "腕試しをしましょう。もし私に勝てたら我が帝国の\n傭兵として雇って差し上げます。", "face": "u286"}]}, {"trigger": "end", "lines": [{"name": "イザベル", "text": "くっ、手強い……。\nそろそろ本気を出した方が良さそうですね。\n飛べ！　イカロス！", "face": "u286"}, {"name": "アンナ", "text": "ちょ、ちょっと待ってください！\n腕試しならばもう十分なのではないでしょうか。", "face": "lf42ad8a82a7e"}, {"name": "アンナ", "text": "それよりも先ほど『白の帝国』と\n言われていましたが……。", "face": "lf42ad8a82a7e"}, {"name": "イザベル", "text": "（しまった。つい熱くなってしまいましたね。）\n確かに。久しぶりに手強い相手に出会えたので、\nはしゃぎすぎてしまいました。", "face": "u286"}, {"name": "アンナ", "text": "（……よかった。）\nもしよろしければ、詳しいお話を\nお聞かせくださいませんか？"}]}], "active": true}