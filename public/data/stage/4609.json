{"quest_id": 4609, "name": "密林の洞窟", "description": "白の帝国の兵士たちを\n魔物から守れ！\n\n上級（★１獲得の目安：平均Lv10）", "event": "帝国猟兵とオークの勇者", "event_category": "History", "mission_id": 920069, "map_no": 3708, "level": 100, "multiplier": 1.0, "charisma": 50, "exp": 200, "gold": 1200, "drops": [{"card": 348, "c": 1}, {"card": 25, "c": 1}, {"card": 57, "c": 1}, {"item": 1007, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 24, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 152, "global_id": 151, "spawn_sec": 27}, {"enemy_id": 3, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 49}, {"enemy_id": 4, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 55}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 70}, {"enemy_id": 6, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 132}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 145}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 170}], "dialogue": [{"trigger": "start", "lines": [{"name": "帝国兵士", "text": "……な、なぜだ？\nさっきまで無かった筈の岩が道を塞いでる……。\nこの経路からは洞窟を出られそうにないな……。", "face": "u287"}, {"name": "帝国兵士", "text": "くそ……オークの猛攻をしのぐ為に\nこの洞窟に身を潜めたというのに、\n出口を見失っては反撃どころではないぞ。", "face": "u287"}, {"name": "ゴブリン", "text": "……ギャギャッ！\nオレタチガ運ンダ岩デ、\n人間、困ッテル、迷ッテル、弱ッテル！", "face": "lfc420560d662"}, {"name": "ゴブリン", "text": "弱ッテル今ナラ、キット倒セルハズ！\nミンナ、行クゾッ、ギャギャッ！", "face": "lfc420560d662"}, {"name": "帝国兵士", "text": "――ッ！？\nこ、こんな時にゴブリンだと！？\n俺の命運も、ここまでかもしれないな……。", "face": "u287"}, {"name": "チグリ", "text": "――王子！　ここだよ！\n帝国兵がオークから逃げる為に、\nこの洞窟に入っていくのを見たんだ！", "face": "u310"}, {"name": "ゴブリン", "text": "ギャギャッ！\n知ラナイ人間ガ来タゾ！？\nドウスル？　ドウスル？", "face": "lfc420560d662"}, {"name": "帝国兵士", "text": "……貴方達は、何者なんだ？\nまさか……我々を助けてくれるというのか！？", "face": "u287"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン", "text": "ギャ……ギャ……。\n仲間ヲ呼ブナンテ、ズルイ……。\nミンナ……ニゲロ、ニゲロ……！", "face": "lfc420560d662"}, {"name": "チグリ", "text": "よっし、どうやらゴブリン達は\nみんな逃げていったみたいだね。\n王子、お疲れさん！", "face": "u310"}, {"name": "帝国兵士", "text": "……助けてくれて、ありがとう。\n貴方達が来なかったら、\nゴブリン達にやられていただろう……。", "face": "u287"}, {"name": "帝国兵士", "text": "だが、見たところ貴方たちは他国の\n兵のようだが、なぜ帝国軍である\n私たちのことを助けに来てくれたのだ……？", "face": "u287"}, {"name": "チグリ", "text": "あんたら帝国兵は\n長い間この森を守ってくれてただろ？\nまあ、恩返しみたいなもんだよ。", "face": "u310"}, {"name": "チグリ", "text": "って言っても、そんな理由なんか無くても、\nジャングルの中で誰かが困ってたら\n助けなきゃって思うのが当然だろ？", "face": "u310"}, {"name": "帝国兵士", "text": "本当に、感謝の念に堪えない……。\n我々もオークとの戦いに復帰するつもりで\nいたが、この傷ではどうやら足手まといだな。", "face": "u287"}, {"name": "帝国兵士", "text": "我らはこのまま帝国へと帰還することにする。\nなに、帰路くらいは我々でなんとかなるさ。\n世話になったな。それでは。", "face": "u287"}]}], "map": {"image": "Map920069_3708", "w": 960, "h": 640, "spots": [{"k": "b", "x": 31, "y": 295}, {"k": "b", "x": 32, "y": 425}, {"k": "m", "x": 190, "y": 201, "id": 200}, {