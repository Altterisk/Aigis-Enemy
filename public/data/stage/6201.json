c": 154}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 7000, "attack": 490, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105152, "race_id": 14, "change_to": 9, "change_condition": 5, "master_id": 604, "global_id": 603, "to_condition": 5, "to_global_id": 604}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 7000, "attack": 490, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "master_id": 605, "global_id": 604, "from_condition": 5}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 3, "hp": 8050, "attack": 602, "base_hp": 11500, "base_attack": 860, "damage_type": "physical", "armor_defense": 120, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 179, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106624, "race_id": 16, "special_effect_id": 222, "change_to": 12, "master_id": 30488, "global_id": 4107, "to_global_id": 4108, "route_behaviour": {"transforms": [{"wait": 1160}]}, "spawn_sec": 166}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 8050, "attack": 602, "base_hp": 11500, "base_attack": 860, "damage_type": "physical", "armor_defense": 120, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 179, "move_speed": 220.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106608, "race_id": 16, "special_effect_id": 222, "change_to": 13, "change_condition": 5, "master_id": 30489, "global_id": 4108, "to_condition": 5, "to_global_id": 4109}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 8050, "attack": 602, "base_hp": 11500, "base_attack": 860, "damage_type": "physical", "armor_defense": 120, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 179, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106624, "race_id": 16, "special_effect_id": 222, "master_id": 30490, "global_id": 4109, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "サヨ", "text": "わたしは王子が英雄の末裔、王に相応しい人間かを\n見届けるために尾行してた訳なんだけど……。邪仙が\n支配する華の国はその逆。まさに悪逆の都だったわね。", "face": "u510"}, {"name": "サヨ", "text": "あの時は魔物退治の遠征中に妖虎仙の娘、\nメイリンに奇襲された事から、\n妖虎仙が支配する華の国へと遠征したのよね。", "face": "u510"}, {"name": "サヨ", "text": "でも、あの戦場……邪仙が支配する華の国の都には、\n邪仙、屍解仙の罠が張り巡らされていた。", "face": "u510"}, {"name": "サヨ", "text": "死体を弄ぶ邪仙、屍解仙。わたしが見てきた\n支配者の中でも、あんな邪道は初めて見た。\nだから、すごく印象に残ってるわ。", "face": "u510"}, {"name": "サヨ", "text": "――さて、キョンシーに変装して紛れ込んだけど。\nこの服装、結構カワイイわね。\nぴょん……ぴょん……と、いけないいけない。", "face": "u510"}, {"name": "サヨ", "text": "変装は完璧とは言え、\n怪しまれる行動は避けないとね。\n……あら、あそこに見えるのは。", "face": "u510"}, {"name": "メイリン", "text": "父様、王子たちが来たみたい。メイリンも頑張るよ！\n父様仕込みの槍術で、王子たちをやっつけちゃうから！", "face": "u380"}, {"name": "妖虎仙", "text": "わしの秘術で周囲の妖気を取り込んだ今、\nお前が出ずとも王子軍など蹴散らしてやるわ。\n邪魔はするなメイリン。", "face": "l062273e6666f"}, {"name": "メイリン", "text": "父様……。", "face": "u380"}, {"name": "妖虎仙", "text": "ふん、お前の未熟な槍など役に立たぬ。\n……この戦いが終わったらもっと鍛えてやるから、\n覚悟しておくのだな。", "face": "l062273e6666f"}, {"name": "メイリン", "text": "……うん！\n……父様、やっぱりメイリンも戦うよ！\nほんきのほんきの、本気で戦うから！　準備してくる！", "face": "u380"}, {"name": "妖虎仙", "text": "む……また勝手に先走りおって……。\n屍解仙がキョンシーどもを残したまま\n姿をくらましているのが気にかかるが……", "face": "l062273e6666f"}, {"name": "妖虎仙", "text": "……まぁ良い、\nまずは王子どもの命貰うとするかのう。\n……妖虎ども、行くぞ！", "face": "l062273e6666f"}]}, {"trigger": "end", "lines": [{"name": "妖虎仙", "text": "――ぐァッ……はぁ、はぁ……。\nこ、これでも勝てぬとは……王子め……。\nその覇気……真の英雄であったか……。", "face": "l062273e6666f"}, {"name": "屍解仙", "text": "妖虎仙よ。\nまさか、妖気を取り込むぬしの秘術でも敗れるとはのぅ。\nさて、この機を待っておったぞ……死ねぃッ――！！", "face": "l4c68c8e39831"}, {"name": "妖虎仙", "text": "……ぐ、うぅ……し、屍解仙め……。\nこれが貴様の……邪仙郷の奴らのねらい、か……。\nめ、メイリン……にげろ……おまえ、だけ、は……。", "face": "l062273e6666f"}, {"name": "メイリン", "text": "父様……？　父様ぁぁ――ッ！！", "face": "u380"}, {"name": "サヨ", "text": "――王子が妖虎仙を倒した直後、潜んでいた屍解仙は\n仲間だった妖虎仙を殺した。あの戦い自体、\n屍解仙が妖虎仙を裏切り、殺す為の罠だったのよね……。", "face": "u510"}, {"name": "サヨ", "text": "人の気持ち、魂、肉体まで弄ぶような卑劣な奴ら、\n許せないわ。ただ、そんな邪仙の手からメイリンを\n保護できたのはあの戦いで数少ない救いだったね。", "face": "u510"}, {"name": "サヨ", "text": "敵として戦った相手であっても、\n助けを求める者に助けの手を差し伸べる。\nまさに王の器と呼べるのかもしれないわね。", "face": "u510"}, {"name": "サヨ", "text": "王……と言うよりは部族の代表だけど。\n次はオークとの戦いの思い出ね。", "face": "u510"}]}], "active": true}