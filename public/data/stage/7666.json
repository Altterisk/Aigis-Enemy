{"quest_id": 7666, "name": "提灯蛙相撲　マスコット場所", "description": "事件解決。スキュレはガマガエルを村人に\n紹介するが、これが譲れぬ戦いの火蓋を\n切ることになるとは知る由もなかった……。\n神級（★１獲得の目安：平均Lv50）", "event": "金魚姫と夏夜の肝試し", "event_category": "History", "mission_id": 920180, "map_no": 4138, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 33, "form_count": 2, "hp": 14500, "attack": 130, "base_hp": 14500, "base_attack": 130, "damage_type": "magical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129712, "race_id": 4, "special_effect_id": 70, "change_to": 1, "change_condition": 5, "missile_id": 563, "missile": {"speed": 17.0}, "master_id": 33867, "global_id": 7484, "to_condition": 5, "to_global_id": 7485, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 14500, "attack": 130, "base_hp": 14500, "base_attack": 130, "damage_type": "magical", "armor_defense": 250, "magic_defense": 5, "attack_range": 120, "attack_speed": 1, "attack_wait": 20, "attack_interval": 81, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129728, "race_id": 4, "special_effect_id": 823, "missile_id": 563, "missile": {"speed": 17.0}, "master_id": 33868, "global_id": 7485, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 26, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 100, "attack_speed": 180, "attack_wait": 60, "attack_interval": 181, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 961, "global_id": 960, "ranged": true, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 2, "hp": 115000, "attack": 250, "base_hp": 115000, "base_attack": 250, "damage_type": "magical", "armor_defense": 350, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129712, "race_id": 4, "special_effect_id": 70, "change_to": 5, "change_condition": 5, "missile_id": 566, "missile": {"speed": 17.0}, "master_id": 33869, "global_id": 7486, "to_condition": 5, "to_global_id": 7487, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 115000, "attack": 250, "base_hp": 115000, "base_attack": 250, "damage_type": "magical", "armor_defense": 350, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 20, "attack_interval": 81, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129728, "race_id": 4, "special_effect_id": 823, "missile_id": 566, "missile": {"speed": 17.0}, "master_id": 33870, "global_id": 7487, "ranged": true, "from_condition": 5}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 118000, "attack": 3500, "base_hp": 118000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_range": 60, "attack_speed": 20, "attack_wait": 10, "attack_interval": 91, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138288, "race_id": 4, "special_effect_id": 789, "change_to": 7, "change_condition": 1, "missile_id": 11, "master_id": 35069, "global_id": 8686, "ranged": true, "variants": [{"hp": 118000, "attack": 3000, "base_hp": 118000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 152, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138304, "race_id": 4, "master_id": 35070, "global_id": 8687}], "spawn_sec": 1}, {"enemy_id": 9, "source": "local", "count": 17, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 100, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108000, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 962, "global_id": 961, "ranged": true, "spawn_sec": 1}], "popups": ["提灯おばけはHPが減ると、\n周囲の味方ユニット全てに\n攻撃を行うようになります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "スキュレ", "text": "──というわけで、この子と仲良くしてほしいのよ。", "face": "u1539a1"}, {"name": "村の青年", "text": "なるほど、愉快そうな方だ。\nそういうことなら構いませんよ。\n子供たちも喜ぶかと思います。", "face": "l949e0dee8a63"}, {"name": "ガマガエル", "text": "よろしく頼むぜブラザー！\nとは言うがよ、受け入れるの早くねぇか？", "face": "le3b4f496efea"}, {"name": "スキュレ", "text": "王子や国主代理、妖怪総大将のおかげで、\n最近の東の国は人間と妖怪の融和が進んでるのよ。\nまあ正直、王子の紹介ってのも大きいけどね。", "face": "u1539a1"}, {"name": "村の青年", "text": "……実はこの地域では相撲が盛んでして。\n見たところ、ガマガエルさんは相当の手練れ。\nどうです？　我が村の広告塔になってみませんか？", "face": "l949e0dee8a63"}, {"name": "ガマガエル", "text": "だはははは！　俺様を利用するのに、\n相撲に目を付けるたぁ中々慧眼じゃねぇか！\n悪くねぇ、相撲好きに悪い奴はいねぇからな！", "face": "le3b4f496efea"}, {"name": "スキュレ", "text": "これならすぐ仲良くなれそうね。\nなによ、ちょっと緊張してたのに。", "face": "u1539a1"}, {"name": "リアナ", "text": "なにはともあれ一件落着──", "face": "u1540a1"}, {"name": "提灯おばけ", "text": "──ちょっと待ったぁああああッ！！", "face": "lfba01d20ff59"}, {"name": "スキュレ", "text": "なになになにっ！？", "face": "u1539a1"}, {"name": "提灯おばけ", "text": "何やってんだよ王子！　村のみんな……！\n俺たちというものがいながら誰だよその妖怪！", "face": "lfba01d20ff59"}, {"name": "村の青年", "text": "提灯おばけさん！？　こっ、これは違うんだ！！", "face": "l949e0dee8a63"}, {"name": "提灯おばけ", "text": "村のマスコットの座は渡さない！　勝負だガマガエル！", "face": "lfba01d20ff59"}, {"name": "ガマガエル", "text": "ああん？　何だか知らねぇが、\n喧嘩しようってんなら俺様は乗るぜ！\n気合の入った奴は嫌いじゃねぇからよ！", "face": "le3b4f496efea"}, {"name": "レミィ", "text": "……マスコットって言われても、\n正直どっちもそんなに可愛くな──", "face": "u1281a1"}, {"name": "ラミィ", "text": "姉ちゃん！？　しーっ！　しーっ！", "face": "u858"}, {"name": "スキュレ", "text": "え、ちょ、なんで急にそんな……\nお、王子、早くあれ止めないと──", "face": "u1539a1"}, {"name": "ガマガエル", "text": "はっけよーーーーい！！！！", "face": "le3b4f496efea"}, {"name": "巨大提灯おばけ", "text": "のこったぁああああッ！！！！", "face": "lce30e1b7fec3"}]}, {"trigger": "end", "lines": [{"name": "スキュレ", "text": "ぜぇ……ぜぇ……なんで、\n楽しいお祭りのはずがこんな、\n疲れなきゃいけないのよ……。", "face": "u1539a1"}, {"name": "ガマガエル", "text": "確と心に響いたぜブラザー、\n気合の入った良い打撃だった！", "face": "le3b4f496efea"}, {"name": "スキュレ", "text": "せめてシスターって言いなさい。", "face": "u1539a1"}, {"name": "巨大提灯おばけ", "text": "へへへ……負けた、負けたぜスキュレの姐さん。\nこの村のマスコットの座ァ、姐さんに譲っちゃる。", "face": "lce30e1b7fec3"}, {"name": "スキュレ", "text": "別にマスコットになりたくて\n戦ってたわけじゃないんだけど？", "face": "u1539a1"}, {"name": "ラトゥール", "text": "提灯おばけ対ガマガエル。\n喧嘩の勝者はスキュレってことで、\n賭け金は胴元の総取りでいいわよね？", "face": "u1541a1"}, {"name": "スキュレ", "text": "いつの間にそんなことしてたの……？", "face": "u1539a1"}, {"name": "スピリア", "text": "……ずっと思ってたのだけど、\nスキュレの浴衣の模様とか帯とか、\n金魚みたいでとっても綺麗よね。", "face": "u1043a1"}, {"name": "スキュレ", "text": "えっ、そ、そうかしら……？", "face": "u1539a1"}, {"name": "フーコ", "text": "……金魚姫だ。", "face": "u857"}, {"name": "ベラ", "text": "金魚姫？　スキュレって金魚のお姫様なのか？", "face": "u1284a1"}, {"name": "ガマガエル", "text": "なにぃ！？　海産物お前……淡水育ちだったのか！？", "face": "le3b4f496efea"}, {"name": "スキュレ", "text": "違うって言ってるでしょ！？", "face": "u1539a1"}, {"name": "村の青年", "text": "日傘を片手に戦う浴衣の金魚姫……売れる！", "face": "l949e0dee8a63"}, {"name": "スキュレ", "text": "やらないからね！？", "face": "u1539a1"}, {"name": "スキュレ", "text": "あーもー！　みんな落ち着きなさいよー！", "face": "u1539a1"}, {"name": "リアナ", "text": "（……たくさんの人に囲まれて、笑顔が溢れて。\nそれこそが本来の貴方の姿です、スキュレさん）", "face": "u1540a1"}, {"name": "リアナ", "text": "（いつか貴方が、今の貴方を、\n心の底から好きになれますように。\n星空が、叶えてくれると嬉しいですね）", "face": "u1540a1"}]}], "active": true}