: 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099056, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 120, "global_id": 119, "ranged": true, "spawn_sec": 1}, {"enemy_id": 8, "source": "local", "count": 17, "form_count": 1, "hp": 640, "attack": 300, "base_hp": 640, "base_attack": 300, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098912, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 118, "global_id": 117, "ranged": true, "spawn_sec": 26}, {"enemy_id": 9, "source": "local", "count": 10, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098928, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 119, "global_id": 118, "ranged": true, "spawn_sec": 76}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 140}, {"enemy_id": 11, "source": "local", "count": 12, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 145}, {"enemy_id": 12, "source": "local", "count": 12, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 157}, {"enemy_id": 13, "source": "local", "count": 12, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 176}], "popups": ["ゴブリンプリンセス長女がいる間は\n敵の攻撃力がアップします。\n\nゴブリンプリンセス次女がいる間は\n味方の魔法耐性が低下します。\n\nゴブリンプリンセス三女がいる間は\n敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン", "text": "ハァ、ゴブリン博士、イナイ……。\n博士イタラ、モット作業、ハカドル……。", "face": "l3c6204d81c07"}, {"name": "ゴブリンプリンセス長女", "text": "無駄口を叩いてる暇があったら、\nもっと手を動かしなさいウスノロ！", "face": "l3d1898687766"}, {"name": "ゴブリンプリンセス次女", "text": "王子たちに気付かれる前に、\n『浮遊石』を掘り尽くすのですわ！\n三女、あなたも何か言ってやりなさい！", "face": "l22310c1bb777"}, {"name": "ゴブリンプリンセス三女", "text": "そうですねぇ。\n頑張ってカンカンしてくださいね？", "face": "le166406288d1"}, {"name": "エレイン", "text": "（どうしてこんな所に、\nゴブリンプリンセスたちが……？）", "face": "u36"}, {"name": "ソーマ", "text": "（プリンセスだけじゃありません、\nあっちにいるのはメカゴブリンクイーンです！）", "face": "u23"}, {"name": "マイン", "text": "それに奴ら『浮遊石』って……、\nまさか『浮遊石』を盗掘してるのか！\nこうしちゃいられねぇ、奴らを止めねぇと！", "face": "u672"}, {"name": "グスタフ", "text": "これ、待つのじゃマイン！！\n策も無く飛び出しては――", "face": "u153"}, {"name": "メカゴブリンクイーン", "text": "あぁら、何かと思えば侵入者さんね。\nでもあなたの相手をしている暇はないのよ。", "face": "lda00e82b435a"}, {"name": "メカゴブリンクイーン", "text": "娘たち、私の代わりに、\nその子をたっぷり可愛がってあげなさい。", "face": "lda00e82b435a"}, {"name": "ゴブリンプリンセス長女", "text": "かしこまりましたわお母様。\n私たちの『トライアングル・フォーメーション』で、\nあなたを目一杯可愛がってあげるわ！　ねぇ三女！", "face": "l3d1898687766"}, {"name": "ゴブリンプリンセス三女", "text": "はい、私がお姉さまたちと、\nゴブリン軍団に回復魔法を！\nそして次女姉さま！", "face": "le166406288d1"}, {"name": "ゴブリンプリンセス次女", "text": "ふふん、三女らしく慎ましやかな紹介ね。\n私はあなたの魔法への抵抗力を奪ってやるの。\nそして満を持してお姉さま！！", "face": "l22310c1bb777"}, {"name": "ゴブリンプリンセス長女", "text": "そう、そしてこの私がゴブリン軍団全員の、\n力をぐぐぐいっと引き上げれば、\n『トライアングル・フォーメーション』完成よ！", "face": "l3d1898687766"}, {"name": "アンナ", "text": "王子、このままではマインさんが！\n急いで助けに入りましょう！", "face": "l031151a3e8d0"}, {"name": "ケイティ", "text": "このままではマインさんが危険です！\nグスタフさん、マインさんの退避を\nお願いして良いですか？", "face": "u114"}, {"name": "グスタフ", "text": "了解じゃ、わしが連れ戻してくるわい！\nあんのバカ娘め！　後先考えずに飛び出しおって、\nまったく誰に似たんじゃ！！", "face": "u153"}, {"name": "アンナ", "text": "王子、マインさんの避難はグスタフさんに任せ、\nゴブリンプリンセスたちを止めましょう！\n応戦の指揮をお願いします！", "face": "l031151a3e8d0"}]}, {"trigger": "end", "lines": [{"name": "マイン", "text": "うぅ、飛び出して悪かったよ。\nごめん、このとおりだッ！", "face": "u672"}, {"name": "エレイン", "text": "気にしないで。\nマインが飛び出さなくても、\n私が飛び出していたと思うわ。", "face": "u36"}, {"name": "グスタフ", "text": "しかしゴブリンどもが、\n『浮遊石』を狙っていたとはのう……。", "face": "u153"}, {"name": "アンナ", "text": "ゴブリン博士ならば、\n浮遊石の加工や悪用も可能かもしれません。\nこのまま見過ごすことは出来ませんね……。", "face": "l031151a3e8d0"}, {"name": "アンナ", "text": "王子、奥へ逃げていった\nメカゴブリンクイーンを追いかけましょう！", "face": "l031151a3e8d0"}]}], "active": true}