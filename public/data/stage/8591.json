"Route=27", "Route=29"]}, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ブロック不可"], "fixture": true, "hp": 10000, "attack": 5000, "base_hp": 10000, "base_attack": 5000, "damage_type": "magical", "armor_defense": 180, "magic_defense": 40, "attack_speed": 1, "attack_wait": 100, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "pattern_id": 2125920, "special_effect_id": 617, "change_to": 2, "master_id": 38879, "global_id": 12496}, {"enemy_id": 5, "source": "local", "count": 22, "form_count": 1, "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 70, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 46, "global_id": 45, "spawn_sec": 82}, {"enemy_id": 6, "source": "local", "count": 17, "form_count": 1, "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 49, "global_id": 48, "ranged": true, "spawn_sec": 100}, {"enemy_id": 7, "source": "local", "count": 7, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 150, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 52, "global_id": 51, "ranged": true, "spawn_sec": 141}, {"enemy_id": 8, "source": "local", "count": 22, "form_count": 1, "tags": ["アーマー"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 64, "global_id": 63, "spawn_sec": 156}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["女性"], "hp": 1500, "attack": 250, "base_hp": 1500, "base_attack": 250, "damage_type": "magical", "armor_defense": 50, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 31680, "global_id": 5299, "ranged": true, "spawn_sec": 194}], "popups": ["【アンブローズの魔法陣】\n・撃破数に含まれない\n\n・ブロック不可。\n　遠距離攻撃での破壊は可能\n\n\n　　　　　　(1/2)", "・アンブローズが特定の地点に\n　到達すると起動し、周囲に強烈な\n　魔法攻撃を行ったのち消滅\n\n・魔法陣の破壊、もしくは\n　アンブローズの撃破、\n　拠点通過で起動することなく消滅\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "ニミュエ", "text": "えー、てすてす。聞こえていますかー？\nアンブローズ様は完全に包囲されています―、\n拗ねてないでさっさと出てきてくださーい。", "face": "u2473a1"}, {"name": "アンブローズ", "text": "うぅ、なんですかみんなでぞろぞろと……。", "face": "u1088a1"}, {"name": "アンブローズ", "text": "寄って集ってあたしを正論でいじめる気ですね！？", "face": "u1088a1"}, {"name": "ファルネ", "text": "（分の悪い主張って自覚はあるんだ）", "face": "u640"}, {"name": "ニミュエ", "text": "分かってるならさっさと降伏してくださーい。", "face": "u2473a1"}, {"name": "アンブローズ", "text": "あ、あたしは自分の意見を曲げませんよぅ！？\n今年のジューンブライドはニミュエが主役なんです！", "face": "u1088a1"}, {"name": "ニミュエ", "text": "おー、なんという使い魔に対する深い愛情でしょー。\nとても私を迷宮に千年放置した御方だとは思えません。", "face": "u2473a1"}, {"name": "アンブローズ", "text": "（グサッ）", "face": "u1088a1"}, {"name": "ニミュエ", "text": "親愛なる主からのお言葉に私も涙が止まりません、\nどうしてもっと早くにそれができなかったのかー。", "face": "u2473a1"}, {"name": "アンブローズ", "text": "（グサグサッ）", "face": "u1088a1"}, {"name": "ニミュエ", "text": "むふー(ツヤツヤ)", "face": "u2473a1"}, {"name": "コレット", "text": "（たっ、楽しんでる……！？）", "face": "u1615a1"}, {"name": "アンブローズ", "text": "だっ、だからですよぅ！", "face": "u1088a1"}, {"name": "ニミュエ", "text": "えー？", "face": "u2473a1"}, {"name": "アンブローズ", "text": "千年間もひとりぼっちにしちゃった分以上に、\nニミュエを甘やかすってあたしは決めたんです！", "face": "u1088a1"}, {"name": "アンブローズ", "text": "親馬鹿なんて言われようがこれだけは譲りません！\nうちの子が一番可愛いんだからうちの子が一番です！", "face": "u1088a1"}, {"name": "ニミュエ", "text": "おー、これはちょっとからかいづらい。", "face": "u2473a1"}, {"name": "ニミュエ", "text": "ではでは王子ちゃん様、アンブローズ様が\nやっぱり言うこと聞く気配がないので、\n早いとこしばいちゃいましょー。", "face": "u2473a1"}, {"name": "アンブローズ", "text": "そ、そういう流れになりますぅ！？", "face": "u1088a1"}, {"name": "ニミュエ", "text": "肝心なところが分かってないアンブローズ様には\nお尻ぺんぺんの刑がお似合いかと―。", "face": "u2473a1"}, {"name": "ニミュエ", "text": "いえーい、お仕置きターイム。", "face": "u2473a1"}]}, {"trigger": "end", "lines": [{"name": "アンブローズ", "text": "うぅ、こんなのってひどいですよぉ……\nみんなして寄って集ってぺんぺんぺんぺん。", "face": "u1088a1"}, {"name": "アンブローズ", "text": "あたし、これでも大魔導士として名を馳せた英傑ですよ？", "face": "u1088a1"}, {"name": "ニミュエ", "text": "使い魔心の分からない御方にはお似合いの罰かとー。", "face": "u2473a1"}, {"name": "アンブローズ", "text": "使い魔心ぉ……？", "face": "u1088a1"}, {"name": "ニミュエ", "text": "私がいつ、主役になりたいと言いましたかー？", "face": "u2473a1"}, {"name": "アンブローズ", "text": "それは……言ってない、ですけどぉ。", "face": "u1088a1"}, {"name": "ニミュエ", "text": "ジューンブライドで一番目立つ花嫁さんの座。\n私もまったく興味が無いーとは言いません。", "face": "u2473a1"}, {"name": "ニミュエ", "text": "あげると言われたならありがたーく頂戴はしますよ？\nですが、周りに迷惑をかけてまで欲しくはありません。", "face": "u2473a1"}, {"name": "ニミュエ", "text": "こんな私を依怙贔屓してくれるのはアンブローズ様、\nそして王子ちゃん様がいればそれだけで十分ですから。", "face": "u2473a1"}, {"name": "アンブローズ", "text": "ニ、ニミュエ～！", "face": "u1088a1"}, {"name": "アンブローズ", "text": "誰よりも綺麗な花嫁さんにしてあげますからねぇ！！", "face": "u1088a1"}, {"name": "コレット", "text": "いいはなしだなぁ。", "face": "u1615a1"}, {"name": "王子", "text": "…………(うんうん)", "face": "u1"}, {"name": "ファルネ", "text": "（ちゃっかり王子を入れてるのは意外と策士ね）", "face": "u640"}, {"name": "ケイティ", "text": "さて、これで三人目ですが……。", "face": "u114"}, {"name": "アンナ", "text": "……最後の難関、ですね。", "face": "lb99dad2ec7a4"}, {"name": "ウルカノ", "text": "仕方ねぇ、あの馬鹿の顔面でも殴りに行くか。", "face": "u2475a1"}]}], "active": true}