1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 42000, "attack": 900, "base_hp": 42000, "base_attack": 900, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 300, "attack_speed": 50, "attack_wait": 20, "attack_interval": 95, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2144208, "special_effect_id": 1321, "missile_id": 6, "master_id": 36162, "global_id": 9779, "ranged": true, "spawn_sec": 107}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 30000, "attack": 800, "base_hp": 30000, "base_attack": 800, "damage_type": "magical", "armor_defense": 250, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 50, "attack_interval": 165, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102000, "race_id": 16, "missile_id": 6, "master_id": 30869, "global_id": 4488, "ranged": true, "spawn_sec": 134}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["アンデッド"], "hp": 5000, "attack": 320, "base_hp": 5000, "base_attack": 320, "damage_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104544, "special_effect_id": 222, "change_to": 10, "change_condition": 2, "missile_id": 6, "master_id": 33315, "global_id": 6932, "ranged": true, "to_condition": 2, "to_global_id": 6933, "spawn_sec": 136}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 7000, "attack": 420, "base_hp": 7000, "base_attack": 420, "damage_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104544, "special_effect_id": 64, "missile_id": 6, "master_id": 33316, "global_id": 6933, "ranged": true, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "鬼刃衆", "text": "あそーれ、わっしょい♪　わっしょい♪", "face": "l3202663e4ef1"}, {"name": "下忍", "text": "ビッフロンス♪　ビッフロンス♪", "face": "u147"}, {"name": "ヴィクトリア", "text": "なんだ、踊っているだけじゃあないか。\n相変わらず歌も踊りも面妖極まりないが。", "face": "u2203a1"}, {"name": "セツナ", "text": "その一緒に踊ってる面子が問題なんだよねぇ。", "face": "u877"}, {"name": "闇の墓守リッチ", "text": "わっしょい♪　わっしょいですぞー♪", "face": "u1807a1"}, {"name": "メトゥス", "text": "なんで私が使い魔に付き合わなきゃいけないのよ……！", "face": "u329"}, {"name": "助手リッチ", "text": "も、申し訳ありません、メトゥス様……！\nどうにも骨が勝手に動いて──ア、ホイホイ♪", "face": "lfea02f4532f5"}, {"name": "クレール", "text": "闇の墓守さんに、メトゥスさんのとこのリッチさん──", "face": "u2200a1"}, {"name": "エストリエ", "text": "えらーやっちゃ♪　えーらやっちゃ♪", "face": "u791"}, {"name": "エデン", "text": "よーいよーいよーい♪", "face": "u239"}, {"name": "フーイェン", "text": "エストリエちゃんにエデンちゃん！", "face": "u2201a1"}, {"name": "フーイェン", "text": "ん……？　ということは……？", "face": "u2201a1"}, {"name": "ヴィンセント", "text": "よくも──俺の──な──に、鬼刃衆──絶対に──", "face": "u103"}, {"name": "フーイェン", "text": "あ、二匹目の復讐の獣です。", "face": "u2201a1"}, {"name": "フーロン", "text": "鬼刃衆……殺す。", "face": "u2202a1"}, {"name": "フーイェン", "text": "一匹目もいた。", "face": "u2201a1"}, {"name": "シロガネ", "text": "踊る鬼刃衆、それに釣られるアンデッド。\n何かの出し物だと思ってヤジを飛ばす観客と、\nそして今にも暴れ出しそうな復讐の獣たち。", "face": "u2126a1"}, {"name": "シロガネ", "text": "うーん、カオスっすねぇ。", "face": "u2126a1"}, {"name": "セツナ", "text": "あたしがヴィンセントさんたちを抑えとくからさ、\nシロガネたちの方でみんなのこと止めてくんない？", "face": "u877"}, {"name": "ヴィクトリア", "text": "任されよう、同業としてあの姿はあまりに忍びない。", "face": "u2203a1"}, {"name": "ヴィクトリア", "text": "ヴィンセントが鬼刃衆を殺す前に我らで制圧する！", "face": "u2203a1"}, {"name": "クレール", "text": "りょ、了解！", "face": "u2200a1"}]}, {"trigger": "end", "lines": [{"name": "エデン", "text": "あー、楽しかったー♪", "face": "u239"}, {"name": "エストリエ", "text": "ふふっ、そうねエデンちゃん。", "face": "u791"}, {"name": "ヴィンセント", "text": "………………。", "face": "u103"}, {"name": "メルアビス", "text": "……どうやら、血の惨劇は免れたみたいね。", "face": "u1252a1"}, {"name": "クルス", "text": "アンデッドを強制的に盆踊りに巻き込む力、\n使いどころが意味不明だけど中々面白いわね。", "face": "u1603a1"}, {"name": "クルス", "text": "そうだ、エマさんが操られたら面白いんじゃない？\n誰か適当に理由付けてエマさんを呼んできて──", "face": "u1603a1"}, {"name": "エマ", "text": "──死にたいんですか？", "face": "u582"}, {"name": "クルス", "text": "ひっ──", "face": "u1603a1"}, {"name": "ヴィクトリア", "text": "……鬼刃衆は逃げたか。\n積極的に交戦する意思はないようだな。", "face": "u2203a1"}, {"name": "メルアビス", "text": "まあ、他の魔神と比べるとビフロンスの欠片は、\n特別身体能力を上げてくれるわけじゃあないもの。", "face": "u1252a1"}, {"name": "メルアビス", "text": "あくまでもビフロンスの本領はアンデッドの使役、\nまずは仲間を増やすことを優先してるんでしょうね。", "face": "u1252a1"}, {"name": "メトゥス", "text": "──その件だけど、早く手を打った方が良いわよ。", "face": "u329"}, {"name": "ヴィクトリア", "text": "どういうことだ？", "face": "u2203a1"}, {"name": "メトゥス", "text": "鬼刃衆たち、もうかなり症状が進行してるわ。\nこのままだと本当にアンデッドになり兼ねない。", "face": "u329"}, {"name": "メトゥス", "text": "今は本人たちの呑気さが前面に出てるけど、\nそうなったらどうなるかは分からないわよ。", "face": "u329"}, {"name": "ヴィクトリア", "text": "これ以上は猶予がないか……。\nセツナ、お前たちはどう思う？", "face": "u2203a1"}, {"name": "セツナ", "text": "うーん、まあ大丈夫じゃない？\n今大事なのは姫様に迷惑が掛からないよう、\n鬼刃衆による民間への被害を減らすことだよ。", "face": "u877"}, {"name": "ヴィクトリア", "text": "……やけに楽観的だな。", "face": "u2203a1"}, {"name": "シロガネ", "text": "アンデッドになろうと鬼刃衆は鬼刃衆っす。\n何であれそこに鬼刃姫様への忠誠心がある限り、\n生きてるか死んでるかは特に重要じゃないっすね。", "face": "u2126a1"}, {"name": "フーイェン", "text": "ちなみに、その忠誠心を忘れてしまった場合は？", "face": "u2201a1"}, {"name": "シロガネ", "text": "まあ、それは……。", "face": "u2126a1"}, {"name": "セツナ", "text": "やっぱり……ねぇ？", "face": "u877"}, {"name": "フーイェン", "text": "（中々ヤバい集団ですねぇ、鬼刃衆）", "face": "u2201a1"}]}], "map": {"image": "Map920218_4924", "w": 960, "h": 640, "spots": [{"k": "b", "x": 952, "y": 178}, {"k": "b", "x": 951, "y": 434}, {"k": "m", "x": 73, "y": 177, "id": 200}, {"k": "m", "x": 74, "y": 362, "id": 201}, {"k": "m", "x": 145, "y": 228, "id": 202}, {"k": "m", "x": 416, "y": 77, "id": 203}, {"k": "m", "x": 516, "y": 75, "id": 204}, {"k": "m", "x": 625, "y": 414, "id": 206}, {"k": "m", "x": 878, "y": 217, "id": 207}, {"k": "m", "x":