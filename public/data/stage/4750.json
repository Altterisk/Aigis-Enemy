_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103120, "race_id": 16, "change_to": 1, "change_condition": 2, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 418, "global_id": 417, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 139}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー"], "hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 180, "attack_wait": 40, "attack_interval": 403, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2099632, "race_id": 16, "special_effect_id": 222, "change_to": 1, "change_condition": 2, "master_id": 998, "to_condition": 2, "to_global_id": 403, "spawn_sec": 167}], "dialogue": [{"trigger": "start", "lines": [{"name": "バシラ", "text": "王子、こっちです！\nこの道にデシウスの姿を見ました！", "face": "u28"}, {"name": "ドッペルゲンガー", "text": "やけに急いでいるようだな、王子。\nだが、ここはそう簡単に通しはしないぞ。", "face": "l095d946e9b08"}, {"name": "モーティマ", "text": "また邪魔が入りやがったか……。どうせお前ら、\n同じサイズの対象にしか化けられないんだろ？\n同じ手は通用しないからな！", "face": "u14"}, {"name": "ドッペルゲンガー", "text": "ククッ……。\nまさか、お前の様な山賊風情に\n本当の事を言われてしまうとは思わなかったよ。", "face": "l095d946e9b08"}, {"name": "ドッペルゲンガー", "text": "だが、常闇の聖霊に授かったこの新しい力によって、\n我が種は、更なる繁栄を約束された。\n覚悟しろ！", "face": "l095d946e9b08"}]}, {"trigger": "end", "lines": [{"name": "ドッペルゲンガー", "text": "くそっ……。\n化ける対象を誤ったか……。\n次は、もっと強い魔物に化けなければならん。", "face": "l095d946e9b08"}, {"name": "ドッペルゲンガー", "text": "しばらくの間は、魔物探しをするのが得策だな……。", "face": "l095d946e9b08"}, {"name": "兵士", "text": "報告！\nドッペルゲンガーの撤退を確認しました！", "face": "l86b54cad43ba"}, {"name": "モーティマ", "text": "何とか勝てたな……ったく、\n巨大な魔物に変身するとは、厄介だったぜ。", "face": "u14"}, {"name": "ケイティ", "text": "意表をつかれて、手間取ってしまいましたね。\n一刻も早くデシウスに追いつかなければ……。\n王子、すぐに進軍を開始しましょう。", "face": "u114"}]}], "active": true}