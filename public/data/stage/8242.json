100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 779, "global_id": 778, "ranged": true, "from_condition": 5}, {"enemy_id": 18, "source": "local", "count": 23, "form_count": 1, "hp": 12000, "attack": 600, "base_hp": 12000, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 40, "attack_wait": 10, "attack_interval": 136, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2152144, "race_id": 9, "special_effect_id": 773, "master_id": 37359, "global_id": 10976, "spawn_sec": 74}, {"enemy_id": 19, "source": "local", "count": 14, "form_count": 1, "hp": 1500, "attack": 20, "base_hp": 1500, "base_attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 35, "attack_speed": 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 633, "global_id": 632, "ranged": true, "spawn_sec": 82}, {"enemy_id": 20, "source": "local", "count": 8, "form_count": 1, "hp": 1500, "attack": 800, "base_hp": 1500, "base_attack": 800, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099056, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 120, "global_id": 119, "ranged": true, "spawn_sec": 91}, {"enemy_id": 21, "source": "local", "count": 10, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 21, "change_condition": 5, "master_id": 780, "global_id": 779, "to_condition": 5, "to_global_id": 780, "spawn_sec": 102}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 781, "global_id": 780, "ranged": true, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "プロメ", "text": "…………早かった、ですね。\nこの船を溶かし切る前にたどり着いてしまうなんて。", "face": "u2150a1"}, {"name": "アルレット", "text": "あっ、あー！！\nそれっ、溶かし、えっ、えぇ！？　もったいない！！", "face": "u1453a1"}, {"name": "レクテ", "text": "落ち着いてアルレット！\nって、わっ、わー！？　機関部見えてる！\n溶岩流れ込んで、ひぁっ、壊れちゃうよぉぉぉ！？", "face": "u2047a1"}, {"name": "プロメ", "text": "……さすがにちょっとだけ、心が痛みました。", "face": "u2150a1"}, {"name": "プロメ", "text": "ですが、これは本来、\n人類が今より数千年後に獲得する技術です。\nきっとあなた方の子孫がたどり着くはずですよ。", "face": "u2150a1"}, {"name": "アルレット", "text": "それが今必要なんだよ！！", "face": "u1453a1"}, {"name": "アルレット", "text": "はぁ……まったくもー！\n超古代文明の遺跡が極端に少ない理由、これか！", "face": "u1453a1"}, {"name": "アルレット", "text": "あなたが！　片っ端から燃やして、溶かして、\n超古代文明そのものの痕跡を消してたんだ！", "face": "u1453a1"}, {"name": "プロメ", "text": "えぇ、そのとおりです。\nこれはあってはならない技術。\n私が誤ったせいで、伝えてしまった未来の遺物。", "face": "u2150a1"}, {"name": "プロメ", "text": "――それでも、あなたたちは求めますか？\nこの技術は確実に、戦乱の火種となります。\nそれでもなお、未来にあるべき技術を欲しますか？", "face": "u2150a1"}, {"name": "王子", "text": "――ああ。", "face": "u1"}, {"name": "プロメ", "text": "……一瞬も、迷うことなく答えますか。\n分かりました。ならばここで、\n私があなたたちを焼き尽くしましょう。", "face": "u2150a1"}, {"name": "プロメ", "text": "私は時代の番人。\n人が過ぎたる力で己を滅ぼさぬよう、\n世界の歩みを断絶させる者。", "face": "u2150a1"}, {"name": "レクテ", "text": "お、大きくなってない？\nプロメさんこんな大きかったっけ！？", "face": "u2047a1"}, {"name": "トラム", "text": "さっきは力を抑えてくれていたのよ。\nつまり、今この状況は――", "face": "u1110a1"}, {"name": "アラン", "text": "――手加減するつもりが一切ないということです！\n王子、戦闘の指揮を！", "face": "u1511a1"}]}, {"trigger": "end", "lines": [{"name": "プロメ", "text": "…………そう、私の本気にまで、\n手を届かせる決意と力をもう持っているのですね。", "face": "u2150a1"}, {"name": "シビラ", "text": "認めて、もらえないかしら？\n人類は道を過つこともあるけれど、\nそれを正し、もう一度歩みだすことができるの。", "face": "u39"}, {"name": "シビラ", "text": "あなたが愛した人類は、ちゃんと成長してる。\nかつての過ちを、もう一度繰り返したりしない。", "face": "u39"}, {"name": "プロメ", "text": "あなたは、あなたたちは、きっとそうなのでしょう。\nその強い決意が私にも、ちゃんと伝わってきています。", "face": "u2150a1"}, {"name": "プロメ", "text": "けれど、それ以外は？\nあなたたちの手が届かない場所では？\n悪意ある者にこの技術が渡ったら？", "face": "u2150a1"}, {"name": "プロメ", "text": "道を踏み外した時に、\n人類が滅びへ歩みだしたその時に、\nその間違いを正せるだけの力はあるのでしょうか？", "face": "u2150a1"}, {"name": "シビラ", "text": "断言は、できない。\nでもそうあろうと、私たちは努力し続けている。", "face": "u39"}, {"name": "プロメ", "text": "分かりました。\nならばその言葉が偽りでないと、証明してもらいましょう。", "face": "u2150a1"}, {"name": "マイン", "text": "……証明？\nって、うわっ、何だこの振動！？", "face": "u672"}, {"name": "アルレット", "text": "あの船だ！\nあれが――浮上しようとしてる！！", "face": "u1453a1"}, {"name": "プロメ", "text": "既に大破して久しい船ですが、\nその炉に、私の火を投げ入れました。", "face": "u2150a1"}, {"name": "プロメ", "text": "――証明してください。\n誤った力を御するだけの、正しき力を持つことを。", "face": "u2150a1"}, {"name": "プロメ", "text": "もちろん、生きてここを出られたら、ですが。", "face": "u2150a1"}, {"name": "ドリー", "text": "ちっ……あんなのが浮上したら、\n戦う前に溶岩に呑まれて溶けちまうぞ！", "face": "u599"}, {"name": "グリム", "text": "て、転移も間に合わないです！\n溶岩の魔力が濃すぎて術がっ！？", "face": "u942"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "シビラ", "text": "なるほど、こういうことね……。", "face": "u39"}, {"name": "リリア", "text": "あっ……あの時出会った、亜神さまの……？", "face": "u20"}, {"name": "シビラ", "text": "助けを呼べって、言っていたものね。\n――助けてくれるのでしょう？\nオラティル様――もうひとりの、文明の亜神！", "face": "u39"}, {"name": "オラティル", "text": "――ふふっ、ああ、もちろんだとも。\nさぁみんな、上層にぶっ飛ばすよ！", "face": "u2149a1"}, {"name": "オラティル", "text": "プロメにも困ったものだよねぇ。\n大好きな人類に、こんな試練を与えるなんて、さ。", "face": "u2149a1"}]}], "active": true}