{"quest_id": 8242, "name": "時代の番人", "description": "未来にあるべき技術を求める王子たちを\n焼き尽くすべく、亜神プロメが襲い来る！\n＜HPに継続ダメージ：中＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["HPに継続ダメージ：中"], "event": "目覚めの炎", "event_category": "History", "mission_id": 920214, "map_no": 4885, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 14}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 4000, "attack": 250, "base_hp": 4000, "base_attack": 250, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 50, "attack_interval": 216, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2152128, "race_id": 9, "special_effect_id": 773, "master_id": 37358, "global_id": 10975, "spawn_sec": 17}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "tags": ["置物", "アーマー"], "fixture": true, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 100, "attack_range": 40, "attack_speed": 1, "attack_wait": 60, "att