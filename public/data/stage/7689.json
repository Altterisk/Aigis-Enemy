mage_type": "physical", "armor_defense": 150, "pattern_id": 2098592}, {"enemy_id": 18, "form_index": 0, "hp": 600, "attack": 300, "damage_type": "physical", "pattern_id": 2098640}, {"enemy_id": 19, "form_index": 0, "hp": 6000, "attack": 300, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2130976}]}, "active": true}