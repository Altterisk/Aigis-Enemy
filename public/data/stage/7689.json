{"quest_id": 7689, "name": "第四陣 帝国の分水嶺", "description": "帝国軍と冥界軍の混成部隊が結集。\n両陣営の総力をあげた戦の火蓋が切られる！\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国四陣", "event_category": "Empire", "mission_id": 940004, "map_no": 4592, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 20000, "attack": 450, "base_hp": 20000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130064, "race_id": 16, "master_id": 34058, "global_id": 7675, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["機械", "帝国"], "hp": 10000, "attack": 560, "base_hp": 10000, "base_attack": 560, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 185, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2132992, "race_id": 16, "special_effect_id": 957, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34610, "global_id": 8227, "ranged": true, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["鳥"], "hp": 3200, "attack": 300, "base_hp": 3200, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_range": 130, "attack_speed": 1, "attack_wait": 3, "attack_interval": 49, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123008, "race_id": 12, "special_eff