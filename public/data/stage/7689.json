speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103408, "race_id": 8, "change_to": 15, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 444, "global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "spawn_sec": 162}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}, {"enemy_id": 17, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 400, "base_hp": 1000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "attack_speed": 20, "attack_wait": 10, "attack_interval": 86, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098592, "race_id": 2, "master_id": 148, "global_id": 147, "spawn_sec": 165}, {"enemy_id": 18, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098640, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 151, "global_id": 150, "ranged": true, "spawn_sec": 181}, {"enemy_id": 19, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "attack_range": 210, "attack_speed": 1, "attack_wait": 25, "attack_interval": 141, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130976, "race_id": 2, "missile_id": 609, "missile": {"speed": 10.0}, "master_id": 34094, "global_id": 7711, "ranged": true, "spawn_sec": 184}], "popups": ["発光するマスに配置した\nユニットは射程が\n上昇します。", "ダークエルフドルイドから攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n複数のダークエルフドルイドから\n攻撃を受けた場合、\n継続ダメージ効果が重複します。\n　　　　　　(1/2)", "ダークエルフドルイドの\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "セグナンド", "text": "――あえて、帝国の布陣が完了するのを待つとは。\n盟友ハイドース殿は、\n奴らに一片たりとも言い訳をさせぬつもりらしい。", "face": "l20ac59a2a223"}, {"name": "ダークエルフ", "text": "セグナンド様、それはいったいどういう……。", "face": "l0e68ae181da5"}, {"name": "ベラート", "text": "奇襲を受けたから負けた、卑怯な手段で負けた、\nそんな言い訳も出来ぬよう、\n万全の帝国軍を潰すつもりなのでしょうな。", "face": "l21787b277675"}, {"name": "オークロード", "text": "いいのかベラート伯爵。\nそのすり潰される軍は\nお前のかつての同胞たちだろう？", "face": "l7abef6f2023c"}, {"name": "ベラート", "text": "ははは、何をいまさら。我が祖国とは\n白の王国であって、白の帝国ではないのですぞ。\n……それに彼らも、覚悟を持ってあちらに立っているはず。", "face": "l21787b277675"}, {"name": "リンクス", "text": "……自分でここにいることを選んだ者が、\nいったいどれだけいるのか疑問だけれど。", "face": "u1561a1"}, {"name": "ベラート", "text": "必要な、しかし忘れてはならぬ尊い犠牲、\nそう心に刻んでおけばそれでよいだろうとも。", "face": "l21787b277675"}, {"name": "リンクス", "text": "異種族が口を挟むことじゃなかったわね。\n人の国家のことは、人が決めていくべきだもの。", "face": "u1561a1"}, {"name": "クロコ", "text": "……ソロソロ時間ダ。\nコノ戦いコソ、帝国攻略の分水嶺ト聞いてイル。\n各々、本懐ヲ遂げられるコトヲ祈ってイルゾ。", "face": "l9164578f1e0d"}, {"name": "セグナンド", "text": "ほう、クロコ殿の口からそんな言葉が出るとはな。", "face": "l20ac59a2a223"}, {"name": "クロコ", "text": "コノ身も武を志し、大願を成就サセンとスル者。\n今は助力スルのみの立場ダガ、\n貴公ラの想いハ分かってイルつもりダ。", "face": "l9164578f1e0d"}, {"name": "ベラート", "text": "――では、また会いましょうぞ。\n白の王国を、取り戻すために。", "face": "l21787b277675"}, {"name": "セグナンド", "text": "ダークエルフの誇りを、取り戻すために。", "face": "l20ac59a2a223"}, {"name": "オークロード", "text": "オークが戦士としてあるために。", "face": "l7abef6f2023c"}, {"name": "リンクス", "text": "獣人たちが、妥協と諦観を捨て去るために。", "face": "u1561a1"}, {"name": "ベラート", "text": "取りこぼしてきたもの、諦めていたものを、\nもう一度取り戻すため――我らに勝利を。", "face": "l21787b277675"}]}, {"trigger": "start", "lines": [{"name": "レオナ", "text": "……陛下、冥界軍が動き始めました。", "face": "u311"}, {"name": "白の皇帝", "text": "……これだけの軍勢を揃えておきながら、\nハイドースめ、何を企んでいる。", "face": "u418"}, {"name": "レオナ", "text": "はっ……？", "face": "u311"}, {"name": "白の皇帝", "text": "……いや、悩んでいる時間はないか。\n全軍に開戦を知らせろ。", "face": "u418"}, {"name": "レオナ", "text": "はっ！　――総員、戦闘配置につけ！\n全軍での激突となるぞ！！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "はぁ……始まっちまったか。\n怪我人はこっちへ！\n重傷者はアウローラ様のところだ！", "face": "u1551a1"}, {"name": "？？？", "text": "グラティア！？　どうしてこんなところに！\nここは最前線ですよ！！\n非戦闘員は早く市壁の中に――", "face": "u1554a1"}, {"name": "グラティア", "text": "いやいや、戦えるんだから戦闘員さ、トゥーダ。\n神官戦士殿直々に、ちゃんと訓練も受けてるわけだしね。", "face": "u1551a1"}, {"name": "グラティア", "text": "それにアタシの打った武具に、\nみんな命を預けて戦ってんだ。\n見届ける責任ってやつがあるだろ？", "face": "u1551a1"}, {"name": "トゥーダ", "text": "はぁ……しかしあまり前線に出ないように。\nこれは帝国の存亡をかけた戦いです。なれば、\n帝国騎士、軍、神官戦士こそが命をはるべきですから。", "face": "u1554a1"}, {"name": "グラティア", "text": "心得ておくよ。\nはぁ……花の似合う麗しの神官さまが、\n今や最前線に咲く屈強な神官戦士さまか。", "face": "u1551a1"}, {"name": "トゥーダ", "text": "なにか？", "face": "u1554a1"}, {"name": "グラティア", "text": "いいや、アタシも頑張らないとなって思っただけ！\nさぁ怪我人を運ぶよ！　手を貸してくれ！", "face": "u1551a1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 18, "params": [150]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 20000, "attack": 450, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2130064}, {"enemy_id": 2, "form_index": 0, "hp": 10000, "attack": 560, "damage_type": "physical",