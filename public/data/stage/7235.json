{"quest_id": 7235, "name": "獅子像の阻み", "description": "獅子像を破壊し、天界の戦力を見極めよ！\n＜天界：攻撃力がダウン。\r\n　一部を除く敵味方のＨＰが徐々に回復＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["天界：攻撃力がダウン。\r\n　一部を除く敵味方のＨＰが徐々に回復"], "event": "戸惑いの戦乙女", "event_category": "History", "mission_id": 920155, "map_no": 5862, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -500]}, {"kind": "term", "influence": 41, "params": [0, 100, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 20, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 600, "base_hp": 30000, "base_attack": 600, "damage_type": "magical", "armor_defense": 4000, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 120, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113008, "race_id": 6, "missile_id": 171, "missile": {"speed": 6.0, "splash": 267}, "master_id": 30755, "global_id": 4374, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 2800, "base_hp": 30000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 251, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107408, "race_id": 6, "master_id": 571, "global_id": 570, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 7, "form_count": 1, "hp": 24000, "attack": 2400, "base_hp": 24000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 220, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127024, "race_id": 6, "master_id": 33410, "global_id": 7027, "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100112, "race_id": 16, "master_id": 217, "global_id": 216, "spawn_sec": 7}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 18000, "attack": 1100, "base_hp": 18000, "base_attack": 1100, "damage_type": "magical", "armor_defense": 1100, "magic_defense": 15, "attack_range": 120, "attack_speed": 80, "attack_wait": 40, "attack_interval": 141, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122416, "race_id": 16, "special_effect_id": 222, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 32500, "global_id": 6119, "ranged": true, "spawn_sec": 7}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 8}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107376, "race_id": 6, "master_id": 572, "global_id": 571, "spawn_sec": 26}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 28}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107568, "race_id": 6, "master_id": 872, "global_id": 871, "spawn_sec": 62}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107024, "race_id": 6, "master_id": 697, "global_id": 696, "spawn_sec": 90}], "dialogue": [{"trigger": "start", "lines": [{"name": "スルーズ", "text": "――この先がオリュンポスに続く障壁のふもとです。\n私はもう、通過できなくなっていると思いますが……。", "face": "u1143a1"}, {"name": "トラム", "text": "今回の遠征でオリュンポスに踏み込む必要はないわ。\nむしろ周辺の地理や\n部隊配置を調査するのが本題だもの。", "face": "u1110a1"}, {"name": "サナラ", "text": "障壁と防衛部隊を展開して外部からの侵入を防ぎつつ、\n同時に物質界に戦力を送り込んでくる……。\n明らかにこちらより戦力は上ですからねぇ。", "face": "u921"}, {"name": "アンブローズ", "text": "敵の装備や特性が分かれば勝利。\nこちらが戦える相手かどうかまで\n判断できたら大勝利ってことですねぇ♪", "face": "u1088a1"}, {"name": "スルーズ", "text": "なるほど……？\n突撃するだけが戦争ではない、ということですね。", "face": "u1143a1"}, {"name": "キャリー", "text": "天槍騎兵団ってどんな組織だったんですか……。\n突撃ばかりしてたら命がいくつあっても足りませんよ？", "face": "u26"}, {"name": "スルーズ", "text": "いえ、その……突撃して\n勝てなかった敵はいなかったので……。", "face": "u1143a1"}, {"name": "ミーシャ", "text": "さすがは亜神の娘たち、ですね……。", "face": "u19"}, {"name": "アトナテス", "text": "――おい、雑談はそこまでだ。\nあの動く青銅像……形は違うが見覚えがあるな……。", "face": "u908"}, {"name": "トラム", "text": "青銅像に仮初めの命を与え、\n兵士とする力の産物ね。\nさしずめ、青銅獅子像ってところかしら。", "face": "u1110a1"}, {"name": "トゥアン", "text": "だがあの動き、本物の獅子以上だぞ？\n元が青銅像だとか信じがたいな。", "face": "u1006a1"}, {"name": "アトナテス", "text": "――つまり、あの翼も\n飾りじゃない可能性が高いってことだな。\n道なんて無視して走ってくるぜ。", "face": "u908"}, {"name": "アンナ", "text": "――それでは王子、これより威力偵察を開始します。\n敵側の情報を、少しでも多く持ち帰りましょう。"}]}, {"trigger": "end", "lines": [{"name": "ユージェン", "text": "――王子、そろそろ引き際だ。\n敵の大部隊が来る前に撤退しよう！", "face": "u906"}, {"name": "トラム", "text": "障壁の防衛部隊、今の王国の戦力で、\n局所的な戦いに持ち込めば突破できそうね。", "face": "u1110a1"}, {"name": "ソラス", "text": "全戦力を一箇所に集中することはできませんからね。\n障壁の一部にこちらの本隊をぶつければ、\nおそらく防衛隊は撃破可能でしょう。", "face": "u904"}, {"name": "アージェ", "text": "……忠告。\n敵もそれは把握しているかと。", "face": "u1090a1"}, {"name": "トゥアン", "text": "自国の弱点を知る王は優秀だ。\nあえて兵を分散させているのは、\n障壁への絶対的な自信と――", "face": "u1006a1"}, {"name": "アトナテス", "text": "――兵からの報告を受けた後、\n襲撃者を撃退する本隊への信頼ってことだな。", "face": "u908"}, {"name": "スルーズ", "text": "それに、あちらには姉さま――天槍騎兵団もいます。\n物質界に派遣されたのは一部の兵ですから、\nオリュンポスにはさらに多くの兵が……。", "face": "u1143a1"}, {"name": "アンナ", "text": "障壁の突破に、兵の強化……。\n課題は山積みですね。", "face": "lf33720f3a739"}, {"name": "アンナ", "text": "ですが、私たち以外に\nこの事態を制圧できる戦力は存在しません。\n勝利に向けて、一歩ずつ進んでいきましょう！"}]}], "story_talk": true, "active": true}