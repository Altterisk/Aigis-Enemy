rmor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30, "global_id": 29, "ranged": true, "spawn_sec": 57}, {"enemy_id": 5, "source": "local", "count": 9, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 66}, {"enemy_id": 6, "source": "local", "count": 9, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 71}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4200, "attack": 380, "base_hp": 4200, "base_attack": 380, "damage_type": "magical", "armor_defense": 1500, "attack_range": 140, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127440, "special_effect_id": 510, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33528, "global_id": 7145, "ranged": true, "spawn_sec": 86}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団"], "hp": 9000, "attack": 1700, "base_hp": 9000, "base_attack": 1700, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 100, "attack_interval": 252, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124336, "special_effect_id": 510, "change_to": 8, "change_condition": 2, "master_id": 32735, "global_id": 6353, "to_condition": 2, "to_global_id": 6354, "spawn_sec": 117}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団", "アンデッド"], "hp": 100000, "attack": 1000, "base_hp": 100000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 10000, "magic_defense": 90, "attack_speed": 1, "attack_wait": 120, "attack_interval": 292, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124352, "special_effect_id": 562, "master_id": 32736, "global_id": 6354, "from_condition": 2}], "popups": ["ホワイトクルセイダーは倒されると、\nその場で復活します。\n\n復活後、ホワイトクルセイダーは\n強くなりますが、HPが徐々に減少し\nいずれ自滅します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "クレイブ", "text": "――王子、ご無事でしたか。", "face": "u8"}, {"name": "アンナ", "text": "クレイブさん！　戻っていたんですね！\n王城の状況はどうなっていますか？", "face": "lf1463357272b"}, {"name": "クレイブ", "text": "えぇ、神聖騎士団の不穏な噂を聞きましたから。\n――王城内の軍は、もはや正常に機能していません。\n誰が精神支配を受けているかも、定かではないので……。", "face": "u8"}, {"name": "ギャレット", "text": "今は遊撃隊を結成し、話の通じないヤツを\nぶん殴って眠らせているところだ。", "face": "u9"}, {"name": "サイラス", "text": "……王国の弱点を見事に突かれたというわけだな。", "face": "u13"}, {"name": "バルバストラフ", "text": "王国とて未だ復興の途中。\n警備の兵に神聖騎士団員が紛れていたとしても、\nそれに気付かなかったことを責められはせんわい。", "face": "u63"}, {"name": "サイラス", "text": "即席での部隊編成が裏目に出た、ということだな。\nだがようやく王子の本隊が到着した。\n反撃はここからだとも。", "face": "u13"}, {"name": "シビラ", "text": "――王国は、もう二度と敗北しない。\nその約束を守る時よ、王子。\n勝つための戦いではなく、守るための戦いを。", "face": "u39"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アリア", "text": "みんな！　これから反撃に出るよ！！\nまずは玉座の間までの道を取り戻すっ！！", "face": "u75"}]}, {"trigger": "end", "lines": [{"name": "神聖騎士団員", "text": "――ほう、もう王国軍本隊がここまで来たか。\nやはり教化しただけの兵では、\n捨て駒程度にしか使えないな……。", "face": "la9115bd85047"}, {"name": "アレクシア", "text": "申し訳ありません。\n私が足止めを失敗したせいです。", "face": "u1168a1"}, {"name": "神聖騎士団員", "text": "よい、我らが主は過ちを責めることはしない。\n過ちは償えば良いだけなのだからな。", "face": "la9115bd85047"}, {"name": "神聖騎士団員", "text": "千人隊長殿、アレクシアに戦士の加護を。\n此度の戦いで戦果を上げたなら、\nこの娘も我らの如き鎧の身体を授けられることだろう。", "face": "la9115bd85047"}, {"name": "千人隊長", "text": "うむ。ドゥマルデ審問官は\nアレクシアを鎧の身体にすることを渋っていたが、\n実力も魔力も十分に備わっているからな。", "face": "l2ba524d84443"}, {"name": "アレクシア", "text": "……あ、あの、何の話なのでしょうか？\n私に戦士の、加護……？", "face": "u1168a1"}, {"name": "千人隊長", "text": "怖れることはない。\n我らが主の戦士として戦い、その陶酔が\n終わった時には、お前は大戦果を上げているのだから。", "face": "l2ba524d84443"}, {"name": "アレクシア", "text": "そんな……意思を奪い戦わせて、\n本当にそれが、私たちの信じてきた教義ですか！？", "face": "u1168a1"}, {"name": "神聖騎士団員", "text": "――主がお望みになったことだ。", "face": "la9115bd85047"}, {"name": "千人隊長", "text": "――王国の民を我らが主の信徒とせよ。\nそれこそが我が主のお告げなのだから。", "face": "l2ba524d84443"}, {"name": "アレクシア", "text": "いやっ……嫌です！\n私は誰かを殺すために騎士になったのでは――", "face": "u1168a1"}, {"name": "千人隊長", "text": "――眠れ、そして目覚めよ、荒ぶる戦士の魂よ。", "face": "l2ba524d84443"}]}], "active": true}