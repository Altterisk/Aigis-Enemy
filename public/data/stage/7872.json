hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 275, "change_to": 12, "master_id": 35853, "global_id": 9470, "to_global_id": 9471}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 8, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 1247, "change_to": 13, "master_id": 35854, "global_id": 9471, "to_global_id": 9472}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 9, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 275, "change_to": 14, "master_id": 35855, "global_id": 9472, "to_global_id": 9473}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 1248, "change_to": 15, "master_id": 35856, "global_id": 9473, "to_global_id": 9474}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142848, "special_effect_id": 275, "change_to": 16, "master_id": 35857, "global_id": 9474}, {"enemy_id": 26, "source": "local", "count": 17, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112816, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30725, "global_id": 4344, "ranged": true, "spawn_sec": 99}], "popups": ["武成豪侠？は\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で２倍までアップ\n\nまた、武成豪侠？は一定確率で\n物理攻撃を回避します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "狛天君", "text": "――ワシをここまで追い詰めるか。\n名高き華王が武将、武成豪侠と呼ばれる者だ……。", "face": "lba7fbf9e3bb2"}, {"name": "武成豪侠？", "text": "強がりもそこまでだ。\n十天君がひとり、狛天君よ！\n我が祖国を害したその罪、ここで死をもって償うがいい！", "face": "u1720a1"}, {"name": "狛天君", "text": "ヌゥゥッ！\nだが、ワシもここで散るわけにはいかぬ。\nチェェェェェイッ！！", "face": "lba7fbf9e3bb2"}, {"name": "武成豪侠？", "text": "なっ、この仙術――目眩ましか！？", "face": "u1720a1"}, {"name": "狛天君", "text": "仙人ならぬその身では、\nワシを追うことなどできまい！\nヌハハハハハッ！！", "face": "lba7fbf9e3bb2"}, {"name": "武成豪侠？", "text": "……西へ逃げたか。\nそちらの方角には、いま彼らがいるはずだけど――", "face": "u1720a1"}, {"name": "武成豪侠？", "text": "はぁ……首級を譲るわけにはいかないな。\n僕も後を追うとしようか。", "face": "u1720a1"}]}, {"trigger": "start", "lines": [{"name": "ケイティ", "text": "――華の国からの正式な招待とは……。\n確か、彼の国は未だ復興の最中だったのでは？", "face": "u114"}, {"name": "清源妙道真君", "text": "えぇ、魔物の復活と、邪仙による襲撃により、\n華の国の体制は大きく乱れました。", "face": "u866"}, {"name": "清源妙道真君", "text": "特に、国家の長たる華王、誅子が存命であることが、\n華の国の復興の大きな足枷となっているのです。", "face": "u866"}, {"name": "ヴェロッテ", "text": "……ん？\n華王……そのチューシ様って人が生きてるなら、\nむしろ復興がさくさく進みそうなものじゃない？", "face": "u150"}, {"name": "竜吉公主", "text": "そうも行かない理由があるのよ。\n邪仙の襲撃があったあの時、\nあの過保護で忠義が重すぎの邪仙が――", "face": "u663"}, {"name": "ナタク", "text": "――おっと、話はまた後で、だ。\nこの気配……仙人、いや、邪仙のものだね。\n随分と近い……王子、こちらへ向かってくるよ！", "face": "u297"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "狛天君", "text": "チィッ、華の国の狂犬の後は王国か！", "face": "lba7fbf9e3bb2"}, {"name": "ナタク", "text": "狛天君！\nまた何か悪巧みを――というわけでもなさそうだ。\n手負いの今こそ、ヤツを捕らえる好機だ！", "face": "u297"}, {"name": "狛天君", "text": "フンッ！　ワシの邪魔をするというのなら、\nこのまま押し通るッ！！", "face": "lba7fbf9e3bb2"}]}, {"trigger": "battle", "at_sec": 59, "lines": [{"name": "武成豪侠？", "text": "……このままだと、\n狛天君の首は王国に渡ってしまう、か。\nそれはまずいな……うん、まずい。", "face": "u1720a1"}, {"name": "武成豪侠？", "text": "客人に手を出すのはご法度だけど、\nそれ以上に、十天君を\n渡すわけにはいかない理由があるからね。", "face": "u1720a1"}, {"name": "武成豪侠？", "text": "さぁ、ちょっと乱戦にさせてもらおうか！", "face": "u1720a1"}]}, {"trigger": "end", "lines": [{"name": "清源妙道真君", "text": "――狛天君、ようやく捕らえましたよ。", "face": "u866"}, {"name": "ナタク", "text": "詳しい話と、他の十天君の居場所、\n王国に戻ったら詳しく聞かせてもらわないとね。", "face": "u297"}, {"name": "狛天君", "text": "……クッ、ククク。\nヌハハハハハッ！　何を生ぬるいことをッ！", "face": "lba7fbf9e3bb2"}, {"name": "狛天君", "text": "さぁ来るぞ、ワシの死が、\n永劫を生きる邪仙の終わりが――", "face": "lba7fbf9e3bb2"}, {"name": "武成豪侠？", "text": "――覚悟ができているようで何よりだ。\n十天君がひとり、狛天君の首、僕がもらい受ける！", "face": "u1720a1"}, {"name": "狛天君", "text": "ぐぁ――ッ！　――ッ！", "face": "lba7fbf9e3bb2"}, {"name": "狛天君", "text": "…………。\n………………。", "face": "lba7fbf9e3bb2"}, {"name": "アンナ", "text": "なっ……何者ですか！？", "face": "l0090ce416ab2"}, {"name": "ナタク", "text": "……邪仙と言えど、まさかその首をはねるとは。\nまったく、君らしくもないやり方だね、\n華の国が武将のひとり、武成豪侠、フェイロン。", "face": "u297"}, {"name": "フェイロン", "text": "これはナタク様、お見苦しいところを。\nそれに太公望様や、清源妙道真君様までお揃いで。", "face": "u1720a1"}, {"name": "アンナ", "text": "……あの方は、いったい？", "face": "l0090ce416ab2"}, {"name": "太公望", "text": "華の国が王、誅子の側近がひとり。\n彼の国を守護する古い家系の者です。", "face": "u603"}, {"name": "清源妙道真君", "text": "その由緒正しい武将が、\n捕虜の首を横から奪いに来たわけです。\n――フェイロン、申し開きは？", "face": "u866"}, {"name": "フェイロン", "text": "いやいや、最初に手傷を負わせたのは僕ですから。\n狩りの獲物とは、\n先に矢を射掛けた者にこそ権利があるものでしょう？", "face": "u1720a1"}, {"name": "清源妙道真君", "text": "……そんな建前は結構。\nあなた程の武将が焦ってトドメを奪いに来たのです。\nおそらくそうしなければならない理由がある。", "face": "u866"}, {"name": "清源妙道真君", "text": "狛天君の首が手土産になるならそれで構いません。\n王国を巻き込もうというのなら、\nそれなりの説明をしてもらいますよ。", "face": "u866"}, {"name": "フェイロン", "text": "これは手厳しい。\nでは、華の国が王都にご案内しましょう。", "face": "u1720a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}