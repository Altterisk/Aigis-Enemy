{"quest_id": 7872, "name": "手負いの邪仙", "description": "復興を進める華の国から招待を受けた\n王子一行。目的地に向かっていると\nなにやら邪仙の気配が近づいてきて……。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "華国演義・崑崙へ至る道", "event_category": "History", "mission_id": 920193, "map_no": 4693, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 1500, "base_hp": 7000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 250, "magic_defense": 30, "attack_range": 80, "attack_speed": 80, "attack_wait": 90, "attack_interval": 246, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112800, "missile_id": 235, "missile": {"speed": 4.0, "splash": 267}, "master_id": 35840, "global_id": 9457, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 14, "form_count": 1, "hp": 2500, "attack": 350, "base_hp": 2500, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112624, "master_id": 30704, "global_id": 4323, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112640, "master_id": 30705, "global_id": 4324, "spawn_sec": 39}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["武狭"], "hp": 10000, "attack": 550, "base_hp": 10000, "base_attack": 550, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 10, "attack_wait": 20, "attack_interval":