: 2, "form_count": 3, "tags": ["アンデッド", "機械"], "hp": 18000, "attack": 850, "base_hp": 18000, "base_attack": 850, "damage_type": "physical", "armor_defense": 180, "magic_defense": 5, "attack_range": 300, "attack_speed": 1, "attack_wait": 100, "attack_interval": 229, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 0.8999999761581421, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129312, "race_id": 7, "special_effect_id": 813, "missile_id": 26, "master_id": 33813, "global_id": 7430, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 19, "source": "local", "count": 10, "form_count": 1, "hp": 1000, "attack": 3000, "base_hp": 1000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_range": 10, "attack_speed": 65, "attack_wait": 80, "attack_interval": 197, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098864, "race_id": 16, "special_effect_id": 229, "missile_id": 56, "missile": {"speed": 1.0, "splash": 80}, "master_id": 127, "global_id": 126, "ranged": true, "spawn_sec": 115}, {"enemy_id": 20, "source": "local", "count": 24, "form_count": 1, "tags": ["変異"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 236, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 0.8999999761581421, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2129360, "race_id": 7, "special_effect_id": 66, "master_id": 33821, "global_id": 7438, "spawn_sec": 134}, {"enemy_id": 21, "source": "local", "count": 10, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 21, "master_id": 30346, "global_id": 3965, "to_global_id": 3964, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 164}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 20, "master_id": 30345, "global_id": 3964}], "popups": ["ダブルヘッドメカゾンビシャークは\n攻撃力500以下の\nあらゆる攻撃を受け付けません。\n\nまた、ニ種類の攻撃を行い、\nどちらの攻撃を受けても、\n即座に麻痺状態になります。\n　　　　　　(1/2)", "ダブルヘッドメカゾンビシャークは\n二種類の攻撃を行うたびに、\n攻撃力がアップしていきます。\n\n２回目の攻撃後、\n攻撃力が最大になります。\n※３回目以降の攻撃力が最大\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "絡繰り忍者", "text": "――来たか、清らかなる戦士たる娘よ。\nサメにすら慈悲を向ける癒し手よ。", "face": "lcf9b31284712"}, {"name": "イーリス", "text": "絡繰り忍者さん、サメさんたちを解放してください。\n死体を弄び、改造までするなんて\n女神アイギス様が許しませんよ！", "face": "u1261a1"}, {"name": "絡繰り忍者", "text": "――笑止。邪神の甘言になど惑わされぬぞ。\nこの世で信ずるに値するは、己の技術と金のみにござる。", "face": "lcf9b31284712"}, {"name": "ポーラ", "text": "さすがは金次第でなんでもする、伝説の絡繰り忍者です。\nイーリス、こいつに話は通じないです。", "face": "u519"}, {"name": "絡繰り忍者", "text": "然り。されどその曇りなき心に打たれたのもまた事実。\n我が実験の成果をもって敬意を表すとしよう。", "face": "lcf9b31284712"}, {"name": "絡繰り忍者", "text": "異形なる顎、空を舞う機械の鎧、双頭たる海の王者……。\n我が実験の行き着く先。\n忍法変異口寄せ――ダブルヘッドメカゾンビシャークッ！！", "face": "lcf9b31284712"}]}, {"trigger": "start", "lines": [{"name": "イーリス", "text": "なっ……さっきのサメさんの姿が……っ！？", "face": "u1261a1"}, {"name": "ジークリンデ", "text": "頭が、ふたつ……？\nいったいどうなっているんだ。", "face": "u1024a1"}, {"name": "メフィスト", "text": "まさに狂気の研究、か……。\n王子、こいつは紛れもない「変異種」だ！", "face": "u1036a1"}, {"name": "イーリス", "text": "王子、サメさんの声が聞こえてきます……。\n助けてって、そう言っているように思えるんです。\nここでサメさんを倒し、魂を解放してあげましょう！", "face": "u1261a1"}]}, {"trigger": "end", "lines": [{"name": "絡繰り忍者", "text": "――我が研究成果を破壊するか。\n完全体にまで成長させられなかったのは残念だが、\nこれにて実験は完了にござる。", "face": "lcf9b31284712"}, {"name": "絡繰り忍者", "text": "変異種と機械化の融合……。\n我が実験は、滞ることなく進んでいる。\n貴公らの妨害、一足遅かったと思い知れ。", "face": "lcf9b31284712"}, {"name": "ジークリンデ", "text": "逃げるつもりか？\nここは海上だぞ、絡繰り忍者。", "face": "u1024a1"}, {"name": "絡繰り忍者", "text": "――笑止千万。\nシノビなれば海の上など造作もない。", "face": "lcf9b31284712"}, {"name": "絡繰り忍者", "text": "まずは実験の成果を、奴らに報告するとしよう。\n然らば御免、王国軍の者たちよ。", "face": "lcf9b31284712"}, {"name": "イーリス", "text": "海の上を走るなんてずるいです……！\nうぅ、これでは追いつけませんね……。", "face": "u1261a1"}, {"name": "クリスタ", "text": "でも、この海域の安全は取り戻せましたわ。\nきっとサメたちも感謝していますわよ？", "face": "u1257a1"}, {"name": "イーリス", "text": "そう、ですよね。\nよぉし、漁師さんたちに伝えてあげましょう！", "face": "u1261a1"}, {"name": "アンナ", "text": "……絡繰り忍者は、\nいったい誰に雇われているのでしょうか。", "face": "l6abb4fe50f67"}, {"name": "アンナ", "text": "変異技術に、機械化技術……。\nこれ以上の企みを防ぐためにも、\nより厳しく監視をしなければなりませんね。", "face": "l08268a39711e"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}