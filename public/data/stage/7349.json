{"quest_id": 7349, "name": "ダブルヘッドメカゾンビシャーク", "description": "王子たちはついに絡繰り忍者が待つ海域に\n辿り着く。イーリスと協力し、改造された\nゾンビシャークたちの魂を解放せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "逆襲のメカゾンビシャーク", "event_category": "History", "mission_id": 920162, "map_no": 5877, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 32000, "attack": 1050, "base_hp": 32000, "base_attack": 1050, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126672, "race_id": 16, "special_effect_id": 663, "change_to": 1, "master_id": 33332, "global_id": 6949, "to_condition": 2, "to_global_id": 6936, "route_behaviour": {"transforms": [{"wait": 120}], "sets_flags": [[0, 0, 30], [0, 1, 30]]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "ステルス"], "hp": 90000, "attack": 1200, "base_hp": 90000, "base_attack": 1200, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 58, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126688, "race_id": 16, "special_effect_id": 664, "master_id": 33319, "global_id": 6936, "from_condition": 2}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 8, "tags": ["変異", "アンデッド", "機械", "ステルス"], "hp": 36000, "attack": 1000, "base_hp": 36000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 550, "magic_defense": 5, "attack_speed": 1, "attack_interval": 30, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129328, "race_id": 7, "change_to": 5, "master_id": 33822, "global_id": 7439, "to_global_id": 7431, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count