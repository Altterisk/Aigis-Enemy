 "tags": ["機械"], "hp": 6800, "base_hp": 6800, "damage_type": "physical", "armor_defense": 50, "attack_speed": 100, "attack_wait": 30, "attack_interval": 201, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110496, "race_id": 16, "special_effect_id": 242, "master_id": 30363, "global_id": 3982, "spawn_sec": 1}, {"enemy_id": 14, "source": "local", "count": 24, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 9}, {"enemy_id": 15, "source": "local", "count": 2, "level": 70, "form_count": 1, "hp": 100000, "attack": 4500, "base_hp": 100000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 115, "attack_wait": 100, "attack_interval": 401, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109424, "race_id": 13, "master_id": 30314, "global_id": 3933, "spawn_sec": 14}, {"enemy_id": 16, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 42}, {"enemy_id": 17, "source": "local", "count": 7, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 58}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンクイーン", "text": "あぁ～～。\nハラハラドキドキしてきたわぁ～～。\n命をかけたレースって本当に楽しいわねぇ。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "さぁ次のレースも早速始めるわよぉ。\n次にビリになるのは誰かしらねぇ～～！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "（――こ、このままでハ、せっかく育てた\n操縦士が処刑されテしまう……\n……そうダ、あの人間をビリにすれバ！）", "face": "l16b6c88b22e6"}, {"name": "ゴブリン博士", "text": "（しかし生半可な妨害では、\n王子達に邪魔されてしまウ……仕方なイ、\nボアを使って妨害してやるのダ……！）", "face": "l16b6c88b22e6"}, {"name": "アンナ", "text": "――ティアルさん、頑張ってください！"}, {"name": "ボリス", "text": "絶対負けんじゃねーぞ！", "face": "u360"}, {"name": "バシラ", "text": "ティアルさんなら絶対勝てます！\nまた、ビューンと抜き去っちゃってください！", "face": "u28"}, {"name": "ティアル", "text": "えへへ、任せておいて。\nかっこいい所、皆に見せてあげるんだから。\nそれじゃ皆……応援よろしくねっ！！", "face": "u505"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン", "text": "――ギャギャアアアアアアァァっ！", "face": "lad7d66fc429b"}, {"name": "ゴブリンクイーン", "text": "ウフフ。処刑も済んだところで、\nそろそろ会場を変えたい所だわねぇ。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "もっとスピードが出せそうな所……、\nそうねぇ……｢海｣なんてどうかしらぁ！？", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "う、海……ですカ……。\n確かにスピードは出せるかもしれませんガ、\n海の潮で機体がボロボロにな――", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "やっぱりそう思うわよねぇ？　博士！\nじゃあ早速会場の準備をするのよぉ！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "は、はい……。\n（あぁぁ……ワタクシのクグツが……）", "face": "l16b6c88b22e6"}, {"name": "アンナ", "text": "どうやら、会場を変えるようですね。\n次の会場は……海、ですか。", "face": "l335f9088597e"}, {"name": "ボリス", "text": "今のままじゃ、潮でくぐつがダメになっちまうかもな。\n……昔、教えた錆止め用の塗装技術、\nちゃんと覚えてるか？", "face": "u360"}, {"name": "ティアル", "text": "も、もちろんです先生！　\nえーっと、め、メッキとそー？　ですよね。\nまずはしっかりと表面を磨きあげて――", "face": "u505"}, {"name": "ベルナール", "text": "どうやら、私の出番のようですね。\nどれ、研磨材を貸してみなさい。\n……ウオオオォォォッ！！", "face": "u10"}, {"name": "バシラ", "text": "す、凄いです！　表面がどんどん\nツルツルに磨き上がっていきます！！", "face": "u28"}, {"name": "ボリス", "text": "やるじゃねぇか。これなら、\n次のレースまでには充分間に合いそうだな。", "face": "u360"}, {"name": "アンナ", "text": "良かった、海でのレースも問題はなさそうですね。"}, {"name": "アンナ", "text": "次のレースでも、いつ妨害が入るかわかりません。\n王子、引き続きティアルさんをサポート致しましょう！", "face": "l335f9088597e"}]}], "active": true}