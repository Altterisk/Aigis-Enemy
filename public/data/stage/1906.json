"enemy_id": 15, "source": "local", "count": 5, "form_count": 3, "tags": ["変異"], "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_speed": 180, "attack_wait": 150, "attack_interval": 591, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115680, "race_id": 7, "special_effect_id": 310, "change_to": 8, "missile_id": 299, "missile": {"speed": 1.0}, "master_id": 31249, "global_id": 4868, "to_global_id": 4859, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 222}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["変異"], "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 411, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115680, "race_id": 7, "special_effect_id": 310, "change_to": 9, "missile_id": 299, "missile": {"speed": 1.0}, "master_id": 31240, "global_id": 4859, "ranged": true, "to_global_id": 4860}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["変異", "狙う", "ブロック不可", "水面"], "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 201, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115696, "race_id": 7, "special_effect_id": 310, "change_to": 8, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 31241, "global_id": 4860, "ranged": true}, {"enemy_id": 16, "source": "local", "count": 5, "form_count": 1, "tags": ["機械"], "hp": 35000, "attack": 1000, "base_hp": 35000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1500, "attack_range": 340, "attack_speed": 1, "attack_wait": 60, "attack_interval": 173, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119248, "race_id": 9, "special_effect_id": 383, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 31879, "global_id": 5498, "ranged": true, "spawn_sec": 302}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "tags": ["変異"], "hp": 24000, "attack": 1200, "base_hp": 24000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 550, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119616, "race_id": 3, "special_effect_id": 410, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 31884, "global_id": 5503, "ranged": true, "route_behaviour": {"transforms": [{"wait": 530}]}, "spawn_sec": 364}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "――遅かったジャナイカ。", "face": "l30885ae334f9"}, {"name": "リッカ", "text": "ゴブリン博士、もう退路はありませんよ！\n大人しく投降して、\nピッキーさんのお父さんを解放してください！", "face": "u152"}, {"name": "ゴブリン博士", "text": "フッフッフ……。\n強気でいられるノモ今のうちデアル……。", "face": "l30885ae334f9"}, {"name": "ピッキー", "text": "な、何がおかしいんですかっ！\nもう包囲されているっていうのに――", "face": "u671"}, {"name": "ゴブリン博士", "text": "包囲？　否！\n誘い込まれたノハ、お前タチのほうダ！！", "face": "l30885ae334f9"}]}, {"trigger": "start", "lines": [{"name": "超変異したデーモン剣士", "text": "アア……アアア……。", "face": "le3dfd8360cfd"}, {"name": "ピッキー", "text": "割れた培養槽の中から何かが――\n――あ、あれはっ、さっきのデーモン！？", "face": "u671"}, {"name": "ゴブリン博士", "text": "先の個体は失敗作ダト言ったハズ。\nこの個体こそ、生命力の限界を突き詰めた\n我が最高傑作の超変異したデーモン剣士ダ！！", "face": "l30885ae334f9"}, {"name": "バシラ", "text": "で、でも、さっきのデーモンも倒せたんです。\nこのデーモンだって攻撃し続ければ――！！", "face": "u28"}, {"name": "アンナ", "text": "――っ！？　バシラさんの矢は確かに当たったのに、\n変異したデーモンの傷が一瞬でふさがっていきます！", "face": "le7f6343bd5f3"}, {"name": "ゴブリン博士", "text": "見ヨ！　この驚異的な回復能力！\nコレこそが、実験に実験ヲ重ねて生み出シタ、\n緑なる身体強化の薬液の効果ナノダ……！！", "face": "l30885ae334f9"}, {"name": "コリン", "text": "……そうか、街中にあふれていた緑の液体。\nあれはゴブリン博士の研究の跡だったというわけか。", "face": "u227"}, {"name": "コリン", "text": "だがこれほど肉体に負荷をかけているんだ。\n再生能力も無限ではないんだろう？\nおそらく時間経過で、再生能力も劣化するはずだ。", "face": "u227"}, {"name": "ゴブリン博士", "text": "知ったコトカ！\n再生能力が失われる前に全滅させれば良いノダ！", "face": "l30885ae334f9"}, {"name": "ゴブリン博士", "text": "サァ！　ソノ強靭ナル肉体によっテ、\n王子タチを蹂躙するがヨイ！！", "face": "l30885ae334f9"}, {"name": "ピッキー", "text": "王子、こ、こいつを倒せば、\n鋼の都は取り戻せるんですよね……？", "face": "u671"}, {"name": "ピッキー", "text": "お願いします、王子の旦那っ！\n力を貸してください……！！", "face": "u671"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "超変異したデーモン剣士", "text": "アア……アアア……グォオオオオオオオオッ！！", "face": "le3dfd8360cfd"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "変異種、警備機械、ともに沈黙しました。\n王子、私達の勝利です！"}, {"name": "ゴブリン博士", "text": "――勝利？　勝利ダト？\nフフッ、フフフッ、ファーッハッハッハッ！！\nお前タチはいずれ、真の勝利者を知ることダロウ！", "face": "l30885ae334f9"}, {"name": "ゴブリン博士", "text": "ゴブリンクイーン様、生命科学の真髄と、\n機械技術を習得したワタクシが、\n今御許へ帰還シマスゾ……！！", "face": "l30885ae334f9"}, {"name": "バシラ", "text": "――あぁっ！？\nゴブリン博士が飛行機械に乗って逃げていきますっ！", "face": "u28"}, {"name": "コリン", "text": "身体強化の薬液に、機械の改造技術……。\nゴブリン博士は\nまだゴブリンクイーンを強化するつもりなのか……？", "face": "u227"}, {"name": "アンナ", "text": "……推測の範囲は出ませんが、\nその可能性は高そうですね。", "face": "le7f6343bd5f3"}, {"name": "リッカ", "text": "――あっ、ピッキーさんが戻ってきましたよ！\nおーい！　お父さんはご無事でしたかー！？", "face": "u152"}, {"name": "ピッキー", "text": "はいっ！！　ゴブリン博士の研究に、\n無理やり協力させられていたそうですけど、\nちゃんと無事でしたー！！", "face": "u671"}, {"name": "ピッキー", "text": "ゴブリン博士もいなくなりましたし、\n父さんも帰ってきましたし、\n全部、全部王国の皆さんのおかげです！", "face": "u671"}, {"name": "ピッキー", "text": "本当にありがとうございましたぁ……っ！！", "face": "u671"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ピッキー", "text": "あ、あの、それで、ひとつご相談なんですけど……。\n鋼の都を救っていただいたお礼には\n全然足りないかもしれないんですけど……。", "face": "u671"}, {"name": "ピッキー", "text": "あたしを、仲間に加えていただけないでしょうかぁ！", "face": "u671"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "ピッキー", "text": "えっ、そ、そんな簡単に？\n本当に良いんですか？　良いんですかっ！？", "face": "u671"}, {"name": "アンナ", "text": "魔物との戦いはまだ終わらない以上、\n協力していただける方はいつでも歓迎ですから。\nでも、ちゃんとお父さんの許可を貰ってからですよ？"}, {"name": "ピッキー", "text": "はいっ！　それはもう！\nさっそく父さんに話してきまーすっ！", "face": "u671"}, {"name": "アンナ", "text": "――これで、ようやく鋼の都を\n魔物から奪還できましたね、王子。"}, {"name": "アンナ", "text": "まだまだ私達の戦いは続きますが、\n一歩一歩、平和な世界を目指して進んでいきましょう！"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 29, "params": [0, 60, 5], "expression": "IsEnemyElementAny( \"変異\");", "expression_human": "the enemy is element/tag 変異"}], "enemies": [{"enemy_id": 1, "hp": 180000, "attack": 1100, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "pattern_id": 2119584}, {"enemy_id": 3, "hp": 22500, "attack": 1650, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "pattern_id": 2115712}, {"enemy_id": 3, "form_index": 1, "hp": 22500, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "pattern_id": 2115728}, {"enemy_id": 5, "hp": 22800, "attack": 2700, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2115776}, {"enemy_id": 6, "hp": 4950, "attack": 870, "damage_type": "physical", "pattern_id": 2115744}, {"enemy_id": 6, "form_index": 1, "hp": 4950, "attack": 580, "damage_type": "physical", "pattern_id": 2115744}, {"enemy_id": 9, "hp": 12000, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115680}, {"enemy_id": 9, "form_index": 1, "hp": 12000, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115696}, {"enemy_id": 11, "hp": 12000, "attack": 800, "damage_type": "physical", "armor_defense": 1500, "pattern_id": 2115792}, {"enemy_id": 12, "hp": 36000, "attack": 1800, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "pattern_id": 2119616}, {"enemy_id": 12, "form_index": 1, "hp": 36000, "attack": 1200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "pattern_id": 2119616}, {"enemy_id": 14, "hp": 7500, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2119632}, {"enemy_id": 15, "hp": 12000, "attack": 300, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115680}, {"enemy_id": 15, "form_index": 1, "hp": 12000, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115680}, {"enemy_id": 15, "form_index": 2, "hp": 12000, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115696}, {"enemy_id": 16, "hp": 52500, "attack": 1000, "damage_type": "physical", "armor_defense": 1500, "pattern_id": 2119248}, {"enemy_id": 13, "hp": 36000, "attack": 1200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "pattern_id": 2119616}]}, "story_talk": true, "active": true}