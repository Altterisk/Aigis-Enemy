{"quest_id": 1906, "name": "狂気の研究成果", "description": "研究所の最深部。実験により生み出された\n最も凶悪な存在が解き放たれる。\n驚異的な再生能力を有する怪物を討ち、\n鋼の都を魔物の支配から解放せよ！", "event": "ストーリーミッション9", "event_category": "Story", "mission_id": 100009, "map_no": 1127, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 10, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["変異"], "hp": 120000, "attack": 1100, "base_hp": 120000, "base_attack": 1100, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 295, "attack_speed": 50, "attack_wait": 10, "attack_interval": 87, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119584, "race_id": 3, "special_effect_id": 409, "change_to": 1, "change_condition": 1, "missile_id": 103, "master_id": 31882, "global_id": 5501, "ranged": true, "variants": [{"tags": ["変異"], "hp": 120000, "attack": 4000, "base_hp": 120000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 70, "attack_range": 10, "attack_speed": 50, "attack_wait": 95, "attack_interval": 266, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119600, "race_id": 3, "special_effect_id": 408, "missile_id": 45, "master_id": 31883, "global_id": 5502, "ranged": true}], "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 2, "tags": ["変異"], "hp": 15000, "attack": 1100, "base_hp": 15000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2115712, "race_id": 7, "special_effect_id": 309, "change_to": 3, "master_id": 31242, "global_id": 4861, "to_global_id": 4862, "spawn_se