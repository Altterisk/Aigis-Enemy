l": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349, "spawn_sec": 148}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 12, "master_id": 30346, "global_id": 3965, "to_global_id": 3964, "route_behaviour": {"transforms": [{"to": 30345}]}, "spawn_sec": 181}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 11, "master_id": 30345, "global_id": 3964}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 5000, "base_hp": 5000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2106560, "race_id": 7, "change_to": 14, "master_id": 30344, "global_id": 3963, "to_global_id": 3962, "route_behaviour": {"transforms": [{"to": 30343}]}, "spawn_sec": 181}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "change_to": 13, "master_id": 30343, "global_id": 3962}], "popups": ["クラールフがいる間は\n悪天候『豪雨』が発生します。\n\n 　　悪天候：豪雨\n\n・敵味方の『射程』減少\n・一部の味方は影響を受けない\n　　　　　　(1/2)", "クラールフから攻撃を受けると、\n攻撃後の待ち時間が増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "ムルーア", "text": "あっ、みんなー！　こっちこっちー！", "face": "u2474a1"}, {"name": "アンナ", "text": "ムルーアさん、お出迎えありがとうございます。"}, {"name": "ムルーア", "text": "全然！　こちらこそ来てくれてありがとうだよー！", "face": "u2474a1"}, {"name": "ケイティ", "text": "早速ですが、そちらはどういった状況ですか？", "face": "u114"}, {"name": "ムルーア", "text": "それがねー、みんなあたしの話を聞いてくれないの。\nこっちにはジューンブライドっていう文化がないから、\nあたしが本当にお嫁に行くって誤解してる人もいるし──", "face": "u2474a1"}, {"name": "オーベッド", "text": "『王子がムルーアを弄んで捨てた』という噂が広まっている。", "face": "u1122a1"}, {"name": "王子", "text": "────！？！？", "face": "u1"}, {"name": "アンナ", "text": "なっ、何故そんなことに……。", "face": "lb99dad2ec7a4"}, {"name": "オーベッド", "text": "先日の会議の結果が曲解されているのだ。\n王子が深海式の結婚式を拒否したのだとな。\nそれと前述の誤解が合わさってこの通り──", "face": "u1122a1"}, {"name": "魚人Ａ", "text": "──おいっ、あそこに王子の野郎がいるぞ！！", "face": "l76c123ca285e"}, {"name": "魚人Ｂ", "text": "なにぃ！？　俺たちのムルーアを泣かせたあの王子か！？", "face": "l76c123ca285e"}, {"name": "魚人Ｃ", "text": "許せねぇ、ムルーアの兄(自称)として、\n俺が代わりに王子をぶん殴ってやるぜ！！", "face": "l76c123ca285e"}, {"name": "オーベッド", "text": "──な？", "face": "u1122a1"}, {"name": "ムルーア", "text": "もー、違うって言ってるのにー！！", "face": "u2474a1"}, {"name": "王子", "text": "…………(ショック)", "face": "u1"}, {"name": "クラールフ", "text": "──すまぬ王子よ、我の責任だ。", "face": "l7c7203a3422c"}, {"name": "ムルーア", "text": "クラールフさま！！", "face": "u2474a1"}, {"name": "クラールフ", "text": "我の説明不足がこの事態を招いてしまった。\nもはや我の言葉もあの者たちには届かぬだろう、\n暴走を止めるには力で叩きのめす他に道はない。", "face": "l7c7203a3422c"}, {"name": "クラールフ", "text": "悪いが、相手をしてやってくれまいか。", "face": "l7c7203a3422c"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "クラールフ", "text": "助かる、我は向こうで指揮を執ろう。\n可能な限り怪我人の数を抑えたいが──", "face": "l7c7203a3422c"}, {"name": "兄ではない魚人", "text": "王子、貴様に俺たちの妹はやらんぞー！", "face": "l76c123ca285e"}, {"name": "クラールフ", "text": "……まあ、多少手荒にやってもらっても構わん。", "face": "l7c7203a3422c"}, {"name": "ムルーア", "text": "よーし、戦うよー！！", "face": "u2474a1"}]}, {"trigger": "end", "lines": [{"name": "兄ではない魚人", "text": "──ぐはぁっ！？", "face": "l76c123ca285e"}, {"name": "ムルーア", "text": "わーい、勝った勝ったー！！", "face": "u2474a1"}, {"name": "兄ではない魚人", "text": "ムルーア、なぜそんな男の味方を……。", "face": "l76c123ca285e"}, {"name": "ムルーア", "text": "だってあたし、王子殿下のこと大好きだし？", "face": "u2474a1"}, {"name": "兄ではない魚人", "text": "──げはぁっ！？", "face": "l76c123ca285e"}, {"name": "ホムラ", "text": "魚人は二度死ぬ。", "face": "u2476a1"}, {"name": "クラールフ", "text": "王子よ、面倒をかけてしまったな。\n深海を代表して謝罪させてもらおう。", "face": "l7c7203a3422c"}, {"name": "王子", "text": "…………(ふるふる)", "face": "u1"}, {"name": "クラールフ", "text": "ふっ……そう言ってもらえると助かる。", "face": "l7c7203a3422c"}, {"name": "アンナ", "text": "クラールフ様、ジューンブライドの件ですが……。"}, {"name": "クラールフ", "text": "分かっている、今回の件は借りだ。", "face": "l7c7203a3422c"}, {"name": "クラールフ", "text": "祝祭を深海で開催すべきという意見は変えぬが、\n無理強いする気もない、判断はそちらに委ねよう。", "face": "l7c7203a3422c"}, {"name": "クラールフ", "text": "王子よ、ムルーアを頼むぞ。", "face": "l7c7203a3422c"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "ムルーア", "text": "頼まれちゃったー！？", "face": "u2474a1"}, {"name": "ファルネ", "text": "これで二人目の説得成功、折り返しね。", "face": "u640"}, {"name": "ケイティ", "text": "ですが、グレンさんとクラールフ様は、\n四人の中でも比較的説得の容易なお二人。", "face": "u114"}, {"name": "ケイティ", "text": "……次は、どちらにします？", "face": "u114"}, {"name": "ファルネ", "text": "どっちも気が重いわね。", "face": "u640"}, {"name": "アンナ", "text": "そ、そんなにハッキリと言わなくても……。", "face": "lb99dad2ec7a4"}]}, {"trigger": "end", "lines": [{"name": "ニミュエ", "text": "ふっふっふー。私の出番、でーすねー？", "face": "u2473a1"}]}], "active": true}