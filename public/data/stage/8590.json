{"quest_id": 8590, "name": "誤解と王子のよからぬ噂", "description": "王子の悪い噂に騙されて荒ぶる魚人たち。\nムルーアと共に襲い来る敵を撃退せよ！\n＜クラールフがいる間豪雨が発生＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["クラールフがいる間豪雨が発生"], "event": "異種婚礼狂騒曲", "event_category": "History", "mission_id": 920234, "map_no": 9362, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 35000, "attack": 300, "base_hp": 35000, "base_attack": 300, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 280, "attack_speed": 1, "attack_wait": 50, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2119680, "race_id": 7, "special_effect_id": 413, "missile_id": 376, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 31898, "global_id": 5517, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 2, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104832, "race_id": 7, "change_to": 1, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 576, "global_id": 575, "ranged": true, "to_condition": 4, "to_tick