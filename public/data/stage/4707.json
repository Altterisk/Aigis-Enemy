ged": true, "spawn_sec": 1}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 640, "attack": 300, "base_hp": 640, "base_attack": 300, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098912, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 118, "global_id": 117, "ranged": true, "spawn_sec": 1}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 1}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 1}, {"enemy_id": 11, "source": "local", "count": 15, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 12, "source": "local", "count": 15, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "メレディス", "text": "つきました。\nここが、魔法都市の入口です……が、\n多数のゴブリン達が見張っている様ですね。", "face": "u400"}, {"name": "ケイティ", "text": "あそこしか入口はないのですか？", "face": "u114"}, {"name": "メレディス", "text": "はい。入り口は今見えている\n転送魔法陣しかありません。", "face": "u400"}, {"name": "モーティマ", "text": "じゃあやることは一つだな、王子。\n正面突破すりゃあいいんだろ？", "face": "u14"}, {"name": "アンナ", "text": "モーティマさん、少しは自重してください。\n味方を危険にさらすわけにはいきません。", "face": "la84c39fa5a9d"}, {"name": "モーティマ", "text": "とは言っても、他にいい手はあるのかよ？", "face": "u14"}, {"name": "アンナ", "text": "それは……えっと……え～っと……。", "face": "l0d2c23b4a106"}, {"name": "ケイティ", "text": "悔しいですが、今回ばかりはモーティマさんの\n作戦でいくしかないようですね。", "face": "u114"}, {"name": "モーティマ", "text": "悔しいってどういうことだよ……ったく。\nまあいいか。おい、王子。\nさっさと準備をしな。派手に暴れてやろうぜ。", "face": "u14"}]}, {"trigger": "end", "lines": [{"name": "メレディス", "text": "すごい……。\n全ての見張りを倒してしまうなんて……！\nお強いのですね、王子は。", "face": "u400"}, {"name": "サイラス", "text": "して、どうやってこの魔法都市に入るのだ？", "face": "u13"}, {"name": "メレディス", "text": "それに関してはお任せ下さい。\n転送魔法陣の起動を行います。", "face": "u400"}, {"name": "バルバストラフ", "text": "なんと、転送魔法陣も起動出来るようになったか。\nお主、一体どれだけ研究をしていたのじゃ？\n転送魔法陣の起動はわしにも出来ぬぞ。", "face": "u63"}, {"name": "メレディス", "text": "ふふっ、バルバストラフさんにも後で教えてあげます。\n……あれ？　上手く起動してくれませんね。\nもしかしたらゴブリンたちがいじったのかも……。", "face": "u400"}, {"name": "メレディス", "text": "申し訳ありません、王子。\n解除するのに少し時間がかかりそうですので、\nしばらく周囲の警戒をお願いできますか？", "face": "u400"}, {"name": "アンナ", "text": "任せて下さい、メレディスさん。\nそれでは王子、引き続き周囲を警戒しながら\n交代で休憩をとることにしましょう。"}]}], "active": true}