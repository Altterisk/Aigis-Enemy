ttack_speed": 1, "attack_wait": 45, "attack_interval": 151, "move_speed": 300.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2121440, "race_id": 3, "change_to": 4, "change_condition": 2, "missile_id": 6, "master_id": 32305, "global_id": 5924, "ranged": true, "to_condition": 2, "to_global_id": 5925}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 15000, "attack": 1500, "base_hp": 15000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 260, "magic_defense": 40, "attack_range": 190, "attack_speed": 1, "attack_wait": 45, "attack_interval": 151, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2121440, "race_id": 3, "change_to": 5, "change_condition": 2, "missile_id": 6, "master_id": 32306, "global_id": 5925, "ranged": true, "from_condition": 2, "to_condition": 2, "to_global_id": 5926}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 20000, "attack": 2200, "base_hp": 20000, "base_attack": 2200, "damage_type": "magical", "armor_defense": 480, "magic_defense": 60, "attack_range": 190, "attack_speed": 1, "attack_wait": 45, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2121440, "race_id": 3, "special_effect_id": 222, "missile_id": 6, "master_id": 32307, "global_id": 5926, "ranged": true, "from_condition": 2}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 14000, "attack": 700, "base_hp": 14000, "base_attack": 700, "damage_type": "physical", "armor_defense": 110, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 91, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133792, "race_id": 16, "special_effect_id": 222, "missile_id": 681, "missile": {"speed": 8.0}, "master_id": 34707, "global_id": 8324, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 15, "form_count": 1, "tags": ["水棲", "機械"], "hp": 7500, "attack": 400, "base_hp": 7500, "base_attack": 400, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 60, "attack_wait": 20, "attack_interval": 133, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2151728, "special_effect_id": 1375, "master_id": 37316, "global_id": 10933}, {"enemy_id": 9, "source": "local", "count": 20, "form_count": 1, "tags": ["機械"], "hp": 7000, "attack": 700, "base_hp": 7000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_range": 120, "attack_wait": 60, "attack_interval": 196, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2151712, "race_id": 2, "special_effect_id": 449, "missile_id": 414, "missile": {"speed": 10.0, "splash": 80}, "master_id": 37315, "global_id": 10932, "ranged": true}], "popups": ["エスネア、エフネは倒されると\nその場で復活します。\n\n２回まで復活し、\n復活するたびに強くなります。", "ミニメカクラブウォーリアのおもちゃ\nミニメカドラゴンのおもちゃは\n攻撃力200以下のあらゆる攻撃を\n受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アイシャ", "text": "みんな準備がんばってるね。\nん、ここも賑やか――って遊んでない？", "face": "u2124a1"}, {"name": "シロガネ", "text": "ここは確か、ミニメカバトル部っすね。\n遊んでるっすけど、遊ぶのが活動みたいなもんっす。", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "それってズルくない～？\nじゃあボクも怠惰部とか作って、\n寝ることだけを活動にしたいよ～。", "face": "u2125a1"}, {"name": "シロガネ", "text": "自習部でもずっと寝てるじゃないっすか。", "face": "u2126a1"}, {"name": "レーレン", "text": "ぐ、ぐわあぁぁぁぁッ！！\nあたしのミニメカがバトルに敗北して爆散したぜ！！", "face": "u614"}, {"name": "エフネ", "text": "レーレン先生！　しっかりしてくださいレーレン先生！", "face": "u969"}, {"name": "エスネア", "text": "そんな……！\nこんなのミニメカバトルじゃないよ！", "face": "u1188a1"}, {"name": "エフネ", "text": "そうです！　ミニメカバトルは、\n人を傷つけるものじゃありません！", "face": "u969"}, {"name": "エフネ", "text": "絶対に、あなたを止めます。\nボクとミニメカバトルで勝負です！", "face": "u969"}, {"name": "シロガネ", "text": "なんか揉め事を、\nミニメカバトルで解決しようとしてるっすね。", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "平和だね～。", "face": "u2125a1"}, {"name": "エフネ", "text": "ああっ！？　ボクのミニメカが……暴走してる！？", "face": "u969"}, {"name": "エスネア", "text": "クリスマスにお姉ちゃんからもらったミニメカも、\n暴れ出しちゃったよ！？", "face": "u1188a1"}, {"name": "シロガネ", "text": "全然平和じゃなくなったすよ。", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "なんでこうも事件が起こるかなぁ……。", "face": "u2125a1"}, {"name": "ベルーフェ", "text": "まぁいいや。とにかく止めてあげようか。", "face": "u2125a1"}]}, {"trigger": "end", "lines": [{"name": "シロガネ", "text": "っす。ミニメカたちを鎮圧完了っす。", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "でかしたねシロガネ副官。\n褒美はなにが欲しい？", "face": "u2125a1"}, {"name": "シロガネ", "text": "じゃあ鬼刃姫様への貢ぎ物をたくさん……。", "face": "u2126a1"}, {"name": "アイシャ", "text": "エスネアとエフネだったよね。\n大丈夫？　ミニメカは修理できるくらいに止めたけど。", "face": "u2124a1"}, {"name": "エスネア", "text": "うん、大丈夫だよ。\n止めてくれてありがとうね。", "face": "u1188a1"}, {"name": "ベルーフェ", "text": "ところでキミたちは、\nピカピカ七色に輝くローパーについてなにか知らない？", "face": "u2125a1"}, {"name": "エフネ", "text": "知りませんけど……なんなんですか、それ？", "face": "u969"}, {"name": "アイシャ", "text": "ボクたちもよく分かってないよ。\nおそらくは異界からやって来ているのだと思うけど。", "face": "u2124a1"}, {"name": "エスネア", "text": "異界ってことは、あの子が関わってるんじゃない？", "face": "u1188a1"}, {"name": "エフネ", "text": "ああ、グリムちゃんですか。\n確かに、最近部活で実験してるって言ってましたね。", "face": "u969"}, {"name": "アイシャ", "text": "グリムか……。なるほど、\n彼女なら異界のローパーを呼び出せる。", "face": "u2124a1"}, {"name": "ベルーフェ", "text": "前科も大量にあるし、\n話を聞いてみるべきかもね。", "face": "u2125a1"}, {"name": "シロガネ", "text": "それじゃあ、グリムさんを探しにいくっすよ。", "face": "u2126a1"}]}, {"trigger": "end", "lines": [{"name": "グリム", "text": "…………。", "face": "u2127a1"}, {"name": "グリム", "text": "ついにバレてしまいましたか。", "face": "u2127a1"}, {"name": "グリム", "text": "ですが、私の実験は止められませんよ。", "face": "u2127a1"}, {"name": "グリム", "text": "私には、同志たる顧問がついていますからね。", "face": "u2127a1"}]}], "active": true}