_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098096, "race_id": 9, "master_id": 717, "global_id": 716, "spawn_sec": 98}, {"enemy_id": 17, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 101}, {"enemy_id": 18, "source": "local", "count": 18, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 102}, {"enemy_id": 19, "source": "local", "count": 8, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 103}, {"enemy_id": 20, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097952, "race_id": 9, "change_to": 20, "change_condition": 1, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 54, "global_id": 53, "ranged": true, "variants": [{"hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 24, "attack_wait": 1, "attack_interval": 51, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097968, "race_id": 9, "master_id": 55, "global_id": 54}], "spawn_sec": 120}], "dialogue": [{"trigger": "start", "lines": [{"name": "トトノ", "text": "ふふ……リンネさん、とってもお似合いですよ。", "face": "u316"}, {"name": "リンネ", "text": "うむ……吾（あ）が此の衣装を着ることは必定……。", "face": "u639"}, {"name": "リンネ", "text": "……なれど、これから王子らに披露すると思うと、\nやはり……解っていても恥ずかしいものじゃな……。", "face": "u639"}, {"name": "トトノ", "text": "恥ずかしがってる場合じゃありませんよ。\nリンネさんは来たる『ジューンブライド』で使われる\n衣装の試着役の一人に選ばれたんですからね？", "face": "u316"}, {"name": "トトノ", "text": "もっと堂々と衣装の魅力をアピールして頂かないと。\nほら、どこかキツいところはありませんか？", "face": "u316"}, {"name": "リンネ", "text": "あまり、大きな声では言いたくないが……。\nその……胸の辺りが、少し……。", "face": "u639"}, {"name": "トトノ", "text": "そ、それはけしから……ん？　あれは――！", "face": "u316"}, {"name": "メカゴブリンクイーン", "text": "ウフフ……報告は本当だったようね。\n人間が作ったにしてはなかなか美しいドレスだわ。", "face": "l2cb72fa7c2a7"}, {"name": "ゴブリンプリンセス長女", "text": "えぇ。あれなら更に美しくなって蘇ったお母様の\n美貌を引き立てるのに丁度いいんじゃないかしら。", "face": "ld178ecdcf509"}, {"name": "ゴブリンプリンセス次女", "text": "そうよ。さっき拾ったこの美しい花びらと合わせれば、\n私たち三姉妹が束になっても\nお母様の美しさには敵わなくなってしまうわ。", "face": "l3aae93e603e7"}, {"name": "ゴブリンプリンセス三女", "text": "そこの人間、聞いているのでしょう？\n痛い目に遭いたくなければ、\nそのドレスを脱いで置いていきなさい。", "face": "l35f6d9db5276"}, {"name": "トトノ", "text": "あわわわわ……こ、こうなったら逃げるしか……。", "face": "u316"}, {"name": "リンネ", "text": "……否。案ずる必要はない……。", "face": "u639"}, {"name": "メカゴブリンクイーン", "text": "あら。なぁに、その反抗的な目つきは？\nそんなに無理やり脱がされたいのかしら？", "face": "l2cb72fa7c2a7"}, {"name": "トトノ", "text": "ひぇッ……そ、そんなご無体なぁ……。", "face": "u316"}, {"name": "アンナ", "text": "――そこまでです！\nゴブリンクイーン、これ以上の横暴は許しませんよ！", "face": "lbb3a22565b44"}, {"name": "リンネ", "text": "王子……待っておったぞ。\n賊どもの撃退……吾（あ）も力を貸そう……。", "face": "u639"}, {"name": "リンネ", "text": "……なに、服装の違いなど小さき事よ……。\n任せておくれ……吾がいる限り、汝（なれ）は敗けぬ。", "face": "u639"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンプリンセス長女", "text": "うっ……お、お母様。\nこれ以上はお体に障りますわ……。", "face": "ld178ecdcf509"}, {"name": "メカゴブリンクイーン", "text": "……そうね。\n博士に調整してもらった機械の身体も\n悲鳴を上げていることだし……。", "face": "l2cb72fa7c2a7"}, {"name": "メカゴブリンクイーン", "text": "三人とも、一旦退くわよ！\nあのドレスを頂くのはまた今度にしましょう。", "face": "l2cb72fa7c2a7"}, {"name": "兵士", "text": "――ゴブリンたちの撤退を確認。", "face": "u6"}, {"name": "トトノ", "text": "……ふぅ。皆さん、ありがとうございました。\nおかげさまで、この世界の美がひとつ守られました。", "face": "u316"}, {"name": "アンナ", "text": "そうですね。\nリンネさん、本当に綺麗です……。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "リンネ", "text": "綺麗……か。\nそう云われることは、識っていたというに……。", "face": "u639"}, {"name": "リンネ", "text": "……ままならぬものじゃな。\nいざ……面と向かって告げられると、\n自ずと頬が弛むのを、どうすることもできぬ……。", "face": "u639"}, {"name": "エレイン", "text": "ふふっ、照れちゃってぇ。\nリンネさんって、案外可愛いところあるのね。", "face": "u36"}, {"name": "ダニエラ", "text": "でも羨ましいわぁ。\nああいうドレスって、私には似合う気がしないもの。", "face": "u43"}, {"name": "レアン", "text": "しかし、さぞかし綺麗だろうな。\n沢山の花びらが舞う中を、\nあのドレスを着たリンネが歩いたら。", "face": "u50"}, {"name": "アンナ", "text": "ふふっ。『ジューンブライド』は\n華やかで素敵なイベントになりそうですね。\n……それでは、そろそろ帰還いたしましょう。"}]}], "active": true}