{"quest_id": 6503, "name": "美を求めしゴブリンクイーン", "description": "魔除けの儀式のため、華やかな\n衣裳に身を包みしリンネ。だが、\nそこに美を追い求めし妖魔の軍が迫る。\n神級（★１獲得の目安：平均Lv50）", "event": "世界樹の花嫁", "event_category": "History", "mission_id": 920111, "map_no": 5360, "level": 100, "multiplier": 1.0, "charisma": 115, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 13000, "attack": 400, "base_hp": 13000, "base_attack": 400, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 400, "attack_wait": 60, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114624, "race_id": 9, "special_effect_id": 293, "change_to": 1, "change_condition": 1, "missile_id": 26, "master_id": 31048, "global_id": 4667, "ranged": true, "variants": [{"tags": ["アーマー", "機械"], "hp": 13000, "attack": 1500, "base_hp": 13000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 800, "magic_defense": 10, "attack_wait": 80, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114640, "race_id": 9, "master_id": 31049, "global_id": 4668}], "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 450, "base_hp": 9000, "base_attack": 450, "damage_type": "magical", "armor_defense": 300, "magic_defense": 90, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112080, "race_id": 9, "special_effect_id": 80, "missile_id": 6, "master_id": 31079, "global_id": 4698, "ranged": true, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 450, "base_hp": 9000, "base_attack": 450, "damage_type": "magical", "armor_defense": 300, "mag