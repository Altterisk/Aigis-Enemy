{"quest_id": 7411, "name": "守るべきもの", "description": "終わらぬ籠城戦に限界を迎えつつある\n一行の前に、アンデッドの首魁が姿を現す。\n＜時間経過でのコスト回復量が60％低下＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["時間経過でのコスト回復量が60％低下"], "event": "ハロウィン包囲戦線", "event_category": "History", "mission_id": 920166, "map_no": 5979, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 30, "params": [40]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 88}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 13200, "attack": 1400, "base_hp": 13200, "base_attack": 1400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "