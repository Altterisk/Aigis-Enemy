d": 2122560, "special_effect_id": 242, "change_to": 13, "master_id": 33657, "global_id": 7274, "to_global_id": 7275, "route_behaviour": {"reroutes": ["Route=100"]}, "spawn_sec": 89}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122560, "change_to": 14, "change_condition": 1, "master_id": 33658, "global_id": 7275, "variants": [{"tags": ["アンデッド"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122608, "master_id": 33659, "global_id": 7276}]}, {"enemy_id": 16, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111632, "race_id": 11, "special_effect_id": 233, "master_id": 30613, "global_id": 4232, "spawn_sec": 137}, {"enemy_id": 17, "source": "local", "count": 14, "form_count": 1, "tags": ["ステルス", "置物"], "fixture": true, "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 242, "master_id": 34042, "global_id": 7659, "spawn_sec": 167}], "popups": ["ヴァーニィは、\nブロックされている間\nHPが徐々に回復します。\n\nまたヴァーニィを倒すと\n以降、血の使い魔は\n生み出されません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴァーニィ", "text": "――今が好機、か。", "face": "l0af7672e8072"}, {"name": "ヴァンパイア公爵", "text": "はっ。\n兵は疲弊し、村の民も恐怖と空腹で動けずにおります。\n今この瞬間こそ、王国軍の最大の弱点。", "face": "lae731360ac43"}, {"name": "ヴァンパイア公爵", "text": "これ以上の時を待てば、民は飢え死に、\n背負うものの無くなった王国軍が牙を剥くでしょう。", "face": "lae731360ac43"}, {"name": "ヴァーニィ", "text": "民を見捨てられぬ国は、弱いものだ。\nヴァンパイアの王国も、英雄王の王国も同じこと。", "face": "l0af7672e8072"}, {"name": "ヴァーニィ", "text": "なれば今宵、王国軍を圧殺してやろう。\n目障りな姉気取りともどもな。", "face": "l0af7672e8072"}, {"name": "パリオス", "text": "…………お腹すい……すい……すいてないぃぃぃ。\nうおー！　うぅー！　大丈夫！　すいてないっ！！", "face": "u1334a1"}, {"name": "セブン", "text": "無理すんな、パリオス。\n弱音吐いたって誰も文句言わないぜ。", "face": "u1333a1"}, {"name": "パリオス", "text": "うぅん、村の皆の方が苦しいはずだもん。\nぼくは平気だぞーって胸を張ってないと、\n敵になめられちゃうし！", "face": "u1334a1"}, {"name": "セフィーレ", "text": "……そうですね。\n空元気も時には必要です。", "face": "u1332a1"}, {"name": "セフィーレ", "text": "敵に弱みを見せたなら、\nそれは間違いなく、\nこちらの弱点を晒すことになりますから。", "face": "u1332a1"}, {"name": "セブン", "text": "そういうもんか。\nじゃあどうする？　楽しいことでも考えるか？", "face": "u1333a1"}, {"name": "村娘", "text": "あっ……それでしたら、\nこの戦いが終わった後のことでも……？", "face": "l77e6736f5115"}, {"name": "セフィーレ", "text": "戦いが終わったら――ハロウィンですね。\nハロウィンのお祭りの、続きをしましょう。", "face": "u1332a1"}, {"name": "パリオス", "text": "お祭りの続き……お祭り！\nうぅぅ、ちょっと元気になってきた！", "face": "u1334a1"}, {"name": "村娘", "text": "美味しいお菓子も焼きましょう。\nそれから、焚き火を囲んで、踊って……。", "face": "l77e6736f5115"}, {"name": "セフィーレ", "text": "――では、約束です。\n私はきっと、村の皆さんを守り抜きます。\n絶対に誰も、殺させはしません。", "face": "u1332a1"}, {"name": "セフィーレ", "text": "たとえ、この命にかえても。\nこれは私が、初めて願った成すべきことですから。", "face": "u1332a1"}]}, {"trigger": "battle", "at_sec": 86, "lines": [{"name": "エマ", "text": "――夜が、来ましたか。\n王子、愛しきあなた、どうかお気をつけて。", "face": "u582"}]}, {"trigger": "battle", "at_sec": 90, "lines": [{"name": "ヴァーニィ", "text": "心までは折れない、か。\n何とも度し難い人の子らよ。", "face": "l0af7672e8072"}, {"name": "ヴァーニィ", "text": "だが、背後に重荷を背負ったまま、\nどこまで戦い続けることができようか。", "face": "l0af7672e8072"}, {"name": "ヴァーニィ", "text": "使い魔たちよ、手当たりしだいに喰らい尽くせ。\n我が道を遮る者は、血肉の全てを奪ってやれ。", "face": "l0af7672e8072"}, {"name": "エマ", "text": "……来ましたか、ヴァーニィ。\n王子、愛しきあなた、ヴァーニィが戦場にいる限り、\n血の使い魔を送り込んでくることでしょう。", "face": "u582"}, {"name": "エマ", "text": "されど、術者たるヴァーニィを討てば、\n使い魔はそれ以上に生まれませぬ。\n――あとは、あなたの指揮のままに。", "face": "u582"}]}, {"trigger": "end", "lines": [{"name": "セブン", "text": "……おいおい、\nアンデッドにも数に限りがあるんじゃねぇのか？", "face": "u1333a1"}, {"name": "ラキュア", "text": "これだけの包囲……おそらくはこれまで、\n戦場に投入せず、温存していた兵なのだろう。", "face": "u344"}, {"name": "村娘", "text": "……あ、あの。\n王国軍の方だけなら、この包囲を抜けられます、よね？", "face": "l77e6736f5115"}, {"name": "村人", "text": "……村の皆で話し合ったんだ。\nここまで守ってくれただけで、感謝しているよ。\n……全員がここで、一緒に死ぬ必要はないだろ？", "face": "ld26cb9f6cdd2"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "村人", "text": "王子殿下、誰も恨みはしません。\nむしろ最期に、英雄王を継ぐ者と戦場を共にできたんだ。\n先祖には胸を張って自慢してやりますよ。", "face": "ld26cb9f6cdd2"}, {"name": "セフィーレ", "text": "……だめ。そんなの、絶対にだめです。", "face": "u1332a1"}, {"name": "セフィーレ", "text": "命ある者が、自ら死を選ぶなど――\nそんな悲しいことは、絶対にだめです！", "face": "u1332a1"}, {"name": "村娘", "text": "でも、セフィーレさま……っ。", "face": "l77e6736f5115"}, {"name": "セフィーレ", "text": "少しでも生き残る可能性の高い道を選びなさい。\nケラウノス様の雷にかけて、私が、誰も殺させません！", "face": "u1332a1"}, {"name": "セブン", "text": "なっ……セフィーレ、何をするつもりだ！？", "face": "u1333a1"}, {"name": "セフィーレ", "text": "私が活路を開きます。\n死ぬのは、神の兵器に過ぎない、\n天使の私だけで十分ですから。", "face": "u1332a1"}, {"name": "村娘", "text": "だめ……待ってくださいセフィーレさまっ！\nどうして……私に、力があれば……っ。", "face": "l77e6736f5115"}, {"name": "村娘", "text": "セフィーレさまっ、お願い、死なないで……っ！！", "face": "l77e6736f5115"}]}, {"trigger": "end", "lines": [{"name": "ソラス", "text": "…………！\nこの力の波動、どこから――", "face": "u904"}, {"name": "アトナテス", "text": "……おい、包囲が崩れていくぞ。\nいや、むしろこれは――道を開けている、のか？", "face": "u908"}, {"name": "ヴァーニィ", "text": "この力は……まさか……。\nありえない、あの方はもういないはず……。", "face": "l0af7672e8072"}, {"name": "ヴァーニィ", "text": "公爵、兵を退け。\nこのままでは、こちらが全滅するぞ！", "face": "l0af7672e8072"}, {"name": "ユージェン", "text": "……いったい、なんだったんだ？\nアンデッドの陣形が崩れたぞ。", "face": "u906"}, {"name": "アンナ", "text": "……真相はわかりませんが、今こそ好機です。\n王子、ヴァーニィの軍勢を討つなら今しかありません！", "face": "le4dc321f97ba"}]}], "active": true}