{"quest_id": 1915, "name": "海溝神殿", "description": "バハムトを封じた神殿で儀式を執り行う\nギガエルを破り、神の野望を打ち砕け！\n＜深海（強）：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海（強）：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション10", "event_category": "Story", "mission_id": 100010, "map_no": 1135, "level": 100, "multiplier": 1.0, "charisma": 52, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 6], "ext": "攻撃待ち増加=90,ダメージ開始待ち=900"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 120000, "base_hp": 120000, "damage_type": "physical", "armor_defense": 10, "magic_defense": 5, "attack_range": 80, "attack_speed": 25, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126592, "special_effect_id": 662, "missile_id": 45, "master_id": 33064, "global_id": 6681, "ranged": true, "route_behaviour": {"reroutes": ["Route=36", "Route=38", "Route=39", "Route=41", "Route=42", "Route=43", "Route=44", "Route=45", "Route=46", "Route=97"]}, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 8, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 45000, "attack": 1000, "base_hp": 45000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 150, "attack_interval": 351, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126544, "race_id": 7, "special_effect_id": 232, "missile_id": 481, "missile": {"speed": 1.0}, "master_id": 34523, "global_id": 8140, "ranged": true, "route_behaviour": {"sets_flags": [[0, 0, 100]]}, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 2, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5000, "attack": 400, "base_hp": 5000, "base_a