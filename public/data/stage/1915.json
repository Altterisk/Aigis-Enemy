count": 4, "tags": ["水中"], "hp": 250000, "attack": 10125, "base_hp": 250000, "base_attack": 10125, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "attack_speed": 1, "attack_wait": 50, "attack_interval": 153, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126448, "race_id": 7, "special_effect_id": 509, "change_to": 11, "change_condition": 4, "master_id": 33046, "global_id": 6663, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 6664}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["水中"], "hp": 250000, "attack": 15187, "base_hp": 250000, "base_attack": 15187, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "attack_speed": 1, "attack_wait": 50, "attack_interval": 153, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126448, "race_id": 7, "special_effect_id": 127, "master_id": 33047, "global_id": 6664, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 16, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 226, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126512, "race_id": 7, "change_to": 13, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 34527, "global_id": 8144, "ranged": true, "variants": [{"hp": 8000, "attack": 1050, "base_hp": 8000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 8000, "magic_defense": 40, "attack_speed": 1, "attack_wait": 60, "attack_interval": 179, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126496, "race_id": 7, "master_id": 34528, "global_id": 8145}], "spawn_sec": 194}, {"enemy_id": 15, "source": "local", "count": 20, "form_count": 1, "tags": ["水中"], "hp": 5500, "attack": 220, "base_hp": 5500, "base_attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126560, "race_id": 18, "special_effect_id": 660, "change_to": 15, "change_condition": 1, "master_id": 34525, "global_id": 8142, "variants": [{"tags": ["水中"], "hp": 5500, "attack": 220, "base_hp": 5500, "base_attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126576, "race_id": 18, "master_id": 34526, "global_id": 8143}], "spawn_sec": 236}], "popups": ["ギガエルは一定時間経過すると、\nバハムトの力を取り込み\n『渦潮』を発生させます。\n\n『渦潮』は味方ユニットの\n遠距離攻撃を自身に引き付けます。\n　　　　　　　　　　　(1/2)", "力を取り込んだギガエルがいる間、\n『渦潮』の数が徐々に増加します。\n\n一度発生した『渦潮』は、\nギガエルを倒しても消滅しません。\n\n『渦潮』は撃破数に含まれません。\n　　　　　　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここが、神獣バハムトを封じた神殿……。", "face": "ldbbcc94fa298"}, {"name": "フローガ", "text": "……ま、まずいですよこれ。\n封印にほころびが生じて、魔力が溢れ出しています。\nもう儀式が進行しているようです！", "face": "u878"}, {"name": "ギガエル", "text": "――来たか、溺れる地の民よ。\n後少しで儀式が終わるところだったのだがな。", "face": "l03cf464604af"}, {"name": "ソフィー", "text": "ギガエル、バハムトの封印を解き、\nいったい何をするつもりなのですか。", "face": "u146"}, {"name": "ギガエル", "text": "……封印を、解く？\nははっ、そうか、そうだな、確かにそう見えるか。", "face": "l03cf464604af"}, {"name": "ギガエル", "text": "だがソフィー、それは些か、誤解というものだ。\n真の目的はバハムトの封印解除などではない。", "face": "l03cf464604af"}, {"name": "ギガエル", "text": "だが、その目的を語る必要もあるまい。\nスカーよ、今しばらく此奴らを足止めしておけ。", "face": "l03cf464604af"}, {"name": "スカー", "text": "――はっ。ギガエル様。", "face": "l299100f8fdfc"}, {"name": "ギガエル", "text": "どうした、その反抗的な目は。\nもしやまだ自我が残っているのか？", "face": "l03cf464604af"}, {"name": "リバン", "text": "……スカーさん。", "face": "u1062a1"}, {"name": "ギガエル", "text": "さぁ、儀式もあと少しで完了する。\n溺れる者たちよ、しばしここで待つがいい。", "face": "l03cf464604af"}, {"name": "アンナ", "text": "……王子、ギガエルの軍勢が来ます。\n儀式を完遂させるわけにはいきません、\n戦闘の指揮をお願いします！", "face": "l69e56a270b4d"}]}, {"trigger": "battle", "at_sec": 131, "lines": [{"name": "フローガ", "text": "王子殿下！　バハムトの封印が――\nあ、あれ？　封印は破壊されているのに……？", "face": "u878"}, {"name": "カタラ", "text": "封印の裂け目から、魔力だけが流れ出しているわ。\nバハムトを封印に残したまま、\n魔力を吸い上げているの……？", "face": "u912"}, {"name": "ギガエル", "text": "――然り。\nバハムトの力を我が物とする、\nそれこそがこの儀式の目的なれば。", "face": "l03cf464604af"}, {"name": "マーマン", "text": "なっ……どういうことですかギガエル様！\nあの御方はバハムトの封印解除を命じていたのでは！？", "face": "l84dcfbcc054a"}, {"name": "ギガエル", "text": "これも秘められし作戦の内なのだ。\nよもや神を疑うつもりではあるまい？", "face": "l03cf464604af"}, {"name": "ギガエル", "text": "さて、これより儀式完遂のため瞑想に入る。\nお前たちは王子の軍勢を足止めするのだ。", "face": "l03cf464604af"}, {"name": "マーマン", "text": "……はっ！", "face": "l84dcfbcc054a"}]}, {"trigger": "end", "lines": [{"name": "ギガエル", "text": "ぐっ……バハムトの力が……っ！\nようやく我が主をお守りする力を、\n手に入れたというのに……！！", "face": "l03cf464604af"}, {"name": "フローガ", "text": "封印の裂け目、拡大が止まりました！\nそうか、ギガエルの儀式を妨害したから……！", "face": "u878"}, {"name": "ギガエル", "text": "深海の民よ、王子よ……。\n貴様らが何をしたのか、今に思い知ることになるぞ。", "face": "l03cf464604af"}, {"name": "ギガエル", "text": "だが、そうだな……。\n貴様らならば、もしかしたら、海神に手が届くやも……。", "face": "l03cf464604af"}, {"name": "アンナ", "text": "……ギガエル、海溝の底へ沈んでいきます。\n撤退した……のでしょうか……？", "face": "l69e56a270b4d"}, {"name": "オーベッド", "text": "……気になることを言っていたな。\nクラールフ様に並ぶ、海神だとかなんとか。", "face": "u1122a1"}, {"name": "レーヴ", "text": "詳しくは調査してみるしかないですね……。\n海にまつわる伝説は数多くあります。\nそのどれが真実なのかは精査するしか……。", "face": "u454"}, {"name": "フローガ", "text": "それに、バハムトの封印も\n裂け目が開いたままになっています。\nこのままでは、いずれ本当に封印が解けてしまうかも。", "face": "u878"}, {"name": "アンナ", "text": "ギガエルの目論見に、解けかけたバハムトの封印。\n調査すべきことばかりが増えていきますね……。", "face": "ldbbcc94fa298"}, {"name": "アンナ", "text": "ですが、立ち止まるわけにはいきません。\n深海の平和を守るためにも、\n海底都市と手を取り合い、前に進んでいきましょう！"}]}, {"trigger": "end", "lines": [{"name": "スカー", "text": "（……オレサマは、弱かったんだな。\n痛いほど、それがよくわかったゼ……）", "face": "ld66228d6b6c3"}, {"name": "スカー", "text": "（チクショウ……もっと、もっと強く……。\nギガエルのクソ野郎も、海神とやらも、\n王子も神も何もかもぶん殴れるほど……）", "face": "ld66228d6b6c3"}, {"name": "スカー", "text": "（ああ、強くなりてェなァ……）", "face": "ld66228d6b6c3"}, {"name": "スカー", "text": "（それまで、勝負はあずけたぜ、王子よォ……）", "face": "ld66228d6b6c3"}]}, {"trigger": "route", "enemy_ids": [6], "lines": [{"name": "ギガエル", "text": "――嗚呼、バハムトの力が流れ込んでくる。\nさすがはクラールフ様に並ぶ海神が\n紡いだ神なる兵器、神獣バハムトの魔力だ。", "face": "l03cf464604af"}, {"name": "ギガエル", "text": "この力があれば……我が愛しき主を守護し、\nあの海神を討つことも不可能ではない……。", "face": "l03cf464604af"}, {"name": "オーベッド", "text": "……何だ、何を言っているんだ、ギガエルは。", "face": "u1122a1"}, {"name": "ギガエル", "text": "お前たちが知る必要はない。\nさぁ、まずは小手調べと行こうか。", "face": "l03cf464604af"}, {"name": "フローガ", "text": "ギガエルの周囲に魔力の渦潮が……。\n王子殿下、矢どころか\n魔法まで渦潮に吸い込まれていきます！", "face": "u878"}, {"name": "リバン", "text": "これじゃあギガエルを狙えないですわ……っ！\n王子殿下、どうか慎重な采配をお願いします！", "face": "u1062a1"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 15, 6], "ext": "攻撃待ち増加=120,ダメージ開始待ち=600"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 144000, "damage_type": "physical", "armor_defense": 10, "magic_defense": 5, "pattern_id": 2126592}, {"enemy_id": 2, "hp": 54000, "attack": 1000, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2126544}, {"enemy_id": 3, "hp": 6000, "attack": 480, "damage_type": "physical", "armor_defense": 200, "magic_defense": 60, "pattern_id": 2124400}, {"enemy_id": 3, "form_index": 1, "hp": 6000, "attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 60, "pattern_id": 2124400}, {"enemy_id": 5, "hp": 36000, "attack": 2400, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 40, "pattern_id": 2126528}, {"enemy_id": 6, "hp": 432000, "attack": 1000, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 60, "pattern_id": 2123664}, {"enemy_id": 6, "form_index": 1, "hp": 432000, "attack": 1000, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 60, "pattern_id": 2126608}, {"enemy_id": 9, "hp": 300000, "attack": 5400, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "pattern_id": 2126448}, {"enemy_id": 9, "form_index": 1, "hp": 300000, "attack": 8100, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "pattern_id": 2126448}, {"enemy_id": 9, "form_index": 2, "hp": 300000, "attack": 12150, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "pattern_id": 2126448}, {"enemy_id": 9, "form_index": 3, "hp": 300000, "attack": 18224, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "pattern_id": 2126448}, {"enemy_id": 13, "hp": 9600, "attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "pattern_id": 2126512}, {"enemy_id": 15, "hp": 6600, "attack": 264, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "pattern_id": 2126560}]}, "active": true}