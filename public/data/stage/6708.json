400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103408, "race_id": 8, "change_to": 15, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 444, "global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "spawn_sec": 191}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}, {"enemy_id": 17, "source": "local", "count": 6, "form_count": 2, "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102672, "race_id": 8, "change_to": 17, "change_condition": 3, "master_id": 385, "global_id": 384, "to_condition": 3, "to_global_id": 385, "spawn_sec": 191}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1600, "base_hp": 18000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 700, "attack_speed": 20, "attack_wait": 15, "attack_interval": 116, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "master_id": 386, "global_id": 385, "from_condition": 3}, {"enemy_id": 19, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 199}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "hp": 42000, "attack": 1150, "base_hp": 42000, "base_attack": 1150, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_speed": 30, "attack_interval": 69, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117600, "race_id": 3, "special_effect_id": 222, "master_id": 31572, "global_id": 5191, "spawn_sec": 238}], "popups": ["ガオレオンはダメージを受けません。\nまた味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nブロックされている間、\nガオレオンは全ての効果を失います。\n　　　　　　(1/2)", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "シャディア", "text": "――あの結晶に『破滅の力』が宿っているのか。\nこれまで以上に強く、力の波動が感じられる。", "face": "u713"}, {"name": "フィリス", "text": "しかし魔王軍の連中はどこへ行ったんだ？\n戦闘の気配は感じられるが、\nどこにも姿が見えないぞ……？", "face": "u40"}, {"name": "？？？", "text": "――待たせたな、挑戦者達よッ！！\n魔神との戦いは余興も余興、\nこれより始まるのがファイナルマッチよッ！！", "face": "l50ea76697074"}, {"name": "フィリス", "text": "だ、誰だ……っ！？", "face": "u40"}, {"name": "ガオレオン", "text": "我こそは魔王軍幹部にして\n百獣のチャンピオン、ガオレオンであるッ！\nいざ声援を背に受け、リングイィンッ！　とうッ！！", "face": "l50ea76697074"}]}, {"trigger": "start", "lines": [{"name": "シャディア", "text": "獣人の、幹部だと……？\nそうかガリウスめ、\n新たな幹部を魔王軍に迎えたということか。", "face": "u713"}, {"name": "ガオレオン", "text": "フハハハッ！！\n貴様が魔王軍を裏切ったというシャディアだなッ！！\nうむッ、良い面構えだ、我が敵に相応しいッ！！", "face": "l50ea76697074"}, {"name": "ガオレオン", "text": "――だがッ！！　もはや時代のスターは我であるッ！！\n時代遅れの旧幹部とその仲間達が、\nちびっこ達の声援を受けた我に敵うと思うなッ！！", "face": "l50ea76697074"}, {"name": "シャディア", "text": "……何なんだ、こいつは。", "face": "u713"}, {"name": "アンナ", "text": "それは私も知りたいところです……。\nガオレオンがやってきたということは、\nマンモンさんは倒されてしまったのでしょうか……？", "face": "lf7b6129804c2"}, {"name": "ガオレオン", "text": "マンモン……？　あぁ、あの前座だなッ！！\n実に良いファイトを魅せてくれたが、\n王者たる我の敵では無かったぞッ！！", "face": "l50ea76697074"}, {"name": "ガオレオン", "text": "さぁ挑戦者達よ、姑息な手段は全て捨て、\n自らの肉体と武技だけを以て\n我に向かってくるが良いッ！！", "face": "l50ea76697074"}, {"name": "ガオレオン", "text": "我が『王者の構え』をとる限り、\n遠距離攻撃など全て無意味と思い知れィッ！！", "face": "l50ea76697074"}, {"name": "バシラ", "text": "そんなハッタリ、通用しませ――えっ？\n王子、ほ、本当に弓矢が吸い寄せられました！\nまったく効いていないみたいですっ！！", "face": "u28"}, {"name": "シャディア", "text": "どうやら『王者の構え』とやら、嘘ではないらしい。\nならば足を止めさせて、王者の構えを崩すしかないか。\n王子、機を見て接近戦をしかけるぞ！", "face": "u713"}]}, {"trigger": "end", "lines": [{"name": "マンモン", "text": "いたたた……あの獣人ちゃん、\n思いっきりぶつんだから……いたたた……。", "face": "u767"}, {"name": "マンモン", "text": "あら、あらあら？\nもしかして私抜きで遊び始めちゃってませんか？\nもうっ、欲張りさんたちですね……！！", "face": "u767"}, {"name": "アンナ", "text": "王子、マンモンさんまで向かってきます！\n気を抜かず迎撃してくださいっ！！", "face": "lf7b6129804c2"}]}, {"trigger": "end", "lines": [{"name": "シャディア", "text": "くっ！　魔神と同時に相手にするには分が悪い。\nまだ立ち上がってくるとはな……っ！", "face": "u713"}, {"name": "モーティマ", "text": "だがガオレオンがマンモンを\n相手取っている今なら、少しは隙がありそうだ、\n王子、今のうちに『破滅の力』を奪っちまおうぜ！！", "face": "u14"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ガオレオン", "text": "――ムゥ、挑戦者と王者の戦いを邪魔するとは、\n如何に魔神マンモンとはいえ許されぬ愚行だぞ。\n我がリングを汚す行いは、死を以て償うがよい。", "face": "l50ea76697074"}, {"name": "マンモン", "text": "――ひぎっ……あ……あぁ……。\nわ、私が……負ける……なんて……。", "face": "u767"}, {"name": "ガオレオン", "text": "王者の爪にかかることを光栄に思えッ！！\n散れィ、魔神マンモン――ッ！！", "face": "l50ea76697074"}]}, {"trigger": "end", "lines": [{"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "モーティマ", "text": "王子、お前何やってんだ！？\nガオレオンの爪を受け止めるなんてよぉ！？", "face": "u14"}, {"name": "マンモン", "text": "……えっ？　わ、私、生きて……えっ？", "face": "u767"}, {"name": "ガオレオン", "text": "……ほう、人間の身にして、\n我が渾身の一撃を受け止めるとはな。", "face": "l50ea76697074"}, {"name": "ガオレオン", "text": "しかも『破滅の力』を奪う最後の好機を捨てて、\n敵である魔神をかばうとは……。\n実に滑稽――だが熱い男だな、お前はッ！！", "face": "l50ea76697074"}, {"name": "デーモン", "text": "ガオレオン様、『破滅の力』の回収に成功いたしました。\n今回もチャンピオンは貴方様にございます。", "face": "l4bb149a8144d"}, {"name": "ガオレオン", "text": "――うむッ。王子よ、お前のガッツに免じて、\nこの場は見逃してやろうぞ。\n更に技を磨き、再び挑戦してくるがいいッ！！", "face": "l50ea76697074"}, {"name": "アンナ", "text": "……ガオレオン、魔王軍、撤退していきます。\n『破滅の力』は……奪われてしまいました……。", "face": "l717789b06a15"}, {"name": "モーティマ", "text": "……はぁ、王子に他人を見捨てて目的を果たせ、\nとは言えねぇもんなぁ……。\nそういう奴だから付いてきたんだしよ。", "face": "u14"}, {"name": "ケイティ", "text": "そうですね、王子はこういう人ですから。\nマンモンさん、今手当をさせますから、\nじっとしていてくださいね。", "face": "u114"}, {"name": "マンモン", "text": "（欲望に流されず、誰かを助けるために戦う？\nこんな人間がいるなんて……ど、どうしましょう。\nちょっと興味が……いえ、すごく興味が……っ！）", "face": "u767"}, {"name": "シャディア", "text": "やれやれ、今後の方針を練り直さないとな。\n王子、マンモンの手当を終えたら、\n入り口に維持してあるゲートから帰還するとしよう。", "face": "u713"}]}], "active": true}