{"quest_id": 6708, "name": "百獣の王者", "description": "ついに『力』の在り処まで辿り着いた\n王子たちの前に、新たな魔王軍幹部が\nその姿を現す……！\n神級（★１獲得の目安：平均Lv50）", "event": "欲望の魔神と破滅の力", "event_category": "History", "mission_id": 920123, "map_no": 3401, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 56, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117648, "race_id": 12, "special_effect_id": 354, "change_to": 1, "change_condition": 1, "master_id": 31573, "global_id": 5192, "variants": [{"hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 56, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117664, "race_id": 12, "special_effect_id": 275, "master_id": 31574, "global_id": 5193}]}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 1, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "spawn_sec": 47}, {"enemy_id": 4, "source": "local", "count": 17, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102224, "race_id": 8, "change_to": 4, "change_co