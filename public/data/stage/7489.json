 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108528, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 30037, "global_id": 3656, "ranged": true, "spawn_sec": 69}, {"enemy_id": 5, "source": "local", "count": 16, "form_index": 0, "form_count": 1, "tags": ["精霊(氷)"], "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 33, "attack_interval": 110, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115552, "change_to": 5, "change_condition": 5, "master_id": 31221, "global_id": 4840, "phases": [{"tags": ["精霊(氷)"], "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 1, "attack_wait": 33, "attack_interval": 109, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115552, "missile_id": 296, "missile": {"speed": 8.0}, "master_id": 31222, "global_id": 4841, "ranged": true, "condition": 5}], "spawn_sec": 101}, {"enemy_id": 7, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 240, "base_hp": 3000, "base_attack": 240, "damage_type": "magical", "armor_defense": 50, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 186, "global_id": 185, "ranged": true, "spawn_sec": 130}], "popups": ["　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇", "クリスマストレントは\n徐々に自身のHPを回復します。\n一定時間経過すると\n回復効果は無くなります。", "アイスエレメンタルの\nHPを減らすと、\n遠距離攻撃をしてきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "テュト", "text": "わぁっ、素敵なクリスマスツリーがいっぱい♪\nあちらにも、こちらにも♪", "face": "u1398a1"}, {"name": "ドリー", "text": "おっ……えーっと、テュトおばあちゃん、だっけか？\nアタシの飾り付けもなかなかのモンだろ♪", "face": "u1399a1"}, {"name": "テュト", "text": "……あ、あれ？\nどうして私の名前を……。", "face": "u1398a1"}, {"name": "ドリー", "text": "街の子どもたちから聞いたんだよ。\nいろいろ昔話をしてくれる、\nカワイイおばあちゃんがいるってな。", "face": "u1399a1"}, {"name": "テュト", "text": "…………わっ、わわ。", "face": "u1398a1"}, {"name": "ドリー", "text": "おっと！　そんなことより！\nクリスマスツリーに興味があるなら、\n一緒に飾り付けでもしてみるかい？", "face": "u1399a1"}, {"name": "テュト", "text": "はいっ、ぜひぜひっ！", "face": "u1398a1"}, {"name": "ドリー", "text": "よぉし、そうと決まれば、\n次はそっちの角に立ってるツリーを――", "face": "u1399a1"}, {"name": "ユキヒメ", "text": "――あっ、ふたりとも、\nここにいると危ないよ……？", "face": "u667"}, {"name": "ドリー", "text": "んっ？　ユキヒメじゃねぇか。\nいったいどうしたって言うんだ？", "face": "u1399a1"}, {"name": "ユキヒメ", "text": "最近、すごく寒くなったでしょ……？\nそれでね、氷霊たちが楽しくなっちゃったみたいで……。", "face": "u667"}, {"name": "ドリー", "text": "……まさか、この街に吹雪が来るのか！？", "face": "u1399a1"}, {"name": "ユキヒメ", "text": "うん。\nそれで、街の皆に避難してって伝えてたんだ。", "face": "u667"}, {"name": "テュト", "text": "そんな……それじゃあ、\nせっかく飾り付けたツリーが……。", "face": "u1398a1"}, {"name": "ドリー", "text": "……ガキたちに、悲しい顔させるわけにゃいかねぇよな。\nツリーを守れるのは、アタシたちしかいねぇっ！", "face": "u1399a1"}, {"name": "ドリー", "text": "ユキヒメ、軍の連中に伝えてくれ！\n一緒にガキの笑顔を守ろうってな！", "face": "u1399a1"}, {"name": "ユキヒメ", "text": "うん、王子たち、呼んでくるね。", "face": "u667"}, {"name": "ドリー", "text": "それからテュトばあちゃん、\n吹雪の中じゃ遠くを狙いにくくなっちまう。\n射程に注意しながら戦うんだぜ！", "face": "u1399a1"}]}, {"trigger": "end", "lines": [{"name": "ドリー", "text": "ひぇぇ、吹雪のせいで\n身体が冷えちまったぜ。", "face": "u1399a1"}, {"name": "テュト", "text": "……あっ、それなら、\n休憩ついでにホットチョコレートでもどうでしょう？", "face": "u1398a1"}, {"name": "ドリー", "text": "おっ、いいねぇ。\nおーいユキヒメー！\n一緒におやつの時間にしようぜー！", "face": "u1399a1"}, {"name": "ユキヒメ", "text": "おやつ……？\nうんっ、それじゃあ王子たちも誘おう？", "face": "u667"}, {"name": "ドリー", "text": "いいねぇ、クリスマスの前祝いってやつだな！", "face": "u1399a1"}, {"name": "ドリー", "text": "へっへ、休憩したら\n飾り付けもラストスパートだ。\nガキたちのキラキラした顔が目に浮かぶようだぜ♪", "face": "u1399a1"}]}], "map": {"image": "Map920170_4008", "w": 960, "h": 640, "spots": [{"k": "b", "x": 695, "y": 13}, {"k": "m", "x": 573, "y": 144, "id": 200}, {"k": "m", "x": 607, "y": 258, "id": 201}, {"k": "m", "x": 678, "y": 394, "id": 202}, {"k": "m", "x": 784, "y": 447, "id": 203}, {"k": "m", "x": 427, "y": 377, "id": 204}, {"k": "m", "x": 495, "y": 478, "id": 205}, {"k": "m", "x": 288, "y": 400, "id": 206}, {"k": "m", "x": 208, "y": 190, "id": 207}, {"k": "m", "x": 342, "y": 280, "id": 208}, {"k": "m", "x": 298, "y": 94, "id": 209}, {"k": "m", "x": 474, "y": 183, "id": 210}, {"k": "m", "x": 162, "y": 437, "id": 211}, {"k": "m", "x": 243, "y": 341, "id": 212}, {"k": "m", "x": 112, "y": 373, "id": 213}, {"k": "m", "x": 572, "y": 343, "id": 214}, {"k": "m", "x": 618, "y": 67, "id": 215}, {"k": "m", "x": 690, "y": 87, "id": 216}, {"k": "m", "x": 645, "y": 170, "id": 217}, {"k": "m", "x": 342, "y": 175, "id": 218}, {"k": "r", "x": 549, "y": 45, "id": 300}, {"k": "r", "x": 494, "y": 94, "id": 301}, {"k": "r", "x": 420, "y": 105, "id": 302}, {"k": "r", "x": 742, "y": 150, "id": 303}, {"k": "r", "x": 702, "y": 218, "id": 304}, {"k": "r", "x": 793, "y": 356, "id": 305}, {"k": "r", "x": 613, "y": 454, "id": 306}, {"k": "r", "x": 410, "y": 437, "id": 307}, {"k": "r", "x": 272, "y": 259, "id": 308}, {"k": "r", "x": 559, "y": 212, "id": 309}]}, "start_cost": 10, "active": true, "name_en": "The Ice Spirits' Christmas", "description_en": "Protect the Christmas tree and drive away the Ice Spirits alongside Tytto and Dolly! \n<Blizzards occur at specific timings> \nAdvanced (★1 acquisition guideline: Average Lv10)"}