1, "master_id": 36169, "global_id": 9786}, {"enemy_id": 4, "source": "local", "count": 7, "form_count": 1, "tags": ["機械"], "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 500, "attack_wait": 60, "attack_interval": 159, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118960, "special_effect_id": 389, "master_id": 31791, "global_id": 5410, "spawn_sec": 43}, {"enemy_id": 5, "source": "local", "count": 13, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 1050, "attack": 200, "base_hp": 1050, "base_attack": 200, "damage_type": "physical", "armor_defense": 60, "magic_defense": 10, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123712, "race_id": 7, "special_effect_id": 229, "missile_id": 232, "master_id": 32688, "global_id": 6306, "ranged": true, "spawn_sec": 53}, {"enemy_id": 6, "source": "local", "count": 16, "form_count": 1, "tags": ["機械", "水棲", "ブロック不可", "狙う", "水中"], "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "physical", "armor_defense": 800, "attack_range": 240, "attack_wait": 80, "attack_interval": 201, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2144480, "special_effect_id": 1377, "missile_id": 877, "missile": {"speed": 3.0, "splash": 80}, "master_id": 36203, "global_id": 9820, "ranged": true, "spawn_sec": 74}, {"enemy_id": 7, "source": "local", "count": 19, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 15, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123728, "race_id": 7, "special_effect_id": 229, "missile_id": 232, "master_id": 32689, "global_id": 6307, "ranged": true, "spawn_sec": 90}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "tags": ["機械", "水棲"], "hp": 72000, "attack": 2000, "base_hp": 72000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_range": 280, "attack_wait": 1, "attack_interval": 53, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2144512, "special_effect_id": 1378, "change_to": 8, "change_condition": 4, "missile_id": 877, "missile": {"speed": 3.0, "splash": 80}, "master_id": 36205, "global_id": 9822, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 9823, "spawn_sec": 101}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "水棲"], "hp": 72000, "attack": 1200, "base_hp": 72000, "base_attack": 1200, "damage_type": "true", "armor_defense": 500, "magic_defense": 5, "attack_range": 280, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2144496, "special_effect_id": 1378, "change_to": 7, "change_condition": 4, "missile_id": 878, "missile": {"speed": 8.0, "slow": [50, 80]}, "master_id": 36206, "global_id": 9823, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "tags": ["機械"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 1000, "attack_wait": 60, "attack_interval": 159, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119024, "special_effect_id": 389, "master_id": 31804, "global_id": 5423, "spawn_sec": 131}], "dialogue": [{"trigger": "start", "lines": [{"name": "グラティア", "text": "くっ……水圧がすごいな……。\nさっき以上に身体が重いぞ……。", "face": "u1840a1"}, {"name": "ナタク", "text": "だが、ライバルの\n得意フィールドで勝ってこそのミニメカバトルだよ。", "face": "u1835a1"}, {"name": "グラティア", "text": "そういうものか……。\nやっぱ戦う連中の考えってのはわかりにくいな。", "face": "u1840a1"}, {"name": "リンネ", "text": "こちらはいつも、送り出す側ゆえな……。\nしかし、皆元気に戻ってくれば、それがなによりじゃ。", "face": "u1833a1"}, {"name": "グラティア", "text": "鍛冶職人も同じさ。\nたくさん殺してこいとは祈らない。\nアタシの武具を使って、生きて帰ってこいって思うのさ。", "face": "u1840a1"}, {"name": "オルカレクス", "text": "さぁ、到着したぞ。\nレギュレーションは深海、\nオーナーもバトル参加ＯＫの全力バトルルールだ。", "face": "l47c8721ccf96"}, {"name": "オルカレクス", "text": "――そしてこの、ミニメカシャチのおもちゃこそ、\n我が相棒、長年の愛機だ。", "face": "l47c8721ccf96"}, {"name": "テュト", "text": "……古い、おもちゃですね。\nきっと長いあいだ、大切にしてきたのでしょう。", "face": "u1836a1"}, {"name": "サナラ", "text": "やっぱり、ミニメカバトラーの魂は\n忘れてなかったみたいですね。", "face": "u1830a1"}, {"name": "オルカレクス", "text": "さて、どうだろうな。\n心が躍っていることは否定しないが、\nここで、貴様らを溺れさせる算段かもしれないぞ。", "face": "l47c8721ccf96"}, {"name": "ヴルム", "text": "そんな悪事をたくらむ人が、この状況で、\nおもちゃのスイッチをオンにしたりすると思う？", "face": "u1834a1"}, {"name": "シャチのギルマン", "text": "キュケっ……。\n総統！　勝利を祈っております！！", "face": "le882c4209cb1"}, {"name": "オルカレクス", "text": "ああ。最強の科学軍団、\n我がオルカ科学ラボの力を見せてやろう！", "face": "l47c8721ccf96"}, {"name": "サナラ", "text": "じゃあレオナさん、レフリーをお願いします！", "face": "u1830a1"}, {"name": "レオナ", "text": "……くっ。ここで私に振るのか。\nいいだろう、双方同意と見て良いな？\n――ミニメカバトル……ファイッ！！", "face": "u1027a1"}]}, {"trigger": "end", "lines": [{"name": "オルカレクス", "text": "――ああ、私の、負けだ。", "face": "l47c8721ccf96"}, {"name": "サナラ", "text": "ええ、私の、勝ちです！！", "face": "u1830a1"}, {"name": "オルカレクス", "text": "キュケケ……。\n思い出したよ、あの日の夢を……。", "face": "l47c8721ccf96"}, {"name": "サナラ", "text": "じゃあ、これからは――", "face": "u1830a1"}, {"name": "オルカレクス", "text": "ああ、これからは正々堂々と、世界征服をしていく。", "face": "l47c8721ccf96"}, {"name": "サナラ", "text": "…………あれ？", "face": "u1830a1"}, {"name": "グラティア", "text": "ん……？", "face": "u1840a1"}, {"name": "ピューロ", "text": "せかいせーふく？　まだ諦めてないの！？", "face": "u1839a1"}, {"name": "オルカレクス", "text": "シャチが最強であると示すこと。\nそれこそが、私の幼き日の夢。", "face": "l47c8721ccf96"}, {"name": "オルカレクス", "text": "しかし、それに溺れる民の――\n乾いた地の子どもたちを巻き込むのは、\n確かに卑怯な行いであった。", "face": "l47c8721ccf96"}, {"name": "オルカレクス", "text": "ゆえに、これより先は、\nシャチらしく全力で世界を狙っていくつもりだ。", "face": "l47c8721ccf96"}, {"name": "オルカレクス", "text": "感謝するぞ、地上のミニメカバトラーたち……！！", "face": "l47c8721ccf96"}, {"name": "アンナ", "text": "……見逃して、いいんでしょうか？", "face": "l7d80fec4cbcf"}, {"name": "スカー", "text": "ケッ……これだから\n気に入らねぇんだ、シャチの連中は！", "face": "u1396a1"}, {"name": "オルカレクス", "text": "では、また会おう。\nキュケケケケ！", "face": "l47c8721ccf96"}, {"name": "シャチのギルマン", "text": "総統に続け！　全軍撤退！\nキュケケケケッ！！", "face": "le882c4209cb1"}, {"name": "ナタク", "text": "……悪い奴らじゃ、なかったけども。", "face": "u1835a1"}, {"name": "アンナ", "text": "厄介事は、これからも続きそうですね……？"}]}], "active": true}