k_speed": 60, "attack_wait": 50, "attack_interval": 137, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110192, "race_id": 4, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30551, "global_id": 4170, "ranged": true, "spawn_sec": 128}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 18000, "attack": 1100, "base_hp": 18000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "attack_range": 160, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109632, "race_id": 4, "change_to": 9, "change_condition": 1, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30204, "global_id": 3823, "ranged": true, "variants": [{"hp": 18000, "attack": 1100, "base_hp": 18000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "attack_range": 160, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109584, "race_id": 4, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30203, "global_id": 3822, "ranged": true}], "spawn_sec": 160}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 14000, "attack": 500, "base_hp": 14000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "attack_interval": 63, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109616, "race_id": 4, "special_effect_id": 650, "change_to": 11, "change_condition": 1, "master_id": 30202, "global_id": 3821, "variants": [{"hp": 14000, "attack": 500, "base_hp": 14000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109600, "race_id": 4, "special_effect_id": 650, "master_id": 30201, "global_id": 3820}], "spawn_sec": 162}], "popups": ["猫又コハルがいる間は\n味方の攻撃力と防御力が\n『25％』低下し、\n敵の攻撃力と防御力が\n『10％』低下します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "コハル", "text": "にゃふふ、人間に演奏するのも好きだけど、\nこれだけ聴衆がいると\n妖怪相手の演奏も悪くないね。", "face": "u1450"}, {"name": "フーコ", "text": "お祭りなんて初めて……だけど、楽しいな。\nすごい賑やか。こんな感じなんだ。", "face": "u493"}, {"name": "ラミィ", "text": "へへー、楽しいよね。\nフーコと久しぶりに一緒に遊べて、\nわたし、すっごい嬉しいよっ！", "face": "u480"}, {"name": "シノ", "text": "妖怪総大将として、妖怪の交流を深めるべく、\n妖怪の祭りを呼びかけてはみたが……。", "face": "u403"}, {"name": "カスミ", "text": "……予想以上に妖怪が集まりましたね。\nそれだけ、お姉……シノ様を総大将と慕う妖怪が\n増えたという証左でしょう。", "face": "u470"}, {"name": "シノ", "text": "この程度、まだまだ父上には及ばないがな。\nだが、私は私なりの道を歩み、\nいつか真の妖怪総大将となってみせよう。", "face": "u403"}, {"name": "アンナ", "text": "――王子、こちらになります。\nシノさんからお誘いのあった、\n妖怪のお祭りと言うのは。", "face": "leb7cd57774eb"}, {"name": "ケイティ", "text": "妖怪達の祭り……人間の祭りと、\nほとんど変わらないようですね。", "face": "u114"}, {"name": "シノ", "text": "皆さん、来てくださったのですね！\nこのような所までご足労頂き、\nありがとうございます。", "face": "u403"}, {"name": "シノ", "text": "来て早々ではあるのですが、血の気多きが妖怪の性。\nあれがなければ始まらないとの者も多いもので……\n……すみませんが、お相手願ってもよろしいでしょうか。", "face": "u403"}, {"name": "アンナ", "text": "はい！　お誘いの手紙にも書いてありましたので、\n準備は万端です。妖怪百鬼夜行のお相手、\n我々が務めさせて頂きます！", "face": "leb7cd57774eb"}, {"name": "コハル", "text": "おぉっと、宴もたけなわみたいだね。今回はシノさんの\nご指名だからな、ご主人には悪いけど『恨み猫三味線』\n今日はご主人たちに聞いてもらうよ？", "face": "u1450"}, {"name": "コハル", "text": "争う力を奪う恨みの一曲。\n本来の力が出ない状態でご主人たちが\nどうやって窮地を乗り越えるか。", "face": "u1450"}, {"name": "コハル", "text": "感動の瞬間を見せてくれ、ご主人。\nそれじゃあ一曲、ご清聴あれ。", "face": "u1450"}]}, {"trigger": "end", "lines": [{"name": "シノ", "text": "流石は王子、本来の数に届かないとは言え、\nより強くなった私の百鬼夜行をあっさりと退けるとは。", "face": "u403"}, {"name": "コハル", "text": "ご主人、見事な大立ち回りを魅せて貰ったよ。\nお陰様で祭りの盛り上がりも最高潮さ。", "face": "u1450"}, {"name": "ケイティ", "text": "人である私達が相手では、\n水を差してしまうのではとも思いましたが。\n盛り上がって頂けたのなら、何よりですね。", "face": "u114"}, {"name": "シノ", "text": "折角の祭りに人も妖怪も関係ないさ。\n王子達も、ぜひ祭りを楽しんで行ってくれ。", "face": "u403"}, {"name": "アンナ", "text": "ありがとうございます、\nぜひそうさせて頂きますね。"}, {"name": "コハル", "text": "それじゃ、次の曲にいかせてもらうよ。\nお次の曲は『妖怪音頭』\nご主人達も、陽気に踊っていってくれ。", "face": "u1450"}]}], "active": true}