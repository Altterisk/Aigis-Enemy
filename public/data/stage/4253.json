0, "attack": 550, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 70, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 46, "global_id": 45, "spawn_sec": 16}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 6600, "attack": 770, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 64, "global_id": 63, "spawn_sec": 41}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 1980, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 150, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 52, "global_id": 51, "ranged": true, "spawn_sec": 45}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 2200, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 49, "global_id": 48, "ranged": true, "spawn_sec": 51}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 19800, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "physical", "armor_defense": 160, "attack_range": 150, "attack_speed": 20, "attack_wait": 5, "attack_interval": 56, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099296, "race_id": 16, "special_effect_id": 235, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 178, "global_id": 177, "ranged": true, "spawn_sec": 98}], "dialogue": [{"trigger": "start", "lines": [{"name": "エリザベート", "text": "……王子、先に謝っておくわ。\n私はいつ人間を襲うか分からない彼女を\nこのままにしておけない。", "face": "u104"}, {"name": "フーリ", "text": "あんな可愛い娘がヴァンパイア……。", "face": "u174"}, {"name": "フラン", "text": "私たちは吸血鬼化した元人間たちを何体も\n倒してきた。ヴァンパイアハンターとして\n仕事を全うさせてもらう……。", "face": "u183"}, {"name": "アンナ", "text": "彼女たちは使命をもって動いている……。\nですが私はエデンさんを助けてあげたい。", "face": "ladee8649bf68"}, {"name": "アンナ", "text": "王子、ここはあの方たちと戦うことで\n意思を示しましょう！", "face": "ladee8649bf68"}, {"name": "ヴィンセント", "text": "お前たち……。", "face": "u103"}, {"name": "ヴィンセント", "text": "エデン。お前は隠れていろ。\n俺も意思を示す……！", "face": "u103"}]}, {"trigger": "battle", "at_sec": 100, "lines": [{"name": "スー", "text": "吸血鬼として作られた少女……。\nあの娘自身に罪はあるのか？", "face": "u232"}, {"name": "スー", "text": "……いや、だが吸血鬼は我が一族の敵。\n次の悲劇を生む前に私が……。", "face": "u232"}]}, {"trigger": "end", "lines": [{"name": "スー", "text": "王子はエデンを生かすのか。", "face": "u232"}, {"name": "アンナ", "text": "可能性があるならそれにかけたい……。\nエデンさんは私たちが保護します。", "face": "ladee8649bf68"}, {"name": "エリザベート", "text": "さっきも言ったけどいつ豹変するか分からない。\nあなたにキバを向けるかもしれない。その時\nあなたは、その娘を手にかけることができるの？", "face": "u104"}, {"name": "アンナ", "text": "その時は……。", "face": "ladee8649bf68"}, {"name": "エデン", "text": "自分が自分で無くならないとは言えないけど、\nその時がくるまでは王子たちと一緒にいる。", "face": "u239"}, {"name": "エデン", "text": "もし、自我を失うようなことになれば\nその前に、あのおじ様にお願いするね。", "face": "u239"}, {"name": "ヴィンセント", "text": "そうだな……。その時がきたら……な……。", "face": "u103"}, {"name": "エリザベート", "text": "まぁ、本人がそう言っているのなら、\n私たちも見守らせてもらうわ。", "face": "u104"}, {"name": "スー", "text": "共存の道か……。", "face": "u232"}, {"name": "アンナ", "text": "王子、今回の事件、一件落着とは言えませんが、\nその時が来ないことを願いましょう……。", "face": "le6de31b285fb"}]}], "active": true}