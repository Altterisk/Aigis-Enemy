pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 49, "global_id": 48, "ranged": true, "spawn_sec": 51}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 19800, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "physical", "armor_defense": 160, "attack_range": 150, "attack_speed": 20, "attack_wait": 5, "attack_interval": 56, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099296, "race_id": 16, "special_effect_id": 235, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 178, "global_id": 177, "ranged": true, "spawn_sec": 98}], "dialogue": [{"trigger": "start", "lines": [{"name": "エリザベート", "text": "……王子、先に謝っておくわ。\n私はいつ人間を襲うか分からない彼女を\nこのままにしておけない。", "face": "u104"}, {"name": "フーリ", "text": "あんな可愛い娘がヴァンパイア……。", "face": "u174"}, {"name": "フラン", "text": "私たちは吸血鬼化した元人間たちを何体も\n倒してきた。ヴァンパイアハンターとして\n仕事を全うさせてもらう……。", "face": "u183"}, {"name": "アンナ", "text": "彼女たちは使命をもって動いている……。\nですが私はエデンさんを助けてあげたい。", "face": "l1a778ac9c97a"}, {"name": "アンナ", "text": "王子、ここはあの方たちと戦うことで\n意思を示しましょう！", "face": "l1a778ac9c97a"}, {"name": "ヴィンセント", "text": "お前たち……。", "face": "u103"}, {"name": "ヴィンセント", "text": "エデン。お前は隠れていろ。\n俺も意思を示す……！", "face": "u103"}]}, {"trigger": "battle", "at_sec": 100, "lines": [{"name": "スー", "text": "吸血鬼として作られた少女……。\nあの娘自身に罪はあるのか？", "face": "u232"}, {"name": "スー", "text": "……いや、だが吸血鬼は我が一族の敵。\n次の悲劇を生む前に私が……。", "face": "u232"}]}, {"trigger": "end", "lines": [{"name": "スー", "text": "王子はエデンを生かすのか。", "face": "u232"}, {"name": "アンナ", "text": "可能性があるならそれにかけたい……。\nエデンさんは私たちが保護します。", "face": "l1a778ac9c97a"}, {"name": "エリザベート", "text": "さっきも言ったけどいつ豹変するか分からない。\nあなたにキバを向けるかもしれない。その時\nあなたは、その娘を手にかけることができるの？", "face": "u104"}, {"name": "アンナ", "text": "その時は……。", "face": "l1a778ac9c97a"}, {"name": "エデン", "text": "自分が自分で無くならないとは言えないけど、\nその時がくるまでは王子たちと一緒にいる。", "face": "u239"}, {"name": "エデン", "text": "もし、自我を失うようなことになれば\nその前に、あのおじ様にお願いするね。", "face": "u239"}, {"name": "ヴィンセント", "text": "そうだな……。その時がきたら……な……。", "face": "u103"}, {"name": "エリザベート", "text": "まぁ、本人がそう言っているのなら、\n私たちも見守らせてもらうわ。", "face": "u104"}, {"name": "スー", "text": "共存の道か……。", "face": "u232"}, {"name": "アンナ", "text": "王子、今回の事件、一件落着とは言えませんが、\nその時が来ないことを願いましょう……。", "face": "l980acd1c9287"}]}], "map": {"image": "Map920039_3553", "w": 960, "h": 640, "spots": [{"k": "b", "x": 919, "y": 292}, {"k": "m", "x": 717, "y": 308, "id": 200}, {"k": "m", "x": 583, "y": 303, "id": 201}, {"k": "m", "x": 566, "y": 221, "id": 202}, {"k": "m", "x": 498, "y": 201, "id": 203}, {"k": "m", "x": 419, "y": 191, "id": 204}, {"k": "m", "x": 335, "y": 187, "id": 205}, {"k": "m", "x": 262, "y": 226, "id": 206}, {"k": "m", "x": 522, "y": 408, "id": 207}, {"k": "m", "x": 445, "y": 415, "id": 208}, {"k": "m", "x": 369, "y": 412, "id": 209}, {"k": "m", "x": 281, "y": 362, "id": 210}, {"k": "m", "x": 238, "y": 287, "id": 211}, {"k": "m", "x": 148, "y": 270, "id": 212}, {"k": "r", "x": 657, "y": 262, "id": 300}, {"k": "r", "x": 627, "y": 376, "id": 301}, {"k": "r", "x": 501, "y": 271, "id": 302}, {"k": "r", "x": 415, "y": 241, "id": 303}, {"k": "r", "x": 337, "y": 258, "id": 304}, {"k": "r", "x": 343, "y": 312, "id": 305}, {"k": "r", "x": 413, "y": 343, "id": 306}, {"k": "r", "x": 495, "y": 339, "id": 307}, {"k": "r", "x": 538, "y": 159, "id": 308}, {"k": "r", "x": 462, "y": 142, "id": 309}, {"k": "r", "x": 387, "y": 135, "id": 310}, {"k": "r", "x": 298, "y": 137, "id": 311}, {"k": "r", "x": 195, "y": 209, "id": 312}, {"k": "r", "x": 391, "y": 471, "id": 313}, {"k": "r", "x": 245, "y": 413, "id": 314}, {"k": "r", "x": 199, "y": 361, "id": 315}, {"k": "r", "x": 672, "y": 351, "id": 316}]}, "start_cost": 20, "active": true}