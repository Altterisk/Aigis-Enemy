le_id": 90, "missile": {"speed": 8.0}, "master_id": 30909, "global_id": 4528, "ranged": true, "spawn_sec": 151}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 8, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31506, "global_id": 5125, "ranged": true, "to_global_id": 5126, "route_behaviour": {"transforms": [{"wait": 40}]}, "spawn_sec": 215}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111504, "race_id": 18, "change_to": 7, "master_id": 31507, "global_id": 5126}], "popups": ["魔界スコーピオンから攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けません。\n\n　　　　　　(1/2)", "また魔界スコーピオンから\n攻撃を複数回受けると、\n麻痺状態になります。\nいずれの効果も\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヤハール", "text": "――こうしていると、昔を思い出すわね。", "face": "u1609a1"}, {"name": "ハルモニア", "text": "昔って、いったいどれだけ前の話ですか。\nまさかその身体になる前の話では？", "face": "u941"}, {"name": "ヤハール", "text": "そうよ、ふたりでつるんで遊んでた頃の話。\nこの魔界の森にも来たことあったわよね。", "face": "u1609a1"}, {"name": "ハルモニア", "text": "……もしかして、恨んでいますか？\n嫌味を言われているような気がするのですが。", "face": "u941"}, {"name": "ヤハール", "text": "どうして親友に嫌味を言わないといけないのよ！", "face": "u1609a1"}, {"name": "ハルモニア", "text": "私が竜将クロコ様につき、魔王軍に入っていなければ、\nお嬢……亜神アスバール様の守護者として、\nこの事態を未然に防げたかもしれないから、とか。", "face": "u941"}, {"name": "ヤハール", "text": "ふんっ、自信過剰すぎよ！\nあなたは魔王につくべきだと思ったから仲間になった。\nあたしはそう思わなかったからここに残った。", "face": "u1609a1"}, {"name": "ヤハール", "text": "ねっ、それだけのことでしょ？\nそんな些細なことで、\nあたしたちの友情にヒビは入らないわ！", "face": "u1609a1"}, {"name": "ハルモニア", "text": "ふふ、やっぱり頭でっかちで石頭のヤハールですね。\n姿が変わっても、その強情さは変わっていません。", "face": "u941"}, {"name": "ヤハール", "text": "ふふん、デーモンの本体は精神体だもの。\nどれだけ肉体が滅び、生まれ変わったとしても、\n譲れない魂のあり方だけは変わらないのよ！", "face": "u1609a1"}, {"name": "ハルモニア", "text": "……普通は、肉体に精神が\n引っ張られがちなんですけどね。\nそこはヤハールの強情さの賜物だと思いますよ。", "face": "u941"}, {"name": "ヤハール", "text": "ハルモニアに言われたくないわね！\n――で、頭でっかちで石頭で甘やかし魔のハルモニア、\n連中の気配、気付いてるかしら？", "face": "u1609a1"}, {"name": "ハルモニア", "text": "えぇ、どうやら私たちを獲物だと認識したようですね。\n我が主、周辺一帯から魔界スコーピオンの気配がします。", "face": "u941"}, {"name": "ヤハール", "text": "王子、魔界スコーピオンは魔界特有の虫よ。\n体力を奪うだけじゃなく、\n麻痺させてくる毒を体内で生成しているの。", "face": "u1609a1"}, {"name": "ハルモニア", "text": "耐性のない者にとっては、\nあまり接近したくない敵ですよね……。", "face": "u941"}, {"name": "ハルモニア", "text": "しかし、幸いなことに、\nこの辺りは魔界の瘴気が比較的薄くなっています。\n一気に蹴散らしてしまいましょう！", "face": "u941"}]}, {"trigger": "end", "lines": [{"name": "ヤハール", "text": "ふぅ、討伐完了ね！\nそれにしても、王国軍って軍隊よね……？\n虫の討伐、ずいぶん慣れているように見えたんだけど。", "face": "u1609a1"}, {"name": "エイル", "text": "えぇ、王国軍は虫退治においても\n物質界有数のプロフェッショナルですから。", "face": "u804"}, {"name": "ヤハール", "text": "…………？\n物質界って、そんなに虫が暴れているの？", "face": "u1609a1"}, {"name": "レティシア", "text": "……色々とあったんですよ。\nこの戦いが終わったら、ぜひお嬢様？　と一緒に、\n物質界に遊びに来てくださいね。", "face": "u1001a1"}, {"name": "ヤハール", "text": "えぇ、きっとお嬢も喜ぶはずよ！\nさぁみんな、魔界の森を抜けるわよ！", "face": "u1609a1"}]}], "active": true}