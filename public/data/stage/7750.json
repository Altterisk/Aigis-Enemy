{"quest_id": 7750, "name": "魔界の森", "description": "魔界スコーピオンを倒し、森を抜けよ。\n＜魔界の瘴気（小）：味方の攻防10％減\n時間経過でのコスト回復量が10％低下＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["魔界の瘴気（小）：味方の攻防10％減\n時間経過でのコスト回復量が10％低下"], "event": "魔界動乱", "event_category": "History", "mission_id": 920183, "map_no": 4163, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 26, "params": [90]}, {"kind": "term", "influence": 27, "params": [90]}, {"kind": "term", "influence": 30, "params": [90]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 1, "master_id": 31504, "global_id": 5123, "to_global_id": 5124, "route_behaviour": {"transforms": [{"wait": 40}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "master_id": 31505, "global_id": 5124}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "hp": 3600, "attack": 500, "base_hp": 3600, "base_attack": 500, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 137, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2140000, "race_id": 18, "special_effect_id": 1163, "master_id": 35313, "global_id": 893