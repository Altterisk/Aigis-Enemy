4, "source": "local", "count": 4, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098448, "race_id": 18, "special_effect_id": 220, "master_id": 96, "global_id": 95, "spawn_sec": 28}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 1, "tags": ["ステルス"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 60, "attack_wait": 30, "attack_interval": 173, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098144, "master_id": 91, "global_id": 90, "spawn_sec": 41}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "hp": 6000, "attack": 550, "base_hp": 6000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 30, "attack_interval": 161, "move_speed": 400.0, "dot_rate": 1.5, "pattern_id": 2104240, "race_id": 14, "special_effect_id": 230, "master_id": 515, "global_id": 514, "spawn_sec": 78}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 730, "base_hp": 12000, "base_attack": 730, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 50, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104208, "race_id": 14, "special_effect_id": 231, "master_id": 513, "global_id": 512, "spawn_sec": 123}], "popups": ["牛頭の魔物の影には、\nダメージを与える事ができません。\n以下の条件を満たすと消滅します。\n\n・本体を倒す\n・本体が拠点に到達する"], "dialogue": [{"trigger": "start", "lines": [{"name": "牛頭の魔物", "text": "グフフフフ……！\nこの砂漠を越えれば、東の国は目と鼻の先……。", "face": "l9255b4082a48"}, {"name": "牛頭の魔物", "text": "復活した大妖怪、酒呑童子の傘下に入り、\n必ずや憎き人間どもを根絶やしにしてやる。", "face": "l9255b4082a48"}, {"name": "アサル", "text": "王子、駆けつけて来て下さり、ありがとうございます。\n私が牛頭の魔物を目撃したのはこの付近です。", "face": "u172"}, {"name": "牛頭の魔物", "text": "グ、グフッ――！？\nあそこにいるのは人間達……ッ！？\n少数ならいざしらず、人数が多すぎるな……。", "face": "l9255b4082a48"}, {"name": "牛頭の魔物", "text": "酒呑童子に早急に合流したいのだが、\n我ながら運が悪すぎる……！　\nこうなれば、分身の妖術を使って対抗するとしよう。", "face": "l9255b4082a48"}, {"name": "兵士", "text": "ほ、報告！　牛頭の魔物が多数出現！\nさらに、どの個体にも攻撃が全く通じない模様……！", "face": "lf6f8f58a9d3b"}, {"name": "フドウ", "text": "攻撃が通じぬとな……？\nむぅ……。異国の妖怪には、不思議な妖術で分身を\n作る者がいると伝え聞いた事があるが……。", "face": "u238"}, {"name": "ユリアン", "text": "小賢しい妖術使いって訳か。\n面倒くさいのは嫌いだ。\nつまり、本体を見つけてとっちめれば良いんだろ？", "face": "u7"}, {"name": "フドウ", "text": "左様。\nだが、分身といえど本体と同等の力を持っている。\n王子、十分にご注意なされよ。", "face": "u238"}]}, {"trigger": "end", "lines": [{"name": "牛頭の魔物", "text": "――グフゥゥゥッ！　\nつ、強い……。\nご、合流……叶わず……。", "face": "l9255b4082a48"}, {"name": "牛頭の魔物", "text": "人間どもめ……覚えていろッ……！\n次こそは必ず強大な力を持つ妖怪とともに、\n根絶やしにしてくれる……！", "face": "l9255b4082a48"}, {"name": "ケイティ", "text": "牛頭の魔物、撤退していきます！", "face": "u114"}, {"name": "ユリアン", "text": "ちっ……。\nここで倒すつもりだったが、逃がしちまったか。", "face": "u7"}, {"name": "ケイティ", "text": "あの牛頭の魔物、他の妖怪とともに\n再戦するような事を言っていましたね。\nただの負け惜しみだと良いのですが。", "face": "u114"}, {"name": "ユリアン", "text": "他の妖怪の仲間になろうと考えていたとなると、\n動きが気になるな……。", "face": "u7"}, {"name": "アンナ", "text": "引き続き、妖怪全体の動きにも注意が必要ですね。\n王子、それでは帰還するとしましょう。", "face": "l7305c7df068c"}]}], "active": true}