{"quest_id": 7692, "name": "第四陣 戦場に響く気高き声", "description": "皇帝が倒れ、帝国軍は混迷の中にあった。\n＜皇帝出撃不可＞\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["皇帝出撃不可", "広域戦闘：敵味方の射程減少"], "event": "帝国四陣", "event_category": "Empire", "mission_id": 940004, "map_no": 4595, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [32], "expression": "IsClassType(98) == 0;", "expression_human": "its class type is not one of 98"}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 35, "form_count": 2, "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_speed": 30, "attack_wait": 10, "attack_interval": 87, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2138560, "race_id": 13, "change_to": 1, "change_condition": 2, "master_id": 35092, "global_id": 8709, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2, "spawned_on_death_by": [1, 3]}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 2, "hp": 23000, "attack": 700, "base_hp": 23000, "base_attack": 700, "damage_type": "magical", "armor_defense": 200, "attack_range": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 71, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138576, "race_id": 13, "special_effect_id": 216, "change_to": 1, "change_condition": 2, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 35093, "global_id": 8710, "ranged": true, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 102}, {"enemy_id": 4, "source": "local", "count": 10, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127760, "race_id": 21, "change_to": 4, "change_condition": 4, "master_id": 33555, "global_id": 7172, "to_condition": 4, "to_ticks": 3, "to_global_id": 7175, "spawn_sec": 132}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127776, "race_id": 21, "special_effect_id": 222, "master_id": 33558, "global_id": 7175, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 2, "hp": 8000, "attack": 1400, "base_hp": 8000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "change_to": 8, "change_condition": 4, "master_id": 33563, "global_id": 7180, "to_condition": 4, "to_ticks": 3, "to_global_id": 7183, "spawn_sec": 162}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 12, "source": "local", "count": 5, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127792, "race_id": 21, "change_to": 12, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 33559, "global_id": 7176, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 7179, "spawn_sec": 209}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127808, "race_id": 21, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 33562, "global_id": 7179, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 16, "source": "local", "count": 3, "form_count": 2, "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128624, "race_id": 21, "change_to": 16, "change_condition": 4, "master_id": 33702, "global_id": 7319, "to_condition": 4, "to_ticks": 3, "to_global_id": 7322, "spawn_sec": 211}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 700, "base_hp": 20000, "base_attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128640, "race_id": 21, "special_effect_id": 127, "master_id": 33705, "global_id": 7322, "from_condition": 4, "trigger_ticks": 3}], "popups": ["冥界のケルベロス、\n冥界のウルフは、\n倒されると黒炎に変化します。", "黒炎は以下の特性を持ちます。\n・撃破数にカウントされる\n・移動、攻撃を行わない\n・ブロック可能\n・黒炎がいる間、すべての味方\n　ユニットに継続ダメージを与える\n・黒炎自身のHPは徐々に減少する", "各種冥界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンジェリーネ", "text": "……そう、陛下が。", "face": "u430"}, {"name": "ルークス", "text": "……はっ。\nアウローラ様、トゥーダ様が\n治療にあたっておりますが、容態は……くっ……。", "face": "u422"}, {"name": "アンジェリーネ", "text": "報告は事実だけを、端的に。\nともあれ、状況は把握しましたわ。", "face": "u430"}, {"name": "ルークス", "text": "あ、アンジェリーネ様、いったいどこへ――", "face": "u422"}, {"name": "アンジェリーネ", "text": "決まっているでしょう。\n陛下が動けぬ今、\n帝国軍の全権を握るのは誰だと思っていますの？", "face": "u430"}, {"name": "アンジェリーネ", "text": "騎士団長のディアナ？　神官戦士団長のトゥーダ？\nまさか王国の王子？　……違うでしょう？", "face": "u430"}, {"name": "アンジェリーネ", "text": "白の帝国が謳う実力主義に、権威など存在しない。\n皇帝の正当性とは、ひとえに先王による譲位、\nその事実こそが最大の後ろ盾なのだから。", "face": "u430"}, {"name": "アンジェリーネ", "text": "ならば、白の帝国が危機にある今、\n私がなすべきことはひとつだけ……。", "face": "u430"}, {"name": "ルークス", "text": "アンジェリーネ、様……？", "face": "u422"}, {"name": "アンジェリーネ", "text": "聞け！　白の帝国が兵たちよ！\nこの地に集いし、白の王国を受け継ぐ者たちよ！", "face": "u430"}, {"name": "アンジェリーネ", "text": "白の皇帝は今、生死の狭間にある！\nされど、彼に国を預けた王家の血は、\n今もなお、貴公らと共に、この戦場にあり続けている！", "face": "u430"}, {"name": "アンジェリーネ", "text": "剣を取れ！　守るべき者を思え！\n故郷は貴公らの背後にあるのだから！", "face": "u430"}, {"name": "アンジェリーネ", "text": "――ふぅ、こんなところかしら？", "face": "u430"}, {"name": "ディアナ", "text": "えぇ、完璧かと。\nただ、時が時ならば、\n革命の戦火が巻き起こりそうな演説でしたよ。", "face": "u624"}, {"name": "アンジェリーネ", "text": "あら、それくらい鎮められなくて何が皇帝なのかしら。\n早く目を覚まして、\n帝国最強の力はここにあるのだと示してもらわないと。", "face": "u430"}, {"name": "ディアナ", "text": "まったく、そのとおりです。\n亜神如きに後れを取っているようでは、\n革命のし甲斐がありませんからね。", "face": "u624"}, {"name": "アンジェリーネ", "text": "よく言うわ。\n陛下を殺すなら、今こそ好機だというのに。", "face": "u430"}, {"name": "ディアナ", "text": "私は善き女王を目指していますから。\n正々堂々、正義に則った戦いでなくては。", "face": "u624"}, {"name": "ヘカティエ", "text": "……はぁ。ねぇあなたたち、\n兵たちには聞かせられない会話よ、これ。", "face": "u1226a1"}, {"name": "ディアナ", "text": "私たちの間に入ってくるような兵がいるなら、\nきっと将来有望なことでしょう。\n――さて、それでは反攻作戦と参りましょうか。", "face": "u624"}, {"name": "ヘカティエ", "text": "まぁ、そういう態度は嫌いではないけれど……。\nディアナ、兵たちに伝えておくといいわ。\n冥界軍が、冥界の魔物を放ったようだから。", "face": "u1226a1"}, {"name": "ディアナ", "text": "冥界の、魔物ですか？\nなにやら、斬ればすむ相手ではないような口ぶりですが。", "face": "u624"}, {"name": "ヘカティエ", "text": "冥界の魔物は、その身に黒炎を宿しているの。\n倒したとしても、黒炎が戦場全体を焼き続けるわ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "時が経てば、黒炎も\n物質界の法則に飲まれて消えていくけれど……。\n手早く炎を散らしてしまった方が安全かもしれないわね。", "face": "u1226a1"}, {"name": "ディアナ", "text": "ああ、つまり黒炎も斬ってしまえばいいと。\n単純で助かりますね。", "face": "u624"}, {"name": "ヘカティエ", "text": "……まぁ、えぇ、そうね。\nこういう人柄だから、\n兵たちはあなたに付いていくのかしら……。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "さぁ、冥界軍が来るわ。\nみんな、迎撃の準備を！", "face": "u1226a1"}]}, {"trigger": "end", "lines": [{"name": "ディアナ", "text": "さすがは冥界軍、兵力も無尽蔵ですか。", "face": "u624"}, {"name": "マルゴット", "text": "死後の世界、ですからね。\nその兵力とは、物質界の死の総量に等しいものかと。", "face": "u1343a1"}, {"name": "ディアナ", "text": "ならばマルゴット、\n死者を戦力として扱える冥界軍が、\n幾度も攻勢をかけては撤退している事実をどう考えますか。", "face": "u624"}, {"name": "マルゴット", "text": "…………何らかの、限界があるのでしょうか。", "face": "u1343a1"}, {"name": "エレオノーラ", "text": "――単純に考えるのなら、\n亜神ハイドースの魔力の総量でしょうね。", "face": "u799"}, {"name": "マルゴット", "text": "エレオノーラ様。\nということは、ハイドースは\n未だ全力を出すことができない、と？", "face": "u1343a1"}, {"name": "エレオノーラ", "text": "原因は分かりませんが、そう考えれば納得できます。\n同時に、この戦いにも光明が見えてきますね。", "face": "u799"}, {"name": "ディアナ", "text": "今回の戦いに限って、ですけどね。\n最終的には、亜神ハイドース本人と\n決着をつけるしかないでしょう。", "face": "u624"}, {"name": "エレオノーラ", "text": "……その要となる皇帝陛下は、\n未だ意識を取り戻していません。", "face": "u799"}, {"name": "エレオノーラ", "text": "傷を塞ぐことはできても、\n亜神の膨大な魔力を浴びたその魂は、\n大きく傷つき、今も生死の狭間を彷徨っています。", "face": "u799"}, {"name": "ディアナ", "text": "まったく、あの男は……。\n為政者というものは、\nこういう時、責任を取るためにいるものなのですが。", "face": "u624"}, {"name": "ディアナ", "text": "ともあれ、信じて待つしかないでしょう。\nマルゴット、前線に出ます。各戦線の情報を――", "face": "u624"}, {"name": "ウルスラ", "text": "――伝令！　伝令ですよー！！", "face": "u1552a1"}, {"name": "ウルスラ", "text": "西の砦に敵獣人の部隊が進軍！\nこちらの増援が間に合わない距離です！", "face": "u1552a1"}, {"name": "アンジェリーネ", "text": "西の砦……ふふっ、ならば問題ありませんわ。\n帝国の大動脈たるあの砦は、\n彼の部隊が防衛にあたっていますから。", "face": "u430"}, {"name": "ディアナ", "text": "彼……？　あぁ、なるほど。\n開戦前に、彼が陛下と密談を\nしていたのはそういうことですか。", "face": "u624"}, {"name": "アンジェリーネ", "text": "この戦いは帝国が背負うべきもの。\nされど、民に血を流させるわけにはいかない。", "face": "u430"}, {"name": "アンジェリーネ", "text": "ならば、帝都につながる道は、\n盟友たる王国軍が守り抜くと、そう言っていましたから。", "face": "u430"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 21, "params": [0, 55]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 24, "params": [32], "expression": "IsClassType(98) == 0;", "expression_human": "its class type is not one of 98"}], "enemies": [{"enemy_id": 1, "hp": 2000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 1, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 3, "hp": 23000, "attack": 700, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2138576}, {"enemy_id": 4, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 4, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 8, "hp": 8000, "attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127824}, {"enemy_id": 8, "form_index": 1, "hp": 8000, "attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127840}, {"enemy_id": 12, "hp": 2500, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 12, "form_index": 1, "hp": 2500, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 16, "hp": 20000, "attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128624}, {"enemy_id": 16, "form_index": 1, "hp": 20000, "attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128640}]}, "active": true}