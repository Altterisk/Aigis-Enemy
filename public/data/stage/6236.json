{"quest_id": 6236, "name": "場外乱入戦", "description": "古代龍のほこらでの戦い。ハクノカミが\n率いる竜人たちとの場外試合に勝利せよ！\n＜魔界審判がいる間敵の攻防80%減少＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["魔界審判がいる間敵の攻防80%減少"], "event": "王者達のバトルロイヤル", "event_category": "History", "mission_id": 920095, "map_no": 5205, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 450, "base_hp": 15000, "base_attack": 450, "damage_type": "magical", "armor_defense": 300, "attack_range": 240, "attack_speed": 70, "attack_wait": 60, "attack_interval": 196, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111536, "race_id": 2, "special_effect_id": 188, "missile_id": 227, "missile": {"speed": 4.0}, "master_id": 30597, "global_id": 4216, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 800, "base_hp": 6000, "base_attack": 800, "damage_type": "physical", "armor_defense": 350, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107072, "race_id": 2, "master_id": 857, "global_id": 856, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 750, "base_hp": 5500, "base_attack": 750, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111552, "race_id": 2, "master_id": 30598, "global_id": 4217, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 1250, "base_hp": 3000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 118, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111376, "special_effect_id": 185, "master_id": 30567, "global_id": 4186, "spawn_sec": 2}, {"enemy_id": 5, "source": "local", "count": 18, "form_count": 1, "hp": 4000, "attack": 700, "base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098528, "race_id": 2, "master_id": 297, "global_id": 296, "spawn_sec": 5}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 1000, "attack": 230, "base_hp": 1000, "base_attack": 230, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098624, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 150, "global_id": 149, "ranged": true, "spawn_sec": 44}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 13000, "attack": 110, "base_hp": 13000, "base_attack": 110, "damage_type": "magical", "armor_defense": 300, "magic_defense": 70, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 203, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100912, "race_id": 2, "special_effect_id": 228, "missile_id": 202, "missile": {"speed": 2.0}, "master_id": 288, "global_id": 287, "ranged": true, "spawn_sec": 51}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 2, "hp": 6000, "attack": 110, "base_hp": 6000, "base_attack": 110, "damage_type": "magical", "armor_defense": 200, "magic_defense": 70, "attack_range": 180, "attack_speed": 60, "attack_wait": 50, "attack_interval": 243, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100896, "race_id": 2, "special_effect_id": 228, "change_to": 6, "change_condition": 2, "missile_id": 201, "missile": {"speed": 2.0}, "master_id": 287, "global_id": 286, "ranged": true, "to_condition": 2, "to_global_id": 287, "spawn_sec": 93}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 13000, "attack": 110, "base_hp": 13000, "base_attack": 110, "damage_type": "magical", "armor_defense": 300, "magic_defense": 70, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 203, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100912, "race_id": 2, "special_effect_id": 228, "missile_id": 202, "missile": {"speed": 2.0}, "master_id": 288, "global_id": 287, "ranged": true, "from_condition": 2}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 293, "global_id": 292, "ranged": true, "spawn_sec": 126}], "dialogue": [{"trigger": "start", "lines": [{"name": "ハクノカミ", "text": "――よし、魔界へのゲートが開いたようじゃな。\n早速向かうとするぞ。", "face": "u1458"}, {"name": "サーベイン", "text": "ハ、ハクノカミ様！　お戯れモ程々ニ！", "face": "u425"}, {"name": "ハクノカミ", "text": "戯れなどではない、\nわらわも魔界武王決定戦とやらに出場するのじゃ。\nほれ、ちゃんと招待状も持っておるじゃろう。", "face": "u1458"}, {"name": "ハクノカミ", "text": "目を覚ますと枕元にコレが置いてあったのじゃ。\n寝起きの運動代わりにちょうどよい。\nさぁ、とっととゲートを通り王子達の元へ向かうぞ！", "face": "u1458"}, {"name": "サーベイン", "text": "この地の龍玉の欠片の力を使い、王子達ノ持つ欠片へと\n魔界ノゲートを作るとハ……こんな芸当が出来るなんて、\n流石はハクノカミ様……。", "face": "u425"}, {"name": "ハクノカミ", "text": "うむ。そうじゃろうそうじゃろう。もっと褒めい。", "face": "u1458"}, {"name": "ゴライア", "text": "サーベイン、感心している場合カ！\n早くハクノカミ様を止め……\n……ん？　ゲートから誰か来たようだゾ？", "face": "u385"}, {"name": "アンナ", "text": "――こ、ここは……？　\n確か、王子の目の前に急にゲートが出現して……。", "face": "l831eb29f1552"}, {"name": "ハクノカミ", "text": "ふむ。わらわが入るより先に、\n王子たちが魔界からコチラへ来てしまったようじゃな。", "face": "u1458"}, {"name": "アンナ", "text": "ハクノカミ様？\nそれにサーベインさんにゴライアさんも。\n一体、どういう事でしょうか。", "face": "l831eb29f1552"}, {"name": "サーベイン", "text": "オオ！　王子！　実はハクノカミ様も\n魔界武王決定戦に招待されていてナ……。\n大会に出ると言って聞かないのだ……！", "face": "u425"}, {"name": "サーベイン", "text": "危険な大会で\nハクノカミ様の身を危険に晒す訳にはいかヌ。\n王子たちからも言い含めてくれないカ。", "face": "u425"}, {"name": "ハクノカミ", "text": "まったく、サーベインも強情じゃのぅ。\n……そうじゃ、王子たちも大会の参加者。\nならばここで試合といこうではないか。", "face": "u1458"}, {"name": "ハクノカミ", "text": "わらわは試合に参加できる、\n王子たち相手なら殺し合いにもならぬ。\nどうじゃ、サーベイン。これなら文句はなかろう。", "face": "u1458"}, {"name": "サーベイン", "text": "ム、ムムム……王子となら、\n確かに大丈夫かもしれン……王子、すまヌが\nハクノカミ様のお戯レに少しばかり付き合ってくれまいカ。", "face": "u425"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "ここにまで審判が！？", "face": "l831eb29f1552"}, {"name": "ケイティ", "text": "ハクノカミ様も招待状を持つ大会参加者。\n魔界の外であれ、この戦いも\n正式な大会の一戦という事ですね。", "face": "u114"}, {"name": "ハクノカミ", "text": "む、「絶対ルール」の審判か。\nちょうどよいハンデじゃな。\nさぁゆくぞ王子、わらわを満足させい！", "face": "u1458"}]}, {"trigger": "end", "lines": [{"name": "サーベイン", "text": "本来の力が戻らぬ身であのお強さ……！\n流石はハクノカミ様で御座いまス！", "face": "u425"}, {"name": "ゴライア", "text": "ケッ、サーベインの野郎、\nハクノカミ様と一緒に戦えて感激してやがる。\n……まぁ、オレも……悪い気分じゃねぇがナ。", "face": "u385"}, {"name": "サーベイン", "text": "この戦いの中での高揚感……。\nハクノカミ様と肩を並べて戦うなド、\nこのような機が無けれバ中々かなわぬカ……。", "face": "u425"}, {"name": "サーベイン", "text": "えぇイ、致し方あるまイ。ハクノカミ様の身は我々ガ\n全力でお守りすれば良いだけの事！　ハクノカミ様、\n此度の大会我々が全力でサポート致します！", "face": "u425"}, {"name": "サーベイン", "text": "魔界武王決定戦、かならずや優勝を！　\n…………ハクノカミ様？", "face": "u425"}, {"name": "ハクノカミ", "text": "…………\n…………\n…………むにゃ。", "face": "u1458"}, {"name": "アンナ", "text": "……眠ってらっしゃいますね。", "face": "l3cef686ba4a9"}, {"name": "サーベイン", "text": "は、ハクノカミ様！？　\n魔界武王決定戦に参加されるのでは\nなかったのですカ！！", "face": "u425"}, {"name": "ハクノカミ", "text": "ふわぁ……なんじゃ、うるさいのう……\n久しぶりに運動したら疲れたわ……\n……少し……ゆっくりしてからでも……ぐぅ。", "face": "u1458"}, {"name": "ゴライア", "text": "……だめダ。コリャ当分目覚めそうにネェナ。", "face": "u385"}, {"name": "サーベイン", "text": "そ、そんナ……いヤ、これでハクノカミ様が\n危険に晒される事もなイ。\nこれで良かったのダ……これデ。", "face": "u425"}, {"name": "アンナ", "text": "……何はともあれハクノカミ様と優勝を\n競い合う事にならずに済んで良かったですね、王子。\nさぁ、魔界へ戻りましょうか！"}]}], "story_talk": true, "active": true}