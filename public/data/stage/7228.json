, "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126864, "race_id": 20, "master_id": 33339, "global_id": 6956, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 12, "source": "local", "count": 9, "form_count": 3, "tags": ["アーマー"], "hp": 2800, "attack": 280, "base_hp": 2800, "base_attack": 280, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126896, "race_id": 20, "change_to": 12, "master_id": 33343, "global_id": 6960, "to_global_id": 6961, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 60}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 2800, "attack": 840, "base_hp": 2800, "base_attack": 840, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126912, "race_id": 20, "change_to": 13, "change_condition": 4, "master_id": 33344, "global_id": 6961, "to_condition": 4, "to_ticks": 1, "to_global_id": 6962}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 2800, "attack": 280, "base_hp": 2800, "base_attack": 280, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126896, "race_id": 20, "master_id": 33345, "global_id": 6962, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "スルーズ", "text": "――ここが、王国の防衛拠点ですね。\n姉さまには皆殺しにしろって言われましたけど……。", "face": "u1143a1"}, {"name": "スルーズ", "text": "偵察任務だって言うから、\n私も付いてきたのに……これじゃあ戦争ですよ……。", "face": "u1143a1"}, {"name": "スルーズ", "text": "――うぅん、迷っていてはだめ、スルーズ。\n今の私は、天界兵を預かる身なのですから。\n総員、隊列を整えよ！　進軍開始！！", "face": "u1143a1"}, {"name": "ミーシャ", "text": "――王子、すでに天界兵が陣をしいています！", "face": "u19"}, {"name": "エレイン", "text": "でも開戦には間に合ったようね。\n急いだ甲斐があったってものよ！", "face": "u36"}, {"name": "キャリー", "text": "あれ、敵に騎兵だけじゃなく、\n天界人の兵士も混じっていませんか？", "face": "u26"}, {"name": "トラム", "text": "天界兵を使うなんて、敵は何を考えているのかしら。\n彼らは物質界では本来の力を発揮できないのに。", "face": "u1110a1"}, {"name": "クリッサ", "text": "……捨て駒、ということ？", "face": "u52"}, {"name": "アトナテス", "text": "気に入らねぇな……。\n手段を選ばないって言っても限度があるぜ。", "face": "u908"}, {"name": "クリッサ", "text": "うん、同感。\n兵の実力を信じない指揮官なんて、\n王国の、私たちの敵じゃない。", "face": "u52"}, {"name": "トラム", "text": "これはおそらく、私たちの実力を測るための偵察よ。\n今後の天界に、\nどんな影響を与えるか見極めるためのね。", "face": "u1110a1"}, {"name": "トラム", "text": "――だから、全力で叩いてやるわよ王子。\n被害者を減らすためにも、最初から全開で！", "face": "u1110a1"}]}, {"trigger": "end", "lines": [{"name": "スルーズ", "text": "――くっ……強い……！\n皆さん、撤退しますよ！", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "――様子を見に来てみれば……。\nスルーズ、なぜ勝手に兵を撤退させるのだ。\n天界兵は使い潰して良いのだぞ？", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "姉さま……！\nしかし彼らは、物質界では本来の力が……。", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "雑兵などいくらいても同じ。\n父上の寵愛深き我らがいれば、\nこれより先の戦乱も問題ないだろう。", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "だから！　姉さま、あの御方はお父さまでは――", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "――やれやれ。\n自分の創造主の見分けもつかないとは。\n父上は姿を変え、私たちのもとへ帰ってきたのだぞ。", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "さぁ、さらに戦火を広げるのだ、スルーズよ。\n人は絶望の縁にあってこそ、\n本来の実力を発揮すると聞いているからな。", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "物質界が、父上の手を煩わせる程の存在なのか、\n我らがそれを見極めるのだ。", "face": "l2644ec5e215f"}, {"name": "ミーシャ", "text": "……天槍騎兵団、撤退していきます。\nいえ、むしろ転戦のために\n移動したというべきでしょうか。", "face": "u19"}, {"name": "キャリー", "text": "あの馬ずるくないですか！？\nどれだけ走っても疲れてる気配がないんですけど！", "face": "u26"}, {"name": "トゥアン", "text": "天槍騎兵団、あいつらが\n精鋭だってのは認めるしかないな。\nだが手段に誇りが感じられないぞ。", "face": "u1006a1"}, {"name": "トラム", "text": "本来のあの子たちは、\n心優しい、民の守護者だったはずなのだけれど……。", "face": "u1110a1"}, {"name": "クリッサ", "text": "そんな子たちなら、ちゃんと止めてあげよう。\n支配が解けた後、きっと泣いてしまうから。", "face": "u52"}, {"name": "トラム", "text": "ふふ、そうですね。\nさぁ王子、急いで彼女らを追いましょう！", "face": "u1110a1"}]}], "story_talk": true, "active": true}