{"quest_id": 7429, "name": "第二陣 蘇りし黒き竜人の長", "description": "ハイドースの力によって蘇った闇の大長老\n率いる竜人族の部隊が海上より襲い来る。\n＜広域戦闘：敵味方の射程減少＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国二陣", "event_category": "Empire", "mission_id": 940006, "map_no": 4578, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [35]}, {"kind": "term", "influence": 20, "params": [35]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 62, "form_index": 0, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098576, "race_id": 2, "master_id": 147, "global_id": 146, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_speed": 90, "attack_wait": 25, "attack_interval": 221, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098640, "race_id": 2, "change_to": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 31275, "global_id": 4894, "to_condition": 0, "to_global_id": 150, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 17}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_r