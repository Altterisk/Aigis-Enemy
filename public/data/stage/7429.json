rm_index": 0, "form_count": 2, "hp": 6500, "attack": 400, "base_hp": 6500, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "attack_range": 210, "attack_speed": 1, "attack_wait": 30, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130944, "race_id": 2, "special_effect_id": 242, "change_to": 15, "missile_id": 608, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34098, "global_id": 7715, "ranged": true, "to_condition": 0, "to_global_id": 7709, "route_behaviour": {"hold": {"routes": 5, "held": 5}, "reroutes": ["Route=999"]}, "spawn_sec": 53}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6500, "attack": 400, "base_hp": 6500, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "attack_range": 270, "attack_speed": 1, "attack_wait": 30, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130944, "race_id": 2, "change_to": 16, "change_condition": 1, "missile_id": 608, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34092, "global_id": 7709, "ranged": true, "from_condition": 0, "variants": [{"hp": 6500, "attack": 600, "base_hp": 6500, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 30, "attack_wait": 20, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130960, "race_id": 2, "master_id": 34093, "global_id": 7710}]}, {"enemy_id": 18, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 1000, "attack": 230, "base_hp": 1000, "base_attack": 230, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_speed": 60, "attack_wait": 60, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098624, "race_id": 2, "change_to": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34118, "global_id": 7735, "to_condition": 0, "to_global_id": 149, "route_behaviour": {"transforms": [{"wait": 800}]}, "spawn_sec": 99}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 230, "base_hp": 1000, "base_attack": 230, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098624, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 150, "global_id": 149, "ranged": true, "from_condition": 0}, {"enemy_id": 3, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098640, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 151, "global_id": 150, "ranged": true, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 198}], "popups": ["闇の大長老は体力が\n徐々に減少していきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ハイドース", "text": "――裏切られ、背後よりの凶刃に倒れ、\nさぞ無念な生だったことだろう。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "黒き竜人、闇色の鱗持つ、竜神が子孫よ。\n汝の後悔、悲しみ、この戦にて晴らすがよい。", "face": "le4066daa294e"}, {"name": "大長老", "text": "うむ……感謝しておるぞ、冥界の亜神よ。\n――しかし、まさかわしを選ぶとは、\nその理由が少々分からぬ。", "face": "lc718fe4021f3"}, {"name": "大長老", "text": "ハイドース殿、貴殿は貴殿なりの、\n正義の為に剣を取ったのじゃろう？", "face": "lc718fe4021f3"}, {"name": "大長老", "text": "それが悪を討つためか、\n定命の者たちの悲しみを雪ぐためなのかは分からぬ。\nじゃがそれは、わしとは意見を異にするものじゃろう。", "face": "lc718fe4021f3"}, {"name": "ハイドース", "text": "大長老よ、我らの意見があうことは、決してあるまい。\nしかし、この戦においてのみ、\n我らは同じ場所を目指すことができよう。", "face": "le4066daa294e"}, {"name": "大長老", "text": "クク……感情に振り回されぬその意志、気に入ったわ。\n此度の蘇りへの感謝として、\nおぬしの真の目的は詮索せずにおいてやろう。", "face": "lc718fe4021f3"}, {"name": "ハイドース", "text": "ご配慮痛み入る。\n――ではまた、冥界にてまみえよう。", "face": "le4066daa294e"}, {"name": "大長老", "text": "カッカッカ！\n良かろう、この老体の生命の輝き、\n腑抜けた地上の竜人に見せてやろうかのう！", "face": "lc718fe4021f3"}, {"name": "大長老", "text": "さぁ竜人族が兵たちよ！\n地上にさらなる穴を開けてやれ！\nもはやこの都市はわしらの物ぞ！", "face": "lc718fe4021f3"}]}, {"trigger": "end", "lines": [{"name": "大長老", "text": "……強く、なったのう。\n実に、竜人らしい苛烈な戦いじゃった……。", "face": "lc718fe4021f3"}, {"name": "メリュジアナ", "text": "……先代も。\n最期にふさわしい、堂々たる戦いでした。", "face": "u740"}, {"name": "大長老", "text": "可愛いメリュジアナよ、\nわしを殺した娘のこと、恨むでないぞ……。\nあの場は戦場、それを忘れたわしにこそ非があるのじゃ。", "face": "lc718fe4021f3"}, {"name": "メリュジアナ", "text": "ははっ、心配無用。\nシャディアは私の茶飲み友だちです。\n恨むどころか、先代の死に様は笑い話ですとも。", "face": "u740"}, {"name": "大長老", "text": "……むっ、ククッ……カッカッカ！\nそうか、そうか……！", "face": "lc718fe4021f3"}, {"name": "メリュジアナ", "text": "えぇ、そのとおりです。\nシャディアは申し訳無さそうな顔をしますが、\nその表情を見る度に、頬を引っ張ってやっています。", "face": "u740"}, {"name": "大長老", "text": "うむっ、実に竜人らしい！\nこれで、わしも大往生できるというものよ！", "face": "lc718fe4021f3"}, {"name": "大長老", "text": "さらばじゃ、メリュジアナ。\nエルドラ様と、ハクノカミ様にもよろしく伝えておくれ。", "face": "lc718fe4021f3"}, {"name": "メリュジアナ", "text": "えぇ、必ず。\nそれでは先代、おさらばです。", "face": "u740"}, {"name": "シャディア", "text": "…………。", "face": "u713"}, {"name": "メリュジアナ", "text": "はぁ……さっきの会話、聞いていただろう？\nそういう顔をする小娘は――こうだっ！　このこのっ！", "face": "u740"}, {"name": "シャディア", "text": "やっ、やめっ、いだだだだっ！？\n頬をひっぱるにゃっ！", "face": "u713"}, {"name": "メリュジアナ", "text": "殺された当人が許すと言っているのだ。\n胸を張って、私が殺したと自慢しておけ！", "face": "u740"}, {"name": "シャディア", "text": "むっ、それはそれで違うと思――いひゃいっ！？", "face": "u713"}, {"name": "メリュジアナ", "text": "さぁ、戦いはまだ続いているぞ！\n我らは王国軍。\n盟友たる帝国の民を守るため、剣を取るのだ！", "face": "u740"}]}, {"trigger": "route", "enemy_ids": [4, 4201], "lines": [{"name": "メリュジアナ", "text": "――先代、まさか本当に蘇ってくるとは。", "face": "u740"}, {"name": "大長老", "text": "おぉ、おぉ、メリュジアナよ。\n実に懐かしいのう。\nさぁ、もっとよく顔を見せておくれ。", "face": "lc718fe4021f3"}, {"name": "メリュジアナ", "text": "……断る。\n私はもはや、貴様の一族ではない。\n庇護される幼き日々は、もう終わったのだ。", "face": "u740"}, {"name": "大長老", "text": "……そうか。\nクク……おぬしが一番御しやすいと思ってみれば、\nいつの間にか、斯様に強くなっておったのじゃなぁ。", "face": "lc718fe4021f3"}, {"name": "メリュジアナ", "text": "黒き竜人の一族は、今は王国と共に歩んでいる。\n貴様の行為は、その同盟に泥を塗る卑劣な反逆だ。", "face": "u740"}, {"name": "大長老", "text": "メリュジアナよ……忘れたというのか……？\n虐げられ、地下に追いやられた竜人の嘆きを、怒りを！", "face": "lc718fe4021f3"}, {"name": "メリュジアナ", "text": "覚えているとも！\nだが、それを押してなお、\n我らは未来の子らの為に、平和を願ったのだ！", "face": "u740"}, {"name": "大長老", "text": "……そうか、残念だ、メリュジアナよ。\n――艦隊に伝えよ、ドラゴニュートメイジを出せ、\nもはや地上の竜人は、我らが同胞ではないとな。", "face": "lc718fe4021f3"}, {"name": "大長老", "text": "蘇生の術により、我が身は徐々に崩れつつはあるが――\nこの魂砕け散るより前に、帝国もろとも、\n王国に与した者どもを蹂躙してやろうぞ！", "face": "lc718fe4021f3"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "メリュジアナ", "text": "……王子。なに、気にするな。\nかつて伝えられなかった別れの言葉を、\n今こうして伝えられたのだ。", "face": "u740"}, {"name": "メリュジアナ", "text": "さぁ、戦いはまだ続いているぞ。\n世界を救う王子のその意志、\n王国軍も皆、受け継いでいるのだと見せてやろう！", "face": "u740"}]}], "active": true}