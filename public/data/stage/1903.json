15680, "race_id": 7, "special_effect_id": 310, "change_to": 5, "missile_id": 299, "missile": {"speed": 1.0}, "master_id": 31249, "global_id": 4868, "to_global_id": 4859, "route_behaviour": {"transforms": [{"wait": 15}]}, "spawn_sec": 150}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["変異"], "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 411, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115680, "race_id": 7, "special_effect_id": 310, "change_to": 4, "missile_id": 299, "missile": {"speed": 1.0}, "master_id": 31240, "global_id": 4859, "ranged": true, "to_global_id": 4860}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["変異", "狙う", "ブロック不可", "水面"], "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 201, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115696, "race_id": 7, "special_effect_id": 310, "change_to": 5, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 31241, "global_id": 4860, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 150000, "attack": 4000, "base_hp": 150000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 3000, "attack_range": 300, "attack_wait": 200, "attack_interval": 476, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115808, "special_effect_id": 313, "missile_id": 300, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31248, "global_id": 4867, "ranged": true, "spawn_sec": 165}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "tags": ["変異", "狙う", "ブロック不可", "水面"], "hp": 15000, "base_hp": 15000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2115728, "race_id": 7, "special_effect_id": 309, "change_to": 9, "master_id": 31243, "global_id": 4862, "to_global_id": 4861, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 207}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["変異"], "hp": 15000, "attack": 1100, "base_hp": 15000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2115712, "race_id": 7, "special_effect_id": 309, "change_to": 8, "master_id": 31242, "global_id": 4861}], "popups": ["警備機械は攻撃力1500以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。", "大型警備機械は攻撃力3000以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲に大ダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ピッキー", "text": "『開発区』はこの道を進んだ先です。\n足元に気をつけてくださいね。", "face": "u671"}, {"name": "リッカ", "text": "本当に、もう誰も住んでいないんですね。\n街も静まり返って――って、\nあれ、機械の駆動音がきこえるような……？", "face": "u152"}, {"name": "ピッキー", "text": "えっ？　この地区にはもう、誰もいないはずです。\n警備機械も全部機能停止しているはずですが……。", "face": "u671"}, {"name": "リッカ", "text": "うぅん、間違いないです。\nこっちに向かってきています！", "face": "u152"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "ピッキー", "text": "あれは……！\nそんな、制御室まで奪われているなんて。\n間違いなく鋼の都の警備機械です……！", "face": "u671"}, {"name": "ユリアン", "text": "おっと、今は対処が優先だ。\n驚いてる暇はないぜ。", "face": "u7"}, {"name": "ピッキー", "text": "……そう、ですよね。はい！\n皆さん、警備機械は不可視の防壁を展開していて、\n防壁の出力を超える攻撃以外は防がれてしまいます。", "face": "u671"}, {"name": "レアン", "text": "なんだって？\nそれじゃあどうしたらいいんだ？", "face": "u50"}, {"name": "ピッキー", "text": "防壁自体は延々と展開し続けることは出来ないんです。\n時間が経てば、いずれ解除されると思うのですけど……。", "face": "u671"}, {"name": "ユリアン", "text": "浮かない顔だな。\n……防壁が解除されるまで待ってたら、\nコチラがやられちまう、って事か。", "face": "u7"}, {"name": "モーティマ", "text": "へっ、なら防壁とやらじゃ防げねぇ位、\n重い攻撃をぶち込みまくってやろうぜ王子！", "face": "u14"}, {"name": "王子", "text": "……！", "face": "u1"}, {"name": "ピッキー", "text": "そ、そんな事が可能なんですか！？\n……いや、そうしなくちゃいけないんですよね……！", "face": "u671"}, {"name": "ピッキー", "text": "皆さん、警備機械は、\n破壊された時に自爆するように設定されてます。\n撃破時の自爆には気をつけてください！", "face": "u671"}]}, {"trigger": "battle", "at_sec": 170, "lines": [{"name": "ピッキー", "text": "お、大型防衛機械まで！\n皆さん、アイツを倒したら\nすぐに避難して下さい！", "face": "u671"}, {"name": "アンナ", "text": "大型の防衛機械ですか……！\n大型と言う事は、当然その自爆も……！", "face": "laa9c849b0c0e"}, {"name": "ピッキー", "text": "はい！　小型機の比じゃない威力ですよ！\n倒したら周囲の皆さんはすぐに避難して下さい！", "face": "u671"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "…………。\n危うく吹き飛ばされるところでしたね……。", "face": "lc8551844ffc4"}, {"name": "ユリアン", "text": "だが、あんな強力な警備機械がいても、\n魔物の侵攻を防ぎきれなかったとはな……。", "face": "u7"}, {"name": "アンナ", "text": "王国を襲撃した魔物の規模に匹敵する、\n大軍勢が鋼の都を襲ったのですね……。", "face": "lc8551844ffc4"}, {"name": "ピッキー", "text": "鋼の都を奪還できるとすれば、\nあたしたちの守りの要だった、\n警備機械達だけだったのに……。", "face": "u671"}, {"name": "ピッキー", "text": "どうしたら良いのでしょうか……。\n変異種と化した魔物相手に、\n人の手だけで勝つことなんて……。", "face": "u671"}, {"name": "ユリアン", "text": "落ち込むには早いぜ。\n警備機械はいなくても、代わりに俺達がいるさ。\n――な、王子？", "face": "u7"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ピッキー", "text": "うぅっ……ぐすっ、ありがとうございます……。", "face": "u671"}, {"name": "ピッキー", "text": "泣いてる場合じゃないですよね。\nさらわれた皆を助けるために、\n態勢を整えて『開発区』へ向かいましょう……！", "face": "u671"}]}], "hard": {"level": 180, "multiplier": 1.8, "modifiers": [{"kind": "term", "influence": 25, "params": [200], "expression": "!IsIdentitiy(\"機械\")", "expression_human": "it does not have the identity [[tag:機械]]"}], "enemies": [{"enemy_id": 1, "hp": 5940, "attack": 580, "damage_type": "physical", "pattern_id": 2115744}, {"enemy_id": 3, "hp": 14400, "attack": 800, "damage_type": "physical", "armor_defense": 1500, "pattern_id": 2115792}, {"enemy_id": 4, "hp": 27360, "attack": 3240, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2115776}, {"enemy_id": 5, "hp": 14400, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115696}, {"enemy_id": 5, "form_index": 1, "hp": 14400, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115680}, {"enemy_id": 7, "hp": 14400, "attack": 360, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115680}, {"enemy_id": 7, "form_index": 1, "hp": 14400, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115680}, {"enemy_id": 7, "form_index": 2, "hp": 14400, "attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2115696}, {"enemy_id": 8, "hp": 270000, "attack": 4000, "damage_type": "physical", "armor_defense": 3000, "pattern_id": 2115808}, {"enemy_id": 9, "hp": 27000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "pattern_id": 2115728}, {"enemy_id": 9, "form_index": 1, "hp": 27000, "attack": 1980, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "pattern_id": 2115712}]}, "story_talk": true, "active": true}