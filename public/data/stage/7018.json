{"quest_id": 7018, "name": "女王の軍略", "description": "激戦の最中、メカゴブリンクイーンが姿を\n現す！　猛犬を駆るライダーに浮遊戦車、\n女王指揮下の多彩な戦略を打ち破れ！\n神級（★１獲得の目安：平均Lv50）", "event": "アルケウス・アルケミスト", "event_category": "History", "mission_id": 920142, "map_no": 5727, "level": 100, "multiplier": 1.0, "charisma": 150, "exp": 620, "gold": 2000, "drops": [{"item": 5003, "c": 4}, {"item": 5002, "c": 1}, {"card": 60, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 13000, "attack": 400, "base_hp": 13000, "base_attack": 400, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 400, "attack_wait": 60, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114624, "race_id": 9, "special_effect_id": 293, "change_to": 1, "change_condition": 1, "missile_id": 26, "master_id": 31048, "global_id": 4667, "ranged": true, "variants": [{"tags": ["アーマー", "機械"], "hp": 13000, "attack": 1500, "base_hp": 13000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 800, "magic_defense": 10, "attack_wait": 80, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114640, "race_id": 9, "master_id": 31049, "global_id": 4668}]}, {"enemy_id": 3, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 50000, "attack": 650, "base_hp": 50000, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_range": 150, "attack_speed": 100, "attack_wait": 100, "attack_interval": 261, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115904, "race_id": 9, "special_effect_id": 216, "missile_id": 304, "missile": {"speed": 3.0, "splash": 133}, "master_id": 31258, "global_id": 4877, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 22, "form_index": 0, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 600, "attack_speed": 45, "attack_wait": 10, "attack_interval": 113, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122096, "race_id": 9, "master_id": 32439, "global_id": 6058, "spawn_sec": 5}, {"enemy_id": 5, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098928, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 119, "global_id": 118, "ranged": true, "spawn_sec": 8}, {"enemy_id": 6, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 700, "attack_speed": 45, "attack_wait": 10, "attack_interval": 113, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122096, "race_id": 9, "special_effect_id": 496, "master_id": 32437, "global_id": 6056, "spawn_sec": 48}], "dialogue": [{"trigger": "start", "lines": [{"name": "メカゴブリンクイーン", "text": "――あぁら、苦戦しているようね、ゴブリン博士。", "face": "leff7b92ea817"}, {"name": "アンナ", "text": "メカゴブリンクイーン……！？", "face": "l395a4968e6f1"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、久しぶりねぇ。\nさぁ博士『賢者の金赤石』採掘進捗を報告なさい。", "face": "leff7b92ea817"}, {"name": "ゴブリン博士", "text": "ハッ！　鉱脈までは発見いたしましタ。\nシカシ王子タチの妨害にあイ……。", "face": "l134051adcf91"}, {"name": "メカゴブリンクイーン", "text": "アナタの技術力は高く評価しているけれど、\n軍略についてはまだまだのようね、ゴブリン博士。", "face": "leff7b92ea817"}, {"name": "ゴブリン博士", "text": "ハッ、ハハァ……！！\n申し訳ありまセン……！！", "face": "l134051adcf91"}, {"name": "メカゴブリンクイーン", "text": "良いわ、ここからはこの私が指揮を執ってあげる。\n王子への借りは返した以上、\n憂いなく戦うことが出来るものねぇ！", "face": "leff7b92ea817"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "メカゴブリンクイーン", "text": "ウフフフッ、気にする必要はないわ。\nさぁ、かかってきなさい。\nゴブリン族の技術と戦略をみせてあげるから！", "face": "leff7b92ea817"}, {"name": "アンナ", "text": "王子、あちらには先程のゴブリンライダーに加え、\n浮遊戦車も控えているようです。\n慎重な指揮をお願いします！！", "face": "l395a4968e6f1"}]}, {"trigger": "end", "lines": [{"name": "メカゴブリンクイーン", "text": "ウフフフッ、また強くなったんじゃないかしら？\n魔王様を倒したのは、やはり偶然ではなかったのねぇ。", "face": "leff7b92ea817"}, {"name": "ゴブリン博士", "text": "メカゴブリンクイーン様！\n撤退いたしまス！　早くこちらヘ！！", "face": "l134051adcf91"}, {"name": "メカゴブリンクイーン", "text": "そうね、これ以上は分が悪いわ。\n――ニコル！　アナタの技術は惜しいけれど、\nその才能を垣間見られたことは忘れないわ！", "face": "leff7b92ea817"}, {"name": "メカゴブリンクイーン", "text": "美しさと強さを兼ね備えた宝石！\nまるで私みたいじゃないかしら？　オ～ッホッホッホ！", "face": "leff7b92ea817"}, {"name": "ニコル", "text": "あぁっ、ニコルちゃんの『賢者の金赤石』を、\nあなたと一緒にしないでくれるかなぁ～！？", "face": "u994"}, {"name": "デモンポーン", "text": "はぁ……はぁ……。\n何とかなったよぉ……。\nニコルちゃん先生、怪我はなかった？", "face": "u997"}, {"name": "ニコル", "text": "うんうん♪　王子さまたちと、\n助手ちゃんのおかげでぴんぴんしてるよー♪", "face": "u994"}, {"name": "ニコル", "text": "とっこっろっでー。\nね、王子さま？　そして助手ちゃんのお姉さん？\n助手ちゃんの活躍っぷり、ちゃんと見てたかな？", "face": "u994"}, {"name": "ハルモニア", "text": "えぇ。いつの間にか、こんな立派になって。", "face": "u941"}, {"name": "アンナ", "text": "以前は断られてしまいましたが、今度は共に――"}, {"name": "デモンポーン", "text": "――うん、えっと、うぅぅ。", "face": "u997"}, {"name": "デモンポーン", "text": "うー！！　だめ！　やっぱりダメー！！\nまだしなくちゃいけない事があるからー！！", "face": "u997"}, {"name": "ニコル", "text": "あっ……走って行っちゃった……。\nまったく、困った助手ちゃんだなぁ♪", "face": "u994"}, {"name": "ハルモニア", "text": "ふふ、でもきっと、すぐに戻ってきますよ。\nきっと何か、やり残したことがあるのでしょう。", "face": "u941"}, {"name": "アンナ", "text": "そうですね。それでは王子、\n私達も王国へ帰還しましょうか。\n此度の遠征、お疲れさまでした！"}]}], "map": {"image": "Map920142_5727", "w": 960, "h": 640, "spots": [{"k": "b", "x": 44, "y": 331}, {"k": "m", "x": 143, "y": 338, "id": 200}, {"k": "m", "x": 191, "y": 259, "id": 201}, {"k": "m", "x": 255, "y": 339,