1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111168, "race_id": 3, "change_to": 8, "change_condition": 2, "master_id": 30464, "global_id": 4083, "to_condition": 2, "to_global_id": 4055, "spawn_sec": 129}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 9000, "attack": 450, "base_hp": 9000, "base_attack": 450, "damage_type": "physical", "armor_defense": 90, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30436, "global_id": 4055, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 153}], "popups": ["魔神アモンとその配下は\n一定範囲内のユニットに\n継続してダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "サヨ", "text": "印象に残る戦いって言ったらさ、\n王子軍の強さに一番驚いたのはあの戦いだよ。", "face": "u510"}, {"name": "サヨ", "text": "ほら、一度は退けた魔神アモン。\n奴がパワーアップしてやって来た時。\nあんなの、どうやって戦うのって思ったもの。", "face": "u510"}, {"name": "アンナ", "text": "――王子、もうすぐ、敵と接触します。\n先に迎撃にあたった兵の半数は命を落とし、\n残りは命からがら逃げ延びた……あの魔神アモンと。", "face": "l09e714fb7b3c"}, {"name": "アンナ", "text": "報告によると、敵は炎に包まれた鳥の頭を持つ魔物で\n並外れた戦闘能力を誇っているとの事。\n進行を止めることすら難しく思われます。", "face": "l09e714fb7b3c"}, {"name": "アンナ", "text": "その上、鎧が溶けてしまう程の凄まじい炎熱を\nまとっており、近づくだけでダメージを\n負ってしまうようです。", "face": "l09e714fb7b3c"}, {"name": "アンナ", "text": "また、同様の力を備えた眷属も従えているようです。\nこれまでとは比べ物にならない壮絶な\n戦いが予想されます。", "face": "l09e714fb7b3c"}, {"name": "アンナ", "text": "十分な鍛練、編成を準備された上で\nこちらに布陣しているとは思いますが、\nその上で、慎重な采配をお願いします。", "face": "l09e714fb7b3c"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "王子、魔神が後退していきます！\n……なんとか、魔神を退けられたようですね。"}, {"name": "アンナ", "text": "魔神アモンを撃退できて本当に良かったです。\n王子、この度はお疲れさまでした！"}, {"name": "サヨ", "text": "……ほんと、奇跡的な勝利だよね。\nあの魔神を一度だけじゃなく\n二度も追い払っちゃうんだから。", "face": "u510"}, {"name": "サヨ", "text": "ちなみにわたしはデーモンに変装して、\n王子の戦いを見届けてたのよ。\n熱い戦いだったわ……色んな意味でね。", "face": "u510"}, {"name": "サヨ", "text": "さて、それじゃこの辺りで一度休憩にしましょうか。\n長話に付き合ってくれてありがとう……と言っても、\n積もり積もった話はまだまだあるわ。", "face": "u510"}, {"name": "サヨ", "text": "今までろくに話せなくて溜まった分、\nこの機会に語りつくしちゃうんだから。\n休憩が終わったら、ちゃんと付き合ってよね！", "face": "u510"}]}], "map": {"image": "Map920094_5233", "w": 960, "h": 640, "spots": [{"k": "b", "x": 107, "y": 85}, {"k": "m", "x": 311, "y": 155, "id": 200}, {"k": "m", "x": 460, "y": 133, "id": 201}, {"k": "m", "x": 608, "y": 122, "id": 202}, {"k": "m", "x": 760, "y": 155, "id": 203}, {"k": "m", "x": 832, "y": 253, "id": 204}, {"k": "m", "x": 770, "y": 334, "id": 205}, {"k": "m", "x": 636, "y": 324, "id": 206}, {"k": "m", "x": 517, "y": 312, "id": 207}, {"k": "m", "x": 386, "y": 296, "id": 208}, {"k": "m", "x": 232, "y": 302, "id": 209}, {"k": "m", "x": 134, "y": 387, "id": 210}, {"k": "m", "x": 219, "y": 454, "id": 211}, {"k": "m", "x": 347, "y": 451, "id": 212}, {"k": "m", "x": 477, "y": 438, "id": 213}, {"k": "m", "x": 607, "y": 424, "id": 214}, {"k": "m", "x": 747, "y": 423, "id": 215}, {"k": "m", "x": 189, "y": 141, "id": 216}, {"k": "r", "x": 272, "y": 224, "id": 300}, {"k": "r", "x": 350, "y": 227, "id": 301}, {"k": "r", "x": 691, "y": 198, "id": 302}, {"k": "r", "x": 750, "y": 250, "id": 303}, {"k": "r", "x": 660, "y": 258, "id": 304}, {"k": "r", "x": 471, "y": 371, "id": 305}, {"k": "r", "x": 376, "y": 357, "id": 306}, {"k": "r", "x": 297, "y": 390, "id": 307}, {"k": "r", "x": 215, "y": 381, "id": 308}]}, "start_cost": 10, "active": true, "name_en": "Amon's Return (Memory) Reports that the Demon God Amon has appeared again. Challenge the decisive battle against the Flame Demon God, enveloped in hellfire that burns everything around. Divine (★1 acquisition guideline: Avg Lv50)", "description_en": "Word comes that the Demon God Amon has returned.\nFace the demon of flame, wreathed in hellfire\nthat scorches everything around, in a decisive battle.\nGod (★1 guideline: Avg Lv50)"}