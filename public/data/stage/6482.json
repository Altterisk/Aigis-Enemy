{"quest_id": 6482, "name": "炎熱の試練", "description": "炎熱吹き荒れる「炎熱の試練」。\n灼熱の中迫る魔物達を討伐せよ。\n＜HPに継続ダメージ：中＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["HPに継続ダメージ：中"], "event": "凶鳥の射手", "event_category": "History", "mission_id": 920109, "map_no": 5342, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 1, "change_condition": 5, "master_id": 780, "global_id": 779, "to_condition": 5, "to_global_id": 780, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 781, "global_id": 780, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 31}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 70}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 78}, {"enemy_id": 6, "source": "local", "count": 8, "form_count": 1, "hp": 4500, "attack": 150, "base_hp": 4500, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105584, "missile_id": 152, "missile": {"speed": 6.0, "splash": 133}, "master_id": 702, "global_id": 701, "ranged": true, "spawn_sec": 100}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31059, "global_id": 4678, "ranged": true, "spawn_sec": 127}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 300, "base_hp": 25000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_range": 130, "attack_speed": 120, "attack_wait": 60, "attack_interval": 221, "move_speed": 230.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100192, "missile_id": 28, "missile": {"speed": 6.0, "splash": 200}, "master_id": 223, "global_id": 222, "ranged": true, "spawn_sec": 188}], "popups": ["ファイアエレメンタルの\nHPを減らすと、\n遠距離攻撃をしてきます。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "シャロン", "text": "暑い……。\nこんなに暑いとヘトヘトになっちゃうわ……。", "face": "u283"}, {"name": "フーリ", "text": "暑さのせいで、普段以上に体力を使いますね……。", "face": "u174"}, {"name": "ヒューナ", "text": "でも……ここが第五の試練の場で……、\nあっている……はずよ……あちちち……。", "face": "u627"}, {"name": "クルル", "text": "洞窟の中なのに、\nこんなに環境が変化するなんて、\n本当にとんでもない試練だね、びっくりしちゃう。", "face": "u197"}, {"name": "フラン", "text": "それで、第五の試練の内容は……。\nそのクロスボウは何と言っているの？", "face": "u183"}, {"name": "ヒューナ", "text": "次は「炎熱に吹き荒れる魔の力を退けよ」って、\n『この子』は言っているけれど……。\n魔の力って何のことかしら……？", "face": "u627"}, {"name": "シャロン", "text": "炎熱に吹き荒れる魔の力って……。\nこれ以上暑くならないことを祈るわ……。", "face": "u283"}, {"name": "フーリ", "text": "でも、試練はあとふたつですよね。\nここが頑張りどころですよ！", "face": "u174"}, {"name": "クルル", "text": "クロスボウさんの本当の目的の為にもね♪\n精一杯回復するから、皆もがんばってね！", "face": "u197"}, {"name": "ヒューナ", "text": "待って……本当の、目的？\n試練には『この子』の力を解放する以外に、\n別の目的があるって言うの……？", "face": "u627"}, {"name": "シャロン", "text": "断定はできないですけどね。\nただ「力の解放」以外にも、別の目的があると言うか、\n試練の過程がそうなっているというべきか……。", "face": "u283"}, {"name": "クルル", "text": "クロスボウさんの目的って、分かりやすいと思うけどね？\nでもきっと、私達が教えちゃ意味がないから……。\nほら、それよりも今は試練に集中しないと！", "face": "u197"}, {"name": "ヒューナ", "text": "んんん……気になるけど、まぁいいわ。\n王子、皆、まずはこの試練を乗り越えましょう！", "face": "u627"}]}, {"trigger": "end", "lines": [{"name": "フーリ", "text": "大勝利、ですね！\n暑さでヘトヘトですけど……！", "face": "u174"}, {"name": "ヒューナ", "text": "えぇ、癒し手の皆がいなかったら、\n果たしてどうなっていたことか……。", "face": "u627"}, {"name": "ヒューナ", "text": "（やっぱり、この試練は、\n私ひとりでは突破できないように作られているのね）", "face": "u627"}, {"name": "ヒューナ", "text": "（一人では絶対に越えられない試練だなんて。\nクルルさんの言っていた、『この子』の本当の目的、\n私にもようやく分かってきた気がするわ……）", "face": "u627"}, {"name": "アンナ", "text": "ヒューナさん、また考え事ですか？", "face": "l26f6d378e2bc"}, {"name": "ヒューナ", "text": "えっ、あ、えぇと……。\nこの試練の、本当の目的について考えていたのよ。", "face": "u627"}, {"name": "フラン", "text": "「クロスボウの真なる力の解放」に、\n「世界で最も美しき力」。\nそれ以外にも、この試練には目的があるの？", "face": "u183"}, {"name": "シャロン", "text": "フラン、耳をかして？\n……ごにょごにょ……。", "face": "u283"}, {"name": "フラン", "text": "……そういうことね。\nヒューナ、最後の試練、必ず皆で突破しよう。", "face": "u183"}, {"name": "ヒューナ", "text": "うぅぅぅ～！！　何なのよ、もうー！！", "face": "u627"}, {"name": "アンナ", "text": "……ひとまず、最後の試練の場に移動しましょうか。\nこれまで以上の難度が予想されます。\nしっかりと準備をしていきましょう！", "face": "l26f6d378e2bc"}]}], "active": true}