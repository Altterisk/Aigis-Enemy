1, "tags": ["忍者"], "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 160, "attack_speed": 37, "attack_wait": 5, "attack_interval": 47, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098816, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 123, "global_id": 122, "ranged": true, "spawn_sec": 86}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 20, "attack_range": 160, "attack_speed": 80, "attack_wait": 5, "attack_interval": 61, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098784, "race_id": 16, "special_effect_id": 220, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 125, "global_id": 124, "ranged": true, "spawn_sec": 90}], "dialogue": [{"trigger": "start", "lines": [{"name": "鬼刃衆", "text": "骨片を盗んだ曲者はまだ見つからんのか！！", "face": "l634016918e5b"}, {"name": "忍者", "text": "申し訳ございません。どうやら見失ったようで……。", "face": "u147"}, {"name": "鬼刃衆", "text": "なにぃっ！　あれは我らに力をもたらす貴重な宝！\nおめおめと盗まれるとは……。\n貴様の命をもって償ってもらおうか！！", "face": "l634016918e5b"}, {"name": "忍者", "text": "ひぃッ……！　い、命だけはお助けください……！", "face": "u147"}, {"name": "？？？", "text": "そうよ。こーんな汚い骨ぐらいで部下を\n殺しちゃだめよ？\nていうか、これってそんなにすごいお宝なの？", "face": "u272"}, {"name": "鬼刃衆", "text": "それはただの骨ではない！　かつて地上に破壊と\n混乱をもたらした魔神の骨だ！", "face": "l634016918e5b"}, {"name": "？？？", "text": "ふーん。魔神の骨なんだー。\nでもそれがなんの役に立つってのよ。", "face": "u272"}, {"name": "鬼刃衆", "text": "魔神の骨を粉末にし、煎じて飲めば\nその力を取り込むことができる……！\nそんじょそこらの骨とはわけが違うんだ！！", "face": "l634016918e5b"}, {"name": "鬼刃衆", "text": "分量を間違えると命を落としかねんが、\n絶大な力を得られる代物だぞ……！！", "face": "l634016918e5b"}, {"name": "？？？", "text": "げっ、これ食べるの？　きったなーい。\nんじゃ、別に魔神の力が欲しいわけじゃないから\nいいや。これ、返すね。", "face": "u272"}, {"name": "鬼刃衆", "text": "……ん？　き、貴様！　何者だ！！！！", "face": "l634016918e5b"}, {"name": "アニータ", "text": "見ればわかるっしょー？\n可愛い泥棒、アニータさんよ。", "face": "u272"}, {"name": "アニータ", "text": "厳重に守ってるからすごいお宝と思ったのにさー。\nがーっかり。", "face": "u272"}, {"name": "鬼刃衆", "text": "おのれ……！　我らの秘密を知ったからには\n生かしては帰さんぞ！！", "face": "l634016918e5b"}, {"name": "アニータ", "text": "秘密って……、あんたが勝手にべらべらしゃべった\nだけじゃない。魔神の骨片って頭も悪くなる効果が\nあるのかしら。", "face": "u272"}, {"name": "アニータ", "text": "おバカさんとは付き合ってらんないの。\nじゃーね。", "face": "u272"}, {"name": "鬼刃衆", "text": "くそっ、逃がすな！　追えっ！", "face": "l634016918e5b"}, {"name": "アニータ", "text": "えいっ！　閃光玉！", "face": "u272"}, {"name": "鬼刃衆", "text": "ぐぁあああ！！　目がっ、目がぁあああ！！！", "face": "l634016918e5b"}, {"name": "ピピン", "text": "……このあたりから魔神の骨片の気配がします。", "face": "u275"}, {"name": "アンナ", "text": "すごい……！　そんなことまでわかるんですか？\nさすがは封印を護ってきた一族ですね！", "face": "l3b5e59a6cf4b"}, {"name": "アニータ", "text": "お嬢ちゃんたち、その骨片ならあそこにいる\n鬼みたいな顔をした人が持ってたよ。\nすごく怒っているみたいだから気を付けてねー。", "face": "u272"}, {"name": "アンナ", "text": "え！？　いまの女性は一体……。\n行ってしまいましたか……。", "face": "l3b5e59a6cf4b"}, {"name": "兵士", "text": "前方に忍者の軍団！\nこちらに向かって来ます！", "face": "l6852db1335ce"}, {"name": "鬼刃衆", "text": "きさまら……っ！　絶対に許さんぞ！！！！\n行くぞ！　水ぐもの術！！", "face": "l634016918e5b"}]}, {"trigger": "end", "lines": [{"name": "鬼刃衆", "text": "おのれッ……！！\nまさか……、我々が、負けるなど……っ！！", "face": "l634016918e5b"}, {"name": "アンナ", "text": "では、魔神の骨片は私たちが頂いていきますね。", "face": "l3b5e59a6cf4b"}, {"name": "鬼刃衆", "text": "返せッ！！　それは我々のものだ！！\nこのッ！　くそっ、縄がほどけぬ……！！", "face": "l634016918e5b"}, {"name": "ピピン", "text": "無事に見つかってよかった。\nこれも王子たちのおかげです。\nありがとうございます。", "face": "u275"}, {"name": "アンナ", "text": "魔神の骨片も無事に見つかりましたし、\n王城へ戻りましょう。"}, {"name": "鬼刃衆", "text": "覚えていろ……ッ！！", "face": "l634016918e5b"}]}], "active": true}