{"quest_id": 6039, "name": "癒しの至宝（記憶）", "description": "魔物の手により砕かれた癒しの至宝。\n砕かれた欠片を集め、\n至宝の力を取り戻せ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "戦場の記憶", "event_category": "History", "mission_id": 920085, "map_no": 3769, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "level": 70, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "level": 70, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 55, "attack_wait": 10, "attack_interval": 172, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097248, "race_id": 3, "special_effect_id": 35, "master_id": 20048, "global_id": 1123, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 5200, "attack": 900, "base_hp": 5200, "base_attack": 900, "damage_type": "physical", "armor_defense": 400, "magic_defense": 5, "attack_speed": 60, "attack_wait": 10, "attack_interval": 177, "move_speed": 500.0, "gain_cost": 2, "do