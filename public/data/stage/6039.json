2100624, "race_id": 18, "special_effect_id": 36, "master_id": 20047, "global_id": 1122, "spawn_sec": 2}, {"enemy_id": 9, "source": "local", "count": 1, "level": 70, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "special_effect_id": 35, "missile_id": 6, "master_id": 20049, "global_id": 1124, "ranged": true, "spawn_sec": 2}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 8}, {"enemy_id": 11, "source": "local", "count": 18, "form_count": 1, "tags": ["スライム"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100576, "master_id": 269, "global_id": 268, "spawn_sec": 47}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 52}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 11, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}], "dialogue": [{"trigger": "start", "lines": [{"name": "リアナ", "text": "ここは……！\n魔物たちがこんなにもたくさん。", "face": "u219"}, {"name": "アンナ", "text": "まさにモンスターハウスと\n言った所でしょうか……。", "face": "l832b17122fb2"}, {"name": "リアナ", "text": "気を付けて下さい、魔物の中には\n「癒しの至宝」の欠片を持つ魔物もいるハズです。\n彼らは時間経過で傷が回復してしまいます！", "face": "u219"}, {"name": "アンナ", "text": "「癒しの至宝」使えば多くの人達の\n傷を癒すと言われる神秘の秘宝。\nこの迷宮の深くに眠っているという話でしたが……。", "face": "l832b17122fb2"}, {"name": "リアナ", "text": "はい、私の一族の伝承ではそう伝えられていたのですが。\n深くに眠っていたハズの財宝は魔物によって破壊され、\n今はその欠片を配下の魔物に渡しているようです。", "face": "u219"}, {"name": "リアナ", "text": "至宝の力を用いて王子様の力になろうと思い、\n皆様に迷宮探索の協力を仰いだというのに、このような\n事態となってしまうなんて……申し訳ありません。", "face": "u219"}, {"name": "アンナ", "text": "いえ、私達がもっと早くに辿り着けていれば、\n至宝は魔物に破壊されずに済んでいたかもしれません。\nそれに、欠片を集めれば至宝の復活も可能なのですよね？", "face": "l832b17122fb2"}, {"name": "リアナ", "text": "たとえ砕かれたとしても、至宝に宿る再生の力は\n消えてはおりません。欠片を集める事が出来れば、\nその力で至宝も再生されると思われます。", "face": "u219"}, {"name": "アンナ", "text": "壊された至宝が復活するということであれば、\nこの迷宮を探索する価値は十分にあります。", "face": "l832b17122fb2"}, {"name": "アンナ", "text": "至宝の欠片集め、是非協力させてください。\n王子、魔物達を倒し、至宝を復活させましょう！"}]}, {"trigger": "end", "lines": [{"name": "リアナ", "text": "ありがとうございます、王子様。\nこれで至宝の欠片は全て集め終わりました。\n――っ！？　皆様、ご覧ください！", "face": "u219"}, {"name": "アンナ", "text": "至宝の欠片が光に包まれて――――きゃっ！　　", "face": "l832b17122fb2"}, {"name": "アンナ", "text": "なんと目映い光だったのでしょう……あっ、王子！\nご覧ください！　\nバラバラだった欠片が一つの宝珠へと戻っています！", "face": "l832b17122fb2"}, {"name": "リアナ", "text": "欠片の頃とは比べ物にならない、\n強い癒しの力を感じます……。\nこれが癒しの至宝なのですね。", "face": "u219"}, {"name": "アンナ", "text": "強烈な光こそ収まりましたが、\n至宝から放たれるこの淡い光……。\n見ていると心が落ち着きますね。"}, {"name": "リアナ", "text": "我が一族に伝わる至宝が魔物の手に落ちずに\n済んで良かった……。欠片集めに協力していただき、\n本当にありがとうございました。", "face": "u219"}, {"name": "リアナ", "text": "そして、改めてヒーラーとして、\n傷ついた大勢の方々を癒す力になれればと思います。\n私も、王子様の仲間に加えていただけないでしょうか？", "face": "u219"}, {"name": "アンナ", "text": "リアナさんが協力していただけるのでしたら\nこちらとしても非常に心強いです。\nぜひ今後とも、よろしくお願いします！"}, {"name": "レーヴ", "text": "――リアナさん、とっても優しそうな方でしたね。\n癒し手としても一流で、悠然としていて……。\n女性としても、術者としても憧れてしまいます！", "face": "u454"}, {"name": "レーヴ", "text": "……ええ、勿論です！　敬慕するだけでなく、\nこれから、しっかりと努力をしていきますからね！\nそれでは次の記憶へと参りましょう、王子。", "face": "u454"}]}], "active": true}