140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 48}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1140, "attack": 238, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 3, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 3800, "attack": 361, "base_hp": 4000, "base_attack": 380, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "master_id": 20012, "global_id": 1087, "spawn_sec": 92}], "dialogue": [{"trigger": "start", "lines": [{"name": "気弱そうな魔物", "text": "ギャギャーッ！", "face": "l922795fc37b5"}, {"name": "アンナ", "text": "……魔物！", "face": "l2d04745ddd90"}, {"name": "気弱そうな魔物", "text": "マッテ。\nオレタチ。ワルイマモノジャナイ。", "face": "l922795fc37b5"}, {"name": "気弱そうな魔物", "text": "ニンゲンニワルイコトシナイ。", "face": "l922795fc37b5"}, {"name": "気弱そうな魔物", "text": "ダカラ、イジメラレル。\nアカイノタクサンキテ……。\nスムトコロナクナッタ。タスケテ……。", "face": "l922795fc37b5"}, {"name": "アンナ", "text": "ええっ……！？\n魔物が人間に助けを求めるなんて……。", "face": "l2d04745ddd90"}, {"name": "アンナ", "text": "……分かりました。\nあなた方の目は澄んでいます。\n嘘偽りなど無いと信じましょう。", "face": "l2d04745ddd90"}, {"name": "アリサ", "text": "そうですね！\nこの方達はきっと悪い事はしないと思います。\n魔物にも争いを好まない方がいるんですね！", "face": "u24"}, {"name": "アリサ", "text": "例え魔物でも、平和を望む方たちならば\n私は治癒士としての仕事を全うします！", "face": "u24"}, {"name": "アンナ", "text": "王子、彼らの住処、取り戻すのを\nお手伝いしましょう。", "face": "l2d04745ddd90"}, {"name": "気弱そうな魔物", "text": "キュウセイシュ！", "face": "l922795fc37b5"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "これでもう大丈夫です。\n家に帰れますよ。", "face": "l2d04745ddd90"}, {"name": "気弱そうな魔物", "text": "アリガトウ。\nイエ。カエレル。", "face": "l922795fc37b5"}, {"name": "気弱そうな魔物", "text": "オマエ。ヤサシイヒト。", "face": "l922795fc37b5"}, {"name": "アンナ", "text": "いいえ、お気になさらず。\nこれからも気を付けてくださいね。", "face": "l2d04745ddd90"}, {"name": "気弱そうな魔物", "text": "ソウスル。オレイ。イツカ。\nゴチソウ。ゴチソウ。", "face": "l922795fc37b5"}, {"name": "アンナ", "text": "……いえ、お礼には及びません。\nあなた達が安心して暮らせるなら、\n私達はそれで充分なのですから。", "face": "l2d04745ddd90"}, {"name": "気弱そうな魔物", "text": "ケンキョ……！", "face": "l922795fc37b5"}, {"name": "アンナ", "text": "まさか、魔物の中にあの様な方々がいたとは。\nいままでに出会った事がありません。\n魔物も住処を奪われた辛さは人と同じなのですね。", "face": "l2d04745ddd90"}, {"name": "アンナ", "text": "とにかく彼らが住処を取り戻せて良かったです。\nそれでは、先を急ぎましょう。", "face": "l2d04745ddd90"}]}], "story_talk": true, "active": true}