"source": "local", "count": 10, "form_count": 2, "tags": ["アンデッド"], "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111856, "race_id": 8, "special_effect_id": 233, "change_to": 4, "change_condition": 3, "master_id": 30626, "global_id": 4245, "to_condition": 3, "to_global_id": 4246, "spawn_sec": 7}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 400, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111872, "race_id": 8, "special_effect_id": 233, "master_id": 30627, "global_id": 4246, "from_condition": 3}, {"enemy_id": 6, "source": "local", "count": 11, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 51}, {"enemy_id": 7, "source": "local", "count": 7, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111632, "race_id": 11, "special_effect_id": 233, "master_id": 30613, "global_id": 4232, "spawn_sec": 83}, {"enemy_id": 8, "source": "local", "count": 18, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 96}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 32000, "attack": 900, "base_hp": 32000, "base_attack": 900, "damage_type": "magical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 360, "master_id": 31671, "global_id": 5290, "spawn_sec": 100}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157, "spawn_sec": 131}], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴィンセント", "text": "欠片持ちの交じったアンデッドの群れに、\n空飛ぶヴァンパイアベヒモスか。\n状況は考えうる限り最悪の形だな……。", "face": "u103"}, {"name": "ヒューナ", "text": "空を飛ばれたらバリケードも無意味、\nそれにあの巨大な爪見た？\n接近戦は挑まない方がいいかもね……。", "face": "u627"}, {"name": "フーリ", "text": "……さらに雲行きまで怪しくなってきましたよ。\n『闇夜』のヴァンパイアベヒモスとか、\n本当に最悪の状況そのものですよねぇ……。", "face": "u174"}, {"name": "エデン", "text": "で、でも、やるしかないよね。\n大丈夫、王子がいるんだから負けないよ。\nね、王子、エストリエちゃん！", "face": "u239"}, {"name": "エストリエ", "text": "……う、うん。", "face": "u791"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "兵士", "text": "――伝令！　伝令です！！\n王子、街の反対側からも\nアンデッドの軍勢が侵攻してきました！", "face": "u6"}, {"name": "ケイティ", "text": "悪いことは重なるもの、ですか。\n王子、致し方ありません。\n反対側の迎撃に人員を割いて――", "face": "u114"}, {"name": "エストリエ", "text": "――わ、私が、私が行くわ！", "face": "u791"}, {"name": "エデン", "text": "エストリエちゃん！？\nで、でもエストリエちゃんの剣は\nひびだらけのままなのに……！", "face": "u239"}, {"name": "エストリエ", "text": "エデンちゃん、これはあくまで\nパパの『魔剣』の欠片を取り戻すためよ。", "face": "u791"}, {"name": "エストリエ", "text": "ここで王子に倒れられちゃ困るもの。\nそれに私は誇り高きヴァンパイアの氏族、\n強硬派の……だ、代表なんだからっ！！", "face": "u791"}, {"name": "エストリエ", "text": "餌の人間を守ってやるのも、\nた、たまにはいいでしょ……！？", "face": "u791"}, {"name": "エデン", "text": "エストリエちゃん……。\nうん、わかった。一緒にがんばろ！", "face": "u239"}, {"name": "エストリエ", "text": "王子、こんな所で死なないでね。\n私はあなたのこと、許すつもりないんだから！\nちゃんと生き残って私に謝りなさい！", "face": "u791"}, {"name": "王子", "text": "…………！（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "ルマリア", "text": "――ヴァンパイアベヒモスの沈黙を確認。\n今度こそ、倒せたみたいですね。", "face": "u343"}, {"name": "ヒューナ", "text": "公爵の軍勢も、第三波は無さそうね。\n街の被害も最小限で済んだし、\nようやく一段落ってところかしら。", "face": "u627"}, {"name": "エストリエ", "text": "……ふう、戻ったわ。\nそっちも無事みたいね。", "face": "u791"}, {"name": "ヴィンセント", "text": "街の反対側の軍勢も、制圧完了だ。\n『魔剣』の欠片も\nだいぶ集まってきたんじゃないか？", "face": "u103"}, {"name": "エストリエ", "text": "……そうね、力が戻ってきてるのを感じるわ。\nところでエデンちゃん、\nさっき何か言いかけてなかった？", "face": "u791"}, {"name": "エデン", "text": "うん、あのねエストリエちゃん、\nエストリエちゃんも、私と一緒に王国に来たらどう？\nって、訊こうとしてたの。", "face": "u239"}, {"name": "エストリエ", "text": "それって、人間の味方になれってことよね？\nパパの仇に、吸血鬼狩人に、\n共存派氏族までいる国に行くなんてありえないわ。", "face": "u791"}, {"name": "ヴィンセント", "text": "そう言うとは思っていた。\nだが、強硬派氏族の当主として、\n同盟関係を結ぶとなればどうだ？", "face": "u103"}, {"name": "ラキュア", "text": "其方にも公爵への恨みがあろう。\nなれば王国、共存派、そこの吸血鬼狩人達と、\n一時休戦の協定を結んではどうかということだ。", "face": "u344"}, {"name": "サリス", "text": "なるほど、名案です。\n公爵率いる支配派氏族を打倒するまで、\n氏族の代表たるエストリエさんと手を結ぶと！", "face": "u605"}, {"name": "エストリエ", "text": "……呆れた。\n私を口先だけで丸め込めると思っているの？", "face": "u791"}, {"name": "エデン", "text": "…………エストリエちゃん。", "face": "u239"}, {"name": "エストリエ", "text": "――でも！　気が変わったわ。\nエデンちゃんを泣かせるわけにはいかないし、\nその同盟に加わってあげても良いわよ。", "face": "u791"}, {"name": "王子", "text": "…………！", "face": "u1"}, {"name": "エストリエ", "text": "何であなたが嬉しそうなのよ！\n許すとは言ってないわよ！", "face": "u791"}, {"name": "アンナ", "text": "頼れる仲間――いえ、同盟氏族になりそうですね。\nそれでは王子、此度の戦い、お疲れ様でした！"}]}, {"trigger": "end", "lines": [{"name": "公爵", "text": "――ヴァンパイアベヒモスを倒すのは想定内か。\n神獣ベヒモスを討伐した者達なれば、\nこれも当然の帰結といえよう……。", "face": "l07e82912f61c"}, {"name": "公爵", "text": "さて、更なる戦力が必要だな……。\n目障りな王子共を、\n叩き潰す日はそう遠くない……。", "face": "l07e82912f61c"}]}], "active": true}