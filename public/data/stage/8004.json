{"quest_id": 8004, "name": "黒衣の銃士と保安官", "description": "酒場を出た王子たちは決闘の現場に遭遇。\n様子をうかがっているとこちらに気づいた\n彼女たちが標的を変更し勝負を挑んでくる！\n神級（★１獲得の目安：平均Lv50）", "event": "ガンスリングフロンティア", "event_category": "History", "mission_id": 920199, "map_no": 7120, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 73000, "attack": 900, "base_hp": 73000, "base_attack": 900, "damage_type": "physical", "armor_defense": 120, "attack_range": 280, "attack_speed": 90, "attack_wait": 80, "attack_interval": 189, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2145232, "race_id": 16, "special_effect_id": 1414, "missile_id": 26, "master_id": 36285, "global_id": 9902, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 61000, "attack": 720, "base_hp": 61000, "base_attack": 720, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 267, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145248, "race_id": 16, "special_effect_id": 1415, "change_to": 2, "change_condition": 1, "missile_id": 723, "missile": {"speed": 12.0, "splash": 187}, "master_id": 36286, "global_id": 9903, "ranged": true, "variants": [{"hp": 61000, "attack": 1400, "base_hp": 61000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 40, "attack_interval": 207, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145264, "race_id": 16, "special_effect_id": 220, "master_id": 36287, "global_id": 9904}]}, {"enemy_id": 4, "source": "local", "count": 29, "form_count": 1, "tags": ["植物"], "hp": 3000, "attack": 100, "base_hp": 3000, "base_attack": 100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145184, "change_to": 4, "change_condition": 1, "master_id": 36282, "global_id": 9899, "variants": [{"tags": ["植物"], "hp": 3000, "attack": 100, "base_hp": 3000, "base_attack": 100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145200, "special_effect_id": 1416, "master_id": 36283, "global_id": 9900}], "spawn_sec": 79}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 220, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 80, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 237, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145136, "race_id": 16, "special_effect_id": 1415, "missile_id": 26, "master_id": 36279, "global_id": 9896, "ranged": true, "spawn_sec": 89}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 350, "base_hp": 12000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145152, "race_id": 16, "change_to": 7, "change_condition": 1, "master_id": 36280, "global_id": 9897, "variants": [{"hp": 12000, "attack": 350, "base_hp": 12000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145168, "race_id": 16, "special_effect_id": 1090, "master_id": 36281, "global_id": 9898}], "spawn_sec": 107}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2145296, "race_id": 16, "change_to": 9, "change_condition": 1, "master_id": 36289, "global_id": 9906, "variants": [{"hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2145312, "race_id": 16, "special_effect_id": 1090, "master_id": 36290, "global_id": 9907}], "spawn_sec": 142}, {"enemy_id": 11, "source": "local", "count": 27, "form_count": 1, "hp": 7500, "attack": 500, "base_hp": 7500, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 237, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145280, "race_id": 16, "special_effect_id": 1415, "missile_id": 26, "master_id": 36288, "global_id": 9905, "ranged": true, "spawn_sec": 149}], "popups": ["皆殺しの凶銃の\n攻撃を受けた味方ユニットは\n2秒間、防御力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。", "保安官の近接攻撃を\n複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "大変な目に遭いましたね。\nおや？　あれは……。"}]}, {"trigger": "start", "lines": [{"name": "？？？", "text": "――さぁて。決闘だ、保安官殿。", "face": "lc5a890fab8c1"}, {"name": "フォニア", "text": "……決闘でしょうか。\n黒衣の銃士と、保安官らしき人物が対峙していますね。", "face": "u548"}, {"name": "トネール", "text": "アイツは……「皆殺しの凶銃」か。", "face": "u1885a1"}, {"name": "アネリア", "text": "あら、知っている人なの？", "face": "u184"}, {"name": "トネール", "text": "ああ。この町で一番狂暴なオンナさ。", "face": "u1885a1"}, {"name": "皆殺しの凶銃", "text": "誰だァ。つけられた覚えのない\n物騒なあだ名でアタシを呼んだのは。", "face": "lc5a890fab8c1"}, {"name": "トネール", "text": "アタシだよ。\nそれよりアンタたちはここで何をしてるんだい？", "face": "u1885a1"}, {"name": "皆殺しの凶銃", "text": "見りゃあ分かるだろ？\n決闘だよ決闘。\n保安官殿となァ。", "face": "lc5a890fab8c1"}, {"name": "皆殺しの凶銃", "text": "で、お前らはなんだァ？\nアタシらは取り込み中……。", "face": "lc5a890fab8c1"}, {"name": "皆殺しの凶銃", "text": "……あ？\nもしやそこにおわすのは、\n王子様と王国軍かァ？", "face": "lc5a890fab8c1"}, {"name": "アンナ", "text": "えっ、は、はい。\nそうですが――", "face": "le9ef8695c4fb"}, {"name": "皆殺しの凶銃", "text": "おいおいマジか！\n強者と名高き王子様とこんな辺鄙な町で会えるとは！\n感謝申し上げるぜ、戦神マレス様よォ！", "face": "lc5a890fab8c1"}, {"name": "皆殺しの凶銃", "text": "何度貴殿らのところに乗り込んで仕合を願おうとしたか！\nまぁそんなことしたら牢屋にぶち込まれるだろうから\n実行には移せなかったがなァ！！", "face": "lc5a890fab8c1"}, {"name": "アネリア", "text": "くすっ。人気者ね、王子。\n彼女ったらあんなに目を輝かせて……。\n標的を貴方に変えたわよ。", "face": "u184"}, {"name": "皆殺しの凶銃", "text": "しけた決闘なんざ中止だ中止！\n保安官殿も王子様と戦いたいと仰ってるしなァ！", "face": "lc5a890fab8c1"}, {"name": "トネール", "text": "アイツら、満面の笑みで銃を抜いたねぇ。\n悪いけど王子サマ、相手してやってくれるかい。", "face": "u1885a1"}, {"name": "皆殺しの凶銃", "text": "かの王子様、そして王国軍と戦えるたァ光栄極まれり！\n勝手に胸を借りさせていただくぜェ！", "face": "lc5a890fab8c1"}]}, {"trigger": "end", "lines": [{"name": "皆殺しの凶銃", "text": "くっ、これで終わり……！？\nいや、まだだ！　まだ終わってねェ……ッ！\nもっともっと戦いてェ……！！", "face": "lc5a890fab8c1"}, {"name": "アネリア", "text": "だけど、保安官殿はもう終わりって言ってるわよ？", "face": "u184"}, {"name": "皆殺しの凶銃", "text": "ほどほどで抑えやがって……！", "face": "lc5a890fab8c1"}, {"name": "皆殺しの凶銃", "text": "だが保安官殿がそう仰るなら仕方がねェ。\n尊き御仁たちの時間をいただきすぎるのも悪いし、\nここらで銃を収めて大人しくすらァ。", "face": "lc5a890fab8c1"}, {"name": "フォニア", "text": "聞き分けがよくて助かりますね。\n……いえ、襲いかかってきたので、\n聞き分けがいいわけではありませんが。", "face": "u548"}, {"name": "皆殺しの凶銃", "text": "さてと。王子様と戦えていい気分だし、酒飲んで寝て……\nあっ。鉱山の連中、どうすっかなァ……。", "face": "lc5a890fab8c1"}, {"name": "アンナ", "text": "鉱山の連中、ですか……？", "face": "le9ef8695c4fb"}, {"name": "皆殺しの凶銃", "text": "ああ。戦神コロッセウムの参加者だとかいう、\n無法者の集まりだよ。", "face": "lc5a890fab8c1"}, {"name": "皆殺しの凶銃", "text": "勝手に鉱山に住み着いて、利益を独占してる……\nまぁ、この町の実質的な支配者みてぇなもんだ。", "face": "lc5a890fab8c1"}, {"name": "皆殺しの凶銃", "text": "ソイツらが鉱山を仕切ってるせいで、\n誰も採掘作業ができねェ。\nだからここの奴らは荒れてんのさ。", "face": "lc5a890fab8c1"}, {"name": "皆殺しの凶銃", "text": "で、いい加減邪魔なんで、\nアタシか保安官殿の勝ったほうが連中に挑む、\nってことで決闘しようとしてたんだよ。", "face": "lc5a890fab8c1"}, {"name": "プロエ", "text": "……丁度良かったかもしれないな。\n現在残っている戦士団は、王国の王子と、\n今しがた話に出てきた鉱山の無法者だけだ。", "face": "u1768a1"}, {"name": "トネール", "text": "決勝戦の相手が決まった、ってことかい？", "face": "u1885a1"}, {"name": "皆殺しの凶銃", "text": "貴殿ら、鉱山の奴らをぶっ倒してくれんのかァ？\nだったらアタシからもお願い致すぜェ！\n保安官殿も頼むと仰ってらァ！！", "face": "lc5a890fab8c1"}, {"name": "王子", "text": "……（こくり）", "face": "u1"}, {"name": "トネール", "text": "なら、行くとしようかね。\n――決勝戦へ。", "face": "u1885a1"}]}], "active": true}