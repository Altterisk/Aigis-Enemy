": 1200, "attack": 78, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 122}, {"enemy_id": 12, "source": "local", "count": 5, "form_count": 1, "hp": 2700, "attack": 78, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "夢の中のセブン", "text": "――シックス！　おい、聞いてんのかよ！\nどうしてナインを殺したんだ！\nアタシたち、仲間じゃなかったのかよ！！", "face": "u449"}, {"name": "夢の中のシックス", "text": "ふふ、仲間を思えばこそですよ、セブンさん。あのまま\n組織の事を話されては、皆が危険に晒されますからね。\nそれに、私のおかげで貴方だって逃げられたでしょう？", "face": "l67c71b433056"}, {"name": "セブン", "text": "――この場面は……。\nシックス！　あのヤロウ、ナインを殺しやがって……！", "face": "u1449"}, {"name": "レーヴ", "text": "お、落ち着いてください！\nこれは夢の中ですから！", "face": "u1454"}, {"name": "セブン", "text": "ナインを殺しておいて、\nあいつは闇の組織で幹部になってやがる。\n……ナインが浮かばれないよ、これじゃ。", "face": "u1449"}, {"name": "レーヴ", "text": "ナインさんの仇は、現実でとりましょう。\nそれにきっと、今のセブンさんが元気なら、\nナインさんも喜んでくれるはずですよ。", "face": "u1454"}, {"name": "セブン", "text": "どうだかな。\n……でも、この時の戦いは\nあまり思い出したくないな。", "face": "u1449"}, {"name": "セブン", "text": "初めて、人を殺そうとした時の戦いだから。", "face": "u1449"}, {"name": "夢の中のセブン", "text": "殺し、か……。そんなこと、本当はしたくないけど……。\nでも、やるしか……やるしか道はないんだよな。\n……生きるには、奪うしか……ないんだよな……？", "face": "u449"}, {"name": "夢の中のシックス", "text": "ええ、そうですとも、セブン。\n心配はいりません……私もお手伝いしますよ。\n貴方が初めて人を殺す、その大切な手伝いを、ね……フフ。", "face": "l67c71b433056"}, {"name": "セブン", "text": "くっ……やっぱり見てられない！\nおい！　そっちのセブン！\nアタシが相手になってやる！！", "face": "u1449"}, {"name": "セブン", "text": "お前の技術は、\n人を殺すために磨いたものじゃないだろ！！", "face": "u1449"}, {"name": "エイミー", "text": "わわっ、行っちゃいましたよ！？", "face": "u1414"}, {"name": "レーヴ", "text": "仕方ない……私も手助けしてきます！", "face": "u1454"}]}, {"trigger": "end", "lines": [{"name": "セブン", "text": "……そっか、そういえばこの時、\nアタシは王子の仲間になったんだよな。", "face": "u1449"}, {"name": "セブン", "text": "……王子を殺さなくて、本当に良かった。\nあの時、止めてくれて……本当に良かった……。", "face": "u1449"}, {"name": "レーヴ", "text": "セブンさん……。\nそうだ、目が覚めたら王子に会いに行きましょう！\nきっとお正月で暇してますから！", "face": "u1454"}, {"name": "セブン", "text": "ははっ、どうだか。\nきっと正月でも、何か面倒事を背負い込んでるよ。\nでも……挨拶くらいはしてやってもいいかな。", "face": "u1449"}, {"name": "エイミー", "text": "それでは新年初売りの装備品も持っていきましょう♪\nその後はみんなで新年会です♪", "face": "u1414"}, {"name": "レーヴ", "text": "そうしましょう！\nでは、皆さんの目を覚ましますよ。\n次に会うときは現実の王国で、です♪", "face": "u1454"}]}], "story_talk": true, "active": true}