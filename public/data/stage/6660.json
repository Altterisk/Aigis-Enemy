{"quest_id": 6660, "name": "新年花札争奪戦", "description": "東の国で正月を楽しむ王子たち。\n花札に興味を示した仲間に鬼刃姫が\nルールを説明したところ……？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ22(2018)", "event_category": "Reproduce", "mission_id": 300217, "map_no": 3462, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 3500, "attack": 100, "base_hp": 3500, "base_attack": 100, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 17, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110992, "race_id": 16, "master_id": 30410, "global_id": 4029, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 12, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 10}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 44}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 3200, "attack": 220, "base_hp": 3200, "base_attack": 220, "damage_type": "physical", "armor_defense": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 162, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 1, "spawn_sec": 48}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 180, "magic_defense": 10, "attack_speed": 55, "attack_wait": 10, "attack_interval": 157, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100480, "race_id": 16, "master_id": 247, "global_id": 246, "spawn_sec": 69}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 4600, "attack": 180, "base_hp": 4600, "base_attack": 180, "damage_type": "physical", "armor_defense": 50, "attack_speed": 30, "attack_wait": 10, "attack_interval": 81, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112368, "race_id": 16, "master_id": 31225, "global_id": 4844, "spawn_sec": 85}, {"enemy_id": 7, "source": "local", "count": 5, "form_count": 1, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 97}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 180, "magic_defense": 10, "attack_speed": 55, "attack_wait": 10, "attack_interval": 157, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100496, "race_id": 16, "master_id": 248, "global_id": 247, "spawn_sec": 112}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 350, "base_hp": 7000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108544, "race_id": 16, "special_effect_id": 54, "master_id": 30129, "global_id": 3748, "spawn_sec": 123}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30717, "global_id": 4336, "ranged": true, "spawn_sec": 125}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 40, "attack_wait": 30, "attack_interval": 133, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102272, "race_id": 16, "master_id": 369, "global_id": 368, "spawn_sec": 128}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_range": 30, "attack_speed": 35, "attack_wait": 50, "attack_interval": 136, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099088, "special_effect_id": 240, "missile_id": 45, "master_id": 20059, "global_id": 1134, "ranged": true, "spawn_sec": 155}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "東の国の都も、だいぶ復興が進みましたね。"}, {"name": "鬼刃姫", "text": "新年を楽しく祝えるのも、\n王国の皆のおかげだよ。本当にありがとね。\n……こんな、皆で遊べるような平穏な日が来るなんてね。", "face": "u730"}, {"name": "イーリス", "text": "遊び、ですか？\n鬼刃姫さんがその手に持っている御札って、\n遊びに使うカードなのですか？", "face": "u575"}, {"name": "バシラ", "text": "私も気になってました！\n猪に鹿に……。\n綺麗な絵が描かれていて、素敵ですよねぇ。", "face": "u28"}, {"name": "鬼刃姫", "text": "ああ、これは花札っていう遊びに使う札だよ。\n東の国ではとっても有名な札でね、\nあても時々遊ぶんだぁ。", "face": "u730"}, {"name": "フィリス", "text": "――はなふだ？\nいったい、どんな遊びなんだ？", "face": "u40"}, {"name": "鬼刃姫", "text": "えっとね、この色々な絵柄の札を取り合って、\n相手よりもたくさんの札をとった人が勝ちっていう――", "face": "u730"}, {"name": "シプリア", "text": "へぇ、札をたくさん奪えば勝ちか。\nそれなら、私たちが有利かな？", "face": "u51"}, {"name": "鬼刃姫", "text": "えっ？　えっと、盗むとかじゃなくて――", "face": "u730"}, {"name": "モーティマ", "text": "おうおう、略奪ってのは小手先の技じゃなくて、\n腕っぷしで正面からやるもんだぜ？\n俺達、山賊の腕っぷしをよーく見てやがれ！", "face": "u14"}, {"name": "テティス", "text": "そうですね、許されぬ相手との愛、\n略奪、駆け落ち、そういうのも素敵ですよね！", "face": "u37"}, {"name": "セブン", "text": "それは何だか違う気がするけど……。\n盗みの技術を競う競技っていうなら相手になるよ。", "face": "u449"}, {"name": "エデン", "text": "えっ？　皆で遊ぶの？\nまぜてまぜてー？", "face": "u239"}, {"name": "シプリア", "text": "よし、じゃあ全員で花札だな。\n鬼刃姫、もちろん相手をしてくれるよな？", "face": "u51"}, {"name": "鬼刃姫", "text": "え、えぇっ！？　花札はそういう遊びじゃなくてぇ！\nお、王子ぃ！　た、助けてぇ……！？", "face": "u730"}, {"name": "アンナ", "text": "……皆さん、何か誤解しているようですね。\n王子、鬼刃姫さんを守りつつ、\n皆さんの頭を冷やすとしましょうか。", "face": "lab0e64136ede"}]}, {"trigger": "end", "lines": [{"name": "鬼刃姫", "text": "もう、皆！\n話はちゃんと最後まできかなきゃ、めっ、なんだから！", "face": "u730"}, {"name": "フィリス", "text": "カードを使って取り合いをするゲームなんだな。\nいやぁ、てっきりカードを\n直接奪い合うゲームだとばかり……。", "face": "u40"}, {"name": "モーティマ", "text": "でもいい腹ごなしの運動になったぜ。", "face": "u14"}, {"name": "シプリア", "text": "まったくだ。これならもう一杯くらい、\nぜんざいとやらを食べておいても良かったな……。", "face": "u51"}, {"name": "バシラ", "text": "あ、それならもう一軒行きます？\n甘い物ならいくらでも食べられますし！\nもちろん鬼刃姫さんもご一緒に♪", "face": "u28"}, {"name": "鬼刃姫", "text": "えっ？　ほんと？\nもちろん行く行く。あても行くよー！\nほら、王子も一緒に行こう？", "face": "u730"}, {"name": "アンナ", "text": "……食べ過ぎも、羽目を外すのも、\n程々にしてくださいね？"}]}], "active": true}