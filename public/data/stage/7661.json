ssin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 53}, {"enemy_id": 8, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 11000, "attack": 800, "base_hp": 11000, "base_attack": 800, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 387, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117104, "race_id": 4, "missile_id": 167, "master_id": 31468, "global_id": 5087, "ranged": true, "spawn_sec": 75}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["機械", "置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 32000, "attack": 1050, "base_hp": 32000, "base_attack": 1050, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2126672, "race_id": 16, "special_effect_id": 663, "master_id": 35055, "global_id": 8672, "spawn_sec": 185}], "dialogue": [{"trigger": "start", "lines": [{"name": "リアナ", "text": "ずいぶんと奥まで来ましたが、見つかりませんね……。", "face": "u1540a1"}, {"name": "スキュレ", "text": "子供たちは何処まで行ったのよぉ……\n王子、絶対に手を離したら駄目だからね？", "face": "u1539a1"}, {"name": "河童", "text": "──ニンゲン、タチサレ。", "face": "lc3cdb546668d"}, {"name": "スキュレ", "text": "また河童！？", "face": "u1539a1"}, {"name": "河童", "text": "モシ、タチサラナイノナラ──", "face": "lc3cdb546668d"}, {"name": "ガマガエル", "text": "──俺様が相手になってやるぜぇ！！", "face": "l6bf31d2f9e45"}, {"name": "ラミィ", "text": "……力士？", "face": "u858"}, {"name": "フーコ", "text": "おすもうさんだ……。", "face": "u857"}, {"name": "スキュレ", "text": "あれが……例の怪物なのかしら？\nあんまり怖い見た目じゃないのね。", "face": "u1539a1"}, {"name": "ガマガエル", "text": "これだから海産物はよォ！？", "face": "l6bf31d2f9e45"}, {"name": "スキュレ", "text": "ひいっ！？", "face": "u1539a1"}, {"name": "ガマガエル", "text": "サメか？　カニか？\n海水育ちがそんなに偉ェのか！？\n淡水育ちは怖くねぇってか！", "face": "l6bf31d2f9e45"}, {"name": "スキュレ", "text": "わ、私そんなつもりじゃ……。", "face": "u1539a1"}, {"name": "ガマガエル", "text": "テメェら海産物はいつもそうだ！\n海の中だけで全てを知った気になって、\n河川や湖に棲む俺様たちを見下しやがる！", "face": "l6bf31d2f9e45"}, {"name": "ガマガエル", "text": "井の中の狭さも知らねぇ奴らに、\n俺様の油を渡すわけにゃあいかねぇ！\n行くぜブラザー！　立合いだァ！", "face": "l6bf31d2f9e45"}, {"name": "河童", "text": "イエッサー！", "face": "lc3cdb546668d"}, {"name": "リアナ", "text": "待ってください！　何か誤解が──", "face": "u1540a1"}, {"name": "ガマガエル", "text": "はっけよーーーーい！！！！", "face": "l6bf31d2f9e45"}]}, {"trigger": "battle", "at_sec": 183, "lines": [{"name": "ガマガエル", "text": "ぶべらっ！？", "face": "l6bf31d2f9e45"}, {"name": "ラミィ", "text": "決まり手は日傘での殴打！\n日傘での殴打でスキュレの勝ち！", "face": "u858"}, {"name": "スキュレ", "text": "えっと、思わず殴っちゃったけど、\nい、今のは殴って良いやつだった？", "face": "u1539a1"}, {"name": "ガマガエル", "text": "くそぉ……俺様が海産物なんぞにやられるなんて！", "face": "l6bf31d2f9e45"}, {"name": "スキュレ", "text": "失礼ね。元はれっきとした人間よ、一応ね。", "face": "u1539a1"}, {"name": "スキュレ", "text": "さあ、早く子供たちを返しなさい。", "face": "u1539a1"}, {"name": "ガマガエル", "text": "ああ？　何の話だ？", "face": "l6bf31d2f9e45"}, {"name": "スキュレ", "text": "え……だって貴方たちが、\n人間を攫う怪物じゃないの？", "face": "u1539a1"}, {"name": "ガマガエル", "text": "お前らこそ、俺様の油を狙う人間じゃないのか？", "face": "l6bf31d2f9e45"}, {"name": "スキュレ", "text": "……なんで油？", "face": "u1539a1"}, {"name": "リアナ", "text": "ガマガエルの油は古来より、\n傷薬として重宝されているんです。\n長く生きた個体の油ほど効果が高いとか。", "face": "u1540a1"}, {"name": "ガマガエル", "text": "俺様は俺様の油を搾取しようとする、\nクソみてぇな人間たちから逃げ出して、\n最近この森に移住して来たわけだが……。", "face": "l6bf31d2f9e45"}, {"name": "リアナ", "text": "私たちは子供たちが行方不明と聞いて、\nこの森に救助にやって来たのですが……。", "face": "u1540a1"}, {"name": "ガマガエル", "text": "河童が森の入り口辺りで脅かしゃあ、\n大抵の人間はすぐに尻尾巻いて村に逃げ帰る。\nガキなんて尚更だろ、俺様は見てねぇぞ。", "face": "l6bf31d2f9e45"}, {"name": "スキュレ", "text": "え……じゃあ、どういうこと？", "face": "u1539a1"}]}, {"trigger": "end", "lines": [{"name": "絡繰り忍者", "text": "（ふむ……先客がいたでござるか）", "face": "lb3745db2dc66"}]}], "map": {"image": "Map920180_4133", "w": 960, "h": 640, "spots": [{"k": "b", "x": 954, "y": 332}, {"k": "m", "x"