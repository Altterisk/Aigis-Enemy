, "magic_defense": 20, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 242, "change_to": 19, "master_id": 34071, "global_id": 7688, "to_condition": 0, "to_global_id": 7689, "route_behaviour": {"hold": {"routes": 5, "held": 5}, "reroutes": ["Route=999"]}, "spawn_sec": 75}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "master_id": 34072, "global_id": 7689, "from_condition": 0, "to_condition": 0, "to_global_id": 4703}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 296, "master_id": 31084, "global_id": 4703, "from_condition": 0}], "popups": ["黒炎のセグナンドは、\n特定の地点に到達すると\n攻撃と同時に周囲のマスを\n一気に占領します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ルーテ", "text": "――ダークエルフの部隊が、砂浜に上陸します！", "face": "u529"}, {"name": "レオナ", "text": "さて……セグナンドはどう出るか……。\nあの男が、まさか後ろで\n震えているということはあるまい。", "face": "u311"}, {"name": "ヘカティエ", "text": "そうね……相手はただのダークエルフではない、\n冥界と手を結んだ連中よ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "ハイドース様の力のひとかけらくらい、\n授かっていると考えた方がいいわね。\n例えば……そう、黒き炎とか、ね？", "face": "u1226a1"}, {"name": "セグナンド", "text": "――我が同胞たちよ、魔界の連中とは違う、\n物質界に生きる強きダークエルフの同胞たちよ！", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "反撃の時は来た。\nこの戦いこそ、最初に灯される正義の炎だ。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "これより先、我らと志を同じくする、\n数多の戦士たちが同じ道を駆け抜けることとなる。", "face": "l20ac59a2a223"}, {"name": "ダークエルフ", "text": "おぉ……セグナンド様……！", "face": "l0e68ae181da5"}, {"name": "セグナンド", "text": "剣を取れ、ダークエルフたちよ！\n父祖の誇りを！　我らの怒りを！\n帝国に突き立ててやるのだ！！", "face": "l20ac59a2a223"}, {"name": "ダークエルフ", "text": "こ、この黒炎は……まさか亜神ハイドース様の……？", "face": "l0e68ae181da5"}, {"name": "セグナンド", "text": "然り。これなる黒炎は、盟友ハイドースとの同盟の証。\n周囲一帯を焼き払う、我らが怒りの炎だ。", "face": "l20ac59a2a223"}, {"name": "ヘカティエ", "text": "なっ……あれは……本当に冥界の黒炎！？", "face": "u1226a1"}, {"name": "レーヴ", "text": "神話以前の物語に謳われる、\n冥界のハイドースが操るという炎……ですか！？", "face": "u454"}, {"name": "ヘカティエ", "text": "あんなので焼き払われたら、\n簡単に陣地を占拠されちゃうわ。\nセグナンドを放置するのは危険よ！", "face": "u1226a1"}, {"name": "セグナンド", "text": "さぁ、行くぞ同胞たちよ。\n――我らの反逆を見せてやれ。", "face": "l20ac59a2a223"}]}, {"trigger": "end", "lines": [{"name": "セグナンド", "text": "ちっ……もう時間、か。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "兵を退け、これだけ時間を稼げば、\n俺たちの目的は達成された。", "face": "l20ac59a2a223"}, {"name": "ダークエルフ", "text": "はっ！　セグナンド様！\n部隊ごとに撤退しろ！　隊列を乱すな！", "face": "l0e68ae181da5"}, {"name": "レオナ", "text": "時間を、稼いだだと……？", "face": "u311"}, {"name": "レオナ", "text": "艦隊を陽動に、ダークエルフがさらに時間を……。\nまさか、次の手があるというのか？", "face": "u311"}, {"name": "カテリナ", "text": "……ねぇマルゴット。\nどうしても陥としたい都市があったら、\nマルゴットならどうする？", "face": "u1344a1"}, {"name": "マルゴット", "text": "どうしたんですか急に。\nそうですね……私なら、\n多方面からの揺さぶりをかけますね。", "face": "u1343a1"}, {"name": "マルゴット", "text": "例えばこの港街なら……。\n海上からの強襲と、森からの挟撃でしょうか。", "face": "u1343a1"}, {"name": "カテリナ", "text": "さすがは教導隊長。\nやり口がやらしー。", "face": "u1344a1"}, {"name": "マルゴット", "text": "やらしくありません！\n……あっ、さらに万全を期すなら、\n空からの戦力も考慮にいれますね。", "face": "u1343a1"}, {"name": "カテリナ", "text": "うんうん、だよねー。\nでも、雲ひとつないこの空に、\n何かが飛んでいる気配はないっと……。", "face": "u1344a1"}, {"name": "マルゴット", "text": "……まさかカテリナさん、\nダークエルフの襲撃すら陽動に使った、敵の作戦は――", "face": "u1343a1"}, {"name": "カテリナ", "text": "うん、私の予想が正しければ――", "face": "u1344a1"}, {"name": "カテリナ", "text": "陛下！　王子！\n警戒すべきは地面の下だよー！！", "face": "u1344a1"}, {"name": "王子", "text": "…………っ！！", "face": "u1"}]}, {"trigger": "route", "lines": [{"name": "セグナンド", "text": "これなるは、我らが怒り、父祖の怒り、\n虐げられし者たちの声なき怒り。", "face": "l20ac59a2a223"}, {"name": "白の皇帝", "text": "……力に酔ったか、ダークエルフの長め。", "face": "u418"}, {"name": "セグナンド", "text": "よく吠えるッ！！\n貴様こそ、力に頼り、力に溺れた俗物だ！", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "何が民のためだ、何が世界の平定だ。\n貴様が見ているものは、そんなものではないだろう！", "face": "l20ac59a2a223"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "セグナンド", "text": "吼えよ黒炎、穢れし者どもを焼き尽くせッ！！", "face": "l20ac59a2a223"}]}], "active": true}