5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 152}], "popups": ["ぬらりひょんがいる間は\n全ての妖怪の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ぬらりひょん", "text": "ヒョッヒョッ。善哉善哉。\nこの地にこれほど多くの妖怪がいたとはのぉ。\nおかげで新たな仲間を配下にできたわい。", "face": "lc2e09f22f03b"}, {"name": "ぬらりひょん", "text": "他国の妖怪どもが活気付いてるようじゃが、\nこれならば十全な備えとなろう……ヒョッヒョッ。\n妖怪の総大将たるわしのメンツもこれで保てよう。", "face": "lc2e09f22f03b"}, {"name": "ぬらりひょん", "text": "……む？\n向こうから何者かがやってくるようじゃのぉ。\n……なるほど人間か。これは丁度良い機会じゃ。", "face": "lc2e09f22f03b"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、このあたりで\n妖怪が出没しているとの噂ですが、\nどうにも見当たりませんね……。", "face": "l68d23b557d5d"}, {"name": "ぬらりひょん", "text": "――何をきょろきょろしておる人間ども。\nわしを探しておるのかな？", "face": "lc2e09f22f03b"}, {"name": "イロハ", "text": "お、お前は……妖怪総大将ぬらりひょん！？\nなぜこんなところに……！", "face": "u242"}, {"name": "ぬらりひょん", "text": "ヒョッヒョッ……貴様らも運がないのぉ。\nわしの新たな仲間たちの\n腕試しによって命を失うのじゃからなぁ！", "face": "lc2e09f22f03b"}, {"name": "アンナ", "text": "王子、妖怪たちが向かってきました……！\n急ぎ戦いの準備をお願い致します。", "face": "l68d23b557d5d"}]}, {"trigger": "end", "lines": [{"name": "ぬらりひょん", "text": "し、信じられん……。\n新たに仲間にした妖怪たちが\n全員やられてしまうとは……！？", "face": "l4fc1e6f49939"}, {"name": "ぬらりひょん", "text": "おんのれぇ……っ。貴様らぁ！\nわしの苦労を水の泡にしよって……。\nいつか必ず目にものをみせてやるわぃ！", "face": "lc2e09f22f03b"}, {"name": "カズハ", "text": "……どうやら、\nぬらりひょんは退いてくれたようですね。", "face": "u235"}, {"name": "イロハ", "text": "妖怪総大将を相手に\nこの程度で済んで良かった……。\n王子、お怪我はありませんか？", "face": "u242"}, {"name": "カズハ", "text": "ふふ、安心してくださいイロハさん。\n王子はこの通り無傷ですよ。\n……ですが、ぬらりひょんの動きが気になりますね。", "face": "u235"}, {"name": "イロハ", "text": "はい……。\n手下になりそうな妖怪を探していたようですし、\nより強大な力を手に入れようと画策するはずです。", "face": "u242"}, {"name": "カズハ", "text": "……何か対策が必要かも知れませんね。\n王子をお護りする為にも、引き続き\n妖怪たちの動向を警戒するとしましょう。", "face": "u235"}]}], "map": {"image": "Map920071_3718", "w": 960, "h": 640, "spots": [{"k": "b", "x": 937, "y": 429}, {"k": "m", "x": 123, "y": 344, "id": 200}, {"k": "m", "x": 778, "y": 212, "id": 201}, {"k": "m", "x": 533, "y": 351, "id": 202}, {"k": "m", "x": 484, "y": 184, "id": 203}, {"k": "m", "x": 552, "y": 136, "id": 204}, {"k": "m", "x": 638, "y": 119, "id": 205}, {"k": "m", "x": 728, "y": 148, "id": 206}, {"k": "m", "x": 622, "y": 362, "id": 207}, {"k": "m", "x": 712, "y": 340, "id": 208}, {"k": "m", "x": 772, "y": 287, "id": 209}, {"k": "m", "x": 458, "y": 409, "id": 210}, {"k": "m", "x": 373, "y": 461, "id": 211}, {"k": "m", "x": 268, "y": 464, "id": 212}, {"k": "m", "x": 179, "y": 418, "id": 213}, {"k": "m", "x": 140, "y": 256, "id": 214}, {"k": "m", "x": 191, "y": 178, "id": 215}, {"k": "m", "x": 285, "y": 140, "id": 216}, {"k": "m", "x": 386, "y": 157, "id": 217}, {"k": "m", "x": 823, "y": 156, "id": 218}, {"k": "m", "x": 905, "y": 150, "id": 219}, {"k": "m", "x": 888, "y": 233, "id": 220}, {"k": "m", "x": 860, "y": 311, "id": 221}, {"k": "m", "x": 43, "y": 303, "id": 222}, {"k": "m", "x": 508, "y": 270, "id": 223}, {"k": "r", "x": 690, "y": 399, "id": 300}, {"k": "r", "x": 830, "y": 245, "id": 301}, {"k": "r", "x": 835, "y": 407, "id": 302}, {"k": "r", "x": 756, "y": 113, "id": 303}, {"k": "r", "x": 468, "y": 142, "id": 304}, {"k": "r", "x": 129, "y": 434, "id": 305}, {"k": "r", "x": 91, "y": 263, "id": 306}, {"k": "r", "x": 148, "y": 160, "id": 307}]}, "start_cost": 10, "active": true, "name_en": "Yokai Supreme Commander's Grand Adventure", "description_en": "The Yokai Supreme Commander Nurarihyon appears to recruit new yokai.\n\nAdvanced (★1 target: average Lv10)"}