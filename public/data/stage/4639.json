t": 1, "transform_resist": 100, "pattern_id": 2103312, "race_id": 4, "special_effect_id": 567, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 440, "global_id": 439, "ranged": true, "spawn_sec": 65}, {"enemy_id": 6, "source": "local", "count": 36, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 90}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 107}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 123}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 152}], "popups": ["ぬらりひょんがいる間は\n全ての妖怪の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ぬらりひょん", "text": "ヒョッヒョッ。善哉善哉。\nこの地にこれほど多くの妖怪がいたとはのぉ。\nおかげで新たな仲間を配下にできたわい。", "face": "lc2e09f22f03b"}, {"name": "ぬらりひょん", "text": "他国の妖怪どもが活気付いてるようじゃが、\nこれならば十全な備えとなろう……ヒョッヒョッ。\n妖怪の総大将たるわしのメンツもこれで保てよう。", "face": "lc2e09f22f03b"}, {"name": "ぬらりひょん", "text": "……む？\n向こうから何者かがやってくるようじゃのぉ。\n……なるほど人間か。これは丁度良い機会じゃ。", "face": "lc2e09f22f03b"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、このあたりで\n妖怪が出没しているとの噂ですが、\nどうにも見当たりませんね……。", "face": "l2e51ace5ef66"}, {"name": "ぬらりひょん", "text": "――何をきょろきょろしておる人間ども。\nわしを探しておるのかな？", "face": "lc2e09f22f03b"}, {"name": "イロハ", "text": "お、お前は……妖怪総大将ぬらりひょん！？\nなぜこんなところに……！", "face": "u242"}, {"name": "ぬらりひょん", "text": "ヒョッヒョッ……貴様らも運がないのぉ。\nわしの新たな仲間たちの\n腕試しによって命を失うのじゃからなぁ！", "face": "lc2e09f22f03b"}, {"name": "アンナ", "text": "王子、妖怪たちが向かってきました……！\n急ぎ戦いの準備をお願い致します。", "face": "l2e51ace5ef66"}]}, {"trigger": "end", "lines": [{"name": "ぬらりひょん", "text": "し、信じられん……。\n新たに仲間にした妖怪たちが\n全員やられてしまうとは……！？", "face": "l4fc1e6f49939"}, {"name": "ぬらりひょん", "text": "おんのれぇ……っ。貴様らぁ！\nわしの苦労を水の泡にしよって……。\nいつか必ず目にものをみせてやるわぃ！", "face": "lc2e09f22f03b"}, {"name": "カズハ", "text": "……どうやら、\nぬらりひょんは退いてくれたようですね。", "face": "u235"}, {"name": "イロハ", "text": "妖怪総大将を相手に\nこの程度で済んで良かった……。\n王子、お怪我はありませんか？", "face": "u242"}, {"name": "カズハ", "text": "ふふ、安心してくださいイロハさん。\n王子はこの通り無傷ですよ。\n……ですが、ぬらりひょんの動きが気になりますね。", "face": "u235"}, {"name": "イロハ", "text": "はい……。\n手下になりそうな妖怪を探していたようですし、\nより強大な力を手に入れようと画策するはずです。", "face": "u242"}, {"name": "カズハ", "text": "……何か対策が必要かも知れませんね。\n王子をお護りする為にも、引き続き\n妖怪たちの動向を警戒するとしましょう。", "face": "u235"}]}], "active": true}