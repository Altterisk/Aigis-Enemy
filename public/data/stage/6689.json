90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 14, "master_id": 30345, "global_id": 3964, "to_global_id": 3965, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 117}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 13, "master_id": 30346, "global_id": 3965}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 13, "master_id": 30346, "global_id": 3965, "to_global_id": 3964, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 162}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 14, "master_id": 30345, "global_id": 3964}], "dialogue": [{"trigger": "start", "lines": [{"name": "ミゲル", "text": "急げ王子の兄貴！\nマーマン達にゴブリンも合流してやがるぞ！", "face": "u369"}, {"name": "ゴブリン", "text": "ギャギャ！　チョコレート！　ウバウ！\nバレンタイン！　シュウリョウ！", "face": "l9e581573e670"}, {"name": "マーマン", "text": "そうだ者ども、チョコレートを根こそぎ奪い取れ！\n全てのチョコレートを我らが女王様に！！", "face": "l0f52cd911980"}, {"name": "リーフ", "text": "あぁっ、ここでも魔物達がチョコを奪ってます！\nこっ、こらぁ！　チョコを返してください～！！", "face": "u747"}, {"name": "ゴブリン", "text": "ギャギャッ！？　チョコ！　ワタサナイ！\nバレンタイン！　ハカイスル！！", "face": "l9e581573e670"}, {"name": "マーマン", "text": "むっ、貴様もチョコを持っているな？\nそれは我らが女王様の物だッ！\nゴブリンよ、チョコを奪い取ってやれ！！", "face": "l0f52cd911980"}, {"name": "リーフ", "text": "きゃっ、やぁっ、やめてくださいぃ！？\nそれはボクのチョコっ、あっ、こらぁ！！", "face": "u747"}, {"name": "ソフィー", "text": "――気を抜いてはだめですよ、リーフさん。\nはい、リーフさんのチョコレートです。", "face": "u746"}, {"name": "リーフ", "text": "そ、ソフィーさんっ！　ありがとうございますっ！\n危うくゴブリンに盗られちゃうところでした……。", "face": "u747"}, {"name": "ソフィー", "text": "魔物の共闘も異常事態ではありますが、\n人々の祝祭たるバレンタインを妨害するとは、\n決して許されない所業ですね……。", "face": "u746"}, {"name": "ソフィー", "text": "王子さま、私も協力いたします。\n乙女の願いを込めたチョコを奪う魔物、\n私達の手で成敗してやりましょう。", "face": "u746"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "ありがとうございます、ソフィーさん。\n王子、ソフィーさんの助力が必要な時には、\n適宜指示をお願いします。", "face": "l307fe93ca6aa"}, {"name": "アンナ", "text": "ここで魔物達を倒し、\nバレンタインを守りましょう！！", "face": "l307fe93ca6aa"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン", "text": "ギャギャーッ！？\nテッタイ！！　テッタイー！！", "face": "l9e581573e670"}, {"name": "マーマン", "text": "くっ……ここは退くしかあるまい。\nしかしこの街のチョコも、根こそぎ我らが奪い取ったぞ！\n急ぎチョコを運び出し、女王様へ献上するのだ……！！", "face": "l0f52cd911980"}, {"name": "リーフ", "text": "……うぅ、魔物達は撃退できましたが、\nチョコを守ることは出来ませんでした。\nこれでは、バレンタインが本当に台無しに……。", "face": "u747"}, {"name": "ソフィー", "text": "バレンタインの日に想いを伝えたい、\nそう願う女性達も多いでしょうに……。\n魔物はいったい何を企んでいるのでしょうか。", "face": "u746"}, {"name": "サイラス", "text": "それについては、おおよそ見当がついたぞ。\n先に倒した魔物を調べたところ、\nとあるフェロモンが検出されたのだ。", "face": "u13"}, {"name": "リーフ", "text": "……魔物って、『女王様』にチョコレートを\n献上って言ってたよね。それに、フェロモンって……！\nそれじゃ、この事件の黒幕は――", "face": "u747"}, {"name": "魔界アリの女王", "text": "――ふふ。そう、これは妾の為の行いよ。\n可愛い妾の子らに、忠誠の証として、\nチョコレートを集めさせておるのだ。", "face": "l1a2868ecbb98"}, {"name": "魔界アリの女王", "text": "人間共のバレンタインなど破壊し、\n代わりに妾からのバレンタインプレゼントとして、\n甘美なるフェロモンを与えてやろうぞ……！", "face": "l1a2868ecbb98"}, {"name": "バルバストラフ", "text": "やはり女王アリの仕業じゃったか！\nしかし、女王が直接姿を現すとは……。\nいかん王子。急ぎ部隊を撤退させるのじゃ！", "face": "u63"}, {"name": "ミゲル", "text": "……ぐっ、や、ヤバい……！\n意識が……あァ、女王サマ……だ、駄目だ！\nこのままじゃ……くそっ、王子の兄貴……ッ！！", "face": "u369"}, {"name": "王子", "text": "…………ッ！？", "face": "u1"}, {"name": "魔界アリの女王", "text": "くふふふ……。さぁ、皆の者。\n妾の甘美なるフェロモンの虜となるのだ……。", "face": "l1a2868ecbb98"}, {"name": "リーフ", "text": "ミゲルくん！？　王子さんまで……！？\nこ、ここは早く撤退した方が良いんじゃ……！！", "face": "u747"}, {"name": "ケイティ", "text": "くっ……この場は止むを得ませんね。\n皆さん、フェロモンの影響下にある方々を連れ撤退を！\n必ず対策は見つかるはずです……！", "face": "u114"}, {"name": "魔界アリの女王", "text": "くふふ……妾のフェロモンがある限り、\n世の男たちは我が忠実なる下僕……。\n王子を手にすれば、もはや王国も妾のものよぉ！", "face": "l1a2868ecbb98"}]}], "story_talk": true, "active": true}