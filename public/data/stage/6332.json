e": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105104, "special_effect_id": 240, "change_to": 2, "master_id": 644, "global_id": 643, "to_global_id": 642, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 113}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 7000, "attack": 450, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 30, "attack_speed": 35, "attack_wait": 50, "attack_interval": 136, "move_speed": 650.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105424, "special_effect_id": 240, "missile_id": 45, "master_id": 643, "global_id": 642, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 12, "form_count": 1, "hp": 1500, "attack": 20, "base_hp": 1500, "base_attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 35, "attack_speed": 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 633, "global_id": 632, "ranged": true, "spawn_sec": 116}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 800, "base_hp": 6000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 2, "attack_interval": 32, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109744, "race_id": 8, "special_effect_id": 130, "master_id": 30228, "global_id": 3847, "spawn_sec": 166}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "酷い……。\nオークたちの野営地が壊滅状態に……。", "face": "l94194626becc"}, {"name": "ルナール", "text": "ね、言ったでしょ？\n吸血鬼たちの大軍に襲われたって。", "face": "u300"}, {"name": "ケイティ", "text": "確かに、吸血鬼やその眷属たちの姿が\nあちこちに見えますね……。", "face": "u114"}, {"name": "ルナール", "text": "あれ？　でも隊を指揮してた\n一番偉そうな吸血鬼がいなくなってる。", "face": "u300"}, {"name": "アンナ", "text": "一番偉そうな吸血鬼？", "face": "lbd47455882a3"}, {"name": "ケイティ", "text": "これだけの人数の吸血鬼を動員できる吸血鬼……。\nひょっとするとヴァンパイア公爵では？", "face": "u114"}, {"name": "アンナ", "text": "ヴァンパイア公爵……言われてみれば\nこんなことができるのは彼くらいかもしれませんね。", "face": "lbd47455882a3"}, {"name": "ルナール", "text": "――危ないっ！　オークがこっちに向かって\n……って、あれ？　なんか肌の色が変じゃない？", "face": "u300"}, {"name": "フーリ", "text": "――っ！　皆さん、気をつけてください！\nあのオークたち、ゾンビ化しているみたいです！", "face": "u174"}, {"name": "ルナール", "text": "わわわ！　襲ってきたぁ！", "face": "u300"}, {"name": "アンナ", "text": "王子、ひとまず応戦しましょう！", "face": "lbd47455882a3"}]}, {"trigger": "end", "lines": [{"name": "ルナール", "text": "はぅ……怖かったぁ。", "face": "u300"}, {"name": "オーク", "text": "誰だ、お前ら！", "face": "l63166045e5e7"}, {"name": "アンナ", "text": "――オークの部隊！　生き残りがいたのですね。\n私たちはここが吸血鬼たちに\n占領されたという報せを聞いて駆けつけたのです。", "face": "lbd47455882a3"}, {"name": "オーク", "text": "お前らがあの卑怯者どもを倒したというのか。\n……フン、余計な真似をしてくれる。", "face": "l63166045e5e7"}, {"name": "ケイティ", "text": "卑怯者ども？　吸血鬼たちのことですか？", "face": "u114"}, {"name": "オーク", "text": "……奴らは俺たちの根城に夜襲をかけたのみならず、\n同胞たちの戦士としての魂を冒涜したのだ。", "face": "l63166045e5e7"}, {"name": "オーク", "text": "生き残った我々で弔い合戦をするつもりだったが、\nお前らのせいでそれも台無しだ。", "face": "l63166045e5e7"}, {"name": "ダニエラ", "text": "ちょっとぉ、そんな言い方ないんじゃない？\nせっかく私たちが仇を討ってあげたっていうのに。", "face": "u43"}, {"name": "オーク", "text": "……確かに、不死者と化したとはいえ同胞は同胞。\n俺たちとしても手をかけるのをためらっていたのは事実だ。", "face": "l63166045e5e7"}, {"name": "オーク", "text": "うむ……礼を言おう、人間どもよ。\nだが、戦士たちの弔いは俺たちの手で行う。\n悪いがここを去ってはくれんか？", "face": "l63166045e5e7"}, {"name": "ケイティ", "text": "……吸血鬼たちを退治するという目的は果たせました。\nいまはそっとしておいて差し上げましょう。", "face": "u114"}, {"name": "アンナ", "text": "そうですね……それでは帰還いたしましょう。\n王子、お疲れ様でした。"}, {"name": "アンナ", "text": "……しかし、ヴァンパイア公爵は\n着々と魔物を眷属とし、自陣に加えているようです。\n今後も彼の動向には十分に警戒して参りましょう。", "face": "lbd47455882a3"}]}], "active": true}