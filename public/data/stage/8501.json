_hp": 2000, "base_attack": 380, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127936, "race_id": 16, "master_id": 33579, "global_id": 7196, "spawn_sec": 70}, {"enemy_id": 17, "source": "local", "count": 27, "form_index": 0, "form_count": 1, "hp": 5400, "attack": 540, "base_hp": 5400, "base_attack": 540, "damage_type": "physical", "armor_defense": 210, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127952, "race_id": 16, "master_id": 33580, "global_id": 7197, "spawn_sec": 101}, {"enemy_id": 18, "source": "local", "count": 21, "form_index": 0, "form_count": 2, "tags": ["ブロック不可"], "hp": 8000, "attack": 1500, "base_hp": 8000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_range": 40, "attack_speed": 50, "attack_wait": 20, "attack_interval": 51, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159264, "special_effect_id": 2023, "change_to": 18, "missile_id": 11, "master_id": 38599, "global_id": 12216, "ranged": true, "to_condition": 0, "to_global_id": 12217, "route_behaviour": {"transforms": [{"wait": 240}]}, "spawn_sec": 160}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "attack_interval": 70, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159280, "master_id": 38600, "global_id": 12217, "from_condition": 0}, {"enemy_id": 20, "source": "local", "count": 24, "form_index": 0, "form_count": 1, "hp": 1600, "attack": 320, "base_hp": 1600, "base_attack": 320, "damage_type": "physical", "armor_defense": 90, "attack_range": 100, "attack_speed": 1, "attack_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127968, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 33581, "global_id": 7198, "ranged": true, "spawn_sec": 167}], "popups": ["エスネアは倒されると\nその場で復活します。\n\n２回まで復活し、\n復活するたびに強くなります。", "ベルーフェは倒されると、\nその場で復活します。\n復活は5回まで行われます。", "落下してくる黒板消しの付喪神の\n攻撃を受けた味方ユニットは\n2秒間、攻撃力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "クロエ", "text": "ねー、もうすぐ午後の授業始まっちゃうよー。", "face": "u784"}, {"name": "ベルーフェ", "text": "ぐー……。", "face": "u2125a1"}, {"name": "クロエ", "text": "完全に寝てる、こりゃ起きないね。\nグリムは午後の授業、出ないのー？", "face": "u784"}, {"name": "グリム", "text": "ちょっと作業が山場なのでパスでーす。", "face": "u2127a1"}, {"name": "クロエ", "text": "ありゃりゃ、とんだ不良生徒だね。\nそれじゃ、あたしもサボっちゃおー。", "face": "u784"}, {"name": "エスネア", "text": "だっ、駄目だよぅ！　授業にはちゃんと出ないと！", "face": "u1188a1"}, {"name": "クロエ", "text": "エスネアは真面目だねー、本当に悪魔？", "face": "u784"}, {"name": "クロエ", "text": "購買で買った新作のお菓子もあるしさ、\n今日はもう全部すっぽかしちゃおうよー。", "face": "u784"}, {"name": "エスネア", "text": "で、でも、先生に怒られちゃうかもだし……。", "face": "u1188a1"}, {"name": "クロエ", "text": "体調不良で寝てましたって言えば、\n一回ぐらいサボっても大丈夫だって。", "face": "u784"}, {"name": "グリム", "text": "ちなみに迷い家様──もとい多目的室の鍵は、\n私が借り受けているので抜かりはありませんよ？", "face": "u2127a1"}, {"name": "クロエ", "text": "つまり先生も入って来れないってわけ。\nいやぁ、こういうのも一つの青春だねぇ。", "face": "u784"}, {"name": "エスネア", "text": "青春……そ、そうなのかな……？", "face": "u1188a1"}, {"name": "クロエ", "text": "そうそう、それじゃ午後はまったりだらけて──", "face": "u784"}, {"name": "清源妙道真君", "text": "──随分と愉快な話をしていますね？", "face": "u2391a1"}, {"name": "クロエ", "text": "げぇっ！？　妙道先生！？", "face": "u784"}, {"name": "グリム", "text": "そんな、部屋の扉は閉めたはずなのに……！", "face": "u2127a1"}, {"name": "清源妙道真君", "text": "予備の鍵ぐらいあるに決まっているでしょう。", "face": "u2391a1"}, {"name": "清源妙道真君", "text": "自分だけが無断欠席するだけでは飽き足らず、\nあろうことか友人までも悪の道に誘うなど……。", "face": "u2391a1"}, {"name": "ナシート", "text": "（ふむ、分かってはいたがここに食材はなさそうだな）", "face": "u2394a1"}, {"name": "清源妙道真君", "text": "まったく、なんと嘆かわしい……。\n全員直りなさい、お説教の時間です。", "face": "u2391a1"}, {"name": "グリム", "text": "やーでーす。", "face": "u2127a1"}, {"name": "クロエ", "text": "妙道先生のお説教、無駄に長いんだよねー。", "face": "u784"}, {"name": "ベルーフェ", "text": "ぐー……。", "face": "u2125a1"}, {"name": "メアリ", "text": "あ、あはは……。", "face": "u2392a1"}, {"name": "清源妙道真君", "text": "……どうやら皆さんには愛の鞭が必要なようですね。", "face": "u2391a1"}, {"name": "クロエ", "text": "あっ、やべ。調子乗りすぎた。", "face": "u784"}, {"name": "清源妙道真君", "text": "全員歯を食い縛りなさい！", "face": "u2391a1"}, {"name": "エスネア", "text": "あ、あたしも～っ！？", "face": "u1188a1"}, {"name": "清源妙道真君", "text": "鉄拳ッ！　制裁ッ！", "face": "u2391a1"}]}, {"trigger": "end", "lines": [{"name": "エスネア", "text": "いったぁ～いっ！？", "face": "u1188a1"}, {"name": "クロエ", "text": "た、体罰はんた～い！", "face": "u784"}, {"name": "清源妙道真君", "text": "問答は無用です、全員放課後生徒指導室に来るように。", "face": "u2391a1"}, {"name": "クロエ", "text": "この上でまだお説教もするの！？", "face": "u784"}, {"name": "グリム", "text": "きょ、教育委員会に連絡を……。", "face": "u2127a1"}, {"name": "清源妙道真君", "text": "お説教が嫌なら学園の裏山で、\n特別課外活動でも構いませんが？", "face": "u2391a1"}, {"name": "クロエ", "text": "学園の裏山って、最近巨大熊が出るって噂の……。", "face": "u784"}, {"name": "エスネア", "text": "お説教でお願いします！", "face": "u1188a1"}, {"name": "グリム", "text": "しまーす……。", "face": "u2127a1"}, {"name": "清源妙道真君", "text": "よろしい、もうすぐ午後の授業が始まります。\n各自、至急自分の教室に戻りなさい。", "face": "u2391a1"}, {"name": "清源妙道真君", "text": "エスネアさんは放課後そのまま帰って構いません。\nその代わりに、今後はたとえ友人が相手であっても、\n悪い誘いはその場でキッパリ断るようにしてください。", "face": "u2391a1"}, {"name": "エスネア", "text": "は、はい！　妙道先生！", "face": "u1188a1"}, {"name": "メアリ", "text": "多目的室は事件に関係なかったようですね。\nナシートさん、私たちも一旦午後の授業に──", "face": "u2392a1"}, {"name": "ナシート", "text": "………………。", "face": "u2394a1"}, {"name": "サクヤ", "text": "ナシートさん？", "face": "u1774a1"}, {"name": "ナシート", "text": "……腹が、減った。", "face": "u2394a1"}, {"nam