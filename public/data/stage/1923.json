e": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 900, "attack_speed": 1, "attack_wait": 90, "attack_interval": 375, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136464, "special_effect_id": 1019, "change_to": 7, "missile_id": 709, "missile": {"speed": 8.0}, "master_id": 34851, "global_id": 8468, "ranged": true, "to_global_id": 8480, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 170}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 900, "attack_speed": 1, "attack_wait": 90, "attack_interval": 375, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136704, "special_effect_id": 1028, "change_to": 6, "missile_id": 709, "missile": {"speed": 8.0}, "master_id": 34863, "global_id": 8480, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 10, "form_count": 3, "tags": ["水棲"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 376, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136464, "special_effect_id": 1019, "change_to": 6, "missile_id": 709, "missile": {"speed": 8.0}, "master_id": 34864, "global_id": 8481, "to_global_id": 8468, "route_behaviour": {"transforms": [{"wait": 2100}]}, "spawn_sec": 180}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["水棲"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 900, "attack_speed": 1, "attack_wait": 90, "attack_interval": 375, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136464, "special_effect_id": 1019, "change_to": 7, "missile_id": 709, "missile": {"speed": 8.0}, "master_id": 34851, "global_id": 8468, "ranged": true, "to_global_id": 8480}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["水棲"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 900, "attack_speed": 1, "attack_wait": 90, "attack_interval": 375, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136704, "special_effect_id": 1028, "change_to": 6, "missile_id": 709, "missile": {"speed": 8.0}, "master_id": 34863, "global_id": 8480, "ranged": true}], "popups": ["ポセイオス像のHPを\n少しでも減らすと、強烈な\n遠距離攻撃をしてきます。\n\nポセイオス像は\n撃破数に含まれません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "デューオ", "text": "――古い海上遺跡なんかで見かける建築様式だ。\n確かに、ここはかつて、地上に存在した神殿みたいだね。", "face": "u594"}, {"name": "ジョヴァンニ", "text": "……でも、おかしくねぇか？\n周囲にたってる神像、どう見てもポセイオスだぜ？", "face": "u123"}, {"name": "ムイル", "text": "ポセイオスはクラールフ様と同じく、\n海に生きる者たちを創造した神……。", "face": "u1419a1"}, {"name": "ムイル", "text": "もしかしたら、遥か昔には、\n乾いた地に生きる者の中にも、\nポセイオスを信仰していた都市があったのでしょうか。", "face": "u1419a1"}, {"name": "ベアトリカ", "text": "あるいは、ポセイオスが\n俺たちを足止めするために設置した、\n罠だって可能性もある。", "face": "u157"}, {"name": "ベアトリカ", "text": "地上で陽動を繰り返してたんだ。\nそれくらいの仕込みをしてても不思議じゃないだろ？", "face": "u157"}, {"name": "フローガ", "text": "わっ……ベアトリカさんの指摘、正解かもしれません。\nあのポセイオス像、強い魔力を帯びています！", "face": "u878"}, {"name": "フローガ", "text": "これはおそらく、衝撃を与えると、\n自動的に反撃してくる魔術の類ですよ！", "face": "u878"}, {"name": "アンナ", "text": "神像に魔力を込めたのか、\nあるいは後から罠として設置したのか……。\nともかく、注意するよう兵に厳命しておきましょう。", "face": "l10213d90c27c"}, {"name": "ベアトリカ", "text": "――さて、おしゃべりはそこまでだ。\n王子、ここから先は敵陣のど真ん中。\nギルマンどもが襲ってくるぞ！", "face": "u157"}]}, {"trigger": "end", "lines": [{"name": "デューオ", "text": "さすがに迎撃準備を整えてるか……。\nポセイオスの真の狙い、\nこの海中神殿で間違いないみたいだね。", "face": "u594"}, {"name": "アンナ", "text": "ポセイオス、いったい何を企んでいるのでしょうか……。", "face": "l10213d90c27c"}, {"name": "リーンベル", "text": "奴の狙いは地上を海に変えることだろう？\n物質界を手に入れる、なんて言っていたからな。", "face": "u268"}, {"name": "デューオ", "text": "つまり、この神殿には、\nそれを可能にする力が眠ってるってことさ。\n王子、急いでポセイオスの居場所を目指すぞ！", "face": "u594"}]}, {"trigger": "end", "lines": [{"name": "メシナ", "text": "（王国軍、やはり来ましたか。\n……いえ、来てくれたの方が正しいのでしょうか）", "face": "l4b69d4dcab0e"}, {"name": "メシナ", "text": "（お父さまは、私に「好きにしろ」と言った。\n侵攻を手伝えとも、何もするなとも言わず……）", "face": "l4b69d4dcab0e"}, {"name": "メシナ", "text": "（それなら、ちゃんと確かめに行きますわ。\n自分の成すべきことを、自分で選び取るために）", "face": "l4b69d4dcab0e"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 49, "params": [30]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 10, "attack": 300, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 50, "pattern_id": 2136528}, {"enemy_id": 1, "form_index": 1, "hp": 180000, "attack": 6000, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 50, "pattern_id": 2136544}, {"enemy_id": 3, "hp": 6000, "attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "pattern_id": 2136480}, {"enemy_id": 3, "form_index": 1, "hp": 6000, "attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "pattern_id": 2136496}, {"enemy_id": 5, "hp": 6000, "attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "pattern_id": 2123616}, {"enemy_id": 6, "hp": 15000, "attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "pattern_id": 2124416}, {"enemy_id": 7, "hp": 7000, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136464}, {"enemy_id": 7, "form_index": 1, "hp": 7000, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136704}, {"enemy_id": 9, "hp": 7000, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136464}, {"enemy_id": 9, "form_index": 1, "hp": 7000, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136464}, {"enemy_id": 9, "form_index": 2, "hp": 7000, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136704}]}, "active": true}