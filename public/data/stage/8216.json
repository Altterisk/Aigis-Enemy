e_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "change_to": 1, "change_condition": 2, "missile_id": 6, "master_id": 37311, "global_id": 10928, "ranged": true, "to_condition": 2, "to_global_id": 7196, "spawn_sec": 95}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 4600, "attack": 700, "base_hp": 4600, "base_attack": 700, "damage_type": "physical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 50, "attack_wait": 30, "attack_interval": 173, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106992, "change_to": 1, "change_condition": 2, "master_id": 37312, "global_id": 10929, "to_condition": 2, "to_global_id": 7196, "spawn_sec": 138}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 20000, "attack": 1500, "base_hp": 20000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 221, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2127520, "race_id": 10, "change_to": 1, "change_condition": 2, "master_id": 37314, "global_id": 10931, "to_condition": 2, "to_global_id": 7196, "spawn_sec": 144}], "popups": ["リッチキングがいる間は、\n全てのアンデッドの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シロガネ", "text": "というわけで、謎のローパーの手がかりを探して、\n校庭を捜索してるっすけど……。", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "なにか見つかった～？", "face": "u2125a1"}, {"name": "アイシャ", "text": "見つかってないよ。\nそれよりベルーフェも地面に寝転んでないで、\n調査を手伝ったらどうかな？", "face": "u2124a1"}, {"name": "シロガネ", "text": "そうっすよ。制服汚れるっすよ。", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "別にいいよ。王子に洗ってもらうから。", "face": "u2125a1"}, {"name": "シロガネ", "text": "王子を使うのはズルいっすよ。\n自分はいつも制服汚して、\n姫様に怒られながら洗ってもらってるのに……。", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "（姫様に洗ってもらってるんだ……）", "face": "u2125a1"}, {"name": "アイシャ", "text": "そもそも汚さないように生活するべきだと思うが……。\nそれはともかく、なにか来るよ。", "face": "u2124a1"}, {"name": "シロガネ", "text": "あれは……魔物っすか？", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "いや、魔物じゃないね。\n仮装した生徒、ってところじゃない？", "face": "u2125a1"}, {"name": "アイシャ", "text": "そういえば文化祭の出し物で、\n魔物の仮装をする生徒たちがいると噂で聞いたね。", "face": "u2124a1"}, {"name": "ベルーフェ", "text": "じゃあ放っておいても大丈夫かな。", "face": "u2125a1"}, {"name": "仮装生徒", "text": "フフフ、模擬戦……。\n人間は皆、倒してしまいましょう。", "face": "labdc1fa49bee"}, {"name": "アイシャ", "text": "しまった！　魔物に扮したことで、\n心まで魔物になりきってしまっている！", "face": "u2124a1"}, {"name": "ベルーフェ", "text": "仕方ない。\n目を覚まさせてあげようか。", "face": "u2125a1"}]}, {"trigger": "end", "lines": [{"name": "仮装生徒", "text": "うう……私は、人間……？", "face": "labdc1fa49bee"}, {"name": "アイシャ", "text": "そうだよ。人の心を取り戻して。", "face": "u2124a1"}, {"name": "仮装生徒", "text": "ウス。", "face": "labdc1fa49bee"}, {"name": "シロガネ", "text": "ふぅ。どうにか正気に戻せたっすね。", "face": "u2126a1"}, {"name": "ベルーフェ", "text": "それはそうと、みんな気づいた？\n仮装した生徒の中に、あのローパーが混ざってたよね。", "face": "u2125a1"}, {"name": "シロガネ", "text": "無駄にピカピカしてるんだから当然気づいてるっすよ。", "face": "u2126a1"}, {"name": "アイシャ", "text": "……ふと思ったんだけど、\nあのローパーは、似ていると思わない？", "face": "u2124a1"}, {"name": "ベルーフェ", "text": "ん？　似てるって、なにと？", "face": "u2125a1"}, {"name": "アイシャ", "text": "ほら、異界の虫だよ。", "face": "u2124a1"}, {"name": "ベルーフェ", "text": "異界の虫……。\nということは、あのローパーはもしかして……。", "face": "u2125a1"}, {"name": "アイシャ", "text": "そう、ボクの推理が正しければ――", "face": "u2124a1"}, {"name": "アイシャ", "text": "あのローパーは異界から現れているのかもしれないよ。", "face": "u2124a1"}]}], "active": true}