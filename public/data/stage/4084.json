{"quest_id": 4084, "name": "もう一つの出会い", "description": "静かになったはずの海に\n銃声が響く！新たな魚人の\n魔の手から海賊を救出せよ！", "event": "裏切りの海賊", "event_category": "History", "mission_id": 920020, "map_no": 3835, "level": 110, "multiplier": 1.1, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "hp": 4620, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 180, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 620, "global_id": 619, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "hp": 11000, "attack": 825, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349, "spawn_sec": 61}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "tags": ["狙う", "ブロック不可", "水面"], "hp": 4620, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 180, "attack_speed": 150, "attack_interval": 51, "move_speed": 800.0, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101136, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 622, "global_id": 621, "ranged": true, "spawn_sec": 76}], "dialogue": [{"trigger": "start", "lines": [{"name": "海賊手下", "text": "船長っ！\nもう後がありません……！", "face": "u124"}, {"name": "ベアトリカ", "text": "情けねぇ声出すんじゃねぇよ。\n最後まで戦え！", "face": "u157"}, {"name": "海賊手下", "text": "えー！　もう最後決定スか！？\nそれは嫌っス！！　誰か助けてくださいーっ！", "face": "u124"}, {"name": "ベアトリカ", "text": "こんな海の片隅で泣き言言ったところで\n誰かが助けてくれるわけねぇだろ！\n甘えんな！", "face": "u157"}, {"name": "アンナ", "text": "王子、海賊です！\nどうやら魔物たちと戦っているようですが……。\nいかがいたしますか？", "face": "l3d74f56bb295"}, {"name": "ベアトリカ", "text": "お前らは水兵どもの仲間だな……。\nこんなところまで追ってくるとは\nしつこいヤツらだ。", "face": "u157"}, {"name": "ベアトリカ", "text": "いいだろう。\n相手になってやろうじゃねぇか。\nかかってこい！", "face": "u157"}, {"name": "海賊手下", "text": "船長、やめてくださいよ！\nあ、すいません。\nとりあえず助けてください！", "face": "u124"}]}, {"trigger": "end", "lines": [{"name": "ベアトリカ", "text": "やっと片付いたか。\nさて、これで邪魔者はいなくなった。\nお前らとも決着をつけようじゃねぇか！", "face": "u157"}, {"name": "アンナ", "text": "あなた方を追ってきたわけではありません。\n帰路の途中で、かすかな銃声が聞こえたので\n立ち寄ったまでです。", "face": "l3d74f56bb295"}, {"name": "アンナ", "text": "それよりも聞きたいことがあります。\nなぜあなた方は魔物と手を結んだのですか。", "face": "l3d74f56bb295"}, {"name": "ベアトリカ", "text": "ぁあ！？\n誰が魔物と手を結んだだって？\n魔物と手を結んだのは水兵たちだろ！", "face": "u157"}]}], "active": true}