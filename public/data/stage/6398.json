"hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 49}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 56}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 100, "base_hp": 3000, "base_attack": 100, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105584, "missile_id": 152, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30691, "global_id": 4310, "ranged": true, "spawn_sec": 80}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097312, "race_id": 9, "master_id": 53, "global_id": 52, "spawn_sec": 138}], "popups": ["マグマゴーレムは一定範囲内の\nユニットに継続ダメージを与えます。\nまた、HPを減らすと\n強烈な遠距離攻撃をしてきます。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ふぅ……それにしても暑いですね。\n火山だから仕方ないとはいえ。", "face": "l735f9a4923bd"}, {"name": "リルケ", "text": "ホント、どうにかなっちゃいそう。\nあーあ……汗で服がびしょびしょだわ。", "face": "u330"}, {"name": "グスタフ", "text": "そんな薄着で来ているクセに、情けないのう。", "face": "u153"}, {"name": "リルケ", "text": "な、なによー！　あんたが変なゴーレムを\n見たっていうからついてきてあげたのに。\n……っていうか、変な目で見ないでよね！", "face": "u330"}, {"name": "グスタフ", "text": "フン、自意識過剰も甚だしいわ。", "face": "u153"}, {"name": "グスタフ", "text": "じゃが、火山活動の活発化と同時に\n目撃されるようになった謎のゴーレムが\n何なのかを知っておきたいというのは事実じゃ。", "face": "u153"}, {"name": "リルケ", "text": "……ま、まぁ、そういう事情なら\nゴーレムに詳しい付与魔術師である私に\n頼るのも仕方ないわね……。", "face": "u330"}, {"name": "マーヤ", "text": "――ひゃッ！？\nお、王子……あの、あ、あれ……っ！", "face": "u338"}, {"name": "グスタフ", "text": "ぬぉッ！？　出た！　\n聞いていた通り、赤熱したゴーレムじゃ！", "face": "u153"}, {"name": "リルケ", "text": "あれは――！\nええと、なんだっけ、\n確か……そう、『マグマゴーレム』！", "face": "u330"}, {"name": "ケイティ", "text": "『マグマゴーレム』……。\n見るからに危険な存在のようですね。", "face": "u114"}, {"name": "リルケ", "text": "ええと……とにかくうかつに近寄らない方がいいわ！\n近づくだけで炎熱によるダメージは避けられないから！", "face": "u330"}, {"name": "リルケ", "text": "幸いヤツには今のところ攻撃の意思はなさそうだから、\nこっちから攻撃しない限りは安全だと思うわ。\n『触らぬ神にたたりなし』で行きましょ。", "face": "u330"}, {"name": "マーヤ", "text": "あ、あのっ……マグマゴーレム以外にも魔物が……。\nひっ……こ、こっちに向かってきてますぅ！", "face": "u338"}, {"name": "アンナ", "text": "くっ……仕方ありません。\n王子、マグマゴーレムを刺激しないよう\n注意しながら魔物を撃退しましょう！", "face": "ld39bc6bfc01e"}]}, {"trigger": "end", "lines": [{"name": "マーヤ", "text": "こ、怖かったですぅ……。", "face": "u338"}, {"name": "リルケ", "text": "それにしても、マグマゴーレムにお目にかかれるとはね。\n限られた錬金術師しか錬成できない、\nすっごく珍しいゴーレムのはずなんだけど……。", "face": "u330"}, {"name": "アンナ", "text": "一体なにが起きているのでしょうか……？", "face": "ld39bc6bfc01e"}, {"name": "グスタフ", "text": "……ふむ。\nこの件については、わしらドワーフが調査をしよう。", "face": "u153"}, {"name": "グスタフ", "text": "なに、心配は無用じゃ。\n火山とはいえ山であることには変わらん。\nそれに敵の正体も判明したしのう。", "face": "u153"}, {"name": "リルケ", "text": "ふふん、褒めてくれてもいいのよ？\n……なーんてね。", "face": "u330"}, {"name": "アンナ", "text": "ええ。リルケさん、\n今回はご協力いただきありがとうございます。"}, {"name": "アンナ", "text": "それではグスタフさん、\n火山の調査の件、よろしくお願いいたしますね。"}]}], "active": true}