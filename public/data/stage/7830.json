{"quest_id": 7830, "name": "平穏なバレンタインを求めて", "description": "トラブル続きのバレンタインを回避する\nため、カカオ農園へやってきた一行。\nしかし、なにやら騒ぎが起きていて……？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "花咲く想いのバレンタイン", "event_category": "History", "mission_id": 920192, "map_no": 4678, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142080, "special_effect_id": 1224, "change_to": 1, "master_id": 35757, "global_id": 9374, "to_global_id": 9375, "route_behaviour": {"transforms": [{"wait": 50}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 5, "tags": ["植物", "バレンタイン", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142096, "change_to": 2, "master_id": 35758, "global_id": 9375, "to_global_id": 9376}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142112, "special_effect_id": 1225, "change_to": 3, "master_id": 35759, "global_id": 9376, "to_global_id": 9377}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 3, "form_count": 5, "tags": ["植物", "バレンタイン", "ステルスII", "ブロック不可"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142128, "change_to": 4, "master_id": 35760, "global_id": 9377, "to_global_id": 9378}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 4, "form_count": 5, "tags": ["植物", "バレンタイン"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142144, "special_effect_id": 1226, "master_id": 35761, "global_id": 9378}, {"enemy_id": 6, "source": "local", "count": 19, "form_count": 1, "tags": ["バレンタイン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 350, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121296, "race_id": 3, "change_to": 6, "master_id": 32292, "global_id": 5911, "spawn_sec": 42}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "tags": ["バレンタイン"], "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 30, "attack_range": 170, "attack_speed": 26, "attack_wait": 20, "attack_interval": 89, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142160, "missile_id": 815, "missile": {"speed": 7.0}, "master_id": 35762, "global_id": 9379, "ranged": true, "spawn_sec": 69}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["バレンタイン"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121328, "race_id": 3, "change_to": 9, "master_id": 32294, "global_id": 5913, "spawn_sec": 127}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 39, "change_to": 11, "missile_id": 6, "master_id": 32291, "global_id": 5910, "ranged": true, "to_global_id": 5923, "spawn_sec": 151}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 10, "missile_id": 6, "master_id": 32304, "global_id": 5923}], "popups": ["魔界カカオがいる間は、\n女性、バレンタイン属性の\n敵の攻撃と防御がアップします。\n\nまた魔界カカオは、\n時間経過で成長します。\n成長するたびに攻撃と防御の\n上昇する値がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ローリエ", "text": "──私、考えたんです。", "face": "u1692a1"}, {"name": "ラタトスク", "text": "なんじゃ急に。", "face": "u1693a1"}, {"name": "ローリエ", "text": "毎年バレンタインはトラブル続き。\nその対処に追われて落ち着く暇もなく、\n王子にチョコを渡すだけでも一苦労です。", "face": "u1692a1"}, {"name": "ポミエ", "text": "……でしたねぇ。", "face": "u1422a1"}, {"name": "ローリエ", "text": "バレンタインは日頃の感謝を伝える日。\n王子には最高のチョコレートを贈りたい、\nその気持ちは私にも痛いほど理解できます。", "face": "u1692a1"}, {"name": "ローリエ", "text": "ですが、クオリティにこだわるあまり、\n王子に迷惑をかけてしまっては本末転倒。", "face": "u1692a1"}, {"name": "ミリアム", "text": "……つまり？", "face": "u1694a1"}, {"name": "ローリエ", "text": "──グルメジャングルはやめましょう。", "face": "u1692a1"}, {"name": "ラタトスク", "text": "慧眼じゃな。", "face": "u1693a1"}, {"name": "ポミエ", "text": "間違いありませんね。", "face": "u1422a1"}, {"name": "ローリエ", "text": "ですので今年は冒険することなく、\n懇意にしている近場のカカオ農園さんで、\n材料を仕入れるつもりでしたのに──", "face": "u1692a1"}, {"name": "農園の主人", "text": "──みんな早く逃げろー！\nカカオが襲ってくるぞー！", "face": "l3444361f15da"}, {"name": "ローリエ", "text": "どうしてこうなるんですかぁッ！？", "face": "u1692a1"}, {"name": "グレーターデーモン", "text": "やれやれ……魔界カカオの暴走とはね、\nあれだけ管理には気を付けろと言ったのに。", "face": "l45969ed547e2"}, {"name": "ポミエ", "text": "グレーターデーモンさん！？　どうしてここに！？", "face": "u1422a1"}, {"name": "ラタトスク", "text": "吾輩知っておる、だいたいこいつが元凶じゃな？", "face": "u1693a1"}, {"name": "グレーターデーモン", "text": "話は後にしよう、今は農園の防衛が先決でね。\n君たちもカカオ退治を手伝ってくれないかい？", "face": "l45969ed547e2"}, {"name": "ミリアム", "text": "……そうするしかないようですね。", "face": "u1694a1"}, {"name": "グレーターデーモン", "text": "魔界カカオの木は成長するほどに、\n周囲のカカオたちに力を与えてしまう。\n実が成る前に倒すことをオススメするよ。", "face": "l45969ed547e2"}, {"name": "ローリエ", "text": "……グルメジャングルは、\nグルメジャングルは避けたのにぃ！", "face": "u1692a1"}]}, {"trigger": "end", "lines": [{"name": "ミリアム", "text": "魔界カカオの沈黙を確認、制圧完了しました。", "face": "u1694a1"}, {"name": "ラタトスク", "text": "まったく、とんだ休日出勤よのぉ。腰が痛いわい。", "face": "u1693a1"}, {"name": "ポミエ", "text": "あのぉ、魔界カカオってなんなのでしょうか？", "face": "u1422a1"}, {"name": "グレーターデーモン", "text": "名前の通り魔界に原生するカカオのことさ。\n非常に高品質だが、少々気性が荒っぽくてね。\n扱い方を間違うとすぐに暴走してしまうんだ。", "face": "l45969ed547e2"}, {"name": "ローリエ", "text": "また貴方はそんな危険な植物を……。", "face": "u1692a1"}, {"name": "農園の主人", "text": "ぐ、グレーターデーモン殿は悪くないのです！\n彼は私の頼みで魔界カカオを仕入れてくれただけ、\n管理体制の不備に関する責任は当園にあります！", "face": "l3444361f15da"}, {"name": "ポミエ", "text": "まっ、まあ暴走は止められたわけですし……。", "face": "u1422a1"}, {"name": "グレーターデーモン", "text": "……いや、実はそう簡単な話ではなくてね。\n君たち、魔界カカオの妖精を見なかったかい？", "face": "l45969ed547e2"}, {"name": "ローリエ", "text": "妖精、ですか？", "face": "u1692a1"}, {"name": "グレーターデーモン", "text": "赤い髪に、カカオのような褐色肌。\nもし見かけていた場合事態は深刻だ。", "face": "l45969ed547e2"}, {"name": "グレーターデーモン", "text": "今すぐにでも追いかけて捕獲しなければ、\nバレンタインが大惨事になってしまうねぇ。", "face": "l45969ed547e2"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "ふぅー、危ない危ない。\nまったく物質界は野蛮だね。", "face": "l0dd4eb1fc022"}, {"name": "？？？", "text": "ボクには大切な使命があるんだ、\nこんな場所で蛮族の相手なんかしてられないよ。", "face": "l0dd4eb1fc022"}, {"name": "？？？", "text": "さぁてと、待っていておくれよ。\n美しくも危うい、恋する乙女たち。", "face": "l0dd4eb1fc022"}]}], "active": true}