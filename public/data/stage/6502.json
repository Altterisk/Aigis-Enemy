{"quest_id": 6502, "name": "闇エルフの企み", "description": "妖精郷への侵攻を企む闇エルフ達。\n迫り来る敵を退け、妖精郷へと急げ！\n\n極級（★１獲得の目安：平均Lv25）", "event": "世界樹の花嫁", "event_category": "History", "mission_id": 920111, "map_no": 5359, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 18, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 30, "attack_wait": 40, "attack_interval": 157, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099024, "race_id": 13, "special_effect_id": 220, "change_to": 2, "change_condition": 3, "master_id": 141, "global_id": 140, "to_condition": 3, "to_global_id": 141, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099040, "race_id": 13, "master_id": 142, "global_id": 141, "from_condition": 3}, {"enemy_id": 4, "source": "local", "count": 10, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 1800, "attack": 330, "base_hp": 1800, "base_attack": 330, "damage_type": "physical", "armor_defense": 180, "magic_defense": 70, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "special_effect_id": 222, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31076, "global_id": 4695, "ranged": true, "spawn_sec": 1}, {"enemy_id": 6, "source": "local", "count": 14, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 1}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 2, "hp": 18000, "attack": 750, "base_hp": 18000, "base_attack": 750, "damage_type": "physical", "armor_defense": 450, "magic_defense": 80, "attack_speed": 30, "attack_wait": 40, "attack_interval": 157, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099024, "race_id": 13, "special_effect_id": 277, "change_to": 7, "change_condition": 3, "master_id": 31077, "global_id": 4696, "to_condition": 3, "to_global_id": 4697, "spawn_sec": 118}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1650, "base_hp": 18000, "base_attack": 1650, "damage_type": "physical", "armor_defense": 450, "magic_defense": 80, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099040, "race_id": 13, "special_effect_id": 222, "master_id": 31078, "global_id": 4697, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "ダークエルフ", "text": "……そうか、王子たちが来ているというのだな。\n承知した。我々の部隊も見つからぬうちに急ごう。", "face": "la2af0c19fdd0"}, {"name": "ダークエルフ", "text": "……諸君、案ずる必要はない。\n花びらの力で強化した魔物どもをうまく使えば、\n今度こそ必ずや妖精郷を落とせるはずだ。", "face": "la2af0c19fdd0"}, {"name": "ダークエルフ", "text": "我々は慌てず、しかし迅速に\n先に妖精郷に向かった部隊と合流し――むッ！？", "face": "la2af0c19fdd0"}, {"name": "カゲロウ", "text": "――いまさら気づいたか。\nぬしらの企み、とくと聞かせてもらったぞ。", "face": "u139"}, {"name": "ロザリー", "text": "やっぱり妖精郷に侵攻しようとしていたのね！", "face": "u117"}, {"name": "ダークエルフ", "text": "チッ、盗み聞きされるとはな。\nまぁいい。既に我らの部隊を除く\n全ての部隊が妖精郷に向けてこの地を発っている。", "face": "la2af0c19fdd0"}, {"name": "ダークエルフ", "text": "だが、我らの計画を知られた以上は\nいずれにせよ生かしておくわけにはいかん。\n悪いが、お前らにはここで死んでもらおう！", "face": "la2af0c19fdd0"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "く……クソッ！\n花びらの力をもってしても勝てないとは……。", "face": "la2af0c19fdd0"}, {"name": "ダークエルフ", "text": "やむをえん……撤退しよう。\n邪魔者どもを足止めできただけでも良しとせねばな。", "face": "la2af0c19fdd0"}, {"name": "スピカ", "text": "ちょっと、待ちなさいよ！", "face": "u113"}, {"name": "ローレン", "text": "スピカ、抑えるんだ。\nいまはヤツらを追撃してる場合じゃない。", "face": "u118"}, {"name": "スピカ", "text": "で、でもっ！\nあいつら、妖精郷を落とすって――", "face": "u113"}, {"name": "ローレン", "text": "だからこそ小事に構ってる場合じゃないのさ。\n一刻も早く妖精郷に救援に向かわないとね。", "face": "u118"}, {"name": "ロザリー", "text": "いまの戦いで時間を稼がれてしまいましたしね。\nこうしている間にもダークエルフたちは……。", "face": "u117"}, {"name": "スピカ", "text": "わ……わかってるわよ。", "face": "u113"}, {"name": "ファルネ", "text": "……困ったことになっちゃったわね。\n最初は花びらを集めるだけのつもりだったのに。", "face": "u640"}, {"name": "ロザリー", "text": "でも、おかげでダークエルフたちの企みを\n事前に知ることができました。感謝いたします。", "face": "u117"}, {"name": "ローレン", "text": "王子、知っての通り妖精郷は僕らエルフの故郷だ。\n悪いけど僕らだけでも救援に向かわせてもらうよ。", "face": "u118"}, {"name": "ファルネ", "text": "……あたしも行くわ。\n花びらの力を感知する力が役に立つかもしれないし、\nみんなを巻き込んじゃった責任もあるから……。", "face": "u640"}, {"name": "ファルネ", "text": "それに、『ジューンブライド』を通じて\n王国の復興を祝うために使うはずだった花びらが\n争いのために使われるなんて……嫌だもの。", "face": "u640"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "……意見が一致したようですね。\nそれでは、準備ができたらすぐに\n妖精郷の救援に向けて出発いたしましょう。", "face": "lbb3a22565b44"}]}], "active": true}