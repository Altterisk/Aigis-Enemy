 "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 32, "global_id": 31, "ranged": true, "spawn_sec": 57}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30, "global_id": 29, "ranged": true, "spawn_sec": 57}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 111}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "route_behaviour": {"sets_flags": [[2, 0, 0]]}, "spawn_sec": 111}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 1200, "attack": 150, "base_hp": 1200, "base_attack": 150, "damage_type": "physical", "armor_defense": 400, "magic_defense": 5, "attack_speed": 80, "attack_wait": 60, "attack_interval": 270, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097776, "race_id": 16, "master_id": 34, "global_id": 33, "route_behaviour": {"sets_flags": [[0, 1, 0]]}, "spawn_sec": 132}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 133}], "dialogue": [{"trigger": "start", "lines": [{"name": "ジョヴァンニ", "text": "くぅぅ！　ようやく期末試験も終わりだぜ！！\nおう野郎ども、これ終わったら酒場に行くぞォ！！", "face": "u611"}, {"name": "レーレン", "text": "こーら、まだ実技試験が残ってんだろ？\n筆記試験は中々の出来だったけど、\nここで気を抜くんじゃないぞ！", "face": "u614"}, {"name": "ジョヴァンニ", "text": "分かってんよ、レーレン先生！\nでも実技と来たら、俺達の得意分野だからなぁ！", "face": "u611"}, {"name": "海賊手下", "text": "そのとおりだぜアーニキィー！！", "face": "u144"}, {"name": "メーリス", "text": "もう、ジョヴァンニもあなたたちも、\n調子にのって足を引っ張らないでよ？", "face": "u609"}, {"name": "ネーニャ", "text": "そうそう。\n楽しい冬休みのためにも、\nここで落第するわけにはいかないんだからね！", "face": "u610"}]}, {"trigger": "start", "lines": [{"name": "ケイティ", "text": "――さて、皆さん揃ったようですね。\n実技試験の説明をしますので、静かに聞くように。", "face": "u114"}, {"name": "ケイティ", "text": "実技試験では皆さんの対応能力を測るために、\n時間経過によってこちらの編成を調整します。\n詳しくは配布した資料を見てください。", "face": "u114"}, {"name": "ネーニャ", "text": "なになに？　えーっと、\n最初は防御を固めた集団を相手にして……。", "face": "u610"}, {"name": "メーリス", "text": "その次は攻撃力を高めた集団を相手に、\nそして最後はこっちの『出撃コスト』が回復しない\n特殊な状況での対応力を見る……っと。", "face": "u609"}, {"name": "メーリス", "text": "そうなると、終盤に向けて『出撃コスト』を\n貯めておくべきね。ソルジャーやワルキューレの\n皆の力を借りるといいかしら……。", "face": "u609"}, {"name": "レーレン", "text": "きちんと予習はしてきただろ？\nお前たちならきっと大丈夫さ。\nさぁて、じゃあまずは王子に模範例を見せてもらうぜ。", "face": "u614"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "レーレン", "text": "王子自らが手本を見せてくれるんだ。\nしっかり技を見て覚えるんだぞ？", "face": "u614"}, {"name": "ジョヴァンニ", "text": "最初は防御を固めた相手、だっけか。\n防御力の高い敵への対処法……。\n王子はどう出るんだ……！？", "face": "u611"}, {"name": "ケイティ", "text": "それでは王子、これより期末試験実技の、\n模範戦闘を開始します！", "face": "u114"}]}, {"trigger": "battle", "at_sec": 64, "lines": [{"name": "ネーニャ", "text": "ここからは敵役の人の攻撃力があがるんだっけ。\nでも王子なら、安心して見ていられるね。", "face": "u610"}]}, {"trigger": "end", "lines": [{"name": "メーリス", "text": "最後は『出撃コスト』が回復しなくなるのよね？\nここまでにどれだけ余力を残す事が出来たのか、\n試されるっていうことね……。", "face": "u609"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "そこまで！　王子、お疲れ様でした！", "face": "u114"}, {"name": "ジョヴァンニ", "text": "すげぇぜ王子！\nやっぱ王子は本当にすげぇよ！", "face": "u611"}, {"name": "メーリス", "text": "やるじゃない、\n王子のこと、ちょっと見直したわ。", "face": "u609"}, {"name": "ネーニャ", "text": "そんな事言って、王子なら楽勝って言ってたの、\nちゃーんと聞いてたけどね♪", "face": "u610"}, {"name": "メーリス", "text": "そういうところは聞かなくていいの！", "face": "u609"}, {"name": "レーレン", "text": "ほらほら、喧嘩するなって。\nそろそろお前達の試験の時間だぞ。", "face": "u614"}, {"name": "ケイティ", "text": "それでは、試験本番に移りましょうか。\n王子、模範例の演武、ありがとうございました！", "face": "u114"}]}], "active": true}