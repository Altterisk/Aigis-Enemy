{"quest_id": 6655, "name": "王国学園の期末試験", "description": "学園の実技試験で模範演武を披露せよ！\n＜特定タイミングで敵の攻撃アップ、\n防御アップ、出撃コストの自然回復なし＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["特定タイミングで敵の攻撃アップ、\n防御アップ、出撃コストの自然回復なし"], "event": "ゴールドラッシュ22(2018)", "event_category": "Reproduce", "mission_id": 300217, "map_no": 3457, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [120], "expression": "(IsStageFlag( 2) == 1);", "expression_human": "(stage flag 2 is set)"}, {"kind": "term", "influence": 11, "params": [300], "expression": "(IsStageFlag( 1) == 1);", "expression_human": "(stage flag 1 is set)"}, {"kind": "term", "influence": 30, "expression": "(IsStageFlag( 0) == 1);", "expression_human": "(stage flag 0 is set)"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 121, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097392, "race_id": 16, "master_id": 30409, "global_id": 4028, "route_behaviour": {"sets_flags": [[1, 1, 550]]}}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "tags": ["サムライ"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_co