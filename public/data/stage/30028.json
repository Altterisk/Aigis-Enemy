23707, "spawn_sec": 574}, {"enemy_id": 45, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112560, "race_id": 18, "master_id": 23718, "spawn_sec": 579}, {"enemy_id": 46, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 13000, "attack": 900, "base_hp": 13000, "base_attack": 900, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112544, "race_id": 18, "master_id": 23717, "spawn_sec": 583}, {"enemy_id": 47, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 17500, "attack": 1500, "base_hp": 17500, "base_attack": 1500, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 23709, "ranged": true, "spawn_sec": 583}, {"enemy_id": 48, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 25000, "attack": 1200, "base_hp": 25000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 23711, "spawn_sec": 622}], "popups": ["ゴースト村少年は\n撃破数に含まれません。\n\nゴースト村少年がいる間は、\n全てのアンデッドの攻撃と防御が\nアップします。", "ゴースト村娘は\n撃破数に含まれません。\n\nゴースト村娘がいる間\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ソーマ", "text": "……王子、村があります。\nでも、地図ではこの辺りには何もないはずでは……。", "face": "u2178a1"}, {"name": "ケイティ", "text": "道を間違えたのでしょうか？\n今の地図と、周囲の地形は合っているのですが。", "face": "u2433a1"}, {"name": "アルティア", "text": "少々お待ちを。\n……ああ、こちらの地図には載っていますね。", "face": "u2891a1"}, {"name": "リカルド", "text": "おっと……やけに古い地図だな。\nいったいいつの時代のものなんだ？", "face": "u205"}, {"name": "アルティア", "text": "倉庫で見つけた、千年戦争の頃の地図の写しです。\nこの写し自体もかなり古いものですけどね。", "face": "u2891a1"}, {"name": "アンナ", "text": "ということは、千年も前の村が、今も……？\n廃村というには、家々がきれいすぎるような。"}, {"name": "ソーマ", "text": "はい。でも……静かすぎませんか？\n家はこんなにあるのに、\n話し声も、誰かが働く音も聞こえません。", "face": "u2178a1"}, {"name": "アルティア", "text": "……誰も暮らしていないのでしょうか。\n王子、慎重に調べた方がよさそうです。", "face": "u2891a1"}, {"name": "ソーマ", "text": "あっ、あそこに人が！\nすみません、少しお尋ねしたいことが――", "face": "u2178a1"}, {"name": "シャルロット", "text": "待ってください。\nあの方の身体……向こう側が透けていますわ！？", "face": "u2827a1"}, {"name": "アリサ", "text": "亡霊……？\nそれに、こちらへ近づいて……っ！", "face": "u24"}, {"name": "アルティア", "text": "王子、お気をつけください！\nどうやらこちらに敵意があるようです！", "face": "u2891a1"}, {"name": "アンナ", "text": "……今は、目の前の敵を退けましょう。\nこのままでは、捜索もままなりません。"}, {"name": "ケイティ", "text": "王子、大討伐ミッションを開始します！\n亡霊たちを退け、村の安全を確保しましょう！", "face": "u2433a1"}]}, {"trigger": "end", "lines": [{"name": "アルティア", "text": "……追撃はありません。\n王子、ひとまずこの場を離れられそうです。", "face": "u2891a1"}, {"name": "ソーマ", "text": "あの、こちらを……。\n捜索願に書かれていた、行方不明者の持ち物が、\n村の中に落ちていました。", "face": "u2178a1"}, {"name": "アンナ", "text": "では、行方不明になった方々は、\nやはりこの村へ……。"}, {"name": "アルティア", "text": "道に迷い、人家を見つけて助けを求めたのでしょう。\nですが、そこで待っていたのは……。", "face": "u2891a1"}, {"name": "ソーマ", "text": "……あの亡霊たち、だったんですね。", "face": "u2178a1"}, {"name": "アンナ", "text": "失踪事件の原因は、この村にあったのですね。\nこれ以上、知らずに立ち入る人が出ないよう、\nすぐに周辺の村へ知らせなければなりません。"}, {"name": "ソーマ", "text": "でも、行方不明になった皆さんは、まだ……。\nこのまま捜索を終えるわけには……。", "face": "u2178a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "ええ。捜索は続けます。\nまずはこの村への立ち入りを禁じ、\n調査の準備を整えましょう。"}, {"name": "アルティア", "text": "……それに、気になることがあります。\n亡霊だけならともかく、\nどうして家々まで昔の姿を留めていたのでしょう。", "face": "u2891a1"}, {"name": "アリサ", "text": "誰も暮らしていないのに、\nまるで村が誰かの帰りを待っているみたいでした……。", "face": "u24"}, {"name": "アルティア", "text": "王子、ひとまず王国へ戻りましょう。\nこの村で何が起きたのか、必ず突き止めなくては。", "face": "u2891a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "route", "lines": [{"name": "アンナ", "text": "王子、彼の妄執を、ここで終わらせてあげましょう。"}, {"name": "シンディ", "text": "……騎士の姿が、消えていきます。", "face": "u1098a1"}, {"name": "アルティア", "text": "……あっ……思い出しました。\nあの地図と一緒に見つけた書物に、\n滅びた村を守っていた騎士の記録があったんです。", "face": "u2891a1"}, {"name": "ソーマ", "text": "村を守っていた……。\nでは、あの騎士が……？", "face": "u2178a1"}, {"name": "アルティア", "text": "千年戦争の頃、この地に偶然、魔界への門が開いた。\nそこからあふれた魔物に襲われ、\n村は一人の生存者もなく滅ぼされたそうです。", "face": "u2891a1"}, {"name": "アルティア", "text": "村を守っていた名高い騎士は、\n魔王軍との戦いで村を離れていたそうです。\n異変を知って駆け戻った時には、もう……。", "face": "u2891a1"}, {"name": "ソーマ", "text": "……さっき私たちが見たのは、\nその時の出来事だったんですね。", "face": "u2178a1"}, {"name": "アルティア", "text": "村人たちを失った騎士は、悲嘆のあまり、\n自ら命を絶った……と、記されていました。", "face": "u2891a1"}, {"name": "アンナ", "text": "それで、守れなかった村で、\nあの日を繰り返していたのでしょうか……。"}, {"name": "ソーマ", "text": "あの方も、きっと誰かを守りたくて、\n剣を取ったんですよね。", "face": "u2178a1"}, {"name": "ミレイユ", "text": "王子、散り際の彼の目を見ましたか？", "face": "u2626a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ミレイユ", "text": "きっと、彼なりに整理がついたのでしょう。\nもしかしたら、王子が英雄王の末裔だと、\nあの短い戦いの中で気付いたのかもしれません。", "face": "u2626a1"}, {"name": "アンナ", "text": "…………。"}, {"name": "アンナ", "text": "王子、村が少しずつ、消えていきます。"}, {"name": "ソーマ", "text": "あっ、向こうに倒れてる人が。\nもしかして、行方不明になっていた方でしょうか？", "face": "u2178a1"}, {"name": "アリサ", "text": "…………！\nまだ息があります！\n他の方も急いで捜索しましょう！", "face": "u24"}, {"name": "アリシア", "text": "……どういうことだと思いますか？", "face": "u2558a1"}, {"name": "ミレイユ", "text": "彼も人々を殺したかったわけではないのでしょう。\n守るべき村に、外部からやってきた者がいたから、\n仕方なく閉じ込めていた、とか。", "face": "u2626a1"}]}], "active": true}