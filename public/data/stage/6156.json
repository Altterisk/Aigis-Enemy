{"quest_id": 6156, "name": "虹色サーキット", "description": "虹色に輝くサーキットを、\n縦横無尽に駆けるくぐつ達。\n熾烈極まるレースの結果を見届けよ！\n神級（★１獲得の目安：平均Lv50）", "event": "スカイ・レーサー", "event_category": "History", "mission_id": 920092, "map_no": 3997, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "tags": ["機械"], "hp": 200000, "attack": 600, "base_hp": 200000, "base_attack": 600, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 110, "attack_interval": 245, "move_speed": 2200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110832, "race_id": 9, "special_effect_id": 82, "change_to": 1, "missile_id": 6, "master_id": 30391, "global_id": 4010, "ranged": true, "to_global_id": 4011, "spawn_sec": 19}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械"], "hp": 200000, "base_hp": 200000, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 30, "attack_speed": 30, "attack_wait": 110, "attack_interval": 275, "move_speed": 2700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110880, "race_id": 9, "special_effect_id": 82, "change_to": 2, "missile_id": 6, "master_id": 30392, "global_id": 4011, "to_global_id": 4012}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["機械"], "hp": 200000, "attack": 600, "base_hp": 200000, "base_attack": 600, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 110, "attack_interval": 245, "move_speed": 2700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110848, "race_id": 9, "special_effect_id": 175, "missile_id": 6, "master_id": 30393, "global_id": 4012, "ranged": true}, {"enemy_id": 4, "source": "local", "count":