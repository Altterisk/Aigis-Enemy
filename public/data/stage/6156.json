"race_id": 16, "special_effect_id": 242, "master_id": 30363, "global_id": 3982, "spawn_sec": 19}, {"enemy_id": 11, "source": "local", "count": 66, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 19}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 41}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 50}, {"enemy_id": 14, "source": "local", "count": 8, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 90}, {"enemy_id": 15, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097952, "race_id": 9, "change_to": 15, "change_condition": 1, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 54, "global_id": 53, "ranged": true, "variants": [{"hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 24, "attack_wait": 1, "attack_interval": 51, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097968, "race_id": 9, "master_id": 55, "global_id": 54}], "spawn_sec": 116}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 163}], "popups": ["くぐつに搭乗したゴブリンクイーンは\n長射程の遠距離攻撃を行います。\n\nまた、ゴブリンクイーンは\n拠点に向かわず、\n倒さなくても★の評価には影響\nしません。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンクイーン", "text": "んまぁ～～～～。\nなんてレインボーなレース会場なの！\nオーダー通りよ！　やるじゃない博士！", "face": "l86fc49ed0f43"}, {"name": "ゴブリンプリンセス長女", "text": "今度は、何色のくぐつに賭けようかしら。\n黒も速そうだし……でも赤も……\nう～ん悩ましいわぁ。", "face": "l01370a5b793f"}, {"name": "ゴブリンクイーン", "text": "人間の子、なかなかやるみたいだし、\n次もあの子に賭けちゃおうかしらぁ。\n何だかファンになってきたわぁ！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "ク……クイーン様！！！\nお戯れも程ほどにしてクダサイ！！！", "face": "l16b6c88b22e6"}, {"name": "ゴブリン博士", "text": "飛行型くぐつの技術ハ、全て私が手に入れましタ。\nこれ以上人間を生かす意味などありませン！", "face": "l16b6c88b22e6"}, {"name": "ゴブリン博士", "text": "ここでアイツを殺しておけば、\nこの技術はゴブリン軍だけのもの……即チ、\nゴブリン軍は圧倒的強者となるノデス！", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "そうねぇ……でも、\n最終レースまで勝ち残ったら解放するって\n約束しちゃったしねぇ……。", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "人間共との約束なド、守る必要ありませン！", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "何を言ってるの？　博士。\n他人を操っても嘘はつかない。それが私のポリシー。\n私は約束を破った事はないし、これからもないわ。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "博士、ターボ搭載のくぐつを用意なさい！\n次のレース……私が出るわ！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "へ？　タ、ターボ……ですカ……？\nし、しかシくぐつの重量を無視した装置ハ……。", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "次のレースは、１位以外は全員処刑よ！\n私自らが、あの人間を処刑台に送ってやるわぁ！\nウフフフフフ。", "face": "l86fc49ed0f43"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンクイーン", "text": "――このポンコツ！　さっさと進みなさい！！\n……ふぅ……やっと動き出したわね。\n……あら？　ちょっと、高度が落ちてきてるわよ。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "ちょっと、止まりなさいこのポンコツ。\nそっちはコースじゃ……ちょ、ちょっと\n止まりなさい、こ、このままじゃ……ッ！？", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "あぁぁ～～～れぇぇぇ～～～～～ッ！！！！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "――く、クイーン様が……。\n奈落に……落ちてしまわれた……。", "face": "l16b6c88b22e6"}, {"name": "ゴブリンプリンセス長女", "text": "そ、そんな……。", "face": "l01370a5b793f"}, {"name": "ゴブリンプリンセス次女", "text": "お母さま！　嘘ですわ！！\nこんな、こんなことって……！", "face": "l298a0df0624c"}, {"name": "ゴブリンプリンセス三女", "text": "お母さま……う、うぅっ…………。", "face": "l7a8fa61fd429"}, {"name": "ゴブリンプリンセス長女", "text": "……貴女達、しっかりしなさい。\nお母さまがいなくなった今、私達三姉妹で\nゴブリン達を率いて行かなきゃいけないのよ。", "face": "l01370a5b793f"}, {"name": "ゴブリンプリンセス長女", "text": "……人間、命拾いしたわね。\n今は大人しくこの場を去ってあげる。\nただ忘れないことね。ゴブリンは不滅よ。", "face": "l01370a5b793f"}, {"name": "アンナ", "text": "……行ってしまわれました。\n何はともあれ、お疲れ様です、ティアルさん。\n無事レースを切り抜ける事ができて良かったです……。"}, {"name": "ティアル", "text": "うん！　それもこれも、\n皆と先生のおかげだね。\nありがとう！", "face": "u505"}, {"name": "ケイティ", "text": "我々は特に何もしていませんよ。\nレースの妨害を狙う、\n不届きな輩を成敗したにすぎません。", "face": "u114"}, {"name": "ボリス", "text": "そうだぜ。レースを勝ち抜いたのは正真正銘お前と、\nお前の作ったそのくぐつの力だ……少し見ない間に、\nいいもん作るようになったじゃねぇか。", "face": "u360"}, {"name": "ティアル", "text": "せ、先生……！", "face": "u505"}, {"name": "ボリス", "text": "……が、まだまだだな。俺だったら、\nもっと速く作る事だってできらぁ。", "face": "u360"}, {"name": "ティアル", "text": "え、えぇ！？　この子をもっと速く！？", "face": "u505"}, {"name": "ボリス", "text": "おう、出来らぁ。貸してみな、\nここをこうしてだな……。", "face": "u360"}, {"name": "ティアル", "text": "ふわぁ……凄い……こんな発想、\n私にはとても……流石ボリス先生です！", "face": "u505"}, {"name": "ボリス", "text": "はん、まだまだ弟子には負けてらんねぇっての。\n……よっし、お前のお陰でこっちも燃えて来たぜ。\nコイツを仕上げたら、次はもっとすげぇのでも作るか！", "face": "u360"}, {"name": "ティアル", "text": "わ、私もお手伝いさせて頂きます！！\n今後ともご指導のほど、\nよろしくお願い致します！！", "face": "u505"}]}, {"trigger": "route", "lines": [{"name": "ゴブリンクイーン", "text": "あら？　何かしらこの煙……？", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "あ、あぁ……やはり設計に無理が……。\nく、クイーン様！　くぐつの耐久がもちません、\n今すぐレースを棄権されて下さイ！", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "この私に棄権ですって？　ありえないわ！\nこんなもの、叩けば直るに決まってるわよ！", "face": "l86fc49ed0f43"}]}], "active": true}