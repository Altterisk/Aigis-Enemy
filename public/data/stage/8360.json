{"quest_id": 8360, "name": "魔界の雪だるま", "description": "王子たちに少し配慮した戦神コロッセウム。\n最初の挑戦者はキングオブ雪だるま！？\n＜雪だるまキングがいる間吹雪が発生＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["雪だるまキングがいる間吹雪が発生"], "event": "モンスターズアッセンブル", "event_category": "History", "mission_id": 920220, "map_no": 7148, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 37, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "change_to": 1, "master_id": 37850, "global_id": 11467, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 61}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_speed": 50, "attack_wait": 30, "attack_interval": 165, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "change_to": 3, "master_id": 37846, "global_id": 11463, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 110}, {"enemy_id": 5, "source": "local", "count": 7, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 1483, "change_to": 5, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 37844, "global_id": 11461, "ranged": true, "to_global_id": 11462, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 110}, {"enemy_id": 5, "source": "local", "c