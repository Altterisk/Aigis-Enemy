 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 44, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2097200, "special_effect_id": 1814, "master_id": 37882, "global_id": 11499, "spawn_sec": 115}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 2, "hp": 9500, "attack": 550, "base_hp": 9500, "base_attack": 550, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 100, "attack_speed": 300, "attack_wait": 90, "attack_interval": 343, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155568, "race_id": 5, "special_effect_id": 1810, "change_to": 10, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 37848, "global_id": 11465, "ranged": true, "to_global_id": 11466, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 122}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 9500, "attack": 550, "base_hp": 9500, "base_attack": 550, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 100, "attack_speed": 300, "attack_wait": 90, "attack_interval": 343, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155568, "race_id": 5, "special_effect_id": 1811, "change_to": 9, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 37849, "global_id": 11466, "ranged": true}], "popups": ["雪だるまキングがいる間は\n悪天候『吹雪』が発生します。", "　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇"], "dialogue": [{"trigger": "start", "lines": [{"name": "アイネ", "text": "──改めて、此度の司会進行を務めるアイネと申します。", "face": "u2262a1"}, {"name": "アイネ", "text": "これから王国の皆様には、\n魔界で行われた厳しい予選を勝ち抜いた、\n三名の挑戦者と順々に戦っていただきます。", "face": "u2262a1"}, {"name": "アイネ", "text": "どの挑戦者も一筋縄ではいかない強敵ばかりですので、\n勝利の暁にはマレス様からの加護が授けられるでしょう。", "face": "u2262a1"}, {"name": "アンナ", "text": "……アイネさん、すごく落ち着いた方ですね。\n戦神マレスの無茶振りに少しも動じていません。"}, {"name": "ウルカノ", "text": "アイネは筋金入りのマレス教徒だからなぁ。\n長いことあいつの副官として働いてるだけあって、\nああ見えて中身は戦いのことしか考えてないぞ。", "face": "u1669a1"}, {"name": "アイネ", "text": "お言葉ですが、ウルカノ様。\n私は何と言われようと構いませんが、\n我が主への侮辱は看過できません。", "face": "u2262a1"}, {"name": "アイネ", "text": "マレス様は戦神としての圧倒的武威のみならず、\n誰より優しく、叡智にも富んだ思慮深い御方です。", "face": "u2262a1"}, {"name": "ユリクセス", "text": "誰か、シャルロットを呼んできてくれ。\n明らかに支離滅裂な言動が見受けられる。", "face": "u2193a1"}, {"name": "ウルカノ", "text": "洗脳はされてないから安心しろ。元からだよ。", "face": "u1669a1"}, {"name": "アイネ", "text": "──時間です、最初の挑戦者を紹介しましょう。\n彼こそは魔界の冬を担う者、キングオブ雪だるま。", "face": "u2262a1"}, {"name": "アイネ", "text": "その名も雪だるまキング。", "face": "u2262a1"}, {"name": "ユキヒメ", "text": "すごい、そのまま……！", "face": "u667"}, {"name": "しづり", "text": "ほう……次代冬将軍たるわらわの前で雪の王を名乗るか。", "face": "u2049a1"}, {"name": "ウルカノ", "text": "雪だるまの王な、結構違うぞ。", "face": "u1669a1"}, {"name": "アイネ", "text": "気の抜けた見た目に油断なさらぬよう。\n彼の王は気候を自由自在に操ります、\n吹雪を止めたくば王を倒すことです。", "face": "u2262a1"}, {"name": "アイネ", "text": "それでは、開戦です。", "face": "u2262a1"}]}, {"trigger": "end", "lines": [{"name": "しづり", "text": "ふむ、ざっとこんなものよな。", "face": "u2049a1"}, {"name": "アンナ", "text": "エリザ、怪我はありませんか？"}, {"name": "エリザ", "text": "大丈夫よ、アンナ。\n王国の冬を担う一族として、\n吹雪の中で後れは取らないわ。", "face": "u198"}, {"name": "ウルカノ", "text": "うーし、この調子で次もさっさと片付けるかぁ！", "face": "u1669a1"}, {"name": "アイネ", "text": "（あの雪だるまキングがこうも容易く……）", "face": "u2262a1"}, {"name": "アイネ", "text": "なるほど、マレス様が気に入るだけのことはありますね。", "face": "u2262a1"}, {"name": "アイネ", "text": "ですが、次の挑戦者はどうでしょう。", "face": "u2262a1"}, {"name": "アイネ", "text": "戦場を疾走する黒き風、あなた方に止められますか？", "face": "u2262a1"}]}], "active": true}