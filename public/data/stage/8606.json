transform_resist": 100, "pattern_id": 2120784, "race_id": 5, "special_effect_id": 450, "master_id": 32092, "global_id": 5711, "spawn_sec": 199}, {"enemy_id": 8, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "tags": ["機械"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 120, "attack_wait": 60, "attack_interval": 224, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120704, "race_id": 2, "special_effect_id": 449, "change_to": 8, "missile_id": 414, "missile": {"speed": 10.0, "splash": 80}, "master_id": 32091, "global_id": 5710, "ranged": true, "to_condition": 0, "to_global_id": 5713, "spawn_sec": 243}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_wait": 60, "attack_interval": 224, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120768, "race_id": 2, "special_effect_id": 449, "change_to": 7, "missile_id": 414, "missile": {"speed": 10.0, "splash": 80}, "master_id": 32094, "global_id": 5713, "from_condition": 0}], "popups": ["オルカレクスは\n攻撃力1000以下の\nあらゆる攻撃を受け付けません。", "おもちゃなどの一部の敵は、\n攻撃力が一定値以下の\nあらゆる攻撃を受け付けません。\n\nまた、一部の敵は倒されると\n自身の周囲にダメージを与えます。\n　　　　　　(1/2)", "無効化される攻撃力の上限\n\nミニメカクラブウォーリア：200\nミニメカドラゴン：200\nシャチのギルマン：500\nミニメカシャチのおもちゃ：500\nミニメカゴーレム：800\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "オルカレクス", "text": "――まさか、王国軍から挑戦状が送られてくるとは。", "face": "ld7ef6a899527"}, {"name": "オルカレクス", "text": "世界征服を目指す我がオルカ科学ラボと、\nついに雌雄を決しようというわけか。", "face": "ld7ef6a899527"}, {"name": "シャチのギルマン", "text": "キュケケ、決戦ですね、総統！", "face": "l57b986b108f8"}, {"name": "オルカレクス", "text": "あぁ、決戦だ。\nレギュレーションは前回と違い水上だが、\nルールは変わらず、オーナーも参加ＯＫの全力バトル！", "face": "ld7ef6a899527"}, {"name": "オルカレクス", "text": "いくぞ、王国軍！\nミニメカバトル……ファイッ！", "face": "ld7ef6a899527"}, {"name": "スーシェン", "text": "オルカ科学ラボがリゾートに……いえ、\n王国軍に向かって攻めて来ているようです。", "face": "u2486a1"}, {"name": "コウメ", "text": "……私たち、なんかやりましたかね？", "face": "u2490a1"}, {"name": "サクヤ", "text": "分かりませんが、あちらはミニメカを展開しています。\n話を聞くには、ミニメカバトルで勝つしかないでしょう。", "face": "u2489a1"}, {"name": "オルカレクス", "text": "キュケー！　我らが仇敵よ！\n今日こそお前たちを倒してやろう！", "face": "ld7ef6a899527"}]}, {"trigger": "end", "lines": [{"name": "イヴリール", "text": "それで、お前たちはどうして急に\n王国軍に襲いかかってきたんだ？", "face": "u2488a1"}, {"name": "オルカレクス", "text": "……何を言っている？\n他ならぬ王国が我らに挑戦状を送りつけてきただろう。", "face": "ld7ef6a899527"}, {"name": "アージェ", "text": "挑戦状？", "face": "u2487a1"}, {"name": "オルカレクス", "text": "まさか、本当に分からないのか？\n我々は王国との決戦のつもりで来たのだぞ？", "face": "ld7ef6a899527"}, {"name": "クロノシア", "text": "それは申し訳ないのですが……。\nしかし私たちは本当に知らないので……。", "face": "u2484a1"}, {"name": "オルカレクス", "text": "こんな梯子の外し方があるか……？", "face": "ld7ef6a899527"}, {"name": "オルカレクス", "text": "……はぁ。深海からわざわざ上がってきたというのに。\nわけが分からないが、王国はその気ではないらしい。", "face": "ld7ef6a899527"}, {"name": "オルカレクス", "text": "骨折り損のくたびれ儲けとはこのことだ。\n仕方がない、気晴らしにそこのリゾートで遊んでから、\nラボに帰るとしよう。", "face": "ld7ef6a899527"}, {"name": "シャチのギルマン", "text": "ところで、どうしてこんなところに\nリゾート施設なんてものが建っているんだ？", "face": "l57b986b108f8"}, {"name": "ペルセナス", "text": "えっ、オルカ科学ラボが\nデモシェフ商会に頼んで作ってもらったんじゃないの？", "face": "u2482a1"}, {"name": "シャチのギルマン", "text": "デモシェフ商会だと！？\n奴らが関わっているというのか！", "face": "l57b986b108f8"}, {"name": "乙姫", "text": "聞いていた話と違うね。\n……なんだか、色んなことが食い違っているのかな。", "face": "u2483a1"}, {"name": "イコル", "text": "ひとまず各々の話を聞こう。\nいったい何が起こっているのか、\n情報を整理したほうが良さそうだ。", "face": "u2485a1"}]}], "map": {"image": "Map920235_9374", "w": 960, "h": 640, "spots": [{"k": "b", "x": 246, "y": 486}, {"k": "b", "x": 38, "y": 345}, {"k": "m", "x": 142, "y": 284, "id": 200}, {"k": "m", "x": 225, "y": 235, "id": 201}, {"k": "m", "x": 312, "y": 186, "id": 202}, {"k": "m", "x": 342, "y": 432, "id": 203}, {"k": "m", "x": 429, "y": 385, "id": 204}, {"k": "m", "x": 507, "y": 329, "id": 205}, {"k": "m", "x": 417, "y": 238, "id": 206}, {"k": "m", "x": 572, "y": 258, "id": 207}, {"k": "m", "x": 661, "y": 209, "id": 208}, {"k": "m", "x": 762, "y": 167, "id": 209}, {"k": "m", "x": 846, "y": 126, "id": 210}, {"k": "m", "x": 475, "y": 95, "id": 211}, {"k": "m", "x": 222, "y": 128, "id": 212}, {"k": "m", "x": 396, "y": 140, "id": 213}, {"k": "m", "x": 794, "y": 489, "id": 214}, {"k": "m", "x": 868, "y": 444, "id": 215}, {"k": "r", "x": 158, "y": 198, "id": 300}, {"k": "r", "x": 752, "y": 265, "id": 301}, {"k": "r", "x": 318, "y": 85, "id": 302}, {"k": "r", "x": 503, "y": 194, "id": 303}, {"k": "r", "x": 224, "y": 384, "id": 304}, {"k": "r", "x": 606, "y": 346, "id": 305}, {"k": "r", "x": 701, "y": 292, "id": 306}, {"k": "r", "x": 450, "y": 505, "id": 307}, {"k": "r", "x": 283, "y": 272, "id": 308}]}, "start_cost": 10, "active": true, "name_en": "Mysterious Challenge", "description_en": "An attack by the Orca Science Lab occurs. However, the target is not the resort facility, but the Royal Army enjoying their vacation...? Extreme (★1 Target: Avg Lv25)"}