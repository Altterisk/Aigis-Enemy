ge_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2106560, "race_id": 7, "change_to": 7, "master_id": 30344, "global_id": 3963, "to_global_id": 3962, "spawn_sec": 54}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "change_to": 6, "master_id": 30343, "global_id": 3962}, {"enemy_id": 4, "source": "local", "count": 14, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "spawn_sec": 57}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 2, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104832, "race_id": 7, "change_to": 3, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 576, "global_id": 575, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 576, "spawn_sec": 67}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "クラールフ", "text": "──これより、陸海合同演習を執り行う。", "face": "l4f2cca96e819"}, {"name": "フィーヌ", "text": "本合同演習の趣旨は、\n今後さらなる激化が予想される戦いに備え、\n各陣営の苦手を克服することにあります。", "face": "u1262a1"}, {"name": "フィーヌ", "text": "海だから動けない、陸だから戦えない。\nそんな言い訳も戦場には通用しません。", "face": "u1262a1"}, {"name": "フィーヌ", "text": "あらゆる戦況に適応する思考と肉体、\nその両方を鍛え上げていただきたいのです。\nそれではまず陸での戦闘から始めましょう！", "face": "u1262a1"}, {"name": "マーマン", "text": "王国軍よ、フィーヌはああ言っているが、\n海中でも十分に戦えている貴殿らに比べて、\n我々は水中以外では本領を発揮することができない。", "face": "l464b5eb15161"}, {"name": "マーマン", "text": "だが、世界の命運を懸けた戦いを前に、\nこれ以上海の中で傍観するだけなど御免だ。\n我らも地上でも戦えると、証明せねばならない。", "face": "l464b5eb15161"}, {"name": "マーマン", "text": "さあ構えろ、誇り高き王国の戦士たちよ。\nクラールフ様の手前、無様な姿も見せられん。\n魚人の全霊を以て、貴殿らに挑ませてもらう。", "face": "l464b5eb15161"}, {"name": "レアン", "text": "ほう、気合が入っているじゃないか。\nであれば、こちらも全力で迎え撃とう。", "face": "u50"}, {"name": "フィーヌ", "text": "双方準備はよろしいですね！\nそれではいざ！　開戦でーす！", "face": "u1262a1"}]}, {"trigger": "end", "lines": [{"name": "フィーヌ", "text": "そこまでー！　そこまででーす！", "face": "u1262a1"}, {"name": "マーマン", "text": "やはりそう簡単には行かぬか……。", "face": "l464b5eb15161"}, {"name": "レアン", "text": "まあこちらも地上での戦いで、\n魚人に負けては立つ瀬がないからな。\nだが、凄まじい気迫を感じたぞ。", "face": "u50"}, {"name": "カノン", "text": "私も想定以上に迫られたから、\n焦って何発か砲弾を外しちゃったわ。\n気を引き締め直さないといけないわね。", "face": "u264"}, {"name": "オーベッド", "text": "然り。同胞よ、敗北を嘆く必要はない。\nこれを糧として、次に活かせば良いだけの話。\n我らが乾いた地の力になれる日は、必ず来る。", "face": "u1122a1"}, {"name": "マーマン", "text": "オーベッド……ああ、そうだ、その通りだ。\n魚人の誇りに懸け、このままでは終わらん。", "face": "l464b5eb15161"}, {"name": "チヨメ", "text": "みなさん、素晴らしい向上心ですねぇ……\nうちのお姫さんにも見習ってほしいぐらいです。", "face": "u1144a1"}, {"name": "フィーヌ", "text": "ふふっ、お互い良い刺激になっているみたいですね。", "face": "u1262a1"}, {"name": "フィーヌ", "text": "それではみなさん！\n少しの休憩を挟みまして、\n演習を続けて行きましょー！", "face": "u1262a1"}]}], "active": true}