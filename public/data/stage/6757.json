{"quest_id": 6757, "name": "大鎌の猛虫", "description": "王子一行の道を阻むべく女王蜘蛛の配下が\n襲い掛かる。動きを封じる蜘蛛の糸に\n加え、未知の増援にも警戒せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "世界樹に巣食う妖虫", "event_category": "History", "mission_id": 920127, "map_no": 3407, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 1, "hp": 6000, "attack": 200, "base_hp": 6000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2116704, "race_id": 18, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 31399, "global_id": 5018, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 11}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 30}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 2, "hp": 21000, "attack": 1200, "base_hp": 21000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 350.0, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118480, "race_id": 18, "change_to": 4, "change_condition": 2, "master_id": 31715, "global_id": 5334, "to_condition": 2, "to_global_id": 5335, "spawn_sec": 82}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10500, "attack": 800, "base_hp": 10500, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_range": 260, "attack_speed": 1, "attack_wait": 20, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118496, "race_id": 18, "missile_id": 351, "missile": {"speed": 10.0}, "master_id": 31716, "global_id": 5335, "ranged": true, "from_condition": 2}, {"enemy_id": 6, "source": "local", "count": 13, "form_count": 1, "hp": 3000, "attack": 220, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118448, "race_id": 18, "special_effect_id": 372, "change_to": 6, "change_condition": 1, "master_id": 31713, "global_id": 5332, "variants": [{"hp": 3000, "attack": 220, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118464, "race_id": 18, "master_id": 31714, "global_id": 5333}], "spawn_sec": 101}, {"enemy_id": 8, "source": "local", "count": 9, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 155}], "dialogue": [{"trigger": "start", "lines": [{"name": "シュシュ", "text": "…………うぇえええっ、\nべとべとですぅぅぅっ！？", "face": "u656"}, {"name": "エイル", "text": "お、お姉ちゃんっ、王子さまぁっ！？\nこの糸べとべとで、わわっ、絡まっちゃいますぅ！？", "face": "u804"}, {"name": "キャロップ", "text": "――シュシュとエイルが試してくれたけど、\nどうやら粘性の高い糸を放つ蜘蛛が、\nすぐ近くにいるみたいだね。", "face": "u698"}, {"name": "クゥイル", "text": "しかし巣を作っているというわけでも無いようですね。\n私達の動向を察知して、\n女王蜘蛛が派遣したということでしょうか……。", "face": "u702"}, {"name": "アリア", "text": "戦闘中にこの糸を吐きかけられたら、\n攻撃どころではなくなってしまいそうですね。", "face": "u75"}, {"name": "バイン", "text": "ほらシュシュ、エイル、\nいつまで絡まって遊んでるの？\nぴょぴょーんと抜け出しちゃって？", "face": "u712"}, {"name": "エイル", "text": "踏んだり蹴ったりです……ぐすん……。", "face": "u804"}, {"name": "シュシュ", "text": "――ふぇ、ほ、ほんとに踏んだり蹴ったりかもです。\n遠くからカサカサって足音が聞こえますよぉ！", "face": "u656"}, {"name": "アリア", "text": "さっそく蜘蛛のお出ましですね。\n王子、指揮をお願いします！", "face": "u75"}]}, {"trigger": "battle", "at_sec": 88, "lines": [{"name": "アリア", "text": "――王子！　新手の魔物が現れました！！", "face": "u75"}, {"name": "エイル", "text": "あれはキラーマンティス……！！\n女王蜘蛛の配下の、強力な虫です……！！", "face": "u804"}, {"name": "エイル", "text": "今は地上を歩いていますが、\nいざとなれば空を飛んできますよー！！", "face": "u804"}]}, {"trigger": "end", "lines": [{"name": "エイル", "text": "いたたた……危ないところでしたぁ……。", "face": "u804"}, {"name": "アンナ", "text": "何とか虫の群れを退けましたね……。\nしかし、女王蜘蛛にあれほど強力な配下が\nいるとは……これは気が抜けません。", "face": "l9f66f32fc465"}, {"name": "フィリス", "text": "でもエイルの知識のおかげで助かったよ。\n世界樹防衛の先行部隊に選ばれたのも、\nやっぱエイルの実力ゆえってことだな。", "face": "u40"}, {"name": "エイル", "text": "……えへっ、そうです？　そうですよね？\nえへへ、えへぇ……♪", "face": "u804"}, {"name": "アリア", "text": "やれやれ……。\nけれどキラーマンティスの情報を得ていたのは、\n確かにエイルのお手柄だったかもしれませんね。", "face": "u75"}, {"name": "アンナ", "text": "それでは王子、この先にも\n何が待ち受けているかわかりません。\n態勢を立て直してから奥へ進みましょう。", "face": "l719c3a89f3cd"}]}], "active": true}