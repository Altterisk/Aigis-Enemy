count": 3, "form_count": 2, "hp": 7000, "attack": 250, "base_hp": 7000, "base_attack": 250, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_to": 8, "change_condition": 4, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38793, "global_id": 12410, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 12409, "spawn_sec": 53}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 7000, "attack": 350, "base_hp": 7000, "base_attack": 350, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_to": 7, "change_condition": 4, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38792, "global_id": 12409, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "tags": ["黒輪"], "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_speed": 50, "attack_wait": 30, "attack_interval": 165, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "special_effect_id": 2075, "change_to": 10, "change_condition": 2, "master_id": 38779, "global_id": 12396, "to_condition": 2, "to_global_id": 12397, "spawn_sec": 113}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "attack_speed": 50, "attack_wait": 20, "attack_interval": 145, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "special_effect_id": 2076, "master_id": 38780, "global_id": 12397, "from_condition": 2}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 2, "tags": ["黒輪"], "hp": 3000, "attack": 240, "base_hp": 3000, "base_attack": 240, "damage_type": "magical", "armor_defense": 50, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 2075, "change_to": 12, "change_condition": 2, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38777, "global_id": 12394, "ranged": true, "to_condition": 2, "to_global_id": 12395, "spawn_sec": 116}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 4500, "attack": 480, "base_hp": 4500, "base_attack": 480, "damage_type": "magical", "armor_defense": 100, "attack_range": 120, "attack_speed": 30, "attack_wait": 40, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 2076, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38778, "global_id": 12395, "ranged": true, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "ココロ", "text": "――時空の歪曲が酷くなってきた。\nこれ、『時の破片』の密度が高くなってきたんだ！", "face": "u364"}, {"name": "フィノーラ", "text": "僕を襲撃した仮面のやつも、\n『時の破片』を集めているはず。\nたぶん距離が近付いてきたってことだろうね。", "face": "u2441a1"}, {"name": "フィノーラ", "text": "それにしても驚いた。\n王国に、まさかクロノシア様がいるなんて。", "face": "u2441a1"}, {"name": "クロノシア", "text": "…………。", "face": "u1986a1"}, {"name": "ココロ", "text": "クロノシア様？　どうかした？\nもしかして体調悪いとか！？", "face": "u364"}, {"name": "クロノシア", "text": "いえ、先ほどから、\nどうにも違和感が拭いきれなくて。", "face": "u1986a1"}, {"name": "フィノーラ", "text": "違和感……？\n敵が『時の破片』で時間に干渉しているということか？", "face": "u2441a1"}, {"name": "トワ", "text": "時の魔法が行使されたなら、\n私たちが感知できるはずです。何か、他の原因ですか？", "face": "u336"}, {"name": "クロノシア", "text": "魔力ではない、何か別の要因……？\n時間をもう一度、やり直させられているような……。", "face": "u1986a1"}, {"name": "？？？", "text": "――さすがは時の女神。\n己の権能外の技術であってもその違和感に気付くとは。", "face": "lc099c04ad102"}, {"name": "フィノーラ", "text": "お前は……ッ！\n王子、あいつだ！　タイムスリープ装置を破壊し、\n『時の破片』を強奪した仮面の男！！", "face": "u2441a1"}, {"name": "？？？", "text": "……今度は殺しそこねましたか。\nなるほど、ますます計画の実現性が高まりました。", "face": "lc099c04ad102"}, {"name": "？？？", "text": "しかし、そのまま生存されては、\nいつかまた、邪魔が入るかもしれません。", "face": "lc099c04ad102"}, {"name": "？？？", "text": "時の監視者フィノーラ。\n超古代文明の遺物たるその叡智、\nここで終わらせておきましょう。", "face": "lc099c04ad102"}, {"name": "アヴリック", "text": "……わ、わわっ。\n大変です、もう周囲を囲まれてます！", "face": "u2443a1"}, {"name": "トワ", "text": "アヴリックさん、フィノーラさんをお願いします。\n王子、周囲は依然時の流れが乱れたままです。\n慎重な指揮をお願いします！", "face": "u336"}]}, {"trigger": "battle", "at_sec": 41, "lines": [{"name": "ココロ", "text": "――何なの？　この仮面のやつら！", "face": "u364"}, {"name": "トワ", "text": "黒冠の魔物も交じっています。\nどうやら、あの仮面の男が\nこの魔物たちを呼び寄せていたようですね。", "face": "u336"}, {"name": "？？？", "text": "……これが王国軍ですか。\nやはり美しさに欠ける。", "face": "lc099c04ad102"}, {"name": "？？？", "text": "――さて、これで全ての条件が整いました。", "face": "lc099c04ad102"}, {"name": "？？？", "text": "フィノーラ、あなたに恨みはありません。\nむしろ感謝すらしています。\nそれでも――ここで死んでもらいましょう。", "face": "lc099c04ad102"}, {"name": "アヴリック", "text": "フィノーラ様！", "face": "u2443a1"}, {"name": "フィノーラ", "text": "タダで死んでやるつもりはないんだけどな……。\nせめて名前だけでも名乗っておきなよ。", "face": "u2441a1"}, {"name": "フィノーラ", "text": "僕は死ぬかもしれないが、\nその名前を追って、僕の親友の後継者が、\n必ずお前の首をぶち砕きに行くからさ。", "face": "u2441a1"}, {"name": "？？？", "text": "良いでしょう。\n死にゆく者への餞別です。我が名は――", "face": "lc099c04ad102"}, {"name": "？？？", "text": "……そうですね、\nエンキドゥとでも名乗っておきましょう。", "face": "lc099c04ad102"}, {"name": "フィノーラ", "text": "随分と高尚な偽名もあったものだ。\n自分に悲劇を重ねるなんて、\nお前もロマンと自分に酔う口か。", "face": "u2441a1"}, {"name": "エンキドゥ？", "text": "それでは、さようなら。\nいつかの時代、冥界にて会いましょう。", "face": "lc099c04ad102"}, {"name": "アヴリック", "text": "や……。", "face": "u2443a1"}, {"name": "アヴリック", "text": "やめろ……フィノーラ様に……手を……っ、\nフィノーラ様に手をだすなぁぁぁぁッ！！", "face": "u2442a1"}, {"name": "トワ", "text": "……これは、神器の魔力？\nいったいどこから――", "face": "u336"}, {"name": "アヴリック", "text": "お前を！　殺す！　絶対殺す！\n綺麗事ばかり並べやがって！　絶対殺す！", "face": "u2442a1"}, {"name": "ウェンディ", "text": "……王子、ちょっと離れて。", "face": "u401"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "ウェンディ", "text": "あの子、認められたみたい。\nあのくぐつ――うぅん、機械人形に。", "face": "u401"}, {"name": "機械人形", "text": "――覚悟はできましたか？", "face": "l46916a40663a"}, {"name": "アヴリック", "text": "できた！　あいつを殺す！\nフィノーラ様を守る！　それから――", "face": "u2442a1"}, {"name": "アヴリック", "text": "――私も、戦う！！", "face": "u2442a1"}, {"name": "機械人形", "text": "――オーダーを受け付けました。\n神器機関を起動します。", "face": "l46916a40663a"}]}, {"trigger": "end", "lines": [{"name": "エンキドゥ？", "text": "――驚きました。\n神器機関の継承者は無能だと聞いていたのですが。", "face": "lc099c04ad102"}, {"name": "アヴリック", "text": "継承者とか、よくわからないですけど！\nぶっ殺す！　死ね！　フィノーラ様に手を出すなー！", "face": "u2442a1"}, {"name": "エンキドゥ？", "text": "……性格は正反対のようだ。", "face": "lc099c04ad102"}, {"name": "エンキドゥ？", "text": "しかし、乱戦になって助かりました。\nここまで距離を詰めることができた。", "face": "lc099c04ad102"}, {"name": "フィノーラ", "text": "……っ！\nまずい！　『時の破片』が共鳴して――", "face": "u2441a1"}, {"name": "エンキドゥ？", "text": "――参りましょう。始まりの場所へ。\nこれより始まる物語の、序章へ。", "face": "lc099c04ad102"}, {"name": "フィノーラ", "text": "転移に巻き込まれる！\n全員離れるな！", "face": "u2441a1"}, {"name": "アンナ", "text": "グリムさん、対抗手段は――", "face": "l6a3847bd5afd"}, {"name": "グリム", "text": "無理でーす！\nこれは次元転移でも時空転移でもなくて――", "face": "u942"}, {"name": "クロノシア", "text": "――時間が！　分断されます！！", "face": "u1986a1"}]}], "story_talk": true, "active": true}