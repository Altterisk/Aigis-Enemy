{"quest_id": 7356, "name": "オリュンポスへ向かって", "description": "障壁に向かう王子たちに敵が襲いかかる。\n<天界（弱）：攻撃力がダウン。\n　一部を除く敵味方のHPが徐々に回復>\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["天界（弱）：攻撃力がダウン。\n　一部を除く敵味方のHPが徐々に回復"], "event": "最後に残された信仰", "event_category": "History", "mission_id": 920163, "map_no": 5899, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -70]}, {"kind": "term", "influence": 41, "params": [0, 60, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 10, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 19, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124128, "race_id": 20, "change_to": 1, "change_condition": 4, "master_id": 32919, "global_id": 6536, "to_condition": 4, "to_ticks": 3, "to_global_id": 6539, "spawn_sec": 30}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124144, "race_id": 20, "special_effect_id": 222, "master_id": 32922, "global_id": 6539, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124192, "race_id": 20, "change_to": 5, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32923, "global_id": 6540, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6543, "spawn_sec": 75}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124208, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32926, "global_id": 6543, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 9, "source": "local", "count": 14, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 9, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{"wait": 60}], "sets_flags": [[11, 1, 60], [12, 1, 60]]}, "spawn_sec": 130}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_s