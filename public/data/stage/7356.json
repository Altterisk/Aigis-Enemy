o": 22, "change_condition": 4, "master_id": 33347, "global_id": 6964, "to_condition": 4, "to_ticks": 1, "to_global_id": 6965}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["アーマー"], "hp": 6400, "attack": 500, "base_hp": 6400, "base_attack": 500, "damage_type": "physical", "armor_defense": 480, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126928, "race_id": 20, "master_id": 33348, "global_id": 6965, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 24, "source": "local", "count": 5, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 24, "master_id": 873, "global_id": 872, "commands": {"raw": "SetStageFlag(1, 0);", "sets_flags": [[1, 0]]}, "route_behaviour": {"transforms": [{"wait": 60}], "sets_flags": [[1, 1, 60], [2, 1, 60], [3, 1, 60], [4, 1, 60], [5, 1, 60]]}, "spawn_sec": 202}, {"enemy_id": 26, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 550, "base_hp": 8000, "base_attack": 550, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105488, "race_id": 6, "special_effect_id": 215, "master_id": 30774, "global_id": 4393, "commands": {"raw": "SetStageFlag(8, 0);", "sets_flags": [[8, 0]]}, "route_behaviour": {"sets_flags": [[8, 1, 0]]}, "spawn_sec": 219}], "popups": ["こちらに敵の増援が向かっています。\n\n素早く敵を撃破することで、\n増援の到着を防ぐことができます。", "各種天界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。", "上位天使がいる間は\n全ての敵のHPが\n徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フローガ", "text": "――殿下、物質界からの魔力通信が入りました。\n世界各地の神殿、聖地の防衛ですが、\n既にいくつかの戦線が突破されているとのこと。", "face": "u878"}, {"name": "ノーマ", "text": "……ちっ。\n物質界連合がいくら最強でも、\n精神支配で手勢を増やせる敵とかインチキすぎない！？", "face": "u1047a1"}, {"name": "ローズ", "text": "こちらは支配された仲間に\n剣を向けなければならないわけですからね。\nどこまで行っても、こちらが不利な戦いです……。", "face": "u1264a1"}, {"name": "アンナ", "text": "後手に回ってしまった以上、\nもはや一刻の猶予もありません。\n今は障壁まで、一点突破で駆け抜けましょう。", "face": "l276c938aebac"}, {"name": "アナトリア", "text": "どちらを見ても敵ばかり……。\n完全に包囲されているように見えるのに、\nどうにも敵の攻勢がぬるいね。どうなっているんだい？", "face": "u522"}, {"name": "トラム", "text": "――天界における、内戦の影響ね。\nケラウノス様が力を失ってからは、\nどの勢力も覇権を取るために牽制しあっていたから。", "face": "u1110a1"}, {"name": "ユージェン", "text": "敵対勢力に睨みをきかせるために、\n薄く広く兵を展開してる、と……。", "face": "u906"}, {"name": "アイシャ", "text": "だからこそ、大規模な戦力を一点に集中すれば、\n敵の増援を振り切りながら戦うことができる。\n……内戦中の他の亜神に感謝しないとかな。", "face": "u181"}, {"name": "トゥアン", "text": "その代わりに、進軍の足を止めたら\n全周包囲されるということだぞ。\n……こういう綱渡りも嫌いじゃないけどな。", "face": "u1006a1"}, {"name": "アンブローズ", "text": "私は気が気じゃないですよぉ！？\nニミュエ！　そっちに怪我人がいます！\n回収してきてくださいー！", "face": "u1088a1"}, {"name": "ニミュエ", "text": "お任せください。\n誰も戦場に取り残したりしませんよ。\nひとりぼっちは寂しいですからね。", "face": "u1175a1"}, {"name": "ルイン", "text": "――そろそろ雑談の停止を進言します。\n前方に多数の天界兵を確認しました。", "face": "u1180a1"}, {"name": "ローズ", "text": "皆さん、傷は私たちが癒しますが、\n絶対に死ぬような無茶はしないでくださいね。", "face": "u1264a1"}, {"name": "リコラ", "text": "普段から無茶しちゃうのが王子の仲間だから、\nローズ、もっといっぱい言ってやって！！", "face": "u289"}, {"name": "ローズ", "text": "え、えっと、では……。\n生きて帰ってこないと許しませんよ！！\nめちゃくちゃ苦い薬草飲ませますからね！", "face": "u1264a1"}, {"name": "アナトリア", "text": "ははっ、苦い薬草は勘弁だ。\n――王子、増援到着前にケリをつけるよッ！！", "face": "u522"}]}, {"trigger": "end", "lines": [{"name": "アージェ", "text": "――陣形の崩壊を確認。\nマスター、このまま突破が可能です。", "face": "u1090a1"}, {"name": "ティアル", "text": "ローズちゃん！　怪我した人、回収してきたよ！\n――王子、このまま前方の索敵に出るね！", "face": "u505"}, {"name": "ローズ", "text": "わっ、あ、ありがとうございます！\nすぐに傷を治しますからね。", "face": "u1264a1"}, {"name": "アリア", "text": "オリュンポスの障壁まで、まだ距離がありますが……。\nこれならほぼ最大の戦力で到達できそうですね。", "face": "u75"}, {"name": "ソラス", "text": "油断は禁物ですよ。\n物質界に残してきた者たちにとって、\n私たちだけが唯一の希望なのですから。", "face": "u904"}, {"name": "アリア", "text": "私たちが……希望……。\nそうですね、気合を入れないと！", "face": "u75"}, {"name": "ウェンディ", "text": "このまま敵の包囲を突破するよ。\nシャール、タイミングは任せるから。", "face": "u401"}, {"name": "シャール", "text": "はいっ！　バトルタンク、\n次弾装填、砲撃――ってぇーッ！！", "face": "u763"}, {"name": "ウェンディ", "text": "機甲部隊、突撃。\n王子の道は、私たちで拓くよ。", "face": "u401"}, {"name": "リッカ", "text": "行きますよ王子、進軍です！！\nオリュンポスを目指しますよー！", "face": "u152"}]}, {"trigger": "end", "lines": [{"name": "大天使長", "text": "――ケラウノス様が、いない……？\nならば我らは、いったい誰の命令で……ぐぅっ……！？", "face": "la6505e1106eb"}, {"name": "大天使長", "text": "お前たち、撤退しなさい。\nこれ以上の戦闘は……くっ、\n何なのですか、この記憶は……ッ！？", "face": "la6505e1106eb"}, {"name": "アージェ", "text": "――大天使長の撤退を確認。\nマスター、このまま突破が可能です。", "face": "u1090a1"}, {"name": "ティアル", "text": "ローズちゃん！　怪我した人、回収してきたよ！\n――王子、このまま前方の索敵に出るね！", "face": "u505"}, {"name": "ローズ", "text": "わっ、あ、ありがとうございます！\nすぐに傷を治しますからね。", "face": "u1264a1"}, {"name": "アリア", "text": "オリュンポスの障壁まで、まだ距離がありますが……。\nこれならほぼ最大の戦力で到達できそうですね。", "face": "u75"}, {"name": "ソラス", "text": "油断は禁物ですよ。\n物質界に残してきた者たちにとって、\n私たちだけが唯一の希望なのですから。", "face": "u904"}, {"name": "アリア", "text": "私たちが……希望……。\nそうですね、気合を入れないと！", "face": "u75"}, {"name": "ウェンディ", "text": "このまま敵の包囲を突破するよ。\nシャール、タイミングは任せるから。", "face": "u401"}, {"name": "シャール", "text": "はいっ！　バトルタンク、\n次弾装填、砲撃――ってぇーッ！！", "face": "u763"}, {"name": "ウェンディ", "text": "機甲部隊、突撃。\n王子の道は、私たちで拓くよ。", "face": "u401"}, {"name": "リッカ", "text": "行きますよ王子、進軍です！！\nオリュンポスを目指しますよー！", "face": "u152"}]}, {"trigger": "route", "lines": [{"name": "大天使長", "text": "――まさか物質界への侵攻を無視し、\n逆に天界に攻め入ってくるとは……。", "face": "la6505e1106eb"}, {"name": "大天使長", "text": "人の子とは、どこまでも愚かな存在ですね。\nケラウノス様の慈悲の御心すら分からないとは……。", "face": "la6505e1106eb"}, {"name": "オーガスタ", "text": "ご自分の主の顔も忘れたのですか？\nケラウノス様はいま、\n力を失って眠りについているんですよ！？", "face": "u960"}, {"name": "大天使長", "text": "何を馬鹿なことを。\nケラウノス様は――ぐっ……なんだ、この記憶は……。", "face": "la6505e1106eb"}, {"name": "大天使長", "text": "お前たち、こいつらを薙ぎ払うのです！\n汚らわしき者たちへ、浄化による救済を！", "face": "la6505e1106eb"}, {"name": "オーガスタ", "text": "大天使長まで操るなんて、\nいったいどれだけの力を……。", "face": "u960"}, {"name": "アンナ", "text": "今はオリュンポス到達が最優先です。\n王子、増援部隊を撃破しましょう！", "face": "l276c938aebac"}]}], "active": true}