{"quest_id": 7665, "name": "蛙を睨む蛇頭", "description": "敵を退けガマガエルを助けた王子たち。\nしかし絡繰り忍者の口寄せによって\n新たに変異した刺客が姿を現す。\n極級（★１獲得の目安：平均Lv25）", "event": "金魚姫と夏夜の肝試し", "event_category": "History", "mission_id": 920180, "map_no": 4137, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "level": 80, "form_count": 2, "tags": ["機械"], "hp": 32000, "attack": 1050, "base_hp": 32000, "base_attack": 1050, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126672, "race_id": 16, "special_effect_id": 663, "change_to": 1, "master_id": 33332, "global_id": 6949, "to_condition": 2, "to_global_id": 6936, "route_behaviour": {"transforms": [{"wait": 120}], "sets_flags": [[0, 0, 30], [0, 1, 30]], "calls_event": [2182, 2183, 2184, 2185]}}, {"enemy_id": 1, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "tags": ["機械", "ステルス"], "hp": 90000, "attack": 1200, "base_hp": 90000, "base_attack": 1200, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 58, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126688, "race_id": 16, "special_effect_id": 664, "master_id": 33319, "global_id": 6936, "from_condition": 2}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 2, "tags": ["変異", "ステルスII", "ブロック不可"], "hp": 10500, "attack": 400, "base_hp": 10500, "base_attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 20, "attack_speed": 115, "attack_wait": 100, "attack_interval": 356, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2138400, "race_id": 16, "change_to": 5, "master_id": 35077, "global_id": 8694, "to_global_id": 8685, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["変異"], "hp": 10500, "attack": 400, "base_hp": 10500, "base_attack": 400, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 180, "attack_speed": 10, "attack_wait": 10, "attack_interval": 61, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2138400, "race_id": 16, "special_effect_id": 309, "missile_id": 733, "missile": {"speed": 4.0}, "master_id": 35068, "global_id": 8685, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 17, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 36}, {"enemy_id": 9, "source": "local", "count": 11, "form_count": 1, "tags": ["変異"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 236, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 0.8999999761581421, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2129360, "race_id": 7, "special_effect_id": 66, "master_id": 33821, "global_id": 7438, "spawn_sec": 66}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 96000, "base_hp": 96000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 40, "attack_speed": 10, "attack_wait": 10, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2138448, "race_id": 4, "special_effect_id": 230, "change_to": 10, "master_id": 35073, "global_id": 8690, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 90}, {"enemy_id": 12, "source": "local", "count": 22, "form_count": 1, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 93}, {"enemy_id": 13, "source": "local", "count": 7, "form_count": 1, "hp": 1000, "attack": 3000, "base_hp": 1000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_range": 10, "attack_speed": 65, "attack_wait": 80, "attack_interval": 197, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098864, "race_id": 16, "special_effect_id": 229, "missile_id": 56, "missile": {"speed": 1.0, "splash": 80}, "master_id": 127, "global_id": 126, "ranged": true, "spawn_sec": 105}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "tags": ["変異"], "hp": 10500, "attack": 400, "base_hp": 10500, "base_attack": 400, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 180, "attack_speed": 10, "attack_wait": 10, "attack_interval": 61, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2138400, "race_id": 16, "special_effect_id": 309, "missile_id": 733, "missile": {"speed": 4.0}, "master_id": 35068, "global_id": 8685, "ranged": true, "spawn_sec": 110}], "popups": ["変異した忍者マスターは\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "絡繰り忍者", "text": "噛み砕き、呑み喰らう。\nその身に宿すは蛇毒の異形。\n忍法、口寄せの術──変異領域！", "face": "l00bbc4094233"}]}, {"trigger": "start", "lines": [{"name": "クーコ", "text": "森の中にお城が……これは、幻術？", "face": "u1282a1"}, {"name": "レミィ", "text": "まさかあいつ、人間まで口寄せしたの！？\nなによあれ……腕が蛇になってるじゃない！", "face": "u1281a1"}, {"name": "ガマガエル", "text": "あわわわわ……俺様、蛇だけは駄目なんだ……。", "face": "le3b4f496efea"}, {"name": "リアナ", "text": "まさか……変異技術を自分たちに施したのですか！？", "face": "u1540a1"}, {"name": "絡繰り忍者", "text": "然り、我が研究は次の段階へと至った。\n此奴らはその先駆け、果て無き武の求道者。", "face": "l00bbc4094233"}, {"name": "絡繰り忍者", "text": "たとえ人の形を捨てようとも、\n強さを求め変異することを選んだ、\nまっこと天晴な覚悟を持った忍たちよ。", "face": "l00bbc4094233"}, {"name": "スキュレ", "text": "だからってこんなの……普通じゃないわ……。", "face": "u1539a1"}, {"name": "絡繰り忍者", "text": "何を驚くことがある。\nお主も似たような代物であろう。", "face": "l00bbc4094233"}, {"name": "絡繰り忍者", "text": "人を守るために、人であることを捨て、\nそれ故に人から拒絶された、哀れな姫君よ。", "face": "l00bbc4094233"}, {"name": "スキュレ", "text": "────っ！", "face": "u1539a1"}, {"name": "絡繰り忍者", "text": "足が震えているぞ、海魔の娘。\n蛇は苦手か、それとも同族嫌悪か。\n過去の記憶を思い出すのは辛かろう。", "face": "l00bbc4094233"}, {"name": "絡繰り忍者", "text": "荒々しき魔力をその身に宿そうと、\nその精神は所詮、箱の中が似合いの小娘。\n大人しく家に籠っておれば幸福であろうに。", "face": "l00bbc4094233"}, {"name": "リアナ", "text": "口を閉じなさい、それ以上の侮辱は許しませんよ。\nスキュレさんは貴方が思うよりもずっと強い人です。", "face": "u1540a1"}, {"name": "スキュレ", "text": "……確かに私は半端者だけどね、\nそういうのはもう全部割り切ってるのよ！\n割り切った上で王子と一緒に戦ってるの！", "face": "u1539a1"}, {"name": "スキュレ", "text": "何も知らないくせに掘り返すんじゃないわよ。", "face": "u1539a1"}, {"name": "絡繰り忍者", "text": "……本当に割り切っている者は、\n割り切っているとは口に出さぬものだ。\nお主はそうありたいと願っているだけに過ぎぬ。", "face": "l00bbc4094233"}, {"name": "スキュレ", "text": "あ、そう、で？　それが何？\n私は絶対に退いたりしないから。", "face": "u1539a1"}, {"name": "絡繰り忍者", "text": "……縁も所縁もない蛙一匹のため、\n恐怖と戦いながらそれでも前に立つか。\nその蛮勇、砕かせてもらうでござる！", "face": "l00bbc4094233"}, {"name": "スキュレ", "text": "砕かれるのは貴方の絡繰りの方よ。\n守るための戦いで、私はもう負けない。", "face": "u1539a1"}]}, {"trigger": "end", "lines": [{"name": "絡繰り忍者", "text": "……これ以上は費用対効果が見合わぬ。\n些か惜しいが、ここらが引き際にござる。", "face": "l00bbc4094233"}, {"name": "リアナ", "text": "絡繰り忍者、撤退していきます。\n追うのは……やめておきましょうか。", "face": "u1540a1"}, {"name": "スキュレ", "text": "賛成、すっごく疲れちゃったし。\nそもそもの目的はあれじゃないしね。", "face": "u1539a1"}, {"name": "ガマガエル", "text": "……海産──じゃねぇ、スキュレだったか？", "face": "le3b4f496efea"}, {"name": "スキュレ", "text": "なに？　私たちは別に貴方を\nどうこうしようって気はないわよ？\n子供たちを見つけたらすぐに帰るわ。", "face": "u1539a1"}, {"name": "ガマガエル", "text": "待ってくれ！　あんたは命の恩人だ！\n借りを返さずに帰しちまったら、俺様一生の恥！\n何でもいい！　俺様にできることはないか！？", "face": "le3b4f496efea"}, {"name": "スキュレ", "text": "う～ん……そこまで言うなら、\n私たちと一緒に村に行ってみない？", "face": "u1539a1"}, {"name": "スキュレ", "text": "貴方はそんな悪い子じゃないみたいだし、\nきっと村の人たちと仲良くなれると思うの。", "face": "u1539a1"}, {"name": "ガマガエル", "text": "あんたが言うなら構わねぇが、\n本当にそんなことでいいのかよ？\n別に油を差し出したっていいんだぜ。", "face": "le3b4f496efea"}, {"name": "スキュレ", "text": "そんなことで私は満足よ。\n油は少し分けてくれると嬉しいかも。\nあとは子供たちの捜索を手伝ってくれたら……。", "face": "u1539a1"}, {"name": "リアナ", "text": "──あ、そのことなのですが、\nさっきシラヌイさんいませんでした？", "face": "u1540a1"}, {"name": "シラヌイ", "text": "呼んだ～？", "face": "u1542a1"}, {"name": "スキュレ", "text": "わっ！？　し、シラヌイさん……？\n今までどこにいらっしゃったんですか？", "face": "u1539a1"}, {"name": "シラヌイ", "text": "えっとね～、森に迷子たちがいたから、\n村の入り口まで護衛と道案内をしてたんだけど、\nみんなと入れ違いになったみたいで戻って来たの。", "face": "u1542a1"}, {"name": "リアナ", "text": "（……するとおかしいですね、\n確かに戦場でシラヌイさんを見掛けたのですが、\nもしや私の見間違いだったのでしょうか……）", "face": "u1540a1"}, {"name": "スキュレ", "text": "よーし、それじゃあみんなで帰りましょうか。", "face": "u1539a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "絡繰り忍者", "text": "──我が力、及ばずか。\n試行回数の不足が響いたな。", "face": "l00bbc4094233"}, {"name": "絡繰り忍者", "text": "しかし、ただでは終わらせぬ。\n置き土産だ、花火を楽しむが良い。", "face": "l00bbc4094233"}, {"name": "スキュレ", "text": "ああもうっ！　また爆弾！？", "face": "u1539a1"}, {"name": "リアナ", "text": "退避！　退避！　退避でーす！", "face": "u1540a1"}]}], "active": true}