"dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104464, "race_id": 9, "change_to": 24, "change_condition": 1, "missile_id": 132, "missile": {"speed": 4.0, "splash": 133}, "master_id": 533, "global_id": 532, "ranged": true, "variants": [{"hp": 100000, "attack": 4000, "base_hp": 100000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 10, "attack_speed": 150, "attack_wait": 50, "attack_interval": 401, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104448, "race_id": 9, "master_id": 532, "global_id": 531}], "spawn_sec": 206}], "popups": ["NPCのゴブリン博士の\n飛行傀儡は、倒されても\n★の評価には影響しません。", "ブライダルメカゴブリンクイーンは\n戦場にいる宝石箱のミミックの\n総数に応じて、攻撃力と\n防御力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "メカゴブリンクイーン", "text": "――あぁら、早かったのね、王子。\nいいえ、今日からは……あ・な・たと、\n呼ぶべきなのかしら……。", "face": "l043a5aa562a7"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "メカゴブリンクイーン", "text": "あら、妻になるこの私に、\n何の言葉もかけないつもりかしら。", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "……これでも、ゴブリン族のため、王国のため、\n身を捧げる覚悟をしてきたのよ……？", "face": "l043a5aa562a7"}, {"name": "王子", "text": "……メカゴブリンクイーン、俺は――", "face": "u1"}, {"name": "ゴブリン博士", "text": "――――アリッ！", "face": "l7590e38ca391"}, {"name": "シルセス", "text": "……この声は、ゴブリン博士？", "face": "u451"}, {"name": "ゴブリン博士", "text": "ソノ結婚！　異議アリぃぃぃぃッ！！", "face": "l7590e38ca391"}, {"name": "メカゴブリンクイーン", "text": "博士、邪魔するつもりかしら？\nこの結婚がどんな意味を持つか、分かっているでしょう。", "face": "l043a5aa562a7"}, {"name": "ゴブリン博士", "text": "それデモ！　それデモです！！\nワタクシは、この結婚に異議ヲとなえマス！！", "face": "l7590e38ca391"}, {"name": "メカゴブリンクイーン", "text": "……あなたが私に反旗を翻すなんてね。\nならば、ゴブリン族の流儀にのっとり、\n実力で私を止めてご覧なさい。", "face": "l043a5aa562a7"}, {"name": "ゴブリン博士", "text": "ウゥ……ワタクシは……ワタクシは……ッ！！", "face": "l7590e38ca391"}, {"name": "シルセス", "text": "……ゴブリン博士。\n私も、手伝いますよ。", "face": "u451"}, {"name": "メリュジアナ", "text": "うむ、我らの目的は一致している。\n互いに大切なものを守るための戦いだ。", "face": "u1218a1"}, {"name": "ナナリー", "text": "……すき、なんでしょ？", "face": "u1217a1"}, {"name": "ゴブリン博士", "text": "あ、いや、スキと言うか……。\nこれは忠義でアリ、忠誠でアリ……ソノ……。", "face": "l7590e38ca391"}, {"name": "シルセス", "text": "忠義でそんなにうろたえるかしら？\nふふ、さぁ行きますよ！　結婚式を破壊するために！", "face": "u451"}, {"name": "王子", "text": "ゴブリン博士、共に戦おう。\n――お前の侠気を、メカゴブリンクイーンに見せてやれ。", "face": "u1"}, {"name": "ゴブリン博士", "text": "…………ッ！！\n王、子……お前……ッ！　ぐすっ、うおぉ、うぉぉぉぉッ！", "face": "l7590e38ca391"}, {"name": "ゴブリン博士", "text": "ユクゾ！　コレは愛を示すための戦いなのダ！！", "face": "l7590e38ca391"}]}, {"trigger": "battle", "at_sec": 143, "lines": [{"name": "メカゴブリンクイーン", "text": "そう、そうね……。\nゴブリン族と人間族の歴史とは、戦いの歴史……。", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "私が勝ったら、王子は私のもの……。\n負けたなら、おとなしく身を引いてあげるわ……。", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "ああ、ミミックから溢れ出す宝石の輝きが、\n私の力となっていくわぁ……！！\n行くわよ、王子、ゴブリン博士！！", "face": "l043a5aa562a7"}, {"name": "シルセス", "text": "まさか、ミミックが盗んだ宝石から\n力を得ているのですか……！？", "face": "u451"}, {"name": "メカゴブリンクイーン", "text": "まずはブーケトスよ！\n受け取りなさい、乙女たち！！", "face": "l043a5aa562a7"}]}, {"trigger": "end", "lines": [{"name": "メカゴブリンクイーン", "text": "プシュー……。\nああ、私が、負けるなんて……。", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "キィィィッ！　王子、そんなに\n私との結婚が嫌だったのかしら！？", "face": "l043a5aa562a7"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "リーナ", "text": "……お母さ――め、メカゴブリンクイーン様、\nこの手紙をお読みください……。\n王国からの、正式な返答です……！", "face": "u521"}, {"name": "メカゴブリンクイーン", "text": "……女王の身柄を捧げての婚姻に、\n平和への道はない……？", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "誰かが涙する結婚では、\nきっといつか、大きな歪みが生じるだろう……と。\nウフフ、そう……そうね……。", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "けれど、私はもう恋愛なんて捨てたのよ。\nこの身はすべて、ゴブリン族のために捧げたの。\n私を愛するような者は、もうどこにも――", "face": "l043a5aa562a7"}, {"name": "シルセス", "text": "いいえ、メカゴブリンクイーン。\nもう忘れたのですか？　誰がこの式に異議を唱えたのか。", "face": "u451"}, {"name": "ゴブリン博士", "text": "メカゴブリンクイーン様！！\nワタクシは……ワタクシは……ッ！！", "face": "l7590e38ca391"}, {"name": "シルセス", "text": "博士、頑張ってください。\nあと一歩、あと少しだけ、勇気を！", "face": "u451"}, {"name": "ゴブリン博士", "text": "……ワタッ、ワタクシはっ！\nメカゴブリンクイーンさまのことヲッ！\nア、アアア、アイッ、アッ…………ぱたんっ。", "face": "l7590e38ca391"}, {"name": "シルセス", "text": "……ゴブリン博士！？\nどうしたのですか！？", "face": "u451"}, {"name": "ナナリー", "text": "……呼吸はしてる。\n緊張しすぎて気絶しちゃったみたいです。", "face": "u1217a1"}, {"name": "メカゴブリンクイーン", "text": "……ウフフ、困った臣下ねぇ。", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "王子、騒がせて悪かったわね。\n今日のことは、お互いに忘れましょう。", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "もとより！　ゴブリン族と人間族は相容れないのよぉッ！！\nオーッホッホッホホッ！！\n所詮は仇敵同士ということねぇッ！", "face": "l043a5aa562a7"}, {"name": "メカゴブリンクイーン", "text": "さぁ、目を覚ましなさい、ゴブリン博士っ！！\n次なる兵器の開発が待っているわよぉ！！", "face": "l043a5aa562a7"}, {"name": "ゴブリン博士", "text": "――ハッ！？\nワタクシは何をッ！？", "face": "l7590e38ca391"}, {"name": "メカゴブリンクイーン", "text": "良いから帰るわよ！\nほら、もっと背筋を伸ばして！", "face": "l043a5aa562a7"}, {"name": "ゴブリン博士", "text": "痛ぁぁぁぁッ！？\nはっ、ははぁっ！　モット伸ばしマスッ！！", "face": "l7590e38ca391"}, {"name": "シルセス", "text": "……ふふ、さぁ王子、私たちも帰りましょうか。\nまだまだ『宝飾品の欠片』は集め終わっていませんからね。", "face": "u451"}, {"name": "シルセス", "text": "楽しいジューンブライドの祝祭のために、\n一緒に準備、頑張りましょうね♪", "face": "u451"}, {"name": "メリュジアナ", "text": "むっ、シルセスずるいぞ！\n王子と腕を組むとは！", "face": "u1218a1"}, {"name": "ナナリー", "text": "……私も、腕、組んでいいですか？", "face": "u1217a1"}, {"name": "アンナ", "text": "ふふ、王子の腕は二本しかありませんよ？\nともあれ、無事に解決してなによりです。\nさぁ、王国へ帰還しましょう！", "face": "l5525f6626658"}]}], "story_talk": true, "active": true}