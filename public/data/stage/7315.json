{"quest_id": 7315, "name": "ソノ結婚！　異議アリッ！", "description": "王子に結婚を迫るメカゴブリンクイーン。\nその時！　式場の扉が勢いよく開かれた！\n愛に立ち上がった一人の男と共に戦え！\n神級（★１獲得の目安：平均Lv50）", "event": "クイーンズ・ウェディング", "event_category": "History", "mission_id": 920160, "map_no": 5941, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 2, "hp": 1, "base_hp": 1, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 50, "attack_wait": 30, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128544, "special_effect_id": 791, "change_to": 1, "change_condition": 2, "master_id": 33698, "global_id": 7315, "to_condition": 2, "to_global_id": 7316, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 400, "base_hp": 12000, "base_attack": 400, "damage_type": "physical", "armor_defense": 370, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "attack_interval": 58, "move_speed": 4500.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128560, "special_effect_id": 791, "master_id": 33699, "global_id": 7316, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 6500, "attack": 430, "base_hp": 6500, "base_attack": 430, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "master_id": 74, "global_id": 73, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 23