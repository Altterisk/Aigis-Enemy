 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 10, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_global_id": 624, "spawn_sec": 79}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 9, "master_id": 625, "global_id": 624}, {"enemy_id": 12, "source": "local", "count": 9, "form_count": 1, "hp": 12000, "attack": 600, "base_hp": 12000, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 40, "attack_wait": 10, "attack_interval": 136, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2152144, "race_id": 9, "special_effect_id": 773, "master_id": 37359, "global_id": 10976, "spawn_sec": 88}, {"enemy_id": 13, "source": "local", "count": 11, "form_count": 1, "hp": 1500, "attack": 800, "base_hp": 1500, "base_attack": 800, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099056, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 120, "global_id": 119, "ranged": true, "spawn_sec": 91}, {"enemy_id": 14, "source": "local", "count": 9, "form_count": 2, "hp": 4000, "attack": 900, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105248, "race_id": 18, "change_to": 14, "master_id": 627, "global_id": 626, "to_global_id": 485, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 101}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 900, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103936, "race_id": 18, "change_to": 13, "master_id": 486, "global_id": 485}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 9, "master_id": 625, "global_id": 624, "to_global_id": 483, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 116}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 10, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true}, {"enemy_id": 15, "source": "local", "count": 12, "form_count": 2, "hp": 4000, "attack": 900, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103936, "race_id": 18, "change_to": 13, "master_id": 486, "global_id": 485, "to_global_id": 626, "spawn_sec": 121}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 900, "base_hp": 4000, "base_attack": 900, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105248, "race_id": 18, "change_to": 14, "master_id": 627, "global_id": 626}], "dialogue": [{"trigger": "start", "lines": [{"name": "プロメ", "text": "――来ましたか。\nオラティル、これは人類と私の問題ですよ？\n手を貸したりしないでください。", "face": "u2150a1"}, {"name": "オラティル", "text": "おいおい、待ちたまえよ。\n私もまた、きみと同じく文明を滅ぼした大罪人だ。\nこの場で人類の答えを見届ける権利はあるだろう？", "face": "u2149a1"}, {"name": "プロメ", "text": "……そうですね。\nそれでは世界を滅ぼした神の生き残りとして、\n私と共に、彼らの答えを聞きましょうか。", "face": "u2150a1"}]}, {"trigger": "battle", "at_sec": 5, "lines": [{"name": "レクテ", "text": "あれが……超古代文明の船。\nすごい、本当に飛ぶんだ……。", "face": "u2047a1"}, {"name": "プロメ", "text": "この機体は、大破して久しいものです。\n今も私の火で、\n無理やり機関を動かしているに過ぎません。", "face": "u2150a1"}, {"name": "プロメ", "text": "全盛期の、都市を焼き、空を墜とした力はありません。\nけれど、誤った力を欲する愚かな者たちを、\n溶かし尽くすには十分な性能を残しています。", "face": "u2150a1"}, {"name": "プロメ", "text": "完全破壊に至るまでに、今の文明の人類なら、\nその半数は殺せるでしょう。\nそんな兵器を、なぜ欲するのですか。", "face": "u2150a1"}, {"name": "王子", "text": "…………間違っているからだ。", "face": "u1"}, {"name": "プロメ", "text": "…………はい？", "face": "u2150a1"}, {"name": "王子", "text": "あなたも、オラティルも、人類を甘く見すぎている。\n教わった知識がなくとも、超古代文明の人々は、\nいつか己を滅ぼす力を手にしていたはずだ。", "face": "u1"}, {"name": "王子", "text": "世界を滅ぼしたのは、神じゃない。\n滅亡の道を進んだのは、かつての俺たちの選択だ。", "face": "u1"}, {"name": "プロメ", "text": "……な、慰めるつもりですか？\nそれはただの言葉遊びです。", "face": "u2150a1"}, {"name": "シビラ", "text": "世界を滅ぼしたという人類の過ちを、\n勝手に、自分たちだけの責任だと思わないでほしい。", "face": "u39"}, {"name": "シビラ", "text": "この船の力を手にしたとしても、\nそれが世界を壊してしまうのか、救うのか、\nどんな道を選んで進むのかは、私たち人類が責任を負うわ。", "face": "u39"}, {"name": "プロメ", "text": "…………。\n………………。", "face": "u2150a1"}, {"name": "オラティル", "text": "……驚いた。\nプロメだけでなく、私まで救う気かい？", "face": "u2149a1"}, {"name": "クリッサ", "text": "子の人生の終焉にまで、\n親であるあなた方が責任を負う必要はない。\nただ、子らが自分で選ぶ道を見守ってほしい。", "face": "u52"}, {"name": "ディーナ", "text": "ま、親から何を教えられたとしても、\n将来何を考えて生きるかなんて、そいつの自由だもんな。", "face": "u22"}, {"name": "ベルナ", "text": "あはは……自分勝手なこと言っちゃってるのは\nたぶんみんなも分かってるけどね。\nそれでも、何ていうの？　ここでふたりに会えたのが――", "face": "u46"}, {"name": "ナナリー", "text": "私たちみんなの、お母さんなんだよね……？\nそれなら、誰に責任があるとか、そういう話じゃなくて、\n文明を教えてくれて、ありがとうって言いたい。", "face": "u29"}, {"name": "プロメ", "text": "だから、その力は……間違ってるんですよぉ……。\n己を滅ぼす力、それも、誰ひとり抗えず、\n滅亡の道しか選べないような力なんてぇ……！！", "face": "u2150a1"}, {"name": "プロメ", "text": "わがまま……わがまま過ぎます……。\n我が子の死に様を見たいママなんて、\nどこにもいないんですよ！？", "face": "u2150a1"}, {"name": "プロメ", "text": "それなのに……私たちの責任まで、\n全部自分たちで背負おうとするなんて、\nそんなの……ずるい……ずるいです……！", "face": "u2150a1"}, {"name": "デスピア", "text": "証明するわ。\n今の私たちがその船に勝利すれば、\nもはや、あなたが思い悩む必要はないでしょう？", "face": "u49"}, {"name": "オラティル", "text": "世界を滅ぼせる力に勝てるなら、\nそれはすなわち、自分たちの手で\n世界を滅ぼしうる可能性を見せることになる。", "face": "u2149a1"}, {"name": "オラティル", "text": "なるほど、道理だ。\nプロメ、覚悟したまえよ。\n彼らは本気で、私たちを過去から救う気だ。", "face": "u2149a1"}, {"name": "プロメ", "text": "知りません！　そんなの、そんなの……！\n私たちの子が……文明の種が……。", "face": "u2150a1"}, {"name": "プロメ", "text": "私が目をそらしていた間に、\nこんなに強く、\n未来を目指して、育っていたなんてぇ……。", "face": "u2150a1"}, {"name": "王子", "text": "見ていてくれ、文明の母たち。\n俺たちの選ぶ未来を。", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "レクテ", "text": "――超古代文明の船、不時着したよ！\nよ、よし、見た感じ中身は無事みたい！", "face": "u2047a1"}, {"name": "プロメ", "text": "…………かっこつけるだけつけて、\n全部の責任をひとりで負おうとしたのに、\nぜーんぶ台無しにされちゃいました。", "face": "u2150a1"}, {"name": "プロメ", "text": "どうしたらいいと思いますぅ……？\nもう親離れできるよって、\n思いっきり見せつけられちゃったんですけどぉ……。", "face": "u2150a1"}, {"name": "オラティル", "text": "きみの与えた試練だろう？\n彼らは、見事にそれを乗り越えた。", "face": "u2149a1"}, {"name": "オラティル", "text": "あとは、きみがどう返事をするかだけだ。\n試練を乗り越えた以上、\n超古代文明の遺産を仕方なく与えるのか――", "face": "u2149a1"}, {"name": "オラティル", "text": "あるいは、愛する子らを信じ、\nきみが彼らの世界に飛び込んでいくのか。", "face": "u2149a1"}, {"name": "プロメ", "text": "…………そう、ですね。", "face": "u2150a1"}, {"name": "プロメ", "text": "まだ、完全に信じたわけでは、ないです。\nでも、少なくとも彼らは、\n私の与えた知識を悪用したりはしないでしょう。", "face": "u2150a1"}, {"name": "プロメ", "text": "いつか己を滅ぼすような選択をする、\nそんな人々が現れないとも限りませんが……。", "face": "u2150a1"}, {"name": "プロメ", "text": "その時には、人と人の対話で乗り越えてみせると、\nそう言いたいのですよね、彼らは。", "face": "u2150a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "プロメ", "text": "ふふっ、どうしてこんなに、\n自信満々に断言できちゃうんでしょうねぇ。", "face": "u2150a1"}, {"name": "プロメ", "text": "まるで超古代文明の誰かから、\n未来を託されたみたいな顔してますよぉ。", "face": "u2150a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "プロメ", "text": "…………えっ？\nあの、まさか、本当に？", "face": "u2150a1"}, {"name": "アンナ", "text": "彼は背負った使命を誇りとして、\n人類とは何か、守るべき存在とは何かを\nずっと自問し続けていました。"}, {"name": "アンナ", "text": "それゆえに人類に牙を剥きましたが、\nそれでも、その責任を神に押し付けるようなことは、\nただの一言も言いませんでしたよ。", "face": "l2b5dc79551bb"}, {"name": "王子", "text": "……俺たちと、共に歩んでくれないか。\n神と人ではなく、母と子として。", "face": "u1"}, {"name": "プロメ", "text": "……あはは。\nお姉ちゃんくらいにしておきましょうよ。\nお母さんだと、色々口出ししてしまいそうです。", "face": "u2150a1"}, {"name": "プロメ", "text": "お姉ちゃんなので、悪いことをしていたら叱ります。\nそれでも、弟たちの選択を、無意味にしたりはしません。", "face": "u2150a1"}, {"name": "プロメ", "text": "――いっしょに、行きましょう。", "face": "u2150a1"}]}], "active": true}