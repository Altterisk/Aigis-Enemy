{"quest_id": 8246, "name": "文明を滅ぼした船", "description": "かつて火を伝え、その罪を背負う亜神に\n人類の未来と意志を示すべく王子たちは\n超古代文明の船との決戦に挑む。\n神級（★１獲得の目安：平均Lv50）", "event": "目覚めの炎", "event_category": "History", "mission_id": 920214, "map_no": 4889, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 216000, "attack": 1400, "base_hp": 216000, "base_attack": 1400, "damage_type": "magical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 1, "attack_wait": 180, "attack_interval": 505, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152320, "special_effect_id": 1708, "change_to": 1, "change_condition": 3, "missile_id": 1055, "missile": {"speed": 16.0, "splash": 107}, "master_id": 37379, "global_id": 10996, "to_condition": 3, "to_global_id": 10994, "route_behaviour": {"transforms": [{"wait": 4000}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 216000, "attack": 1400, "base_hp": 216000, "base_attack": 1400, "damage_type": "magical", "armor_defense": 800, "magic_defense": 20, "attack_range": 360, "attack_speed": 1, "attack_wait": 180, "attack_interval": 504, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152320, "special_effect_id": 1706, "missile_id": 1055, "missile": {"speed": 16.0, "splash": 107}, "master_id": 37377, "global_id": 10994, "ranged": true, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 6}, {"enemy_id": 4, "source": "local", "count": 13, "form_count": 1, "hp": 400