00, "magic_defense": 20, "attack_speed": 50, "attack_wait": 30, "attack_interval": 161, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098768, "race_id": 2, "master_id": 117, "global_id": 116}], "spawn_sec": 96}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "magical", "armor_defense": 150, "attack_range": 160, "attack_speed": 50, "attack_wait": 40, "attack_interval": 161, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099744, "race_id": 2, "special_effect_id": 222, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 192, "global_id": 191, "ranged": true, "spawn_sec": 96}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 600, "base_hp": 2800, "base_attack": 600, "damage_type": "physical", "armor_defense": 1000, "attack_speed": 70, "attack_wait": 40, "attack_interval": 220, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101424, "race_id": 16, "master_id": 261, "global_id": 260, "spawn_sec": 123}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 17250, "attack": 1200, "base_hp": 17250, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 50, "attack_interval": 189, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105792, "race_id": 16, "master_id": 733, "global_id": 732, "spawn_sec": 130}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 14000, "attack": 650, "base_hp": 14000, "base_attack": 650, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101824, "race_id": 16, "special_effect_id": 226, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30020, "global_id": 3639, "ranged": true, "spawn_sec": 137}], "dialogue": [{"trigger": "start", "lines": [{"name": "ルシル", "text": "待てーーーッ！\n待て待て待てぇーーーッ！！", "face": "u222"}, {"name": "リオン", "text": "待ちなさいキャリー！\nあんたよりあたしの方が速いって\nこの際に証明してあげるんだから！", "face": "u1251"}, {"name": "キャリー", "text": "ひぇえッ！　みんなが追いかけてきてるっ！\nそんなことされたら余計に止まれませんよぉ～～ッ！！", "face": "u646"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ケイティ", "text": "……そろそろキャリーさんたちが\n再びここを通る頃ですね。", "face": "u114"}, {"name": "ユリアン", "text": "その時が奴らを止める好機だな。\n王子、準備はいいか？", "face": "u7"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アリア", "text": "相手は機動力の高い騎兵の方々です。\n速さに任せて突破されないよう、\n確実に足止めして鎮圧していきましょう。", "face": "u75"}, {"name": "ミゲル", "text": "待ちやがれーっ！　キャリーの姉貴ィ！", "face": "u369"}, {"name": "アリア", "text": "――来ましたっ！\n王子、ご指示をお願いします！", "face": "u75"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "……ふぅっ。ようやく鎮まりましたね。", "face": "u114"}, {"name": "ルシル", "text": "なんだ、訓練じゃなかったのか。\n早とちりしてしまって、すまなかったな。", "face": "u222"}, {"name": "キャリー", "text": "あぅ、申し訳ありません……。\n私が暴走してしまったせいで、皆さんを\nこんな日暮れまで付き合わせてしまって……。", "face": "u646"}, {"name": "エレイン", "text": "ホント、迷惑もいいところだわ。\nあんたのおかげでこっちはヘトヘトよ。", "face": "u36"}, {"name": "キャリー", "text": "うぐっ……。", "face": "u646"}, {"name": "アンナ", "text": "え、エレインさん……。", "face": "lcd5b67a8847f"}, {"name": "エレイン", "text": "……けど、私はそれなりに楽しかったわ。\nそれに、おかげさまで王子やみんなと一緒に\nこんな綺麗な夕日も見れたわけだしね♪", "face": "u36"}, {"name": "キャリー", "text": "……え？", "face": "u646"}, {"name": "フーリ", "text": "わぁ……本当に綺麗ですねぇ。\n夕日のオレンジ色が海に溶けてるみたい……。", "face": "u174"}, {"name": "レシア", "text": "ふっ、そうだな……。\nキャリー、今日はありがとう。\nおかげで良い訓練ができた。", "face": "u358"}, {"name": "カノン", "text": "私も楽しかったわ。\nこれもキャリーさんが水着を着てきてくれたおかげね。", "face": "u264"}, {"name": "キャリー", "text": "皆さん……ありがとうございます。\nえへへ、間違えて水着を着てきて正解だったかも。", "face": "u646"}, {"name": "アンナ", "text": "ですが、せっかく用意した水着を\n使わないなんて勿体ないですよね？"}, {"name": "キャリー", "text": "……え？\nということは、もしかして……。", "face": "u646"}, {"name": "アンナ", "text": "ええ。先ほど王子の了承も得られましたので、\n今日一日頑張って頂いたご褒美に、\n明日は海でバカンスということにいたしましょう。"}, {"name": "キャリー", "text": "やったぁっ！\n王子、アンナさん、ありがとうございますっ！", "face": "u646"}]}], "active": true}