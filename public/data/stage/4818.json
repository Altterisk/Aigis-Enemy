, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 1200, "base_hp": 60000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105904, "race_id": 4, "special_effect_id": 232, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 752, "global_id": 751, "ranged": true, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 36, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 13}, {"enemy_id": 6, "source": "local", "count": 7, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 20}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 151}, {"enemy_id": 8, "source": "local", "count": 5, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 187}], "dialogue": [{"trigger": "start", "lines": [{"name": "重水の四天王", "text": "くっくっく……天狗山に出向くのも随分と久しいですね。\nさて、今日こそは目障りな天狗を屈服させてやりましょう。", "face": "l33379a72946d"}, {"name": "迅雷の四天王", "text": "屈服など生ぬるいぞ。水よ。\nわしなら羽をむしり取り、殺し尽くしてやるわい。", "face": "l9c2d62fff21d"}, {"name": "豪風の四天王", "text": "あまり浮かれ騒ぐのは良くない。水と雷よ。\n天狗の神通力を甘く見れば、死に繋がる。\n――ん？　誰だあやつらは。", "face": "l13e2c73ee0a0"}, {"name": "アンナ", "text": "お、王子、あそこをご覧下さい！\n酒呑童子の配下の四天王です……！\nまさか、天狗山を襲いに……。", "face": "l7305c7df068c"}, {"name": "豪風の四天王", "text": "……むぅ。あれは人間か。\n天狗山には古より天狗一派の物の怪しか\nおらんかったように思うが。どうしたものか。", "face": "l13e2c73ee0a0"}, {"name": "重水の四天王", "text": "……くっくっく。\n天狗と人が手を取り合うとは、実に面白い。\nいいでしょう、ここでまとめて殺してあげます。", "face": "l33379a72946d"}, {"name": "迅雷の四天王", "text": "グハハハ！\n生ぬるいと言っておるだろう。水よ。\nこの山ごと、わしの雷の餌食にしてくれるわ！", "face": "l9c2d62fff21d"}]}, {"trigger": "end", "lines": [{"name": "迅雷の四天王", "text": "――グッ、ぅ……\nなんという事だ。\n我ら四天王と渡り合うとは……。", "face": "l9c2d62fff21d"}, {"name": "豪風の四天王", "text": "天狗が人間に肩入れしてるとなれば、\n少々厄介になってきたな。\n酒呑童子様に報告しに戻るとしよう。", "face": "l13e2c73ee0a0"}, {"name": "重水の四天王", "text": "賢明な判断ですね……。\nそれでは人間どもよ。\n次に見える時を楽しみにしてますよ……くっくっく。", "face": "l33379a72946d"}, {"name": "アオバ", "text": "……逃げられてしまいましたか。\nですが、十分な戦果を得ることができました。\n四天王を圧倒できたのは大きな自信となりましょう。", "face": "u441"}, {"name": "アオバ", "text": "それにしても、王子は本当に人間なのですか？\n物の怪をも上回る力をお持ちの様に見える……。\n一言も語らず、兵と意思疎通を行っているようですし。", "face": "u441"}, {"name": "アンナ", "text": "ちょ、ちょっとアオバさん！\n王子は、もちろん人間ですよ！", "face": "l7305c7df068c"}, {"name": "バシラ", "text": "まったくもう！　アオバさんってば何でも疑って……！\n天狗様に、妖怪と人間の区別の付け方も\n修行で教わってくださいっ！", "face": "u28"}, {"name": "アオバ", "text": "は、はいっ！\nもっと修行に励みます……！", "face": "u441"}]}], "active": true}