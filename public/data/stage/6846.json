e_id": 22, "missile": {"speed": 10.0}, "master_id": 30075, "global_id": 3694, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 900, "base_hp": 12000, "base_attack": 900, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105072, "race_id": 16, "special_effect_id": 121, "master_id": 30071, "global_id": 3690, "spawn_sec": 3}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099584, "race_id": 16, "special_effect_id": 222, "missile_id": 57, "missile": {"speed": 12.0}, "master_id": 179, "global_id": 178, "ranged": true, "spawn_sec": 3}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1200, "base_hp": 30000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 1200, "magic_defense": 15, "attack_speed": 25, "attack_wait": 1, "attack_interval": 75, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2115648, "special_effect_id": 130, "change_to": 10, "master_id": 31230, "global_id": 4849, "route_behaviour": {"transforms": [{"wait": 720}]}, "spawn_sec": 4}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 1700, "base_hp": 12000, "base_attack": 1700, "damage_type": "magical", "armor_defense": 2200, "attack_speed": 1, "attack_wait": 100, "attack_interval": 244, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119664, "race_id": 2, "special_effect_id": 222, "master_id": 31899, "global_id": 5518, "spawn_sec": 6}, {"enemy_id": 13, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "magical", "armor_defense": 700, "magic_defense": 15, "attack_speed": 25, "attack_wait": 1, "attack_interval": 75, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111696, "special_effect_id": 54, "master_id": 30620, "global_id": 4239, "spawn_sec": 7}], "dialogue": [{"trigger": "start", "lines": [{"name": "エルドラ", "text": "――こ、これが！\n噂に聞くプリンセスのお茶会ですのね！", "face": "u549"}, {"name": "シェリー", "text": "本当はもっと早くお呼びしたかったんですけどね。\n中々都合があわなくて……。", "face": "u27"}, {"name": "シルヴィア", "text": "いえいえ、こうして\nご一緒出来ただけで光栄ですわ♪", "face": "u442"}, {"name": "リリア", "text": "そう言っていただけると助かります。\n――って、あら？\n向こうの影に何か見えたような……？", "face": "u20"}, {"name": "テミス", "text": "あれは……もしやゴブリン博士では？\nた、大変っ、王子に知らせませんと！", "face": "u38"}, {"name": "ゴブリン博士", "text": "――くっ、この洗脳装置では足りナイカ！\nやはりマダマダ改良が必要だナ……！", "face": "l7a9ffec81721"}, {"name": "シビラ", "text": "どうやら、何かの装置を動かしているようね。\n洗脳装置――って聞こえたけれど。", "face": "u39"}, {"name": "エルドラ", "text": "せ、せせせ、洗脳ですの！？\nけれどあいにくと、そんな物に操られる、\n単純な脳みそではありませんのよ！", "face": "u1549"}, {"name": "メカゴブリンクイーン", "text": "ウフフ、まったくあなたは手ぬるいのよ。\nこういう装置はねぇ、\n最初から最大出力で使うものでしょう？", "face": "l7d33218f4289"}, {"name": "シルヴィア", "text": "……くっ、こ、これは……頭が、割れそうですわ！？", "face": "u1442"}, {"name": "ゴブリン博士", "text": "く、くく、クイーン様ァ！？\nそんな出力デハ、装置が壊れテ――", "face": "l7a9ffec81721"}, {"name": "メカゴブリンクイーン", "text": "おだまり！\n予算なんていくらでも出してあげるから、\nあなたの最高の技術を発揮しなさい！", "face": "l7d33218f4289"}, {"name": "ゴブリン博士", "text": "はっ、ははぁっ！！\nでは更に出力をあげテ……！！", "face": "l7a9ffec81721"}, {"name": "シビラ", "text": "――ごめんなさい、王子。\nこれ以上は、もう……っ。", "face": "u39"}, {"name": "ソーマ", "text": "――お、王子っ、大変です！\nプリンセスの皆さんが、\nゴブリンクイーンに操られて……！！", "face": "u23"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "メカゴブリンクイーン", "text": "ウフフ、さぁ、仲間を奪われた気持ちはいかが？\nさぁ人間の姫君達よ、\n私に従い、王国を蹂躙してやりなさぁい！！", "face": "l7d33218f4289"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "ク、クイーン様っ！！\nもう装置が保たな――ウワァァッ！？", "face": "l7a9ffec81721"}, {"name": "メカゴブリンクイーン", "text": "負荷を掛けすぎたみたいね……。\nまさか洗脳装置が壊れるなんて。\nでも良いデータが取れたでしょう？", "face": "l7d33218f4289"}, {"name": "ゴブリン博士", "text": "は、はいっ！\n最高のデータが取れましたゾ……！！", "face": "l7a9ffec81721"}, {"name": "メカゴブリンクイーン", "text": "それならいいのよぉ！\nさぁ撤収よ！　オーッホッホッホッホ！！", "face": "l7d33218f4289"}, {"name": "エルドラ", "text": "――うっ……頭がガンガンするですの……。", "face": "u549"}, {"name": "シルヴィア", "text": "うぅぅ、まさかゴブリンに操られるなんて……。", "face": "u442"}, {"name": "ソーマ", "text": "ふぅ……プリンセスの皆さんは、\n皆無事みたいですね。", "face": "u23"}, {"name": "アンナ", "text": "ゴブリン軍団は、\nこれまで以上に技術力を上げているようですね……。", "face": "l0cdbaa562e8f"}, {"name": "リリア", "text": "我々も気を抜いてはいられませんね……。\n技術の面でも、心構えの面でも。", "face": "u20"}, {"name": "アンナ", "text": "そうですね……。\n我々も対策を練らなければなりません。\nともかく、此度のゴブリン討伐お疲れさまでした！"}]}], "active": true}