{"quest_id": 7184, "name": "聖槍防衛戦", "description": "空より舞い降りる天使から\n聖槍完成まで遺跡を守りきれ！\n＜出撃時の初期HP減少：小＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["出撃時の初期HP減少：小"], "event": "新たなる千年戦争", "event_category": "History", "mission_id": 920187, "map_no": 5128, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 1, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 3, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 43}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 25, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 5, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 54}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 236, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114224, "race_id": 6, "change_to": 7, "master_id": 30949, "global_id": 4568, "to_global_id": 4567, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 93}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_range": 180, "attack_speed": 55, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114192, "race_id": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30948, "global_id": 4567, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 9, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 116}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "magical", "armor_defense": 400, "magic_defense": 25, "attack_range": 240, "attack_speed": 70, "attack_wait": 35, "attack_interval": 101, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112688, "race_id": 6, "special_effect_id": 234, "missile_id": 236, "missile": {"speed": 8.0}, "master_id": 31369, "global_id": 4988, "ranged": true, "spawn_sec": 148}], "dialogue": [{"trigger": "start", "lines": [{"name": "ネフティ", "text": "――我らの聖地に、\n天使ごときが土足で踏み入るな！！", "face": "u551"}, {"name": "シャディア", "text": "ネフティ、まだ生きているか！？\nもう少しだ、あと少しで王子が来る！", "face": "u713"}, {"name": "ネフティ", "text": "これくらいで死にません！\nネズミに比べれば、連中など羽虫も同然です！", "face": "u551"}, {"name": "シャディア", "text": "それは心強い。\nさすがは聖槍の守護者殿だ！", "face": "u713"}, {"name": "ベルナ", "text": "でも！　もう！　そろそろ！　限界だよ！\n迎撃部隊は全員ピラミッドの外にいたんだから！", "face": "u46"}, {"name": "ゴライア", "text": "うるせェ！！　喚く前に手を動かセ！！\n勝利を盗ムのがテメェの仕事ダロ！！", "face": "u385"}, {"name": "ベルナ", "text": "あっ、シャディアと話してたから嫉妬した？\n嫉妬したんだゴライア！！", "face": "u46"}, {"name": "ゴライア", "text": "冗談言ってる場合カァ！？\n畜生ッ、王子、早く、早く来やがレェ！！", "face": "u385"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "シャディア", "text": "……ふぅ。\n待ちくたびれたぞ、王子。", "face": "u713"}, {"name": "ネフティ", "text": "本当に。\nけれど聖槍は守り抜きましたよ。", "face": "u551"}, {"name": "ベルナ", "text": "時間は稼いで――うぅん、盗んでおいたから。\nあとはあいつらを蹴散らすだけだよ！", "face": "u46"}, {"name": "ゴライア", "text": "ケッ、もう少し遅くても良かったんだゼ？\nだが、テメェがいないとシマラねぇからナ。", "face": "u385"}, {"name": "シャディア", "text": "王子、天使はピラミッドの上空から降下してくる。\nピラミッドの入り口を直接目指す者もいるだろう。\n兵の配置には十分に注意しろ！", "face": "u713"}]}, {"trigger": "end", "lines": [{"name": "ベルナ", "text": "はぁ、はぁっ！\nどんなもんだー！！", "face": "u46"}, {"name": "クリッサ", "text": "ベルナ、気を抜かないで。\n次の部隊が上空の門から出てくるはず。", "face": "u52"}, {"name": "ディーナ", "text": "天使は神の兵器、だっけ？\n兵器だけあって無尽蔵ってわけか。", "face": "u22"}, {"name": "ナナリー", "text": "でも、飛んでるから撃ちやすい……かな。\n聖槍の完成まであと少し、まだまだ戦えるよ。", "face": "u29"}, {"name": "デスピア", "text": "飛んでる方が撃ちやすいっていうの、\nもう天才の域だと思うわ……。\n王子、魔導師隊も健在よ。次の指示を！", "face": "u49"}, {"name": "イリス", "text": "怪我をした方はこちらへ！\n応急手当ですが、絶対に死なせませんから！", "face": "u17"}, {"name": "ミスリア", "text": "――たーっ！！", "face": "u846"}, {"name": "フィグネリア", "text": "たー？　今なにか聞こえたような……？", "face": "u18"}, {"name": "ミスリア", "text": "でーきーたーっ！！\nでーきーまーしーたーっ！！", "face": "u846"}, {"name": "ミスリア", "text": "神殺しの聖槍、その名もグングニル！！\n完成しましたー！！", "face": "u846"}, {"name": "シビラ", "text": "王子、これがあなたの、新たな力。\n立ちふさがる者を貫き砕く、神を殺す唯一の武器。", "face": "u39"}, {"name": "シビラ", "text": "あなたを信じる神器の担い手達が力を注いだ、\n勝利へ導き、答えをもたらす、\n神を砕くために編まれた槍、グングニルよ。", "face": "u39"}, {"name": "アンナ", "text": "王子、グングニルの力を手にとってください。\n「神を討つ意志」の称号を担うことで、\nこの力は王子のものとなります。", "face": "l6637a56cd69d"}, {"name": "シビラ", "text": "私たちの歩む道を、世界の未来を、この槍で貫くの。\nあなたは負けないって誓ったんだから、\nその覚悟を、決意を、私たちに見せてね。", "face": "u39"}]}], "active": true}