 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 49}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "missile_id": 6, "master_id": 8, "ranged": true, "spawn_sec": 81}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 13000, "attack": 700, "base_hp": 13000, "base_attack": 700, "damage_type": "magical", "armor_defense": 350, "attack_range": 250, "attack_speed": 50, "attack_wait": 35, "attack_interval": 191, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102736, "special_effect_id": 568, "missile_id": 6, "master_id": 20183, "global_id": 1258, "ranged": true, "spawn_sec": 108}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 124}], "dialogue": [{"trigger": "start", "lines": [{"name": "死者の王", "text": "自らが王子たちを倒すと勇ましく出て行ったのに\nこの様とは。\nお前には失望した。", "face": "le6fbd3d8f49a"}, {"name": "メメント", "text": "申し訳ありません。お父様。\nボクの力が及ばぬため……。", "face": "u195"}, {"name": "死者の王", "text": "もうよい、下がれ。\n全く……、我が娘ながら使えぬものよ。\nお前の処分はやつらを葬ってからだ。", "face": "le6fbd3d8f49a"}, {"name": "アンナ", "text": "死者の王……。\n禍々しい気配を感じます。\n王子、お気をつけください。", "face": "l77e165d70384"}, {"name": "死者の王", "text": "ここまで辿り着いたことは評価に値する。\nその褒美に、私自ら相手してやろう……！", "face": "le6fbd3d8f49a"}, {"name": "死者の王", "text": "いっておくが、私の死霊魔術が小娘のそれと\n同じと思うな。", "face": "le6fbd3d8f49a"}, {"name": "死者の王", "text": "本当の死霊魔術がどんなものか、\n真の力を見せてやる。", "face": "le6fbd3d8f49a"}, {"name": "死者の王", "text": "さぁ、我の力でさらに凶悪になった\nアンデッドモンスターたちよ！　やつらを葬れ！！", "face": "le6fbd3d8f49a"}]}, {"trigger": "end", "lines": [{"name": "死者の王", "text": "まさか私までもが負けるとは……っ。\nだが、これで勝ったと思うなよ……！", "face": "le6fbd3d8f49a"}, {"name": "死者の王", "text": "私は死を克服し、人間を超越した\n存在なのだ！！", "face": "le6fbd3d8f49a"}, {"name": "死者の王", "text": "私は何度でも蘇るのだ！", "face": "le6fbd3d8f49a"}, {"name": "メメント", "text": "そう、死者の王は肉体を破壊しても\n滅ぶことはない。", "face": "u195"}, {"name": "メメント", "text": "その魂を封じた器を破壊しない限りは\n倒すことはできない……。", "face": "u195"}, {"name": "死者の王", "text": "メメント！\n貴様その手に持っているのは！", "face": "le6fbd3d8f49a"}, {"name": "メメント", "text": "お父様が王子一行と戯れている間に\n見つけたお父様の魂の器です。", "face": "u195"}, {"name": "死者の王", "text": "それをどうするのだ。\nま、まさかっ。", "face": "le6fbd3d8f49a"}, {"name": "メメント", "text": "そう、そのまさかです。\nこの器を破壊させていただきます。", "face": "u195"}, {"name": "メメント", "text": "……さようなら、お父様。", "face": "u195"}, {"name": "死者の王", "text": "ま、まて！　待つのだ！\nまっ……ぅあ゛あ゛あああああああ！！！", "face": "le6fbd3d8f49a"}]}], "active": true}