{"quest_id": 7557, "name": "ゴブリン博士のガリ勉部", "description": "ガリ勉部を設立したゴブリン博士が部費の\n争奪戦に参戦！　博士率いるゴブリン軍団\nとの模擬戦に勝利せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "部費を勝ち取れ　学園大乱闘！", "event_category": "History", "mission_id": 920173, "map_no": 4089, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 650, "base_hp": 9000, "base_attack": 650, "damage_type": "physical", "armor_defense": 200, "attack_range": 280, "attack_speed": 1, "attack_wait": 30, "attack_interval": 121, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2133728, "race_id": 9, "missile_id": 680, "missile": {"speed": 2.0}, "master_id": 34702, "global_id": 8319, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 17, "form_index": 0, "form_count": 1, "hp": 640, "attack": 300, "base_hp": 640, "base_attack": 300, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098912, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 118, "global_id": 117, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 13, "form_index": 0, "form_count": 1, "hp": 750, "attack": 150, "base_hp": 750, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 5, "attack_interval": 91, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2133632, "race_id": 9, "master_id": 34655, "global_id": 8272}, {"enemy_id": 4, "source": "local", "count": 21, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 180, "base_hp": 1200, "base_attack": 180, "damage_type": "physical", "attack_speed": 40, "attack_wait": 5, "attack_interval": 91, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2133648, "race_id": 9, "master_id": 34656, "global_id": 8273, "spawn_sec": 8}, {"enemy_id": 5, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098928, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 119, "global_id": 118, "ranged": true, "spawn_sec": 54}, {"enemy_id": 6, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 3000, "attack": 120, "base_hp": 3000, "base_attack": 120, "damage_type": "magical", "armor_defense": 150, "attack_range": 200, "attack_speed": 70, "attack_wait": 55, "attack_interval": 163, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116288, "race_id": 9, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 32231, "global_id": 5850, "ranged": true, "spawn_sec": 65}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "――分かった！　分かったゾ！！", "face": "l5afb44c31698"}, {"name": "ゴブリン", "text": "ギャギャ？　ハカセ？", "face": "l88f76f1aff08"}, {"name": "ゴブリン博士", "text": "オマエたちは気付いタか？\n今コノ学園ハ、各部活が乱戦状態にアル。", "face": "l5afb44c31698"}, {"name": "ゴブリン", "text": "ダイランセン！　ナカヨクケンカ！", "face": "l88f76f1aff08"}, {"name": "ゴブリン博士", "text": "ウム、王国は部費争奪戦でスラ、\n模擬戦にヨッテ決着をつけるコトで、\n生徒スベテに指揮官とシテの経験を積ませているノダ。", "face": "l5afb44c31698"}, {"name": "ゴブリン", "text": "……ギャギャ？", "face": "l88f76f1aff08"}, {"name": "ゴブリン博士", "text": "指揮官ヲ失っタ軍は弱イ……。\nユエに、誰もが指揮官にナリウル訓練を！\n王子、オマエはワタクシにコレを見せるために……！！", "face": "l5afb44c31698"}, {"name": "ゴブリン博士", "text": "こうしてはいられナイ！\nワタクシも部費争奪戦に加わらなくてハ！！", "face": "l5afb44c31698"}, {"name": "ゴブリン", "text": "ギャギャ？\nヤンキーゴブリン部ハイル？", "face": "l88f76f1aff08"}, {"name": "ゴブリン博士", "text": "否デアル！\n学生ノ本分はベンキョウ！！\nワタクシが新たに設立するノハ――", "face": "l5afb44c31698"}, {"name": "ゴブリン博士", "text": "――ガリ勉部ダッ！！", "face": "l5afb44c31698"}, {"name": "ケイティ", "text": "…………。\nという経緯で、ガリ勉部が誕生したそうなのですが……。", "face": "u1442a1"}, {"name": "クレア", "text": "張り切りすぎて、新入生たちの同好会を、\n根こそぎ蹴散らしてしまっているみたいなんですよね。", "face": "u1444a1"}, {"name": "トワ", "text": "ゴブリン軍団は経験豊富な戦士たちですからね……。\nでも、手加減しろというのも筋違いで。", "face": "u785"}, {"name": "クレア", "text": "そこで、王子になにか名案があったりしないかなって。\nどうです？　なにか解決法は――", "face": "u1444a1"}, {"name": "クレア", "text": "――えっ、あの、王子？\nいきなり武器を構えて、どうしたんですか！？", "face": "u1444a1"}, {"name": "トワ", "text": "クレアさん、もう止めても無駄かと……。\n友人と好きなだけ模擬戦していいぞ、\nなんて言ったら、王子がどうなるのかは……。", "face": "u785"}, {"name": "クレア", "text": "えっ、えーっ！？\nそういう意味で言ったんじゃ……王子っ！　王子～っ！！", "face": "u1444a1"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "オミゴト……ガリ勉部、\n王子ファンクラブにハ届かなかっタか……。", "face": "l5afb44c31698"}, {"name": "クレア", "text": "お、王子ファンクラブ……？\nそれはともかく！　ストップストップ！", "face": "u1444a1"}, {"name": "クレア", "text": "もうっ、王子もゴブリン博士も！\n学生の催しに全力出しちゃダメじゃないですか！", "face": "u1444a1"}, {"name": "ゴブリン博士", "text": "ハッ……タシカニ……。\n部費トカ研究費トイウ響きについつい……。", "face": "l5afb44c31698"}, {"name": "トワ", "text": "……以前は研究費に苦労していたそうですからね。", "face": "u785"}, {"name": "トワ", "text": "でも、勉学に励まんとするその姿勢は、\n他の生徒の模範に相応しいものでした。", "face": "u785"}, {"name": "トワ", "text": "留学中の短い間ではありますが、\nめいっぱい、学びと研究に邁進していってくださいね。", "face": "u785"}, {"name": "ゴブリン博士", "text": "おぉ、おぉ……！　アリガタイ！\n学園トノ共同研究もしてみたかったノダ！", "face": "l5afb44c31698"}, {"name": "トワ", "text": "えぇ、ぜひぜひ♪\n技術研究でしたら、\nレーレン先生にも話を通しておきますね。", "face": "u785"}, {"name": "クレア", "text": "（さすがいいんちょ、キレイにまとめましたね）", "face": "u1444a1"}, {"name": "トワ", "text": "（ふふ、偽らざる本音ですよ）\nそれよりクレアさん、何だか外が騒がしくないですか？", "face": "u785"}, {"name": "クレア", "text": "言われてみれば……。\n部費争奪戦にしても、ちょっと騒ぎすぎというか――", "face": "u1444a1"}, {"name": "コーネリア", "text": "――ファーッハッハッハ！\n次の相手はどいつだ！\nこの暗黒学園騎士コーネリアが相手になるぞ！", "face": "u1441a1"}, {"name": "王子", "text": "…………！？", "face": "u1"}]}], "map": {"image": "Map920173_4089", "w": 960, "h": 640, "spots": [{"k": "b", "x": 952, "y": 216}, {"k": "b", "x": 954, "y": 473}, {"k": "m", "x": 805, "y": 496, "id": 201}, {"k": "m", "x": 798, "y": 363, "id": 202}, {"k": "m", "x": 717, "y": 370, "id": 203}, {"k": "m", "x": 637, "y": 369, "id": 204}, {"k": "m", "x": 565, "y": 360, "id": 205}, {"k": "m", "x": 614, "y": 235, "id": 206}, {"k": "m", "x": 701, "y": 235, "id": 207}, {"k": "m", "x": 795, "y": 235, "id": 208}, {"k": "m", "x": 797, "y": 301, "id": 210}, {"k": "m", "x": 723, "y": 496, "id": 211}, {"k": "m", "x": 719, "y": 433, "id": 212}, {"k": "m", "x": 640, "y": 501, "id": 213}, {"k": "m", "x": 563, "y": 285, "id": 214}, {"k": "m", "x": 496, "y": 287, "id": 215}, {"k": "m", "x": 133, "y": 326, "id": 216}, {"k": "m", "x": 564, "y": 500, "id": 217}, {"k": "m", "x": 495, "y": 362, "id": 218}, {"k": "m", "x": 299, "y": 418, "id": 219}, {"k": "m", "x": 125, "y": 249, "id": 220}, {"k": "m", "x": 141, "y": 404, "id": 221}, {"k": "m", "x": 217, "y": 405, "id": 222}, {"k": "m", "x": 205, "y": 243, "id": 223}, {"k": "m", "x": 277, "y": 242, "id": 224}, {"k": "m", "x": 424, "y": 242, "id": 225}, {"k": "m", "x": 352, "y": 241, "id": 226}, {"k": "m", "x": 119, "y": 463, "id": 227}, {"k": "m", "x": 383, "y": 419, "id": 228}, {"k": "m", "x": 468, "y": 419, "id": 229}, {"k": "m", "x": 471, "y": 497, "id": 230}, {"k": "r", "x": 349, "y": 114, "id": 300}, {"k": "r", "x": 511, "y": 183, "id": 301}, {"k": "r", "x": 376, "y": 309, "id": 302}, {"k": "r", "x": 190, "y": 161, "id": 303}, {"k": "r", "x": 720, "y": 283, "id": 304}, {"k": "r", "x": 566, "y": 419, "id": 305}, {"k": "r", "x": 771, "y": 151, "id": 306}, {"k": "r", "x": 870, "y": 273, "id": 307}, {"k": "r", "x": 802, "y": 412, "id": 308}, {"k": "r", "x": 641, "y": 287, "id": 309}, {"k": "r", "x": 115, "y": 160, "id": 310}, {"k": "r", "x": 268, "y": 307, "id": 311}, {