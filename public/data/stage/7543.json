{"quest_id": 7543, "name": "第三陣 黄金に輝く鋼の騎馬", "description": "新兵器に搭乗したベラート伯爵が飛空戦艦\nと共に現れた。迫りくる反乱軍を退けよ！\n＜広域戦闘：敵味方の射程減少＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国三陣", "event_category": "Empire", "mission_id": 940005, "map_no": 4589, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [55]}, {"kind": "term", "influence": 20, "params": [55]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 3, "tags": ["機械", "帝国"], "hp": 92000, "base_hp": 92000, "damage_type": "physical", "armor_defense": 650, "magic_defense": 10, "attack_speed": 1, "attack_wait": 180, "attack_interval": 502, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133072, "special_effect_id": 956, "change_to": 1, "missile_id": 670, "missile": {"speed": 4.0}, "master_id": 34623, "global_id": 8240, "to_condition": 0, "to_global_id": 8232, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag(0, 1);\"); if (IsStageFlag(999) == 0) { CallEvent(2712, 2713, 2714, 2715); }", "sets_flags": [[0, 1]], "on_destroy": true}, "spawn_sec": 34}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械", "帝国"], "hp": 92000, "attack": 1200, "base_hp": 92000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 650, "magic_defense": 10, "attack_range": 360, "attack_speed": 1, "attack_wait": 180, "attack_interval": 501, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133072, "special_effect_id": 956, "change_to": 2, "missile_id": 670, "missile": {"speed": 4.0}, "master_id": 34615, "global_id": 8232, "ranged": true, "from_condition": 0, "to_condition": 0, "to_global_i