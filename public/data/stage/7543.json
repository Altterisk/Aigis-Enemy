sec": 193}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "帝国"], "hp": 40000, "attack": 800, "base_hp": 40000, "base_attack": 800, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2133104, "race_id": 16, "special_effect_id": 957, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34620, "global_id": 8237, "ranged": true, "from_condition": 0}, {"enemy_id": 18, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 46000, "attack": 650, "base_hp": 46000, "base_attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 210, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133312, "race_id": 16, "change_to": 18, "change_condition": 1, "missile_id": 26, "master_id": 34630, "global_id": 8247, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 46000, "attack": 1800, "base_hp": 46000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133328, "race_id": 16, "master_id": 34631, "global_id": 8248}], "spawn_sec": 197}], "popups": ["ベラート専用バトルタンクが\nいる間、全ての敵の攻撃力と\n防御力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーネ", "text": "――うぅぅぅ、どうしよ、どうしたらいい？\nボクにできること、何かない！？", "face": "u1432a1"}, {"name": "マルレーン", "text": "落ち着いてレーネ。\n慌てるとろくなことないんだから。", "face": "u1434a1"}, {"name": "レーネ", "text": "マルレーンは落ち着き過ぎだよ！\n街の外には伯爵の軍勢がいるのに！", "face": "u1432a1"}, {"name": "マルレーン", "text": "さっきの、アンジェリーネ様たちの話、聞いてた？\nどちらもこの国のことを考えてる。\nだから、街の人が傷つくことは、たぶんないよ。", "face": "u1434a1"}, {"name": "レーネ", "text": "……たぶん、でしょ？", "face": "u1432a1"}, {"name": "マルレーン", "text": "……うん、確証は全然ないかな。\nこっちからしたら、雲の上のお貴族様の話だもん。", "face": "u1434a1"}, {"name": "レーネ", "text": "……でも、アンジェリーネ様は信じたい。\nこんな田舎まで、毎年視察に来てくれるの、\nアンジェリーネ様だけだもん。", "face": "u1432a1"}, {"name": "マルレーン", "text": "うん、そうだね。\n……あの人が守りたいと思うものを、\n今この場所で守れるのは、アタシたちだけだ。", "face": "u1434a1"}, {"name": "ディルク", "text": "――総員警戒！\n上空に飛空戦艦出現！", "face": "u287"}, {"name": "マルレーン", "text": "……よし、頑張ろ、レーネ。\nこれが終わったらお菓子買いに行こ！", "face": "u1434a1"}, {"name": "レーネ", "text": "うん、とびっきり甘いやつ！", "face": "u1432a1"}, {"name": "ベラート", "text": "――美しい街だ。\n愛すべき、白の王国の街だ。", "face": "l21787b277675"}, {"name": "ベラート", "text": "行くぞ諸君！　祖国のために剣を取れ！\nかの傭兵より、国を取り戻すのだ！！", "face": "l21787b277675"}]}, {"trigger": "enemy_death", "enemy_id": 1, "lines": [{"name": "ベラート", "text": "な、な、な、なにぃぃぃぃっ！？\n我が飛空戦艦が！　くっ……脱出だ！　脱出せよ！！", "face": "l21787b277675"}, {"name": "ベラート", "text": "せっかくの最新鋭バトルタンクが……！\nくぅぅぅっ、覚えておけ、白の皇帝めッ！！", "face": "l21787b277675"}, {"name": "アンナ", "text": "どうやら、新型兵器の\n出撃を防ぐことができたようですね。"}, {"name": "アンナ", "text": "王子、敵の攻勢が続いています。\n引き続き指揮をお願いします！", "face": "l91db55a83012"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "ベラート伯爵、見れば分かるぞ。\nこの攻勢のために、領地の戦力の殆どを割いたな。", "face": "u311"}, {"name": "レオナ", "text": "もはや、反乱軍に勝機はない。\n投降すれば極刑は免れるかもしれないぞ。", "face": "u311"}, {"name": "ベラート", "text": "フッ……たわ言を。\nまだ勝負はついてはおりませんからな。", "face": "l21787b277675"}, {"name": "ベラート", "text": "白の王国を取り戻す、そのためならば、\nこのベラート、己を犠牲にすることすら厭わぬと知れ！", "face": "l21787b277675"}, {"name": "レオラ", "text": "利権を取り戻すためなら、の間違いじゃないかしらぁ？", "face": "u464"}, {"name": "ベラート", "text": "利権を求めて何が悪いッ！\n民は耕し、作り、貴族は貪り、領土を守るために戦う！\nそこに何の問題があるというのだッ！！", "face": "l21787b277675"}, {"name": "ルーテ", "text": "……ベラート伯爵領は、\n確かに腐敗の温床ではありましたが、\n重税もなく、兵も精強であると聞きます。", "face": "u529"}, {"name": "ルーテ", "text": "ですが、それは彼の領地が力を持っていたから。\n力なき貴族は領地を奪われ、\n白の帝国に組み込まれていったのも、また事実です。", "face": "u529"}, {"name": "ディアナ", "text": "ルーテ、あなたの家もそのひとつでしたね。\n……あちらに付きますか？", "face": "u624"}, {"name": "ルーテ", "text": "ふふっ、ディアナ様ったら御冗談を。\nもう私の家に、かつての力はありませんから。", "face": "u529"}, {"name": "ルーテ", "text": "それに、誰も彼もが忘れています。\n上が争えば、そのしわ寄せをくらうのは民なのです。\nならば、今できることは――", "face": "u529"}, {"name": "ディアナ", "text": "――見せかけの安定を維持することだけ。\n真の平和を目指すのは、亜神の脅威が去ってから。\n……どうやら、同意見のようですね。", "face": "u624"}, {"name": "ディアナ", "text": "では、ベラート伯爵を捕らえに行きましょう。\nこの戦い、すでに趨勢は決まって――", "face": "u624"}, {"name": "マルゴット", "text": "――ディアナ様！\n王国の死霊魔術師より報告です！\n周辺から、異様な魔力を感知したと！", "face": "u1343a1"}, {"name": "ディアナ", "text": "…………異様な、魔力？\n死霊魔術……まさか……！！", "face": "u624"}]}, {"trigger": "route", "lines": [{"name": "ベラート", "text": "――我が兵よ、我が民たちよ、今行くぞ！\n黄金に輝く鋼の騎馬！\n最新鋭バトルタンクの勇姿を見るが良い！", "face": "l21787b277675"}, {"name": "貴族騎士", "text": "おぉ、おぉ！　兵たちよ、見よ！\n伯爵殿が最前線に、我らと共に立つぞ！", "face": "l36511b202f8c"}, {"name": "レオナ", "text": "……何が勇姿なものか。\n賄賂と不正で蓄えた資金の結晶だろう。", "face": "u311"}, {"name": "白の皇帝", "text": "だが、指揮官が前線に並び立つことの心強さは、\n俺たちも十分に理解していることだろう。", "face": "u418"}, {"name": "白の皇帝", "text": "王子、気をつけろ。\n敵軍の士気はより高くなるぞ。", "face": "u418"}]}], "active": true}