global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 199}, {"enemy_id": 25, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}], "popups": ["オーク旗手が持つ\n敵の攻撃と防御アップの能力は、\nオーク旗手の数に応じて効果が\n重複します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "うおおおおおおおおおっっ！！\nチャンプッ！　チャンプッ！！", "face": "le8d3f3acf4c9"}, {"name": "アナトリア", "text": "……ったく、\n一体どこから湧いてきたんだい。\n邪魔だよ、さっさと散りな！", "face": "u1522"}, {"name": "ドゥーラ", "text": "無駄だぜアナトリア。\nみんな、これから始まるだろう\n世紀の戦いに胸躍らせてんのさ。", "face": "u446"}, {"name": "ベストラ", "text": "オークの英雄と、人の英雄……いわば\n人とオークの頂上決戦、\n見逃せる訳がありません！", "face": "u474"}, {"name": "アナトリア", "text": "やれやれ、あたしはアイツと決着が付けられれば\nそれで良かったんだけどね。\n一体どこから聞きつけたんだか……。", "face": "u1522"}, {"name": "アナトリア", "text": "……ま、観客がいてこその闘技場か。\n久しぶりにこんな舞台で戦うのも悪くないかもね。\nさて……来たようだね！", "face": "u1522"}, {"name": "ケイティ", "text": "――……凄まじい熱気です。皆さん、\n会場の空気に飲まれないよう気を付けて下さい。", "face": "u114"}, {"name": "アンナ", "text": "……この場でアナトリアさんと\n相対するのは二度目ですね。", "face": "l831eb29f1552"}, {"name": "アナトリア", "text": "そういえばそうだったね……なんてまぁ、\nそんな事はもうどうでもいいさ。初めてあったのが\nいつだろうが、やる事に変わりはしないんだからね。", "face": "u1522"}, {"name": "アナトリア", "text": "下らない話はもういらない……さぁ、\n楽しませてもらうよ、人間の英雄の力ってやつを！\n途中で死んじまわないよう気を付ける事だね！！", "face": "u1522"}, {"name": "アンナ", "text": "例えアナトリアさんが相手であろうと、\n王子は絶対に負けません！", "face": "l831eb29f1552"}, {"name": "アナトリア", "text": "そいつぁ楽しみだ！　\nさぁ、全力で行くよ！！", "face": "u1522"}, {"name": "オーク", "text": "なんという気迫のぶつかり合い……。\nここにいては戦いの邪魔をしかねん、\nオレ達は退避しておくとしよう。", "face": "le8d3f3acf4c9"}]}, {"trigger": "battle", "at_sec": 26, "lines": [{"name": "オーク", "text": "クッ……この戦いばかりは静観しようと\n思ったが……無理だ！　オークとして、\nこれ以上体の疼きを抑えられようものか！", "face": "le8d3f3acf4c9"}, {"name": "ベストラ", "text": "だ、ダメですよ。\n今は真剣勝負の最中、邪魔する訳には！", "face": "u474"}, {"name": "ドゥーラ", "text": "……とかなんとか言ってるお前も、\n今にも飛び出しそうじゃねーか。\n疼いてしょうがねーんだろ。", "face": "u446"}, {"name": "ドゥーラ", "text": "こんな戦いを見て、大人しく見ていられるのなら、\nそいつはオークじゃねぇ！　\nすまない王子、悪いがみてるだけにはいかないぜ……！", "face": "u446"}]}, {"trigger": "end", "lines": [{"name": "アナトリア", "text": "ぐッ……参ったよ……あたしの負けだ。", "face": "u1522"}, {"name": "アンナ", "text": "勝った……勝ちましたよ、王子！\nアナトリアさんに勝ちました！！"}, {"name": "ケイティ", "text": "とは言え、ギリギリの勝負でした。\n次に戦えば、どちらが勝つかは全く判りません。\nオークの皆さんによる乱入もありましたしね。", "face": "u114"}, {"name": "ドゥーラ", "text": "わ、悪かったよ……。\nだって、あんな勝負見せつけられて\nじっと見てるだけなんて、我慢できないぜ。", "face": "u446"}, {"name": "ベストラ", "text": "私もあんなに闘志を感じたのは初めてでした。\n気持ちの高ぶりを抑えられなくて……すみません。", "face": "u474"}, {"name": "アナトリア", "text": "……乱入があろうがなかろうが、\nさっきのは間違いなくあたしの全力さ。", "face": "u1522"}, {"name": "アナトリア", "text": "そんなあたしにあんた達は勝った、\nそしてあんた達にあたしは負けたんだ。世辞や言い訳は\n必要ない……ここじゃ最後に立っている者こそが勝者だ。", "face": "u1522"}, {"name": "アナトリア", "text": "次どうなるかなんて関係ない。\n今、ここに立っているのはあんた達なんだ。\n勝者として、しゃんと胸を張りなよ！", "face": "u1522"}, {"name": "アンナ", "text": "アナトリアさん……。\nありがとうございます！"}, {"name": "アナトリア", "text": "ま、とはいえあたしも負けたまんまで終わるつもりも\n無いからね……それでだ、一つ頼みがあるんだが。", "face": "u1522"}, {"name": "ドゥーラ", "text": "オレはアナトリアが何を頼みたいか、\n大体想像できるぜ。", "face": "u446"}, {"name": "ベストラ", "text": "そうですね。\n王子たち皆さんも想像できてると思います。", "face": "u474"}, {"name": "アナトリア", "text": "……お見通し、って顔してるね、王子。\nまぁその通りだと思うけどさ。\nあたしも仲間に加えてくれないかい。", "face": "u1522"}, {"name": "アナトリア", "text": "王子の戦いぶりを見てると、\nまだあたしにも足りないものがあるって感じるんだ。\nそれを得れば、もっと強くなれそうだってね。", "face": "u1522"}, {"name": "アンナ", "text": "アナトリアさんが仲間に加わってくれれば\nとても心強いです！\nこちらこそ、よろしくお願いします！"}, {"name": "アンナ", "text": "それでは帰還いたしましょう。\n王子、この度の戦い、お疲れ様でした！"}]}], "story_talk": true, "active": true}