{"quest_id": 6239, "name": "英雄対英雄", "description": "オークの観衆が見守る闘技場。\n今こそアナトリアとの決着を付けよ！\n＜旗手がいる間敵の攻撃と防御アップ＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["旗手がいる間敵の攻撃と防御アップ"], "event": "王者達のバトルロイヤル", "event_category": "History", "mission_id": 920095, "map_no": 5208, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 250, "base_hp": 5000, "base_attack": 250, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102608, "race_id": 8, "special_effect_id": 567, "master_id": 381, "global_id": 380, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102640, "race_id": 8, "change_to": 2, "change_condition": 3, "master_id": 383, "global_id": 382, "to_condition": 3, "to_global_id": 383, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 450, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102656, "race_id": 8, "master_id": 384, "global_id": 383, "from_condition": 3}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 2, "hp": 6000, "attack": 800, "base_hp": 6000, "base_attack": 800, "damage_type": "physical", "ar