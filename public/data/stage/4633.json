{"quest_id": 4633, "name": "さらわれたセレイナ", "description": "ヴァンパイア公爵と\n麻痺爪を振るう氏族を撃破し、\nさらわれたセレイナを救い出せ！\n神級（★１獲得の目安：平均Lv50）", "event": "天使たちの陰謀", "event_category": "History", "mission_id": 920070, "map_no": 3196, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 2, "tags": ["アンデッド"], "hp": 7000, "attack": 450, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_speed": 35, "attack_wait": 50, "attack_interval": 171, "move_speed": 650.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105104, "special_effect_id": 240, "change_to": 1, "master_id": 644, "global_id": 643, "to_global_id": 642, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 7000, "attack": 450, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 30, "attack_speed": 35, "attack_wait": 50, "attack_interval": 136, "move_speed": 650.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105424, "special_effect_id": 240, "missile_id": 45, "master_id": 643, "global_id": 642, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 20, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 20, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 8}, {"enemy_id": 2, "source": "local", "count": 12, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 450, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 30, "attack_speed": 35, "attack_wait": 50, "attack_interval": 136, "move_speed": 650.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105424, "special_effect_id": 240, "missile_id": 45, "master_id": 643, "global_id": 642, "ranged": true, "spawn_sec": 48}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 30, "attack_wait": 50, "attack_interval": 201, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105360, "master_id": 634, "global_id": 633, "spawn_sec": 114}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157, "spawn_sec": 114}], "dialogue": [{"trigger": "start", "lines": [{"name": "セレイナ", "text": "きゃぁッ――！？\nは、離してくださいッ！\n貴方は……いったい何者なのですか……？", "face": "u375"}, {"name": "公爵", "text": "怯えているな、女。\nククク……実にいい表情だ。", "face": "l95958961146f"}, {"name": "公爵", "text": "我は高貴なる吸血種の長にして、\n貴様ら下等な人間を支配する者だ。", "face": "l95958961146f"}, {"name": "セレイナ", "text": "他者の命を弄ぶ不浄の異種が、\n私に何の用だというのですか……！？", "face": "u375"}, {"name": "公爵", "text": "何の用、だと……？\nフハハハッ！　これは傑作だ。\n吸血鬼を前にしてその様な問いを向けるとはな。", "face": "l95958961146f"}, {"name": "セレイナ", "text": "……私の血を、奪うというのですね……。", "face": "u375"}, {"name": "公爵", "text": "そう悲観するでない。我は低位の吸血鬼が\n行うような野蛮な採血手法を捨てている……。\n貴様はより美しい方法で我に血を贈与するのだ！", "face": "l95958961146f"}, {"name": "セレイナ", "text": "う、美しい……方法……？\n何を、言っているのですか……？", "face": "u375"}, {"name": "公爵", "text": "貴様のような高位の神官の血を半永久的に\n採取する機関が完成したのだよ……ククク。\n最初の被験者は貴様だ。光栄に思うがいい！", "face": "l95958961146f"}, {"name": "セレイナ", "text": "血を半永久的に……採取する……？\nそんな……イヤです……誰か、誰か助けて……。", "face": "u375"}, {"name": "公爵", "text": "そうだ、もっと鳴いてみせろ……ククク。\nその絶望が、貴様の血を\nより甘美なものにするのだ！", "face": "l95958961146f"}, {"name": "アンナ", "text": "――そこまでです、公爵！\n今すぐセレイナさんを解放してください！", "face": "l7321c8eb4085"}, {"name": "公爵", "text": "……ほう、これは都合がいい。\n貴様のような美しい女が自らやってくるとはな。\nこの聖職者と共に貴様の血も頂くとしよう！", "face": "l95958961146f"}]}, {"trigger": "end", "lines": [{"name": "公爵", "text": "――グぁッ、はァ……はぁ……。\nなぜ我が、膝をついている……？\n人間ごときに……後れを取るとは……。", "face": "l95958961146f"}, {"name": "公爵", "text": "クソ……。\nどうやら考えを改めなくてはいけないようだな……。", "face": "l95958961146f"}, {"name": "公爵", "text": "一刻も早く完全な力を取り戻し、人間達を\n我が支配下に置かなくては、危険だ……！", "face": "l95958961146f"}, {"name": "アンナ", "text": "公爵が退いていきます……！\nやりましたね、王子！", "face": "l7321c8eb4085"}, {"name": "セレイナ", "text": "ありがとうございます、王子。\n本当に、もうダメかと思いました……。", "face": "u375"}, {"name": "フーリ", "text": "セレイナさん、そんなに身体を震わせて……。\nさぞや恐ろしかったのでしょうね。", "face": "u174"}, {"name": "アンナ", "text": "もう安心して下さい、セレイナさん。\n今の貴方には王子と私達がいます！\nさあ、共に帰還しましょう。"}]}], "active": true}