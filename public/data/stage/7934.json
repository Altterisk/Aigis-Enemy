ed": 1, "attack_wait": 45, "attack_interval": 131, "move_speed": 450.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116816, "special_effect_id": 92, "change_to": 38, "change_condition": 2, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 31451, "global_id": 5070, "ranged": true, "to_condition": 2, "to_global_id": 5071, "spawn_sec": 181}, {"enemy_id": 38, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 550, "base_hp": 30000, "base_attack": 550, "damage_type": "magical", "armor_defense": 750, "magic_defense": 20, "attack_range": 312, "attack_speed": 1, "attack_wait": 45, "attack_interval": 131, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116864, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 31452, "global_id": 5071, "ranged": true, "from_condition": 2}, {"enemy_id": 40, "source": "local", "count": 6, "form_count": 1, "hp": 13000, "attack": 500, "base_hp": 13000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 15, "attack_range": 220, "attack_speed": 1, "attack_wait": 45, "attack_interval": 131, "move_speed": 1150.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119760, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 31921, "global_id": 5540, "ranged": true, "spawn_sec": 185}, {"enemy_id": 41, "source": "local", "count": 3, "form_count": 1, "hp": 11500, "attack": 280, "base_hp": 11500, "base_attack": 280, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 45, "attack_interval": 127, "move_speed": 1150.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114272, "missile_id": 265, "missile": {"speed": 2.0}, "master_id": 30956, "global_id": 4575, "ranged": true, "spawn_sec": 185}], "popups": ["金光聖菩は分身がいる間、\n攻撃力、防御力がアップします。\nまた、分身の数に応じて効果が\n重複します。", "清源妙道真君(本体)のいる間は、\n味方ユニットの攻撃力と防御力、\n魔法耐性が『20%』低下します。", "太公望は、\n徐々に自身のHPを回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "元始天尊", "text": "――何をやり遂げたような顔になっているのですか！\n立ちなさい！\nそれでも華の国を陰より支える仙人ですか！", "face": "l82645b3c9fe1"}, {"name": "聞忠", "text": "くっ……まだまだ……！！", "face": "lbdabd395b30e"}, {"name": "元始天尊", "text": "誅子も誅子です！\n守られてばかりで何が王ですか！\n王子を見習いなさい！　最前線に率先して飛び込む気概を！", "face": "l82645b3c9fe1"}, {"name": "誅子", "text": "よ、余とて、いつも最前線に……！！", "face": "lbd7844e34f72"}, {"name": "元始天尊", "text": "口答えは我が刃を\n受け止められるようになってからです！\nそれまでは行動で応えなさい！！", "face": "l82645b3c9fe1"}, {"name": "フェイロン", "text": "……あ、あの、これは？", "face": "u1720a1"}, {"name": "清源妙道真君", "text": "ははは、さすがは元始天尊様。\n愛の鞭はまったく衰えていませんね。", "face": "u866"}, {"name": "太公望", "text": "まったくです。\nというより、この知性派きっての武闘派、\n元始天尊様を倒すとは上層の亜神、何者なのでしょうか。", "face": "u603"}, {"name": "聞忠", "text": "あぁっ！？　誅子！　大丈夫ですか！？", "face": "lbdabd395b30e"}, {"name": "誅子", "text": "へ、平気だ……。\nそれより聞忠、余を甘やかすな！", "face": "lbd7844e34f72"}, {"name": "元始天尊", "text": "仙人より先に、人の子がこの特訓の真意を\nつかんでいるではありませんか。\n聞忠、それでよく邪仙が名乗れますね！？", "face": "l82645b3c9fe1"}, {"name": "聞忠", "text": "し、しかし……。", "face": "lbdabd395b30e"}, {"name": "元始天尊", "text": "守ると決めたなら、\nあらゆるものから最後まで守り抜きなさい。", "face": "l82645b3c9fe1"}, {"name": "元始天尊", "text": "共に戦うと決めたなら、\n半端な甘さを見せず、その背中を頼りなさい。", "face": "l82645b3c9fe1"}, {"name": "元始天尊", "text": "好きだから、可愛いから、守りたいから、\n甘えたいから、\nそんな中途半端な感情で国が成り立つものですか！", "face": "l82645b3c9fe1"}, {"name": "元始天尊", "text": "――さて、王子。\nそろそろ例のお手伝いをしてもらいましょうか。", "face": "l82645b3c9fe1"}, {"name": "誅子", "text": "おう、じ……？\n元始天尊様、いったい何をするつもりで――", "face": "lbd7844e34f72"}, {"name": "元始天尊", "text": "もちろん、特訓です。\n王子、全力でこの子たちを叩きのめしてくださいね。", "face": "l82645b3c9fe1"}, {"name": "聞忠", "text": "なっ……！？", "face": "lbdabd395b30e"}, {"name": "普賢", "text": "（元始天尊様、そんなこと言っておいて、\nどうせ楽しくなって自分も参戦しちゃうんだろうな）", "face": "u1782a1"}, {"name": "太公望", "text": "（普賢、あなたも同類でしょうに）", "face": "u603"}, {"name": "元始天尊", "text": "さぁ、立ちなさい華の国の子らよ！\n英雄王を継ぐ者の胸を借り、\n己の未熟さを思い知るのです！", "face": "l82645b3c9fe1"}]}, {"trigger": "end", "lines": [{"name": "誅子", "text": "……も、う、脚に力が、はいらな……。", "face": "lbd7844e34f72"}, {"name": "聞忠", "text": "仙力が……尽き……て……。", "face": "lbdabd395b30e"}, {"name": "元始天尊", "text": "――分かりましたか。\n己がどれだけ未熟なのか、どれだけ驕っていたのか。", "face": "l82645b3c9fe1"}, {"name": "誅子", "text": "……はい。", "face": "lbd7844e34f72"}, {"name": "聞忠", "text": "えぇ……。", "face": "lbdabd395b30e"}, {"name": "誅子", "text": "なぁ、フェイロン、国は無事に動いているか。\n私など必要ないくらいに。", "face": "lbd7844e34f72"}, {"name": "フェイロン", "text": "はっ……その……。", "face": "u1720a1"}, {"name": "普賢", "text": "言ってやれ、フェイロン。\nトドメ……いや、きっかけが必要だろう。", "face": "u1782a1"}, {"name": "フェイロン", "text": "……華の国は、急速に復興作業が進み始めました。\n私は書類を振り分け、指示を出すだけですが、\n末端の者たちが国を立て直そうと張り切っています。", "face": "u1720a1"}, {"name": "フェイロン", "text": "今の華の国に必要なのは、王ではありません。\n物資と人員だけです。", "face": "u1720a1"}, {"name": "誅子", "text": "そう、か……。\nそうだろうな、分かっていたことか。", "face": "lbd7844e34f72"}, {"name": "普賢", "text": "お前たち、旅にでも出たらどうだ。\n見聞が狭すぎるんだ、誅子も、聞忠も。", "face": "u1782a1"}, {"name": "普賢", "text": "世界を知らずして為政者にはなれない。\n戦う相手、味方とする相手、救うべき相手、\nそれらを見ることもなく、何が王だ。", "face": "u1782a1"}, {"name": "誅子", "text": "王とは……か……。", "face": "lbd7844e34f72"}, {"name": "フェイロン", "text": "あの、でも、できるだけ早く帰ってきてください。\n国が回っていることと、主君らが不要であるということは\n等号で結べるものではありません。", "face": "u1720a1"}, {"name": "フェイロン", "text": "まだ、国号を変えるには早すぎます。\n民も、我らの馬鹿王はいつ戻るんだと\n笑い話をしながらおふたりを待っていますので。", "face": "u1720a1"}, {"name": "誅子", "text": "ははは！　馬鹿王か！\nよし、ならば出立を急ぐとしよう。\n聞忠、これより旅に出るぞ！！", "face": "lbd7844e34f72"}, {"name": "聞忠", "text": "はい、誅子。\nあぁっ、また服が乱れて……！", "face": "lbdabd395b30e"}, {"name": "元始天尊", "text": "……聞忠、甘やかさぬように。\n愛と過保護の違いを見極めるのも、\nこの旅の目的のひとつとしておきなさい。", "face": "l82645b3c9fe1"}, {"name": "普賢", "text": "ふぅ……ようやく一段落だな。\nさぁて、肩の荷も降りたことだし！\n崑崙でめくるめく昼寝タイムが待って――", "face": "u1782a1"}, {"name": "元始天尊", "text": "普賢、あなたは王国へ行きなさい。", "face": "l82645b3c9fe1"}, {"name": "普賢", "text": "――いなかった。\n私の昼寝タイムは！？", "face": "u1782a1"}, {"name": "元始天尊", "text": "私はしばし、崑崙の修復にかかりきりになります。\nその間、王国との連絡係を誰がするというのです。", "face": "l82645b3c9fe1"}, {"name": "普賢", "text": "やっぱ亜神ってのは信用ならない！\nくそっ、どうしてこうなったぁ！？", "face": "u1782a1"}, {"name": "元始天尊", "text": "そういうわけですから、\n王子、この子をよろしく頼みますね？", "face": "l82645b3c9fe1"}]}], "active": true}