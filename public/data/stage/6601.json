": 2115152, "race_id": 16, "special_effect_id": 54, "master_id": 31143, "global_id": 4762, "spawn_sec": 74}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 1, "hp": 1500, "attack": 400, "base_hp": 1500, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 61, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110336, "special_effect_id": 164, "missile_id": 45, "master_id": 30285, "global_id": 3904, "ranged": true, "spawn_sec": 85}, {"enemy_id": 10, "source": "local", "count": 9, "form_count": 1, "hp": 1500, "attack": 400, "base_hp": 1500, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 111, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110320, "special_effect_id": 165, "missile_id": 45, "master_id": 30284, "global_id": 3903, "spawn_sec": 106}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 40, "attack_wait": 30, "attack_interval": 133, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102272, "race_id": 16, "master_id": 369, "global_id": 368, "spawn_sec": 147}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 600, "base_hp": 12000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 70, "attack_wait": 60, "attack_interval": 162, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100928, "race_id": 16, "special_effect_id": 226, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31318, "global_id": 4937, "ranged": true, "spawn_sec": 149}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "attack_range": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 59, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116176, "special_effect_id": 164, "missile_id": 45, "master_id": 31314, "global_id": 4933, "ranged": true, "spawn_sec": 179}], "dialogue": [{"trigger": "start", "lines": [{"name": "クゥイル", "text": "守護と攻撃、\n貴殿らの戦闘能力は十分見せていただきました。", "face": "u702"}, {"name": "クゥイル", "text": "しかし、いざという時に\n窮地に駆けつけられてこそ真の英雄。", "face": "u702"}, {"name": "クゥイル", "text": "目まぐるしく移り変わる戦闘に対応出来てこそ、\n本物の強者であると言えるでしょう。", "face": "u702"}, {"name": "テティス", "text": "つまり、機動力のある私達の出番ということですね。\n可愛らしいクゥイルさんが\n見ているとなると、気合が入りますね？", "face": "u37"}, {"name": "エレイン", "text": "まっ、確かに速度なら私達が最速よね。\nいくら王子でも、騎兵の速度には追いつけないもの。", "face": "u36"}, {"name": "リオン", "text": "あら、騎乗している上に弓も使える、\nあたし達の方が速度では上ではないかしら？", "face": "u251"}, {"name": "ミゲル", "text": "へっ、身内同士で言い争ってんなよ。\nオレは王子の兄貴にイイトコ見せられるかもって、\n今すっげぇワクワクしてんだからよ。", "face": "u369"}, {"name": "シプリア", "text": "騎兵諸君の速度自慢は結構だけど、\n身軽さも忘れてもらっては困るな。", "face": "u51"}, {"name": "エレイン", "text": "ふふん、頼りにしてるわシプリア。\n王子に勝ったら美味しい甘味を食べに行くわよ！", "face": "u36"}, {"name": "クゥイル", "text": "……甘味、いいですね。\nうぅ……羨ましい……。", "face": "u702"}, {"name": "エレイン", "text": "あら？　クゥイルも一緒に行く？", "face": "u36"}, {"name": "クゥイル", "text": "い、いえ！　私には任務がありますので！", "face": "u702"}, {"name": "クゥイル", "text": "こほん。王子殿下の実力はよく分かりました。\nしかしまだまだ、こんな物ではないはず！\n更なる力を、私に見せてください！", "face": "u702"}]}, {"trigger": "end", "lines": [{"name": "クゥイル", "text": "この猛攻まで凌ぐとは、\nやはり王子殿下こそ英雄の器と言えそうですね。", "face": "u702"}, {"name": "クゥイル", "text": "ではこの次は――", "face": "u702"}, {"name": "エレイン", "text": "ちょーっと待った！　一度休憩にしましょ。\nせっかく縁が出来たんだし、\n一緒にお昼でもいかがかしら？", "face": "u36"}, {"name": "クゥイル", "text": "えっ、いや、しかし私には任務が……。", "face": "u702"}, {"name": "シュシュ", "text": "お昼ごはん！　お昼ごはんは大事ですよ！\nクゥイルちゃんも一緒にごはん食べませんか？", "face": "u656"}, {"name": "クゥイル", "text": "シュシュまで……でも、えぇと、だから……。", "face": "u702"}, {"name": "ケイティ", "text": "十分な休息がなければ、訓練の効果は半減します。\nそれに、世界樹と王国間の\n親交を深めるのも、大切な任務ではないでしょうか。", "face": "u114"}, {"name": "テティス", "text": "そうですよ？　さぁ向こうで親交を深めましょう？", "face": "u37"}, {"name": "クゥイル", "text": "うっ、うぅ……。", "face": "u702"}, {"name": "シプリア", "text": "ほら、私はもう腹ペコなんだ。\n文句を言わずに付いてくる付いてくる。", "face": "u51"}, {"name": "クゥイル", "text": "あっ、ちょっと、手を離して、あぁっ！？", "face": "u702"}, {"name": "シュシュ", "text": "（ねっ、クゥイルちゃん。\n王国の皆さんって、\nとーってもいい人達ですよね♪）", "face": "u656"}, {"name": "クゥイル", "text": "（うぅ、否定はしません。\nむしろお人好し過ぎるくらいです……）", "face": "u702"}, {"name": "アンナ", "text": "それでは模擬戦の前半をここで終了し、\n休憩にいたしましょう。\n後半に向けて、十分に英気を養ってくださいね。"}]}], "active": true}