{"quest_id": 6235, "name": "戦いを求める者たち", "description": "剣を打ち直すべく洞窟へと\n訪れたアナトリアの前に、\n戦いを求めし猛者達が姿を現す。\n神級（★１獲得の目安：平均Lv50）", "event": "王者達のバトルロイヤル", "event_category": "History", "mission_id": 920095, "map_no": 5204, "level": 100, "multiplier": 1.0, "charisma": 115, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111504, "race_id": 18, "change_to": 1, "master_id": 30596, "global_id": 4215, "to_global_id": 3857, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30238, "global_id": 3857, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 33, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 3, "master_id": 986, "global_id": 985, "to_global_id": 987, "spawn_sec": 10}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 2, "master_id": 988, "global_id": 987}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 3, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111504, "race_id": 18, "change_to": 5, "master_id": 795, "global_id": 794, "to_global_id": 483, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 15}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 6, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_global_id": 624}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 5, "master_id": 625, "global_id": 624}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 