"base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 3, "master_id": 986, "global_id": 985, "to_global_id": 987}, {"enemy_id": 31, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 2, "master_id": 988, "global_id": 987}, {"enemy_id": 32, "source": "local", "count": 4, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 7, "master_id": 796, "global_id": 795, "to_global_id": 484, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 140}, {"enemy_id": 32, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 8, "master_id": 485, "global_id": 484, "to_global_id": 625}, {"enemy_id": 32, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 7, "master_id": 626, "global_id": 625}, {"enemy_id": 33, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 1200, "base_hp": 5000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103936, "race_id": 18, "master_id": 987, "global_id": 986, "spawn_sec": 149}], "popups": ["ラクシャーサ、バロウス、\nメフィストは倒されると、\nその場で復活します。\n復活は5回まで行われます。\n\nオーラをまとったラクシャーサは\n倒されると、自身の周囲に\nダメージを与えます。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "アナトリア", "text": "――それじゃ、コイツをよろしく頼むよ。\n気付けば随分とボロボロになっていたからね。\nここでなら素材も取れるだろう。", "face": "u522"}, {"name": "ティニー", "text": "任せてちょうだい。\nドワーフの姫にして天才鍛冶師、ティニー、\nこの名に恥じる様な仕事はしないわ！", "face": "u523"}, {"name": "アナトリア", "text": "頼もしい限りだね。あんたを呼んでおいた甲斐も\nあるってもんだ。……久々に全力でやりたい奴がいる、\n最高のやつをお願いするよ。", "face": "u522"}, {"name": "ティニー", "text": "えぇ、最高の剣に仕上げてみせるわ！\nそれじゃ、早速素材を集めなきゃ……あら？\n誰か来たみたいよ？", "face": "u523"}, {"name": "ラクシャーサ", "text": "――……オークの英雄、アナトリア。\n一度戦ってみたいと足を運んだが……どうせなら、\n剣を打ち直した後、全力で戦いたいものだな。", "face": "u306"}, {"name": "アナトリア", "text": "こいつは珍しいお客様だね。魔神の連中とは、\nあたしもぜひ一度手合わせしたいと思ってたんだ。\nあたしは別に今でも構わないよ……やるかい？", "face": "u522"}, {"name": "バロウス", "text": "うーん……折角だし全力のアナトリアを見てみたいな。\n……そうだ、わたし達で素材を集めるのを手伝おうよ！　\nねぇメフィスト、何か良い案とかない？", "face": "u448"}, {"name": "メフィスト", "text": "ふぅむ。私の知識が欲しいならくれてやろう。\nこの辺りの岩盤は粒度が荒いようだな。", "face": "u526"}, {"name": "メフィスト", "text": "多大なエネルギーを意図的に与えれば……\nつまり、端的に言うと、人為的破壊を行い\n鉱石を迅速に獲得するのが良かろう。", "face": "u526"}, {"name": "バロウス", "text": "もう～。相変わらず話長いよね、メフィストって。\n壁を壊せっていうだけでいいのに……。\nよーっし分かったわ！　任せて！", "face": "u448"}, {"name": "ティニー", "text": "ちょ、ちょっと待ちなさいよ！　魔神の力で\n壁面を攻撃なんてしたら洞窟が崩壊しかね……\n……ちょ、ちょっと、話を聞いてってば！", "face": "u523"}, {"name": "アンナ", "text": "――何やら人の気配がするようですが。\nあれは、アナトリアさん！！", "face": "l831eb29f1552"}, {"name": "アナトリア", "text": "あぁ、あんた達か。\n今は見ての通り立て込んでてね。\n戦いなら、また後にしてくれるかい？", "face": "u522"}, {"name": "アンナ", "text": "どうやらお困りのようですね。\n……以前のお礼もあります、\n是非私達にも協力させてください！"}, {"name": "ティニー", "text": "誰だか知らないけど、協力してくれるっていうなら\nお願いするわ！　このままじゃ洞窟が崩壊しちゃう！\nあの人達を止めるのを手伝って！", "face": "u523"}, {"name": "アナトリア", "text": "やつらは魔界の中でも別格の存在、魔神の連中だ。\n数回倒した程度じゃまたすぐ立ち上がる。\n倒したからって油断するんじゃないよ、気をつけな。", "face": "u522"}]}, {"trigger": "end", "lines": [{"name": "ラクシャーサ", "text": "おい……二人とも、そこまでにしておけ。\nこれ以上やれば洞窟が崩壊しかねないぞ。", "face": "u306"}, {"name": "バロウス", "text": "え？　で、でも、鉱石たくさん出てきてるみたいだよ。\n今やめるのはもったいないよ……！", "face": "u448"}, {"name": "メフィスト", "text": "意見の二分を解決するには私の知識が必須だ。\n現在の状況を纏めると、洞窟崩壊の確率は80％、\n採掘可能な鉱石の埋蔵率は残り5％と推測される。", "face": "u526"}, {"name": "メフィスト", "text": "一見して洞窟崩壊の危険性が高くラクシャーサの提案が\n妥当に見えるが、残り5％の鉱石を使ってアナトリアの\n武具を新調した場合の興奮度は1000％。", "face": "u526"}, {"name": "メフィスト", "text": "導き出された答え、それは……\n「鉱石掘削の続行」である。", "face": "u526"}, {"name": "ラクシャーサ", "text": "まったく……仕方ない、この場は\n無理やり連れて行くしかなさそうか。", "face": "u306"}, {"name": "メフィスト", "text": "な、離せ！　離さぬか！\n正しく深い知識から導き出された美しい理論に、\n武力で解決を図るなどと……！！！！", "face": "u526"}, {"name": "ラクシャーサ", "text": "オークの英雄アナトリア。その剣が仕上がった暁には、\n是非とも貴君と全力での戦いを所望したい。\n……それでは、また会おう。", "face": "u306"}, {"name": "アンナ", "text": "――……行ってしまわれました。\n……あの、大丈夫ですか？", "face": "l831eb29f1552"}, {"name": "ティニー", "text": "……そ、そざいが……。", "face": "u523"}, {"name": "アンナ", "text": "……素材がどうかされたのですか？", "face": "l831eb29f1552"}, {"name": "ティニー", "text": "素材が！　魔界の希少鉱石がこんなに！\n戦いの影響で凄く露出してきてるのよ！\nこれだけあれば……よぉっし、まずは試し打ちよ！", "face": "u523"}, {"name": "ティニー", "text": "――カン！　カン！　カン！！", "face": "u523"}, {"name": "ティニー", "text": "トホホ……失敗しちゃった。意外に難しい素材ね……。\n……でも、まだまだこれから！　素材は大量！\n最っっ高の武器に仕上げてみせるんだから！！", "face": "u523"}, {"name": "アンナ", "text": "……ここにいてはお邪魔になりそうですね。\n王子、我々は退散致しましょうか。"}, {"name": "アナトリア", "text": "迷惑かけちまってすまないね。\n助かった、礼を言っておくよ。", "face": "u522"}, {"name": "ケイティ", "text": "……アナトリアさんなら、我々の協力がなくとも\nあの方々を止められたのでは？", "face": "u114"}, {"name": "アナトリア", "text": "さて、なんのことだろうね……まぁ、なんにせよ\nこれで貸し借りはなしだ。戦う時は、\n何に気兼ねするでもない、全力でやれるだろ。", "face": "u522"}, {"name": "アナトリア", "text": "くだらない遠慮なんて一切なしだ。\n全力でかかってこい。\n当然あたしも、そうさせてもらうよ。", "face": "u522"}, {"name": "アンナ", "text": "……はい！　全力でぶつからせて頂きます！\n王子、必ずやアナトリアさんに勝利し、\n優勝を目指しましょう！！", "face": "l831eb29f1552"}]}], "story_talk": true, "active": true}