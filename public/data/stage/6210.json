{"quest_id": 6210, "name": "魔物の結集（記憶）", "description": "魔物を集結させ、人間を滅ぼさんとする\n神ケラウノスとの決戦。その最中、\n神と戦うべく王子と共闘する者とは……！\n神級（★１獲得の目安：平均Lv50）", "event": "戦場の記憶～追憶の章～", "event_category": "History", "mission_id": 920094, "map_no": 5245, "level": 100, "multiplier": 1.0, "charisma": 115, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108080, "master_id": 991, "global_id": 990, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 6}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "attack_range": 200, "attack_speed": 40, "attack_wait": 30, "attack_interval": 141, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108144, "race_id": 9, "missile_id": 173, "missile": {"speed": 3.0}, "master_id": 964, "global_id": 963, "ranged": true, "spawn_sec": 7}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 2, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 4