_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30436, "global_id": 4055, "from_condition": 2}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "tags": ["忍者"], "hp": 900, "attack": 190, "base_hp": 900, "base_attack": 190, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100032, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 212, "global_id": 211, "ranged": true, "spawn_sec": 14}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 52000, "attack": 6000, "base_hp": 52000, "base_attack": 6000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 40, "attack_speed": 50, "attack_wait": 50, "attack_interval": 245, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103440, "race_id": 3, "master_id": 446, "global_id": 445, "spawn_sec": 22}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 1000, "base_hp": 60000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 80, "attack_range": 220, "attack_speed": 20, "attack_wait": 110, "attack_interval": 281, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2108320, "race_id": 19, "special_effect_id": 138, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30198, "global_id": 3817, "ranged": true, "spawn_sec": 28}, {"enemy_id": 12, "source": "local", "count": 12, "form_count": 1, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 106}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 5800, "base_hp": 13000, "base_attack": 5800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 30, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108128, "race_id": 16, "special_effect_id": 54, "master_id": 994, "global_id": 993, "spawn_sec": 116}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 139}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――アイギス様のお告げによって\n常闇の聖霊を追ってきましたが……、\nデシウスも聖霊を追っているようですね。", "face": "lb17e96a90f21"}, {"name": "アンナ", "text": "デシウスはアイギス様の姉神様「ケラウノス」の名前を\n口にしていましたが、一体どんな関係が――。", "face": "lb17e96a90f21"}, {"name": "王子", "text": "――……。", "face": "u1"}, {"name": "アンナ", "text": "急に軍を止められて、どうされました、王子？\nあ、あれは……デシウス？\nそれに隣にいる女性は一体。", "face": "lb17e96a90f21"}, {"name": "デシウス", "text": "追い詰めたぞ、ケラウノス！\nなぜ、お前を信仰していた我輩の祖国を滅ぼした！？\nなぜ、魔物の大群を呼び寄せたのだ……！　答えろ……！", "face": "l5d57eaa443e7"}, {"name": "ケラウノス", "text": "神ならば人間の願いを聞き入れるはずなどと、\n思いあがった愚か者たちに天罰を下しただけです。", "face": "lfea95bdb9660"}, {"name": "ケラウノス", "text": "でも安心なさい。お前の国の人間だけではなく、\nいずれ全ての人間を滅ぼしてあげます。\nさあ、常闇の聖霊よ、人間を滅ぼす為に協力なさい。", "face": "lfea95bdb9660"}, {"name": "常闇の聖霊", "text": "うッ、ぁ……ぁぁ……。もう……いや、だ……。\nやめてくれ……。\nもう、われに力は……残って、いない……。", "face": "u397"}, {"name": "ケラウノス", "text": "常闇の聖霊、力を使い果たしましたか。\nでは代わりに、聖霊の力で強化しておいた\n魔物をこの地に召喚し、駒としましょう。", "face": "lfea95bdb9660"}, {"name": "デシウス", "text": "くそっ……。ケラウノスのやつめ、\n魔物を召喚し始めている……！　我輩の祖国にした事と\n同じことを……！　くそったれぇ……！", "face": "l5d57eaa443e7"}, {"name": "モーティマ", "text": "お、おいっ！　デシウスのヤツ、鎧を召喚して……！\n一人であの軍勢に挑むなんて無謀だぜ！\nって王子！？", "face": "u14"}, {"name": "王子", "text": "……！", "face": "u1"}, {"name": "ケラウノス", "text": "おや、愚昧とは言え、女神の加護を受けし男が\n暗黒騎士と肩を並べるとは、面白い取り合わせですね。\n一緒に滅ぼせば好都合と言うもの。では、死になさい。", "face": "lfea95bdb9660"}]}, {"trigger": "end", "lines": [{"name": "ケラウノス", "text": "現世代の英雄、これほどまでの力とは……。\nまあいいです。地上を滅ぼすには、まだいくらでも\nやりようはあります。ここは退くとしましょう。", "face": "lfea95bdb9660"}, {"name": "ケイティ", "text": "消えてしまいました……。\nそんな、せっかく出会えた女神が、\n私たちの敵となるなんて……。", "face": "u114"}, {"name": "デシウス", "text": "はぁ……はぁ……。\nお、おのれ……逃がしたか……。", "face": "l5d57eaa443e7"}, {"name": "デシウス", "text": "我輩は一足先に退かせてもらうとしよう。\nまだまだ我輩には、やらねばならぬことがあるからな。\nもっと力を、神をしのぐ力を手に入れなければならん。", "face": "l5d57eaa443e7"}, {"name": "デシウス", "text": "貴様らとの共闘など、次は無いと思うことだ。\n貴様らが窮地に陥っていても、協力などしてやらんぞ。\n絶対だからな！　では、さらばだ！！", "face": "l5d57eaa443e7"}, {"name": "サヨ", "text": "――デシウスの祖国はケラウノスを信仰していた。\nだけど、信じていた神に裏切られ、祖国を失って……。\n無力感に苛まれて、力を求めるようになったと思うの。", "face": "u510"}, {"name": "サヨ", "text": "この戦いの途中から、もしかして、と思ってたわ。\n天使兵団との戦いの時、天使の中に潜入してたでしょ？\nあの時、幾つか分かった事があったの。", "face": "u510"}, {"name": "サヨ", "text": "――アイギス様の姉神「ケラウノス」が、\n人間を不浄な存在として、天使に人間を滅ぼすよう命じ、\n幾つもの国を滅ぼしている事。", "face": "u510"}, {"name": "サヨ", "text": "滅ぼされた国の中には、ケラウノスの信仰国もあって、\nケラウノスを降臨させた結果、国を滅ぼされた事。\n天使兵団との戦いの頃は信じられなかったけど……。", "face": "u510"}, {"name": "サヨ", "text": "この戦いの道中で、ケラウノスと戦う前から、\nデシウスがケラウノスに対して仇のように言ってた事。\nデシウスの執念を見て、神は敵なんだって、感じたわ。", "face": "u510"}, {"name": "サヨ", "text": "デシウスは神に対抗できる力を求めている。\n信じていた神に裏切られ、大事なもの全てを失った\n彼の悲しみや無念さは計り知れないわ。", "face": "u510"}, {"name": "サヨ", "text": "デシウスも、そして王子も\nそれぞれが正しいと思った道を進んでる。", "face": "u510"}, {"name": "サヨ", "text": "そして、お互いの道を譲れないなら……、\n戦うことだってある。", "face": "u510"}, {"name": "サヨ", "text": "英雄の末裔である王子が選んできた道のり、\nその一つの答えともいえる区切りを\nわたしが見届けるのももうすぐの事だったわ。", "face": "u510"}]}], "active": true}