{"quest_id": 6279, "name": "妖魔女王の連携戦術", "description": "妖魔女王たちの連携攻撃を打ち崩せ！\n＜クイーン三姉妹がいる間敵の攻撃力\n上昇、徐々にＨＰ回復、味方魔耐減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["クイーン三姉妹がいる間敵の攻撃力\n上昇、徐々にＨＰ回復、味方魔耐減少"], "event": "大怪盗とピラミッドの秘宝", "event_category": "History", "mission_id": 920098, "map_no": 5254, "level": 100, "multiplier": 1.0, "charisma": 115, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 28000, "attack": 550, "base_hp": 28000, "base_attack": 550, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112080, "race_id": 9, "special_effect_id": 196, "missile_id": 6, "master_id": 30646, "global_id": 4265, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 28000, "attack": 550, "base_hp": 28000, "base_attack": 550, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112096, "race_id": 9, "special_effect_id": 197, "missile_id": 6, "master_id": 30647, "global_id": 4266, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 28000, "attack": 550, "base_hp": 28000, "base_attack": 550, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112112, "race_id": 9, "special_effect_id": 198, "missile_id": 6, "master_id": 30648, "global_id": 4267, "ranged": true