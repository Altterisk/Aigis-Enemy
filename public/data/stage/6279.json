8, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 129}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 131}, {"enemy_id": 10, "source": "local", "count": 8, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 132}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 158}, {"enemy_id": 12, "source": "local", "count": 4, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 167}], "popups": ["ゴブリンクイーン長女がいる間は\n敵の攻撃力がアップします。\n\nゴブリンクイーン次女がいる間は\n味方の魔法耐性が低下します。\n\nゴブリンクイーン三女がいる間は\n敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "こ、こちらガご所望であっタ、\n例のアレでございまス。\nプリンセ……クイーン長女サマ。", "face": "lf3747a5faa16"}, {"name": "ゴブリンクイーン長女", "text": "へぇ……これが呪われた宝石の欠片ねぇ。\nふふ、中々綺麗じゃない。私に似合いそうねぇ。", "face": "l4941d791b38f"}, {"name": "ゴブリンクイーン次女", "text": "お姉さまでしたら、そのような物だけでなく\nきっとどのような宝石でもお似合いですわ。\n貴方もそう思うでしょう、三女！", "face": "l66369a298a92"}, {"name": "ゴブリンクイーン三女", "text": "はい、間違いありません！\nお姉さま達でしたら、きっとどのような\n宝石でもお似合いに決まっています！", "face": "l5f1c14f02f5d"}, {"name": "ゴブリンクイーン長女", "text": "ふふ、二人とも正直者ねぇ。ゴブリン博士、\n貴方もよく手に入れてくれたわね。\n何か欲しいものがあれば言いなさい？", "face": "l4941d791b38f"}, {"name": "ゴブリン博士", "text": "ほ、本当ですカ！？　そ、それでしたらワタクシ、\n是非とモ作りたい兵器ガございましテ、\nそのための予算ヲ――", "face": "lf3747a5faa16"}, {"name": "ゴブリンクイーン長女", "text": "――と思ったけど、貴方さっき、\n私をプリンセスって呼ぼうとしたわね。", "face": "l4941d791b38f"}, {"name": "ゴブリンクイーン長女", "text": "何度も言ってるでしょ。お母様亡き今、私達がクイーン。\nいつまでもプリンセスと思われてるだなんてしゃくだわ。\nやっぱりさっきのは、なーし……うふふ。", "face": "l4941d791b38f"}, {"name": "ゴブリン博士", "text": "そ、ソンナァ……。", "face": "lf3747a5faa16"}, {"name": "ゴブリンクイーン次女", "text": "流石お姉さまですわ。ゴブリン博士の\n情けなく落ち込んだ顔、たまりませんわ。", "face": "l66369a298a92"}, {"name": "ゴブリンクイーン三女", "text": "成程、あれが飴と鞭と言うものなのですね。\n……私も、頑張って見習わせて頂きます！", "face": "l5f1c14f02f5d"}, {"name": "アンナ", "text": "――王子、呪われた宝石の欠片を持ちだした\nゴブリンが向かったのは\nこちらのようです……あれは！？", "face": "l43ffb21ff54d"}, {"name": "ゴブリンクイーン長女", "text": "あらあらぁ。王子達じゃない。ちょうどいいわ、\nこの呪われた宝石の欠片に加え、私達\n姉妹の絆の力を見せる良い機会よぉ……まずは三女！", "face": "l4941d791b38f"}, {"name": "ゴブリンクイーン三女", "text": "はい、お姉さま！　まずは私が皆さんに\n回復魔法を……！　これで呪われた宝石の呪いも\n怖くありませんわ！　……次女姉さま！", "face": "l5f1c14f02f5d"}, {"name": "ゴブリンクイーン次女", "text": "三女の癖にやるじゃない。そして\n次は私が王子達の魔法への抵抗を奪って……と。\n……お姉さま！", "face": "l66369a298a92"}, {"name": "ゴブリンクイーン長女", "text": "よくやったわ二人とも。あとは私がゴブリン軍団\n全員の力を引き上げれば……うふふ。\n完璧なフォーメーションね。名付けて――", "face": "l4941d791b38f"}, {"name": "ゴブリンクイーン長女", "text": "『トライアングル・フォーメーション』\n……さぁ覚悟なさい。地獄を見せてあげるわよ。", "face": "l4941d791b38f"}, {"name": "アンナ", "text": "ゴブリン軍団、どうやら連携を強化してきたようですね。\n……まずはあの連携を打ち崩すのが上策かと。\n王子、冷静な指示をお願いします。", "face": "l43ffb21ff54d"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンクイーン三女", "text": "きゃあ！", "face": "l5f1c14f02f5d"}, {"name": "ゴブリンクイーン次女", "text": "何やってるのよ三女！", "face": "l66369a298a92"}, {"name": "ケイティ", "text": "陣形が崩れました……今が好機！", "face": "u114"}, {"name": "ゴブリンクイーン長女", "text": "ちょーっと分が悪いかしらぁ。\n……しょうがないわね、ゴブリン兵たち！", "face": "l4941d791b38f"}, {"name": "ゴブリン", "text": "ギャギャ！", "face": "l0bb0dbc4c0ed"}, {"name": "ゴブリンクイーン長女", "text": "私達が逃げるまで、奴らの足止めをするのよ。\n……もちろん命懸けでね。\n手を抜こうものなら、後で殺すわよ。", "face": "l4941d791b38f"}, {"name": "ゴブリン", "text": "ギャギャー！　\nシニタクナイ！　シニタクナイ！\nイノチガケ！　イノチガケ！", "face": "l0bb0dbc4c0ed"}, {"name": "ケイティ", "text": "ぐっ……仲間達を足止めに使うとは。\nなんという卑劣な……！　", "face": "u114"}, {"name": "ゴブリンクイーン長女", "text": "うふふ、なんとでも言いなさい。\n……さぁ妹達、帰るわよ。", "face": "l4941d791b38f"}, {"name": "ゴブリンクイーン次女", "text": "人間の分際で……覚えてなさい！", "face": "l66369a298a92"}, {"name": "ゴブリンクイーン三女", "text": "私の失敗がなければ……次までには、\nフォーメーションをもっと完璧なものに……。", "face": "l5f1c14f02f5d"}, {"name": "ゴブリンクイーン長女", "text": "えぇ、次こそは私達が絶対に勝つわよ。\n覚悟しておきなさい、人間達。", "face": "l4941d791b38f"}, {"name": "ケイティ", "text": "――……逃げられてしまいましたか。\n『トライアングル・フォーメーション』\n恐ろしい連携攻撃です。", "face": "u114"}, {"name": "アンナ", "text": "はい……ゴブリン達も、新たな力を\n身に着けていっているようでしたね。", "face": "l43ffb21ff54d"}, {"name": "ケイティ", "text": "我々も負けてはいられませんね。国に戻り次第、\n更なる鍛錬、仲間との連携強化を図るべく、\n新たな特訓メニューを考案致しましょう。", "face": "u114"}, {"name": "アンナ", "text": "はい、ケイティさん。よろしくお願いします！\n……それでは王子、帰還致しましょうか。\nお疲れ様でした。"}]}], "active": true}