_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131104, "race_id": 3, "special_effect_id": 868, "change_to": 34, "missile_id": 616, "missile": {"speed": 12.0}, "master_id": 34123, "global_id": 7740, "ranged": true, "from_condition": 0}, {"enemy_id": 14, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 172}, {"enemy_id": 28, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 172}], "popups": ["　　 【レラジェの呪毒II】\n・攻撃を受けると徐々にHPが減少\n　一撃につき合計で、攻撃対象\n　ユニットの最大HP50％のダメージ\n\n・レラジェを撃破すると、\n　ダメージが停止"], "dialogue": [{"trigger": "end", "lines": [{"name": "フローガ", "text": "――魔神レラジェ、沈黙を確認しました！\nすごい……めちゃくちゃな魔力が放出されています！", "face": "u878"}, {"name": "レライエ", "text": "はぁ……はぁ……や、やりました……！\nレラジェさまの魔力が大きな流れになって……。\nわわ……魔界との通路が復活していきます……！", "face": "u1355a1"}, {"name": "フライデーモン", "text": "おぉ……これで魔界の門を再び開くことができる。\n王子……いや、王子殿下、\n敵であった我らのために、ここまでしてくれるとは……。", "face": "l3145ec5d3be3"}, {"name": "デーモン剣士", "text": "この恩、決して忘れはしまい。\n王子殿下、魔界へ戻った後も、\n汝を救世主として崇めるとしよう。", "face": "l1ed3b1f08fad"}, {"name": "王子", "text": "…………！？", "face": "u1"}, {"name": "レライエ", "text": "レラジェさまも、\n良い戦いだったと言い残していきました。\nそれから、ま、また戦いたいとも……。", "face": "u1355a1"}, {"name": "アンナ", "text": "再戦の際には、事前に\n教えてくれるように伝えておいてくださいね……？"}, {"name": "アンナ", "text": "それでは王子、我々は王国へ帰還しましょうか。\n魔神レラジェ討伐、お疲れさまでした！"}]}], "map": {"image": "Map5041", "w": 960, "h": 640, "spots": [{"k": "b", "x": 177, "y": 180}, {"k": "b", "x": 156, "y": 470}, {"k": "m", "x": 470, "y": 415, "id": 200}, {"k": "m", "x": 244, "y": 220, "id": 201}, {"k": "m", "x": 350, "y": 180, "id": 202}, {"k": "m", "x": 434, "y": 131, "id": 203}, {"k": "m", "x": 520, "y": 85, "id": 204}, {"k": "m", "x": 614, "y": 139, "id": 205}, {"k": "m", "x": 690, "y": 185, "id": 206}, {"k": "m", "x": 690, "y": 335, "id": 207}, {"k": "m", "x": 690, "y": 260, "id": 208}, {"k": "m", "x": 300, "y": 290, "id": 209}, {"k": "m", "x": 244, "y": 420, "id": 210}, {"k": "m", "x": 370, "y": 415, "id": 211}, {"k": "m", "x": 300, "y": 360, "id": 212}, {"k": "m", "x": 570, "y": 415, "id": 213}, {"k": "m", "x": 670, "y": 405, "id": 214}, {"k": "m", "x": 770, "y": 475, "id": 215}, {"k": "m", "x": 781, "y": 156, "id": 216}, {"k": "r", "x": 583, "y": 187, "id": 300}, {"k": "r", "x": 583, "y": 258, "id": 302}, {"k": "r", "x": 201, "y": 303, "id": 303}, {"k": "r", "x": 195, "y": 367, "id": 304}, {"k": "r", "x": 413, "y": 481, "id": 305}, {"k": "r", "x": 530, "y": 482, "id": 306}, {"k": "r", "x": 409, "y": 223, "id": 307}, {"k": "r", "x": 74, "y": 136, "id": 308}, {"k": "r", "x": 480, "y": 349, "id": 309}, {"k": "r", "x": 582, "y": 349, "id": 310}, {"k": "r", "x": 671, "y": 98, "id": 311}, {"k": "r", "x": 126, "y": 408, "id": 312}, {"k": "r", "x": 895, "y": 183, "id": 315}, {"k": "r", "x": 301, "y": 472, "id": 316}, {"k": "r", "x": 634, "y": 470, "id": 317}], "events": [{"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "StageWideAreaRangeUp2", "x": 74, "y": 137}]}, {"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_01", "fx": "StageWideAreaRangeUp2", "x": 410, "y": 226}]}, {"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_02"