pawn_sec": 8}, {"enemy_id": 8, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "special_effect_id": 603, "master_id": 32848, "global_id": 6466, "spawn_sec": 8}, {"enemy_id": 9, "source": "local", "count": 19, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 43}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108096, "master_id": 992, "global_id": 991, "spawn_sec": 108}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108112, "master_id": 993, "global_id": 992, "spawn_sec": 114}], "popups": ["オーラをまとった魔物がいる間は、\n全てのアンデッドの攻撃と防御が\nアップします。\n\n攻撃と防御アップの効果は、\nオーラをまとった魔物の数に\n応じて重複します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "報告！\n領内にアンデッドが進攻してきています！", "face": "l8c4c9afdcef3"}, {"name": "アンナ", "text": "そんな……。\nこんなところにまでアンデッドが攻めてくるなんて……！", "face": "ld091604bc104"}, {"name": "ユリアン", "text": "ビフロンスの精神体が地上界に現れた影響だろうな。", "face": "u7"}, {"name": "フーリ", "text": "かなりの数ですね。\n……ですが、これ以上は進ませる訳にはいきません！", "face": "u174"}]}, {"trigger": "end", "lines": [{"name": "エーテル", "text": "アンデッドを全て倒すことができたようですね！\n王子、お疲れ様でした。", "face": "u215"}, {"name": "フーリ", "text": "よ、よかった……。\n……何とか、皆さんのお邪魔にならずに、\n戦いきることができました……。", "face": "u174"}, {"name": "ニコラウス", "text": "何を仰る、フーリ殿！\nなかなかの戦いぶりでしたぞ？", "face": "u345"}, {"name": "フーリ", "text": "そ、そんな、私なんて……まだまだ未熟で……。\nもっと、強くなりたいです……。", "face": "u174"}, {"name": "ニコラウス", "text": "だっはっはっは！\nその謙虚さは強さを求めるものにとっては美徳ですな！", "face": "u345"}, {"name": "フーリ", "text": "そんな、大げさですよ……。\nですが、王子様の為にもっともっと頑張りたいです！", "face": "u174"}, {"name": "アンナ", "text": "何はともあれ、皆さんが無事で本当に良かったです。\n王子、お疲れ様でした。"}]}], "map": {"image": "Map920078_3875", "w": 960, "h": 640, "spots": [{"k": "b", "x": 931, "y": 232}, {"k": "b", "x": 938, "y": 482}, {"k": "m", "x": 251, "y": 177, "id": 200}, {"k": "m", "x": 403, "y": 118, "id": 201}, {"k": "m", "x": 349, "y": 190, "id": 202}, {"k": "m", "x": 336, "y": 279, "id": 203}, {"k": "m", "x": 313, "y": 349, "id": 204}, {"k": "m", "x": 248, "y": 408, "id": 205}, {"k": "m", "x": 353, "y": 417, "id": 206}, {"k": "m", "x": 448, "y": 417, "id": 207}, {"k": "m", "x": 527, "y": 434, "id": 208}, {"k": "m", "x": 617, "y": 463, "id": 209}, {"k": "m", "x": 670, "y": 388, "id": 210}, {"k": "m", "x": 791, "y": 395, "id": 211}, {"k": "m", "x": 652, "y": 322, "id": 212}, {"k": "m", "x": 648, "y": 242, "id": 213}, {"k": "m", "x": 759, "y": 217, "id": 214}, {"k": "m", "x": 654, "y": 167, "id": 215}, {"k": "m", "x": 555, "y": 176, "id": 216}, {"k": "m", "x": 459, "y": 182, "id": 217}, {"k": "r", "x": 181, "y": 234, "id": 300}, {"k": "r", "x": 265, "y": 245, "id": 301}, {"k": "r", "x": 264, "y": 304, "id": 302}