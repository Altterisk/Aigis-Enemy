iour": {"transforms": [{"wait": 450}]}, "spawn_sec": 57}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 331, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109088, "race_id": 16, "special_effect_id": 61, "change_to": 5, "missile_id": 26, "master_id": 30128, "global_id": 3747, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 15, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 70}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103536, "race_id": 16, "special_effect_id": 61, "change_to": 9, "master_id": 454, "global_id": 453, "to_global_id": 454, "route_behaviour": {"transforms": [{"wait": 840}]}, "spawn_sec": 84}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103552, "race_id": 16, "special_effect_id": 61, "change_to": 8, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 455, "global_id": 454, "ranged": true}], "popups": ["フォーから受けたダメージは\n２倍になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "雪の国の衛兵", "text": "――くっ、西門が突破されたぞ！\nこいつら本当に盗賊なのか！？", "face": "u64"}, {"name": "雪の国の重装兵", "text": "この連中が噂に聞く闇の組織なのか……？\n街を包囲されていちゃ救援要請もできないぞ。\nせめて王国に伝令を出せたら……！", "face": "u69"}, {"name": "雪の国の衛兵", "text": "次代の英雄王殿の国か……。\nだが王国は天界との戦いに忙殺されているはず。\n俺たちの街にまで救援にきてくれるとは――", "face": "u64"}, {"name": "雪の国の重装兵", "text": "――い、いや、あれを見ろ！\nあの軍旗、王国の主力部隊のものだぞ！！", "face": "u69"}, {"name": "サンタヘイオス", "text": "雪の国の皆さん、ご無事ですか！？\nこれより王国軍が援護に加わります！", "face": "u1116a1"}, {"name": "雪の国の衛兵", "text": "おぉ……あの白と黒の髪色は、\nまさか王国軍のヘイオス殿では！", "face": "u64"}, {"name": "サンタヘイオス", "text": "――いいえ、今の私はサンタヘイオス！\n子どもたちの夢を守るために戦う騎士ですとも！", "face": "u1116a1"}, {"name": "サンタコーネリア", "text": "ああ。サンタクロースの一族より、\n今年のクリスマスへの助力を請われし\n光と闇の騎士、それが私たちだ。", "face": "u725"}, {"name": "雪の国の重装兵", "text": "おお、サンタクロースの一族の協力者か！\nサンタの騎士たちよ、敵はすでに\nおもちゃ工場へ向かっている。注意してくれ！", "face": "u69"}, {"name": "カミラ", "text": "情報どおり、闇の組織は雪の国の\nおもちゃ工場を狙っているようですね。", "face": "u724"}, {"name": "サンタヘイオス", "text": "王子殿下、すでに街には闇の組織が侵入しています。\n見張りも配置されていると考えるべきでしょう。", "face": "u1116a1"}, {"name": "サンタヘイオス", "text": "見張りに見つかれば敵の抵抗はより激しくなります。\n可能な限り、敵の警戒網を避けつつ、\n迅速に戦闘を進めていきましょう！", "face": "u1116a1"}]}, {"trigger": "battle", "at_sec": 26, "lines": [{"name": "？？？", "text": "おやおやぁ？　何を手こずっているんだい？\n君たちには侵入者の\n抹殺を命じたはずなんだけどねェ。", "face": "lb0c511288c26"}, {"name": "闇組織構成員", "text": "フォーさま……！　いえ、これは……！", "face": "l0856284cfbe7"}, {"name": "フォー", "text": "ハハハ！　まぁいいさ！\n最後にはどっちかが死ぬんだ。\n俺も手伝ってやるから、あいつらを殺してこいよ。", "face": "lb0c511288c26"}, {"name": "カノン", "text": "何、この匂い……火薬……？\n王子、あいつからすごい火薬の匂いがするわ。\n尋常じゃない量の爆発物を仕込んでるみたい！", "face": "u726"}, {"name": "デューオ", "text": "あのプレゼントボックスが爆弾だとすると……。\nこれはまずいね、被害は倍じゃ済まないかもよ！", "face": "u937"}, {"name": "フォー", "text": "さァ！　遊んでやろうじゃないか！！\nハーッハァ！！", "face": "lb0c511288c26"}]}, {"trigger": "end", "lines": [{"name": "フォー", "text": "ハーッハッハッハッハァ！！\n俺を倒した！　俺の人形を殺したぞこいつらァ！！", "face": "lb0c511288c26"}, {"name": "フォー", "text": "久々に愉快な連中が現れたもんだァ……。\n愉快に派手に殺してやるよ！\n――そら、ドッカァァァァァァンッ！！", "face": "lb0c511288c26"}, {"name": "サンタヘイオス", "text": "――ッ！　殿下、離れてください！！", "face": "u1116a1"}, {"name": "アリサ", "text": "なっ……じ、自爆した……？\n王子、フォーが自爆しました！", "face": "u432"}, {"name": "リュリュ", "text": "……うぅん、これは違います。\n自爆したのは人形で、細い魔力の糸が繋がっています。", "face": "u203"}, {"name": "シャルロット", "text": "魔力の糸……？　――本当ですわ！\nおもちゃ工場の方へ続いてますわよ！", "face": "u556"}, {"name": "シプリア", "text": "遠隔操作してたってことか。\nどうりで誰もフォーの姿を見たことがないわけだ。\n人形を使って部下に指示を出してたんだな。", "face": "u565"}, {"name": "カノン", "text": "それよりこの爆薬の量よ。\nこれだけ詰め込んでいるんだから、\nおもちゃ工場なんて大変なことになってそう……。", "face": "u726"}, {"name": "サンタヘイオス", "text": "そうですね……。\n王子殿下、おもちゃ工場へ急ぎましょう！", "face": "u1116a1"}]}], "story_talk": true, "active": true}