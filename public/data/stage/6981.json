{"quest_id": 6981, "name": "男湯に迫る魔の手", "description": "温泉を楽しむ王国の男たちだったが、\n気がつけば殺気に取り囲まれていた！\n四方八方から迫るドッペルゲンガーを討て！\n極級（★１獲得の目安：平均Lv25）", "event": "王国軍の慰安旅行ー温泉編ー", "event_category": "History", "mission_id": 920139, "map_no": 3468, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "form_count": 2, "hp": 700, "attack": 120, "base_hp": 700, "base_attack": 120, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 126, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121600, "race_id": 16, "change_to": 1, "change_condition": 2, "master_id": 32320, "global_id": 5939, "to_condition": 2, "to_global_id": 403}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1500, "attack": 100, "base_hp": 1500, "base_attack": 100, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2102912, "master_id": 404, "global_id": 403, "from_condition": 2, "spawned_on_death_by": [1, 3, 4, 5, 6, 7, 8]}, {"enemy_id": 3, "source": "local", "count": 12, "form_count": 2, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "change_to": 1, "change_condition": 2, "master_id": 32322, "global_id": 5941, "to_condition": 2, "to_global_id": 403, "spawn_sec": 6}, {"enemy_id": 4, "source": "local", "count": 8, "form_count": 2, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "change_to": 1, "change_condition": 2, "master_id": 32324, "global_id": 5943, "to_condition": 2, "to_global_id": 403, "spawn_sec": 8}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 2, "tags": ["アンデッド"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 161, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112288, "race_id": 4, "change_to": 1, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 32327, "global_id": 5946, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 63}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 2, "hp": 500, "attack": 300, "base_hp": 500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121616, "race_id": 16, "change_to": 1, "change_condition": 2, "master_id": 32321, "global_id": 5940, "to_condition": 2, "to_global_id": 403, "spawn_sec": 74}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 2, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "change_to": 1, "change_condition": 2, "master_id": 32326, "global_id": 5945, "to_condition": 2, "to_global_id": 403, "spawn_sec": 95}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 2, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "change_to": 1, "change_condition": 2, "master_id": 32325, "global_id": 5944, "to_condition": 2, "to_global_id": 403, "spawn_sec": 101}], "dialogue": [{"trigger": "start", "lines": [{"name": "モーティマ", "text": "――うっひょぉ！　こいつぁ広いぜ！\nもしかして泳げちまうんじゃねぇか！？", "face": "u14"}, {"name": "ニコラウス", "text": "モーティマ殿、温泉にはマナーがあるのですぞ？\nまずは体を洗い、\nそれから静かに景色を味わいつつですなぁ。", "face": "u345"}]}, {"trigger": "start", "lines": [{"name": "村人", "text": "――おぉ、皆様お揃いで。\nお湯加減はいかがですかな？", "face": "ld66c75772212"}, {"name": "オスカー", "text": "えぇ、少し熱いくらいですが、\nそれがむしろ心地よい、最高の湯加減ですね……。", "face": "u366"}, {"name": "村人", "text": "ふふふ、それは良かったです。\nくっくっく……実に良かった……。", "face": "ld66c75772212"}, {"name": "ジェイク", "text": "……何かおかしくないか？\n急に温泉の外が静かになりやがった。", "face": "u367"}, {"name": "ダン", "text": "くっ、こいつは殺気だ……！\n温泉が魔物に囲まれてるぜ！？", "face": "u204"}, {"name": "村人", "text": "（な、なに？　こいつらどうして\n殺気だけで気配に気付くんだ！？）", "face": "ld66c75772212"}, {"name": "村人", "text": "（えぇい、仕方ない！\nお前達、ここで王子を抹殺するぞ！！）", "face": "ld66c75772212"}, {"name": "ジョヴァンニ", "text": "魔物はまだこの村を諦めてねぇってことか。\n仕方ねぇ。王子、返り討ちにしてやろうぜ！", "face": "u123"}]}, {"trigger": "end", "lines": [{"name": "ドッペルゲンガー", "text": "くっ……撤退だ！　撤退しろ！！\nどうしてこいつら、風呂場に武器を持ってきてるんだ！", "face": "lf386e3aa1a78"}, {"name": "ヴァレリー", "text": "魔物が村人に化けていたようだね。\n村のためにも、他にドッペルゲンガーが\n潜んでいないか、調査した方が良さそうだ。", "face": "u12"}, {"name": "ロベルト", "text": "まったく、とんだ温泉旅行になっちまったな。\n温泉宿で魔物退治とは。", "face": "u109"}, {"name": "ストレイ", "text": "でも、おかげで村に潜む魔物があぶり出せた。\nさぁ王子、魔物退治に出かけようか。", "face": "u82"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "マリウス", "text": "……むっ？\nところでドッペルゲンガー達が\n逃げていった方向は、確か女湯の方ではなかったかな？", "face": "u116"}, {"name": "ユリアン", "text": "なんだって！？\n急いで知らせてやらねぇと……！", "face": "u7"}, {"name": "ヴィンセント", "text": "女傑揃いの彼女達ならば大事には至らないと思うが、\n急いで駆けつけた方が良さそうだな。", "face": "u103"}, {"name": "グレーターデーモン", "text": "（やれやれ、先走って襲撃をするとは、\n連中は後で叱っておかないといけないねぇ）", "face": "l940fd0fc7c8f"}, {"name": "グレーターデーモン", "text": "（だがこれも想定の範囲内だよ。\n何事もある程度の冗長性を持たせなければね）", "face": "l940fd0fc7c8f"}, {"name": "グレーターデーモン", "text": "（事業とはあくせく働くものではない。\n既に動いている事業を乗っ取ることこそ、\n成功への近道なのだよ……ふっふっふ……）", "face": "l940fd0fc7c8f"}]}], "active": true}