123}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_speed": 60, "attack_wait": 60, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "change_to": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31276, "global_id": 4895, "to_global_id": 292, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 165}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 293, "global_id": 292, "ranged": true}], "popups": ["\n\n\n ～ドワーフの王国へ向かう道中～"], "dialogue": [{"trigger": "start", "lines": [{"name": "カゲロウ", "text": "くっ、まさかこんなところで……。\n王子、急ぎ戦闘の準備をッ！！", "face": "u139"}, {"name": "アンナ", "text": "カゲロウさん！\nいったい何が起きたのですか？", "face": "l031151a3e8d0"}, {"name": "サイゾウ", "text": "はっ、我ら先行していた部隊が魔物と遭遇し――", "face": "u237"}, {"name": "ケイティ", "text": "なるほど、その魔物の掃討の為に、\n追加の戦力が必要ということですね？", "face": "u114"}, {"name": "サイゾウ", "text": "――否、魔物の討伐は順調に進み、\n主君らの手を煩わせる程ではありませぬ。", "face": "u237"}, {"name": "ソーマ", "text": "えっ？　それじゃあどうして、\nそんなに慌てているんでしょうか……？", "face": "u23"}, {"name": "カゲロウ", "text": "マイン殿の地雷と我らの攻撃で、\n魔物は大部分を討伐することが出来たのだ。\nだが、その後が問題だった……。", "face": "u139"}, {"name": "マイン", "text": "ごめん、アタシのせいだ！\n地雷でふっ飛ばしたトコまでは\nトントン拍子でいい感じだったんだけど……。", "face": "u672"}, {"name": "マイン", "text": "そしたら、地下の竜人族の住処を\n掘り当てちまったんだ……！！", "face": "u672"}, {"name": "竜人戦士", "text": "まさかニンゲンの方から\n殺されに来てクレルとはナァ！！", "face": "u95"}, {"name": "アンナ", "text": "……どうやら人間に敵意を持つ\n竜人たちの住処だったようですね。", "face": "l031151a3e8d0"}, {"name": "サイゾウ", "text": "魔物の残党にも気をつけられよ。\n竜人族と戦うとなれば、\n新手の敵が現れるかもしれませぬ。", "face": "u237"}, {"name": "アンナ", "text": "そうですね。\n王子、急いで竜人族を迎え撃ちましょう！", "face": "l031151a3e8d0"}]}, {"trigger": "end", "lines": [{"name": "ソーマ", "text": "まさか街道の地下に\n竜人さんの住処があったなんて……。", "face": "u23"}, {"name": "マイン", "text": "ちゃんと地雷の設置場所を調査しなかった、\nアタシの責任だ……ごめん、悪かったよ……。", "face": "u672"}, {"name": "マイン", "text": "グスタフのジジィにも、\n発破の時は良く周りを見ろって言われてんのに。", "face": "u672"}, {"name": "アリサ", "text": "でも、マインさんがいなかったら、\nもっとたくさんの魔物に\n襲われていたはずですよ！", "face": "u24"}, {"name": "マイン", "text": "うぅ……そう、かな……？\nちったぁ役に立てたかな……？", "face": "u672"}, {"name": "アンナ", "text": "えぇ、目的地までまだ距離がありますし、\nここからの旅路も頼りにさせていただきますね。"}, {"name": "アンナ", "text": "それでは王子、ここからも警戒しつつ、\nドワーフの王国を目指しましょう！", "face": "l031151a3e8d0"}]}], "active": true}