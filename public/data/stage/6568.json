{"quest_id": 6568, "name": "竜人たちの穴ぐら", "description": "マインを伴いドワーフの王国へ向かう\n王子一行に地底の竜人たちが襲いかかる。\n地下から現れる竜人を撃退せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "浮遊石とドワーフの養娘", "event_category": "History", "mission_id": 920114, "map_no": 3306, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 15, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098576, "race_id": 2, "master_id": 147, "global_id": 146, "spawn_sec": 23}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 31}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 52}, {"enemy_id": 4, "source": "local", "count": 15, "form_count": 2, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_speed": 90, "attack_wait": 25, "attack_interval": 221, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098640, "race_id": 2, "change_to": 4, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 31275, "gl