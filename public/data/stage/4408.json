{"quest_id": 4408, "name": "魂を狩る魔物", "description": "死竜の手下である\nカボチャの魔物と\nスケルトンたちから集落を守れ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "死竜と復讐の魔導司祭", "event_category": "History", "mission_id": 920053, "map_no": 3626, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 41, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 20}, {"enemy_id": 3, "source": "local", "count": 3, "level": 80, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 400, "global_id": 399, "ranged": true, "spawn_sec": 40}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 58}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 123}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "エターナーさん、先ほどお話していたドラコリッチに\nついてなんですが……。同じくアンデッドと化した\nドラゴンゾンビとはなにか違いはあるのでしょうか。", "face": "l6fc715adedb1"}, {"name": "エターナー", "text": "ドラゴンゾンビは、生前の肉体的な強さを\n引き継いではいるけれど知性はないし、\n動きも鈍いという弱点があるんだ。", "face": "u298"}, {"name": "エターナー", "text": "それに比べてドラコリッチは、\n生前の知識を受け継いでいて\n自ら考えて行動することができる。", "face": "u298"}, {"name": "エターナー", "text": "そして、物理的にも魔力的にも\n生前の能力をはるかに上回るんだ。", "face": "u298"}, {"name": "アンナ", "text": "なるほど……。つまり、\nドラゴンゾンビよりも厄介な相手というわけですね。\nそんな魔物がさらに力をつけたら……。", "face": "l6fc715adedb1"}, {"name": "エターナー", "text": "そういう事だ。\n私は急ぎドラコリッチの居場所を探る。\n何かあったら報告しよう。", "face": "u298"}, {"name": "エターナー", "text": "あと、カボチャの魔物は魂を奪う為に、\n人の住む場所に現れる。この近辺の集落には\n目を配っておいた方がいいだろう。", "face": "u298"}, {"name": "アンナ", "text": "わかりました。\nどうかお気をつけて。", "face": "l6fc715adedb1"}, {"name": "兵士", "text": "報告！　領内に魔物の侵入を確認！\nこちらに迫ってきています！", "face": "l418aa5a6436b"}, {"name": "アンナ", "text": "またあのカボチャの魔物でしょうか……！？\n王子、戦闘の準備を！", "face": "l6fc715adedb1"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "なんとか倒すことができましたが……、\n他の集落も襲われている可能性があります。", "face": "l6fc715adedb1"}, {"name": "アンナ", "text": "急ぎ確認しに参りましょう、王子。", "face": "l6fc715adedb1"}]}], "active": true}