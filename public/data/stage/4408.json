{"quest_id": 4408, "name": "魂を狩る魔物", "description": "死竜の手下である\nカボチャの魔物と\nスケルトンたちから集落を守れ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "死竜と復讐の魔導司祭", "event_category": "History", "mission_id": 920053, "map_no": 3626, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 180, "gold": 800, "drops": [{"item": 5002, "c": 1}, {"card": 50, "c": 1}, {"item": 2001, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 41, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 20}, {"enemy_id": 3, "source": "local", "count": 3, "level": 80, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 400, "global_id": 399, "ranged": true, "spawn_sec": 40}, {"enemy_id": 4, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 58}, {"enemy_id": 5, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 123}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "エターナーさん、先ほどお話していたドラコリッチに\nついてなんですが……。同じくアンデッドと化した\nドラゴンゾンビとはなにか違いはあるのでしょうか。", "face": "l6fc715adedb1"}, {"name": "エターナー", "text": "ドラゴンゾンビは、生前の肉体的な強さを\n引き継いではいるけれど知性はないし、\n動きも鈍いという弱点があるんだ。", "face": "u298"}, {"name": "エターナー", "text": "それに比べてドラコリッチは、\n生前の知識を受け継いでいて\n自ら考えて行動することができる。", "face": "u298"}, {"name": "エターナー", "text": "そして、物理的にも魔力的にも\n生前の能力をはるかに上回るんだ。", "face": "u298"}, {"name": "アンナ", "text": "なるほど……。つまり、\nドラゴンゾンビよりも厄介な相手というわけですね。\nそんな魔物がさらに力をつけたら……。", "face": "l6fc715adedb1"}, {"name": "エターナー", "text": "そういう事だ。\n私は急ぎドラコリッチの居場所を探る。\n何かあったら報告しよう。", "face": "u298"}, {"name": "エターナー", "text": "あと、カボチャの魔物は魂を奪う為に、\n人の住む場所に現れる。この近辺の集落には\n目を配っておいた方がいいだろう。", "face": "u298"}, {"name": "アンナ", "text": "わかりました。\nどうかお気をつけて。", "face": "l6fc715adedb1"}, {"name": "兵士", "text": "報告！　領内に魔物の侵入を確認！\nこちらに迫ってきています！", "face": "l418aa5a6436b"}, {"name": "アンナ", "text": "またあのカボチャの魔物でしょうか……！？\n王子、戦闘の準備を！", "face": "l6fc715adedb1"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "なんとか倒すことができましたが……、\n他の集落も襲われている可能性があります。", "face": "l6fc715adedb1"}, {"name": "アンナ", "text": "急ぎ確認しに参りましょう、王子。", "face": "l6fc715adedb1"}]}], "map": {"image": "Map920053_3626", "w": 960, "h": 640, "spots": [{"k": "b", "x": 167, "y": 131}, {"k": "m", "x": 809, "y": 361, "id": 200}, {"k": "m", "x": 708, "y": 371, "id": 201}, {"k": "m", "x": 605, "y": 353, "id": 202}, {"k": "m", "x": 512, "y": 330, "id": 203}, {"k": "m", "x": 422, "y": 367, "id": 204}, {"k": "m", "x": 310, "y": 388, "id": 205}, {"k": "m", "x": 203, "y": 358, "id": 206}, {"k": "m", "x": 111, "y": 365, "id": 207}, {"k": "m", "x": 234, "y": 282, "id": 208}, {"k": "m", "x": 260, "y": 196, "id": 209}, {"k": "m", "x": 346, "y": 151, "id": 210}, {"k": "m", "x": 426, "y": 102, "id": 211}, {"k": "m", "x": 522, "y": 57, "id": 212}, {"k": "m", "x": 612, "y": 44, "id": 213}, {"k": "m", "x": 696, "y": 79, "id": 214}, {"k": "m", "x": 759, "y": 137, "id": 215}, {"k": "m", "x": 782, "y": 261, "id": 216}, {"k": "r", "x": 855, "y": 281, "id": 300}, {"k": "r", "x": 899, "y": 315, "id": 301}, {"k": "r", "x": 837, "y": 424, "id": 302}, {"k": "r", "x": 749, "y": 421, "id": 303}, {"k": "r", "x": 485, "y": 273, "id": 304}, {"k": "r", "x": 246, "y": 437, "id": 305}, {"k": "r", "x": 179, "y": 420, "id": 306}, {"k": "r", "x": 69, "y": 316, "id": 307}, {"k": "r", "x": 144, "y": 302, "id": 308}, {"k": "r", "x": 327, "y": 255, "id": 309}, {"k": "r", "x": 374, "y": 218, "id": 310}, {"k": "r", "x": 428, "y": 181, "id": 311}, {"k": "r", "x": 500, "y": 166, "id": 312}]}, "start_cost": 10, "active": true}