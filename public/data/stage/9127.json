 "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2161104, "race_id": 18, "special_effect_id": 2094, "master_id": 38838, "global_id": 12455, "from_condition": 5}, {"enemy_id": 18, "source": "local", "count": 31, "form_count": 1, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "physical", "armor_defense": 20, "attack_range": 120, "attack_speed": 50, "attack_wait": 10, "attack_interval": 51, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2161040, "race_id": 18, "special_effect_id": 229, "missile_id": 353, "missile": {"speed": 7.0}, "master_id": 38829, "global_id": 12446, "ranged": true, "spawn_sec": 108}, {"enemy_id": 19, "source": "local", "count": 14, "form_count": 1, "hp": 6000, "attack": 900, "base_hp": 6000, "base_attack": 900, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112544, "race_id": 18, "master_id": 30694, "global_id": 4313, "spawn_sec": 131}, {"enemy_id": 20, "source": "local", "count": 13, "form_count": 1, "hp": 4000, "attack": 700, "base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 15, "attack_interval": 79, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122272, "race_id": 18, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 32482, "global_id": 6101, "ranged": true, "spawn_sec": 156}, {"enemy_id": 21, "source": "local", "count": 20, "form_count": 1, "tags": ["アーマー", "スカラベ"], "hp": 12000, "attack": 1050, "base_hp": 12000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 1, "attack_wait": 30, "attack_interval": 262, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2161120, "race_id": 18, "special_effect_id": 2095, "master_id": 38839, "global_id": 12456, "spawn_sec": 174}, {"enemy_id": 22, "source": "local", "count": 9, "form_count": 2, "hp": 21000, "attack": 1200, "base_hp": 21000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 350.0, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118480, "race_id": 18, "change_to": 22, "change_condition": 2, "master_id": 31715, "global_id": 5334, "to_condition": 2, "to_global_id": 5335, "spawn_sec": 228}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10500, "attack": 800, "base_hp": 10500, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_range": 260, "attack_speed": 1, "attack_wait": 20, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118496, "race_id": 18, "missile_id": 351, "missile": {"speed": 10.0}, "master_id": 31716, "global_id": 5335, "ranged": true, "from_condition": 2}, {"enemy_id": 24, "source": "local", "count": 14, "form_count": 1, "hp": 12000, "attack": 1300, "base_hp": 12000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112560, "race_id": 18, "master_id": 30695, "global_id": 4314, "spawn_sec": 249}], "popups": ["蜜の入った壺は、\n周囲の敵のHPを三回まで\n大幅に回復します。\n\n空になった壺は\n回復を行わなくなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "魔界アリの女王", "text": "──なにっ、王国が攻めてくるだと！？", "face": "lbf5de9eaef7a"}, {"name": "ヴェルミス", "text": "攻めてくる──と言うと、少し語弊があるな。\nここで戦神コロッセウムの決勝が開かれるのだ。", "face": "l6aa4467fa81f"}, {"name": "ヴェルミス", "text": "元々、この森の蟲使いには招待状が届いていたらしい。\nハニービーが外部の伝手を使って連絡を取ったのだろう。", "face": "l6aa4467fa81f"}, {"name": "魔界アリの女王", "text": "ええい、あやつらめ余計な真似をしてくれたな！\n至急外の兵隊を集めよ、王子たちを迎え撃つのだ！", "face": "lbf5de9eaef7a"}, {"name": "ヴェルミス", "text": "女王、それはできない。", "face": "l6aa4467fa81f"}, {"name": "魔界アリの女王", "text": "何故だ！？", "face": "lbf5de9eaef7a"}, {"name": "ヴェルミス", "text": "もうそこにいる。", "face": "l6aa4467fa81f"}, {"name": "マレス", "text": "フハハハハハッ！！　蟲王国に！！　俺様が来た！！", "face": "lb24fefec4ed4"}, {"name": "マレス", "text": "これより戦神コロッセウム！\n人類最強決定戦・蟲王国の部！", "face": "lb24fefec4ed4"}, {"name": "マレス", "text": "バグズリベリオンの決勝を執り行う！", "face": "lb24fefec4ed4"}, {"name": "観客", "text": "どんどんぱふぱふ！", "face": "l0c573be078ea"}, {"name": "チェルシー", "text": "（いつの間にか観客まで呼んでる……！？）", "face": "u2369a1"}, {"name": "レーレン", "text": "魔界アリの女王、本当にこんなとこにいやがったか……。", "face": "u614"}, {"name": "魔界アリの女王", "text": "くっく……戦神マレスよ、よくもやってくれおったな。\nこれで妾の遠大な計画が全てご破算になってしもうたわ。", "face": "lbf5de9eaef7a"}, {"name": "マレス", "text": "フッ……貴様の計画など知らんな。\n俺様は蟲の森の戦士たちの参戦表明に応えたに過ぎん。", "face": "lb24fefec4ed4"}, {"name": "マレス", "text": "魔界アリの女王よ、棄権するのであればそれで構わん。\n戦神コロッセウムは戦意なき者の上がる舞台ではない。", "face": "lb24fefec4ed4"}, {"name": "アイネ", "text": "まあ、敵を前に戦わずして逃げた女王に、\nどれだけの者がついていくかは疑問ですが。", "face": "u2262a1"}, {"name": "誅子", "text": "（ぐさっ）", "face": "u2018a1"}, {"name": "ヴェルミス", "text": "女王、覚悟を決めた方が良い。", "face": "l6aa4467fa81f"}, {"name": "魔界アリの女王", "text": "ええい！　よかろう、戦ってくれるわ！\n確かに貴様らに計画は大きく狂わされたが、\nこの妾が何の備えもしておらぬとでも思うたか！？", "face": "lbf5de9eaef7a"}, {"name": "魔界アリの女王", "text": "王国よ、これでもくらえい！！", "face": "lbf5de9eaef7a"}, {"name": "ハニービー", "text": "気を付けて！　女王の特濃フェロモンが──", "face": "u2466a1"}, {"name": "ココン", "text": "……なにも、ない？　これは、加護の力？", "face": "l12314f6975de"}, {"name": "魔界アリの女王", "text": "貴様……何をした？", "face": "lbf5de9eaef7a"}, {"name": "マレス", "text": "俺様は言ったはずだぞ、魔界アリの女王よ。\n戦神コロッセウムに戦意なき者は必要ない。", "face": "lb24fefec4ed4"}, {"name": "マレス", "text": "貴様がフェロモンで『強制』動員した蟲たちは、\n俺様の方で一時的に預かっておくとしよう。", "face": "lb24fefec4ed4"}, {"name": "魔界アリの女王", "text": "戦神……マレスゥゥゥゥゥゥウッ！！！！", "face": "lbf5de9eaef7a"}, {"name": "マレス", "text": "さあ女王よ、これで舞台は整った。\n両者、純粋な己の武威を競うがいい！", "face": "lb24fefec4ed4"}, {"name": "マレス", "text": "いざ、開戦だ！", "face": "lb24fefec4ed4"}]}, {"trigger": "end", "lines": [{"name": "マレス", "text": "そこまで！！　勝者、王国の王子！！", "face": "lb24fefec4ed4"}, {"name": "観客", "text": "わっしょわっしょい！！", "face": "l0c573be078ea"}, {"name": "ヴェルミス", "text": "やれやれ、敗北が決まった途端に部下を捨て逃亡とは。\n途中までは女王らしい振る舞いも垣間見えたのだが──", "face": "l6aa4467fa81f"}, {"name": "ヴェルミス", "text": "（女王よ、やはり貴女は支配者の器ではない）", "face": "l6aa4467fa81f"}, {"name": "ココン", "text": "ん、待った。逃がさない。", "face": "l12314f6975de"}, {"name": "ハニービー", "text": "ちょーっとお話、聞かせてもらえるかしら。", "face": "u2466a1"}, {"name": "ヴェルミス", "text": "……まったく物騒なことだな、なあ戦神マレス殿。\nこれがコロッセウムを戦った戦士に対する仕打ちか？", "face": "l6aa4467fa81f"}, {"name": "マレス", "text": "お前たち、今すぐに武器を降ろせ。\nその者に危害を与えることは許さん。", "face": "lb24fefec4ed4"}, {"name": "ココン", "text": "だけど、こいつは……！！", "face": "l12314f6975de"}, {"name": "マレス", "text": "勘違いするなよ、蟲の森の繭守よ。\n俺様はお前たちを救いに来たわけではない。", "face": "lb24fefec4ed4"}, {"name": "マレス", "text": "聖人だろうが悪人だろうが知ったことか。\n俺様は戦い抜いた戦士をこそ尊重する。", "face": "lb24fefec4ed4"}, {"name": "マレス", "text": "ヴェルミスよ、良き闘争であったぞ。\nお前の安全、数日は俺様が保証しよう。", "face": "lb24fefec4ed4"}, {"name": "ウルカノ", "text": "そういうこったな、お前たちもこれ以上は諦めろ。\n蟲たちと森は取り返せた、今はそれで満足しとけ。", "face": "u1669a1"}, {"name": "ココン", "text": "……ん。", "face": "l12314f6975de"}, {"name": "ヴェルミス", "text": "感謝するよ、戦神マレス。\n私は特定の神を崇めてはいないが、\n今後祈ることがあれば貴方にしよう。", "face": "l6aa4467fa81f"}, {"name": "アイネ", "text": "ほう、中々に見所がありそうですね。\n女王の下を離れることがあれば連絡を、\nマレス様に仕える権利を差し上げます。", "face": "u2262a1"}, {"name": "ヴェルミス", "text": "悪くない選択肢だ。前向きに検討しておこう。", "face": "l6aa4467fa81f"}, {"name": "マレス", "text": "さて、今回はここでお別れだ戦士たちよ。\n次回の戦神コロッセウムを心して待てッ！！", "face": "lb24fefec4ed4"}, {"name": "マレス", "text": "フゥーハハハハハハハハッ！！！！", "face": "lb24fefec4ed4"}]}, {"trigger": "end", "lines": [{"name": "ハニービー", "text": "……二人とも行っちゃったわね。", "face": "u2466a1"}, {"name": "ハニービー", "text": "まずはお礼を言わせて。ありがとう、王子ちゃん。\nアタシとハニーちゃんたちの森を取り戻してくれて。", "face": "u2466a1"}, {"name": "ココン", "text": "こんぐらっちゅっれーしょん。", "face": "l12314f6975de"}, {"name": "ハニービー", "text": "王国へのこの恩は絶対に忘れないわ。\nもしアタシにできることがあれば何でも言って、\nハニーちゃん以外なら何をおいても助けに行くわ。", "face": "u2466a1"}, {"name": "ココン", "text": "私も、森の環境を元に戻したらそっちに行く。", "face": "l12314f6975de"}, {"name": "アンナ", "text": "はい、お二人ならいつでも歓迎です。"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "ハニービー", "text": "それじゃあ……またね、王子ちゃんたち！", "face": "u2466a1"}, {"name": "ココン", "text": "ばいばーい。", "face": "l12314f6975de"}]}], "active": true}