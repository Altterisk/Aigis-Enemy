{"quest_id": 9127, "name": "決勝Lv1", "description": "純粋な己の武威を競う決勝戦の舞台で、\n魔界アリの女王を相手に勝利を掴め！\n\n＜ユニット、アイテムのドロップなし＞", "modifier_notes": ["ユニット、アイテムのドロップなし"], "event": "バグズリベリオン", "event_category": "History", "mission_id": 920233, "map_no": 9358, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 2, "tags": ["置物"], "fixture": true, "hp": 150000, "attack": 12000, "base_hp": 150000, "base_attack": 12000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 80, "attack_speed": 1, "attack_wait": 120, "attack_interval": 301, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "pattern_id": 2161136, "special_effect_id": 2096, "change_to": 1, "change_condition": 4, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 38840, "global_id": 12457, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 12460, "commands": {"raw": "SetStageFlag(20, 1);", "sets_flags": [[20, 1]]}, "route_behaviour": {"transforms": [{"flag": 3, "val": 1, "to": 38840}, {"flag": 14, "val": 1, "to": 38840}, {"val": 1, "to": 38840}, {"flag": 8, "val": 1, "to": 38840}, {"flag": 7, "val": 1, "to": 38840}, {"flag": 15, "val": 1, "to": 38840}, {"flag": 2, "val": 1, "to": 38840}, {"flag": 13, "val": 1, "to": 38840}, {"flag": 6, "val": 1, "to": 38840}, {"flag": 12, "val": 1, "to": 38840}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物"], "fixture": true, "hp": 150000, "attack": 1, "base_hp": 150000, "base_attack": 1, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 120, "attack_interval": 302, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "pattern_id": 2161152, "special_effect_id": 2096, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 38843, "global_id": 1