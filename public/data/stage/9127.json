_to": 6, "master_id": 626, "global_id": 625}, {"enemy_id": 9, "source": "local", "count": 18, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_global_id": 624, "spawn_sec": 67}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 8, "master_id": 625, "global_id": 624}, {"enemy_id": 11, "source": "local", "count": 9, "form_count": 1, "hp": 8000, "base_hp": 8000, "damage_type": "physical", "armor_defense": 120, "attack_speed": 1, "attack_wait": 120, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126016, "race_id": 18, "special_effect_id": 774, "master_id": 38830, "global_id": 12447, "spawn_sec": 90}, {"enemy_id": 12, "source": "local", "count": 18, "form_count": 3, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 45, "attack_wait": 60, "attack_interval": 206, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2161056, "race_id": 18, "change_to": 12, "master_id": 38835, "global_id": 12452, "to_global_id": 1245