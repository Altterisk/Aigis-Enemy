nt": 2, "tags": ["狙う", "ブロック不可", "水面", "水棲"], "hp": 15000, "attack": 750, "base_hp": 15000, "base_attack": 750, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 180, "attack_speed": 180, "attack_wait": 60, "attack_interval": 169, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142032, "race_id": 4, "special_effect_id": 229, "change_to": 5, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 35754, "global_id": 9371, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 10, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 15, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123728, "race_id": 7, "special_effect_id": 229, "missile_id": 232, "master_id": 32689, "global_id": 6307, "ranged": true, "spawn_sec": 117}, {"enemy_id": 9, "source": "local", "count": 20, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 7000, "attack": 750, "base_hp": 7000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 60, "attack_speed": 1, "attack_wait": 25, "attack_interval": 109, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2123760, "race_id": 7, "missile_id": 11, "master_id": 32691, "global_id": 6309, "ranged": true, "spawn_sec": 166}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 2, "tags": ["水棲", "ブロック不可"], "hp": 86000, "attack": 3000, "base_hp": 86000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146064, "race_id": 4, "change_to": 10, "master_id": 36371, "global_id": 9988, "to_global_id": 9989, "route_behaviour": {"transforms": [{"wait": 600}]}, "spawn_sec": 304}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 86000, "attack": 3000, "base_hp": 86000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146080, "race_id": 4, "change_to": 11, "change_condition": 1, "master_id": 36372, "global_id": 9989, "variants": [{"hp": 86000, "attack": 3000, "base_hp": 86000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2146080, "race_id": 4, "special_effect_id": 1090, "master_id": 36373, "global_id": 9990}]}], "dialogue": [{"trigger": "start", "lines": [{"name": "蜃", "text": "――解けよ蜃気楼、いでよ真なる深海の祭殿よ！！", "face": "l63fcaad3241b"}, {"name": "イヲナミ", "text": "なっ……祭殿が消えました！？\nこの寂れた場所は、いったい……。", "face": "u1722a1"}, {"name": "シノ", "text": "……蜃は、配下のためにこの祭殿を――\n海中の楼閣を編み上げていたのでしょう。\nしかし今、それを解いたということは……。", "face": "u403"}, {"name": "イヲナミ", "text": "幻を維持していた妖力を、\n全力全開でこっちに向けてくるってことですか！？", "face": "u1722a1"}, {"name": "蜃", "text": "かつて、人々は妖怪を畏れ、\n海を崇め、決して蔑ろにはしなかった。", "face": "l63fcaad3241b"}, {"name": "蜃", "text": "それが何だ、魔物だ魔王だ亜神だと、\n世は乱れ、信仰は揺らぎ、\n妖怪への畏れなど消え失せてしまった！", "face": "l63fcaad3241b"}, {"name": "蜃", "text": "もはや、妖怪が生き延びるには、\n神に連なる血筋を取り込むしかないのだ！", "face": "l63fcaad3241b"}, {"name": "シノ", "text": "なるほど、事情が飲み込めました。\nただ、解決策を提案するには――", "face": "u403"}, {"name": "サギリ", "text": "チッ……頭茹だってやがる。\n一回叩きのめさないといけないな。", "face": "u869"}, {"name": "カスミ", "text": "対話の第一歩はケジメから。\n王子さま、蜃を倒して話を聞かせましょう！", "face": "u470"}, {"name": "蜃", "text": "そうはさせぬわ！\nいざ、我が真の姿を見せてやろう！\n蜃気楼を束ねし大妖怪「蜃」の威容を！", "face": "l63fcaad3241b"}]}, {"trigger": "end", "lines": [{"name": "蜃", "text": "ぐぁぁぁぁっ！！\nくっ……溺れる地の者ごときがぁ……！！", "face": "l63fcaad3241b"}, {"name": "シノ", "text": "そこまで！\n大妖怪ならば、負けを認める器を見せてはどうですか。", "face": "u403"}, {"name": "蜃", "text": "くっ……溺れる地の妖怪総大将ごときが……。\n深海の惨状を知らぬくせに……。", "face": "l63fcaad3241b"}, {"name": "シノ", "text": "……深海の者たちまで、\n気を回してやれなかったことは謝罪します。\nされどこれからは違いますよ。", "face": "u403"}, {"name": "ウズメ", "text": "――魔物復活以降、海路が封鎖され、\n人々が漁に出られなくなった。\nそれにより、畏れを得られなくなった、と。", "face": "u125"}, {"name": "ウズメ", "text": "それゆえに、畏れの代わりとなる力を得るべく、\n龍宮城の亜神と血縁を結ぼうとした。\nこれで合っていますか、蜃どの？", "face": "u125"}, {"name": "蜃", "text": "むっ……そう、だが……？", "face": "l63fcaad3241b"}, {"name": "シノ", "text": "地上の妖怪も、同じことで困っていました。\nそこで我々は、畏れ以外の手段で、\n妖怪たちが糧を得ていく手段を見つけたのです。", "face": "u403"}, {"name": "海河童", "text": "畏れ、以外……だァ……？", "face": "l15ef4255c9c0"}, {"name": "カスミ", "text": "妖怪とは人の感情を喰らうもの。\n向けられる感情が何であれ、\n人が妖怪のことを想うのであれば――", "face": "u470"}, {"name": "シノ", "text": "それが、妖怪にとっては糧となるのです。\n畏れでなく、例えば憧憬であっても。", "face": "u403"}, {"name": "サギリ", "text": "だから、嫌がってる女の子に結婚を迫るより、\nカッコイイ大妖怪の生き様ってやつを、\n港の人間たちに見せてやれよ。", "face": "u869"}, {"name": "サギリ", "text": "あたしだって知ってるぜ？\n瑞妖蜃気楼、何もない水面に、\n絢爛たる楼閣を編み上げるおそるべき者だってな。", "face": "u869"}, {"name": "蜃", "text": "…………。\nそう、か、目をそらしていたのは、我々だったのか。", "face": "l63fcaad3241b"}, {"name": "蜃", "text": "よし、海河童よ、サザエ鬼よ、\nこれからは、こちらから化かしに行こうぞ！", "face": "l63fcaad3241b"}, {"name": "蜃", "text": "人が漁に訪れるのを待つのではない。\n化かし、驚かせに、こちらから赴くのだ！", "face": "l63fcaad3241b"}, {"name": "サギリ", "text": "……ん？　あれ？", "face": "u869"}, {"name": "カスミ", "text": "サギリちゃん、焚き付け方に失敗してないですか？", "face": "u470"}, {"name": "シノ", "text": "……前向きになったのは、良いことです。\n漁港には一応目を光らせておくとしましょう。", "face": "u403"}, {"name": "イヲナミ", "text": "えーっとぉ……これで、\n乙姫さまの件は解決、ですかねぇ？", "face": "u1722a1"}, {"name": "アンナ", "text": "どうやら、そのようですね？\nでは王子、龍宮城へ戻りましょうか。"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 18, "params": [150]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 10, "damage_type": "physical", "pattern_id": 2146096}, {"enemy_id": 1, "form_index": 1, "hp": 23000, "attack": 1800, "damage_type": "physical", "armor_defense": 2800, "magic_defense": 30, "pattern_id": 2146112}, {"enemy_id": 3, "hp": 1050, "attack": 200, "damage_type": "physical", "armor_defense": 60, "magic_defense": 10, "pattern_id": 2123712}, {"enemy_id": 4, "hp": 380000, "attack": 4200, "damage_type": "magical", "armor_defense": 5000, "magic_defense": 60, "pattern_id": 2146128}, {"enemy_id": 5, "hp": 100000, "attack": 2800, "damage_type": "magical", "armor_defense": 3000, "magic_defense": 25, "pattern_id": 2146128}, {"enemy_id": 6, "hp": 15000, "attack": 750, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "pattern_id": 2142048}, {"enemy_id": 6, "form_index": 1, "hp": 15000, "attack": 750, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "pattern_id": 2142032}, {"enemy_id": 8, "hp": 3000, "attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2123728}, {"enemy_id": 9, "hp": 7000, "attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "pattern_id": 2123760}, {"enemy_id": 10, "hp": 86000, "attack": 3000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "pattern_id": 2146064}, {"enemy_id": 10, "form_index": 1, "hp": 86000, "attack": 3000, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 25, "pattern_id": 2146080}]}, "active": true}