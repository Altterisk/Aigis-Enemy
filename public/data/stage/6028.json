{"quest_id": 6028, "name": "大地に眠る召喚獣（記憶）", "description": "洞窟で出会った少女のため、\n炎獄より来たる野獣に力を示せ！\n＜敵の移動速度アップ＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["敵の移動速度アップ"], "event": "戦場の記憶", "event_category": "History", "mission_id": 920085, "map_no": 3758, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 10, "modifiers": [{"kind": "term", "influence": 12, "params": [250]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "hp": 23000, "attack": 2500, "base_hp": 23000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 40, "attack_interval": 301, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "special_effect_id": 222, "master_id": 20041, "global_id": 1116, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 14}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 19}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 32}, {"enemy_id": 5, "source": "local", "count": 28, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 34}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 220, "global_id": 219, "spawn_sec": 90}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 127}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 138}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 300, "base_hp": 25000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_range": 130, "attack_speed": 120, "attack_wait": 60, "attack_interval": 221, "move_speed": 230.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100192, "missile_id": 28, "missile": {"speed": 6.0, "splash": 200}, "master_id": 223, "global_id": 222, "ranged": true, "spawn_sec": 165}], "dialogue": [{"trigger": "start", "lines": [{"name": "ソラノ", "text": "――そういえばお礼を忘れてたわね。\nさっきは助けてくれてありがとう、\n私は召喚士のソラノ。", "face": "u134"}, {"name": "ソラノ", "text": "一人前の召喚士になるためには召喚獣を手に入れることが\n条件。召喚獣を手に入れたら仲間になってあげるんだから、\n協力してよね。", "face": "u134"}, {"name": "ソラノ", "text": "さあ、私の後についてくるのよ！", "face": "u134"}, {"name": "アンナ", "text": "ああ、一人で先に行かないでください。\n魔物たちが待ち伏せているかもしれませんよ。", "face": "l9d6a0fdd4bae"}, {"name": "ソラノ", "text": "えっ！？\nちょっと女の子を先に行かせるなんて\nヒドイじゃない！", "face": "u134"}, {"name": "兵士", "text": "報告！　魔物が通常よりも速い速度で\n接近しているとの事！", "face": "l9cc0c3a8a979"}, {"name": "アンナ", "text": "ここでは魔物の動きが素早くなっているようですね……。\n王子、気を付けてください。油断は禁物です。", "face": "l9d6a0fdd4bae"}]}, {"trigger": "end", "lines": [{"name": "ソラノ", "text": "やったわ！　これで私も一人前よ！\nんじゃ、無事召喚獣も手に入ったし。\n約束通り、力を貸してあげるわ。よろしくね！", "face": "u134"}, {"name": "レーヴ", "text": "…………ソラノさん、とっても元気な方でしたね！\n何だか、見ているこちらまで元気になってしまいました！", "face": "u454"}, {"name": "レーヴ", "text": "それにしてもイフリートを使役されているとの事ですが、\nあれほどの熱気……召喚士の方は熱くないのでしょうか？", "face": "u454"}, {"name": "レーヴ", "text": "むぅ……実に興味深い……。", "face": "u454"}, {"name": "レーヴ", "text": "――ハッ！？　す、すみません！\nまたぼうっとしていたようで……。", "face": "u454"}, {"name": "レーヴ", "text": "それでは次の記憶へと進みましょう、王子。\nさあ、お手をどうぞ……。", "face": "u454"}]}], "active": true}