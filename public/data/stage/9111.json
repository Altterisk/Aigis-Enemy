enemy_id": 29, "source": "local", "count": 1, "form_index": 7, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 275, "change_to": 36, "master_id": 35874, "global_id": 9491, "to_global_id": 9492}, {"enemy_id": 29, "source": "local", "count": 1, "form_index": 8, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 1258, "change_to": 37, "master_id": 35875, "global_id": 9492, "to_global_id": 9493}, {"enemy_id": 29, "source": "local", "count": 1, "form_index": 9, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 275, "change_to": 38, "master_id": 35876, "global_id": 9493, "to_global_id": 9494}, {"enemy_id": 29, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 1259, "change_to": 39, "master_id": 35877, "global_id": 9494, "to_global_id": 9495}, {"enemy_id": 29, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 275, "change_to": 40, "master_id": 35878, "global_id": 9495}], "popups": ["フェイロンは\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で２倍までアップ\n\n\n\n　　　　　　(1/2)", "また、フェイロンは一定確率で\n物理攻撃を回避します。\n\nさらに、フェイロンは\nHPが徐々に回復します。\n\n\n　　　　　　(2/2)", "華王、誅子は\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ\n\n\n\n　　　　　　(1/2)", "また華王、誅子は一定確率で\n物理攻撃を回避します。\n\nさらに、華王、誅子がいる間は\n全ての敵の攻撃と防御が\n大幅にアップします。\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "アラン", "text": "──いったいどういう風の吹き回しですか？", "face": "u1511a1"}, {"name": "マレス", "text": "……何の話だ、銀月の亜神よ。", "face": "l8bb7479cf030"}, {"name": "アラン", "text": "あなたは身勝手に人間を振り回しても、\n意図的に国家の政に干渉する性格ではないでしょう。\nどうして今回に限って華の国に介入する真似を？", "face": "u1511a1"}, {"name": "マレス", "text": "……誅子が武王大宴に参加を表明した時点で、\n前回の武王を筆頭に古強者たちは国を案じ身を引いた。\n残されたのは、活きは良いが経験の少ない若者が主体だ。", "face": "l8bb7479cf030"}, {"name": "マレス", "text": "元始天尊に鍛えられた誅子には敵わん。\n出来レースだ、そう仕組んだのはフェイロンだがな。\n結末の分かり切った戦いなど見ても何も面白くはない。", "face": "l8bb7479cf030"}, {"name": "アラン", "text": "……誅子はあなたの嫌う人種かと思いましたが、\nここまで肩入れするとは意外ですね。", "face": "u1511a1"}, {"name": "マレス", "text": "それは簡単な話だ、銀月よ。\n王の責務から逃げ出した歴代にも類を見ぬ暗君。\nそんなことはな、あいつ自身が一番よく理解している。", "face": "l8bb7479cf030"}]}, {"trigger": "start", "lines": [{"name": "マレス", "text": "──さあ、時間だ武人たちよ！\nこれより戦神コロッセウム・武王大宴！\nその決勝戦の開幕をここに宣言する！", "face": "l8bb7479cf030"}, {"name": "マレス", "text": "栄誉ある武王の座を争う二人を紹介しよう！\nまずはもはや物質界にその名を知らぬ者はなし！\n女神アイギスの加護を受けし大英雄、王国の王子！", "face": "l8bb7479cf030"}, {"name": "観客A", "text": "うぉおおおおおおッ！", "face": "l73df3fb11b39"}, {"name": "マレス", "text": "続いてはこちらも貴様らのよく知る顔だろう。\n元始天尊から直々に鍛え上げられし華王、誅子！", "face": "l8bb7479cf030"}, {"name": "観客A", "text": "………………。", "face": "l73df3fb11b39"}, {"name": "観客B", "text": "………………。", "face": "lf72e82738284"}, {"name": "レアン", "text": "（……露骨だな、そして異様だ。\nこれでは針の筵に座る方がまだマシだろう。\nこんな空気、普通実力の半分も発揮できんぞ）", "face": "u50"}, {"name": "聞忠", "text": "ちゅ、誅子──", "face": "l780a23f2b887"}, {"name": "華王、誅子", "text": "──嬉しいなぁ、聞忠よ。", "face": "le3ac29afab6a"}, {"name": "聞忠", "text": "…………へ？", "face": "l780a23f2b887"}, {"name": "華王、誅子", "text": "彼らは余が特に迷惑をかけた者たちだ。\n華の国の危機に際し、無能なる王に代わって、\n十天君の脅威に正面から立ち向かった武人たち。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "余の顔など二度と見たくもないだろうに、\nこうして席を立たずに余を見てくれている。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "たとえ彼らが余に期待するものが、\n王子に敗れ地に這いつくばる姿だとしても。\nこの状況がどれほど望外の喜びであることか。", "face": "le3ac29afab6a"}, {"name": "聞忠", "text": "……誅子、あなたは。", "face": "l780a23f2b887"}, {"name": "華王、誅子", "text": "聞忠よ、これは証明する戦いだ。\n失った信頼は、結果でしか取り戻せん。\n決勝の相手が王子で、余は逆に良かった。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "華王は、とても強いのだと。\nこの国を守る力があるのだと。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "今ここで、世界に知らしめよう。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "──死ぬ気で行くぞ、王子。", "face": "le3ac29afab6a"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "マレス", "text": "両者の奮闘を期待する！　始めッ！", "face": "l8bb7479cf030"}]}, {"trigger": "end", "lines": [{"name": "華王、誅子", "text": "──は、ははははっ！\nまだだ、まだ終わっていない！\n余はまだ戦える、そうだろう王子！", "face": "le3ac29afab6a"}, {"name": "聞忠", "text": "待ってください誅子、その怪我ではもう……！", "face": "l780a23f2b887"}, {"name": "華王、誅子", "text": "骨の一本も砕かずにおめおめと降参などできるか！\n余が見捨てた民の苦しみはこんなものではないはずだ！", "face": "le3ac29afab6a"}, {"name": "アリス", "text": "誅子さん……。", "face": "u288"}, {"name": "華王、誅子", "text": "親を亡くした童に石を投げられた！\n子を腕の中に抱いた母親の死体を見た！\n全ては余の無能と臆病さが招いた悲劇だ！", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "あのときの痛みに比べれば！\nこんな傷なんら問題ではない！", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "続けるぞ！　証明せねばならんのだ！\n余は逃げぬ……二度と逃げたりせぬと！", "face": "le3ac29afab6a"}, {"name": "マレス", "text": "──いや、そこまでだ。決着はついた。\nよく吠えたが、その動かぬ足では戦えまい。", "face": "l8bb7479cf030"}, {"name": "華王、誅子", "text": "────っ。", "face": "le3ac29afab6a"}, {"name": "マレス", "text": "勝者、王子！　誇れ、次代の最強はお前のものだ！", "face": "l8bb7479cf030"}, {"name": "観客A", "text": "うぉおおおおおおッ！　王子ぃいいいいッ！", "face": "l73df3fb11b39"}, {"name": "観客B", "text": "新しい武王の誕生だぁああああ！", "face": "lf72e82738284"}, {"name": "華王、誅子", "text": "………………無様、だな。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "……っ、うっ、くっ……。", "face": "le3ac29afab6a"}, {"name": "マレス", "text": "──馬鹿め、もっと周りをよく見ろ。", "face": "l8bb7479cf030"}, {"name": "観客の少女", "text": "ちゅ、誅子さまー！　かっこよかったよー！", "face": "lcb0e0be1a49b"}, {"name": "クーシン", "text": "（ぱちぱちぱちぱち）", "face": "u2000a1"}, {"name": "華王、誅子", "text": "────っ、はっ、はは。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "片や会場を震わせるほどの大歓声……。\n片や童の声援一つにまばらな拍手か……。", "face": "le3ac29afab6a"}, {"name": "聞忠", "text": "誅子……誅子ぃ……！", "face": "l780a23f2b887"}, {"name": "華王、誅子", "text": "泣くな聞忠、余まで泣けてくる。\nこれが、余と貴様の現在地らしい。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "……精進が足りんなぁ。", "face": "le3ac29afab6a"}]}], "active": true}