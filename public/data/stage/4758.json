": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "special_effect_id": 499, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 677, "global_id": 676, "ranged": true, "spawn_sec": 236}, {"enemy_id": 12, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "special_effect_id": 499, "master_id": 679, "global_id": 678, "spawn_sec": 246}], "popups": ["オーラをまとった魔物がいる間は、\n全てのアンデッドの攻撃と防御が\nアップします。\n\n攻撃と防御アップの効果は、\nオーラをまとった魔物の数に\n応じて重複します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "モーティマ", "text": "やっと追いついたぞ！\nカボチャ達！", "face": "u14"}, {"name": "カボチャの魔物", "text": "ク、クヒー！\nキ、キング様！\nアイツラがモウ来たカボ！　食べられるカボ……！", "face": "l127852b34ebb"}, {"name": "パンプキンキング", "text": "クー……。こうなったら、最後の手段カボ……。\n食べられるくらいなら――", "face": "l215dcaca6d0c"}, {"name": "パンプキンキング", "text": "カボチャの魔物2体を捧げて、\n魔神ビフロンス様を召喚……カボッ！", "face": "l215dcaca6d0c"}, {"name": "カボチャの魔物", "text": "サ、捧ゲル！？　カ、カボ――！？\nキング様、ビフロンス様の復活ハ\n王子ノ魂デナイトダメナンジャ……！", "face": "l127852b34ebb"}, {"name": "パンプキンキング", "text": "精神体であれば、\n地上界に現れることは出来るはずカボ！", "face": "l215dcaca6d0c"}, {"name": "パンプキンキング", "text": "そして、魔神ビフロンス様の特殊効果により、\n戦場のアンデッドモンスターの数体に\n味方を強化する特殊能力が発動する……カボッ！", "face": "l215dcaca6d0c"}, {"name": "パンプキンキング", "text": "ビフロンス様がお姿を見せるまでは、\n何としても王子たちを足止めするカボ！\n王子の魂を奪うスキは必ず生まれるカボ……！", "face": "l215dcaca6d0c"}, {"name": "カボチャの魔物", "text": "カボー！", "face": "l127852b34ebb"}, {"name": "エーリカ", "text": "カボー！", "face": "u409"}]}, {"trigger": "end", "lines": [{"name": "パンプキンキング", "text": "そんな……。\nせっかくお見えになった、\nビフロンス様のお姿が消えたカ……ボ……！", "face": "l215dcaca6d0c"}, {"name": "パンプキンキング", "text": "もっと……もっと魂を捧げなければ……！\nたとえ精神体であろうと、\nさっきよりも地上界で力を行使できるはずカボ！", "face": "l215dcaca6d0c"}, {"name": "兵士", "text": "報告！\n敵の攻勢が止まりました！", "face": "l8c4c9afdcef3"}, {"name": "ケイティ", "text": "……一体どういう事でしょうか。\n寄り集まって何か思案しているようです。", "face": "u114"}, {"name": "アンナ", "text": "不穏ですね……。\n王子、しばらく様子を見ましょう。", "face": "ld51aa19f5fed"}]}], "map": {"image": "Map920078_3873", "w": 960, "h": 640, "spots": [{"k": "b", "x": 948, "y": 381}, {"k": "b", "x": 12, "y": 437}, {"k": "m", "x": 873, "y": 348, "id": 200}, {"k": "m", "x": 785, "y": 398, "id": 201}, {"k": "m", "x": 685, "y": 449, "id": 202}, {"k": "m", "x": 600, "y": 407, "id": 203}, {"k": "m", "x": 788, "y": 301, "id": 204}, {"k": "m", "x": 319, "y": 455, "id": 205}, {"k": "m", "x": 416, "y": 408, "id": 206}, {"k": "m", "x": 157, "y": 363, "id": 207}, {"k": "m", "x": 325, "y": 270, "id": 208}, {"k": "m", "x": 237, "y": 414, "id": 209}, {"k": "m", "x": 511, "y": 360, "id": 210}, {"k": "m", "x": 231, "y": 214, "id": 211}, {"k": "m", "x": 782, "y": 212, "id": 212}, {"k": "m", "x": 705, "y": 257, "id": 213}, {"k": "m", "x": 244, "y": 316, "id": 214}, {"k": "m", "x": 424, "y": 314, "id": 215}, {"k": "m", "x": 615, "y": 306, "id": 216}, {"k": "m", "x": 612, "y": 213, "id": 217}, {"k": "m", "x": 409, "y": 217, "id": 218}, {"k": "m", "x": 510, "y": 267, "id": 219}, {"k": "m", "x": 324, "y": 169, "id": 220}, {"k": "m", "x": 701, "y": 170, "id": 221}, {"k": "r", "x": 744, "y": 96, "id": 300}, {"k": "r", "x": 686, "y": 345, "id": 301}, {"k": "r", "x": 557, "y": 471, "id": 302}, {"k": "r", "x": 442, "y": 470, "id": 303}, {"k": "r", "x": 143, "y": 458, "id": 304}, {"k": "r", "x": 231, "y": 95, "id": 305}, {"k": "r", "x": 101, "y": 270, "id": 306}]}, "start_cost": 10, "active": true}