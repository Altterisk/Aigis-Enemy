0, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 9}, {"enemy_id": 5, "source": "local", "count": 10, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 26, "global_id": 25, "spawn_sec": 62}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 66}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 2500, "attack": 600, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 27, "global_id": 26, "spawn_sec": 90}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 1000, "base_hp": 3000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097840, "race_id": 16, "master_id": 45, "global_id": 44, "spawn_sec": 128}], "dialogue": [{"trigger": "start", "lines": [{"name": "ナナリー", "text": "他国への、表敬訪問ですか……？", "face": "u29"}, {"name": "シビラ", "text": "凱旋パレードで各国をまわるでしょう？\n北の大国の王家を代表する以上、挨拶は必要だから。", "face": "u39"}, {"name": "シビラ", "text": "それに、例の黒冠のこともあるし、\n各国の連携を深めるためにも\n友好関係をアピールしておかないと。", "face": "u39"}, {"name": "ディーナ", "text": "お姫様ってのは考えることが多いんだなぁ……。\nまっ、国の話とかはよく分からないけど、\n仲良くするのはいいことだな！", "face": "u22"}, {"name": "ナナリー", "text": "ですが、大丈夫なのですか？\nひとりで動くのは、やはり危険だと思いますけど……。", "face": "u29"}, {"name": "ディーナ", "text": "じゃあ護衛についていけばいいんじゃないか？", "face": "u22"}, {"name": "シビラ", "text": "それはありがたいけれど、ふたりとも入賞者でしょう？\n式典で忙しいのではないかしら。", "face": "u39"}, {"name": "ディーナ", "text": "堅苦しいのは苦手だしさ。\nそれに友だちと一緒にいたほうが楽しいだろ？", "face": "u22"}, {"name": "ナナリー", "text": "そうですね、私もディーナさんと一緒に、\nシビラ様の護衛をさせてもらいます。", "face": "u29"}, {"name": "ナナリー", "text": "……友だちですから。", "face": "u29"}, {"name": "シビラ", "text": "ふふっ、友達ね……。\nそれなら、厚意に甘えさせてもらうわ。", "face": "u39"}, {"name": "ディーナ", "text": "ところで、気になってることがあるんだけど\n友だちだし聞いてもいいよな？", "face": "u22"}, {"name": "ディーナ", "text": "ときどき、プリンセスたちでお茶会してるだろ？\nいつもすごい轟音が聞こえてくるんだけど、\nいったい何をやってるんだ？", "face": "u22"}, {"name": "シビラ", "text": "ああ、説明するより体験してみる？\nプリンセス流のお茶会というものを。", "face": "u39"}, {"name": "ナナリー", "text": "ぷ、プリンセス流のお茶会、ですか……？", "face": "u29"}, {"name": "ディーナ", "text": "それって普通のとなにが違うんだ？", "face": "u22"}, {"name": "シビラ", "text": "お茶を楽しむだけじゃなくて、戦いも楽しむの。\nつまりは、模擬戦をするってことね。", "face": "u39"}, {"name": "シビラ", "text": "ほら、どうせならそこの貴方もおいで。", "face": "u39"}, {"name": "ジュジュカ", "text": "えっ！？　私も参加するんですか！？", "face": "u2431a1"}, {"name": "シビラ", "text": "今回のパレード、司会進行に任命されたのでしょう？\nせっかくだし、ここで打ち解けておきましょう。", "face": "u39"}]}, {"trigger": "end", "lines": [{"name": "ベルニス", "text": "ジュジュカさん、大丈夫ですか？\nいきなり模擬戦に巻き込まれてましたけど……。", "face": "u2434a1"}, {"name": "ジュジュカ", "text": "ぜぇーっ、ぜぇーっ！", "face": "u2431a1"}, {"name": "ディーナ", "text": "大丈夫かー？\nなんだったら私がマッサージするぞ！", "face": "u22"}, {"name": "ジュジュカ", "text": "あぁぁ～～マッサージきもちぃ～～～……。", "face": "u2431a1"}, {"name": "ナナリー", "text": "ふふ、賑やかなお茶会ですね。", "face": "u29"}, {"name": "シビラ", "text": "えぇ、そうね。\nとても楽しいお茶会だわ。", "face": "u39"}, {"name": "シビラ", "text": "……パレードの間は、よろしくね。\n護衛もそうだけど、貴方たちと楽しみたいから。", "face": "u39"}]}], "active": true}