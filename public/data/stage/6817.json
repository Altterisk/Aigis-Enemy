rce": "local", "count": 8, "form_count": 3, "hp": 1500, "attack": 130, "base_hp": 1500, "base_attack": 130, "damage_type": "magical", "armor_defense": 60, "magic_defense": 10, "attack_range": 150, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101888, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 31834, "global_id": 5453, "ranged": true, "to_global_id": 656, "spawn_sec": 107}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["狙う", "ブロック不可", "水面"], "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 60, "magic_defense": 10, "attack_range": 100, "attack_speed": 150, "attack_wait": 60, "attack_interval": 171, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101120, "race_id": 7, "special_effect_id": 229, "change_to": 1, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 657, "global_id": 656, "ranged": true, "to_global_id": 346}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 1500, "attack": 130, "base_hp": 1500, "base_attack": 130, "damage_type": "magical", "armor_defense": 60, "magic_defense": 10, "attack_range": 150, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101888, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 347, "global_id": 346, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 116}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 7, "master_id": 580, "global_id": 579, "to_global_id": 349, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 160}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349}], "dialogue": [{"trigger": "start", "lines": [{"name": "フーリ", "text": "――こんなところに、魚人の住処があったなんて。", "face": "u658"}, {"name": "アンナ", "text": "この付近には漁村があります。\nこのまま放置したら、\nどんな被害が出るかわかりませんね……。", "face": "u437"}, {"name": "リタ", "text": "ここで退治してしまいますか。\n幸いなことに、\nここからふたつの通路に繋がっています。", "face": "u837"}, {"name": "マーヤ", "text": "なるほど、挟撃が可能ですね……。\n周辺の村の為にも、全力で叩いてしまいましょう。", "face": "u839"}, {"name": "サンドラ", "text": "水路から逃げるやつがいるかもしれないし、\nそうね、私とドルチェ、リタで出口の対処をするわ。\nラピス、王子の援護は任せたからね？", "face": "u836"}, {"name": "ラピス", "text": "……何故私なんだ。\nだが、海水浴よりはマシか……。", "face": "u832"}, {"name": "ドルチェ", "text": "もうっ、勝手に決めないでよ！\n……狙撃してる間、ちゃんと守ってよ？", "face": "u835"}, {"name": "サンドラ", "text": "えぇ、任せておいて。\nドルチェにはヒレ一本触れさせないわ。\nもちろん、リタにもね？", "face": "u836"}, {"name": "リタ", "text": "わ、私は隠れるの得意ですから！\nちゃんとドルチェを守ってあげてくださいっ。", "face": "u837"}, {"name": "アンナ", "text": "それでは王子、我々はこの場所に集中しましょう。\n急な事態ではありますが、\n戦闘の指揮をお願いします！！", "face": "u437"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "どうやら、この周辺の魚人は殲滅出来たようですね。", "face": "u437"}, {"name": "ラピス", "text": "魚人如きが、私に抗おうなどと考えるからこうなるんだ。", "face": "u832"}, {"name": "サンドラ", "text": "ふぅ、水路から逃げた連中の討伐も完了よ。\nお疲れ様、ドルチェ、リタ。", "face": "u836"}, {"name": "ドルチェ", "text": "王子達が大半を倒してくれたから助かったわ。\nでも、せっかくの海なのに、\nじめじめした洞窟で魔物討伐なんて……。", "face": "u835"}, {"name": "リタ", "text": "……そうですか？\n私、結構ここ好きなんですけど……。", "face": "u837"}, {"name": "マーヤ", "text": "わ、私も涼しくて結構好きだったり……。", "face": "u839"}, {"name": "ラピス", "text": "炎天下よりも、ここの方が落ち着くぞ。", "face": "u832"}, {"name": "アンナ", "text": "それでは、ここでもう少し涼んでから、\n模擬戦の続きにしましょうか。", "face": "u437"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}