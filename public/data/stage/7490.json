1, "form_count": 3, "tags": ["機械"], "hp": 24000, "attack": 1500, "base_hp": 24000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_range": 220, "attack_wait": 30, "attack_interval": 126, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131904, "race_id": 2, "special_effect_id": 893, "change_to": 7, "change_condition": 2, "missile_id": 636, "missile": {"speed": 8.0}, "master_id": 34227, "global_id": 7844, "ranged": true, "to_condition": 2, "to_global_id": 7845, "spawn_sec": 196}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械"], "hp": 16000, "attack": 1000, "base_hp": 16000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_wait": 50, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131920, "race_id": 2, "special_effect_id": 894, "change_to": 8, "change_condition": 2, "missile_id": 542, "missile": {"speed": 17.0}, "master_id": 34228, "global_id": 7845, "from_condition": 2, "to_condition": 2, "to_global_id": 7846}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["機械", "ステルスII", "ブロック不可"], "hp": 16000, "attack": 1000, "base_hp": 16000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_range": 1, "attack_wait": 50, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131936, "race_id": 2, "special_effect_id": 895, "missile_id": 542, "missile": {"speed": 17.0}, "master_id": 34229, "global_id": 7846, "ranged": true, "from_condition": 2}], "popups": ["ミニメカドラゴンのおもちゃは\n攻撃力200以下のあらゆる攻撃を\n受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。", "フォー人形から受けた\nダメージは2倍になります。\n\nまた、フォー人形は倒されると\n自身の周囲にダメージを与えます。", "ブラックメカドラゴンの\nおもちゃから受けるダメージは\n2倍になります。\nまた、ブラックメカドラゴンの\nおもちゃは攻撃力800以下の\nあらゆる攻撃を受け付けず、\n倒されると自身の周囲に\nダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヘレナ", "text": "――よし、まだメカドラゴンは完成していないようだ。\n市街のどこかに、\n連中がパーツを運び込んでいるはずだが……。", "face": "u1397a1"}, {"name": "アナベラ", "text": "……いや、ヘレナ。\nどうやら探している暇はなさそうだぞ。アレを見ろ！", "face": "u1309a1"}]}, {"trigger": "start", "lines": [{"name": "エスネア", "text": "あれって、ミニメカドラゴンのおもちゃ！？\nうぅぅ、おもちゃを悪事に使うなんてー！", "face": "u997"}, {"name": "ヘレナ", "text": "……時間稼ぎをするつもりか。\n王子、ミニメカドラゴンを強行突破するぞ！", "face": "u1397a1"}]}, {"trigger": "battle", "at_sec": 198, "lines": [{"name": "ヘレナ", "text": "なんだ、この音は……。\n何か巨大なものの羽ばたきのような……。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "ドラゴン……いや違う、\nこの機械音は……まさか、間に合わなかったのか！？", "face": "u1397a1"}, {"name": "クロエ", "text": "暗黒メカドラゴン……うぅん、あれはその後継機……。\nまさか、もう完成したっていうの？", "face": "u145"}, {"name": "エスネア", "text": "デーモンシェフが極秘プロジェクトだって言ってた、\n最凶の漆黒竜、ブラックメカドラゴン――のおもちゃ！？", "face": "u997"}, {"name": "モーティマ", "text": "おいおいおい、何だよあれ！\nおもちゃってサイズじゃねぇぞ！", "face": "u14"}, {"name": "デーモンシェフ", "text": "市販されるのはミニメカドラゴンのサイズだからな……。\nくぅっ、やはりフルサイズ版の\n設計図を盗み出していたのか！", "face": "lf28f528005ca"}, {"name": "フォー", "text": "あーあーあー、聞こえるかなァ？\nどうだい、驚いたかァ！？", "face": "l2dca6681666f"}, {"name": "フォー", "text": "王子ィ、俺の犯罪計画に泥を塗った罪、\n王国の民に清算させてやろうじゃないかァ！", "face": "l2dca6681666f"}, {"name": "アイリーン", "text": "王子、お気をつけを。\nブラックメカドラゴンのおもちゃから、\n大量の火薬と、闇の組織の使う毒の匂いがします。", "face": "u315"}, {"name": "ヘレナ", "text": "なるほど、武器に毒を塗っているんだろうな。\n火薬は――つまり撃破されたら、\n自爆して周囲を巻き込むつもりなんだな？", "face": "u1397a1"}, {"name": "エスネア", "text": "そ、それも大変だけどさ、\nあいつの出力、普通よりも高くなってるみたいだよ！\n倍以上の力で攻撃してくるかも……！", "face": "u997"}, {"name": "ヘレナ", "text": "やれやれ……どこまでも念入りな嫌がらせだな！\n王子、迅速にこいつらを撃破して、\nそのままフォーを逮捕するぞ！！", "face": "u1397a1"}]}, {"trigger": "end", "lines": [{"name": "フォー", "text": "アーッハッハッハッハッ！！\nやるじゃないか！\n一号機を破壊するなんてなぁ！！", "face": "l2dca6681666f"}, {"name": "フォー", "text": "――だがなァ、クリスマスパーティは、\nここ――からが――本番――", "face": "l2dca6681666f"}, {"name": "ヘレナ", "text": "……このフォーも人形か。\nしかし、一号機だと……？", "face": "u1397a1"}, {"name": "ヘレナ", "text": "ブラックメカドラゴンのおもちゃを\nまだどこかに隠している、のか……？", "face": "u1397a1"}, {"name": "デーモンシェフ", "text": "そんな馬鹿な……。\n弊社でもまだ、試作の段階なのだぞ……？\n闇の組織に、そんな加工技術を持つ者が――", "face": "lf28f528005ca"}, {"name": "ソーマ", "text": "……あっ。います、よね。\n闇の組織に協力している、機械に精通した人……。", "face": "u23"}, {"name": "絡繰り忍者", "text": "――然り。\n先刻ぶりの再会にござるな。", "face": "l9ac55d93a312"}]}], "active": true}