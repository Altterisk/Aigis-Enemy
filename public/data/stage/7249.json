base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 15, "attack_interval": 79, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122272, "race_id": 18, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 32482, "global_id": 6101, "ranged": true, "spawn_sec": 115}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "hp": 21000, "attack": 1200, "base_hp": 21000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 350.0, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118480, "race_id": 18, "change_to": 9, "change_condition": 2, "master_id": 31715, "global_id": 5334, "to_condition": 2, "to_global_id": 5335, "spawn_sec": 118}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10500, "attack": 800, "base_hp": 10500, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_range": 260, "attack_speed": 1, "attack_wait": 20, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118496, "race_id": 18, "missile_id": 351, "missile": {"speed": 10.0}, "master_id": 31716, "global_id": 5335, "ranged": true, "from_condition": 2}, {"enemy_id": 11, "source": "local", "count": 9, "form_count": 1, "hp": 6000, "attack": 200, "base_hp": 6000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2116704, "race_id": 18, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 31399, "global_id": 5018, "ranged": true, "spawn_sec": 124}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 28000, "attack": 800, "base_hp": 28000, "base_attack": 800, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_range": 300, "attack_speed": 1, "attack_wait": 40, "attack_interval": 181, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118560, "race_id": 18, "missile_id": 352, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 31735, "global_id": 5354, "ranged": true, "spawn_sec": 184}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー", "スカラベ"], "hp": 15000, "attack": 400, "base_hp": 15000, "base_attack": 400, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 1, "attack_wait": 1, "attack_interval": 49, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121632, "race_id": 18, "master_id": 32393, "global_id": 6012, "spawn_sec": 192}], "popups": ["進化した魔界アリの女王は、\nブロックされると強烈な近接攻撃を\n行います。ブロック中の攻撃は、\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "魔界アリの女王", "text": "市街に入ってしまえば、\n人間が虫に追いつけるはずもなし。", "face": "l62d4e0de131b"}, {"name": "魔界アリの女王", "text": "くふふ、さぁ、存分に養分を蓄えよ！\n妾の戦のために、街を食い荒らせ虫たちよ！", "face": "l62d4e0de131b"}, {"name": "リノ", "text": "王子、ちょっと虫が多すぎるよ！\n前に出たら集中砲火にあっちゃう！", "face": "u590"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "エレット", "text": "何か攻撃を引きつける手段があれば……。\nあ、あたしが最前線に出て注意を引けば――", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "――待たれよ、エレット嬢。\n副デーモンシェフ、この辺りには「アレ」があったな。", "face": "l30ffa9fac382"}, {"name": "副デーモンシェフ", "text": "はっ……まさかセレモニー用の「アレ」を……？", "face": "la93bcd2ecde7"}, {"name": "デーモンシェフ", "text": "ある意味では、これこそセレモニーだとも。\nデモシェフ商会が、王国と共闘する、\nその記念碑としてお披露目するに、相応しい威容だ。", "face": "l30ffa9fac382"}, {"name": "副デーモンシェフ", "text": "おぉ……承知しました！\n従業員たちよ、今こそ\n「特大デーモンのチョコ細工」お披露目の時ッ！！", "face": "la93bcd2ecde7"}, {"name": "エレット", "text": "なっ……な、なにこれぇ！？", "face": "u1152a1"}, {"name": "魔界アリの女王", "text": "なんだそのふざけたチョコレート像は！？", "face": "l62d4e0de131b"}, {"name": "オーガスタ", "text": "大きい……いえ、それだけじゃありません。\nこのサイズのチョコ細工だというのに、\n材料に一切ムラがない……！！", "face": "u1153a1"}, {"name": "デーモンシェフ", "text": "ふふ、これもまだ試作のうち。\nされど虫たちの注意を引くには十分！！", "face": "l30ffa9fac382"}, {"name": "エレット", "text": "ありがとう、デーモンシェフ……！\nこれなら長時間、\n虫の遠距離攻撃を引きつけられるかも！", "face": "u1152a1"}, {"name": "エレット", "text": "女王蜘蛛さんも、キホルちゃんも、\nこの街も、全部ぜんぶ取り戻すよー！！", "face": "u1152a1"}]}, {"trigger": "end", "lines": [{"name": "魔界アリの女王", "text": "ふざけるな……そんなチョコ細工ごときに、\nどうして妾が敗北しなければならぬ……！", "face": "l62d4e0de131b"}, {"name": "魔界アリの女王", "text": "覚えておけよ料理人ども……。\nそして王子よ……！！", "face": "l62d4e0de131b"}, {"name": "エレット", "text": "こらー！！　飛んで逃げるなんて卑怯だぞー！！", "face": "u1152a1"}, {"name": "女王蜘蛛", "text": "うっ……ここは……。\nもしや王国……？", "face": "l17147554e672"}, {"name": "キホル", "text": "うぅ……きもちわるい……。\nお腹の中があまったるい……。", "face": "u1159a1"}, {"name": "エレット", "text": "女王蜘蛛さん！　キホルちゃん！\n良かった、正気に戻ったんだね！", "face": "u1152a1"}, {"name": "女王蜘蛛", "text": "エレット……なるほど、王国軍が助けてくれたのね。\nまた世話をかけてしまったようですわね……。", "face": "l17147554e672"}, {"name": "キホル", "text": "…………。", "face": "u1159a1"}, {"name": "デーモンシェフ", "text": "キホル、どうして不貞腐れているのだ。\nまだ腹の中にフェロモンが残って――", "face": "l30ffa9fac382"}, {"name": "キホル", "text": "――めない。", "face": "u1159a1"}, {"name": "エレット", "text": "ん？　なになに？　どうしたの？", "face": "u1152a1"}, {"name": "キホル", "text": "認めないから！！\nこのキホルちゃんが、\n人間に助けられたなんて絶対認めないから～！！", "face": "u1159a1"}, {"name": "エレット", "text": "あはは……元気そうなら良かったかな？", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "困ったものだな……。\nこれはしばらく、物質界の実地体験が必要か。", "face": "l30ffa9fac382"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "デーモンシェフ", "text": "うむうむ。\nそういうわけでキホルよ、今日から\nお前はデモシェフ商会のアルバイトだ！", "face": "l30ffa9fac382"}, {"name": "キホル", "text": "はっ？　はぁ～！？\nどうして私が働かなきゃいけないの！？", "face": "u1159a1"}, {"name": "エレット", "text": "あっ、あたしも一緒にアルバイトしていい？\nお菓子作り、もうちょっと上手くなりたくて♪", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "おぉ、それは心強い！\nさぁキホルよ、宿舎完備、休日豊富、\nまかない食べ放題のデモシェフ商会へ来るが良い！", "face": "l30ffa9fac382"}, {"name": "キホル", "text": "くっ……どいつもこいつも！\nどうしてキホルちゃんの話を聞かないのよー！！", "face": "u1159a1"}, {"name": "エレット", "text": "――ふふっ、元気になってよかったぁ。\nそれじゃあ王子、\nあたしは街の人たちの救助に行ってくるね。", "face": "u1152a1"}, {"name": "エレット", "text": "あっ……そ、それから……えっと……。\nちょ、ちょこ……バレンタインのチョコ、\n楽しみに……しててねっ♪", "face": "u1152a1"}]}], "active": true}