{"quest_id": 4681, "name": "さまよえる落ち武者たち", "description": "徐々にせまる\n落ち武者の群れを討ち、\n魂を救済せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "第二次妖怪大戦", "event_category": "History", "mission_id": 920073, "map_no": 3728, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "level": 80, "form_count": 2, "tags": ["アンデッド"], "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 60, "attack_wait": 40, "attack_interval": 201, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099376, "change_to": 1, "change_condition": 3, "master_id": 143, "global_id": 142, "to_condition": 3, "to_global_id": 143, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 24, "attack_interval": 49, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099392, "special_effect_id": 222, "master_id": 144, "global_id": 143, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 1, "level": 80, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 15, "attack_speed": 60, "attack_wait": 40, "attack_interval": 201, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.850000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099408, "change_to": 3, "change_condition": 3, "master_id": 162, "global_id": 161, "to_condition": 3, "to_global_id": 162, "spawn_sec": 29}, {"enemy_id": 3, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_speed": 24, "attack_interval": 55, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.850000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099424, "special_effect_id": 222, "master_id": 163, "global_id": 162, "from_condition": 3}, {"enemy_id": 5, "source": "local", "count": 27, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 45}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 100}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 110}], "dialogue": [{"trigger": "start", "lines": [{"name": "イロハ", "text": "なんて、綺麗なのでしょう……。\nここがサクヤさんの、\n思い出の場所なのですね。", "face": "u242"}, {"name": "サクヤ", "text": "はい。\n春になれば、桜の雅が更にここを美しく彩ります。\nいつか、その美景を皆さんにも……。", "face": "u93"}, {"name": "サクヤ", "text": "（ヒバリ……かつて共に目にしたこの蒼天……。\n今もなお、私たちは同じ空を見ているのでしょうか。\n……あなたの身が、心配でなりません……）", "face": "u93"}, {"name": "イロハ", "text": "サクヤさん……？\nあの……どうしたのですか？", "face": "u242"}, {"name": "サクヤ", "text": "想いが口をついていたとは……お恥ずかしい。\n実は、私には妹がいるのです。\n少々おてんばですが、芯の強き侍にございます。", "face": "u93"}, {"name": "サクヤ", "text": "……彼女には、果たすべき使命があり、\n今はこうして私と行動を別にしていますが、\nその性分ゆえ無茶をしていないか心配で……。", "face": "u93"}, {"name": "イロハ", "text": "果たすべき使命？\nサクヤさんがそれほどまでに身を案じるとは、\nよほど危険な責務を負っているのですね……？", "face": "u242"}, {"name": "サクヤ", "text": "はい……。\n妹は、由緒ある「鬼切」という刀を受け継ぎ、\nそして同時に、鬼と戦う使命を背負ったのです。", "face": "u93"}, {"name": "落ち武者", "text": "……オオォォオオ……。\n……人間……にん、げぇぇん……オォォォオ……。\n我らと共にぃぃ……死んでくれぇぇぇ……。", "face": "l1ef8a634ba85"}, {"name": "サクヤ", "text": "――ッ！？\nあれは……死んだ武士達が物の怪の仕業で\n魔物へと変えられてしまった者たちの様ですね。", "face": "u93"}, {"name": "サイゾウ", "text": "つまりは、『アンデッド』と同じ魔物か……。\n死しても尚、闘わせようとするとは、許せぬ！", "face": "u237"}, {"name": "イロハ", "text": "サクヤさんの思い出の地を守る為にも、\nそして魔物化してしまった武士たちの魂の為にも、\n魔物を討ちましょう……皆さん！", "face": "u242"}]}, {"trigger": "end", "lines": [{"name": "落ち武者", "text": "か、感謝……いた、す……。\nこれで、我らも…………\n愛する……家族の、もと……へ……。", "face": "l1ef8a634ba85"}, {"name": "イロハ", "text": "討伐、完了しました……。\nですが、やり切れないですね……。", "face": "u242"}, {"name": "サクヤ", "text": "かつては平和だった地が、\nこのような惨事の温床となるとは……。", "face": "u93"}, {"name": "サクヤ", "text": "（ヒバリ……あなたもきっと\nこのような想いをしているのでしょうね……）", "face": "u93"}, {"name": "イロハ", "text": "サクヤさん……。", "face": "u242"}, {"name": "サクヤ", "text": "申し訳ありません。\n皆さんに、心配をかけてしまっていますね……。\nですが、大丈夫です。", "face": "u93"}, {"name": "サクヤ", "text": "私はひとりではありません。\n頼れる仲間と、信じるべき主君がいます。\nだから、私の心が迷うことはありません。", "face": "u93"}, {"name": "サクヤ", "text": "さあ、行きましょう。\n王子と共に、復活してしまった酒呑童子を倒し、\nこの地に安寧を取り戻しましょう！", "face": "u93"}]}], "active": true}