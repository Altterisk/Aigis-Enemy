{"quest_id": 7042, "name": "ディエーラの決意", "description": "スイレンたち、消えた花嫁を探すため囮を\n買って出たディエーラ。襲い来る不死者を\n蹴散らし、敵の企みをあぶり出せ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ジューンブライド・ミッドナイト", "event_category": "History", "mission_id": 920145, "map_no": 5555, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 21, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 28}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2122464, "special_effect_id": 233, "change_to": 3, "change_condition": 1, "master_id": 32506, "global_id": 6125, "variants": [{"tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160}], "spawn_sec": 35}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 44}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157, "spawn_sec": 139}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 200, "base_hp": 6000, "base_attack": 200, "damage_type": "magical", "armor_defense": 300, "magic_defense": 20, "attack_range": 160, "attack_speed": 50, "attack_wait": 30, "attack_interval": 127, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122592, "race_id": 2, "change_to": 7, "change_condition": 1, "missile_id": 227, "missile": {"speed": 4.0}, "master_id": 32515, "global_id": 6134, "ranged": true, "variants": [{"hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 50, "attack_wait": 40, "attack_interval": 187, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122576, "race_id": 2, "master_id": 32514, "global_id": 6133}], "spawn_sec": 139}], "dialogue": [{"trigger": "start", "lines": [{"name": "ヒューナ", "text": "……ディエーラ、足が震えてるわ。\n本当は怖いんでしょ？", "face": "u627"}, {"name": "ディエーラ", "text": "お、囮役が怖くないはずないです。\nでも私がさらわれれば、後は皆さんが必ず、\n花嫁役の子たちを助けてくれるわけですから。", "face": "u1010a1"}, {"name": "ディエーラ", "text": "そう思えば、皆さんを、王子を信じているからこそ、\n危ない橋だって渡れるというものです。", "face": "u1010a1"}, {"name": "ヒューナ", "text": "ふふ、商人らしい図太さね。\nそれじゃあ私達は隠れておくわ。\n名女優っぷりを期待しているわね。", "face": "u627"}, {"name": "ディエーラ", "text": "えぇ、お任せを。\nそれでは王子、後はお任せしますね。", "face": "u1010a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "フーリ", "text": "――王子様、予想的中みたいです。\n向こうからアンデッドらしき影が\n複数こちらへ向かってきています。", "face": "u174"}, {"name": "アンナ", "text": "それでは皆さん、計画どおりに。\n魔物を討伐しつつ、ディエーラさんが\nさらわれたら後を追跡しましょう。", "face": "ld25eb68c1dfc"}, {"name": "アンナ", "text": "王子、魔物の迎撃準備をお願いします！", "face": "ld25eb68c1dfc"}]}, {"trigger": "battle", "at_sec": 141, "lines": [{"name": "スイレン", "text": "…………。", "face": "u1013a1"}, {"name": "フーリ", "text": "あれは、スイレンさん！？\n心配したんですよ！　今までいったいどこに――", "face": "u174"}, {"name": "ヒューナ", "text": "待ってフーリ！\n様子がおかしいわ！", "face": "u627"}, {"name": "ラキュア", "text": "……操られているわけではなさそうだ。\nむしろ意識を奪われたことで、\n有り余るスイレンの力が暴走しているのだろう。", "face": "u344"}, {"name": "ヴィンセント", "text": "花嫁誘拐犯はヴァンパイアで確定だな。\nスイレンの強さを御しかねるとは、\n何とも情けない吸血鬼だ。", "face": "u103"}, {"name": "ヴィンセント", "text": "王子、上手く行けば囮を使わずとも、\n吸血鬼どもにアジトを吐かせられるかもしれない。\n急いで決着を付けるぞ。", "face": "u103"}]}, {"trigger": "end", "lines": [{"name": "スイレン", "text": "はぁ……はぁ……お、おう、じ……さま？\nここは……いったい……。", "face": "u1013a1"}, {"name": "ディエーラ", "text": "スイレンさん！\n良かった、意識が戻ったんですね！", "face": "u1010a1"}, {"name": "スイレン", "text": "ディエーラ……って、あっ、あぁ！！\n急いで宝石を外して、ディエーラ！\nこの事件の原因は――", "face": "u1013a1"}, {"name": "ディエーラ", "text": "ほ、宝石？　いったいなにを――", "face": "u1010a1"}, {"name": "ヒューナ", "text": "……何が起きてるの？\nスイレンとディエーラの\n装飾品が赤く光ってるけど！？", "face": "u627"}, {"name": "スイレン", "text": "この宝石が――みんな――逃げ――", "face": "u1013a1"}, {"name": "フーリ", "text": "きゃぁっ！？　――あ、あれ？\nスイレンさんとディエーラさんは！？", "face": "u174"}, {"name": "ヴィンセント", "text": "消え……たのか……？", "face": "u103"}, {"name": "アンナ", "text": "そんな、これでは追跡もすることが……。", "face": "ld8d0aca843ae"}, {"name": "エマ", "text": "…………姫、もしやこれは。", "face": "u582"}, {"name": "シルヴィア", "text": "えぇ、血でできた宝石、\nこの匂い、人をさらう手口……。\n私の記憶が間違っていないのなら――", "face": "u442"}, {"name": "アンナ", "text": "おふたりは、何かご存知なのですか？", "face": "ld25eb68c1dfc"}, {"name": "エマ", "text": "……お話は、移動しながらにいたしましょう。\n幸いにして、こちらには心当たりがあります。", "face": "u582"}, {"name": "シルヴィア", "text": "これ程の濃い血の香りであれば、\n追跡も容易なものですわ。\n今は一刻を争うのでしょう？", "face": "u442"}]}], "active": true}