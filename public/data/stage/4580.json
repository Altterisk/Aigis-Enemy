1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 11, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 123}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 10, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 13, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 125}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 12, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン", "text": "ギャギャッ！\n戦車！　戦車！\nシンピン！　シンピン！", "face": "l6c227aea162d"}, {"name": "ゴブリン博士", "text": "おい、私の芸術作品に汚い手で触るナ！\nゴブリンクイーン様ヘ、お披露目する迄に、\nまだまだ調整しなくてはいけないのだかラ！", "face": "ld52b4f1f4768"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、報告によれば、この場所でゴブリン達の\n活動が活発になっているという事ですが……。", "face": "l15bcf247e4c0"}, {"name": "ゴブリン", "text": "ギャギャギャッ！　\nニンゲン！", "face": "l6c227aea162d"}, {"name": "ゴブリン博士", "text": "人間だト！？\nゴブリンクイーン様が魔界に行っておられる時に、\nなんてことダ。", "face": "ld52b4f1f4768"}, {"name": "ゴブリン", "text": "（……じーっ）", "face": "l6c227aea162d"}, {"name": "ゴブリン博士", "text": "これはまだ未完成品ダ……。\nクイーン様用の輿もまだ出来ていないし、\nクイーン様に乗って頂かなくては、本来の力が……。", "face": "ld52b4f1f4768"}, {"name": "ゴブリン博士", "text": "……いやまてよ。\nこの騎獣の破壊力ならば、人間など粉々ダ。\n多少の傷ならばクイーン様にバレる事もないだろウ。", "face": "ld52b4f1f4768"}, {"name": "兵士", "text": "報告！　\nゴブリン達の姿を確認――せ、戦車！？\n敵は最新型の騎獣戦車を有しているようです！", "face": "l6240fb82ec01"}, {"name": "アンナ", "text": "こんな狭い洞窟で戦車！？\n王子、慎重なご采配をお願い致します！", "face": "l15bcf247e4c0"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "そんな……クイーン様の専用御車が……。\nなんと報告すれバ…。\n……くぅぅッ……うっ、うぅ……。", "face": "ld52b4f1f4768"}, {"name": "アンナ", "text": "ゴブリン達が退却していきます。\n戦車も破壊しましたし、\n追撃の必要はなさそうですね。", "face": "l15bcf247e4c0"}, {"name": "グスタフ", "text": "それにしても、さっきの面を被ったゴブリンは\n一体何者なんじゃ？　長い事ゴブリン達を\n見てきているが、あれは初めて見るな。", "face": "u153"}, {"name": "ケイティ", "text": "風貌からしてゴブリン達の武器を作っている\n博士のような感じでしたね。ゴブリンは高度な\n技術は持ち合わせていないはずですが……。", "face": "u114"}, {"name": "グスタフ", "text": "ふむ。もし、そのゴブリンが例の戦車を\n作ったのだとしたらやっかいじゃな。\nまた新種の兵器を製造するかもしれん。", "face": "u153"}, {"name": "ケイティ", "text": "今後もゴブリンの動向に注意していきましょう。\n数で勝るゴブリン達が最新鋭の武具を作れる\nとなれば、手強い敵になるのは明らかです。", "face": "u114"}, {"name": "アンナ", "text": "王子、我が軍も今後に備えて、\n準備をしておいた方がいいですね。\nでは、一度戻りましょう。", "face": "l15bcf247e4c0"}]}], "active": true}