1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 21139, "global_id": 1433, "ranged": true, "spawn_sec": 41}, {"enemy_id": 5, "source": "local", "count": 17, "form_index": 0, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 71}, {"enemy_id": 6, "source": "local", "count": 21, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 1, "attack_wait": 45, "attack_interval": 162, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 2.200000047683716, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124064, "master_id": 32715, "global_id": 6333, "spawn_sec": 110}, {"enemy_id": 7, "source": "local", "count": 13, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 20, "base_hp": 1500, "base_attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 35, "attack_speed": 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 633, "global_id": 632, "ranged": true, "spawn_sec": 114}, {"enemy_id": 8, "source": "local", "count": 18, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31059, "global_id": 4678, "ranged": true, "spawn_sec": 127}, {"enemy_id": 9, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 400, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102160, "master_id": 21142, "global_id": 1436, "spawn_sec": 155}, {"enemy_id": 10, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 190}], "popups": ["味方の帝国兵は倒されると\n★の評価に影響します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "イルヴィ", "text": "――この先だ。\n冥界第二層で、私の部族は匿ってもらっている。", "face": "u1918a1"}, {"name": "レオナ", "text": "匿って……？\nいったいどういうことだ。\nまさか冥界の勢力同士で内乱でも起きたのか？", "face": "u311"}, {"name": "イルヴィ", "text": "……そう、だな。\nこれは内乱と言っていいのかもしれない。\nこちらからすれば騙し討ちに等しいが。", "face": "u1918a1"}, {"name": "イルヴィ", "text": "ハイドース様は今、ある儀式を進めている。\nそれゆえに、冥界の勢力はそれぞれが、\n戦力を整えているところだった。", "face": "u1918a1"}, {"name": "イルヴィ", "text": "だが、ハイドース様が動けぬその隙をつき、\n奴が現れ、私の家族たちを虐殺し始めたんだ。", "face": "u1918a1"}, {"name": "ティルト", "text": "三代目、白の皇帝――骸帝か。\nそれでお前たちは、この封鎖階層に逃げ込んだんだな。", "face": "u1705a1"}, {"name": "ディアナ", "text": "封鎖階層？\n冥界にも、天界のオリュンポスのように、\n複数の階層があるということですか？", "face": "u624"}, {"name": "ヘカティエ", "text": "……私から説明しましょうか。\n念のために言っておくのなら、\n世界の実験場たるオリュンポスとは別物よ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "冥界第二層、通称ヘルヘイムは、\n天界を追放された亜神、ヘリューズのために、\nわずかな領域を割譲したものなのよ。", "face": "u1226a1"}, {"name": "ハリンヘイム", "text": "ヘリューズって、\nあの昔話の、反逆者ヘリューズですか！？", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "遥かな未来、アスガルドに災禍をもたらすと予言され、\n冷たき世界へと追放されたという、\n…………亜神イコルの、妹。", "face": "u1854a1"}, {"name": "ヘカティエ", "text": "……あなたのイコル嫌いは筋金入りね。\nでも、正確にはその伝承は間違い。\n彼女は追放されたのではなく、自ら追放を選んだのよ。", "face": "u1226a1"}, {"name": "ティルト", "text": "それは、どういう――", "face": "u1705a1"}, {"name": "？？？", "text": "――話はそこまでですの！\nあっちから逃げてくるの、我が軍の斥候ですの！！", "face": "u1922a1"}, {"name": "斥候兵", "text": "へ、陛下ッ！\nあいつは、化け物です……！", "face": "u287"}, {"name": "レオナ", "text": "何があった！\n――骸帝と、遭遇したのか？", "face": "u311"}, {"name": "斥候兵", "text": "いえ、あれは……あれは王でも、剣士でもなく……。\n魔女……いえ、もっとおぞましい何か……。", "face": "u287"}, {"name": "イルヴィ", "text": "魔女……？\nまさか、ヘリューズ様が……？\nいや、でも私が出発するときにはまだ正気を保って……。", "face": "u1918a1"}, {"name": "レオナ", "text": "…………心当たりがありそうだが、\nその話はあとで、徹底的に詳しく教えてもらおうか。", "face": "u311"}, {"name": "白の皇帝", "text": "……全軍、戦闘準備。\nアンデッドを蹴散らし、この先へ向かう。", "face": "u418"}, {"name": "レオナ", "text": "――はっ！！\n斥候は下がれ。その傷では戦えないだろう。", "face": "u311"}, {"name": "アウローラ", "text": "負傷兵はこちらへ。\nみなさん、彼らの護衛もお願いします。", "face": "u711"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "いやーな臭いがしますの。\n腐って、停滞しきって、澱んだ臭いが……。", "face": "u1922a1"}, {"name": "ジェニー", "text": "パラベルは鼻がいい。\nさっきの斥候たちを見れば分かるよ。\nこの先に待っているのは、人が遭遇しちゃいけない何かだ。", "face": "u1923a1"}, {"name": "ヘカティエ", "text": "この先に待っているのがヘリューズだとして、\n彼女がダークエルフたちを守るために、\n戦うことを選んだなら……そうね、こうなるはずよ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "アスガルドに災禍をもたらすという予言。\nそれは、彼女という存在が、\nあまりに死に近すぎるために生じたもの。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "生命が死んでいく様を余さず感じ取ってしまうから、\n彼女はその嘆きから目を背けるために、\n自らひとりぼっちになることを選んだのよ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "そんな彼女が、死の蔓延する戦場に飛び込めば、\nきっと正気を保ってはいられないでしょうね。", "face": "u1226a1"}, {"name": "イルヴィ", "text": "……そんな。\n私たちのために、あの人が、そこまで。", "face": "u1918a1"}, {"name": "ティルト", "text": "なぜそこまでして、ダークエルフを匿ったのでしょう。\nひとりでいたいなら、そんなことをする必要は……。", "face": "u1705a1"}, {"name": "ヘカティエ", "text": "魔界の同族とも、物質界の同族とも相容れない、\nセグナンドたちの部族に、\n何か思うところがあったんじゃないかしら？", "face": "u1226a1"}, {"name": "ハリナ", "text": "先を急ぐとしよう。\nそんな頭の悪いお人好し、\n長く苦しませるのは酷だろう？", "face": "u988"}]}], "hard": {"level": 140, "multiplier": 1.4, "modifiers": [{"kind": "term", "influence": 18, "params": [140]}, {"kind": "term", "influence": 20, "params": [140]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 11200, "attack": 1260, "damage_type": "physical", "armor_defense": 400, "pattern_id": 2102160}, {"enemy_id": 2, "form_index": 0, "hp": 3920, "attack": 1050, "damage_type": "physical", "armor_defense": 280, "pattern_id": 2102064}, {"enemy_id": 3, "form_index": 0, "hp": 1400, "attack": 420, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2098672}, {"enemy_id": 4, "form_index": 0, "hp": 6300, "attack": 600, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2098656}, {"enemy_id": 5, "form_index": 0, "hp": 728, "attack": 14, "damage_type": "physical", "armor_defense": 7, "pattern_id": 2099152}, {"enemy_id": 6, "form_index": 0, "hp": 14000, "attack": 840, "damage_type": "physical", "armor_defense": 600, "pattern_id": 2124064}, {"enemy_id": 7, "form_index": 0, "hp": 2100, "attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "pattern_id": 2105344}, {"enemy_id": 8, "form_index": 0, "hp": 21000, "attack": 250, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2114784}, {"enemy_id": 9, "form_index": 0, "hp": 16800, "attack": 2100, "damage_type": "physical", "armor_defense": 400, "pattern_id": 2102160}, {"enemy_id": 10, "form_index": 0, "hp": 4200, "attack": 840, "damage_type": "physical", "armor_defense": 220, "pattern_id": 2098688}]}, "active": true}