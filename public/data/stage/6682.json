{"quest_id": 6682, "name": "竜人たちの奇襲", "description": "東の国での騒乱の最中、地下に潜む竜人の\n軍勢が地上へと侵攻を開始した。更に、\n竜人たちは天狗の羽を手にしていて……？\n上級（★１獲得の目安：平均Lv10）", "event": "鬼神大嶽丸と黒紅の翼", "event_category": "History", "mission_id": 920121, "map_no": 3212, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117152, "race_id": 2, "change_to": 1, "change_condition": 1, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31487, "global_id": 5106, "ranged": true, "variants": [{"hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117168, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31488, "global_id": 5107, "ranged": true}], "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 32, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098576, "race_id": 2, "master_id": 147, "global_id": 146, "spawn_sec": 12}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098640, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 151, "global_id": 150, "ranged": true, "spawn_sec": 52}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 2800, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 60}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 7500, "attack": 650, "base_hp": 7500, "base_attack": 650, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117120, "race_id": 2, "change_to": 6, "change_condition": 1, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31485, "global_id": 5104, "ranged": true, "variants": [{"hp": 7500, "attack": 650, "base_hp": 7500, "base_attack": 650, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117136, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31486, "global_id": 5105, "ranged": true}], "spawn_sec": 65}, {"enemy_id": 8, "source": "local", "count": 8, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098512, "race_id": 2, "master_id": 112, "global_id": 111, "spawn_sec": 78}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――忍びの方の報告どおり、\n竜人達が行軍しているようですね。", "face": "lfe3fe8d5cb21"}, {"name": "ソーマ", "text": "こんなに大勢、\nいったい何処に向かっているんでしょうか……？", "face": "u23"}, {"name": "ケイティ", "text": "報告によれば、竜人達まで\n姿を惑わす術を使っていたとのことです。\n竜人が鬼の策略に乗った可能性もありますね……。", "face": "u114"}, {"name": "クローディア", "text": "何にせよ、このまま竜人族の侵攻を\n見過ごすわけにはいきませんね。", "face": "u163"}, {"name": "鬼刃姫", "text": "そうだね。竜人族の好き勝手にさせちゃ、\nどれだけの被害が出るかわからないもんね。\n王子、ここで竜人達を迎撃しよう！", "face": "u435"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "竜人戦士", "text": "ククク……。\n異国の鬼とやらから面妖な術を得た今こそ、\n我らが覇を示す時ダッ！！", "face": "u95"}, {"name": "竜人戦士", "text": "異国ノ連中と協力などする気はなかったガ、\n今回に限っては感謝せねばならんカ。\nだが地上を蹂躙した暁には、鬼の連中も――", "face": "u95"}, {"name": "クローディア", "text": "そこまでです！\nその企み、ここで私達が止めさせてもらいます！", "face": "u163"}, {"name": "竜人戦士", "text": "ムゥッ！？\n人間ドモめ、もう嗅ぎつけてきたノカ！\nだがモハヤ手遅れダ！！", "face": "u95"}, {"name": "竜人戦士", "text": "我らは異国の鬼ドモヨリ、\n姿を惑わす秘術を宿した羽を得たノダ！\n人間の攻撃など、当たらねば脅威ではないゾ！", "face": "u95"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "クローディア", "text": "王子、竜人の魔術師が使っているのは、\nやはり天狗の神通力のようです。\n足止めしてしまえば遠距離攻撃も可能なはずです！", "face": "u163"}, {"name": "アンナ", "text": "天狗の方々の羽を取り戻すためにも、\nここで竜人族の企みを挫きましょう！", "face": "lfe3fe8d5cb21"}]}, {"trigger": "end", "lines": [{"name": "竜人戦士", "text": "グゥッ！　撤退！　撤退ダッ！！", "face": "u95"}, {"name": "クローディア", "text": "竜人達が撤退していきます。\nなんとか天狗の羽も取り戻せましたね。", "face": "u163"}, {"name": "アンナ", "text": "しかし、なぜ鬼達は竜人に\n天狗の羽を与えたのでしょうか……。", "face": "lfe3fe8d5cb21"}, {"name": "鬼刃姫", "text": "……たぶん、時間稼ぎかな。\nあても詳しくは知らないけど、大嶽丸の封印解除には、\n大掛かりな儀式が必要らしいから。", "face": "u435"}, {"name": "クローディア", "text": "竜人達に暴れさせ、\n私達の目を逸らすつもりだったということですね。\nでも、だからといって竜人を無視するわけにも……。", "face": "u163"}, {"name": "鬼刃姫", "text": "うん、だから王子は全軍じゃなくて、\n一部の精鋭だけでここまで来たんだよね？", "face": "u435"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "鬼刃姫", "text": "それに王国の忍者や、天狗の皆が捜索しているから、\n鬼達の居場所が見つかるのは時間の問題だと思うよ。\n鬼刃衆にも協力するように言っておいたしね。", "face": "u435"}, {"name": "アザミ", "text": "――然り。\n王子、鬼共の居場所を見つけました。", "face": "u160"}, {"name": "アンナ", "text": "アザミさん！　本当ですか！？", "face": "lfe3fe8d5cb21"}, {"name": "アザミ", "text": "はい。\n……しかし事態は急を要します。\nどうやら儀式完遂まで、あまり時が無いようです。", "face": "u160"}, {"name": "アンナ", "text": "わかりました。\n王子、急ぎ準備を整え、出立しましょう！", "face": "lfe3fe8d5cb21"}]}], "active": true}