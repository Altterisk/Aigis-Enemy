{"quest_id": 6447, "name": "邪仙参謀の策", "description": "都を襲う邪仙の企み。\n迫り来る邪仙達を退け、\n敵の手に落ちた都を救い出せ！\n神級（★１獲得の目安：平均Lv50）", "event": "龍穴の風水士", "event_category": "History", "mission_id": 920108, "map_no": 5334, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 900, "attack_speed": 1, "attack_wait": 120, "attack_interval": 821, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114576, "special_effect_id": 280, "missile_id": 274, "master_id": 31036, "global_id": 4655, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 10, "attack_range": 150, "attack_speed": 1, "attack_wait": 15, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114560, "special_effect_id": 232, "missile_id": 89, "master_id": 30991, "global_id": 4610, "ranged": true, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 25000, "attack": 2100, "base_hp": 25000, "base_attack": 2100, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 10, "attack_range": 150, "attack_speed": 1, "attack_wait": 200, "attack_interval": 501, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114544, "missile_id": 275, "missile": {"speed": 7.0}, "master_id": 30990, "global_id": 4609, "ranged": true, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105120, "race_id": 14, "change_to": 4, "change_condition": 5, "master_id": 602, "global_id": 601, "to_condition": 5, "to_global_id": 602, "spawn_sec": 13}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105136, "race_id": 14, "master_id": 603, "global_id": 602, "from_condition": 5}, {"enemy_id": 6, "source": "local", "count": 7, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112816, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30725, "global_id": 4344, "ranged": true, "spawn_sec": 57}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 7000, "attack": 650, "base_hp": 7000, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114512, "race_id": 14, "change_to": 7, "change_condition": 3, "master_id": 31002, "global_id": 4621, "spawn_sec": 89}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112832, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30726, "global_id": 4345, "ranged": true, "spawn_sec": 96}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 2, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105152, "race_id": 14, "change_to": 10, "change_condition": 5, "master_id": 604, "global_id": 603, "to_condition": 5, "to_global_id": 604, "spawn_sec": 137}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "master_id": 605, "global_id": 604, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "イロハ", "text": "はぁっ、はぁっ……。\nシズカ様、余りご無理をされては……。", "face": "u242"}, {"name": "シズカ", "text": "……これしきの傷、まだ平気よ。\nそれよりイロハ、貴方は？", "face": "u101"}, {"name": "イロハ", "text": "は、はい……私もなんとか、大丈夫です。", "face": "u242"}, {"name": "淵天君", "text": "クックック……滑稽ですネェ。\n本陣は既に落ちたというのに、\n未だ無意味な抵抗を続けるとは。", "face": "lf2dd1c5fb101"}, {"name": "コジュウロウ", "text": "――シズカ様、お待たせし申した。\n女子供やご老人の避難が完了したでござる。", "face": "u102"}, {"name": "シズカ", "text": "ありがとう、コジュウロウ。\nこれで後顧の憂いはないわ。", "face": "u101"}, {"name": "頂天君", "text": "フハハハハ！　笑止ッ！\nたかが数人の兵になにができる？　なァ兄者！", "face": "l29c80f49b45e"}, {"name": "超天君", "text": "おうとも、弟よ！\n各地の防衛に戦力を割き過ぎたせいで、\n肝心の都を守りきれぬとは、馬鹿な奴らだなァ！", "face": "l467163d62f3f"}, {"name": "淵天君", "text": "ま、それも計算通りですが、解せませんネェ。\n各地の民を見捨てて都の守りに専念していれば、\nもう少し長生きできたでしょうに。", "face": "lf2dd1c5fb101"}, {"name": "シズカ", "text": "……国を守ると私は決めた。\nそして、侍は約束を必ず守るの。", "face": "u101"}, {"name": "コジュウロウ", "text": "シズカ様……拙者も最後までお供しますぞ！", "face": "u102"}, {"name": "アンナ", "text": "――待ってください！\nそんな傷だらけの状態で戦えるのですか！？", "face": "l53980a73cb6a"}, {"name": "シズカ", "text": "アンナさん！　それに他の皆も！\n助けに来てくれたのね……！", "face": "u101"}, {"name": "淵天君", "text": "ぐぬぬぬ……こうも早く来るとは計算外ですねェ。\nですが、これ以上私たちの邪魔はさせませんよォ！", "face": "lf2dd1c5fb101"}, {"name": "淵天君", "text": "超頂兄弟、私の『棺氷陣』での攻撃が途切れぬよう、\n周囲を巡回し、敵の攻撃から私を守るのですねェ！\nなぁに、言う通りにしていれば全てうまくいきますヨ！", "face": "lf2dd1c5fb101"}]}, {"trigger": "end", "lines": [{"name": "超天君", "text": "――ガハァアアアアッ！！\nわ……我が『地烈陣』がぁあああああッ！！", "face": "l467163d62f3f"}, {"name": "頂天君", "text": "あ……ァ兄者ァアアアアアアアッ！！！！\nおのれぇえッ、淵天君ッ！　\n何が『言う通りにしていれば全てうまくいく』だ！", "face": "l29c80f49b45e"}, {"name": "淵天君", "text": "ヒィイッ！　こ、こんなはずでは……。", "face": "lf2dd1c5fb101"}, {"name": "太公望", "text": "万策尽きた、というご様子ですね。\nそれとも、まだ秘策が残っておいでですか？", "face": "u603"}, {"name": "淵天君", "text": "ぐぬぬぬぬぬ……て、撤退ですねェ！\n都の中枢は依然我ら邪仙郷の支配下、\nあの三人ならそう簡単には奪い返されませんヨォ！", "face": "lf2dd1c5fb101"}, {"name": "シズカ", "text": "……ふぅ、助かったわ。\nありがとう……王子、みんな。", "face": "u101"}, {"name": "シズカ", "text": "……でも、まだ終わりじゃないわ。\n邪仙たちの急襲を受けた時、民を避難させるために\nやむなく都の中枢までもヤツらに明け渡してしまったの。", "face": "u101"}, {"name": "イロハ", "text": "敵に奪われた御城の前では、十天君でも上位の\n実力者たちが防衛にあたっていると思われます。\nなんとしても奪還しなくては…………つぅッ！", "face": "u242"}, {"name": "アンナ", "text": "……ご無理をなさらないでください。\n皆さんは都の防衛で疲弊していらっしゃいます。", "face": "l79be9443abef"}, {"name": "シズカ", "text": "……わかったわ。\nなら、奪還は貴方たちにお願いするわね。\n頼んだわよ、王子。", "face": "u101"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "コジュウロウ", "text": "っと、思い出したでござる。\n殿、これは邪仙たちが持っていた物でござるが……。", "face": "u102"}, {"name": "メイファ", "text": "ふぇっ！？　\nそれは――風水尺！\nどうしてそれを……？", "face": "u618"}, {"name": "コジュウロウ", "text": "なに、王子殿が渡来の珍しい物差しを\n集めていると風の噂で聞きましてな。\n世の中は助け合いでござる。", "face": "u102"}, {"name": "メイファ", "text": "（すごい……命がけの戦いの中でも\n誰かのためになることを考えられるなんて。\nわたしなんか、与えてもらってばっかりなのに……）", "face": "u618"}, {"name": "メイファ", "text": "（わたしももっと、皆さんのお役に立たなくちゃ……！）", "face": "u618"}, {"name": "アンナ", "text": "王子、ここからが正念場です。\n城壁の中にいるという十天君の三人を倒し、\n占領された都を奪還いたしましょう。", "face": "l53980a73cb6a"}]}], "active": true}