{"quest_id": 7084, "name": "敬虔なる槍騎士", "description": "信仰の名の下に非道を尽くす神聖騎士団。\n槍騎士コルムと協力し\n神聖騎士団の凶行を阻止せよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ27(2020)", "event_category": "Reproduce", "mission_id": 300277, "map_no": 4027, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 2, "tags": ["置物"], "fixture": true, "hp": 10, "attack": 140, "base_hp": 10, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "change_to": 1, "master_id": 32658, "global_id": 6276, "to_global_id": 6277, "route_behaviour": {"transforms": [{"wait": 150}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物"], "fixture": true, "hp": 10, "attack": 140, "base_hp": 10, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "special_effect_id": 245, "master_id": 32659, "global_id": 6277}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 70, "attack_wait": 10, "attack_interval": 167, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123552, "special_effect_id": 510, "change_to": 3, "master_id": 32657, "global_id": 6275, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 29, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 38}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 2500, "attack": 280, "base_hp": 2500, "base_attack": 280, "damage_type": "physical", "armor_defense": 700, "attack_range": 150, "attack_speed": 1, "attack_wait": 60, "attack_interval": 186, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123488, "special_effect_id": 510, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 32645, "global_id": 6263, "ranged": true, "spawn_sec": 45}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 53}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 62}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 70, "attack_wait": 10, "attack_interval": 167, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2122400, "special_effect_id": 510, "master_id": 32496, "global_id": 6115, "spawn_sec": 91}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 95}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 126}], "popups": ["白い鎧の神聖騎士は、\n戦場にいる神聖騎士の総数に応じて\n攻撃力と防御力がアップします。"], "dialogue": [{"trigger": "battle", "at_sec": 5, "lines": [{"name": "神聖騎士団員", "text": "――穢れし魔王の配下を、この鉄槌にて清めん。", "face": "lbb53008e666d"}, {"name": "ゴブリン", "text": "ギャギャー！？", "face": "ldd218878cfc1"}, {"name": "神聖騎士団員", "text": "我らの道行きを遮るとは、\nやはりゴブリンに、信仰は分からないということか。", "face": "lbb53008e666d"}, {"name": "ゴブリン", "text": "ギャギャ！　ココ！　ナワバリ！\nハイッテクル！　ダメ！　カエレ！", "face": "ldd218878cfc1"}, {"name": "神聖騎士団員", "text": "有象無象が……。\nコルムめ、面倒な場所に逃げ込んだものだ。", "face": "lbb53008e666d"}, {"name": "コルム", "text": "おかげで、ちょっとだけ時間が稼げましたけどね……。", "face": "u1032a1"}, {"name": "神聖騎士団員", "text": "ふふ、だがもう後がないようだ。\nさぁコルムよ、神聖なる儀式を受け入れよ。\n肉体を捨て、魂を鎧に宿すのだ。", "face": "lbb53008e666d"}, {"name": "コルム", "text": "お断りです……！！\nそんなものは信仰ではありません！\n下僕にされていることに気付かないんですか！？", "face": "u1032a1"}, {"name": "神聖騎士団員", "text": "穢れた思想に染まるとは、\nかつての敬虔さはどこへ行ってしまったのか……。\nさぁ、コルムよ、今こそ――", "face": "lbb53008e666d"}, {"name": "フィナン", "text": "そこまでです！\nコルムちゃん、今助けますよ！", "face": "u1003a1"}, {"name": "アンナ", "text": "彼女がフィナンさんのご友人のようですね。\n向こうにいるのは、神聖騎士団ですか。", "face": "l839d9d7ea579"}, {"name": "コルム", "text": "フィナン……？\nそれにあの軍は、もしかして王国の……？", "face": "u1032a1"}, {"name": "神聖騎士団員", "text": "王国軍か……。\nまぁ良い、我らが信仰を受け入れぬのなら、\nまとめて浄化してやるより他にはあるまい。", "face": "lbb53008e666d"}, {"name": "神聖騎士団員", "text": "必殺の陣形をとれ。\n敵は魔王を討った王国軍だ。油断をするな！", "face": "lbb53008e666d"}, {"name": "コルム", "text": "王子殿下、私も戦えます。\n王国軍に動きを合わせますので、\n奥義が必要な時にはご指示をお願いします！", "face": "u1032a1"}]}, {"trigger": "end", "lines": [{"name": "フィナン", "text": "コルムちゃぁぁぁあんっ！\n無事ですか？　怪我してないですか？", "face": "u1003a1"}, {"name": "コルム", "text": "大丈夫です、フィナン。\n王子殿下、助けていただいてありがとうございました。", "face": "u1032a1"}, {"name": "フィナン", "text": "王子さま、この子はコルムちゃんです。\n私と同じ騎士修道会にいて、\n姉妹同然の仲良しさんだったんですよ？", "face": "u1003a1"}, {"name": "コルム", "text": "わっ……だ、抱きつかないでくださいっ！\n王子殿下が見ていますよ！？", "face": "u1032a1"}, {"name": "アンナ", "text": "ふふっ、ご友人が無事で何よりです。\n――それにしても、神聖騎士団の動きが不気味ですね。"}, {"name": "トゥアン", "text": "先日、偽りの天界の門に飲まれたと思えば、\n今日はこうして物質界で活動している、と……。\n……連中、天界の何者かに操られているのか？", "face": "u1006a1"}, {"name": "ソラス", "text": "否定できませんね……。\n天界との戦いに介入してくる可能性もあります。", "face": "u904"}, {"name": "ソラス", "text": "王子君、神聖騎士団には\n今後も警戒しておかなければなりませんね。", "face": "u904"}]}], "active": true}