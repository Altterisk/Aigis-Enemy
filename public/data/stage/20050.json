{"quest_id": 20050, "name": "竜の太守、決闘の果てに", "description": "国の行く末を背負う覚悟を示すため、 \n猛威を振るう太守との決闘を制せよ！\n＜悪天候：強風が発生＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["悪天候：強風が発生"], "event": "破滅のリヴァイアサン", "event_category": "Emergency", "mission_id": 200592, "map_no": 7526, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 220, "gold": 900, "drops": [{"card": 15, "c": 1}, {"card": 361, "c": 1}, {"card": 150, "c": 1}], "capacity": 8, "start_cost": 10, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 10, "attack_interval": 88, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2174000, "race_id": 2, "change_to": 1, "change_condition": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 41249, "to_condition": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "attack_range": 100, "attack_speed": 1, "attack_wait": 80, "attack_interval": 216, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2174016, "race_id": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 41250, "ranged": true, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 250, "base_hp": 2000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 30692, "global_id": 4311, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 10, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_range": 180, "attack_speed": 1, "attack_wait": 90, "attack_interval": 221, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132944, "race_id": 2, "change_to": 4, "missile_id": 667, "missile": {"speed": 6.0}, "master_id": 34564, "global_id": 8181, "ranged": true, "to_condition": 0, "to_global_id": 8180, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 90, "attack_interval": 222, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132944, "race_id": 2, "change_to": 3, "master_id": 34563, "global_id": 8180, "from_condition": 0}, {"enemy_id": 6, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 200000, "base_hp": 200000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 15, "attack_speed": 1, "attack_wait": 3, "attack_interval": 20, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2174352, "special_effect_id": 2136, "change_to": 6, "master_id": 41266, "to_condition": 0, "route_behaviour": {"transforms": [{"wait": 50}]}, "spawn_sec": 16}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 200000, "base_hp": 200000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 15, "attack_speed": 1, "attack_wait": 3, "attack_interval": 48, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2174336, "special_effect_id": 2578, "master_id": 41265, "from_condition": 0}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 30000, "attack": 8000, "base_hp": 30000, "base_attack": 8000, "damage_type": "magical", "armor_defense": 600, "magic_defense": 80, "attack_range": 400, "attack_speed": 1, "attack_wait": 160, "attack_interval": 411, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174400, "race_id": 2, "change_to": 8, "change_condition": 2, "missile_id": 1753, "missile": {"speed": 5.0}, "master_id": 41272, "ranged": true, "to_condition": 2, "spawn_sec": 23}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 35000, "attack": 1500, "base_hp": 35000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 900, "magic_defense": 80, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174416, "race_id": 2, "master_id": 41273, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100256, "race_id": 2, "change_to": 10, "change_condition": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 41263, "ranged": true, "to_condition": 2, "spawn_sec": 101}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 200, "base_hp": 6000, "base_attack": 200, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100272, "race_id": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 41264, "ranged": true, "from_condition": 2}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 6000, "attack": 110, "base_hp": 6000, "base_attack": 110, "damage_type": "magical", "armor_defense": 200, "magic_defense": 70, "attack_range": 180, "attack_speed": 60, "attack_wait": 50, "attack_interval": 243, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100896, "race_id": 2, "special_effect_id": 228, "change_to": 12, "change_condition": 2, "missile_id": 201, "missile": {"speed": 2.0}, "master_id": 287, "global_id": 286, "ranged": true, "to_condition": 2, "to_global_id": 287, "spawn_sec": 117}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 13000, "attack": 110, "base_hp": 13000, "base_attack": 110, "damage_type": "magical", "armor_defense": 300, "magic_defense": 70, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 203, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100912, "race_id": 2, "special_effect_id": 228, "missile_id": 202, "missile": {"speed": 2.0}, "master_id": 288, "global_id": 287, "ranged": true, "from_condition": 2}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100864, "race_id": 2, "change_to": 14, "change_condition": 2, "missile_id": 33, "missile": {"speed": 5.0}, "master_id": 41261, "ranged": true, "to_condition": 2, "spawn_sec": 121}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 7500, "attack": 300, "base_hp": 7500, "base_attack": 300, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100880, "race_id": 2, "missile_id": 34, "missile": {"speed": 5.0}, "master_id": 41262, "ranged": true, "from_condition": 2}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物"], "fixture": true, "uncounted": true, "hp": 80000, "attack": 850, "base_hp": 80000, "base_attack": 850, "damage_type": "physical", "armor_defense": 900, "magic_defense": 80, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2174432, "race_id": 2, "master_id": 41274, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_StandMotion\");"}, "spawn_sec": 156}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンウェン", "text": "わらわは逃げぬ。\n太守よ、わらわは……この戦を止めるために来た！", "face": "u2934a1"}, {"name": "アングハラド", "text": "敵の王子を連れてか。\n随分と物騒な里帰りではないか。", "face": "lc12185578db6"}, {"name": "アンウェン", "text": "王子を敵に回したのは竜ノ国の方だろう！\n王子の話も、わらわの話も聞かずに！\nトラハイアとて戦に賛成したわけではあるまい！", "face": "u2934a1"}, {"name": "アングハラド", "text": "わめいたところで、天竜核の力は戻らぬ。\nいずれ訪れる未来であったが、\nそれが今やってきただけのこと。", "face": "lc12185578db6"}, {"name": "アングハラド", "text": "地に落ちた我らを、他の種族が見逃すと思うか？", "face": "lc12185578db6"}, {"name": "アンウェン", "text": "天竜核のことは、原因がわかったかもしれぬのだ。\n出力の低下も止められるやも――", "face": "u2934a1"}, {"name": "アングハラド", "text": "残った力で、いつまで浮いていられる。\n百年か？　十年か？\n明日の食い扶持を求め、他種族に頭を垂れるのか？", "face": "lc12185578db6"}, {"name": "アーニャ", "text": "……頭を下げたら、いけないんですか？\n助けてもらったら、ありがとうって言うだけですよ。", "face": "u99"}, {"name": "アングハラド", "text": "ほう。我らとは違う、竜の血か。\nお前も、人の庇護を受けて生きているのか？", "face": "lc12185578db6"}, {"name": "アーニャ", "text": "私も、王子さまに助けてもらいました。\nあの時は、今と違う姿でしたけど……。\nそれでも、助けてくれたんです。", "face": "u99"}, {"name": "アーニャ", "text": "だから今度は、私が力になりたいんです。\nあなたたちを助けたくて\n駆け出した、王子さまの力に。", "face": "u99"}, {"name": "アングハラド", "text": "……ただひとり、偶然に、良き人間がいた。\nそれだけで、国の行く末を託せと？", "face": "lc12185578db6"}, {"name": "シビラ", "text": "ひとりではないわ。\nここに集ったのは戦を求める者ではない。\n悲しむ誰かを放っておけない者ばかりだもの。", "face": "u1981a1"}, {"name": "アングハラド", "text": "王子が倒れても、同じことを言えるか？\n千年を生きる我らにとって、人の一生など一瞬だ。\nその一瞬の約束で、我が子らの未来を賭けられるか。", "face": "lc12185578db6"}, {"name": "アンウェン", "text": "わらわの未来なら、わらわに決めさせろ！！", "face": "u2934a1"}, {"name": "アングハラド", "text": "……アンウェン。", "face": "lc12185578db6"}, {"name": "アンウェン", "text": "そなたが滅びても、わらわが生き残ればよい。\nそう思って、出ていくのを見逃したのであろう？\n……それで、わらわが喜ぶと思ったか！？", "face": "u2934a1"}, {"name": "アンウェン", "text": "国も、そなたも、トラハイアも。\nわらわは、全部連れて帰りたいのだ！\n帰る家を、勝手に滅ぼしてくれるな！", "face": "u2934a1"}, {"name": "アンナ", "text": "…………。", "face": "lbd7ff2ae0b3a"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アングハラド", "text": "…………欲張りな娘に、育ったものだ。", "face": "lc12185578db6"}, {"name": "サフレア", "text": "強欲にもなりました。\n太守様の背中を見て育ち、\n努力を諦めぬ将軍に剣を教わったお方ですから。", "face": "u2935a1"}, {"name": "アングハラド", "text": "ならば、力を示せ。\n我を倒し、この国を背負えるだけの力を！", "face": "lc12185578db6"}, {"name": "アンウェン", "text": "望むところだ！\n王子、皆の者！　わらわに力を貸してくれ！！", "face": "u2934a1"}, {"name": "アンナ", "text": "……はい！　王子、ご号令を！\n竜都の戦いに、決着をつけましょう！", "face": "l713a56a6a7fc"}]}, {"trigger": "end", "lines": [{"name": "アングハラド", "text": "ぐっ……！\n我が、敗れるか……。", "face": "lc12185578db6"}, {"name": "アンウェン", "text": "太守！\n……もうよい。勝負はついた。\n今度こそ、話を聞いてもらうぞ。", "face": "u2934a1"}, {"name": "アングハラド", "text": "……我が娘ながら、よくもそこまで\n人の子らを信じられるものよ。", "face": "lc12185578db6"}, {"name": "シビラ", "text": "アングハラド陛下。\n天眼ノ国は、あなたのよき隣人となるはずよ。", "face": "u1981a1"}, {"name": "シビラ", "text": "小さなすれ違いや争いはあるかもしれない。\nけれど、アンウェンが共存の道を示したのだから。", "face": "u1981a1"}, {"name": "アングハラド", "text": "……負けたのは、我だ。\nその言葉、信じると誓おう。", "face": "lc12185578db6"}, {"name": "アンウェン", "text": "む……待て、太守よ、\n我が師――いや、トラハイア将軍はどこに――", "face": "u2934a1"}, {"name": "アンナ", "text": "――っ、足元が……！？\n王子、街が傾いています！"}, {"name": "ラピス", "text": "レヴィアタン、お前か？", "face": "u2941a1"}, {"name": "レヴィアタンの化身", "text": "もしそうならすぐ止めています。\nこれは……何者かが、神造兵器リヴァイアサンの\n天竜核を取り外したのではないかと。", "face": "lfe7a12f0fc1b"}, {"name": "アングハラド", "text": "……モードリオン、約束を違えたな？", "face": "lc12185578db6"}, {"name": "モードリオン", "text": "――失礼な。予定を繰り上げただけですよ。", "face": "ld14a7c1a4050"}, {"name": "アトナテス", "text": "……よう、久しぶりだな。\n悪党っぷりに磨きがかかったか？", "face": "u908"}, {"name": "モードリオン", "text": "失礼な。これは正義の行いですよ。", "face": "ld14a7c1a4050"}, {"name": "モードリオン", "text": "嘆き悲しむ者ばかりのこんな世界、\n作り直して然るべきでしょう。", "face": "ld14a7c1a4050"}, {"name": "シビラ", "text": "……リヴァイアサンから、\n動力源である天竜核を奪ったのね？", "face": "u1981a1"}, {"name": "モードリオン", "text": "えぇ、そういう契約でしたから。", "face": "ld14a7c1a4050"}, {"name": "モードリオン", "text": "竜ノ国が勝利をおさめれば、\n奪った天眼核により、失われし神造兵器の\n建造技術をもってリヴァイアサンを復活させる。", "face": "ld14a7c1a4050"}, {"name": "モードリオン", "text": "しかし、もし敗北したならば、\n天竜核そのものをいただく。――公平な取引では？", "face": "ld14a7c1a4050"}, {"name": "ラピス", "text": "……ふざけたことを。\n初めから、核を両方奪うつもりだったのだろう。", "face": "u2941a1"}, {"name": "モードリオン", "text": "奪う……？", "face": "ld14a7c1a4050"}, {"name": "モードリオン", "text": "勘違いしないでいただきたい。\n天眼核も、天竜核も、そのコアは破滅の力。\n本来これらはすべて、我が王のものなのですから。", "face": "ld14a7c1a4050"}, {"name": "カタラ", "text": "…………破滅の力って。\nこの世界にも破滅の力があるってこと！？", "face": "u912"}, {"name": "モードリオン", "text": "おしゃべりが過ぎました。\nそれではさようなら、哀れな竜の太守殿。", "face": "ld14a7c1a4050"}, {"name": "モードリオン", "text": "偉大なるドラゴンたちの国の最期へ、\nせめてもの餞として、\n天竜核の本当の力をお見せしましょう。", "face": "ld14a7c1a4050"}, {"name": "アンウェン", "text": "やめろモードリオン！　何を――", "face": "u2934a1"}, {"name": "モードリオン", "text": "それでは、さようなら。", "face": "ld14a7c1a4050"}, {"name": "パルセ", "text": "『――こえますか！？\nこちらドーンブリンガー！』", "face": "u2276a1"}, {"name": "フローガ", "text": "パルセさん！　大丈夫、聞こえています！", "face": "u878"}, {"name": "パルセ", "text": "『魔力計器がすべて振り切れました！\nそちらでいったい何が起きているのですか！？』", "face": "u2276a1"}, {"name": "ユリクセス", "text": "馬鹿な……ドーンブリンガーの設計は、\n大神ディアスの魔力にすら対応しているんだぞ？", "face": "u2193a1"}, {"name": "アカツキ", "text": "『――ッ！　天眼ノ国周辺にて、大規模な魔力嵐が発生！\nこのままじゃ……国がまるごと吹き飛びますよ！』", "face": "u2578a1"}, {"name": "レヴィアタンの化身", "text": "天竜核の暴走に、天眼核が共鳴しているんです。\nこのままでは、どちらの国も……。", "face": "lfe7a12f0fc1b"}, {"name": "ラピス", "text": "レヴィアタン、お前の力でどうにかできないのか。", "face": "u2941a1"}, {"name": "レヴィアタンの化身", "text": "私では出力が足りません。\nこれは、ふたつの破滅の力による共鳴。\n大神すら超えた――破壊神の力の顕現です。", "face": "lfe7a12f0fc1b"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "シビラ", "text": "何か、できることは……。", "face": "u1981a1"}]}, {"trigger": "end", "lines": [{"name": "謎の声", "text": "――。――――！\n――――ッ！！", "face": "lfb8eaf80f0f2"}, {"name": "シビラ", "text": "――っ。\nなに……？　誰か、呼んだ……？", "face": "u1981a1"}, {"name": "アンナ", "text": "シビラさん？\n……その剣、光って……！", "face": "l713a56a6a7fc"}, {"name": "シビラ", "text": "フラガラッハ……？\nあなたが、私を呼んでいるの？", "face": "u1981a1"}, {"name": "謎の声", "text": "――良かった、やっと声が届いた。", "face": "lfb8eaf80f0f2"}, {"name": "シビラ", "text": "前にも確か――私たちの、ご先祖さま……？", "face": "u1981a1"}, {"name": "謎の声", "text": "そう、覚えていてくれて嬉しいわ。\nでも時間がないから、手短に話すわね。", "face": "lfb8eaf80f0f2"}, {"name": "謎の声", "text": "あなたと王子なら、この暴走を止められる。\n実行するか、全力で逃げるかは、ふたりに任せるわ。", "face": "lfb8eaf80f0f2"}]}], "map": {"image": "Map7526", "w": 960, "h": 640, "spots": [{"k": "b", "x": 884, "y": 529}, {"k": "m", "x": 317, "y": 418, "id": 200}, {"k": "m", "x": 396, "y": 373, "id": 201}, {"k": "m", "x": 504, "y": 389, "id": 202}, {"k": "m", "x": 615, "y": 366, "id": 203}, {"k": "m", "x": 658, "y": 288, "id": 204}, {"k": "m", "x": 604, "y": 202, "id": 205}, {"k": "m", "x": 497, "y": 183, "id": 206}, {"k": "m", "x": 408, "y": 216, "id": 207}, {"k": "m", "x": 355, "y": 295, "id": 208}, {"k": "m", "x": 225, "y": 479, "id": 209}, {"k": "m", "x": 140, "y": 429, "id": 210}, {"k": "m", "x": 668, "y": 152, "id": 211}, {"k": "m", "x": 761, "y": 106, "id": 212}, {"k": "m", "x": 863, "y": 176, "id": 213}, {"k": "m", "x": 707, "y": 420, "id": 214}, {"k": "m", "x": 781, "y": 479, "id": 215}, {"k": "m", "x": 503, "y": 285, "id": 216}, {"k": "r", "x": 417, "y": 466, "id": 300}, {"k": "r", "x": 577, "y": 486, "id": 301}, {"k": "r", "x": 787, "y": 342, "id": 302}, {"k": "r", "x": 733, "y": 221, "id": 303}, {"k": "r", "x": 511, "y": 104, "id": 304}, {"k": "r", "x": 226, "y": 317, "id": 305}, {"k": "r", "x": 99, "y": 206, "id": 306}], "events": [{"t": 14.6, "when": "time", "ops": [{"op": "+fx", "name": "obj_03", "fx": "RockFall3", "x": 146, "y": 492}]}, {"t": 16.1, "when": "time", "ops": [{"op": "-fx", "name": "obj_03"}]}, {"t": 33.6, "when": "time", "ops": [{"op": "+fx", "name": "obj_01", "fx": "RockFall3", "x": 449, "y": 245}]}, {"t": 35.1, "when": "time", "ops": [{"op": "-fx", "name": "obj_01"}]}, {"t": 59.5, "when": "time", "ops": [{"op": "+fx", "name": "obj_02", "fx": "RockFall3", "x": 666, "y": 234}]}, {"t": 61.0, "when": "time", "ops": [{"op": "-fx", "name": "obj_02"}]}, {"t": 93.5, "when": "time", "ops": [{"op": "+fx", "name": "obj_04", "fx": "RockFall3", "x": 449, "y": 245}]}, {"t": 95.0, "when": "time", "ops": [{"op": "-fx", "name": "obj_04"}]}, {"t": 127.2, "when": "time", "ops": [{"op": "+fx", "name": "obj_05", "fx": "RockFall3", "x": 146, "y": 492}]}, {"t": 128.7, "when": "time", "ops": [{"op": "-fx", "name": "obj_05"}]}, {"t": 153.2, "when": "time", "ops": [{"op": "+fx", "name": "obj_06", "fx": "RockFall3", "x": 449, "y": 245}]}, {"t": 154.7, "when": "time", "ops": [{"op": "-fx", "name": "obj_06"}]}, {"t": 157.6, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "WhiteOut4", "x": 502, "y": 312}]}]}, "active": true}