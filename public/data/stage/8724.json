{"quest_id": 8724, "name": "第十陣 真なる神に殉ずる者", "description": "神官を装った何者かが白の皇帝に襲い来る！\n＜白の皇帝の出撃時の初期HP減少：中＞\n＜白の皇帝の攻撃力がダウン＞\n神級（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["白の皇帝の出撃時の初期HP減少：中", "白の皇帝の攻撃力がダウン"], "event": "帝国十陣", "event_category": "Empire", "mission_id": 940010, "map_no": 9436, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_count": 1, "tags": ["邪教徒"], "hp": 152000, "attack": 900, "base_hp": 152000, "base_attack": 900, "damage_type": "magical", "armor_defense": 250, "magic_defense": 15, "attack_range": 240, "attack_speed": 50, "attack_wait": 55, "attack_interval": 177, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2164848, "race_id": 16, "special_effect_id": 2213, "missile_id": 1407, "missile": {"speed": 3.0}, "master_id": 39247, "global_id": 12864, "ranged": true, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 11, "form_count": 1, "tags": ["邪教徒"], "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 39268, "global_id": 12885, "spawn_sec": 149}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["邪教徒"], "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_spee