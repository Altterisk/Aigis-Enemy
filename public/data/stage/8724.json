change_to": 14, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 39252, "global_id": 12869, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 12872, "spawn_sec": 254}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "邪教徒"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127808, "race_id": 21, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 39255, "global_id": 12872, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 18, "source": "local", "count": 8, "form_count": 2, "tags": ["邪教徒"], "hp": 4500, "attack": 950, "base_hp": 4500, "base_attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 126, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159616, "race_id": 21, "change_to": 18, "change_condition": 4, "master_id": 39260, "global_id": 12877, "to_condition": 4, "to_ticks": 3, "to_global_id": 12880, "spawn_sec": 270}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["邪教徒"], "hp": 4500, "attack": 700, "base_hp": 4500, "base_attack": 700, "damage_type": "true", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 200, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159632, "race_id": 21, "special_effect_id": 1540, "master_id": 39263, "global_id": 12880, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 22, "source": "local", "count": 4, "form_count": 2, "tags": ["アーマー", "邪教徒"], "hp": 142000, "attack": 2650, "base_hp": 142000, "base_attack": 2650, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 308, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2159696, "race_id": 21, "special_effect_id": 795, "change_to": 22, "change_condition": 4, "master_id": 39264, "global_id": 12881, "to_condition": 4, "to_ticks": 3, "to_global_id": 12884, "spawn_sec": 307}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "邪教徒"], "hp": 142000, "attack": 1450, "base_hp": 142000, "base_attack": 1450, "damage_type": "true", "armor_defense": 5000, "magic_defense": 30, "attack_speed": 1, "attack_wait": 120, "attack_interval": 376, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2159712, "race_id": 21, "special_effect_id": 2029, "master_id": 39267, "global_id": 12884, "from_condition": 4, "trigger_ticks": 3}], "popups": ["邪教の神官から攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n複数の邪教の神官から\n攻撃を受けた場合、\n継続ダメージ効果が重複します。\n　　　　　　(1/3)", "邪教の神官の\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。\n\n\n　　　　　　(2/3)", "邪教の神官がいる間は、\n邪教徒属性の\n敵の攻撃と防御がアップします。\n\nこの効果は重複します。\n\n\n　　　　　　(3/3)", "各種冥界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "メーア", "text": "――ふぃー。やっと一休みですねー。", "face": "u2404a1"}, {"name": "ギョウブ", "text": "それにしても、きれいな神殿やね。\n放棄されて無人だって聞いとったけど。", "face": "u2599a1"}, {"name": "ヴィクター", "text": "ふむ……。\n無人の建物というものは、空気が淀むもの。\nしかしここは……どうやら何者かの出入りがあるようだ。", "face": "u795"}, {"name": "オルドネッタ", "text": "オークさんたちですかね？\n森からちょっと離れてますけど。", "face": "u2602a1"}, {"name": "シュテフィ", "text": "いえ、アダマス様は、彼らにとっては異教。\n雨宿り程度をすることはあるかもしれませんが、\n頻繁に訪れることはないでしょう。", "face": "u1709a1"}, {"name": "ウルスラ", "text": "…………臭いますな。", "face": "u1552a1"}, {"name": "メーア", "text": "えっ、何です？　何がです？", "face": "u2404a1"}, {"name": "ウルスラ", "text": "何者かが神殿に入って来ました。\n……足音は、複数……この衣擦れは、神官の装衣？", "face": "u1552a1"}, {"name": "レオナ", "text": "敵襲か？", "face": "u2600a1"}, {"name": "ウルスラ", "text": "いえ、ここからではそこまでは……。", "face": "u1552a1"}, {"name": "エレオノーラ", "text": "私が出ましょう。\nアダマス教徒であれば、他の教区であっても\n私を知らないものはいないはずです。", "face": "u799"}, {"name": "？？？", "text": "……おぉ、この神殿に来客とは。\nこれもアダマス様の思し召しでしょうか。", "face": "le98e66db8554"}, {"name": "エレオノーラ", "text": "挨拶もなく失礼しました。\nあなたは、ここの神官でしょうか？", "face": "u799"}, {"name": "？？？", "text": "えぇ、えぇ。\nこちらの神殿で名ばかりですが神官戦士を。\nおや、そちらの方はもしや皇帝陛下では……？", "face": "le98e66db8554"}, {"name": "エレオノーラ", "text": "…………トゥーダ。", "face": "u799"}, {"name": "トゥーダ", "text": "はい。\n――この身は金剛、折れぬ刃。", "face": "u1554a1"}, {"name": "？？？", "text": "……なにを？", "face": "le98e66db8554"}, {"name": "トゥーダ", "text": "アダマス様の神官戦士なのでしょう？\n共に祈りの聖句を。\n――この身は金剛、折れぬ刃。さぁ、続きを。", "face": "u1554a1"}, {"name": "？？？", "text": "…………。", "face": "le98e66db8554"}, {"name": "トゥーダ", "text": "我ら、女神アダマスの神罰代行者。\n――エレオノーラ様、この者、神官を騙る者です。", "face": "u1554a1"}, {"name": "？？？", "text": "…………あと少しで呪いが完成したというのに。\n仕方あるまい、真なる神に殉ずる者たちよ、剣をとれ。", "face": "le98e66db8554"}, {"name": "マリカ", "text": "あれは……冥界人が混じっている……？\n総員！　抜刀ーッ！！　陛下をお護りせよ！！", "face": "u623"}, {"name": "邪教徒", "text": "女神アダマスなど偽りの女神に過ぎぬ。\n冥界にて封じられし我らが神よ！\n我ら、世界を砕く大牙なりッ！！", "face": "le98e66db8554"}, {"name": "邪教徒", "text": "この身に、怒りと憎悪を与え給え！！", "face": "le98e66db8554"}]}, {"trigger": "end", "lines": [{"name": "邪教徒", "text": "ぐふっ……怒りを……憎悪、を……。", "face": "le98e66db8554"}, {"name": "マリカ", "text": "……ちっ、間に合いませんでした。\n自決したようです。", "face": "u623"}, {"name": "レオナ", "text": "ジュディス、陛下の容態は！", "face": "u2600a1"}, {"name": "ジュディス", "text": "……先程と変化はありません。", "face": "u2089a1"}, {"name": "エレオノーラ", "text": "陛下にはアダマス様の加護があるはず。\nこの短時間で、人間の神官が編み上げた呪い程度で、\nここまで容態が悪化するなんて……。", "face": "u799"}, {"name": "トゥーダ", "text": "……帝都へ急ぎ戻りましょう。\nありえない事態が起こっていることは、事実です。", "face": "u1554a1"}, {"name": "レオナ", "text": "早馬を出せ。\n帝都の治癒士と神官に受け入れ態勢を整えさせろ。", "face": "u2600a1"}, {"name": "ディルク", "text": "はっ。", "face": "u287"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "ジュディス", "text": "陛下！　陛下！！\nしっかりしてください！", "face": "u2089a1"}, {"name": "ジュディス", "text": "……っ、まずいです、意識が……！", "face": "u2089a1"}, {"name": "ジュディス", "text": "陛下っ、陛下ーッ！！", "face": "u2089a1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 29, "params": [0, 20, 10]}, {"kind": "term", "influence": 20, "params": [130]}, {"kind": "term", "influence": 19, "params": [120]}], "enemies": [{"enemy_id": 1, "hp": 152000, "attack": 900, "damage_type": "magical", "armor_defense": 250, "magic_defense": 15, "pattern_id": 2164848}, {"enemy_id": 2, "hp": 2000, "attack": 130, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2097536}, {"enemy_id": 3, "hp": 900, "attack": 200, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "pattern_id": 2097568}, {"enemy_id": 4, "hp": 1100, "attack": 250, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2097552}, {"enemy_id": 5, "hp": 3200, "attack": 220, "damage_type": "physical", "armor_defense": 40, "pattern_id": 2097168}, {"enemy_id": 6, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 6, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 10, "hp": 8000, "attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127824}, {"enemy_id": 10, "form_index": 1, "hp": 8000, "attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127840}, {"enemy_id": 14, "hp": 2500, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 14, "form_index": 1, "hp": 2500, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 18, "hp": 4500, "attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2159616}, {"enemy_id": 18, "form_index": 1, "hp": 4500, "attack": 700, "damage_type": "true", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2159632}, {"enemy_id": 22, "hp": 142000, "attack": 2650, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 30, "pattern_id": 2159696}, {"enemy_id": 22, "form_index": 1, "hp": 142000, "attack": 1450, "damage_type": "true", "armor_defense": 5000, "magic_defense": 30, "pattern_id": 2159712}]}, "active": true}