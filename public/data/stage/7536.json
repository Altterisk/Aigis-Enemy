{"quest_id": 7536, "name": "第三陣 飛行戦艦の急襲", "description": "帝国北部の合同演習地にベラート伯爵の\n飛行艦隊が現れ、再び戦の火蓋が切られる。\n＜広域戦闘：敵味方の射程減少＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国三陣", "event_category": "Empire", "mission_id": 940005, "map_no": 4582, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [220]}, {"kind": "term", "influence": 20, "params": [220]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["機械", "帝国"], "hp": 92000, "attack": 1200, "base_hp": 92000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 650, "magic_defense": 10, "attack_range": 360, "attack_speed": 1, "attack_wait": 180, "attack_interval": 501, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133072, "special_effect_id": 956, "change_to": 1, "missile_id": 670, "missile": {"speed": 4.0}, "master_id": 34615, "global_id": 8232, "ranged": true, "to_condition": 0, "to_global_id": 8233, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag(1, 1);\");", "sets_flags": [[1, 1]], "on_destroy": true}, "route_behaviour": {"transforms": [{"wait": 180}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "帝国"], "hp": 92000, "base_hp": 92000, "damage_type": "physical", "armor_defense": 650, "magic_defense": 10, "attack_speed": 1, "attack_wait": 180, "attack_interval": 410, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133088, "special_effect_id": 956, "missile_id": 670, "missile": {"speed": 4.0}, "master_id": 34616, "global_id": 8233, "from_condition": 0}, {"enemy_id": 3, "source": "local", "count": 2, "form_index": 0, "form_count": 4, "tags": ["機械", "帝国"], "hp": 10000, "attack": 560, "base_hp": 10000, "base_attack": 560, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 191, "move_speed": 250.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133008, "race_id": 16, "special_effect_id": 242, "change_to": 3, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34607, "global_id": 8224, "ranged": true, "to_condition": 0, "to_global_id": 8225, "route_behaviour": {"hold": {"routes": 2, "held": 2}, "reroutes": ["Route=999"]}, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["機械", "帝国"], "hp": 10000, "attack": 560, "base_hp": 10000, "base_attack": 560, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 191, "move_speed": 250.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133008, "race_id": 16, "change_to": 4, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34608, "global_id": 8225, "ranged": true, "from_condition": 0, "to_condition": 0, "to_global_id": 8226}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["機械", "帝国"], "hp": 10000, "attack": 560, "base_hp": 10000, "base_attack": 560, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 191, "move_speed": 250.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2133008, "race_id": 16, "special_effect_id": 957, "change_to": 5, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34609, "global_id": 8226, "ranged": true, "from_condition": 0, "to_condition": 0, "to_global_id": 8227}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["機械", "帝国"], "hp": 10000, "attack": 560, "base_hp": 10000, "base_attack": 560, "damage_type": "physical", "armor_defense": 650, "attack_range": 300, "attack_speed": 1, "attack_wait": 60, "attack_interval": 185, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2132992, "race_id": 16, "special_effect_id": 957, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 34610, "global_id": 8227, "ranged": true, "from_condition": 0}, {"enemy_id": 7, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 45, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111792, "race_id": 16, "master_id": 30637, "global_id": 4256, "spawn_sec": 106}, {"enemy_id": 8, "source": "local", "count": 33, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 137}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 20000, "attack": 450, "base_hp": 20000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130064, "race_id": 16, "master_id": 34058, "global_id": 7675, "spawn_sec": 190}], "popups": ["発光するマスに配置した\nユニットは射程が\n上昇します。", "飛空戦艦が特定の位置に到着すると、\n艦内から増援が出現します。\n飛空戦艦を撃破すると、艦内の\n敵も同時に倒すことができます。\n\nまた飛空戦艦は、増援を降下中は\n砲撃を行いません。\n　　　　　　(1/2)", "飛空戦艦は拠点に\n向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――えっ、こんな北の僻地まで、\n王国軍が視察に来てるの？", "face": "u1432a1"}, {"name": "？？？", "text": "レーネったら、自分の故郷を僻地とか言わない！\nそれに視察じゃなくて、\n対冥界軍を想定した合同演習だからね。", "face": "u1434a1"}, {"name": "レーネ", "text": "まったく、そんなことだろうと思ったよ。\nマルレーンったら、軍に入ってから\n一度も里帰りしてくれなかったしさー。", "face": "u1432a1"}, {"name": "マルレーン", "text": "軍の仕事が忙しくてね。\nなかなか里帰りもできない……って、\nアタシを薄情者みたいに言うなってばー！", "face": "u1434a1"}, {"name": "レーネ", "text": "幼馴染のボクを置いて、\n都会に出て行っちゃうんだから薄情者だと思うなぁ？", "face": "u1432a1"}, {"name": "マルレーン", "text": "「ボクには路地裏が似合うのさ」なんて言って、\nアタシの誘いを断ったのはレーネの方――\n…………ん？　何、この音。", "face": "u1434a1"}, {"name": "レーネ", "text": "……これ、飛空艦の音だ。\n東の山脈の方から聞こえるような……。", "face": "u1432a1"}, {"name": "マルレーン", "text": "帝国の飛空艦隊はここにはいないはずだけど。\n……あっ、見えた。あの艦影は帝国艦だね。\n掲げている軍旗は――", "face": "u1434a1"}, {"name": "レーネ", "text": "待って、あの旗ってベラート伯爵の……。", "face": "u1432a1"}, {"name": "マルレーン", "text": "……まずい。激マズだこれ！\nレーネは急いで避難して！\nアタシは陛下に報告しなきゃ！！", "face": "u1434a1"}, {"name": "レーネ", "text": "避難しろって言われても――あぁもう！\nマルレーンのバカ！\nすぐ危険な場所に飛び込んでいくんだから！！", "face": "u1432a1"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "マルレーン", "text": "はぁっ、はぁ……っ！\nラウラ！　陛下はどこに！？", "face": "u1434a1"}, {"name": "ラウラ", "text": "そんなに急いでどうしたのですか？\n陛下でしたら、王国の王子殿下と会談を……。", "face": "u1433a1"}, {"name": "マルレーン", "text": "どうしたも何も、東の山脈を超えて、\nベラート伯爵の飛空艦隊が迫ってるんだよ！", "face": "u1434a1"}, {"name": "マルレーン", "text": "たぶん、見張りに気付かれないように、\n超低空を飛ばしてきたんだ。\nこのままじゃ準備が整う前に攻撃されちゃうよ！", "face": "u1434a1"}, {"name": "白の皇帝", "text": "……慌てるな。\n戦闘の準備はできている。", "face": "u418"}, {"name": "レオナ", "text": "何しろ、合同演習の真っ只中だったからな。\nマルレーン、艦影の詳細は？", "face": "u311"}, {"name": "マルレーン", "text": "えぇと、格納庫みたいな箱を積んだ、\n大型の飛空戦艦だったかと……。\nそれから多数の砲台が！", "face": "u1434a1"}, {"name": "レオナ", "text": "……まさか、我が軍の最新鋭艦か？\nベラート伯爵め、いったいどこから設計図を……。", "face": "u311"}, {"name": "レオラ", "text": "分かってはいたけれど、\n内通者がいる、ということねぇ。", "face": "u464"}, {"name": "レオラ", "text": "でも、あの飛空戦艦はまだまだ試作段階。\n飛行時間はごく限られているはずよ。", "face": "u464"}, {"name": "白の皇帝", "text": "……レオナ、兵に伝えろ。\n飛空戦艦は車両部隊を輸送しているはずだ。\n可能であれば、部隊の降下前に撃ち落とせ。", "face": "u418"}, {"name": "レオナ", "text": "はっ！", "face": "u311"}, {"name": "白の皇帝", "text": "マルレーン、工兵隊への伝令を任せる。\n戦場は広域だ。\n攻撃の届く範囲は限られる。射程範囲を見誤るな。", "face": "u418"}, {"name": "白の皇帝", "text": "――総員、迎え撃つぞ。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "ルーテ", "text": "陛下！　敵の増援です！\n飛空戦艦がさらに出現！", "face": "u529"}, {"name": "ケイティ", "text": "……東の山脈に隠れて、\n敵の全容が把握できない状況ですか。", "face": "u114"}, {"name": "白の皇帝", "text": "……この状況をどう見る、王国の戦術教官。", "face": "u418"}, {"name": "ケイティ", "text": "…………。\n私ならば、後退を進言するところですね。", "face": "u114"}, {"name": "ケイティ", "text": "敵は飛空戦艦と車両部隊を主力としています。\nならば、背後の雪山に逃れ、\n高所を確保すべきかと。", "face": "u114"}, {"name": "レオナ", "text": "陛下、こちらも同意見です。\nあえてあちらが有利な、\n平地で迎え撃つ必要もないでしょう。", "face": "u311"}, {"name": "白の皇帝", "text": "…………全軍、後退だ。\n陣形を乱すな。山腹に到着次第反撃に移る。", "face": "u418"}, {"name": "ケイティ", "text": "…………。", "face": "u114"}, {"name": "ケイティ", "text": "（白の皇帝も、以前と比べて変わりましたね。\nまさか私に意見を求めてくるとは）", "face": "u114"}, {"name": "アンナ", "text": "（変わろうとしている、のでしょうか。\nもしかしたら、王子の影響かもしれませんね）"}]}], "active": true}