{"quest_id": 1941, "name": "アルティア：魔蠅の復活", "description": "魔神ベルゼビュートが復活し、\n眷属による物質界への侵攻が始まる。\n魔界の門に迫り来る魔物を食い止めろ！\n%c[ff4000]このミッションは固定メンバーで出撃します。%c[ffffff]", "event": "ストーリーミッション外伝", "event_category": "Story", "mission_id": 100101, "map_no": 1161, "level": 70, "multiplier": 0.7, "charisma": 10, "capacity": 8, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}, {"kind": "term", "influence": 24, "params": [36], "expression": "(IsOverlapMember() != 1;)&&IsClassType(9, 94, 95, 96, 97, 98, 99, 209, 1001,1220,1251,1273,1315,1318,1320,1323,1328,1350,1353,1379,1386,1394,1401,1411,1431,1446,1447,1448,1457,1534) == 0;", "expression_human": "(it is not a duplicate of another unit in your team) and its class type is not one of 30 class types"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 3, "hp": 8400, "base_hp": 12000, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "attack_interval": 231, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112512, "race_id": 3, "change_to": 1, "change_condition": 2, "master_id": 30699, "global_id": 4318, "to_condition": 2, "to_global_id": 4319, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 1, "base_hp": 1, "damage_type": "physical", "armor_defense": 100, "attack_wait": 80, "attack_interval": 231, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112528, "race_id": 3, "special_effect_id": 206, "change_to": 2, "change_condition": 2, "master_id": 30700, "global_id": 4319, "from_condition": 2, "to_condition": 2, "to_global_id": 433}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 4200, "base_hp": 6000, "damage_type": "physical", "armor_defense": 800, "magic_def