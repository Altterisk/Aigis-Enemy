500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105248, "race_id": 18, "change_to": 5, "master_id": 627, "global_id": 626}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "hp": 3150, "attack": 210, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110064, "race_id": 12, "special_effect_id": 168, "master_id": 30315, "global_id": 3934, "spawn_sec": 69}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 1, "hp": 4200, "attack": 630, "base_hp": 6000, "base_attack": 900, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112544, "race_id": 18, "master_id": 30694, "global_id": 4313, "spawn_sec": 73}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 4200, "base_hp": 6000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101840, "race_id": 3, "special_effect_id": 55, "master_id": 434, "global_id": 433, "spawn_sec": 100}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 8400, "attack": 910, "base_hp": 12000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112560, "race_id": 18, "master_id": 30695, "global_id": 4314, "spawn_sec": 161}], "dialogue": [{"trigger": "start", "lines": [{"name": "ドロテア", "text": "──来たか、どうやら間に合ったようだな。", "face": "u408"}, {"name": "ヴィディア", "text": "ああ、遅れてすまない。ドロテア殿、戦況は？", "face": "u1894a1"}, {"name": "ドロテア", "text": "劣勢だな、主力が留守の隙を狙われた。\nとにもかくにも兵士の数がまるで足りん。", "face": "u408"}, {"name": "アルティア", "text": "まさかよりによってのタイミングで、\n魔神ベルゼビュートが復活するなんて……。", "face": "u261"}, {"name": "ドロテア", "text": "よもや偶然とは思えん。\nおそらくはずっと我らの背中を\n刺す機会を窺っていたのだろうな。", "face": "u408"}, {"name": "ランシェ", "text": "ベルゼビュートと言えば、\nアスバールさんはどこに？", "face": "u1957a1"}, {"name": "メフィスト", "text": "ああ、アスバール殿なら体調を崩して休んでいるよ。\n彼女とベルゼビュートはコインの表裏のような関係だ、\n奴の復活がなんらかの影響を及ぼしているのだろうね。", "face": "u526"}, {"name": "メフィスト", "text": "知識欲の魔神としては大変興味深い現象なんだが──", "face": "u526"}, {"name": "パヤモ", "text": "ここで負けてしまっては……元も子もありません……。", "face": "u1851a1"}, {"name": "パヤモ", "text": "（魔神……もう出てくるなって、言ったのに……）", "face": "u1851a1"}, {"name": "ドロテア", "text": "ベルゼビュートの軍勢は魔界の門を狙って進軍中だ。\n放っておけば、物質界が奴の眷属で溢れ返るだろう。", "face": "u408"}, {"name": "ヴィディア", "text": "それは、想像もしたくないな……。", "face": "u1894a1"}, {"name": "ランシェ", "text": "私たちも近場にいた遠征部隊の寄せ集め、\nこの数でどれだけ進行を抑えられますかね……。", "face": "u1957a1"}, {"name": "ヴィディア", "text": "泣き言は後だ、今はやるしかあるまい。", "face": "u1894a1"}, {"name": "ヴィディア", "text": "なに、王国や帝国の本隊が到着するまでの時間稼ぎだ。\n戦線の死守は必要ない、逐次退却しながら距離を取る。", "face": "u1894a1"}, {"name": "ヴィディア", "text": "アルティア、やれるな？", "face": "u1894a1"}, {"name": "アルティア", "text": "もちろんです！", "face": "u261"}, {"name": "ヴィディア", "text": "よし、総員出撃だ。指揮は私が執る。文句は後で聞こう！", "face": "u1894a1"}, {"name": "ヴィディア", "text": "我らで魔神ベルゼビュートの野望を砕く！！", "face": "u1894a1"}]}, {"trigger": "end", "lines": [{"name": "一般兵", "text": "──伝令！　敵部隊が魔界の門に到達しました！", "face": "u6"}, {"name": "ヴィディア", "text": "くっ、抜けられたか……。", "face": "u1894a1"}, {"name": "ランシェ", "text": "この数で戦場全域をカバーするのは不可能ですよ！\nせめて隘路だったら蟻一匹通しはしないんですけどねぇ！", "face": "u1957a1"}, {"name": "メフィスト", "text": "不味いね、このままだと物質界が奴の眷属で溢れるぞ。", "face": "u526"}, {"name": "ヴィディア", "text": "……兵を二手に分ける。", "face": "u1894a1"}, {"name": "ヴィディア", "text": "アルティア、君はゲートを抜けた奴らを追え。", "face": "u1894a1"}, {"name": "アルティア", "text": "で、ですが──", "face": "u261"}, {"name": "ヴィディア", "text": "議論している時間はない、\n今ならまだ間に合うはずだ。", "face": "u1894a1"}, {"name": "ヴィディア", "text": "ここは私たちで抑える、絶対に追加は行かせない。", "face": "u1894a1"}, {"name": "メフィスト", "text": "帝国軍を勝手に代表して私からもお願いするよ。", "face": "u526"}, {"name": "メフィスト", "text": "物質界に侵略の橋頭堡なんて築かれてみたまえ。\n害虫駆除には十年単位の月日を要することだろう。", "face": "u526"}, {"name": "メフィスト", "text": "その間の被害については計算する気も起きないな。", "face": "u526"}, {"name": "アルティア", "text": "……了解しました、皆様もご武運を。", "face": "u261"}, {"name": "ヴィディア", "text": "ああ、物質界は任せたよ。", "face": "u1894a1"}, {"name": "アルティア", "text": "遠征部隊は私に続いてください！　ゲートを抜けます！", "face": "u261"}, {"name": "遠征部隊", "text": "おおおおッ！！", "face": "u64"}, {"name": "ヴィディア", "text": "さあ、ここからしんどいぞ。", "face": "u1894a1"}, {"name": "ランシェ", "text": "ふふふ、ヴィディアと組むといつもこうですね。", "face": "u1957a1"}, {"name": "ヴィディア", "text": "適材適所だ、後輩のために死ねるなら本望だろう？", "face": "u1894a1"}, {"name": "ランシェ", "text": "死にませんよ。老兵は死なず、ただ去るのみ──です。", "face": "u1957a1"}, {"name": "ベルゼビュートの眷属", "text": "ブブブブブブブブ。", "face": "l60231936c46a"}, {"name": "ベルゼビュートの眷属", "text": "ブッ──", "face": "l60231936c46a"}, {"name": "アスバール", "text": "──私も出ましょう。", "face": "u1668a1"}, {"name": "ヴィディア", "text": "アスバール殿、もう大丈夫なのですか？", "face": "u1894a1"}, {"name": "アスバール", "text": "全然最悪の気分ですが、私だけ休んでもいられません。", "face": "u1668a1"}, {"name": "アスバール", "text": "力を貸してください、これは世界を守る戦いです。", "face": "u1668a1"}]}], "active": true}