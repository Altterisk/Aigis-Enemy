{"quest_id": 6260, "name": "霧を纏いし紅血の皇女", "description": "突如カリオペをさらった\n吸血鬼の皇女シルヴィア。\n霧を振り払い彼女の真意を問い質せ！\n神級（★１獲得の目安：平均Lv50）", "event": "カリオペと恐怖の夜", "event_category": "History", "mission_id": 920096, "map_no": 3254, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "magical", "armor_defense": 700, "magic_defense": 15, "attack_speed": 25, "attack_wait": 1, "attack_interval": 75, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111696, "special_effect_id": 54, "master_id": 30620, "global_id": 4239, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 16, "form_count": 1, "hp": 2000, "attack": 550, "base_hp": 2000, "base_attack": 550, "damage_type": "physical", "armor_defense": 800, "attack_speed": 60, "attack_wait": 10, "attack_interval": 116, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098496, "race_id": 12, "master_id": 100, "global_id": 99, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "hp": 2400, "attack": 650, "base_hp": 2400, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "master_id": 24, "global_id": 23, "spawn_sec": 37}, {"enemy_id": 4, "source": "local", "count": 59, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 43}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 1000, "base_hp": 7000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 2200, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 600.0, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099136, "race_id": 12, "master_id": 645, "global_id": 644, "spawn_sec": 67}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1200, "base_hp": 30000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 1200, "magic_defense": 15, "attack_speed": 25, "attack_wait": 1, "attack_interval": 75, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111696, "special_effect_id": 130, "master_id": 30619, "global_id": 4238, "spawn_sec": 120}], "dialogue": [{"trigger": "start", "lines": [{"name": "シルヴィア", "text": "――王子様、カリオペさんは預かりました。\n返して欲しくば、このヴァンパイアのプリンセス、\nシルヴィアを倒す事ですわ！", "face": "u1442"}, {"name": "アンナ", "text": "シルヴィアさん！？\nカリオペさんを連れ去ったりして……。\n一体、どうしてこんな事を！？", "face": "la78924dc8c4e"}, {"name": "シルヴィア", "text": "アンナさん、聞くまでも無い事ですわ。\n人間たちの童話の本にはこう書いてありました。", "face": "u1442"}, {"name": "シルヴィア", "text": "『王子様が悪い吸血鬼を退治し、お姫様を助け、\nいつまでも幸せに暮らしましたとさ……』と。", "face": "u1442"}, {"name": "シルヴィア", "text": "本当なら私をお姫様扱いして欲しい\nところですが……私はどこまでいっても吸血鬼。\n今はカリオペさんがお姫様ですわね。", "face": "u1442"}, {"name": "カリオペ", "text": "――オウジ、タスケテー！　\nワタシハココヨー！", "face": "u524"}, {"name": "シルヴィア", "text": "カリオペさんを助けたくば、\nこのシルヴィアの挑戦、受けて下さい！", "face": "u1442"}, {"name": "アンナ", "text": "……カリオペさんに余り危機感を感じませんが。\n王子、シルヴィアさんの真意を確かめるためにも、\nここはカリオペさんを助け出しましょう！", "face": "la78924dc8c4e"}]}, {"trigger": "end", "lines": [{"name": "カリオペ", "text": "タスケテクレテ、アリガトウオウジ。\nアナタノオヒメサマヨー。", "face": "u524"}, {"name": "アンナ", "text": "カリオペさん、すごい棒読みの口調ですね……。\n……もしかして、またカリオペさんの\nイタズラなのでしょうか？", "face": "l85338b31cbec"}, {"name": "シルヴィア", "text": "イタズラじゃなくて、肝試しですわ！\nねぇ、王子、ビックリされましたか？", "face": "u1442"}, {"name": "シルヴィア", "text": "今、王国で肝試し大会をされているのでしょう？\nそれで、私も参加したいと思っていたところに、\nカリオペさんが手伝ってくれる事になったのです。", "face": "u1442"}, {"name": "アンナ", "text": "そう言う事だったのですか……。"}, {"name": "シルヴィア", "text": "ですけど、やっぱり私もお姫様扱いして欲しいですね。\nカリオペさん、次は私がお姫様役をしたいので、\n悪い魔女役をお願いしますわ。", "face": "u1442"}, {"name": "カリオペ", "text": "いいわよ。じゃあいつもの服に着替えてこようかしら。\nついでに次のイタズラの準備もして……。", "face": "u524"}, {"name": "アンナ", "text": "カリオペさん、すっかりいつもの調子ですね。\nシルヴィアさんも本気で人を襲った訳じゃなくて、\nホッとしました。"}, {"name": "アンナ", "text": "こんな吸血鬼の肝試しなら、歓迎なのですけどね。\nそれでは王子、お疲れ様でした。"}]}], "active": true}