: 2103568, "race_id": 12, "master_id": 456, "global_id": 455, "spawn_sec": 76}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 322, "global_id": 321, "ranged": true, "spawn_sec": 91}, {"enemy_id": 13, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 6000, "attack": 320, "base_hp": 6000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 3000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "special_effect_id": 317, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31294, "global_id": 4913, "ranged": true, "spawn_sec": 106}, {"enemy_id": 14, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 9000, "attack": 450, "base_hp": 9000, "base_attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 2200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "special_effect_id": 317, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 31287, "global_id": 4906, "ranged": true, "spawn_sec": 106}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 48, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112016, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30612, "global_id": 4231, "ranged": true, "spawn_sec": 116}], "popups": ["暴走したノワールは倒されると、\nその場で復活します。\n復活は2回まで行われます。\nまた、復活するたびに\n攻撃力が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ノワール", "text": "ここが祭壇……。\nかつて魔物の封印に使われたという場所……。", "face": "u679"}, {"name": "バルバストラフ", "text": "ほれ、祭壇に上がるのじゃ。\n儀式の準備をするぞい。", "face": "u63"}, {"name": "ノワール", "text": "……魔術師、皆、それから、王子。\nその……世話になった。\nいや、違う……だから……その……。", "face": "u679"}, {"name": "ノワール", "text": "……ありがとう。", "face": "u679"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "バルバストラフ", "text": "――「封印晶」の配置は、こうじゃな。\n成る程、随分と古い術式じゃわい。", "face": "u63"}, {"name": "サイラス", "text": "だが洗練されている。\n我々の魔力で「封印晶」の力を増幅すれば、\n彼女を助けることが出来るだろう。", "face": "u13"}, {"name": "バルバストラフ", "text": "しかし、魔物とて素直に従いはせんじゃろう。\n皆、何が起きても良いように構えておれ！", "face": "u63"}, {"name": "サイラス", "text": "ゆくぞバルバストラフ。\n共鳴……増幅……今だッ！！", "face": "u13"}, {"name": "ノワール", "text": "魔力が……流れ込んで……。\nあぁっ……ぐっ……グアァ――ッ！！", "face": "u679"}]}, {"trigger": "start", "lines": [{"name": "バルバストラフ", "text": "おそらくは魔物の最後の抵抗じゃ。\n王子、この娘を助けたいのなら、\nここで魔物を無力化するんじゃ……！！", "face": "u63"}, {"name": "メーリス", "text": "取り付いた魔物のせいかしら。\nノワールさんの魔力が異常に高まっているわ！？", "face": "u78"}, {"name": "ナキア", "text": "最初に戦った時と同じと思うなよ、王子。\nこの魔力の気配……ぶっ倒す度に、\n更に凶暴になって立ち上がってくるぞ……！！", "face": "u641"}, {"name": "アンナ", "text": "王子、取り付いた魔物を倒し、\nノワールさんを助けましょう……！！", "face": "l74a020b6a569"}]}, {"trigger": "end", "lines": [{"name": "バルバストラフ", "text": "――今じゃ！\nサイラス、ぬかるでないぞ！", "face": "u63"}, {"name": "サイラス", "text": "誰に言っている！　封印晶の術式を共鳴させ、\n迷宮中の欠片の魔力を引き寄せた。\nこれならば……封印術式、起動ッ！！", "face": "u13"}, {"name": "ノワール", "text": "グァアアア――ッ！！", "face": "u679"}, {"name": "アリサ", "text": "ノワールさん！！", "face": "u24"}]}, {"trigger": "end", "lines": [{"name": "ノワール", "text": "――ま、魔物め……。力を封じられ、\n支配される側に回った気分はどうだ……？", "face": "u679"}, {"name": "ノワール", "text": "貴様には多くのものを奪われた……。\n今度は、私が貴様の力を頂く――皆を守る力として……！\nこれが……私の、復讐だ……ッ！", "face": "u679"}, {"name": "ケイティ", "text": "魔物の抵抗が次第に落ち着いていくようです。\nノワールさんの制御下に入ったのでしょうか……。", "face": "u114"}, {"name": "アリサ", "text": "……ノワールさん！　大丈夫ですか！？", "face": "u24"}, {"name": "ノワール", "text": "……ぐっ……ぁ……アリサ……？\n私は……。", "face": "u679"}, {"name": "ナキア", "text": "……ったく、心配させやがって。\nで、魔物はちゃんと制御できてるのか？", "face": "u641"}, {"name": "フィリス", "text": "ふぅ、これで一安心かな。\nノワール、怪我はしてないかい？", "face": "u40"}, {"name": "ソーマ", "text": "大丈夫ですか？\nノワールさんお腹へってないですか！？", "face": "u23"}, {"name": "ノワール", "text": "ま、待って……。\n一斉に質問されても……困る……。", "face": "u679"}, {"name": "アンナ", "text": "どうやら、封印の儀式は上手くいったようですね。\n王子、ひとまず王国へ戻りましょうか。"}]}], "active": true}