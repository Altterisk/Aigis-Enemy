{"quest_id": 7234, "name": "決意のスルーズ", "description": "天槍騎兵団の卑劣なる策は、\n村の住民にまでその矛先を向ける……。\nスルーズと共に村人を救え！\n神級（★１獲得の目安：平均Lv50）", "event": "戸惑いの戦乙女", "event_category": "History", "mission_id": 920155, "map_no": 5861, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 250, "gold": 1200, "drops": [{"card": 57, "c": 1}, {"card": 58, "c": 1}, {"card": 59, "c": 1}, {"card": 60}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_index": 0, "form_count": 3, "tags": ["アーマー"], "hp": 2800, "attack": 280, "base_hp": 2800, "base_attack": 280, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126896, "race_id": 20, "change_to": 1, "master_id": 33343, "global_id": 6960, "to_condition": 0, "to_global_id": 6961, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 2800, "attack": 840, "base_hp": 2800, "base_attack": 840, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126912, "race_id": 20, "change_to": 2, "change_condition": 4, "master_id": 33344, "global_id": 6961, "from_condition": 0, "to_condition": 4, "to_ticks": 1, "to_global_id": 6962}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 2800, "attack": 280, "base_hp": 2800, "base_attack": 280, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126896, "race