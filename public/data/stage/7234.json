_id": 33356, "global_id": 6973, "to_condition": 4, "to_ticks": 3, "to_global_id": 6976, "spawn_sec": 76}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1120, "base_hp": 5000, "base_attack": 1120, "damage_type": "true", "armor_defense": 240, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 33359, "global_id": 6976, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 2, "hp": 20000, "attack": 1120, "base_hp": 20000, "base_attack": 1120, "damage_type": "physical", "armor_defense": 1600, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124224, "race_id": 20, "change_to": 11, "change_condition": 4, "master_id": 33406, "global_id": 7023, "to_condition": 4, "to_ticks": 3, "to_global_id": 7026, "spawn_sec": 90}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 280, "base_hp": 20000, "base_attack": 280, "damage_type": "true", "armor_defense": 1600, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124240, "race_id": 20, "special_effect_id": 563, "missile_id": 45, "master_id": 33409, "global_id": 7026, "from_condition": 4, "trigger_ticks": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "村人", "text": "ひぃぃっ、助けっ、誰か助けてくれぇ……ッ！！\n――って、えっ……？　あんたは……？", "face": "l2894ac1d2bf9"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "スルーズ", "text": "――この村を救いに来た者です。\n私のそばから離れないでください！", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "……スルーズ、何のつもりだ。\n父上を裏切るつもりか？", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "私は……私はお父さまを裏切ったことも、\n姉さまを裏切ったことも、一度だってありません。\nようやく目が覚めた、それだけです。", "face": "u1143a1"}, {"name": "クリッサ", "text": "大好きなお姉さんを泣かせたくない、\nこの子はただ、それだけで戦えるワルキューレだよ。\n――良い妹を持ったね。", "face": "u52"}, {"name": "天槍騎兵長", "text": "物質界のワルキューレと手を組んだか……。\nまぁ良い、作戦に変更はない。", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "父上はこう仰った。\n悪逆と非道を物質界に振りまき、\n王国軍の真価を引き出せと。", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "お前たち、このまま村を蹂躙しろ。\n天界兵も自由に使い潰せ、あれはただのコマだ。", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "……王子殿下、勝手なお願いだとは分かっています。\nこの村を守る戦いに、私の槍を捧げさせてください。", "face": "u1143a1"}, {"name": "スルーズ", "text": "姉さまの誇りを守るために、物質界の命を守るために、\nワルキューレの真なる使命を果たすために。", "face": "u1143a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "スルーズ", "text": "最初から迷っている暇なんてなかった。\nもっと早くから、こうするべきでした。\n天槍騎兵団スルーズ、推して参る！！", "face": "u1143a1"}]}, {"trigger": "battle", "at_sec": 10, "lines": [{"name": "村人", "text": "うわぁぁぁっ！？\nなんだアイツっ！？　来るなっ！　来るなぁぁッ！！", "face": "l2894ac1d2bf9"}, {"name": "スルーズ", "text": "くっ……王子殿下、天界巨兵が村人を！", "face": "u1143a1"}, {"name": "トラム", "text": "天界兵に村人をあぶり出させているのね。\nどこまでも卑劣な戦法を……。", "face": "u1110a1"}, {"name": "トラム", "text": "王子、戦力の配分に気をつけて。\n村人にも護衛が必要よ！", "face": "u1110a1"}]}, {"trigger": "end", "lines": [{"name": "天槍騎兵長", "text": "――なるほど、誰かを守る時にこそ、\n真価を発揮するのが人間というものか。", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "以上で威力偵察は完了だ。\n全軍撤退しろ、負傷した天界兵は捨てていって構わない。", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "姉さま！　待って！！", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "……裏切り者に、姉と呼ばれるつもりはない。\nスルーズ、次に会う時は敵同士だ。", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "……分かってます。\n姉さま、姉さまは、私が必ず解放します。\nこの槍と、お父さまの名にかけて。", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "…………哀れな妹だ。", "face": "l2644ec5e215f"}, {"name": "ミーシャ", "text": "……天槍騎兵団、撤退していきます。\n王子、まずは村の消火を急ぎましょう。", "face": "u19"}, {"name": "スルーズ", "text": "私も手伝います！\n簡単な手当ならできますから！", "face": "u1143a1"}, {"name": "ソラス", "text": "――天界との戦いは、物質界への\n不干渉を勝ち取るだけで良いと思っていましたが……。", "face": "u904"}, {"name": "アトナテス", "text": "どうやら、あっちは\nやる気が有り余ってるみたいだぜ？", "face": "u908"}, {"name": "アージェ", "text": "神とは決して、偉大なものではありませんから。\n己の似姿として人間を作った以上、\n似たような欲を持っているものかと。", "face": "u1090a1"}, {"name": "トゥアン", "text": "領土か力か、富か名声か……。\n何にしても向こうがやる気なんだ、\nこっちが遠慮する必要はないだろう。", "face": "u1006a1"}, {"name": "アトナテス", "text": "最初からこっちは千年戦争をする気なんだ。\n王子が助けたいって言う限り、\n全員に手を差し伸べるのが今の王国ってやつだろ。", "face": "u908"}, {"name": "アンナ", "text": "そう、ですね……。\nならば、行くしかなさそうですね。\n――オリュンポスへ。"}]}], "story_talk": true, "active": true}