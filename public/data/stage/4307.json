hp": 3000, "base_attack": 400, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "special_effect_id": 222, "missile_id": 6, "master_id": 137, "global_id": 136, "ranged": true, "spawn_sec": 111}], "dialogue": [{"trigger": "start", "lines": [{"name": "ダークエルフ", "text": "くっ、思ったよりも早かったな。\nしかしすでに二体の古代兵器はわが手中にある、\n何も恐れることなどない。", "face": "lddd9f81cf6a6"}, {"name": "ダークエルフ", "text": "我らの全戦力をもって、お前たちを\n滅ぼしてやる。覚悟しろ……！", "face": "lddd9f81cf6a6"}]}, {"trigger": "battle", "at_sec": 28, "lines": [{"name": "ダークエルフ", "text": "さすがは王子と言ったところか。\nあのゴーレムは未完成体ではあるが、\nやつらをせん滅するには十分だろう。", "face": "lddd9f81cf6a6"}, {"name": "アンナ", "text": "あれが古代の巨大兵器……！\n想像よりもなんて大きい……。\n王子、最大限の注意を！", "face": "l2de784a6429d"}]}, {"trigger": "end", "lines": [{"name": "セラ", "text": "大きな音がしたのでもしやと駆けつけましたが……。\nその様子だとダークエルフの企みは\n阻止できたのですわね。", "face": "u255"}, {"name": "アンナ", "text": "ひとまず、これまでに集めたミスリル鉱を\nお渡ししたいですし、いったん共に王城に\n戻りましょう。", "face": "l2de784a6429d"}, {"name": "ダークエルフ", "text": "ふは、は……、ふはははっ。はははははッ……！！\nおめでたい奴らだ。これで終わりと思ったのか？\nお前たちが戦ったのは未完成体に過ぎない。", "face": "lddd9f81cf6a6"}, {"name": "ダークエルフ", "text": "我らの手中にある内の一つ、完成体は妖精郷に\n向けて、すでに進軍を開始していたのだ。\n我々の計画はすでに完遂していたのだよ！", "face": "lddd9f81cf6a6"}, {"name": "アンナ", "text": "そんな……！　それではエルフの方たちが！\n王子、すぐに妖精郷へ向かいましょう！", "face": "l2de784a6429d"}]}], "map": {"image": "Map920044_3581", "w": 960, "h": 640, "spots": [{"k": "b", "x": 43, "y": 333}, {"k": "m", "x": 170, "y": 411, "id": 200}, {"k": "m", "x": 575, "y": 246, "id": 201}, {"k": "m", "x": 675, "y": 246, "id": 202}, {"k": "m", "x": 170, "y": 330, "id": 203}, {"k": "m", "x": 771, "y": 246, "id": 204}, {"k": "m", "x": 369, "y": 329, "id": 205}, {"k": "m", "x": 169, "y": 246, "id": 206}, {"k": "m", "x": 471, "y": 411, "id": 207}, {"k": "m", "x": 570, "y": 329, "id": 208}, {"k": "m", "x": 6