tags": ["アーマー"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 296, "master_id": 31084, "global_id": 4703, "spawn_sec": 140}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 177}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 40, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 209, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102832, "missile_id": 28, "missile": {"speed": 6.0, "splash": 200}, "master_id": 399, "global_id": 398, "ranged": true, "spawn_sec": 196}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 398, "global_id": 397, "spawn_sec": 206}], "popups": ["カボチャの馬車がいる間\n全ての敵のHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。", "ダークエルフナイトは\nダメージを受けると\n攻撃したユニットへ反撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ダークエルフ", "text": "――ふふふ、これでエルフどもに\nようやく引導を渡すことができる。", "face": "l13bfea66a98e"}, {"name": "ダークエルフ", "text": "我らの配下には、\nこの大量のカボチャの魔物がいるのだからな！", "face": "l13bfea66a98e"}, {"name": "カボチャの魔物", "text": "――カボ。ダークエルフ様に従いますカボ。", "face": "lb6b194f94d39"}, {"name": "ダークエルフ", "text": "それどころか……くっくっく……。\nあのパンプキンキングすら、\n我らダークエルフにかしずいているのだ！", "face": "l13bfea66a98e"}, {"name": "ダークエルフ", "text": "妖精郷にカボチャの魔物が実る木があると聞き、\n一気にこの辺りを\n占領した甲斐があったというものだ……。", "face": "l13bfea66a98e"}, {"name": "パンプキンキング", "text": "我らの召喚主はダークエルフ様たちカボ。\nどんなご命令でも聞きますカボ。", "face": "lfbb0d7ce7122"}, {"name": "リヴル", "text": "――やれやれ。\n召喚術に詳しくないヤツが、\nおだてられて良い気になってるみたいだぞ、王子。", "face": "u1081a1"}, {"name": "ダークエルフ", "text": "な、なにを！？\n我が召喚術は完璧だぞ！\n見よ、パンプキンキングすら我が命に従うのだ！", "face": "l13bfea66a98e"}, {"name": "リヴル", "text": "鳥の雛と召喚術を混同してないか？\nパンプキンキングが\nそんな簡単に従うはずなんて――いや、まぁいいか。", "face": "u1081a1"}, {"name": "リヴル", "text": "王子、楽しいハロウィンのために、\nついでに妖精郷のために、\nこいつらをぶっ飛ばしてやるぞ！", "face": "u1081a1"}, {"name": "ダークエルフ", "text": "我らをバカにしたこと、後悔させてやるぞ！\n行け、カボチャの魔物！\nそしてパンプキンキングよ！！", "face": "l13bfea66a98e"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "なっ……ダークエルフの精鋭と、\nカボチャの魔物が蹴散らされた、だと……！？", "face": "l13bfea66a98e"}, {"name": "リヴル", "text": "こっちはハロウィンを守るっていう、\n重要な使命があるんだぞ？\nカボチャごときに負けるはずがないだろ。", "face": "u1081a1"}, {"name": "ダークエルフ", "text": "くっ……だが、カボチャの魔物はまだまだいるぞ！\nおいパンプキンキング！\n王国軍の連中を、物量で押しつぶしてやれ！", "face": "l13bfea66a98e"}, {"name": "パンプキンキング", "text": "カボカボー？　誰になめた口を利いているのカボ？\nお願いしますパンプキンキング様っていうカボ☆", "face": "lfbb0d7ce7122"}, {"name": "ダークエルフ", "text": "なに……！？\nま、まさか従っているフリをしていただけなのか！？", "face": "l13bfea66a98e"}, {"name": "パンプキンキング", "text": "当たり前カボー☆\nクヒュヒュヒュ！\nダークエルフの魔力、いただいていくカボー！", "face": "lfbb0d7ce7122"}, {"name": "ダークエルフ", "text": "ぐわぁぁぁぁッ！？\nやめっ、やめろぉぉぉぉっ！！", "face": "l13bfea66a98e"}, {"name": "パンプキンキング", "text": "さぁ、残すは王国軍だけカボ。\n愉快なカボチャのパーティで、\n王国軍をパンプキンパイにしてやるカボー☆", "face": "lfbb0d7ce7122"}]}], "active": true}