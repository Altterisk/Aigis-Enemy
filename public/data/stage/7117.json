{"quest_id": 7117, "name": "軍事狂宴・魔王軍幹部", "description": "これからの戦いに備え、元魔王軍幹部との\n模擬戦を行うことになった一行。\n王国に集いし新たな戦友に力を示せ！\n神級（★１獲得の目安：平均Lv50）", "event": "開かれし扉と集う戦士たち", "event_category": "History", "mission_id": 920149, "map_no": 5757, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097952, "race_id": 9, "change_to": 1, "change_condition": 1, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 54, "global_id": 53, "ranged": true, "variants": [{"hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 24, "attack_wait": 1, "attack_interval": 51, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097968, "race_id": 9, "master_id": 55, "global_id": 54}], "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 21}, {"enemy_id": 4, "source": "local", "count": 10, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pa