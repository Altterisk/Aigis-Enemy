ttack_interval": 125, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110640, "race_id": 9, "special_effect_id": 234, "missile_id": 26, "master_id": 30731, "global_id": 4350, "ranged": true, "from_condition": 2}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 1, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110656, "race_id": 9, "special_effect_id": 234, "change_to": 18, "change_condition": 2, "missile_id": 26, "master_id": 30740, "global_id": 4359, "ranged": true, "spawn_sec": 208}, {"enemy_id": 21, "source": "local", "count": 2, "form_count": 1, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110688, "race_id": 9, "special_effect_id": 234, "change_to": 21, "change_condition": 2, "missile_id": 26, "master_id": 30741, "global_id": 4360, "ranged": true, "spawn_sec": 210}, {"enemy_id": 24, "source": "local", "count": 2, "form_count": 1, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110720, "race_id": 9, "special_effect_id": 234, "change_to": 24, "change_condition": 2, "missile_id": 26, "master_id": 30742, "global_id": 4361, "ranged": true, "spawn_sec": 212}, {"enemy_id": 27, "source": "local", "count": 1, "form_count": 3, "tags": ["アーマー"], "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_range": 250, "attack_speed": 90, "attack_wait": 45, "attack_interval": 136, "move_speed": 450.0, "dot_rate": 1.5, "pattern_id": 2105648, "special_effect_id": 232, "change_to": 27, "change_condition": 2, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 805, "global_id": 804, "ranged": true, "to_condition": 2, "to_global_id": 805, "spawn_sec": 221}, {"enemy_id": 27, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 40000, "attack": 3000, "base_hp": 40000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 20, "attack_speed": 90, "attack_wait": 120, "attack_interval": 476, "move_speed": 300.0, "dot_rate": 1.5, "pattern_id": 2105664, "change_to": 28, "change_condition": 2, "master_id": 806, "global_id": 805, "from_condition": 2, "to_condition": 2, "to_global_id": 806}, {"enemy_id": 27, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 80000, "attack": 3500, "base_hp": 80000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 20, "attack_speed": 50, "attack_wait": 20, "attack_interval": 221, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2105680, "special_effect_id": 86, "master_id": 807, "global_id": 806, "from_condition": 2}], "popups": ["ガオレオンはダメージを受けません。\nまた味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nブロックされている間、\nガオレオンは全ての効果を失います。\n　　　　　　(1/2)", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n\n\n\n　　　　　　(2/2)", "クラールフがいる間は\n悪天候『豪雨』が発生します。\n\n 　　悪天候：豪雨\n\n・敵味方の『射程』減少\n・一部の味方は影響を受けない\n　　　　　　(1/2)", "クラールフから攻撃を受けると、\n攻撃後の待ち時間が増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "クラールフ", "text": "――成程、敵は強大だな。\n末端の兵にまで、斯様な武器を持たせ、\n更には神の楔まで保有しているとなると――", "face": "l00c08af544f1"}, {"name": "ガオレオン", "text": "――なれば我らも、できることをするしかあるまいッ！\n幸いにして、王国に集ったのは\n奇跡のような戦力だからなッ！！", "face": "l3179d9738cce"}, {"name": "ノーマ", "text": "はぁ……王国軍って元は敵だった人が多すぎない！？\n王子ったら、どれだけ器が大きいのよ……。", "face": "u1047a1"}, {"name": "ガオレオン", "text": "ガオーッ！！\nそんな事を言い始めたら、ノーマよ、\nお前も元魔王軍である以上、元敵ではないかッ！！", "face": "l3179d9738cce"}, {"name": "メカゴブリンクイーン", "text": "あら、私はまだ敵のままよ？\n共通の敵を倒すために、\nこうして協力しているだけなんだから。", "face": "le219b5be753d"}, {"name": "女王子", "text": "それでも、メカゴブリンクイーン様が\n共に戦ってくれるだけで、私はとても嬉しいです。\nもう二度と、お話は出来ないと思っていましたから。", "face": "le1a0323ff10f"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、あなたは素直な良い子ねぇ。\n王国に返したのは失敗だったかしら……。", "face": "le219b5be753d"}, {"name": "レヴィ", "text": "うぅん、この子は人間だから、\n連れて行っちゃだめ。", "face": "u328"}, {"name": "メカゴブリンクイーン", "text": "……そうね、あなたに言われたら仕方ないわ。\nけれど、王子にひどい目にあわされたら、\nふたりとも私の所へ逃げてくるのよぉ？", "face": "le219b5be753d"}, {"name": "デシウス", "text": "――王子よ、部下がゴブリン族に\nスカウトされそうになっていないか？", "face": "l6607c719ec5f"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "デシウス", "text": "フム……王子が構わないと言うなら良いのだが……。\nともあれ、模擬戦というのは初めてだな。\n王国の恒例行事と聞いたが、この規模は心躍るぞ！", "face": "l6607c719ec5f"}, {"name": "ハナ", "text": "元魔王軍幹部さんたちと、\n王国軍での模擬戦ですからね……。\nちょっと前なら、あり得なかった組み合わせです。", "face": "u212"}, {"name": "アンナ", "text": "我々は即席の連合軍ですからね。\n模擬戦を繰り返して、\n連携と練度を高めていかなければなりません。"}, {"name": "ハナ", "text": "そうして天界の子たちも、\n世界樹も、深海も、全部ぜんぶ助けにいくんですね。", "face": "u212"}, {"name": "ハナ", "text": "よぉし、アタシも気合をいれて踊ります！\n王子、みなさん、準備は良いですか？\n――それでは、模擬戦開始です！！", "face": "u212"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "そこまで！　模擬戦終了です！！", "face": "u114"}, {"name": "ノーマ", "text": "……なるほどね。\nこれならガリウス様だって倒せちゃうはずよ。", "face": "u1047a1"}, {"name": "ノーマ", "text": "王子の強さはひとりの強さじゃなくて、\n皆が強くて、その上\n皆が王子の所に集まってるからもっと強いのね。", "face": "u1047a1"}, {"name": "ソラス", "text": "そこが英雄王と、王子君の最大の違いでしょうね。\nあの人だって、ここまで\n手当たりしだいに仲間を集めはしませんでした。", "face": "u904"}, {"name": "サナラ", "text": "あの人はほら、ひとりでも\nめちゃくちゃ凄かったじゃないですか。\n万能すぎて英傑の塔の設計にも関わってましたよね？", "face": "u921"}, {"name": "アトナテス", "text": "だからこそ、王子には\nもっと強くなってもらわないとな。\n伸びしろがある内は目一杯しごいてやらねぇと。", "face": "u908"}, {"name": "ノーマ", "text": "もっともっと強くなっちゃうのかぁ……。\nふふっ、私も訓練、手伝っちゃおうかしら。", "face": "u1047a1"}, {"name": "トゥアン", "text": "ん、最初は「人類のくせに」とか言ってなかったか？", "face": "u1006a1"}, {"name": "ノーマ", "text": "そ、それはそれよ！\n王子のこと、気に入ったんだからいいの！", "face": "u1047a1"}, {"name": "アンナ", "text": "――王子、天界との戦いは始まったばかりです。\nこれから先、どんな敵が待っているのかも分かりません。", "face": "l34d9eaa35f12"}, {"name": "アンナ", "text": "けれど、多くの仲間と共に、\nこれからも歩み続けましょう。\n――私たちの千年戦争を！"}]}], "active": true}