{"quest_id": 64, "name": "復讐者", "description": "謎の魔物の襲撃から\n住人達を守れ！", "event": "吸血鬼の花嫁", "event_category": "History", "mission_id": 920007, "map_no": 3782, "level": 80, "multiplier": 0.8, "charisma": 25, "exp": 140, "gold": 600, "drops": [{"item": 5002, "c": 1}, {"card": 72, "c": 1}, {"card": 6, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 512, "attack": 112, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 512, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 14}, {"enemy_id": 3, "source": "local", "count": 9, "form_index": 0, "form_count": 1, "hp": 512, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 22}, {"enemy_id": 4, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 5600, "attack": 240, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 31}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 240, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 64}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 512, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 69}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここです。\nこの集落ではこの数日、魔物たちの襲撃を\n受けており、中には見慣れない魔物もいるそうです。"}]}, {"trigger": "battle", "at_sec": 30, "lines": [{"name": "アンナ", "text": "これで終わりでしょうか。\nあっけないですね。"}, {"name": "ヴィンセント", "text": "油断するな……\nやつらが近づいてくる！", "face": "u103"}, {"name": "アンナ", "text": "誰ですかあなたは？\n「やつら」ってなんでしょうか？"}]}, {"trigger": "battle", "at_sec": 38, "lines": [{"name": "ヴィンセント", "text": "気を付けろ。\nそいつの牙には麻痺毒がある。\n攻撃を受け続けると体がしびれて動けなくなるぞ。", "face": "u103"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "何とか撃退できたみたいですね。\nあの見慣れない魔物はなんだったんでしょうか。"}, {"name": "ヴィンセント", "text": "やつらは「ヴァンパイア」だ。\nといっても、ヴァンパイアの中では最も下級で\nレッサーヴァンパイアと呼ばれる存在だ。", "face": "u103"}, {"name": "ヴィンセント", "text": "本物のヴァンパイアの召使、まがい物のような\nものだな……だが油断するなよ。\nタフで麻痺毒を持っている、近づかれたら厄介だ。", "face": "u103"}, {"name": "アンナ", "text": "いろいろと知っているみたいですね。\nもしかして、なぜヴァンパイアがここに現れたのかも\nご存じですか？"}, {"name": "ヴィンセント", "text": "やつらは迎えに来ているのさ……花嫁を。\nこの集落にヴァンパイアに血を吸われた女が\nいるはずだ。", "face": "u103"}, {"name": "カルマ", "text": "……", "face": "u105"}, {"name": "アンナ", "text": "貴方は？"}, {"name": "カルマ", "text": "私はカルマと申します。\n国を魔物に滅ぼされ、今は放浪の身……", "face": "u105"}, {"name": "カルマ", "text": "確かにそこの方がおっしゃるように数日前\nに黒い魔物に襲われ、血を吸われました。", "face": "u105"}, {"name": "ヴィンセント", "text": "永く生きたヴァンパイアは血を吸うことで\n自分の仲間を増やすことができる。\n残念だが、あんたはもう手遅れだ。", "face": "u103"}, {"name": "ヴィンセント", "text": "おそらく、もって２週間、はやければ数日で\nやつらの仲間だ。", "face": "u103"}, {"name": "ヴィンセント", "text": "化け物になる前に殺してやるぜ……", "face": "u103"}]}], "map": {"image": "Map920007_3782", "w": 960, "h": 640, "spots": [{"k": "b", "x": 886, "y": 296}, {"k": "m", "x": 717, "y": 308, "id": 200}, {"k": "m", "x": 583, "y": 303, "id": 201}, {"k": "m", "x": 566, "y": 221, "id": 202}, {"k": "m", "x": 498, "y": 201, "id": 203}, {"k": "m", "x": 419, "y": 191, "id": 204}, {"k": "m", "x": 335, "y": 187, "id": 205}, {"k": "m", "x": 262, "y": 226, "id": 206}, {"k": "m", "x": 522, "y": 408, "id": 207}, {"k": "m", "x": 445, "y": 415, "id": 208}, {"k": "m", "x": 369, "y": 412, "id": 209}, {"k": "m", "x": 281, "y": 362, "id": 210}, {"k": "m", "x": 238, "y": 287, "id": 211}, {"k": "m", "x": 148, "y": 270, "id": 212}, {"k": "r", "x": 657, "y": 262, "id": 300}, {"k": "r", "x": 627, "y": 376, "id": 301}, {"k": "r", "x": 501, "y": 271, "id": 302}, {"k": "r", "x": 415, "y": 241, "id": 303}, {"k": "r", "x": 337, "y": 258, "id": 304}, {"k": "r", "x": 343, "y": 312, "id": 305}, {"k": "r", "x": 413, "y": 343, "id": 306}, {"k": "r", "x": 495, "y": 339, "id": 307}, {"k": "r", "x": 538, "y": 159, "id": 308}, {"k": "r", "x": 462, "y": 142, "id": 309}, {"k": "r", "x": 387, "y": 135, "id": 310}, {"k": "r", "x": 298, "y": 137, "id": 311}, {"k": "r", "x": 195, "y": 209, "id": 312}, {"k": "r", "x": 391, "y": 471, "id": 313}, {"k": "r", "x": 245, "y": 413, "id": 314}, {"k": "r", "x": 199, "y": 361, "id": 315}]}, "start_cost": 5, "active": true, "story_talk": true}