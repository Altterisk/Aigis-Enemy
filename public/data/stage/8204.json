it": 30, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130944, "race_id": 2, "change_to": 10, "change_condition": 1, "missile_id": 608, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34092, "global_id": 7709, "ranged": true, "variants": [{"hp": 6500, "attack": 600, "base_hp": 6500, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 30, "attack_wait": 20, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130960, "race_id": 2, "master_id": 34093, "global_id": 7710}], "spawn_sec": 64}, {"enemy_id": 12, "source": "local", "count": 38, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_range": 200, "attack_speed": 90, "attack_wait": 10, "attack_interval": 70, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2140208, "race_id": 2, "special_effect_id": 234, "change_to": 12, "change_condition": 1, "missile_id": 45, "master_id": 35320, "global_id": 8937, "ranged": true, "variants": [{"hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 157, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2140224, "race_id": 2, "special_effect_id": 621, "master_id": 35321, "global_id": 8938}], "spawn_sec": 73}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130992, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34095, "global_id": 7712, "ranged": true, "spawn_sec": 164}], "popups": ["雷竜クロコが生み出す飛翔する雷棘は\n拠点に向かわず、\n討伐数に含まれません。\nまた、遠距離攻撃で破壊が可能です。\n\n雷竜クロコを撃破すると\n以降、飛翔する雷棘は\n生み出されません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "クロノシア", "text": "――それでは、始めます。\nレーヴちゃん、タイミングをあわせてください。", "face": "u1986a1"}, {"name": "レーヴ", "text": "はいっ、こちらは大丈夫です！", "face": "u454"}, {"name": "クロノシア", "text": "ここから先は、夢の中に再現された戦場。\nその中で戦う皆さんからすれば、現実そのものの光景です。", "face": "u1986a1"}, {"name": "クロノシア", "text": "痛みも、恐怖も、記憶も、\nすべてが本物のように感じられるでしょう。\nここが夢だと、気付けないほどに。", "face": "u1986a1"}, {"name": "レーヴ", "text": "……記憶を再生します。\n工業都市奪還戦直後、竜将クロコを退けた時から――", "face": "u454"}]}, {"trigger": "start", "lines": [{"name": "クロコ", "text": "――その力は、怒りカ。\nソレホドまでに大切な民ナラバ、\n鳥籠にデモ閉じ込めて、飾っておけばいいモノヲ。", "face": "lc6a487316ae7"}, {"name": "白の皇帝", "text": "その口、二度と利けぬようにしてやろう。\nまさか逃げるつもりはないだろう？", "face": "u418"}, {"name": "クロコ", "text": "然り。こちらにも退けぬ理由がアル。\nいずれ終焉ヲ迎えるコノ大地で、\n竜神の血を残すタメに――", "face": "lc6a487316ae7"}, {"name": "竜人戦士", "text": "オヤメください！\nクロコ様、今のお身体デハ、\n雷竜の力に耐えきれマセヌ！！", "face": "u95"}, {"name": "クロコ", "text": "構わヌ。\n遥かな高みに至ろうと言うノダ。\nこの命ナド、とうの昔に捨ててイル。", "face": "lc6a487316ae7"}, {"name": "白の皇帝", "text": "その言葉、撤回できぬものと思え。\n行くぞ、竜将クロコ――！！", "face": "u418"}]}, {"trigger": "battle", "at_sec": 16, "lines": [{"name": "クロコ", "text": "雷ヨ、真なる雷霆ヨ、\n今こそ我が身を貫きタマエ！！", "face": "lc6a487316ae7"}]}, {"trigger": "battle", "at_sec": 20, "lines": [{"name": "アーニャ", "text": "竜神の祖、最初のドラゴン……。\nあれが、あの姿が……？", "face": "u99"}, {"name": "ヴルム", "text": "全然力の制御ができてないみたいだけどね。", "face": "u527"}, {"name": "エルドラ", "text": "むしろ制御できてない力の方が怖いですわ！\n王子さま、気をつけてくださいな！！", "face": "u549"}]}, {"trigger": "end", "lines": [{"name": "クロコ", "text": "…………ここ、まで、か。", "face": "lc6a487316ae7"}, {"name": "ハルモニア", "text": "クロコ様……いえ、竜将クロコ。\nなぜここまでして、雷竜を目指すのですか。", "face": "u941"}, {"name": "クロコ", "text": "ハルモニア、カ……。\n竜ナラザルお前ニハ、理解ナドできまい……。", "face": "lc6a487316ae7"}, {"name": "クロコ", "text": "何かヒトツを過てば……世界ナド容易く滅ぶ……。\n人の世は終わる……ダガ、竜人、ハ――", "face": "lc6a487316ae7"}, {"name": "白の皇帝", "text": "……トドメは必要か？", "face": "u418"}, {"name": "クロコ", "text": "不要、ダ。\n竜の世に、情けナド必要ナイ……。", "face": "lc6a487316ae7"}, {"name": "クロコ", "text": "…………。", "face": "lc6a487316ae7"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "白の皇帝", "text": "……いずれ、現実でもこうしてやろう。", "face": "u418"}, {"name": "白の皇帝", "text": "人の世は終わらない。\n犠牲になった者たちの名は、\n未来永劫、この地の子どもたちに語り継がれるのだから。", "face": "u418"}]}], "active": true}