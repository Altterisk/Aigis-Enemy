t": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2120192, "special_effect_id": 433, "master_id": 32038, "global_id": 5657, "from_condition": 2}, {"enemy_id": 53, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102752, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 394, "global_id": 393, "ranged": true, "spawn_sec": 457}, {"enemy_id": 54, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 500, "base_hp": 2800, "base_attack": 500, "damage_type": "magical", "armor_defense": 700, "magic_defense": 40, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 241, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102800, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 397, "global_id": 396, "ranged": true, "spawn_sec": 465}, {"enemy_id": 55, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 3500, "attack": 700, "base_hp": 3500, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101280, "master_id": 267, "global_id": 266, "spawn_sec": 485}, {"enemy_id": 56, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 3500, "attack": 550, "base_hp": 3500, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 200, "attack_speed": 90, "attack_wait": 60, "attack_interval": 157, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103824, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 480, "global_id": 479, "ranged": true, "spawn_sec": 495}], "popups": ["ゴブリン騎獣楽団がいる間は\n敵のゴブリンの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ナナリー", "text": "――あ、あれ……？　ここは……？", "face": "u29"}, {"name": "ディーナ", "text": "飛空船で城に突っ込んだところまでは\n覚えてるけど、\nこの風景はいったいどういうことだ？", "face": "u22"}, {"name": "クリッサ", "text": "果ての見えない暗闇に、\n支えもなく浮いている構造物……。\nもしかして、ここが魔王城……？", "face": "u52"}, {"name": "異界召喚士", "text": "――キヒ。\nお前達が侵攻してくることは既に知っておった。\nならば出迎えてやるのが当然じゃろう。", "face": "l7b1f4704ba1a"}, {"name": "クロコ", "text": "お前達ハ罠に掛かっタということダ。\n物質界最後ノ戦力たる王子タチよ。", "face": "ld3f4651f95a1"}, {"name": "メカゴブリンクイーン", "text": "あらぁ……？\nでも白の皇帝ちゃんが見えないわね……。\nまさか尻尾を巻いて逃げ出したのかしら？", "face": "le10a6d9788ec"}, {"name": "ガオレオン", "text": "リングに上がらぬ者に勝利はないッ！\nだがあの猛者が逃げるとも思えぬ、\nおそらくは策を弄しているのだろうッ！", "face": "lc0efcabbf44a"}, {"name": "クラールフ", "text": "……然様。溺れる者は母なる海を忘れたが、\nそれと引き換えに多くの智慧を得た。\n各々、油断をするでないぞ。", "face": "ld38e902ab834"}, {"name": "デシウス", "text": "……だが、邪魔が入らぬのは実に良い。\n元より王子達こそが、魔王様に反抗する最後の灯火。", "face": "l4675fa259dcc"}, {"name": "デシウス", "text": "ならば、ここでその火を消すことが、\n魔王様が道行を正しく果たすための、\n最大の武功となることだろう！", "face": "l4675fa259dcc"}, {"name": "ディーナ", "text": "……魔王軍幹部が勢揃いとは。\nどうやら本気で、\nここで決着をつけるつもりみたいだな。", "face": "u22"}, {"name": "クロコ", "text": "覚悟はデキテいるようダナ。\n魔王様の手を煩わセるまでもナイ。\nここデ、物質界最後の戦力を刈り取ルとしヨウ。", "face": "ld3f4651f95a1"}, {"name": "イリス", "text": "そんなことは、絶対にさせません。\n私達はここへ、死ぬために来たのではなく、\n世界を救うために来たのですから。", "face": "u17"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、この戦力を見て、\nまだそんな口が利けるのかしら？\n蛮勇を超えて、もはや無謀と言うべきね。", "face": "le10a6d9788ec"}, {"name": "シビラ", "text": "無謀な戦いを、いつも塗り替えてきたのは誰なのか。\n幾度も刃を交えてきた、\nあなた達ならよく知っているはず。", "face": "u39"}, {"name": "シビラ", "text": "絶対に乗り越えられない壁を、\n常に打ち破り、答えを導き出してきたのが、\n果たして誰だったのかを。", "face": "u39"}, {"name": "デシウス", "text": "……知っているとも。だが！\n我輩がこの生の最後に望むのは王子との闘争。\n生きた証を焼き尽くす戦いのみだ！！", "face": "l4675fa259dcc"}, {"name": "アンナ", "text": "王子、魔王軍幹部の連合軍が来ます！\nおそらくは総力戦となります。\nどうか、物質界の為に勝利を！", "face": "lae6f900356a5"}]}, {"trigger": "battle", "at_sec": 79, "lines": [{"name": "異界召喚士", "text": "キヒィ！　所詮は悪あがき、\n行くぞ物質界最後の抵抗勢力どもよ！", "face": "l7b1f4704ba1a"}, {"name": "デスピア", "text": "いくつもの世界を引っ掻き回しただけでなく、\n自分の弟子にあんな酷いことをするなんて。", "face": "u49"}, {"name": "デスピア", "text": "異界召喚士、同じ魔の道を歩む者として、\nあなたを許すわけにはいきません。", "face": "u49"}, {"name": "異界召喚士", "text": "大口を叩けるのもここまでじゃ！\n異界より来たれ、我が配下よ……っ！！", "face": "l7b1f4704ba1a"}]}, {"trigger": "battle", "at_sec": 142, "lines": [{"name": "メカゴブリンクイーン", "text": "――ここまで、何度戦ってきたのかしらね。\n王国は何度も私達の邪魔をして……。", "face": "le10a6d9788ec"}, {"name": "レヴィ", "text": "……そうだね。\nでも、それもここで終わりだよ。", "face": "u328"}, {"name": "メカゴブリンクイーン", "text": "お前は……そう、私に復讐をしにきたのね。\nでもそれは決して叶わない。\n王子諸共、ここでトドメを刺してあげるわぁ！", "face": "le10a6d9788ec"}, {"name": "レヴィ", "text": "トドメを刺されるのは、あなたの方。\nわたしはもう、絶対に負けない。\nわたしには王子がいるんだから。", "face": "u328"}, {"name": "レヴィ", "text": "――行くよ、ママ。", "face": "u328"}]}, {"trigger": "battle", "at_sec": 227, "lines": [{"name": "ガオレオン", "text": "フハハハッ！　とうとうこの時が来たッ！\nこの世界のファイナルマッチであるッ！", "face": "lc0efcabbf44a"}, {"name": "マンモン", "text": "さぁて、それはどうかしらぁ？\n人はどこまでも強欲なものよ。\n滅びを前にして、諦めることなどできるかしら？", "face": "u767"}, {"name": "ガオレオン", "text": "笑止ッ！　諦めぬというのなら、\nチャンピオンたる我が自ら引導を渡すのみよッ！！", "face": "lc0efcabbf44a"}, {"name": "マンモン", "text": "それなら、かかっていらっしゃい。\nどこまでも栄光と勝利に強欲ながおがおちゃん！", "face": "u767"}]}, {"trigger": "battle", "at_sec": 293, "lines": [{"name": "クラールフ", "text": "――ずっと、考えていたのだ。\n真に守るべきものが何なのか。", "face": "ld38e902ab834"}, {"name": "シャディア", "text": "……クラールフ殿。\nその答えは出たのですか。", "face": "u713"}, {"name": "クラールフ", "text": "――否。かつて守ったこの世界が、\nこうして滅びゆく様を見てもなお、\nどちらが正解なのか分からぬままだ。", "face": "ld38e902ab834"}, {"name": "シャディア", "text": "では何故、私達と相対しているのですか。", "face": "u713"}, {"name": "クラールフ", "text": "――気付いたから、だとも。\nガリウスめが神の一柱である以上、\n溺れる民たるお前達が手を伸ばした物にな。", "face": "ld38e902ab834"}, {"name": "シャディア", "text": "――ッ！\nあなたはこちらの秘策に気付いて……！！", "face": "u713"}, {"name": "クラールフ", "text": "はて、何のことだろうか……。\nさぁ、世界の担い手たるは何れか、\nその実力をもって示すが良い！", "face": "ld38e902ab834"}]}, {"trigger": "battle", "at_sec": 328, "lines": [{"name": "クロコ", "text": "――ホウ、未ダ諦めナイのか。\nだが、ここデその抵抗も終わりダ。", "face": "ld3f4651f95a1"}, {"name": "ゴライア", "text": "ケッ、竜人族ノ恥晒しが良く吠えるゼ！", "face": "u385"}, {"name": "クロコ", "text": "――ゴライア。\nその不屈の闘志ダケは認めてヤロウ。\nダガ、此度の戦いは最早児戯ではナイ。", "face": "ld3f4651f95a1"}, {"name": "ゴライア", "text": "ウルセェ！　テメェと会話スルつもりはねェんだよ！\n今日は決着ヲつけに来たんだからナァ！！", "face": "u385"}, {"name": "ゴライア", "text": "人間もなァ、悪いヤツばかりじゃねェ。\n物質界だってそういうもんダ。\n行くぞベルナ、この馬鹿に理解させてヤレ！", "face": "u385"}, {"name": "ベルナ", "text": "もっちろん！\n行くよゴライア、勝利を盗んであげるから！", "face": "u46"}]}, {"trigger": "battle", "at_sec": 392, "lines": [{"name": "デシウス", "text": "――とうとう、この時が来たか。\n随分と、遠回りをしてきた気がするものだ。", "face": "l4675fa259dcc"}, {"name": "デシウス", "text": "王子軍には、我輩が迷惑をかけた者もいたな。\n今はただ、済まなく思っている。", "face": "l4675fa259dcc"}, {"name": "デシウス", "text": "そしてヘイオス、ミーティア、シャディアよ。\n我輩の勝手に付き合わせて、済まなかった。", "face": "l4675fa259dcc"}, {"name": "ヘイオス", "text": "デシウス、望んだ道は貫けましたか？", "face": "u915"}, {"name": "デシウス", "text": "うむ。回り道ではあったがな。\n我らの故郷の仇を討ち、\nそして今は、望んでこの場所に至った。", "face": "l4675fa259dcc"}, {"name": "ミーティア", "text": "……星の声は、聞こえるようになった？", "face": "u280"}, {"name": "デシウス", "text": "ヌゥ、それが皆目聞こえぬままだ。\n師には顔向けできぬなぁ。", "face": "l4675fa259dcc"}, {"name": "シャディア", "text": "短き間ではあったが、かけがえなき友よ。\n――どうか、お前にとって悔いなき戦いを。", "face": "u713"}, {"name": "デシウス", "text": "うむ。これ以上は、どれだけ待ってもありえまい。\nシャディアよ、どうか友として、\n我輩の最後の戦いを見届けてほしい。", "face": "l4675fa259dcc"}, {"name": "王子", "text": "――来い、デシウス。\n俺達の戦いに、ここで決着をつけよう。", "face": "u1"}, {"name": "デシウス", "text": "――応ッ！！", "face": "l4675fa259dcc"}]}, {"trigger": "end", "lines": [{"name": "異界召喚士", "text": "キ、キヒィッ！？\n何故だ！？　なぜこれ程の力をぉ！？", "face": "l7b1f4704ba1a"}, {"name": "異界召喚士", "text": "こうなれば魔力を注ぎ込んで、\n新たな異界の門を……弟子よ！　どこにおる！？", "face": "l7b1f4704ba1a"}, {"name": "エマ", "text": "――あの子は来ませんよ。\nあなたに待っているのは、暗き死後の旅路のみ。", "face": "u582"}, {"name": "異界召喚士", "text": "ヒッ！？\nや、やめ――ぎぃやぁあぁあぁぁぁぁッ！？", "face": "l7b1f4704ba1a"}, {"name": "クロコ", "text": "……惨めなものダ。\nソウカ……これが、敗北カ……。", "face": "ld3f4651f95a1"}, {"name": "ガオレオン", "text": "そうか……我は、とうとう負けたのだな……。", "face": "lc0efcabbf44a"}, {"name": "ゴライア", "text": "ケッ、出直しテきやがれ！\nテメェらの戯言に付き合ってル暇はねェんだよ！", "face": "u385"}, {"name": "メカゴブリンクイーン", "text": "まだよ……まだ……私は……。", "face": "le10a6d9788ec"}, {"name": "クラールフ", "text": "……やめておけ、ゴブリン族が女王よ。\nそして行くが良い、溺れる者達よ。\n母なる海を忘れた、地上に生きる者達よ。", "face": "ld38e902ab834"}, {"name": "クラールフ", "text": "この者らに、未だ忠義があるようであれば、\n我が足止めをしておこう。", "face": "ld38e902ab834"}, {"name": "シャディア", "text": "クラールフ殿……！", "face": "u713"}, {"name": "クラールフ", "text": "シャディアよ、ゆめゆめ忘れるなかれ。\nこれはこやつらに恥を重ねさせぬためだ。\n溺れる者らの味方をするわけではない。", "face": "ld38e902ab834"}, {"name": "デシウス", "text": "おぉ……我輩の鎧が、砕けていく……。\nこれが……全てを焼き尽くし\n歩み続けてきた、我輩の最期か……。", "face": "l4675fa259dcc"}, {"name": "デシウス", "text": "王子よ、嗚呼、我が終生の好敵手よッ！！\n聖槍を担い、魔王を名乗る神を討て！\n我輩の生きた証をッ！　お前が歴史に刻んでくれッ！！", "face": "l4675fa259dcc"}, {"name": "王子", "text": "……ああ。\nお前が守りたかった世界は、必ず俺が守り続けていく。", "face": "u1"}, {"name": "アンナ", "text": "王子、先を急ぎましょう。\n白の帝国も、そろそろ合流するはずです。", "face": "lae6f900356a5"}, {"name": "アンナ", "text": "魔王を倒し、千年戦争を終わらせましょう。\n私達の長きに渡る戦いを。", "face": "lae6f900356a5"}]}, {"trigger": "end", "lines": [{"name": "デシウス", "text": "――嗚呼、星の声が聞こえる。\n何と美しい、調べなのだろうか……。", "face": "l4675fa259dcc"}, {"name": "デシウス", "text": "…………。", "face": "l4675fa259dcc"}, {"name": "デシウス", "text": "………………。", "face": "l4675fa259dcc"}, {"name": "デシウス", "text": "……………………。", "face": "l4675fa259dcc"}, {"name": "デシウス", "text": "ム……？", "face": "l4675fa259dcc"}]}], "active": true}