: 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105472, "race_id": 6, "special_effect_id": 73, "missile_id": 151, "missile": {"speed": 3.0}, "master_id": 650, "global_id": 649, "ranged": true, "spawn_sec": 202}, {"enemy_id": 26, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 2100, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 67, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2140544, "race_id": 16, "special_effect_id": 230, "change_to": 26, "master_id": 36683, "global_id": 10300, "variants": [{"tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 2100, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 67, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2148496, "race_id": 16, "special_effect_id": 230, "change_to": 28, "master_id": 36685, "global_id": 10302}, {"tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 2100, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 67, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2148480, "race_id": 16, "special_effect_id": 230, "change_to": 27, "master_id": 36686, "global_id": 10303}], "sp_change_to": [36685, 36686], "route_behaviour": {"transforms": [{"to": 36685, "wait": 120}, {"wait": 30}]}, "spawn_sec": 239}, {"enemy_id": 30, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 1, "base_hp": 1, "damage_type": "magical", "armor_defense": 1500, "magic_defense": 50, "attack_speed": 1, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "pattern_id": 2148320, "race_id": 19, "change_to": 30, "change_condition": 2, "master_id": 36669, "global_id": 10286, "route_behaviour": {"sets_flags": [[114, 1, -1]]}, "spawn_sec": 239}], "popups": ["上位天使がいる間は\n全ての敵のHPが\n徐々に回復します。", "弓を持った上位天使は、\nHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "トゥアン", "text": "――要塞宮殿って言ってたが、\n中に入ってみれば、ただの城みたいだな。", "face": "u1006a1"}, {"name": "アキレア", "text": "ああ、まだ起動してないからな。\nどうにか間に合った、ってことだ。", "face": "u1972a1"}, {"name": "アージェ", "text": "……起動？\nこの宮殿には、何か仕掛けがあるということですか？", "face": "u1090a1"}, {"name": "ゴブリン博士", "text": "『――ピピーッ、ガガガッ。\n王――子！　聞こえルか！？』", "face": "l410ff470c8dd"}, {"name": "フローガ", "text": "外のゴブリン博士から通信のようです。\n魔術ギルドの通信網に割り込むとは……。\nもしもし？　どうしましたか？", "face": "u878"}, {"name": "ゴブリン博士", "text": "『気をツケヨ！　要塞宮殿ガ――飛翔してイル！！』", "face": "l410ff470c8dd"}, {"name": "ソラス", "text": "飛翔……？　きゃっ！？\n地面が揺れて……いえ、本当に飛んでいる！？", "face": "u904"}, {"name": "イヴリール", "text": "おいおい、今度は空に航海か？", "face": "u1959a1"}, {"name": "ラーワル", "text": "いや、喜んでいる場合じゃないよ！\n僕はともかく、皆どうやって戻れば――", "face": "u1369a1"}, {"name": "ディアス", "text": "――ほう、もう余を倒し、\n帰還する時のことを考えているのか。", "face": "l5dbd91ae8b23"}, {"name": "クロノシア", "text": "あなたを、止めに来ましたよ。\n愚かな亜神、迷える雷霆、ディアスよ。", "face": "u1986a1"}, {"name": "ディアス", "text": "迷っていたのは、お前も同じだろう。\n己が身に与えられし、時の権能に恐れをなし、\n自ら封印されることを選んだ時の女神よ。", "face": "l5dbd91ae8b23"}, {"name": "クロノシア", "text": "その迷いも、今日までです。\nあなたの計画を、看過することはできません。", "face": "u1986a1"}, {"name": "ディアス", "text": "なぜ、と問うてやろう。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "人は、愚かなものだ。\n戦いを繰り返し、誰かを傷つけ、\n成長とは名ばかりの争いを繰り返す。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "その原因を、根本から消し去ろうというのだぞ。", "face": "l5dbd91ae8b23"}, {"name": "イコル", "text": "そのために、どれだけのものを犠牲にするつもりだ！", "face": "u1988a1"}, {"name": "イコル", "text": "お前の計画の邪魔になるものを、\nどれだけその手にかけた、いくつの命を奪った！", "face": "u1988a1"}, {"name": "ディアス", "text": "ほう……？\nお前はアスガルドの者を憎んでいたと思ったが。", "face": "l5dbd91ae8b23"}, {"name": "イコル", "text": "ああ、嫌いさ……。\nだけど……だから、\nそれを奪った貴様を、ぼくは許さない。", "face": "u1988a1"}, {"name": "ディアス", "text": "……ガリウスの影響か、\nあるいは人間と言葉を交わしすぎたのか。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "弱くなったな、亜神イコル。", "face": "l5dbd91ae8b23"}, {"name": "ハリンヘイム", "text": "――イコルは、弱くありません。\n本当にどうしようもない最低の亜神ですけど、\nでも、弱くありません。", "face": "u1854a1"}, {"name": "イコル", "text": "ハリンヘイム……？", "face": "u1988a1"}, {"name": "ディアス", "text": "実に哀れなものだ。\n弱き者同士で傷の舐め合いとは。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "だが、その憎しみも、悲しみも、\nあと少しで永遠に消え去る。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "お前たちを救ってやろう。\nようやく、クロノシアより奪った力も、\n身体に馴染み始めたところだ。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "創造神よ、あなたの生み出した世界を、\n今ここに、余が受け継ごう。", "face": "l5dbd91ae8b23"}]}, {"trigger": "end", "lines": [{"name": "ディアス", "text": "――まだだ。その程度ではあるまい！？", "face": "l696a98e27053"}, {"name": "王子", "text": "…………ッ！！", "face": "u309"}, {"name": "ディアス", "text": "お前の可能性を！\n人の未来を！　余に見せてみよ！", "face": "l696a98e27053"}, {"name": "ディアス", "text": "戦いの中で、貴様の力が増していくのが分かる。\n原因は何だ、あの娘の聖剣か？\n亜神どもの祈りか？　女神アイギスの加護か？", "face": "l696a98e27053"}, {"name": "ディアス", "text": "だが、それでも……なぜだ。\nそこまでの決意をもってなお、\nなぜ余に届かない。ここまで来れぬのだ。", "face": "l696a98e27053"}, {"name": "アキレア", "text": "…………ひい爺さん。", "face": "u1972a1"}, {"name": "ディアス", "text": "余に可能性を見せるのではなかったのか。\nさぁ、その刃を神に突き立ててみせるがいい！", "face": "l696a98e27053"}, {"name": "王子", "text": "…………俺は。", "face": "u309"}, {"name": "ディアス", "text": "……………もうよい。\n今、楽にしてやろう。", "face": "l696a98e27053"}, {"name": "ディアス", "text": "魔物によって故郷を失い、それでも抗い続けた者よ。\n余は、お前のような者たちをこそ、\n救ってやりたいと、そう思っていたのだ。", "face": "l696a98e27053"}, {"name": "ディアス", "text": "もう休め、楽になれ。\nお前の剣では、余に決して届かぬ。\nこの戦いをもって、それを、理解してしまった。", "face": "l696a98e27053"}, {"name": "ディアス", "text": "――この場にて、仲間たちと共に、\n永遠の停滞へといざなってやろう。", "face": "l696a98e27053"}, {"name": "ランシェ", "text": "……！！\n皆、逃げて――！！", "face": "u1957a1"}, {"name": "イコル", "text": "……っ、だめだ、間に合わない！", "face": "u1988a1"}, {"name": "ディアス", "text": "――人の時代は、これで終わりだ。", "face": "l696a98e27053"}, {"name": "王子", "text": "――ッ！！", "face": "u309"}]}, {"trigger": "end", "lines": [{"name": "ディアス", "text": "……余の雷霆を、防いだ、だと？", "face": "l696a98e27053"}, {"name": "ディアス", "text": "何だ、その力は。\nアイギスの神器――いや、女神の力は感じぬ。\n貴様の内より湧き上がる、この輝きは何だ！", "face": "l696a98e27053"}, {"name": "ディアス", "text": "神の力でも、神器でもない……。\nいや、魔力の増加すら感じられぬ。\n貴様、その力はいったい何なのだ……！！", "face": "l696a98e27053"}, {"name": "王子", "text": "――誓い、だ。", "face": "u1985a1"}, {"name": "王子", "text": "千の誓いが、千の約束が、\n過去のすべてが、俺を支えてくれている。", "face": "u1985a1"}, {"name": "アンナ", "text": "……！\nエインヘリヤルが、\n私に何かを語りかけてきます。", "face": "l3377ec8b0efa"}, {"name": "シビラ", "text": "……フラガラッハが、震えてる。\nきっと、エインヘリヤルと同じことを伝えたいのね。", "face": "u1981a1"}, {"name": "シビラ", "text": "王子の誓いは、ただひとりのものじゃない。\n現在、過去、未来、すべての時代に生きた、\n戦士たち全ての誓いが、いま、ここにある。", "face": "u1981a1"}, {"name": "ディアス", "text": "……ただの、意志の力だと、いうのか。\nただ人の意志を束ねただけの力だと！\nありえない……否、これは――", "face": "l696a98e27053"}, {"name": "クロノシア", "text": "アンナさん、あなたが神獣との縁を、\n複雑に絡み合った\n可能性の糸からつかみとったように――", "face": "u1986a1"}, {"name": "クロノシア", "text": "――王子はいま、過去の全てを力としているの。\nだからこそ、世界が応えてくれた。", "face": "u1986a1"}, {"name": "クロノシア", "text": "この世界は創造神の生み出したもの。\n諦めない彼の意志が、世界を少しだけ、書き換えた。", "face": "u1986a1"}, {"name": "王子", "text": "――大神ディアス、この世界は、貴様には渡さない。", "face": "u1985a1"}, {"name": "ディアス", "text": "ああ、認めよう……。\n貴様こそ、余を殺す者だ！！", "face": "l696a98e27053"}, {"name": "ディアス", "text": "その刃は神をも殺しうる！\nその可能性は、世界すら斬り裂くだろう！！", "face": "l696a98e27053"}]}, {"trigger": "end", "lines": [{"name": "ディアス", "text": "だが――余もまた、世界を担う義務があるッ！！", "face": "l696a98e27053"}, {"name": "トゥアン", "text": "ディアス、何をするつもりだ！？", "face": "u1006a1"}, {"name": "アキレア", "text": "…………神の雷霆だ！\n地上全域に放つはずだった雷撃を、\n王子ひとりにぶっ放すつもりだ、あいつ！！", "face": "u1972a1"}, {"name": "ディアス", "text": "王子よ、貴様の物語は、ここで終わる！！", "face": "l696a98e27053"}, {"name": "ケラウノス", "text": "――いいえ、物語は続きます。", "face": "lca7fc09f3c3b"}]}, {"trigger": "end", "lines": [{"name": "ディアス", "text": "なっ……ケラウノス、なぜ――", "face": "l696a98e27053"}]}, {"trigger": "route", "lines": [{"name": "ディアス", "text": "――耐えてみせるか、人間ごときが！", "face": "l5dbd91ae8b23"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "王子", "text": "ディアス、なぜ笑う。", "face": "u1"}, {"name": "ディアス", "text": "笑っている、のか、余が。\nククッ……そうか、なるほど、これは喜びか。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "余は、いま、確かに歓喜している。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "嘆き、恨み、殺し、奪い合うのみの人類が、\n本当に創造神の被造物であるのかと、\nこれまで、ただただ疑問に思っていた……。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "創造神ともあろう者が、\nこれほどまでに愚かな生命を生み出すものかと！", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "だが、これが輝きか。\n余の見たかった、信じたかったものか。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "愚かな被造物の中にも、\nほんの少しでも、輝けるものがあったか！", "face": "l5dbd91ae8b23"}, {"name": "シビラ", "text": "……だめっ、王子下がって！！", "face": "u1981a1"}, {"name": "ディアス", "text": "――だが、手遅れだ。\n貴様がどれだけ優れた魂を抱いていようと、\n種全ての愚行を、拭い去ることなどできはしない。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "見よ、これこそが真なる神の力。\n創造神を継ぐ、世界最後の神の力である。", "face": "l696a98e27053"}, {"name": "ユージェン", "text": "大神ディアス……。\nそうか、クロノシアの呪いを解いたのか！", "face": "u906"}, {"name": "クロノシア", "text": "……決して、油断しないでください。\n神の楔を生み出す権能を失してはいますが、\n今のディアスは亜神の域を超えた存在です。", "face": "u1986a1"}, {"name": "クロノシア", "text": "ですが、私は――この世界に流れる悠久の時は、\nあなたを信じます、王子。", "face": "u1986a1"}]}, {"trigger": "route", "lines": [{"name": "ディアス", "text": "――王子よ、余を殺す者はお前だけだ。\nそしてお前を殺すのも、余以外にありえまい！", "face": "l696a98e27053"}, {"name": "ディアス", "text": "どちらが神になるのか！\n創造神を継ぐのか！　お前の誓いを見せてみよ！！", "face": "l696a98e27053"}, {"name": "王子", "text": "――いいや、俺は神を継ぐつもりはない。", "face": "u1"}, {"name": "ディアス", "text": "……なに？", "face": "l696a98e27053"}, {"name": "王子", "text": "人に委ねれば、世界は滅びるのかもしれない。", "face": "u1"}, {"name": "王子", "text": "だが、誰かに委ねた世界もまた、\n人からすれば、滅びと変わらないものだ。", "face": "u1"}, {"name": "王子", "text": "――ならば俺は、人の抗い続ける意志を信じる。", "face": "u1"}, {"name": "ディアス", "text": "……良いだろう。\nそれほどまでに、人の可能性を信じるのであれば――", "face": "l696a98e27053"}, {"name": "ディアス", "text": "いつまで諦めずにいられるのか、見せてみよ。", "face": "l696a98e27053"}, {"name": "イコル", "text": "なんだ、この魔力は……。", "face": "u1988a1"}, {"name": "ハリンヘイム", "text": "これは……。\n……見たことが、あります。", "face": "u1854a1"}, {"name": "イコル", "text": "いったいどこで――まさか！？", "face": "u1988a1"}, {"name": "ハリンヘイム", "text": "アスガルドを焼き払った、魔力の奔流。\nあのときにそっくりです。\nこんなの……いったいどうしたら……。", "face": "u1854a1"}, {"name": "シビラ", "text": "心配しないで。\n今回は、不意打ちじゃない。\nこっちにも、いくつも対抗策がある。", "face": "u1981a1"}, {"name": "シビラ", "text": "もう二度と、何も、失わせはしないわ。", "face": "u1981a1"}, {"name": "ハリンヘイム", "text": "…………はい。\n手伝います。誰も、殺させません。", "face": "u1854a1"}, {"name": "バスティス", "text": "……あ、あし、ガクブルにゃ。\nこれだから戦いとか嫌いなのにゃ……。\nでも、でもぉ……頑張るにゃぁぁぁ。", "face": "u1892a1"}, {"name": "元始天尊", "text": "怖れることはありません。\nたかだか戦場全域の大火力攻撃です。", "face": "u1801a1"}, {"name": "バスティス", "text": "これだから脳筋きらいにゃぁぁぁぁ！！", "face": "u1892a1"}, {"name": "元始天尊", "text": "魔力の放出量が、あまりに多すぎます。\nこれならば、長時間持続することはないはず。\n――生き延びれば、反撃の好機が訪れます。", "face": "u1801a1"}, {"name": "イヨ", "text": "なんだ、簡単じゃん！\nつまり天墜神星さまの彗星を、\n何百発も耐えるようなものでしょ？", "face": "u1948a1"}, {"name": "ヒミコ", "text": "ふふっ、えぇ、確かに。\nタカマガハラの神々よ、私たちに、どうかお力を！", "face": "u1950a1"}, {"name": "ディアス", "text": "――その物語、この場にて終わらせてやろう。", "face": "l696a98e27053"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "ディアス", "text": "――届くのか、人の刃が。\n否……届かせたのか、王子よ、お前の意志が！", "face": "l5dbd91ae8b23"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "王子", "text": "ディアス、なぜ笑う。", "face": "u1"}, {"name": "ディアス", "text": "笑っている、のか、余が。\nククッ……そうか、なるほど、これは喜びか。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "余は、いま、確かに歓喜している。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "嘆き、恨み、殺し、奪い合うのみの人類が、\n本当に創造神の被造物であるのかと、\nこれまで、ただただ疑問に思っていた……。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "創造神ともあろう者が、\nこれほどまでに愚かな生命を生み出すものかと！", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "だが、これが輝きか。\n余の見たかった、信じたかったものか。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "愚かな被造物の中にも、\nほんの少しでも、輝けるものがあったか！", "face": "l5dbd91ae8b23"}, {"name": "シビラ", "text": "……だめっ、王子下がって！！", "face": "u1981a1"}, {"name": "ディアス", "text": "――だが、手遅れだ。\n貴様がどれだけ優れた魂を抱いていようと、\n種全ての愚行を、拭い去ることなどできはしない。", "face": "l5dbd91ae8b23"}, {"name": "ディアス", "text": "見よ、これこそが真なる神の力。\n創造神を継ぐ、世界最後の神の力である。", "face": "l696a98e27053"}, {"name": "ユージェン", "text": "大神ディアス……。\nそうか、クロノシアの呪いを解いたのか！", "face": "u906"}, {"name": "クロノシア", "text": "……決して、油断しないでください。\n神の楔を生み出す権能を失してはいますが、\n今のディアスは亜神の域を超えた存在です。", "face": "u1986a1"}, {"name": "クロノシア", "text": "ですが、私は――この世界に流れる悠久の時は、\nあなたを信じます、王子。", "face": "u1986a1"}]}], "active": true}