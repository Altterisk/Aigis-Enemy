{"quest_id": 7704, "name": "儚き夢", "description": "亜神ヒュープによって夢に囚われた王子。\n目の前の光景に違和感を覚えつつも、\n王国兵との手合わせを開始する。\n神級（★１獲得の目安：平均Lv50）", "event": "見果てぬ未来と叶わぬ夢", "event_category": "History", "mission_id": 920181, "map_no": 4143, "level": 110, "multiplier": 1.1, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 13200, "attack": 1650, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 50, "attack_wait": 50, "attack_interval": 205, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121840, "race_id": 16, "special_effect_id": 222, "master_id": 32527, "global_id": 6146}, {"enemy_id": 2, "source": "local", "count": 8, "form_count": 1, "hp": 2750, "attack": 770, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 51, "global_id": 50}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 13200, "attack": 880, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 700, "attack_speed": 1, "attack_wait": 10, "attack_interval": 58, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2126096, "race_id": 16, "master_id": 33540, "global_id": 7157}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 1, "hp": 2750, "attack": 550, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 70, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_i