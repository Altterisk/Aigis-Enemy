eed": 70, "attack_wait": 10, "attack_interval": 125, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113520, "race_id": 16, "change_to": 12, "master_id": 31231, "global_id": 4850, "to_global_id": 4419, "spawn_sec": 86}, {"enemy_id": 12, "source": "local", "count": 1, "level": 120, "form_index": 1, "form_count": 2, "hp": 9900, "attack": 495, "base_hp": 9000, "base_attack": 450, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 70, "attack_wait": 10, "attack_interval": 125, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113520, "race_id": 16, "special_effect_id": 222, "master_id": 30800, "global_id": 4419}, {"enemy_id": 14, "source": "local", "count": 12, "form_count": 1, "tags": ["アーマー"], "hp": 3080, "attack": 660, "base_hp": 2800, "base_attack": 600, "damage_type": "physical", "armor_defense": 1000, "attack_speed": 70, "attack_wait": 40, "attack_interval": 220, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101424, "race_id": 16, "master_id": 261, "global_id": 260, "spawn_sec": 86}, {"enemy_id": 15, "source": "local", "count": 12, "form_count": 1, "hp": 3300, "attack": 1100, "base_hp": 3000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097840, "race_id": 16, "master_id": 45, "global_id": 44, "spawn_sec": 87}, {"enemy_id": 16, "source": "local", "count": 12, "form_count": 1, "hp": 1980, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 150, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 52, "global_id": 51, "ranged": true, "spawn_sec": 87}, {"enemy_id": 17, "source": "local", "count": 12, "form_count": 1, "tags": ["アーマー"], "hp": 2200, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 200, "attack_range": 200, "attack_speed": 70, "attack_wait": 90, "attack_interval": 301, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100064, "race_id": 16, "missile_id": 13, "missile": {"speed": 5.0, "splash": 133}, "master_id": 214, "global_id": 213, "ranged": true, "spawn_sec": 87}], "dialogue": [{"trigger": "start", "lines": [{"name": "セーラ", "text": "――ソーマさん、もっとよく狙って。\nそれでは王子付きのメイドになれませんよ？", "face": "u346"}, {"name": "ソーマ", "text": "は、はいっ！\n――って、私なんかが王子付きなんて恐れ多いですよ！？", "face": "u23"}, {"name": "ロイ", "text": "おやセーラ殿。\nソーマ殿の弓の訓練ですかな？", "face": "u11"}, {"name": "セーラ", "text": "えぇ、この後の模擬戦では、\n王室警護の訓練も兼ねて、\nメイドも参加することになっていますので。", "face": "u346"}, {"name": "ケイティ", "text": "王国は伝統的に、\nメイドが簡単な身辺警護も兼ねていますからね。", "face": "u114"}, {"name": "シビラ", "text": "ふふ、英雄王の時代からの名残ね？", "face": "u39"}, {"name": "ケイティ", "text": "し、シビラ殿下！？\nどうしてこちらに！？", "face": "u114"}, {"name": "シビラ", "text": "どうしても何も、今回の演習は北の大国との合同でしょう。\nもちろん、部隊を率いて参加しにきたのよ？", "face": "u39"}, {"name": "ケイティ", "text": "まったく、心臓に悪いです……。\n殿下が参加するとは一言も聞いていませんでしたよ。", "face": "u114"}, {"name": "シビラ", "text": "これくらいで驚いていてどうするの。\nいくらこの数百年、\n王国の平和が続いているからと言っても――", "face": "u39"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "シビラ", "text": "あら、王子までどうしたの？\n王国も北の大国も、大きな戦争もなく、\nずっと豊かに繁栄を続けているじゃない。", "face": "u39"}, {"name": "王子", "text": "…………。\n………………。", "face": "u1"}, {"name": "セーラ", "text": "王子、気分がすぐれないようでしたら、\n次の模擬戦は陣幕で休んでいた方が……。", "face": "u346"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ミレイユ", "text": "体調が悪い時に無理をしてはいけませんよ。\nいくら国王陛下がご観覧になるからと言っても、\n張り切りすぎては怪我の元ですからね。", "face": "u386"}, {"name": "王子", "text": "…………？　父上が……？", "face": "u1"}, {"name": "ミレイユ", "text": "おや、突然元気になりましたね？\nそれでは、本番の前に\n少し身体を動かしておくとしましょうか。", "face": "u386"}]}, {"trigger": "end", "lines": [{"name": "クレイブ", "text": "騒がしいと思って来てみれば……。\nミレイユ、演習本番の前に何をしているのですか。", "face": "u8"}, {"name": "ミレイユ", "text": "おや、準備運動ですよクレイブ。\n王子も陛下が観覧すると聞いて、\nとてもやる気になっているようでしたし。", "face": "u386"}, {"name": "クレイブ", "text": "ああ……。\nしかし張り切りすぎは怪我の元で――", "face": "u8"}, {"name": "ソーマ", "text": "ふふっ、ミレイユさんと同じことを言ってますね♪", "face": "u23"}, {"name": "セーラ", "text": "えぇ。\nおふたりとも、王子の剣と槍の師匠ですからね。", "face": "u346"}, {"name": "ケイティ", "text": "ともあれ、元気を使い果たしていないようで何よりです。\nそれでは王子、演習場へ移動しましょうか。", "face": "u114"}, {"name": "クレイブ", "text": "おっと、そうでした。\n陛下も王子の戦いぶりを楽しみにしているそうですよ？", "face": "u8"}, {"name": "王子", "text": "…………っ。", "face": "u1"}, {"name": "ソーマ", "text": "王子？　どうしてそんな辛そうなお顔を――", "face": "u23"}, {"name": "レーヴ", "text": "――王子ッ！！\n目を覚ましてくださいッ！！", "face": "u454"}, {"name": "ソーマ", "text": "あれ？　あなたは……神殿の……？", "face": "u23"}, {"name": "レーヴ", "text": "ソーマさんも！\nって、ミレイユさんたちまで！？", "face": "u454"}, {"name": "レーヴ", "text": "うぅぅぅ、目が覚めているのは私だけみたいですね……。", "face": "u454"}, {"name": "ヒュープ", "text": "――むしろ驚きだよ。\n僕の夢の中で、\nまさか目覚めたままでいられる者がいるなんてね。", "face": "l08302fbc4106"}, {"name": "レーヴ", "text": "あいにくと、夢の中は慣れているんです。\n特にこういう酷い悪夢の中は。", "face": "u454"}, {"name": "ヒュープ", "text": "何が酷いものか、何が悪夢であるものか。\nこれは彼が望んだ、\n決して叶うことのない、過去の素敵な夢なんだよ？", "face": "l08302fbc4106"}, {"name": "ヒュープ", "text": "彼が、王子が望んでいたんだ。\n魔物も復活せず、両親も健在で、\n仲間たちと語らうこんな時間をね。", "face": "l08302fbc4106"}, {"name": "レーヴ", "text": "王子が……ずっと悔やんでいたことは、知ってます。\n誰だってこうだったらいいなって、夢くらい持ってます。", "face": "u454"}, {"name": "レーヴ", "text": "それでも、そういう夢は自分だけのものなんです。\n叶わなくても、大切に心の中に留めておくもので――", "face": "u454"}, {"name": "ヒュープ", "text": "覗き見て、再現して、閉じ込めて。\nそんなことはされたくない、とでも？", "face": "l08302fbc4106"}, {"name": "レーヴ", "text": "当たり前ですよ！\nもう決して叶わない願いを見せつけて、\n閉じ込めて、こんなの拷問じゃないですか！！", "face": "u454"}, {"name": "レーヴ", "text": "王子が夢の中で、どれだけ後悔してきたのか、\n私は知っています……。", "face": "u454"}, {"name": "レーヴ", "text": "それでも王子が立ち上がって、\n前に歩み続けてきた辛さも、\n私は……私たちは知っているんです……！", "face": "u454"}, {"name": "ヒュープ", "text": "君が何を言おうと、その声は届かないよ。\nどれだけ王子のことを想っていても、\n彼の心は、もはやこの夢に閉じ込められて――", "face": "l08302fbc4106"}, {"name": "王子", "text": "………………。", "face": "u1"}, {"name": "レーヴ", "text": "王、子……？", "face": "u454"}, {"name": "ヒュープ", "text": "まさか、目覚めたのか……？\n僕の作り出した夢から覚めたというのか……！？", "face": "l08302fbc4106"}, {"name": "王子", "text": "…………ありがとう、レーヴ。\nここからは、俺の戦いだ。", "face": "u1"}]}], "active": true}