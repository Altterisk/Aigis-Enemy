{"quest_id": 6190, "name": "死霊術師と反魂の至宝（記憶）", "description": "魔神ビフロンスの配下、リッチロードが\nメトゥスの魂を狙う。迫りくる死霊と\n戦う最中、現れた者とは……。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "戦場の記憶～追憶の章～", "event_category": "History", "mission_id": 920094, "map_no": 5225, "level": 80, "multiplier": 0.8, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 500, "base_hp": 15000, "base_attack": 500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104608, "missile_id": 6, "master_id": 30447, "global_id": 4066, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 10, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 240, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 6}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 640, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 14}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 2400, "attack": 480, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 30}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 3200, "attack": 400, "base_hp": 4000, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "attack_speed": 20, "attack_wait": 10, "attack_interval": 86, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102080, "race_id": 2, "master_id": 356, "global_id": 355, "spawn_sec": 57}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 2, "tags": ["アンデッド"], "hp": 1600, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104544, "special_effect_id": 222, "change_to": 6, "change_condition": 2, "missile_id": 6, "master_id": 30449, "global_id": 4068, "ranged": true, "to_condition": 2, "to_global_id": 4069, "spawn_sec": 71}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 2400, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 350.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104544, "special_effect_id": 64, "missile_id": 6, "master_id": 30450, "global_id": 4069, "ranged": true, "from_condition": 2}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 2240, "attack": 600, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 121}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 2400, "attack": 480, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "change_to": 9, "change_condition": 2, "master_id": 30448, "global_id": 4067, "to_condition": 2, "to_global_id": 4054, "spawn_sec": 142}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5040, "attack": 256, "base_hp": 6300, "base_attack": 320, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30435, "global_id": 4054, "from_condition": 2}], "popups": ["助手リッチは撃破されると、\nその場で復活し\nHPと攻撃力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "サヨ", "text": "次は……え、メトゥスさんの助手である\nリッチに頼まれて、彼女を助けにいった時の事？\n確かに、あの戦いも印象に残っている出来事ね。", "face": "u510"}, {"name": "サヨ", "text": "不死者であるメトゥスさんとは最初、敵対してたのよね。\nだけど、彼女の助手であるリッチが王子の許を訪れた。", "face": "u510"}, {"name": "サヨ", "text": "不死者を操る魔神ビフロンスから彼女を助けてくれ、と。\nそれで、不死者を人間に戻せる力をもつ宝玉、\n反魂の至宝を取りに出立したのよね。", "face": "u510"}, {"name": "バルバストラフ", "text": "――事態の深刻さは理解できたようじゃの。\n不死者のままいれば、ビフロンスに身も心も\n操られるのは時間の問題じゃ。", "face": "u63"}, {"name": "メトゥス", "text": "私は……。", "face": "u329"}, {"name": "アンナ", "text": "不死者のままだとビフロンスに魂を操られる、\nだけど人間に戻れば、いつか死んでしまう。\nメトゥスさん、すごく悩んでいます、王子……。", "face": "le02648efb8c0"}, {"name": "？？？", "text": "―――フフフ、悩む必要などありませんよ。", "face": "l55e2cdb9b27b"}, {"name": "リッチロード", "text": "私はビフロンス様の忠実なる配下の一人、\nリッチロード。主の命によりメトゥス様を\nお迎えにあがりました。", "face": "l55e2cdb9b27b"}, {"name": "メトゥス", "text": "追っ手を差し向けてまで魂を求めるなんてね。\nビフロンスも見る目はあるようじゃない。\nだけど、私の魂はそう安くないのよ。", "face": "u329"}, {"name": "リッチロード", "text": "苦悩、煩い、恐怖……あなたを取り巻く\n負の楔は、ビフロンス様への忠誠ひとつで、\nすべて取り除かれるものなのですよ？", "face": "l55e2cdb9b27b"}, {"name": "メトゥス", "text": "耳障りな台詞を並べ立てないでもらえるかしら？\nお喋りなリッチってキライなの……。\n私の魂がほしいなら、もぎ取ってみなさいよ。", "face": "u329"}, {"name": "リッチロード", "text": "仕方ありませんね……。\n我が主は私にこうも言っていました。", "face": "l55e2cdb9b27b"}, {"name": "リッチロード", "text": "『生死は問わぬ』とね。\n我が主ながら実にユーモアがある。\n不死者に生死を問わないとは……くくく。", "face": "l55e2cdb9b27b"}, {"name": "リッチロード", "text": "フフ、ビフロンス様より与えられた\nこの強大な力をもって、\n貴方達を殺し尽くして上げましょう。", "face": "l55e2cdb9b27b"}]}, {"trigger": "battle", "at_sec": 73, "lines": [{"name": "助手リッチ", "text": "コロス……人間ハ、ミナゴロシダ……。\n我ガ主ビフロンス様の御心のママニ……。", "face": "lbf9bf65fe371"}, {"name": "メトゥス", "text": "あなた達ッ！！　生きてたのね！？\nもうっ！　どれだけ心配させるのよ！\n少しだけだけど寂しかったのよ？", "face": "u329"}, {"name": "メトゥス", "text": "って、そうよね。魂が残っていれば\n何度だって蘇るのが不死者ですもの。\nあぁ、私ったらそんな単純なことを――。", "face": "u329"}, {"name": "助手リッチ", "text": "誰ダ、貴様ハ？\n死霊ガ……ナゼ人間に与スル？", "face": "lbf9bf65fe371"}, {"name": "メトゥス", "text": "――ッ！？　何を……言ってるの？\n私よ！　メトゥスよ！　あなたのマスター！\n……ほんとうに、覚えていないの？", "face": "u329"}, {"name": "助手リッチ", "text": "訳ノ分カラヌ事ヲ……。\n出来損ナイメ……コロシテヤル。\n役立タズノ不死者ナド必要ナイ……。", "face": "lbf9bf65fe371"}, {"name": "メトゥス", "text": "……うそよ。\nだって、あなたは私の死霊で。\n私はあなたのマスターで……こんなことって。", "face": "u329"}]}, {"trigger": "end", "lines": [{"name": "助手リッチ", "text": "――ぁぁ…ぁ…メトゥス様……有り難うございます。\n……お泣きになることは……ないのです……。\n貴方には……もう、沢山の、仲間……が……。", "face": "lbf9bf65fe371"}, {"name": "メトゥス", "text": "……今まで、ありがとう。\nそして、さようなら……。", "face": "u329"}, {"name": "サヨ", "text": "ビフロンスに魂を操られる事がないように……\n操られる苦しみから解放するために……\n彼女は、家族以上の存在だったリッチを消滅させた。", "face": "u510"}, {"name": "サヨ", "text": "……凄く、辛い決断だったと思うわ。", "face": "u510"}, {"name": "サヨ", "text": "わたしは、メトゥスさんが不死者として人々にしてきた\n罪過も見てきたわ。それは王子も同じハズ。\nそれでも、王子は彼女を受け入れた。", "face": "u510"}, {"name": "サヨ", "text": "清濁併せ呑む……それは同時に両方の敵対者と\n戦う事にもなりかねない道。", "face": "u510"}, {"name": "サヨ", "text": "王子の選択の結末、それを見届けるために\nわたしの戦いも続いていくわ。", "face": "u510"}]}], "active": true}