{"quest_id": 1910, "name": "深海への再訪", "description": "協力関係となった深海の王クラールフに\n会うため、海中を進む一行を敵が襲う。\n＜深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション10", "event_category": "Story", "mission_id": 100010, "map_no": 1130, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 23, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 15, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123728, "race_id": 7, "special_effect_id": 229, "missile_id": 232, "master_id": 32689, "global_id": 6307, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 10, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "spawn_sec": 19}, {"enemy_id": 3, "source": "local", "count": 17, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 35000, "attack": 800, "base_hp": 35000, "base_attack": 800, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 150, "attack_interval": 351, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124384, "race_id": 7, "special_effect_id": 232, "missile_id": 481, "missile": {"speed": 1.0}, "master_id": 34522, "global_id": 8139, "ranged": true, "spawn_sec": 49}, {"enemy_id": 4, "source": "local", "count": 11, "form_count": 2, "hp": 6000, "attack": 1500, "base_hp": 6000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106544, "race_id": 7, "change_to": 1, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 821, "global_id": 820, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 821, "spawn_sec": 69}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 5, "source": "local", "count": 9, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5250, "attack": 750, "base_hp": 5250, "base_attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 97, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123792, "race_id": 7, "missile_id": 45, "master_id": 32765, "global_id": 6383, "ranged": true, "spawn_sec": 130}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "master_id": 350, "global_id": 349, "spawn_sec": 152}, {"enemy_id": 7, "source": "local", "count": 14, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 7000, "attack": 750, "base_hp": 7000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 60, "attack_speed": 1, "attack_wait": 25, "attack_interval": 109, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2123760, "race_id": 7, "missile_id": 11, "master_id": 32691, "global_id": 6309, "ranged": true, "spawn_sec": 158}], "dialogue": [{"trigger": "start", "lines": [{"name": "海底都市の案内役", "text": "――王国の皆様、この海流に乗っていけば、\nすぐにクラールフ様の海底都市に到着ですわよ♪", "face": "u1062a1"}, {"name": "アンナ", "text": "案内ありがとうございます、リバンさん。\nおかげでここまで、\n大きなアクシデントもなくやって来れました。"}, {"name": "ピッキー", "text": "えぇっ、アクシデントだらけでしたよぉ！\n水中呼吸に慣れるの大変でしたし、\n今でもちょっと溺れちゃいそうですぅぅぅ……。", "face": "u671"}, {"name": "リバン", "text": "乾いた地の方々からすると、\n海巫女の秘術で水中呼吸ができるというのは\n不思議な感覚なのかもしれませんわね。", "face": "u1062a1"}, {"name": "リバン", "text": "でもピッキー様、最初に比べて\nとても泳ぎが上手になったと思いますわ♪", "face": "u1062a1"}, {"name": "ピッキー", "text": "えっ、そう見えます？　ふっふーん、\n実はクラールフさんとの定期会合に行くと聞いて、\nこっそり泳ぎの練習をしてきたんですよー！", "face": "u671"}, {"name": "シャディア", "text": "とはいえ、地上と比べて\n動きが鈍くなるのは仕方ないか……。\nこの『水圧』のせいで、体力も消耗しているしな。", "face": "u713"}, {"name": "ピッキー", "text": "あー、はしゃいでたら、\n確かにちょっとずつ体力が削れていっている気が……。", "face": "u671"}, {"name": "リバン", "text": "ふふふ、これからは深海と地上は\n手とヒレを取り合って歩んでいくのだと聞いています。\n今のうちに海中にも慣れておいてくださいまし。", "face": "u1062a1"}, {"name": "リバン", "text": "さてさて、そろそろ海底都市が見えてくる頃――\nって、あら……？\n何かがこちらに向かってくるような……？", "face": "u1062a1"}, {"name": "イブキ", "text": "ふむ、武装した魚人の部隊か。\nどうやら話し合いをしたいわけではないらしい。\n王子、迎撃準備をした方が良さそうだ。", "face": "u511"}, {"name": "ピッキー", "text": "お、王子の旦那ぁ！\n泳ぎはあっちに分があります。\n水中戦闘には十分注意してくださいねっ！！", "face": "u671"}, {"name": "イブキ", "text": "確かに、海底を歩かず泳いでくる連中を、\n正面から受け止めるのは難しいだろう。\n王子、遠距離から対処するよう心がけるんだ。", "face": "u511"}, {"name": "リバン", "text": "うぅ、安全な海路のはずだったのですけれど……。\n乾いた地の王子様、どうか力を貸してくださいまし！", "face": "u1062a1"}]}, {"trigger": "end", "lines": [{"name": "マーマン", "text": "――よし、威力偵察は完了した。\n各自迅速に撤退しろ。\nギガエル様に王子たちの情報を伝えるんだ。", "face": "l84dcfbcc054a"}, {"name": "イブキ", "text": "くっ……さすがは魚人か。\n水中での逃げ足は随分と速いようだ。", "face": "u511"}, {"name": "シャディア", "text": "リバン、確かこの海路は\n安全なはずだったと言っていたな？", "face": "u713"}, {"name": "リバン", "text": "は、はい。この海路は海底都市の、\n腕利きの衛兵隊が定期的に巡回していますから。", "face": "u1062a1"}, {"name": "シャディア", "text": "……その衛兵たちがいないというのも妙な話だ。\n王子、クラールフ殿の海底都市に\n何かが起きているのかもしれないぞ。", "face": "u713"}, {"name": "ピッキー", "text": "えぇぇっ、で、でもクラールフさんって\n元魔王軍幹部の超強いタコさんじゃないですか！\nき、きっと大丈夫ですよ、きっと！", "face": "u671"}, {"name": "シャディア", "text": "ピッキーの言うところの超強い元幹部が、\n敵が領海内を泳ぐことを許すと思うか？\n……どうやら、会合どころではないのかもしれないな。", "face": "u713"}, {"name": "リバン", "text": "そんな……急いで海底都市に戻らないと！\n他の魚人たちにも急いで救援要請を、\nそれからえっと、えぇとっ！　何をすれば……！？", "face": "u1062a1"}, {"name": "アンナ", "text": "落ち着いてください、リバンさん。\n増援ならここにいるのですから。"}, {"name": "リバン", "text": "えっ……て、手伝っていただけるのですか……？\n乾いた地の皆様は、大切なお客人だと\nクラールフ様から聞いていたのですが……。", "face": "u1062a1"}, {"name": "シャディア", "text": "客人である以前に、私たちは共に戦う仲間だろう。\n王子なんか、今にも駆け出してしまいそうだぞ。\nこの男は筋金入りのお人好しだからな。", "face": "u713"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "リバン", "text": "王子様……！！\n……ぐすっ、分かりましたわ。\n最短距離で海底都市までご案内いたしますっ！！", "face": "u1062a1"}, {"name": "アンナ", "text": "対天界に向けた定期会合という名目でしたが、\nやはり武装してきて正解でしたね。\n王子、急ぎ海底都市へ向かいましょう！", "face": "l8681a1bbb90b"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 18, "params": [160]}, {"kind": "term", "influence": 20, "params": [200]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 3000, "attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 15, "pattern_id": 2123728}, {"enemy_id": 2, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 3, "hp": 35000, "attack": 800, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "pattern_id": 2124384}, {"enemy_id": 4, "hp": 6000, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 4, "form_index": 1, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 5, "hp": 5250, "attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "pattern_id": 2123792}, {"enemy_id": 6, "hp": 10000, "attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "pattern_id": 2101936}, {"enemy_id": 7, "hp": 7000, "attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "pattern_id": 2123760}]}, "active": true}