0, "pattern_id": 2130752, "change_to": 12, "change_condition": 1, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 34040, "global_id": 7657, "ranged": true, "variants": [{"tags": ["アンデッド"], "hp": 11000, "attack": 900, "base_hp": 11000, "base_attack": 900, "damage_type": "magical", "armor_defense": 100, "attack_range": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 67, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2130768, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 34041, "global_id": 7658, "ranged": true}], "spawn_sec": 136}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 50000, "attack": 2900, "base_hp": 50000, "base_attack": 2900, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 30, "attack_wait": 50, "attack_interval": 209, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130720, "special_effect_id": 43, "change_to": 14, "change_condition": 1, "master_id": 34036, "global_id": 7653, "variants": [{"tags": ["アンデッド"], "hp": 50000, "attack": 2900, "base_hp": 50000, "base_attack": 2900, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 30, "attack_wait": 50, "attack_interval": 209, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130736, "special_effect_id": 43, "master_id": 34037, "global_id": 7654}], "spawn_sec": 170}], "popups": ["ヴァーニィの遠距離攻撃を\n複数回受けると、\n麻痺状態になります。\n\nまたヴァーニィは、\nブロックされている間\nHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ジュリア", "text": "ヴァーニィの身体が、崩れて――\nいえ、変異していく……？", "face": "u1583a1"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "ヴァーニィ", "text": "……私は、誇り高き、ヴァンパイアに……。\n姉さんのように……。", "face": "l177a204bb696"}, {"name": "エマ", "text": "…………ヴァーニィ、あなたは……。", "face": "u582"}, {"name": "シルヴィア", "text": "……とどめを、刺してあげましょう。\nこんな姿、誰にも見せたくないはずですもの。", "face": "u442"}, {"name": "エマ", "text": "どうして……私は、あなたを……。", "face": "u582"}, {"name": "ジュリア", "text": "エマさん！　お姉ちゃんなのでしょう！？\n最後の姿、ちゃんと見送ってあげてよ。", "face": "u1583a1"}, {"name": "エマ", "text": "…………。", "face": "u582"}, {"name": "ヴァンパイア公爵", "text": "――然り。\nこれにて、ヴァンパイアの王国全ての血脈は死に絶える。\nこれより先は、新たに紡がれる歴史となるのだ。", "face": "l5bec930041d8"}, {"name": "ヴァンパイア公爵", "text": "我が主君の最期……。\nそれを看取るのが王子とエマ様、\n姫殿下であるというのなら、これ以上は望むべくもない。", "face": "l5bec930041d8"}, {"name": "ヴァンパイア公爵", "text": "王子よ、我ら古きヴァンパイアの歴史、\n貴様がその手で、終わらせるのだ。", "face": "l5bec930041d8"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ラキュア", "text": "王子よ、ヴァーニィは\n無尽蔵に使い魔を生み出し続けている。\nためらう必要はない、本体を狙え。", "face": "u344"}, {"name": "ラキュア", "text": "ここで、ヴァンパイアの歴史を一度終わらせよう。\n次なる時代を紡ぐために。", "face": "u344"}]}, {"trigger": "end", "lines": [{"name": "ヴァーニィ", "text": "――やっと、終わるのか……。\nああ……永き生が……私の戦いが……。", "face": "l177a204bb696"}, {"name": "ジュリア", "text": "ヴァーニィ、だめよ……。\nだって、あなたにだって、本当は幸せな日々が……。", "face": "u1583a1"}, {"name": "ヴァーニィ", "text": "ありえまい、そんなもの……。\n私が失敗作であるという事実は変わらぬ……。", "face": "l177a204bb696"}, {"name": "村娘？", "text": "――いいや、お前は失敗作などではない。", "face": "l1c438cc348b3"}, {"name": "ヴァーニィ", "text": "小娘が何を……いや、この気配は、まさか……。", "face": "l177a204bb696"}, {"name": "村娘？", "text": "失敗作は、私の方だ。\n千年戦争を終え、人間になることを望み、\n最後の娘たるお前と、私の次の身体を作ったのだ。", "face": "l1c438cc348b3"}, {"name": "村娘？", "text": "しかし、私は失敗してしまった……。\n記憶を失ってしまったのだ。", "face": "l1c438cc348b3"}, {"name": "村娘？", "text": "私は、ひとりで人間になるのが怖かった。\nだからお前に、ヴァーニィに、\n一緒に生きていってほしかったのだ……。", "face": "l1c438cc348b3"}, {"name": "ヴァーニィ", "text": "そんな……嘘だ……。\nありえない……あなたが失敗するはずなど……。", "face": "l177a204bb696"}, {"name": "ジュリア", "text": "――それなら、あなたも失敗作じゃないはずよ。\n母君のこと、本当は信じたかったのでしょう？", "face": "u1583a1"}, {"name": "ヴァーニィ", "text": "…………。", "face": "l177a204bb696"}, {"name": "村娘？", "text": "ヴァーニィ、お前のおかげで、\nようやく私は、記憶を取り戻すことができた。", "face": "l1c438cc348b3"}, {"name": "村娘？", "text": "これからは、共に生きていこう。\nお前の身体は砕けてしまうが、\nその魂は、私とずっと共にあり続ける。", "face": "l1c438cc348b3"}, {"name": "村娘？", "text": "そしていつかの未来、\nもう一度、私の娘として、世界を歩む道連れとして、\nこの世界を歩んでくれないだろうか……？", "face": "l1c438cc348b3"}, {"name": "ヴァーニィ", "text": "……ああ、母様……リヴンお母さん……。\n私は……あなたと一緒に……。", "face": "l177a204bb696"}, {"name": "ジュリア", "text": "……消えちゃった。\nヴァーニィは、あなたの中にいるの……？", "face": "u1583a1"}, {"name": "リヴン", "text": "ああ、魂だけ、それもほんの一欠片だけだが……。\n――ジュリア、貴女には迷惑をかけてしまったな。", "face": "l1c438cc348b3"}, {"name": "ジュリア", "text": "……いいえ、迷惑だなんて。\nヴァーニィに操られなかったら、\n彼女の苦しみを、分かってあげることはできなかったもの。", "face": "u1583a1"}, {"name": "リヴン", "text": "きっと、この子の苦しみを、\n本当の意味で理解できたのは貴女だけだろう。", "face": "l1c438cc348b3"}, {"name": "リヴン", "text": "勝手な願いだが……どうか、\nこの子のことを、忘れないであげてほしい。", "face": "l1c438cc348b3"}, {"name": "リヴン", "text": "さようなら、ヴァーニィ。\nまたいつか、どこかで会おう。……必ず。", "face": "l1c438cc348b3"}]}], "active": true}