{"quest_id": 7724, "name": "永き夜の終わり", "description": "ジュリア、エマの想いは届かず始祖の血は\nヴァーニィの手に……。悲劇の吸血鬼に\n勝利し、血塗られた歴史に終止符を打て！\n神級（★１獲得の目安：平均Lv50）", "event": "永き後日談の終わり", "event_category": "History", "mission_id": 920182, "map_no": 4156, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "tags": ["アンデッド", "ステルスII", "ブロック不可"], "hp": 96000, "attack": 1400, "base_hp": 96000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 40, "attack_interval": 148, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2128160, "change_to": 1, "master_id": 35222, "global_id": 8839, "to_global_id": 8840, "route_behaviour": {"transforms": [{"wait": 210}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アンデッド", "ステルスII", "ブロック不可"], "hp": 96000, "attack": 1350, "base_hp": 96000, "base_attack": 1350, "damage_type": "physical", "armor_defense": 550, "magic_defense": 40, "attack_speed": 1, "attack_wait": 40, "attack_interval": 124, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2139424, "change_to": 2, "master_id": 35223, "global_id": 8840, "to_global_id": 8841}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アンデッド"], "hp": 96000, "attack": 900, "base_hp": 96000, "base_attack": 900, "damage_type": "magical", "armor_defense": 550, "magic_defense": 40, "attack_range": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 71, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2139440, "special_effect_id": 1123, "change_to": 3, "change_condition": 1, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 35224, "global_id": 8841, "ranged": true, "variants": [{"tags": ["アンデッド"], "hp": 96000, "attack": 1350, "base_hp": 96000, "base_attack": 1350, "damage_type": "true", "armor_defense": 550, "ma