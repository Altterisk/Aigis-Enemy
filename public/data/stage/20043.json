{"quest_id": 20043, "name": "廃棄区画の潜伏者", "description": "鋼の都の廃棄区画に潜伏する影。\n率いられし囚人や変異魔物を退け、 \n追い詰められた大佐を捕縛せよ！\n神級EX（★１獲得の目安：平均覚醒Lv25）", "event": "竜姫襲来", "event_category": "Emergency", "mission_id": 200588, "map_no": 7515, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 414000, "attack": 3200, "base_hp": 414000, "base_attack": 3200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 240, "attack_speed": 300, "attack_wait": 50, "attack_interval": 137, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173136, "race_id": 16, "change_to": 1, "change_condition": 1, "missile_id": 11, "master_id": 41188, "ranged": true, "variants": [{"hp": 414000, "attack": 2650, "base_hp": 414000, "base_attack": 2650, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 116, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173152, "race_id": 16, "master_id": 41189}]}, {"enemy_id": 3, "source": "local", "count": 30, "form_index": 0, "form_count": 1, "hp": 27000, "attack": 1000, "base_hp": 27000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 200, "attack_speed": 70, "attack_wait": 75, "attack_interval": 273, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158416, "race_id": 16, "master_id": 41191}, {"enemy_id": 4, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 350, "base_hp": 6000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 60, "attack_interval": 235, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000,