hp": 40000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 550, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119616, "race_id": 3, "special_effect_id": 410, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 41236, "ranged": true, "spawn_sec": 172}, {"enemy_id": 10, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["変異"], "hp": 150000, "attack": 1100, "base_hp": 150000, "base_attack": 1100, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 250, "attack_speed": 50, "attack_wait": 10, "attack_interval": 81, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119552, "race_id": 3, "special_effect_id": 407, "change_to": 10, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 41237, "ranged": true, "variants": [{"tags": ["変異"], "hp": 150000, "attack": 4300, "base_hp": 150000, "base_attack": 4300, "damage_type": "physical", "armor_defense": 350, "magic_defense": 70, "attack_speed": 50, "attack_wait": 30, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119568, "race_id": 3, "special_effect_id": 406, "master_id": 41238}], "spawn_sec": 205}, {"enemy_id": 12, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["変異"], "hp": 25000, "attack": 1800, "base_hp": 25000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 171, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115776, "special_effect_id": 311, "master_id": 41235, "spawn_sec": 208}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物"], "fixture": true, "uncounted": true, "hp": 414000, "attack": 3200, "base_hp": 414000, "base_attack": 3200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 300, "attack_wait": 50, "attack_interval": 437, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173824, "race_id": 16, "change_to": 13, "change_condition": 1, "missile_id": 11, "master_id": 41240, "variants": [{"hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 41241, "ranged": true}], "route_behaviour": {"hold": {"routes": 1, "held": 1}}, "spawn_sec": 345}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 97, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2167712, "race_id": 16, "master_id": 41197, "route_behaviour": {"hold": {"routes": 1, "held": 1}}, "spawn_sec": 345}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["置物"], "fixture": true, "uncounted": true, "hp": 452000, "attack": 2850, "base_hp": 452000, "base_attack": 2850, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 60, "attack_interval": 164, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173200, "race_id": 16, "special_effect_id": 2120, "change_to": 12, "change_condition": 1, "missile_id": 11, "master_id": 41239, "variants": [{"tags": ["置物"], "fixture": true, "uncounted": true, "hp": 414000, "attack": 3200, "base_hp": 414000, "base_attack": 3200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 300, "attack_wait": 50, "attack_interval": 437, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173824, "race_id": 16, "change_to": 13, "change_condition": 1, "missile_id": 11, "master_id": 41240}, {"hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 60, "attack_wait": 120, "attack_interval": 421, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097744, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 41241, "ranged": true}], "sp_change_to": [41201], "spawn_sec": 348}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ブロック不可"], "hp": 452000, "attack": 2850, "base_hp": 452000, "base_attack": 2850, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 60, "attack_interval": 164, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173200, "race_id": 16, "special_effect_id": 2519, "change_to": 17, "master_id": 41201, "from_condition": "sp_change"}], "popups": ["\n\n\n\n　　――別日、鋼の都", "変異したフライデーモンは\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。\n\nまた、一定範囲内のユニットは\n継続ダメージを受けます。", "変異したゴブリンは\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。", "変異したアークデーモンは\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。", "オーラをまとった紅牡丹は\n遠距離攻撃を全て回避します。", "変異したオーガは\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "battle", "at_sec": 54, "lines": [{"text": "──別日、鋼の都。"}, {"name": "レストレイン", "text": "囲め、囲め！　絶対に逃がすな！", "face": "lc6212114892f"}, {"name": "セバスティア大佐", "text": "まったく、しつこい女だな。レストレイン警備局長。", "face": "u2932a1"}, {"name": "レストレイン", "text": "生憎とそれしか取り柄がなくてな！", "face": "lc6212114892f"}, {"name": "レストレイン", "text": "ここで都市警備隊の誇りを取り戻す！　総員、抜剣！", "face": "lc6212114892f"}, {"name": "警備局員", "text": "応ッ！", "face": "lde9f58f34af6"}, {"name": "シェリンフォード", "text": "（二日前、鋼の都の警備局に送られてきた匿名の投書。\nそれはセバスティア大佐の潜伏先を知らせる内容だった）", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "（最初は悪質な悪戯だとして疑う者もいたが、\n最終的にレストレイン局長の判断で捜査が決定──）", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "（結果的に投書の内容は事実だと証明されたわけだが……）", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "（この拭いきれない違和感はなんだ……？）", "face": "lb0d6c51e3e62"}, {"name": "イザムバード", "text": "クレールは右！　アタシは左！", "face": "u972"}, {"name": "クレール", "text": "了解ッ！", "face": "u1046a1"}, {"name": "シェリンフォード", "text": "（彼女は南方諸国で悪名高い『殺戮の名将』だった、\nこれまでに買った恨みも掃いて捨てるほどあるだろう）", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "（その中に我々の情報収集能力を上回る\n人材がいたとしても決して不思議ではない）", "face": "lb0d6c51e3e62"}, {"name": "ピーク", "text": "アイゼルフ、行きましょう！", "face": "u2344a1"}, {"name": "アイゼルフ", "text": "やー！", "face": "u2343a1"}, {"name": "セバスティア大佐", "text": "チッ……鬱陶しい。", "face": "u2932a1"}, {"name": "シェリンフォード", "text": "（だが、彼女がそんな失態を軽々に犯すのか……？）", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "（教授の策略？　まさか、なんのために？\n右腕とも言うべき存在を捨て駒にする理由が？）", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "（……いや、今は憶測を重ねたところで堂々巡りか）", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "まずはセバスティア大佐を捕まえる、話はそれからだ。", "face": "lb0d6c51e3e62"}]}, {"trigger": "battle", "at_sec": 346, "lines": [{"name": "セバスティア大佐", "text": "………………。", "face": "u2932a1"}, {"name": "レストレイン", "text": "詰み、ですね。", "face": "lc6212114892f"}, {"name": "警備局員", "text": "つ、ついに──", "face": "lde9f58f34af6"}, {"name": "シェリンフォード", "text": "一ついいかな、局長。", "face": "lb0d6c51e3e62"}, {"name": "レストレイン", "text": "どうなされた、シェリンフォード殿。", "face": "lc6212114892f"}, {"name": "シェリンフォード", "text": "警備局の理念に反することを承知しながら、\n私は鋼の都に住まう市民の一人として、\n貴方に進言しなければならないことがあります。", "face": "lb0d6c51e3e62"}, {"name": "レストレイン", "text": "……聞きましょう。", "face": "lc6212114892f"}, {"name": "シェリンフォード", "text": "セバスティア大佐は、今ここで殺すべきだ。", "face": "lb0d6c51e3e62"}, {"name": "レストレイン", "text": "なっ……急に何を仰る！？", "face": "lc6212114892f"}, {"name": "セバスティア大佐", "text": "（……ふっ）", "face": "u2932a1"}, {"name": "シェリンフォード", "text": "彼女は南方諸国における国際指名手配犯であり、\n同時に多数のシンパを擁するテロリストでもある。", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "その身柄が我々の手元にあるというだけで、\n鋼の都は要らぬ火種を懐に抱えることになる。", "face": "lb0d6c51e3e62"}, {"name": "レストレイン", "text": "お待ちを、あまりにも司法を軽んじた発言だ。", "face": "lc6212114892f"}, {"name": "シェリンフォード", "text": "ええ、もちろん僕もそう思います。", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "ですが、現在の都市議会は少々潔癖が過ぎる。\nそれが間違っているというわけではありませんが、\n彼女の罪過の立証には莫大な時間を要するでしょう。", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "これまでの彼女らの手口は実に巧妙だった。\n最悪、少数の微罪にしか問えない可能性もある。", "face": "lb0d6c51e3e62"}, {"name": "レストレイン", "text": "だからそうなる前に、事故に見せかけて……と？", "face": "lc6212114892f"}, {"name": "レストレイン", "text": "やはり警備局長として承服できかねます。\nこの者は必ず、法廷に立たせねばならない。", "face": "lc6212114892f"}, {"name": "シェリンフォード", "text": "……ええ、貴方は正しい。その判断を尊重します。\n僕としても自ら真相を遠ざけるような真似は避けたい。", "face": "lb0d6c51e3e62"}, {"name": "シェリンフォード", "text": "失礼、気の迷いでした。忘れてください。", "face": "lb0d6c51e3e62"}, {"name": "レストレイン", "text": "いいえ、鋼の都を思ってのお言葉でしょう。\n名探偵からの助言はいつでも受け付けています。", "face": "lc6212114892f"}, {"name": "シェリンフォード", "text": "では、一つだけ留意しておいてください。\nおそらくこの状況も『教授』の計画の内です。", "face": "lb0d6c51e3e62"}, {"name": "レストレイン", "text": "……了解した、議会にも報告しておく。\n王国との連携も強化する必要があるだろうな。", "face": "lc6212114892f"}, {"name": "レストレイン", "text": "総員撤収だ！　まだまだ当分は休めると思うなよ！", "face": "lc6212114892f"}, {"name": "警備局員", "text": "応ッ！", "face": "lde9f58f34af6"}]}, {"trigger": "end", "lines": [{"name": "モリア", "text": "ふぅ……流石は音に聞く名探偵、\n中々心臓に悪い提案をしてくれる。", "face": "l77139d921a13"}, {"name": "モリア", "text": "さて、この仕込みがどう機能するか……。", "face": "l77139d921a13"}, {"name": "モリア", "text": "大切な右腕を斬り落としたんだ。\n君たちがこれから彼女をどう扱うのか、\n舞台裏から楽しみにさせてもらうとしよう。", "face": "l77139d921a13"}, {"name": "モリア", "text": "レストレイン、シェリンフォード、そして……王子。", "face": "l77139d921a13"}]}], "active": true}