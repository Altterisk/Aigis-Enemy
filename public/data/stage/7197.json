d": 2126416, "special_effect_id": 659, "change_to": 6, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33018, "global_id": 6635, "ranged": true, "to_global_id": 6634, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 87}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 22500, "attack": 550, "base_hp": 22500, "base_attack": 550, "damage_type": "physical", "armor_defense": 270, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 750.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126400, "special_effect_id": 657, "change_to": 5, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33017, "global_id": 6634, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109072, "race_id": 16, "special_effect_id": 61, "change_to": 8, "master_id": 30127, "global_id": 3746, "to_global_id": 3747, "route_behaviour": {"transforms": [{"wait": 540}]}, "spawn_sec": 127}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 331, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109088, "race_id": 16, "special_effect_id": 61, "change_to": 7, "missile_id": 26, "master_id": 30128, "global_id": 3747, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 5, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 134}], "popups": ["おもちゃ工場のベルトコンベアで\n運ばれている間、フォー人形は\n攻撃を行いません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ソラノ", "text": "――悪夢のような光景ね。\nおもちゃの生産ラインが、\n全部フォーの人形に入れ替わってるじゃない！", "face": "u938"}, {"name": "サンタコーネリア", "text": "……なるほど、クリスマス爆破作戦とは、\nふざけた企みだと思っていたが――", "face": "u725"}, {"name": "サンタヘイオス", "text": "――フォー人形を子どもたちに贈る、\nそれが本当の狙いだったということですね。", "face": "u1116a1"}, {"name": "ベルニス", "text": "で、でも、闇の組織の狙いはお金ですよね？\nプレゼントを爆破するって、いったい何の目的で……。", "face": "u557"}, {"name": "アイリーン", "text": "……フォーの行動原理は、\n闇の組織とは相容れないのです。", "face": "u315"}, {"name": "セブン", "text": "あいつは生きるためでも稼ぐためでもなく、\nただ愉しいからって人を殺していた。\n……きっとこれも、その一環なんだ。", "face": "u449"}, {"name": "フォー", "text": "――勘違いしてもらっちゃ困るなァ……。\n誰が愉しいだけで人を殺すっていうんだい。", "face": "lb0c511288c26"}, {"name": "フォー", "text": "俺は見たいんだよ……。\n燃え盛る苦しみの中から這い上がる、\n人間の強さってやつを……。", "face": "lb0c511288c26"}, {"name": "フォー", "text": "だから！　さぁ！\n存分に苦しみ、傷つき、死にそうになりながら！\n――その強さを俺に見せておくれよ。ハーッハァ！！", "face": "lb0c511288c26"}, {"name": "セブン", "text": "くっ……王子、フォーが工場の奥に逃げるぞ！", "face": "u449"}, {"name": "サンタヘイオス", "text": "セブン、深追いはいけません。\n――周囲をよく見てください。", "face": "u1116a1"}, {"name": "セブン", "text": "周囲って……なっ、コンベアが動き出したぞ！？", "face": "u449"}, {"name": "サンタコーネリア", "text": "フォー人形をけしかけるつもりなのだろう。\n製造中は無害だろうが、\n完成すればこちらへ向かってくるはずだ。", "face": "u725"}, {"name": "サンタヘイオス", "text": "どうやら、後を追うには\nこれを片付けるしかないようですね。\n王子殿下、迎撃の指揮をお願いします！", "face": "u1116a1"}]}, {"trigger": "end", "lines": [{"name": "サンタヘイオス", "text": "よし、ここの製造ラインは止まりました！", "face": "u1116a1"}, {"name": "エスネア", "text": "……あっ、あぁぁぁっ！！\nよわよわ王子、大変だよ！　大変なの！！", "face": "u997"}, {"name": "エフネ", "text": "……はっ、そ、そうですよ！\n生産ラインはここだけじゃないんです！！", "face": "u969"}, {"name": "エーテル", "text": "確かに、工場の奥にも、\nおもちゃの生産ラインがあったはずです。\nもしやフォーは、それを起動するために奥へ……。", "face": "u933"}, {"name": "サンタヘイオス", "text": "もはや、一刻の猶予もありませんね。\nクリスマスと子どもたちを守るため、\n急いで工場の奥へ進みましょう！", "face": "u1116a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "見張り", "text": "――こっちに王国軍が来ているぞ！", "face": "l0856284cfbe7"}, {"name": "シャルロット", "text": "見つかってしまいましたわ！\n敵の抵抗が激しくなりますわよ！", "face": "u556"}]}], "story_talk": true, "active": true}