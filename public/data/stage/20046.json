e": 90, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103792, "race_id": 2, "missile_id": 39, "missile": {"splash": 133}, "master_id": 31705, "global_id": 5324, "ranged": true, "from_condition": 2}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 156, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2166080, "race_id": 16, "change_to": 15, "master_id": 39458, "global_id": 13075, "spawn_sec": 188}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["置物"], "fixture": true, "uncounted": true, "hp": 15000, "base_hp": 15000, "damage_type": "true", "armor_defense": 350, "magic_defense": 40, "attack_speed": 10, "attack_wait": 10, "attack_interval": 109, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108288, "race_id": 3, "special_effect_id": 110, "master_id": 41271, "spawn_sec": 188}], "popups": ["サファイアドラゴンは\n自身の攻撃力の値で\n自身を含む周囲の敵を回復します。\nまたサファイアドラゴンがいる間、\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "グリム", "text": "――はー、なるほど。\n急遽想定にない魔界行きが必要になったと。", "face": "u942"}, {"name": "アナベラ", "text": "うん。単刀直入に聞くけど、\n普段使用しているゲートではなく、\nここから直接魔界に移動することは可能？", "face": "u1309a1"}, {"name": "グリム", "text": "んー、んんー。\nはい、たぶんできるかと？", "face": "u942"}, {"name": "ユリクセス", "text": "本当か！？", "face": "u2193a1"}, {"name": "グリム", "text": "知らない場所を繋ぐのが難しいわけで。\nこの場所も、魔界も知ってる場所なのでー。", "face": "u942"}, {"name": "グリム", "text": "ただ、新しく術を組み立てる必要があるので、\n結構時間がかかるかとー。\nざっと……これくらい？", "face": "u942"}, {"name": "ユリクセス", "text": "十分だ！\nよし王子、術の完成まで時間を稼ぐぞ！", "face": "u2193a1"}, {"name": "ラピス", "text": "……お前は、優秀だな。", "face": "u436"}, {"name": "グリム", "text": "ふふん。ゆーしゅーなのでー。", "face": "u942"}, {"name": "グリム", "text": "ところで、魔神の力を借りるとして、\nレラジェ様にとってのレライエさんみたいな、\n共鳴者のポジションが必要ですよね？", "face": "u942"}, {"name": "グリム", "text": "いったい、誰を魔界に派遣するつもりなんでしょー？", "face": "u942"}, {"name": "ラピス", "text": "……グリム、お前と同じくらい優秀なやつだ。", "face": "u436"}, {"name": "グリム", "text": "…………？", "face": "u942"}, {"name": "ラピス", "text": "王国の王子と、帝国の神官戦士。\nそのふたりから全幅の信頼を寄せられるほどの、\n優秀な大悪魔召喚士の役割だ、と言っているんだ。", "face": "u436"}, {"name": "ラピス", "text": "――さぁ、儀式を始めろ。\nこの場は王子たちが守ってくれる。", "face": "u436"}]}, {"trigger": "end", "lines": [{"name": "グリム", "text": "――できましたー。\n少人数でしたら、問題なくあちらへ渡れますー。", "face": "u942"}, {"name": "アンナ", "text": "王子、レヴィアタンとの交渉役には誰を――"}, {"name": "レライエ", "text": "えっと、私と、アルティアさんと……。あとは……。", "face": "u1355a1"}, {"name": "ラピス", "text": "――わたしが行く。", "face": "u436"}, {"name": "アンナ", "text": "ラピスさん？"}, {"name": "ラピス", "text": "可能性は少しでも上げるべきだろう。\n魔界をよく知り、召喚の知識もある。\nわたしが行くべきだ。", "face": "u436"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ラピス", "text": "なんだその顔は、不満か？", "face": "u436"}, {"name": "ノーマ", "text": "あはは。心配してるのよ、王子は。", "face": "u1047a1"}, {"name": "ラピス", "text": "む……そうか……。", "face": "u436"}, {"name": "王子", "text": "…………ラピス。", "face": "u1"}, {"name": "ラピス", "text": "ん、なんだ。内緒話か？", "face": "u436"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ラピス", "text": "…………ふっ。なるほどな。\nいいだろう。このわたしが、\nお前の期待に応えてやる。", "face": "u436"}]}, {"trigger": "end", "lines": [{"name": "ラピス", "text": "グリム、もう一度出番だ。\n一緒に来てくれ。", "face": "u436"}, {"name": "グリム", "text": "はい？　いいですけど、\n物質界から戻ってくるのには\nいつものゲートを使うんですよね？", "face": "u942"}, {"name": "ラピス", "text": "王子はもっと巨大なものを押し通すつもりらしい。\n悪魔は喚び慣れているが、\n世界を超えるには、お前の力が必要だろう？", "face": "u436"}, {"name": "グリム", "text": "巨大なもの……はっ！\nなるほど、でしたら頑張っちゃいますねー。", "face": "u942"}]}, {"trigger": "end", "lines": [{"name": "ラピス", "text": "では、行ってくる。\nここは任せたぞ、王子。", "face": "u436"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "map": {"image": "Map7522", "w": 960, "h": 640, "spots": [{"k": "b", "x": 816, "y": 127}, {"k": "m", "x": 609, "y": 161, "id": 200}, {"k": "m", "x": 668, "y": 132, "id": 201}, {"k": "m", "x": 680, "y": 209, "id": 202}, {"k": "m", "x": 747, "y": 167, "id": 203}, {"k": "m", "x": 758, "y": 251, "id": 204}, {"k": "m", "x": 820, "y": 207, "id": 205}, {"k": "m", "x": 526, "y": 207, "id": 206}, {"k": "m", "x": 458, "y": 250, "id": 207}, {"k": "m", "x": 393, "y": 287, "id": 208}, {"k": "m", "x": 330, "y": 320, "id": 209}, {"k": "m", "x": 268, "y": 356, "id": 210}, {"k": "m", "x": 180, "y": 391, "id": 211}, {"k": "m", "x": 85, "y": 357, "id": 212}, {"k": "m", "x": 422, "y": 375, "id": 213}, {"k": "m", "x": 490, "y": 333, "id": 214}, {"k": "m", "x": 495, "y": 412, "id": 215}, {"k": "m", "x": 568, "y": 378, "id": 216}, {"k": "m", "x": 642, "y": 421, "id": 217}, {"k": "m", "x": 700, "y": 452, "id": 218}, {"k": "r", "x": 374, "y": 163, "id": 300}, {"k": "r", "x": 285, "y": 246, "id": 301}, {"k": "r", "x": 233, "y": 275, "id": 302}, {"k": "r", "x": 355, "y": 428, "id": 303}, {"k": "r", "x": 596, "y": 271, "id": 304}, {"k": "r", "x": 767, "y": 319, "id": 305}, {"k": "r", "x": 723, "y": 348, "id": 306}], "events": [{"t": 0, "when": "time", "ops": [{"op": "+fx", "name": "obj_99", "fx": "BlackOut3", "x": 480, "y": 301}]}, {"t": 43.3, "when": "time", "ops": [{"op": "+fx", "name": "obj_01", "fx": "RockFall3", "x": 468, "y": 337}]}, {"t": 47.8, "when": "time", "ops": [{"op": "-fx", "name": "obj_01"}]}, {"t": 184.7, "when": "time", "ops": [{"op": "+fx", "name": "obj_03", "fx": "RockFall3", "x": 521, "y": 184}]}, {"t": 188.2, "when": "time", "ops": [{"op": "-fx", "name": "obj_03"}]}, {"t": 188.2, "when": "time", "ops": [{"op": "-s", "name": "locPlc_200"}, {"op": "-s", "name": "locPlc_201"}, {"op": "-s", "name": "locPlc_202"}, {"op": "-s", "name": "locPlc_203"}, {"op": "-s", "name": "locPlc_204"}, {"op": "-s", 