{"quest_id": 4136, "name": "姫と山賊団", "description": "王子達を狙う山賊団。\nしかし別の魔物の影が……。", "event": "姫と山賊と悪霊の都", "event_category": "History", "mission_id": 920027, "map_no": 3877, "level": 80, "multiplier": 0.8, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "form_count": 1, "hp": 800, "attack": 120, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "hp": 2560, "attack": 176, "base_hp": 3200, "base_attack": 220, "damage_type": "physical", "armor_defense": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 162, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 1, "spawn_sec": 16}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 1600, "attack": 104, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 30}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 5600, "attack": 280, "base_hp": 7000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102880, "race_id": 16, "master_id": 20185, "global_id": 1260, "spawn_sec": 50}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["植物"], "hp": 3200, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 56}], "dialogue": [{"trigger": "start", "lines": [{"name": "山賊", "text": "お嬢、人が来ましたぜ！\n金目のもの持ってるかなぁ……。", "face": "u4"}, {"name": "？？？", "text": "もう！　いつも言ってるけど、\nお嬢って言わないでってば！\nちゃんとお頭って呼んでよね。", "face": "u185"}, {"name": "？？？", "text": "あーもう！　気分が台無しじゃない。\nで、どんな人たち？", "face": "u185"}, {"name": "山賊", "text": "なんかじゃらじゃらと、\n暑苦しそうなもん身に着けてやすね。\nあんなのつけてたらロクに動けねぇな！", "face": "u4"}, {"name": "山賊", "text": "絶対勝てるっすよ！", "face": "u4"}, {"name": "？？？", "text": "（……まったく。これだから育ちの悪い人は……。）", "face": "u185"}, {"name": "？？？", "text": "ふーん。\n良い家柄の人なのかなぁ。\nよっし！　じゃ一仕事だね！", "face": "u185"}, {"name": "山賊", "text": "へい！", "face": "u4"}]}, {"trigger": "battle", "at_sec": 54, "lines": [{"name": "山賊", "text": "こ……こいつらつええええええ！\nお嬢！　こいつら只者じゃねぇ！", "face": "u4"}, {"name": "？？？", "text": "お頭って呼びなさいってば！", "face": "u185"}, {"name": "？？？", "text": "うーん負けちゃった……。\nえーっと……ごめんなさい！\nさっきの事は謝るから見逃してください！", "face": "u185"}, {"name": "？？？", "text": "ほら、あんた達も一緒にごめんなさいして！", "face": "u185"}, {"name": "山賊", "text": "急に襲って悪かった！　すまんな！", "face": "u4"}, {"name": "？？？", "text": "ちゃんと謝るの！！", "face": "u185"}, {"name": "山賊", "text": "許してください。ごめんなさい……。", "face": "u4"}, {"name": "アンナ", "text": "……。", "face": "l4bd8816bddc1"}]}, {"trigger": "end", "lines": [{"name": "カボチャの魔物", "text": "ミツケタ。ミツケタ。\nヒメだ。\nタマシイ、もらう……！", "face": "lcada1b233c8e"}, {"name": "？？？", "text": "……！！\nあいつは……！　こんなところまで……！", "face": "u185"}, {"name": "アンナ", "text": "あの魔物は一体どこから……。\nこの近辺では見た事がありませんね。", "face": "l4bd8816bddc1"}, {"name": "？？？", "text": "ちょっと、そこの人！\nさっきはごめんなさい！　謝るからあの魔物\n倒してくれない？", "face": "u185"}, {"name": "？？？", "text": "このままじゃ、みんな魂とられちゃう！", "face": "u185"}, {"name": "アンナ", "text": "え！？　魂をとられる……！？\nよく分からないですが、危険な魔物のようです。\n戦いましょう。", "face": "l4bd8816bddc1"}]}], "active": true}