ster_id": 37440, "global_id": 11057, "spawn_sec": 213}, {"enemy_id": 27, "source": "local", "count": 2, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 90, "attack_speed": 40, "attack_wait": 10, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "pattern_id": 2113808, "special_effect_id": 1160, "master_id": 37395, "global_id": 11012, "spawn_sec": 214}, {"enemy_id": 28, "source": "local", "count": 1, "form_count": 2, "tags": ["ハニー", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 112, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 2000, "pattern_id": 2113840, "change_to": 28, "master_id": 41182, "spawn_sec": 215}, {"enemy_id": 28, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 107, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2173088, "race_id": 16, "change_to": 29, "master_id": 41181}, {"enemy_id": 31, "source": "local", "count": 1, "form_count": 2, "tags": ["ハニー", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 112, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 2000, "pattern_id": 2113856, "change_to": 27, "master_id": 41183, "spawn_sec": 215}, {"enemy_id": 31, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "attack": 10, "base_hp": 300000, "base_attack": 10, "damage_type": "physical", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 107, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2173088, "race_id": 16, "change_to": 29, "master_id": 41181}], "popups": ["\n\n\n\n――セーレの居城、ハニーセーレの間"], "dialogue": [{"trigger": "battle", "at_sec": 52, "lines": [{"text": "――セーレの居城、ハニーセーレの間"}, {"name": "ハニーＡ", "text": "はにほー。", "face": "l0a288895e9cd"}, {"name": "ハニーＢ", "text": "なんかいっぱいいるー。", "face": "l0a288895e9cd"}, {"name": "ハニーＣ", "text": "おもしろそうだからいついちゃったー。", "face": "l0a288895e9cd"}, {"name": "アイリーン", "text": "……あの、王子。\nハニーが、こちらをじっと見てきます。", "face": "u315"}, {"name": "ユリクセス", "text": "視線が鬱陶しいな……。眼鏡が原因なのか？", "face": "u2193a1"}, {"name": "ハニーＤ", "text": "めがねっこだー。", "face": "l0a288895e9cd"}, {"name": "ハニーＥ", "text": "りょうほうめがねっこだー。", "face": "l0a288895e9cd"}, {"name": "ハニーセーレ", "text": "ハーッハッハッハ！　ハニホー！\n来たな、ランス、王子！", "face": "l889a78825052"}, {"name": "ハニーセーレ", "text": "この部屋の偽ハニーは全て私の眷属！\n本物のハニーも私のしもべだ！", "face": "l889a78825052"}, {"name": "ハニーＡ", "text": "ちがうよー。", "face": "l0a288895e9cd"}, {"name": "ハニーＢ", "text": "おもしろいからいるだけー。", "face": "l0a288895e9cd"}, {"name": "ハニーセーレ", "text": "黙れぇい！", "face": "l889a78825052"}, {"name": "シィル", "text": "あの魔神さんには魔法が効きにくいです。\n私の魔法も、グリムさんの魔法も……。", "face": "u2900a1"}, {"name": "グリム", "text": "ですねー。門を開ける魔力まで、\n減衰させられてる感じがしますー。", "face": "u942"}, {"name": "シルキィ", "text": "なら、私の出番ね。\n魔導具は魔法じゃない。物理。", "face": "u2902a1"}, {"name": "シルキィ", "text": "リトル、行くわよ。", "face": "u2902a1"}, {"name": "ハニーセーレ", "text": "ぬっ……魔人か。\nふん、偽ハニーどもよ、まずは眼鏡どもを狙え！", "face": "l889a78825052"}, {"name": "アイリーン", "text": "ええっ！？　なぜ私たちを！？", "face": "u315"}, {"name": "ハニーセーレ", "text": "ハニーは眼鏡に弱い。\n私の眷属も同じだ！　ハニホー！", "face": "l889a78825052"}, {"name": "ユリクセス", "text": "それはハニーの好みの話だろう！？", "face": "u2193a1"}, {"name": "アンナ", "text": "王子、シルキィさんを軸に、\n魔法に頼らない編成でお願いします！"}]}, {"trigger": "battle", "at_sec": 215, "lines": [{"name": "ハニーセーレ", "text": "ぐぬぬ……この私が、魔人ごときに……！", "face": "l889a78825052"}, {"name": "ハニーＡ", "text": "……ねえ。", "face": "l0a288895e9cd"}, {"name": "ハニーＢ", "text": "このにせもの、めがねっこをたたいたよね。", "face": "l0a288895e9cd"}, {"name": "ハニーＣ", "text": "アイリーンちゃんと、ユリクセスちゃんを。", "face": "l0a288895e9cd"}, {"name": "ハニーＤ", "text": "ゆるせなーい。", "face": "l0a288895e9cd"}, {"name": "ハニーＥ", "text": "ゆるせなーい。", "face": "l0a288895e9cd"}, {"name": "ハニーＦ", "text": "はにほーーーー！！", "face": "l0a288895e9cd"}]}, {"trigger": "end", "lines": [{"name": "ハニーセーレ", "text": "な、なんだ貴様ら！　私は魔神セーレだぞ！\nハニーの力を宿した、真の――", "face": "l889a78825052"}, {"name": "ハニーＡ", "text": "にせものー。", "face": "l0a288895e9cd"}, {"name": "ハニーＢ", "text": "めがねっこのてきー。", "face": "l0a288895e9cd"}, {"name": "ハニーセーレ", "text": "ひぃぃっ！？　やめろ、寄るな！\n私は本物だ！　ハニホー！！", "face": "l889a78825052"}, {"name": "ランス", "text": "がははは！　いいぞハニワども！\nもっとやれ！", "face": "u2897a1"}, {"name": "ハニーセーレ", "text": "くっ……魔力炉だ、魔力炉で決着を……！", "face": "l889a78825052"}]}, {"trigger": "end", "lines": [{"name": "グリム", "text": "ハニーの群れに追われて逃げていきましたー。\nなんか、可哀想になってきましたねぇ。", "face": "u942"}, {"name": "シルキィ", "text": "同情は要らないわ。\n人質を取る魔神に、二度目はない。", "face": "u2902a1"}, {"name": "シィル", "text": "……あっ。ランス様、呪いの魔力が、\n二本とも同じ場所に向かってます。\nたぶんあっちが魔力炉の間です！", "face": "u2900a1"}, {"name": "リア", "text": "ふたり揃って、炉のところで\nお互いを吸収する気ね。", "face": "u2901a1"}, {"name": "アンナ", "text": "王子、急ぎましょう。\n完全体になる前に、決着を！"}, {"name": "ランス", "text": "おう！　行くぞ王子！\nそして俺様の呪いを解くのだー！", "face": "u2897a1"}]}], "active": true}