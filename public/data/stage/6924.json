id": 2115408, "race_id": 4, "special_effect_id": 92, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 32126, "global_id": 5745, "ranged": true}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 74}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 5, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "special_effect_id": 222, "change_to": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 32132, "global_id": 5751, "to_global_id": 5752, "spawn_sec": 78}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 5, "tags": ["ステルス"], "hp": 40000, "attack": 350, "base_hp": 40000, "base_attack": 350, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 60, "attack_wait": 30, "attack_interval": 169, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "special_effect_id": 415, "change_to": 14, "master_id": 32133, "global_id": 5752, "to_global_id": 5753}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 2, "form_count": 5, "hp": 40000, "attack": 350, "base_hp": 40000, "base_attack": 350, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 60, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 15, "master_id": 32134, "global_id": 5753, "to_global_id": 5754}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 3, "form_count": 5, "hp": 40000, "attack": 550, "base_hp": 40000, "base_attack": 550, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 220, "attack_speed": 60, "attack_wait": 60, "attack_interval": 199, "move_speed": 100.0, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2100832, "race_id": 4, "special_effect_id": 452, "change_to": 16, "change_condition": 2, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 32135, "global_id": 5754, "ranged": true, "to_condition": 2, "to_global_id": 5755}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 4, "form_count": 5, "hp": 30000, "attack": 550, "base_hp": 30000, "base_attack": 550, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 130, "attack_speed": 60, "attack_wait": 120, "attack_interval": 319, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100848, "race_id": 4, "special_effect_id": 226, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 32136, "global_id": 5755, "ranged": true, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "スズネ", "text": "さっきはぬらりひょんの系譜に化けて、\nぼっこぼこにされちゃいました……。\nそれなら次は……ごにょごにょ……。", "face": "u936"}, {"name": "妖狸", "text": "なるほどぽん……！！\n隣山の里から奪った木の葉があれば、\nその変化も不可能じゃないぽん！", "face": "l29774d5d3d78"}]}, {"trigger": "start", "lines": [{"name": "たぬきの里の長", "text": "王子さま、あやかし狸大合戦は、\nどんな変化が飛び出してくるか分からない、\n命がけの騙し合いだぽん。", "face": "u1019a1"}, {"name": "たぬきの里の長", "text": "どれだけ強い存在に化けられるか、\nそしてそれを打ち破れるか、\n化けぢからと実力の両方が必要なんだぽん！", "face": "u1019a1"}, {"name": "フーコ", "text": "へぇ……でも、どれだけ強い魔物や妖怪に変化しても、\nこっちにはその本物を打ち破ってきた、\n何人もの腕利きが揃っているんだよ？", "face": "u493"}, {"name": "ラミィ", "text": "そうそうっ♪\n本物の力の前には、妖狸の変化なんてイチコロだって♪", "face": "u480"}, {"name": "たぬきの里の長", "text": "ゆ、油断しちゃいけないぽん！\n王子さまも皆も、絶対気を抜いちゃだめだぽん。", "face": "u1019a1"}, {"name": "たぬきの里の長", "text": "化ける前に隙を見せる子は、倒してしまうのも、\n大合戦では当然許されているんだぽん。\nできるだけ先に倒してしまうぽん……！", "face": "u1019a1"}]}, {"trigger": "end", "lines": [{"name": "ラミィ", "text": "あ、あわわわ、焦ったぁ……！！\nまさかフーコの姉ちゃんに化けるなんて！", "face": "u480"}, {"name": "フーコ", "text": "……お、驚いてないから。\nだ、大丈夫……うん……。", "face": "u493"}, {"name": "スズネ", "text": "……うぅぅ、ボクさまちゃんは、\nやっぱりずるいですぽん！\n何て強力な助っ人なんですぽんー！！", "face": "u936"}, {"name": "たぬきの里の長", "text": "ぽんぽこぽーん♪\n負けを認めるなら、観念して事情を話すぽん！", "face": "u1019a1"}, {"name": "スズネ", "text": "ぽぽん……分かったぽん……。\nあやかし狸大合戦、敗者は勝者にぽんぽこお腹を見せて、\n何でも言うことを聞くのがあたし様たちのならわし……。", "face": "u936"}, {"name": "スズネ", "text": "実はあたし様たちは――", "face": "u936"}]}, {"trigger": "end", "lines": [{"name": "重水の四天王", "text": "――おっと、そこまでですよスズネ。", "face": "l7fdf3d471bc6"}, {"name": "重水の四天王", "text": "まさか魔王の放った瘴気よりあなた方を救った、\n大恩ある我ら鬼を裏切るおつもりですか？", "face": "l7fdf3d471bc6"}, {"name": "ホムラ", "text": "重水の四天王……！？\nそうか、スズネたちを脅してたってのはてめぇらか！", "face": "u739"}, {"name": "重水の四天王", "text": "くっくっくっ……脅したとは人聞きの悪い……。\nさぁスズネ、ここは一度撤退なさい。", "face": "l7fdf3d471bc6"}, {"name": "重水の四天王", "text": "それともまさか、スズネの里は\n命を救われた恩を、仇で返すと？", "face": "l7fdf3d471bc6"}, {"name": "スズネ", "text": "ぽ、ぽん……。\nごめんなさいですぽん、ボクさまちゃん……。", "face": "u936"}, {"name": "スズネ", "text": "あたし様は、やっぱり鬼の旦那方に受けた御恩を、\n返さなきゃならないのですぽん……！", "face": "u936"}, {"name": "たぬきの里の長", "text": "ス、スズネちゃん……！！\nたぬぬぬ、まさか鬼に協力するなんて、\nどうしてこんなことになったぽん……。", "face": "u1019a1"}, {"name": "ヒエン", "text": "王子、我ら忍がスズネ殿の後を追いまする。", "face": "u112"}, {"name": "アリサ", "text": "で、では私達は急いで怪我人の手当を！", "face": "u24"}, {"name": "アンナ", "text": "魔王の瘴気による影響が、妖狸さんの里にまで……。\n王子、事態の真相を知るためにも、\n十分な準備をしてからスズネさん達を追いましょう！", "face": "le527dc289920"}]}], "active": true}