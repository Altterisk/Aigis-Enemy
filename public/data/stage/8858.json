400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 40058, "global_id": 13675, "spawn_sec": 187}, {"enemy_id": 11, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 125000, "attack": 2600, "base_hp": 125000, "base_attack": 2600, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103296, "race_id": 10, "master_id": 40060, "global_id": 13677, "spawn_sec": 194}, {"enemy_id": 12, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 155000, "attack": 3000, "base_hp": 155000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 261, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122048, "race_id": 10, "master_id": 40061, "global_id": 13678, "spawn_sec": 252}], "popups": ["ヒュリオンの\n一定範囲内の味方ユニットは\n継続ダメージを受けます。\n\nまたヒュリオンは体力が\n徐々に減少していきます。", "白の皇帝の影の\n一定範囲内の味方ユニットは\n攻撃力がダウンし、\n継続ダメージを受けます。\n\nまた白の皇帝の影は、\n戦場にいる呪いの泥の総数に応じて\n攻撃と防御がアップします。", "帝国史・歴戦の追憶が\n解放されました。\n\nホーム画面左側の\nミッションクエストにある、\n魔神降臨のメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヒュリオン？", "text": "――しろの、こうてい。", "face": "u2736a1"}, {"name": "白の皇帝", "text": "……ヒュリオン、ではないな。\nこの呪いを送り込んだ主か。", "face": "u418"}, {"name": "ヒュリオン？", "text": "…………よい、うつわ、だ。", "face": "u2736a1"}, {"name": "ヘカティエ", "text": "……器？", "face": "u1226a1"}, {"name": "ヒュリオン？", "text": "たたかいつづけよ。\n呪いを振りまき、孤独に、戦い続けよ。", "face": "u2736a1"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "白の皇帝", "text": "あいにくと、俺を孤独にさせたがらない友がいてな。\nいずれ、貴様の喉元に、我が剣を突き付けてやる。\nその日を楽しみに待ちわびているといい。", "face": "u418"}, {"name": "ヒュリオン？", "text": "いつまで、そのつよがりが保つものか――", "face": "u2736a1"}, {"name": "ヒュリオン？", "text": "――たるたろすで、お前の旅路を、見届けよう。", "face": "u2736a1"}, {"name": "白の皇帝", "text": "…………っ！！", "face": "u418"}, {"name": "白の皇帝", "text": "なん、だ……？\n身体が、熱く……。", "face": "u418"}, {"name": "メーア", "text": "あ、あれ！　あれって！", "face": "u2404a1"}, {"name": "フルス", "text": "前に見た、皇帝陛下そっくりな影！！", "face": "u2738a1"}, {"name": "白の皇帝", "text": "敵が俺の姿を取ろうと、関係ない。\nヒュリオンを呪いから解き放ち、\n俺の似姿を撃破する。――行くぞ。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "白の皇帝", "text": "――合わせろ、王子。", "face": "u418"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ティシファ", "text": "ヒュリオンから、タルタロスの気配が消えていく……。", "face": "u2739a1"}, {"name": "ティシファ", "text": "（そうか、女神アイギス、\nケラウノスの加護を受けた王子と、\nアダマスの加護を受けた皇帝がそろっていたから……）", "face": "u2739a1"}, {"name": "ヒュリオン", "text": "……っ、はぁっ、はぁっ、うっ……ぁ……。", "face": "u2736a1"}, {"name": "フローガ", "text": "ヒュリオンの魔力反応も落ち着いています。\n呪いは無事に解けたみたいですね。", "face": "u878"}, {"name": "白の皇帝", "text": "……助力に感謝する、ティシファ。", "face": "u418"}, {"name": "ティシファ", "text": "いえ。礼なら、呼び声に応えたヒュリオンと、\nその身を捧げたキュクロプスの王へ。", "face": "u2739a1"}, {"name": "ティシファ", "text": "それよりも――", "face": "u2739a1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "ティシファ", "text": "皇帝。あなたの身にかかった呪いが、\nよりその深さを増しています。", "face": "u2739a1"}, {"name": "白の皇帝", "text": "……やはり、か。", "face": "u418"}, {"name": "エリアス", "text": "さきほど、皇帝の姿を取った呪いを斬り捨てたのに……。", "face": "u2737a1"}, {"name": "ティシファ", "text": "あれはいわば、皇帝という鋳型を通して、\nタルタロスの魔力が形を得たものです。", "face": "u2739a1"}, {"name": "ティシファ", "text": "あのような個体が現れたことが、\n呪いがより強くなっている証左かと。", "face": "u2739a1"}, {"name": "レオナ", "text": "陛下……。", "face": "u2600a1"}, {"name": "白の皇帝", "text": "ひとまず帝都へ戻る。\n情報を整理し、打てる手を洗い出す。", "face": "u418"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 29, "params": [0, 20, 10]}, {"kind": "term", "influence": 18, "params": [120]}, {"kind": "term", "influence": 14, "params": [50], "expression": "IsC