{"quest_id": 8256, "name": "魔力の残滓を追って", "description": "敵の襲撃を潜り抜け調査地点に辿り着いた\n王子一行。しかしそこは既に魔神セーレの\n配下によって守りが固められていた。\n上級（★１獲得の目安：平均Lv10）", "event": "ランス1000　再び交わる世界", "event_category": "Reproduce", "mission_id": 320424, "map_no": 4893, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 55, "attack_wait": 10, "attack_interval": 172, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097248, "race_id": 3, "master_id": 35749, "global_id": 9366}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 3}, {"enemy_id": 5, "source": "local", "count": 7, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 14}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 46}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 60}, {"enemy_id": 8, "source": "local", "count": 14, "form_count": 1, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "spawn_sec": 69}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 106}], "dialogue": [{"trigger": "start", "lines": [{"name": "グリム", "text": "――はーい、ここが次元の狭間に\n転移した地点で……わわわっ、魔物があんなにたくさん。", "face": "u942"}, {"name": "ウルザ", "text": "こんなに大勢配備するとは、\nここが重要地点だと明かしているようなものですね。", "face": "u2158a1"}, {"name": "グレース", "text": "グリムさんの異界召喚魔法は、\n魔神セーレからしても想定外だったのでしょう。", "face": "u213"}, {"name": "グレース", "text": "あの防衛陣は、我々の存在が、\nセーレにとっての脅威であると示しているも同然です。", "face": "u213"}, {"name": "グリム", "text": "えへん。", "face": "u942"}, {"name": "シィル", "text": "わぁ、よしよし、なでなで。", "face": "u581"}, {"name": "グリム", "text": "えへんえへーん♪", "face": "u942"}, {"name": "上杉謙信", "text": "では、次元の狭間に乗り込む前哨戦に、\nあのモンスターたちを蹴散らすとしよう。", "face": "u2156a1"}, {"name": "グリム", "text": "あっちの魔神も転移の術を使うので、\n増援には注意しながら戦ってくださいねー。", "face": "u942"}, {"name": "グリム", "text": "私が魔神セーレの立場だったら、\n間違いなく、戦闘中に異界の門をばんばん増やすので。", "face": "u942"}, {"name": "ウルザ", "text": "……グリムさんが味方で良かったですね。", "face": "u2158a1"}, {"name": "グリム", "text": "今日はいっぱい褒めてもらえてうれしーです。\nそれじゃ、さくっとやっちゃいましょー！", "face": "u942"}]}, {"trigger": "end", "lines": [{"name": "上杉謙信", "text": "――周囲に気配はない。\n制圧完了だ。", "face": "u2156a1"}, {"name": "グリム", "text": "それじゃ、ちょっと向こう側を探ってみましょうかー。\nよいしょっと……。", "face": "u942"}, {"name": "魔剣カオス", "text": "むむ、ちょっといやーな感じがするのー。", "face": "le2e11fea1f65"}, {"name": "ウルザ", "text": "……それは、「魔人」がいるということですか？", "face": "u2158a1"}, {"name": "魔剣カオス", "text": "いや、次元がしっちゃかめっちゃかでよーわからん。\nおい心の友よ、突入するなら早く儂を構えんか。", "face": "le2e11fea1f65"}, {"name": "ランス", "text": "はいぱーへいき……。\n俺様の……はいぱー……へーき……。", "face": "l56c324708564"}, {"name": "王子", "text": "…………（ぽふぽふ）", "face": "u1"}, {"name": "モーティマ", "text": "……気持ちは分かるぜ、ランス。\n男にとっちゃショックだよなぁ。", "face": "u14"}, {"name": "魔剣カオス", "text": "くぅぅ、魔人がおるかもしれんというのに！\nこういう時に使い物にならんとは。", "face": "le2e11fea1f65"}, {"name": "アンナ", "text": "では、王国軍が先行して突入しましょう。\n戦況によってはお力をお借りするかもしれませんが……。"}, {"name": "上杉謙信", "text": "なれば、この入口は我々で防衛しておこう。\n王子殿、よろしく頼みます。", "face": "u2156a1"}, {"name": "グリム", "text": "それじゃあ、異界の門を開きますよー。\nえいっ、とやーっ！", "face": "u942"}]}], "active": true}