e": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 56}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 68}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 6000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2101616, "race_id": 16, "special_effect_id": 222, "master_id": 268, "global_id": 267, "spawn_sec": 100}], "dialogue": [{"trigger": "start", "lines": [{"name": "キャリー", "text": "と、止めてください～～～！！", "face": "u26"}, {"name": "レーヴ", "text": "――えっ！？　あ、あれはキャリーさん！？\n王子、これはいったいどういうことなのでしょうか？", "face": "u454"}, {"name": "レーヴ", "text": "な、なるほど……どうやら騎兵の訓練の最中に、\n馬が暴走してしまった時の記憶のようですね。", "face": "u454"}, {"name": "レーヴ", "text": "暴走した馬はどこを通るのか全く予想がつきません！\n王子、くれぐれも用心してください！", "face": "u454"}]}, {"trigger": "end", "lines": [{"name": "レーヴ", "text": "はぁ……はぁ……よ、ようやく騒ぎが収まったようですね。", "face": "u454"}, {"name": "レーヴ", "text": "それにしても、あの優秀なキャリーさんが、\nあのように馬を暴走させてしまうなんて……。", "face": "u454"}, {"name": "レーヴ", "text": "やはり、どれほど卓越した方であっても\n時には失敗してしまう事があるのですね。", "face": "u454"}, {"name": "レーヴ", "text": "アンナ様のお手伝いに段々と慣れてきた私ですが、\n慢心が強くなれば思わぬ失敗をしかねません……。", "face": "u454"}, {"name": "レーヴ", "text": "大きなミスをしないように、これからもおごること無く\n皆さんのサポートを頑張りたいと思います！", "face": "u454"}, {"name": "