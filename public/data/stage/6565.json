ack": 550, "damage_type": "physical", "armor_defense": 500, "attack_speed": 120, "attack_wait": 30, "attack_interval": 211, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102960, "race_id": 16, "special_effect_id": 225, "change_to": 4, "missile_id": 26, "master_id": 31255, "global_id": 4874, "to_global_id": 1055, "route_behaviour": {"transforms": [{"wait": 20}]}, "spawn_sec": 134}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 8000, "attack": 550, "base_hp": 8000, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "attack_range": 180, "attack_speed": 120, "attack_wait": 30, "attack_interval": 91, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102960, "race_id": 16, "special_effect_id": 225, "missile_id": 26, "master_id": 10056, "global_id": 1055, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "グスタフ", "text": "おぉ、こっちじゃこっちじゃ！", "face": "u153"}, {"name": "リッカ", "text": "グスタフさん！\nえぇと、その大量の爆薬はいったい……？", "face": "u152"}, {"name": "グスタフ", "text": "いや何、『浮遊石』鉱脈への、\n近道を作ってやろうかと思っての。\nこうして準備をしていたんじゃ。", "face": "u153"}, {"name": "マイン", "text": "それはありがたいけど……グスタフのジジィが、\nこうして張り切ってる時って、\nいつも何かろくでもない事が起きるんだよなぁ。", "face": "u672"}, {"name": "グスタフ", "text": "今回は何も起こらんわい！\nそれじゃあ行くぞ、耳を塞いで口を半開きにせい！\nせーの……発破ァ！！", "face": "u153"}, {"name": "ソーマ", "text": "きゃぁああっ！？", "face": "u23"}, {"name": "マイン", "text": "けほっ、けほっ……。\nまったく、もうちょっとタイミングってものを……って、\nほ、ほら言わんことじゃねぇ！！", "face": "u672"}, {"name": "リッカ", "text": "穴の奥に見えるの……あれ機甲兵ですよ！", "face": "u152"}, {"name": "グスタフ", "text": "採掘を続けていたら、\nいつかは遭遇していたんじゃ。\n早いか遅いかじゃろう。はっはっは。", "face": "u153"}, {"name": "マイン", "text": "まったく、困ったジジィだぜ……。", "face": "u672"}, {"name": "リッカ", "text": "王子、機甲兵の中には自爆する個体もいます。\n十分に警戒して迎撃してください！", "face": "u152"}]}, {"trigger": "end", "lines": [{"name": "リッカ", "text": "ふぅ……何とか片付きましたね。", "face": "u152"}, {"name": "ケイティ", "text": "グスタフさん、\n次からは相談してからにしてくださいね？", "face": "u114"}, {"name": "マイン", "text": "…………ん？\nおいジジィ、ありゃ何だ？\nこんな洞穴見たこと無いぞ？", "face": "u672"}, {"name": "ソーマ", "text": "グスタフさんの開けた穴の向こうに、\n別の洞穴が広がってるみたいですね。", "face": "u23"}, {"name": "グスタフ", "text": "これは……人工の洞穴じゃな。\n何者かが掘り進んだ跡があるぞい。", "face": "u153"}, {"name": "アンナ", "text": "ドワーフの皆さんが掘った洞窟ではない、\nとなると、魔物が潜んでいる可能性もありますね。", "face": "l031151a3e8d0"}, {"name": "アンナ", "text": "王子、安全確保の為にも、\n一度調査してはいかがでしょうか？", "face": "l031151a3e8d0"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "マイン", "text": "よぉし、そうとなりゃ乗り込むぜ！\n足場が悪いから注意してついてきな！", "face": "u672"}]}], "active": true}