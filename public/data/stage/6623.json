00, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 94}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 20000, "attack": 3900, "base_hp": 20000, "base_attack": 3900, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103296, "race_id": 10, "master_id": 263, "global_id": 262, "spawn_sec": 115}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097824, "master_id": 44, "global_id": 43, "spawn_sec": 116}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 400, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102160, "master_id": 364, "global_id": 363, "spawn_sec": 116}, {"enemy_id": 16, "source": "local", "count": 2, "form_count": 1, "hp": 20000, "attack": 2000, "base_hp": 20000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 321, "global_id": 320, "spawn_sec": 128}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "hp": 50000, "attack": 1200, "base_hp": 50000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 190, "attack_speed": 100, "attack_wait": 30, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114032, "race_id": 2, "special_effect_id": 232, "change_to": 17, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30919, "global_id": 4538, "ranged": true, "variants": [{"hp": 50000, "attack": 3000, "base_hp": 50000, "base_attack": 3000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 100, "attack_wait": 20, "attack_interval": 203, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114048, "race_id": 2, "master_id": 30920, "global_id": 4539}], "spawn_sec": 163}], "dialogue": [{"trigger": "start", "lines": [{"name": "ガード", "text": "魔王様。王国、帝国両軍が我が軍を挟撃する形で\n進軍しております。……恐らくは挟撃に呼応し、\n王子共の精鋭部隊が一気に魔王様を目指して来るかと。", "face": "l4a5ad89fe84a"}, {"name": "魔王ガリウス", "text": "未だ予の真の力を取り戻していない以上、\n捨て置くことは出来ないか。\nこの諦めの悪さ、かつての英雄王を思い出させるな。", "face": "l63d8013a65b7"}, {"name": "ガード", "text": "魔王様、私はゴブリンクイーンと共に、\n前線の指揮に当たりたいと思います。\n行くぞ、ゴブリンクイーン。", "face": "l4a5ad89fe84a"}, {"name": "メカゴブリンクイーン", "text": "了解よぉ。\nゴブリン軍団の実力、見せてあげるわぁ。", "face": "l9795ab823576"}, {"name": "魔王ガリウス", "text": "任せたぞ、我が臣下たちよ。\nクロコよ、お前はこちらの戦線に残れ。\n戦場全体を見渡し、変化があれば予に報告せよ。", "face": "l63d8013a65b7"}, {"name": "クロコ", "text": "――はッ。心得ました。", "face": "l71a8f4e034a3"}, {"name": "魔王ガリウス", "text": "英雄王の系譜、人類種の希望、\n物質界の守護者……何とも下らぬものだ。\n我が前に立たねば、滅びの時まで生き長らえたものを。", "face": "l63d8013a65b7"}, {"name": "アンナ", "text": "――いいえ、滅びの時は訪れません。\n王子と、そして私たちが貴方を倒してみせます！", "face": "l05bc605f113e"}, {"name": "魔王ガリウス", "text": "ほう、存外早かったな。\nそれに……ほう……？\n我が一撃を喰らって生き延びたか、シャディアよ。", "face": "l63d8013a65b7"}, {"name": "シャディア", "text": "王子、奴の話に付き合う必要はない。\n完全復活までは、まだ猶予があるはずだ。\nおそらくは時間稼ぎをしようという魂胆だろう。", "face": "u713"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "シャディア", "text": "私も戦うぞ、王子。\nせめて一太刀、奴に浴びせねば……。\n――ぐぅッ……！", "face": "u713"}, {"name": "アリサ", "text": "シャディアさん！！　無茶をしては駄目です！！\n本当なら死んでいてもおかしくない状態なんですよ！？", "face": "u24"}, {"name": "シャディア", "text": "くっ……どうして、この身体は動いてくれないのだ……。\n済まない……済まない王子……っ。", "face": "u713"}, {"name": "アンナ", "text": "シャディアさん、ここは私たちに任せて後方に退避を。\n……王子、これを最後の戦いとしましょう。\n戦闘の指揮をお願いします。――ご武運をっ！！", "face": "l05bc605f113e"}]}, {"trigger": "end", "lines": [{"name": "クロコ", "text": "――魔王様、前線の部隊ハ\n王国、帝国両軍に押されてイル様子。", "face": "l71a8f4e034a3"}, {"name": "魔王ガリウス", "text": "人間共もこれまで以上に本気、と言う事か。\n思った以上に楽しませてくれる。\n……だが、我が軍の消耗は捨て置けぬな。", "face": "l63d8013a65b7"}, {"name": "クロコ", "text": "はッ。兵を無駄に消耗させル必要もありますマイ……。\nここからは私も参戦いたしまショウ。", "face": "l71a8f4e034a3"}]}, {"trigger": "end", "lines": [{"name": "魔王ガリウス", "text": "……ほう、予に拮抗するか。\n真の力を得る前とはいえ、見事なものだ。\n褒めて遣わそう、王子よ。", "face": "l63d8013a65b7"}, {"name": "魔王ガリウス", "text": "――しかし、残念だったな。\n時間切れというやつだ、人類種共よ。", "face": "l63d8013a65b7"}, {"name": "シャディア", "text": "なっ……！？\n魔王の力が急激に高まっていく……！！\nまだ真の力の解放まで、時間がかかるはずだぞ！？", "face": "u713"}, {"name": "魔王ガリウス", "text": "アイギスから聞いていないのか？\nこの地には神々の戦い、その力の残滓が渦巻いている。\nただそれを、予の力に変じているだけのこと……。", "face": "l63d8013a65b7"}, {"name": "シャディア", "text": "そんな……。\n神の力を、吸収しているというのか……！？", "face": "u713"}, {"name": "魔王ガリウス", "text": "さぁ、余興は終わりだ。\n我が真の力を前にして、絶望に咽び泣くが良い。", "face": "l63d8013a65b7"}]}], "story_talk": true, "active": true}