{"quest_id": 8348, "name": "第八陣 庭園", "description": "亜神ハイドースの儀式を止めるべく、\n転移魔術で冥界にある庭園に辿り着いた\n一行は目的地へ進軍を開始する。\n神級（★１獲得の目安：平均Lv50）", "event": "帝国八陣", "event_category": "Empire", "mission_id": 940008, "map_no": 5064, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 23, "form_count": 2, "hp": 3000, "base_hp": 3000, "damage_type": "physical", "armor_defense": 120, "attack_speed": 1, "attack_wait": 120, "attack_interval": 314, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155216, "race_id": 18, "special_effect_id": 1179, "change_to": 1, "change_condition": 2, "master_id": 37834, "global_id": 11451, "to_condition": 2, "to_global_id": 11452, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 2000, "attack": 1, "base_hp": 2000, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 70, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2155232, "special_effect_id": 1799, "master_id": 37835, "global_id": 11452, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 33, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 322, "global_id": 321, "ranged": true, "spawn_sec": 50}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127760, "race_id": 21, "change_to": 4, "change_condition": 4, "master_id": 33555, "global_id": 7172, "to_condition": 4, "to_ticks": 3, "to_global_id": 7175, "spawn_sec": 84}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127776, "race_id": 21, "special_effect_id": 222, "master_id": 33558, "global_id": 7175, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 2, "hp": 8000, "attack": 1400, "base_hp": 8000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "change_to": 8, "change_condition": 4, "master_id": 33563, "global_id": 7180, "to_condition": 4, "to_ticks": 3, "to_global_id": 7183, "spawn_sec": 123}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 12, "source": "local", "count": 21, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127792, "race_id": 21, "change_to": 12, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 33559, "global_id": 7176, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 7179, "spawn_sec": 128}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127808, "race_id": 21, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 33562, "global_id": 7179, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 16, "source": "local", "count": 29, "form_count": 1, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 448, "global_id": 447, "ranged": true, "spawn_sec": 175}], "popups": ["冥界の蝶は、\n倒されると小さな黒炎に\n変化します。", "各種冥界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アグナ", "text": "――っ。\n痛ったたたた……ここは……？", "face": "u2251a1"}, {"name": "ヘイズル", "text": "ほら、しっかりして。\nここは冥界――『庭園』の入口だよ。", "face": "u2248a1"}, {"name": "レオナ", "text": "ということは、アダマス様が仕掛けたという\n転送魔術は無事に成功したということか。", "face": "u311"}, {"name": "ヘカティエ", "text": "冥界……？　本当に？\n確かに近い魔力を感じるけれど、\nここには、死者の魂の気配がなさ過ぎるわ。", "face": "u1226a1"}, {"name": "ヘイズル", "text": "ここには、冥界の影響は及ばないんだ。\n何しろここを最初に作ったのは\nアダマス様だからね。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "ただ、いずれ冥界軍に察知されて、\n敵が押し寄せてくるでしょうけど。", "face": "u2245a1"}, {"name": "アグナ", "text": "へぇ……冥界だけど、冥界じゃない場所か。\n冥界はどこも寂しい雰囲気ではあったけど、ここは――", "face": "u2251a1"}, {"name": "ルスティ", "text": "今までのどこよりも、\n静かで、悲しい感じがするね。", "face": "u2247a1"}, {"name": "ルスティ", "text": "――あっ、ちょうちょ発見！\n冥界にもちょうちょっているんだねー。", "face": "u2247a1"}, {"name": "アグナ", "text": "……物悲しい雰囲気を一瞬で破壊したな。", "face": "u2251a1"}, {"name": "ヘカティエ", "text": "ちょうちょ……？\n待って、それには触らないで！", "face": "u1226a1"}, {"name": "ルスティ", "text": "こっちおいでぇー……って、えぇぇえ！？\nなに！？　何か大変なことになるとか！？", "face": "u2247a1"}, {"name": "ヘカティエ", "text": "その蝶は、死を迎えると黒炎を咲かせるのよ。", "face": "u1226a1"}, {"name": "ザミエル", "text": "そんな危ない蝶が放し飼いか……。", "face": "u2246a1"}, {"name": "ザミエル", "text": "ともあれ、ここが入口ということは、\n目的地はこの先ということだな。\n敵を蹴散らしながら進むしかあるまい。", "face": "u2246a1"}, {"name": "ヘイズル", "text": "冥界軍もすぐに駆けつけるだろうしね。\nそれじゃあ、初代の信任まで受けた現皇帝、\n堂々たる指揮を頼んだよ？", "face": "u2248a1"}, {"name": "白の皇帝", "text": "…………ああ。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "ヴァイス", "text": "いつか死を迎える日が来たら、\nこの地に来ることになるんだな……。", "face": "u798"}, {"name": "ルーテ", "text": "なんだか、不思議な気分ですよね。\nいつか来るはずだった場所に、\n生きたまま来ているのですから。", "face": "u529"}, {"name": "クリスタ", "text": "死した魂は、何を考えているのでしょう。\n退屈ではないのかしら？", "face": "u709"}, {"name": "ヘカティエ", "text": "……私が話し相手くらいはしてあげるわよ？", "face": "u1226a1"}, {"name": "ヴィラヘルム", "text": "ふふっ、冥界も悪いところではありませんよ。\n私はその入口で、契約のために\n長らくとどまっていただけですが。", "face": "u2245a1"}, {"name": "ヘカティエ", "text": "人は短い生で、数多くの出来事に遭遇する。\nほんの少しの寿命の内に、\n目まぐるしすぎるほどの体験をするわ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "だからこそ、冥界では\n穏やかな眠りが待っているのよ。", "face": "u1226a1"}, {"name": "ヘイズル", "text": "正直、私はもっと眠っていたかった。\nまさかアダマス様が肉体を失った理由が、\n殺されたんじゃなくて、自分の選択だったなんて。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "まぁまぁ……。\nおかげで、懐かしい顔も見られたのですから、\n短い第二の人生だと思えば楽しいものですよ。", "face": "u2245a1"}, {"name": "ヘカティエ", "text": "懐かしい、顔……？\n帝国に、あなたたちの顔見知りなんていたかしら？", "face": "u1226a1"}, {"name": "ヴィラヘルム", "text": "本人ではないけれど、\nやっぱり、同じ血を引いていると、\n顔つきや髪色が似るものだなって。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "帝国貴族の末裔たちに、\n私と同じ血の流れる可愛い王女、それから――", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "あなた、ヴァイスの子孫でしょう？", "face": "u2245a1"}, {"name": "ヴァイス", "text": "…………！！", "face": "u798"}, {"name": "ヴァイス", "text": "……ヴァイスの名を、継いでおります。\n私が当代の族長です。", "face": "u798"}, {"name": "ヴィラヘルム", "text": "やっぱり。\n白の王国が乱れきって、どうしようもない時、\n私が帝政を掲げて国を再建し始めた時――", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "あなたの先祖が、私と共に戦ってくれました。\nありがとう。今も帝国の民でいてくれたのですね。", "face": "u2245a1"}, {"name": "ヴァイス", "text": "……身に余る光栄です、ヴィラヘルム様。", "face": "u798"}, {"name": "ヘイズル", "text": "あーあ、また人たらししてる……。\n可愛い現皇帝の臣下に手を出すのは良くないよ。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "えっ……あの、そんなつもりは……。\nもう、皆さん笑わないでください！", "face": "u2245a1"}, {"name": "アンジェリーネ", "text": "（本当に、人たらしですわね……。\n兵の緊張をほぐすために、道化を演じるなんて）", "face": "u430"}, {"name": "マリカ", "text": "（アンジェリーネ様も時々やってるじゃないですか。\nこれ、血筋だったんですねぇ）", "face": "u623"}, {"name": "アンジェリーネ", "text": "（……意図してやっていることは、\n皆には内緒にしておいてくださいね？）", "face": "u430"}, {"name": "ヘイズル", "text": "さて、まだ先は長い。\n気を引き締めて進もう。", "face": "u2248a1"}, {"name": "スイゼ", "text": "――いいや、これ以上は進ませない。\n神聖なる庭園を、アダマスの信徒が穢すことは許さない。", "face": "u2250a1"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 12, "params": [200]}, {"kind": "term", "influence": 18, "params": [150]}], "enemies": [{"enemy_id": 1, "hp": 4500, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2155216}, {"enemy_id": 1, "form_index": 1, "hp": 3000, "attack": 2, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2155232}, {"enemy_id": 3, "hp": 6000, "attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "pattern_id": 2101328}, {"enemy_id": 4, "hp": 3000, "attack": 450, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 4, "form_index": 1, "hp": 3000, "attack": 900, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 8, "hp": 12000, "attack": 2100, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127824}, {"enemy_id": 8, "form_index": 1, "hp": 12000, "attack": 525, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127840}, {"enemy_id": 12, "hp": 3750, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 12, "form_index": 1, "hp": 3750, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 16, "hp": 9000, "attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "pattern_id": 2103472}]}, "active": true}