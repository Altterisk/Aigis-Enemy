{"quest_id": 1937, "name": "大神ポセイオス", "description": "争いが生命の本質と謳う亜神は、破壊と\n憤怒の欠片を飲み込み真なる姿を現す。\n総力をもって海の大神の野望を打ち破れ！\n＜広域戦闘：敵味方の射程減少＞", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "ストーリーミッション11", "event_category": "Story", "mission_id": 100011, "map_no": 1157, "level": 100, "multiplier": 1.0, "charisma": 58, "capacity": 10, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 6, "tags": ["水棲", "ブロック不可", "狙う", "水中", "ステルスII"], "hp": 520000, "attack": 1, "base_hp": 520000, "base_attack": 1, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 70, "attack_speed": 1, "attack_wait": 50, "attack_interval": 222, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2154656, "race_id": 19, "special_effect_id": 1787, "change_to": 1, "master_id": 37786, "global_id": 11403, "to_global_id": 11404, "commands": {"raw": "SetStageFlag(1, 0); SetStageFlag(2, 0); SetStageFlag(3, 0); SetStageFlag(4, 0);", "sets_flags": [[1, 0], [2, 0], [3, 0], [4, 0]]}, "route_behaviour": {"transforms": [{"wait": 60}], "sets_flags": [[0, 1, 60], [1, 1, 60]], "calls_event": [2601, 2602]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 6, "tags": ["水棲", "ブロック不可", "狙う", "水中"], "hp": 520000, "attack": 10000, "base_hp": 520000, "base_attack": 10000, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 70, "attack_range": 240, "attack_speed": 1, "attack_wait": 50, "attack_interval": 221, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2154672, "race_id": 19, "special_effect_id": 1787, "change_to": 2, "missile_id": 542, "missile": {"speed": 17.0}, "master_id": 37787, "global_id": 11404, "ranged": true, "to_global_id": 11405}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 6, "tags": ["水棲", "ブロック不可", "狙う", "水中"], "hp": 520000, "attack": 6500, "base_hp"