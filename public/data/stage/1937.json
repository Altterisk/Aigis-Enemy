magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 17, "source": "local", "count": 19, "form_count": 2, "tags": ["水棲"], "hp": 24000, "attack": 1300, "base_hp": 24000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132464, "race_id": 2, "change_to": 17, "master_id": 34509, "global_id": 8126, "to_global_id": 8125, "spawn_sec": 255}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲", "ブロック不可"], "hp": 24000, "attack": 900, "base_hp": 24000, "base_attack": 900, "damage_type": "magical", "armor_defense": 200, "magic_defense": 5, "attack_range": 240, "attack_speed": 1, "attack_wait": 42, "attack_interval": 131, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2132448, "race_id": 2, "special_effect_id": 947, "change_to": 16, "missile_id": 227, "missile": {"speed": 4.0}, "master_id": 34508, "global_id": 8125, "ranged": true}, {"enemy_id": 19, "source": "local", "count": 16, "form_count": 1, "hp": 15000, "attack": 650, "base_hp": 15000, "base_attack": 650, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 20, "attack_range": 180, "attack_speed": 1, "attack_wait": 10, "attack_interval": 57, "move_speed": 2400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2128976, "race_id": 7, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 37800, "global_id": 11417, "ranged": true, "spawn_sec": 282}, {"enemy_id": 20, "source": "local", "count": 14, "form_count": 1, "tags": ["水棲", "アーマー"], "hp": 25000, "attack": 1600, "base_hp": 25000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 2500, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136512, "special_effect_id": 621, "master_id": 34854, "global_id": 8471, "spawn_sec": 329}, {"enemy_id": 21, "source": "local", "count": 6, "form_count": 1, "tags": ["水棲"], "hp": 130000, "attack": 3600, "base_hp": 130000, "base_attack": 3600, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 150, "attack_wait": 80, "attack_interval": 389, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136448, "master_id": 34850, "global_id": 8467, "spawn_sec": 379}], "popups": ["光を放つマスに配置したユニットは\nアトランティスの防衛結界により\nHP、攻撃、防御、射程が\n大幅に上昇します。", "大神ポセイオスの通常攻撃や\n落下攻撃の二段目を受けると\n「水の檻」状態になり、\n攻撃後の待ち時間が増加します。\nまた一定時間\n継続ダメージを受けます。\n\n　　　　　　(1/2)", "「水の檻」は\n深海の影響に対する\nユニット能力で軽減、\n無効化が可能です。\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "オオワタツミの化身", "text": "アトランティス浮上により、\nこの地は巨大な内海と化している。\n行くぞクラールフ、今こそ我が大渦を見せる時。", "face": "lae28b5444c2e"}, {"name": "クラールフ", "text": "久しい感覚だ。\n何かを守るために己の身を捧ぐのではない、\n勝ち取るために、自ら渦中へ飛び込むこの感覚は。", "face": "l20681e9a5514"}, {"name": "乙姫", "text": "渦巻けぇ～♪　逆巻け～♪\n渦潮をここにぃ～！！", "face": "u1803a1"}, {"name": "フレイ", "text": "よーそろー！！　おまたせ王子！\nこのまま艦隊で全経路を封鎖するよ！", "face": "u423"}, {"name": "鬼刃衆", "text": "今こそ姫さまに戦働きを見せる時！\n鬼刃水軍、寡兵なれども助太刀いたす！！", "face": "lfa650db3fe99"}, {"name": "竜吉公主", "text": "行くわよセノーテちゃん、アクアマリーちゃん！\n外海から来る敵を――全部せき止める！！", "face": "u663"}, {"name": "セノーテ", "text": "は、はい！\n水霊のみんな、あつまってくださーい！！", "face": "u502"}, {"name": "アクアマリー", "text": "ウンディーネ、力を……貸してください！\n王子様たちの戦いを、誰にも邪魔させないで！", "face": "u659"}, {"name": "イヴリール", "text": "海がいつ、ポセイオスのものに決まったって？\nこれだけの敵対者に囲まれてよく謳うものだ。", "face": "u1959a1"}, {"name": "ポセイオス", "text": "おぉ、おぉ……何と強大な軍勢よ。\nメシナ、お前がこれだけの仲間を集めたのか？", "face": "l40a6ab415701"}, {"name": "メシナ", "text": "いいえ、私の力じゃありませんわ。\n彼らは皆、王子の決意と誓いのもとへ集った者たち。", "face": "u1506a1"}]}, {"trigger": "start", "lines": [{"name": "ポセイオス", "text": "グワッハッハッハッハ！！\nそうか、そうか！\nそれでこそ喰らいがいがあるというものじゃなァ！！", "face": "l40a6ab415701"}, {"name": "ポセイオス", "text": "ならばこちらも、あらん限りの力を示そうぞ！！", "face": "l40a6ab415701"}, {"name": "アネリア", "text": "なっ……空を泳いでる！？\nそれ反則じゃないの！？", "face": "u184"}, {"name": "イヴリール", "text": "こっちだって数で囲んでるんだ。\n相手が何をしてきたって、真正面から食い破るだけだ。", "face": "u1959a1"}, {"name": "アトランティスの巨人兵", "text": "――デューオ様。", "face": "l6b6d860e92b3"}, {"name": "デューオ", "text": "わっ……なに？　どうしたの？", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "彼らは全て、デューオ様の仲間――\n我らアトランティス軍の、\n友軍だと認識してよろしいでしょうか？", "face": "l6b6d860e92b3"}, {"name": "デューオ", "text": "うん、そうだよ。\nみんな、アタシの大切な仲間たちさ！\nいつか全員連れて、大冒険に行くんだよ。", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "了解しました。\n敵味方識別コードを更新。\nアトランティス防衛結界の適用対象に設定します。", "face": "l6b6d860e92b3"}, {"name": "アトランティス", "text": "王国代表者、王子殿。\n我ら古代アトランティスの意志を、\nこの地に存在したという証を、貴方に託しました。", "face": "l9e93f5ea87eb"}, {"name": "デューオ", "text": "わっ……何この光？\n何だか、身体があったかくなってきたような……。", "face": "u594"}, {"name": "アトランティスの巨人兵", "text": "都市決戦用兵装、\nアトランティス防衛用の魔法陣を展開中です。\nアトランティスも、皆さまと共に戦います。", "face": "l6b6d860e92b3"}, {"name": "王子", "text": "ああ。共に戦おう。\nこれはアトランティスの民の、故郷を取り戻す戦いだ。", "face": "u1"}, {"name": "アトランティスの巨人兵", "text": "はい。そして皆さま、この時代の人類の、\n故郷を守るための戦いです。", "face": "l6b6d860e92b3"}, {"name": "王子", "text": "行くぞ、ポセイオス。\n海と大地の皆が、お前の野望を砕く。", "face": "u1"}, {"name": "ポセイオス", "text": "ああ、来い王子よ！\n大神ポセイオス、全力で相手をしてやろう！！", "face": "l40a6ab415701"}]}, {"trigger": "end", "lines": [{"name": "ポセイオス", "text": "…………大神の力をもってなお、\nそれを乗り越えてくるか、王子よ。", "face": "l40a6ab415701"}, {"name": "ポセイオス", "text": "やはり欲しい……その力、その存在……。\nそれだけの力を得て、なぜ貴様は、\n世界を手に入れようとせぬのだ……。", "face": "l40a6ab415701"}, {"name": "王子", "text": "――奪われる者の悲しみを、知っているからだ。", "face": "u1"}, {"name": "ポセイオス", "text": "二度と奪われぬよう、\nすべてを手中に収めようとは思わぬのか。", "face": "l40a6ab415701"}, {"name": "王子", "text": "そう願う者がいたならば、\nそれは、俺たちの敵だ。", "face": "u1"}, {"name": "ポセイオス", "text": "………ククッ、ハハハッ、グワッハッハッハ！！", "face": "l40a6ab415701"}, {"name": "ポセイオス", "text": "いつか、必ず貴様を我がしもべにしてやろう。\nだから覚えておけ、王子ッ！！", "face": "l40a6ab415701"}, {"name": "ポセイオス", "text": "――貴様が勝利をもって掴んだ平和こそ、\nこの大神ポセイオスが願った、\n戦いの果ての栄光そのものだとッ！！", "face": "l40a6ab415701"}, {"name": "フローガ", "text": "ポセイオスの魔力が砕けていきます。\nあっ……海の底に、沈んで……。", "face": "u878"}, {"name": "メシナ", "text": "お父さま……。", "face": "u1506a1"}, {"name": "オオワタツミの化身", "text": "終わった、か。", "face": "lae28b5444c2e"}, {"name": "クラールフ", "text": "後は我らの仕事だ。\n肉体をこの海溝に封じる結界を施さねば。\nオオワタツミ殿、手伝って貰えるか？", "face": "l20681e9a5514"}, {"name": "オオワタツミの化身", "text": "無論よ、すぐに取り掛かるとしよう。", "face": "lae28b5444c2e"}, {"name": "メシナ", "text": "――ところで王子、何か忘れてないかしら？\n皆、あなたの言葉を待っていますのよ。", "face": "u1506a1"}, {"name": "王子", "text": "……メシナ。", "face": "u1"}, {"name": "メシナ", "text": "……大丈夫、私が海の未来を、受け継ぎますわ。", "face": "u1506a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "王子", "text": "――俺たちの、勝利だ。\n海の平和は、ここに守られた。", "face": "u1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "クレール", "text": "ポセイオスの上昇を確認。\n……いったい何をするつもり！？", "face": "u1046a1"}, {"name": "フローガ", "text": "ポセイオスの魔力が増幅されています！\n王子殿下、警戒を！！", "face": "u878"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 25, "params": [300], "expression": "(IsIdentitiy(\"深海\"); || IsIdentitiy(\"銃士\");) != 1;", "expression_human": "not (it has the identity [[tag:深海]] and or it has the identity [[tag:銃士]])"}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 18, "params": [160]}], "enemies": [{"enemy_id": 1, "hp": 676000, "attack": 1, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 70, "pattern_id": 2154656}, {"enemy_id": 1, "form_index": 1, "hp": 676000, "attac