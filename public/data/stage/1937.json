 "pattern_id": 2136496}, {"enemy_id": 15, "hp": 7800, "attack": 780, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 16, "hp": 7800, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 16, "form_index": 1, "hp": 7800, "attack": 780, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 17, "hp": 31200, "attack": 1690, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132464}, {"enemy_id": 17, "form_index": 1, "hp": 31200, "attack": 900, "damage_type": "magical", "armor_defense": 200, "magic_defense": 5, "pattern_id": 2132448}, {"enemy_id": 19, "hp": 19500, "attack": 650, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 20, "pattern_id": 2128976}, {"enemy_id": 20, "hp": 32500, "attack": 2080, "damage_type": "physical", "armor_defense": 2500, "pattern_id": 2136512}, {"enemy_id": 21, "hp": 169000, "attack": 4680, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "pattern_id": 2136448}]}, "active": true}