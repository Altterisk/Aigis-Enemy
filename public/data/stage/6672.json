_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109104, "race_id": 16, "special_effect_id": 61, "change_to": 6, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 473, "global_id": 472, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 24000, "attack": 600, "base_hp": 24000, "base_attack": 600, "damage_type": "physical", "armor_defense": 65, "magic_defense": 20, "attack_range": 170, "attack_speed": 90, "attack_wait": 50, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115280, "race_id": 16, "special_effect_id": 299, "missile_id": 291, "missile": {"speed": 15.0}, "master_id": 31144, "global_id": 4763, "ranged": true, "spawn_sec": 128}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 21000, "attack": 1600, "base_hp": 21000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 125, "attack_interval": 293, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115264, "race_id": 16, "special_effect_id": 61, "missile_id": 290, "missile": {"splash": 93}, "master_id": 31145, "global_id": 4764, "ranged": true, "spawn_sec": 129}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 2, "tags": ["ステルス"], "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103744, "race_id": 16, "special_effect_id": 61, "change_to": 11, "master_id": 474, "global_id": 473, "to_global_id": 474, "spawn_sec": 134}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 800, "base_hp": 12000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103712, "race_id": 16, "special_effect_id": 61, "change_to": 10, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 475, "global_id": 474, "ranged": true}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 2, "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109136, "race_id": 16, "special_effect_id": 61, "change_to": 13, "master_id": 30132, "global_id": 3751, "to_global_id": 3752, "route_behaviour": {"transforms": [{"wait": 1500}]}, "spawn_sec": 144}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 135, "attack_interval": 361, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109152, "race_id": 16, "special_effect_id": 61, "change_to": 12, "missile_id": 26, "master_id": 30133, "global_id": 3752, "ranged": true}], "popups": ["アサシンから受けたダメージは\n２倍になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ネヴィン", "text": "ここが報告にあった、\n闇の組織の拠点のひとつか？", "face": "u407"}, {"name": "アンナ", "text": "すみません、ネヴィンさん。\n別のご用事で訪ねてこられたのに、\nここまで同行していただいて……。"}, {"name": "ネヴィン", "text": "急ぎの用ではなかったし、構わないさ。\n引き合わせたい者が居たんだが、\n後回しにせざるを得ないようだからな。", "face": "u407"}, {"name": "セシリー", "text": "――ん、ようやく来たな。\nこっちだ王子。", "face": "u21"}, {"name": "アンナ", "text": "セシリーさん、セブンさん、\n見張りお疲れ様です。この場に\n闇の組織が出入りしているとのことでしたが……。", "face": "lf3819494e5d1"}, {"name": "セブン", "text": "うん。幹部らしき奴の姿も確認したよ。\nでも、ひとつ問題があって……。", "face": "u449"}, {"name": "ネヴィン", "text": "問題？　いったい何があったんだ？", "face": "u407"}, {"name": "セブン", "text": "あれ見てよ。あのダークエルフが、\n闇の組織の連中を追い詰めててさ。\nもう一触即発って感じ。", "face": "u449"}]}, {"trigger": "start", "lines": [{"name": "ネヴィン", "text": "へぇ、地上でダークエルフとは、珍し――って、あぁ？\nどうしてあいつ、あんな所にいるんだ。", "face": "u407"}, {"name": "セシリー", "text": "なんだ、知り合いなのか？", "face": "u21"}, {"name": "ネヴィン", "text": "知り合いも何も、用事っていうのが\n王子とあいつを引き合わせることだったんだ。\n突然いなくなったと思ったら……まったく……。", "face": "u407"}, {"name": "セシリー", "text": "どうする。このまま放っておけば、\nおそらくあのダークエルフひとりで、\n闇の組織と激突することになるが。", "face": "u21"}, {"name": "アンナ", "text": "ネヴィンさんのお知り合いとあれば、\n見過ごすわけにはいきません。\n王子、あの方を助けにいきましょう。", "face": "lf3819494e5d1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ネヴィン", "text": "手間をかけるな、王子。\n説教は後であいつにしてやってくれ。", "face": "u407"}]}, {"trigger": "end", "lines": [{"name": "セシリー", "text": "ちっ、生き残りは逃げ出したか……。", "face": "u21"}, {"name": "アンナ", "text": "しかし、闇の組織の戦力は削ぐことが出来ました。\n何より彼女も無事なようですしね。"}, {"name": "？？？", "text": "……ネヴィン、助けてとは言ってないんだけど。", "face": "u735"}, {"name": "ネヴィン", "text": "まったく、今日は王子と顔合わせだって言っただろう。\nそれがどうしてこんな所で、\n勝手に闇の組織相手に戦うことになってたんだ。", "face": "u407"}, {"name": "？？？", "text": "……それは……ただ、見過ごせなかっただけよ。", "face": "u735"}, {"name": "セブン", "text": "見過ごせなかった？　裏取引を？", "face": "u449"}, {"name": "？？？", "text": "……いいえ、こいつら、子供を誘拐していたから。\n本当はわたしだけでも十分だったんだけど、\n一応、お礼は言っておくわ。――ありがとう。", "face": "u735"}, {"name": "ネヴィン", "text": "素直なんだか素直じゃないんだか……まぁいい。\n王子、こいつはジルヴァ、魔界都市の牢獄長だ。\n女王の命で、今後は王国に協力することになる。", "face": "u407"}, {"name": "ジルヴァ", "text": "――えっ？　あなたが王子だったの？\nへぇ……ふぅん……悪くないじゃない。", "face": "u735"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "ジルヴァ", "text": "我らが女王、ドロテア様から\nあなたに協力するように言われているの。\n実力を見せられてちょうどよかったわね。", "face": "u735"}, {"name": "ジルヴァ", "text": "それじゃあわたしは、さらわれていた子供を\n元の街へ帰してあげなくちゃいけないから。\nそろそろ行くわね。また会いましょう、王子？", "face": "u735"}, {"name": "ネヴィン", "text": "……まぁ、そういうわけだ。\n悪い奴じゃない。ちょっと変わってはいるけどな。", "face": "u407"}, {"name": "アンナ", "text": "どうやら、頼りになる仲間が増えそうですね。\n我々もこの拠点の調査をしてから、\n王国へ帰還しましょう。"}]}], "active": true}