{"quest_id": 60001, "name": "雪原の転生者", "description": "前世の記憶に困惑する少女を鎮めよ！\n＜白の皇帝の出撃時の初期HP減少：中＞\n＜白の皇帝の攻撃力がダウン＞\n神級（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["白の皇帝の出撃時の初期HP減少：中", "白の皇帝の攻撃力がダウン"], "event": "帝国大戦　タルタロス編第二幕", "event_category": "Empire", "mission_id": 940012, "map_no": 7505, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 160000, "attack": 1800, "base_hp": 160000, "base_attack": 1800, "damage_type": "magical", "armor_defense": 700, "magic_defense": 30, "attack_range": 170, "attack_speed": 1, "attack_wait": 60, "attack_interval": 191, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2173424, "race_id": 19, "special_effect_id": 1039, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 41206, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 420, "base_hp": 5000, "base_attack": 420, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 39329, "global_id": 12946, "spawn_sec": 54}, {"enemy_id": 3, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 24000, "attack": 650, "base_hp": 24000, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_ra