in_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130512, "race_id": 12, "change_to": 7, "master_id": 40927, "to_condition": 0, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 173}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 166000, "attack": 4000, "base_hp": 166000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 500, "attack_range": 40, "attack_speed": 1, "attack_wait": 90, "attack_interval": 219, "move_speed": 1100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130528, "race_id": 12, "special_effect_id": 789, "change_to": 8, "change_condition": 1, "missile_id": 11, "master_id": 40928, "ranged": true, "from_condition": 0, "variants": [{"tags": ["アーマー"], "hp": 166000, "attack": 800, "base_hp": 166000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "attack_speed": 1, "attack_wait": 60, "attack_interval": 160, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130512, "race_id": 12, "master_id": 40929}]}, {"enemy_id": 10, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "hp": 172000, "attack": 2000, "base_hp": 172000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 20, "attack_wait": 75, "attack_interval": 241, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118528, "race_id": 12, "change_to": 10, "change_condition": 3, "master_id": 40932, "to_condition": 3, "spawn_sec": 224}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 172000, "attack": 1800, "base_hp": 172000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 300, "attack_range": 200, "attack_speed": 20, "attack_wait": 50, "attack_interval": 137, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118544, "race_id": 12, "special_effect_id": 374, "missile_id": 357, "missile": {"speed": 10.0}, "master_id": 40933, "ranged": true, "from_condition": 3}], "popups": ["\n\n\n\n　　――白の帝国北部"], "dialogue": [{"trigger": "battle", "at_sec": 52, "lines": [{"text": "――白の帝国北部"}, {"name": "白の皇帝", "text": "…………懐かしいな、この街も。", "face": "u418"}, {"name": "ヘルメルク", "text": "へぇ、侵攻でもしたことあるの？", "face": "u2275a1"}, {"name": "白の皇帝", "text": "いいや、昔、訪れたことがあるだけだ。\nあの頃は皇帝でも何でもない、ただの旅人だった。", "face": "u418"}, {"name": "ヘルメルク", "text": "ふぅん、じゃあ今と同じだね。\n白の皇帝ぶらりひとり旅だし。", "face": "u2275a1"}, {"name": "白の皇帝", "text": "……ひとり旅の予定だったが、\nなぜ貴様がここにいる。", "face": "u418"}, {"name": "ヘルメルク", "text": "もー、わかってるでしょ。\n皇帝陛下をひとりで旅なんてさせられないよ。", "face": "u2275a1"}, {"name": "ヘルメルク", "text": "一箇所にとどまると、君を中心に\nタルタロスの呪いが広がってしまう。\nだから一箇所にとどまらないようにする必要がある。", "face": "u2275a1"}, {"name": "ヘルメルク", "text": "そこまでは、まぁ、納得できるよ。\nついでに情報収集もしようっていうのも分かる。", "face": "u2275a1"}, {"name": "ウルスラ", "text": "だからって、護衛をつけないというのは\nさすがにアンジェリーネ様もディアナ様も\nお許しにならないわけですよ。", "face": "u1552a1"}, {"name": "ヘルメルク", "text": "だから、王子に頼まれた旅人の守護神でもある僕と、\n帝国代表でそこのニンジャが来ているわけ。", "face": "u2275a1"}, {"name": "白の皇帝", "text": "……騒々しくて仕方ない。\nついてくるなとは言わんが、距離を取れ。\nタルタロスの呪いがどんな影響を及ぼすかも分からん。", "face": "u418"}, {"name": "ヘルメルク", "text": "はいはい。\nあっ、あの屋台いいな……ちょっと買ってこよ。", "face": "u2275a1"}, {"name": "ウルスラ", "text": "あっ、拙の分もお願いします！\nお財布はこちらの陛下護衛用機密費から！", "face": "u1552a1"}, {"name": "白の皇帝", "text": "…………はぁ。", "face": "u418"}, {"name": "白の皇帝", "text": "――ッ……まったく、\n呪いに蝕まれるのも、難儀なことだ。", "face": "u418"}, {"name": "白の皇帝", "text": "だが……肉体の苦痛など、\n一度は国を失った、やつのことを思えば――", "face": "u418"}, {"name": "？？？", "text": "――ねぇ、大丈夫？\nわっ……すごい汗。ちょっと、絶対休んだほうがいいよ！", "face": "u2912a1"}, {"name": "白の皇帝", "text": "……何者だ。", "face": "u418"}, {"name": "？？？", "text": "何者って、この村の住人だけど……。\nほら、うちの納屋くらいなら貸してあげるから！", "face": "u2912a1"}, {"name": "白の皇帝", "text": "……俺に構うな。", "face": "u418"}, {"name": "ヘルメルク", "text": "――そうそう。\nお宿はちゃんと取るから、まぁ安心して。\n旅の連れもほら、このとおりいるわけだし。", "face": "u2275a1"}, {"name": "ウルスラ", "text": "（えっ、せっかくならご厚意に甘えてもいいのでは？）", "face": "u1552a1"}, {"name": "ヘルメルク", "text": "（この子もここの住人なら帝国臣民。\n陛下も民に呪いの影響を与えたくはないでしょ）", "face": "u2275a1"}, {"name": "？？？", "text": "……あ、あっ……あなた、は……。", "face": "u2912a1"}, {"name": "ヘルメルク", "text": "ん？　ああ、僕？\nどこかで会ったことあったっけ……。", "face": "u2275a1"}, {"name": "？？？", "text": "し、らない、知らないはずなのに……。\nいやっ……こんなの、\nあなたのことなんて、知らないはずなのに……。", "face": "u2912a1"}, {"name": "白の皇帝", "text": "……下がれ、ヘルメルク、ウルスラ。\nこの娘、様子がおかしい。", "face": "u418"}, {"name": "ウルスラ", "text": "いや、下がるのは陛下の方では！？", "face": "u1552a1"}, {"name": "？？？", "text": "熱い……あの炎が、また……。\nいやっ、もうあの場所には、戻りたくないの！", "face": "u2912a1"}, {"name": "ヘルメルク", "text": "おっと……この魔力は、もしや……。", "face": "u2275a1"}, {"name": "白の皇帝", "text": "タルタロスの魔力か……。", "face": "u418"}, {"name": "ヘルメルク", "text": "こんなところで魔力を撒き散らしたら……。\nウルスラ！　住人の避難を！\n野生の魔物が騒ぎ出すかもしれない！", "face": "u2275a1"}, {"name": "ウルスラ", "text": "陛下の方は！？", "face": "u1552a1"}, {"name": "ヘルメルク", "text": "大丈夫だよ。\nもう、彼がすぐそこまで来てるから。", "face": "u2275a1"}]}, {"trigger": "end", "lines": [{"name": "白の皇帝", "text": "……王子か。\nなるほど、そろそろ定期会合の時期だったか。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "？？？", "text": "はぁ……っ、はぁ……。\n来ないで。もう、近づかないで……。", "face": "u2912a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "？？？", "text": "……あなたは……王子、殿下？\n私を、助けるつもりなの？", "face": "u2912a1"}, {"name": "白の皇帝", "text": "周囲に獣が残っていないか確かめろ。\n負傷者がいれば……王国に任せられるか？", "face": "u418"}, {"name": "アンナ", "text": "承知しました。\n癒し手も連れてきていますので、おまかせを。"}, {"name": "ヘルメルク", "text": "えーっと……さてと……。\n怖がられたままだと困るんだけど、\n僕、きみに何かしたっけ……？", "face": "u2275a1"}, {"name": "？？？", "text": "私を……捕まえるんじゃ、ないの？\nあなたは……亜神ディアスの、血縁者、よね？", "face": "u2912a1"}, {"name": "ヘルメルク", "text": "えっ。", "face": "u2275a1"}, {"name": "ヘルメルク", "text": "……きみ、もしかしてオリュンポスの関係者だったり？\nいや、でもその顔に見覚えはないし……。", "face": "u2275a1"}, {"name": "白の皇帝", "text": "……タルタロスの、転生者か？", "face": "u418"}, {"name": "ヘルメルク", "text": "…………！\nそうか、さっきの炎……。\nあれはきみの力ではなく、きみを罰していた炎か。", "face": "u2275a1"}, {"name": "？？？", "text": "…………。", "face": "u2912a1"}, {"name": "ヘルメルク", "text": "覚えてるよ。\n亜神ディアスの妻に手を出そうとして、\n永遠の炎に焼かれ続けることになった亜神のこと。", "face": "u2275a1"}, {"name": "ヘルメルク", "text": "焼き続けるだけじゃなくて、\nまさかタルタロスに幽閉していたなんて……。\n身内のことながらえげつない……。", "face": "u2275a1"}, {"name": "白の皇帝", "text": "……過去のことは、知らん。\nだが俺たちが貴様を傷つけることはない。\nそれに――亜神ディアスは、この男が倒した。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "？？？", "text": "そう、なの……？", "face": "u2912a1"}, {"name": "白の皇帝", "text": "娘、名は？", "face": "u418"}, {"name": "イクセリス", "text": "イクセリス。\n……私は、イクセリス。", "face": "u2912a1"}, {"name": "白の皇帝", "text": "イクセリス。俺たちは、貴様を罰しに来たのではない。\nだが、タルタロスのことを少しでも知っているなら、\nその記憶と知識を頼りたい。話せるか？", "face": "u418"}, {"name": "イクセリス", "text": "……うん。\nあなたの……その呪いのこと、かな？", "face": "u2912a1"}, {"name": "イクセリス", "text": "私が知ってるものと、似てるよ。\nでも、どうして人間に、こんな酷い呪いを……。", "face": "u2912a1"}, {"name": "アンナ", "text": "落ち着いて話せる場所を借りましょう。\n王子、陛下、こちらへ。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 10, "params": [10]}, {"kind": "term", "influence": 18, "params": [120]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 160000, "attack": 1800, "damage_type": "magical", "armor_defense": 700, "magic_defense": 30, "pattern_id": 2173424}, {"enemy_id": 2, "form_index": 0, "hp": 5000, "attack": 420, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "pattern_id": 2101264}, {"enemy_id": 3, "form_index": 0, "hp": 24000, "attack": 650, "damage_type": "physical", "armor_defense": 2000, "pattern_id": 2097472}, {"enemy_id": 4, "form_index": 0, "hp": 5000, "attack": 340, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "pattern_id": 2162320}, {"enemy_id": 5, "form_index": 0, "hp": 62000, "attack": 1550, "damage_type": "physical", "armor_defense": 350, "pattern_id": 2158176}, {"enemy_id": 6, "form_index": 0, "hp": 35000, "attack": 600, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2122160}, {"enemy_id": 7, "form_index": 0, "hp": 166000, "attack": 800, "damage_type": "physical", "armor_defense": 500, "pattern_id": 2130512}, {"enemy_id": 7, "form_index": 1, "hp": 166000, "attack": 4000, "damage_type": "physical", "armor_defense": 500, "pattern_id": 2130528}, {"enemy_id": 10, "form_index": 0, "hp": 172000, "attack": 2000, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2118528}, {"enemy_id": 10, "form_index": 1, "hp": 172000, "attack": 1800, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2118544}]}, "active": true}