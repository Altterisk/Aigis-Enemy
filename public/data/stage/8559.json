"race_id": 16, "missile_id": 614, "missile": {"speed": 4.0}, "master_id": 34132, "global_id": 7749, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 28, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 64, "global_id": 63}, {"enemy_id": 5, "source": "local", "count": 20, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 45, "attack_interval": 148, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160640, "race_id": 16, "special_effect_id": 1795, "master_id": 38796, "global_id": 12413}, {"enemy_id": 6, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 19000, "attack": 900, "base_hp": 19000, "base_attack": 900, "damage_type": "physical", "armor_defense": 240, "attack_range": 360, "attack_speed": 1, "attack_wait": 90, "attack_interval": 223, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131088, "race_id": 16, "missile_id": 615, "missile": {"speed": 6.0}, "master_id": 34134, "global_id": 7751, "ranged": true, "spawn_sec": 127}], "dialogue": [{"trigger": "start", "lines": [{"name": "過去のエンキドゥ", "text": "――戦況はどうなっていますか。", "face": "l08a3257497e4"}, {"name": "砦の兵士", "text": "……この砦は、もう駄目です。\n城門が先程破られました。", "face": "u65"}, {"name": "過去のエンキドゥ", "text": "そう、ですか……。", "face": "l08a3257497e4"}, {"name": "砦の兵士", "text": "気を落とさないでください。\nここまで保たせることができたのが奇跡なんです。", "face": "u65"}, {"name": "砦の兵士", "text": "不意にあなたが、\n空から降ってきた時には驚きましたよ。", "face": "u65"}, {"name": "砦の兵士", "text": "それどころか、劣勢であった我らのために、\n剣を取って戦ってくれるとは。\nあなたに出会ってから、驚いてばかりです。", "face": "u65"}, {"name": "過去のエンキドゥ", "text": "やめてください。\nただ、死に場所を探していただけなのですから。", "face": "l08a3257497e4"}, {"name": "砦の兵士", "text": "最後に、聞かせてくれませんか？\nあなたはなぜ、そんなに死にたがっていたのですか？", "face": "u65"}, {"name": "過去のエンキドゥ", "text": "……生きる意味を、失ったからですよ。\n初めて会ったときに言ったでしょう？", "face": "l08a3257497e4"}, {"name": "砦の兵士", "text": "時代がどうの、というのですか？\nその辺りは、さっぱり分かりませんが……。", "face": "u65"}, {"name": "砦の兵士", "text": "ですが、我々はあなたに生きる希望を、\n戦う意志を与えられました。\nあなたこそ、我らの戴く英雄そのものです。", "face": "u65"}, {"name": "過去のエンキドゥ", "text": "ははっ……そうですか。\nこの身が、英雄……なるほど。", "face": "l08a3257497e4"}, {"name": "砦の兵士", "text": "何か、お気に召しましたか？\nそれでは、私も最後の戦場に参ります。\n次に会うときは冥界で。共に酒盛りでも――", "face": "u65"}]}, {"trigger": "start", "lines": [{"name": "アヴリック", "text": "――ッ！！　こ、ここは……！？", "face": "u2442a1"}, {"name": "砦の兵士", "text": "なっ……どこから現れた！？\n敵の魔術の類か！？", "face": "u65"}, {"name": "オーシェン", "text": "どうやら、どこかの戦場に紛れ込んだようですね……。\nシビラ様、私の後ろに！", "face": "u2133a1"}, {"name": "シビラ", "text": "大丈夫、こういう時には人手が必要でしょう？", "face": "u39"}, {"name": "アンナ", "text": "こちらに戦闘の意思はありません！\n双方、剣を引いてください！", "face": "lb67ee2de3dd8"}, {"name": "砦の兵士", "text": "敵兵の言うことなど信用できぬ！\n我が同胞たちよ、ここが死に場所だ！\n祖国のため、敵の首を叩き斬れッ！！", "face": "u65"}, {"name": "シビラ", "text": "説得不能……まぁ、そうよね。\n王子、敵が来るわ。構えて！", "face": "u39"}]}, {"trigger": "end", "lines": [{"name": "エンキドゥ？", "text": "――見事な戦いぶりでした。", "face": "l08a3257497e4"}, {"name": "フィノーラ", "text": "何のつもりだ、これは。\nここはいったいどこだ！？", "face": "u2441a1"}, {"name": "エンキドゥ？", "text": "歴史を作り変えるために必要な要因を、\nひとつずつ、揃えているだけですよ。", "face": "l08a3257497e4"}, {"name": "エンキドゥ？", "text": "これで、ようやく舞台を始めることができます。\n時の監視者フィノーラ、\n少々回り道をしましたが、あなたのおかげです。", "face": "l08a3257497e4"}, {"name": "フィノーラ", "text": "協力なんてした覚えはないぞ。", "face": "u2441a1"}, {"name": "エンキドゥ？", "text": "あなたたちが『時の破片』などという、\n魔力に頼らず世界を歪める技術を、\nこの世界に見いだしてくれたのです。", "face": "l08a3257497e4"}, {"name": "クロノシア", "text": "……違和感の正体が、ようやく分かりました。\n『時の破片』を用いれば、\n私に観測されることなく、時間を書き換えられる。", "face": "u1986a1"}, {"name": "クロノシア", "text": "あなたは既に、一度この時を経験している。\nそうですね？", "face": "u1986a1"}, {"name": "エンキドゥ？", "text": "御名答、さすがは時の女神。", "face": "l08a3257497e4"}, {"name": "エンキドゥ？", "text": "目的は、ただひとつ。\nこの時代、この場所に、\n『時の破片』を残していくこと。", "face": "l08a3257497e4"}, {"name": "エンキドゥ？", "text": "幾度も繰り返して、ようやく成功しました。\nそれでは、未来へ帰りましょうか。", "face": "l08a3257497e4"}, {"name": "フィノーラ", "text": "させるか――ッ！！", "face": "u2441a1"}, {"name": "エンキドゥ？", "text": "無意味ですよ、『時の破片』の力は、\n時の魔術とも、次元転移とも異なるものなのですから。", "face": "l08a3257497e4"}]}, {"trigger": "end", "lines": [{"name": "過去のエンキドゥ", "text": "…………。", "face": "l08a3257497e4"}, {"name": "過去のエンキドゥ", "text": "…………転移魔法。\nいや、違う……見たことのない、力だった。", "face": "l08a3257497e4"}, {"name": "過去のエンキドゥ", "text": "これだ……この輝く何か……。\n『時の破片』……？\nこれが、確かに、何かを引き起こした……。", "face": "l08a3257497e4"}, {"name": "過去のエンキドゥ", "text": "……まだ、やり直せるのかもしれない。", "face": "l08a3257497e4"}, {"name": "過去のエンキドゥ", "text": "もう一度、取り戻す……。\nこの手に……あの日を、あの時代を……。", "face": "l08a3257497e4"}, {"name": "過去のエンキドゥ", "text": "…………。", "face": "l08a3257497e4"}]}], "map": {"image": "Map920231_9343", "w": 960, "h": 640, "spots": [{"k": "b", "x": 71, "y": 493}, {"k": "b", "x": 365, "y": 506}, {"k": "m", "x": 887, "y": 391, "id": 200}, {"k": "m", "x": 814, "y": 450, "id": 201}, {"k": "m", "x": 806, "y": 329, "id": 202}, {"k": "m", "x": 720, "y": 278, "id": 203}, {"k": "m", "x": 626, "y": 229, "id": 204}, {"k": "m", "x": 701, "y": 187, "id": 205}, {"k": "m", "x": 765, "y": 142, "id": 206}, {"k": "m", "x": 547, "y": 183, "id": 207}, {"k": "m", "x": 472, "y": 139, "id": 208}, {"k": "m", "x": 392, "y": 85, "id": 209}, {"k": "m", "x": 324, "y": 124, "id": 210}, {"k": "m", "x": 355, "y": 211, "id": 211}, {"k": "m", "x": 172, "y": 210, "id": 212}, {"k": "m", "x": 397, "y": 271, "id": 213}, {"k": "m", "x": 438, "y": 331, "id": 214}, {"k": "m", "x": 484, "y": 403, "id": 215}, {"k": "m", "x": 172, "y": 367, "id": 216}, {"k": "m", "x": 218, "y": 413, "id": 217}, {"k": "m", "x": 149, "y": 45