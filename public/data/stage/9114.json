{"quest_id": 9114, "name": "決勝Lv.1", "description": "カウリオ海賊団との決勝戦に勝利せよ！\n＜深海(弱)：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞\n＜ユニット、アイテムのドロップなし＞", "modifier_notes": ["深海(弱)：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ", "ユニット、アイテムのドロップなし"], "event": "クロスランペイジ", "event_category": "History", "mission_id": 920211, "map_no": 7133, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 6, 30], "ext": "攻撃待ち増加=30,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 116000, "attack": 2400, "base_hp": 116000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 160, "attack_speed": 1, "attack_wait": 85, "attack_interval": 223, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2150944, "race_id": 7, "special_effect_id": 222, "missile_id": 1009, "missile": {"speed": 4.0}, "master_id": 37149, "global_id": 10766, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 8, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 1050, "attack": 200, "base_hp": 1050, "base_attack": 200, "damage_type": "physical", "armor_defense": 60, "magic_defense": 10, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162