ern_id": 2123680, "race_id": 7, "special_effect_id": 64, "master_id": 37190, "global_id": 10807, "spawn_sec": 285}, {"enemy_id": 21, "source": "local", "count": 24, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 60, "attack_range": 100, "attack_speed": 1, "attack_wait": 30, "attack_interval": 129, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124400, "race_id": 7, "special_effect_id": 220, "missile_id": 11, "master_id": 32767, "global_id": 6385, "ranged": true, "spawn_sec": 293}, {"enemy_id": 22, "source": "local", "count": 15, "form_count": 1, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 226, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123040, "race_id": 7, "change_to": 22, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 32935, "global_id": 6552, "ranged": true, "variants": [{"hp": 10000, "attack": 1050, "base_hp": 10000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 179, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123024, "race_id": 7, "master_id": 32936, "global_id": 6553}], "spawn_sec": 341}, {"enemy_id": 24, "source": "local", "count": 8, "form_count": 1, "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 20, "attack_range": 180, "attack_speed": 1, "attack_wait": 10, "attack_interval": 57, "move_speed": 2400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2128976, "race_id": 7, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 34529, "global_id": 8146, "ranged": true, "spawn_sec": 478}], "popups": ["サメは攻撃を行うたびに、\n攻撃力がアップしていきます。\n\n２回目の攻撃後、\n攻撃力が最大になります。\n※３回目以降の攻撃力が最大", "グリトニアの\n攻撃を受けた味方ユニットは\n3秒間、攻撃力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。\n　　　　　　(1/2)", "グリトニアが特定の位置に\n到着すると、\n墨の煙幕を張ります。\n\n\n\n\n　　　　　　(2/2)", "墨の煙幕が味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nスキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。", "クラゲの魔物から\n攻撃を複数回受けると、\n麻痺状態になります。", "サラタンの幼体から\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\nブロックされている間は、\n攻撃に遅延効果が無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マレス", "text": "──これより戦神コロッセウム、\nグルメジャングルの部の決勝戦を執り行う。", "face": "la7aadd749be2"}, {"name": "マレス", "text": "戦士たちよ、海巫女の加護は受けているな？", "face": "la7aadd749be2"}, {"name": "カウリオ", "text": "ああ、問題なく動けるぜ。", "face": "u2081a1"}, {"name": "ジークリンデ", "text": "こちらも大丈夫だ。呼吸にも差し障りない。", "face": "u429"}, {"name": "メーア", "text": "がぼがぼぼがぼぼがぼ(問題しかないんですけど)。", "face": "u796"}, {"name": "ジンレイ", "text": "（連戦に次ぐ連戦、ちょっと堪えるねぇ……）", "face": "u2065a1"}, {"name": "マレス", "text": "であれば、もはや俺様から言うべきことはない。\n両者が熱き戦いを繰り広げてくれることを願おう。", "face": "la7aadd749be2"}, {"name": "カウリオ", "text": "うっし、俺は負けねぇ！　負けられねぇ！\nよっしゃァ！　カウリオ海賊団、行くぞァ！", "face": "u2081a1"}, {"name": "海賊団員", "text": "アイアイサー！", "face": "u1122a1"}, {"name": "マレス", "text": "剣を持て戦士たちよ、全ての舞台は整った！", "face": "la7aadd749be2"}, {"name": "マレス", "text": "──戦え！", "face": "la7aadd749be2"}]}, {"trigger": "battle", "at_sec": 165, "lines": [{"name": "カウリオ", "text": "（つ、強ぇ……これが、王国の力……！）", "face": "u2081a1"}, {"name": "参謀", "text": "ふむ、やはりこうなりましたか。", "face": "l7d1ac18367ee"}, {"name": "カウリオ", "text": "さ、参謀！　このままじゃ負けちまう！\n何か、ここから逆転できる策を──痛っ！？", "face": "u2081a1"}, {"name": "参謀", "text": "触らないでください、汚らわしい。\n私がここまでお膳立てしてあげたというのに。\n所詮、半端者はどこまで行っても半端者でしたね。", "face": "l7d1ac18367ee"}, {"name": "参謀", "text": "結局、自分でやるしかありませんか。", "face": "l7d1ac18367ee"}, {"name": "海賊団員", "text": "がっ──！？　何だ、身体が、腐って……！？", "face": "u1122a1"}, {"name": "カウリオ", "text": "なっ、何して……何してんだよ参謀！？", "face": "u2081a1"}, {"name": "参謀", "text": "貸したものを返してもらうんですよ。\nあなた方のような寄せ集めの小さな海賊団に、\n王国と戦える力があったはずないでしょう？", "face": "l7d1ac18367ee"}, {"name": "参謀", "text": "借り物の力であまり意気がられても不快ですしね。\nああ、利子分はあなたから取り立てるとしましょう。", "face": "l7d1ac18367ee"}, {"name": "参謀", "text": "ええと、何でしたっけ。\n戦神の加護を得て他の魚人を見返す？\n良かったですねぇ、一時でも夢が見れて。", "face": "l7d1ac18367ee"}, {"name": "カウリオ", "text": "やめっ、やめろ、やめて──", "face": "u2081a1"}, {"name": "参謀", "text": "できるわけがないでしょうに。\nあなたのような魚人の落ちこぼれ、\n母親にも捨てられた雑種の分際で──", "face": "l7d1ac18367ee"}, {"name": "スカー", "text": "──シャァァァァックッ！！", "face": "u1396a1"}, {"name": "参謀", "text": "ッ、野蛮なギルマンが何の真似ですか？", "face": "l7d1ac18367ee"}, {"name": "スカー", "text": "気に入らねェ、気に入らねェなァ！\nオレサマはテメェみたいな魚人が一番嫌いなんだよッ！", "face": "u1396a1"}, {"name": "デスピア", "text": "──災厄の魔女、八爪のグリトニア。\n島の魔物を暴走させていたのはあなたね？", "face": "u49"}, {"name": "グリトニア", "text": "おや、その名を知っているとは博識ですねぇ。\n仰る通り、皆様に魔物をけしかけたのは私です。", "face": "l7d1ac18367ee"}, {"name": "グリトニア", "text": "皆様、連戦で相当お疲れでしょう？\n慣れぬ環境で呼吸も苦しくはありませんか？\nどうです、ここは私めに勝ちを譲るというのは──", "face": "l7d1ac18367ee"}, {"name": "スカー", "text": "却下だ！　テメェに譲るモンなんざ鱗一枚もねェ！", "face": "u1396a1"}, {"name": "グリトニア", "text": "……卑しいギルマンとは会話になりませんね。\nよろしい、では決勝戦を続けるとしましょうか。", "face": "l7d1ac18367ee"}, {"name": "グリトニア", "text": "戦神の加護は、私のものだ！", "face": "l7d1ac18367ee"}]}, {"trigger": "end", "lines": [{"name": "ジンレイ", "text": "──参ったねぇ、あと一撃が決まらない。", "face": "u2065a1"}, {"name": "シャジャル", "text": "この手元からすり抜けられる感覚、まさにタコだな。", "face": "u1769a1"}, {"name": "ジークリンデ", "text": "……水中での戦闘が長引き過ぎだ。\n呼吸はできても身体への負担が大きい、\nこのまま持久戦に持ち込まれると拙いぞ。", "face": "u429"}, {"name": "グリトニア", "text": "ふふっ、王国軍もこの程度ですか。\n魔物や実力者との戦闘で疲弊させてから、\n海中に引きずり込んでしまえば他愛もない。", "face": "l7d1ac18367ee"}, {"name": "グリトニア", "text": "（このまま適当に時間を潰してあげれば、\n溺れる民どもは勝手に自滅することでしょう）", "face": "l7d1ac18367ee"}, {"name": "スカー", "text": "シャァァァァックッ！　何か手はねぇのかよ！", "face": "u1396a1"}, {"name": "グリトニア", "text": "無駄です無駄、海の中で私に怖いものなど──", "face": "l7d1ac18367ee"}, {"name": "イヴリール", "text": "………………。", "face": "u1959a1"}, {"name": "グリトニア", "text": "……まさかお前、イヴリール、ですか？", "face": "l7d1ac18367ee"}, {"name": "イヴリール", "text": "おっと、ようやく気付いたか。\n久しぶりだな、何十年振りだ？", "face": "u1959a1"}, {"name": "イヴリール", "text": "懐かしいじゃないか、その八本足。\n千切れた足を生やすのは大変だったろ。", "face": "u1959a1"}, {"name": "グリトニア", "text": "待て、やめろ、こっちに来るな──！", "face": "l7d1ac18367ee"}, {"name": "イヴリール", "text": "──で、今日は何本足になりたい？", "face": "u1959a1"}, {"name": "グリトニア", "text": "～～～～ッ！？", "face": "l7d1ac18367ee"}, {"name": "デューオ", "text": "墨吐いて逃げた！？", "face": "u594"}, {"name": "イヴリール", "text": "追うなよ、そのまま逃がしてやれ。\n雑な追撃なんぞしたら逆に喰われる。", "face": "u1959a1"}, {"name": "デスピア", "text": "（まさかグリトニアがこの何十年、\n姿を現した記録がなかったのって……）", "face": "u49"}, {"name": "イヴリール", "text": "おい、決勝はもう終わりだろう。\nそこの奴、医者に見せんと死ぬぞ。", "face": "u1959a1"}, {"name": "海賊団員", "text": "……う、うぅ。", "face": "u1122a1"}, {"name": "ムルーア", "text": "──っ、そうだね！\n私、先に戻ってお医者様を呼んでくる！", "face": "u1568a1"}, {"name": "ハルフゥ", "text": "お願いします、私は応急処置を──", "face": "u1118a1"}, {"name": "ジンレイ", "text": "あれま、なんだか大事になったねぇ。", "face": "u2065a1"}]}, {"trigger": "route", "lines": [{"name": "スカー", "text": "シャアアアアックッ！　ヤロウ、墨の中に隠れやがった！", "face": "u1396a1"}, {"name": "デスピア", "text": "あの墨は煙幕でもあり障壁でもある。\n彼女を倒すにはまず墨を破壊するのよ。", "face": "u49"}, {"name": "デスピア", "text": "魔法の効果は薄いわ、気を付けて。", "face": "u49"}, {"name": "スカー", "text": "要するに物理ってことだなァ！？", "face": "u1396a1"}, {"name": "スカー", "text": "行くぜ王子！　あいつの横っ腹ぶん殴ってやらァ！", "face": "u1396a1"}]}], "active": true}