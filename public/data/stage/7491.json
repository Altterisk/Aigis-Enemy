tack_wait": 107, "attack_interval": 300, "move_speed": 750.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126400, "special_effect_id": 658, "change_to": 13, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33019, "global_id": 6636, "ranged": true, "to_global_id": 6635, "route_behaviour": {"reroutes": ["Route=312", "Route=317", "Route=322", "Route=327", "Route=332", "Route=333", "Route=334", "Route=335", "Route=336", "Route=337", "Route=338", "Route=339", "Route=340", "Route=341", "Route=342", "Route=343", "Route=344", "Route=345", "Route=346", "Route=347", "Route=348", "Route=349", "Route=350", "Route=351", "Route=352", "Route=353", "Route=354", "Route=355", "Route=45", "Route=601", "Route=602", "Route=603", "Route=604", "Route=605", "Route=606", "Route=607", "Route=608", "Route=609", "Route=610", "Route=611", "Route=612", "Route=613", "Route=614", "Route=615", "Route=999"]}, "spawn_sec": 106}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械"], "hp": 22500, "attack": 550, "base_hp": 22500, "base_attack": 550, "damage_type": "physical", "armor_defense": 270, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126416, "special_effect_id": 659, "change_to": 14, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33018, "global_id": 6635, "ranged": true, "to_global_id": 6634}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["機械"], "hp": 22500, "attack": 550, "base_hp": 22500, "base_attack": 550, "damage_type": "physical", "armor_defense": 270, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 750.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126400, "special_effect_id": 657, "change_to": 13, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33017, "global_id": 6634, "ranged": true}, {"enemy_id": 16, "source": "local", "count": 8, "form_count": 1, "tags": ["忍者"], "hp": 4500, "attack": 600, "base_hp": 4500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098896, "race_id": 16, "master_id": 436, "global_id": 435, "spawn_sec": 153}, {"enemy_id": 17, "source": "local", "count": 4, "form_count": 1, "tags": ["忍者"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_interval": 76, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099968, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 208, "global_id": 207, "ranged": true, "spawn_sec": 178}], "popups": ["フォーから受けた\nダメージは2倍になります。\n\nまたフォーを倒すと\n以降、人形は登場しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フォー", "text": "なんだい、絡繰り忍者、\nこいつらと知り合いだったのか？", "face": "lfe3f7d6c8e7f"}, {"name": "絡繰り忍者", "text": "以前、そう報告したでござろう。\n興味のない事であっても、\n情報は選り好みせず仕入れておくべきだ。", "face": "l62f6c5f68128"}, {"name": "フォー", "text": "あー、そうだっけ？\nいいんだよ、細かいことはサァ。", "face": "lfe3f7d6c8e7f"}, {"name": "フォー", "text": "それより準備は終わったんだろうな。\nブラックメカドラゴンの量産計画はァ。", "face": "lfe3f7d6c8e7f"}, {"name": "絡繰り忍者", "text": "我が技術に果てはない。\nしかし、復讐相手ではなく、\nその民に手をあげるやり口は気に入らぬな。", "face": "l62f6c5f68128"}, {"name": "フォー", "text": "分かってないなァ、絡繰り忍者。\n憎い相手を殴ってスッキリすんのは馬鹿とクズまでだ。", "face": "lfe3f7d6c8e7f"}, {"name": "フォー", "text": "本当に楽しいのはァ！\n憎い相手の大切な人間を、なぶって、苦しめて、\nボロボロになった様を見せつけることだろうがァ！", "face": "lfe3f7d6c8e7f"}, {"name": "ヘレナ", "text": "……悪趣味だな。\nだが、その凶行は止めさせてもらおう。", "face": "u1397a1"}, {"name": "フォー", "text": "――おっとぉ、お前の顔は知ってるぜ。\n天才軍師ヘレナちゃんじゃァないか。", "face": "lfe3f7d6c8e7f"}, {"name": "フォー", "text": "どうだ、俺の部下にならないか。\n俺はなァ、頭のいいヤツが好きなんだ。\nゴブリンすら統率のとれた軍にするその頭脳を――", "face": "lfe3f7d6c8e7f"}, {"name": "ヘレナ", "text": "――断固拒否、だ。\n我が知略は王子の目指す未来のためにある。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "それにフォー、お前ごときの才覚じゃ、\nこの頭脳を使いこなせるとは思えないなッ！！", "face": "u1397a1"}, {"name": "フォー", "text": "……ハハッ、ますます気に入った。\n絡繰り忍者ァ！　ブラックメカドラゴンを出せ！！", "face": "lfe3f7d6c8e7f"}, {"name": "アリア", "text": "……王子、ブラックメカドラゴンだけでなく、\n市街にはフォーの人形が放たれていると報告が。", "face": "u75"}, {"name": "ヘレナ", "text": "フォーの人形は、操作している本体を叩けば沈黙する。\n王子、雑魚ばかりに気を取られないように気をつけるんだ。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "これは、王国の民を守るための戦いだ。\n王子、悪の芽をここで摘み取るぞ！", "face": "u1397a1"}]}, {"trigger": "end", "lines": [{"name": "フォー", "text": "ギャハハハハハハッ！！\nあーあ、負けたッ！　また負けたァ！！", "face": "lfe3f7d6c8e7f"}, {"name": "フォー", "text": "どこまで俺をイラつかせるんだ！\n王子っ、ハハハッ、憎みすぎて愛しちまいそうだ！！", "face": "lfe3f7d6c8e7f"}, {"name": "フォー", "text": "あーあ、この人形も――そろそろ終わりか――。\nあばよ王子ィ、次はもっと――楽しませて――。", "face": "lfe3f7d6c8e7f"}, {"name": "ヘレナ", "text": "……これも人形、か。\nフォーの本体はどこにいるんだかな……。", "face": "u1397a1"}, {"name": "アリア", "text": "市街に散らばっていたミニメカドラゴンも、\nすべて沈黙したようです。\nどうやらフォーが操っていたようですね。", "face": "u75"}, {"name": "ヘレナ", "text": "……はぁ、潰しても潰してもきりがないな。\n先日も闇の組織の拠点を制圧したっていうのに。", "face": "u1397a1"}, {"name": "セブン", "text": "闇ギルドの頃ならともかく、\n闇の組織の幹部連中は、\n下部組織を平気で切り捨ててるみたいだしな。", "face": "u449"}, {"name": "アイリーン", "text": "そもそも幹部の情報を与えていないなら、\nどれだけ絞っても上にはたどり着けないですから。", "face": "u315"}, {"name": "エスネア", "text": "……でも、クリスマスはちゃんと守ったよ？\nほら、あっちの家の窓見てみて♪", "face": "u997"}, {"name": "ヘレナ", "text": "窓って、いったいどういう――\nははっ、どうしたんだあの子たちは。\n嬉しそうにこっちに手を振ったりして。", "face": "u1397a1"}, {"name": "アンナ", "text": "街の子どもたち、ですね。\nきっと、ヘレナさんが、\nクリスマスを守ってくれたんだって思っているんですよ。"}, {"name": "ヘレナ", "text": "……そっか。\nうん、戦いは終わらなくても、\n一時の安寧を勝ち取ったのは、立派な戦果かな。", "face": "u1397a1"}, {"name": "ヘレナ", "text": "よし王子、胸を張って凱旋するぞ！\n街の人々を安心させるのも、軍の役目だからな！", "face": "u1397a1"}, {"name": "ヘレナ", "text": "王国の民よ！　悪の野望は砕いたぞ！\nせーのっ、メリークリスマース♪", "face": "u1397a1"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "――どこまでも、混乱ばかりを好む男だな。\n困ったものだ、本当に。", "face": "ldf778e0f9630"}, {"name": "？？？", "text": "しかし、興味深い。\n王子の可能性をどこまで引き出すか、\n――フォーにはまだ、使いみちがありそうだ。", "face": "ldf778e0f9630"}, {"name": "？？？", "text": "我が主への報告は、しばし後にしよう。\n我らが求める世界のあり方に、\n果たして、有用なのはどちらなのか……。", "face": "ldf778e0f9630"}]}], "active": true}