{"quest_id": 7491, "name": "火花咲く王都のクリスマス", "description": "量産したブラックメカドラゴンのおもちゃ\nを従え、フォーと絡繰り忍者が襲い掛かる。\n王国の民とクリスマスを守りぬけ！\n神級（★１獲得の目安：平均Lv50）", "event": "クリスマス・デストロイヤー", "event_category": "History", "mission_id": 920170, "map_no": 4010, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 3, "tags": ["機械"], "hp": 24000, "attack": 1500, "base_hp": 24000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_range": 220, "attack_wait": 30, "attack_interval": 126, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131904, "race_id": 2, "special_effect_id": 893, "change_to": 1, "change_condition": 2, "missile_id": 636, "missile": {"speed": 8.0}, "master_id": 34227, "global_id": 7844, "ranged": true, "to_condition": 2, "to_global_id": 7845, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械"], "hp": 16000, "attack": 1000, "base_hp": 16000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_wait": 50, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131920, "race_id": 2, "special_effect_id": 894, "change_to": 2, "change_condition": 2, "missile_id": 542, "missile": {"speed": 17.0}, "master_id": 34228, "global_id": 7845, "from_condition": 2, "to_condition": 2, "to_global_id": 7846}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["機械", "ステルスII", "ブロック不可"], "hp": 16000, "attack": 1000, "base_hp": 16000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_range": 1, "attack_wait": 50, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131936, "race_id": 2, "special_effect_id": 895, "missile_id": 542, "missile": {"speed": 17.0}, "master_id": 34229, "global_id": 7846, "ranged": true, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 32000, "attack": 1050, "base_hp": 32000, "base_attack": 1050, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126672, "race_id": 16, "special_effect_id": 663, "change_to": 4, "change_condition": 2, "master_id": 33318, "global_id": 6935, "to_condition": 2, "to_global_id": 6936, "spawn_sec": 6}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "ステルス"], "hp": 90000, "attack": 1200, "base_hp": 90000, "base_attack": 1200, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 58, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126688, "race_id": 16, "special_effect_id": 664, "master_id": 33319, "global_id": 6936, "from_condition": 2}, {"enemy_id": 6, "source": "local", "count": 57, "form_count": 2, "tags": ["機械"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 120, "attack_wait": 60, "attack_interval": 224, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120704, "race_id": 2, "special_effect_id": 449, "change_to": 6, "missile_id": 414, "missile": {"speed": 10.0, "splash": 80}, "master_id": 32091, "global_id": 5710, "ranged": true, "to_global_id": 5713, "spawn_sec": 8}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damag