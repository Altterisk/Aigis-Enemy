{"quest_id": 6057, "name": "樹霊の暴走", "description": "妖精郷が襲撃を受けたとの報せを受け、\n王子たちは救援へと向かう。\n＜特定のタイミングで雨が発生＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで雨が発生"], "event": "古代龍の目覚め", "event_category": "History", "mission_id": 920086, "map_no": 3907, "level": 100, "multiplier": 1.0, "charisma": 115, "exp": 450, "gold": 1800, "drops": [{"item": 5003, "c": 4}, {"card": 117, "c": 1}, {"card": 118, "c": 1}, {"item": 2002, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 5000, "attack_speed": 100, "attack_wait": 10, "attack_interval": 211, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098960, "special_effect_id": 133, "master_id": 30167, "global_id": 3786, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 280, "attack_speed": 100, "attack_wait": 10, "attack_interval": 211, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098960, "special_effect_id": 94, "master_id": 662, "global_id": 661, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 1}, {"enemy_id": 4, "source": "local"