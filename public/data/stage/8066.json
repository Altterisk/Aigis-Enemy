, "base_attack": 1300, "damage_type": "physical", "armor_defense": 600, "magic_defense": 35, "attack_speed": 60, "attack_wait": 100, "attack_interval": 321, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106208, "race_id": 7, "master_id": 834, "global_id": 833, "spawn_sec": 329}, {"enemy_id": 78, "source": "local", "count": 4, "form_count": 1, "hp": 25500, "attack": 1300, "base_hp": 15000, "base_attack": 1300, "damage_type": "magical", "armor_defense": 600, "magic_defense": 35, "attack_range": 220, "attack_speed": 60, "attack_wait": 100, "attack_interval": 261, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106592, "race_id": 7, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 835, "global_id": 834, "ranged": true, "spawn_sec": 336}], "popups": ["　　　　【魔界の瘴気】\n攻撃力と防御力、時間経過による\nコスト回復量が低下します。\n王子【神器装備】王子【ケラウノス】\n皇帝を配置すると攻撃力と防御力の\n低下について無効化することが\nできます。\n一部ユニットも無効化できます。", "2体の魔神は\n臨界近く溜め込んだ魔力の影響で\n体が崩壊を始めました。\n\nHPが徐々に減少し\n一定時間が経過するたびに\n攻撃力がアップします。\n　　　　　　(1/2)", "第二形態に変身した魔神は\n一定時間が経過すると\n能力が暴走を始め、戦場に\nさらなる影響を及ぼします。\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "メフィスト", "text": "──いざ実物を見ると凄まじいね。\n全くの無から魔界に海を創り出すとは、\n魔神ウェパルの権能はこれ程だったかな？", "face": "u526"}, {"name": "アブグルント", "text": "そうねメフィスト、\nちょっと泳いでみてくれない？", "face": "u1553a1"}, {"name": "メフィスト", "text": "ははは、面白い冗談だアブグルント。\nあれはウェパルの血潮のようなものだぜ？\n私に死ねと言ってるようなものじゃないか。", "face": "u526"}, {"name": "ムルーア", "text": "そうかなー、普通に泳げそうだけど。\nむしろ海の中にいるみたいで元気かも！", "face": "u1568a1"}, {"name": "メフィスト", "text": "そりゃあウェパルは海を司る魔神だ。\n君たち魚人が適応できても不思議じゃない。\nだが我々、乾いた地に生きる者からすれば──", "face": "u526"}, {"name": "ラピス", "text": "うるさい、いいから一回行ってこい。", "face": "u436"}, {"name": "メフィスト", "text": "──！？　──！！　──！？", "face": "u526"}, {"name": "アブグルント", "text": "……駄目そうね、私たちの身体には毒みたい。", "face": "u1553a1"}, {"name": "イヴリール", "text": "茶番は終わったか。\n雑魚と野良犬がこちらに気づいた、\nこのまま墜落船に乗り込むぞ。", "face": "u1959a1"}, {"name": "レオナ", "text": "突入と同時に戦闘開始だ。\n各員、作戦は頭に入ってるな？", "face": "u311"}, {"name": "アブグルント", "text": "念のためおさらいしておきましょうか。\nグラシャラボラスは透明化する眷属を使役するわ。\n攻撃を当てたければ足止めして捕まえることね。", "face": "u1553a1"}, {"name": "イルムガルト", "text": "ウェパルはあらゆる生物の傷口を腐らせてきます。\nダメージの増加には最大限の注意を払ってください。", "face": "u1436a1"}, {"name": "イヴリール", "text": "お前たち、ここから先はもう後戻りできん。\n人間の形で死にたいのなら今が最後の機会だ。", "face": "u1959a1"}, {"name": "フレイ", "text": "はいはい、聞き飽きたよキャプテン。\nもっと他に言うべきコトとかないの？", "face": "u423"}, {"name": "イヴリール", "text": "良い度胸だなフレイ。だが、その通りだ。", "face": "u1959a1"}, {"name": "イヴリール", "text": "おれの船に乗った以上、\n敗北は許さん、勝利も要らん。\n蹂躙だ、蹂躙のみを許可する。", "face": "u1959a1"}, {"name": "イヴリール", "text": "圧倒せよ！　圧倒せよ！\n奴らの尊厳を奪え、矜持を嘲笑え！\n存在そのものを根底から否定し尽くせ！", "face": "u1959a1"}, {"name": "デューオ", "text": "圧倒せよー！　圧倒せよー！", "face": "u594"}, {"name": "イヴリール", "text": "──おれたちは海賊、あらゆる全てを奪う者！", "face": "u1959a1"}, {"name": "イヴリール", "text": "我らこそが嵐である！", "face": "u1959a1"}, {"name": "イヴリール", "text": "開戦だ！　奴らの首を船の上に掲げてやれ！", "face": "u1959a1"}]}, {"trigger": "end", "lines": [{"name": "イヴリール", "text": "お前たち仕上げだ！　最大火力を持って来い！", "face": "u1959a1"}, {"name": "レオナ", "text": "総員照準合わせ！　王子、合わせろ！", "face": "u311"}, {"name": "王子", "text": "────ッ！", "face": "u1"}, {"name": "イヴリール", "text": "冥途の土産だ、まとめて消えろォ！", "face": "u1959a1"}]}, {"trigger": "end", "lines": [{"name": "カーナ", "text": "……魔神二体の沈黙を確認。討伐、完了です。", "face": "u1107a1"}, {"name": "メフィスト", "text": "精神体の崩壊も始まっているようだ。\nあとはただ消えゆくのを待つのみだろうね。", "face": "u526"}, {"name": "アブグルント", "text": "ウェパルの血潮というのも本当だったみたい。\nこの海も三日もすれば消えるんじゃないかしら。", "face": "u1553a1"}, {"name": "パヤモ", "text": "これで……私の領地も……水没しないで済みます……。", "face": "u1851a1"}, {"name": "イヴリール", "text": "ふん……大した戦利品は無しか。\n魔神を名乗る割にはしけてやがる。\n描き上げた航海図もゴミ同然とはな。", "face": "u1959a1"}, {"name": "デューオ", "text": "まあまあキャプテン、\n魔神を二体も同時に倒したんだよ？\nこれは恩賞もたんまりに違いないって！", "face": "u594"}, {"name": "レオナ", "text": "そうだな、報酬には色を付けさせてもらおう。\n無事帰還した暁には国を挙げての宴も約束する。", "face": "u311"}, {"name": "イヴリール", "text": "……まあ、今回はそれで良しとしてやるとするか。\nお前たち帰るまでが航海だ、最後まで気を抜くなよ。", "face": "u1959a1"}, {"name": "ジョヴァンニ", "text": "アイアイサー！", "face": "u123"}, {"name": "イヴリール", "text": "サーではない、次間違えたら銃殺だ。", "face": "u1959a1"}, {"name": "ジョヴァンニ", "text": "ア、アイアイ、マム……。", "face": "u123"}]}, {"trigger": "end", "lines": [{"name": "メフィスト", "text": "いやはや、何はともあれ一件落着だね……ん？", "face": "u526"}, {"name": "アブグルント", "text": "（グラシャラボラスは死んだ。\nだけどウェパルはまだ運命に抗っている。\nもう、できることなんて何もないのに）", "face": "u1553a1"}, {"name": "アブグルント", "text": "（精神体が消えるまであと少し。\nその死に体でこの世に何かを遺せるのか。\nそれとも、徒に苦痛を引き延ばすだけなのか）", "face": "u1553a1"}, {"name": "メフィスト", "text": "アブグルント、何か気になることでも？", "face": "u526"}, {"name": "アブグルント", "text": "……いいえ、今しがた終わったわ。", "face": "u1553a1"}, {"name": "アブグルント", "text": "残念ね、面白くなると思ったのに。", "face": "u1553a1"}]}, {"trigger": "route", "lines": [{"name": "レオナ", "text": "──ッ！？　気を付けろ！\nグラシャラボラスの様子がおかしい！", "face": "u311"}, {"name": "メフィスト", "text": "ふむふむ、自らの魔力を込めた羽根を撒き散らして、\nその周辺の眷属たちに透明化を付与しているのかな？", "face": "u526"}, {"name": "アブグルント", "text": "ええ、随分と怒らせたみたいね。\nさっきよりも強力な一撃を溜めてるわ。\nねぇメフィスト、試しになんだけど──", "face": "u1553a1"}, {"name": "メフィスト", "text": "──試しで殺されちゃあ堪らないねぇ！\n海から這い上がるのも大変だったんだよ！", "face": "u526"}, {"name": "ラピス", "text": "喚くなメフィスト、さっさと構えろ。\n本当に死にたいなら止めはしないがな。", "face": "u436"}, {"name": "レオナ", "text": "敵も追い詰められている！\n総員、ここが正念場だ！\n今日こそ奴との長き因縁を断つ！", "face": "u311"}]}, {"trigger": "route", "enemy_ids": [33], "lines": [{"name": "ムルーア", "text": "わわわっ！？　なんか変な感じ！\n船の上なのに水の中にいるみたい！", "face": "u1568a1"}, {"name": "イルドナ", "text": "ウェパルが『暴走』を始めました。\n自らの領域で周囲を強引に浸食しています。\n警戒を、もはやこの場は深海と変わりません。", "face": "u1645a1"}, {"name": "イヴリール", "text": "この程度で騒ぐな、雑魚の無駄な抵抗だ。\n奴め、まだ自分の立場を理解していないらしい。", "face": "u1959a1"}, {"name": "イヴリール", "text": "おれは奪う、お前は差し出す──お分かり？", "face": "u1959a1"}, {"name": "イヴリール", "text": "分からんのなら……そのまま死ねぇっ！", "face": "u1959a1"}]}], "active": true}