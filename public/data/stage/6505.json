{"quest_id": 6505, "name": "襲撃の闇エルフ騎士", "description": "少女の示した小路を進み、いち早く\n妖精郷へと辿り着いた王子達。郷に迫る\n危機を伝え、一行は襲撃への備えを急ぐ。\n極級（★１獲得の目安：平均Lv25）", "event": "世界樹の花嫁", "event_category": "History", "mission_id": 920111, "map_no": 5362, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "tags": ["植物"], "hp": 1950, "attack": 420, "base_hp": 1950, "base_attack": 420, "damage_type": "physical", "armor_defense": 150, "magic_defense": 80, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098944, "special_effect_id": 134, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 31087, "global_id": 4706, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 15, "form_count": 1, "tags": ["植物"], "hp": 1300, "attack": 280, "base_hp": 1300, "base_attack": 280, "damage_type": "physical", "armor_defense": 100, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 131, "global_id": 130, "ranged": true, "spawn_sec": 12}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 296, "master_id": 31084, "global_id": 4703, "spawn_sec": 39}, {"enemy_id": 4, "source": "local", "count": 3, "level": 80, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 280, "attack_speed": 100, "attack_wait": 10, "attack_interval": 211, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098960, "special_effect_id": 94, "master_id": 662, "global_id": 661, "spawn_sec": 66}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 80}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 94}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 236, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103248, "change_to": 7, "change_condition": 1, "missile_id": 6, "master_id": 424, "global_id": 423, "ranged": true, "variants": [{"hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "master_id": 423, "global_id": 422}], "spawn_sec": 124}], "popups": ["ダークエルフナイトは\nダメージを受けると\n攻撃したユニットへ反撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ファルネ", "text": "……ここが妖精郷ね。\nダークエルフたちがまだ来ていないといいんだけど。", "face": "u640"}, {"name": "スプラ", "text": "……あの、王子さまたちですよね？\n皆さんお揃いで、どういった御用ですか？", "face": "u355"}, {"name": "アンナ", "text": "スプラさん！\nよかった……まだ妖精郷は無事のようですね。", "face": "lbb3a22565b44"}, {"name": "マリウス", "text": "――おい、一体何事だ？\nいくら王子たちとはいえ、連絡もなく来られては――", "face": "u116"}, {"name": "スピカ", "text": "――それどころじゃないんだってば。\nダークエルフがまたここに攻めてきてるのよ？", "face": "u113"}, {"name": "スプラ", "text": "ふぇっ！？　ほ、本当ですかっ？", "face": "u355"}, {"name": "マリウス", "text": "ふむ……その話が本当なら、\n速やかに住民の避難と迎撃準備を進めねばならんな。", "face": "u116"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "……承知いたしました。\n妖精郷の皆さん、迎撃は私たちが担当します。\n皆さんは住民の方々の避難誘導を急いでください。", "face": "lbb3a22565b44"}, {"name": "マリウス", "text": "うむ……恩に着る。\n皆、手分けして各地区の住民を避難させてくれ！", "face": "u116"}, {"name": "ファルネ", "text": "――ッ！\nみんな、敵が来るわ！　警戒して！", "face": "u640"}, {"name": "ダークエルフ", "text": "…………どういうことだ？\nなぜ、王子たちがここにいる……？", "face": "la2af0c19fdd0"}, {"name": "ダークエルフ", "text": "……まぁいい。ヤツらごと妖精郷を蹂躙してやる！\n魔物どもよ、花びらの力を思い知らせてやれ！", "face": "la2af0c19fdd0"}]}, {"trigger": "battle", "at_sec": 40, "lines": [{"name": "ローレン", "text": "あれは――ダークエルフの騎士か！\n王子、気をつけてくれ。ヤツらの盾は攻撃を受けると、\nその威力の大小にかかわらず雷撃を飛ばす魔法の盾だ。", "face": "u118"}, {"name": "ケイティ", "text": "承知しました――皆さん、\n光る盾を持つダークエルフは雷で反撃してくるようです。\n攻撃する際は充分にご注意ください！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "フィリス", "text": "はぁ、はぁ……なんとか守り抜いたか。", "face": "u40"}, {"name": "ダークエルフ", "text": "……フフ、それはどうかな？", "face": "la2af0c19fdd0"}, {"name": "フィリス", "text": "な、なに笑ってるんだよ。", "face": "u40"}, {"name": "リノ", "text": "――あーーーっ！！！！", "face": "u350"}, {"name": "マーヤ", "text": "――ぴぎぃッ！？\nおおお、脅かさないでくださいよぅっ……。", "face": "u338"}, {"name": "リノ", "text": "ご、ごめんなさい。\nでも、いますっごく嫌な気配がしたから……。", "face": "u350"}, {"name": "ソラノ", "text": "……そう、リノも感じたのね。\n悪意に染まった無数の力のざわめきを。", "face": "u134"}, {"name": "アンナ", "text": "……ソラノさん、\nもう少し分かりやすく言っていただけますか？", "face": "lbb3a22565b44"}, {"name": "ファルネ", "text": "二人とも無意識に感じ取ったのよ。\nあたしがいま感じてるのと同じ、\n花びらの力が急速に近づいてくる気配をね。", "face": "u640"}, {"name": "ケイティ", "text": "……意識せずとも感じ取れるほど\n多数の花びらと、その力の恩恵を受けた敵が\nすぐ近くまで迫ってきている……ということですか。", "face": "u114"}, {"name": "ダークエルフ", "text": "今更気づいたか。だが、もはや手遅れだ。\n――皆の者、後退して本隊と合流するぞ！", "face": "la2af0c19fdd0"}, {"name": "アンナ", "text": "……どうやら、次の戦いが正念場となりそうですね。", "face": "lbb3a22565b44"}, {"name": "ファルネ", "text": "……ごめんなさい。\nあたしが花びらを集めようなんて言ったせいで、\nみんなをこんな危険に巻き込んじゃって……。", "face": "u640"}, {"name": "アンナ", "text": "いえ。ご提案に乗ったのは私たちですし、\n結果的に妖精郷を守れるなら本望です。\n成功させましょう、防衛も『ジューンブライド』も。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ファルネ", "text": "王子、みんな……ありがとう。\nそれじゃあ、ダークエルフとの決戦に備えて\n防衛の準備を進めていきましょう。", "face": "u640"}]}], "active": true}