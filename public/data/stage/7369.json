{"quest_id": 7369, "name": "巨大提灯おばけの大一番", "description": "巨大提灯おばけが名をあげるべく一世一代\nの大勝負を仕掛けてくる。クーコ、レミィ、\nベラと共に勝負を正面から受けて立て！\n神級（★１獲得の目安：平均Lv50）", "event": "提灯おばけと夏夜の狩人", "event_category": "History", "mission_id": 920164, "map_no": 5882, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_count": 2, "hp": 14500, "attack": 130, "base_hp": 14500, "base_attack": 130, "damage_type": "magical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129712, "race_id": 4, "special_effect_id": 70, "change_to": 1, "change_condition": 5, "missile_id": 563, "missile": {"speed": 17.0}, "master_id": 33867, "global_id": 7484, "to_condition": 5, "to_global_id": 7485}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 14500, "attack": 130, "base_hp": 14500, "base_attack": 130, "damage_type": "magical", "armor_defense": 250, "magic_defense": 5, "attack_range": 120, "attack_speed": 1, "attack_wait": 20, "attack_interval": 81, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129728, "race_id": 4, "special_effect_id": 823, "missile_id": 563, "missile": {"speed": 17.0}, "master_id": 33868, "global_id": 7485, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "hp": 115000, "attack": 250, "base_hp": 115000, "base_attack": 250, "damage_type": "magical", "armor_defense": 350, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129712, "race_id": 4, "special_effect_id": 70, "change_to": 3, "change_condition": 5, "missile_id": 566, "missile":