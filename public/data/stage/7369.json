099360, "race_id": 4, "master_id": 104, "global_id": 103, "spawn_sec": 70}, {"enemy_id": 8, "source": "local", "count": 12, "form_count": 1, "tags": ["サムライ"], "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100464, "race_id": 16, "master_id": 246, "global_id": 245, "spawn_sec": 130}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["サムライ"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099952, "race_id": 16, "master_id": 207, "global_id": 206, "spawn_sec": 137}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["忍者"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 51, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099984, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 209, "global_id": 208, "ranged": true, "spawn_sec": 144}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 1, "tags": ["忍者"], "hp": 900, "attack": 190, "base_hp": 900, "base_attack": 190, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100032, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 212, "global_id": 211, "ranged": true, "spawn_sec": 147}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["女性", "サムライ"], "hp": 18000, "attack": 1500, "base_hp": 18000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120464, "race_id": 16, "change_to": 12, "change_condition": 1, "master_id": 32045, "global_id": 5664, "variants": [{"tags": ["女性", "サムライ"], "hp": 18000, "attack": 1500, "base_hp": 18000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120464, "race_id": 16, "special_effect_id": 436, "master_id": 32046, "global_id": 5665}], "spawn_sec": 161}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 350, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2126720, "race_id": 16, "special_effect_id": 665, "master_id": 33071, "global_id": 6688, "spawn_sec": 164}], "popups": ["ヨシノがいる間は、\n忍者、サムライ、妖怪系の敵の\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヨシノ", "text": "おーい、助けて王子ー！", "face": "u1104a1"}, {"name": "チヨメ", "text": "お姫さーん、ご無事ですか──って、\nどうして斬りかかってくるんですかー！？", "face": "u1144a1"}, {"name": "ヨシノ", "text": "いやー、それが手足の自由を奪われちゃってさ。\n体がまるで言うこと聞かないの、もう逆に面白いよね。", "face": "u1104a1"}, {"name": "シズカ", "text": "（演技って難しいわね……。\nでもこれもシノの作戦のうち。\n私も頑張って操られているフリをしないと）", "face": "u101"}, {"name": "シノ", "text": "そういうことです、王子。\n私たちはもはや、完全に操られてしまいました。", "face": "u403"}, {"name": "アンナ", "text": "そんな、シノさんまで操られるなんて、\nいったい誰がこのようなことを──", "face": "ld9d0516d8e4e"}, {"name": "巨大提灯おばけ", "text": "──ワシじゃあ。", "face": "la945ac30853a"}, {"name": "ベラ", "text": "うぉおおおおおおッ！？　でっ、でっかいぞー！？", "face": "u1284a1"}, {"name": "巨大提灯おばけ", "text": "首を長ぅして待っとったでぇ、王子ぃ。\nおどれに恨みはねぇが、これも畏れを集めるためじゃ。\n悪いが、この夏祭りはワシらが占拠させてもろうたわ。", "face": "la945ac30853a"}, {"name": "シノ", "text": "──ッ、どうしてこのようなことをする！\n提灯おばけ、貴方のところにも報せは届いているはず。\n王子は私たち妖怪のため動いてくれているのですよ！", "face": "u403"}, {"name": "巨大提灯おばけ", "text": "んなこたぁ百も承知じゃシノの姐さん、\n人間と妖怪が共存できる世界ってなァ、\nそりゃあ大層素晴らしいことじゃろう。", "face": "la945ac30853a"}, {"name": "巨大提灯おばけ", "text": "じゃが、そりゃあ一年後か？　十年後か？\nそれじゃあ遅いんじゃ姐さん、提灯おばけは弱ぇ妖怪、\n舎弟たちにゃもう吹けば飛ぶような灯りしか残っとらん。", "face": "la945ac30853a"}, {"name": "巨大提灯おばけ", "text": "ワシらには明日はねぇ、今しかないんじゃ……！\nせやから王子、ワシはおどれを倒して舎弟たちを救う、\n畏るべき大妖怪、提灯おばけの名を世に知らしめたる！", "face": "la945ac30853a"}, {"name": "王子", "text": "…………(くいくい)", "face": "u1"}, {"name": "レミィ", "text": "ちょっと王子！　そんな挑発しなくても──", "face": "u1281a1"}, {"name": "クーコ", "text": "待って、これでいいのよレミィ。\n言葉での説得は不可能、特に私たちにはね。\nここは続きましょう、王子くんを信じるのよ。", "face": "u1282a1"}, {"name": "レミィ", "text": "クーコ……分かったわ。\n王子、私たちも一緒に戦うわ。\nだからどうか、全力でぶつかってあげて？", "face": "u1281a1"}, {"name": "巨大提灯おばけ", "text": "さあ、そろそろ勝負といこうやないか。\n負ければ終わりの夏の華、最初で最後の大一番！\n男一代提灯おばけ、ド派手に一発、咲いたらぁっ！", "face": "la945ac30853a"}, {"name": "巨大提灯おばけ", "text": "往生せぇや、王子ぃいいいいいいッ！！", "face": "la945ac30853a"}, {"name": "ヨシノ", "text": "うへぇ……王子、私にはあんまり痛くしないでねー。", "face": "u1104a1"}]}, {"trigger": "end", "lines": [{"name": "巨大提灯おばけ", "text": "負けた……こりゃ完敗じゃあ、王子。\nお前らすまんのぉ、頼りない親分でよ……。", "face": "la945ac30853a"}, {"name": "提灯おばけ", "text": "おやびん……。", "face": "l07adf235cb1f"}, {"name": "巨大提灯おばけ", "text": "ケジメはつけたる……早ぅ殺しや。\n詫びろっちゅーなら、潔く腹も斬る。", "face": "la945ac30853a"}, {"name": "王子", "text": "…………(ふるふる)", "face": "u1"}, {"name": "巨大提灯おばけ", "text": "──っ、情けかけとるんちゃうぞ！\nワシら提灯おばけはもう終わりなんじゃ！\nせめて見届けるんが男ってもんじゃろうが！", "face": "la945ac30853a"}, {"name": "巨大提灯おばけ", "text": "貴様んらも、もう操られてるフリはえぇ。\nそんなもん最初からお見通しじゃ。\nワシらに同情したっちゅうんじゃろう？", "face": "la945ac30853a"}, {"name": "ココロ", "text": "違うよ、提灯おばけさん。\nほら、周りを見てみなってー。", "face": "u1283a1"}, {"name": "屋台のおっちゃん", "text": "うぉおおお！　熱い、熱い戦いだった！\n王子も提灯おばけも最高の喧嘩だったぞー！", "face": "l83de3d13848c"}, {"name": "観客の青年", "text": "感動した！　俺は猛烈に感動した！\n格好良かったぜー！　提灯おばけー！", "face": "lc55dc152765d"}, {"name": "ベラ", "text": "あははっ！　提灯おばけ、\nみーんなアタシたちの喧嘩が面白かったってさ、\nもちろん、アタシもすーっごく楽しかったぞ！", "face": "u1284a1"}, {"name": "提灯おばけ", "text": "おやびん！　体に力が漲ってくるっす！\nめちゃくちゃ痛ぇのにすっげぇ温かくて……。\n俺だけじゃない、他のやつらも同じです！", "face": "l07adf235cb1f"}, {"name": "巨大提灯おばけ", "text": "────ッ！？　お、お前たち……！！", "face": "la945ac30853a"}, {"name": "シノ", "text": "楽しい、面白い、格好良い。\nこれらの感情もまた、妖怪の糧となる。\n今日もまた魅せてくれますね、人の総大将。", "face": "u403"}, {"name": "クーコ", "text": "抗争ではなくあくまで喧嘩ってね、\n王子くんはとことん男の子だなぁ♪", "face": "u1282a1"}, {"name": "巨大提灯おばけ", "text": "……まったく、とんでもねぇ男がいたもんじゃあ、\nワシらのような妖怪まで救うてまうとはのぉ……。", "face": "la945ac30853a"}, {"name": "巨大提灯おばけ", "text": "じゃが、ここまでカタギさんに迷惑かけて、\nこのまま無罪放免なんざ筋が通らんけぇの、\nこの落とし前はいつか必ずつけさせてもらう。", "face": "la945ac30853a"}, {"name": "巨大提灯おばけ", "text": "何かあれば姐さんを通して連絡くれぇ。\nいつでんどこでん絶対に駆けつけて、\n組の総力挙げておどれのためにタマぁ張ったる。", "face": "la945ac30853a"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "巨大提灯おばけ", "text": "まっ、闇を照らすぐれぇしかできんのじゃがな、\n手始めにちょっくら祭りの夜空を彩ってみらぁ！", "face": "la945ac30853a"}, {"name": "マオ", "text": "提灯さんたちが一斉空に浮かんで……。\nわぁ……幻想的ですごくきれいです……！", "face": "u867"}, {"name": "ラミィ", "text": "いっよーし！　じゃあ夏祭りも再開しよー！\nわたしが太鼓を叩くから、踊って踊ってー！\nどーんどーんどーん！　どどーんど、どーん！", "face": "u858"}, {"name": "ベラ", "text": "おぉー！　盛り上がってきたなぁ！\n王子、王子！　アタシたちも一緒に踊ろう！", "face": "u1284a1"}, {"name": "ベラ", "text": "なんか戦ってばっかでよくわかんなかったけど──", "face": "u1284a1"}, {"name": "ベラ", "text": "──祭りと喧嘩は夏の華、だな！", "face": "u1284a1"}]}], "active": true}