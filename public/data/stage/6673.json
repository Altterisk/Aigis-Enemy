n_id": 2106496, "race_id": 8, "special_effect_id": 343, "change_to": 7, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31458, "global_id": 5077, "ranged": true, "to_condition": 3, "to_global_id": 5078, "spawn_sec": 79}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "attack": 135, "base_hp": 900, "base_attack": 135, "damage_type": "physical", "armor_defense": 45, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106512, "race_id": 8, "special_effect_id": 344, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31459, "global_id": 5078, "ranged": true, "from_condition": 3}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 2, "hp": 18000, "attack": 720, "base_hp": 18000, "base_attack": 720, "damage_type": "physical", "armor_defense": 450, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102672, "race_id": 8, "special_effect_id": 343, "change_to": 9, "change_condition": 3, "master_id": 31464, "global_id": 5083, "to_condition": 3, "to_global_id": 5084, "spawn_sec": 135}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1440, "base_hp": 18000, "base_attack": 1440, "damage_type": "physical", "armor_defense": 630, "attack_speed": 20, "attack_wait": 15, "attack_interval": 116, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "special_effect_id": 343, "master_id": 31465, "global_id": 5084, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "チグリ", "text": "王子こっちだ、急いでくれ！", "face": "u310"}, {"name": "フィリス", "text": "こんな距離からもう、\nオーク達の騒ぎ声が聞こえてくるな。\nいったい何が起きてるっていうんだ？", "face": "u40"}, {"name": "ダナン", "text": "どうやら、この騒動の発端は謎の病らしい。\nここ最近、オーク達の間で\n正体不明の病が広まっているようでな。", "face": "u299"}, {"name": "ケイティ", "text": "オーク達が病ですか……。\n体調を崩したのなら大人しくなりそうなものですが、\n騒ぎを起こしているのですか？", "face": "u114"}, {"name": "チグリ", "text": "それが、満足に戦えないくらい不調になったせいで、\n病を持ち込んだ犯人探しに躍起になってるみたいなんだ。", "face": "u310"}, {"name": "アンナ", "text": "それは困りましたね……。\n密林の平和の為にも、放置はでき――", "face": "lace48cea1f67"}, {"name": "オーク", "text": "――そこにいるのは誰だッ！？\n……ごほっ、げほっ。", "face": "l696bdd73dc88"}, {"name": "ミトラ", "text": "ちっ、気付かれてしまったか……。\nだが、奴らが探しているのは病を流行させた犯人だ。\n戦わずとも犯人を突き止め、ヤツらに教えてやれば……。", "face": "u276"}, {"name": "オーク", "text": "……その姿、呪術師だな？\nはっ！　まさかこの病は貴様の呪術によるものか！？", "face": "l696bdd73dc88"}, {"name": "ミトラ", "text": "何？　いや、それは完全に誤解――", "face": "u276"}, {"name": "オーク", "text": "――問答無用！\nうおお！！　我らの怒りを思い知れッ！！", "face": "l696bdd73dc88"}, {"name": "アンナ", "text": "話は通じそうにないですね……。\nオークの軍勢がこちらへ向かってきます！", "face": "lace48cea1f67"}, {"name": "アンナ", "text": "王子、オーク達は病で弱っているようですが、\n体力が失われる程に凶暴化するため、油断は禁物です。\n慎重な采配をお願いします！", "face": "lace48cea1f67"}]}, {"trigger": "end", "lines": [{"name": "ミトラ", "text": "――オークども、今回は大人しく引き下がりな。\nお前たちの病はあたしらの仕業では無いし、\n全力で戦えず力尽きるのはお前たちも不本意だろう？", "face": "u276"}, {"name": "オーク", "text": "ごほっ、げほっ……お、王子の仲間だったとは……。\n王国軍の手合いであれば、\nこんな卑劣な手を使う筈がないな……。", "face": "l696bdd73dc88"}, {"name": "オーク", "text": "……ごほっ、今回は、言う通り引き上げるとしよう……。\n次は互いに万全の状態で戦おうではないか……。", "face": "l696bdd73dc88"}, {"name": "ケイティ", "text": "……オーク達、撤退していきます。", "face": "u114"}, {"name": "ダナン", "text": "どうやらこれで、密林の騒ぎは収まったみたいだな。", "face": "u299"}, {"name": "チグリ", "text": "でもこのジャングルで、\nあんな病見たことないんだけどなぁ。\nいったい何が原因なんだろう？", "face": "u310"}, {"name": "アンナ", "text": "病の出処も含め、\n今後も警戒が必要なようですね……。\n王子、ひとまず王国へ帰還いたしましょう。", "face": "lace48cea1f67"}]}], "active": true}