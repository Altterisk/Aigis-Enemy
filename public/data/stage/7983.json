uffEffectMagma"}}, "master_id": 21325, "global_id": 1618, "ranged": true}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 7, "change_condition": 5, "master_id": 780, "global_id": 779, "to_condition": 5, "to_global_id": 780, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 233}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 781, "global_id": 780, "ranged": true, "from_condition": 5}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 36000, "attack": 1200, "base_hp": 36000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 9999, "magic_defense": 40, "attack_range": 40, "attack_speed": 1, "attack_wait": 30, "attack_interval": 109, "move_speed": 2800.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2133584, "race_id": 2, "special_effect_id": 789, "change_to": 9, "change_condition": 1, "missile_id": 11, "master_id": 21326, "global_id": 1619, "ranged": true, "variants": [{"hp": 36000, "attack": 800, "base_hp": 36000, "base_attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 184, "move_speed": 2800.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133600, "race_id": 2, "master_id": 21327, "global_id": 1620}], "spawn_sec": 304}], "popups": ["ファイアエレメンタルの\nHPを減らすと、\n遠距離攻撃をしてきます。 ", "マグマサラマンダーから\n攻撃を受けると\n「マグマ付着」状態になります。\nマグマ付着によるダメージは、\n女神の加護やユニットの\n能力によって軽減、解除する\nことができません。\n　　　　　　(1/2)", "　 　　【マグマ付着】\n・攻撃を受けると徐々にHPが減少\n\n・複数の敵から攻撃を受けた\n　場合、継続ダメージ効果が重複\n\n・一定時間の経過でのみ解除可能\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "オーキュ", "text": "――ここが、ムスペルヘイム。\n渦巻く炎の眠る、第三層のもうひとつの姿ですのね……。", "face": "u1101a1"}, {"name": "ハリンヘイム", "text": "鳥神の民には、あまり縁がない場所でしょう。\n第三層には、このような\n複数の世界が並立しているんです。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "まぁこんなに広くても、\n生き残っているのは極僅かなのですが。", "face": "u1854a1"}, {"name": "カーニア", "text": "…………。", "face": "u1685a1"}, {"name": "ハリンヘイム", "text": "今のは、一応場を和ませる冗談のつもりです。", "face": "u1854a1"}, {"name": "カーニア", "text": "さすがに笑えないよ！！", "face": "u1685a1"}, {"name": "ドゥマルデ", "text": "号砲の亜神殿も、どうやら吹っ切れたようですね。\nなすべきことが見つかった、というべきでしょうか。", "face": "u1266a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "パリオス", "text": "うぅー、それにしても暑いよぉ……。\nこれじゃあ到着前に焼き鳥になっちゃうぅぅ。", "face": "u1109a1"}, {"name": "ハリンヘイム", "text": "ムスペルヘイムは灼熱の世界ですからね。\n炎の剣の封印まで後少し、頑張って――", "face": "u1854a1"}, {"name": "ライノー", "text": "――いや、悪い知らせだ。\nただでさえ暑いっていうのに、\n亜神イコルは熱い連中ばかり残していったらしい。", "face": "u1086a1"}, {"name": "パリオス", "text": "うぇー！？\nこんな暑い中で戦うの！？", "face": "u1109a1"}, {"name": "オーキュ", "text": "仕方ありませんわ。\n王子さま、暑さによる体力減少に注意してくださいな！\nさぁ、敵が来ますわよ！！", "face": "u1101a1"}]}, {"trigger": "end", "lines": [{"name": "エステル", "text": "戦っていて思ったのですが、\nこんなに熱く炎が燃え盛っているのに、\nどこか寂しい場所ですね、ここは……。", "face": "u245"}, {"name": "ハリンヘイム", "text": "……ここは、死んだ世界ですから。\n本来の管理者もおらず、\n住人も、その眷属もいない世界なんです。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "でも、もうこれ以上、故郷を壊させはしません。\nイコルはおそらく、炎の剣の封印を解き、\n巨人スルトを蘇らせようとしています。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "そんなことになれば、\nスルトの業火は第三層だけでなく、\nオリュンポス全土を焼き払いかねません。", "face": "u1854a1"}, {"name": "パリオス", "text": "おりゅんぽす、ぜんど？\nえっ、えぇぇ！？　そんなにヤバいの！？", "face": "u1109a1"}, {"name": "エステル", "text": "炎の剣は、ただの魔剣ではないのです。\nいずれ世界を滅ぼす業火を、\n剣の形に整えたものですから。", "face": "u245"}, {"name": "ハリンヘイム", "text": "……アスガルドの伝承に、お詳しいのですね？", "face": "u1854a1"}, {"name": "エステル", "text": "ご先祖さまに、少し縁があったもので……。", "face": "u245"}, {"name": "パリオス", "text": "そんな危険なものを、どうして創造したんだろ……。\n元々オリュンポスは、創造神さまが\n実験場として作ったんだよね？", "face": "u1109a1"}, {"name": "ハリンヘイム", "text": "創造神さまの意図は、誰にも分かりません。\n第三層が、必ず滅びを迎える運命にあると、\nそう定めた理由も、私たちは知りませんから。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "でも、滅びは本来訪れる形でなく、\n亜神ディアスの侵攻によってもたらされました。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "第三層の亜神として、運命は受け入れますが、\n運命に記されざる滅びには、ちゃんと抗おうと思います。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "亜神ディアスの策謀も、\nイコルの計画も、すべて私が打ち砕きます。", "face": "u1854a1"}, {"name": "ライノー", "text": "……思ったより、武闘派だな？", "face": "u1086a1"}, {"name": "ハリンヘイム", "text": "当然ですとも。\n第三層の亜神は、皆強き戦士ですからね！", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "さぁ、そろそろ炎の剣の封印地点です。\n皆さん、心の準備をしておいてください。", "face": "u1854a1"}]}], "active": true}