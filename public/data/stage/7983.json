{"quest_id": 7983, "name": "渦巻く炎の眠る地", "description": "亜神イコルを追ってムスペルヘイムを進む\n王子たちに魔物の群れが襲い来る。\n＜HPに継続ダメージ：中＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["HPに継続ダメージ：中"], "event": "神話の笛の音は、ただ遠く", "event_category": "History", "mission_id": 920198, "map_no": 4744, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 5, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 2, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 1, "change_condition": 5, "master_id": 778, "global_id": 777, "to_condition": 5, "to_global_id": 778, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 779, "global_id": 778, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 221, "move_speed": 230.0, "gain_cost": 1, "dot_rate": 0.699999988079071, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100192, "missile_id": 52, "missile": {"speed": 6.0, "splash": 107}