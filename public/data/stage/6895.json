{"quest_id": 6895, "name": "氷床の洞穴", "description": "次なる目的地は、凍える洞穴。\n氷の足場を滑り来るフロストジャイアント\nを倒し、この状況を切り抜けよ！\n極級（★１獲得の目安：平均Lv25）", "event": "終末の戦士たち", "event_category": "History", "mission_id": 920135, "map_no": 5537, "level": 100, "multiplier": 1.0, "charisma": 65, "exp": 300, "gold": 1500, "drops": [{"card": 15, "c": 1}, {"card": 242, "c": 1}, {"card": 133, "c": 1}, {"item": 1002, "c": 1}, {"item": 5003, "c": 2}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 39, "form_index": 0, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 820, "base_hp": 6000, "base_attack": 820, "damage_type": "physical", "armor_defense": 220, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 205, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101248, "master_id": 227, "global_id": 226, "spawn_sec": 30}, {"enemy_id": 3, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 70000, "attack": 1500, "base_hp": 70000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "attack_range": 100, "attack_speed": 150, "attack_wait": 90, "attack_interval": 301, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115008, "race_id": 10, "special_effect_id": 232, "change_to": 3, "missile_id": 274, "master_id": 32044, "global_id": 5663, "ranged": true, "to_condition": 0, "to_global_id": 5662, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 57}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 70000, "attack": 1500, "base_hp": 70000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "attack_speed": 150, "attack_wait": 90, "attack_interval": 451, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115008, "race_id": 10, "special_effect_id": 232, "change_to": 2, "missile_id": 274, "master_id": 32043, "global_id": 5662, "from_condition": 0}, {"enemy_id": 5, "source": "local", "count": 8, "form_index": 0, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "change_to": 5, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 30046, "global_id": 3665, "ranged": true, "to_condition": 0, "to_global_id": 3666, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 87}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "special_effect_id": 229, "change_to": 4, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 30047, "global_id": 3666, "ranged": true, "from_condition": 0}], "dialogue": [{"trigger": "start", "lines": [{"name": "メーリス", "text": "た、たたた、たしかにっ、\nさっきは暑い暑いって言ってたけどぉっ！！", "face": "u78"}, {"name": "パレス", "text": "こ、今度はっ、ささ、寒すぎます……っ。", "face": "u129"}, {"name": "ヴァレリー", "text": "それに足場が随分と悪い。\n床まで凍っているとはね……。", "face": "u12"}, {"name": "カタラ", "text": "でも、だからこそ誰も、\nこんな場所に来ようとは思わないのよ。", "face": "u912"}, {"name": "ミゲル", "text": "まぁ、確かに好んでこんな場所にいるのは、\n寒いところが好きな動物連中か……。", "face": "u369"}, {"name": "エレーヌ", "text": "あるいはフロストジャイアントくらい、だろうな。", "face": "u481"}, {"name": "キュテリ", "text": "……いやいや、\nそんな縁起でもないこと言わないでほしいな。\n本当に出てきたらどうするんだ？", "face": "u53"}, {"name": "カタラ", "text": "悪いことは口に出すと本当になるって、\n昔お婆ちゃんに聞いたわね……。", "face": "u912"}, {"name": "キャリー", "text": "うっ……この物音、獣だけじゃなくて、\n大きな足音も響いてきてますよ！", "face": "u26"}, {"name": "アトナテス", "text": "件のフロストジャイアントってやつか。\nそれに可愛い雪だるまも付いてきてるぜ？", "face": "u908"}, {"name": "パレス", "text": "喜んでる場合じゃないです……！\nこの凍った足場、こちらは不利になりますが……。", "face": "u129"}, {"name": "メーリス", "text": "この地で生きる魔物にとっては、\nむしろ滑って突撃ができて好都合ってことね。", "face": "u78"}, {"name": "アンナ", "text": "王子、魔物の予期せぬ行動に注意してください！\n迎撃の準備をお願いします！", "face": "l2e0a5b9d2133"}]}, {"trigger": "end", "lines": [{"name": "カタラ", "text": "あった！　『破滅の力』は回収できたわ！", "face": "u912"}, {"name": "シャディア", "text": "くっ……また一段と、\n力の影響が大きくなったな……。", "face": "u713"}, {"name": "カタラ", "text": "ぶっつけ本番だったけど、\nあたしの術でちゃんと制御ができそうよ。\n――ほら、これで大丈夫。", "face": "u912"}, {"name": "ヴァレリー", "text": "……へぇ。確かに魔力の波動が和らいだ。\nこんな術を伝える一族があったんだね。", "face": "u12"}, {"name": "カタラ", "text": "英雄王陛下の命に従って、\nずーっと華の国の奥地で暮らしてたからね。\nこの術を知るのはあたしだけのはずよ。", "face": "u912"}, {"name": "パレス", "text": "……そんな奥地で、寂しくありませんでしたか？", "face": "u129"}, {"name": "カタラ", "text": "……まぁ、ちょっとはね。\nでもこれは、世界を守る大事な使命だったし。", "face": "u912"}, {"name": "ユージェン", "text": "……これからは、仲間がいる。\n『破滅の力』を回収し、防護を固めた後にも、\n王国と共にいてくれるんだろう？", "face": "u906"}, {"name": "カタラ", "text": "……そ、そうね。\nまぁ、考えておいてあげてもいいわ。", "face": "u912"}, {"name": "シャディア", "text": "（……嬉しそう、だな）", "face": "u713"}, {"name": "メーリス", "text": "（あら、でもそれを指摘したら、\n絶対ぴーぴー怒ってくるはずよ。\n今は黙っておいてあげましょ？）", "face": "u78"}, {"name": "カタラ", "text": "聞こえてるわよ！！\nさぁ、次が最後の『破滅の力』の隠し場所よ！\nちゃんと準備してついてきなさい！", "face": "u912"}]}], "map": {"image": "Map920135_5537", "w": 960, "h": 640, "spots": [{"k": "b", "x": 29, "y": 357}, {"k": "m", "x": 125, "y": 319, "id": 200}, {"k": "m", "x": 118, "y": 395, "id": 201}, {"k": "m", "x": 221, "y": 397, "id": 202}, {"k": "m", "x": 219, "y": 316, "id": 203}, {"k": "m", "x": 774, "y": 404, "id": 204}, {"k": "m", "x": 780, "y": 318, "id": 205}, {"k": "m", "x": 681, "y": 197, "id": 206}, {"k": "m", "x": 691, "y": 126, "id": 207}, {"k": "m", "x": 853, "y": 321, "id": 208}, {"k": "m", "x": 856, "y": 407, "id": 209}, {"k": "r", "x": 140, "y": 495, "id": 300}, {"k": "r", "x": 242, "y": 494, "id": 301}, {"k": "r", "x": 352, "y": 488, "id": 302}, {"k": "r", "x": 584, "y": 487, "id": 303}, {"k": "r", "x": 786, "y": 203, "id": 304}, {"k": "r", "x": 595, "y": 192, "id": 305}, {"k": "r", "x": 206, "y": 224, "id": 306}, {"k": "r", "x": 292, "y": 183, "id": 307}, {"k": "r", "x": 394, "y": 186, "id": 308}, {"k": "r", "x": 698, "y": 521, "id": 309}, {"k": "r", "x": 107, "y": 223, "id": 310}, {"k": "r", "x": 809, "y": 487, "id": 311}, {"k": "r", "x": 514, "y": 194, "id": 312}]}, "start_cost": 10, "active": true, "story_talk": true, "name_en": "Ice Shelf Cavern", "description_en": "The next destination is a freezing cavern. Defeat the Frost Giants sliding down the icy platforms to overcome this situation! Extreme (Guide for earning 1★: Avg Lv25)"}