{"quest_id": 4581, "name": "飛来する合成魔獣", "description": "帰路につく帝国の飛空船に\n空の魔物たちが襲い掛かる！\n＜帝国出身ユニット以外出撃不可＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["帝国出身ユニット以外出撃不可"], "event": "ゴールドラッシュ10(2016)", "event_category": "Reproduce", "mission_id": 300100, "map_no": 5418, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [11], "expression": "IsAssign(\"帝国\");", "expression_human": "it is assigned to [[tag:白の帝国]]"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "level": 80, "form_count": 2, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 131, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105936, "race_id": 13, "change_to": 1, "master_id": 759, "global_id": 758, "to_global_id": 276, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "hp": 15000, "attack": 550, "base_hp": 15000, "base_attack": 550, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 180, "attack_speed": 70, "attack_wait": 20, "attack_interval": 111, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100672, "race_id": 13, "change_to": 2, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 277, "global_id": 276, "ranged": true, "variants": [{"hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100688, "race_id": 13, "master_id": 278, "global_id": 277}]}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 7}, {"enemy_id": 5, "source": "local", "count": 10, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 7}, {"enemy_id": 6, "source": "local", "count": 10, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 37}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 2800, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 57}], "dialogue": [{"trigger": "start", "lines": [{"name": "レオナ", "text": "先刻の戦いによる飛空船の損傷が酷いな……。\n帝国に戻るまでちゃんと飛べるのか？", "face": "u311"}, {"name": "ボリス", "text": "俺様が整備した飛空船を\n甘く見るんじゃねえぜ、レオナ。", "face": "u360"}, {"name": "ボリス", "text": "このくらいの傷ならもう一戦くらい\n魔物とやり合うことだって――どぅわッ！？\nなんだこの揺れは？", "face": "u360"}, {"name": "イザベル", "text": "ほ、本当に大丈夫なのですか？\n不測の事態に陥っているなんてことは、\nありませんよね……？", "face": "u286"}, {"name": "ボリス", "text": "こ、このくらいの揺れで、\n慌てるんじゃねえ！", "face": "u360"}, {"name": "ディルク", "text": "――報告！\n左舷後方よりキマイラの襲撃を確認！", "face": "u287"}, {"name": "ボリス", "text": "キマイラだって？　ちくしょうッ！\n本当に魔物が襲ってきやがるとはな……。\nいよいよもって船が持たねえぞ……？", "face": "u360"}, {"name": "イザベル", "text": "さっきと言ってることがちが――きゃぁっ！？\n揺れがどんどん酷くなって……、\nわ、わわ……何とかしてくださいボリス殿ぉ！", "face": "u286"}, {"name": "レオナ", "text": "くそ、魔物め……ッ！？\n総員、直ちに臨戦態勢を取れ！", "face": "u311"}, {"name": "レオナ", "text": "陛下、ご采配をお願いします！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "キマイラの掃滅を確認！\n何とか窮地を乗り切ったようです。", "face": "u311"}, {"name": "レオナ", "text": "今日は厄日だな……。\nボリス、可能な限り飛空船を急がせてくれ。", "face": "u311"}, {"name": "ボリス", "text": "無茶言うなっての！\nさっきの戦闘で、飛空船の各所が\nまたぶっ壊れちまったんだぞ？", "face": "u360"}, {"name": "レオナ", "text": "泣き言とはおかしいな……。\n『俺様の整備した飛空船が世界最速』\n……では無かったのかな？", "face": "u311"}, {"name": "ボリス", "text": "人の言葉尻つかまえてこの女軍師め……。\n俺が気に入らねえなら\n他の飛空船技師を雇いやがれってんだ。", "face": "u360"}, {"name": "ボリス", "text": "ああむしゃくしゃするなぁッ！\nお前ら、このボリス様をなめるなよ！\n全速前進で帝都に突っ込んでやらぁッ！！", "face": "u360"}, {"name": "ドワイト", "text": "いや、ボリス殿……？\n帝都に突っ込むのは如何なものかと……。", "face": "u348"}, {"name": "ボリス", "text": "かたッ苦しいことは言いっこなしだぜドワイト！\nそれに見てみろ！\n陛下も異論は無いみたいだぜ？", "face": "u360"}, {"name": "白の皇帝", "text": "っふ……もっと飛ばせ、ボリス。", "face": "u418"}, {"name": "ドワイト", "text": "陛下まで――ッ！？\nあぁ……無事に帰還できることを\n不肖ドワイト、ただ祈るばかりです……。", "face": "u348"}]}], "active": true}