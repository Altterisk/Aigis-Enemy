180, "effect_name": "HitEffectSlow"}}, "master_id": 39871, "global_id": 13488, "ranged": true, "spawn_sec": 250}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["式神"], "hp": 428000, "attack": 500, "base_hp": 428000, "base_attack": 500, "damage_type": "true", "armor_defense": 500, "magic_defense": 15, "attack_range": 240, "attack_speed": 1, "attack_wait": 75, "attack_interval": 207, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2170080, "race_id": 4, "special_effect_id": 2411, "missile_id": 1457, "missile": {"speed": 6.0, "splash": 107}, "master_id": 40496, "global_id": 14113, "ranged": true, "spawn_sec": 329}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 434000, "attack": 2580, "base_hp": 434000, "base_attack": 2580, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_range": 300, "attack_speed": 80, "attack_wait": 65, "attack_interval": 221, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2172144, "race_id": 16, "change_to": 12, "change_condition": 1, "missile_id": 1588, "missile": {"speed": 8.0}, "master_id": 41035, "ranged": true, "variants": [{"hp": 434000, "attack": 2230, "base_hp": 434000, "base_attack": 2230, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 64, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2172160, "race_id": 16, "master_id": 41036}], "spawn_sec": 448}], "popups": ["クダギツネの攻撃を受けた\n味方ユニットは3秒間、\n攻撃力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。", "妖怪の集合体の\n一定範囲内のユニットは\n継続ダメージを受けます。\n\nまた妖怪の集合体は\n味方ユニットから受ける\n全てのダメージを30％軽減します。", "陰陽師から攻撃を\n受けると、一定時間スキルが\n使用できなくなります。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。", "黒衣の妖怪は\n一定範囲内のユニットの\n攻撃力と防御力を\n50％ダウンさせます。", "黒衣の妖怪から\n攻撃を受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n毒によるダメージは女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "近衛兵", "text": "──貴様、何者かッ！！", "face": "l040cea8008c4"}, {"name": "？？？", "text": "……それがしが何者か、ですか。", "face": "u2884a1"}, {"name": "？？？", "text": "それは拙者も探しておる最中なのですが……結構！", "face": "u2884a1"}, {"name": "？？？", "text": "問われて名乗るもおこがましいが！", "face": "u2884a1"}, {"name": "？？？", "text": "生まれはたたら場、火床の上がり！\n腰に佩かれて諸国を巡り、浮世を歩みし幾歳月。\n東に往きては悪を斬り、西に征きては鬼を断つ。", "face": "u2884a1"}, {"name": "？？？", "text": "百の節目を越えてより、年も数えぬ浪人暮らし。\n銭はなけれど心は錆びず、毀れぬ仁義を抱きて候。", "face": "u2884a1"}, {"name": "ムラサメ", "text": "抜けば玉散る氷の刃、名をムラサメ──", "face": "u2884a1"}, {"name": "ムラサメ", "text": "これより拙者、シズカ殿にお味方申す。", "face": "u2884a1"}, {"name": "シズカ", "text": "その名乗りにその名前──\nまさか、あの妖刀ムラサメ……？", "face": "u101"}, {"name": "ムラサメ", "text": "ふむ、そう呼ばれていた時期もありましたな。", "face": "u2884a1"}, {"name": "シズカ", "text": "……そう、あなたも付喪神になったのね。", "face": "u101"}, {"name": "ムラサメ", "text": "おや、驚かれぬのですか？", "face": "u2884a1"}, {"name": "シズカ", "text": "似たような存在にいくつか心当たりがあるのよ。", "face": "u101"}, {"name": "ムラサメ", "text": "ははぁ、それはまこと重畳にて。\nでは、お任せしていただけますかな", "face": "u2884a1"}, {"name": "シズカ", "text": "ええ、どうせ足が動かないもの。やってちょうだい。", "face": "u101"}, {"name": "ドウマン", "text": "（また面妖なのが現れたのぉ。\n王国の手の者か、それとも──）", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "何をしておるノリモチ、早う行かぬか。", "face": "l134bb0de0456"}, {"name": "ノリモチ", "text": "はっ、はい！　行くぞお前たち！", "face": "u2881a1"}, {"name": "ムラサメ", "text": "はっはっは、敵が一人増えた程度で及び腰ですなぁ。", "face": "u2884a1"}, {"name": "ムラサメ", "text": "さてもさてもそこもとら、\nまさか今さら死にたくないなど、\nどうか言ってくださりますな。", "face": "u2884a1"}]}, {"trigger": "end", "lines": [{"name": "陰陽師", "text": "うっ、ぐぐぐっ……。", "face": "l17ba454a069a"}, {"name": "ドウマン", "text": "逃げられた、か。この雨では足跡も追えぬ。", "face": "l134bb0de0456"}, {"name": "ノリモチ", "text": "ド、ドウマン様……。", "face": "u2881a1"}, {"name": "ドウマン", "text": "ノリモチ、貴様には失望したわ。", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "木っ端大名だった貴様を拾い上げてやったのは誰だ？\nよくも儂の期待を裏切り、斯様な無様を晒してくれたな。", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "旧友に情でも湧いたか、くだらん真似を。", "face": "l134bb0de0456"}, {"name": "ノリモチ", "text": "けっ、決してそんなことは……。", "face": "u2881a1"}, {"name": "ドウマン", "text": "もうよい、言い訳の前に足を使え。\n貴様の代わりはいくらでもいることを忘れるな。", "face": "l134bb0de0456"}, {"name": "ノリモチ", "text": "ひーん！！(号泣)", "face": "u2881a1"}, {"name": "ドウマン", "text": "（まったく、公家は根性なしが多くて嫌になるのぅ……）", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "（まあよい、これで武家と朝廷の対立は決定的──）", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "（彼奴らを朝敵に認定し、\n逆賊の汚名を着せてやれば、\nこちらに寝返る者も増えよう）", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "（帝が儂の手にある以上、大義は常にこちらにある）", "face": "l134bb0de0456"}, {"name": "ドウマン", "text": "（キシシ、なんとも簡単な遊戯よなぁ……！）", "face": "l134bb0de0456"}, {"name": "近衛兵", "text": "（笑ってる顔めっちゃこえー）", "face": "l040cea8008c4"}, {"name": "ドウマン", "text": "セイメイよ、地獄で見ているか？\n貴様が育てたこの国、儂が壊してくれようぞ。", "face": "l134bb0de0456"}]}]}