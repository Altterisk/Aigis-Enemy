{"quest_id": 7320, "name": "第一陣 前線指揮官リンクス", "description": "闇水晶の力を利用し、更に攻勢を強めんと\nするリンクスが帝国に襲い掛かる！\n<広域戦闘：敵味方の射程減少>\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国一陣", "event_category": "Empire", "mission_id": 940007, "map_no": 4565, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [20]}, {"kind": "term", "influence": 20, "params": [20]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["鳥"], "hp": 3200, "attack": 300, "base_hp": 3200, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_range": 130, "attack_speed": 1, "attack_wait": 3, "attack_interval": 49, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123008, "race_id": 12, "special_effect_id": 794, "missile_id": 474, "missile": {"speed": 10.0}, "master_id": 33706, "global_id": 7323, "ranged": true, "commands": {"raw": "CreateMapEffectObject2(\"obj_01\", \"StageOccupationFlag\", 5, 0, 60, 629, 270); DeleteMapEffectObject(\"obj_01\", 60); CreateMapPlaceObject(\"locPlc_351\", 351, 629, 270); CreateMapEffectObject2(\"obj_06\", \"StageWideAreaRangeUp\", 5, 0, 60, 629, 315); CreateMapEffectObject2(\"obj_05\", \"StageWideAreaRangeUp2\", 5, 0, 60, 629, 270); CreateGuestUnit(\"ゲストID=0\", \"配置ID=351\", \"演出=0\", \"フェード時間=20\");"}, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 66000, "attack": 1400, "base_hp": 66000, "base_attack": 1400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 240, "attack_speed": 1, "attack_wait": 28, "attack_interval": 98, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.0, "assassin_resist": 1, "transform_resist": 100,