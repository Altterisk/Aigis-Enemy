gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "master_id": 24, "global_id": 23, "spawn_sec": 96}, {"enemy_id": 16, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "tags": ["鳥"], "hp": 3200, "attack": 300, "base_hp": 3200, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_range": 130, "attack_speed": 1, "attack_wait": 3, "attack_interval": 49, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123008, "race_id": 12, "special_effect_id": 234, "missile_id": 474, "missile": {"speed": 10.0}, "master_id": 32635, "global_id": 6253, "ranged": true, "spawn_sec": 96}, {"enemy_id": 17, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 120, "attack_speed": 1, "attack_wait": 1, "attack_interval": 20, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122160, "race_id": 12, "special_effect_id": 621, "master_id": 21071, "global_id": 1365, "spawn_sec": 101}, {"enemy_id": 18, "source": "local", "count": 5, "form_index": 0, "form_count": 2, "hp": 8000, "attack": 1400, "base_hp": 8000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "change_to": 18, "change_condition": 4, "master_id": 33563, "global_id": 7180, "to_condition": 4, "to_ticks": 3, "to_global_id": 7183, "spawn_sec": 112}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 22, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 45000, "attack": 1800, "base_hp": 45000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2128592, "race_id": 12, "master_id": 33700, "global_id": 7317, "spawn_sec": 139}, {"enemy_id": 23, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 30000, "attack": 1100, "base_hp": 30000, "base_attack": 1100, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103568, "race_id": 12, "master_id": 456, "global_id": 455, "spawn_sec": 154}], "popups": ["リンクスの部隊は体力が\n徐々に減少していきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リンクス", "text": "――なるほど、ね……。\n白の帝国だけならまだしも、\n王国がここまで厄介だなんて。", "face": "u1561a1"}, {"name": "リンクス", "text": "……そういえば、あの男も王子が何とかって言ってたわね。\nダーク何とかって名前だったかしら……。", "face": "u1561a1"}, {"name": "リンクス", "text": "まぁいいわ。私が直接戦場に出て、\n王子とやらを叩き潰せばいいだけよ。", "face": "u1561a1"}, {"name": "ハイドース", "text": "――リンクスよ、指揮官が前線に出るなとは、\n確かお前から聞いた言葉ではなかったか。", "face": "le4066daa294e"}, {"name": "リンクス", "text": "……指揮官はハイドース様ですから。\n私は前線指揮官、兵と共に最前線に立つのが役目よ。", "face": "u1561a1"}, {"name": "ハイドース", "text": "やれやれ、そういう気質は獣人ならではか。\nだが、決して引き際を見誤るな。\nまずは初戦、敵を知ることが最優先と心得よ。", "face": "le4066daa294e"}, {"name": "リンクス", "text": "……勝っても負けてもいいから、死ぬな、と。\nえぇ、分かったわ、ハイドース様。", "face": "u1561a1"}]}, {"trigger": "start", "lines": [{"name": "マレブランケ", "text": "王子、敵が動き始めたようだ。\nどうやらこちらの先手を取りたいようだね。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "先頭にいる獣人の子が、\nリエーフの言っていたリンクス嬢かな？", "face": "u1225a1"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "リンクス", "text": "ハイドース様、冥界の力をお借りします。", "face": "u1561a1"}, {"name": "マレブランケ", "text": "むっ……あれは闇水晶かな……？\nリンクス嬢から感じる力が、\n急速に増大していくようだ。", "face": "u1225a1"}, {"name": "リエーフ", "text": "リンクス、また無茶を……。\n王子様、どうかあの子を止めるために、\n力を貸してください！", "face": "u1178a1"}]}, {"trigger": "battle", "at_sec": 188, "lines": [{"name": "マレブランケ", "text": "王子、敵の増援部隊だ。\nさすがに後詰を用意していたか、冥界軍。", "face": "u1225a1"}, {"name": "リエーフ", "text": "これは軍と軍の戦い……。\n戦場を知る者同士の争い、ということですね……。", "face": "u1178a1"}, {"name": "レオーネ", "text": "心配しなくても大丈夫だって。\n王子がさ、いくつの戦場を\n勝ち抜いてきたと思ってるのさ。", "face": "u926"}, {"name": "リエーフ", "text": "……ですね。\n王子様、今はこの戦いを征しましょう！", "face": "u1178a1"}]}, {"trigger": "end", "lines": [{"name": "バシラ", "text": "――王子！　冥界軍が前線を下げ始めました！", "face": "u28"}, {"name": "レオナ", "text": "ふぅ……初戦はこちらの勝利、だな。\n皆、よくやってくれた！", "face": "u311"}, {"name": "メフィスト", "text": "だが獣人と冥界人の部隊だけで、\n帝国を攻め滅ぼすつもりでもあるまい。\n後に控えるのは、いったい何だろうね。", "face": "u526"}, {"name": "白の皇帝", "text": "……何が来ようと、することは変わらない。\nまずは兵に休息を取らせろ。", "face": "u418"}, {"name": "白の皇帝", "text": "王子、王国軍も傷の手当が必要だろう。\n得られた時間は長くはないが、\n可能な限りの準備を済ませておけ。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "白の皇帝", "text": "……俺が言うまでもなかったか。\n敵とすれば怖ろしいが、\n味方となれば心強いものだな。", "face": "u418"}, {"name": "アンナ", "text": "王子、兵の治療を開始しました。\nシノビと弓手で連携し、周辺の索敵も進めています。", "face": "l91db55a83012"}, {"name": "アンナ", "text": "……苦しい戦いではありますが、\nきっと、勝利をつかみ取りましょう！", "face": "l91db55a83012"}]}], "active": true}