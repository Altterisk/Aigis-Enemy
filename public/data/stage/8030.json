{"quest_id": 8030, "name": "慰霊式典に潜む爆弾魔", "description": "襲撃が続くなか古戦場で慰霊式典を行う\n王子一行。追悼の模擬戦ではフーロン、\nリヴン、スーシェンを相手に武威を示せ！\n上級（★１獲得の目安：平均Lv10）", "event": "人気闘兵凱旋パレードIII", "event_category": "History", "mission_id": 920202, "map_no": 4773, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 5000, "attack": 350, "base_hp": 5000, "base_attack": 350, "damage_type": "true", "armor_defense": 80, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_wait": 120, "attack_interval": 276, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2128192, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 36345, "global_id": 9962, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "true", "armor_defense": 100, "magic_defense": 10, "attack_range": 350, "attack_speed": 1, "attack_wait": 25, "attack_interval": 86, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120928, "special_effect_id": 371, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 36350, "global_id": 9967, "ranged": true, "spawn_sec": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 60, "attack_speed": 1, "attack_wait": 17, "attack_interval": 83, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2145920, "special_effect_id": 1442, "missile_id": 45, "master_id": 36349, "global_id": 9966, "ranged": true, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 6, "