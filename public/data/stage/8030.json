st": 1, "transform_resist": 1, "pattern_id": 2123520, "change_to": 11, "change_condition": 4, "missile_id": 11, "master_id": 32648, "global_id": 6266, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6267, "route_behaviour": {"sets_flags": [[18, 1, 120], [17, 1, 100], [20, 1, 100], [19, 1, 100], [22, 1, 100], [21, 1, 90], [2, 1, 240], [3, 1, 340], [5, 1, 100], [4, 1, 0], [23, 1, 100], [24, 1, 120], [25, 1, 200], [6, 1, 200], [7, 1, 200], [8, 1, 1200], [9, 1, 200], [10, 1, 200], [11, 1, 200], [12, 1, 1200], [13, 1, 1000], [14, 1, 200], [15, 1, 10000], [16, 1, 0]]}, "spawn_sec": 282}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 420, "magic_defense": 15, "attack_range": 50, "attack_speed": 1, "attack_wait": 15, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123536, "special_effect_id": 548, "missile_id": 11, "master_id": 32649, "global_id": 6267, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 24, "form_count": 3, "tags": ["機械"], "hp": 9500, "attack": 400, "base_hp": 9500, "base_attack": 400, "damage_type": "physical", "armor_defense": 170, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126400, "special_effect_id": 658, "change_to": 8, "missile_id": 515, "missile": {"speed": 8.0, "splash": 67}, "master_id": 33022, "global_id": 6639, "ranged": true, "to_global_id": 6638, "route_behaviour": {"reroutes": ["Route=202", "Route=300", "Route=301", "Route=302", "Route=303", "Route=304", "Route=305", "Route=306", "Route=307", "Route=308", "Route=309", "Route=310", "Route=311", "Route=312", "Route=313", "Route=314", "Route=315", "Route=316", "Route=317", "Route=318", "Route=319", "Route=320", "Route=321", "Route=322", "Route=323", "Route=500", "Route=600", "Route=999"]}, "spawn_sec": 282}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械"], "hp": 9500, "attack": 400, "base_hp": 9500, "base_attack": 400, "damage_type": "physical", "armor_defense": 170, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126416, "special_effect_id": 659, "change_to": 7, "missile_id": 515, "missile": {"speed": 8.0, "splash": 67}, "master_id": 33021, "global_id": 6638, "ranged": true, "to_global_id": 6637}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["機械"], "hp": 9500, "attack": 400, "base_hp": 9500, "base_attack": 400, "damage_type": "physical", "armor_defense": 170, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126400, "special_effect_id": 657, "change_to": 8, "missile_id": 515, "missile": {"speed": 8.0, "splash": 67}, "master_id": 33020, "global_id": 6637, "ranged": true}], "popups": ["リヴンから\n攻撃を複数回受けると、\n麻痺状態になります。", "スーシェンは倒されると\n自身の周囲にダメージを与えます。", "フォー人形から受けた\nダメージは2倍になります。\n\nまた、フォー人形は倒されると\n自身の周囲にダメージを与えます。", "フォーから受けた\nダメージは2倍になります。\n\nまたフォーを倒すと\n以降、人形は登場しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シロガネ", "text": "ここで一旦パレードを中断して、慰霊式典の時間っす。", "face": "u1657a1"}, {"name": "リヴン", "text": "──まずは古戦場という会場にも関わらず、\n多くの者が集まってくれたことに感謝したい。", "face": "u1619a1"}, {"name": "リヴン", "text": "……おそらくこの場にいる者たちの中に、\n誰かを失ったことがない者はいないだろう。", "face": "u1619a1"}, {"name": "リヴン", "text": "家族を、友人を、仲間を。あるいは、その全てを。", "face": "u1619a1"}, {"name": "リヴン", "text": "かくいう私もそうだった。\nいや、失ったという表現は少し違うな。\n己の無能で大切なものを手放してしまった。", "face": "u1619a1"}, {"name": "リヴン", "text": "永劫、この罪と後悔が消えることはないだろう。\nそれでも、私は決して下を向くわけにはいかない。", "face": "u1619a1"}, {"name": "リヴン", "text": "……きっと、諸君らも同じはずだ。\n道半ばに倒れた者たちの意志を受け継ぎ、\n我々は前へ進み続けなければならないのだ。", "face": "u1619a1"}, {"name": "フーロン", "text": "この場に眠る英雄たちに敬意と、哀悼を。", "face": "u1158a1"}, {"name": "スーシェン", "text": "そして、平和への誓いと祈りを捧げましょう。", "face": "u607"}, {"name": "スーシェン", "text": "──黙祷。", "face": "u607"}, {"name": "兵士", "text": "………………。", "face": "u6"}, {"name": "兵士", "text": "………………。", "face": "u64"}, {"name": "リヴン", "text": "さあ、追悼の摸擬戦だ。", "face": "u1619a1"}, {"name": "兵士", "text": "うぉーーー！！", "face": "u65"}, {"name": "シロガネ", "text": "やっべぇ国民性っすね～。", "face": "u1657a1"}]}, {"trigger": "battle", "at_sec": 184, "lines": [{"name": "フォー", "text": "あーあー、暢気なもんだぜ。\n俺が大量の爆弾を仕込んでるとも知らずに、\n感動的な演説なんかしちゃってよォ……。", "face": "l8a947ee22b44"}, {"name": "フォー", "text": "アンデッドが慰霊なんてシャレにもならねぇ。\n知ってるかい？　命は有限だから美しいんだぜ？", "face": "l8a947ee22b44"}, {"name": "フォー", "text": "今からそいつを教えてやる──", "face": "l8a947ee22b44"}, {"name": "リヴン", "text": "甘いな。", "face": "u1619a1"}, {"name": "フォー", "text": "──なッ、俺の爆弾が！？　いつから気づいて！？", "face": "l8a947ee22b44"}, {"name": "リヴン", "text": "なに、タネの割れた手品師などこの程度さ。", "face": "u1619a1"}, {"name": "スーシェン", "text": "──滑稽。芸がないとはこのことですね。", "face": "u607"}, {"name": "フーロン", "text": "いいえスーシェンさん、それは違います。\n道化師というのは人を笑わせるのが仕事です。\nその点、あのピエロは芸達者と言えるでしょう。", "face": "u1158a1"}, {"name": "フーロン", "text": "──まあ、失笑ですけどね。", "face": "u1158a1"}, {"name": "フォー", "text": "ハッ……ハハッ、ハハハハハッ！\nこんな屈辱は初めてだぜ王子ィ……！", "face": "l8a947ee22b44"}, {"name": "フォー", "text": "……テメェら全員木っ端微塵にしてやる。", "face": "l8a947ee22b44"}, {"name": "リヴン", "text": "ではこちらも宣言しよう、お前には無理だ。", "face": "u1619a1"}, {"name": "スーシェン", "text": "──提案。\n人形使いは本体を仕留めるが定石、\nそれで厄介な人形も止まるはずです。", "face": "u607"}, {"name": "フーロン", "text": "さて、道化には道化らしく、\n派手に踊ってもらいましょう。", "face": "u1158a1"}]}, {"trigger": "end", "lines": [{"name": "フォー", "text": "こんのっ……人形風情がァアアアア！", "face": "l8a947ee22b44"}, {"name": "闇組織構成員", "text": "フォー様！　もう無理です！　退却しましょう！", "face": "l7ef7f376a7ca"}, {"name": "セブン", "text": "……ぷっ、ざまぁ♪", "face": "u449"}, {"name": "フォー", "text": "ああああああああああッ！？", "face": "l8a947ee22b44"}, {"name": "闇組織構成員", "text": "フォー様！　逃げますよ！　\n逃げっ……逃げるっつってんだろうが！\nお前たちも手伝え！　さっさとずらかるぞ！", "face": "l7ef7f376a7ca"}, {"name": "ノストラ", "text": "……スッキリしたわ、あいつ嫌いなのよね。", "face": "u1912a1"}, {"name": "ノストラ", "text": "狡賢いけど計画を邪魔されるのを極度に嫌う。\nその割に、挑発に乗って自分の感情を優先する。", "face": "u1912a1"}, {"name": "ノストラ", "text": "……追撃は任せて良いのよね。", "face": "u1912a1"}, {"name": "メアリ", "text": "はい、私たちの方で彼らを追い込みます。", "face": "u1053a1"}, {"name": "ノストラ", "text": "──で、まだ文句があるのかしら？", "face": "u1912a1"}, {"name": "セブン", "text": "……アタシはまだ信じてねぇからな。", "face": "u449"}, {"name": "ノストラ", "text": "別に貴方からの信用なんて要らないわ。\n私の計画の邪魔さえしないでくれたらね。", "face": "u1912a1"}, {"name": "セブン", "text": "……なんだよ計画って。", "face": "u449"}, {"name": "ノストラ", "text": "どうせ信じないから言わないわ。\nでも、悪いようにはしないから安心しなさい。\n全部が終わる頃には、貴方の望みも叶うはずよ。", "face": "u1912a1"}, {"name": "セブン", "text": "……アタシの、望み？", "face": "u449"}]}], "active": true}