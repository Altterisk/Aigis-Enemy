: 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 68}, {"enemy_id": 9, "source": "local", "count": 26, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 70}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 122}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、報告にあった小屋が見えてきました。\n魔物が暴れているというのはこの辺りのようですね。", "face": "l4fa24225c3f2"}, {"name": "クレア", "text": "――待って、みんな。なにか聞こえる。\nこれは……銃声？", "face": "u30"}, {"name": "？？？", "text": "オ～ッホッホ！　最高ねぇ！\nアナタが作ったこの『ガトリング』とかいう銃は。", "face": "l075961d84daa"}, {"name": "ゴブリン博士", "text": "光栄にございマス。\nそちらは最新のねじ巻き式の機関銃デス。", "face": "l461eedd99c96"}, {"name": "ゴブリン博士", "text": "その他にモ腕が変形して火炎放射器になるナド、\nクイーン様の麗しき機械のボディーは\n多数の優れた機能を搭載しておりマス。", "face": "l461eedd99c96"}, {"name": "アンナ", "text": "……『クイーン様』？\nでは、ゴブリン博士の傍にいるのは……！", "face": "l4fa24225c3f2"}, {"name": "メカゴブリンクイーン", "text": "ウフフ……来たわね、王子。\nアナタたちが来るのを待っていたのよ。", "face": "l075961d84daa"}, {"name": "メカゴブリンクイーン", "text": "……理由？　そんなの決まってるじゃない。\n死の淵から蘇った新しいワタシを見てもらうためよ。", "face": "l075961d84daa"}, {"name": "ゴブリン博士", "text": "確かにクイーン様はかつて瀕死の重傷を負われタ。\nダガ、その不屈の精神とワタクシの改造手術にヨリ、\n以前よりもさらに強く、美しく生まれ変わったノダ！", "face": "l461eedd99c96"}, {"name": "ケイティ", "text": "美しい……？\n確かに凄い技術ですが、美しいかどうかは……。", "face": "u114"}, {"name": "ゴブリン博士", "text": "な、何を言ウ！？\nこの洗練サレタ機能美が分からんトハ――", "face": "l461eedd99c96"}, {"name": "メカゴブリンクイーン", "text": "――下がってなさい、博士。\n野蛮な人間たちにワタシたちゴブリンの\n崇高なる美的感覚が判るはずもないわ。", "face": "l075961d84daa"}, {"name": "メカゴブリンクイーン", "text": "さぁて……覚悟なさい、人間たち！\nワタシの快気祝いに相応しい、\n無様な踊りを踊らせてあげるわぁ！", "face": "l075961d84daa"}]}, {"trigger": "end", "lines": [{"name": "メカゴブリンクイーン", "text": "ウフフ……今日のところはこんなものかしら。\n博士、引き上げるわよ。", "face": "l075961d84daa"}, {"name": "兵士", "text": "ゴブリン軍、撤退していきます。", "face": "u6"}, {"name": "アンナ", "text": "皆さん、お怪我はありませんか？"}, {"name": "クレア", "text": "はい、大丈夫です。\nそれにしても凄い技術でしたねぇ。\n身体の一部を機械にしちゃうなんて。", "face": "u30"}, {"name": "アンナ", "text": "ええ……ゴブリン博士の技術力は\n日増しに高まっているようですね。", "face": "l4fa24225c3f2"}, {"name": "ケイティ", "text": "それに、ゴブリンクイーンが復活した今、\nゴブリン軍の情勢は再び変化していくはずです。", "face": "u114"}, {"name": "アンナ", "text": "今後もゴブリンたちの動向には\n注意を払う必要がありそうですね。\n……それでは皆さん、帰還いたしましょう。"}]}], "active": true}