issile": {"speed": 12.0, "deflectable": true}, "master_id": 518, "global_id": 517, "ranged": true, "from_condition": 0}, {"enemy_id": 4, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 4, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 76}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 6, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 1500, "base_hp": 2000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 250, "magic_defense": 40, "attack_range": 160, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099504, "race_id": 4, "change_to": 6, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 106, "global_id": 105, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 106, "spawn_sec": 146}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 60, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "from_condition": 4, "trigger_ticks": 1}], "popups": [" 　　　悪天候：霧\n\n・敵味方の『射程』減少\n・一部の味方は影響を受けない"], "dialogue": [{"trigger": "start", "lines": [{"name": "アカネ", "text": "──迷いました。", "face": "u1678a1"}, {"name": "シエナ", "text": "困った……。", "face": "u1680a1"}, {"name": "カノン", "text": "意気揚々と妖怪退治を請け負っといて、\n標的を取り逃した上に迷子になりましたじゃ、\nさすがに依頼主たちに顔向けできないわね……。", "face": "u1417a1"}, {"name": "フィオレ", "text": "ですが、仕方ありませんよ。\nこれほどまでに霧が濃くなるなんて、\n誰にも予想できませんでしたから。", "face": "u1679a1"}, {"name": "ミコト", "text": "この濃霧ではこれ以上の捜索は危険です。\n今日のところは諦めて下山するべきですね。", "face": "u130"}, {"name": "シエナ", "text": "……問題は無事に下山できるかどうか。", "face": "u1680a1"}, {"name": "フィオレ", "text": "ええ、下手に動けば遭難もありえます。\nはぐれないよう全員で慎重に動きましょう。", "face": "u1679a1"}, {"name": "シエナ", "text": "……それだけじゃない。", "face": "u1680a1"}, {"name": "ソーマ", "text": "──っ！？　敵襲！　敵襲です！", "face": "u1138a1"}, {"name": "アカネ", "text": "ここからは攻守逆転、ということですか。", "face": "u1678a1"}, {"name": "アカネ", "text": "濃霧の中では姿を見失いがちでしたが、\n向こうから来るのであればむしろ好都合。", "face": "u1678a1"}, {"name": "アカネ", "text": "直接、そっ首叩き落として差し上げましょう。", "face": "u1678a1"}]}, {"trigger": "end", "lines": [{"name": "アカネ", "text": "ふむ、依頼の標的ではなかったようですね。", "face": "u1678a1"}, {"name": "シエナ", "text": "残念……せっかく倒したのに。", "face": "u1680a1"}, {"name": "カノン", "text": "雑魚は放って今日はさっさと下山しましょ。\nこの霧じゃあ、まともに砲撃もできないもの。", "face": "u1417a1"}, {"name": "ミコト", "text": "そうしたいのは山々なのですが、\n時間を掛け過ぎてしまったようですね。\n今からだと下山するには遅すぎます。", "face": "u130"}, {"name": "フィオレ", "text": "私も同意見です。\n山中での夜間の行軍は、\n事故に繋がりかねません。", "face": "u1679a1"}, {"name": "カノン", "text": "うへぇ、まさか……野宿？", "face": "u1417a1"}, {"name": "アカネ", "text": "致し方ありませんね、野営の準備を──", "face": "u1678a1"}, {"name": "？？？", "text": "──お困りですかな？", "face": "l613d32145d89"}, {"name": "アカネ", "text": "ッ、何者です！", "face": "u1678a1"}, {"name": "？？？", "text": "おっと、刀を収めてください。\n決して怪しい者ではありません。", "face": "l613d32145d89"}, {"name": "シエナ", "text": "登場の仕方からして怪しさしかない。\nアナタは誰？　どうしてここにいるの？", "face": "u1680a1"}, {"name": "？？？", "text": "名乗るほどの者ではございません。\nこの近くで小さな宿を営んでおります、\n温泉が趣味のただの老いぼれですよ。", "face": "l613d32145d89"}, {"name": "ミコト", "text": "温泉……。", "face": "u130"}, {"name": "アカネ", "text": "宿……？", "face": "u1678a1"}]}], "map": {"image": "Map920190_4664", "w": 960, "h": 640, "spots": [{"k": "b", "x": 27, "y": 227}, {"k": "b", "x": 23, "y": 455}, {"k": "m", "x": 818, "y": 280, "id": 200}, {"k": "m", "x": 819, "y": 361, "id": 201}, {"k": "m", "x": 739, "y": 316, "id": 202}, {"k": "m", "x": 739, "y": 398, "id": 203}, {"k": "m", "x": 656, "y": 344, "id": 204}, {"k": "m", "x": 655, "y": 419, "id": 205}, {"k": "m", "x": 575, "y": 342, "id": 206}, {"k": "m", "x": 574, "y": 420, "id": 207}, {"k": "m", "x": 496, "y": 342, "id": 208}, {"k": "m", "x": 495, "y": 419, "id": 209}, {"k": "m", "x": 515, "y": 198, "id": 210}, {"k": "m", "x": 596, "y": 140, "id": 211}, {"k": "m", "x": 478, "y": 120, "id": 212}, {"k": "m", "x": 467, "y": 267, "id": 213}, {"k": "m", "x": 418, "y": 342, "id": 214}, {"k": "m", "x": 417, "y": 417, "id": 215}, {"k": "m", "x": 338, "y": 341, "id": 216}, {"k": "m", "x": 338, "y": 417, "id": 217}, {"k": "m", "x": 252, "y": 333, "id": 218}, {"k": "m", "x": 254, "y": 406, "id": 219}, {"k": "m", "x": 164, "y": 401, "id": 220}, {"k": "m", "x": 152, "y": 309, "id": 221}, {"k": "m", "x": 79, "y": 269, "id": 222}, {"k": "m", "x": 81, "y": 420, "id": 223}, {"k": "m", "x": 660, "y": 103, "id": 224}, {"k": "m", "x": 437, "y": 53, "id": 225}, {"k": "r", "x": 525, "y": 289, "id": 300}, {"k": "r", "x": 802, "y": 208, "id": 301}, {"k": "r", "x": 689, "y": 481, "id": 302}, {"k": "r", "x": 774, "y": 461, "id": 303}, {"k": "r", "x": 90, "y": 187, "id": 304}, {"k": "r", "x": 75, "y": 361, "id": 305}, {"k": "r", "x": 303, "y": 285, "id": 306}, {"k": "r", "x": 261, "y": 465, "id": 307}, {"k": "r", "x": 3