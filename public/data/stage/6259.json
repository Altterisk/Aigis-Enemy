{"quest_id": 6259, "name": "夜明けの決戦", "description": "ついに姿を現したヴァンパイア公爵。\n吸血鬼達との決戦を制し、\n操られたカリオペを救い出せ！\n極級（★１獲得の目安：平均Lv25）", "event": "カリオペと恐怖の夜", "event_category": "History", "mission_id": 920096, "map_no": 3253, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 10, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 20}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157, "spawn_sec": 33}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111632, "race_id": 11, "special_effect_id": 233, "master_id": 30613, "global_id": 4232, "spawn_sec": 50}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 30, "attack_wait": 50, "attack_interval": 201, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105360, "master_id": 634, "global_id": 633, "spawn_sec": 88}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 450, "base_hp": 9000, "base_attack": 450, "damage_type": "magical", "armor_defense": 240, "magic_defense": 10, "attack_range": 230, "attack_speed": 70, "attack_wait": 60, "attack_interval": 175, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111648, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 30616, "global_id": 4235, "ranged": true, "spawn_sec": 95}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 1, "hp": 1500, "attack": 20, "base_hp": 1500, "base_attack": 20, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 35, "attack_speed": 10, "attack_wait": 12, "attack_interval": 35, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2105344, "race_id": 11, "special_effect_id": 71, "missile_id": 47, "master_id": 633, "global_id": 632, "ranged": true, "spawn_sec": 98}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 650, "base_hp": 20000, "base_attack": 650, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 180, "attack_speed": 70, "attack_wait": 50, "attack_interval": 171, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111664, "race_id": 13, "change_to": 8, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 30617, "global_id": 4236, "ranged": true, "variants": [{"tags": ["アンデッド"], "hp": 20000, "attack": 1300, "base_hp": 20000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111680, "race_id": 13, "special_effect_id": 233, "master_id": 30618, "global_id": 4237}], "spawn_sec": 123}], "dialogue": [{"trigger": "start", "lines": [{"name": "公爵", "text": "我が眷属よ……何をもたついておる？\n一刻も早く人間らの本拠を突き崩すのだ。", "face": "la721cbb86253"}, {"name": "ゴブリンゾンビ", "text": "ギャ……ギャ……ニンゲン……テゴワイ……。\nマモリ……カタイ……攻メルノ……難シイ……。", "face": "l1c6114090332"}, {"name": "公爵", "text": "弁解など聞かぬ。無駄口を叩く暇があるのなら、\nその身を賭して本陣を攻めよ。", "face": "la721cbb86253"}, {"name": "ゴブリンゾンビ", "text": "……ソンナ……無茶苦茶ダ……。", "face": "l1c6114090332"}, {"name": "ラキュア", "text": "ふッ……どうやらかなり焦れておるようだな、公爵よ。\nまぁ、当然のことか。このまま、夜が明けてしまっては、\n貴様の計画は水泡に帰してしまうのだからな。", "face": "u344"}, {"name": "公爵", "text": "口を慎みたまえ、吸血種の恥さらし……。\n見たところ、貴様は未だ人間に与しているようだが、\nいい加減、目を醒ましたらどうかね？", "face": "la721cbb86253"}, {"name": "ラキュア", "text": "目を醒ます、だと？　", "face": "u344"}, {"name": "ラキュア", "text": "ふッ……血液採取の永久機関などと\n下劣極まりない夢に浸り続けている貴様に\n言われたくはない。", "face": "u344"}, {"name": "ラキュア", "text": "ヴァンパイアの誇りすら捨て、魔物を眷属とした貴様になど\nもはや醜さしか感じぬ……心から欲するものがあるのなら、\n自ら奪いに来たらどうだ、公爵？", "face": "u344"}, {"name": "公爵", "text": "ラキュア……やはり、貴様とは相容れぬようだな。\n……よかろう。その度し難き愚かさは、\n我が手によって粛正してやるとしよう。", "face": "la721cbb86253"}, {"name": "アンナ", "text": "――王子！　公爵が戦闘態勢に入ったようです！\nカリオペさんを助けるためにも、すぐに出撃の準備を！", "face": "lbdeea5beba02"}]}, {"trigger": "end", "lines": [{"name": "公爵", "text": "――くッ、ぅぅ……まずい……。\nこのままでは、夜が明けてしまう……。", "face": "la721cbb86253"}, {"name": "公爵", "text": "仕方ない……此処は撤退するしかなかろう。\nだが、これで終わったと思うな、人間たちよ……。", "face": "la721cbb86253"}, {"name": "公爵", "text": "より多くの魔物をヴァンパイア化することで、\n我が眷属による大軍勢を従え……いつの日か、\n必ずや血液採取の永久機関を作ってみせる……。", "face": "la721cbb86253"}, {"name": "メメント", "text": "…………な、何とか退けることが出来たみたいだけど、\nあの様子だと、いずれまた戦うことになりそうだね？", "face": "u195"}, {"name": "ラキュア", "text": "ああ……とはいえ、こうしてカリオペを\n無事に助けることが出来たのだ。\n今は彼女の生還を喜ぶとしよう。", "face": "u344"}, {"name": "カリオペ", "text": "……ん、ぅぅ…………あ、れ？\nどうして私、こんなところで寝てたのかしら？", "face": "u524"}, {"name": "フーリ", "text": "――カリオペさん！？\nよかった、気が付いたのですね！\n怪我は？　どこか痛むところはありませんか？", "face": "u174"}, {"name": "カリオペ", "text": "ちょ、ちょっと！　\nそんなふうに抱きつかれる方が痛いって！\n……というより、私が準備した肝試し大会はどうなったの？", "face": "u524"}, {"name": "メトゥス", "text": "何が肝試し大会は、よ。\nまったく……アナタのせいで、\nこっちは肝が冷えっぱなしだったんだからね？", "face": "u329"}, {"name": "アンナ", "text": "何はともあれ、こうして皆さんが無事でよかったですね。\n王子、本当にお疲れ様でした。"}]}], "active": true}