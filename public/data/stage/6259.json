0, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 650, "base_hp": 20000, "base_attack": 650, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 180, "attack_speed": 70, "attack_wait": 50, "attack_interval": 171, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111664, "race_id": 13, "change_to": 8, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 30617, "global_id": 4236, "ranged": true, "variants": [{"tags": ["アンデッド"], "hp": 20000, "attack": 1300, "base_hp": 20000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111680, "race_id": 13, "special_effect_id": 233, "master_id": 30618, "global_id": 4237}], "spawn_sec": 123}], "dialogue": [{"trigger": "start", "lines": [{"name": "公爵", "text": "我が眷属よ……何をもたついておる？\n一刻も早く人間らの本拠を突き崩すのだ。", "face": "la721cbb86253"}, {"name": "ゴブリンゾンビ", "text": "ギャ……ギャ……ニンゲン……テゴワイ……。\nマモリ……カタイ……攻メルノ……難シイ……。", "face": "l1c6114090332"}, {"name": "公爵", "text": "弁解など聞かぬ。無駄口を叩く暇があるのなら、\nその身を賭して本陣を攻めよ。", "face": "la721cbb86253"}, {"name": "ゴブリンゾンビ", "text": "……ソンナ……無茶苦茶ダ……。", "face": "l1c6114090332"}, {"name": "ラキュア", "text": "ふッ……どうやらかなり焦れておるようだな、公爵よ。\nまぁ、当然のことか。このまま、夜が明けてしまっては、\n貴様の計画は水泡に帰してしまうのだからな。", "face": "u344"}, {"name": "公爵", "text": "口を慎みたまえ、吸血種の恥さらし……。\n見たところ、貴様は未だ人間に与しているようだが、\nいい加減、目を醒ましたらどうかね？", "face": "la721cbb86253"}, {"name": "ラキュア", "text": "目を醒ます、だと？　", "face": "u344"}, {"name": "ラキュア", "text": "ふッ……血液採取の永久機関などと\n下劣極まりない夢に浸り続けている貴様に\n言われたくはない。", "face": "u344"}, {"name": "ラキュア", "text": "ヴァンパイアの誇りすら捨て、魔物を眷属とした貴様になど\nもはや醜さしか感じぬ……心から欲するものがあるのなら、\n自ら奪いに来たらどうだ、公爵？", "face": "u344"}, {"name": "公爵", "text": "ラキュア……やはり、貴様とは相容れぬようだな。\n……よかろう。その度し難き愚かさは、\n我が手によって粛正してやるとしよう。", "face": "la721cbb86253"}, {"name": "アンナ", "text": "――王子！　公爵が戦闘態勢に入ったようです！\nカリオペさんを助けるためにも、すぐに出撃の準備を！", "face": "la78924dc8c4e"}]}, {"trigger": "end", "lines": [{"name": "公爵", "text": "――くッ、ぅぅ……まずい……。\nこのままでは、夜が明けてしまう……。", "face": "la721cbb86253"}, {"name": "公爵", "text": "仕方ない……此処は撤退するしかなかろう。\nだが、これで終わったと思うな、人間たちよ……。", "face": "la721cbb86253"}, {"name": "公爵", "text": "より多くの魔物をヴァンパイア化することで、\n我が眷属による大軍勢を従え……いつの日か、\n必ずや血液採取の永久機関を作ってみせる……。", "face": "la721cbb86253"}, {"name": "メメント", "text": "…………な、何とか退けることが出来たみたいだけど、\nあの様子だと、いずれまた戦うことになりそうだね？", "face": "u195"}, {"name": "ラキュア", "text": "ああ……とはいえ、こうしてカリオペを\n無事に助けることが出来たのだ。\n今は彼女の生還を喜ぶとしよう。", "face": "u344"}, {"name": "カリオペ", "text": "……ん、ぅぅ…………あ、れ？\nどうして私、こんなところで寝てたのかしら？", "face": "u524"}, {"name": "フーリ", "text": "――カリオペさん！？\nよかった、気が付いたのですね！\n怪我は？　どこか痛むところはありませんか？", "face": "u174"}, {"name": "カリオペ", "text": "ちょ、ちょっと！　\nそんなふうに抱きつかれる方が痛いって！\n……というより、私が準備した肝試し大会はどうなったの？", "face": "u524"}, {"name": "メトゥス", "text": "何が肝試し大会は、よ。\nまったく……アナタのせいで、\nこっちは肝が冷えっぱなしだったんだからね？", "face": "u329"}, {"name": "アンナ", "text": "何はともあれ、こうして皆さんが無事でよかったですね。\n王子、本当にお疲れ様でした。"}]}], "map": {"image": "Map920096_3253", "w": 960, "h": 640, "spots": [{"k": "b", "x": 132, "y": 258}, {"k": "m", "x": 238, "y": 424, "id": 200}, {"k": "m", "x": 177, "y": 359, "id": 201}, {"k": "m", "x": 256, "y": 176, "id": 202}, {"k": "m", "x": 199, "y": 293, "id": 203}, {"k": "m", "x": 648, "y": 268, "id": 204}, {"k": "m", "x": 330, "y": 145, "id": 205}, {"k": "m", "x": 388, "y": 171, "id": 206}, {"k": "m", "x": 449, "y": 203, "id": 207}, {"k": "m", "x": 572, "y": 250, "id": 208}, {"k": "m", "x": 573, "y": 320, "id": 209}, {"k": "m", "x": 509, "y": 342, "id": 210}, {"k": "m", "x": 376, "y": 382, "id": 211}, {"k": "m", "x": 409, "y": 431, "id": 212}, {"k": "m", "x": 483, "y": 433, "id": 213}, {"k": "m", "x": 556, "y": 435, "id": 214}, {"k": "m", "x": 630, "y": 440, "id": 215}, {"k": "m", "x": 827, "y": 294, "id": 216}, {"k": "m", "x": 706, "y": 202, "id": 217}, {"k": "m", "x":