100, "pattern_id": 2099984, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 209, "global_id": 208, "ranged": true, "spawn_sec": 114}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "tags": ["忍者"], "hp": 900, "attack": 190, "base_hp": 900, "base_attack": 190, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100032, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 212, "global_id": 211, "ranged": true, "spawn_sec": 116}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["女性", "サムライ"], "hp": 18000, "attack": 1500, "base_hp": 18000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120464, "race_id": 16, "change_to": 10, "change_condition": 1, "master_id": 32045, "global_id": 5664, "variants": [{"tags": ["女性", "サムライ"], "hp": 18000, "attack": 1500, "base_hp": 18000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2120464, "race_id": 16, "special_effect_id": 436, "master_id": 32046, "global_id": 5665}], "spawn_sec": 133}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 350, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2126720, "race_id": 16, "special_effect_id": 665, "master_id": 33071, "global_id": 6688, "spawn_sec": 135}], "popups": ["ロゼットがいる間は\nレアリティゴールドの\n敵ユニットの攻撃と防御が\nアップします。", "シズカは\nブロックされている間、\nHPが徐々に回復します。", "ヨシノがいる間は、\n忍者、サムライ系の敵の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "エルドラ", "text": "――本場の初詣、ですわね！", "face": "u944"}, {"name": "ロゼット", "text": "初詣だけでなく、今年は\nヨシノさんの大名行列を見に来たんですよ？", "face": "u729"}, {"name": "アンジェリーネ", "text": "あぁ、もう。\nそんな口いっぱいに頬張って。\n親善大使でもあるということ、忘れてはいけませんよ？", "face": "u430"}, {"name": "エルドラ", "text": "へふわ？　もぐもぐ……。", "face": "u944"}, {"name": "シビラ", "text": "それにしても、遅いと思わない？\n大名行列が来る前に凍えちゃいそうよ。", "face": "u39"}, {"name": "テミス", "text": "そうですわね……。この雪道で、\n行列が遅くなっているのかもしれませんわ。", "face": "u38"}, {"name": "アンジェリーネ", "text": "これだけ寒いと、\n私たちも凍えてしまいますわね……。", "face": "u430"}, {"name": "ロゼット", "text": "あっ、それなら少し運動しませんか？\nお正月でちょっと食べ過ぎちゃいましたし……。", "face": "u729"}, {"name": "シビラ", "text": "……また模擬戦？\nでも、少しならいいかな。", "face": "u39"}, {"name": "アンジェリーネ", "text": "プリンセスばかりなら、\n模擬戦というより演武かしら？\nけれど名案ね、こんなに寒いんだもの。", "face": "u430"}, {"name": "エルドラ", "text": "ふっふっふ、模擬戦なら負けませんわ！\nプリンセスは戦えてこそ。\n竜人の姫の実力みせてあげますわよ！", "face": "u944"}, {"name": "ヨシノ", "text": "――あっれぇ、大名行列って言ったのに、\n何だか勝手にお祭りはじめてない？", "face": "u1104a1"}, {"name": "ヨシノ", "text": "はぁ、仕方ないなぁ。\nよし皆、あの子たちも交えて演武と行こう！", "face": "u1104a1"}, {"name": "ヨシノ", "text": "遠慮することはない。\nプリンセスっていうのは\nその国でも一二を争うくらい強いんだからな！", "face": "u1104a1"}]}, {"trigger": "end", "lines": [{"name": "エルドラ", "text": "ふぅ、身体が温まってきましたわ！\n……って、あら？　もうヨシノがいますわ？", "face": "u944"}, {"name": "ヨシノ", "text": "やれやれ、模擬戦に夢中で大名行列見てなかったな？", "face": "u1104a1"}, {"name": "ロゼット", "text": "わわわ……す、すみません……。\nつい楽しくなってしまって……。", "face": "u729"}, {"name": "ヨシノ", "text": "ははっ、まぁいいさ。\nそれじゃあ約束の初詣に行こうか。\nプリンセス同士で出かけるのも悪くないでしょ？", "face": "u1104a1"}, {"name": "アンジェリーネ", "text": "えぇ、昔では考えられないことでしたしね。\n……今でも、真に味方とは思っていないけれど。", "face": "u430"}, {"name": "ヨシノ", "text": "ふふ、それはお互い様だ。\nでもこうして手をとりあえた。\nしばらくは、戦争になることはないと思うよ。", "face": "u1104a1"}, {"name": "シビラ", "text": "……王子のおかげ、かしらね。", "face": "u39"}, {"name": "エルドラ", "text": "ですです、ですわ♪\nそれじゃあさっそく、初詣に出発ですわよー♪", "face": "u944"}]}], "story_talk": true, "active": true}