_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2113232, "race_id": 3, "change_to": 8, "change_condition": 1, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 30858, "global_id": 4477, "ranged": true, "variants": [{"hp": 7000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true}], "spawn_sec": 67}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 2100, "attack": 800, "base_hp": 3000, "base_attack": 800, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 200, "attack_speed": 50, "attack_wait": 50, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113552, "race_id": 3, "missile_id": 254, "missile": {"speed": 4.0, "splash": 93}, "master_id": 30867, "global_id": 4486, "ranged": true, "spawn_sec": 92}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "tags": ["ステルス"], "hp": 10500, "attack": 700, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2113216, "race_id": 3, "change_to": 11, "change_condition": 1, "master_id": 30857, "global_id": 4476, "variants": [{"hp": 10500, "attack": 700, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230}], "spawn_sec": 101}], "dialogue": [{"trigger": "start", "lines": [{"name": "レオナ", "text": "――各員、急ぎ状況を報告しろ！", "face": "u311"}, {"name": "ディルク", "text": "左舷に被弾を確認！\n急ぎ修復にあたっています！", "face": "u287"}, {"name": "ルーテ", "text": "対空砲台の被害が甚大です！\nこれ以上の使用は困難、\n敵飛行型魔物を迎撃しきれません！", "face": "u529"}, {"name": "レオナ", "text": "希少鉱石による、最高の硬度を誇る\n特製の砲台だったのだがな。まさか\n魔神直々に破壊に来ようとは……万事休すか。", "face": "u311"}, {"name": "ルーテ", "text": "レオナ様……\n……っ！？　\n……れ、レオナ様！　あ、あちらを！！", "face": "u529"}, {"name": "レオナ", "text": "あの飛空船は、もしや……！", "face": "u311"}, {"name": "アンナ", "text": "――遅くなってすみません！\n皆さんご無事でしょうか！", "face": "lcf7077a7cfba"}, {"name": "ルーテ", "text": "王国の皆さん……良かった、\n来てくださったのですね。", "face": "u529"}, {"name": "ケイティ", "text": "帝国に敵の調査を依頼したのは我々です、\n見過ごす事なんて出来ませんよ。\nご協力感謝致します。", "face": "u114"}, {"name": "レオナ", "text": "礼など後で良い。まずは目先の魔神を\nなんとかするのが先決だ。\n船が堕ちれば、乗っている者全員道連れだぞ。", "face": "u311"}, {"name": "アンナ", "text": "はい！　レオナさん達は、どうか\n後方にて怪我の治療をなさってください。\n魔神は我々で対処致します！"}, {"name": "ルーテ", "text": "判りました……どうやら魔神は\n羽を休め力を温存しているようです。\nどうかくれぐれもお気を付け下さい。", "face": "u529"}, {"name": "レオナ", "text": "魔神の力を与えられた魔物に注意を怠るな。\n透明化した敵は遠距離からの狙いがつけられんが、\n交戦している時にはその力を使えんようだ。", "face": "u311"}, {"name": "レオナ", "text": "近接兵との戦闘中であれば、\n遠距離攻撃による狙いもつけられる筈だ！", "face": "u311"}, {"name": "アンナ", "text": "ご忠告ありがとうございます。\n王子、戦闘の指示をお願いします！", "face": "lcf7077a7cfba"}]}, {"trigger": "route", "lines": [{"name": "レオナ", "text": "翼を広げたか……どうやら魔神が\n本気になったようだな！", "face": "u311"}, {"name": "ルーテ", "text": "魔神が放つ爆炎は、周囲にいる味方全てを\nめがけて放たれるようです。兵を固めて配置する程、\nその爆炎の被害は大きくなってしまうかと。", "face": "u529"}, {"name": "ルーテ", "text": "皆さん、どうかお気をつけて！", "face": "u529"}]}], "active": true}