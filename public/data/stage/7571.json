{"quest_id": 7571, "name": "帝国の守護者", "description": "次の開催地、帝国に到着した王子たち。\nマルゴット、ディアナ、ヘカティエが\n率いる帝国の精鋭を相手に力を示せ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "人気闘兵凱旋パレード", "event_category": "History", "mission_id": 920174, "map_no": 4494, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 220, "gold": 750, "drops": [{"card": 1454, "c": 1}, {"card": 50, "c": 1}, {"card": 56, "c": 1}, {"item": 23000}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 38, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_speed": 1, "attack_wait": 17, "attack_interval": 72, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2135520, "race_id": 12, "master_id": 34715, "global_id": 8332, "spawn_sec": 5}, {"enemy_id": 3, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["アーマー", "帝国"], "hp": 3500, "attack": 250, "base_hp": 3500, "base_attack": 250, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 321, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113104, "race_id": 16, "change_to": 3, "change_condition": 1, "missile_id": 244, "missile": {"speed": 4.0, "splash": 53}, "master_id": 30775, "global_id": 4394, "ranged": true, "variants": [{"tags"