n_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135536, "special_effect_id": 275, "change_to": 14, "master_id": 34769, "global_id": 8386, "from_condition": 0, "to_condition": 0, "to_global_id": 8337}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 7, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 6000, "base_hp": 6000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 152, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135536, "special_effect_id": 978, "change_to": 15, "master_id": 34720, "global_id": 8337, "from_condition": 0, "to_condition": 0, "to_global_id": 8387}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 8, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 6000, "base_hp": 6000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 152, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135536, "special_effect_id": 275, "change_to": 16, "master_id": 34770, "global_id": 8387, "from_condition": 0, "to_condition": 0, "to_global_id": 8338}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 9, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 6000, "base_hp": 6000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 152, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135536, "special_effect_id": 979, "change_to": 17, "master_id": 34721, "global_id": 8338, "from_condition": 0, "to_condition": 0, "to_global_id": 8388}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 6000, "base_hp": 6000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 152, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135536, "special_effect_id": 275, "change_to": 18, "master_id": 34771, "global_id": 8388, "from_condition": 0, "to_condition": 0, "to_global_id": 8339}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 6000, "base_hp": 6000, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 152, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135536, "special_effect_id": 980, "change_to": 19, "master_id": 34722, "global_id": 8339, "from_condition": 0}, {"enemy_id": 28, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "tags": ["帝国", "女性"], "hp": 2000, "attack": 500, "base_hp": 2000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_speed": 80, "attack_wait": 40, "attack_interval": 191, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102512, "race_id": 16, "master_id": 336, "global_id": 335, "spawn_sec": 149}], "popups": ["ヘカティエは\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ"], "dialogue": [{"trigger": "start", "lines": [{"name": "マルゴット", "text": "――あの、ディアナ様、\n冥界軍との戦いも続いている中で、\nパレードに協賛している余裕などあるのでしょうか……？", "face": "u1343a1"}, {"name": "ディアナ", "text": "……ありませんね。\n余裕はまったくありません。", "face": "u624"}, {"name": "マルゴット", "text": "でしたら何故――", "face": "u1343a1"}, {"name": "ディアナ", "text": "ですが、冥界軍との決着が付くまで、\n魔王決戦被害地の戦災復興は待っていろ、\nなんてことは言えないでしょう？", "face": "u624"}, {"name": "マルゴット", "text": "……っ、それは、確かに。", "face": "u1343a1"}, {"name": "ディアナ", "text": "悪意ある者は、そんなことをする余裕があるなら\nこっちを片付けてからにしろ、\nなんて耳当たりの良い言葉を使うものですが――", "face": "u624"}, {"name": "ディアナ", "text": "国家というものは、可能な限り全ての事柄に、\n同時に当たらねばならないのです。\n――マルゴット、今後のために覚えておくように。", "face": "u624"}, {"name": "マルゴット", "text": "はっ、ディアナ様！", "face": "u1343a1"}, {"name": "ヘカティエ", "text": "……ずいぶん可愛がっているのね。\n後継者にでもするつもりなの？", "face": "u1226a1"}, {"name": "ディアナ", "text": "立ち聞きですか、亜神殿。\n……何にせよ、その言葉は否定しておきましょう。\n私はまだ、後継者を探す歳でもありませんから。", "face": "u624"}, {"name": "ヘカティエ", "text": "それにしては、まるで我が子に\n学のひとつでも\n仕込んでいるかのような物言いだったわよ？", "face": "u1226a1"}, {"name": "ディアナ", "text": "……あの子は、後継者ではなく、\n私の補佐官となってもらう予定なので。", "face": "u624"}, {"name": "ヘカティエ", "text": "……騎士団の？", "face": "u1226a1"}, {"name": "ディアナ", "text": "いえ、私が皇帝の座についた時の、ですよ。", "face": "u624"}, {"name": "ヘカティエ", "text": "…………。\nあなた、王子に影響されたんじゃない？", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "言葉の端々から、絶対にやり遂げられるって\n自信が溢れかえっているように見えるわ。", "face": "u1226a1"}, {"name": "ディアナ", "text": "ふふ、王国とは友好関係を維持したいですからね。\nもちろん、冥界とも\nいずれは友好関係を築きたいものですが。", "face": "u624"}, {"name": "ヘカティエ", "text": "勘弁してよ、この私に、\nハイドース様の後釜に座れって言いたいの？", "face": "u1226a1"}, {"name": "ディアナ", "text": "さて、どう受け取るかはお任せします。\nそれより、そろそろ模擬戦演武が始まりますよ。", "face": "u624"}, {"name": "市民", "text": "おぉ、見ろ！　ディアナ騎士団長に、\nマルゴット教導隊長だ！！\n亜神ヘカティエ様もいるぞ！！", "face": "l2acb13722dfc"}, {"name": "商人", "text": "なんとお美しい……。\n帝国の平和を守る、美しき女神たちだ……！", "face": "l2acb13722dfc"}, {"name": "ヘカティエ", "text": "……私まで帝国の守護神扱いされていない？", "face": "u1226a1"}, {"name": "マルゴット", "text": "ふふ、諦めてください。\n帝国市民からすれば、冥界との戦いに駆けつけてくれた\n美しき女神さまそのものなんですから。", "face": "u1343a1"}, {"name": "ヘカティエ", "text": "まぁいいわ。\n神に夢を抱くのは、人類の権利のひとつだものね。\n――では、少しだけ踊ってあげましょうか。", "face": "u1226a1"}]}, {"trigger": "end", "lines": [{"name": "アクラ", "text": "――いやぁ、見事見事。\nこれが白の帝国の女傑たちの武技。\nいやはや、おみそれしました。", "face": "u1454a1"}, {"name": "マルゴット", "text": "護衛役のアクラさんですね。\n竜人の隠れ里までの案内、よろしくお願いします。", "face": "u1343a1"}, {"name": "マルゴット", "text": "まぁ、軍に護衛をつけるというのも、\nなんともおかしな話ではあるのですが……。", "face": "u1343a1"}, {"name": "ディアナ", "text": "形式というのは大切なのですよ、マルゴット。\n実際の戦力の如何は関係ないのです。", "face": "u624"}, {"name": "ヘカティエ", "text": "ホストたる王国が要請し、東の国が護衛につく。\n王国と東の国という歴史深い二国の仲に、\n白の帝国を受け入れるという対外的なアピールかしら？", "face": "u1226a1"}, {"name": "ディアナ", "text": "えぇ、人気闘兵は王国主催の祝祭ですからね。\n白の帝国を大々的に巻き込むことで、\n王子殿下なりに帝国を助けようとしているのでしょう。", "face": "u624"}, {"name": "マルゴット", "text": "なるほど……。\n……まだまだ、学ぶことばかりですね。", "face": "u1343a1"}, {"name": "ディアナ", "text": "えぇ、これからも励みなさい。\nあなたにはとても大きな期待をしているのですから。", "face": "u624"}, {"name": "マルゴット", "text": "ひぃ……頑張ります……。", "face": "u1343a1"}, {"name": "ヘカティエ", "text": "ほら、胸を張りなさい。\nそんなうなだれたまま、\n帝都の門を出ていくつもりかしら？", "face": "u1226a1"}, {"name": "マルゴット", "text": "は、はい……。\nあっ、あの子こっちに手を振っていますよ。", "face": "u1343a1"}, {"name": "ディアナ", "text": "あなたに手を振っているんですよ。\n手を振り返すのも、仕事のうちですからね？", "face": "u624"}, {"name": "マルゴット", "text": "これも仕事……はいっ！\nみなさーん、行ってきますねー！", "face": "u1343a1"}, {"name": "ディアナ", "text": "……ふふ、まぁ、これはこれで。", "face": "u624"}]}], "map": {"image": "Map920174_4494", "w": 960, "h": 640, "spots": [{"k": "b", "x": 873, "y": 509}, {"k": "m", "x": 772, "y": 448, "id": 200}, {"k": "m", "x": 704, "y": 409, "id": 201}, {"k": "m", "x": 637, "y": 367, "id": 202}, {"k": "m", "x": 570, "y": 329, "id": 203}, {"k": "m", "x": 497, "y": 284, "id": 204}, {"k": "m", "x": 431, "y": 242, "id": 205}, {"k": "m", "x": 363, "y": 203, "id": 206}, {"k": "m", "x": 291, "y": 161, "id": 207}, {"k": "m", "x": 695, "y": 499, "id": 208}, {"k": "m", "x": 784, "y": 362, "id": 209}, {"k": "m", "x": 629, "y": 458, "id": 210}, {"k": "m", "x": 710, "y": 321, "id": 211}, {"k": "m", "x": 562, "y": 416, "id": 212}, {"k": "m", "x": 491, "y": 374, "id": 213}, {"k": "m", "x": 639, "y": 279, "id": 214}, {"k": "m", "x": 575, "y": 239, "id": 215}, {"k": "m", "x": 423, "y": 335, "id": 216}, {"k": "m", "x": 509, "y": 198, "id": 217}, {"k": "m", "x": 353, "y": 290, "id": 218}, {"k": "m", "x": 438, "y": 155, "id": 219}, {"k": "m", "x": 372, "y": 115, "id": 220}, {"k": "m", "x": 287, "y": 250, "id": 221}, {"k": "m", "x": 218, "y": 205, "id": 222}, {"k": "m", "x": 852, "y": 404, "id": 223}, {"k": "m", "x": 345, "y": 383, "id": 224}, {"k": "m", "x": 274, "y": 430, "id": 225}, {"k": "m", "x": 582, "y": 151, "id": 226}, {"k": "m", "x": 662, "y": 106, "id": 227}, {"k": "r", "x": 304, "y": 329, "id": 300}, {"k": "r", "x": 210, "y": 382, "id": 301}, {"k": "r", "x": 649, "y": 193, "id": 302}, {"k": "r", "x": 716, "y": 232, "id": 303}, {"k": "r", "x": 819, "y": 291, "id": 304}, {"k": "r", "x": 892, "y": 334, "id": 305}, {"k": "r", "x": 409, "y": 421, "id": 306}, {"k": "r", "x": 551, "y": 508, "id": 307}, {"k": "r", "x": 200, "y": 272, "id": 308}, {"k": "r", "x": 509, "y": 105, "id": 309}]}, "start_cost": 10, "active": true, "name_en": "Guardians of the Empire", "description_en": "The Princes have arrived at the next venue, the Empire. Show your strength against the Empire's elite, led by Margot, Diana, and Hecatie! Intermediate (★1 target: Avg Lv1, 8 units)"}