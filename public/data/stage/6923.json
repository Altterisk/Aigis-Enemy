ck": 1000, "damage_type": "physical", "armor_defense": 280, "magic_defense": 50, "attack_speed": 70, "attack_wait": 90, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 10, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 32121, "global_id": 5740, "to_global_id": 5741}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 17000, "attack": 1000, "base_hp": 17000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 280, "magic_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 90, "attack_interval": 281, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2103312, "race_id": 4, "special_effect_id": 222, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 32122, "global_id": 5741, "ranged": true}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "special_effect_id": 222, "change_to": 12, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 32127, "global_id": 5746, "to_global_id": 5747, "spawn_sec": 119}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 6000, "attack": 360, "base_hp": 6000, "base_attack": 360, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "attack_wait": 30, "attack_interval": 110, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "special_effect_id": 415, "change_to": 13, "master_id": 32128, "global_id": 5747, "to_global_id": 5748}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 6000, "attack": 360, "base_hp": 6000, "base_attack": 360, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 14, "master_id": 32129, "global_id": 5748, "to_global_id": 5749}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["ステルス"], "hp": 6000, "attack": 360, "base_hp": 6000, "base_attack": 360, "damage_type": "physical", "armor_defense": 200, "attack_range": 160, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109632, "race_id": 4, "special_effect_id": 222, "change_to": 15, "change_condition": 1, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 32130, "global_id": 5749, "ranged": true, "variants": [{"hp": 6000, "attack": 360, "base_hp": 6000, "base_attack": 360, "damage_type": "physical", "armor_defense": 200, "attack_range": 160, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109584, "race_id": 4, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 32131, "global_id": 5750, "ranged": true}]}], "dialogue": [{"trigger": "start", "lines": [{"name": "スズネ", "text": "はぁ……はぁ……。\nどうにか先回りできましたぽん……！", "face": "u936"}, {"name": "妖狸", "text": "スズネさまー！\n王国軍がこっちに来てるって本当ぽん！？", "face": "l29774d5d3d78"}, {"name": "スズネ", "text": "間違いないですぽん！\nあたし様がこの目で見てきましたぽん！！", "face": "u936"}, {"name": "妖狸", "text": "たぬぬぬぬ……！？\nどうするぽん？　あの人は何て言ってたぽん？", "face": "l29774d5d3d78"}, {"name": "スズネ", "text": "王子達をこの場で迎え撃てと……言ってたぽん……。\nでも、あたし様は、\nボクさまちゃんと戦いたくないぽん……うぅぅ……。", "face": "u936"}, {"name": "妖狸", "text": "たぬぬ……スズネさま、あっちの里の長さまと、\n大の仲良しだったぽんね……。\nどうしてこんなことになったぽん……。", "face": "l29774d5d3d78"}, {"name": "スズネ", "text": "いいえ……でも、あの人がいなかったら、\nこの里は魔王の放った瘴気で\nきっと全滅しちゃってたはずですぽん……。", "face": "u936"}, {"name": "スズネ", "text": "この里は、先祖代々仁義を重んじる里ですぽん！\nあたし様の好き嫌いよりも、\n受けた御恩を返す方が大事ですぽん……！", "face": "u936"}, {"name": "妖狸", "text": "たぬぅぅ～！！\nスズネさま、かっこいいぽん……！！", "face": "l29774d5d3d78"}, {"name": "スズネ", "text": "ふふふっ、そこでさっき見かけた\nこわいけどカッコイイ女の子に変身して……。\nごにょごにょ……こそこそ……。", "face": "u936"}, {"name": "妖狸", "text": "なるほどぽん……ごにょごにょ……。", "face": "l29774d5d3d78"}]}, {"trigger": "start", "lines": [{"name": "たぬきの里の長", "text": "――王子さま、そろそろスズネちゃんの里だぽん！\n何が出てくるか分からないのが妖狸の里。\n十分に注意しておくぽん！", "face": "u1019a1"}]}, {"trigger": "end", "lines": [{"name": "サギリ", "text": "な、なんであたしに変身してるんだよ！\n妖狸どもぉーっ！！", "face": "u869"}, {"name": "スズネ", "text": "か、かっこ良かったからですぽんー！！\nそんなことより、ボクさまちゃん！\nこんな多勢に無勢で卑怯ですぽんー！！", "face": "u936"}, {"name": "たぬきの里の長", "text": "たぬぬぬっ！？\nスズネちゃんだってボクさまの里から、\n木の葉を根こそぎ奪っていったぽん！！", "face": "u1019a1"}, {"name": "スズネ", "text": "だ、だってそれは……！\nぽぽぽん……やむにやまれぬ事情があるんですぽん！", "face": "u936"}, {"name": "サギリ", "text": "……話してみろよ。\nもしかしたら、あたし達が力になれるかもしれねぇ。", "face": "u869"}, {"name": "スズネ", "text": "ぽぽぽん……っ！？\nだ、だめですぽん……秘密を話すのは、\n信義にもとる行いですぽん……！", "face": "u936"}, {"name": "たぬきの里の長", "text": "頭が硬いのは昔から……だぽん。\nそれじゃあ分かるまで、\nあやかし狸大合戦を続けるしかないぽん！", "face": "u1019a1"}, {"name": "スズネ", "text": "望むところですぽんー！！", "face": "u936"}]}], "active": true}