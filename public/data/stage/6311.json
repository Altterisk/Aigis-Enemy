0, "attack": 900, "base_hp": 15000, "base_attack": 900, "damage_type": "physical", "armor_defense": 200, "magic_defense": 40, "attack_speed": 50, "attack_wait": 10, "attack_interval": 151, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105552, "race_id": 6, "special_effect_id": 86, "master_id": 30766, "global_id": 4385}]}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 10, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 180}]}, "spawn_sec": 134}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 150}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}], "popups": ["ケラウノスは拠点には\n向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ネフティ", "text": "待ってください皆さん！　本当に大丈夫ですか？\nこんな悪そうな人に聖槍グングニルを任せて。\n聖槍の守護者としては、正直かなり不安です。", "face": "u551"}, {"name": "デシウス", "text": "見た目で人を判断するな、女よ。\nこの我輩が聖槍の使い手となった以上、\n我が宿敵ケラウノスを討ち滅ぼすのは時間の問題だ。", "face": "l07c2a5a929a8"}, {"name": "ケラウノス", "text": "――残念ながら、それは不可能です。", "face": "ld3e1ccb68393"}, {"name": "アンナ", "text": "ケラウノス様！？　\nい、いつの間に……。", "face": "l27c32c63c21e"}, {"name": "ケラウノス", "text": "本当におめでたい方々ですね。\n聖槍グングニルのもとに辿り着いたくらいで、\n私を滅ぼせると思いましたか？", "face": "ld3e1ccb68393"}, {"name": "デシウス", "text": "つ、強がりもそこまでだ！\n聖槍が本物だということは貴様自身がいま証明した！\nあとは我輩の力を聖槍に注ぎ込めば…………ッ！！", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "…………ぬうっ……な、なぜだ……？\nなぜ……神殺しの力が発動しないッ！？", "face": "l07c2a5a929a8"}, {"name": "ケラウノス", "text": "ふふ……聞いたことがありませんか？\n依り代となる人間を用意することができれば、\n神をこの地上に降臨させることも可能、という話を。", "face": "ld3e1ccb68393"}, {"name": "アンナ", "text": "――――ッ！？\nでは、いまのケラウノス様は……。", "face": "l27c32c63c21e"}, {"name": "ケラウノス", "text": "そう。いまの私は人間の少女の肉体を依り代として\n降臨した存在。つまり神そのものではないのです。\nよって、神殺しの力の対象とはなりません。", "face": "ld3e1ccb68393"}, {"name": "ケラウノス", "text": "この肉体から私の神としての本質を\n分離させでもしない限りはね……。\nですが、物質界の存在である貴方たちにそれは不可能。", "face": "ld3e1ccb68393"}, {"name": "ネフティ", "text": "そんな……それでは\n聖槍グングニルの力をもってしても――", "face": "u551"}, {"name": "デシウス", "text": "――ケラウノスは倒せない……というのか？\nち……ちっくしょおぉおおおッッ！！！\n我輩は……我輩は一体、なんのために……ッ！！", "face": "l07c2a5a929a8"}, {"name": "アイギス", "text": "――諦めてはなりません、人の子よ。", "face": "l3c4017ec21c4"}, {"name": "アンナ", "text": "あ、アイギス様――！？\nですが、私たちにはもう、どうすることも……。", "face": "l27c32c63c21e"}, {"name": "アイギス", "text": "同じ神の座にある私なら、姉様の精神体を\n依り代の肉体から分離させられるかもしれません。\nかつて姉様がアダマスの肉体と精神体を分離したように。", "face": "l3c4017ec21c4"}, {"name": "アイギス", "text": "……ですが、私に残された僅かな力で\nそれを実行するには、相応の時間が必要です。\n人の子よ、そのための時間を作って頂けますか？", "face": "l3c4017ec21c4"}, {"name": "ケラウノス", "text": "ふん。死に損ないのアイギスに\nなにができるとも思えませんが……いいでしょう。\nその僅かな希望を、目の前で踏みにじってあげます。", "face": "ld3e1ccb68393"}]}, {"trigger": "end", "lines": [{"name": "アイギス", "text": "人の子よ、準備が整いました。\nこれより我が姉、女神ケラウノスの精神体を\n少女の肉体から分離させることを試みます。", "face": "l3c4017ec21c4"}, {"name": "ケラウノス", "text": "――うっ！？\nぐ、うぁあッ……おのれ、アイギス……ッ！！", "face": "ld3e1ccb68393"}, {"name": "デシウス", "text": "や…………やったか！？", "face": "l07c2a5a929a8"}, {"name": "ケラウノス", "text": "ふ……ふふ……ははは……あはははははははッ！！", "face": "ld3e1ccb68393"}, {"name": "アイギス", "text": "くっ……あと一歩、姉様には届きませんでしたか……。", "face": "l3c4017ec21c4"}, {"name": "ケラウノス", "text": "ふふ。残念でしたね、アイギス。\n長きに渡り人間たちを守護するために浪費し、\n減衰しきった貴方一人の力など、所詮はこんなもの。", "face": "ld3e1ccb68393"}, {"name": "アダマス", "text": "――でしたら、二人ではどうですか？", "face": "l18f52070136f"}, {"name": "ケラウノス", "text": "その声は――アダマス！？\nば、馬鹿な……どうして貴方がここに？", "face": "ld3e1ccb68393"}, {"name": "皇帝", "text": "はぁっ、はぁっ……まったく。\n王国の政務官は……人使いが荒い……ッ。", "face": "u418"}, {"name": "アンナ", "text": "あ、貴方は……白の皇帝！？\n確かに白の帝国にも協力を要請はしましたが、\nまさか……皇帝がお一人でいらっしゃるなんて。", "face": "l27c32c63c21e"}, {"name": "皇帝", "text": "一刻を争う事態だと……アダマスが言うんでな。\n集団でなだれ込むより……俺一人のほうが、速い……。", "face": "u418"}, {"name": "皇帝", "text": "……だが、さすがに疲れた……。\n王子……俺は後方で休ませてもらう、ぞ……。", "face": "u418"}, {"name": "アリサ", "text": "あぁっ！　体中ひどいお怪我です！\nいますぐ治療して差し上げないと……。", "face": "u24"}, {"name": "アダマス", "text": "アイギス姉様、事情は把握しています！\nいまこそ、私たち二柱の女神の力をひとつに！", "face": "l18f52070136f"}, {"name": "アイギス", "text": "ええ、そうしましょう。\n一人一人の力は小さくても、それを重ね合わせれば\nどんなものにも負けない大きな力となる……。", "face": "l3c4017ec21c4"}, {"name": "アイギス", "text": "それは、人の子らが教えてくれたこと。\nケラウノス姉様。貴方が愚かだと侮った、\nその人間たちの手によって敗れるのです。", "face": "l3c4017ec21c4"}, {"name": "ケラウノス", "text": "や……やめなさい！　アイギス……アダマスッ！\n自分がなにをしているか、判っているのですかッ！？\n……ぐ、ウッ……うアアアァアアァアァッッッ！！！！", "face": "ld3e1ccb68393"}]}], "active": true}