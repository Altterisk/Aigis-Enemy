{"quest_id": 6311, "name": "降臨せし女神", "description": "グングニルへと辿り着いた王子たちの前に\n女神ケラウノスが姿を現す。宿敵を前に、\n聖槍を発動せんとするデシウスだが……。\n上級（★１獲得の目安：平均Lv10）", "event": "神殺しの聖槍", "event_category": "History", "mission_id": 920185, "map_no": 5112, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 1000, "base_hp": 60000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 80, "attack_range": 220, "attack_speed": 20, "attack_wait": 110, "attack_interval": 281, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2108320, "special_effect_id": 111, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30019, "global_id": 3638, "ranged": true, "route_behaviour": {"transforms": [{"wait": 1300}]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 3, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 10, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "ba