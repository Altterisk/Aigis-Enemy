6.0, "splash": 133}, "master_id": 31296, "global_id": 4915, "ranged": true, "spawn_sec": 154}], "popups": ["カボチャの馬車がいる間\n全ての敵のHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "カボチャの魔物", "text": "ふふふ、まだ追ってくるカボ。\n予定通りカボ！", "face": "l175ba8fc5516"}, {"name": "ヒューナ", "text": "ふぅ、やっと追いついたわ。\nいったいどこまで逃げるつもり？\nそろそろキャンディちゃんを返しなさい！", "face": "u627"}, {"name": "カボチャの魔物", "text": "うるさいカボ！　黙れカボ！\nまんまとおびき出されたとも知らずにカボ……！！", "face": "l175ba8fc5516"}, {"name": "ヴィンセント", "text": "おびき出された、だと……？\n何か秘策があるということか。", "face": "u103"}, {"name": "カボチャの魔物", "text": "いでよ！　新兵器カボチャの馬車！！", "face": "l175ba8fc5516"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "カボチャの魔物", "text": "馬車！　カボチャの馬車！\nは、早く来るカボ！　カボチャの馬車ー！！", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "……来ませんね、カボチャの馬車。", "face": "u691"}, {"name": "カボチャの魔物", "text": "えぇい、こうなったら新兵器が救援に来るまで、\n時間を稼ぐカボよ！", "face": "l175ba8fc5516"}, {"name": "アンナ", "text": "どうやら仕掛けて来るようですね。\n王子、迎撃の準備をお願いします！", "face": "l38bce76ccd97"}]}, {"trigger": "battle", "at_sec": 71, "lines": [{"name": "カボチャの魔物", "text": "来た、やっと来たカボ！\nこれこそボクらのカボチャの馬車カボ！！", "face": "l175ba8fc5516"}, {"name": "ヒューナ", "text": "あれはいったい……？\nやけに可愛い見た目の馬車だけど……。", "face": "u627"}, {"name": "キャンディ", "text": "ふふふ、カボチャの馬車ですよ！\n魔法のお菓子で、カボチャさん達の傷を\n癒やすことができちゃうんです！", "face": "u691"}, {"name": "カボチャの魔物", "text": "さらに強力なカボチャ爆弾も積んでいるカボ。\n当たれば周囲一帯どかーんカボ！", "face": "l175ba8fc5516"}, {"name": "カボチャの魔物", "text": "でも進路妨害されると、\nお菓子をばらまくのを忘れて爆弾ばかり投げちゃう、\nちょっぴり過激なカボチャ紳士カボ。", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "……えっ？　ばくだん？\nどうして爆弾なんて積んで……。", "face": "u691"}, {"name": "カボチャの魔物", "text": "何を考え込んでるカボ！\nキャンディちゃんもそろそろ前線に出るカボ！！", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "……えぇと、は、はい。\nわかりました……。", "face": "u691"}, {"name": "ヒューナ", "text": "王子、愉快な見た目に騙されないようにね。\nさっさと倒してキャンディちゃんを助けるわよ！", "face": "u627"}]}, {"trigger": "end", "lines": [{"name": "キャンディ", "text": "――カボチャさん！　私聞いてません！\nどうしてあんな危険な爆弾を積んでいるんですか！", "face": "u691"}, {"name": "カボチャの魔物", "text": "カボ？　王子達に容赦する必要ないカボ。\nヤツラはカボチャ畑を荒らした極悪人カボ！", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "で、でも、だからって……。\nあんなの当たったら怪我しちゃいます！\nイタズラで仕返しするだけって言ったじゃないですか！", "face": "u691"}, {"name": "カボチャの魔物", "text": "うるさい小娘カボ……。\nそろそろ始末するカボか……。", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "……えっ？\nきゃっ、いやっ！　離してください！！", "face": "u691"}, {"name": "カボチャの魔物", "text": "離すわけないカボ。\nお前も生贄にしてやるカボ！\nカボチャの馬車、全速前進カボー！", "face": "l175ba8fc5516"}, {"name": "ヴィンセント", "text": "くっ、この細い路地をあんな速度で……ッ！\n王子、急いで追うぞ。\n連中、あの娘を生贄にすると言っていた。", "face": "u103"}, {"name": "アンナ", "text": "絶対に見過ごすわけにはいきません。\n王子、急ぎましょう！", "face": "l38bce76ccd97"}]}], "map": {"image": "Map920116_3286", "w": 960, "h": 640, "spots": [{"k": "b", "x": 948, "y": 381}, {"k": "m", "x": 873, "y": 348, "id": 200}, {"k": "m", "x": 785, "y": 398, "id": 201}, {"k": "m", "x": 685, "y": 449, "id": 202}, {"k": "m", "x": 600, "y": 407, "id": 203}, {"k": "m", "x": 788, "y": 301, "id": 204}, {"k": "m", "x": 319, "y": 455, "id": 205}, {"k": "m", "x": 416, "y": 408, "id": 206}, {"k": "m", "x": 157, "y": 363, "id": 207}, {"k": "m", "x": 325, "y": 270, "id": 208}, {"k": "m", "x": 237, "y": 414, "id": 209}, {"k": "m", "x": 511, "y": 360, "id": 210}, {"k": "m", "x": 231, "y": 214, "id": 211}, {"k": "m", "x": 782, "y": 212, "id": 212}, {"k": "m", "x": 705, "y": 257, "id": 213}, {"k": "m", "x": 244, "y": 316, "id": 214}, {"k": "m", "x": 424, "y": 314, "id": 215}, {"k": "m", "x": 615, "y": 306, "id": 216}, {"k": "m", "x": 612, "y": 213, "id": 217}, {"k": "m", "x": 409, "y": 217, "id": 218}, {"k": "m", "x": 510, "y": 267, "id": 219}, {"k": "m", "x": 324, "y": 169, "id": 220}, {"k": "m", "x": 701, "y": 170, "id": 221}, {"k": "r", "x": 744, "y": 96, "id": 300}, {"k": "r", "x": 686, "y": 345, "id": 301}, {"k": "r", "x": 557, "y": 471, "id": 302}, {"k": "r", "x": 442, "y": 470, "id": 303}, {"k": "r", "x": 143, "y": 458, "id": 304}, {"k": "r", "x": 231, "y": 95, "id": 305}, {"k": "r", "x": 101, "y": 270, "id": 306}]}, "active": true}