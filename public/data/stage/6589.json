, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 160, "attack_speed": 70, "attack_wait": 35, "attack_interval": 136, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116096, "missile_id": 306, "missile": {"speed": 4.0, "splash": 107}, "master_id": 31301, "global_id": 4920, "ranged": true}], "spawn_sec": 66}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 110}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 400, "global_id": 399, "ranged": true, "spawn_sec": 152}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 5600, "attack": 320, "base_hp": 5600, "base_attack": 320, "damage_type": "magical", "armor_defense": 10, "magic_defense": 25, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116048, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31296, "global_id": 4915, "ranged": true, "spawn_sec": 154}], "popups": ["カボチャの馬車がいる間\n全ての敵のHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "カボチャの魔物", "text": "ふふふ、まだ追ってくるカボ。\n予定通りカボ！", "face": "l175ba8fc5516"}, {"name": "ヒューナ", "text": "ふぅ、やっと追いついたわ。\nいったいどこまで逃げるつもり？\nそろそろキャンディちゃんを返しなさい！", "face": "u627"}, {"name": "カボチャの魔物", "text": "うるさいカボ！　黙れカボ！\nまんまとおびき出されたとも知らずにカボ……！！", "face": "l175ba8fc5516"}, {"name": "ヴィンセント", "text": "おびき出された、だと……？\n何か秘策があるということか。", "face": "u103"}, {"name": "カボチャの魔物", "text": "いでよ！　新兵器カボチャの馬車！！", "face": "l175ba8fc5516"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "カボチャの魔物", "text": "馬車！　カボチャの馬車！\nは、早く来るカボ！　カボチャの馬車ー！！", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "……来ませんね、カボチャの馬車。", "face": "u691"}, {"name": "カボチャの魔物", "text": "えぇい、こうなったら新兵器が救援に来るまで、\n時間を稼ぐカボよ！", "face": "l175ba8fc5516"}, {"name": "アンナ", "text": "どうやら仕掛けて来るようですね。\n王子、迎撃の準備をお願いします！", "face": "l0efbe2f641d8"}]}, {"trigger": "battle", "at_sec": 71, "lines": [{"name": "カボチャの魔物", "text": "来た、やっと来たカボ！\nこれこそボクらのカボチャの馬車カボ！！", "face": "l175ba8fc5516"}, {"name": "ヒューナ", "text": "あれはいったい……？\nやけに可愛い見た目の馬車だけど……。", "face": "u627"}, {"name": "キャンディ", "text": "ふふふ、カボチャの馬車ですよ！\n魔法のお菓子で、カボチャさん達の傷を\n癒やすことができちゃうんです！", "face": "u691"}, {"name": "カボチャの魔物", "text": "さらに強力なカボチャ爆弾も積んでいるカボ。\n当たれば周囲一帯どかーんカボ！", "face": "l175ba8fc5516"}, {"name": "カボチャの魔物", "text": "でも進路妨害されると、\nお菓子をばらまくのを忘れて爆弾ばかり投げちゃう、\nちょっぴり過激なカボチャ紳士カボ。", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "……えっ？　ばくだん？\nどうして爆弾なんて積んで……。", "face": "u691"}, {"name": "カボチャの魔物", "text": "何を考え込んでるカボ！\nキャンディちゃんもそろそろ前線に出るカボ！！", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "……えぇと、は、はい。\nわかりました……。", "face": "u691"}, {"name": "ヒューナ", "text": "王子、愉快な見た目に騙されないようにね。\nさっさと倒してキャンディちゃんを助けるわよ！", "face": "u627"}]}, {"trigger": "end", "lines": [{"name": "キャンディ", "text": "――カボチャさん！　私聞いてません！\nどうしてあんな危険な爆弾を積んでいるんですか！", "face": "u691"}, {"name": "カボチャの魔物", "text": "カボ？　王子達に容赦する必要ないカボ。\nヤツラはカボチャ畑を荒らした極悪人カボ！", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "で、でも、だからって……。\nあんなの当たったら怪我しちゃいます！\nイタズラで仕返しするだけって言ったじゃないですか！", "face": "u691"}, {"name": "カボチャの魔物", "text": "うるさい小娘カボ……。\nそろそろ始末するカボか……。", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "……えっ？\nきゃっ、いやっ！　離してください！！", "face": "u691"}, {"name": "カボチャの魔物", "text": "離すわけないカボ。\nお前も生贄にしてやるカボ！\nカボチャの馬車、全速前進カボー！", "face": "l175ba8fc5516"}, {"name": "ヴィンセント", "text": "くっ、この細い路地をあんな速度で……ッ！\n王子、急いで追うぞ。\n連中、あの娘を生贄にすると言っていた。", "face": "u103"}, {"name": "アンナ", "text": "絶対に見過ごすわけにはいきません。\n王子、急ぎましょう！", "face": "l0efbe2f641d8"}]}], "active": true}