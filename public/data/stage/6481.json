{"quest_id": 6481, "name": "牙獣の試練", "description": "所せましと洞窟を駆ける獣達。\n縦横無尽な獣の動きを見極め、\n「牙獣の試練」を乗り越えよ！\n上級（★１獲得の目安：平均Lv10）", "event": "凶鳥の射手", "event_category": "History", "mission_id": 920109, "map_no": 5341, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 2, "level": 80, "form_count": 1, "hp": 2400, "attack": 650, "base_hp": 2400, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "master_id": 24, "global_id": 23, "spawn_sec": 29}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31059, "global_id": 4678, "ranged": true, "spawn_sec": 42}, {"enemy_id": 4, "source": "local", "count": 20, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 45}, {"enemy_id": 5, "source": "local", "count": 16, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 55}, {"enemy_id": 6, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 15000, "attack": 550, "base_hp": 15000, "base_attack": 550, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 180, "attack_speed": 70, "attack_wait": 20, "attack_interval": 111, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100672, "race_id": 13, "change_to": 6, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 277, "global_id": 276, "ranged": true, "variants": [{"hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100688, "race_id": 13, "master_id": 278, "global_id": 277}], "spawn_sec": 142}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "随分と洞窟の奥深くまで来ましたね。\n次が第四の試練でしたか？", "face": "l616b59afdfd8"}, {"name": "ヒューナ", "text": "えぇ、そのとおりよ。\n第四の試練は「疾駆する爪牙の獣を狩れ」だと、\n『この子』は言っているけれど……。", "face": "u627"}, {"name": "シャロン", "text": "獣を、狩れ……ですか？\nでもこの辺り、静かで何もいないような……。", "face": "u283"}, {"name": "ラテリア", "text": "――おっと、皆止まって。\nどうやらクロスボウ君の言うことは本当みたいだ。\nこの道の奥に、獣の群れが潜んでいるよ。", "face": "u532"}, {"name": "ヒューナ", "text": "獣の気配って……そんなことが分かるの！？", "face": "u627"}, {"name": "ラテリア", "text": "誰にでも得意分野があるものだよ。\nヒューナたちがアンデッドに詳しいようにね。", "face": "u532"}, {"name": "ラテリア", "text": "つまりは助け合いってやつさ。\n仲間っていうのはそういうものでしょ？", "face": "u532"}, {"name": "ヒューナ", "text": "……そういうものなのかしら。", "face": "u627"}, {"name": "ラテリア", "text": "そういうものなんだよ。\nさぁて、獣狩りの時間だ。", "face": "u532"}, {"name": "ラテリア", "text": "ここは道が入り組んでるから、\n獣はそれを利用してくるかもしれない。\n連中の素早さに惑わされないようにね。", "face": "u532"}, {"name": "アンナ", "text": "分かりました、ラテリアさん。\n王子、十分に注意して獣の進路を見極めましょう！", "face": "l616b59afdfd8"}]}, {"trigger": "end", "lines": [{"name": "ラテリア", "text": "助かったよヒューナ、まさか獣の群れに、\nアンデッドが混じってくるなんて予想してなかった。", "face": "u532"}, {"name": "ヒューナ", "text": "いいえ、私も助けられたわ。\n困った時は助け合い、なんでしょう？", "face": "u627"}, {"name": "シャロン", "text": "……ヒューナさん、楽しそうですね。", "face": "u283"}, {"name": "フーリ", "text": "人付き合いが嫌いなんじゃなくて、\n苦手なだけなんですよ、きっと。", "face": "u174"}, {"name": "ヒューナ", "text": "シャロンさん、フーリさん！\nひそひそ話してるの、聞こえてるんだからね！", "face": "u627"}, {"name": "ヴィンセント", "text": "やれやれ……。\n何ともかしましい……。", "face": "u103"}, {"name": "アンナ", "text": "ヒューナさんが皆さんと打ち解けてきたのですから、\n良い事じゃないですか。全員の協力があって、\n獣の群れを退治する事ができたようですし。"}, {"name": "アンナ", "text": "しかし、試練はさらに過酷になると予想されます。\n王子、十分に気を引き締めて、先へ進みましょう。", "face": "l616b59afdfd8"}]}], "active": true}