, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100032, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 212, "global_id": 211, "ranged": true, "spawn_sec": 14}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 41600, "attack": 4800, "base_hp": 52000, "base_attack": 6000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 40, "attack_speed": 50, "attack_wait": 50, "attack_interval": 245, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103440, "race_id": 3, "master_id": 446, "global_id": 445, "spawn_sec": 22}, {"enemy_id": 10, "source": "local", "count": 12, "form_count": 1, "hp": 8, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 107}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 10400, "attack": 4640, "base_hp": 13000, "base_attack": 5800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 20, "attack_wait": 30, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108128, "race_id": 16, "special_effect_id": 54, "master_id": 994, "global_id": 993, "spawn_sec": 117}, {"enemy_id": 12, "source": "local", "count": 4, "form_count": 1, "hp": 4800, "attack": 400, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 139}], "dialogue": [{"trigger": "start", "lines": [{"name": "デシウス", "text": "追い詰めたぞ、ケラウノス！\nなぜ、お前を信仰していた我輩の祖国を滅ぼした！？\nなぜ、魔物の大群を呼び寄せたのだ……！　答えろ……！", "face": "l02935476a4d0"}, {"name": "ケラウノス", "text": "ふふふ、\n神ならば人間の願いを聞き入れるはずなどと\n思いあがった愚か者たちに天罰を下しただけです。", "face": "l3edf87b6584c"}, {"name": "ケラウノス", "text": "でも安心なさい。\nお前の国の人間だけではありません。\nいずれ全ての人間を滅ぼしてあげます。", "face": "l3edf87b6584c"}, {"name": "ケラウノス", "text": "そのためにもレヴィアタンの復活を邪魔させる\nわけにはいきませんからね。\nさあ、聖霊よ、人間たちの力を削ぐために協力なさい。", "face": "l3edf87b6584c"}, {"name": "常闇の聖霊", "text": "うッ、ぁ……ぁぁ……。もう……いや、だ……。\nやめてくれ……。\nもう、われに力は……残って、いない……。", "face": "u397"}, {"name": "ケラウノス", "text": "聖霊が力を失ってしまったようですね。\n計算外ではありますが、これまで常闇の聖霊が\n力を与えた魔物をこの地に全て召喚しましょう。", "face": "l3edf87b6584c"}, {"name": "ケラウノス", "text": "あの男……アイギスの加護を受けているようですし、\nここで滅ぼせば充分地上に\n致命傷を与える事ができるでしょう。", "face": "l3edf87b6584c"}, {"name": "デシウス", "text": "くそっ……。ケラウノスのやつめ、\n魔物を召喚し始めている……！　我輩の祖国にした事と\n同じことを……！　くそったれぇ……！", "face": "l02935476a4d0"}, {"name": "モーティマ", "text": "お、おいっ、デシウス……！\n無茶してんじゃねぇ……！", "face": "u14"}, {"name": "ケラウノス", "text": "邪魔です、暗黒騎士……！", "face": "l3edf87b6584c"}, {"name": "デシウス", "text": "う………ぐ……ぁぁ……。", "face": "l02935476a4d0"}, {"name": "兵士", "text": "ほ、報告！\n全方位より、魔物が突如出現！\n各部隊、前線が混乱しています！", "face": "l86b54cad43ba"}]}, {"trigger": "end", "lines": [{"name": "ケラウノス", "text": "まさか、現世代の英雄が、\nこれほどまでの力を有しているとは……。", "face": "l3edf87b6584c"}, {"name": "ケラウノス", "text": "まあいいです。\n地上を滅ぼすには、まだいくらでも\nやりようはあります。ここは退くとしましょう。", "face": "l3edf87b6584c"}, {"name": "アンナ", "text": "ま、待って下さい！\n女神ケラウノス様！\nなぜ貴方はこのようなことを……！", "face": "l4f471a324987"}, {"name": "ケイティ", "text": "消えてしまいました……。\nそんな、せっかく出会えた女神が、\n私たちの敵となるなんて……。", "face": "u114"}, {"name": "デシウス", "text": "我輩は一足先に退かせてもらうとしよう。\nまだまだ我輩には、やらねばならぬことがあるからな。\nもっと力を、神をしのぐ力を手に入れなければならん。", "face": "l02935476a4d0"}, {"name": "ユリアン", "text": "……デシウスのやつ、行っちまったようだな。\nっと、それよりも常闇の聖霊は無事なのか？", "face": "u7"}, {"name": "常闇の聖霊", "text": "…………こ、こは……？\nわれは、いったい……。\nそ、そうだ……ケラウノス様に……くぅ、ぅぅ……。", "face": "u397"}, {"name": "常闇の聖霊", "text": "そうか……。\nどうやら、われはそなたらに助けてもらったようだな。\n……感謝する。", "face": "u397"}, {"name": "常闇の聖霊", "text": "……二度も命を救われたのだ。\nわれの力を王子に預けよう。\n聖霊の務め、われも果たす時が来たようだ。", "face": "u397"}, {"name": "ケイティ", "text": "常闇の聖霊が無事でよかったですね。\n……ですが、いったい\nこれから私達はどうしたらいいのでしょう。", "face": "u114"}, {"name": "アンナ", "text": "……話し合うべきことが多すぎるような気がします。\n王子、今は帰還することにしましょう。\n常闇の聖霊を助ける事ができただけで充分です。", "face": "l4f471a324987"}]}], "active": true}