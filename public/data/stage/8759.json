{"quest_id": 8759, "name": "炎の騎士", "description": "王子たちの前に炎を纏った騎士が姿を現す。\n＜魔力嵐(弱)：出撃時の初期HP減少(小)\n　爆風範囲、魔法ダメージが減少＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["魔力嵐(弱)：出撃時の初期HP減少(小)\n　爆風範囲、魔法ダメージが減少"], "event": "黒き導き、白き目覚め", "event_category": "History", "mission_id": 920240, "map_no": 7307, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 50, "params": [80]}, {"kind": "term", "influence": 22, "params": [80]}, {"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 172000, "attack": 3600, "base_hp": 172000, "base_attack": 3600, "damage_type": "magical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2165680, "race_id": 16, "special_effect_id": 242, "master_id": 39414, "global_id": 13031, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 16, "form_count": 2, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2165712, "race_id": 8, "change_to": 2, "change_condition": 3, "master_id": 39416, "global_id": 13033, "to_condition": 3, "to_global_id": 13034, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3500, "attack": 550, "base_hp": 3500, "base_attack": 550, "damage_type": "physical", "armor_defense": 250, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2165728, "race_id": 8, "master_id": 39417, "global_id": 13034, "from_condition": 3}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 45, "attack_interval": 148, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160640, "race_id": 16, "special_effect_id": 1795, "master_id": 38796, "global_id": 12413, "spawn_sec": 99}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "physical", "armor_defense": 400, "attack_range": 120, "attack_speed": 1, "attack_wait": 60, "attack_interval": 167, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160656, "race_id": 16, "special_effect_id": 232, "missile_id": 45, "master_id": 38797, "global_id": 12414, "ranged": true, "spawn_sec": 125}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 5000, "attack": 320, "base_hp": 5000, "base_attack": 320, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_speed": 30, "attack_wait": 40, "attack_interval": 159, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2165376, "race_id": 2, "master_id": 39452, "global_id": 13069, "spawn_sec": 149}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 60, "attack_speed": 10, "attack_wait": 35, "attack_interval": 91, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2162320, "race_id": 11, "special_effect_id":