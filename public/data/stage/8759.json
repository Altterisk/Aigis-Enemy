12389, "from_condition": 2}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "magical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 167, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2165680, "race_id": 16, "change_to": 15, "master_id": 39445, "global_id": 13062, "route_behaviour": {"transforms": [{"flag": 1, "val": 1}, {"flag": 2, "val": 1}, {"flag": 3, "val": 1}, {"flag": 4, "val": 1}]}, "spawn_sec": 307}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 156, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2166080, "race_id": 16, "change_to": 19, "master_id": 39458, "global_id": 13075, "route_behaviour": {"transforms": [{"flag": 5, "val": 1}]}, "spawn_sec": 307}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 163, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2165808, "race_id": 16, "change_to": 21, "master_id": 39442, "global_id": 13059, "sp_change_to": [39444], "route_behaviour": {"transforms": [{"flag": 7, "val": 1}, {"flag": 9, "val": 1, "to": 39442}, {"to": 39444, "wait": 300000}]}, "spawn_sec": 307}, {"enemy_id": 24, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 10, "attack_interval": 145, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2165760, "race_id": 16, "change_to": 24, "master_id": 39439, "global_id": 13056, "sp_change_to": [39441], "route_behaviour": {"transforms": [{"flag": 6, "val": 1}, {"flag": 8, "val": 1, "to": 39439}, {"to": 39441, "wait": 300000}]}, "spawn_sec": 307}, {"enemy_id": 27, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 500, "base_hp": 299999, "base_attack": 500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 25, "attack_speed": 60, "attack_wait": 90, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 2.0, "pattern_id": 2165744, "master_id": 39451, "global_id": 13068, "spawn_sec": 307}, {"enemy_id": 28, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2097200, "special_effect_id": 902, "master_id": 36265, "global_id": 9882, "route_behaviour": {"sets_flags": [[1, 1, 36], [0, 1, 34], [2, 1, 20], [5, 1, 60], [6, 1, 60], [7, 1, 60], [3, 1, 165], [8, 1, 30], [9, 1, 30], [10, 1, 0], [11, 1, 0]]}, "spawn_sec": 307}], "popups": ["　　【魔力嵐(弱)】\n・ユニット配置時の\n　初期HPが少し減少\n\n・味方の魔法攻撃による\n　ダメージが減少\n\n・敵味方の爆風範囲が減少", "炎の騎士は、\n拠点には向かわず、\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。", "黒い光冠の魔物は倒されると、\nその場で強くなって復活します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――おっと、快進撃はそこまでだ。", "face": "l2d5d46a4f63e"}, {"name": "ケイティ", "text": "炎の、騎士……？　何者ですか！", "face": "u2433a1"}, {"name": "？？？", "text": "おいおい、モリグナンから聞いてねぇのかよ。\n裏切ってそっちについたんだろ？", "face": "l2d5d46a4f63e"}, {"name": "トリステラ", "text": "裏切りとは失礼ですね。\n最初から味方したつもりはないですよ。", "face": "u2630a1"}, {"name": "モリグナン", "text": "そうね、値踏みはさせてもらうと、\n最初にエンキドゥには伝えていたもの。", "face": "lfe5456e1292d"}, {"name": "モリグナン", "text": "それに、その仮面がある限り、\nあなたが誰だったのか、\nそれを認識することなんて誰にもできないわ？", "face": "lfe5456e1292d"}, {"name": "？？？", "text": "へぇ、この仮面、そこまで便利な代物だったのか。\n確かにお前は昔から、\nこういう趣味の悪い魔法が大好物だったよな。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "それで値踏みの結果は？\n我らがギルガメッシュは王の器なりや？", "face": "l2d5d46a4f63e"}, {"name": "モリグナン", "text": "不合格。\n不確定な願いの契約に、\n私の戦争を委ねることはできないわ。", "face": "lfe5456e1292d"}, {"name": "トリステラ", "text": "同じく。\n彼本人なら話は違ったかもしれない。\nでも、そうじゃないなら――そこに未来への物語はない。", "face": "u2630a1"}, {"name": "？？？", "text": "そうかよ。\n――で？　そいつが未来を託す次の王か？", "face": "l2d5d46a4f63e"}, {"name": "オークの副官", "text": "――姉御、奴は王国の王子です。\n噂によれば魔王と神を討った者だとか。", "face": "l03b0aebd8509"}, {"name": "？？？", "text": "……王子？　王ですらねぇのかよ。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "笑えねぇ戦いだな、まったく。\nあいつが帰ってくるって言うから、\nわざわざ穏やかに死ぬ未来を捨てたっていうのに。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "それが蓋を開けてみりゃ、中身が全くの別人と来た。\nその上、抗ってくんのがただの王子かよ！", "face": "l2d5d46a4f63e"}, {"name": "アナトリア", "text": "（……王子を、知らない？\nその辺りの野盗ならまだしも、\nあれだけの気迫をまとった、一流の戦士が？）", "face": "u522"}, {"name": "アナトリア", "text": "あんたたち、魔界のオークだね？\nいったいどういう事情で、その騎士についたんだい。", "face": "u522"}, {"name": "オークの戦士たち", "text": "あれは、まさかチャンプ……！？\nアナトリア、アナトリアだ……！", "face": "l416422fb8140"}, {"name": "オークの副官", "text": "狼狽えるな、野郎ども。\n姉御を信じて戦えばいい。\n最高の死に場所を与えるという約束を思い出せ。", "face": "l03b0aebd8509"}, {"name": "アナトリア", "text": "なるほど、その騎士に忠義を誓ったんだね。\nそれなら――容赦はしないよ。", "face": "u522"}, {"name": "オークの副官", "text": "望むところッ！！\n我が主君、炎の騎士、太陽の化身よ！\n我らが命をもって勝利を捧げます！", "face": "l03b0aebd8509"}, {"name": "オークの戦士たち", "text": "うおおおおおッ！　燃え盛る炎よ！！\nうおおおおおッ！！　太陽の輝きよ！！", "face": "l416422fb8140"}, {"name": "？？？", "text": "退屈でまた死にそうになってたところなんだ。\n王子、てめぇは楽しませてくれるんだろうな？", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "誰も彼も腹に一物抱えやがって。\n正体隠して、陰謀巡らせて、\nそんなの、何が楽しいのかわかりゃしねぇ。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "――だから、わかりやすく行こうぜ。\n俺様は平和な世界ってやつが大好きだ。\nそのためには、最強の王がいる。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "王がいねぇなら！\n王が決まるまで、全員で殺し合えばいいんだよッ！！", "face": "l2d5d46a4f63e"}]}, {"trigger": "battle", "at_sec": 304, "lines": [{"name": "？？？", "text": "――やるねぇ。\n見直したよ、王子サマ。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "こんな戦士が生まれるなら、\n永遠の命ってやつ、貰っておけばよかったな。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "だが――足りねぇよ。\nそれじゃあ世界ってやつを守ることはできねぇ。", "face": "l2d5d46a4f63e"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アナトリア", "text": "くっ……数が多い……！\n王子！　ひとりで相手をするんじゃない！\nそいつは――何かがおかしい！", "face": "u522"}, {"name": "？？？", "text": "世界を守るために必要な条件は、分かるか？", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "ひとつは、世界を滅ぼす巨悪を倒すこと。\n誰にもできない偉業を成し遂げて、\n有無を言わさず全ての王となることだ。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "もうひとつは、世界を滅ぼす巨悪になること。\n誰も逆らえない力を手にすれば、\n誰もが抗うことを諦める。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "お前はどっちなんだ、王子サマ。\nあいにくと、まだこの時代に生きて短いんでね。\n今まで何をしてきたのか、知らねぇんだ。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "さぁ、教えてくれよ。", "face": "l2d5d46a4f63e"}, {"name": "ミレイユ", "text": "王子、耳を貸してはなりません。\nあれは王を惑わす者の言葉。\n戦乱へ人心を導く破滅の徒の言い分です。", "face": "u386"}, {"name": "？？？", "text": "あぁ……？\nおい、おいおいおい！　ミレイユ！\nてめぇ生きてたのかよ！！", "face": "l2d5d46a4f63e"}, {"name": "ミレイユ", "text": "……私を、知っている……？", "face": "u386"}, {"name": "？？？", "text": "ちっ……この仮面、便利だが\nこういう時に気が利かねぇな……。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "まぁ、いいや。\nお前がついていて、\nそれでも人類は戦争をやめられなかった。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "誰も、英雄王にはなれなかった。\n自分の国を守るので精一杯。\nそんなくだらねぇ世界は、俺様が終わらせる。", "face": "l2d5d46a4f63e"}, {"name": "セーラ", "text": "……ご主人様、下がってください。\n何か仕掛けてきます。", "face": "u346"}, {"name": "？？？", "text": "ヤツを殺すつもりならよぉ……。\nこれくらいでくたばったりしねぇよなぁ？", "face": "l2d5d46a4f63e"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "見事、生き延びてみせやがれ。\nこいつを耐えきったら、\nその時は仮面を外して、正々堂々相手をしてやるよ。", "face": "l2d5d46a4f63e"}, {"name": "王子", "text": "ミレイユ、セーラ、逃げてくれ。", "face": "u1"}, {"name": "セーラ", "text": "いいえ、一歩も退きません。\n私は――ご主人様のメイドです。", "face": "u346"}, {"name": "ミレイユ", "text": "近衛とは王を守るもの。\n未来の我が王、あなたのためならば。", "face": "u386"}, {"name": "？？？", "text": "いい覚悟だ。それじゃあ、死にな。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "光り輝き、大地の全てを焼き尽くせ。\n――我が聖剣！　ガラティィィィィンッ！！", "face": "l2d5d46a4f63e"}]}, {"trigger": "end", "lines": [{"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "セーラ", "text": "くっ……っ。", "face": "u346"}, {"name": "ミレイユ", "text": "…………。", "face": "u386"}, {"name": "アンナ", "text": "王子！　セーラさん、ミレイユさん！", "face": "l45edffb7f1fa"}, {"name": "？？？", "text": "ほう、消し飛ばなかったか。\nこんなに面白いやつらがいるなら、\nこの時代のこと、もっと調べておくんだったな。", "face": "l2d5d46a4f63e"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "――だが、あと一歩足りてねぇ。\nこれで終わりだぜ。", "face": "l2d5d46a4f63e"}, {"name": "セーラ", "text": "……ミレイユ様。", "face": "u346"}, {"name": "ミレイユ", "text": "えぇ。私も同じ覚悟です。", "face": "u386"}, {"name": "セーラ＆ミレイユ", "text": "あなたにお仕えできて、幸せでした。\n――未来は、お任せします。", "face": "l75cdf3b4d2e3"}, {"name": "王子", "text": "…………！？", "face": "u1"}, {"name": "？？？", "text": "喰らえ、原初の炎。\n神の溶鉱炉たる始まりの火。", "face": "l2d5d46a4f63e"}, {"name": "？？？", "text": "――溶けちまえ。\nこれが星の物語、最初の記憶だッ！！", "face": "l2d5d46a4f63e"}]}], "active": true}