hysical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 79}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 79}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 81}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 17, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 96}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 19, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 99}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "……足掻くな人間ども。\nおとなしく、死を受け入れよ。", "face": "l2aefaaf94325"}, {"name": "レオナ", "text": "……くそッ！\n辺境の村の魔物退治と甘く見ていたが、\nまさか我が軍がここまで押されるとは……。", "face": "u311"}, {"name": "アンナ", "text": "――レオナさん！？\n私たちもすぐに加勢します！", "face": "l15bcf247e4c0"}, {"name": "？？？", "text": "ほう。援軍か。\nいくら人間が増えたところで詮無きこと。\n良かろう、全て滅す――ら、ラクシャーサ様！？", "face": "l2aefaaf94325"}, {"name": "ラクシャーサ", "text": "それはこちらの台詞だ、我が配下らよ。\n主の命もなく活動を始めるとは、どういうことだ？", "face": "u306"}, {"name": "ラクシャーサの配下", "text": "……人間に与したラクシャーサ様に、委細を話す\n義理はありません。邪魔立てするならば、\n例え貴方であろうと滅するまで……ッ！", "face": "l2aefaaf94325"}, {"name": "ラクシャーサ", "text": "なるほど……主への背信の愚を解さぬ程の\n乱心ということか……いいだろう。\n私自らが滅殺してやる。", "face": "u306"}, {"name": "アンナ", "text": "……つまり、あの魔物は\nラクシャーサさんの配下の\n方々という事なのですか？", "face": "l15bcf247e4c0"}, {"name": "ラクシャーサ", "text": "そうだ。\nただ私の制御を離れてしまったがな……。\n回数制限付きだが、倒しても蘇るから気を付けろ。", "face": "u306"}, {"name": "レオナ", "text": "王子！　我が帝国軍は西方の敵を迎え撃つ！\n王子軍は東方からの敵をたのむ！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "ラクシャーサの配下", "text": "く……ぬぁぁあああ……あ…。\nさ、再生が及ばぬ……。\n一度魔界に戻らねば……。", "face": "l2aefaaf94325"}, {"name": "レオナ", "text": "……何とか、勝てたか。\n今回の助力、不本意ではあったが、\n感謝しておく……王子。", "face": "u311"}, {"name": "レオナ", "text": "礼ついでに忠告しておいてやる。", "face": "u311"}, {"name": "レオナ", "text": "近頃、同時多発的に各所において魔物の\n動きが活発になっている。\n偶然とするには不穏に過ぎる。", "face": "u311"}, {"name": "ラクシャーサ", "text": "魔界に御していたはずの我が配下が\n解き放たれた事も解せぬな。", "face": "u306"}, {"name": "レオナ", "text": "貴様らがどうなろうと知ったことではないが、\n今日のような事もあるからな……。\nつまらぬ所で死なれては困る。注意は怠るな。", "face": "u311"}, {"name": "レオナ", "text": "さあ、全軍撤収だ！\n急ぎ帝国へ戻り、\n陛下への報告を一刻も早く行うぞ！", "face": "u311"}, {"name": "アンナ", "text": "王子、出来ることなら、先ほどのように共に\n魔物に立ち向かえればと願ってしまいますね……。"}, {"name": "アンナ", "text": "では、私たちも戻りましょう。\n王子、この度はお疲れ様でした。", "face": "l15bcf247e4c0"}]}], "active": true}