": true, "variants": [{"hp": 50000, "attack": 3000, "base_hp": 50000, "base_attack": 3000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 100, "attack_wait": 20, "attack_interval": 203, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114048, "race_id": 2, "master_id": 30920, "global_id": 4539}], "spawn_sec": 137}, {"enemy_id": 20, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102224, "race_id": 8, "change_to": 20, "change_condition": 3, "master_id": 366, "global_id": 365, "to_condition": 3, "to_global_id": 366, "spawn_sec": 141}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "physical", "armor_defense": 450, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102240, "race_id": 8, "master_id": 367, "global_id": 366, "from_condition": 3}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097824, "master_id": 44, "global_id": 43, "spawn_sec": 151}, {"enemy_id": 23, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 161}, {"enemy_id": 24, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 161}], "dialogue": [{"trigger": "start", "lines": [{"name": "ルナール", "text": "――あ、あった！\nね、王子？　言った通りでしょ？", "face": "u300"}, {"name": "アンナ", "text": "確かに、魔界のゲートのようなものが見えますね。\n……おや、ゲートの奥に人影が……！", "face": "l947c00562db7"}, {"name": "ケイティ", "text": "――ッ！\nあれは、確か魔王親衛隊の――", "face": "u114"}, {"name": "クロコ", "text": "――竜将クロコだ。\n覚えておいてもらオウ。", "face": "l74c5e7f34db0"}, {"name": "ゴライア", "text": "ケッ、なぁにが竜将クロコだ！\nテメエも誇り高き竜人族の戦士なら、\nなんだって魔王の使い走りなんかしてんだヨ！", "face": "u385"}, {"name": "クロコ", "text": "……誰だか知らんガ、言葉は慎メ。\n私は自らの意志で此処に来たノダ。\n英雄と名高い王子の軍と一戦交エンとスル為にナ。", "face": "l74c5e7f34db0"}, {"name": "ゴライア", "text": "勝手なこと言いやがっテ！\nコッチはいい迷惑ダゼ！", "face": "u385"}, {"name": "クロコ", "text": "……少し静かになっテもらオウカ。", "face": "l74c5e7f34db0"}, {"name": "クロコ", "text": "――勇猛ナル魔王軍の戦士達ヨ！\n己ガ武を存分に振ルイ、以て魔王様への忠誠を示セ！", "face": "l74c5e7f34db0"}, {"name": "オーク", "text": "うおおおおおおおっ！！\n同胞よ、先陣を切れ！\n王子の首級はオレたちの手で挙げるのだ！", "face": "l5ef35f915d23"}, {"name": "ソーマ", "text": "あぁっ！\n王子、オークさんたちがこっちに向かってきます！", "face": "u23"}, {"name": "ゴライア", "text": "ったく、ビビってんじゃねえヨ！\nそんなだからお前ら人間は魔物どもに舐められるんダ。", "face": "u385"}, {"name": "クロコ", "text": "サァ……王子よ、見せテもらおうカ！\n古今無双と名高き人間の英雄ハ、\n鋼ヲモ貫く我ガ雷槍の閃きを如何スル！", "face": "l74c5e7f34db0"}]}, {"trigger": "end", "lines": [{"name": "クロコ", "text": "ウム……やはり強イ。\n現し世の英雄との評判に恥じヌ強さダ。", "face": "l74c5e7f34db0"}, {"name": "クロコ", "text": "いずれまた戦おウ。\n暫し、さらばダ。", "face": "l74c5e7f34db0"}, {"name": "ゴライア", "text": "……フン、口ほどにもネェ野郎だゼ。", "face": "u385"}, {"name": "ルナール", "text": "……でも、さっきのクロコって人、\nまだ本気を出してないみたいだったよ。", "face": "u300"}, {"name": "ケイティ", "text": "ええ……それに、魔王親衛隊の将が\n自ら隊を率いて物質界に現れるとは……。", "face": "u114"}, {"name": "アンナ", "text": "魔王軍との戦いは\n新たな局面を迎えようとしているのかもしれませんね。\n今後も気を引き締めてまいりましょう。", "face": "l947c00562db7"}]}], "map": {"image": "Map3447", "w": 960, "h": 640, "spots": [{"k": "b", "x": 286, "y": 533}, {"k": "b", "x": 928, "y": 491}, {"k": "m", "x": 549, "y": 334, "id": 200}, {"k": "m", "x": 388, "y": 118, "id": 201}, {"k": "m", "x": 172, "y": 120, "id": 202}, {"k": "m", "x": 617, "y": 402, "id": 203}, {"k": "m", "x": 770, "y": 142, "id": 204}, {"k": "m", "x": 383, "y": 336, "id": 205}, {"k": "m", "x": 585, "y": 127, "id": 206}, {"k": "m", "x": 189, "y": 217, "id": 207}, {"k": "m", "x": 708, "y": 453, "id": 208}, {"k": "m", "x": 815, "y": 485, "id": 209}, {"k": "m", "x": 360, "y": 408, "id": 210}, {"k": "m", "x": 330, "y": 478, "id": 211}, {"k": "m", "x": 267, "y": 292, "id": 212}, {"k": "m", "x": 659, "y": 290, "id": 213}, {"k": "m", "x": 738, "y": 232, "id": 214}, {"k": "m", "x": 106, "y": 257, "id": 215}, {"k": "r", "x": 739, "y": 97, "id": 300}, {"k": "r", "x": 450, "y": 388, "id": 301}, {"k": "r", "x": 582, "y": 438, "id": 302}, {"k": "r", "x": 116, "y": 174, "id": 303}, {"k": "r", "x": 290, "y": 380, "id": 304}, {"k": "r", "x": 685, "y": 335, "id": 305}, {"k": "r", "x": 778, "y": 275, "id": 306}, {"k": "r", "x": 695, "y": 497, "id": 307}, {"k": "r", "x": 179, "y": 277, "id": 308}], "events": [{"t": 0.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_01", "fx": "StageGate1", "x": 20, "y": 285}]}, {"t": 5.0, "when": "time", "ops": [{"op": "+fx", "name": 