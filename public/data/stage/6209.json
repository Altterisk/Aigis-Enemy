st": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "from_condition": 3}, {"enemy_id": 9, "source": "local", "count": 13, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "spawn_sec": 127}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 540, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1000.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106496, "race_id": 8, "change_to": 10, "change_condition": 2, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30507, "global_id": 4126, "ranged": true, "to_condition": 2, "to_global_id": 4054, "spawn_sec": 135}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3780, "attack": 192, "base_hp": 6300, "base_attack": 320, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30435, "global_id": 4054, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "サヨ", "text": "過去に一度は撃退した魔界蟻が、\n新しい女王に率いられて\n王国に攻めてきた時の事ね。", "face": "u510"}, {"name": "サヨ", "text": "魔界蟻の女王のフェロモンは種族や外見に関係なく、\nあらゆる男性を虜にしてしまう、\n恐ろしい力を持っていたのよね。", "face": "u510"}, {"name": "サヨ", "text": "幸い、過去に一度戦った後にフェロモンへの抗体を\n準備できたから、王子や王子軍の男性が虜になる、\nなんて事態は避けれたのは幸いだったわね……。", "face": "u510"}, {"name": "テルマ", "text": "――王子、魔界蟻の軍勢がこの辺りで\n目撃されました。", "face": "u296"}, {"name": "テルマ", "text": "魔界蟻は地面は当然、壁を這って移動もできます。\n蟻の侵攻ルートには注意してください。", "face": "u296"}, {"name": "テルマ", "text": "また、魔界蟻の軍勢の中には\nオークやマーマンの姿も混ざっているとの\n目撃情報があります。", "face": "u296"}, {"name": "テルマ", "text": "オスの魔物ばかり……ですね。\n女王蟻のフェロモンに誘惑された魔物と\n魔界蟻の混成軍が相手となります。", "face": "u296"}, {"name": "テルマ", "text": "大量の敵との交戦が予想されますので、\n効果的な部隊運用を心がけてくださいね。\nそれでは出陣しましょう、王子！", "face": "u296"}]}, {"trigger": "end", "lines": [{"name": "サヨ", "text": "――あの時は王子たちの助けになるかと、\n蟻の群れに潜入してたの。\n魔界蟻の弱点を探ろうと思って。", "face": "u510"}, {"name": "サヨ", "text": "フェロモンの洗脳を解除できれば、\n魔物の軍勢も解散させられるかも、と考えてたんだけど。\nフェロモンは女王を倒すしか止める手立てが無かったの。", "face": "u510"}, {"name": "サヨ", "text": "女王蟻はいつも取り巻きを連れていたから、\n近づく事すら出来なかったし、そうしてる間に戦闘が\n始まって、戦場に駆り出されちゃうし。", "face": "u510"}, {"name": "サヨ", "text": "今回も、王子達が女王蟻を倒す姿を見てるだけだった。\n陰から支えようって思ってるのに、\nわたしは何もできなかった……。", "face": "u510"}, {"name": "サヨ", "text": "……無力感、かぁ。\nデシウスもこんな気持ちを感じたのかもしれないわね。\nそして、ただひたすらに力を求めるようになったのかも。", "face": "u510"}, {"name": "サヨ", "text": "暗黒騎士団を崩壊させ、部下を犠牲にしてまで、\nデシウスが力を求めていた理由。\nそれが垣間見えたのが、次の戦いだったよね。", "face": "u510"}]}], "active": true}