6, "global_id": 14343, "spawn_sec": 159}, {"enemy_id": 32, "source": "local", "count": 1, "form_count": 1, "hp": 55000, "attack": 1250, "base_hp": 55000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 650, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099360, "race_id": 4, "master_id": 39542, "global_id": 13159, "spawn_sec": 188}, {"enemy_id": 33, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 100000, "attack": 3000, "base_hp": 100000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 30, "attack_speed": 200, "attack_wait": 120, "attack_interval": 596, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120784, "race_id": 5, "special_effect_id": 451, "master_id": 40727, "global_id": 14344, "spawn_sec": 198}, {"enemy_id": 34, "source": "local", "count": 1, "form_count": 2, "hp": 225000, "attack": 4000, "base_hp": 225000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 711, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099712, "race_id": 5, "change_to": 34, "change_condition": 5, "master_id": 40901, "to_condition": 5, "spawn_sec": 258}, {"enemy_id": 34, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 225000, "attack": 3500, "base_hp": 225000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_range": 200, "attack_speed": 300, "attack_wait": 120, "attack_interval": 406, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099728, "race_id": 5, "change_to": 35, "change_condition": 1, "missile_id": 76, "missile": {"speed": 3.0, "splash": 133}, "master_id": 40902, "ranged": true, "from_condition": 5, "variants": [{"hp": 225000, "attack": 4000, "base_hp": 225000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 711, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099712, "race_id": 5, "missile_id": 58, "master_id": 40903}]}], "popups": ["巨躯のオーク勇者はHPが\n50%以下になると咆哮を行います。\n咆哮後、移動速度が上昇します。", "巨躯のオークはHPが\n50%以下になると咆哮を行います。\n咆哮後、移動速度が上昇します。", "スピーカーゴーレムから\n攻撃を複数回受けると、\n麻痺状態になります。", "メカゴーレムは攻撃力1500以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オロバス", "text": "──レディース＆ジェントルメン！", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "紳士淑女の皆様、オロバスカップ本選へようこそ。", "face": "l6c31c92fccb4"}, {"name": "観客", "text": "うぉおおおおおおおおおおお！！", "face": "la3a8ec8464a6"}, {"name": "オロバス", "text": "たった一つの願いをかなえるために集まった、\n綺羅星の如きアイドルたちの祝宴が始まります。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "ルールは簡単、予選と同様に人気投票形式を採用。\n各ユニットにライブパフォーマンスを披露してもらい、\nその結果を以って決勝に進む上位三組を決定いたします。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "なお今回のオロバスカップでは──", "face": "l6c31c92fccb4"}, {"name": "ラタトスク", "text": "……いよいよじゃな。"}, {"name": "アージェ", "text": "オール・セット、いつでも行けます。"}, {"name": "キュウビ", "text": "まっ、わらわの勝利は決まっておるがな。"}, {"name": "ラタトスク", "text": "吾輩たちの勝利じゃ、間違えるな。"}, {"name": "ユキヒメ", "text": "私たちも負けない、よ……？"}, {"name": "アルタ", "text": "ええ、優勝の栄光はアージェ★アルタが貰い受けます。"}, {"name": "アンナ", "text": "皆さん、我々の最優先目標は──"}, {"name": "キュウビ", "text": "王子の解呪、であろう？\n安心せよ、抜かりはない。"}, {"name": "ラタトスク", "text": "大船に乗った気でいるのじゃな！"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "オロバス", "text": "それでは次のユニットに参りましょう、\nあの伝説の王国プロダクションからは──", "face": "l6c31c92fccb4"}, {"name": "ケイティ", "text": "皆さん、カウントダウン始まります！", "face": "u2433a1"}, {"name": "アージェ★アルタ", "text": "参りましょう、スリー。"}, {"name": "ラタ★キュウビ", "text": "とぅー！"}, {"name": "ユキヒメ", "text": "わん……ッ！"}, {"name": "オロバス", "text": "ヒュウィゴッ！", "face": "l6c31c92fccb4"}]}, {"trigger": "end", "lines": [{"name": "少女", "text": "──ユキヒメちゃーん！！！！", "face": "l0a5b13274af9"}, {"name": "リュティエ", "text": "もふもふ最高ーっ！！", "face": "u1273a1"}, {"name": "もふもふマニア", "text": "お日様の匂いしそう。", "face": "la3a8ec8464a6"}, {"name": "偶像信徒A", "text": "アージェ様に踏まれたい。", "face": "l5eb252155b6f"}, {"name": "偶像信徒B", "text": "いや、アルタ様に蹴られたい。", "face": "la3a8ec8464a6"}, {"name": "マリレーヌ", "text": "…………(感涙)", "face": "u1354a1"}, {"name": "泣いてる亜神", "text": "…………(滂沱)"}, {"name": "涙ぐむ亜神", "text": "（やりましたね、アルタ……）"}, {"name": "ユキヒメ", "text": "やり切った……？"}, {"name": "アージェ", "text": "パーフェクトです、ユキヒメさん。"}, {"name": "キュウビ", "text": "はあ……ガラにもなく燥ぎ過ぎたわ。"}, {"name": "ラタトスク", "text": "普段の仕事の百倍疲れたのじゃあ……。"}, {"name": "ユキヒメ", "text": "うん……すっごく疲れた。\n心臓もずっとバクバクだし──"}, {"name": "ユキヒメ", "text": "──でも、楽しかった。"}, {"name": "アルタ", "text": "……ですね。"}, {"name": "ラタトスク", "text": "業腹じゃがな。"}, {"name": "キュウビ", "text": "まあ、認めてやらんこともない。"}, {"name": "アージェ", "text": "ピピピ、人気属性・ツンデレを検出しました。"}, {"name": "キュウビ", "text": "違うわ！"}, {"name": "ユキヒメ", "text": "（ピピピって口で言うんだ……）"}, {"name": "アルタ", "text": "ふふっ……。"}, {"name": "ラタトスク", "text": "さて、名残惜しいがそろそろ戻るとするか。"}, {"name": "アルタ", "text": "凱旋ですね。"}, {"name": "アージェ", "text": "ええ、堂々と帰還しましょう。"}, {"name": "ユキヒメ", "text": "それじゃあみんな、また……ね？"}, {"name": "観客", "text": "わぁああああああああ！！", "face": "la3a8ec8464a6"}]}], "active": true}