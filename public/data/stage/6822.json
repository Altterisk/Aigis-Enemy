"base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_wait": 5, "attack_interval": 39, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "special_effect_id": 64, "master_id": 31840, "global_id": 5459, "spawn_sec": 127}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 151}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士Ａ", "text": "――た、大変だ！\nゴブリンどもが攻めてきたぞ！", "face": "u65"}, {"name": "兵士Ｂ", "text": "くそっ、早く本隊に知らせないと……！！\n――って、あれはまさか……。\n向こうから来るの、王子の本隊じゃないか！？", "face": "u69"}, {"name": "兵士Ａ", "text": "王子、現在こちらにゴブリンの群れが向かっています！\n至急援護をお願いします……！！", "face": "u65"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "アンナ", "text": "報告ありがとうございます。\n魔物は我々が対処しますから、\n兵の皆さんは村人の避難誘導を！", "face": "le4da4fde4f27"}, {"name": "兵士Ａ", "text": "……はッ！！", "face": "u65"}, {"name": "ラテリア", "text": "剣の導きに従って来てみたら、\nゴブリンの群れに遭遇するとはね……。", "face": "u532"}, {"name": "ピリカ", "text": "がう……？　でもおかしいよ……？\nボクの剣が反応するのは、\nいつも獣が相手の時だけなのに……。", "face": "u843"}, {"name": "ゴブリン", "text": "――ギャギャッ！　トマレ！　トマレ！\nオオカミ！　イウコトキカナイ！！", "face": "lb59f9b8abb75"}, {"name": "ラテリア", "text": "……なるほどね、\n凶暴化したのはゴブリンの乗騎ってことか。", "face": "u532"}, {"name": "ピリカ", "text": "がう……。\nそれで暴れた乗騎から逃げるために、\n他のゴブリンも村の方へ来たんだね。", "face": "u843"}, {"name": "アンナ", "text": "いずれにせよ、村に被害が出る前に対処しなくては。\n王子、迎撃の準備をお願いします！", "face": "le4da4fde4f27"}]}, {"trigger": "end", "lines": [{"name": "兵士Ａ", "text": "助かりました、王子。\nそれにしても、報告しに行く前に来てくださるとは……。", "face": "u65"}, {"name": "ケイティ", "text": "こちらも、魔物凶暴化の\n原因を調査している最中だったのです。\n何か心当たりはありませんか……？", "face": "u114"}, {"name": "兵士Ａ", "text": "そういえば猟師達が、最近やけに凶暴な獣が\n森の洞窟から現れると話していましたね……。", "face": "u65"}, {"name": "兵士Ｂ", "text": "あの時は獲物が自分から飛び出してくると、\n猟師たちと笑っていましたが、もしかしたら……。", "face": "u69"}, {"name": "アンナ", "text": "なるほど……可能性は高そうですね……。\n王子、その洞窟に向かってみましょうか？", "face": "le4da4fde4f27"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ピリカ", "text": "……がう。剣も同じ方角に導こうとしてる。\nその洞窟に、この事件の原因があるのかも。", "face": "u843"}, {"name": "アンナ", "text": "周辺の村のためにも、\n急いでこの事件を解決しないといけませんね。\n王子、森の奥へ急ぎましょう！", "face": "le4da4fde4f27"}]}], "map": {"image": "Map920131_3416", "w": 960, "h": 640, "spots": [{"k": "b", "x": 132, "y": 258}, {"k": "m", "x": 238, "y": 424, "id": 200}, {"k": "m", "x": 177, "y": 359, "id": 201}, {"k": "m", "x": 256, "y": 176, "id": 202}, {"k": "m", "x": 199, "y": 293, "id": 203}, {"k": "m", "x": 648, "y": 268, "id": 204}, {"k": "m", "x": 330, "y": 145, "id": 205}, {"k": "m", "x": 388, "y": 171, "id": 206}, {"k": "m", "x": 449, "y": 203, "id": 207}, {"k": "m", "x": 572, "y": 250, "id": 208}, {"k": "m", "x": 573, "y": 320, "id": 209}, {"k": "m", "x": 509, "y": 342, "id": 210}, {"k": "m", "x": 376, "y": 382, "id": 211}, {"k": "m", "x": 409, "y": 431, "id": 212}, {"k": "m", "x": 483, "y": 433, "id": 213}, {"k": "m", "x": 556, "y": 435, "id": 214}, {"k": "m", "x": 630, "y": 440, "id": 215}, {"k": "m", "x": 827, "y": 293, "id": 216}, {"k": "m", "x": 706, "y": 202, "id": 217}, {"k": "m", "x": 741, "y": 286, "id": 218}, {"k": "m", "x": 705, "y": 447, "id": 219}, {"k": "m", "x": 83, "y": 418, "id": 220}, {"k": "m", "x": 224, "y": 234, "id": 221}, {"k": "m", "x": 442, "y": 363, "id": 222}, {"k": "m", "x": 306, "y": 400, "id": 223}, {"k": "m", "x": 781, "y": 461, "id": 224}, {"k": "m", "x": 780, "y": 151, "id": 225}, {"k": "m", "x": 160, "y": 425, "id": 226}, {"k": "m", "x": 508, "y": 229, "id": 227}, {"k": "r", "x": 109, "y": 