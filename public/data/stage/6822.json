{"quest_id": 6822, "name": "制御不能の騎獣", "description": "獣の凶暴化は、ゴブリンの駆る\n騎獣たちにも及んでいた。\n暴走するゴブリンライダーから村を守れ！\n上級（★１獲得の目安：平均Lv10）", "event": "白き姫と魔獣の剣", "event_category": "History", "mission_id": 920131, "map_no": 3416, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 31, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 10, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 60}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 68}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 73}, {"enemy_id": 5, "source": "local", "count": 7, "form_count": 1, "hp": 2400, "attack": 250, "base_hp": 2400, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_wait": 5, "attack_interval": 51, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "special_effect_id": 64, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 31838, "global_id": 5457, "ranged": true, "spawn_sec": 77}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 1, "hp": 3150, "attack": 400, "base_hp": 3150, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_wait": 5, "attack_interval": 51, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "special_effect_id": 64, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 31839, "global_id": 5458, "ranged": true, "spawn_sec": 122}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 127}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_wait": 5, "attack_interval": 39, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "special_effect_id": 64, "master_id": 31840, "global_id": 5459, "spawn_sec": 127}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 151}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士Ａ", "text": "――た、大変だ！\nゴブリンどもが攻めてきたぞ！", "face": "u65"}, {"name": "兵士Ｂ", "text": "くそっ、早く本隊に知らせないと……！！\n――って、あれはまさか……。\n向こうから来るの、王子の本隊じゃないか！？", "face": "u69"}, {"name": "兵士Ａ", "text": "王子、現在こちらにゴブリンの群れが向かっています！\n至急援護をお願いします……！！", "face": "u65"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "アンナ", "text": "報告ありがとうございます。\n魔物は我々が対処しますから、\n兵の皆さんは村人の避難誘導を！", "face": "lb3fb7f0a421f"}, {"name": "兵士Ａ", "text": "……はッ！！", "face": "u65"}, {"name": "ラテリア", "text": "剣の導きに従って来てみたら、\nゴブリンの群れに遭遇するとはね……。", "face": "u532"}, {"name": "ピリカ", "text": "がう……？　でもおかしいよ……？\nボクの剣が反応するのは、\nいつも獣が相手の時だけなのに……。", "face": "u843"}, {"name": "ゴブリン", "text": "――ギャギャッ！　トマレ！　トマレ！\nオオカミ！　イウコトキカナイ！！", "face": "lb59f9b8abb75"}, {"name": "ラテリア", "text": "……なるほどね、\n凶暴化したのはゴブリンの乗騎ってことか。", "face": "u532"}, {"name": "ピリカ", "text": "がう……。\nそれで暴れた乗騎から逃げるために、\n他のゴブリンも村の方へ来たんだね。", "face": "u843"}, {"name": "アンナ", "text": "いずれにせよ、村に被害が出る前に対処しなくては。\n王子、迎撃の準備をお願いします！", "face": "lb3fb7f0a421f"}]}, {"trigger": "end", "lines": [{"name": "兵士Ａ", "text": "助かりました、王子。\nそれにしても、報告しに行く前に来てくださるとは……。", "face": "u65"}, {"name": "ケイティ", "text": "こちらも、魔物凶暴化の\n原因を調査している最中だったのです。\n何か心当たりはありませんか……？", "face": "u114"}, {"name": "兵士Ａ", "text": "そういえば猟師達が、最近やけに凶暴な獣が\n森の洞窟から現れると話していましたね……。", "face": "u65"}, {"name": "兵士Ｂ", "text": "あの時は獲物が自分から飛び出してくると、\n猟師たちと笑っていましたが、もしかしたら……。", "face": "u69"}, {"name": "アンナ", "text": "なるほど……可能性は高そうですね……。\n王子、その洞窟に向かってみましょうか？", "face": "lb3fb7f0a421f"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ピリカ", "text": "……がう。剣も同じ方角に導こうとしてる。\nその洞窟に、この事件の原因があるのかも。", "face": "u843"}, {"name": "アンナ", "text": "周辺の村のためにも、\n急いでこの事件を解決しないといけませんね。\n王子、森の奥へ急ぎましょう！", "face": "lb3fb7f0a421f"}]}], "active": true}