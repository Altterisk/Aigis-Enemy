 "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 87}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 2, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 170, "attack_speed": 70, "attack_wait": 40, "attack_interval": 153, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143072, "race_id": 16, "change_to": 5, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 35960, "global_id": 9577, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 98}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1500, "attack": 100, "base_hp": 1500, "base_attack": 100, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2102912, "master_id": 404, "global_id": 403, "from_condition": 2, "spawned_on_death_by": [5, 7, 9, 10]}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 2, "hp": 8800, "attack": 650, "base_hp": 8800, "base_attack": 650, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 48, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143104, "race_id": 16, "special_effect_id": 54, "change_to": 5, "change_condition": 2, "master_id": 35963, "global_id": 9580, "to_condition": 2, "to_global_id": 403, "spawn_sec": 111}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 157}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 2, "hp": 14000, "attack": 450, "base_hp": 14000, "base_attack": 450, "damage_type": "physical", "armor_defense": 350, "magic_defense": 15, "attack_range": 160, "attack_wait": 10, "attack_interval": 79, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143120, "special_effect_id": 1286, "change_to": 5, "change_condition": 2, "missile_id": 45, "master_id": 35973, "global_id": 9590, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 161}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 2, "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 60, "attack_interval": 193, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143088, "race_id": 16, "special_effect_id": 818, "change_to": 5, "change_condition": 2, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 35961, "global_id": 9578, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 177}], "popups": ["\n\n\n\n　――セーレの居城、貴族の間"], "dialogue": [{"trigger": "battle", "at_sec": 54, "lines": [{"text": "――セーレの居城、貴族の間"}, {"name": "グリム", "text": "はい、とうちゃくでーす。\nセーレの居城、次元の狭間の奥ですー。", "face": "u942"}, {"name": "ルキファ", "text": "……嫌な空気だ。\n魔力が、どこかへ吸い上げられている。", "face": "u1621a1"}, {"name": "エフネ", "text": "見てください、あそこ……人が捕まってます！", "face": "u969"}, {"name": "エスネア", "text": "異界からさらわれた人たちだよ！\n魔力を吸われてるみたい！", "face": "u997"}, {"name": "シィル", "text": "ひどい……！", "face": "u2900a1"}, {"name": "リア", "text": "セーレの狙いは魔力炉ね。\nさらった人の魔力を炉に送って、完全体になる気だわ。", "face": "u2901a1"}, {"name": "貴族セーレ", "text": "クックック……よく来たな、ランス、王子。", "face": "l70921f716695"}, {"name": "貴族セーレ", "text": "見ろ。この者たちの魔力を炉に注ぎ、\n紛い物を吸収し、私は真の魔神として蘇るのだ。", "face": "l70921f716695"}, {"name": "ランス", "text": "御託はいらん。俺様は呪いを解きに来たのだ。\nとっとと死ね！", "face": "u2897a1"}, {"name": "貴族セーレ", "text": "相変わらず品のない男よ。\nさぁ眷属ども！　この者らを魔力炉の餌にせよ！", "face": "l70921f716695"}, {"name": "リア", "text": "リアも出るわ。\nダーリンに変な呪いをかけておいて、\nただで済むと思ってるのかしら？", "face": "u2901a1"}, {"name": "シィル", "text": "わ、私も！　ランス様のために頑張ります！", "face": "u2900a1"}]}, {"trigger": "end", "lines": [{"name": "貴族セーレ", "text": "ぐっ……おのれ、おのれぇ……！", "face": "l70921f716695"}, {"name": "貴族セーレ", "text": "ならば……さらった者どもを人質に――", "face": "l70921f716695"}, {"name": "貴族セーレ", "text": "……ん？　いない！？　どこへ消えた！", "face": "l70921f716695"}, {"name": "シルキィ", "text": "――ここよ。", "face": "u2902a1"}, {"name": "シルキィ", "text": "捕まっていた方々は、全員こちらで保護したわ。\nあなたが喋っている間にね。", "face": "u2902a1"}, {"name": "シィル", "text": "シルキィさん、いつの間に……！", "face": "u2900a1"}, {"name": "シルキィ", "text": "人質を取る戦法なんて、ありふれてるもの。\n先回りしただけよ。", "face": "u2902a1"}, {"name": "貴族セーレ", "text": "貴様、魔人……ホーネット派の魔人か……！", "face": "l70921f716695"}, {"name": "ランス", "text": "がははは！　シルキィちゃん、良い仕事だ！", "face": "u2897a1"}, {"name": "シルキィ", "text": "……ちゃん、はやめてほしいのだけど。", "face": "u2902a1"}, {"name": "貴族セーレ", "text": "ちっ……！　今回はここまでだ。\nだが、魔力炉は既に動いている！", "face": "l70921f716695"}, {"name": "グリム", "text": "あっ、また逃げました。\nほんとに逃げ足だけは一級品ですねー。", "face": "u942"}, {"name": "アンナ", "text": "王子、まずは救出した方々を安全な場所へ。\nそれから、もうひとりのセーレを追いましょう！"}, {"name": "ルキファ", "text": "魔力の流れは、あちらだ。\n……丸い方――えぇと、ハニーの方と言うべきか。", "face": "u1621a1"}]}], "active": true}