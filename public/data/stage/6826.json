{"quest_id": 6826, "name": "森の貪食者", "description": "魔剣に導かれ、洞窟を抜けた王子一行は\n魔の森へと至る。再生能力を持った森の\n大喰らい『マンイーター』を排除せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "白き姫と魔獣の剣", "event_category": "History", "mission_id": 920131, "map_no": 3420, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 15, "form_count": 1, "hp": 3000, "attack": 220, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118448, "race_id": 18, "special_effect_id": 372, "change_to": 1, "change_condition": 1, "master_id": 31713, "global_id": 5332, "variants": [{"hp": 3000, "attack": 220, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118464, "race_id": 18, "master_id": 31714, "global_id": 5333}]}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "tags": ["植物"], "hp": 12000, "attack": 850, "base_hp": 12000, "base_attack": 850, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_wait": 50, "attack_interval": 139, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119376, "special_effect_id": 400, "master_id": 31845, "global_id": 5464}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 1, "tags": ["植物"], "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "g