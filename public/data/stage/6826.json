0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100672, "race_id": 13, "special_effect_id": 64, "change_to": 8, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 31846, "global_id": 5465, "ranged": true, "variants": [{"hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_wait": 1, "attack_interval": 43, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100688, "race_id": 13, "special_effect_id": 64, "master_id": 31847, "global_id": 5466}], "spawn_sec": 172}], "popups": ["異界の虫はHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――ようやく洞窟を抜けましたが、\nここはいったい……？", "face": "lb3fb7f0a421f"}, {"name": "ピリカ", "text": "がう……すごい魔力……。\nボクの剣もびりびりって反応してる……！", "face": "u843"}, {"name": "アイーダ", "text": "ここはまさか、魔の森か……？\nあの洞窟がここに繋がっていたとはな。", "face": "u381"}, {"name": "アンナ", "text": "魔の森……！\nベルゼビュートが封印されていた場所ですね……。", "face": "lb3fb7f0a421f"}, {"name": "アイーダ", "text": "そして私の古巣というわけだ。\nそれにしても、あの頃よりも随分と魔力が濃い。\n何かが起きているのは間違いなさそうだ。", "face": "u381"}, {"name": "ピリカ", "text": "がう……？\n何だか森がざわざわして――", "face": "u843"}]}, {"trigger": "start", "lines": [{"name": "エイル", "text": "あれは……異界の虫！！\n以前に世界樹で見たのと同じ虫です！", "face": "u804"}, {"name": "アイーダ", "text": "それに、あの通路を塞いでいる魔物は\nマンイーターだな……。", "face": "u381"}, {"name": "ピリカ", "text": "まんいーたー……？\nひ、人を食べるの……！？", "face": "u843"}, {"name": "アイーダ", "text": "食べるかどうかはともかく、襲ってくるのは確かだ。\n王子、気をつけろよ。マンイーターは\n受けた傷を再生する能力を持っているんだ。", "face": "u381"}, {"name": "アイーダ", "text": "だが、治癒能力の活性化も長時間は保たないらしい。\nマンイーターの対処が難しければ、\n他の魔物を倒した後に回すのも手かもしれないぞ。", "face": "u381"}, {"name": "ピリカ", "text": "がう……！　王子のお兄ちゃん、\n剣はこの森の奥に、ボクを導こうとしてる。\nここを突破するのに、力を貸して……！", "face": "u843"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "エイル", "text": "まさか、異界の虫が魔の森にいるなんて……。", "face": "u804"}, {"name": "ラテリア", "text": "……魔の森の魔力が高まっている原因にも、\nこれで見当がついたってものさ。", "face": "u532"}, {"name": "アイーダ", "text": "ああ。この森の中で\n異界の門が開かれたに違いない。", "face": "u381"}, {"name": "シャディア", "text": "……つまり、今回の首謀者は魔王軍、\nそして異界召喚士ということだろうな。\n王子、先を急いだ方が良さそうだ。", "face": "u713"}, {"name": "ピリカ", "text": "がう……！！\n王子のお兄ちゃん、剣も早く早くって急かしてるみたい。\nもしかしたら時間がもう無いのかも……！！", "face": "u843"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ピリカ", "text": "剣はこっちだって言ってる……。\n皆、ボクについてきて……！！", "face": "u843"}]}], "active": true}