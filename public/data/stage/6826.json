"magic_defense": 50, "attack_range": 180, "attack_wait": 1, "attack_interval": 73, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100672, "race_id": 13, "special_effect_id": 64, "change_to": 8, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 31846, "global_id": 5465, "ranged": true, "variants": [{"hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_wait": 1, "attack_interval": 43, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100688, "race_id": 13, "special_effect_id": 64, "master_id": 31847, "global_id": 5466}], "spawn_sec": 172}], "popups": ["異界の虫はHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――ようやく洞窟を抜けましたが、\nここはいったい……？", "face": "le4da4fde4f27"}, {"name": "ピリカ", "text": "がう……すごい魔力……。\nボクの剣もびりびりって反応してる……！", "face": "u843"}, {"name": "アイーダ", "text": "ここはまさか、魔の森か……？\nあの洞窟がここに繋がっていたとはな。", "face": "u381"}, {"name": "アンナ", "text": "魔の森……！\nベルゼビュートが封印されていた場所ですね……。", "face": "le4da4fde4f27"}, {"name": "アイーダ", "text": "そして私の古巣というわけだ。\nそれにしても、あの頃よりも随分と魔力が濃い。\n何かが起きているのは間違いなさそうだ。", "face": "u381"}, {"name": "ピリカ", "text": "がう……？\n何だか森がざわざわして――", "face": "u843"}]}, {"trigger": "start", "lines": [{"name": "エイル", "text": "あれは……異界の虫！！\n以前に世界樹で見たのと同じ虫です！", "face": "u804"}, {"name": "アイーダ", "text": "それに、あの通路を塞いでいる魔物は\nマンイーターだな……。", "face": "u381"}, {"name": "ピリカ", "text": "まんいーたー……？\nひ、人を食べるの……！？", "face": "u843"}, {"name": "アイーダ", "text": "食べるかどうかはともかく、襲ってくるのは確かだ。\n王子、気をつけろよ。マンイーターは\n受けた傷を再生する能力を持っているんだ。", "face": "u381"}, {"name": "アイーダ", "text": "だが、治癒能力の活性化も長時間は保たないらしい。\nマンイーターの対処が難しければ、\n他の魔物を倒した後に回すのも手かもしれないぞ。", "face": "u381"}, {"name": "ピリカ", "text": "がう……！　王子のお兄ちゃん、\n剣はこの森の奥に、ボクを導こうとしてる。\nここを突破するのに、力を貸して……！", "face": "u843"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "エイル", "text": "まさか、異界の虫が魔の森にいるなんて……。", "face": "u804"}, {"name": "ラテリア", "text": "……魔の森の魔力が高まっている原因にも、\nこれで見当がついたってものさ。", "face": "u532"}, {"name": "アイーダ", "text": "ああ。この森の中で\n異界の門が開かれたに違いない。", "face": "u381"}, {"name": "シャディア", "text": "……つまり、今回の首謀者は魔王軍、\nそして異界召喚士ということだろうな。\n王子、先を急いだ方が良さそうだ。", "face": "u713"}, {"name": "ピリカ", "text": "がう……！！\n王子のお兄ちゃん、剣も早く早くって急かしてるみたい。\nもしかしたら時間がもう無いのかも……！！", "face": "u843"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "ピリカ", "text": "剣はこっちだって言ってる……。\n皆、ボクについてきて……！！", "face": "u843"}]}], "map": {"image": "Map920131_3420", "w": 960, "h": 640, "spots": [{"k": "b", "x": 510, "y": 229}, {"k": "m", "x": 421, "y": 257, "id": 200}, {"k": "m", "x": 491, "y": 416, "id": 201}, {"k": "m", "x": 396, "y": 397, "id": 202}, {"k": "m", "x": 312, "y": 369, "id": 203}, {"k": "m", "x": 243, "y": 309, "id": 204}, {"k": "m", "x": 179, "y": 240, "id": 205}, {"k": "m", "x": 101, "y": 239, "id": 206}, {"k": "m", "x": 235, "y": 184, "id": 207}, {"k": "m", "x": 306, "y": 127, "id": 208}, {"k": "m", "x": 742, "y": 166, "id": 209}, {"k": "m", "x": 747, "y": 239, "id": 210}, {"k": "m", "x": 765, "y": 318, "id": 211}, {"k": "m", "x": 785, "y": 400, "id": 212}, {"k": "m", "x": 692, "y": 421, "id": 213}, {"k": "m", "x": 585, "y": 421, "id": 214}, {"k": "m", "x": 366, "y": 192, "id": 215}, {"k": "m", "x": 530, "y": 313, "id": 216}, {"k": "m", "x": 539, "y": 372, "id": 217}, {"k": "m", "x": 367, "y": 87, "id": 218}, {"k": "m", "x": 866, "y": 420, "id": 219}, {"k": "m", "x": 809, "y": 138, "id": 220}, {"k": "r", "x": 379, "y": 290, "id": 300}, {"k": "r", "x": 395, "y": 450, "id": 301}, {"k": "r", "x": 609, "y": 468, "id": 302}, {"k": "r", "x": 751, "y": 463, "id": 303}, {"k": "r", "x": 850, "y": 339, "id": 304}, {"k": "r", "x": 739, "y": 89, "id": 305}, {"k": "r", "x": 430, "y": 350, "id": 306}, {"k": "r", "x": 127, "y": 173, "id": 307}, {"k": "r", "x": 614, "y": 277, "id": 30