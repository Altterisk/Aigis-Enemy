age_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 138}, {"enemy_id": 15, "source": "local", "count": 7, "form_count": 1, "tags": ["鳥"], "hp": 1200, "base_hp": 2000, "damage_type": "physical", "armor_defense": 30, "magic_defense": 5, "attack_speed": 1, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2144624, "race_id": 11, "master_id": 36232, "global_id": 9849, "spawn_sec": 206}, {"enemy_id": 16, "source": "local", "count": 7, "form_count": 1, "tags": ["鳥"], "hp": 4800, "base_hp": 8000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 1, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2144640, "race_id": 11, "master_id": 36233, "global_id": 9850, "spawn_sec": 252}, {"enemy_id": 17, "source": "local", "count": 8, "form_count": 1, "hp": 1800, "attack": 240, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107376, "race_id": 6, "master_id": 572, "global_id": 571, "spawn_sec": 327}, {"enemy_id": 18, "source": "local", "count": 8, "form_count": 2, "tags": ["アーマー"], "hp": 1500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124192, "race_id": 20, "change_to": 18, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32923, "global_id": 6540, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6543, "spawn_sec": 338}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 1500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124208, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32926, "global_id": 6543, "ranged": true, "from_condition": 4, "trigger_ticks": 3}], "popups": ["神獣フギンがいる間は\n全ての敵の攻撃力が\nアップします。", "神獣ムニンがいる間は\n全ての敵の防御力が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "バスティス", "text": "──にゃー！？　やーっと戻ってきたにゃ！！", "face": "u1892a1"}, {"name": "イコル", "text": "やぁバスティス、神獣とのおしゃべりは楽しかったかい？", "face": "u1988a1"}, {"name": "バスティス", "text": "まっっっったく楽しくにゃかったが？\nこいつら二羽とも性格が暗すぎるにゃ！\nアスガルドの連中って全員こうなのにゃ？", "face": "u1892a1"}, {"name": "イコル", "text": "はっはっはっは、ヌンの黒猫風情がほざくじゃないか。\nでもまあ助かったよ、おかげで時間稼ぎにはなった。", "face": "u1988a1"}, {"name": "フギン", "text": "イコルか……よくもまあここまで小細工を弄すものだ。", "face": "l3d7049ae27bd"}, {"name": "コレット", "text": "（あれが、アスガルドの神獣フギンとムニン……！）", "face": "u1615a1"}, {"name": "イコル", "text": "それぐらいしか取り柄がないものでね。\nバスティスとの話し合いは有益だったかい？", "face": "u1988a1"}, {"name": "フギン", "text": "我らが眠っていた間のあらましは全て聞いた。\nだが、その上で我らの返答は変わらぬ。", "face": "l3d7049ae27bd"}, {"name": "フギン", "text": "我が唯一にして絶対の王は此処に無く──", "face": "l3d7049ae27bd"}, {"name": "ムニン", "text": "──我が怒りの矛先すらも既に無い。", "face": "l3db6e4e86e96"}, {"name": "フギン/ムニン", "text": "ゆえに我らに意義は無く、この世に留まる理由も無し。", "face": "l2c6ad32f0d44"}, {"name": "イコル", "text": "はいはい、堂々巡りね。では問おう、智の神の使徒よ。\nお前たちはなぜ己が物質界にいるか考えたことはあるか？", "face": "u1988a1"}, {"name": "フギン", "text": "………………。", "face": "l3d7049ae27bd"}, {"name": "イコル", "text": "どうしてウォーディーンはお前たちを遠ざけた？\nディアスのアスガルド侵攻直前に物質界へ送り出し、\n戦いが始まってからも呼び戻すことをしなかった。", "face": "u1988a1"}, {"name": "イコル", "text": "つまり、あいつは確固たる意思で『そう』したんだ。", "face": "u1988a1"}, {"name": "ムニン", "text": "既に我が王は先に旅立たれてしまわれたのだ。\n今さら我らがその崇高なお考えを知る由もない。", "face": "l3db6e4e86e96"}, {"name": "イコル", "text": "いいや、ぼくは完璧に理解している。\nあいつはな、人類に託したかったんだよ。\n理不尽な困難に立ち向かうための力を！", "face": "u1988a1"}, {"name": "イコル", "text": "そう、フギンムニンという強大な戦力をな！", "face": "u1988a1"}, {"name": "フギン", "text": "それはお前の勝手な解釈だ。願望と言っても良い。", "face": "l3d7049ae27bd"}, {"name": "イコル", "text": "ああ、確かにそうなのかもしれないな。\nでもな、お前たちにぼくの解釈が否定できるか？\n事実、グングニルとドラウプニルはこちらにある。", "face": "u1988a1"}, {"name": "イコル", "text": "あいつがお前たちの殉死を望んでいる根拠は？\n主人の死に際にも付き従えなかった使い魔が、\nどうしてぼくの解釈が間違っていると言い切れる？", "face": "u1988a1"}, {"name": "フギン", "text": "………………。", "face": "l3d7049ae27bd"}, {"name": "コレット", "text": "（うわぁ、悪魔の証明……）", "face": "u1615a1"}, {"name": "バスティス", "text": "デリカシーとかにゃーのか？", "face": "u1892a1"}, {"name": "イコル", "text": "それともウォーディーンの解釈バトルでもするか？\nぼくには三日三晩だろうが付き合う用意があるぞ。", "face": "u1988a1"}, {"name": "フギン", "text": "……やめておく、弁舌でお前に勝てる気はしない。\nそれよりもずっと単純で、明快な方法があるはずだ。", "face": "l3d7049ae27bd"}, {"name": "イコル", "text": "（──釣れたッ！）", "face": "u1988a1"}, {"name": "ムニン", "text": "王子、といったか。", "face": "l3db6e4e86e96"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "フギン/ムニン", "text": "今は亡き我が王の御名においてフギン/ムニンが問う。", "face": "l2c6ad32f0d44"}, {"name": "フギン/ムニン", "text": "汝その卑小なる人の身にて、我が器に足り得るか──！", "face": "l2c6ad32f0d44"}, {"name": "イコル", "text": "あとはぶん殴って躾けてやるだけだ！　行け、王子！", "face": "u1988a1"}]}], "active": true}