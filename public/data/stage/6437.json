{"quest_id": 6437, "name": "錬金講師の新薬", "description": "レーレンの新薬を試さんと、模擬戦を\n行う王子達。実験の成果は如何に……。\n＜物理威力減少：中＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["物理威力減少：中"], "event": "アルケミスト・ドクトリン", "event_category": "History", "mission_id": 920107, "map_no": 5323, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 23, "params": [50]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 1000, "attack": 200, "base_hp": 1000, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 120, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104048, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 490, "global_id": 489, "ranged": true, "spawn_sec": 23}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 20, "attack_interval": 111, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100544, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 250, "global_id": 249, "ranged": true, "spawn_sec": 24}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 560, "base_hp": 6000, "base_attack": 560, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 260, "attack_speed": 70, "attack_wait": 60, "attack_interval": 251, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100528, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id"