ount": 6, "form_count": 1, "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 70, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 46, "global_id": 45, "spawn_sec": 148}, {"enemy_id": 13, "source": "local", "count": 5, "form_count": 1, "hp": 3500, "attack": 400, "base_hp": 3500, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 162, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 47, "global_id": 46, "spawn_sec": 156}, {"enemy_id": 14, "source": "local", "count": 6, "form_count": 1, "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 49, "global_id": 48, "ranged": true, "spawn_sec": 168}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30717, "global_id": 4336, "ranged": true, "spawn_sec": 182}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 950, "base_hp": 8000, "base_attack": 950, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 40, "attack_wait": 30, "attack_interval": 133, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102272, "race_id": 16, "special_effect_id": 222, "master_id": 30397, "global_id": 4016, "spawn_sec": 182}], "popups": ["『錬金講師の新薬』では\n味方ユニットの物理攻撃で\n与えるダメージが半減します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ジョヴァンニ", "text": "いやぁ～、ロイ先生の『サバイバルで使える魔術』も\nなかなか面白かったなぁ！", "face": "u611"}, {"name": "メーリス", "text": "そんなタイトルの授業じゃなかったでしょ。\nさてはジョヴァンニ、あんたまた寝てたわね？", "face": "u609"}, {"name": "ネーニャ", "text": "王子たちが視察に来てるときに、\nしかも課外授業で寝るなんて、ある意味すごいよね。", "face": "u610"}, {"name": "ジョヴァンニ", "text": "寝れる時に寝る、それが海賊っつぅもんよ！\n――お、向こうにいるのレーレン先生じゃねえか？", "face": "u611"}, {"name": "レーレン", "text": "おう、あたしの可愛い生徒たちじゃねーか！\nちょいとこっちに来てくれよ。", "face": "u614"}, {"name": "アンナ", "text": "おや、レーレンさん。随分と賑やかですね。"}, {"name": "レーレン", "text": "いや～、あたしの錬金術士としての最新の研究成果を\nみんなに披露させてもらおうかと思ったんだけどね。", "face": "u614"}, {"name": "レーレン", "text": "味方を強化する新薬の試作品を開発したんで\n実戦で効果の程を見せたかったんだが、\nあいにく使う相手がいなくてさぁ。", "face": "u614"}, {"name": "ミレイユ", "text": "あら、でしたら私たちが\n模擬戦の相手をして差し上げましょうか。\nそうすれば薬の効果を生徒たちに示せるでしょう？", "face": "u386"}, {"name": "エスタ", "text": "ふふ、生徒さんと模擬戦だなんて面白そうですね。\n私も運動がてら参加させていただこうかしら。", "face": "u1187"}, {"name": "ケイティ", "text": "お二人とも……、\n本日は視察だけのご予定だったはずでは。", "face": "u114"}, {"name": "バルバストラフ", "text": "ふぉっふぉっ、そう形式張ることもなかろう。\nわしらも視察ばかりで退屈しとったところじゃ。", "face": "u1063"}, {"name": "レーレン", "text": "みんな……恩に着るぜ！\nそんじゃ、生徒たちの相手を\n務めてくれる人たちは集合してくれ。", "face": "u614"}, {"name": "レーレン", "text": "今から渡す薬を使えば鎧みたいに硬くなれるはずだ。\nだが、魔法での攻撃とか守りを貫通する攻撃とかは\n普通に食らうから、そこんとこは注意してくれよな！", "face": "u614"}, {"name": "ネーニャ", "text": "王子はあたしたちの組ね！\n武器とかでの攻撃は効きにくくなってるみたいだし、\nここはあたしの魔法に頼ってもいいのよ。", "face": "u610"}]}, {"trigger": "end", "lines": [{"name": "ジョヴァンニ", "text": "……ふぅーッ。\n銃とか剣とかでの攻撃が効きにくい相手っつぅのは、\n思ったより戦いづらいもんだなぁ。", "face": "u611"}, {"name": "メーリス", "text": "逆に言えば、レーレン先生の新薬があれば\n魔物の攻撃もあんまり痛くなくなるってことよね？\n錬金術ってすごいなぁ。", "face": "u609"}, {"name": "モーティマ", "text": "あぁ、大したもんだぜ。\nおいチビっ子、もっとすげえ薬はねえのかよ？", "face": "u14"}, {"name": "レーレン", "text": "チビっ子言うな、怪獣おじさん。\nだが、さらに味方を強化する薬ならここにあるぜ。", "face": "u614"}, {"name": "モーティマ", "text": "ほう、そいつはすげえじゃねえか。\nどれ、このモーティマ様に……。", "face": "u14"}, {"name": "レーレン", "text": "ダメだ。この薬はまだまだ開発中で……\n――って、おい！　勝手に取るなーっ！", "face": "u614"}, {"name": "モーティマ", "text": "うおおおおおッ！　すっげーッ！\nさっきよりもさらに力が湧いてきたぜーッ！", "face": "u14"}, {"name": "レーレン", "text": "あちゃー、もう使っちゃったか。\nまぁ、あの様子なら研究は成功ってとこかな。", "face": "u614"}, {"name": "サイラス", "text": "ならば私も頂いて良いかな？\n学園の未来を担うかもしれぬ、\n若き錬金術士殿の才腕を身をもって知りたいのでね。", "face": "u1013"}, {"name": "レーレン", "text": "ったく、仕方ねーな。\n新薬を試してみたいやつは並んでくれ。\n結果がどうなっても自己責任で頼むぜ？", "face": "u614"}, {"name": "レーレン", "text": "……って、さっき薬使ったやつ全員かよ！\nこうなりゃあたしも使ってやるぜ！　うりゃーっ！　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　", "face": "u614"}, {"name": "レーレン", "text": "――ふぅ。これでよし、と。\nみんな、休憩したらもっかい模擬戦してくれるか？\n試作品の効果を確かめたいからさ。", "face": "u614"}, {"name": "アンナ", "text": "わかりました。\n王子、後ほどお相手して差し上げましょう。"}]}], "story_talk": true, "active": true}