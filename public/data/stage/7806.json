r_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105120, "race_id": 14, "change_to": 7, "change_condition": 5, "master_id": 602, "global_id": 601, "phases": [{"hp": 2000, "attack": 200, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105136, "race_id": 14, "master_id": 603, "global_id": 602, "condition": 5}], "spawn_sec": 183}], "popups": ["神獣玉兎の第一形態は、\n傷ついた周囲の敵を\n自身の攻撃力の値で\n回復します。\n\n\n\n　　　　　　(1/2)", "神獣玉兎の第一形態がいる間は\n妖怪属性の敵の攻撃と防御が\nアップします。\n\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "battle", "at_sec": 14, "lines": [{"name": "ラテリア", "text": "――神獣玉兎。\nうさぎっていうから、\nシュシュみたいな可愛い子を想像してたけど……。", "face": "u532"}, {"name": "シュシュ", "text": "うっわぁ！　すごい貫禄ですよー！", "face": "u656"}, {"name": "ケイティ", "text": "でも、どこか悲しそうな顔をしていますね……。\nやっぱり、誰も訪ねてこないのは、\n神獣でも寂しさを感じるものなのでしょうか。", "face": "u114"}, {"name": "ラテリア", "text": "祝祭の伝統を忘れられてしまった、\n可哀想な神獣さま、か。\nせめて僕らで、奉納相撲の相手をしてあげよう。", "face": "u532"}, {"name": "ニミュエ", "text": "忘れられるって寂しいですものねー……。", "face": "u1175a1"}, {"name": "アンブローズ", "text": "…………。", "face": "u1088a1"}, {"name": "ニミュエ", "text": "今のは嫌味じゃないので、\nそんな顔しないでくださいねー。", "face": "u1175a1"}, {"name": "ニミュエ", "text": "ただ、ずっと誰かを待っていて、\nでもその誰かが来てくれないというのは、\nただただ、悲しいことだと思うんです。", "face": "u1175a1"}, {"name": "アンブローズ", "text": "……あたしたちで、祝祭を受け継ぎましょう。\nさぁ王子ちゃん、神獣玉兎との奉納相撲、\n全力でぶち当たっていきますよぉ！", "face": "u1088a1"}]}, {"trigger": "route", "lines": [{"name": "シュシュ", "text": "――あれ？\nなんだか玉兎さんの雰囲気が変わりました？", "face": "u656"}, {"name": "キャロップ", "text": "怒ってる……いや、興奮してる？", "face": "u698"}, {"name": "バイン", "text": "これが伝承にある、\n自分も戦いたくなっちゃったモードなんじゃない！？", "face": "u712"}, {"name": "レーヴ", "text": "王子、神獣玉兎が仲間への支援をやめて、\nこっちに突っ込んできます！", "face": "u454"}, {"name": "レーヴ", "text": "強力な障壁をまとっていますから、\n弱い攻撃では傷すら付けられないはずです。\n全力で火力を集中してください……！！", "face": "u454"}]}], "map": {"image": "Map9265", "w": 960, "h": 640, "spots": [{"k": "b", "x": 15, "y": 473}, {"k": "m", "x": 145, "y": 471, "id": 200}, {"k": "m", "x": 236, "y": 445, "id": 201}, {"k": "m", "x": 335, "y": 429, "id": 202}, {"k": "m", "x": 422, "y": 435, "id": 203}, {"k": "m", "x": 517, "y": 450, "id": 204}, {"k": "m", "x": 617, "y": 458, "id": 205}, {"k": "m", "x": 717, "y": 459, "id": 206}, {"k": "m", "x": 806, "y": 462, "id": 207}, {"k": "m", "x": 257, "y": 363, "id": 208}, {"k": "m", "x": 256, "y": 296, "id": 209}, {"k": "m", "x": 250, "y": 230, "id": 210}, {"k": "m", "x": 237, "y": 159, "id": 211}, {"k": "m", "x": 297, "y": 106, "id": 212}, {"k": "m", "x": 370, "y": 68, "id": 213}, {"k": "m", "x": 167, "y": 123, "id": 214}, {"k": "m", "x": 91, "y": 97, "id": 215}, {"k": "m", "x": 377, "y": 351, "id": 216}, {"k": "m", "x": 425, "y": 311, "id": 217}, {"k": "m", "x": 466, "y": 269, "id": 218}, {"k": "m", "x": 510, "y": 229, "id": 219}, {"k": "m", "x": 554, "y": 182, "id": 220}, {"k": "r", "x": 103, "y": 410, "id": 300}, {"k": "r", "x": 198, "y": 386, "id": 301}, {"k": "r", "x": 153, "y": 216, "id": 302}, {"k": "r", "x": 92, "y": 166, "id": 303}, {"k": "r", "x": 338, "y": 232, "id": 304}, {"k": "r", "x": 341, "y": 167, "id": 305}, {"k": "r", "x": 403, "y": 202, "id": 306}, {"k": "r", "x": 582, "y": 342, "id": 307}, {"k": "r", "x": 499, "y": 392, "id": 308}, {"k": "r", "x": 748, "y": 397, "id": 309}, {"k": "r", "x": 660, "y": 514, "id": 310}]}, "active": true, "story_talk": true}