id": 25, "source": "local", "count": 1, "form_count": 1, "hp": 4800, "attack": 150, "base_hp": 4800, "base_attack": 150, "damage_type": "magical", "armor_defense": 60, "magic_defense": 15, "attack_range": 240, "attack_speed": 1, "attack_wait": 50, "attack_interval": 173, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123120, "race_id": 16, "special_effect_id": 319, "change_to": 25, "change_condition": 1, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33167, "global_id": 6784, "ranged": true, "variants": [{"hp": 4200, "attack": 150, "base_hp": 4200, "base_attack": 150, "damage_type": "magical", "armor_defense": 60, "magic_defense": 15, "attack_range": 240, "attack_speed": 1, "attack_wait": 50, "attack_interval": 173, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123120, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33168, "global_id": 6785, "ranged": true}], "spawn_sec": 177}, {"enemy_id": 27, "source": "local", "count": 5, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 44, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2137888, "change_to": 27, "master_id": 35013, "global_id": 8630, "to_global_id": 8631, "spawn_sec": 180}, {"enemy_id": 27, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 44, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2137888, "special_effect_id": 1069, "master_id": 35014, "global_id": 8631}, {"enemy_id": 29, "source": "local", "count": 36, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 29, "master_id": 986, "global_id": 985, "to_global_id": 987, "spawn_sec": 183}, {"enemy_id": 29, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 28, "master_id": 988, "global_id": 987}], "popups": ["スイカは拠点には向かわず、\n倒さなくても★の評価には\n影響しません。 \n\nまたスイカがいる間、\n敵がスイカの近くを通過すると\nスイカを食べて\nHPを大きく回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "客Ａ", "text": "どけッ、ミーハー共がよ！！\n俺は歴史オタクだぞッ！！\nお前らとは偉人を推してきた年季が違うんだよォー！！", "face": "l77f10aaae876"}, {"name": "客Ｂ", "text": "お前それ王国の王子の前でも言えんの？\nオタクは真夏の砂浜みてぇな過酷な環境に来ないで、\n日陰で歴史書でも読んでるんだなァーッ！！", "face": "l73da0a119c40"}, {"name": "一般兵", "text": "新しい模擬戦会場はここですか？", "face": "u65"}, {"name": "少女", "text": "あ～有名人に接客されてぇなぁ～。\nそのことをいずれ生まれてくる子どもや孫に、\n一生涯自慢し続けてぇなぁ～。", "face": "l717c3dd2f604"}, {"name": "帝国騎士", "text": "模擬戦ひとつもらえますか？", "face": "l260442328e4d"}, {"name": "徐華", "text": "いやはや、揉めまくっておるな。\nなにやら変な客も混ざっているようじゃが……。", "face": "u2850a1"}, {"name": "ハリンヘイム", "text": "全員変ではあったでしょう。", "face": "u2839a1"}, {"name": "ダグマール", "text": "どんどんヒートアップしていっていますね。\nこのままですと暴動に発展する可能性が高そうです。", "face": "u2843a1"}, {"name": "ヘイズル", "text": "はぁ……善意で店の手伝いをした結果、\nこんな事態に陥るなんてね。", "face": "u2836a1"}, {"name": "徐華", "text": "自分たちの知名度と人気の高さを、\n低く見積もりすぎておったようじゃな。", "face": "u2850a1"}, {"name": "ホルミース", "text": "白の帝国の初代皇帝と初代騎士団長。\n華の国の設計者の亜神に、偉大なる仙人。\nそれから王国の初代副司令官……。", "face": "u2834a1"}, {"name": "ホルミース", "text": "その他、風神雷神の娘たちに、号砲の亜神などなど。\n……人々が押し寄せるのも納得の面々ですね。", "face": "u2834a1"}, {"name": "ヴィラヘルム", "text": "こうして多くの人に慕われるのは嬉しいことですが、\nさすがにこれは看過できません。", "face": "u2835a1"}, {"name": "徐華", "text": "あとまぁ、普通に店の迷惑になるからのう。", "face": "u2850a1"}, {"name": "徐華", "text": "責任を取って……というのも変な話じゃが、\n海の家の臨時手伝いとして、一働きしてやろうかのう！", "face": "u2850a1"}]}, {"trigger": "battle", "at_sec": 149, "lines": [{"name": "アブグルント", "text": "お客さんたちの勢いが弱まってきたわね。", "face": "u2840a1"}, {"name": "ハリンヘイム", "text": "まだまだ暴れている人たちはいますが、\nこの調子なら問題なく鎮圧できそうです。", "face": "u2839a1"}, {"name": "徐華", "text": "……いや、そう上手くはいかないようじゃ。\nとんちきなのがやって来たぞ。", "face": "u2850a1"}, {"name": "スイカの魔物", "text": "――スイ。", "face": "lf3152fb903f2"}, {"name": "レミィ", "text": "す、スイカの魔物！？　どうしてここに……！？", "face": "u2837a1"}, {"name": "スイカの魔物", "text": "夏といえば海、海といえばスイカ。\nならば浜辺に我々がいることはなにも不思議ではないスイ。", "face": "lf3152fb903f2"}, {"name": "スイカの魔物", "text": "それともなんでスイ？\nビフロンス様が消滅してしまったせいで、\nもう頑張る理由もなくなったスイカたちを嗤ってるスイ？", "face": "lf3152fb903f2"}, {"name": "クーコ", "text": "あぁ……そういえばスイカの魔物も、\n魔神ビフロンスを信仰してたわね……。", "face": "u2837a1"}, {"name": "スイカの魔物", "text": "ビフロンス様がいなくなった今、\n我々は自分のスイカ生を歩くことになったスイ。", "face": "lf3152fb903f2"}, {"name": "スイカの魔物", "text": "スイカの生き方とはなにか、生きる意味とはなにか。\n答えのないスイカ哲学を考え続けていたある日、\n我々はスイカ割りでかち割られるスイカを目撃したスイ。", "face": "lf3152fb903f2"}, {"name": "スイカの魔物", "text": "そのとき気づいたスイ。\n人間とスイカは相容れないスイ。\nスイカは人間を打倒しなければならないスイ……！", "face": "lf3152fb903f2"}, {"name": "ホルミース", "text": "言われてみると確かに、スイカ視点のスイカ割りは、\nとても残酷な遊びに見えそうですね。", "face": "u2834a1"}, {"name": "スイカの魔物", "text": "そうだスイ！　スイカたちは人間を許さないスイ！\nだからこの場の人間たちを倒してやるスイ！", "face": "lf3152fb903f2"}, {"name": "スイカの魔物", "text": "そう、スイカを販売していた海の家の人間たちのように！\nみんなの両手首を捻り上げて、\n二度とスイカ割りできなくしてやるスイ！", "face": "lf3152fb903f2"}, {"name": "ヘイズル", "text": "まさか、従業員たちの両手首捻挫の原因は……！\nスイカの仕入れの際の事故って、そういうことか……！", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "この魔物に襲われたせいで、\n海の家は営業できなくなったのですね。", "face": "u2835a1"}, {"name": "スイカの魔物", "text": "そのとおりだスイ！\nただ、手伝いが入ったのは予想外だったスイ！", "face": "lf3152fb903f2"}, {"name": "スイカの魔物", "text": "だから今度は海の家と王子たちを、\nかち割られたスイカみたいに粉々にして、\n確実に営業停止に追い込んでやるスイ！", "face": "lf3152fb903f2"}, {"name": "ホルミース", "text": "どうやら、スイカの魔物はやる気みたいですね。\nそれに見てください、スイカの甘い香りにつられて、\n虫の魔物たちが集まってきましたよ。", "face": "u2834a1"}, {"name": "ハリンヘイム", "text": "海の家に虫……最悪ですね。", "face": "u2839a1"}, {"name": "徐華", "text": "迷惑なスイカと衛生的によくない虫には、\nお引き取り願うとするかのう。", "face": "u2850a1"}, {"name": "スイカの魔物", "text": "そう簡単にはいかないスイ！\nスイカの底力を見せてやるスイ――！！", "face": "lf3152fb903f2"}]}, {"trigger": "end", "lines": [{"name": "スイカの魔物", "text": "ス、スイ……。\nもうダメ……スイ……。", "face": "lf3152fb903f2"}, {"name": "ダグマール", "text": "スイカの魔物の沈黙を確認。\nそれから人々も落ち着きを取り戻したようです。", "face": "u2843a1"}, {"name": "一般兵", "text": "実戦は終わりましたし、次は模擬戦ですか？", "face": "u65"}, {"name": "ダグマール", "text": "ずっと正気ではない者もいるようです。", "face": "u2843a1"}, {"name": "アブグルント", "text": "王国文化が生んだ悲しきモンスターね。", "face": "u2840a1"}, {"name": "ヘイズル", "text": "さて、これで作戦は終了か。\nなんだかどっと疲れた気がするよ。", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "ですが休むわけにはいきませんよ。", "face": "u2835a1"}, {"name": "ヴィラヘルム", "text": "私たちは店員として、\nまだまだお客さんたちの相手をしなければいけませんから。", "face": "u2835a1"}, {"name": "イムラウ", "text": "ふふっ、そうだったね。\n私たちは、海の家のお手伝いをするんだもん。", "face": "u2842a1"}, {"name": "徐華", "text": "これからまた働かねばならんのか……。\n儂はもう愛想よく接客する体力とかないぞ？", "face": "u2850a1"}, {"name": "ハリンヘイム", "text": "だとしてもですよ。\n臨時とはいえ店員なんですから、真剣に働かないと。", "face": "u2839a1"}, {"name": "ヴィディア", "text": "そもそもこの程度で疲れるほど、\n君はやわじゃないだろう。", "face": "u2841a1"}, {"name": "徐華", "text": "ぐぬぬ……どうやらサボれないようじゃのう。", "face": "u2850a1"}, {"name": "徐華", "text": "見つかってしまったのが運の尽きじゃ。\n仕方がないから、ほどほど真面目に働くとするかのう。", "face": "u2850a1"}, {"name": "ホルミース", "text": "では改めて、お店を開ける準備をしましょうか。\nほら王子様もお客さんの列に並んでください。", "face": "u2834a1"}, {"name": "ヘイズル", "text": "順番が来たら接客してあげるよ。\nそれまでに買いたい物とか決めておいてね。", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "食べ物や飲み物を色々と取り揃えていますから。\nたくさん買って売り上げに貢献してくださいね。", "face": "u2835a1"}, {"name": "徐華", "text": "さて、開店じゃ。", "face": "u2850a1"}, {"name": "徐華", "text": "儂らがこんなことをするのは、この夏だけじゃからな。\nしっかり目に焼き付けて、思い出にするのじゃぞ、王子♪", "face": "u2850a1"}]}], "active": true}