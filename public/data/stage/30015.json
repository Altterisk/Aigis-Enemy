, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111856, "race_id": 8, "special_effect_id": 233, "change_to": 16, "change_condition": 3, "master_id": 30626, "global_id": 4245, "to_condition": 3, "to_global_id": 4246, "spawn_sec": 386}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 400, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111872, "race_id": 8, "special_effect_id": 233, "master_id": 30627, "global_id": 4246, "from_condition": 3}, {"enemy_id": 18, "source": "local", "count": 15, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 350, "base_hp": 800, "base_attack": 350, "damage_type": "physical", "attack_speed": 40, "attack_wait": 40, "attack_interval": 161, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111760, "race_id": 9, "special_effect_id": 192, "master_id": 30629, "global_id": 4248, "spawn_sec": 395}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド", "機械"], "hp": 42000, "attack": 800, "base_hp": 42000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 150, "attack_interval": 466, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "pattern_id": 2127088, "special_effect_id": 763, "change_to": 19, "change_condition": 2, "master_id": 36453, "global_id": 10070, "to_condition": 2, "to_global_id": 10071, "spawn_sec": 424}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド", "機械"], "hp": 62000, "attack": 800, "base_hp": 62000, "base_attack": 800, "damage_type": "magical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 1, "attack_wait": 150, "attack_interval": 466, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "transform_resist": 1, "pattern_id": 2127104, "special_effect_id": 764, "master_id": 36454, "global_id": 10071, "from_condition": 2}, {"enemy_id": 21, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 35000, "attack": 1000, "base_hp": 35000, "base_attack": 1000, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111888, "race_id": 12, "special_effect_id": 233, "master_id": 30630, "global_id": 4249, "spawn_sec": 489}], "popups": ["アンデッド系から\n攻撃を複数回受けると、\n麻痺状態になります。", " 　　　悪天候：闇夜\n\n・敵の『移動速度』上昇", "チェインソン男は倒されると、\nその場で復活します。\n\n復活後、チェインソン男から\n攻撃を受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ハロウィン洗脳村人Ａ", "text": "ヒャッハー！　トリック・オア・右フック！\nトリック・オア・右フックゥ！\nどうだ、ボディにダメージが溜まってきただろ！", "face": "l910d0a6fea3d"}, {"name": "ハロウィン洗脳村人Ｂ", "text": "キエェェ―！　トリック・オア・ローキック！\nトリック・オア・ローキック！\n執拗に膝を狙っていくゥ！", "face": "la694b149543b"}, {"name": "村人", "text": "痛っ！　やめ……上等だァァーー！！\nそんなにハロウィンしたいならお菓子をくれてやるよォ！\nただしテメェらの血の味がするけどなァァーーッ！！", "face": "la3a8ec8464a6"}, {"name": "コレット", "text": "すでに乱闘が起こって……。\nなんでただの村人の方も殺気立っているんですか！？", "face": "u1937a1"}, {"name": "アンナ", "text": "現状は……バリケードを設置して凌いでいるようですね。\nですが外側に仮装した村人がおり、\nアンデッドと見分けがつかなくなっています。", "face": "l473d5d4c04bd"}, {"name": "ウィリアス", "text": "だったら話は簡単ね！\nみんなまとめて倒して、それから保護するわよ！", "face": "u1934a1"}, {"name": "？？？", "text": "そうは問屋とチェーンソーが卸さねェェ！\nギュイィィィィン！！\n俺たちの刃が回転数を上げていくゥゥ！！", "face": "l2ee2e2041d15"}, {"name": "コレット", "text": "な、なんですかコイツら！？\nチェーンソーを持った怪物たちが、\n会場を練り歩いていますよ……！？", "face": "u1937a1"}, {"name": "チェインソン男", "text": "俺たちはハロウィンでパワーアップしたアンデッド！\nチェインソン男とでも呼んでくれよなぁ！\n悪いが祝祭は暴力の祭典とさせてもらったぜ！！", "face": "l2ee2e2041d15"}, {"name": "ウィリアス", "text": "チェインソン男だかなんだか知らないけど、\nよくも祝祭をめちゃくちゃにしてくれたわね！\nみんなで頑張って準備してきたのに！", "face": "u1934a1"}, {"name": "チェインソン男", "text": "チェーンソッソッソォ！！\nいや……それに関しては本当にごめんって……。\n暴動が終わったら直すの手伝うから……。", "face": "l2ee2e2041d15"}, {"name": "クーコ", "text": "――賑やかな声が聞こえると思ったら、\nもうハロウィンが始まっていたのかしら？", "face": "u1935a1"}, {"name": "レミィ", "text": "みんな仮装して楽しそうじゃない！\n私たち、一歩遅れちゃったわね！", "face": "u1936a1"}, {"name": "コレット", "text": "あれは……レミィさんとクーコさん！\n助かりました！　かの雷神の娘と風神の娘である\n彼女たちがいれば百人力ですよ！", "face": "u1937a1"}, {"name": "レミィ", "text": "んん？　王子たちがいるってことは……分かったわ！\nこれはきっと模擬戦ね！", "face": "u1936a1"}, {"name": "クーコ", "text": "ふふっ。ハロウィンに相応しい、楽しい催しじゃない。\nそれなら王子くんたちと手合わせしましょうか♪", "face": "u1935a1"}, {"name": "コレット", "text": "終わった……！！", "face": "u1937a1"}, {"name": "ウィリアス", "text": "いいやまだよコレット！\nあっちがふたりなら、こっちもふたりでかかればいいわ！", "face": "u1934a1"}, {"name": "チェインソン男", "text": "させないぜッ！　喰らえ！！\nデスハロウィン洗脳ビームッ！！", "face": "l2ee2e2041d15"}, {"name": "ウィリアス", "text": "あばばばばばばば！？", "face": "u1934a1"}, {"name": "ウィリアス", "text": "ケヒャァー！！\nトリック・オア・疾風の翼！\nトリック・オア・疾風の翼ァ！", "face": "u1934a1"}, {"name": "コレット", "text": "ウィリアスさぁーーん！！", "face": "u1937a1"}, {"name": "チェインソン男", "text": "闇夜の時間が近づいているおかげで、\nアンデッドたちの動きも活発になってるぜ！\nいくぜみんなァ！　ハロウィンの時間だぜッ！", "face": "l2ee2e2041d15"}, {"name": "コレット", "text": "アンデッドたちが襲ってきます……！？\nちくしょう！　とんだハロウィンですよ！！", "face": "u1937a1"}]}, {"trigger": "end", "lines": [{"name": "チェインソン男", "text": "うっ、うわぁぁああぁぁぁぁ！！\n死んだぜッ！！！！", "face": "l2ee2e2041d15"}, {"name": "コレット", "text": "しゃあぁっ！　チェインソン男、爆散！！", "face": "u1937a1"}, {"name": "洗脳されていた村人Ａ", "text": "うぅ……俺たちは……いったい……？", "face": "la3a8ec8464a6"}, {"name": "ウィリアス", "text": "あれ……私、なにしてたのかしら……？", "face": "u1934a1"}, {"name": "シャルロット", "text": "チェインソン男が倒れたことで、\n皆さんの精神支配も解けたようですわね。", "face": "u128"}, {"name": "アンナ", "text": "通りすがりのシャルロットさん！！"}, {"name": "クーコ", "text": "……もしかしてだけど、\nさっきのは模擬戦ではなかったの……？", "face": "u1935a1"}, {"name": "レミィ", "text": "ええっ！　じゃあ私たち、\n悪いことしちゃったんじゃ……！", "face": "u1936a1"}, {"name": "王子", "text": "……（ふるふる）", "face": "u1"}, {"name": "コレット", "text": "お咎めなし、ですか。\nまったく、王子殿下は……。", "face": "u1937a1"}, {"name": "コレット", "text": "え……。\n会場を直して、ハロウィンを楽しもう、ですか？", "face": "u1937a1"}, {"name": "ウィリアス", "text": "名案じゃない！　お詫びもかねて、全力で頑張るわ！", "face": "u1934a1"}, {"name": "レミィ", "text": "そういうことなら私もやるわ！\n折角作った飾りが壊れたままっていうのも悲しいもの！", "face": "u1936a1"}, {"name": "クーコ", "text": "もちろん私も手伝うわよ。\nお姉ちゃんに任せてね。", "face": "u1935a1"}, {"name": "洗脳されていた村人Ｂ", "text": "だったら俺たちにも手伝わせてくれ！\nキエェェー！　詫びハロウィン準備だァーー！！", "face": "l8cea18673728"}, {"name": "村人", "text": "俺たちもやるぜ！\n村人の力を見せてやらァーー！！", "face": "la3a8ec8464a6"}, {"name": "チェインソン男", "text": "俺たちも直すの手伝うぜッ！", "face": "l2ee2e2041d15"}, {"name": "コレット", "text": "なんか変なのいませんでした？？？", "face": "u1937a1"}, {"name": "ウィリアス", "text": "細かいことはいいじゃない！\nみんなでハロウィンを楽しみましょう！", "face": "u1934a1"}, {"name": "コレット", "text": "……まぁ、賑やかでいいと思いましょうか。", "face": "u1937a1"}, {"name": "コレット", "text": "王子殿下、大変なハロウィンでしたから、\nあとでいっぱい、埋め合わせをしてくださいね。", "face": "u1937a1"}, {"name": "コレット", "text": "――トリック・オア・トリートです♪", "face": "u1937a1"}]}]}