{"quest_id": 30015, "name": "極級", "description": "・時間経過によるコスト回復なし\n・ＥＸＰ/ゴールド/ドロップなし\n・ライフが０でもミッションクリア\n", "event": "復刻2狂気！デスハロウィンカーニバル", "event_category": "Subjugation", "mission_id": 400582, "map_no": 7145, "level": 100, "multiplier": 1.0, "capacity": 10, "modifiers": [{"kind": "term", "influence": 17}], "enemies": [{"enemy_id": 1, "source": "local", "count": 101, "form_count": 1, "tags": ["アンデッド"], "hp": 1800, "attack": 150, "base_hp": 1800, "base_attack": 150, "damage_type": "physical", "armor_defense": 10, "attack_speed": 70, "attack_wait": 150, "attack_interval": 535, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2146288, "race_id": 16, "special_effect_id": 763, "master_id": 36447, "global_id": 10064, "spawn_sec": 40}, {"enemy_id": 2, "source": "local", "count": 24, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 47}, {"enemy_id": 3, "source": "local", "count": 34, "form_count": 2, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "attack_speed": 30, "attack_wait": 50, "attack_interval": 201, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099200, "race_id": 16, "change_to": 3, "change_condition": 2, "master_id": 36466, "global_id": 10083, "to_condition": 2, "to_global_id": 6073, "spawn_sec": 85}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 500, "attack": 300, "base_hp": 500, "base_attack": 300, "d