local", "count": 1, "form_count": 1, "hp": 5000, "attack": 350, "base_hp": 5000, "base_attack": 350, "damage_type": "physical", "armor_defense": 700, "attack_speed": 70, "attack_wait": 30, "attack_interval": 175, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100736, "master_id": 281, "global_id": 280, "spawn_sec": 76}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 108}], "dialogue": [{"trigger": "start", "lines": [{"name": "グスタフ", "text": "なっ……！　お前たちだな！　ミスリル鉱を奪おうと\nしている奴ってのは！！", "face": "u153"}, {"name": "ダークエルフ", "text": "あぁそうだ。あいつら、ここにあるミスリル鉱を\n全て奪うつもりだ！", "face": "lddd9f81cf6a6"}, {"name": "グスタフ", "text": "おのれ……！　この洞窟のミスリル鉱を\n渡すわけにはいかん！！", "face": "u153"}, {"name": "アンナ", "text": "あの様子……、どうも話が通じなさそうです。\n王子、お気を付けください。", "face": "l2de784a6429d"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "落ち着いてください。\n私たちは略奪をしに来たわけじゃありません。\nなにか守る理由があるのですか？", "face": "l2de784a6429d"}, {"name": "グスタフ", "text": "ここで採れる希少なミスリル鉱を使った武具を、\n作ってやらねばならぬ奴がいる。", "face": "u153"}, {"name": "グスタフ", "text": "そいつは魔物と戦うためにも必要だと必死で\nワシに頼んできたのだ。", "face": "u153"}, {"name": "グスタフ", "text": "そいつの為にもこの洞窟からミスリル鉱を奪おうと\nするやつは許しておけん！", "face": "u153"}, {"name": "アンナ", "text": "……それはもしやセラさんのことですか？", "face": "l2de784a6429d"}, {"name": "グスタフ", "text": "あ？　なんだ、知り合いか。", "face": "u153"}, {"name": "アンナ", "text": "ですがミスリル鉱を狙うものがいるのは事実です。\n先ほどのダークエルフが魔物を使って\nミスリル鉱を集めてなにか企んでいるようです。", "face": "l2de784a6429d"}, {"name": "グスタフ", "text": "な、なんだと！！　おのれダークエルフめ……！\n確かにミスリル鉱は魔の力に反応する。", "face": "u153"}, {"name": "グスタフ", "text": "純度の高いものとなれば、魔の力に触れたことに\nよって魔物化までする物もでてきた。", "face": "u153"}, {"name": "アンナ", "text": "先の戦闘でみた魔物はそれだったのですか……。", "face": "l2de784a6429d"}, {"name": "グスタフ", "text": "それに、これは聞いた話だがミスリル鉱を使えば\n強力な兵器を錬成することも可能らしい。", "face": "u153"}, {"name": "アンナ", "text": "もしかして……。王子、ダークエルフの狙いは\nそれかもしれません。\nもしそうなら兵器作りを阻止しなければ！", "face": "l2de784a6429d"}, {"name": "アンナ", "text": "急ぎ先へ進みましょう！", "face": "l2de784a6429d"}]}], "active": true}