15000, "base_attack": 550, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 75, "attack_interval": 240, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2173696, "race_id": 11, "special_effect_id": 2525, "master_id": 41224, "spawn_sec": 206}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 2, "tags": ["ステルス"], "hp": 35000, "attack": 750, "base_hp": 35000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 16, "attack_wait": 10, "attack_interval": 95, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159904, "change_to": 13, "change_condition": 2, "master_id": 40014, "global_id": 13631, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 224}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["邪教徒"], "hp": 152000, "attack": 900, "base_hp": 152000, "base_attack": 900, "damage_type": "magical", "armor_defense": 250, "magic_defense": 15, "attack_range": 240, "attack_speed": 50, "attack_wait": 55, "attack_interval": 177, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2164848, "race_id": 16, "special_effect_id": 2213, "missile_id": 1407, "missile": {"speed": 3.0}, "master_id": 39247, "global_id": 12864, "ranged": true, "spawn_sec": 251}, {"enemy_id": 16, "source": "local", "count": 4, "form_count": 1, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 200000, "attack": 3500, "base_hp": 200000, "base_attack": 3500, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_range": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 343, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2173504, "race_id": 10, "special_effect_id": 2522, "missile_id": 45, "master_id": 41210, "ranged": true, "spawn_sec": 401}], "popups": ["影のディアナは\n攻撃力1500以下の\nあらゆる攻撃を受け付けません。\n\n影のディアナから攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n　　　　　　(1/3)", "影のディアナの\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。\n\n\n　　　　　　(2/3)", "影のディアナは、\n戦場にいる呪いの泥の総数に応じて\n攻撃と防御がアップします。\n\n\n\n\n　　　　　　(3/3)", "邪教の神官から攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n複数の邪教の神官から\n攻撃を受けた場合、\n継続ダメージ効果が重複します。\n　　　　　　(1/3)", "邪教の神官の\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。\n\n\n　　　　　　(2/3)", "邪教の神官がいる間は、\n邪教徒属性の\n敵の攻撃と防御がアップします。\n\nこの効果は重複します。\n\n\n　　　　　　(3/3)", "影の帝国降臨が\n解放されました。\n\nホーム画面左側の\nミッションクエストにある、\n魔神降臨のメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "影のレオナ", "text": "――しかし、よく考えたものだな。", "face": "u2915a1"}, {"name": "影のディアナ", "text": "何をでしょう？", "face": "u2914a1"}, {"name": "影のレオナ", "text": "己の生命と引き換えに、\n勝とうが負けようが、民の安全を確約させる手法だ。", "face": "u2915a1"}, {"name": "影のディアナ", "text": "私の記憶――正確には、\nオリジナルの記憶の中に、答えがありましたから。", "face": "u2914a1"}, {"name": "影のディアナ", "text": "過去の白の帝国であれば、\n不可能だったことでしょう。", "face": "u2914a1"}, {"name": "影のディアナ", "text": "しかし、今の白の帝国は違う。\nどこかの誰かさんの、まばゆい輝きに、\n希望を見出してしまったあの皇帝の時代なら。", "face": "u2914a1"}, {"name": "影のレオナ", "text": "……なるほどな。", "face": "u2915a1"}, {"name": "影のディアナ", "text": "それに、皇帝が呑気にひとり旅をしていたのも好都合。\nまだ建造途中ではありますが、\nこれだけの影の帝都を造ることができましたから。", "face": "u2914a1"}, {"name": "影のレオナ", "text": "白の帝国としても、\nここまでの国力を持つ都市国家を相手に、\n戦争をしたいとは思わない、か。", "face": "u2915a1"}, {"name": "影の帝国巨兵", "text": "――女皇陛下！　影なる希望！\n漆黒の騎士皇帝！　我らがディアナ様！\n戦うすべを持つ者、すべてそろいました！", "face": "l322ed888eb2d"}, {"name": "影のディアナ", "text": "……皆、覚悟はできていますね。", "face": "u2914a1"}, {"name": "影のレオナ", "text": "間違っても、討ち死にの覚悟は、\nなどと言うんじゃないぞ。", "face": "u2915a1"}, {"name": "影の帝国巨兵", "text": "はっ、皆よく理解しております。", "face": "l322ed888eb2d"}, {"name": "影の帝国巨兵", "text": "我らが家族のため、友のため。\n――そして女皇陛下と参謀殿のため！\n我ら必ず、生き残ることを誓いましょう！", "face": "l322ed888eb2d"}, {"name": "白の皇帝", "text": "……良い臣下を持ったな。", "face": "u418"}, {"name": "影のディアナ", "text": "えぇ、そしてあなたも。", "face": "u2914a1"}, {"name": "白の皇帝", "text": "……俺の人徳によるものではないがな。", "face": "u418"}, {"name": "白の皇帝", "text": "王子、手を貸せ。\nこのふたりを止め、魔力の流入を断つ。", "face": "u418"}, {"name": "白の皇帝", "text": "決して、死なせはしない。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "影のレオナ", "text": "……全軍、武器を収めろ。\nこれ以上の戦闘を禁ずる。我らの、負けだ。", "face": "u2915a1"}, {"name": "サスキア", "text": "こちらも攻撃を止めてください！\n武器を置いた方には、手を出さないで。\n負傷者の手当てを急ぎましょう！", "face": "u2918a1"}, {"name": "フローガ", "text": "ふたりとも、こちらへ！\nタルタロスの魔力流入を止めます！", "face": "u878"}, {"name": "ヘルメルク", "text": "手を貸すよ。\nタルタロスのことは詳しくないけど、\n影を生み出す魔法は見たことあるから。", "face": "u2275a1"}, {"name": "フローガ", "text": "お願いします！", "face": "u878"}, {"name": "ローザ", "text": "――陛下。\n敵方に潜んでいた神官を捕らえました。\nただ……敗れたというのに、ずっと笑っていて。", "face": "u2916a1"}, {"name": "邪教徒", "text": "見事……実に、見事。\n神の試練を、またひとつ越えられたか……。", "face": "le98e66db8554"}, {"name": "白の皇帝", "text": "……試練だと？\n貴様、俺の呪いについて知っているのか。", "face": "u418"}, {"name": "邪教徒", "text": "その身に降りかかる呪いを打ち破り、\nより強く、より強靭な器へと至る。\n全ては、我らが神を迎えるため……。", "face": "le98e66db8554"}, {"name": "へカティエ", "text": "……器？\nまさか、神を宿らせるつもり？", "face": "u1226a1"}, {"name": "邪教徒", "text": "然り。タルタロスの奥底にて、神は待っておられる。\nその器が、完成する時を。", "face": "le98e66db8554"}, {"name": "ローザ", "text": "……陛下。この者は、私たちが預かります。\n今は、あのおふたりを。", "face": "u2916a1"}, {"name": "影のディアナ", "text": "さて、残すは首謀者が責任を取るだけ、ですね。", "face": "u2914a1"}, {"name": "影のレオナ", "text": "……死出の旅路、共をしよう。\n冥界でも参謀が必要だろう、我が女皇。", "face": "u2915a1"}, {"name": "レオナ", "text": "むっ……待て！\n誰か、剣を取り上げろ！", "face": "u2600a1"}, {"name": "ローザ", "text": "だめっ、間に合わな――", "face": "u2916a1"}, {"name": "イクセリス", "text": "――やめて！\nふたりとも、その剣を置いて！", "face": "u2912a1"}, {"name": "影のディアナ", "text": "これは私たちの責任の取り方です。\nあなたが、気に病むことではありません。", "face": "u2914a1"}, {"name": "イクセリス", "text": "そんなの、無理だよ。\n目の前で死のうとしてる人に、\n関係ないから黙ってろなんて……！", "face": "u2912a1"}, {"name": "影のレオナ", "text": "……ならば、どうしろと？\n私たちは、オリジナルではない。\nその欲望だけを取り出された、偽物だ。", "face": "u2915a1"}, {"name": "イクセリス", "text": "私だって、自分が誰なのか、よく分からない。\n村で暮らしてた私と、タルタロスにいた私と。\n急に、どっちも自分だって言われても……。", "face": "u2912a1"}, {"name": "イクセリス", "text": "でも、あなたたちが死ぬのは嫌なの。\nそう思ったのが、今の私か、昔の私かなんて、\nそんなの、分からなくたっていいでしょ！", "face": "u2912a1"}, {"name": "影のディアナ", "text": "…………。", "face": "u2914a1"}, {"name": "イクセリス", "text": "あなたたちは、どうなの？\nオリジナルならどうするとかじゃなくて。\nあなたたちは、本当に死にたいの？", "face": "u2912a1"}, {"name": "影のディアナ", "text": "……民を、守りたかった。\nあの方々が怯えずに暮らせる国を、私が……。", "face": "u2914a1"}, {"name": "イクセリス", "text": "うん。さっき、聞いたよ。\nあの巨人の人、家族と暮らす場所をもらったって。\nあなたに助けてもらったって、言ってた。", "face": "u2912a1"}, {"name": "影の帝国巨兵", "text": "……女皇陛下。\n我が子らには、あなたを見捨てずに済んだと、\nそう伝えるつもりで戻ってきたのです。", "face": "l322ed888eb2d"}, {"name": "影のディアナ", "text": "……私が生きて、またあなた方を傷つけたら。\nそれでも、同じことを言えますか？", "face": "u2914a1"}, {"name": "イクセリス", "text": "だったら、誰かに止めてもらおうよ。\n私だって暴れちゃったけど、王子も陛下も、\n助けてくれた。今も、一緒にいてくれる。", "face": "u2912a1"}, {"name": "イクセリス", "text": "生まれたばかりなんでしょう？\n自分が誰かなんて、これから生きて決めればいい。\n今、全部終わりにしなくたっていいじゃない！", "face": "u2912a1"}, {"name": "レオナ", "text": "私の欲望から生まれたのなら、\nそう簡単に生命を捨ててくれるな。\n成し遂げたい欲望、ひとつやふたつではあるまい。", "face": "u2600a1"}, {"name": "影のレオナ", "text": "…………。", "face": "u2915a1"}, {"name": "イクセリス", "text": "……王子。お願いがあるの。\nこのふたりを、王国に連れていってもらえない？\nそれから……えっと、私も一緒に。", "face": "u2912a1"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "イクセリス", "text": "このふたりに必要なのは、\n自分が誰なのか、ゆっくり確かめる時間だと思うの。\n……私も、なんだけど。", "face": "u2912a1"}, {"name": "ディアナ", "text": "こちらからも頼めますか。\n影の帝国の民を悪いようにはしません。\nただ、反乱の首謀者を野放しにもできません。", "face": "u624"}, {"name": "ディアナ", "text": "無罪放免として、\nこのまま都市国家の長に据えても良いのですが――", "face": "u624"}, {"name": "影のディアナ", "text": "民のためにも、罪人たる私が、\nここに残るわけには参りません。", "face": "u2914a1"}, {"name": "ディアナ", "text": "――と、言うと思ったので。", "face": "u624"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "白の皇帝", "text": "……世話をかけるな。", "face": "u418"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 50, "params": [50]}], "enemies": [{"enemy_id": 1, "hp": 280000, "attack": 1500, "damage_type": "magical", "armor_defense": 350, "magic_defense": 20, "pattern_id": 2173664}, {"enemy_id": 1, "form_index": 1, "hp": 280000, "attack": 1500, "damage_type": "magical", "armor_defense": 350, "magic_defense": 20, "pattern_id": 2173664}, {"enemy_id": 3, "hp": 250000, "attack": 2200, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2173632}, {"enemy_id": 3, "form_index": 1, "hp": 250000, "attack": 2200, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2173712}, {"enemy_id": 5, "hp": 120000, "attack": 800, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "pattern_id": 2173648}, {"enemy_id": 5, "form_index": 1, "hp": 120000, "attack": 1000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "pattern_id": 2173648}, {"enemy_id": 5, "form_index": 2, "hp": 120000, "attack": 1200, "damage_type": "magical", "armor_defense": 400, "magic_defense": 50, "pattern_id": 2173648}, {"enemy_id": 8, "hp": 14000, "attack": 1700, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "pattern_id": 2173488}, {"enemy_id": 9, "hp": 21000, "attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "pattern_id": 2173680}, {"enemy_id": 10, "hp": 30000, "attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "pattern_id": 2168544}, {"enemy_id": 11, "hp": 62000, "attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2168528}, {"enemy_id": 12, "hp": 15000, "attack": 550, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "pattern_id": 2173696}, {"enemy_id": 13, "hp": 35000, "attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2159904}, {"enemy_id": 13, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 15, "hp": 152000, "attack": 900, "damage_type": "magical", "armor_defense": 250, "magic_defense": 15, "pattern_id": 2164848}, {"enemy_id": 16, "hp": 200000, "attack": 3500, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2173504}]}, "active": true}