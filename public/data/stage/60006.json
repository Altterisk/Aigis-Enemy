{"quest_id": 60006, "name": "偽りと真実の果てに", "description": "覚醒した影の暴走を止め決着をつけよ！\n＜白の皇帝の出撃時の初期HP減少：中＞\n＜白の皇帝の攻撃力がダウン＞\n神級（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["白の皇帝の出撃時の初期HP減少：中", "白の皇帝の攻撃力がダウン"], "event": "帝国大戦　タルタロス編第二幕", "event_category": "Empire", "mission_id": 940012, "map_no": 7510, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 280000, "attack": 1500, "base_hp": 280000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 350, "magic_defense": 20, "attack_range": 210, "attack_speed": 1, "attack_wait": 3, "attack_interval": 57, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2173664, "race_id": 16, "special_effect_id": 2535, "missile_id": 1726, "master_id": 41221, "ranged": true, "sp_change_to": [41222], "commands": {"raw": "FlagCheckCommandOrder(0, 1, 127, 1, \"DoEnemy_ModeChange(41222);\"); SetStageFlag(0, 0); SetStageFlag(1, 0); SetStageFlag(2, 0); SetStageFlag(3, 0);", "sets_flags": [[0, 0], [1, 0], [2, 0], [3, 0]], "mode_changes": 1, "flag_checks": ["0, 1, 127, 1, \"DoEnemy_ModeChange(41222"]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["影の帝国", "タルタロスの呪縛"], "hp": 280000, "attack": 1500, "base_hp": 280000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 350, "magic_defense": 20, "attack_range": 210, "attack_speed": 1, "attack_wait": 3, "attack_interval": 57, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2173664, "race_id": 16, "special_effect_id": 2528, "missile_id": 1726, "master_id": 41222, 