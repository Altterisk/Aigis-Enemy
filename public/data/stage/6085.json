{"quest_id": 6085, "name": "頂点を目指して", "description": "打倒アナトリアを胸に、ベストラの\n辛く厳しい修行の幕が開ける。\n＜遠距離ユニット出撃不可＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["遠距離ユニット出撃不可"], "event": "オーク格闘家の王子軍入門", "event_category": "History", "mission_id": 920088, "map_no": 3238, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [4], "expression": "IsVanguard() || IsClassType(1684);"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 450, "base_hp": 5000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 137, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109792, "race_id": 16, "special_effect_id": 54, "master_id": 30215, "global_id": 3834, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 137, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109744, "race_id": 8, "special_effect_id": 54, "master_id": 30225, "global_id": 3844, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 10, "attack_interval": 157, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100480, "race_id": 16, "master_id": 30229, "global_id": 3848, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 5000, "attack": 450, "base_hp": 5000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_speed": 40, "attack_wait": 10, "attack_interval": 142, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097920, "race_id": 16, "master_id": 30230, "global_id": 3849, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 33, "level": 90, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 4}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 6000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2101616, "race_id": 16, "master_id": 30231, "global_id": 3850, "spawn_sec": 89}, {"enemy_id": 7, "source": "local", "count": 2, "level": 80, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 109}], "dialogue": [{"trigger": "start", "lines": [{"name": "ベストラ", "text": "入門を許可して頂いたこと感謝致します。\n王子軍の下で\nしっかり鍛錬を積ませていただきます！", "face": "u474"}, {"name": "ケイティ", "text": "いえ、お気になさらず。\nベストラさんの力をお借りできるのであれば、\nこちらとしてもありがたい話ですし。", "face": "u114"}, {"name": "モモ", "text": "怒りの力の訓練かぁ……うーんそんなの\nやったことないもんなぁ……そうだ、ひとまず\n私達の訓練に参加してみたらどう？", "face": "u1249"}, {"name": "ケイティ", "text": "本日は接近戦の訓練でしたね。\n戦いの基本は歩兵による接近戦、\n歩兵の強さは軍の強さに直結します。", "face": "u114"}, {"name": "ベストラ", "text": "歩兵の強さ……つまり力比べですね。\n力でしたら、少々自信があります！", "face": "u474"}, {"name": "ディーナ", "text": "そうなのか。私も力だったら結構自信あるよ。", "face": "u22"}, {"name": "キャリー", "text": "私もです！　いつもこの鉛槍で鍛えてますから！", "face": "u1026"}, {"name": "モーティマ", "text": "俺も男だしな。女、子供に\n負ける訳にはいかねぇ……\n……いかねぇんだよ！", "face": "u14"}, {"name": "モモ", "text": "皆やる気充分ね！　よーっし！\n誰が一番力が強いか力比べと行きましょ！\n王子、いっくよ～！", "face": "u1249"}, {"name": "ケイティ", "text": "王子、此度は近接兵の訓練となります。\nご采配を下すのは、近接兵のみにお願いしますね。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "ベストラ", "text": "普段と違う環境での特訓はやはり身が入りますね。\n皆さんとの力比べの成果でしょうか、\nなんだか、一段と力強くなれた気がします。", "face": "u474"}, {"name": "モモ", "text": "良い訓練になったようで何よりね。……にしても、\nオークって荒々しかったり無骨なものだと思ってたけど\nベストラみたいに穏やかなオークもいるんだね。", "face": "u1249"}, {"name": "ベストラ", "text": "……お、穏やか……。\nこの性格は自分では嫌なのです！\n早く自分を変えたくて……。", "face": "u474"}, {"name": "モモ", "text": "そうなんだ～。私は良いと思うけどなぁ。\nそれにしても……今日はすっごい疲れたし\n明日のリンさんとの朝練、辛そうだなぁ。", "face": "u1249"}, {"name": "ベストラ", "text": "辛い朝練……！？　\nその朝練、是非私も\n参加させては貰えませんか！", "face": "u474"}, {"name": "モモ", "text": "えっ？\n別にいいけど……いいの？\nすっごくきついよ？", "face": "u1249"}, {"name": "ベストラ", "text": "望むところです！　", "face": "u474"}, {"name": "ベストラ", "text": "辛い特訓を乗り越えてこそ、\n強くなった実感が得られるものですから！", "face": "u474"}, {"name": "モモ", "text": "そっか。わかった！\nそれじゃ、明日も一緒に頑張ろうね！", "face": "u1249"}]}], "map": {"image": "Map920088_3238", "w": 960, "h": 640, "spots": [{"k": "b", "x": 936, "y": 423}, {"k": "m", "x": 138, "y": 156, "id": 200}, {"k": "m", "x": 236, "y": 182, "id": 201}, {"k": "m", "x": 329, "y": 207, "id": 202}, {"k": "m", "x": 519, "y": 175, "id": 203}, {"k": "m", "x": 300, "y": 276, "id": 204}, {"k": "m", "x": 424, "y": 389, "id": 205}, {"k": "m", "x": 522, "y": 395, "id": 206}, {"k": "m", "x": 425, "y": 173, "id": 207}, {"k": "m", "x": 421, "y": 70, "id": 208}, {"k": "m", "x": 642, "y": 297, "id": 209}, {"k": "m", "x": 613, "y": 367, "id": 210}, {"k": "m", "x": 745, "y": 328, "id": 211}, {"k": "m", "x": 843, "y": 360, "id": 212}, {"k": "m", "x": 421, "y": 481, "id": 213}, {"k": "m", "x": 518, "y": 71, "id": 214}, {"k": "m", "x": 519, "y": 484, "id": 215}, {"k": "m", "x": 109, "y": 216, "id": 216}, {"k": "m", "x": 205, "y": 246, "id": 217}, {"k": "m", "x": 714, "y": 395, "id": 218}, {"k": "m", "x": 816, "y": 423, "id": 219}, {"k": "m", "x": 337, "y": 350, "id": 220}, {"k": "m", "x": 611, "y": 215, "id": 221}]}, "active": true}