{"quest_id": 8194, "name": "第七陣 女王ラビリス", "description": "迷宮の玉座の間へと辿り着いた同盟軍は、\n法と秩序の亜神との決戦に挑む。\n＜時間経過でのコスト回復量が60%低下＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["時間経過でのコスト回復量が60%低下"], "event": "帝国七陣", "event_category": "Empire", "mission_id": 940001, "map_no": 4785, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 30, "params": [40]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 180000, "attack": 2800, "base_hp": 180000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 20, "attack_speed": 1, "attack_interval": 34, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2150992, "race_id": 19, "special_effect_id": 1235, "change_to": 1, "change_condition": 2, "master_id": 37204, "global_id": 10821, "to_condition": 2, "to_global_id": 10822, "commands": {"raw": "SetStageFlag(2, 0); DoEnemy_RegistCommand(\"OnModeChanged\", \"SetStageFlag(2, 1);\");", "sets_flags": [[2, 0], [2, 1]], "on_mode_changed": true}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 200000, "attack": 7000, "base_hp": 200000, "base_attack": 7000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 20, "attack_range": 50, "attack_speed": 1, "attack_wait": 80, "attack_interval": 213, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2151008, "race_id": 19, "special_effect_id": 1236, "missile_id": 11, "master_id": 37205, "global_id": 10822, "ranged": true, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 70000, "attack": 2500, "base_hp": 70000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "tran