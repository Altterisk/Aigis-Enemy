"master_id": 456, "global_id": 455, "spawn_sec": 77}, {"enemy_id": 8, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "hp": 23000, "attack": 700, "base_hp": 23000, "base_attack": 700, "damage_type": "magical", "armor_defense": 200, "attack_range": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 71, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138576, "race_id": 13, "special_effect_id": 216, "change_to": 4, "change_condition": 2, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 35093, "global_id": 8710, "ranged": true, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 129}, {"enemy_id": 9, "source": "local", "count": 19, "form_index": 0, "form_count": 2, "hp": 18000, "attack": 600, "base_hp": 18000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_interval": 34, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142480, "race_id": 19, "special_effect_id": 1238, "change_to": 9, "change_condition": 3, "master_id": 35806, "global_id": 9423, "to_condition": 3, "to_global_id": 9424, "spawn_sec": 139}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 1000, "base_hp": 18000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 234, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142496, "race_id": 19, "special_effect_id": 86, "master_id": 35807, "global_id": 9424, "from_condition": 3}, {"enemy_id": 11, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 45000, "attack": 1800, "base_hp": 45000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2128592, "race_id": 12, "master_id": 33700, "global_id": 7317, "spawn_sec": 159}, {"enemy_id": 12, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 35000, "attack": 1000, "base_hp": 35000, "base_attack": 1000, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111888, "race_id": 12, "special_effect_id": 233, "master_id": 30630, "global_id": 4249, "spawn_sec": 167}], "popups": ["亜神ラビリスは倒されると、\nその場で一度だけ復活します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ラビリス", "text": "――なんだ、珍しい客人だな。", "face": "u2087a1"}, {"name": "ラビリス", "text": "へカティエのところの小間使いが、\nふたりも揃って何の用事だ？", "face": "u2087a1"}, {"name": "オルフィー", "text": "我が主がしばし不在でして……。\nもしかしたら、お隣さんの館に監禁されていないかなと。", "face": "u2085a1"}, {"name": "リチュエ", "text": "その言い方、思いっきり喧嘩売ってません？", "face": "u2088a1"}, {"name": "オルフィー", "text": "へカティエ様が敵対するつもりである以上、\nいずれは激突する相手ですし……。", "face": "u2085a1"}, {"name": "ラビリス", "text": "ハッ、確かにそろそろ飽いてきた頃だ。\n約束した刻限も近いし、\n迷宮から出してやっても構わな――", "face": "u2087a1"}, {"name": "白の皇帝", "text": "――何、手間を掛けさせるつもりはない。\nこちらから、来てやったぞ。", "face": "u418"}, {"name": "ラビリス", "text": "なっ……どうやってオレの迷宮を……！", "face": "u2087a1"}, {"name": "ヘカティエ", "text": "……敵が兵を送り込む通路を、\nそのまま逆走してやればいいということね。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "妥当な策だとは思ったけれど、\nその出口が、あなたの玉座だとは考えもしなかったわ。", "face": "u1226a1"}, {"name": "リチュエ", "text": "へカティエ様！\nやっぱり拉致監禁されてたんですね！？", "face": "u2088a1"}, {"name": "オルフィー", "text": "ご無事……のようですね……？\n実力行使をする前で助かりました……。", "face": "u2085a1"}, {"name": "？？？", "text": "ふぅ、やーっとマトモな敵のお出ましかな！", "face": "u2084a1"}, {"name": "レオナ", "text": "クリッペ、盾騎士で玉座の間を封鎖しろ！\nラビリスをここで仕留める！", "face": "u311"}, {"name": "クリッペ", "text": "りょーかい！\n晴れ舞台には誰も行かせないよっと！", "face": "u2084a1"}, {"name": "ヘカティエ", "text": "オルフィー、リチュエも助力を。\n今こそラビリスを討つ好機。\n彼らの戦いに水を差す者を排除なさい。", "face": "u1226a1"}, {"name": "ラビリス", "text": "好き勝手言いやがって……。\n法を破った罪は、その身で償ってもらうぜ。", "face": "u2087a1"}, {"name": "ラビリス", "text": "すり潰されたい奴から前に出ろ！\n我が名はラビリス！\n雷霆の神が娘にして、地上の女王、秩序の亜神である！！", "face": "u2087a1"}, {"name": "ティルト", "text": "来るが良い、亜神ラビリス！\nみんな気をつけろ、\nヤツの突撃は倒れるまで止まらないぞ！", "face": "u1705a1"}]}, {"trigger": "end", "lines": [{"name": "ラビリス", "text": "――二度目の死は、ここだったか。", "face": "u2087a1"}, {"name": "ラビリス", "text": "さぁ、殺せ。\n全力で戦ったんだ、悔いはねぇ。", "face": "u2087a1"}, {"name": "レーヴ", "text": "――ま、待って！　待ってください！", "face": "u454"}, {"name": "レーヴ", "text": "彼女は、女王ラビリスは\nきっと話の通じる方だと思うんです！", "face": "u454"}, {"name": "白の皇帝", "text": "……説明しろ。", "face": "u418"}, {"name": "レーヴ", "text": "亜神――いえ、女王ラビリス。\n前回の遭遇戦の後、\n帝国軍と共同であなたの伝承を調べました。", "face": "u454"}, {"name": "ジェニー", "text": "ほとんどが口伝ばかり。\n書物はそれらを集めたものだから、\nバリエーションが豊富すぎて大変だったよ。", "face": "u1923a1"}, {"name": "クリッペ", "text": "（ああ、それであの大量の本運ばされたんだ……）", "face": "u2084a1"}, {"name": "レーヴ", "text": "あなたがかつて築いた国は、\nひとつの理想を体現したものでした。", "face": "u454"}, {"name": "レーヴ", "text": "厳格な法に基づいた、理性の都です。\n人々は秩序の庇護のもとに、\n繁栄を謳歌していたはずです。", "face": "u454"}, {"name": "ラビリス", "text": "……ああ。\nだがその都も、今や瓦礫の下だけどな。", "face": "u2087a1"}, {"name": "ジェニー", "text": "それでも、あなたの法は\n野蛮な荒くれ者たちから、民を守っていた。", "face": "u1923a1"}, {"name": "ジェニー", "text": "犯罪者には容赦がなかったみたいだけど、\nまぁ、それはあなたを見れば分かる。", "face": "u1923a1"}, {"name": "レーヴ", "text": "女王ラビリス、我々は分かりあえるはずです。\nなぜなら、あなたは今も法を大切にしているから。", "face": "u454"}, {"name": "レーヴ", "text": "領土を侵した私たちに罰を与えるのではなく、\nこんな時間稼ぎをし続けたのは、\n別の「約束」があったからではありませんか？", "face": "u454"}, {"name": "ラビリス", "text": "ほう……そこまで推測したのか。", "face": "u2087a1"}, {"name": "ジェニー", "text": "それはたぶん、亜神ハイドースとの約束。\n帝国軍をここで足止めするところまでが、\nあなたの結んだ契約だったんじゃない？", "face": "u1923a1"}, {"name": "ラビリス", "text": "ああ。そのとおりだ。\nそしてその契約は果たされた。\nだからもう、オレはオレの好きにしていいわけだ。", "face": "u2087a1"}, {"name": "ラビリス", "text": "――なぁ、どう思う？\n貴様ら、オレの国民どもは。", "face": "u2087a1"}, {"name": "メルアビス", "text": "……霊魂たちが、騒いでる。\nえっと……これは……。", "face": "u675"}, {"name": "メメント", "text": "『行ってこいよ俺たちの女王陛下！』\n『伝説一個で満足するとからしくねぇ、\n伝説第二弾を打ち立てて来てくださいよ！』だって。", "face": "u195"}, {"name": "メルアビス", "text": "『物質界と冥界の国を打ち立てたら、\n次は天界にも参りましょうぞ！』とか言ってる。", "face": "u675"}, {"name": "ラビリス", "text": "…………死んでも馬鹿な奴らばかりだぜ。", "face": "u2087a1"}, {"name": "レーヴ", "text": "……ですから、\n女王ラビリスとは同盟関係を結べるはずでは――！", "face": "u454"}, {"name": "白の皇帝", "text": "…………好きにしろ。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 30, "params": [40]}, {"kind": "term", "influence": 20, "params": [130]}, {"kind": "term", "influence": 18, "params": [130]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 180000, "attack": 2800, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 20, "pattern_id": 2150992}, {"enemy_id": 1, "form_index": 1, "hp": 200000, "attack": 7000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 20, "pattern_id": 2151008}, {"enemy_id": 3, "form_index": 0, "hp": 70000, "attack": 2500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2108064}, {"enemy_id": 4, "form_index": 0, "hp": 3500, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2142464}, {"enemy_id": 4, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 6, "form_index": 0, "hp": 2000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 7, "form_index": 0, "hp": 30000, "attack": 1100, "damage_type": "physical", "pattern_id": 2103568}, {"enemy_id": 8, "form_index": 0, "hp": 23000, "attack": 700, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2138576}, {"enemy_id": 9, "form_index": 0, "hp": 18000, "attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2142480}, {"enemy_id": 9, "form_index": 1, "hp": 18000, "attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2142496}, {"enemy_id": 11, "form_index": 0, "hp": 45000, "attack": 1800, "damage_type": "physical", "armor_defense": 1200, "pattern_id": 2128592}, {"enemy_id": 12, "form_index": 0, "hp": 35000, "attack": 1000, "damage_type": "physical", "pattern_id": 2111888}]}, "active": true}