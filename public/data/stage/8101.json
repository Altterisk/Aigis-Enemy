82, "global_id": 8399, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 16, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 55, "attack_wait": 50, "attack_interval": 236, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114384, "master_id": 31001, "global_id": 4620, "spawn_sec": 166}, {"enemy_id": 17, "source": "local", "count": 3, "form_count": 1, "hp": 9000, "attack": 800, "base_hp": 9000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114592, "race_id": 14, "change_to": 17, "change_condition": 3, "master_id": 31017, "global_id": 4636, "spawn_sec": 209}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 1, "hp": 96000, "attack": 3000, "base_hp": 96000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_range": 240, "attack_speed": 20, "attack_wait": 60, "attack_interval": 267, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2148576, "race_id": 12, "special_effect_id": 86, "change_to": 19, "change_condition": 1, "missile_id": 960, "missile": {"speed": 6.0}, "master_id": 36690, "global_id": 10307, "ranged": true, "variants": [{"hp": 96000, "attack": 1500, "base_hp": 96000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2148592, "race_id": 12, "special_effect_id": 86, "master_id": 36691, "global_id": 10308}], "spawn_sec": 239}], "popups": ["朱雀は一定範囲内のユニットに\n継続してダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フーイェン", "text": "──この会場の参加者は粗方倒しましたかね。", "face": "u1549a1"}, {"name": "クーシン", "text": "……改めて凄まじいのですね、王国の精鋭とは。\n予選とはいえ華の国の猛者たちがこうも容易く……。", "face": "u2000a1"}, {"name": "ダン", "text": "まっ、俺にかかればざっとこんなもんよ。", "face": "u204"}, {"name": "ユリアン", "text": "パンダにボコられてたやつがよく言うぜ。", "face": "u7"}, {"name": "ダン", "text": "パンダはしょうがねぇだろ！", "face": "u204"}, {"name": "マオ", "text": "……これで予選は終わり、なのでしょうか。", "face": "u361"}, {"name": "マレス", "text": "──待たせたな王子、そして華の国の武人たちよ！", "face": "l8bb7479cf030"}, {"name": "マレス", "text": "貴様らの熱き戦いに対する褒美として、\n俺様がこの予選の最後を飾る挑戦者を用意した！", "face": "l8bb7479cf030"}, {"name": "アリス", "text": "……赤い鳥人に、白い獣人？", "face": "u288"}, {"name": "クーシン", "text": "あれは突如、華の国に現れた新星。\n四神を彷彿とさせる戦い方をする四人組、\nその内の朱雀と白虎と呼ばれる二人ですね。", "face": "u2000a1"}, {"name": "太公望", "text": "いや、あの、あれは……。", "face": "u603"}, {"name": "クーシン", "text": "……？　どうかされましたか？", "face": "u2000a1"}, {"name": "竜吉公主", "text": "驚かないで聞いてほしいのだけど、\nあれ本物よ、本物の四神、朱雀と白虎。", "face": "u663"}, {"name": "クーシン", "text": "──え。", "face": "u2000a1"}, {"name": "太公望", "text": "永い眠りから覚めたかと思えば、\n亜人の姿に化けて諸国漫遊の旅ですか。\n俗世を思い切り満喫しちゃってますねぇ。", "face": "u603"}, {"name": "マレス", "text": "さあ、これで役者は出揃った！\nド派手な華を咲かせてみやがれッ！", "face": "l8bb7479cf030"}, {"name": "クーシン", "text": "えーーーーっ！？", "face": "u2000a1"}]}, {"trigger": "end", "lines": [{"name": "クーシン", "text": "四神と戦うなんて、聞いてないんですけど……。", "face": "u2000a1"}, {"name": "シャオ", "text": "さ、最後にとんでもない相手だったわね……。", "face": "u180"}, {"name": "フーイェン", "text": "んー、勝てたまでは良かったんですが、\n人間も中々やるではないかみたいな顔して、\nルンルン気分で帰られたのは少し癪ですねー。", "face": "u1549a1"}, {"name": "クーシン", "text": "本来の姿でないとはいえ神獣ですよ？\nもしも彼らが本気を出して戦っていたら、\nこの辺一帯火の海になっていましたよ……。", "face": "u2000a1"}, {"name": "マレス", "text": "良き戦いだった、王国の武人たちよ！\n武王大宴の名に相応しき高度な技の応酬！\n力と力のぶつかり合いには血沸き肉躍った！", "face": "l8bb7479cf030"}, {"name": "マレス", "text": "王子、お前こそ当代の武王の座に挑むに相応しい男だ。", "face": "l8bb7479cf030"}, {"name": "マレス", "text": "先ほど、第二会場の方でも決着がついた。\nお前たちが決勝戦で戦う相手を紹介しよう。", "face": "l8bb7479cf030"}, {"name": "普賢", "text": "おーい、予選通過者を連れて来てやったぞ。\nまったく亜神ってのは人使いが──げぇっ！？", "face": "u1782a1"}, {"name": "フェイロン", "text": "王子だと……！？　どうしてここに！？", "face": "u1720a1"}, {"name": "アリス", "text": "普賢さんに、フェイロンさん？\nそれでは、まさか決勝の相手は──", "face": "u288"}, {"name": "華王、誅子", "text": "ハハハハハハ、なるほどそういうことか。\nしばらく振りだな王子よ、息災であったか？", "face": "le3ac29afab6a"}, {"name": "アリス", "text": "誅子さん！", "face": "u288"}, {"name": "太公望", "text": "元始天尊様の下で修行中と聞いていましたが……\nどうやら戻ってきたようですね、聞忠も一緒ですか。", "face": "u603"}, {"name": "聞忠", "text": "クーシン……私を謀りましたね？", "face": "l780a23f2b887"}, {"name": "クーシン", "text": "さあ、何のことでしょう。", "face": "u2000a1"}, {"name": "聞忠", "text": "白々しい……！　あくまでもとぼけると？", "face": "l780a23f2b887"}, {"name": "アリス", "text": "えっと……な、何かあったんですか？", "face": "u288"}, {"name": "華王、誅子", "text": "いいや、こちらの話だ。\n其方らが気にすることではない。\n決勝では存分に武を競い合おうぞ。", "face": "le3ac29afab6a"}, {"name": "華王、誅子", "text": "ではな、行くぞ聞忠。", "face": "le3ac29afab6a"}, {"name": "聞忠", "text": "待ってください誅子！　話は終わって──", "face": "l780a23f2b887"}, {"name": "フェイロン", "text": "…………誅子様はああ言っていたけど、\n事情を話さないわけにもいかないだろう。", "face": "u1720a1"}, {"name": "フェイロン", "text": "場所を移そう、クーシンも来てもらうぞ。", "face": "u1720a1"}]}], "active": true}