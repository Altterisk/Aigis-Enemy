{"quest_id": 8101, "name": "赤と白の新星", "description": "予選の最後を飾るべく現れた挑戦者。\n四神を彷彿させる四人組、その内の二人の\n新星が勝ち進む王子たちの前に立ち塞がる！\n神級（★１獲得の目安：平均Lv50）", "event": "武王大宴", "event_category": "History", "mission_id": 920206, "map_no": 7126, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 1, "hp": 7000, "attack": 650, "base_hp": 7000, "base_attack": 650, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 20, "attack_interval": 122, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2114512, "race_id": 14, "change_to": 1, "change_condition": 3, "master_id": 31002, "global_id": 4621, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105120, "race_id": 14, "change_to": 3, "change_condition": 5, "master_id": 602, "global_id": 601, "to_condition": 5, "to_global_id": 602, "spawn_sec": 5}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105136, "race_id": 14, "master_id": 603, "global_id": 602, "from_condition": 5}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 2, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "