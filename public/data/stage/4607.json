p": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 8, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 119}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102640, "race_id": 8, "change_to": 10, "change_condition": 3, "master_id": 383, "global_id": 382, "to_condition": 3, "to_global_id": 383, "spawn_sec": 181}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 450, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102656, "race_id": 8, "master_id": 384, "global_id": 383, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "良き報せがございます。\nついに、噂に名高い\n例の王子を発見しました！", "face": "l1b60b704868b"}, {"name": "オーク部隊長", "text": "それは本当か！？\nついにあの王子と戦うことができるのか……。\n魔界から出向いた甲斐があったというものだ！", "face": "l8d34cd20d0f1"}, {"name": "オーク", "text": "魔物の軍勢に対して抵抗を続ける人間……。\nその中で最も強い者と戦いたいと言う\n部隊長様の願いが叶うのですね。", "face": "l1b60b704868b"}, {"name": "オーク部隊長", "text": "聞くところによれば、\n白の帝国の皇帝にも比肩するほどの\n強者だという話だからな！", "face": "l8d34cd20d0f1"}, {"name": "レーゼル", "text": "（――今のうちに笑っているがいい。\n……この一撃で仕留める……ッ！）", "face": "u371"}, {"name": "オーク部隊長", "text": "――ッ！？\n銃撃……だと？\n誰だ卑怯な手で戦場を汚す輩は！？", "face": "l8d34cd20d0f1"}, {"name": "レーゼル", "text": "クソっ！\n仕留め損なったか……！\nこのまま応戦するしかないか……。", "face": "u371"}, {"name": "アンナ", "text": "――王子、レーゼルさんを見つけました！\nどうやらまた単身で\nオークと戦うつもりのようです！", "face": "l878f496a6c7b"}, {"name": "ダナン", "text": "早まるなレーゼル！\nだめだ、聞こえていないようだ。\n王子、あたし達もすぐに加勢するぞ！", "face": "u299"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "やりましたね、王子！\nオーク軍が続々と退いていきます！\nこれでこの地に平穏が戻るでしょう。"}, {"name": "レーゼル", "text": "やったぞ、みんなぁーッ！\nオーク達を倒すことができたんだ！\n私達は、ついに成し遂げたんだー！！", "face": "u371"}, {"name": "アンナ", "text": "え！？　あ、あの……レーゼルさん！？\n――きゃぁっ！？　あの……きゅ、急に\n抱きつかれると……は、恥ずかしいです……。", "face": "l878f496a6c7b"}, {"name": "レーゼル", "text": "ご、ごめん……嬉しくてつい……。\nその……力を貸してくれてありがとう。\n本当に貴方達には迷惑をかけてしまった……。", "face": "u371"}, {"name": "ダナン", "text": "気にすることはない。\nジャングルの平和を守る者同士、\n共に助け合うのは当然のことさ。", "face": "u299"}, {"name": "兵士", "text": "――はぁ、はぁ……ほ、報告ッ！\nお、オークの大部隊が、\nジャングルの奥地に突如として出現した模様！", "face": "lfcf030e255fb"}, {"name": "レーゼル", "text": "な……なんだって……ッ！？\n大部隊って……ど、どういうことだ……？", "face": "u371"}, {"name": "ダナン", "text": "おそらく先ほど私達が倒したのは、\n偵察か先遣隊に過ぎなかったという訳か。\nどうする……ここは逃げるのも手だぞ？", "face": "u299"}, {"name": "アンナ", "text": "ダナンさんの言うことも一理ありますが……。\nそれでも、ここで逃げるわけにはいきません！\n王子、体勢を立て直し大部隊に備えましょう！", "face": "l878f496a6c7b"}]}], "active": true}