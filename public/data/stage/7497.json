{"quest_id": 7497, "name": "新春恒例　破魔矢祭", "description": "今年も王子に向かって弓兵たちが破魔矢を\n射る！　謀反と勘違いして助けに入った\nマツリと共に祭りを盛り上げよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ30(2021)", "event_category": "Reproduce", "mission_id": 300333, "map_no": 4051, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 300, "gold": 800, "drops": [{"card": 166, "c": 1}, {"card": 55, "c": 2}, {"item": 1006, "c": 1}, {"item": 10019}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 4000, "attack": 150, "base_hp": 4000, "base_attack": 150, "damage_type": "physical", "armor_defense": 30, "attack_range": 380, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107280, "race_id": 16, "special_effect_id": 222, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30812, "global_id": 4431, "ranged": true, "spawn_sec": 6}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 14000, "attack": 130, "base_hp": 14000, "base_attack": 130, "damage_type": "physical", "armor_defense": 70, "attack_range": 300, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101824, "race_id": 16, "special_effect_id": 226, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30809, "global_id": 4428, "ranged": true, "spawn_sec": 6}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 200, "base_hp": 15000, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 5, "attack_range": 330, "attack_speed": 1, "attack_wait": 10, "attack_interval": 51, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120208, "special_effect_id": 235, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 32242, "global_id": 5861, "ranged": true, "spawn_sec": 6}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 12000, "attack": 120, "base_hp": 12000, "base_attack": 120, "damage_type": "physical", "armor_defense": 50, "attack_range": 260, "attack_speed": 30, "attack_wait": 10, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113536, "race_id": 16, "special_effect_id": 257, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30806, "global_id": 4425, "ranged": true, "spawn_sec": 6}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 40000, "attack": 150, "base_hp": 40000, "base_attack": 150, "damage_type": "physical", "armor_defense": 400, "attack_range": 310, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2126112, "race_id": 16, "special_effect_id": 129, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 34284, "global_id": 7901, "ranged": true, "spawn_sec": 6}, {"enemy_id": 6, "source": "local", "count": 32, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 150, "base_hp": 1200, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_range": 100, "attack_speed": 80, "attack_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097760, "race_id": 12, "missile_id": 253, "missile": {"speed": 3.0}, "master_id": 30813, "global_id": 4432, "ranged": true, "spawn_sec": 12}], "dialogue": [{"trigger": "start", "lines": [{"name": "ナナリー", "text": "今年も？", "face": "u29"}, {"name": "リオン", "text": "破魔矢を！", "face": "u251"}, {"name": "ソーマ", "text": "射ちますよー♪", "face": "u23"}, {"name": "アーシェラ", "text": "と、いうわけだ王子。\n今年は例年以上の破魔矢を用意している。\n射手の希望者も年々増加傾向だな。", "face": "u391"}, {"name": "ユージェン", "text": "何でも王子に破魔矢を当てられたら、\nその年は良い年になるという噂があるらしい。\n今回は皆の気合の入りようも凄まじいぞ。", "face": "u906"}, {"name": "ナナリー", "text": "矢じりは潰してありますけど、\nまともに当たるとちょっと痛いです。\n王子、頑張って迎撃してくださいね？", "face": "u29"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "マツリ", "text": "むむむ！　弓兵の皆さんが\n揃って王子サマに弓を向けてます！\n反逆ですか！？　謀反ですか！？", "face": "u1406a1"}, {"name": "ケイティ", "text": "マツリさん、いらっしゃったんですね。\nいえ、あれは別にそういう話でもなく──", "face": "u114"}, {"name": "マツリ", "text": "多数で一人を囲むとは卑怯千万！\nこのマツリ、目の前の悪事は見逃せません！\n義によって王子サマに助太刀いたします！", "face": "u1406a1"}, {"name": "マツリ", "text": "王子サマは、私が守りますよー！", "face": "u1406a1"}]}, {"trigger": "end", "lines": [{"name": "マツリ", "text": "──破魔矢を射ってたんですか？　何故？", "face": "u1406a1"}, {"name": "ユージェン", "text": "まあ、普通はそうなるよな……。", "face": "u906"}, {"name": "カズハ", "text": "確かに本来の使い方とは違いますが、\n皆さんの王子を想う気持ちは本物ですし、\n何より良い射撃訓練にもなりますからね。", "face": "u235"}, {"name": "カズハ", "text": "王国らしくて悪くないと思いますよ？", "face": "u235"}, {"name": "マツリ", "text": "なるほど。お正月に浮かれることなく、\n先を見据え心と技を清めようという心意気！\nまさに一年の計は新春にあり、ですね！", "face": "u1406a1"}, {"name": "マツリ", "text": "私も心なしか体が軽くなった気がします！", "face": "u1406a1"}, {"name": "王子", "text": "…………(こくこく)", "face": "u1"}, {"name": "ソーマ", "text": "何はともあれ、今年の破魔矢祭も成功ですね。", "face": "u23"}, {"name": "ケイティ", "text": "ええ、皆さんお疲れさまでした。\n後片付けはこちらで担当しますので、\n皆さん体を冷やさないようお気をつけて。", "face": "u114"}, {"name": "ケイティ", "text": "今年も一年頑張りましょう、王子！", "face": "u114"}]}], "map": {"image": "Map4051", "w": 960, "h": 640, "spots": [{"k": "b", "x": 892, "y": 529}, {"k": "m", "x": 385, "y": 200, "id": 200}, {"k": "m", "x": 146, "y": 264, "id": 201}, {"k": "m", "x": 490, "y": 263, "id": 202}, {"k": "m", "x": 573, "y": 204, "id": 203}, {"k": "m", "x": 657, "y": 149, "id": 204}, {"k": "m", "x": 299, "y": 147, "id": 205}, {"k": "m", "x": 225, "y": 207, "id": 206}, {"k": "m", "x": 737, "y": 211, "id": 207}, {"k": "m", "x": 830, "y": 276, "id": 208}, {"k": "m", "x": 572, "y": 324, "id": 209}, {"k": "m",