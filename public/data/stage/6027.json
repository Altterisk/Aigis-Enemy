180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 104}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 10, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 129}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 600, "base_hp": 2800, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 60, "attack_wait": 10, "attack_interval": 129, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097424, "master_id": 20, "global_id": 19, "spawn_sec": 129}, {"enemy_id": 13, "source": "local", "count": 5, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 134}], "dialogue": [{"trigger": "start", "lines": [{"name": "レン", "text": "――王子のお力になりたいと\n父とともにこの国を目指し\n旅をしてまいりました。", "face": "u127"}, {"name": "レン", "text": "しかし、数日前に魔物たちの襲撃を受け\n父は命を落とし、私だけが生き残ってしまいました。", "face": "u127"}, {"name": "レン", "text": "未熟な私では王子のお役に立つことはないでしょう。\n本来ならば私が命を賭しても父を守らなければ\nならぬところ……。", "face": "u127"}, {"name": "レン", "text": "ただ気にかかるのは魔物たちが\n父の書き記した『兵法書』を奪っていったこと……。", "face": "u127"}, {"name": "アンナ", "text": "――魔物は兵法書などを\n奪ってどうするんでしょうね。\nまさか戦術の勉強でもするんでしょうか。", "face": "l832b17122fb2"}, {"name": "レン", "text": "あの魔物たちの統率された動き……どうやら\n父の残した兵法書を読み解くことが出来る、\n優秀な指揮官がいるようですね。", "face": "u127"}, {"name": "レン", "text": "いたずらに戦えば被害が広がるのみ\n……砦にて迎え撃ちましょう。", "face": "u127"}]}, {"trigger": "end", "lines": [{"name": "レン", "text": "この大軍を退けるとは……お見事です。\n敵が撤退を開始します。追撃の準備を。", "face": "u127"}, {"name": "レーヴ", "text": "………………王子、お見事でした！\nそれに、レンさんの戦術も\n見惚れるほど素晴らしかったです！", "face": "u454"}, {"name": "レーヴ", "text": "私もレンさんの戦術の下であれば\n華麗に闘う事ができるのでしょうか……？", "face": "u454"}, {"name": "レーヴ", "text": "……い、いえ。\nやはり適材適所……向き不向きはありますよね？", "face": "u454"}, {"name": "レーヴ", "text": "ですがめげたりなどしません！　\n戦闘は得意ではありませんが、神殿書記官として\n私にしかできないことがあるはず……。", "face": "u454"}, {"name": "レーヴ", "text": "はい、これからも精一杯頑張ります！\nそれでは、王子。次の記憶へと参りましょう。", "face": "u454"}]}], "active": true}