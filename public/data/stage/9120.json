awn_sec": 131}, {"enemy_id": 12, "source": "local", "count": 42, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 150}, {"enemy_id": 9, "source": "local", "count": 10, "form_count": 1, "hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 24, "attack_wait": 1, "attack_interval": 51, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097968, "race_id": 9, "master_id": 55, "global_id": 54, "spawn_sec": 161}, {"enemy_id": 13, "source": "local", "count": 6, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 177}, {"enemy_id": 14, "source": "local", "count": 52, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1000, "attack_range": 200, "attack_speed": 70, "attack_wait": 55, "attack_interval": 163, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116288, "race_id": 9, "missile_id": 26, "master_id": 31344, "global_id": 4963, "ranged": true, "spawn_sec": 185}, {"enemy_id": 15, "source": "local", "count": 6, "form_count": 1, "hp": 100000, "attack": 250, "base_hp": 100000, "base_attack": 250, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 10, "attack_range": 200, "attack_speed": 150, "attack_wait": 30, "attack_interval": 161, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104464, "race_id": 9, "change_to": 15, "change_condition": 1, "missile_id": 132, "missile": {"speed": 4.0, "splash": 133}, "master_id": 533, "global_id": 532, "ranged": true, "variants": [{"hp": 100000, "attack": 4000, "base_hp": 100000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 10, "attack_speed": 150, "attack_wait": 50, "attack_interval": 401, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104448, "race_id": 9, "master_id": 532, "global_id": 531}], "spawn_sec": 230}, {"enemy_id": 17, "source": "local", "count": 15, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 600, "attack_speed": 45, "attack_wait": 10, "attack_interval": 113, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122096, "race_id": 9, "master_id": 32439, "global_id": 6058, "spawn_sec": 238}], "popups": ["ゴブリン王子がいる間は\n敵のゴブリンの攻撃と防御が\nアップします。", "ゴブリン騎獣楽団がいる間は\n敵のゴブリンの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マレス", "text": "──待っていたぞ、王国の戦士たちよ。", "face": "lb2d55be9cb1f"}, {"name": "マレス", "text": "道中トラブルもあったようだが、\n名立たる強者たちと障害を跳ね除け、\nよくぞこの舞台までたどり着いた。", "face": "lb2d55be9cb1f"}, {"name": "マレス", "text": "そんなお前たちに、俺様がとびきりの挑戦者を用意した！", "face": "lb2d55be9cb1f"}]}, {"trigger": "start", "lines": [{"name": "ウルカノ", "text": "なんだ、音楽……？", "face": "u1669a1"}, {"name": "アミー", "text": "──有象無象と宿命付けられ、\nこの世に生まれた者たちがいた。", "face": "u2260a1"}, {"name": "アミー", "text": "強者たちに足蹴にされ、這いつくばって泥すする。\n絶望諦観の渦の中、孤独に立ち上がるは小さな背中。", "face": "u2260a1"}, {"name": "ケイティ", "text": "これは……詩、ですか。", "face": "u114"}, {"name": "アミー", "text": "夢と希望をその身に背負い、暗い闇を突き進む。\n艱難辛苦を乗り越えて、宿命を破りて天へと挑む──", "face": "u2260a1"}, {"name": "アミー", "text": "さあ、見届けようぜ。小さき者たちの下剋上。", "face": "u2260a1"}, {"name": "アミー", "text": "叫ぼうじゃないか、世界に刻む己の名を。", "face": "u2260a1"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "ゴブリン王子", "text": "──我が名はゴブリン王子、小鬼の未来を照らす者なリ。", "face": "l8e0408f4116d"}, {"name": "王子", "text": "──ッ！？", "face": "u1"}, {"name": "ウルカノ", "text": "驚いた、随分と見違えたじゃねぇか。\n心なしか喋りも流暢になってやがるぜ。", "face": "u1669a1"}, {"name": "ゴブリン博士", "text": "当然デアル！　かつてのご子息と侮るなかレ！", "face": "l5625e950bb42"}, {"name": "ゴブリン博士", "text": "ご子息はアノ日の敗北から今日マデ、\n血の滲むような努力を続けられてキタ！", "face": "l5625e950bb42"}, {"name": "ゴブリン博士", "text": "開拓村でフィジカルを鍛え、剣技を修めラレ！\n過酷な魔界深部での武者修行を完遂されたのダ！", "face": "l5625e950bb42"}, {"name": "ゴブリン博士", "text": "ご子息は正真正銘、ゴブリン界の英雄へと成長しタ！", "face": "l5625e950bb42"}, {"name": "メカゴブリンクイーン", "text": "獅子は我が子を千尋の谷に落とす。\n──とはよく言ったものねぇ。", "face": "l4456df3bea9d"}, {"name": "ゴブリン王子", "text": "王国の王子よ、我が理想にして我が希望の光よ。\n貴殿のような男になるため、私は努力をしてきタ。", "face": "l8e0408f4116d"}, {"name": "ゴブリン王子", "text": "だが、憧れだけでは決して辿り着けぬ境地を知った。\n貴殿のようになるために、私は貴殿を越えねばならン。", "face": "l8e0408f4116d"}, {"name": "ゴブリン王子", "text": "今日が、その日ダ。貴殿を倒し、私は真の英雄となル。", "face": "l8e0408f4116d"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "ゴブリン王子", "text": "もはや言葉は不要……ここからは剣にて語らン！", "face": "l8e0408f4116d"}, {"name": "マレス", "text": "さあ、クライマックスだ！\nゴブリン王子vs英雄王を継ぐ者！\nリベンジマッチの始まりだぜ！", "face": "lb2d55be9cb1f"}]}, {"trigger": "end", "lines": [{"name": "マレス", "text": "──そこまで、勝者は王国の王子！", "face": "lb2d55be9cb1f"}, {"name": "王子", "text": "…………(ぐっ)", "face": "u1"}, {"name": "ゴブリン王子", "text": "これでも、届かなかったカ……。", "face": "l8e0408f4116d"}, {"name": "ゴブリン博士", "text": "ご、ご子息……！", "face": "l5625e950bb42"}, {"name": "王子", "text": "………………。", "face": "u1"}, {"name": "アンナ", "text": "王子がゴブリン王子に手を差し伸べて……。"}, {"name": "シビラ", "text": "王子もゴブリン王子を認めたんでしょうね。\n後に続く者ではなく、共に並び立つ好敵手として。", "face": "u39"}, {"name": "アミー", "text": "人間とゴブリンが健闘を称え合う姿は美しいですねー。", "face": "u2260a1"}, {"name": "ゴブリン王子", "text": "ギャギャ！　握手、ウレシイ！　ウレシイ！", "face": "l8e0408f4116d"}, {"name": "ヨシノ", "text": "あ、喋りが前に戻った。", "face": "u1104a1"}, {"name": "シズカ", "text": "意識して強い自分を演じてたんでしょうね。\n中身はやっぱり王子の大ファンみたい。", "face": "u101"}, {"name": "メカゴブリンクイーン", "text": "……ふぅ、あの子もまだまだみたいね。帰るわよ。", "face": "l4456df3bea9d"}, {"name": "ゴブリン博士", "text": "メ、メカゴブリンクイーン様！", "face": "l5625e950bb42"}, {"name": "メカゴブリンクイーン", "text": "博士も、時間を無駄にしている暇はないわよぉ？\nあの子の新しいトレーニングメニューを考えなさい。", "face": "l4456df3bea9d"}, {"name": "ゴブリン博士", "text": "……！　お、お任せくだサイ！", "face": "l5625e950bb42"}, {"name": "アミー", "text": "いやぁ、ゴブリンの歴史的瞬間に立ち会えて光栄でした。\nチャムチャムさん、魔猪でキャリー、お願いできます？", "face": "u2260a1"}, {"name": "チャムチャム", "text": "オッケー！　歌、すっごい良かったよ！", "face": "u2146a1"}, {"name": "アミー", "text": "そいつは重畳、それでは皆さんあたしはこの辺で。\nまた音楽で気分でもアゲたいときは呼んでください。", "face": "u2260a1"}, {"name": "ウルカノ", "text": "……なんか、思ったより爽やかに終わったな。", "face": "u1669a1"}, {"name": "ユリクセス", "text": "まあ、ここのところずっと張り詰めていたからな。\nちょっとした息抜きぐらいにはなったんじゃないか。", "face": "u2193a1"}, {"name": "トラム", "text": "自分の背中を追ってくれる相手との純粋な競い合い、\nあんなに楽しそうな王子は久しぶりに見たわね。", "face": "u1110a1"}, {"name": "王子", "text": "…………(にこにこ)", "face": "u1"}, {"name": "アイネ", "text": "はっ！？　まさかマレス様は、\n決戦を前に心労を抱えた王子を見兼ねて……？", "face": "u2262a1"}, {"name": "マレス", "text": "…………フッ。", "face": "lb2d55be9cb1f"}, {"name": "アイネ", "text": "さすがマレス様！", "face": "u2262a1"}, {"name": "バスティス", "text": "『…………フッ』じゃねーのにゃ。\n絶対そんなこと考えてないのにゃよ。", "face": "u1892a1"}, {"name": "マレス", "text": "今回の戦神コロッセウムはこれで終幕だ。\n王子、優勝者であるお前には俺様の加護と──", "face": "lb2d55be9cb1f"}, {"name": "マレス", "text": "しばしの間、アイネを預けよう。\n俺様の副官だ、とびきり優秀だぜ？", "face": "lb2d55be9cb1f"}, {"name": "ウルカノ", "text": "──おい、いいのかよ？", "face": "u1669a1"}, {"name": "アイネ", "text": "御主命とあらば、如何様にも。", "face": "u2262a1"}, {"name": "マレス", "text": "俺様はお前たちに大きく期待している。\nゆえの判断だ、戦神マレスに二言はない。", "face": "lb2d55be9cb1f"}, {"name": "マレス", "text": "王子よ、俺様は次のコロッセウムでお前を待っているぞ。", "face": "lb2d55be9cb1f"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "マレス", "text": "話は以上だ、俺様は帰るが──", "face": "lb2d55be9cb1f"}, {"name": "マレス", "text": "忘れるな、王国には戦神の加護があることを。", "face": "lb2d55be9cb1f"}]}, {"trigger": "route", "enemy_ids": [3], "lines": [{"name": "シャディア", "text": "気を付けろ王子！　何か来るぞ！", "face": "u713"}, {"name": "ゴブリン王子", "text": "──師から受け継ぎし我が奥義を見よ！", "face": "l8e0408f4116d"}, {"name": "ゴブリン王子", "text": "必殺──ゴブリン流星剣ッ！", "face": "l8e0408f4116d"}]}], "active": true}