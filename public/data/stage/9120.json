{"quest_id": 9120, "name": "決勝Lv.1", "description": "吟遊詩人の詩が流れる中、敗北を糧に\n小鬼の英雄へと成長した挑戦者が現れる。\n戦いで鍛え上げた武威を示し、勝利を掴め！\n＜ユニット、アイテムのドロップなし＞", "modifier_notes": ["ユニット、アイテムのドロップなし"], "event": "モンスターズアッセンブル", "event_category": "History", "mission_id": 920220, "map_no": 7151, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 45, "attack_interval": 245, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2155792, "race_id": 3, "master_id": 37870, "global_id": 11487, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 99999, "attack": 1, "base_hp": 99999, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2097200, "master_id": 37871, "global_id": 11488, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "hp": 112000, "attack": 1200, "base_hp": 112000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 550, "magic_defense": 5, "attack_range": 200, "attack_speed": 10, "attack_wait": 25, "attack_interval": 127, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2142640, "race_id": 9, "special_effect_id": 1817, "change_to": 3, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 37866, "global_id": 11483, "ranged": true, "to_global_id": 11484, "route_behav