5, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 113}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "hp": 2400, "attack": 650, "base_hp": 2400, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "master_id": 24, "global_id": 23, "spawn_sec": 118}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 620, "base_hp": 18000, "base_attack": 620, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126864, "race_id": 20, "change_to": 21, "master_id": 33340, "global_id": 6957, "to_global_id": 6958, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 158}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 1860, "base_hp": 18000, "base_attack": 1860, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126880, "race_id": 20, "change_to": 22, "change_condition": 4, "master_id": 33341, "global_id": 6958, "to_condition": 4, "to_ticks": 1, "to_global_id": 6959}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 620, "base_hp": 18000, "base_attack": 620, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126864, "race_id": 20, "master_id": 33342, "global_id": 6959, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "天槍騎兵長", "text": "さぁスルーズ、別働隊を呼べ。\n父上を侮辱する物質界の者たちに、\nより深き絶望を与えるのだ……。", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "……もうやめましょう。\n姉さま、こんなことをしたって、\nお父さまは戻ってこないんですよ……？", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "まだ言うか、スルーズ！\n地上の民は、父上の槍を盗んだ大罪人だぞ！", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "そんな連中の肩を持つなら、\nスルーズ、お前とて同罪だ！", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "……ッ！\n……わかり、ました。\nごめんなさい姉さま、私も、戦います……。", "face": "u1143a1"}, {"name": "テティス", "text": "はぁ……うんざりですね、こういうの。\n誰かの目的のために、女の子が涙を流すなんて。", "face": "u37"}, {"name": "クリッサ", "text": "えぇ、本当に。\n戦争はこんなことの繰り返し……。\n誰かがその連鎖を断ち切らないと。", "face": "u52"}, {"name": "アンナ", "text": "王子、天槍騎兵団が来ます。\n迎撃の準備をお願いします。\nここで、あの子たちを止めましょう！", "face": "l921e0527bf8c"}]}, {"trigger": "end", "lines": [{"name": "天槍騎兵長", "text": "何故だ……私は物質界により深き絶望を……。\n王国の真の力を見極めるために……。\nそれなのに、なぜこの槍が届かない……。", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "姉さま、撤退しましょう！\nこのままだと森の火に巻き込まれます！", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "くっ……だが……！\n槍を盗んだあの男を赦すわけには……！", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "黙っていてください、ほら、肩を貸しますから。\n……それから、あなたが、王子ですよね？", "face": "u1143a1"}, {"name": "スルーズ", "text": "王子、そしてトラム様、私は姉さまと行きます。\n――どうか、私たちを止めてください。", "face": "u1143a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ミーシャ", "text": "……天槍騎兵団、および天界兵、撤退していきます。", "face": "u19"}, {"name": "キャリー", "text": "王子、近隣の街より警備兵の応援が到着しました。\nこのまま消火作業に入ります！", "face": "u26"}, {"name": "フウカ", "text": "急いで！　時間をかけると被害が拡大するわ！\nまだ魔物がいるかもしれないから、\n部隊ごとに連携して動いて！", "face": "u228"}, {"name": "アンナ", "text": "……いったい、どうしたら\n彼女たちを止められるのでしょうか。", "face": "lb06e935627dd"}, {"name": "トラム", "text": "天使アラエルに、天槍騎兵団……。\nきっと他にも、今回の黒幕の被害者はいるはずよ。", "face": "u1110a1"}, {"name": "トラム", "text": "目的が何かはわからないけれど、\nそのために誰かの心を縛るなんて、\n決して赦されることではないわ。", "face": "u1110a1"}, {"name": "トラム", "text": "けれどまずは、彼女たちを止めましょう。\nこれ以上、罪を重ねさせないために。", "face": "u1110a1"}, {"name": "アンナ", "text": "……ですね。\n王子、消火活動と並行して、\n天槍騎兵団の行方を捜索します。", "face": "l921e0527bf8c"}, {"name": "アンナ", "text": "絶対に、彼女たちの凶行を止めましょう！", "face": "l921e0527bf8c"}]}], "story_talk": true, "active": true}