"count": 44, "form_index": 0, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 25}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 12000, "attack": 200, "base_hp": 12000, "base_attack": 200, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 50, "attack_interval": 152, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109728, "special_effect_id": 142, "change_to": 5, "missile_id": 194, "missile": {"speed": 15.0}, "master_id": 30189, "global_id": 3808, "to_condition": 0, "to_global_id": 3955, "route_behaviour": {"transforms": [{"wait": 360}]}, "spawn_sec": 135}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 200, "base_hp": 12000, "base_attack": 200, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_range": 210, "attack_speed": 1, "attack_wait": 50, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109728, "special_effect_id": 142, "missile_id": 194, "missile": {"speed": 15.0}, "master_id": 30336, "global_id": 3955, "ranged": true, "from_condition": 0}], "dialogue": [{"trigger": "start", "lines": [{"name": "雷神", "text": "――失せろ！\nこの雷神は貴様ら人間どもと馴れ合うつもりはない！", "face": "l9bc7f2309274"}, {"name": "カゲロウ", "text": "少しはこちらの話を聞け！\n端から馴れ合ってくれなどとは頼んでいない。", "face": "u139"}, {"name": "フドウ", "text": "左様。拙僧らはお主が華の国の邪仙の手に落ちぬよう\n警告に参っただけなのだ。", "face": "u238"}, {"name": "雷神", "text": "ワシが邪仙如きの手に落ちるだと？\nフン、馬鹿も休み休み言え。", "face": "l9bc7f2309274"}, {"name": "フドウ", "text": "なにを言う。\nお主の盟友、風神が妖天君という邪仙に魂パクを奪われ、\nそやつの操り人形とさせられたことを忘れたか？", "face": "u238"}, {"name": "フドウ", "text": "その妖天君が何処からか現れ、術で妖どもを操って\n次々と軍列に加えているのを見た者がいるのだ。", "face": "u238"}, {"name": "雷神", "text": "このワシが風神と同じ末路を辿るというのか？\n馬鹿馬鹿しい、侮るのもいい加減にしろ！", "face": "l9bc7f2309274"}, {"name": "妖天君", "text": "――なら、試してみるかイ？", "face": "la9cd64d9130d"}, {"name": "カゲロウ", "text": "なッ――妖天君！？\nいつの間に……。", "face": "u139"}, {"name": "イロハ", "text": "と……とにかく、\n雷神の魂パクを奪われるわけにはいきません！\nここは私たちでヤツを撃退しましょう！", "face": "u242"}, {"name": "妖天君", "text": "……目障りな奴らだネェ。\nボクの魂パク集めを邪魔してくれちゃってサ。", "face": "la9cd64d9130d"}, {"name": "妖天君", "text": "そんなに死に急ぐなら、\n望み通りにしてあげるヨ……ほほいっ！", "face": "la9cd64d9130d"}, {"name": "カゲロウ", "text": "むッ――気をつけろ！\nヤツに操られた妖どもが鬼門から出てくるぞ！", "face": "u139"}]}, {"trigger": "end", "lines": [{"name": "妖天君", "text": "うっ……。", "face": "la9cd64d9130d"}, {"name": "カゲロウ", "text": "はぁ……はぁ……や、やったか？", "face": "u139"}, {"name": "妖天君", "text": "……な～んちゃってネ――ホイッ！", "face": "la9cd64d9130d"}, {"name": "雷神", "text": "――グフゥッ！？", "face": "l9bc7f2309274"}, {"name": "カゲロウ", "text": "なッ――あの距離から不意打ちだと！？", "face": "u139"}, {"name": "雷神", "text": "グ、オオォ……ッ！\n不意打ちとは……卑怯、な……ッ！", "face": "l9bc7f2309274"}, {"name": "妖天君", "text": "へぇ、まだ喋る元気があるとはネェ。\n丈夫な操り人形が手に入って嬉しいヨ……ほほいっ！", "face": "la9cd64d9130d"}, {"name": "雷神", "text": "――グハァアアアッ！！　\n……ガ…………グ、ウゥッ……。", "face": "l9bc7f2309274"}, {"name": "カゲロウ", "text": "お……おのれ、外道め！", "face": "u139"}, {"name": "妖天君", "text": "ククッ……おめでたい奴らだネェ。\n勝ち負けの他に必要なものが\n戦にあると思ってるのかイ？", "face": "la9cd64d9130d"}, {"name": "妖天君", "text": "卑怯とでも外道とでも、なんとでも言うがいいサ。\n喋れなくなる前に、ネ……。", "face": "la9cd64d9130d"}, {"name": "ヨジロウ", "text": "あ、こら、待つだ！", "face": "u236"}, {"name": "カゲロウ", "text": "くっ……鬼門に逃げ込まれたか。", "face": "u139"}, {"name": "フドウ", "text": "……今更嘆いたところで詮無きこと。\nまずは雷神の魂パクが妖天君に奪われたことを\nお上に報告せねばなるまい……。", "face": "u238"}]}, {"trigger": "end", "lines": [{"name": "金光聖菩", "text": "…………ふふ。\nこの私が上空から見ていたとは、よもや思うまい。"}, {"name": "金光聖菩", "text": "にしても、見損なったぞ妖天君。\n東の国を侵略するために戦力拡充が必要とはいえ、\nああもなりふり構わず妖怪どもの魂パクを奪うとは。"}, {"name": "金光聖菩", "text": "邪道と誹られようが、道を極めんとする求道者。\nそれが邪仙というものであり、\n我らが自ら誇りとするところでもあったはずだ。"}, {"name": "金光聖菩", "text": "……だが、先刻のヤツはどうだ？\n妖怪どもを見境なく自陣に加えて悦に入るとは、\n求道者としての誇りを売り渡すに等しい行為ではないか。"}, {"name": "金光聖菩", "text": "あぁ……苛々する。\nこの苛立ちを誰にぶつけてやろうか……。"}]}], "map": {"image": "Map920105_5312", "w": 960, "h": 640, "spots": [{"k": "b", "x": 27, "y": 475}, {"k": "m", "x": 160, "y": 476, "id": 200}, {"k": "m", "x": 277, "y": 469, "id": 201}, {"k": "m", "x": 261, "y": 250, "id": 202}, {"k": "m", "x": 444, "y": 264, "id": 203}, {"k": "m", "x": 335, "y": 405, "id": 204}, {"k": "m", "x": 399, "y": 465, "id": 205}, {"k": "m", "x": 684, "y": 482, "id": 206}, {"k": "m", "x": 515, "y": 426, "id": 207}, {"k": "m", "x": 528, "y": 233, "id": 208}, {"k": "m", "x": 626, "y": 235, "id": 209}, {"k": "m", "x": 592, "y": 338, "id": 210}, {"k": "m", "x": 196, "y": 188, "id": 211}, {"k": "m", "x": 669, "y": 148, "id": 212}, {"k": "m", "x": 604, "y": 452, "id": 213}, {"k": "m", "x": 785, "y": 525, "id": 214}, {"k": "m", "x": 93, "y": 167, "id": 215}, {"k": "m", "x": 309, "y": 312, "id": 216}, {"k": "m", "x": 388, "y": 333, "id": 217}, {"k": "m", "x": 709, "y": 363, "id": 218}, {"k": "m", "x": 505, "y": 161, "id": 219}, {"k": "r", "x": 198, "y": 337, "id": 300}, {"k": "r", "x": 715, "y": 314, "id": 301}, {"k": "r", "x": 360, "y": 264, "id": 302}, {"k": "r", "x": 450, "y": 190, "id": 303}, {"k": "r", "x": 544, "y": 287, "id": 304}, {"k": "r", "x": 417, "y": 403, "id": 305}, {"k": "r", "x": 252, "y": 409, "id": 306}, {"k": "r", "x": 574, "y": 158, "id": 307}, {"k": "r", "x": 772, "y": 465, "id": 308}, {"k": "r", "x": 473, "y": 338, "id": 309}, {"k": "r", "x": 668, "y": 411, "id": 310}], "events": [{"t": 1.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_08", "fx": "StageGate6", "x": 451, "y": 97}]}, {"t": 1.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_09", "fx": "StageGate6", "x": 898, "y": 246}]}, {"t": 1.0, "when": "time", "o