0, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 4}], "dialogue": [{"trigger": "start", "lines": [{"name": "教団員", "text": "ついに見つけたぞ……！　この地に王子がいるのは\n本当だったようだな。", "face": "l5b6da4a97ede"}, {"name": "教団員", "text": "何度も我々の計画を邪魔しおって……ッ！\nかくなる上は我々の命をかけて魔神ロノベ様の\n復活を成就してみせる！！", "face": "l5b6da4a97ede"}, {"name": "アンナ", "text": "ピピンさんは下がってください！　危険です。", "face": "l9f4f7b28a408"}, {"name": "ピピン", "text": "いえ、私も戦います！\n私も風水士として皆さんを助けたいんです……！！", "face": "u275"}, {"name": "教団員", "text": "いいか同胞たちよ。いざというときは\n魔神ロノベ様にその身を捧げるのだ。", "face": "l5b6da4a97ede"}, {"name": "教団員", "text": "もっている骨片をすべて飲み込み、\n骨片の力を解放するのだ……ッ！！！", "face": "l5b6da4a97ede"}]}, {"trigger": "end", "lines": [{"name": "ピピン", "text": "わがままを言ってしまってすみません……。", "face": "u275"}, {"name": "ピピン", "text": "でもこのまま何もしないのは嫌だったんです。\n私も皆さんの力になりたくて……。", "face": "u275"}, {"name": "アンナ", "text": "その気持ちは大切ですが、\nなにかあったらどうするんですか……？", "face": "lc5f3d2b93a36"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "アンナ", "text": "た、確かに私も以前、\n同じようなことをしましたが……、\nそれは、その……。", "face": "l9f4f7b28a408"}, {"name": "アンナ", "text": "……次からは気を付けてくださいね？"}, {"name": "ピピン", "text": "ありがとうございます……！", "face": "u275"}]}], "map": {"image": "Map920049_3613", "w": 960, "h": 640, "spots": [{"k": "b", "x": 25, "y": 290}, {"k": "m", "x": 717, "y": 308, "id": 200}, {"k": "m", "x": 583, "y": 303, "id": 201}, {"k": "m", "x": 566, "y": 221, "id": 202}, {"k": "m", "x": 498, "y": 201, "id": 203}, {"k": "m", "x": 419, "y": 191, "id": 204}, {"k": "m", "x": 335, "y": 187, "id": 205}, {"k": "m", "x": 262, "y": 226, "id": 206}, {"k": "m", "x": 522, "y": 408, "id": 207}, {"k": "m", "x": 445, "y": 415, "id": 208}, {"k": "m", "x": 369, "y": 412, "id": 209}, {"k": "m", "x": 281, "y": 362, "id": 210}, {"k": "m", "x": 238, "y": 287, "id": 211}, {"k": "m", "x": 148, "y": 270, "id": 212}, {"k": "r", "x": 657, "y": 262, "id": 300}, {"k": "r", "x": 627, "y": 376, "id": 301}, {"k": "r", "x": 501, "y": 271, "id": 302}, {"k": "r", "x": 415, "y": 241, "id":