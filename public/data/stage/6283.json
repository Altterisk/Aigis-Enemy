resist": 1000, "pattern_id": 2098816, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 123, "global_id": 122, "ranged": true, "spawn_sec": 79}, {"enemy_id": 9, "source": "local", "count": 15, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 80}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 94}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 36, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099616, "race_id": 16, "special_effect_id": 222, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 181, "global_id": 180, "ranged": true, "spawn_sec": 110}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1100, "base_hp": 10000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 51, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099984, "race_id": 16, "special_effect_id": 222, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 748, "global_id": 747, "ranged": true, "spawn_sec": 110}], "dialogue": [{"trigger": "start", "lines": [{"name": "サバル", "text": "にゃはははっ！　鬼さんこっち～っ！", "face": "u536"}, {"name": "セブン", "text": "くっそーっ！\n待ちやがれ、この泥棒猫め！", "face": "u449"}, {"name": "アンナ", "text": "報せを聞いて駆けつけてみれば……。\n皆さん、これは一体なんの騒ぎですか！？", "face": "lbfab4fba6540"}, {"name": "セブン", "text": "見りゃわかるだろ？\nあのサバルとかっていう生意気な泥棒猫を\nとっ捕まえてやろうとしてるんだよ！", "face": "u449"}, {"name": "セブン", "text": "なにが怪盗サバルだ！\nアタシの縄張りに盗みの予告状なんか\n送ってきやがって……ふざけんなっての！", "face": "u449"}, {"name": "ウル", "text": "っていうわけで、素早さに自信がある\nあたしたちモンクと、任務で王国に来てる\n忍者たちがサバル捕獲作戦に協力してるの！", "face": "u1162"}, {"name": "ケイティ", "text": "今すぐこの騒ぎを止めてください。\n近隣住民から苦情が出ています。", "face": "u114"}, {"name": "ナギ", "text": "断る。いくら王子の命でも、\n主君の領地で盗みを働くような不届き者を\n捨て置くなんて、忍としての信念が許さないからな。", "face": "u1244"}, {"name": "サバル", "text": "にゃははっ、そう言うなら早く捕まえてみなよ。\nまぁ、この天下の大怪盗、サバル様の速さに\nついてこれる人なんていないだろうけどねぇ？", "face": "u536"}, {"name": "サキ", "text": "くぅ～～っ、言ったわねッ！\n待ちなさいサバル！　捕まえてその首に\nでっかい猫用の鈴をつけてやるんだから！", "face": "u1090"}, {"name": "アンナ", "text": "……力ずくで止めるしかなさそうですね。\n王子、騒ぎを起こしている方々を鎮圧しつつ、\n機があればサバルさんを捕らえてしまいましょう。", "face": "l855824aac6c8"}, {"name": "ケイティ", "text": "相手は機動力に長けた者ばかり。\n気を抜けばすぐに脇を通り抜けられてしまいます。\nくれぐれも迅速な采配を。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "ダン", "text": "ぐおッ！？\nな、なんだ……急に身体が痺れて……ッ！", "face": "u204"}, {"name": "サバル", "text": "いやぁ～、君たちが予想以上にしぶといから、\n何人かには痺れてもらおうと思ってね。", "face": "u536"}, {"name": "サバル", "text": "安心するといい、ちょっと痺れさせるだけさ。\nそれに、私の投げナイフに何度も当たるような\n間抜けじゃないかぎり、麻痺することはないよ。", "face": "u536"}]}, {"trigger": "end", "lines": [{"name": "ジーナ", "text": "はぁっ、はぁっ……。\nあーあ、結局捕まえられなかったかぁ。\nさすがは天下の大怪盗、逃げ足も一流ってとこね。", "face": "u1131"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "サバル", "text": "――にゃはは。捕まっちゃったかぁ。\nさすがは王子、私の動きを読み切るとはね。", "face": "u536"}, {"name": "ケイティ", "text": "……なッ！？\n王子、いつの間にサバルさんを\n捕まえていたのですか？", "face": "u114"}, {"name": "サバル", "text": "いやぁ、それにしてもさすがだね。\n速さに自信のある者たちが束になっても\nこの私を捕まえることはできなかったのに……。", "face": "u536"}, {"name": "サバル", "text": "王子たちが来た途端に、この結果だ。\nその統率力、心底尊敬するよ……王子。\nん……ふみゃあ♪　スリスリスリスリ～……♪", "face": "u536"}, {"name": "アンナ", "text": "ちょ、ちょっとサバルさん！\n王子にくっつきすぎではないですか？", "face": "lbfab4fba6540"}, {"name": "サバル", "text": "んん～？　なにを言ってるんだい？\n先に抱きしめてきたのは王子だよ、アンにゃ？", "face": "u536"}, {"name": "アンナ", "text": "アンナですッ！", "face": "lbfab4fba6540"}, {"name": "サバル", "text": "――――あれ、そうだったっけ？\nま、いいじゃないか、細かいことは。\nふふっ……スリスリスリスリ～……♪", "face": "u536"}, {"name": "アンナ", "text": "……もう。\n王子は逃げる貴方を捕まえただけで、\n抱きしめたわけではありませんからね？", "face": "lbfab4fba6540"}, {"name": "アンナ", "text": "王子もあまりサバルさんを\n甘やかしすぎないでくださいね？\n……それでは、そろそろ王城へ戻りましょう。"}]}], "active": true}