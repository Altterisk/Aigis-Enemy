370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "spawn_sec": 18}, {"enemy_id": 6, "source": "local", "count": 12, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 179, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2162336, "race_id": 12, "change_to": 6, "change_condition": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 38998, "global_id": 12615, "ranged": true, "variants": [{"hp": 3500, "attack": 500, "base_hp": 3500, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 5, "attack_wait": 35, "attack_interval": 116, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2162352, "race_id": 12, "master_id": 38999, "global_id": 12616}], "spawn_sec": 31}, {"enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 51}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 75}], "dialogue": [{"trigger": "start", "lines": [{"name": "フィノーラ", "text": "――ギルガメッシュの拠点が分からない？", "face": "u2441a1"}, {"name": "マータン", "text": "うむむーん。\n雪枝の里の戦士たちで手分けして\nあっちこっち探っているし――", "face": "u2524a1"}, {"name": "パルセ", "text": "ドーンブリンガーによる上空からの探知も\n継続してはいるのですが……。", "face": "u2276a1"}, {"name": "フィノーラ", "text": "それでも場所の特定ができない、と。\nなるほど、魔力嵐と吹雪の影響か……。", "face": "u2441a1"}, {"name": "マータン", "text": "それに何より、\n狭間の雪原はとんでもなく広いんだ。", "face": "u2524a1"}, {"name": "マータン", "text": "マータンたちが住んでいる里も、\n南――北の大国との境界からそう離れていないし。\n果てがどこにあるのかも分かっていない。", "face": "u2524a1"}, {"name": "フィノーラ", "text": "ふむ……。\nこの際だ、いっそズィズィーと\nラシュマシュから聞き出すというのは――", "face": "u2441a1"}, {"name": "ズィズィー", "text": "――呼んだね！？", "face": "u2456a1"}, {"name": "ラシュマシュ", "text": "えぇ、呼ばれましたね？", "face": "u2457a1"}, {"name": "ズィズィー", "text": "呼ばれたからには名乗ってあげよう！\n星に轟く禍つ風！　嵐の夜を――", "face": "u2456a1"}, {"name": "フィノーラ", "text": "――名乗りは今度たっぷり聞くから！\nそれで、心当たりは？", "face": "u2441a1"}, {"name": "ラシュマシュ", "text": "そうは言われてもねぇ。\n私たち、味方になったというわけでもないし？", "face": "u2457a1"}, {"name": "ズィズィー", "text": "遊びに来てるだけだもんね。\nそれに――あいつらの拠点の位置、\n誰も正確には知らないんだよ。", "face": "u2456a1"}, {"name": "パルセ", "text": "……誰も？", "face": "u2276a1"}, {"name": "ズィズィー", "text": "拠点そのものじゃなくて、拠点に移動するための\n移動魔法のある場所しか知らないっていうか？", "face": "u2456a1"}, {"name": "ズィズィー", "text": "いつもその移動魔法で拠点に行くから、\nどこにあるかとか知らないんだよねー。", "face": "u2456a1"}, {"name": "フィノーラ", "text": "……移動魔法に相乗りは、まぁ、無理だろうな。\nとなると、手がかりの一切ない拠点を、\n人海戦術で探すしかないということか。", "face": "u2441a1"}, {"name": "？？？", "text": "――そういうことなら！\nわたしたちが力になれるかも！", "face": "u2613a1"}, {"name": "？？？", "text": "でもその前に……。\n王国式の挨拶をしなくちゃね！", "face": "u2613a1"}, {"name": "パルセ", "text": "……王国式、挨拶？", "face": "u2276a1"}, {"name": "？？？", "text": "レッツもぎせーん！！", "face": "u2613a1"}]}, {"trigger": "end", "lines": [{"name": "ファオル", "text": "あっ！　こんな所にいた！\n……あー、もしかして、もう一戦やっちゃった感じ？", "face": "u2513a1"}, {"name": "王子", "text": "…………（ほくほく）", "face": "u1"}, {"name": "？？？", "text": "…………（きらきら）", "face": "u2613a1"}, {"name": "アヴリック", "text": "わぁ、ほくほくきらきらしてますねぇ。", "face": "u2443a1"}, {"name": "ファオル", "text": "クルーナ、模擬戦はあくまで歓迎の催しで、\n挨拶するたびに開くものじゃないって教えたでしょ？", "face": "u2513a1"}, {"name": "クルーナ", "text": "あれ、そうだっけ……？", "face": "u2613a1"}, {"name": "フィノーラ", "text": "えーっと、ひとまず事情を説明してくれないか？", "face": "u2441a1"}, {"name": "アヴリック", "text": "んー、いったいどこから話せばいいか……。", "face": "u2443a1"}, {"name": "ファオル", "text": "端的に言えば、雪枝の里だけでなく、\n狭間の雪原の諸部族が、\n王国に協力を申し出てくれていて……。", "face": "u2513a1"}, {"name": "フィノーラ", "text": "ほう？　それは心強い。\n雪原の地理に詳しい者たちが味方となれば、\nギルガメッシュの拠点捜索もさらに進むはずだ。", "face": "u2441a1"}, {"name": "アヴリック", "text": "ただ、ですね？　その条件というのが――", "face": "u2443a1"}, {"name": "クルーナ", "text": "――王子が、雪原王になること！　だよ！", "face": "u2613a1"}, {"name": "フィノーラ", "text": "…………雪原王？", "face": "u2441a1"}]}], "active": true}