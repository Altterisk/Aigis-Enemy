t_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 133}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 360, "base_hp": 8000, "base_attack": 360, "damage_type": "magical", "armor_defense": 30, "magic_defense": 25, "attack_range": 210, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106576, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 837, "global_id": 836, "ranged": true, "spawn_sec": 147}], "dialogue": [{"trigger": "start", "lines": [{"name": "バシラ", "text": "次はこっちの道です、王子！　\n見たところ、まだ神官戦士達も天使達も、\n私達を追いかけているようですね……。", "face": "u28"}, {"name": "アンナ", "text": "この森は道が複雑に入り組んでいますから、\n上手くいけば敵の追跡から逃れられるはずです。\n王子、お急ぎ下さい！", "face": "l7321c8eb4085"}]}, {"trigger": "start", "lines": [{"name": "天使", "text": "……王子軍を見失ったようですね……。\n本当に大丈夫なのですか？", "face": "l78025fce4bde"}, {"name": "セレイナ", "text": "心配には及びません、天使様。\n既に多数の神官戦士たちが王子を捜索しています。\n……後は追い詰めるだけですよ。", "face": "u375"}, {"name": "天使", "text": "……さすがです、聖なる徒セレイナ。\nその働きぶりに神もきっと\nお喜びになるでしょう……。", "face": "l78025fce4bde"}, {"name": "セレイナ", "text": "ありがたき幸せにございます。\n必ずや王子を捕らえてみせます！", "face": "u375"}]}, {"trigger": "end", "lines": [{"name": "セレイナ", "text": "そ、そんな……。\nまたも、敗れるなんて……このまま、では……。", "face": "u375"}, {"name": "バシラ", "text": "今がチャンスです王子！　私の後に\n付いてきて下さい！　こちらの道を使えば、\n今度こそ敵を撒けるはずです！", "face": "u28"}, {"name": "バシラ", "text": "それに、この先の森は、霧がかってるから、\nあの人達もすぐに私達を見つける事は\n出来ないはずです！", "face": "u28"}, {"name": "アンナ", "text": "ありがとうございます。\n王子、バシラさんの後に続きましょう！", "face": "l7321c8eb4085"}]}], "active": true}