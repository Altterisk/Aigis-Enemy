terval": 205, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2166352, "race_id": 19, "special_effect_id": 1179, "change_to": 4, "missile_id": 1440, "master_id": 39474, "global_id": 13091, "ranged": true, "to_global_id": 13092, "to_flag": [21, 1], "route_behaviour": {"transforms": [{"flag": 21, "val": 1}, {"flag": 22, "val": 1}, {"flag": 23, "val": 1}, {"flag": 24, "val": 1}, {"flag": 25, "val": 1}, {"flag": 26, "val": 1}, {"flag": 27, "val": 1}, {"flag": 28, "val": 1}, {"flag": 29, "val": 1}, {"flag": 30, "val": 1}, {"flag": 31, "val": 1}, {"flag": 32, "val": 1}, {"flag": 33, "val": 1}, {"flag": 34, "val": 1}, {"flag": 35, "val": 1}, {"flag": 36, "val": 1}, {"flag": 37, "val": 1}, {"flag": 38, "val": 1}, {"flag": 39, "val": 1}, {"flag": 40, "val": 1}, {"flag": 41, "val": 1}, {"flag": 42, "val": 1}, {"flag": 43, "val": 1}, {"flag": 44, "val": 1}, {"flag": 45, "val": 1}, {"flag": 46, "val": 1}, {"flag": 47, "val": 1}, {"flag": 48, "val": 1}, {"flag": 49, "val": 1}, {"flag": 50, "val": 1}, {"flag": 56, "val": 1}, {"flag": 57, "val": 1}, {"flag": 58, "val": 1}, {"flag": 59, "val": 1}, {"flag": 60, "val": 1}, {"flag": 51, "val": 1}, {"flag": 52, "val": 1}, {"flag": 53, "val": 1}, {"flag": 54, "val": 1}, {"flag": 55, "val": 1}, {"flag": 61, "val": 1}, {"flag": 62, "val": 1}, {"flag": 63, "val": 1}, {"flag": 64, "val": 1}, {"flag": 65, "val": 1}, {"flag": 66, "val": 1}, {"flag": 67, "val": 1}, {"flag": 68, "val": 1}, {"flag": 69, "val": 1}, {"flag": 70, "val": 1}, {"flag": 71, "val": 1}, {"flag": 72, "val": 1}, {"flag": 73, "val": 1}, {"flag": 74, "val": 1}, {"flag": 75, "val": 1}, {"flag": 76, "val": 1}, {"flag": 77, "val": 1}, {"flag": 78, "val": 1}, {"flag": 79, "val": 1}, {"flag": 80, "val": 1}, {"flag": 81, "val": 1}, {"flag": 82, "val": 1}, {"flag": 83, "val": 1}, {"flag": 84, "val": 1}, {"flag": 85, "val": 1}, {"flag": 86, "val": 1}, {"flag": 87, "val": 1}, {"flag": 88, "val": 1}, {"flag": 89, "val": 1}, {"flag": 90, "val": 1}]}, "spawn_sec": 7}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 120000, "attack": 1500, "base_hp": 120000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 100, "magic_defense": 10, "attack_range": 260, "attack_speed": 50, "attack_wait": 75, "attack_interval": 205, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2166352, "race_id": 19, "special_effect_id": 1300, "change_to": 3, "missile_id": 1440, "master_id": 39475, "global_id": 13092, "ranged": true, "from_flag": [21, 1]}], "dialogue": [{"trigger": "start", "lines": [{"name": "グリム", "text": "――よいしょー。\nふぅ、通路安定してます。\n全員そのまま、落ち着いて通過してくださいー。", "face": "u942"}, {"name": "グリム", "text": "ゲートの中に通路を展開して、\n無理やり安定化させました。\n今回ばかりはグリムちゃんを褒めてもいいですよー。", "face": "u942"}, {"name": "王子", "text": "…………（なでなで）", "face": "u1"}, {"name": "グリム", "text": "えへへー。", "face": "u942"}, {"name": "ズィズィー", "text": "うぇぇー……何だかふらふらするー……。", "face": "u2456a1"}, {"name": "アンナ", "text": "……どうして彼女たちも一緒に来ているんですか？", "face": "l7ab1c1417235"}, {"name": "ラシュマシュ", "text": "ふふっ、もちろん志願したからよ？", "face": "u2457a1"}, {"name": "ズィズィー", "text": "こんな楽しそうなこと、\n乗らない手はないもんねー。", "face": "u2456a1"}, {"name": "ユリクセス", "text": "自分から危険に突っ込んでいく手駒は多い方がいい。\nさて、まずは周辺に危険がないか確認したいが――", "face": "u2193a1"}, {"name": "アキレア", "text": "…………なぁ、おい。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "何だ、脳筋の出番はまだないぞ。", "face": "u2193a1"}, {"name": "アキレア", "text": "いや、あれ。あれ見ろよ。\n――見覚え、あるよな？", "face": "u1972a1"}, {"name": "ガレア", "text": "要塞宮殿――いや、終焉要塞、ゼウス……？", "face": "u2459a1"}, {"name": "オラティル", "text": "起動している様子はないね。\nそれに、魔力もまったく感じられない。", "face": "u2149a1"}, {"name": "レクテ", "text": "うわ、よく見たら辺り一面遺物だらけじゃない！？\n見たことない構造のやつばかり！", "face": "u2047a1"}, {"name": "アルレット", "text": "よし、調査だ！　王子さま！\n調査許可！　いますぐ！", "face": "u1453a1"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ガレア", "text": "ああ、みんな離れるなよ。\n――どうやら、僕らは招かれざる客らしい。", "face": "u2459a1"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "マキナ", "text": "あれは……なんだ……？\n動物じゃなさそうだけど。", "face": "u376"}, {"name": "イリス", "text": "人……いえ、生命力を感じません。\nなんというのか、抜け殻のような……。", "face": "u17"}, {"name": "トラム", "text": "……亜神、とも違うわ。\nまるですべての魔力を失った、神のなれはてみたい。", "face": "u1110a1"}, {"name": "アキレア", "text": "ちっ、攻撃の意志だけはありそうだ。\n仕方ない、迎撃するぞ！", "face": "u1972a1"}]}, {"trigger": "end", "lines": [{"name": "タバサ", "text": "あ、あの、これ無尽蔵に出てきてないですかー！？", "face": "u1064a1"}, {"name": "グリム", "text": "わっ、わっ、皆さん、ストップ！\n撤退！　撤退を進言しまーす！", "face": "u942"}, {"name": "イコル", "text": "どうした、何か問題か？", "face": "u1988a1"}, {"name": "グリム", "text": "あいつらが出現してから、ゲートの魔力が不安定に！\nも、戻れなくなる前に戻りましょー！", "face": "u942"}, {"name": "タバサ", "text": "せめて！　せめて何か回収してから～！", "face": "u1064a1"}, {"name": "グリム", "text": "だめです！\n専門家の言うことはきいてくださーい！", "face": "u942"}, {"name": "アンナ", "text": "皆さん、急ぎ退却を！", "face": "l7ab1c1417235"}, {"name": "ユージェン", "text": "ふふっ。", "face": "u906"}, {"name": "ユージェン", "text": "やっぱり、こうじゃないと。", "face": "u906"}, {"name": "サナラ", "text": "こう、というと？\n危機的状況のことですー！？", "face": "u921"}, {"name": "ユージェン", "text": "危険でも、大変でも、\n仲間といっしょに\n新天地に行くのは、何だか楽しいってこと！", "face": "u906"}, {"name": "エフトラ", "text": "ユージェン！\nゲートが不安定になっています！　急いで！", "face": "u1468a1"}, {"name": "ユージェン", "text": "ごめん！　急ぐ！", "face": "u906"}, {"name": "ユージェン", "text": "またすぐに戻って来るから！\n首を洗って待っておけ！　未知の世界！", "face": "u906"}]}], "active": true}