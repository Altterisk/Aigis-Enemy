k_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 101}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 1800, "attack": 300, "base_hp": 1800, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 141, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 314, "global_id": 313, "ranged": true, "spawn_sec": 136}], "popups": ["　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇"], "dialogue": [{"trigger": "start", "lines": [{"name": "ケイティ", "text": "なんという雪……こう視界が悪くては\n教団員を見つけるのも一苦労ですね。", "face": "u114"}, {"name": "ソーマ", "text": "そうですね……。ずっと見張っているのですが、\n「吹雪」が吹いちゃうと、\n遠くが全然見えなくなっちゃいます……。", "face": "u23"}, {"name": "ケイティ", "text": "吹雪の中では飛び道具を使う部隊は、\n遠くを狙えなくなるでしょう。", "face": "u114"}, {"name": "兵士", "text": "報告！　教団員と思わしき輩は\n砦の方向に向かっているとのこと！", "face": "le9079e806633"}, {"name": "アンナ", "text": "分りました！\n王子、追撃の準備をお願いします。\n「グリモワールの書片」を取り戻しましょう。", "face": "l546252706e34"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "ひとまずは教団員達を捕らえる事が出来ましたが……\n彼らが持ち去ったグリモワールの書片は、\nこの程度ではないはずです。", "face": "u114"}, {"name": "アンナ", "text": "はい。引き続き辺りの捜索を続けましょう。", "face": "l546252706e34"}]}], "map": {"image": "Map920089_3963", "w": 960, "h": 640, "spots": [{"k": "b", "x": 481, "y": 529}, {"k": "m", "x": 707, "y": 183, "id": 200}, {"k": "m", "x": 459, "y": 219, "id": 201}, {"k": "m", "x": 331, "y": 235, "id": 202}, {"k": "m", "x": 214, "y": 255, "id": 203}, {"k": "m", "x": 714, "y": 368, "id": 2