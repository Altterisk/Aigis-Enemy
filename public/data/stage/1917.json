{"quest_id": 1917, "name": "クラールフの神殿", "description": "クラールフに敵対する新たな勢力が現れた。\n神殿に侵攻してくる敵の軍勢を撃退せよ！\n＜深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション10", "event_category": "Story", "mission_id": 100010, "map_no": 1137, "level": 100, "multiplier": 1.0, "charisma": 53, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 18, "form_count": 1, "tags": ["水中"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 5, "attack_interval": 60, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2123616, "race_id": 7, "master_id": 32682, "global_id": 6300, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 69, "form_count": 1, "tags": ["水中"], "hp": 5500, "attack": 220, "base_hp": 5500, "base_attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126560, "race_id": 18, "special_effect_id": 660, "change_to": 2, "change_condition": 1, "master_id": 34525, "global_id": 8142, "variants": [{"tags": ["水中"], "hp": 5500, "attack": 220, "base_hp": 5500, "base_attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126576, "race_id": 18, "master_id": 34526, "global_id": 814