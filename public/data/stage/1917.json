al": 226, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126512, "race_id": 7, "change_to": 7, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 34527, "global_id": 8144, "ranged": true, "variants": [{"hp": 8000, "attack": 1050, "base_hp": 8000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 8000, "magic_defense": 40, "attack_speed": 1, "attack_wait": 60, "attack_interval": 179, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126496, "race_id": 7, "master_id": 34528, "global_id": 8145}], "spawn_sec": 61}, {"enemy_id": 9, "source": "local", "count": 37, "form_count": 1, "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 20, "attack_range": 180, "attack_speed": 1, "attack_wait": 10, "attack_interval": 57, "move_speed": 2400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2128976, "race_id": 7, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 34529, "global_id": 8146, "ranged": true, "spawn_sec": 69}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 15000, "attack": 800, "base_hp": 15000, "base_attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 250, "attack_speed": 1, "attack_wait": 50, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124416, "race_id": 7, "special_effect_id": 220, "missile_id": 480, "missile": {"speed": 3.0}, "master_id": 32768, "global_id": 6386, "ranged": true, "spawn_sec": 180}, {"enemy_id": 11, "source": "local", "count": 14, "form_count": 1, "hp": 45000, "attack": 1500, "base_hp": 45000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 6000, "magic_defense": 20, "attack_speed": 60, "attack_wait": 60, "attack_interval": 228, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119360, "race_id": 7, "master_id": 33060, "global_id": 6677, "spawn_sec": 183}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "tags": ["水中"], "hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 40, "attack_speed": 1, "attack_wait": 150, "attack_interval": 358, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126528, "race_id": 7, "master_id": 34524, "global_id": 8141, "spawn_sec": 300}], "dialogue": [{"trigger": "start", "lines": [{"name": "クラールフ", "text": "――創造神による、世界の創生。\nこの世界の始まりの時に、\n我らも無数の生命をこの世界へ送り出した。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "己に奉仕する種族を作る者もいれば、\n自由意志を持つ、新たな生命を生み出した者もいた。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "そして我とポセイオスは、共に水を司る神として、\nこの大海に水の民を作り出したのだ。", "face": "l93d772652f9f"}, {"name": "キュステ", "text": "……えっと、友だちだったということですか？", "face": "u1248a1"}, {"name": "クラールフ", "text": "で、あれば良かったのだがな。\nあやつは己の領域を広げるために、\n他の生命を滅ぼすことを躊躇しなかった。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "海の残り半分を手に入れ、その後には\n乾いた地の全てを、海に沈めんとしていたのだ。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "ゆえに、我は神としての力の全てを注ぎ、\nあやつから神の力を剥奪したのだ……。", "face": "l93d772652f9f"}, {"name": "シャディア", "text": "……その恨みゆえに、\nポセイオスはこの海底都市を狙っていると？", "face": "u713"}, {"name": "クラールフ", "text": "――否、それ以上を望んでいることだろう。\n天界の暗躍、突如現れた冥界軍、\nそして此度の事変と、あまりにも時が揃いすぎている。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "おそらくは、偶然ではあるまい。\nかの三亜神の企み、\n世界を揺るがす動乱に繋がるものであるはずだ。", "face": "l93d772652f9f"}, {"name": "ハルフゥ", "text": "神の座を追われた亜神、ですか……。\n力を奪われたとなれば、それを取り戻すために……？", "face": "u1118a1"}, {"name": "クラールフ", "text": "もしそれが目的であるならば、\n人類にとっては避けられぬ戦いとなることだろう。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "……神の力を取り戻す手段は、そう多くない。\n現実的な手段を選ぶならば、\n数多の命を己に捧げさせようとするはずだ。", "face": "l93d772652f9f"}, {"name": "ハルフゥ", "text": "……そんなことは、絶対にさせません。\nこっちにはクラールフ様と王子さまがいるんですから！\n絶対大丈夫――", "face": "u1118a1"}, {"name": "衛兵マーマン", "text": "――伝令！　伝令！\nクラールフ様、海底都市に向けて、\n無数の軍勢が接近中です！", "face": "l84dcfbcc054a"}, {"name": "クラールフ", "text": "随分と動きが早い……。\n先手を打ってきたのは、あやつの方だったか。", "face": "l93d772652f9f"}, {"name": "アンナ", "text": "王子、迎撃に出ましょう！\nポセイオスの企みを砕くために！", "face": "l69e56a270b4d"}]}, {"trigger": "end", "lines": [{"name": "リバン", "text": "ロブスナイトまで出てくるなんて。\nこの海域にはいないはず、ですわよね……？", "face": "u1062a1"}, {"name": "ハルフゥ", "text": "あれはもっと深い場所に棲息しているはず。\n……間違いなく、何者かに率いられた軍勢ですね。", "face": "u1118a1"}, {"name": "？？？", "text": "グワッハッハッハ！\nクラールフよ、随分な歓迎じゃなぁ！", "face": "lfc16c4c73f16"}, {"name": "？？？", "text": "旧友が訪ねて来たのだぞ？\n歓迎どころか、銛を向けてくるとは酷いではないか！", "face": "lfc16c4c73f16"}, {"name": "クラールフ", "text": "我を友だと思ったことが、一度でもあったのか？\n亜神ポセイオスよ、戯言もそれくらいにしておけ。", "face": "l93d772652f9f"}, {"name": "ポセイオス", "text": "私はお前を友だと思っていたのじゃぞ？\n裏切り、私から神の力を剥奪したあの時まではのぅ！", "face": "lfc16c4c73f16"}, {"name": "ポセイオス", "text": "海を統べる者同士、世界を沈めた後には\nその半分くらいは分けてやろうと思ったものよ！", "face": "lfc16c4c73f16"}, {"name": "ポセイオス", "text": "しかし、それにしてもあのクラールフが、\nまさか溺れる民の手を借りるとは……。\nとうとう誇りまで無くしたかのう？", "face": "lfc16c4c73f16"}, {"name": "クラールフ", "text": "此れなる者は、我が盟友だ。\n侮辱しないでもらおう、ポセイオスよ。", "face": "l93d772652f9f"}, {"name": "ポセイオス", "text": "……盟友？　ほう、よく見ればその顔、\nガリウスを滅ぼしたという人間の王子か？", "face": "lfc16c4c73f16"}, {"name": "ポセイオス", "text": "グワッハッハッハ！\n臣下の言葉は冗談だと思っていたぞ！\nこの深海に、例の王子が来ているとはのぉ！", "face": "lfc16c4c73f16"}, {"name": "ポセイオス", "text": "王子よ、私は他の亜神とは違う。\n貴様を殺そうなどとは考えておらぬ。", "face": "lfc16c4c73f16"}, {"name": "ポセイオス", "text": "そう、神に仇なす程の人間となれば、\nその偉業を愛で、可愛がってやるのが筋というもの。\n貴様も私のもとで、永遠の寵愛を授けてやろうぞ。", "face": "lfc16c4c73f16"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ポセイオス", "text": "なんじゃ、その反抗的な目つきは。\n……神の寵愛を断るとは、今の時代の人間は\n本当に度し難いのう……。", "face": "lfc16c4c73f16"}, {"name": "ポセイオス", "text": "なれば貴様にも、身の程というものを教えてやらねば。\n我が配下共よ、進軍せよ！！", "face": "lfc16c4c73f16"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 49, "params": [50]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 6000, "attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "pattern_id": 2123616}, {"enemy_id": 2, "hp": 5500, "attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "pattern_id": 2126560}, {"enemy_id": 4, "hp": 5250, "attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "pattern_id": 2123792}, {"enemy_id": 5, "hp": 6000, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 5, "form_index": 1, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 7, "hp": 8000, "attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "pattern_id": 2126512}, {"enemy_id": 9, "hp": 18000, "attack": 800, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 20, "pattern_id": 2128976}, {"enemy_id": 10, "hp": 15000, "attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "pattern_id": 2124416}, {"enemy_id": 11, "hp": 45000, "attack": 1500, "damage_type": "physical", "armor_defense": 6000, "magic_defense": 20, "pattern_id": 2119360}, {"enemy_id": 12, "hp": 30000, "attack": 2000, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 40, "pattern_id": 2126528}]}, "active": true}