se": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "spawn_sec": 207}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 240, "attack_speed": 1, "attack_wait": 15, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118288, "race_id": 16, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 31682, "global_id": 5301, "ranged": true, "spawn_sec": 211}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 28000, "attack": 300, "base_hp": 28000, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_wait": 25, "attack_interval": 86, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118272, "special_effect_id": 371, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 31681, "global_id": 5300, "ranged": true, "spawn_sec": 215}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "tags": ["金光陣"], "hp": 35000, "attack": 1000, "base_hp": 35000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 600, "magic_defense": 70, "attack_range": 200, "attack_speed": 100, "attack_wait": 60, "attack_interval": 165, "move_speed": 650.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114816, "special_effect_id": 92, "missile_id": 6, "master_id": 31061, "global_id": 4680, "ranged": true, "spawn_sec": 217}, {"enemy_id": 18, "source": "local", "count": 4, "form_count": 1, "hp": 15000, "attack": 800, "base_hp": 15000, "base_attack": 800, "damage_type": "magical", "armor_defense": 500, "magic_defense": 70, "attack_range": 200, "attack_speed": 100, "attack_wait": 60, "attack_interval": 165, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114816, "special_effect_id": 294, "missile_id": 6, "master_id": 31062, "global_id": 4681, "ranged": true, "spawn_sec": 219}], "popups": ["イングリッドは一定範囲内の\nユニットの魔法耐性を\n半減させます。", "金光聖菩は分身がいる間、\n攻撃力、防御力がアップします。\nまた、分身の数に応じて効果が\n重複します。", "スーシェンは倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "キュウビ", "text": "――なぁディアナよ。\n本当にわらわ達が、\n王国のパレードに参加して良かったのだろうか。", "face": "u465"}, {"name": "ディアナ", "text": "……それは私も、今でも疑問に思っています。\n人気闘兵なる催しがあったとは聞いていますが、\nまさか帝国軍たる私達が招待されるとは……。", "face": "u1624"}, {"name": "クラマ", "text": "気にするでない、帝国の者達よ。\nそれを言えば余とて天狗の里の者。\n王国の祭りに国賓として招待されたと思えば良い良い。", "face": "u572"}, {"name": "アリス", "text": "ですです。それに昔ならいざ知らず、\n今の王国、帝国は協力関係にあるんですから、\nまったく問題ないかと！", "face": "u1288"}, {"name": "イングリッド", "text": "……他国の姫が言うと、説得力がありますね。\nしかしこうして民が手を振ってくれるのを見ていると、\n平和の為に戦っているのだと実感が湧きます。", "face": "u1323"}, {"name": "リズリー", "text": "イングリッドは真面目だなぁ……。\nあっ、屋台のおっじさーん！\nそのお菓子ちょーうだいっ♪", "face": "u716"}, {"name": "金光聖菩", "text": "むむ、リズリーよ、\nそのお菓子を私にも寄越すと良い。\n王国の甘味となれば興味があるぞ。", "face": "u630"}, {"name": "ディアナ", "text": "……王国の者がこれだけ\n自由気ままに過ごしているのなら、\n確かに帝国の者がいても問題ないかもしれませんね。", "face": "u1624"}, {"name": "スーシェン", "text": "――肯定。\n長き戦乱の世を生きる人間の皆さまなれば、\n国を問わず息抜きが重要だとスーシェンも同意します。", "face": "u607"}, {"name": "ソニア", "text": "――はい！\n盛り上がってますね！　いい感じですね！\nそういうわけでソニアちゃんです♪", "face": "u748"}, {"name": "スーシェン", "text": "――不可解。\nどういうわけでソニアちゃんなのでしょうか。", "face": "u607"}, {"name": "ソニア", "text": "第一回人気闘兵では、\n最終的に市民の皆さまへ模擬戦を披露し、\n大好評を収めたと記録が残っていました。", "face": "u748"}, {"name": "ソニア", "text": "先人の知恵が残されているのなら、\nそれを活かさぬのは愚者の行い。\nならば今回も皆さんで演武をせねばと思ったわけで！", "face": "u748"}, {"name": "ケイティ", "text": "無論、既に許可は得ています。\n栄誉ある人気闘兵上位入賞者の皆さんの\n華麗なる戦いぶりを、民に見せてあげてください。", "face": "u114"}, {"name": "金光聖菩", "text": "…………ほう。\n腹ごなしの運動までさせてくれるとは、\n人気闘兵は実に良き催しなのだな。", "face": "u1630"}, {"name": "スーシェン", "text": "――肯定。\n邪仙と意見があうのは少々不本意ですが、\n王子が認めた仲間ならば良しとします。ふんす。", "face": "u607"}, {"name": "金光聖菩", "text": "口の減らぬキョンシーだ。\nだがこのやり取りも愉快ではある。\nでは行くぞ王子よ、共に高め合おうではないか！", "face": "u1630"}]}, {"trigger": "end", "lines": [{"name": "ソニア", "text": "ふっふっふ、街の皆さんも\nカッコイイ模擬戦に大盛り上がり！\nやはり先人の知恵は利用するべきですね！", "face": "u748"}, {"name": "アルティア", "text": "……くっ、せっかくの晴れ舞台に\n間に合いませんでしたか。\n王子との貴重な手合わせの機会が……。", "face": "u261"}, {"name": "モルテナ", "text": "王子との手合わせって、\nそんなに貴重な気がしないような……？\nあっ、ラピス、そのお菓子もう一個ちょうだい♪", "face": "u357"}, {"name": "ラピス", "text": "…………自分で買え。\n――あっ、こら、勝手に取っていくな。\n……こっちの包みは渡さないぞ。", "face": "u436"}, {"name": "シルヴィア", "text": "そっちはお土産用だったりするんですの？\nそんな大事そうに抱えているなんて♪", "face": "u442"}, {"name": "ラピス", "text": "…………黙れ。気にするな。", "face": "u436"}, {"name": "シビラ", "text": "国をあげてのパレードなのに、\n何も変わらないのが皆らしい、のかな。\nあなたもそう思わない？", "face": "u39"}, {"name": "リンネ", "text": "…………んっ、あ、どうしたのじゃ？\n汝もこの屋台の焼き菓子を食べたいのか……？", "face": "u351"}, {"name": "シビラ", "text": "……ふふっ、そうね。\n私にも、ひとくちもらえる？", "face": "u39"}]}], "story_talk": true, "active": true}