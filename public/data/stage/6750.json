{"quest_id": 6750, "name": "第二回人気闘兵パレード", "description": "人気闘兵上位者たちと華やかに演武せよ！\n＜金光聖菩の分身がいる間、\n金光聖菩の攻撃と防御アップ＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["金光聖菩の分身がいる間、\n金光聖菩の攻撃と防御アップ"], "event": "ゴールドラッシュ23(2019)", "event_category": "Reproduce", "mission_id": 300232, "map_no": 5817, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 17, "level": 50, "form_count": 1, "hp": 3000, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 13, "attack_interval": 54, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100976, "race_id": 16, "special_effect_id": 54, "master_id": 30217, "global_id": 3836, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 17000, "attack": 800, "base_hp": 17000, "base_attack": 800, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_range": 80, "attack_speed": 1, "attack_wait": 13, "attack_interval": 53, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109760, "race_id": 16, "special_effect_id": 144, "missile_id": 11, "master_id": 30218, "global_id": 3837, "ranged": true, "spawn_sec": 17}, {"enemy_id": 3, "source": "local", "count": 9, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 57}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 2, "hp": 2000, "attack": 1500, "base_hp": 2000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 250, "magic_defense": 40, "attack_range": 160