300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106208, "race_id": 7, "master_id": 834, "global_id": 833, "spawn_sec": 355}, {"enemy_id": 41, "source": "local", "count": 2, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 3150, "attack": 750, "base_hp": 5250, "base_attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 97, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123792, "race_id": 7, "missile_id": 45, "master_id": 32765, "global_id": 6383, "ranged": true, "spawn_sec": 434}], "popups": ["サメは攻撃を行うたびに、\n攻撃力がアップしていきます。\n\n２回目の攻撃後、\n攻撃力が最大になります。\n※３回目以降の攻撃力が最大"], "dialogue": [{"trigger": "battle", "at_sec": 141, "lines": [{"name": "フローガ", "text": "王子殿下、封印に亀裂が入っています！\nこのままでは\n完全にバハムトが解き放たれてしまいます……！", "face": "u878"}, {"name": "アンナ", "text": "討伐を急ぐしかありませんね……。\n皆さん、火力を集中してください！", "face": "l6ad2d2ab4d1f"}]}, {"trigger": "battle", "at_sec": 327, "lines": [{"name": "ベアトリカ", "text": "まずい……おい王子！　封印が砕けそうだぞ！", "face": "u157"}, {"name": "デューオ", "text": "さすがは伝説の神獣、簡単にはいかないか……。\nでも諦める選択はないよね。\n全力でバハムトを倒すよ、王子！", "face": "u594"}]}, {"trigger": "end", "lines": [{"name": "マルスィ", "text": "――神獣バハムト、動きが止まりました！", "face": "u1065a1"}, {"name": "ハルフゥ", "text": "潜水騎士の皆さん、\nそのままバハムトを抑え込んでください！\n今なら再封印が可能なはずです！", "face": "u1118a1"}, {"name": "セディナ", "text": "こいつを抑えろって、無理難題を言ってくるなぁ！\nまぁ、やってみせるけどね！", "face": "u1095a1"}, {"name": "キュステ", "text": "鋼の都の技術力、今こそ見せる時！\n蒸気圧、フルパワー！！", "face": "u1248a1"}, {"name": "リバン", "text": "クラールフ様の神殿と、魔力経路が繋がりましたわ！\n海巫女全員と、クラールフ様の魔力を共鳴させて――", "face": "u1062a1"}, {"name": "ハルフゥ", "text": "――この巨岩を再封印の要石に……。\nよし、後少し……皆、意識を集中して……！！", "face": "u1118a1"}]}, {"trigger": "end", "lines": [{"name": "ヴィアベル", "text": "……封印、うまくいった？\nもう大丈夫……かしら……？", "face": "u1247a1"}, {"name": "フローガ", "text": "神獣バハムトの魔力、急速に縮小していきます。\n封印は……成功のようです！", "face": "u878"}, {"name": "ハルフゥ", "text": "……でも、これは一時的なものです。\n最初の封印と比べれば、不安定すぎます。", "face": "u1118a1"}, {"name": "ヴィアベル", "text": "もし封印が解けたら、また今回みたいな\n戦いをしないといけないってことなのね……。", "face": "u1247a1"}, {"name": "ハルフゥ", "text": "その時までに、新たな封印方法を模索しないとですね。\nクラールフ様にも協力を仰ぎましょう。", "face": "u1118a1"}, {"name": "フローガ", "text": "……ん？　ちょっとまってください。\nかすかにバハムトの魔力が残っています。\nあの……岩陰のあたりでしょうか……？", "face": "u878"}, {"name": "ベアトリカ", "text": "なっ、もう封印を解いたってのか！？", "face": "u157"}, {"name": "ハルフゥ", "text": "いえ、これは……古い封印の要石の欠片のようですね。\n長くバハムトを封じてきたために、\n魔力が一部移ってしまっているようです。", "face": "u1118a1"}, {"name": "キュステ", "text": "……これ、バハムト対策に使えたりしません？\n例えばバハムトの魔力を帯びた装備を作るとか……。", "face": "u1248a1"}, {"name": "ミスリア", "text": "んぁー……できる、かなぁ……？\nあっ、他の神獣から\n装備を作った時の技術、使えちゃうかも……？", "face": "u846"}, {"name": "キャラット", "text": "よし、地上に帰ったら早速分析してみよ！\nミスリア、そっち持ってー！", "face": "u593"}, {"name": "アンナ", "text": "ひとまず、これで神獣バハムトの再封印はできましたね。\nとはいえ封印は不安定とのことですから、\n今後も警戒を怠らないようにしましょう。"}, {"name": "アンナ", "text": "それでは王子、\n神獣バハムト再封印作戦、お疲れさまでした！"}]}, {"trigger": "route", "enemy_ids": [27, 4100, 4201], "lines": [{"name": "ハルフゥ", "text": "――こ、これは、まずいです！！\nバハムトの封印が完全に解けました！！", "face": "u1118a1"}, {"name": "リバン", "text": "バハムトが、真の力を……。\nお、王子さま、一度撤退しましょう！！", "face": "u1062a1"}, {"name": "マルスィ", "text": "ですが、ここで退いては深海の都市が……！", "face": "u1065a1"}, {"name": "アンナ", "text": "……王子、判断はすべて、王子に委ねます。\nどうか慎重な判断をお願いします！", "face": "l6ad2d2ab4d1f"}]}, {"trigger": "route", "lines": [{"name": "キュステ", "text": "はぁ……はぁ……っ！\nお、王子さま、バハムトがどこかへ去っていきます……。", "face": "u1248a1"}, {"name": "ベアトリカ", "text": "ちっ、待ちやがれ！\n戻ってこい海蛇野郎！", "face": "u157"}, {"name": "アンナ", "text": "急いで追撃に――いえ、この状況では……それも……。", "face": "lcd5b67a8847f"}, {"name": "ヴィアベル", "text": "今は周囲の敵を片付けるしかないわ。\n皆、被害を抑えることに集中して！", "face": "u1247a1"}]}], "active": true}