 300, "magic_defense": 15, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2106560, "race_id": 7, "change_to": 7, "master_id": 30344, "global_id": 3963, "to_global_id": 3962, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 43}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "change_to": 6, "master_id": 30343, "global_id": 3962}, {"enemy_id": 9, "source": "local", "count": 10, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 45}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 57}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 750, "base_hp": 6000, "base_attack": 750, "damage_type": "physical", "armor_defense": 120, "magic_defense": 10, "attack_speed": 1, "attack_wait": 85, "attack_interval": 224, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2150816, "race_id": 7, "master_id": 37140, "global_id": 10757, "spawn_sec": 66}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 8000, "base_hp": 8000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_wait": 5, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2106560, "race_id": 7, "special_effect_id": 1591, "change_to": 12, "master_id": 37172, "global_id": 10789, "to_global_id": 10790, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 72}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 5, "attack_interval": 161, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "special_effect_id": 1592, "change_to": 11, "master_id": 37173, "global_id": 10790}, {"enemy_id": 14, "source": "local", "count": 2, "form_count": 1, "hp": 3500, "attack": 280, "base_hp": 3500, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 5, "attack_interval": 99, "move_speed": 2200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "special_effect_id": 64, "master_id": 37151, "global_id": 10768, "spawn_sec": 113}], "dialogue": [{"trigger": "start", "lines": [{"name": "ローリエ", "text": "来てしまいました……グルメジャングル。", "face": "u257"}, {"name": "アナトリア", "text": "へぇ、本当にいきなり戦場のど真ん中じゃないか。\nどいつもこいつも目が血走ってて分かりやすいねぇ。", "face": "u522"}, {"name": "ジークリンデ", "text": "魔物たちもかなり暴れているな。\n久しぶりに狩りの時間といくか？", "face": "u429"}, {"name": "シャジャル", "text": "ふむ、予選形式はバトルロイヤルで良かったかな？", "face": "u1769a1"}, {"name": "ジンレイ", "text": "そうみたいだねぇ、各自で楽しんじゃおうっか？", "face": "u2065a1"}, {"name": "メーア", "text": "──誰かー！　たすけてくださーい！\n銛を持った女の人に追われていまーす！", "face": "u796"}, {"name": "ジークリンデ", "text": "………………。", "face": "u429"}, {"name": "レギーナ", "text": "むっ、あの方は……！", "face": "u405"}, {"name": "ユッタ", "text": "知ってるんですかレギーナ。", "face": "u1228a1"}, {"name": "レギーナ", "text": "ああ、彼女は当代一とも称される女漁師だ。\nとある港湾都市を拠点とした大船団の船長でもあり、\n民間初のアンモナイトクラーケン討伐も成し遂げている。", "face": "u405"}, {"name": "ユッタ", "text": "あれ狩れる漁師がいるんですか！？", "face": "u1228a1"}, {"name": "レギーナ", "text": "人類の食文化を一段階押し上げた偉人！\nまさにレジェンド、握手してほしいなぁ！", "face": "u405"}, {"name": "メーア", "text": "たすけてって言ってるのが聞こえないんですかねぇ！？", "face": "u796"}, {"name": "アンナ", "text": "王子、あまり気は進みませんが参戦しましょう！"}, {"name": "メーア", "text": "あまり気は進みませんが！？", "face": "u796"}]}, {"trigger": "battle", "at_sec": 71, "lines": [{"name": "？？？", "text": "どけどけー！　邪魔だ邪魔だー！", "face": "u2081a1"}, {"name": "イヴリール", "text": "ん？", "face": "u1959a1"}, {"name": "スカー", "text": "アアッ？　あいつも参加者かァ？", "face": "u1396a1"}, {"name": "デューオ", "text": "んー？　あの魚人、どっかで見たようなー？", "face": "u594"}, {"name": "ローリエ", "text": "えっと、後ろに何か連れてませんか……？", "face": "u257"}]}, {"trigger": "battle", "at_sec": 78, "lines": [{"name": "ローリエ", "text": "う、後ろに大量の魔物がいますよー！？", "face": "u257"}, {"name": "デューオ", "text": "ちょおっ！？　こっちの方に来てない！？", "face": "u594"}, {"name": "オスカー", "text": "暴走した魔物でモンスタートレインですか……。", "face": "u366"}, {"name": "ジェイク", "text": "その上でお裾分けとはマナーがなってねぇな。\n他人を巻き込むのは冒険者としちゃあ三流だぜ？", "face": "u367"}, {"name": "？？？", "text": "うるせぇッ！　そんなとこにいる方が悪いんだよ！", "face": "u2081a1"}, {"name": "アナトリア", "text": "言うじゃないか、全員ぶっ飛ばせばいいんだろう？", "face": "u522"}, {"name": "ジークリンデ", "text": "油断するなよ、暴走の影響で力と速度が増しているからな。", "face": "u429"}]}, {"trigger": "end", "lines": [{"name": "ジークリンデ", "text": "──残っているのは粗方斬り捨てたな。\nあの赤い髪の魚人は……もう逃げているか。", "face": "u429"}, {"name": "デューオ", "text": "あの子、誰だったっけなー？\n会ったことあるはずなんだけど……。", "face": "u594"}, {"name": "スカー", "text": "……ありゃあ、カウリオだな。", "face": "u1396a1"}, {"name": "デューオ", "text": "あー、それ！　カウリオ！", "face": "u594"}, {"name": "アンナ", "text": "有名な方なのでしょうか？", "face": "l91db55a83012"}, {"name": "スカー", "text": "深海の爪弾き者を集めた海賊団の頭目だ。\nギルマンの間じゃそれなりに有名な奴だな。", "face": "u1396a1"}, {"name": "デューオ", "text": "アタシも何回か海上でやりあったことあるよ、\n誰にでも噛みつく昔のスカーみたいな子だよね。", "face": "u594"}, {"name": "スカー", "text": "アァンッ！？　オレサマはそんなことしてねェ！", "face": "u1396a1"}, {"name": "デューオ", "text": "いやしてたでしょ、なんで否定するの。", "face": "u594"}, {"name": "ミネルバ", "text": "なんにせよ、相手が格上でも決して怯まない、\n今時珍しく気概のある子だと思っていたけど……。", "face": "u91"}, {"name": "ミネルバ", "text": "随分と、つまらなくなっていたわね。", "face": "u91"}, {"name": "スカー", "text": "………………。", "face": "u1396a1"}]}], "active": true}