{"quest_id": 7208, "name": "戦闘用晴れ着はじめました", "description": "晴れ着に喜ぶシャディア、グリム、\nエフネ。感謝を伝えたいと呼ばれた\n着物職人は……なんとデーモンシェフ！？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ28(2020)", "event_category": "Reproduce", "mission_id": 300293, "map_no": 4033, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "hp": 3000, "attack": 1200, "base_hp": 3000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 190, "attack_speed": 1, "attack_wait": 45, "attack_interval": 141, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126704, "race_id": 3, "change_to": 1, "change_condition": 2, "missile_id": 6, "master_id": 33068, "global_id": 6685, "ranged": true, "to_condition": 2, "to_global_id": 6686, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 4000, "attack": 2000, "base_hp": 4000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 160, "magic_defense": 40, "attack_range": 190, "attack_speed": 1, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126704, "race_id": 3, "change_to": 2, "change_condition": 2, "missile_id": 6, "master_id": 33069, "global_id": 6686, "ranged": true, "from_condition": 2, "to_condition": 2, "to_global_id": 6687}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 6000, "attack": 3300, "base_hp": 6000, "base_attack": 3300, "damage_type": "magical", "armor_defense": 320, "magic_defense": 60, "attack_range": 190, "attack_speed": 1, "attack_wait": 45, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2126704, "race_id": 3, "special_effect_id": 222, "missile_id": 6, "master_id": 33070, "global_id": 6687, "ra