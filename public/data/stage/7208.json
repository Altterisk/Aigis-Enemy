, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "hp": 12000, "attack": 700, "base_hp": 12000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_range": 170, "attack_speed": 60, "attack_wait": 20, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101488, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 306, "global_id": 305, "ranged": true, "spawn_sec": 107}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 141}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 1200, "base_hp": 30000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 40, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2113792, "race_id": 3, "master_id": 30888, "global_id": 4507, "spawn_sec": 185}], "popups": ["エフネは倒されると\nその場で復活します。\n\n２回まで復活し、\n復活するたびに強くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シャディア", "text": "――おお、これが晴れ着というものか。\n東の国のドレス、ということかな？", "face": "u1126a1"}, {"name": "グリム", "text": "おー、ひらひら、ふりふり、ばさばさー。\n思ったより動きやすいですね。", "face": "u1127a1"}, {"name": "エフネ", "text": "よかった、丈もぴったりですね。\nおふたりのための特注品なんですよ、これ。", "face": "u1130a1"}, {"name": "シャディア", "text": "……やれやれ、王子の道楽にも困ったものだ。\nしかし、悪い気分ではないな。", "face": "u1126a1"}, {"name": "エフネ", "text": "ざこざこ王子もたまには良いことしますよね。\nボクの晴れ着までお金を出してくれたんですよ。", "face": "u1130a1"}, {"name": "シャディア", "text": "たまには、は余計だ。\nエフネも王子のこと、\n気に入っていないわけじゃないんだろう？", "face": "u1126a1"}, {"name": "エフネ", "text": "なっ……！\nき、気に入ってなんていませんから！\nあの子がいるから仕方なく協力してるだけで！", "face": "u1130a1"}, {"name": "グリム", "text": "すなおじゃなーい。", "face": "u1127a1"}, {"name": "エフネ", "text": "も、もう～！！\nボクはひとすじなんです！\nざこざこ王子なんて眼中にありませんから！", "face": "u1130a1"}, {"name": "シャディア", "text": "ふふ、からかって悪かった。\nそれよりエフネ、この晴れ着を仕立てた職人に、\nぜひ礼を言いたいのだが……。", "face": "u1126a1"}, {"name": "エフネ", "text": "あっ、それならもう来てますよ。", "face": "u1130a1"}, {"name": "デーモンシェフ", "text": "――気に入ってくれたようで何よりだ。", "face": "l78d972bbff7c"}, {"name": "グリム", "text": "……えぇっと？　もしかして、\nデーモンシェフがこの晴れ着を！？", "face": "u1127a1"}, {"name": "デーモンシェフ", "text": "うむ。一業種だけでは、トラブルが起きた時に\n社員を守ってやれないからな。\n将来の異業種展開に備えて、修行中なのだ。", "face": "l78d972bbff7c"}, {"name": "シャディア", "text": "社長自らか……。\nそれは殊勝な心がけだな。", "face": "u1126a1"}, {"name": "デーモンシェフ", "text": "ああ、だがテストがまだ終わっていないのだ。\n良かったらこのまま、\n晴れ着の戦闘試験に付き合ってくれないか？", "face": "l78d972bbff7c"}, {"name": "グリム", "text": "……はい？　せんとーしけん？", "face": "u1127a1"}, {"name": "デーモンシェフ", "text": "この試作１号は、\n着心地、華やかさ、そして防御力を備えた\n新機軸の戦場で着る晴れ着なのだ！", "face": "l78d972bbff7c"}, {"name": "デーモンシェフ", "text": "くくく……この試作が上手く行けば！\n世界中の女性兵から注文が殺到！\n華やかな戦場が誕生すること間違いなし！", "face": "l78d972bbff7c"}, {"name": "デーモンシェフ", "text": "そういうわけでアルバイトのエフネよ！\n晴れ着の戦闘試験を実施するのだ！", "face": "l78d972bbff7c"}, {"name": "エフネ", "text": "ふっふっふ、そういうわけなので、\nバイト代のためにお相手お願いしますねー♪", "face": "u1130a1"}, {"name": "シャディア", "text": "やれやれ、そういうことか……。\nグリム、迎撃するぞ！", "face": "u1126a1"}, {"name": "グリム", "text": "わー、これは緊急事態ですね。\n召喚術使っちゃっていいやつですねー♪", "face": "u1127a1"}]}, {"trigger": "end", "lines": [{"name": "デーモンシェフ", "text": "おぉ、傷ひとつない！\nこれならば市販も可能になるぞ……！", "face": "l78d972bbff7c"}, {"name": "シャディア", "text": "ふぅ、確かに良い着心地だった。\n動きも阻害されないし、\n祝いの席での護衛もしやすくなるだろう。", "face": "u1126a1"}, {"name": "デーモンシェフ", "text": "おお、元魔王親衛隊たるシャディア様より、\n斯様なお言葉をいただけるとは……！", "face": "l78d972bbff7c"}, {"name": "デーモンシェフ", "text": "さぁバイトのエフネよ、\nこれから晴れ着の量産に入るぞ！", "face": "l78d972bbff7c"}, {"name": "エフネ", "text": "えっ、無理ですよ？", "face": "u1130a1"}, {"name": "デーモンシェフ", "text": "なっ……なぜだ！？\n性能は抜群！　完全な晴れ着だろう！？", "face": "l78d972bbff7c"}, {"name": "エフネ", "text": "デーモンシェフの要求する性能が高すぎるんです。\n３着分で、ざこざこ王子に\nもらった予算使い切っちゃいましたよ。", "face": "u1130a1"}, {"name": "デーモンシェフ", "text": "くっ……そうか……。\n良い物を追求しすぎるとこうなるのだな……。", "face": "l78d972bbff7c"}, {"name": "グリム", "text": "予算との兼ね合いってやつですね。\nせちがらい。", "face": "u1127a1"}, {"name": "シャディア", "text": "何事もバランス、ということだな。", "face": "u1126a1"}, {"name": "デーモンシェフ", "text": "だが、身についた技術は嘘をつかないはず。\nさらなる商売のため、我々は止まらないぞ！", "face": "l78d972bbff7c"}, {"name": "デーモンシェフ", "text": "……おっと、その前に。\n王子に新年の挨拶くらいはしておこう。\n王国で商売をすることもあるだろうしな。", "face": "l78d972bbff7c"}, {"name": "グリム", "text": "案内しますよー。\nみんなで一緒におとし玉もらいましょう。", "face": "u1127a1"}, {"name": "シャディア", "text": "ははっ、それはいい。\nでは王子のところへ行くとしようか。", "face": "u1126a1"}]}], "story_talk": true, "active": true}