{"quest_id": 8610, "name": "人形と絡繰り", "description": "悲鳴を聞いて現場に駆けつけた王子たちは、\n事件の黒幕である闇の組織と対峙する。\nフォーと絡繰り忍者を倒して勝利を掴め！\n極級（★１獲得の目安：平均Lv25）", "event": "真夏のカオスリゾート", "event_category": "History", "mission_id": 920235, "map_no": 9378, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 800, "base_hp": 60000, "base_attack": 800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 37, "attack_interval": 169, "move_speed": 750.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2126336, "race_id": 16, "special_effect_id": 525, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33016, "global_id": 6633, "ranged": true, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag(0, 1);\");", "sets_flags": [[0, 1]], "on_destroy": true}, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 32000, "attack": 1050, "base_hp": 32000, "base_attack": 1050, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126672, "race_id": 16, "special_effect_id": 663, "change_to": 2, "change_condition": 2, "master_id": 33318, "global_id": 6935, "to_condition": 2, "to_global_id": 6936, "route_behaviour": {"calls_event": [2121, 2122, 2123, 2124]}, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "ステルス"], "hp": 90000, "attack": 1200, "base_hp": 90000, "base_attack": 1200, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 58, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126688, "race_id": 16, "special_effect_id":