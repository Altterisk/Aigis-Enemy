, "source": "local", "count": 32, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 94}, {"enemy_id": 8, "source": "local", "count": 12, "form_count": 1, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100000, "race_id": 16, "master_id": 210, "global_id": 209, "spawn_sec": 100}, {"enemy_id": 9, "source": "local", "count": 11, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 110}, {"enemy_id": 10, "source": "local", "count": 18, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 112}, {"enemy_id": 11, "source": "local", "count": 7, "form_count": 1, "tags": ["変異"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 236, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 0.8999999761581421, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2129360, "race_id": 7, "special_effect_id": 66, "master_id": 33821, "global_id": 7438, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 112}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "tags": ["変異"], "hp": 10500, "attack": 400, "base_hp": 10500, "base_attack": 400, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 180, "attack_speed": 10, "attack_wait": 10, "attack_interval": 61, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2138400, "race_id": 16, "special_effect_id": 309, "missile_id": 733, "missile": {"speed": 4.0}, "master_id": 35068, "global_id": 8685, "ranged": true, "spawn_sec": 152}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "tags": ["変異"], "hp": 28000, "attack": 800, "base_hp": 28000, "base_attack": 800, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 236, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2129360, "race_id": 7, "special_effect_id": 68, "master_id": 34230, "global_id": 7847, "spawn_sec": 270}], "popups": ["フォーから受けた\nダメージは2倍になります。\n\nまたフォーを倒すと\n以降、人形は登場しません。", "フォー人形から受けた\nダメージは2倍になります。\n\nまた、フォー人形は倒されると\n自身の周囲にダメージを与えます。", "絡繰り忍者は攻撃力300以下の\nあらゆる攻撃を受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。", "変異した忍者マスターは\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フォー", "text": "三つ巴の殺し合いが見れるかと期待してたんだが。\n仲違いも孤立もせずに、すぐに落ち着きやがって。", "face": "l1ab687946a57"}, {"name": "フォー", "text": "愉快に潰し合って消耗したところで、\nオルカ共の技術と商会の資本力を奪い、王子を始末する。\nそんな愉快な計画が全部パァだ。", "face": "l1ab687946a57"}, {"name": "フォー", "text": "どいつもこいつも、本能を隠してばかり、\n理性的で反吐がでる。観客はなァ、\n血湧き肉躍る爆殺劇を楽しみにしてるんだよォ！", "face": "l1ab687946a57"}, {"name": "絡繰り忍者", "text": "憎い相手を殴ってスッキリするのは馬鹿とクズまでだと、\n以前、自分自身でそう言っていたはずでござるが？", "face": "lc445ed380e0d"}, {"name": "フォー", "text": "おいおい、俺はこうも言ったはずだぜ？\n本当に楽しいのは、憎い相手の大切な人間を苦しめて、\nボロボロになった様を見せつけることだってよォ。", "face": "l1ab687946a57"}, {"name": "フォー", "text": "お人好しの王子のことだ。\nオルカ共と商会の連中をなぶってやれば、\nさぞかし心を痛めてくれるだろうサ。", "face": "l1ab687946a57"}, {"name": "アイリーン", "text": "――そんなことを許すと思うか？", "face": "u315"}, {"name": "フォー", "text": "おっと、王国軍のお戻りだ。\nやっぱりその辺の甲殻類ごときじゃ陽動にもならないかァ。", "face": "l1ab687946a57"}, {"name": "フォー", "text": "その隙にリゾートを血の海にしようと思ったのによォ！\n本当に俺をイラつかせてくれるなァ！！", "face": "l1ab687946a57"}, {"name": "ペルセナス", "text": "あー……困った、こういうタイプの悪党は、\nてんで話ができないんだよね。", "face": "u2482a1"}, {"name": "イヴリール", "text": "無理に話す必要もないだろう。\nあれとは最初から平和的な解決が見込めない。", "face": "u2488a1"}, {"name": "イコル", "text": "どのみち向こうはやる気だ。\n戦うしかないだろうね。", "face": "u2485a1"}, {"name": "スーシェン", "text": "以前交戦した経験から提案。\n人形使いは本体を仕留めるが定石、\nそれで厄介な人形も止まるはずです。", "face": "u2486a1"}, {"name": "コウメ", "text": "それじゃ、場違いな殺人ピエロには、\nさっさと退場してもらいましょう。", "face": "u2490a1"}]}, {"trigger": "end", "lines": [{"name": "フォー", "text": "ギャハハハハハハッ！！\n本ッ当に鬱陶しいなテメェらはよォ！！", "face": "l1ab687946a57"}, {"name": "フォー", "text": "ああーーイライラする！！\nみんなまとめて木っ端微塵にしなきゃ気が済まねぇなァ！！", "face": "l1ab687946a57"}, {"name": "絡繰り忍者", "text": "しかし状況は劣勢、ここは一度退くでござるよ。\nお主に死なれてしまえば報酬が支払われない故な。", "face": "lc445ed380e0d"}, {"name": "アージェ", "text": "闇の組織が撤退していきます。\nひとまず危機は去ったと考えていいでしょう。", "face": "u2487a1"}, {"name": "デーモンシェフ", "text": "助かったよ、王国諸君。\n我々だけではきっと、この窮地をしのげなかった。", "face": "lacf600866f64"}, {"name": "オルカレクス", "text": "おかげで被害は最小限に抑えられた。\n多少の負傷者はいるが、いずれも軽傷で済んでいる。", "face": "ld7ef6a899527"}, {"name": "ペルセナス", "text": "手当てをすればすぐに治りそうかな。\nうん、それなら一安心だよ。", "face": "u2482a1"}, {"name": "クロノシア", "text": "では、リゾートのことは皆さんにお願いして、\n私たちはこのまま、闇の組織を追いましょうか。", "face": "u2484a1"}]}, {"trigger": "end", "lines": [{"name": "デーモンシェフ", "text": "……行ってしまったか。", "face": "lacf600866f64"}, {"name": "オルカレクス", "text": "そうだな……。", "face": "ld7ef6a899527"}, {"name": "オルカレクス", "text": "……これから、どうするつもりだ？", "face": "ld7ef6a899527"}, {"name": "デーモンシェフ", "text": "まずは負傷者の手当てだろう。\nそれから不安がっているリゾートの従業員たちを\n落ち着かせてやる必要があるだろうな。", "face": "lacf600866f64"}, {"name": "デーモンシェフ", "text": "……いや、もうひとつ、やるべきことがあるか。", "face": "lacf600866f64"}, {"name": "オルカレクス", "text": "キュキュ……どうやら同じことを考えているようだな。", "face": "ld7ef6a899527"}, {"name": "オルカレクス", "text": "やられっぱなしは我々の性に合わない。\n借りを返してやろうではないか！", "face": "ld7ef6a899527"}]}, {"trigger": "route", "enemy_ids": [2], "lines": [{"name": "絡繰り忍者", "text": "――また腕を上げたようでござるな。\nされどそれは拙者とて同じ。", "face": "lc445ed380e0d"}, {"name": "絡繰り忍者", "text": "さて、此度の爆破からは、無事に切り抜けられるか？", "face": "lc445ed380e0d"}, {"name": "サクヤ", "text": "い、いけません！\n絡繰り忍者が身代わりに爆弾を置いて――！？", "face": "u2489a1"}, {"name": "乙姫", "text": "みんな、急いで逃げてっ。\n爆発に巻き込まれちゃう！", "face": "u2483a1"}]}], "active": true}