{"quest_id": 7804, "name": "狙われたデーモン像　事件編", "description": "デモシェフ商会に届いた怪盗サバルの犯行\n予告状。名探偵アナベラと助手の王子は\n犯行を防ぐべく張り込みを開始する……。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ31(2022)", "event_category": "Reproduce", "mission_id": 300377, "map_no": 4204, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 2, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 420, "magic_defense": 15, "attack_range": 50, "attack_speed": 1, "attack_wait": 15, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2141296, "change_to": 1, "change_condition": 4, "missile_id": 11, "master_id": 35544, "global_id": 9161, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 9162, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 110}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 420, "magic_defense": 15, "attack_range": 50, "attack_speed": 1, "attack_wait": 15, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2141312, "special_effect_id": 548, "missile_id": 11, "master_id": 35545, "global_id": 9162, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_wait": 4, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2141328, "change_to": 3, "master_id": 35546, "global_id": 9163, "route_behaviour": {"transforms": [{"flag": 10, "val": 1}]}, "spawn_sec": 110}, {"enemy_id": 5, "source": "local", "count": 46, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 5, "change_condition": 3, "master_id": 800, "global_id": 799, "to_condition": 3, "to_global_id": 800, "spawn_sec": 112}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 500, "base_hp": 1200, "base_attack": 500, "damage_type": "physical", "armor_defense": 130, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "from_condition": 3}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106496, "race_id": 8, "change_to": 7, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 387, "global_id": 386, "ranged": true, "to_condition": 3, "to_global_id": 387, "spawn_sec": 165}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106512, "race_id": 8, "special_effect_id": 234, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 388, "global_id": 387, "ranged": true, "from_condition": 3}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 9, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 178}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_wait": 4, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2141360, "master_id": 35548, "global_id": 9165, "spawn_sec": 253}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_wait": 4, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2141344, "master_id": 35547, "global_id": 9164, "spawn_sec": 253}], "popups": ["\n\n\n　　  　………………。", "\n\n\n　　 　　…………。", "\n\n\n　 　――犯行予告の時間。"], "dialogue": [{"trigger": "start", "lines": [{"name": "副デーモンシェフ", "text": "――おぉ、これがデモシェフ温泉！\n様々な他業種展開を続けてきましたが、\nとうとうその集大成がここに誕生したのですね！", "face": "lf7b73b0e35f9"}, {"name": "デーモンシェフ", "text": "うむ、癒やしに娯楽、美食に観光、\n数々の技術を蓄積してきたからこその、\nデモシェフ商会による温泉宿が開業だ！", "face": "lef96f8b14ef4"}, {"name": "副デーモンシェフ", "text": "ふふっ、そんなデーモンシェフ様に、\n温泉開業を祝して、\n社員一同からプレゼントがあるのですが……。", "face": "lf7b73b0e35f9"}, {"name": "デーモンシェフ", "text": "ぷ、ぷれぜんとだと……？\nいや、まだまだ社員には苦しい生活をさせている。\nそんな状況で――いや、そうだな……。", "face": "lef96f8b14ef4"}, {"name": "デーモンシェフ", "text": "感謝の気持ちを受け取らないのは、\n物質界の流儀に反するかもしれない。\nありがたく受け取ろうではないか。", "face": "lef96f8b14ef4"}, {"name": "ゴブリン", "text": "ギャギャ！　ジュンビオッケー！", "face": "leaf50d42b036"}, {"name": "副デーモンシェフ", "text": "行きますぞ、これこそがデモシェフ温泉の象徴！\nデーモンシェフ立像です……ッ！！", "face": "lf7b73b0e35f9"}, {"name": "デーモンシェフ", "text": "おぉ、おぉ……！\nお前たち、ありがとう、ありがとう……！", "face": "lef96f8b14ef4"}, {"name": "デーモンシェフ", "text": "これは「水晶」製か……？\n透き通ったこの美しさ、なんだか照れてしまうな……。", "face": "lef96f8b14ef4"}, {"name": "ゴブリン", "text": "ギャギャ？　ナニカアル？", "face": "leaf50d42b036"}, {"name": "副デーモンシェフ", "text": "ん、立像に手紙……？\nなになに……こ、これは、犯行予告状！？", "face": "lf7b73b0e35f9"}, {"name": "名探偵アナベラ", "text": "――と、いうわけで、\nぼくらが呼ばれたというわけか。", "face": "u1309a1"}, {"name": "副デーモンシェフ", "text": "えぇ、先日の怪盗サバル事件、\n見事に解決に導いたという、\n名探偵アナベラ様のお力を借りられないかと……。", "face": "lf7b73b0e35f9"}, {"name": "名探偵アナベラ", "text": "むぅ、しかしこれは、探偵の仕事というより\n警備兵や傭兵の仕事のような気も……。", "face": "u1309a1"}, {"name": "助手王子", "text": "…………（とんとん）", "face": "u1"}, {"name": "名探偵アナベラ", "text": "ん、どうした助手王子。\n――む？　この辺りは山の幸が美味いって？", "face": "u1309a1"}, {"name": "副デーモンシェフ", "text": "ふふ、もちろん宿の食事には、\n我々デモシェフ商会の本職たる料理の腕をもって、\n最高のごちそうを準備しております！", "face": "lf7b73b0e35f9"}, {"name": "名探偵アナベラ", "text": "む、むむ、そうか……。\nそうだなぁ、最近書庫にこもりっぱなしで、\n硬いパンしか食べてなかったし……じゅるり……。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "よし、これも怪盗サバルの犯行を防ぐため！\n必ずやデーモンシェフ立像を守り抜こうじゃないか！", "face": "u1309a1"}, {"name": "副デーモンシェフ", "text": "おぉ、さすが名探偵アナベラ様！\nそして助手王子殿、ありがとうございます……！", "face": "lf7b73b0e35f9"}]}, {"trigger": "start", "lines": [{"text": "………………。"}, {"text": "…………。"}, {"text": "――犯行予告の時間。"}, {"name": "名探偵アナベラ", "text": "実に静かなものだな……。\n怪盗サバルめ、いったいどこから侵入するつもりなんだ。", "face": "u1309a1"}, {"name": "副デーモンシェフ", "text": "むっ……何か聞こえませんか？\nまるで地響きのような……足音……？", "face": "lf7b73b0e35f9"}, {"name": "オーク", "text": "うぉぉぉぉぉッ！　温泉！\nうぉぉぉぉぉッ！　湯治！！", "face": "l26e205d6dcc2"}, {"name": "ハイオーク", "text": "戦士の傷を癒やすのは！\n食事と睡眠、そして豊かな温泉だ！", "face": "la441b09bd288"}, {"name": "名探偵アナベラ", "text": "お、オークの団体客ぅ！？\nまったまった、温泉は立入禁止だぞ！", "face": "u1309a1"}, {"name": "副デーモンシェフ", "text": "た、確かに入り口には、\nただいま準備中の札を立ててあったはず！？", "face": "lf7b73b0e35f9"}, {"name": "名探偵アナベラ", "text": "えぇい、仕方ない！\n助手王子、オークたちの相手をしてやってくれ！\n戦いに満足したら立ち去るはずだ！", "face": "u1309a1"}]}, {"trigger": "end", "lines": [{"name": "名探偵アナベラ", "text": "はぁ、はぁ……。\nまさか温泉宿に来てまで、\nオークの相手をすることになるとは……。", "face": "u1309a1"}, {"name": "名探偵アナベラ", "text": "ぼくは……頭脳労働担当、なんだぞ……！？", "face": "u1309a1"}, {"name": "ハイオーク", "text": "いや、準備中だったとは失礼した。\n掃除の邪魔をしてしまったか。", "face": "la441b09bd288"}, {"name": "ハイオーク", "text": "オークの戦士たちよ、\n迷惑をかけぬよう、迅速に撤退するのだ！", "face": "la441b09bd288"}, {"name": "助手王子", "text": "…………？", "face": "u1"}, {"name": "副デーモンシェフ", "text": "むっ、どうしました？\nそんな不思議そうな顔をして――はっ！？\nた、大変です！　デーモンシェフ様の立像が！", "face": "lf7b73b0e35f9"}, {"name": "ゴブリン", "text": "ギャギャ！　キエテル！　キエテル！", "face": "leaf50d42b036"}, {"name": "怪盗サバル", "text": "にゃーっはっはっはっは！\n予告通り、デーモンシェフの立像はいただいたぁ！", "face": "u536"}, {"name": "怪盗サバル", "text": "名探偵アナベラよ、\n今回は黒猫大怪盗サバル様の勝利のようだなぁ！", "face": "u536"}, {"name": "怪盗サバル", "text": "それでは諸君、さらばだー！", "face": "u536"}, {"name": "副デーモンシェフ", "text": "なっ……待て！　立像を返せ！！", "face": "lf7b73b0e35f9"}, {"name": "助手王子", "text": "…………！！", "face": "u1"}, {"name": "名探偵アナベラ", "text": "――待ちたまえ、助手王子、副デーモンシェフ。\nそう焦って追いかけては、怪盗サバルの思うツボだよ。", "face": "u1309a1"}, {"name": "助手王子", "text": "…………？", "face": "u1"}, {"name": "名探偵アナベラ", "text": "よく考えてみたまえ。\nあれだけのオーク筋肉密度の中、華奢な怪盗サバルが、\nあの大きな立像を持ち運べると思うかい？", "face": "u1309a1"}, {"name": "副デーモンシェフ", "text": "名探偵アナベラ殿、それはいったいどういう……？", "face": "lf7b73b0e35f9"}, {"name": "名探偵アナベラ", "text": "さぁ、役者も揃っていることだし、\nここはひとつ、探偵らしく解決編と行こうじゃないか！", "face": "u1309a1"}, {"name": "紅牡丹", "text": "さぁさお立ち会い！\n消えたデーモンシェフ像はどこにあるのか！？", "face": "u661"}, {"name": "紅牡丹", "text": "名探偵アナベラ、ぶらり温泉ふたり旅。\n運命の解決編……こうご期待！", "face": "u661"}]}], "story_talk": true, "active": true}