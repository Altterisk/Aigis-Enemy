{"quest_id": 7086, "name": "ゴールデンサイクロン", "description": "復讐の機会を探る帝国貴族ベラートに\n新たな風が吹く！？\n＜ベラートがいる間敵の攻撃防御アップ＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["ベラートがいる間敵の攻撃防御アップ"], "event": "ゴールドラッシュ27(2020)", "event_category": "Reproduce", "mission_id": 300277, "map_no": 4029, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "tags": ["アーマー"], "hp": 30000, "attack": 550, "base_hp": 30000, "base_attack": 550, "damage_type": "physical", "armor_defense": 1400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 120, "attack_interval": 299, "move_speed": 2200.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123568, "race_id": 16, "change_to": 1, "missile_id": 11, "master_id": 32660, "global_id": 6278, "to_global_id": 6262, "route_behaviour": {"transforms": [{"wait": 130}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1400, "magic_defense": 40, "attack_speed": 1, "attack_wait": 10, "attack_interval": 68, "move_speed": 2200.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123472, "race_id": 16, "special_effect_id": 545, "change_to": 2, "missile_id": 11, "master_id": 32644, "global_id": 6262, "to_global_id": 6261}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 30000, "attack": 400, "base_hp": 30000, "base_attack": 400, "damage_type": "physical", "armor_defense": 1400, "magic_defense": 40, "attack_range": 60, "attack_speed": 1, "attack_wait": 3, "attack_interval": 22, "move_speed": 2200.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123456, "race_id": 16, "special_effect_id": 545, "change