rm_resist": 1000, "pattern_id": 2113104, "race_id": 16, "change_to": 7, "change_condition": 1, "missile_id": 244, "missile": {"speed": 4.0, "splash": 53}, "master_id": 30775, "global_id": 4394, "ranged": true, "variants": [{"tags": ["アーマー", "帝国"], "hp": 3500, "attack": 250, "base_hp": 3500, "base_attack": 250, "damage_type": "physical", "armor_defense": 250, "attack_speed": 60, "attack_wait": 60, "attack_interval": 206, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113120, "race_id": 16, "master_id": 30776, "global_id": 4395}], "spawn_sec": 91}, {"enemy_id": 9, "source": "local", "count": 4, "level": 80, "form_count": 1, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 45, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111792, "race_id": 16, "master_id": 30637, "global_id": 4256, "spawn_sec": 103}, {"enemy_id": 10, "source": "local", "count": 2, "level": 80, "form_count": 1, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "spawn_sec": 115}], "popups": ["パーフェクトベラートは\n縦横無尽に移動を行い\n周囲のユニットに\nダメージを与えます。\n\nまた、ベラートがいる間は\n全ての敵の攻撃力と\n防御力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ベラート", "text": "くっ……私は伯爵だぞ……尊き血筋なのだぞ……。\nそれなのに、何故こんな仕打ちを……。", "face": "l40072c1f5ac6"}, {"name": "ベラート", "text": "何が実力主義だ、何が白の皇帝だ……。\n貴様の治世でどれだけの血と涙が流れたと……。\nくそっ、くそっ、くそぉぉぉっ！！", "face": "l40072c1f5ac6"}, {"name": "ベラート", "text": "――だが、今の私には新たなる鎧がある。\nあの珍妙なデーモンの、工場長……？\nあやつが玩具工場で作ったという鎧がな……！！", "face": "l40072c1f5ac6"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "ベラート伯爵が最後に目撃されたのは、\nこの辺りだと報告を受けています。", "face": "l839d9d7ea579"}, {"name": "レオナ", "text": "道案内までさせてしまって済まないな。\nベラートを追跡していた部隊には、\nきつく指導をしておく。", "face": "u311"}, {"name": "レオナ", "text": "だが、その追跡部隊が妙なことを言っていてな。\n確かベラートが玩具工場に出入りしていたとか……。", "face": "u311"}, {"name": "エスネア", "text": "おもちゃこうじょう……？", "face": "u997"}, {"name": "エフネ", "text": "……玩具工場、ですか。", "face": "u969"}, {"name": "レオナ", "text": "子供に玩具を贈るような男ではないと思うが、\nまぁ、頭の片隅にとどめておいてくれ。", "face": "u311"}, {"name": "ベラート", "text": "――否、もはや手遅れだ。\n事実は常に更新され、情報はその後を行くしかない。", "face": "l40072c1f5ac6"}, {"name": "レオナ", "text": "ベラート！！\n素直に出頭するとは、殊勝な心がけだな。", "face": "u311"}, {"name": "ベラート", "text": "ふふふふふ……出頭だと？\nまさか、まさかまさかまさか！！\nこの私が！　貴族たる私がそんなことをすると思うか！", "face": "l40072c1f5ac6"}, {"name": "ルーテ", "text": "――た、大変です！\nベラート派についた兵が、\nこちらへ向かってきていると報告が！", "face": "u529"}, {"name": "ベラート", "text": "さぁ、美しき鎧を見よ！！\nこれこそが……私の新たな力！！", "face": "l40072c1f5ac6"}, {"name": "ベラート", "text": "――パーフェクトベラートの姿だッ！！", "face": "l40072c1f5ac6"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "アンナ", "text": "お、王子！　よく分かりませんが危険です！！\n慎重な采配をお願いします……！！", "face": "l839d9d7ea579"}]}, {"trigger": "end", "lines": [{"name": "ベラート", "text": "ぜはぁ、ぜはぁ……な、何というパワー。\n何というスピード……この私が振り回されるとは。", "face": "l40072c1f5ac6"}, {"name": "ベラート", "text": "だが、私は必ず帰ってくる！\nその時こそ、帝国がかつての栄華を取り戻す時だ！", "face": "l40072c1f5ac6"}, {"name": "ベラート", "text": "パーフェクトベラート、撤退モード！！", "face": "l40072c1f5ac6"}, {"name": "レオナ", "text": "……珍妙な出で立ちだが、何と怖ろしい鎧だ。", "face": "u311"}, {"name": "アンナ", "text": "何とか撃退はできましたが、\nあまりにも未知の動きでしたね……。", "face": "l839d9d7ea579"}, {"name": "レオナ", "text": "今後もベラートは何をしでかすか分からない。\n済まないが、これからも力を貸してほしい。", "face": "u311"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "エスネア", "text": "（…………な、なにあれぇ！\nめちゃくちゃカッコよくない！？）", "face": "u997"}, {"name": "モーティマ", "text": "（……ヤバいぜ！　あれはヤバいぜ！！\nうぉぉ、心が躍るぜ……っ！！）", "face": "u14"}, {"name": "エフネ", "text": "（うぅぅ、良く分からないけど\nボクも混ぜてください！）", "face": "u969"}, {"name": "エスネア", "text": "（よぉし、さっそく\nパーフェクトベラートごっこだー！\n後でよわよわ王子も誘ってあーげよっと♪）", "face": "u997"}]}], "active": true}