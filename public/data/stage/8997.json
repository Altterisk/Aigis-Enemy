, "attack_range": 80, "attack_speed": 1, "attack_wait": 180, "attack_interval": 404, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2124432, "race_id": 7, "special_effect_id": 555, "missile_id": 232, "master_id": 36121, "global_id": 9738, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 29, "source": "local", "count": 6, "form_count": 1, "hp": 36000, "attack": 1600, "base_hp": 18000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 20, "attack_range": 180, "attack_speed": 1, "attack_wait": 10, "attack_interval": 57, "move_speed": 2400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2128976, "race_id": 7, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 36113, "global_id": 9730, "ranged": true, "spawn_sec": 928}], "popups": ["水中ゴブリン博士は\nHPが50％以下になると\n攻撃力が上昇し、\n貫通攻撃になります。", "潜水艦に乗るメカゴブリンクイーンが\nいる間は敵のゴブリンの\n攻撃と防御がアップします。\n\n潜水艦に乗るメカゴブリンクイーンは\n撃破数に含まれません。\n\n　　　　　　(1/2)", "また、撃破すると\nその時点で\nミッションクリアになります。\n※討伐数は最大数で\n　カウントされます。\n　　　　　\n　\n　　　　　　(2/2)", "ゴブリン博士お手製機雷は倒されると\n自身の周囲にダメージを与えます。\n\nまた、ゴブリン博士お手製機雷は\n撃破数に含まれません。", "熱帯魚のギルマンから\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴィアベル", "text": "――そろそろ海底に到達するわ。", "face": "u1247a1"}, {"name": "キュステ", "text": "あっ、ゴブリン軍団が集まってますよ。\n遺跡かなにかに群がってるみたいですね？", "face": "u1248a1"}, {"name": "イヴリール", "text": "いや……あれは遺跡じゃない。沈没船だ。", "face": "u1959a1"}, {"name": "リーンベル", "text": "沈没船……？\nここ数年、この海域での沈没報告は受けていないぞ？", "face": "u268"}, {"name": "イヴリール", "text": "それも当然だ。\nあの船の様式、おそらく戦乱の時代のものだろう。", "face": "u1959a1"}, {"name": "ヴィアベル", "text": "そんな船に、ゴブリン軍団がいったい何の用事で――", "face": "u1247a1"}, {"name": "ゴブリン博士", "text": "クックック。\nコレだけの財宝がアレバ！\nメカゴブリンクイーン様に最高のプレゼントを……！", "face": "l2bdcef4785ee"}, {"name": "ヴィアベル", "text": "…………。", "face": "u1247a1"}, {"name": "ゴブリン博士", "text": "黄金の首飾り……イヤ、\n光り輝く全身像……ッ！！\nイヤイヤイヤ、ココはモウ、黄金の指輪ヲ……！！", "face": "l2bdcef4785ee"}, {"name": "リーンベル", "text": "…………。", "face": "u268"}, {"name": "ゴブリン博士", "text": "フフッ、フフフッ……。\n夢が無限に広がル……！！", "face": "l2bdcef4785ee"}, {"name": "キュステ", "text": "見逃してあげていいんじゃないですか？", "face": "u1248a1"}, {"name": "アンナ", "text": "そういうわけにも……。\nあれが沈没船なら、まずは調査が優先です。", "face": "l3e7b18ff46b6"}, {"name": "リーンベル", "text": "それにここは王国領海内だ。\n好き勝手に盗掘させていたら、国家の主権に関わる。", "face": "u268"}, {"name": "イヴリール", "text": "難しい理屈付けは終わったか？", "face": "u1959a1"}, {"name": "リーンベル", "text": "えぇ。あとは存分に。", "face": "u268"}, {"name": "イヴリール", "text": "やれやれ。\n財宝なんてのは、昔から勝ったやつの総取りだろう？\n向こうがそれを望んでいるんだ、乗ってやれ。", "face": "u1959a1"}, {"name": "ゴブリン博士", "text": "なっ……王子ィ！？\nナゼここに！？", "face": "l2bdcef4785ee"}, {"name": "王子", "text": "…………（ふんす）", "face": "u1"}, {"name": "ゴブリン博士", "text": "くぅぅっ、盗掘がバレたノカ！？\n仕方ナイ！\n相手が王子と言えド、ココは譲れヌ！", "face": "l2bdcef4785ee"}, {"name": "ゴブリン博士", "text": "ゴブリン軍団ヨ！　戦闘準備を――", "face": "l2bdcef4785ee"}, {"name": "メカゴブリンクイーン", "text": "――ウフフフッ！\n水くさいわよゴブリン博士！", "face": "lacfe1e951c88"}, {"name": "ゴブリン博士", "text": "メカゴブリンクイーン様ぁ！？", "face": "l2bdcef4785ee"}, {"name": "メカゴブリンクイーン", "text": "どうせ、危険な深海調査だからと、\n私に黙って作業を進めようとしたのでしょう？", "face": "lacfe1e951c88"}, {"name": "ゴブリン博士", "text": "ハッ、エッ、アッ、エットォ……ソノォ……。", "face": "l2bdcef4785ee"}, {"name": "メカゴブリンクイーン", "text": "気にする必要はないわ！\n私には、アナタが造った新型兵器、\nゴブリン武装潜水艦があるのだから！", "face": "lacfe1e951c88"}, {"name": "ゴブリン", "text": "ギャギャ！　メカゴブリンクイーンサマ！\nクイーンサマミテル！　ガンバル！！", "face": "lea836502d59f"}, {"name": "キュステ", "text": "……あー、めちゃくちゃになってきましたよぉ？\nクイーンのせいで、ゴブリン皆やる気になってますし。", "face": "u1248a1"}, {"name": "リーンベル", "text": "まとめて黙らせよう。", "face": "u268"}, {"name": "イヴリール", "text": "同感だ。", "face": "u1959a1"}, {"name": "ケイティ", "text": "おそらくメカゴブリンクイーンを倒せば、\nこの騒動もすぐに鎮まるはずです。\n可能であれば、クイーンに集中攻撃を！", "face": "u114"}]}, {"trigger": "enemy_death", "enemy_id": 8, "lines": [{"name": "イヴリール", "text": "――で、反省したか？", "face": "u1959a1"}, {"name": "ゴブリン博士", "text": "グヌヌヌ……。", "face": "l2bdcef4785ee"}, {"name": "リーンベル", "text": "せっかく沈没船を発見したんだから、\n焦らず王国に報告すれば良かったんだ。", "face": "u268"}, {"name": "リーンベル", "text": "合同調査だって可能だし、\n発見者として取り分の要求だってできただろうに。", "face": "u268"}, {"name": "ゴブリン博士", "text": "ムッ……そ、そうナノカ……？", "face": "l2bdcef4785ee"}, {"name": "アンナ", "text": "王国法にも類似の記述がありますし、\n王子だって駄目とは言わないかと……。"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "ゴブリン博士", "text": "オォ……かたじけナイ……。", "face": "l2bdcef4785ee"}, {"name": "リーンベル", "text": "よし、じゃあ話もまとまったし、\nメカゴブリンクイーンの救助に行くとしよう。", "face": "u268"}, {"name": "ヴィアベル", "text": "方向舵が壊れたようだったから、\n軍艦で牽引してあげないとかしら？", "face": "u1247a1"}, {"name": "ゴブリン博士", "text": "い、イイノカ……！？", "face": "l2bdcef4785ee"}, {"name": "リーンベル", "text": "今は物質界連合の仲間だろう？\n今後も、できれば協力関係であり続けたいが。", "face": "u268"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ゴブリン博士", "text": "アリガトウ、王国海軍ヨ！\nアリガトウ、王子ヨ！", "face": "l2bdcef4785ee"}, {"name": "イヴリール", "text": "よし、あの女王が迷子になる前に追うぞ。\n総員海面に上がり、乗船しろ！", "face": "u1959a1"}]}], "active": true}