"hp": 9000, "attack": 750, "base_hp": 9000, "base_attack": 750, "damage_type": "physical", "armor_defense": 800, "attack_range": 120, "attack_speed": 1, "attack_wait": 60, "attack_interval": 167, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160656, "race_id": 16, "special_effect_id": 232, "missile_id": 45, "master_id": 38800, "global_id": 12417, "ranged": true, "spawn_sec": 102}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 2, "tags": ["黒輪"], "hp": 9500, "attack": 550, "base_hp": 9500, "base_attack": 550, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 100, "attack_speed": 300, "attack_wait": 90, "attack_interval": 343, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155568, "race_id": 5, "special_effect_id": 2071, "change_to": 12, "change_condition": 2, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 38781, "global_id": 12398, "ranged": true, "to_condition": 2, "to_global_id": 12399, "spawn_sec": 117}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 14250, "attack": 1100, "base_hp": 14250, "base_attack": 1100, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "attack_range": 100, "attack_speed": 300, "attack_wait": 70, "attack_interval": 303, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2155568, "race_id": 5, "special_effect_id": 2072, "missile_id": 422, "missile": {"speed": 10.0}, "master_id": 38782, "global_id": 12399, "ranged": true, "from_condition": 2}, {"enemy_id": 14, "source": "local", "count": 2, "form_count": 2, "tags": ["黒輪"], "hp": 24000, "attack": 1200, "base_hp": 24000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_range": 60, "attack_speed": 115, "attack_wait": 100, "attack_interval": 279, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 2077, "change_to": 14, "change_condition": 2, "missile_id": 11, "master_id": 38785, "global_id": 12402, "ranged": true, "to_condition": 2, "to_global_id": 12403, "spawn_sec": 144}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒輪"], "hp": 36000, "attack": 2400, "base_hp": 36000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_range": 60, "attack_speed": 115, "attack_wait": 80, "attack_interval": 239, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2157232, "race_id": 11, "special_effect_id": 2078, "missile_id": 11, "master_id": 38786, "global_id": 12403, "ranged": true, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "トワ", "text": "――もとの時間に戻ります！\n座標の特定は不可能……衝撃に備えてください！", "face": "u336"}, {"name": "オーシェン", "text": "……ッ。\nここは、北の大国のどこか……のようですね。", "face": "u2133a1"}, {"name": "シビラ", "text": "北部戦線近くの廃村ね……。\nこの音は――戦場の近く……？", "face": "u39"}, {"name": "トレシア", "text": "王子殿下、シビラ殿下！\nどうして戦場に……！？", "face": "u2314a1"}, {"name": "シビラ", "text": "トレシア！　状況報告をお願い。\nいったい何が起きているの？", "face": "u39"}, {"name": "トレシア", "text": "現在、仮面の騎士団、\n及びラシュマシュ、ズィズィーの手勢との戦闘中です！", "face": "u2314a1"}, {"name": "トレシア", "text": "北部城塞を突破した魔物も多数！\n現在、王国にも支援要請を――あ、あれ？", "face": "u2314a1"}, {"name": "トレシア", "text": "もう、王子殿下がいる……？\nまだ伝令が届く前、ですよね……？", "face": "u2314a1"}, {"name": "フィノーラ", "text": "なるほど、歴史が書き換わった、のか……。\nすまない、王子……僕が失敗しなければ……。", "face": "u2441a1"}, {"name": "オーシェン", "text": "反省会は後にしましょう。\n悔やむことはいつでもできます。\n今は――敵の軍勢を押し返す時！", "face": "u2133a1"}, {"name": "ズィズィー", "text": "うわ、戻ってきた。\nラシュマシュ、あいつらどうする？", "face": "l55560da56643"}, {"name": "ラシュマシュ", "text": "仲良く遊んであげましょう。\nエンキドゥも随分と楽しそうだし。", "face": "l2efb11afd439"}, {"name": "ズィズィー", "text": "何か記憶がざわざわする……ってことは、\n無事にやりたいこと、やり遂げてきたのかな？", "face": "l55560da56643"}, {"name": "ラシュマシュ", "text": "そういうことでしょうね。\nただ……ちょっと美学には反するけれど。", "face": "l2efb11afd439"}, {"name": "ズィズィー", "text": "ラシュマシュの美学ぅ？", "face": "l55560da56643"}, {"name": "ラシュマシュ", "text": "一度失敗したことを、無かったことにする。\nそんなの、後ろ向きすぎて美しくないじゃない？", "face": "l2efb11afd439"}, {"name": "ラシュマシュ", "text": "悲劇も、喜劇もね、\n前を向いて転がり落ちていくのが素敵なのよ。", "face": "l2efb11afd439"}]}, {"trigger": "end", "lines": [{"name": "トレシア", "text": "――敵の攻勢に揺らぎが。\nシビラ殿下、敵が撤退していきます！", "face": "u2314a1"}, {"name": "シビラ", "text": "本隊は待機、精鋭に追わせて。\n北部城塞より\n北に向かうようなら追跡を打ち切っていいわ。", "face": "u39"}, {"name": "トレシア", "text": "……ここで潰さなくて、大丈夫ですか？", "face": "u2314a1"}, {"name": "シビラ", "text": "こちらが壊滅的な被害を受けるのは避けないと。\n北部城塞軍を失うのは、\n全軍の半数の戦力喪失とほぼ同じよ。", "face": "u39"}, {"name": "オーシェン", "text": "こちらも同意です。\n敵の撤退に波があるのは、\nおそらく捨て駒の小隊を残しているからでしょう。", "face": "u2133a1"}, {"name": "シビラ", "text": "死兵ほど怖いものはないものね。", "face": "u39"}, {"name": "エンキドゥ", "text": "…………。", "face": "lc099c04ad102"}, {"name": "シビラ", "text": "それに、何が起きたのか、確かめないと。", "face": "u39"}, {"name": "トレシア", "text": "何が起きたか、ですか……？", "face": "u2314a1"}, {"name": "シビラ", "text": "厄介ね、歴史の改変って。", "face": "u39"}, {"name": "シビラ", "text": "王子、一度城塞に退きましょう。\nフィノーラ、状況の説明をお願いできる？", "face": "u39"}, {"name": "フィノーラ", "text": "ああ。と言っても、\nここはもう、僕の知っている時代じゃない。\nどこまで正確に説明できるかは分からないけど。", "face": "u2441a1"}]}], "story_talk": true, "active": true}