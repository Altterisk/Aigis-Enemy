", "count": 7, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 91}, {"enemy_id": 5, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 398, "global_id": 397, "spawn_sec": 101}, {"enemy_id": 6, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 400, "global_id": 399, "ranged": true, "spawn_sec": 201}], "dialogue": [{"trigger": "start", "lines": [{"name": "セシリー", "text": "エーリカが入って行ったのはここだ。\n間違いない。", "face": "u21"}, {"name": "ユユ", "text": "わぁ～！？　何ここぉ！？　すっごーい！\n王子さま、ほらほら、あれ見て！\nカボチャの家だよぉ！　素敵だねぇ、住みたいねぇ！", "face": "u110"}, {"name": "ユユ", "text": "エーリカさんは本当に操られてるのかなぁ？\nこんなに楽しそうな所に住んでるみたいだし、\nやっぱりあたし達の思い過ごしだったのかも……。", "face": "u110"}, {"name": "ユリアン", "text": "いや、ここだいぶ不気味だぞ？\n墓も沢山あるし……。そもそもパンプキンキングが\n人間って……。完全に洗脳されてるぜ、あの子。", "face": "u7"}, {"name": "カボチャの魔物", "text": "クフフ。\nマンマと誘イコマレタ馬鹿ナ王子タチ。", "face": "l127852b34ebb"}, {"name": "カボチャの魔物", "text": "ココがお前タチの墓場ニナルノダ！", "face": "l127852b34ebb"}, {"name": "ケイティ", "text": "王子、カボチャの魔物です！\n急ぎ戦闘のご準備を。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "カボチャの魔物", "text": "グヌヌ……また負ケタ……。", "face": "l127852b34ebb"}, {"name": "カボチャの魔物", "text": "デモ、マダマダ諦めタリナンカしないカボ！\nトニカク今は逃げるカボーッ！", "face": "l127852b34ebb"}, {"name": "ユリアン", "text": "おいコラ、待ちやがれ！", "face": "u7"}, {"name": "ケイティ", "text": "エーリカさんの姿はありませんでしたね。\n手がかりはあのカボチャ達しか……。\n危険かもしれませんが、カボチャ達を追いましょう。", "face": "u114"}]}], "map": {"image": "Map920078_3869", "w": 960, "h": 640, "spots": [{"k": "b", "x": 927, "y": 176}, {"k": "m", "x": 850, "y": 215, "id": 200}, {"k": "m", "x": 723, "y": 281, "id": 201}, {"k": "m", "x": 757, "y": 205, "id": 202}, {"k": "m", "x": 670, "y": 161, "id": 203}, {"k": "m", "x": 580, "y": 115, "id": 204}, {"k": "m", "x": 197, "y": 216, "id": 205}, {"k": "m", "x": 354, "y": 298, "id": 206}, {"k": "m", "x": 547, "y": 291, "id": 207}, {"k": "m", "x": 550, "y": 483, "id": 208}, {"k": "m", "x": 452, "y": 334, "id": 209}, {"k": "m", "x": 446, "y": 428, "id": 210}, {"k": "m", "x": 633, "y": 333, "id": 211}, {"k": "m", "x": 641, "y": 427, "id": 212}, {"k": "m", "x": 359, "y": 378, "id": 213}, {"k": "m", "x": 729, "y": 383, "id": 214}, {"k": "m", "x": 279, "y": 257, "id": 215}, {"k": "r", "x": 142, "y": 310, "id": 300}, {"k": "r", "x": 422, "y": 167, "id": 301}, {"k": "r", "x": 773, "y": 472, "id": 302}, {"k": "r", "x": 818, "y": 146, "id": 303}, {"k": "r", "x": 352, "y": 486, "id": 304}, {"k": "r", "x": 862, "y": 304, "id": 305}]}, "start_cost": 10, "active": true, "name_en": "Pumpkin House", "description_en": "The Prince breaches the pumpkin dwelling and discovers a strange pumpkin house, but…….\n\nAdvanced (★1 target: average Lv10)"}