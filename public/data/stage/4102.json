{"quest_id": 4102, "name": "鬼を宿す剣士：鬼の力", "description": "戦場に現れた一人の剣士\nその剣士に隠された力とは？", "event": "鬼を宿す剣士", "event_category": "History", "mission_id": 920023, "map_no": 3020, "level": 80, "multiplier": 0.8, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 1, "hp": 512, "attack": 112, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 8, "form_count": 1, "hp": 800, "attack": 120, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 11}, {"enemy_id": 3, "source": "local", "count": 1, "level": 90, "form_count": 1, "tags": ["アーマー"], "hp": 2240, "attack": 320, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 38}, {"enemy_id": 4, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 4800, "attack": 320, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099872, "race_id": 16, "master_id": 200, "global_id": 199, "spawn_sec": 45}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "魔物が出現したと報告があった場所は\nここですね。", "face": "lf8b2ab917c80"}, {"name": "暗黒騎士", "text": "進め！　魔物たちよ！\n王子の軍を壊滅させるのだ！", "face": "lf7e57276aa4b"}]}, {"trigger": "battle", "at_sec": 49, "lines": [{"name": "暗黒騎士", "text": "流石にやるな。\nしかし、もう少しで\nアレが到着するはずだ。", "face": "lf7e57276aa4b"}, {"name": "剣士", "text": "…………。", "face": "u164"}, {"name": "剣士", "text": "………！！", "face": "u1164"}, {"name": "アンナ", "text": "王子！　新手です！\n注意してください！", "face": "lf8b2ab917c80"}]}, {"trigger": "end", "lines": [{"name": "剣士", "text": "あなたが、あの軍を指揮する王子ですか？", "face": "u164"}, {"name": "アンナ", "text": "あなたは……？", "face": "lf8b2ab917c80"}, {"name": "モミジ", "text": "私の名はモミジ。\nあなたたちと争うつもりはありません。\n私の刀は……人を……まもる……。", "face": "u164"}, {"name": "モミジ", "text": "…………。", "face": "u164"}, {"name": "アンナ", "text": "あっ……！　気絶してしまったみたいですね。\n争うつもりはないとは、どういうことでしょう？", "face": "lf8b2ab917c80"}, {"name": "モミジ", "text": "…………！", "face": "u1164"}, {"name": "モミジ", "text": "初めましてだな、王子よ。\n我はこの娘の身体を借りている者。", "face": "u1164"}, {"name": "アンナ", "text": "雰囲気が変わった……！\n王子、危険です。\nモミジさんから離れてください。", "face": "lf8b2ab917c80"}, {"name": "モミジ", "text": "王子よ。ここで貴様を叩き斬っても良いが、\n次の楽しみにしておくとしよう。\nでは次の戦場で会おう。", "face": "u1164"}, {"name": "アンナ", "text": "行ってしまったようですね……。\nあの様子、どうやら魔物に意識を\n乗っ取られているようです。", "face": "lf8b2ab917c80"}, {"name": "アンナ", "text": "このまま放っておくわけにはいきません。\nモミジさんの後を追いましょう！", "face": "lf8b2ab917c80"}]}], "active": true}