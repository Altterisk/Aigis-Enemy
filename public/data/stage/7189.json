: "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["鳥"], "hp": 1500, "base_hp": 1500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 2, "attack_speed": 1, "attack_wait": 3, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2125744, "race_id": 12, "special_effect_id": 613, "change_to": 12, "master_id": 32912, "global_id": 6529, "ranged": true}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 2, "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124096, "race_id": 20, "change_to": 15, "change_condition": 4, "master_id": 32748, "global_id": 6366, "to_condition": 4, "to_ticks": 3, "to_global_id": 6369, "spawn_sec": 222}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1400, "base_hp": 5000, "base_attack": 1400, "damage_type": "true", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 32751, "global_id": 6369, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 19, "source": "local", "count": 28, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124160, "race_id": 20, "change_to": 19, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32915, "global_id": 6532, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6535, "spawn_sec": 239}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 800, "base_hp": 5500, "base_attack": 800, "damage_type": "true", "armor_defense": 600, "magic_defense": 15, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124176, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32918, "global_id": 6535, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 23, "source": "local", "count": 4, "form_count": 2, "hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124224, "race_id": 20, "change_to": 23, "change_condition": 4, "master_id": 32752, "global_id": 6370, "to_condition": 4, "to_ticks": 3, "to_global_id": 6375, "spawn_sec": 248}, {"enemy_id": 23, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 405, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124240, "race_id": 20, "special_effect_id": 563, "change_to": 26, "change_condition": 1, "master_id": 32757, "global_id": 6375, "from_condition": 4, "trigger_ticks": 3, "variants": [{"hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124240, "race_id": 20, "special_effect_id": 563, "missile_id": 45, "master_id": 32755, "global_id": 6373}]}], "popups": ["アラエルが使役する霊鳥は\nあらゆる攻撃を受け付けません。\n\nアラエルの撃破、もしくは\nアラエルが拠点を通過すると\n消滅します。", "アラエルがいる間は、\n鳥人系の敵の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "トラム", "text": "（――その身を石に変えられし\n我が民よ、もう少しだけ待っていて）", "face": "u1110a1"}, {"name": "トラム", "text": "（王子が――あの人の子孫が、\n私を殺しに来てくれたわ。\nかつての私の剣の担い手と、右腕を連れて）", "face": "u1110a1"}, {"name": "トラム", "text": "（嗚呼、あとは私が「契約」を果たし、\nゴルゴーンと共に滅べば、\nこの都は石の呪いから解放される……）", "face": "u1110a1"}, {"name": "ゴルゴーン", "text": "フシュシュ……。\n「契約」を忘れぬようにな、亜神トラムよ。", "face": "le8081631b686"}, {"name": "トラム", "text": "えぇ、私は決して裏切らないわ。\n全力で王子を迎え撃つ。", "face": "u1110a1"}, {"name": "ゴルゴーン", "text": "フシュシュ……。その言葉を信じよう。\nダが、貴様の出番はまダ先ダ……。", "face": "le8081631b686"}, {"name": "トラム", "text": "まだ先……？\nどういう――まさか、天使を呼んだの！？", "face": "u1110a1"}, {"name": "ゴルゴーン", "text": "あの御方の采配ダ。\n創造主亡き天使は全テ、あの御方のものなのダから。", "face": "le8081631b686"}, {"name": "トラム", "text": "……その装置を停止させないよう注意することね。\n一瞬でも隙が生まれたら、\n操られていた天使が一斉に牙をむくはずよ。", "face": "u1110a1"}, {"name": "ゴルゴーン", "text": "フシュシュ！\n天使如きが傷ツけられるような方ではない。\n三女神に力を分かタれテなお、その輝きは健在よ。", "face": "le8081631b686"}, {"name": "トラム", "text": "（……王子、必ずここへたどり着いて。\n私と戦うその瞬間まで、必ず生き残って）", "face": "u1110a1"}, {"name": "トラム", "text": "（――あなたには、「契約」に縛られた私を、\n殺してもらわないといけないのだから）", "face": "u1110a1"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "ソシエ", "text": "王子、どうかしたの？\nもう敵陣のど真ん中だから、気を抜いちゃだめ。", "face": "u486"}, {"name": "シビラ", "text": "……それにしても、酷いありさまね。\n周りの石像は、ただの彫像じゃない。\n全部ひとが石に変えられたものよ。", "face": "u39"}, {"name": "ハリナ", "text": "ゴルゴーンは麻痺の力を持っていたが、\n長く浴び続ければ石となるというのは、\nまさにこういうことだったのか……。", "face": "u988"}, {"name": "白の皇帝", "text": "国を人質に取られた為政者……か。\n王子、貴様が同じ状況なら、どうする。", "face": "u418"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "白の皇帝", "text": "……愚問だったか。\n確かに貴様なら、こんな事態を招く前に、\n誰かに助力を求めていたことだろうな。", "face": "u418"}, {"name": "ディアナ", "text": "――陛下、伏兵が姿を現しました。\nどうやらまだ、足止めをするつもりのようです。", "face": "u624"}, {"name": "白の皇帝", "text": "フッ……ならば取るべき道はひとつだけだ。\n王子、俺はあちらの敵をやる。\nお前はこのまま、正面から切り抜けるがいい。", "face": "u418"}]}, {"trigger": "battle", "at_sec": 161, "lines": [{"name": "ギガエル", "text": "……来た、か。\n深海より呼び戻された時は何事かと思ったが、\nまさか溺れる民がゴルゴーン様に挑むとは。", "face": "l7b77898c1bb9"}, {"name": "アラエル", "text": "……殺す、殺す、殺す殺す殺す。\n神が滅ぶはずがない……神は、確かにいるんだ……。", "face": "lc1a9650acc48"}, {"name": "パリオス", "text": "あ、アラエルさま……！？\nぼくだよ！　パリオスだよ！！", "face": "u1109a1"}, {"name": "アラエル", "text": "……ぱり、おす……？\nくっ……ぐぁああっ、あ、あたまが……割れる……っ。", "face": "lc1a9650acc48"}, {"name": "アラエル", "text": "お前か！　お前が僕の主をぉぉッ！！\n殺すっ、殺す殺す殺すぅぅぅぅっ！！", "face": "lc1a9650acc48"}, {"name": "ギガエル", "text": "アラエル……そうだな、\n己が創造主の滅びなど、誰も信じたくはあるまい。", "face": "l7b77898c1bb9"}, {"name": "ギガエル", "text": "だが奴らを殺し、神の楔を勝ち取れば、\nお前の主の復活も夢ではあるまい。", "face": "l7b77898c1bb9"}, {"name": "ギガエル", "text": "今はただ、己が信じるもののために\n泥を啜り、かの亜神に従うのだ。", "face": "l7b77898c1bb9"}, {"name": "ソフィー", "text": "アラエル、ギガエル、あなたたちは……。", "face": "u146"}, {"name": "ギガエル", "text": "……ソフィーか、久しいな。\nと言っても、我らのことなど覚えてはいないだろうが。", "face": "l7b77898c1bb9"}, {"name": "ギガエル", "text": "さぁ、人の身でどこまで戦えるのか、\nこの先に待つ戦いのため、見極めさせてもらおうか。", "face": "l7b77898c1bb9"}, {"name": "アンナ", "text": "王子、天使たちが来ます！\nどうか、慎重な指揮をお願いします！", "face": "l0ade8018550d"}]}, {"trigger": "end", "lines": [{"name": "ギガエル", "text": "……ここまで、だな。\nアラエル、撤退するぞ。", "face": "l7b77898c1bb9"}, {"name": "アラエル", "text": "……ギガ、エル？　ソフィー？\nああ、みんなここにいたのですね。\n主は、我が主はどこに……。", "face": "lc1a9650acc48"}, {"name": "ソフィー", "text": "……あなたの主は、きっと聖域で待っていますよ。", "face": "u146"}, {"name": "アラエル", "text": "ああ、ああ、そうに違いない……。\nギガエル、送ってくれますか？\nどうしてか、とても疲れていて……。", "face": "lc1a9650acc48"}, {"name": "ギガエル", "text": "……ああ、任せておけ。\nそして王子よ、退くならば、今が最後の好機だ。\nここがお前達の分水嶺なのだから。", "face": "l7b77898c1bb9"}, {"name": "ギガエル", "text": "ゴルゴーン様を滅ぼすか、否か。\nそれがお前たちの運命を変えることになる。", "face": "l7b77898c1bb9"}, {"name": "王子", "text": "……助けを求める者を、見捨てるわけにはいかない。\nもう二度と、助けを求める声に背を向けたりはしない。", "face": "u1"}, {"name": "王子", "text": "何が敵であろうと、俺たちは勝利する。\n自分たちの行く末を、自ら決めるために。", "face": "u1"}, {"name": "ギガエル", "text": "……それはもはや、呪いのようなものだぞ。\nいったい何人の運命をその肩に担うつもりだ。", "face": "l7b77898c1bb9"}, {"name": "ギガエル", "text": "だが、嗚呼、そうだな……。\n為政者とはそういうものか。\n我が主も、民のために己を殺す御方だった。", "face": "l7b77898c1bb9"}, {"name": "ギガエル", "text": "さぁ、行くがいい。\n人の身に余る願いを持つ者よ。\n今だけは天使として、お前たちを祝福しよう。", "face": "l7b77898c1bb9"}, {"name": "アンナ", "text": "……天使たちが、撤退していきます。\n王子、この先が都市の中枢、\nトラムさんと、ゴルゴーンが待つ場所です。", "face": "l0ade8018550d"}, {"name": "アンナ", "text": "私たちは、王子の目指す未来を信じます。\nだからどうか、悔いなき戦いを。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "トラム", "text": "（――そう、いつの世も、\n王とは民のために己を殺すか、\n民を殺して己が生きることしかできないの）", "face": "u1110a1"}, {"name": "トラム", "text": "（でも、あの人はどうだったかしら……。\n英雄王、私たちが信じて戦ったあの人は）", "face": "u1110a1"}, {"name": "トラム", "text": "（――あの人になら「助けて」って、言えたのかしら）", "face": "u1110a1"}]}], "active": true}