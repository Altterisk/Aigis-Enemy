{"quest_id": 6914, "name": "燃ゆる世界樹", "description": "王子達の戦いはまだまだ終わらない！\n世界樹に降り立つ天よりの使者を退けよ！\n<特定のタイミングで熱波が発生>\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["特定のタイミングで熱波が発生"], "event": "英雄王を継ぐ者", "event_category": "History", "mission_id": 920186, "map_no": 5124, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 21, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 1, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 3, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 61}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 11, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000