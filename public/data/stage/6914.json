"attack_interval": 151, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105552, "race_id": 6, "special_effect_id": 86, "master_id": 32083, "global_id": 5702}]}, {"enemy_id": 15, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 15, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 4890}]}, "spawn_sec": 214}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 17, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 3200}]}, "spawn_sec": 219}, {"enemy_id": 19, "source": "local", "count": 6, "form_count": 1, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107024, "race_id": 6, "master_id": 697, "global_id": 696, "spawn_sec": 252}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 120000, "attack": 1200, "base_hp": 120000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_range": 300, "attack_speed": 1, "attack_wait": 80, "attack_interval": 235, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2120672, "special_effect_id": 108, "missile_id": 410, "missile": {"speed": 8.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 32080, "global_id": 5699, "ranged": true, "spawn_sec": 288}], "popups": ["  　　悪天候：熱波\n\n・味方に『継続ダメージ』\n・悪天候の影響を受けない特性を持つ\nユニットは『継続ダメージ』を\n受けません。", "上位天使(戦斧)がいる間は\n全ての天使のHPが\n徐々に回復します。", "茨の女王から攻撃を受けると、\n攻撃後の待ち時間が\n大幅に増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "キャロップ", "text": "――世界樹が、燃えてる……。\nうぅ、どうしてこんなことに……。", "face": "u698"}, {"name": "クゥイル", "text": "突如、前触れもなく天使が侵攻してきたんです。\n世界樹の周囲は常に、\nグリフィン騎兵が警戒しているはずなのに……。", "face": "u702"}, {"name": "エイル", "text": "もしや……世界樹の内側から……？", "face": "u804"}, {"name": "大天使長", "text": "――なるほど、それなりの知恵はあるようですね。\nされど愚かなる人の子よ。\nこれはもはや、手遅れというものです。", "face": "ldefb66888388"}, {"name": "大天使長", "text": "不要な枝葉は全て焼け落ち、\n力ある幹は神の力の欠片によって魔物と化す。\n世界樹はこのまま滅びゆく定めなのです。", "face": "ldefb66888388"}, {"name": "ソフィー", "text": "大天使長、もはや地上に、\n天使に命をくだす神は存在しません。\n何故、こんなことをするのですか。", "face": "u146"}, {"name": "大天使長", "text": "……なるほど、堕天した者達には感じられませんか。\n世界樹に開いた天界へ続く門より、\nこの世界に溢れ出る、力の波動を。", "face": "ldefb66888388"}, {"name": "アンナ", "text": "天界へ続く、門……？", "face": "lae6f900356a5"}, {"name": "クロエ", "text": "……神無き地上に、天使に命を下すものはいない。\n大天使長、あんたに指示を出しているのは、何者？", "face": "u145"}, {"name": "大天使長", "text": "わざわざ我らがそれを教えるとでも？\n我らはただ、命に従い浄化を執行するのみ。", "face": "ldefb66888388"}, {"name": "大天使長", "text": "この虫と同じ様に、\n世界樹と共に浄化してやりましょう。\nそれが愚かなる人の子への、せめてもの慈悲です。", "face": "ldefb66888388"}, {"name": "女王蜘蛛", "text": "……ぐっ、ぁあっ……！\n気をつけ、なさい……敵は天使だけではありません。\nこの者らは……世界樹に、『神の楔』を……。", "face": "l2094e6bcb3a4"}, {"name": "エイル", "text": "女王蜘蛛……！\nなんて酷い……今助けますからね！", "face": "u804"}, {"name": "女王蜘蛛", "text": "わたくしよりも、今は天使を……！\nこのままでは……ぁっ、ぐっ、\n世界樹が……燃え落ちてしまいますわ……っ！", "face": "l2094e6bcb3a4"}, {"name": "女王蜘蛛", "text": "人の子をかばったばかりに……。\nくっ……不覚ですわね……。", "face": "l2094e6bcb3a4"}, {"name": "？？？", "text": "ぅ……ぁ……。", "face": "u960"}, {"name": "大天使長", "text": "――確か、あなた方はこの浄化を、\n世界樹の災厄の予言、と呼んでいましたね。\nそれでは、災厄そのものをご覧に入れましょう。", "face": "ldefb66888388"}, {"name": "フェイ", "text": "王子、この『熱波』の中じゃ、\n徐々に体力を削られちゃうわ。\n私達風水使いの力を上手く使って！", "face": "u434"}, {"name": "アンナ", "text": "世界樹を滅ぼさせるわけにはいきません。\n王子、急ぎ迎撃の準備をお願いします！", "face": "lae6f900356a5"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "――くふ。くふふ。", "face": "l03de852214d8"}, {"name": "ロヴィニア", "text": "何、あれ……？\nあんな魔物見たことないよ……？", "face": "u662"}, {"name": "女王蜘蛛", "text": "あれは世界樹に埋め込まれた、\n神の力の欠片なるものによって、\n姿を変じた茨の女王とも言うべき魔物ですわ……。", "face": "l2094e6bcb3a4"}, {"name": "女王蜘蛛", "text": "茨の女王のつるは、\n絡め取った者の動きを鈍くします。\n王国の者達よ、決して油断せぬよう……。", "face": "l2094e6bcb3a4"}, {"name": "茨の女王", "text": "くふ……くふふふっ！", "face": "l03de852214d8"}]}, {"trigger": "end", "lines": [{"name": "大天使長", "text": "――なるほど、魔王ガリウス討伐の報は\n真実だったようですね。\n人の身でこれほどの力を手にしているとは。", "face": "ldefb66888388"}, {"name": "大天使長", "text": "しかし世界樹に埋め込んだ『神の楔』は、\nいまやその幹の深くにまで至っています。\n目的は十分に達成したと言って良いでしょう。", "face": "ldefb66888388"}, {"name": "ミルノ", "text": "――ま、待ちなさい！　大天使長！", "face": "u337"}, {"name": "ロヴィニア", "text": "ちぃっ、もう弓も届かないところに……！", "face": "u662"}, {"name": "エイル", "text": "ともかく、今は消火と負傷者の救助が最優先です。\n女王蜘蛛もっ！　大人しく治療されてくださいね！", "face": "u804"}, {"name": "女王蜘蛛", "text": "……恩に着ますわ、人間の娘よ。\nけれどわたくしよりも、この子を優先してくださいな。", "face": "l2094e6bcb3a4"}, {"name": "？？？", "text": "……こ、ここは……あなた方は……？", "face": "u960"}, {"name": "女王蜘蛛", "text": "この子は、天使の軍勢が出現した直後に、\n天界へ続く門より転がり出てきたのです。", "face": "l2094e6bcb3a4"}, {"name": "女王蜘蛛", "text": "もしかしたら、何か天界のことを\n知っているかもしれませんわ。", "face": "l2094e6bcb3a4"}, {"name": "エイル", "text": "……わかりました。\nですが、あなたも無理はしないでくださいね？", "face": "u804"}, {"name": "女王蜘蛛", "text": "そちらもね。\nさぁ、わたくしの子供たち、\nエルフ達に協力し、世界樹の火を消しに行きなさい。", "face": "l2094e6bcb3a4"}, {"name": "ソラス", "text": "（……世界樹に打ち込まれたという、\n『神の楔』なるもの……星の巡りも、\n暗がりに満ちた未来を伝えています……）", "face": "u904"}, {"name": "ソラス", "text": "（戦いは、まだ終わっていないということなのですか……？）", "face": "u904"}]}], "active": true}