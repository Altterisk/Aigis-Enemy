 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128992, "race_id": 7, "special_effect_id": 233, "missile_id": 548, "missile": {"speed": 1.0}, "master_id": 33757, "global_id": 7374, "ranged": true, "spawn_sec": 85}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "tags": ["水中"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 5, "attack_interval": 60, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2123616, "race_id": 7, "master_id": 32682, "global_id": 6300, "spawn_sec": 115}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 2500, "attack": 700, "base_hp": 2500, "base_attack": 700, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104832, "race_id": 7, "change_to": 4, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 576, "global_id": 575, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 576, "spawn_sec": 134}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104848, "race_id": 7, "master_id": 577, "global_id": 576, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 60, "attack_range": 100, "attack_speed": 1, "attack_wait": 30, "attack_interval": 129, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124400, "race_id": 7, "special_effect_id": 220, "missile_id": 11, "master_id": 32767, "global_id": 6385, "ranged": true, "spawn_sec": 158}], "popups": ["ゾンビシャークから攻撃を受けると、\n即座に麻痺状態になります。\n\n\n\n\n\n　　　　　　(1/2)", "またゾンビシャークは\n攻撃を行うたびに、\n攻撃力がアップしていきます。\n\n２回目の攻撃後、\n攻撃力が最大になります。\n※３回目以降の攻撃力が最大\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "クゥイル", "text": "──前方に標的を捕捉！　もう間もなく会敵します！", "face": "u1256a1"}, {"name": "メルアビス", "text": "いよいよ黒幕のご登場ってわけね、\nどんな面か拝ませてもらおうじゃない。", "face": "u1252a1"}, {"name": "マーヤ", "text": "うう……あまり怖い顔でないといいのですが……。", "face": "u839"}, {"name": "アナトリア", "text": "アンデッドが怖かったらあたしの後ろに来なよ。\n全員まとめて守ってやるから安心して任せな！", "face": "u1250a1"}, {"name": "メーア", "text": "はーい！", "face": "u1038a1"}, {"name": "ディアナ", "text": "はーいではありません、あなたはこっちです。\nなんですかその騎士団でも見せない無駄に良い返事は。", "face": "u1034a1"}, {"name": "メルアビス", "text": "来るわよ王子!　指揮をお願い！", "face": "u1252a1"}]}, {"trigger": "battle", "at_sec": 11, "lines": [{"name": "アレイダ", "text": "あのアンデッド……人喰いザメでは！？\nおおお、お兄ちゃん！　助けてくださーい！", "face": "u1251a1"}, {"name": "クゥイル", "text": "ほ、本当に人喰いザメですっ！\nみなさん気を付けてくださ──え？\nお兄ちゃん？　王子殿下がですか？", "face": "u1256a1"}, {"name": "アレイダ", "text": "あっ──いえ、あの、その、これは違くて。", "face": "u1251a1"}, {"name": "メルアビス", "text": "(怯えながら王子の腕に抱き着く……、\nそういうのもあるのね、勉強になるわ。\nでも……怯えるって言ったってねぇ……)", "face": "u1252a1"}, {"name": "メフィスト", "text": "サメのアンデッド、いやゾンビシャークかな？\nきっとサハギンの比ではないほどの強力な麻痺毒を\n保持しているに違いない！　ああ、気になるなぁ！", "face": "u1036a1"}, {"name": "ラピス", "text": "……少しでも噛まれたら面倒だな、\nおいメフィスト、早く私の盾になれ。\nどうせお前、死んでも死なんだろう。", "face": "u832"}, {"name": "メフィスト", "text": "友人にその言い方はどうかと思うなー！", "face": "u1036a1"}, {"name": "メルアビス", "text": "(魔界組は平常運転だし……)", "face": "u1252a1"}, {"name": "アナトリア", "text": "はっはー！　歯応えがありそうじゃないか！\nいいねぇ、食い散らかしてやろうじゃないかい！", "face": "u1250a1"}, {"name": "ジークリンデ", "text": "まあ待て、食べやすいよう私が三枚におろしてやる。", "face": "u1024a1"}, {"name": "メルアビス", "text": "やめときなさい、お腹壊すわよ。", "face": "u1252a1"}, {"name": "メルアビス", "text": "(アナトリアとジークはいつも頼もし過ぎるし、\nアタシはアンデッドなんてもう見慣れちゃって、\n正直この程度じゃ怯えるフリもできないわね……)", "face": "u1252a1"}, {"name": "メルアビス", "text": "まっ、王子へのアピールは後ってことで。\n今は悪いサメ退治に励むとしましょうか。", "face": "u1252a1"}]}, {"trigger": "end", "lines": [{"name": "マーガレット", "text": "ゾンビシャーク、退却していきますわ……。", "face": "u1254a1"}, {"name": "メルアビス", "text": "そっ、逃げ足の速いこと。\n引き際を誤らない程度の知能はあるみたいね。", "face": "u1252a1"}, {"name": "ミコト", "text": "ですが相当の痛手は与えました。\n多少なり回る頭を持っているのならば、\nこれ以上の手出しは無益と理解できるはず。", "face": "u834"}, {"name": "メルアビス", "text": "そうね、でもまだ油断はできないわ。\nみんなも周囲の警戒は怠らないように──", "face": "u1252a1"}, {"name": "クゥイル", "text": "──なるほど、アレイダさんにとって殿下は\n憧れのお兄さんのような存在だったのですね。\n実は私も殿下から姉と慕われていないこともなく……。", "face": "u1256a1"}, {"name": "アレイダ", "text": "え！？　それってつまりクゥイルさんは、\n私の姉ということに──クゥイルお姉様……！？", "face": "u1251a1"}, {"name": "メルアビス", "text": "……あそこは緊張感ないわねー。", "face": "u1252a1"}, {"name": "アナトリア", "text": "はっはっはっ！　まぁいいじゃないか、\nあれぐらいお気楽な方が雰囲気も明るくなる。\n戦場でも笑える余裕があるってのはいいことだよ。", "face": "u1250a1"}, {"name": "セーラ", "text": "周囲の警戒は私の方で担当しておきますので、\n皆様も少しぐらいは気を抜かれても大丈夫ですよ？", "face": "u1249a1"}, {"name": "メルアビス", "text": "……ふふっ、それもそうね。\n船の修理も終わってる頃だろうし、\nさっさと陸に上がっちゃいましょうか。", "face": "u1252a1"}, {"name": "ツキコ", "text": "………………。", "face": "u1253a1"}, {"name": "メルアビス", "text": "ツキコー？　置いてっちゃうわよー！", "face": "u1252a1"}, {"name": "ツキコ", "text": "──うん。すぐ、行くね。", "face": "u1253a1"}, {"name": "ツキコ", "text": "(まだ、なにも終わってない気がする。\nツキコたちは、嵐の目の中にいるだけ)", "face": "u1253a1"}, {"name": "ツキコ", "text": "──なのかも、ね？", "face": "u1253a1"}]}], "active": true}