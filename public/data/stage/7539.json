er_id": 34621, "global_id": 8238, "ranged": true, "to_global_id": 8239, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 111}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["帝国"], "hp": 18000, "attack": 600, "base_hp": 18000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "magic_defense": 10, "attack_range": 240, "attack_speed": 90, "attack_wait": 30, "attack_interval": 121, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133120, "race_id": 16, "change_to": 14, "missile_id": 26, "master_id": 34622, "global_id": 8239, "ranged": true}, {"enemy_id": 17, "source": "local", "count": 6, "form_count": 1, "tags": ["帝国"], "hp": 20000, "attack": 450, "base_hp": 20000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130064, "race_id": 16, "master_id": 34058, "global_id": 7675, "spawn_sec": 145}, {"enemy_id": 18, "source": "local", "count": 10, "form_count": 1, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "spawn_sec": 173}], "popups": ["このミッションでは、\n飛空戦艦は拠点に進行し、\n撃破数にカウントされます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レオナ", "text": "――総員、迎撃準備！\nこの橋でベラートの兵を止める！", "face": "u311"}, {"name": "マルゴット", "text": "飛空戦艦も雪山を超えてきます。\nここからは総力戦ですよ！", "face": "u1343a1"}, {"name": "ディアナ", "text": "……まだベラート伯爵が\n姿を見せないのが気がかりですが。", "face": "u624"}, {"name": "マルゴット", "text": "確かに……。\nあの伯爵であれば、\n真っ先に名乗りをあげそうなものですよね。", "face": "u1343a1"}, {"name": "ディアナ", "text": "指揮官は後方に控える、\nということを覚えたのかもしれません。", "face": "u624"}, {"name": "マルゴット", "text": "……ふふっ、御冗談を。\nですが、少し緊張が解れました。\nこちら側の指揮官にも教えてあげたいですね。", "face": "u1343a1"}, {"name": "ディアナ", "text": "まったくです。\nとはいえ、あの背中を見ているからこそ、\n兵たちが奮い立つというのもまた事実。", "face": "u624"}, {"name": "ディアナ", "text": "マルゴット、彼らの戦い方を見ておきなさい。\nきっといつか、あなたの剣に役立つはずですよ。", "face": "u624"}, {"name": "マルゴット", "text": "はっ！　ディアナ様！\n――それでは、ベラート伯爵の兵を迎え撃つとしましょうか。", "face": "u1343a1"}]}, {"trigger": "end", "lines": [{"name": "サザンカ", "text": "……撃退した、というより――", "face": "u1347a1"}, {"name": "マレブランケ", "text": "――態勢を整えるため、あえて撤退した、\nといったところかな、あちらの部隊は。", "face": "u1225a1"}, {"name": "マルゴット", "text": "敵が飛空艦隊を持ち出した以上、\nこちらは常に後手に回ることになります。\nこちらにも、航空戦力があれば……。", "face": "u1343a1"}, {"name": "マレブランケ", "text": "仕方あるまい。\n艦隊は別の襲撃地点に急行中だ。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "航空艦隊の移動力が必要な地点への同時攻撃。\n今回は完全に、冥界軍の手のひらの上だということさ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "もう一箇所の襲撃地点……。\nあちらも無事だと良いんだけど……。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "まぁ、不安がっていても仕方がない。\n今は背後の街を守ることに集中しよう。\n美しき乙女たちの友情を守るためにもね！", "face": "u1225a1"}, {"name": "レーネ", "text": "……うつくしき、おとめ？", "face": "u1432a1"}, {"name": "マルレーン", "text": "……アタシのことかな！", "face": "u1434a1"}, {"name": "レーネ", "text": "マルレーンはどっちかっていうと、\n美しいっていうより、かわいいの方じゃない？", "face": "u1432a1"}, {"name": "マルレーン", "text": "むっ……童顔って言いたいのかー！？", "face": "u1434a1"}, {"name": "マレブランケ", "text": "こらこら、喧嘩は戦闘が終わってからだよレディたち。\nさぁ、襲撃が止まった今の内だ！\n急いで補給を済ませるぞ！", "face": "u1225a1"}]}], "active": true}