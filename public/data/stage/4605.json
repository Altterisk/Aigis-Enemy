{"quest_id": 4605, "name": "レッサーオーク", "description": "オークの群れを打ち破り、\nジャングルの奥地へと急げ！\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "帝国猟兵とオークの勇者", "event_category": "History", "mission_id": 920069, "map_no": 3704, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 34, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 1, "change_condition": 3, "master_id": 800, "global_id": 799, "to_condition": 3, "to_global_id": 800, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 500, "base_hp": 1200, "base_attack": 500, "damage_type": "physical", "armor_defense": 130, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 7}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 34}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102224, "race_id": 8, "change_to": 5, "change_condition": 3, "master_id": 366, "global_id": 365, "to_condition": 3, "to_global_id": 366, "spawn_sec": 77}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "physical", "armor_defense": 450, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102240, "race_id": 8, "master_id": 367, "global_id": 366, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "ルナール", "text": "確かこの方角に\nレーゼルは進んでいったはずだけど……。\n一向に見当たらないなぁ。", "face": "u300"}, {"name": "ユリアン", "text": "それにしても帝国軍ってのは薄情だぜ。\n仲間ひとり置き去りにして\nみんな逃げ出しちまうんだもんな。", "face": "u7"}, {"name": "ルナール", "text": "薄情？　何てこというんだよ！\n帝国の兵達は部隊が壊滅する寸前まで\nジャングルの為に戦ってくれたんだよ！", "face": "u300"}, {"name": "ユリアン", "text": "……わ、悪かったよ。\nそうとは知らず、軽口を叩いちまった……。", "face": "u7"}, {"name": "兵士", "text": "報告！\n前方に魔物の姿を確認！\n警戒してください！", "face": "lfcf030e255fb"}, {"name": "オーク", "text": "――おぉ？　まだ人間が残っていたか！\nこのあたりにはもう人間は残っていないと\n思っていたが、これは幸運だ！", "face": "l1b60b704868b"}, {"name": "ユリアン", "text": "ようやく現れたな、オーク共め……。\n帝国兵が命を削ってまで戦ったっていうなら、\n俺もそれに恥じない戦いをさせてもらうぜ！", "face": "u7"}, {"name": "アンナ", "text": "王子、私達もユリアンさんに続きましょう！\n戦いの準備をお願いします！", "face": "l878f496a6c7b"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "王子、オークが撤退していきます。\nやりましたね。"}, {"name": "ダナン", "text": "――王子！\n勝利を喜んでる余裕はないぞ！\nすぐに進軍を再開するんだ！", "face": "u299"}, {"name": "アンナ", "text": "どうしたのですか、ダナンさん？", "face": "l878f496a6c7b"}, {"name": "ダナン", "text": "この先にある村を\nオークの軍団が襲撃してるようなんだ！\n頼む、急いでくれ！", "face": "u299"}, {"name": "アンナ", "text": "それはまずいですね。\n王子、すぐに村へ向かいましょう！", "face": "l878f496a6c7b"}]}], "active": true}