{"quest_id": 7467, "name": "砂漠の薔薇", "description": "王子軍の不在を狙い神獣が砂漠の国へ侵攻。\n絶体絶命の危機に一人の英傑が目覚める。\n＜出撃時の初期HP減少：小＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["出撃時の初期HP減少：小"], "event": "未来へ架ける橋", "event_category": "History", "mission_id": 920168, "map_no": 5996, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 1, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{"wait": 900}]}, "spawn_sec": 32}, {"enemy_id": 2, "source": "local", "count": 24, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 40}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 40000, "attack": 1000, "base_hp": 40000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 10, "attack_range": 200, "attack_speed": 60, "attack_wait": 45, "attack_interval": 221, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "pattern_id": 2112736, "special_effect_id": 242, "missile_id": 239, "master_id": 34178, "global_id": 7795, "ranged": true, "route_behaviour": {"calls_event":