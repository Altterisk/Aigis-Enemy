 "attack_interval": 66, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2117536, "race_id": 15, "special_effect_id": 86, "change_to": 20, "master_id": 31565, "global_id": 5184, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 169}, {"enemy_id": 22, "source": "local", "count": 2, "level": 80, "form_count": 1, "tags": ["アンデッド"], "hp": 24000, "attack": 900, "base_hp": 24000, "base_attack": 900, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_range": 400, "attack_speed": 20, "attack_wait": 20, "attack_interval": 119, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2117584, "race_id": 15, "special_effect_id": 355, "missile_id": 340, "missile": {"speed": 8.0}, "master_id": 31568, "global_id": 5187, "ranged": true, "spawn_sec": 195}, {"enemy_id": 23, "source": "local", "count": 10, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124160, "race_id": 20, "change_to": 23, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32915, "global_id": 6532, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6535, "spawn_sec": 210}, {"enemy_id": 23, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 800, "base_hp": 5500, "base_attack": 800, "damage_type": "true", "armor_defense": 600, "magic_defense": 15, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124176, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32918, "global_id": 6535, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 27, "source": "local", "count": 3, "level": 80, "form_count": 1, "tags": ["アーマー", "アンデッド"], "hp": 65000, "attack": 6000, "base_hp": 65000, "base_attack": 6000, "damage_type": "physical", "armor_defense": 3000, "attack_speed": 20, "attack_wait": 70, "attack_interval": 291, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "transform_resist": 1, "pattern_id": 2117552, "race_id": 15, "special_effect_id": 86, "master_id": 31566, "global_id": 5185, "spawn_sec": 226}], "popups": ["\n\n\n　 　――その頃、砂漠の国", "癒し手の姿をした\nエインヘリヤル(分身体)がいる間は、\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――その頃、砂漠の国"}, {"name": "ホルエス", "text": "……スフィンクスに、エインヘリヤル。\n王国軍の不在を狙った世界各地の同時侵攻ですか。", "face": "u149"}, {"name": "ネフティ", "text": "砂漠の民の心は折れていません。\nたとえ神獣が相手だろうと、最後まで戦い抜きますとも。", "face": "u551"}, {"name": "ホルエス", "text": "……民に、死ぬまで戦えと命令しろ、と？", "face": "u149"}, {"name": "ネフティ", "text": "いえ、我らは戦士です。\nそれに、死ぬつもりも、負けるつもりもありません。", "face": "u551"}, {"name": "ホルエス", "text": "ふふっ、そうでしたね。\n先程の弱音は忘れてください。", "face": "u149"}, {"name": "ハシム", "text": "何、一匹も通さなけりゃいいんだ。\n王国ができたことを、\n砂漠の国ができないって道理はない。", "face": "u170"}, {"name": "ザラーム", "text": "然り！\n背負うものは民の命と国家の誇り。\nここで折れては、先祖に顔向けができぬ！", "face": "u175"}, {"name": "ホルエス", "text": "――ならば、剣をとりなさい！\n砂漠の民よ！　偉大なる砂漠の薔薇に連なる者たちよ！", "face": "u149"}, {"name": "ホルエス", "text": "これは、祖国を守護する戦いです！\n家族を、誇りを、歴史を守る力は、\n今この瞬間の、私たちの手にあります！", "face": "u149"}]}, {"trigger": "end", "lines": [{"name": "ホルテウス", "text": "――千年、か。\n存外長く眠ってしまったな。", "face": "u1372a1"}, {"name": "ホルエス", "text": "本当に、ホルテウス様なのですか……？\n伝説では行方不明になったと……。", "face": "u149"}, {"name": "ホルテウス", "text": "正確には、神獣スフィンクスを封印するために、\n千年分の魔力を注がねばならなかった、だな。", "face": "u1372a1"}, {"name": "ホルテウス", "text": "しかし、どうやら間に合ったようだ。\n砂漠の民の意志、我が心に届いたぞ。", "face": "u1372a1"}, {"name": "ホルエス", "text": "ありがとうございました。\nおかげで、砂漠の民は守られ――", "face": "u149"}, {"name": "ホルテウス", "text": "頭を下げるでない。\n汝と我は同格、共に王族なのだから。", "face": "u1372a1"}, {"name": "ホルテウス", "text": "さて、目覚めたからには、\n英雄王との約束を果たさねばならぬが……。\nホルエス、英雄王の国はまだあるか？", "face": "u1372a1"}, {"name": "ホルエス", "text": "は、はい！\nえぇと、王国へ向かうのですか……？", "face": "u149"}, {"name": "ホルテウス", "text": "うむ。目が覚めたら、\n子孫の様子をみてやってほしいと言われていてな。", "face": "u1372a1"}, {"name": "ホルテウス", "text": "さぁ、行くぞスフィンクス！\n千年後の世界、この目でしかと見極めよう！", "face": "u1372a1"}]}, {"trigger": "route", "enemy_ids": [3], "lines": [{"name": "？？？", "text": "――震える声で、震える膝で、\n心細く、己を信じ切ることができず、\n民が傷つくことを怖れる、優しき者よ。", "face": "u1372a1"}, {"name": "天使", "text": "なっ……神獣スフィンクスが、制御を離れた……！？", "face": "l33c3845a29e4"}, {"name": "？？？", "text": "怖かろう、今すぐにでも逃げ出したいだろう。\nだが、それでも、よくぞ言った。", "face": "u1372a1"}, {"name": "ホルエス", "text": "あな、たは……？", "face": "u149"}, {"name": "？？？", "text": "長らく待たせてしまった。\n神獣の封印に、千年分の魔力を注いでしまったからな。", "face": "u1372a1"}, {"name": "？？？", "text": "天使ども、神獣とは神の兵器だ。\nそしてスフィンクスは、砂漠の民のため、\n神より授かった我が神器である。", "face": "u1372a1"}, {"name": "？？？", "text": "我が愛しき子孫たちを怯えさせ、\n我がスフィンクスを盗んだ罪は、万死に値する。", "face": "u1372a1"}, {"name": "ホルエス", "text": "砂漠の薔薇、至高の美、砂漠の国の最初の女王……。\nあなたは……っ、ホルテウスさま……っ！？", "face": "u149"}, {"name": "ホルテウス", "text": "我が名を継ぐ当代の女王よ、\n重ねて言おう――長らく待たせたな。", "face": "u1372a1"}, {"name": "ホルテウス", "text": "もはや神獣スフィンクスは我らの守護獣なり。\nホルエスよ、これより砂漠の国の戦を見せるぞ。", "face": "u1372a1"}, {"name": "ホルエス", "text": "はい……っ！！\n砂漠の民よ、私たちの戦いを天使に見せてやりなさい！！", "face": "u149"}]}], "active": true}