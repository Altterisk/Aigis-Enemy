in_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 11, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 112}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "売人", "text": "ああもぉッ！　アイツらどこまで追いかけてくるんだ！？\n絶対、捕まるわけにはいかないのに！", "face": "l0dd435fdd151"}, {"name": "売人", "text": "仕方ない、高値で売れるのは分かってるけど、\nこの重たい武器は置いていくしかないな。\n……くっそぉ、とんだ損失だよ、まったく。", "face": "l0dd435fdd151"}]}, {"trigger": "start", "lines": [{"name": "オーク", "text": "――むッ！？　何だこの武器は……？\nほう、なかなか手に馴染むではないか！\nまるで武器が強き者に持たれ、喜んでいるようだ。", "face": "lfa7dc50946a5"}, {"name": "エイミー", "text": "はぁ……はぁ……。\n何て逃げ足の速い売人なの……。", "face": "u414"}, {"name": "オーク", "text": "……何だ貴様らは？", "face": "lfa7dc50946a5"}, {"name": "エイミー", "text": "え……？　どうしてこんなところにオークが？\n――って、あああッ！？\nそれ、私の「呪いの武器」です！", "face": "u414"}, {"name": "ソーマ", "text": "オークさん、お願いですからその武器を返して下さい。\nその武器は呪われています！\n高額で買い取りも行っていますよ！", "face": "u23"}, {"name": "オーク", "text": "……それは出来ぬな。\nこの武器は強き者に使われる事を望んでいる。", "face": "lfa7dc50946a5"}, {"name": "オーク", "text": "貴様の様な拝金の輩の許ではなく、\n我らの様な戦士と共にありたいとな。", "face": "lfa7dc50946a5"}, {"name": "ソーマ", "text": "そ、そんなぁ。\nやっぱりオークさんとは戦いになってしまうのですね……。", "face": "u23"}]}, {"trigger": "end", "lines": [{"name": "オーク", "text": "ふむ……どうやらこちらの誤解だったようだな。\n非礼を詫びよう。この武器も、しかと返還する。\nもう手放したりしないようにな。", "face": "lfa7dc50946a5"}, {"name": "エイミー", "text": "あ、ありがとうございます……。\n（うわ、けっこうボロボロになってるぅ……）", "face": "u414"}, {"name": "エイミー", "text": "あ、あの！\nこれは少しばかりですがお礼のゴールドです！\n拾って頂いたわけですし。", "face": "u414"}, {"name": "オーク", "text": "そんな物はいらん。\nオレはゴールドに興味などない。", "face": "lfa7dc50946a5"}, {"name": "エイミー", "text": "む、無欲……！", "face": "u414"}, {"name": "オーク", "text": "王子、其方との再戦を楽しみにしている。\n今日のオレは心なしか本調子を出せなかったしな。\n……それでは、さらばだ！", "face": "lfa7dc50946a5"}, {"name": "ソーマ", "text": "えぇー！　次もまた戦うつもりなんですね……。", "face": "u23"}, {"name": "アンナ", "text": "何はともあれ、\n「呪いの武器」を取り戻せて良かったです。"}, {"name": "エイミー", "text": "ですが、依然として闇ギルドの残党については\n詳しいことは分かっていません……。", "face": "u414"}, {"name": "エイミー", "text": "まだ売人は近くにいるはずです。\n王子、引き続き先ほどの売人を探しましょう！", "face": "u414"}]}], "active": true}