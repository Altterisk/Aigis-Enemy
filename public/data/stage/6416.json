se_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112832, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30726, "global_id": 4345, "ranged": true, "spawn_sec": 148}], "dialogue": [{"trigger": "start", "lines": [{"name": "マオ", "text": "ここが神仙郷……。\n確かに清らかな気の流れを感じますね。", "face": "u361"}, {"name": "兵士", "text": "――報告！　前方より敵部隊が接近中！", "face": "u6"}, {"name": "アンナ", "text": "あれは――！", "face": "l9cb6e8886bd9"}, {"name": "狛天君", "text": "ほう、貴様らはいつぞやの王子らか。\nどんなヤツが来るかと思い、楽しみにしていたが。", "face": "la5d351b64f96"}, {"name": "仙人", "text": "狛天君……爆炎を操る十天君きっての猛将が、\n神仙郷防衛の主将というわけですか？", "face": "u603"}, {"name": "狛天君", "text": "――ん？　\nそういう貴様は、もしや……。　", "face": "la5d351b64f96"}, {"name": "狛天君", "text": "……うむ、やはりそうか！\nヌハハハハハッ！　思わぬ大物が釣れたものだ！", "face": "la5d351b64f96"}, {"name": "アンナ", "text": "（大物？\n仙人様は確か、自分は名もなき仙人だと……）", "face": "l9cb6e8886bd9"}, {"name": "狛天君", "text": "さぁ、攻めてくるがいい。\n神仙郷をワシらの手から解放したいのだろう？", "face": "la5d351b64f96"}, {"name": "狛天君", "text": "無論、そうなれば返り討ちにするつもりだがな。\nここで貴様らを討てばワシも功徳を積めるというものだ。\nヌハッ、ヌハハッハハハハッ！！", "face": "la5d351b64f96"}, {"name": "フューネス", "text": "……あいつ……うるさい。\n敵……倒す……いいか？", "face": "u15"}, {"name": "仙人", "text": "…………。", "face": "u603"}, {"name": "フューネス", "text": "…………？", "face": "u15"}, {"name": "狛天君", "text": "ヌハハッ！　どうした、臆したか？\nならばこちらから行かせてもらうぞ！", "face": "la5d351b64f96"}]}, {"trigger": "end", "lines": [{"name": "フューネス", "text": "……もう、おわりか？\nおまえ……大したことないな。", "face": "u15"}, {"name": "狛天君", "text": "……フフッ。\nフハッ、ヌハハハハハッ！！", "face": "la5d351b64f96"}, {"name": "アンナ", "text": "な、なにがおかしいのですか？", "face": "l9cb6e8886bd9"}, {"name": "狛天君", "text": "ヌフフ……馬鹿め。\nここでのワシの敗北もヤツの計画のうちよ。", "face": "la5d351b64f96"}, {"name": "ケイティ", "text": "計画？　なにを言って――", "face": "u114"}, {"name": "バシラ", "text": "――って、あれ……？\nなんか私たち……いつの間にか敵に囲まれてません？", "face": "u28"}, {"name": "ケイティ", "text": "――ッ！？\nそんな……いつの間に背後に敵兵が？", "face": "u114"}, {"name": "迅天君", "text": "――ヒューッ、流石は狛天のアニキだ！\n強いだけじゃなく演技も得意だったとはねぇ！", "face": "l80b2a8cce4eb"}, {"name": "アンナ", "text": "なッ――貴方は！", "face": "l9cb6e8886bd9"}, {"name": "狛天君", "text": "フン……誰が兄貴だ。\nとにかく、包囲完成までの時間は稼いでやったぞ。\nあとは上手くやるんだな。", "face": "la5d351b64f96"}, {"name": "迅天君", "text": "ああ、任せてくれ。\n網にかかった獲物くらい、秒で捌いてやるさ。", "face": "l80b2a8cce4eb"}, {"name": "仙人", "text": "…………。", "face": "u603"}]}], "map": {"image": "Map920105_5313", "w": 960, "h": 640, "spots": [{"k": "b", "x": 492, "y": 23}, {"k": "m", "x": 695, "y": 137, "id": 200}, {"k": "m", "x": 284, "y": 147, "id": 201}, {"k": "m", "x": 194, "y": 306, "id": 202}, {"k": "m", "x": 581, "y": 448, "id": 203}, {"k": "m", "x": 812, "y": 275, "id": 204}, {"k": "m", "x": 464, "y": 449, "id": 205}, {"k": "m", "x": 761, "y": 478, "id": 206}, {"k": "m", "x": 244, "y": 468, "id": 207}, {"k": "m", "x": 236, "y": 223, "id": 208}, {"k": "m", "x": 110, "y": 367, "id": 209}, {"k": "m", "x": 277, "y": 365, "id": 210}, {"k": "m", "x": 757, "y": 204, "id": 211}, {"k": "m", "x": 756, "y": 341, "id": 212}, {"k": "m", "x": 684, "y": 408, "id": 213}, {"k": "m", "x": 347, "y": 439, "id": 214}, {"k": "m", "x": 121, "y": 466, "id": 215}, {"k": "m", "x": 604, "y": 170, "id": 216}, {"k": "m", "x": 395, "y": 176, "id": 217}, {"k": "m", "x": 491, "y": 147, "id": 218}, {"k": "r", "x": 137, "y": 213, "id": 300}, {"k": "r", "x": 181, "y": 411, "id": 301}, {"k": "r", "x": 334, "y": 250, "id": 302}, {"k": "r", "x": 445, "y": 323, "id": 303}, {"k": "r", "x": 548, "y": 247, "id": 304}, {"k": "r", "x": 669, "y": 311, "id": 305}, {"k": "r", "x": 842, "y": 409, "id": 306}]}, "start_cost": 10, "active": true, "name_en": "Blazing Inferno in the Immortal Realm", "description_en": "Awaiting them in the Immortal Realm is Komaten, an Evil Sage who manipulates flames using the treasure \"Blazing Formation.\" Win this intense battle! Extreme (★1 acq