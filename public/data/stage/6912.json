}, "master_id": 444, "global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "spawn_sec": 268}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}, {"enemy_id": 24, "source": "local", "count": 4, "level": 8, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 271}, {"enemy_id": 25, "source": "local", "count": 2, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102640, "race_id": 8, "change_to": 25, "change_condition": 3, "master_id": 383, "global_id": 382, "to_condition": 3, "to_global_id": 383, "spawn_sec": 295}, {"enemy_id": 25, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 450, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102656, "race_id": 8, "master_id": 384, "global_id": 383, "from_condition": 3}, {"enemy_id": 27, "source": "local", "count": 2, "form_count": 2, "hp": 25000, "attack": 2500, "base_hp": 25000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102928, "race_id": 8, "change_to": 27, "change_condition": 3, "master_id": 405, "global_id": 404, "to_condition": 3, "to_global_id": 405, "spawn_sec": 301}, {"enemy_id": 27, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 25000, "attack": 2500, "base_hp": 25000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 20, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102944, "race_id": 8, "master_id": 406, "global_id": 405, "from_condition": 3}], "popups": ["魔王は特定のタイミングまで\nあらゆる攻撃を受け付けません。\n\n防御、魔法耐性を無視した\n非常に強力な遠距離攻撃を行います。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。", "光を放つマスに配置したユニットは\n束ねられた女神の力により\nHP、攻撃、防御、魔法耐性が\n大幅に上昇します。", "オーク旗手がいる間は\n敵のオークの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "魔王ガリウス", "text": "――来たのか。\n無駄なあがきをするものだ。", "face": "ld52e97de0357"}, {"name": "ソラス", "text": "無駄ではありません。\n魔王よ、千年戦争を終わらせる時です。", "face": "u904"}, {"name": "魔王ガリウス", "text": "……神殺しの聖槍、か。\n無粋なものを持ち出すものだ……。", "face": "ld52e97de0357"}, {"name": "魔王ガリウス", "text": "定命の者よ、物質界に蔓延る人の王子よ。\nお前の願いは、決して届くことはない。", "face": "ld52e97de0357"}, {"name": "ユージェン", "text": "どういうことだ。\n一体何を言って――", "face": "u906"}, {"name": "フローガ", "text": "――ッ！　お、王子殿下っ！\n白の帝国との通信魔法が途絶えました！", "face": "u878"}, {"name": "アトナテス", "text": "てめぇ、知ってやがったな……？\n俺達を嘲笑うために見過ごしてたってのか。", "face": "u908"}, {"name": "サナラ", "text": "……な、なに思いつめた顔してるんですか！\n元から可能性の低い作戦だったんですよ！", "face": "u921"}, {"name": "サナラ", "text": "いまさら鍵が一個無くなったからって何ですか！\nそう言って私に、皆に力を与えたのは、\n王子！　あなたじゃないですか！", "face": "u921"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "サナラ", "text": "そうそう、その顔です！\n白の皇帝は必ず来ます。\nそれまでに、私達ができることをしましょう！", "face": "u921"}, {"name": "依り代の少女", "text": "――えぇ。そうでした。\n王子様は、決して諦めない方。\nだから私は、ここに来たのですから。", "face": "l42263541b037"}, {"name": "依り代の少女", "text": "サナラさん、始めましょう。\n私達に出来ることを、私達にしかできないことを。", "face": "l42263541b037"}, {"name": "サナラ", "text": "えぇ！　もちろんです！\n――あまねくこの星の全てよ、\n大地を紡ぐサナラの声に応えよ……！！", "face": "u921"}, {"name": "依り代の少女", "text": "――アイギス様、アダマス様、\n私の声にお応えください……。", "face": "l42263541b037"}, {"name": "魔王ガリウス", "text": "ほう……地脈を束ねるその術、見覚えがある。\nあの時、あの男と共に予に抗った者のひとりか。", "face": "ld52e97de0357"}, {"name": "魔王ガリウス", "text": "だが、たかが大地の気の流れに、\n女神どもの力を注いだとて、\n予に傷ひとつ付けることはできまい。", "face": "ld52e97de0357"}, {"name": "魔王ガリウス", "text": "思い上がった人の子らよ、\nここでお前達の歴史を終わらせてやろう。", "face": "ld52e97de0357"}, {"name": "アンナ", "text": "……王子、魔王ガリウスが来ます。\n必ず、勝機はあるはずです。\nどうか、どうかご武運を……！！", "face": "l34498d378b43"}]}, {"trigger": "end", "lines": [{"name": "サナラ", "text": "――魔王ガリウスの魔力が、崩壊していきます！！", "face": "u921"}, {"name": "アトナテス", "text": "今度は封印なんて半端なものじゃない。\n真の滅びってやつだ、魂まで砕けちまえ！", "face": "u908"}, {"name": "ユージェン", "text": "ようやく、終わったんだな……。\nさぁ王子、皆に言うことがあるんじゃないか？", "face": "u906"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "アリシア", "text": "ふふっ、皆さん、\n王子の勝利宣言を待っているんですよ。", "face": "u372"}, {"name": "アンナ", "text": "王子、千年戦争の終結を。\n魔王ガリウスとの長き戦いの終わりを伝えてください。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "王子", "text": "――長い、長い戦いだった。\n英雄王の時代から続いた魔王との戦いは、\n今ここで、俺達自身の手で終わりを遂げた。", "face": "u1"}, {"name": "王子", "text": "――誓いは果たした。\n俺たちの、勝利だ。", "face": "u1"}, {"name": "ソーマ", "text": "うぅっ……ぐすっ……。\nやりました！　魔王を倒しましたぁ！", "face": "u23"}, {"name": "アリサ", "text": "やっと……やっと終わったんですね。\n魔王との戦いが、ようやく……！", "face": "u24"}, {"name": "クレイブ", "text": "……長く世界を蝕み続けた魔王という暗闇を、\n王子という輝きが、打ち払ったのですね。", "face": "u8"}, {"name": "ユリアン", "text": "おいおい、クレイブさん泣いてんのか？\n今は笑って喜ぶところだぜ！", "face": "u7"}, {"name": "モーティマ", "text": "しみったれた顔してんじゃねぇよ。\nおら、派手に凱旋して勝利を伝えてやろうぜ！", "face": "u14"}, {"name": "エレイン", "text": "そうよ、世界中で戦っていた仲間に、\nちゃんと勝ったぞって報告しなくちゃ！", "face": "u36"}, {"name": "アイギス", "text": "――王子よ、そして人の子らよ。\nこれより先は、人の力で歩んでいくのですよ。", "face": "l2c5636d542dc"}, {"name": "アダマス", "text": "私達は力を使い果たしてしまいましたから、\nもう、こうして力を貸すことは難しくなるでしょう。", "face": "l11587cc510b4"}, {"name": "アイギス", "text": "ですが、あなた達ならば、\nきっとその手で未来を切り拓いて行けるはずです。", "face": "l2c5636d542dc"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "……王子、きっと世界中の皆さんが、\n王子の言葉を待っているはずです。"}, {"name": "アンナ", "text": "さぁ、王国へ帰還しましょう！！"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "魔王ガリウス", "text": "――なるほど、これまでとは違うようだ。\nならば予の次なる姿を見せてやろう。", "face": "ld52e97de0357"}, {"name": "魔王ガリウス", "text": "人の身で、神にして魔王たる予の力に、\nどこまで付いてこられるか、抗ってみせろ。", "face": "ld52e97de0357"}, {"name": "ソラス", "text": "この魔力の波動……くっ……！\n王子君、今の魔王に魔法は殆ど効きません！\nおびただしい魔力が放出され続けています！", "face": "u904"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "魔王ガリウス", "text": "ハハハハハハハハッ！！\nそうか！　予に匹敵するか！！", "face": "l0465a630b658"}, {"name": "魔王ガリウス", "text": "よかろう、予の真なる姿を見ることを許す！\nお前達の力の全て、出し尽くしてみせよ！！", "face": "l0465a630b658"}, {"name": "依り代の少女", "text": "くっ……ぁあぁッ！！\nこのままでは、女神様達の力を維持できません……っ！", "face": "l42263541b037"}, {"name": "ケラウノス", "text": "（……かつて私の器だった者が、\n弱音を吐くことは許しませんよ）", "face": "l42263541b037"}, {"name": "アダマス", "text": "……えっ？　姉、様？", "face": "l11587cc510b4"}, {"name": "ケラウノス", "text": "（もはや世界の行く末に興味などありません。\nけれど、私の力を一度は宿したものが、\nガリウスに敗れることだけは許しません）", "face": "l42263541b037"}, {"name": "ケラウノス", "text": "（――我が力、最後のひとかけらまで持っていきなさい）", "face": "l42263541b037"}, {"name": "サナラ", "text": "…………！？\n地脈が安定しました！\nすごい……これが三女神の力……！！", "face": "u921"}, {"name": "アイギス", "text": "王子よ、諦めることなく、剣を掲げ続けた者よ。\n三女神全ての力を、あなたに委ねます。", "face": "l2c5636d542dc"}, {"name": "アイギス", "text": "神無き世界を、人の力で、\n神々を打ち破り進むのです、人の子よ。", "face": "l2c5636d542dc"}, {"name": "王子", "text": "……魔王ガリウス、お前がもたらした悲劇の果てに、\n俺は幾度も、お前を倒すと誓い続けた。", "face": "u1"}, {"name": "王子", "text": "――誓いを、果たす時が来た。", "face": "u1"}, {"name": "魔王ガリウス", "text": "やってみせるがいい！　矮小なる人の子よ！\nその手がここまで届くのか、\n全存在を賭けてかかってこい……！！", "face": "l0465a630b658"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "魔王ガリウス", "text": "……あ、ああ……予の、魂が……。\n予の力の形が……崩れ、壊れていく……。", "face": "l0465a630b658"}, {"name": "魔王ガリウス", "text": "これが……これが人の力だと……？\nあの男ですら……予には届かなかったというのに……。", "face": "l0465a630b658"}, {"name": "魔王ガリウス", "text": "答えよ、お前は、何者なのだ……。", "face": "l0465a630b658"}, {"name": "王子", "text": "……王国の、王子だ。\nただ仲間と共に、歩み続ける者だ。", "face": "u1"}, {"name": "魔王ガリウス", "text": "そう……か……。\n王子よ……もう二度と逢うことはないだろうが、\nお前のことは……決して、忘れまい……。", "face": "l0465a630b658"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "白の皇帝", "text": "――まったく、世話が焼ける。\nまさか飛空船が圧潰するとは思わなかったぞ。", "face": "u418"}, {"name": "アンナ", "text": "白の皇帝……！\n無事だったのですね……！"}, {"name": "白の皇帝", "text": "後はお前の仕事だ、王子。\n聖槍を振るうのも、\n世界を救うのも、俺には荷が重すぎる。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ソラス", "text": "…………。\nこれは……この槍では……。", "face": "u904"}, {"name": "アトナテス", "text": "どうしたソラス、早くその槍を王子に渡せ！", "face": "u908"}, {"name": "ソラス", "text": "駄目なんです！\nこの聖槍に残された力だけでは、\n魔王ガリウスの障壁には届きません！！", "face": "u904"}, {"name": "アンナ", "text": "そんな……。\n何か、何か打つ手は……。", "face": "le2d021f3964e"}, {"name": "気弱な魔物", "text": "――ギャギャ！\nウツテ！　アル！　ウツテ！　アル！！", "face": "lec11385ef99a"}, {"name": "冒険者", "text": "だぁぁぁああぁぁぁッ！！\nポーションがもう無いぞ！\n飲み尽くしちまったぞ！！", "face": "la236f17dc140"}, {"name": "アリシア", "text": "あ、あなた方は！？\nどうしてこんな所まで……！", "face": "u372"}, {"name": "冒険者", "text": "持ってきてやったんだよ！\n物質界中から！　ありったけの力ってやつをよ！\n俺達の冒険の成果を喰らいやがれ！", "face": "la236f17dc140"}, {"name": "気弱な魔物", "text": "ギャギャ！　常闇ノ聖霊モ！\nチカラ！　カシテクレタ！", "face": "lec11385ef99a"}, {"name": "ポーラ", "text": "こんな貴重なものを……って、\n癒しの至宝まで入ってるです。\nこっそりくすねてたですか。", "face": "u253"}, {"name": "冒険者", "text": "おかげで世界の危機を救う足しになるだろう？\nおっと、それから、\nもうひとり王子に会いたいって奴を護衛してきたぜ。", "face": "la236f17dc140"}, {"name": "ダークアンナ", "text": "…………お久しぶりです。", "face": "u776"}, {"name": "ダークアンナ", "text": "言葉を重ねるつもりはありません。\nただ、あの御方より言伝を預かっております。", "face": "u776"}, {"name": "ダークアンナ", "text": "『眩く輝く、蒼空と、緑に満ちた世界を、\n俺が憧れたこの世界を、失うことは決して許さない』\n――以上です。意味は、お分かりですね？", "face": "u776"}, {"name": "ソーマ", "text": "…………！！\nダーク王子さんの剣から、聖槍に光が……！", "face": "u23"}, {"name": "アンナ", "text": "王子、勝ちましょう。\nこの世界の皆が、力を貸してくれています……！！"}, {"name": "王子", "text": "――ああ。\nこの聖槍には、今やこの世界全ての願いが宿っている。", "face": "u1"}, {"name": "王子", "text": "魔王ガリウスよ、お前を守る盾は、\nこの世界の願いによって砕かれる……！！", "face": "u1"}, {"name": "魔王ガリウス", "text": "――ぐぅ……ッ！？\n……ほう、予の障壁を消滅させたか……！", "face": "ld52e97de0357"}, {"name": "魔王ガリウス", "text": "良いだろう。\nようやくこの世界に興味がわいた。\n予が自ら、お前達の相手をしてやろう……！！", "face": "ld52e97de0357"}, {"name": "アンナ", "text": "王子、魔王ガリウスの障壁が破られました！\nここで、全ての戦いを終わらせましょう！", "face": "l34498d378b43"}]}], "active": true}