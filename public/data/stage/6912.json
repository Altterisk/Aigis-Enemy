{"quest_id": 6912, "name": "この世界、全ての願い", "description": "世界に生きるもの全ての願い。\n希望を胸に英雄は、仲間と共に──\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "英雄王を継ぐ者", "event_category": "History", "mission_id": 920186, "map_no": 5122, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 4, "hp": 150000, "attack": 30000, "base_hp": 150000, "base_attack": 30000, "damage_type": "true", "armor_defense": 1000, "magic_defense": 60, "attack_range": 140, "attack_speed": 120, "attack_wait": 30, "attack_interval": 157, "move_speed": 250.0, "dot_rate": 1.7999999523162842, "pattern_id": 2116400, "special_effect_id": 445, "change_to": 1, "missile_id": 324, "missile": {"speed": 9.0}, "master_id": 32075, "global_id": 5694, "ranged": true, "to_global_id": 5695, "route_behaviour": {"transforms": [{"wait": 300}], "calls_event": [2209, 2210, 2211, 2212, 2213, 2214, 2215, 2216, 2217, 2218, 2219, 2220, 2221, 2222, 2223, 2224, 2225, 2226, 2227, 2228, 2229, 2230, 2231, 2232, 2233, 2234, 2235, 2236, 2237, 2238, 2239, 2240, 2241, 2242, 2243, 2244, 2245, 2246, 2247, 2248, 2249, 2250, 2251, 2252, 2253, 2254]}, "spawn_sec": 4}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "hp": 150000, "attack": 30000, "base_hp": 150000, "base_attack": 30000, "damage_type": "true", "armor_defense": 1000, "magic_defense": 60, "attack_range": 140, "attack_speed": 120, "attack_wait": 30, "attack_interval": 157, "move_speed": 250.0, "dot_rate": 1.7999999523162842, "pattern_id": 2120384, "special_effect_id": 275, "change_to": 2, "change_condition": 2, "missile_id": 324, "missile": {"speed": 9.0}, "master_id": 32076, "global_id": 5695, "ranged": true, "to_condition": 2, "to_global_id": 5696}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 1000000, "attack": 8000, "base_hp": 1000000, "base_attack": 8000, "damage_type": "true", "armor_defense": 600, "magic_defense": 100, "attack_range": 300