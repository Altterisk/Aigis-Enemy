"アンデッド"], "hp": 100000, "attack": 2500, "base_hp": 100000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_range": 50, "attack_speed": 1, "attack_wait": 90, "attack_interval": 260, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114976, "race_id": 11, "special_effect_id": 295, "missile_id": 45, "master_id": 31065, "global_id": 4684, "ranged": true}], "popups": ["凶鳥の一定範囲内のユニットは\n物理防御力が低下します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴィンセント", "text": "――凶鳥に異変が起きた、だと？", "face": "u103"}, {"name": "ヒューナ", "text": "えぇ。力が増幅しすぎちゃったみたい。\nほら、ハロウィンには死者が帰ってくるでしょ？", "face": "u627"}, {"name": "ヒューナ", "text": "凶鳥はあの辺り一帯の守護者だから、\n戻ってきた人たちの\n魂に影響されちゃったみたいなの。", "face": "u627"}, {"name": "フーリ", "text": "凶鳥さんも大変ですねぇ……。\nそれで、私たちは何をすれば良いんですか？", "face": "u174"}, {"name": "ヒューナ", "text": "凶鳥からの依頼はみっつ。\nひとつはハロウィンに乗じて現れた、\nアンデッドたちを鎮めること。", "face": "u627"}, {"name": "ヒューナ", "text": "もうひとつは、零れてしまった凶鳥の力、\n形をとってしまった分身を討伐すること。", "face": "u627"}, {"name": "ヒューナ", "text": "それから最後に、\n魔物に滅ぼされた村の人たちのために、\nお墓参りをしてあげてほしいって。", "face": "u627"}, {"name": "エリザベート", "text": "なるほどね。\nつまり私たちの専門分野ばかりってこと。", "face": "u104"}, {"name": "ルマリア", "text": "手早く討伐を終わらせて、\nお墓も綺麗にしてあげましょうね。", "face": "u343"}, {"name": "ヒューナ", "text": "そういうわけだから王子、指揮をお願いね。\nさぁ、アンデッドたちがこっちに来るわよ！", "face": "u627"}]}, {"trigger": "end", "lines": [{"name": "ヒューナ", "text": "――ふぅ、討伐完了ね。", "face": "u627"}, {"name": "ルマリア", "text": "それでは、近くの村のお墓参りに行きましょうか。", "face": "u343"}, {"name": "ヒューナ", "text": "……えぇ。そうしましょう。", "face": "u627"}, {"name": "ヴィンセント", "text": "（ヒューナ、この近くということは、\nお前の故郷の村だろう。\n無理はしていないか？）", "face": "u103"}, {"name": "ヒューナ", "text": "（ヴィンセント、あなたがそれを言う？\n大丈夫よ、私には王子と皆がついてるから）", "face": "u627"}, {"name": "ヒューナ", "text": "（こんなに素敵な仲間ができたよって、\n魔物に殺された両親に報告しなくちゃ）", "face": "u627"}, {"name": "ヴィンセント", "text": "（……そうか）", "face": "u103"}, {"name": "ヒューナ", "text": "さぁ王子、早く洞窟を出ましょ。\n帰ったら楽しいハロウィンの祝祭が待ってるわ♪", "face": "u627"}]}], "active": true}