range": 100, "attack_speed": 1, "attack_wait": 60, "attack_interval": 166, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127968, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 33581, "global_id": 7198, "ranged": true, "spawn_sec": 76}, {"enemy_id": 9, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "hp": 10, "base_hp": 10, "damage_type": "physical", "attack_speed": 1, "attack_wait": 30, "attack_interval": 72, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2141504, "race_id": 4, "change_to": 9, "change_condition": 2, "master_id": 35699, "global_id": 9316, "to_condition": 2, "to_global_id": 9317, "spawn_sec": 78}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 14000, "base_hp": 14000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 45, "attack_wait": 50, "attack_interval": 226, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2141520, "race_id": 4, "special_effect_id": 1211, "master_id": 35700, "global_id": 9317, "from_condition": 2}, {"enemy_id": 11, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 5400, "attack": 540, "base_hp": 5400, "base_attack": 540, "damage_type": "physical", "armor_defense": 210, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127952, "race_id": 16, "master_id": 33580, "global_id": 7197, "spawn_sec": 78}, {"enemy_id": 12, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 180, "base_hp": 1200, "base_attack": 180, "damage_type": "physical", "attack_speed": 40, "attack_wait": 5, "attack_interval": 91, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2133648, "race_id": 9, "master_id": 34656, "global_id": 8273, "spawn_sec": 110}], "dialogue": [{"trigger": "start", "lines": [{"name": "ホムラ", "text": "──ふぅ、ここまで逃げれば大丈夫だろ。\nったく、親父のせいでひどい目にあったぜ。", "face": "u1185a1"}, {"name": "ロヴィニア", "text": "あー、七不思議も大詰めかー。\n残り二個だっけ？　早いよねー。", "face": "u1778a1"}, {"name": "サクヤ", "text": "ええ、あと少しだからこそ、\nより気を引き締めて参りましょう。", "face": "u1774a1"}, {"name": "ホムラ", "text": "んん？　ひーふーみーよー……。", "face": "u1185a1"}, {"name": "サクヤ", "text": "さて、次は『夜の校庭を走る人体模型』ですね。", "face": "u1774a1"}, {"name": "クレア", "text": "うわぁ……ここに来て王道ですかぁ……。", "face": "u1444a1"}, {"name": "ホムラ", "text": "（……ただでさえ人体模型なんて気味悪いのに、\nましてやそれが動いてる光景なんて見たくねぇ……）", "face": "u1185a1"}, {"name": "ホムラ", "text": "（つっても今更ビビってるなんて言うのも──）", "face": "u1185a1"}]}, {"trigger": "start", "lines": [{"name": "ホムラ", "text": "キャーーーーッ！？", "face": "u1185a1"}, {"name": "ロヴィニア", "text": "おおー、ホムラらしからぬ可愛い悲鳴。", "face": "u1778a1"}, {"name": "サクヤ", "text": "これはまさしく怪奇現象！　気になります！", "face": "u1774a1"}, {"name": "クレア", "text": "こっちはちっとも動じませんね！？", "face": "u1444a1"}, {"name": "サクヤ", "text": "さあさあ、行きましょう皆さん！\n王国学園不思議倶楽部、出動です！", "face": "u1774a1"}]}, {"trigger": "end", "lines": [{"name": "ロヴィニア", "text": "あ、走る人体模型が逃げた！", "face": "u1778a1"}, {"name": "サクヤ", "text": "追いましょう、捕獲して解剖です！", "face": "u1774a1"}, {"name": "ホムラ", "text": "もうされてるだろ。", "face": "u1185a1"}, {"name": "クレア", "text": "サクヤさん、自然体ですごいですね。\n正直、今のは私もかなり怖かったです。", "face": "u1444a1"}, {"name": "サクヤ", "text": "そうですねぇ……前々から怪談は好きでしたが。", "face": "u1774a1"}, {"name": "サクヤ", "text": "こういうのは初めてなのでドキドキしますし、\nなによりも……皆さんが一緒だからでしょうか？", "face": "u1774a1"}, {"name": "ロヴィニア", "text": "えっへへー♪　私も楽しいよー♪", "face": "u1778a1"}, {"name": "クレア", "text": "いやぁ、実は私も……。", "face": "u1444a1"}, {"name": "サクヤ", "text": "ホムラさんはどうです？", "face": "u1774a1"}, {"name": "ホムラ", "text": "～～ッ、楽しいよ！　決まってんだろ！\nあんまり言わせんなよ、恥ずかしい！", "face": "u1185a1"}, {"name": "サクヤ", "text": "ふふっ、それは良かったです。\nさあ、我ら王国学園不思議倶楽部の最高潮、\n最後の謎を解き明かしに行こうではありませんか。", "face": "u1774a1"}]}], "map": {"image": "Map920195_4713", "w": 960, "h": 640, "spots": [{"k": "b", "x": 941, "y": 149}, {"k": "b", "x": 943, "y": 473}, {"k": "m", "x": 105, "y": 409, "id": 200}, {"k": "m", "x": 215, "y": 143, "id": 201}, {"k": "m", "x": 233, "y": 232, "id": 202}, {"k": "m", "x": 192, "y": 320, "id": 203}, {"k": "m", "x": 235, "y": 419, "id": 204}, {"k": "m", "x": 343, "y": 452, "id": 205}, {"k": "m", "x": 469, "y": 454, "id": 206}, {"k": "m", "x": 596, "y": 453, "id": 207}, {"k": "m", "x": 706, "y": 418, "id": 208}, {"k": "m", "x": 745, "y": 322, "id": 209}, {"k": "m", "x": 708, "y": 231, "id": 210}, {"k": "m", "x": 595, "y": 192, "id": 211}, {"k": "m", "x": 470, "y": 192, "id": 212}, {"k": "m", "x": 343, "y": 190, "id": 213}, {"k": "m", "x": 839, "y": 220, "id": 214}, {"k": "m", "x": 840, "y": 416, "id": 215}, {"k": "r", "x": 133, "y": 208, "id": 300}, {"k": "r", "x": 89, "y": 308, "id": 301}, {"k": "r", "x": 281, "y": 313, "id": 302}, {"k": "r", "x": 464, "y": 259, "id": 303}, {"k": "r", "x": 658, "y": 319, "id": 304}, {"k": "r", "x": 464, "y": 381, "id": 305}, {"k": "r", "x": 752, "y": 151, "id": 306}, {"k": "r", "x": 856, "y": 319, "id": 307}, {"k": "r", "x": 760, "y": 484, "id": 308}]}, "start_cost": 10, "active": true}