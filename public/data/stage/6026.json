{"quest_id": 6026, "name": "妖精郷の危機（記憶）", "description": "妖精郷を襲うダークエルフ。\nアベンジャーの恐るべき能力に\n気をつけろ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "戦場の記憶", "event_category": "History", "mission_id": 920085, "map_no": 3756, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 200, "gold": 800, "drops": [{"card": 118, "c": 1}, {"card": 133, "c": 1}, {"item": 1002, "c": 1}, {"item": 5002, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 35, "form_index": 0, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 30}, {"enemy_id": 3, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 34}, {"enemy_id": 4, "source": "local", "count": 1, "level": 70, "form_index": 0, "form_count": 1, "hp": 18000, "attack": 300, "base_hp": 18000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103600, "special_effect_id": 223, "master_id": 20040, "global_id": 1115, "spawn_sec": 48}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 60}], "dialogue": [{"trigger": "start", "lines": [{"name": "オリヴィエ", "text": "あなた方は！\n人間がどうしてこんなところに……。\nまさか妖精郷を助けにきてくださったのですか？", "face": "u115"}, {"name": "アンナ", "text": "あなたはエルフですか？\n妖精郷とは、いったい何のことでしょうか。", "face": "l832b17122fb2"}, {"name": "オリヴィエ", "text": "妖精郷はエルフの結界によって現世とは\n切り離され、誰も入ることができないはずでした。", "face": "u115"}, {"name": "オリヴィエ", "text": "それが先日、何者かによって結界が破られ\n魔物の侵略を許してしまったのです。", "face": "u115"}, {"name": "オリヴィエ", "text": "われわれエルフは、かつての千年戦争が終結した後、\n争いを避けるため他の種族との関わりを絶ちました。\n隠れ里を作り、そこで長い年月を過ごしていました。", "face": "u115"}, {"name": "オリヴィエ", "text": "魔物が復活し人間が苦しんでいた際にも、\n他の種族との接触を禁じた古い仕来りを守るという名目で、\n何もしてさしあげることもありませんでした……。", "face": "u115"}, {"name": "オリヴィエ", "text": "このような身勝手な行いの\nわれわれを助けて頂き、\n本当にありがとうございます。", "face": "u115"}, {"name": "アンナ", "text": "いえ、困っている方を助けるのは当然の事です。\nそれにまだ、妖精郷の中に入り込んだ魔物が\n残っているようです。油断せずに行きましょう。"}, {"name": "ロアナ", "text": "人間どもがエルフの援軍に来ているのかい？\n軟弱なエルフ相手に退屈していたところだ。\nどれ、私の相手をしてもらおうか。", "face": "u121"}, {"name": "ロアナ", "text": "ダメージを受けるほどに攻撃力が増す\nアベンジャーの恐ろしさ……見せてやろうじゃないか。\nさあ、私に攻撃してきな！　倍にして返してやるよ！", "face": "u121"}]}, {"trigger": "end", "lines": [{"name": "ロアナ", "text": "まさかそんな、私たちが負けるなんて……！\nあいつら一体何者なんだい……。", "face": "u121"}, {"name": "オリヴィエ", "text": "ありがとうございます……！\nあなた方のおかげで里に侵入した魔物は\nすべて撃退することができました。", "face": "u115"}, {"name": "オリヴィエ", "text": "今回の件で、我々エルフの在り方について、\n古き仕来りを守り続けるだけではなく、\nいま一度考え直す必要があると感じました。", "face": "u115"}, {"name": "オリヴィエ", "text": "すぐにとは参りませんが、今後は我々エルフも\n王子達、人々と関わりを持つようにしていきたく思います。\nその際には何卒、よろしくお願いしますね。", "face": "u115"}, {"name": "レーヴ", "text": "…………種族、境遇に関係なくお手を差し伸べる。\nそんな王子の優しさこそが、\n沢山の方々との繋がりを生む力なのでしょうね。", "face": "u454"}, {"name": "レーヴ", "text": "王子ならば、種族、立場に囚われることなく\n様々な方たちが協力し、笑い合える世界を\n作る事が出来ると信じています……！", "face": "u454"}, {"name": "レーヴ", "text": "私も、他の種族の方々ともっと交流を深められたら……\nって、も、申し訳ありません！　次の記憶ですよね？\nはい、それでは私の手をお取りください、王子。", "face": "u454"}]}], "map": {"image": "Map920085_3756", "w": 960, "h": 640, "spots": [{"k": "b", "x": 30, "y": 220}, {"k": "b", "x": 930, "y": 172}, {"k": "b", "x": 930, "y": 493}, {"k": "m", "x": 218, "y": 237, "id": 200}, {"k": "m", "x": 293, "y": 142, "id": 201}, {"k": "m", "x": 434, "y": 128, "id": 202}, {"k": "m", "x": 575, "y": 156, "id": 203}, {"k": "m", "x": 669, "y": 235, "id": 204}, {"k": "m", "x": 825, "y": 195, "id": 205}, {"k": "m", "x": 803, "y": 447, "id": 206}, {"k": "m", "x": 622, "y": 361, "id": 207}, {"k": "m", "x": 463, "y": 363, "id": 208}, {"k": "m", "x": 312, "y": 339, "id": 209}, {"k": "m", "x": 331, "y": 444, "id": 210}, {"k": "r", "x": 137, "y": 297, "id": 300}, {"k": "r", "x": 336, "y": 206, "id": 301}, {"k": "r", "x": 340, "y": 255, "id": 302}, {"k": "r", "x": 436, "y": 41, "id": 303}, {"k": "r", "x": 578, "y": 277, "id": 304}, {"k": "r", "x": 540, "y": 447, "id": 305}, {"k": "r", "x": 891, "y": 394, "id": 306}, {"k": "r", "x": 746, "y": 302, "id": 307}, {"k": "r", "x": 654, "y": 294, "id": 308}]}, "start_cost": 15, "active": true}