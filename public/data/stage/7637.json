{"quest_id": 7637, "name": "オリュンポス麓の決戦", "description": "障壁を守護する大天使たちを打ち倒せ！\n＜天界：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["天界：攻撃力がダウン。\n　一部を除く敵味方のＨＰが徐々に回復"], "event": "オリュンポス開門作戦", "event_category": "History", "mission_id": 920178, "map_no": 4129, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -500]}, {"kind": "term", "influence": 41, "params": [0, 100, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 20, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 20000000, "attack": 10000, "base_hp": 20000000, "base_attack": 10000, "damage_type": "physical", "armor_defense": 40, "magic_defense": 20, "attack_range": 30, "attack_speed": 1, "attack_wait": 30, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2137216, "special_effect_id": 993, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 34956, "global_id": 8573, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 3, "hp": 59000, "attack": 4000, "base_hp": 59000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 450, "magic_defense": 15, "attack_speed": 1, "attack_wait": 100, "attack_interval": 302, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2137232, "race_id": 20, "special_effect_id": 1059, "change_to": 2, "master_id": 34941, "global_id": 8558, "to_global_id": 8574, "route_behaviour": {"transforms": [{"wait": 35}]}}, {"enemy_id": 2, "source": "local", "count