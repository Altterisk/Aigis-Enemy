 100, "transform_resist": 100, "pattern_id": 2123680, "race_id": 7, "master_id": 32684, "global_id": 6302, "spawn_sec": 225}, {"enemy_id": 20, "source": "local", "count": 2, "form_count": 1, "tags": ["鳥"], "hp": 60000, "attack": 700, "base_hp": 60000, "base_attack": 700, "damage_type": "physical", "armor_defense": 450, "magic_defense": 40, "attack_range": 350, "attack_speed": 1, "attack_wait": 30, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125824, "race_id": 11, "special_effect_id": 619, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 32932, "global_id": 6549, "ranged": true, "spawn_sec": 275}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 1, "hp": 100000, "attack": 2800, "base_hp": 100000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_speed": 1, "attack_wait": 70, "attack_interval": 212, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2125808, "race_id": 6, "special_effect_id": 618, "master_id": 32931, "global_id": 6548, "route_behaviour": {"calls_event": [2191, 2192, 2193, 2194, 2195, 2196, 2197, 2198, 2199, 2200]}, "spawn_sec": 277}, {"enemy_id": 22, "source": "local", "count": 16, "form_count": 1, "tags": ["鳥", "水棲"], "hp": 5500, "base_hp": 5500, "damage_type": "physical", "armor_defense": 400, "attack_speed": 1, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132416, "race_id": 11, "master_id": 34504, "global_id": 8121, "spawn_sec": 287}, {"enemy_id": 23, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 10000000, "attack": 250, "base_hp": 10000000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_speed": 40, "attack_wait": 30, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104032, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 34947, "global_id": 8564, "spawn_sec": 417}, {"enemy_id": 24, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 10000000, "attack": 300, "base_hp": 10000000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 60, "attack_interval": 221, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137280, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 34948, "global_id": 8565, "spawn_sec": 417}, {"enemy_id": 25, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 10000000, "attack": 250, "base_hp": 10000000, "base_attack": 250, "damage_type": "physical", "armor_defense": 60, "attack_speed": 80, "attack_wait": 60, "attack_interval": 246, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 34949, "global_id": 8566, "spawn_sec": 417}], "popups": ["天界では、時間経過によって\n雲の足場が出現する\nことがあります。\n\n出現した雲の足場には、\n遠距離ユニットを\n配置できるようになります。", "大天使長はHPが徐々に回復します。\nブロックされている間は\n回復効果が無くなります。\n\nまた、一定時間が\n経過することでも\n回復効果は無くなります。", "ギガエルがいる間は、\n魚人を含む水棲の魔物の\n攻撃と防御がアップします。", "アラエルがいる間は、\n鳥人系の敵の攻撃と防御が\nアップします。", "アラエルが使役する霊鳥は\nあらゆる攻撃を受け付けません。\n\nアラエルの撃破、もしくは\nアラエルが拠点を通過すると\n消滅します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "大天使長", "text": "――とうとう、ここまで来ましたか。\n神に叛逆する、愚かなる人の子らよ。", "face": "l941a64959799"}, {"name": "サナラ", "text": "大天使長と、天槍騎兵だけ……？\nやけに戦力が薄いですね。", "face": "u921"}, {"name": "ヘレナ", "text": "よし、前回の分析は正しかった。\nこの障壁は巨大過ぎるがゆえに、\n全域に戦力を分散させるしかないんだ。", "face": "u354"}, {"name": "シェミア", "text": "大天使長、まさか命を賭してまで\nこの障壁を守るつもりですか？", "face": "u1505a1"}, {"name": "大天使長", "text": "……シェミア、懐かしい顔ですね。\n人を愛し、地に堕ちたかつての同胞よ。", "face": "l941a64959799"}, {"name": "大天使長", "text": "されど、この障壁は絶対なるもの。\nケラウノス様のため、神聖なるオリュンポスを、\n私は――ぐぅッ……ケラ、ウノス、様のために……。", "face": "l941a64959799"}, {"name": "フローガ", "text": "王子殿下！　例の天使を支配する魔力の波動が！\n彼はおそらく、亜神ディアスに……！", "face": "u878"}, {"name": "大天使長", "text": "亜神、ディアス……？\n何を言っているのです、私は……ケラウノス様の、\n真なる、願いのために……。", "face": "l941a64959799"}, {"name": "ヘレナ", "text": "説得はもとより不可能、か……。\n仕方ない、王子！　敵を蹴散らし、障壁を砕くぞ！", "face": "u354"}]}, {"trigger": "battle", "at_sec": 411, "lines": [{"name": "アナベラ", "text": "……よし、障壁の前に敵はもういない。\nみんな、後は手筈どおりに頼むよ！", "face": "u1309a1"}, {"name": "レーヴ", "text": "任せてください！\nエクスさんも準備は良いですか？", "face": "u454"}, {"name": "エクス", "text": "えぇ、おまかせを。\nまさか私たちの祈りが、\n障壁突破の鍵になるとは考えもしませんでしたが。", "face": "u487"}, {"name": "ディアス", "text": "――祈り、祈りだと？\n力を使い果たし、眠りにつく女神にでも祈るのか？", "face": "l0ac261863309"}, {"name": "アルヴァ", "text": "……ッ！　亜神ディアス！！", "face": "u1198a1"}, {"name": "ディアス", "text": "なぜ理解しない、理解しようともしない。\n何の苦難も悲しみもない、\n停滞と安寧の世界をもたらしてやると言っているのに。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "人類が不完全な存在であることは、\n貴様らでも理解の及ぶところだろう。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "余がすべての力を取り戻した暁には、\n愚かなる創造神の失敗、\nその全てを打ち消してやろうというのだぞ？", "face": "l0ac261863309"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ディアス", "text": "……気に入らぬ。\nその目つき、実に不愉快だ。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "だが、貴様らとて庇護すべき愚かなる創造神の被造物。\nこの手で殺すのは、余の流儀に反する。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "過去より学ばぬ愚か者どもよ、\n再び彼方の地へ送ってやろう。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "もう二度とこの地を踏めぬよう、\nそうだな、空の果て、\nあるいは遥かな地の底にでも行くがよい。", "face": "l0ac261863309"}, {"name": "エクス", "text": "…………来ましたね。\nレーヴさん、転送魔術ですわ！", "face": "u487"}, {"name": "レーヴ", "text": "はいっ！　女神アイギス様、\nその「権能」の一端をお貸しください！！", "face": "u454"}]}, {"trigger": "battle", "at_sec": 415, "lines": [{"name": "ディアス", "text": "…………ほう。\n余の魔術を防いだ、だと？", "face": "l0ac261863309"}, {"name": "ディアス", "text": "女神アイギスが助力したとでも――\n否、これは、そうか、余の権能を解読したのかッ！！", "face": "l0ac261863309"}, {"name": "レーヴ", "text": "亜神ディアス、あなたが本来持っていた権能は、\n創造神によって剥奪され、\nそれらの欠片は三女神を生み出しました。", "face": "u454"}, {"name": "レーヴ", "text": "考えてみれば、とても単純なことだったんです。\nあなたの振るう権能の多くは、\n三女神と同系統のそれだったのですから。", "face": "u454"}, {"name": "エクス", "text": "この障壁は、女神アイギスによる封印の権能。\n数多くの魔物を封じ、\n千年戦争を終結させた結界を真似たもの。", "face": "u487"}, {"name": "エクス", "text": "そして転送魔術とは、\nすなわち「召喚」の権能を劣化、模倣したもの。", "face": "u487"}, {"name": "レーヴ", "text": "この地へ召喚するのではなく、\nこの地から、彼方の地へと召喚していたのだと、\nそこに気付けば、あとは術式を解析するだけでした。", "face": "u454"}, {"name": "エクス", "text": "もしこれが、女神アイギス様の「召喚」そのものなら、\n私たちでは手が届くこともないほどに、\n複雑に絡み合った奇跡のような術式だったことでしょう。", "face": "u487"}, {"name": "デスピア", "text": "けれど、そうではなかった。\n亜神ディアス、あなたが模倣した魔術は、\n私たちの手が届く代物だったのよ。", "face": "u49"}, {"name": "エステル", "text": "女神アイギス様への祈りが術式を解き、\nその細く鋭い廻廊へ、私たちが魔力を叩き込む。\nそれだけで、この繊細な術式は容易く崩壊するのです。", "face": "u245"}, {"name": "エステル", "text": "――こんな風に。", "face": "u245"}]}, {"trigger": "end", "lines": [{"name": "アルス", "text": "はぁ、はぁ……。\n待たせたね、王子っ！！", "face": "u73"}, {"name": "ウィルフレッド", "text": "決戦には間に合いましたか？", "face": "u5"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ディアス", "text": "……見事だ、人類よ。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "神の術を読み解き、神域を犯す不敬、\nその偉業に免じて赦すとしよう。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "王子よ、貴様こそ我が雷霆の敵であると、\nここに認めようではないか。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "人類よ、オリュンポスへ挑むことを許そう。\n原初の実験場、創造神の庭、\n我が居城たる聖域へ来るがいい。", "face": "l0ac261863309"}, {"name": "アルヴァ", "text": "……逃げるつもりか、亜神ディアス。", "face": "u1198a1"}, {"name": "ディアス", "text": "喚くな、余が全力をもって相対してやろうというのだ。\n相応しい時、相応しい舞台が必要だろう？", "face": "l0ac261863309"}, {"name": "ディアス", "text": "王子よ、さらなる力を身につけよ。\n小手先の力ではない、真なる英雄としての力を。", "face": "l0ac261863309"}, {"name": "ディアス", "text": "オリュンポスを超えたその先で、\n余は貴様を待ち続けようぞ。", "face": "l0ac261863309"}, {"name": "フローガ", "text": "……亜神ディアスの魔力、霧散しました。\nどうやら、もうこの付近にはいないようです。", "face": "u878"}, {"name": "アンナ", "text": "……オリュンポスへ挑めとは、どういう意味なのでしょう。", "face": "l6808f0be7d85"}, {"name": "トラム", "text": "かつてのオリュンポスは、\n創造神による、世界を生み出すための実験場よ。\nでも、今はいったいどうなっているのか……。", "face": "u1110a1"}, {"name": "レーヴ", "text": "それに、強くなれとは……。\nこちらが強くなったら、\n亜神ディアスにとって不利益なのでは……？", "face": "u454"}, {"name": "ケイティ", "text": "――ともあれ、今は作戦完遂を喜びましょう。\nオリュンポスへの道が、ようやく確保できたのですから。", "face": "u114"}, {"name": "アンナ", "text": "そう、ですね……。\n王子、皆さん、お疲れ様でした！"}, {"name": "アンナ", "text": "まずはこの地に陣を築き、\n今後の方策を練ることにしましょう！", "face": "l6808f0be7d85"}]}, {"trigger": "route", "enemy_ids": [16], "lines": [{"name": "ギガエル", "text": "――ここで刃を交えることになるとは。\nしかし、これもまた必然というものか。", "face": "l5c49c5b6e838"}, {"name": "ハルフゥ", "text": "ギガエル様、クラールフ様の天使たるあなたが、\nなぜ亜神ディアスに加担するのですか。", "face": "u1118a1"}, {"name": "ギガエル", "text": "……答える必要はあるまい。", "face": "l5c49c5b6e838"}, {"name": "フローガ", "text": "問うべきはそこではないかもしれませんよ。\nむしろ――ギガエル、あなたはなぜ、\n亜神ディアスの精神支配を受けていないのですか？", "face": "u878"}, {"name": "ギガエル", "text": "…………ほう。\n人の子にしては目聡いものだ。\nその目、魔力の乱れが見えているのか。", "face": "l5c49c5b6e838"}, {"name": "ギガエル", "text": "我が敬愛する創造主は、未だ健在であるがゆえに。\n我が権能は、過去も未来も変わることなく、\n海に生きる者らと、我が主のために振るわれる。", "face": "l5c49c5b6e838"}, {"name": "ギガエル", "text": "我が使命を阻むのであれば、\n我が主の盟友とて容赦はしない。", "face": "l5c49c5b6e838"}, {"name": "フローガ", "text": "……亜神クラールフとのつながりが、消えていない？\nだから亜神ディアスの精神支配を受けていない、と。", "face": "u878"}, {"name": "フローガ", "text": "…………あれ、それなら余計に分からなくなりますよ！\n亜神ディアスに与する理由がまったく分かりません！", "face": "u878"}, {"name": "ギガエル", "text": "……時間稼ぎは、これくらいでいいだろう。\n亜神ディアスよ、義理は果たしたぞ。", "face": "l5c49c5b6e838"}, {"name": "ギガエル", "text": "さぁ、かかってくるがいい、乾いた地の民よ。", "face": "l5c49c5b6e838"}]}, {"trigger": "route", "enemy_ids": [21], "lines": [{"name": "アラエル", "text": "…………。", "face": "lce1c0bbaf335"}, {"name": "パリオス", "text": "アラエルさま！\nよかった、無事だったんだね！", "face": "u1109a1"}, {"name": "アラエル", "text": "……穢らわしい。\n空も、翼も、何もかもが穢れている……。", "face": "lce1c0bbaf335"}, {"name": "アラエル", "text": "あぁッ……ぐぁあっ……！\nどうして……我が主よ……どこに……。", "face": "lce1c0bbaf335"}, {"name": "ソフィー", "text": "精神支配が進行して……。\nアラエル、私の声は届きませんか……？", "face": "u146"}, {"name": "アラエル", "text": "……ソフィー、ソフィー？\nそこにいるのですか……？", "face": "lce1c0bbaf335"}, {"name": "アラエル", "text": "ああ……手を貸してください……。\n穢らわしい者どもが、我が主を傷つけようとするのです。", "face": "lce1c0bbaf335"}, {"name": "パリオス", "text": "アラエルさま……。\nうぅぅ、見てられないよ、あんな姿……。", "face": "u1109a1"}, {"name": "ミレイユ", "text": "精神支配装置がディアスの手にある以上、\nいま、彼にしてあげられることはありません。", "face": "u386"}, {"name": "ミレイユ", "text": "せめて、苦しまずに済むよう、\nしばしの眠りにつかせてあげましょう。", "face": "u386"}]}], "active": true}