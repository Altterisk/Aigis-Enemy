": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 41213, "spawn_sec": 103}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "tags": ["ステルス"], "hp": 30000, "attack": 800, "base_hp": 30000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113920, "master_id": 40554, "global_id": 14171, "spawn_sec": 126}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "tags": ["タルタロスの呪縛"], "hp": 62000, "attack": 350, "base_hp": 62000, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 75, "attack_interval": 199, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2168528, "special_effect_id": 2344, "missile_id": 11, "master_id": 40010, "global_id": 13627, "ranged": true, "spawn_sec": 158}, {"enemy_id": 10, "source": "local", "count": 5, "form_count": 1, "hp": 24000, "attack": 650, "base_hp": 24000, "base_attack": 650, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097472, "race_id": 12, "master_id": 40697, "global_id": 14314, "spawn_sec": 219}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 85000, "attack": 1100, "base_hp": 85000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 2200, "attack_speed": 50, "attack_wait": 10, "attack_interval": 106, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099136, "race_id": 12, "special_effect_id": 222, "master_id": 40698, "global_id": 14315, "spawn_sec": 225}], "popups": ["不定形な呪いの泥は、\n攻撃を行わず\n撃破数に含まれません。", "呪いの泥の\n一定範囲内の味方ユニットは\n攻撃力がダウンし、\n継続ダメージを受けます。\n\nまた呪いの泥は、\n戦場にいる呪いの泥の総数に応じて\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヒュリオン", "text": "――それでね、それでね。", "face": "u2736a1"}, {"name": "イクセリス", "text": "うんうんっ。\n帝都のお菓子、食べてみたいなぁ♪", "face": "u2912a1"}, {"name": "アンナ", "text": "……どうやら、落ち着いたようですね。"}, {"name": "ヘルメルク", "text": "似た境遇の者がいたのが幸いだったね。\nそれにしても……はぁ、困った父親だなぁ。", "face": "u2275a1"}, {"name": "サザンカ", "text": "処刑せず、転生すれば責め苦が終わるようにした辺り、\nディアスも昔のイクセリスのことを\n相当気に入ってたんじゃないかなって思うけどね。", "face": "u1347a1"}, {"name": "ヘルメルク", "text": "そういうもの？", "face": "u2275a1"}, {"name": "サザンカ", "text": "責め苦が終わったらまた来るがいい、\nって言ってるようなものだし。", "face": "u1347a1"}, {"name": "ヘルメルク", "text": "なるほど、男女の機微というか、\n強者の余裕というか……難しいものだね。", "face": "u2275a1"}, {"name": "へカティエ", "text": "それで、帝都の方は？", "face": "u1226a1"}, {"name": "ウルスラ", "text": "ひとまず早馬を出しました。\nフローガさんに手伝ってもらって、\n魔力通信をしようと思ったのですが――", "face": "u1552a1"}, {"name": "フローガ", "text": "この周辺一帯で、魔力の乱れが発生しているようで。\nそちらもあわせて調査中、といったところですね。", "face": "u878"}, {"name": "へカティエ", "text": "いっそ、このまま帝都に戻った方が早いかもね。", "face": "u1226a1"}, {"name": "白の皇帝", "text": "……俺が戻れば、呪いを持ち帰ることにもなる。\n向こうの状況が分かるまでは、動きようがない。", "face": "u418"}, {"name": "ヘルメルク", "text": "何事もなければいいけどねぇ……。\n……ん？　何か、足音ずしんずしんしてない？", "face": "u2275a1"}, {"name": "？？？", "text": "――すみません！　誰かー！　助けてほしいっす！\n北の道に、まだ人が残ってて……！", "face": "u2917a1"}, {"name": "アンナ", "text": "巨人族の方……？\n落ち着いてください。何があったのですか？"}, {"name": "？？？", "text": "獣が暴れて、里の連中も手一杯で……。\n道にも、変な黒いのが湧くし……。\nあーもう、どこから説明したらいいんすかね！？", "face": "u2917a1"}, {"name": "白の皇帝", "text": "正確な場所はどこだ。", "face": "u418"}, {"name": "？？？", "text": "北の街道っす！　ここからまっすぐっすよ！", "face": "u2917a1"}, {"name": "白の皇帝", "text": "先に確認しておくが、その黒いものとは何だ？\n黒い泥のようなものか？", "face": "u418"}, {"name": "？？？", "text": "そう、それっす！\n里の近くだけじゃなくて、\nここへ来るまで、何か所も噴き出してたんすよ。", "face": "u2917a1"}, {"name": "イクセリス", "text": "……私が、さっき暴れたから……？", "face": "u2912a1"}, {"name": "？？？", "text": "いや、何日か前からっす。\n獣にまとわりついて、それから急に凶暴に……。\n……って、来た！　あいつらっす！", "face": "u2917a1"}, {"name": "白の皇帝", "text": "遅かったか……。\n王子、獣を迎えうつぞ。", "face": "u418"}, {"name": "王子", "text": "…………ッ！", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "逃げ遅れた人、たぶん全員助けられたっす！\nありがとうっすー！", "face": "u2917a1"}, {"name": "白の皇帝", "text": "よく知らせてくれた。\nおかげで、民を守ることができた。", "face": "u418"}, {"name": "？？？", "text": "たみ……？\nんっ……んー……？　んー！？", "face": "u2917a1"}, {"name": "？？？", "text": "もしかして、皇帝陛下っすか！？\nそっちは……王子殿下！？", "face": "u2917a1"}, {"name": "白の皇帝", "text": "…………ただの通りすがりだ。", "face": "u418"}, {"name": "？？？", "text": "ただの通りすがりはそんな威厳ないっすよ！\nはぁ、それにしても、帝国軍が近くにいるって聞いて、\n頼りに来て本当によかったっすよぉ。", "face": "u2917a1"}, {"name": "チレン", "text": "あっ、あたしはチレンっす！\nほんっとーにありがとうございました！", "face": "u2917a1"}, {"name": "へカティエ", "text": "……でも、困ったわね。\n黒い泥……タルタロスの魔力が、\nもう何日も噴き出しているのでしょう？", "face": "u1226a1"}, {"name": "フローガ", "text": "魔力通信が届かないのも、\nそれが原因と見て間違いなさそうですね。", "face": "u878"}, {"name": "へカティエ", "text": "何より、北の街道でも起きているのでしょう？\nそれってつまり――", "face": "u1226a1"}, {"name": "白の皇帝", "text": "俺がまだ、通っていない場所にも、ということか。", "face": "u418"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "白の皇帝", "text": "フッ……そうだな。\nならば、ためらう必要はないか。", "face": "u418"}, {"name": "白の皇帝", "text": "一度、帝都へ帰還する。\n何が起きているのか、原因究明を急ぐぞ。", "face": "u418"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 12, "params": [200]}, {"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "hp": 172000, "attack": 2000, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2118528}, {"enemy_id": 1, "form_index": 1, "hp": 172000, "attack": 1800, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2118544}, {"enemy_id": 3, "hp": 4200, "attack": 400, "damage_type": "physical", "armor_defense": 40, "pattern_id": 2097344}, {"enemy_id": 4, "hp": 5000, "attack": 340, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "pattern_id": 2162320}, {"enemy_id": 5, "hp": 6000, "attack": 420, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "pattern_id": 2101264}, {"enemy_id": 6, "hp": 30000, "attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "pattern_id": 2168544}, {"enemy_id": 7, "hp": 10000, "attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "pattern_id": 2097856}, {"enemy_id": 8, "hp": 30000, "attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "pattern_id": 2113920}, {"enemy_id": 9, "hp": 62000, "attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2168528}, {"enemy_id": 10, "hp": 24000, "attack": 650, "damage_type": "physical", "armor_defense": 2000, "pattern_id": 2097472}, {"enemy_id": 11, "hp": 85000, "attack": 1100, "damage_type": "physical", "armor_defense": 2200, "pattern_id": 2099136}]}, "active": true}