{"quest_id": 8479, "name": "魔女の襲撃", "description": "王城でカカオ豆の魔物を調理していると、\n突如魔女モーロンが攻め込んできて……！？\n暴れ回る災厄の魔女を撃退せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "不思議なカカオクッキング", "event_category": "History", "mission_id": 920226, "map_no": 9300, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 55000, "attack": 1650, "base_hp": 55000, "base_attack": 1650, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 10, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2140720, "race_id": 16, "special_effect_id": 1621, "change_to": 1, "change_condition": 6, "master_id": 37026, "global_id": 10643, "to_condition": 6, "to_global_id": 10644, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 55000, "attack": 1650, "base_hp": 55000, "base_attack": 1650, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 10, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2140736, "race_id": 16, "special_effect_id": 1622, "master_id": 37027, "global_id": 10644, "from_condition": 6}, {"enemy_id": 3, "source": "local", "count": 22, "form_count": 1, "tags": ["バレンタイン"], "hp": 1600, "attack": 500, "base_hp": 1600, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "attack_range": 100, "attack_speed": 70, "attack_wait": 50, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113952, "missile_id": 257, "missile": {"speed": 2.0}, "master_id": 30905, "global_id": 4524, "ranged": true, "spawn_sec": 39}, {"enemy_id": 4, "source": "local", "count": 8, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 308, "change_to": 4, "master_id": 32290, "global_id": 5909, "to_global_id": 5920, "spawn_sec": 60}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 275, "change_to": 3, "master_id": 32301, "global_id": 5920}, {"enemy_id": 6, "source": "local", "count": 19, "form_count": 1, "tags": ["バレンタイン", "チョコレート騎士団"], "hp": 5500, "attack": 650, "base_hp": 5500, "base_attack": 650, "damage_type": "physical", "armor_defense": 800, "attack_speed": 58, "attack_wait": 15, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149824, "master_id": 37023, "global_id": 10640, "spawn_sec": 83}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 5000, "attack": 150, "base_hp": 5000, "base_attack": 150, "damage_type": "physical", "armor_defense": 80, "magic_defense": 25, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2140704, "missile_id": 47, "master_id": 35480, "global_id": 9097, "ranged": true, "spawn_sec": 107}, {"enemy_id": 8, "source": "local", "count": 10, "form_count": 1, "tags": ["植物"], "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 25, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2140704, "missile_id": 47, "master_id": 35481, "global_id": 9098, "ranged": true, "spawn_sec": 150}], "popups": ["魔女モーロンがいる間は、\n全ての敵のHPが\n徐々に回復します。\n\nまた魔女モーロンの\nHPが25%を下回ると、\n回復量が増加します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ノストラ", "text": "ねぇ、カカオ豆さん。\nひとつ、気になっていたことがあるのだけど。", "face": "u2364a1"}, {"name": "カカオ豆の魔物", "text": "うん？　どうしたの？", "face": "le1ad1420c9f0"}, {"name": "ノストラ", "text": "貴方、王国の人たちがチョコを欲しがっていると、\n親切な魔女に教えてもらったと言っていたわよね。", "face": "u2364a1"}, {"name": "ノストラ", "text": "いったい、誰にそんなことを吹き込まれたの？", "face": "u2364a1"}, {"name": "カカオ豆の魔物", "text": "うーん……名前は聞いてないんだけど、\n美味しいお菓子を作れて、\n実は入れ歯をしている女の人で――", "face": "le1ad1420c9f0"}, {"name": "モーロン", "text": "――あっはははははっ！\n王城をお菓子の家にしてあげるよ！", "face": "l671089dd0d31"}, {"name": "カカオ豆の魔物", "text": "あっ、あの女の人だよ！", "face": "le1ad1420c9f0"}, {"name": "ミア", "text": "へー、お菓子の魔女のモーロンさんだったんですね。\n……どうして王城にお菓子の魔女が！？", "face": "u2361a1"}, {"name": "アデライド", "text": "まさか攻め込んでくるとはな。\n裏で隠れて悪事を働くのはやめたのか？", "face": "u2362a1"}, {"name": "モーロン", "text": "おや、王国軍の連中がぞろぞろと……。\nって城に侵入してるんだから当たり前だったね。", "face": "l671089dd0d31"}, {"name": "モーロン", "text": "コツコツやってもあんたらに邪魔されるんだ。\nだったら直接王国を攻めちまうほうがいいだろう？", "face": "l671089dd0d31"}, {"name": "マツリ", "text": "どうやら血迷ったようですね。\nあなたひとりで王国が落とせるとでも思いましたか。", "face": "u2363a1"}, {"name": "モーロン", "text": "そちらこそ、魔女の恐怖を忘れたかい！", "face": "l671089dd0d31"}, {"name": "モーロン", "text": "あたしはお菓子が大好きな普通の魔女！\nされど災厄の魔女のひとりと知られた者！", "face": "l671089dd0d31"}, {"name": "モーロン", "text": "砂糖漬けのお菓子になって、\nその甘い恐怖を思い知るがいいさ！", "face": "l671089dd0d31"}]}, {"trigger": "end", "lines": [{"name": "アデライド", "text": "ここまでだ。\n大人しくお縄についてもらうぞ。", "face": "u2362a1"}, {"name": "モーロン", "text": "ちっ、ここまでかい……。\nあたしだけじゃ無理があったね。", "face": "l671089dd0d31"}, {"name": "エレイン", "text": "ふんっ、啖呵を切った割には大したことないじゃない！\nこれならチョコ作りのほうが難敵だったわよ！", "face": "u2365a1"}, {"name": "モーロン", "text": "あぁそうかい。\nじゃあせいぜいチョコ作りを頑張るんだね。", "face": "l671089dd0d31"}, {"name": "マツリ", "text": "どこか呆気ない幕切れでしたが……。\nこれで後は、カカオ豆の魔物を調理するだけでしょうか。", "face": "u2363a1"}, {"name": "ミア", "text": "そうですねっ。\n砂糖を混ぜて、美味しいチョコにしましょう！", "face": "u2361a1"}, {"name": "カカオ豆の魔物", "text": "うん、みんなありがとう！\nそれじゃ、砂糖といい感じに混ざるね！", "face": "le1ad1420c9f0"}, {"name": "カカオ豆の魔物", "text": "これでみんなを笑顔にするような、\n美味しいチョコに……ぐあっ！？\nあっ、あぁ、ぎあぁぁぁあぁぁぁ！？", "face": "le1ad1420c9f0"}, {"name": "ミア", "text": "か、カカオ豆さん！？　どうしたんですか！？", "face": "u2361a1"}, {"name": "アデライド", "text": "砂糖を混ぜた途端に苦しみはじめた……！？", "face": "u2362a1"}, {"name": "ノストラ", "text": "まさか……お菓子の魔女！　貴方の仕業ね！", "face": "u2364a1"}, {"name": "モーロン", "text": "あっはははははっ！\n駄目じゃないか、材料はちゃんと確認しないと。\n魔女が呪いの砂糖とすり替えてるかもしれないんだから！", "face": "l671089dd0d31"}, {"name": "カカオ豆の魔物", "text": "う、ぐぐ……ッ。\n私は……私は、食べられて……そして……！", "face": "le1ad1420c9f0"}, {"name": "ミア", "text": "カカオ豆さん……？", "face": "u2361a1"}, {"name": "カカオ豆の魔物", "text": "私を食べさせて――", "face": "le1ad1420c9f0"}, {"name": "チョコレートの魔物", "text": "――人を、支配する。", "face": "l890d61b2642f"}]}], "active": true}