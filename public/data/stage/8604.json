ndition": 0, "to_global_id": 12520, "spawn_sec": 130}, {"enemy_id": 34, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 650, "base_hp": 12000, "base_attack": 650, "damage_type": "physical", "armor_defense": 100, "attack_range": 240, "attack_speed": 120, "attack_wait": 60, "attack_interval": 171, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2161584, "race_id": 16, "special_effect_id": 275, "change_to": 33, "missile_id": 26, "master_id": 38903, "global_id": 12520, "ranged": true, "from_condition": 0}, {"enemy_id": 36, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 500, "base_hp": 5000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101904, "race_id": 7, "master_id": 348, "global_id": 347, "spawn_sec": 248}], "popups": ["コウメは、自身の攻撃力の値で\n自身を含む周囲の敵を回復します。\n\nブロックされている間は、\n回復行動を行わなくなります。", "イヴリールがいる間は、\n全ての味方ユニットの\n防御力が低下します。", "乙姫は\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ"], "dialogue": [{"trigger": "start", "lines": [{"name": "ペルセナス", "text": "――デモシェフ商会から、リゾートのお誘いかぁ。", "face": "u2482a1"}, {"name": "アージェ", "text": "去年に続いて今年も\n新しくリゾート施設を建設したようですね。", "face": "u2487a1"}, {"name": "スーシェン", "text": "前回は大変な目に遭いましたし、\nまたトラブルになりそうではありますが……。", "face": "u2486a1"}, {"name": "コウメ", "text": "でもおごりでリゾートですよ？\nこんなの行かなきゃ損ですよ。", "face": "u2490a1"}, {"name": "サクヤ", "text": "それに、私たちは既に船に乗っています。\n確かに多少の不安はありますが、\nこの機会をめいっぱい楽しんじゃいましょう。", "face": "u2489a1"}, {"name": "乙姫", "text": "乾いた地のリゾートかぁ。\nどんな感じなんだろうねぇ。", "face": "u2483a1"}, {"name": "ペルセナス", "text": "ワクワクしてテンション上がっちゃうよね！\nというわけで、この昂りを模擬戦にぶつけようか！", "face": "u2482a1"}, {"name": "イコル", "text": "……きみ、いつの間にか王国に染まったね。\n事あるごとに模擬戦をしたがる感じがまさにだよ。", "face": "u2485a1"}, {"name": "クロノシア", "text": "まぁまぁ、いいじゃないですか。\nほら、王子はもう準備していますし。", "face": "u2484a1"}, {"name": "イヴリール", "text": "しかし人数が多いな。\nどうする、陣営を分けるか？", "face": "u2488a1"}, {"name": "ペルセナス", "text": "うーん、そうだね。\n切り替えつつやろうか。", "face": "u2482a1"}, {"name": "ペルセナス", "text": "それじゃあ――模擬戦、開始！", "face": "u2482a1"}]}, {"trigger": "end", "lines": [{"name": "ペルセナス", "text": "いいねいいね！\nそれじゃまた陣営を切り替えて――", "face": "u2482a1"}, {"name": "クロノシア", "text": "――模擬戦もいいですが、そろそろ到着するみたいですよ。", "face": "u2484a1"}, {"name": "サクヤ", "text": "遠くにうっすらと見えてきましたが……。\nあれは、水上コテージでしょうか？", "face": "u2489a1"}, {"name": "コウメ", "text": "結構いい感じっぽいですね。\nこれは楽しい夏休みを期待できそうです。", "face": "u2490a1"}, {"name": "スーシェン", "text": "前回のリゾートはトラブルこそありましたが、\nレジャーや食事は満足のいくものだったそうですからね。\n何事もなければ、楽しい夏を過ごせるでしょう。", "face": "u2486a1"}, {"name": "ペルセナス", "text": "トラブルが起きたら、そのときはそのとき！\n超強い半神のあたしが解決してあげる！", "face": "u2482a1"}]}], "map": {"image": "Map920235_9372", "w": 960, "h": 640, "spots": [{"k": "b", "x": 411, "y": 320}, {"k": "b", "x": 540, "y": 241}, {"k": "m", "x": 782, "y": 410, "id": 200}, {"k": "m", "x": 716, "y": 444, "id": 201}, {"k": "m", "x": 644, "y": 478, "id": 202}, {"k": "m", "x": 542, "y": 482, "id": 203}, {"k": "m", "x": 454, "y": 453, "id": 204}, {"k": "m", "x": 717, "y": 188, "id": 205}, {"k": "m", "x": 627, "y": 287, "id": 206}, {"k": "m", "x": 730, "y": 283, "id": 207}, {"k": "m", "x": 847, "y": 375, "id": 208}, {"k": "m", "x": 273, "y": 259, "id": 209}, {"k": "m", "x": 343, "y": 198, "id": 210}, {"k": "m", "x": 399, "y": 131, "id": 211}, {"k": "m", "x": 346, "y": 412, "id": 212}, {"k": "m", "x": 297, "y": 337, "id": 213}, {"k": "m", "x": 486, "y": 93, "id": 214}, {"k": "m", "x": 591, "y": 77, "id": 215}, {"k": "m", "x": 226, "y": 191, "id": 216}, {"k": "m", "x": 920, "y": 394, "id": 217}, {"k": "m", "x": 448, "y": 377, "id": 218}, {"k": "m", "x": 672, "y": 109, "id": 219}, {"k": "m", "x": 793, "y": 323, "id": 220}, {"k": "m", "x": 182, "y": 123, "id": 221}, {"k": "r", "x": 508, "y": 307, "id": 300}, {"k": "r", "x": 607, "y": 368, "id"