{"quest_id": 1804, "name": "胃底の魔軍", "description": "体内を進む一行の前に、魔軍に囚われし\n少女の姿が……。体力を奪う胃酸の猛威を\n切り抜け、踊り子の少女を救い出せ！\n＜胃酸：HPに継続ダメージ＞", "modifier_notes": ["胃酸：HPに継続ダメージ"], "event": "ストーリーミッション8", "event_category": "Story", "mission_id": 100008, "map_no": 1117, "level": 100, "multiplier": 1.0, "charisma": 46, "capacity": 10, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 75, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 52000, "attack": 1500, "base_hp": 52000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 150, "magic_defense": 40, "attack_range": 150, "attack_speed": 150, "attack_wait": 50, "attack_interval": 251, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114128, "race_id": 3, "change_to": 2, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30930, "global_id": 4549, "ranged": true, "variants": [{"hp": 52000, "attack": 5000, "base_hp": 52000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 40, "attack_speed": 50, "attack_wait": 50, "attack_interval": 245, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2098736, "race_id": 3, "master_id": 30369, "global_id": 3988}], "spawn_sec": 1}, {"enemy_id": 4, "source": "loc