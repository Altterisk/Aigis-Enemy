nemy_id": 16, "source": "local", "count": 6, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 213}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 900, "base_hp": 40000, "base_attack": 900, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 190, "attack_speed": 50, "attack_wait": 10, "attack_interval": 86, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103488, "race_id": 3, "special_effect_id": 232, "change_to": 17, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 449, "global_id": 448, "ranged": true, "variants": [{"hp": 40000, "attack": 2200, "base_hp": 40000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 70, "attack_speed": 50, "attack_wait": 30, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103504, "race_id": 3, "master_id": 450, "global_id": 449}], "spawn_sec": 254}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 1, "hp": 45000, "attack": 800, "base_hp": 45000, "base_attack": 800, "damage_type": "magical", "armor_defense": 150, "magic_defense": 40, "attack_range": 150, "attack_speed": 150, "attack_wait": 60, "attack_interval": 195, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110288, "race_id": 3, "special_effect_id": 232, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30274, "global_id": 3893, "ranged": true, "spawn_sec": 271}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここがレヴィアタンの胃ですか。\nうっ……なんだか気分が……。", "face": "l8531607319ce"}, {"name": "モーティマ", "text": "ぐっ……お、俺もだ……。\nどうなってんだ？　さっき休憩したばっかじゃねえか。", "face": "u14"}, {"name": "ゼンメル", "text": "うむ……おそらくレヴィアタンの胃酸が\n我々の身体を蝕んでいるのじゃろう。\n老体にはこたえるわい……ゲホッゴホッ！", "face": "u284"}, {"name": "ケイティ", "text": "この場に留まっていては危険ですね……。\n可能な限り速やかに通過いたしましょう。", "face": "u114"}, {"name": "リエーレ", "text": "――ッ！\n（静かに！　向こうに誰かいるぞ……）", "face": "u490"}, {"name": "デーモンメイジ", "text": "――フン、貴様の舞には飽きたわ。\nそろそろもっと刺激的な余興をしてもらおうか？", "face": "lf74789a68062"}, {"name": "？？？", "text": "ひっ……そ、それだけはご勘弁を！\nもっとお気に召す踊りを披露しますので……。", "face": "u596"}, {"name": "グレーターデーモン", "text": "……デーモンメイジ君。\n召集前にワシが暇つぶしのために連れてきた奴隷だ。\nそう簡単に殺してしまっては困るんだがねぇ。", "face": "lfdadac9db6cc"}, {"name": "デーモンメイジ", "text": "フン、ならば別の奴隷を連れてくればよかろう。\n見飽きた舞を披露する踊り子など、さっさと殺してな。", "face": "lf74789a68062"}, {"name": "？？？", "text": "あぅ……そ、そんなぁ……。", "face": "u596"}, {"name": "アンナ", "text": "くっ……もう見ていられません！\n王子、あの人を助けに行きましょう！", "face": "l8531607319ce"}, {"name": "ケイティ", "text": "ですが、胃酸の影響による兵の疲弊が深刻です。\n風水使いの方々なら影響を軽減できるかもしれませんが、\n兵の治癒を怠らぬよう、くれぐれもご注意ください。", "face": "u114"}, {"name": "グレーターデーモン", "text": "――おや、あれは人間達か。\nデーモンメイジ君、\n暇つぶしをしている場合ではなくなったようだよ。", "face": "lfdadac9db6cc"}, {"name": "デーモンメイジ", "text": "ああ、我ら高位デーモンが召集に応じ、\nここで待機していた甲斐があったというものだ。", "face": "lf74789a68062"}, {"name": "デーモンメイジ", "text": "総員、戦闘用意！\nレヴィアタン復活を阻止せんと企む不届き者の\n愚かなる野心をここで打ち砕くのだ！", "face": "lf74789a68062"}]}, {"trigger": "end", "lines": [{"name": "デーモンメイジ", "text": "くっ……人間どもがここまでやるとは……。\nだが、レヴィアタンの復活を阻害せんとする\n無法の輩をこの先に通すわけには……。", "face": "lf74789a68062"}, {"name": "ガード", "text": "――もうよい、デーモンメイジよ。\n無益な抵抗はやめ、兵を退くがいい。", "face": "l4c6077d25df9"}, {"name": "リエーレ", "text": "あれは、魔王軍の――！", "face": "u490"}, {"name": "デーモンメイジ", "text": "が、ガード様！？\nですが、ここで退いては――。", "face": "lf74789a68062"}, {"name": "ガード", "text": "確かに、レヴィアタンの防衛を諦めるのは惜しい。\nだが、これ以上軍の戦力を失うことは\n魔王様の意に沿うところではないのだ。", "face": "l4c6077d25df9"}, {"name": "ガード", "text": "それに、レヴィアタンの復活を待つことのみが\n物質界を滅ぼす唯一の方法というわけではない。\nここは一旦退き、次なる戦いに備えることを優先せよ。", "face": "l4c6077d25df9"}, {"name": "デーモンメイジ", "text": "……承知いたしました。\n――総員、撤退！　ガード様のご命令だ！", "face": "lf74789a68062"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "？？？", "text": "……あ、あのっ。\n助けていただいてありがとうございます！", "face": "u596"}, {"name": "シャルキー", "text": "私、シャルキーっていいます。\n魔界で奴隷として暮らす、同じ境遇の人たちを\n元気づけるために踊り子になったのですが……。", "face": "u596"}, {"name": "リエーレ", "text": "デーモン共の暇つぶしのためにここに連れてこられて、\n危うく魔物のエサにされちまうとこだったってわけだ。", "face": "u490"}, {"name": "シャルキー", "text": "はい……ですから、助けていただいたお礼に\nここから先の道案内をさせてくださいませんか？", "face": "u596"}, {"name": "シャルキー", "text": "私……こっそり聞いていたんです。\nデーモン様たちがここから心臓への\n行き方について話しているのを。", "face": "u596"}, {"name": "ケイティ", "text": "……お気持ちは嬉しいですが、\nここから先は命の保証はできませんよ？", "face": "u114"}, {"name": "シャルキー", "text": "か……覚悟の上ですっ！\n皆さんに救って頂いた命ですから！", "face": "u596"}, {"name": "アンナ", "text": "……ありがとうございます、シャルキーさん。\nそれでは、ここから先の道案内をお願いしますね。"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 75, 30]}, {"kind": "term", "influence": 11, "params": [300]}, {"kind": "term", "influence": 21, "params": [150]}], "enemies": [{"enemy_id": 1, "hp": 6000, "attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2106176}, {"enemy_id": 2, "hp": 52000, "attack": 1500, "damage_type": "magical", "armor_defense": 150, "magic_defense": 40, "pattern_id": 2114128}, {"enemy_id": 4, "hp": 2000, "attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "pattern_id": 2107936}, {"enemy_id": 5, "hp": 6000, "attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "pattern_id": 2105952}, {"enemy_id": 6, "hp": 2000, "attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2100224}, {"enemy_id": 6, "form_index": 1, "hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2100208}, {"enemy_id": 8, "hp": 2700, "attack": 350, "damage_type": "physical", "armor_defense": 70, "magic_defense": 40, "pattern_id": 2098704}, {"enemy_id": 9, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "pattern_id": 2108304}, {"enemy_id": 10, "hp": 2000, "attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "pattern_id": 2100240}, {"enemy_id": 11, "hp": 4000, "attack": 330, "damage_type": "true", "armor_defense": 50, "pattern_id": 2109376}, {"enemy_id": 12, "hp": 30000, "attack": 1200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 40, "pattern_id": 2113792}, {"enemy_id": 13, "hp": 10000, "attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "pattern_id": 2100352}, {"enemy_id": 14, "hp": 30000, "attack": 400, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "pattern_id": 2098384}, {"enemy_id": 16, "hp": 15000, "attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "pattern_id": 2098288}, {"enemy_id": 17, "hp": 40000, "attack": 900, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "pattern_id": 2103488}, {"enemy_id": 19, "hp": 45000, "attack": 800, "damage_type": "magical", "armor_defense": 150, "magic_defense": 40, "pattern_id": 2110288}]}, "active": true}