": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "attack": 1, "base_hp": 200000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 44, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2097200, "special_effect_id": 516, "change_to": 9, "master_id": 36252, "global_id": 9869, "to_global_id": 9870, "to_flag": [12, 1], "route_behaviour": {"transforms": [{"flag": 12, "val": 1}], "force_dead": true}, "spawn_sec": 1}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "attack": 1, "base_hp": 200000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 44, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2097200, "special_effect_id": 1398, "master_id": 36253, "global_id": 9870, "from_flag": [12, 1]}, {"enemy_id": 11, "source": "local", "count": 34, "form_count": 1, "tags": ["召喚(グリム)"], "hp": 4000, "attack": 250, "base_hp": 4000, "base_attack": 250, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 169, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2151744, "special_effect_id": 1685, "master_id": 37317, "global_id": 10934, "spawn_sec": 78}, {"enemy_id": 12, "source": "local", "count": 9, "form_count": 1, "tags": ["召喚(グリム)"], "hp": 8000, "attack": 650, "base_hp": 8000, "base_attack": 650, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 169, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2151744, "special_effect_id": 1688, "master_id": 37330, "global_id": 10947, "spawn_sec": 131}, {"enemy_id": 13, "source": "local", "count": 5, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_range": 40, "attack_speed": 1, "attack_wait": 20, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2116736, "special_effect_id": 336, "missile_id": 11, "master_id": 37337, "global_id": 10954, "ranged": true, "spawn_sec": 184}, {"enemy_id": 14, "source": "local", "count": 5, "form_count": 1, "hp": 5500, "attack": 10, "base_hp": 5500, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_speed": 30, "attack_interval": 61, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098352, "special_effect_id": 220, "master_id": 23, "global_id": 22, "spawn_sec": 198}], "popups": ["噴霧器がいる間、\n悪天候『無気力の霧』が発生します。\n\nまた噴霧器がいる間、\n一定時間が経過するたびに\nステータスダウン効果が強化され\n最大80％までダウンします。\n　　　　　　(1/2)", "　　　　【無気力の霧】\n\n・時間経過による\n　『コスト回復量』20%低下\n・味方の『攻撃力』低下\n・一部の味方は影響を受けない\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "ベルーフェ", "text": "やーっとみつけたぁ……。\nグリム、いったい何をたくらんでるのさー！", "face": "u2125a1"}, {"name": "グリム", "text": "企んでるとか人聞きの悪い。\nちょっとヤバイやつ召喚するだけですよ？", "face": "u2127a1"}, {"name": "ベルーフェ", "text": "ヤバイんじゃん！", "face": "u2125a1"}, {"name": "グリム", "text": "まぁまぁ。成功してから許可をとればいいんです。\nそれより私たち「超実践的実験部」の発表会へ\nよく来てくれました。", "face": "u2127a1"}, {"name": "ベルーフェ", "text": "超実践的実験部……？", "face": "u2125a1"}, {"name": "シロガネ", "text": "噂で聞いたことがあるっす。\n確か廃部寸前の科学部を乗っ取って、\n日夜怪しい実験に挑むヤバイ部活らしいっす。", "face": "u2126a1"}, {"name": "アイシャ", "text": "なるほど……？\nつまりこの妙な機械の数々は、\nその超実践的な実験の成果ってことかな？", "face": "u2124a1"}, {"name": "シロガネ", "text": "いったいどこから、\nそんな潤沢な資金が……。", "face": "u2126a1"}, {"name": "グリム", "text": "資金源は王子さまですねー。", "face": "u2127a1"}, {"name": "アイシャ", "text": "予想外だけど予想通りだった。", "face": "u2124a1"}, {"name": "ベルーフェ", "text": "グリムの実力は確かだからね……。\nのびのび研究させた方がいいって判断だろうけど、\nそれにしても召喚物を野放しはよくないなぁ！", "face": "u2125a1"}, {"name": "グリム", "text": "いやぁ、さすがに人員不足でして……。\nでも聞いて下さい。\nとうとう我が部にも顧問の先生が来てくれたんです！", "face": "u2127a1"}, {"name": "アイシャ", "text": "顧問……？\nいったい誰が――", "face": "u2124a1"}, {"name": "ローパー博士", "text": "どうも。超実践的実験部顧問、\n臨時教師のローパー博士です。", "face": "l522273003f38"}, {"name": "アイシャ", "text": "ろ、ローパー博士……！？\nなんでキミが学園にいるの！？", "face": "u2124a1"}, {"name": "ローパー博士", "text": "ははは。実験資金を稼ぐ意味も含めて、\n王国学園に不法侵入就任いたしました。", "face": "l522273003f38"}, {"name": "シロガネ", "text": "要するに、勝手に入ってきて、\n勝手に生徒に授業している不審者ってことっすよね？", "face": "u2126a1"}, {"name": "グリム", "text": "確かにローパー博士先生は不審者ですけど、\n私の実験には惜しみなく協力してくれるいい先生ですよ。", "face": "u2127a1"}, {"name": "ベルーフェ", "text": "まぁ、実験するのはいいけど、\n学園のみんなが困ってるんだ。\n今回は、このへんでやめてくれないかな。", "face": "u2125a1"}, {"name": "グリム", "text": "それについては大丈夫でしょう。\n王国の皆さんは強いので、\n異界から出てきたローパーになんて負けませんしー。", "face": "u2127a1"}, {"name": "ローパー博士", "text": "とはいえ、私は顧問として、\n責任を取らなければならないことを理解しています。", "face": "l522273003f38"}, {"name": "ローパー博士", "text": "つまり……後で責任は取るので、\n今は好き放題実験したいということですよォーー！！", "face": "l522273003f38"}, {"name": "シロガネ", "text": "この人たちはダメっす！\n力ずくで止めさせないと永遠に実験するっすよ！", "face": "u2126a1"}, {"name": "ローパー博士", "text": "おっと、そうはいきませんよ！\n噴霧器を起動！　この装置から発生する奇天烈な色の霧は、\n皆様のやる気を削いでいきます！", "face": "l522273003f38"}, {"name": "ローパー博士", "text": "時間が経過するほど霧は拡散し、\n効果も強まっていきますよ！\nお嬢さんたちはいつまで耐えられますかねぇ！", "face": "l522273003f38"}, {"name": "アイシャ", "text": "裏を返せば、装置を壊せば霧は止まるはず。\n全部片づけて、グリムたちもなんとかしよう！", "face": "u2124a1"}, {"name": "グリム", "text": "そう簡単にはいきません！\nさぁ、実験開始です！", "face": "u2127a1"}]}, {"trigger": "end", "lines": [{"name": "ローパー博士", "text": "あぁ！？　私のヘソクリを使って用意した噴霧器が！？", "face": "l522273003f38"}, {"name": "シロガネ", "text": "よしっ。これで終わりっす！\n観念するっすよ！", "face": "u2126a1"}, {"name": "グリム", "text": "そんなー……。\nむ、無慈悲ですよぉ。", "face": "u2127a1"}, {"name": "ベルーフェ", "text": "そうは言うけど、こんな実験を許すわけにはいかないよ。\nそれに、もう十分やったんじゃないの？", "face": "u2125a1"}, {"name": "ローパー博士", "text": "仕方ありませんね。\n奥の手でもあれば足掻きましたが……。\n投了せざるを得ないようです。", "face": "l522273003f38"}, {"name": "ローパー博士", "text": "さぁ、グリムさん。\n王子と教師たちに謝りに行きましょう。\n大いなる実験には、大いなる責任が伴うものです。", "face": "l522273003f38"}, {"name": "グリム", "text": "――いいえ、まだ実験は終わりませんよ。", "face": "u2127a1"}, {"name": "ベルーフェ", "text": "これは……まさか、\n異界から魔物を喚び出すつもり……！？", "face": "u2125a1"}, {"name": "グリム", "text": "ええ、そうです！\nもうちょっとだけ、続けさせてもらいますよ！", "face": "u2127a1"}]}], "active": true}