{"quest_id": 8221, "name": "超実践的実験部の発表会", "description": "体育館では実験部に不法に就任した顧問と\nグリムによって発表会が強行される……。\n＜噴霧器がいる間、無気力の霧が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["噴霧器がいる間、無気力の霧が発生"], "event": "王国ナナイロ文化祭", "event_category": "History", "mission_id": 920212, "map_no": 4870, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2097200, "special_effect_id": 902, "master_id": 36265, "global_id": 9882, "route_behaviour": {"sets_flags": [[10, 1, 6500], [11, 1, 4300], [12, 1, -1]]}}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "tags": ["置物", "機械", "噴霧器"], "fixture": true, "hp": 14000, "attack": 1, "base_hp": 14000, "base_attack": 1, "damage_type": "physical", "armor_defense": 400, "attack_speed": 1, "attack_wait": 15, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2144864, "special_effect_id": 516, "change_to": 2, "master_id": 36254, "global_id": 9871, "commands": {"raw": "SetStageFlag(10, 0); SetStageFlag(11, 0); SetStageFlag(12, 0); SetStageFlag(13, 1); if ((IsStageFlag(13) == 1) && (IsStageFlag(14) == 1)) { SetStageFlag(18, 1); SetStageFlag(19, 1); }", "sets_flags": [[10, 0], [11, 0], [12, 0], [13, 1], [18, 1], [19, 1]]}, "route_behaviour": {"transforms": [{"flag": 11, "val": 1}, {"flag": 12, "val": 1}]}, "spawn_sec": 1}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "attack": 1, "base_hp": 200000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_inte