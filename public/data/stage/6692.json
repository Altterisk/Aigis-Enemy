{"quest_id": 6692, "name": "乙女たちの反撃", "description": "ついに反攻作戦を開始！　囮役のリーフに\n群がる魔界アリの軍勢を返り討ちにせよ！\n＜女性ユニットのみ出撃可＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["女性ユニットのみ出撃可"], "event": "誘惑のバレンタイン戦線", "event_category": "History", "mission_id": 920122, "map_no": 3349, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [3], "expression": "((IsGender(0) == 0) && (IsToken()) || IsGender(1) || IsPlayerSupportUnit();", "expression_human": "((it is not male) and (it is a token) or it is female or it is a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 22, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 1, "master_id": 31504, "global_id": 5123, "to_global_id": 5124, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "master_id": 31505, "global_id": 5124}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "maste