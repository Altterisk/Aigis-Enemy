: 5, "master_id": 31500, "global_id": 5119, "to_global_id": 5120, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 53}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 4, "master_id": 31501, "global_id": 5120}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 3, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111504, "race_id": 18, "change_to": 7, "master_id": 795, "global_id": 794, "to_global_id": 483, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 72}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 8, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_global_id": 624}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 7, "master_id": 625, "global_id": 624}, {"enemy_id": 10, "source": "local", "count": 12, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 10, "master_id": 986, "global_id": 985, "to_global_id": 987, "spawn_sec": 75}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 9, "master_id": 988, "global_id": 987}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 1200, "base_hp": 25000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 40, "attack_speed": 10, "attack_wait": 15, "attack_interval": 96, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106304, "race_id": 18, "master_id": 30263, "global_id": 3882, "spawn_sec": 103}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 2, "master_id": 796, "global_id": 795, "to_global_id": 484, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 111}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 3, "master_id": 485, "global_id": 484, "to_global_id": 625}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 2, "master_id": 626, "global_id": 625}], "dialogue": [{"trigger": "start", "lines": [{"name": "ケイティ", "text": "王子、バルバストラフさんらに加え、\n錬金術士や魔女の皆さんの協力もあり、\n新しい抗体の試作品が完成したとの事です。", "face": "u114"}, {"name": "コリン", "text": "完成まで漕ぎつけたのは王子の分だけ。\nフェロモンを完全に無害化する程の効力も無いが……。\nそれでも、女王アリの誘惑は無効化できるハズだ。", "face": "u227"}, {"name": "アンナ", "text": "これで、反撃の準備は整いましたね。\nそれではリーフさん、危険な役割ですが、\n打ち合わせどおり囮役をお願いして良いですか？", "face": "l713a56a6a7fc"}, {"name": "リーフ", "text": "も、もちろん、任せてください！\nすぅーはぁー……。", "face": "u747"}, {"name": "リーフ", "text": "――おーい！　あっりさーん！\nチョコレートはここにありますよー！！", "face": "u747"}, {"name": "マーヤ", "text": "……どうやら、魔物にも声が届いたみたい、です。\n大量の魔物が近寄って来る気配がします……。\n……って、え？　あ、あの魔物は……！", "face": "u338"}, {"name": "魔界アリの女王", "text": "くふふ、わざわざ妾にチョコレートを貢ぎに来るとは、\n人間の雌にしては殊勝な心がけよなぁ。", "face": "l1a2868ecbb98"}, {"name": "リーフ", "text": "女王アリ……！　ちっ、違いますよ！\nボクのチョコレートはあげませんから！\nむしろ罠にかかったのはあなたの方ですよ……！", "face": "u747"}, {"name": "マーヤ", "text": "ふぇ、フェロモンに操られた魔物たちどころか、\n女王アリをおびき出しちゃったと言う事でしょうか……。\nで、でも、考えようによっては女王を倒すチャンスかも。", "face": "u338"}, {"name": "魔界アリの女王", "text": "ふふ、おびき出しただと？　無駄な抵抗よのぅ。\nこの街は既に妾たち魔界アリの巣と化しておる。", "face": "l1a2868ecbb98"}, {"name": "魔界アリの女王", "text": "さぁ妾の可愛い魔界アリ達よ、\nそして哀れにも自ら姿を晒した王子よ、\n妾への忠誠の証として、チョコを捧げるが良い！", "face": "l1a2868ecbb98"}, {"name": "王子", "text": "…………ッ！", "face": "u1"}, {"name": "魔界アリの女王", "text": "むっ？　どういうことだ？\n王子よ、なぜ妾の命令に従わぬ……！？\nバカな……妾の誘惑が通じぬ雄がいるなど……。", "face": "l1a2868ecbb98"}, {"name": "リーフ", "text": "王子さんはあなたに操られたりなんかしません！\n――王子さんが戦えなくても、指揮があれば百人力です。\nあとはボクたち女の子にまかせてください！", "face": "u747"}, {"name": "魔界アリの女王", "text": "……む？　王子の様子を見るに、\n誘惑には耐えても、身体は自由に動かぬようじゃな……？\nならば雌共を殺し、改めて妾の物にしてやるまでの事。", "face": "l1a2868ecbb98"}, {"name": "リーフ", "text": "そんなことはさせません！\n王子さんはボクの……じゃなくて、皆の王子さんです！\n絶対に渡しませんからね……ッ！！", "face": "u747"}]}, {"trigger": "end", "lines": [{"name": "リーフ", "text": "た、倒せ、ました……？\nボクたち、勝ったんですか……？", "face": "u747"}, {"name": "ケイティ", "text": "いえ、まだ動けるようです。\n皆さん、気を抜かないでください。", "face": "u114"}, {"name": "魔界アリの女王", "text": "…………おのれ。\nおのれ人類種如きが……！！\n妾の体に傷をつけるとは……ッ！！", "face": "l1a2868ecbb98"}, {"name": "マーヤ", "text": "女王アリの体色が赤く変わっていってます……！\nい、一体、何が……！？", "face": "u338"}, {"name": "コリン", "text": "まさかフェロモン同様、\n女王アリ自身も進化しているとでも言うのか！？", "face": "u227"}, {"name": "魔界アリの女王", "text": "……もはや許さぬ。\n妾に屈辱を味わわせたその罪、\n決して許さぬぞ人間共が……っ！！", "face": "l6cecba48de90"}, {"name": "魔界アリの女王", "text": "さぁ妾の可愛い子らよ、今こそ妾のもとへ集い、\n憎き人類種の雌共を抹殺するのだ！", "face": "l6cecba48de90"}, {"name": "魔界アリの女王", "text": "その後に、有象無象の雄共を食し、\n最後に王子をゆっくり味わって喰ろうてやろう……。", "face": "l6cecba48de90"}, {"name": "ケイティ", "text": "……くっ、魔界アリだけでなく、\nフェロモンで操っているゴブリンやマーマンの部隊まで、\nこの地に呼び寄せたようですね。", "face": "u114"}, {"name": "アンナ", "text": "……皆さん、苦しい状況ではありますが、\nここで女王アリを倒せば、\n事件の原因を叩くことが出来ます。", "face": "l713a56a6a7fc"}, {"name": "リーフ", "text": "そ、そうです！　これは街の平和だけじゃなくて、\n女の子の大事なバレンタインをかけた戦いですから。\n――皆さん、決着を付けますよ……！！", "face": "u747"}]}], "story_talk": true, "active": true}