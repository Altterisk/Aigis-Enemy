ense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 24}, {"enemy_id": 8, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 700, "attack": 120, "base_hp": 700, "base_attack": 120, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 126, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121600, "race_id": 16, "master_id": 32453, "global_id": 6072, "spawn_sec": 34}, {"enemy_id": 9, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 57}, {"enemy_id": 10, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 87}], "dialogue": [{"trigger": "start", "lines": [{"name": "ソーマ", "text": "この温泉宿、とっても広いんですね。\n全部を見回るだけでもすごい時間が……。", "face": "u1138a1"}, {"name": "カノン", "text": "温泉街に魔物の卵を持ち込んだ犯人。\nグレーターデーモンはすぐに会えるって\n言ってたけど、いったいどこにいるのかしら？", "face": "u1417a1"}, {"name": "副デーモンシェフ", "text": "……おや？　皆さんどうしてこちらに？", "face": "la572a6b4455b"}, {"name": "フィーヌ", "text": "副デーモンシェフさん！？\nそちらこそどうしてここに！？", "face": "u1415a1"}, {"name": "副デーモンシェフ", "text": "デモシェフ商会の福利厚生の一環として、\n社員一同で温泉旅行に来ているのですが……。\nそんなに慌てて、どうなされたのですか？", "face": "la572a6b4455b"}, {"name": "シュシュ", "text": "かくかくしかじかです！", "face": "u979"}, {"name": "副デーモンシェフ", "text": "……なるほど、温泉にドラコリザードが。\n了解しました、我らも避難を開始します。", "face": "la572a6b4455b"}, {"name": "エマ", "text": "……お待ちを、副デーモンシェフ。\nあれだけの騒ぎがあって貴方は本当に、\n今の今まで気づいていなかったのですか？", "face": "u1137a1"}, {"name": "副デーモンシェフ", "text": "いえ、その……温泉に入っていたもので……。", "face": "la572a6b4455b"}, {"name": "エマ", "text": "グレーターデーモンは全て喋りましたよ？", "face": "u1137a1"}, {"name": "副デーモンシェフ", "text": "なっ！　あいついくら払ったと──しまった！？", "face": "la572a6b4455b"}, {"name": "エマ", "text": "尻尾を出しましたね。\nリズリーさん、お願いします。", "face": "u1137a1"}, {"name": "リズリー", "text": "おっ、出番？　さあ、どこかなどこかな～♪\nどこに隠れてるのかな～♪　おや、ここかな～？", "face": "u977"}, {"name": "デーモンシェフ", "text": "──っ！？", "face": "l1c8712e99c4e"}, {"name": "フィーヌ", "text": "あれはデーモンシェフさん！？\nそれに運んでいるのはドラコリザードの……\nいえ、もっと大きい魔物の卵です！！", "face": "u1415a1"}, {"name": "副デーモンシェフ", "text": "シェフ逃げてください！　ここは私が！", "face": "la572a6b4455b"}, {"name": "フィーヌ", "text": "……副デーモンシェフさん、どういうことですか。", "face": "u1415a1"}, {"name": "副デーモンシェフ", "text": "……こちらにも事情があるのです。", "face": "la572a6b4455b"}, {"name": "フィーヌ", "text": "副デーモンシェフさん！！", "face": "u1415a1"}, {"name": "エマ", "text": "フィーヌさん、もはや言葉は不要でしょう。\n皆さん戦闘準備を、ここで彼らを止めます。", "face": "u1137a1"}]}, {"trigger": "end", "lines": [{"name": "カノン", "text": "戦闘終了……だけど、\n肝心のデーモンシェフたちには、\nどさくさで逃げられちゃったわね。", "face": "u1417a1"}, {"name": "ソーマ", "text": "まさかデーモンシェフさんが犯人だったなんて……。", "face": "u1138a1"}, {"name": "フィーヌ", "text": "………………。", "face": "u1415a1"}, {"name": "エマ", "text": "裏切られた、という気持ちはあるでしょう。\nしかし彼は、極めて理性的なデーモンです。\n今になって短慮を起こしたとは、到底思えません。", "face": "u1137a1"}, {"name": "エマ", "text": "何か隠された事情があるはずです。\nそれを聞き出すためにも、彼らを止めなくては。", "face": "u1137a1"}, {"name": "フィーヌ", "text": "……そうですね、\n落ち込んでる暇なんてありません！", "face": "u1415a1"}]}], "map": {"image": "Map920171_4060", "w": 960, "h": 640, "spots": [{"k": "b", "x": 449, "y": 518}, {"k": "m", "x": 433, "y": 188, "id": 200}, {"k": "m", "x": 350, "y": 245, "id": 201}, {"k": "m", "x": 238, "y": 252, "id": 202}, {"k": "m", "x": 119, "y": 251, "id": 203}, {"k": "m", "x": 198, "y": 386, "id": 204}, {"k": "m", "x": 330, "y": 402, "id": 205}, {"k": "m", "x": 440, "y": 444, "id": 206}, {"k": "m", "x": 519, "y": 364, "id": 207}, {"k": "m", "x": 635, "y": 331, "id": 208}, {"k": "m", "x": 722, "y": 278, "id": 209}, {"k": "m", "x": 717, "y": 178, "id": 210}, {"k": "m", "x": 454, "y": 102, "id": 211}, {"k": "m", "x": 670, "y": 93, "id": 212}, {"k": "m", "x": 816, "y": 139, "id": 213}, {"k": "r", "x": 538, "y": 484, "id": 300}, {"k": "r", "x": 753, "y": 377, "id": 301}, {"k": "r", "x": 376, "y": 351, "id": 302}, {"k": "r", "x": 285, "y": 464, "id": 303}, {"k": "r", "x": 173, "y": 460, "id": 304}, {"k": "r", "x": 121, "y": 182, "id": 305}, {"k": "r", "x": 452, "y": 331, "id": 306}, {"k": "r", "x": 596, "y": 133, "id": 307}, {"k": "r", "x": 747, "y": 96, "id": 308}, {"k": "r", "x": 66, "y": 394, "id": 309}]}, "start_cost": 10, "active": true}