{"quest_id": 6922, "name": "化け河童", "description": "里を目指す王子たちに河童が襲い掛かる。\n化ける力で調子づく河童たちを\n懲らしめろ。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "あやかし狸大合戦", "event_category": "History", "mission_id": 920137, "map_no": 5516, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 23, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 15, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 100, "attack_speed": 180, "attack_wait": 60, "attack_interval": 181, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 961, "global_id": 960, "ranged": true, "spawn_sec": 34}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 57}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 4, "hp": 3500, "attack": 200, "base_hp": 3500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "magic_defense": 15, "attack_range": 100, "attack_speed": 180, "attack_wait": 60, "attack_interval": 181, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "special_effect_id": 222, "change_to": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 32137, "global_id": 5756, "ranged": true, "to_global_id": 5757, "spawn_sec": 135}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 6000, "attack": 360, "base_hp": 6000, "base_attack": 360, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "attack_wait": 30, "attack_interval": 122, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107984, "race_id": 4, "special_effect_id": 415, "change_to": 5, "master_id": 32138, "global_id": 5757, "to_global_id": 5758}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 6000, "attack": 360, "base_hp": 6000, "base_attack": 360, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 6, "master_id": 32139, "global_id": 5758, "to_global_id": 5759}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["ステルス"], "hp": 6000, "attack": 360, "base_hp": 6000, "base_attack": 360, "damage_type": "physical", "armor_defense": 200, "attack_range": 160, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109632, "race_id": 4, "special_effect_id": 222, "change_to": 7, "change_condition": 1, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 32140, "global_id": 5759, "ranged": true, "variants": [{"hp": 6000, "attack": 360, "base_hp": 6000, "base_attack": 360, "damage_type": "physical", "armor_defense": 200, "attack_range": 160, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2109584, "race_id": 4, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 32141, "global_id": 5760, "ranged": true}]}], "dialogue": [{"trigger": "start", "lines": [{"name": "たぬきの里の長", "text": "――こっちぽん！\nこの川を越えていくのが、\nスズネちゃんの里への近道なんだぽん！", "face": "u1019a1"}, {"name": "サギリ", "text": "へぇ……本当かねぇ？\nこの先、随分と生臭いぜ？", "face": "u869"}, {"name": "たぬきの里の長", "text": "た、たぬ？　どういう意味だぽん？", "face": "u1019a1"}, {"name": "サギリ", "text": "――ふんっ、その反応、\nどうやら騙してるわけじゃなさそうだな。\nおい王子、この先に河童共が隠れてるぞ！", "face": "u869"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "河童", "text": "――ヒャッハァ！\nバレちまったら仕方ねェ！\n野郎ども、ヤッチマイナ～！！", "face": "lf7d7bb407567"}, {"name": "たぬきの里の長", "text": "たぬぬっ！　あの河童が持ってるの、\nボクさまの里の特製木の葉だぽん……！！", "face": "u1019a1"}, {"name": "河童", "text": "アァン？　この木の葉か？\nケッケッケ、こいつはスズネって妖狸がくれたのサ！", "face": "lf7d7bb407567"}, {"name": "河童", "text": "これだけの変化の力があれば、\n妖怪総大将にだって変身できちまうゼェ～！", "face": "lf7d7bb407567"}, {"name": "サギリ", "text": "……聞き捨てならねぇな。\n妖怪総大将になるのはこのあたしだ。\nそれまでシノの名前を汚させはしねぇぞ！！", "face": "u869"}, {"name": "サギリ", "text": "王子、魔力がバンバン漏れ出してる河童に気をつけな。\nシノに変身しようなんざ、\n千年早いって教えてやろうぜッ！！", "face": "u869"}]}, {"trigger": "end", "lines": [{"name": "河童", "text": "ヒェェ～ッ！！\nこ、木の葉はお返ししますゥゥゥ！\nどうか命だけはァ～ッ！！", "face": "lf7d7bb407567"}, {"name": "サギリ", "text": "調子のいい奴らだな、まったく……。\nほらたぬぽん様よ、\nこの木の葉はあんたの里のなんだろ？", "face": "u869"}, {"name": "たぬきの里の長", "text": "たぬぬ、やっぱりボクさまの里の木の葉だぽん。\n――って、たぬぽんじゃないぽん！　ボクさまだぽん！", "face": "u1019a1"}, {"name": "アンナ", "text": "……ということは、本当にスズネさんという方が、\n奪った木の葉をばら撒いた、\nということなのでしょうか……？", "face": "l48e06ddcbb07"}, {"name": "たぬきの里の長", "text": "そんな酷いことする子じゃないはずぽん……。\nやっぱり、誰かに脅されてるのかもしれないぽん。", "face": "u1019a1"}, {"name": "ホムラ", "text": "王子、先を急ごう。\nこれだけの魔力が込められた木の葉が、\nあちこちにばら撒かれたら大変なことになっちまう。", "face": "u739"}]}, {"trigger": "end", "lines": [{"name": "スズネ", "text": "（……ボクさまちゃん、ごめんなさいぽん）", "face": "u936"}, {"name": "スズネ", "text": "（でも、あの人に命を救ってもらった恩義を、\n返さないといけないのですぽん……！）", "face": "u936"}, {"name": "スズネ", "text": "（って、あぁぁ～！！\nこのままじゃ置いていかれてしまいますぽん！\n急いで追いかけないとですぽん～！！）", "face": "u936"}]}], "active": true}