amage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126912, "race_id": 20, "change_to": 18, "change_condition": 4, "master_id": 33344, "global_id": 6961, "to_condition": 4, "to_ticks": 1, "to_global_id": 6962}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 2800, "attack": 280, "base_hp": 2800, "base_attack": 280, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126896, "race_id": 20, "master_id": 33345, "global_id": 6962, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 340, "attack_speed": 10, "attack_wait": 60, "attack_interval": 171, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2156336, "race_id": 22, "special_effect_id": 1176, "change_to": 20, "master_id": 37930, "global_id": 11547, "to_global_id": 11548, "to_flag": [2, 1], "route_behaviour": {"transforms": [{"flag": 2, "val": 1}], "sets_flags": [[2, 1, 80]]}, "spawn_sec": 225}, {"enemy_id": 20, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 340, "attack_speed": 10, "attack_wait": 60, "attack_interval": 171, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2156352, "race_id": 22, "master_id": 37931, "global_id": 11548, "from_flag": [2, 1]}], "popups": ["ヘラクレイアは、\n拠点には向かわず\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。", "各種天界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。", "天槍騎兵団は突撃中、\nブロックすると、\n一度だけ強力な攻撃を行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――退け。\n戦士でない者を殺す趣味はない。", "face": "lded377ee3c3f"}, {"name": "？？？", "text": "では、退く理由がありません。\n世界最強最速の私が、戦士に見えないと？", "face": "u2276a1"}, {"name": "ユリクセス", "text": "やめろパルセ！\nお前はまだ、戦える身体じゃないんだぞ！", "face": "u2193a1"}, {"name": "パルセ", "text": "…………。\nさぁヘラクレイア、一騎打ちです。\n私に勝てると思っているなら、かかってきなさい。", "face": "u2276a1"}, {"name": "ユリクセス", "text": "こいつ！　僕の言葉を無視したな！？\nまだ神獣の頃の矜持を引きずってるだろう！？", "face": "u2193a1"}, {"name": "パルセ", "text": "怪我人に発言権はありません。\n私をかばって負傷した大馬鹿天才はお黙りを。", "face": "u2276a1"}, {"name": "パルセ", "text": "女神アイギスより賜りし、我が使命は人類の守護。\n神獣から人型になってもそれは変わりません。", "face": "u2276a1"}, {"name": "パルセ", "text": "それに、ここで彼女を止めなければ、\nただでさえ天界兵に破壊されている私の身体が、\n完全破壊されかねません。", "face": "u2276a1"}, {"name": "ヘラクレイア", "text": "ほう、神獣……？\nさては破壊対象の――神獣ユニコーンの化身か。", "face": "lded377ee3c3f"}, {"name": "ヘラクレイア", "text": "ならば、立っているだけでも辛そうな、\nその様は演技ということか。", "face": "lded377ee3c3f"}, {"name": "ヘラクレイア", "text": "ならば、望みどおり相手をしよう。\nいずれにせよ、斬ってみれば分かることだ。", "face": "lded377ee3c3f"}, {"name": "ユリクセス", "text": "パルセ！　もういい！\n僕のことは捨てて早く逃げ――", "face": "u2193a1"}, {"name": "ヘラクレイア", "text": "…………ん。\nこの匂い……戦士の気配だ。", "face": "lded377ee3c3f"}, {"name": "ヘラクレイア", "text": "――ようやく来たか、王国軍。", "face": "lded377ee3c3f"}, {"name": "アキレア", "text": "おらァ！　頭脳労働担当者に何してくれやがる！\n無事かユリクセス！　ユニコーンの小娘！", "face": "u1972a1"}, {"name": "ユリクセス", "text": "重傷だ、正直動きたくない！\nそれよりアキレア、船体を破壊している天界兵を潰せ！", "face": "u2193a1"}, {"name": "アキレア", "text": "あぁ？　このデッカイ女はいいのか？", "face": "u1972a1"}, {"name": "ユリクセス", "text": "こいつは例外中の例外なんだ！\nこういう奴の担当は王子の本隊に任せろ！", "face": "u2193a1"}, {"name": "ヘラクレイア", "text": "例外、か……。\nなるほど、悪くない気分だ。\n人間だったころの感情が蘇ってくる。", "face": "lded377ee3c3f"}, {"name": "ヘラクレイア", "text": "神の座を拒否した男、王国の王子。\n真逆の道を選んだお前の剣技、見せてもらう。", "face": "lded377ee3c3f"}, {"name": "ヘラクレイア", "text": "――我が名はヘラクレイア。\n殺されたい者から前に出ろ。", "face": "lded377ee3c3f"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "――ヘラクレイア、そろそろ撤退を。", "face": "l62998838a8cf"}, {"name": "ヘラクレイア", "text": "……ガレアか。なぜだ？\nこの船を破壊するのが目的じゃないのか。", "face": "lded377ee3c3f"}, {"name": "ガレア", "text": "目的は時間稼ぎだからね。\nそれに、君をここで失うと計画に支障が出る。", "face": "l62998838a8cf"}, {"name": "ヘラクレイア", "text": "負ける、と言いたいのか。\n半神となったこの身が。", "face": "lded377ee3c3f"}, {"name": "ガレア", "text": "君の強さは知っている。\nでも、ここは僕の計略に乗ってくれないかい？", "face": "l62998838a8cf"}, {"name": "ヘラクレイア", "text": "……ふん。", "face": "lded377ee3c3f"}, {"name": "ガレア", "text": "さて、天界兵の諸君も撤退だ！\n破壊活動ご苦労！", "face": "l62998838a8cf"}, {"name": "ユリクセス", "text": "待てぇぇぇッ！！\nガレア、やはり貴様か！！", "face": "u2193a1"}, {"name": "ユリクセス", "text": "おかしいと思ったんだ。\n亜神ディアスが眠っているというのに、\n天界兵がやけに上手く用兵されていたからな。", "face": "u2193a1"}, {"name": "ガレア", "text": "気付いていて襲撃を防げないとは、\n常勝の智将の勘も鈍ったのかな？", "face": "l62998838a8cf"}, {"name": "ユリクセス", "text": "魔術ギルドの総力で編み上げた転移妨害魔法だぞ！\nそれをぶち破ってくる奴がいるとか、\nいったいどこの誰が予想するんだ！", "face": "u2193a1"}, {"name": "ガレア", "text": "君なら予想して、対策までしてくると思ったんだけどね。\nなにしろ、これは転移魔法じゃない、\n女神アイギスに奪われた召喚魔法の疑似再現だ。", "face": "l62998838a8cf"}, {"name": "ガレア", "text": "開戦前には、いつも「ディアスの加護を！」って\n祈りを捧げていたんだから、僕が加護を\n受けた相手がディアス様だって、気付いてただろうに。", "face": "l62998838a8cf"}, {"name": "ユリクセス", "text": "ディアスへの祈りの言葉、か。\nあんなもの、戦場の作法だと思うだろう、普通は！", "face": "u2193a1"}, {"name": "ガレア", "text": "ははっ、まぁいいさ。\n君と話していると、すぐ罠にかけられるからね。\n雑談はこれくらいにしておこう。", "face": "l62998838a8cf"}, {"name": "ガレア", "text": "では、また会おう。\n常勝の智将殿に――不敗を誓った王国の王子。", "face": "l62998838a8cf"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "フローガ", "text": "……天界兵が消え――いえ、転移しました。\n恐ろしいくらいに大出力の転移魔法です。", "face": "u878"}, {"name": "ユリクセス", "text": "…………はぁ。\nまた頭痛の種が増えたぞ、まったく。", "face": "u2193a1"}]}], "active": true}