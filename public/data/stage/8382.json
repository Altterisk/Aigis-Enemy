{"quest_id": 8382, "name": "神獣ユニコーンの化身", "description": "天界軍の襲撃を受けた現場へ駆けつける\n王子一行。そこには敵将ヘラクレイアと\n対峙する一人のオートマタがいて……？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "空へ", "event_category": "History", "mission_id": 920221, "map_no": 4948, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "physical", "armor_defense": 340, "attack_speed": 10, "attack_wait": 60, "attack_interval": 171, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2156416, "change_to": 1, "master_id": 37965, "global_id": 11582, "route_behaviour": {"transforms": [{"flag": 1, "val": 1}], "sets_flags": [[1, 1, 80]]}}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 128000, "attack": 3000, "base_hp": 128000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1800, "magic_defense": 50, "attack_range": 60, "attack_speed": 1, "attack_wait": 60, "attack_interval": 157, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "pattern_id": 2156320, "race_id": 22, "special_effect_id": 1434, "missile_id": 45, "master_id": 37932, "global_id": 11549, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 18, "form_count": 2, "hp": 2000, "attack": 240, "base_hp": 2000, "base_attack": 240, "damage_type": "physical", "armor_defense": 120, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124128, "race_id": 20, "change_to": 4, "change_condition": 4, "master_id": 33352, "global_id": 6969, "to_condition": 4, "to_ticks": 3, "to_global_id": 6972, "spawn_sec": 52}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 480, "base_hp": 2000, "base_attack": 480, "damage_type": "true", "armor_defe