 "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 50, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121360, "race_id": 3, "special_effect_id": 234, "change_to": 6, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 32296, "global_id": 5915, "to_global_id": 5914, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 76}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["バレンタイン"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 1200, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121344, "race_id": 3, "special_effect_id": 234, "change_to": 7, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 32295, "global_id": 5914, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "tags": ["バレンタイン"], "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 600, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121312, "race_id": 3, "master_id": 32293, "global_id": 5912, "spawn_sec": 86}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン", "text": "ギャギャ！　工場長！\n王子タチ！　キタ！　王子！　キタ！！", "face": "l07267ed6c1ce"}, {"name": "デーモンシェフ", "text": "えぇい、今は工場長ではない！\nおしゃれで素敵なデーモンシェフと呼べ！！", "face": "l1cb44203deef"}, {"name": "ゴブリン", "text": "ギャギャ！　デーモンシェフ！\n王子タチ！　スグソコ！　アブナイ！", "face": "l07267ed6c1ce"}, {"name": "デーモンシェフ", "text": "はぁ、まったく、案ずるでない。\n如何に魔王様を倒した王子達とて、\n我がお菓子工場職員にはかなうまい。", "face": "l1cb44203deef"}, {"name": "デーモンシェフ", "text": "何しろ配下のデーモン達は、\nチョコレートコーティングが\n既に完了しているのだからな！！", "face": "l1cb44203deef"}, {"name": "ゴブリン", "text": "……ギャギャ？　チョコ？　コーティング？", "face": "l07267ed6c1ce"}]}, {"trigger": "start", "lines": [{"name": "シャルキー", "text": "――ここが『お菓子工場』ですか……？\nすんすん……確かにあまい香りがします！", "face": "u965"}, {"name": "リノ", "text": "あっ、あっちにデーモン型のチョコもあるよ！\nさすがにあの形は、食べたいとは思えないなぁ……。", "face": "u590"}, {"name": "アリス", "text": "……あれ？\n今、あのデーモン型のチョコ、動きませんでした？", "face": "u589"}, {"name": "シャルキー", "text": "えぇっ、そんなまさか……って、\nほ、ほんとに動いてます！\n王子様ぁっ！　あれ動いてますよー！", "face": "u965"}, {"name": "エーテル", "text": "マイコニド型やトレント型のチョコが動くのですから、\nデーモン型が動いても不思議ではないですよね……。", "face": "u215"}, {"name": "オーガスタ", "text": "でもあのチョコ、随分と硬そうですねぇ。\n子供やお年寄りのことを考えない、\nカチコチチョコな気がしますよ……？", "face": "u960"}, {"name": "リノ", "text": "へぇ、そんなに硬いチョコが相手なら、\n物理攻撃よりも、\n魔法でどかんと攻撃した方が良いかもね。", "face": "u590"}, {"name": "アンナ", "text": "相手はお菓子のような見た目ではありますが、\n正真正銘、本物の魔物です。\n王子、慎重な采配をお願いします！", "face": "lff330ed655d9"}]}, {"trigger": "end", "lines": [{"name": "シャルキー", "text": "うわぁ、チョコでできた魔物だと思ったら、\n魔物をチョコでコーティングしてたんですね。", "face": "u965"}, {"name": "エーテル", "text": "なるほど、チョコで出来た鎧ということですか。\n食べ物で遊ぶなんて、お行儀の悪い工場ですね……。", "face": "u215"}, {"name": "シャルキー", "text": "ともかく、魔物は鎮圧できました！\n王子様『お菓子工場』を作った黒幕を捜索しましょう！", "face": "u965"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "シャルキー", "text": "バレンタインの祝祭を邪魔するなんて、\nぜーったいに許さないんですからー！", "face": "u965"}, {"name": "ゴブリン", "text": "――ギャギャ！　チョコデーモン！　ヤラレタ！", "face": "l07267ed6c1ce"}, {"name": "デーモンシェフ", "text": "まだ慌てるような段階ではない……。\nだが通常のチョコ職員だけでは\n戦力が足りないのもまた事実。", "face": "l1cb44203deef"}, {"name": "デーモンシェフ", "text": "念には念を入れ、\n新たに配属した職員を送り込むとしよう……。", "face": "l1cb44203deef"}, {"name": "デーモンシェフ", "text": "さぁ王子達よ、\nおしゃれで素敵なデーモンシェフのお菓子工場を、\nたっぷりと味わっていくがよい……！！", "face": "l1cb44203deef"}]}], "story_talk": true, "active": true}