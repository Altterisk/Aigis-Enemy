{"quest_id": 8075, "name": "大地を揺るがす木馬", "description": "天界軍を乗せアイギス神殿に\n迫りくる巨大な木馬を撃破せよ！\n＜広域戦闘：敵味方の射程減少＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "人である者、神に生まれた者", "event_category": "History", "mission_id": 920204, "map_no": 4792, "level": 100, "multiplier": 1.0, "charisma": 65, "exp": 300, "gold": 1500, "drops": [{"card": 242, "c": 1}, {"card": 150, "c": 1}, {"card": 139, "c": 1}, {"item": 2001, "c": 2}, {"item": 5003, "c": 2}], "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 125000, "attack": 2000, "base_hp": 125000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 900, "magic_defense": 20, "attack_speed": 1, "attack_wait": 120, "attack_interval": 472, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2147808, "race_id": 15, "special_effect_id": 1545, "change_to": 1, "master_id": 36579, "global_id": 10196, "to_condition": 0, "to_global_id": 10197, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag(1, 1);\");", "sets_flags": [[1, 1]], "on_destroy": true}, "route_behaviour": {"transforms": [{"wait": 96}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ブロック不可"], "hp": 125000, "base_hp": 125000, "damage_type": "magical", "armor_defense": 900, "magic_defense": 20, "attack_speed": 1, "attack_wait": 120, "attack_interval": 304, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2147824, "race_id": 15, "change_to": 2, "master_id": 36580, "global_id": 10197, "from_condition": 0}, {"enemy_id": 5, "source": "local", "count": 3, "form_index": 0, "form_count": 3, "hp": 17000, "attack": 1000, "base_hp": 17000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 19