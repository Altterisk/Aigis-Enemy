, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2147728, "race_id": 20, "special_effect_id": 1540, "master_id": 36573, "global_id": 10190, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 27, "source": "local", "count": 6, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124192, "race_id": 20, "change_to": 27, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32923, "global_id": 6540, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6543, "spawn_sec": 117}, {"enemy_id": 27, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124208, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32926, "global_id": 6543, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 31, "source": "local", "count": 1, "form_count": 2, "hp": 5000, "attack": 560, "base_hp": 5000, "base_attack": 560, "damage_type": "physical", "armor_defense": 240, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124096, "race_id": 20, "change_to": 31, "change_condition": 4, "master_id": 33356, "global_id": 6973, "to_condition": 4, "to_ticks": 3, "to_global_id": 6976, "spawn_sec": 122}, {"enemy_id": 31, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1120, "base_hp": 5000, "base_attack": 1120, "damage_type": "true", "armor_defense": 240, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 33359, "global_id": 6976, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 2, "hp": 17000, "attack": 1000, "base_hp": 17000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2147904, "race_id": 20, "change_to": 6, "change_condition": 4, "master_id": 36587, "global_id": 10204, "to_condition": 4, "to_ticks": 3, "to_global_id": 10207, "spawn_sec": 145}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 17000, "attack": 1800, "base_hp": 17000, "base_attack": 1800, "damage_type": "true", "armor_defense": 400, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2147920, "race_id": 20, "special_effect_id": 222, "master_id": 36590, "global_id": 10207, "from_condition": 4, "trigger_ticks": 3}], "popups": ["木馬が特定の位置に到着すると、\n内部から増援が出現します。\n木馬を撃破すると、\n内部の敵も同時に\n倒すことができます。"], "dialogue": [{"trigger": "battle", "at_sec": 5, "lines": [{"name": "レーヴ", "text": "――わぁ、でっかい木馬ですよ。\n神殿からでもよく見えますねぇ。", "face": "u454"}, {"name": "エクス", "text": "えぇ、ここから見ると小さく見えますが、\n実際にはほら、あの山に匹敵する大きさのようですわよ？", "face": "u487"}, {"name": "フェルミ", "text": "落ち着いてる場合じゃ――いえ、\n落ち着いていた方がいいんだけど……。", "face": "u324"}, {"name": "レーヴ", "text": "正直、巨大すぎて感覚が麻痺してしまいますね。\n集中しないといけないんですけど、\n何というのか、あまりに馬鹿げた光景で。", "face": "u454"}, {"name": "レーヴ", "text": "巨大すぎますからね……。\nあれはおそらく、千年戦争当時に、\nアイギス様が作り上げた神獣だと思います。", "face": "u454"}, {"name": "レーヴ", "text": "伝承に残る姿とは違いすぎるので、\nもはや、ただの「木馬」としか言えませんが。", "face": "u454"}, {"name": "エクス", "text": "原型が残ってないということ？\n神獣の改造だなんて、そんなことできるのかしら？", "face": "u487"}, {"name": "レーヴ", "text": "あれは特殊な神獣なので、\n比較的容易だったのではないかと。", "face": "u454"}, {"name": "レーヴ", "text": "伝承にいわく、アイギス様の作り上げた「木馬」は、\n兵員輸送を目的とした堅牢なものだったそうです。", "face": "u454"}, {"name": "レーヴ", "text": "生命体というより、むしろ乗り物に近い存在です。\nなので、他の神がそれを鹵獲し、\n改造したとしても不思議ではないかと。", "face": "u454"}, {"name": "伝令兵", "text": "――で、伝令ッ！\n仮称「木馬」、動き始めました！！", "face": "u64"}, {"name": "フェルミ", "text": "……やるしか、ないみたいね。", "face": "u324"}, {"name": "エクス", "text": "でも、あんなの足止めできるかしら？", "face": "u487"}, {"name": "レーヴ", "text": "足止めは考えないほうがいいと思います。\n伝承によれば、侵攻経路上に立ちはだかる者には、\n強力な火炎を放っていたと書き残されていますので。", "face": "u454"}, {"name": "フェルミ", "text": "つまり、あいつが神殿に到達する前に、\n遠距離からの攻撃を集中して叩くしかない、っと。", "face": "u324"}, {"name": "レーヴ", "text": "さらには、あの内部には敵兵が大勢乗っているはずです。\nそちらにも注意したほうが良いかと。", "face": "u454"}, {"name": "エクス", "text": "方針は決まりましたわね。\nさぁ、アイギス神殿を守りますわよ！", "face": "u487"}]}, {"trigger": "end", "lines": [{"name": "エクス", "text": "完全撃破、とはいきませんわね……！", "face": "u487"}, {"name": "フェルミ", "text": "改造されているとは言っても、\n元が神獣だけあるわね。", "face": "u324"}, {"name": "アキレア", "text": "――そうさ。\nこれがお前達の信じる、女神アイギスの力の一端だ。", "face": "u1972a1"}, {"name": "クレイブ", "text": "……とうとう来ましたか、半神アキレア。", "face": "u8"}, {"name": "アキレア", "text": "人が神に見初められた逸話は数あれど、\n人が神に打ち勝った逸話は、そう多くない。", "face": "u1972a1"}, {"name": "アキレア", "text": "お前たちが心酔してる王子だってそうだ。\n神の助力なしに、あのガリウスに勝てたか？\n本当に人類の力だけで勝てたって言えるのか？", "face": "u1972a1"}, {"name": "アキレア", "text": "諦めないなんて言葉、言うだけなら簡単なんだよ。\nそれをやり遂げる覚悟と実力、\nてめぇにあんのかよ、なぁ、王子ッ！！", "face": "u1972a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アキレア", "text": "……へぇ。噛み付いてくるかと思ったが、\n自分の器ってやつは、ちゃんと分かってるみたいだな。", "face": "u1972a1"}, {"name": "アキレア", "text": "王子、お前に覚悟があるのは、分かってる。\nだが覚悟だけじゃ、神は殺せない。", "face": "u1972a1"}, {"name": "アキレア", "text": "この世界はな、どこまで行っても、\n創造神が作った箱庭なんだよ。\n神の手から逃れることは、できないんだ。", "face": "u1972a1"}, {"name": "アトナテス", "text": "――それで、諦めたのかよ。\n諦めて、人を捨てて、神になったのか？", "face": "u908"}, {"name": "アキレア", "text": "……ああ。\n自分じゃ選んだつもりだったけど、\n俺様は、諦めたんだろうな、あの時に。", "face": "u1972a1"}, {"name": "アキレア", "text": "守りたいものを守るためには、力が必要だった。\n自分の中には、人と神の血が流れていて、\nどちらの道にも進むことができた。", "face": "u1972a1"}, {"name": "アキレア", "text": "だから、神になって、\n守りたいものを守ることにしたんだ。", "face": "u1972a1"}, {"name": "アキレア", "text": "人のまま、守りたいものを守ろうと\n魔界に行ったお前からみたら、滑稽だろ。", "face": "u1972a1"}, {"name": "アトナテス", "text": "自分の覚悟を、滑稽だなんて言うんじゃねぇよ。\n諦めだろうがなんだろうが、\nお前が救った連中まで嘲笑うことになっちまうぜ。", "face": "u908"}, {"name": "アキレア", "text": "ちっ……お前が諦めたとか言うからだろうが！\nあーもう！　調子が狂う……！", "face": "u1972a1"}, {"name": "王子", "text": "…………アキレア。", "face": "u1"}, {"name": "アキレア", "text": "…………何だよ、王子。", "face": "u1972a1"}, {"name": "王子", "text": "俺たちと共に、来ないか。", "face": "u1"}, {"name": "アキレア", "text": "けっ……いいぜ、それも悪くない。\nだが、その前に俺様は、やらなくちゃいけないことがある。", "face": "u1972a1"}, {"name": "アキレア", "text": "さぁ始めようぜ、この世界最後の戦争を！！", "face": "u1972a1"}]}], "active": true}