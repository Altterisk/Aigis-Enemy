name": "サラサ", "text": "頼りになるじゃない。\n次はどこに行くのかしら？", "face": "u317"}, {"name": "暗黒騎士デシウス", "text": "なに、ちょっと雪山にな。\n手なずけられそうな奴らもいるしな。\nさぁ行くぞ。", "face": "l3211f683040c"}, {"name": "アンナ", "text": "王子！　暗黒騎士団が撤退していきます。\nどういう事でしょうか。\nあとを追いましょう。", "face": "lbbf1ee25fd02"}]}], "map": {"image": "Map920057_3150", "w": 960, "h": 640, "spots": [{"k": "b", "x": 824, "y": 116}, {"k": "b", "x": 779, "y": 525}, {"k": "m", "x": 703, "y": 412, "id": 200}, {"k": "m", "x": 738, "y": 252, "id": 201}, {"k": "m", "x": 571, "y": 317, "id": 202}, {"k": "m", "x": 603, "y": 234, "id": 203}, {"k": "m", "x": 517, "y": 204, "id": 204}, {"k": "m", "x": 428, "y": 188, "id": 205}, {"k": "m", "x": 263, "y": 225, "id": 206}, {"k": "m", "x": 616, "y": 406, "id": 207}, {"k": "m", "x": 451, "y": 428, "id": 208}, {"k": "m", "x": 360, "y": 417, "id": 209}, {"k": "m", "x": 273, "y": 383, "id": 210}, {"k": "m", "x": 236, "y": 310, "id": 211}, {"k": "m", "x": 537, "y": 400, "id": 212}, {"k": "m", "x": 872, "y": 248, "id": 213}, {"k": "m", "x": 814, "y": 422, "id": 214}, {"k": "m", "x": 881, "y": 335, "id": 215}, {"k": "m", "x": 342, "y": 187, "id": 216}, {"k": "r", "x": 645, "y": 330, "id": 300}, {"k": "r", "x": 812, "y": 332, "id": 301}, {"k": "r", "x": 453, "y": 245, "id": 302}, {"k": "r", "x": 351, "y": 344, "id": 303}, {"k": "r", "x": 516, "y": 153, "id": 304}, {"k": "r", "x": 433, "y": 136, "id": 305}, {"k": "r", "x": 338, "y": 133, "id": 306}, {"k": "r", "x": 250, "y": 154, "id": 307}, {"k": "r", "x": 192, "y": 209, "id": 308}, {"k": "r", "x": 468, "y": 479, "id": 309}, {"k": "r", "x": 304, "y": 470, "id": 310}, {"k": "r", "x": 189, "y": 384, "id": 311}]}, "start_cost": 10, "active": true, "name_en": "Dark Bow Cavalry", "description_en": "Beware the Dark Knight's bow cavalry\nracing across the battlefield,\nand stop the advance of Decius and his forces!\nExtreme (★1 target: average Lv25)"}