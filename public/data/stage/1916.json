ttack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106544, "race_id": 7, "change_to": 7, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 821, "global_id": 820, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 821, "spawn_sec": 132}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 8, "form_count": 1, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 226, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126512, "race_id": 7, "change_to": 13, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 34527, "global_id": 8144, "ranged": true, "variants": [{"hp": 8000, "attack": 1050, "base_hp": 8000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 8000, "magic_defense": 40, "attack_speed": 1, "attack_wait": 60, "attack_interval": 179, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126496, "race_id": 7, "master_id": 34528, "global_id": 8145}], "spawn_sec": 153}, {"enemy_id": 15, "source": "local", "count": 3, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 7000, "attack": 750, "base_hp": 7000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 60, "attack_speed": 1, "attack_wait": 25, "attack_interval": 109, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2123760, "race_id": 7, "missile_id": 11, "master_id": 32691, "global_id": 6309, "ranged": true, "spawn_sec": 174}, {"enemy_id": 16, "source": "local", "count": 4, "form_count": 1, "tags": ["水中"], "hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 40, "attack_speed": 1, "attack_wait": 150, "attack_interval": 358, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126528, "race_id": 7, "master_id": 34524, "global_id": 8141, "spawn_sec": 250}], "popups": ["　　　悪天候：激流\n\n・敵の『移動速度』上昇\n・味方の『射程』減少\n・一部の味方は影響を受けない"], "dialogue": [{"trigger": "start", "lines": [{"name": "クラールフ", "text": "――おぉ、シャディアよ、海底に来ていたか。\n我は今ここから動けぬゆえ、歓迎もしてやれぬが……。", "face": "l93d772652f9f"}, {"name": "シャディア", "text": "いえ、お構いなく。\nですが、神獣バハムトの封印の維持、\nクラールフ殿をして、それほどの重労働なのですか？", "face": "u713"}, {"name": "クラールフ", "text": "然り。我にかつて程の力は残っておらぬ。\n海巫女たちと我の力を束ねたとて、\nバハムト封印の維持は中々に骨が折れるものよ。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "それゆえ、こうして各地をめぐり、\n魔力の乱れを整えているのだからな。", "face": "l93d772652f9f"}, {"name": "マルスィ", "text": "海底都市周辺の海流が乱れていたのも、\nもしやバハムトの魔力の影響なのでしょうか？", "face": "u1065a1"}, {"name": "ハルフゥ", "text": "えぇ、バハムトの封印は不安定なままだから、\nその影響で突発的な激流や、\n激しい上昇海流が発生しているんです。", "face": "u1118a1"}, {"name": "リバン", "text": "おかげで本来はこの深度には現れない、\n深海の魔物も浮上してきたりして\n衛兵たちもかなり疲弊していますのよ……。", "face": "u1062a1"}, {"name": "オーベッド", "text": "だが王国との共闘を経て、\nこの都市の衛兵の士気は高まっている。\n王子殿のおかげだ、乾いた地の戦士には負けられぬとな。", "face": "u1122a1"}, {"name": "オーベッド", "text": "もしこの後時間があるのなら、\n衛兵たちに訓示のひとつでも頼めないか？\nきっと皆、喜んで――", "face": "u1122a1"}]}, {"trigger": "battle", "at_sec": 13, "lines": [{"name": "？？？", "text": "――ヌゥゥゥゥゥゥゥゥンッ！！", "face": "lc33ac7584ca8"}, {"name": "ハルフゥ", "text": "な、なんですか今の音！？\nいったいどこから……！？", "face": "u1118a1"}, {"name": "キュステ", "text": "王子さまぁぁぁぁ！！\n大変です！　巨大な魚人が！！", "face": "u1248a1"}, {"name": "？？？", "text": "ヌゥン、それがしは魚人にあらずゥ。\n溺れる地の民よ、我が名を知らぬと申すかァ！", "face": "lc33ac7584ca8"}, {"name": "シャディア", "text": "……まさか、亜神ジーラトス殿か？", "face": "u713"}, {"name": "ジーラトス", "text": "ヌゥン？　それがしを知る者がいるではないかァ！\nしかしその知識は些か古いと言わざるをえぬなァ！", "face": "lc33ac7584ca8"}, {"name": "クラールフ", "text": "荒ぶる亜神、大地を沈める者、万物を砕く無法者、\nジーラトス、お前は我が倒したはずだったが。", "face": "l93d772652f9f"}, {"name": "ジーラトス", "text": "ヌゥン、そのとおりだとも。\nかつての荒神ジーラトスは、\n敵味方問わぬ悪行を戒められ、おぬしに倒された。", "face": "lc33ac7584ca8"}, {"name": "ジーラトス", "text": "だが！　それがしはあの御方に命を救われ、\n荒ぶる魂を鎮める神器を与えていただいたのだ！", "face": "lc33ac7584ca8"}, {"name": "クラールフ", "text": "……改心した、ということか？\nならばなぜ、殺意をむき出しにして、この地へ来たのだ。", "face": "l93d772652f9f"}, {"name": "ジーラトス", "text": "ヌフゥン！　知れたことォ！\nそれがしは正義の亜神ジーラトス！\n正義をなすため、溺れる地の王子を殺しにきたのよォ！", "face": "lc33ac7584ca8"}, {"name": "アンナ", "text": "王子、どうやら会話は望めないようです。\n急ぎ迎撃の準備をお願いします！", "face": "l69e56a270b4d"}]}, {"trigger": "end", "lines": [{"name": "ジーラトス", "text": "ヌフゥゥゥウゥン！！\nこれが人間の戦い方か！　実に小さいィ！！", "face": "lc33ac7584ca8"}, {"name": "ジーラトス", "text": "だが！　それがしに傷を付けたことは褒めてやろう！\n次なる戦いでは、\nおぬしらのエラとヒレを引っ剥がしてやろうぞォ！", "face": "lc33ac7584ca8"}, {"name": "アンナ", "text": "……撤退、したのでしょうか？"}, {"name": "クラールフ", "text": "……あやつめ、確かに千年戦争の頃よりも、\n多少は理性的になったようだな。\nあの手枷が魂を鎮める神器なのだろう。", "face": "l93d772652f9f"}, {"name": "ケイティ", "text": "あの亜神は、いったい何者なのですか？", "face": "u114"}, {"name": "クラールフ", "text": "千年戦争の折、海神によって物質界に降りた亜神の一柱。\n人類の味方として喚ばれた者でありながら、\n敵味方問わず、目につくもの全てを踏み潰す暴虐の亜神。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "それゆえに、我はあやつを叩き潰し、\n二度と復活せぬよう深海に封じたのだ。", "face": "l93d772652f9f"}, {"name": "ハルフゥ", "text": "それが、復活しているということは……。\n解き放った者が敵にいるということですね。", "face": "u1118a1"}, {"name": "クラールフ", "text": "いったい誰が、と問うまでもあるまい。\n我らに敵対するもうひとつの海底神殿、\n海を我と二分する、かつて神だった者……。", "face": "l93d772652f9f"}, {"name": "クラールフ", "text": "――海神ポセイオス。\nやはり我と敵対するつもりか。", "face": "l93d772652f9f"}, {"name": "キュステ", "text": "ぽせい、おす？", "face": "u1248a1"}, {"name": "クラールフ", "text": "詳しくは神殿で話すとしよう。\n王子よ、此度の敵は一筋縄ではいかぬぞ。", "face": "l93d772652f9f"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 18, "params": [300]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 300000, "attack": 1, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 40, "pattern_id": 2128848}, {"enemy_id": 3, "hp": 300000, "attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128800}, {"enemy_id": 3, "form_index": 1, "hp": 300000, "attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128816}, {"enemy_id": 3, "form_index": 2, "hp": 300000, "attack": 7000, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128832}, {"enemy_id": 3, "form_index": 3, "hp": 300000, "attack": 1, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128784}, {"enemy_id": 3, "form_index": 4, "hp": 300000, "attack": 3500, "damage_type": "physical", "armor_defense": 900, "magic_defense": 40, "pattern_id": 2128784}, {"enemy_id": 8, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 9, "hp": 5500, "attack": 220, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 30, "pattern_id": 2126560}, {"enemy_id": 11, "hp": 5250, "attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "pattern_id": 2123792}, {"enemy_id": 12, "hp": 6000, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 12, "form_index": 1, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 13, "hp": 8000, "attack": 700, "damage_type": "magical", "armor_defense": 8000, "magic_defense": 40, "pattern_id": 2126512}, {"enemy_id": 15, "hp": 7000, "attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "pattern_id": 2123760}, {"enemy_id": 16, "hp": 30000, "attack": 2000, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 40, "pattern_id": 2126528}]}, "active": true}