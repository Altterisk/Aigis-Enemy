0, "attack": 200, "base_hp": 3200, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 31298, "global_id": 4917, "spawn_sec": 15}, {"enemy_id": 5, "source": "local", "count": 8, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 80}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 40, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 209, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102832, "missile_id": 28, "missile": {"speed": 6.0, "splash": 200}, "master_id": 399, "global_id": 398, "ranged": true, "spawn_sec": 125}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 400, "global_id": 399, "ranged": true, "spawn_sec": 142}], "dialogue": [{"trigger": "start", "lines": [{"name": "キャンディ", "text": "やだ……いや……っ！\n王子さまにお仕置きするだけって言ったのに！", "face": "u691"}, {"name": "カボチャの魔物", "text": "いつまでもきゃーきゃーうるさいカボ。\n騙されてたってまだ気づかないカボか？", "face": "l175ba8fc5516"}, {"name": "キャンディ", "text": "…………えっ？\n騙され……て……？", "face": "u691"}, {"name": "パンプキンキング", "text": "扱いやすい娘でホントウに助かったカボ。\nおかげでカボチャの身体も取り戻せたカボ。", "face": "l0549a863f3b3"}, {"name": "パンプキンキング", "text": "後はお前の魂を我らが主、\n魔神ビフロンス様に捧げるだけカボ……！！", "face": "l0549a863f3b3"}, {"name": "キャンディ", "text": "やっ……いやぁ……ッ！！\n誰か……誰か助け――", "face": "u691"}, {"name": "パンプキンキング", "text": "ビフロンス様も待ちくたびれているはずカボ。\n人間の魂を集め、今こそ再び、\nビフロンス様の復活を――", "face": "l0549a863f3b3"}, {"name": "メーリス", "text": "――そこまでよ！　キャンディ、無事！？", "face": "u78"}, {"name": "ミサ", "text": "何とか間に合ったようですね。\nカボチャの魔物、悪事もここまでです！", "face": "u539"}, {"name": "キャンディ", "text": "皆さん……！　王子さまも……！！\nごめんなさい、わ、私のせいで……！！", "face": "u691"}, {"name": "カボチャの魔物", "text": "ちっ……また邪魔が入ったカボ。\nこうなったら、王子達もここで倒して、\nビフロンス様復活の糧にしてやるカボ！", "face": "l175ba8fc5516"}, {"name": "アンナ", "text": "王子、捕まっているキャンディさんを救出し、\nカボチャの魔物の陰謀を阻止しましょう！", "face": "l0efbe2f641d8"}]}, {"trigger": "end", "lines": [{"name": "カボチャの魔物", "text": "カ……カボ……。", "face": "l175ba8fc5516"}, {"name": "エーリカ", "text": "大勝利♪\nキャンディちゃん立てる？　怪我はない？", "face": "u409"}, {"name": "キャンディ", "text": "あ……あの……。その……。\nごめんなさい……ッ！！", "face": "u691"}, {"name": "キャンディ", "text": "カボチャ畑を荒らしたっていうの、\n魔物たちの嘘だったんですよね……。\n私が騙されていただけで……全部……。", "face": "u691"}, {"name": "キャンディ", "text": "本当に、本当にごめんなさい……！！", "face": "u691"}, {"name": "ミサ", "text": "……せっかくの楽しいハロウィンなのに、\nそんな落ちこんだ顔をしていてはダメですよ。", "face": "u539"}, {"name": "キャンディ", "text": "……えっ？", "face": "u691"}, {"name": "エーリカ", "text": "そうそう♪\nハロウィンは皆で楽しくじゃないと♪", "face": "u409"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "キャンディ", "text": "…………うぅ……ぐすっ。\nありがとうございます、皆さん、王子さま……！", "face": "u691"}, {"name": "アンナ", "text": "それでは、王国に戻り、\nハロウィンパーティの準備をしましょうか。\nもちろん、キャンディさんもご一緒に。"}, {"name": "キャンディ", "text": "……はいっ！！", "face": "u691"}]}], "active": true}