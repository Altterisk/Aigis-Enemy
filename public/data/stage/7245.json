resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 7, "master_id": 31500, "global_id": 5119, "to_global_id": 5120, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 111}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 6, "master_id": 31501, "global_id": 5120}, {"enemy_id": 8, "source": "local", "count": 5, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107552, "race_id": 18, "change_to": 6, "master_id": 31501, "global_id": 5120, "to_global_id": 5119, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 120}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 7, "master_id": 31500, "global_id": 5119}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 200, "base_hp": 6000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2116704, "race_id": 18, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 31399, "global_id": 5018, "ranged": true, "spawn_sec": 177}], "popups": ["女王蜘蛛から攻撃を受けると、\n攻撃後の待ち時間が\n大幅に増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "キホル", "text": "――えっへん。\n魔界一の料理人、キホルちゃん参上ぅー♪", "face": "u1159a1"}, {"name": "エレット", "text": "あの子が、女王アリのフェロモンを、\n無理やり女王蜘蛛さんに摂取させたの……？", "face": "u1152a1"}, {"name": "オーガスタ", "text": "人を幸せにする料理を、\n人を操るために使うなんて……許せませんね……。", "face": "u1153a1"}, {"name": "デーモンシェフ", "text": "あの娘――キホルは元々は魔王軍にいた者だ。\n確かに料理番を務めてはいたが……。", "face": "l30ffa9fac382"}, {"name": "キホル", "text": "あっ、裏切り者のデーモンシェフじゃーん♪\n魔王様を裏切って、物質界で商売してるなんて、\nほんっとゴミクズ！　忠誠心の欠片もないんだぁ♪", "face": "u1159a1"}, {"name": "エレット", "text": "魔王ガリウスは、もういないんだよ！\nみんな物質界で、一緒に生きていこうとしてるのに！", "face": "u1152a1"}, {"name": "キホル", "text": "はぁ？　ガリウス様は死なないもん。\n取り消せ人間！　今すぐガリウス様に謝って！", "face": "u1159a1"}, {"name": "魔界アリの女王", "text": "おお、おお、可哀想にキホルよ。\n共に魔界に生を受けた者同士、\n魔王様への忠誠を尽くさねばなぁ。", "face": "l62d4e0de131b"}, {"name": "キホル", "text": "うん、うん……。キホルちゃん頑張るよ。\n頑張って、魔王様を侮辱した奴らぼこぼこにするから！", "face": "u1159a1"}, {"name": "エレット", "text": "うぅ、どうしたら言葉が届くんだろ……。", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "エレット嬢、おそらくキホルは、\nフェロモンチョコを食べさせられているのだ。\n彼女自身が作ったチョコをな。", "face": "l30ffa9fac382"}, {"name": "デーモンシェフ", "text": "だが、無事に無力化し、\nフェロモンの効果が切れても、\n仲間にできるとは思わないことだぞ。", "face": "l30ffa9fac382"}, {"name": "エレット", "text": "えっ……ど、どうして……？\nデーモンシェフだって、前は敵だったのに、\n今はこうして協力できているのに。", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "彼女は人一倍、忠誠心の強いデーモンだった。\n支えを失ったキホルを、\n魔王様の代わりに支えられるかどうか……。", "face": "l30ffa9fac382"}, {"name": "デーモンシェフ", "text": "その覚悟がないなら、\n安易に助けようなどと思わな――", "face": "l30ffa9fac382"}, {"name": "エレット", "text": "よし、助けるよ！\nあたし、あの子を助けるから！", "face": "u1152a1"}, {"name": "デーモンシェフ", "text": "なっ……話を聞いて……。\n――はぁ、そうだったな、エレット嬢は\n王子と共に戦ってきた神官戦士だったか。", "face": "l30ffa9fac382"}, {"name": "キホル", "text": "うだうだとうるさいなぁ……。\n虫たち、あのうるさい頭を叩き落としてきて！", "face": "u1159a1"}]}, {"trigger": "end", "lines": [{"name": "女王蜘蛛", "text": "くっ……ま、魔界アリの女王……貴様ぁっ！\nわたくしに……何を……っ！", "face": "l17147554e672"}, {"name": "魔界アリの女王", "text": "はて、もうフェロモンが切れたか。\nキホルよ、フェロモンチョコを食わせてやるがよい。", "face": "l62d4e0de131b"}, {"name": "キホル", "text": "はぁい♪　たぁんと食べてねぇ♪\nあなたには、魔王様が死んだなんて嘘をつく、\nあの人間たちを倒してもらわなきゃいけないんだから。", "face": "u1159a1"}, {"name": "エレット", "text": "はぁ……はぁ……。\n虫の数が多すぎて、きりがないよ……！", "face": "u1152a1"}, {"name": "エレット", "text": "女王蜘蛛さんと、\nキホルさんを助けなきゃいけないのに！", "face": "u1152a1"}, {"name": "キホル", "text": "はぁ～？　まだ言ってるの？\nキホルちゃんはぁ、自分で望んでここにいるの！", "face": "u1159a1"}, {"name": "キホル", "text": "ねぇ女王様、こいつら無視して、\nもっといっぱいチョコを奪いにいこ？", "face": "u1159a1"}, {"name": "キホル", "text": "物質界の連中ぜーんぶ！\nキホルちゃんと女王様のフェロモンチョコで、\nめろめろのきゅんきゅんにしてやるからね♪", "face": "u1159a1"}, {"name": "エレット", "text": "あなたに、そんなこと絶対させないから！\n王子、急いで後を追おう！", "face": "u1152a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}