{"quest_id": 7245, "name": "クッキンデーモン キホルちゃん", "description": "魔界料理人キホルを味方につけた\nアリの女王は、フェロモンチョコにより\n女王蜘蛛まで支配することに成功していた！\n極級（★１獲得の目安：平均Lv25）", "event": "魅惑のチョコレート・トラップ", "event_category": "History", "mission_id": 920156, "map_no": 5867, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 28000, "attack": 800, "base_hp": 28000, "base_attack": 800, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_range": 300, "attack_speed": 1, "attack_wait": 40, "attack_interval": 181, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118560, "race_id": 18, "missile_id": 352, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 31735, "global_id": 5354, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 11, "form_count": 1, "hp": 900, "attack": 50, "base_hp": 900, "base_attack": 50, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2116704, "race_id": 18, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 31904, "global_id": 5523, "ranged": true, "spawn_sec": 30}, {"enemy_id": 3, "source": "local", "count": 18, "form_count": 1, "hp": 3000, "attack": 220, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 21184