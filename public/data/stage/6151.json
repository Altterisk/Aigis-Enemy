eed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3}, {"enemy_id": 19, "source": "local", "count": 5, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 430, "base_hp": 6500, "base_attack": 430, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "master_id": 74, "global_id": 73}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097312, "race_id": 9, "master_id": 53, "global_id": 52}, {"enemy_id": 22, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120}, {"enemy_id": 23, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261}, {"enemy_id": 24, "source": "local", "count": 2, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 96}], "popups": ["レーサーたちは拠点に向かわず、\n倒さなくても★の評価には影響\nしません。\n\nゴブリンレーサーは倒されると\n修理を行い、2回までレースに\n復帰します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "クイーンサマ、どうですカ？\n新しい兵器「飛行型くぐつ」ハ！", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "ウフフ、よくやったじゃない博士。\nここ最近は、失態続きだったから\nそろそろ処刑かと思ってたところよぉ。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "ただ、スピードが足りない気がするわぁ。\n矢も追いつけない程の速度じゃないと、\nすぐ狙撃されちゃうに決まってるじゃない？", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "す、スピードですカ……。\n操縦者の技術ガ上がれば何とカ……。\n少し、訓練を積む為のお時間を頂きたク……。", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "何を言ってるのかしら？\n私は待つのが嫌いなの知ってるわよねぇ？\n分かったら、今すぐスピードを上げるのよ！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン博士", "text": "し、シカシ……。\n何ブン、兵達もこのような飛行物を\n操縦するのは初めてデスシ……。", "face": "l16b6c88b22e6"}, {"name": "ゴブリンクイーン", "text": "兵達の士気が足りないんじゃないかしらぁ？\nそうだ！　いいことを思いついたわぁ。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "今からレースを始めなさい！\nレースをやってビリになった奴は、処刑だわ！", "face": "l86fc49ed0f43"}, {"name": "ゴブリン", "text": "ギャギャーー！\nマケタクナイ！　マケタクナイ！！\nシニタクナイ！　シニタクナイ！！", "face": "lad7d66fc429b"}, {"name": "ゴブリンクイーン", "text": "ほら御覧なさい、博士。\n兵達がやる気を出してるわ。\nやっぱり、恐怖って大事よねぇ。", "face": "l86fc49ed0f43"}, {"name": "ボリス", "text": "――王子ここだ、ゴブリン達が集まっているのは！\nゴブリンクイーンもいるようだぞ！", "face": "u360"}, {"name": "アンナ", "text": "ゴブリンクイーン！\nティアルさんを返してください！", "face": "lfeb669e7258e"}, {"name": "ゴブリンクイーン", "text": "誰かと思えば、王子達じゃない。\nティアル？　……あぁ、このくぐつを作った\n技術者の事ね。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "そうだ！　丁度良かったわぁ。\n今からくぐつのレースを始めるのよ。\nそのティアルって子も参加させましょう。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "最終レースまで、\nビリにならなかったら解放してあげてもいいわよぉ。\n技術は全部奪ったし、どうせ用済みだったしねぇ。", "face": "l86fc49ed0f43"}, {"name": "ティアル", "text": "レースに参加……！？\nビリになったら処刑……って、\n死んじゃうって事だよね……。", "face": "u505"}, {"name": "ボリス", "text": "おい、ティアル！\nそんなレース参加する必要ないぞ。\n俺達が、すぐに助けてやる！", "face": "u360"}, {"name": "ティアル", "text": "ま、待って……！\n私、レースに出る……！", "face": "u505"}, {"name": "ティアル", "text": "ライダーの誇りにかけて、レースで正々堂々と戦う！\nせっかく完成させたこの子と一緒に、\nレースで勝ち残ってみせる！　", "face": "u505"}, {"name": "ティアル", "text": "ボリス先生、見ててください……！", "face": "u505"}, {"name": "アンナ", "text": "ティアルさん……。\n本気のようですけど……、\n王子、どうしましょうか……？", "face": "lfeb669e7258e"}, {"name": "アンナ", "text": "……分かりました。\nティアルさんの意思を尊重し、\nレースを見守りましょう。", "face": "lfeb669e7258e"}, {"name": "ケイティ", "text": "王子、ゴブリン達のことです。\nどんな妨害があるかわかりません。\n不測の事態に対処できるよう、準備はしておきましょう。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "――……やった！　やりました王子！\nティアルさんが勝ち残りました！"}, {"name": "ボリス", "text": "けどギリッギリじゃねーか。\n……ったく、\nハラハラさせんじゃねーぞ。", "face": "u360"}, {"name": "ティアル", "text": "す、すみません……で、でも、\nちゃんと勝ち残りましたよ！", "face": "u505"}, {"name": "ケイティ", "text": "流石の乗りこなし……見事なものでしたね。", "face": "u114"}, {"name": "ゴブリンクイーン", "text": "ふぅん……まぁ、一回戦で終わっちゃうのも\n面白くないものね。少しは楽しめたわ。\n次のレースも精々楽しませて頂戴。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "ではお楽しみの処刑の時間よぉ。\nビリになったのは貴方ね？", "face": "l86fc49ed0f43"}, {"name": "ゴブリン", "text": "ぎ、ギャギャアアアアアアアアッ！！", "face": "lad7d66fc429b"}, {"name": "アンナ", "text": "……ッ！　配下の者を\nああもあっさりと……。", "face": "l073b3e98e97d"}, {"name": "ゴブリンクイーン", "text": "言ったでしょ、ビリのノロマは処刑だって。\n勝負のルールは絶対よ……だから安心なさい。\n最後まで勝ち残ればちゃんとその子は解放してあげる。", "face": "l86fc49ed0f43"}, {"name": "ゴブリンクイーン", "text": "まぁ、それができればだけどね。\nウフフフ。", "face": "l86fc49ed0f43"}, {"name": "ティアル", "text": "ゴブリンクイーン……恐ろしい奴だね……。\nでも、私は絶対に負けない！", "face": "u505"}, {"name": "ティアル", "text": "この子の走りの癖も何もかも、\n長年の付き合いで、私には分かるの。\nそう簡単にくぐつを乗りこなせるわけないんだから！", "face": "u505"}, {"name": "ボリス", "text": "いっちょ前の事言いやがって……ったく。\nあんなにギリギリのレースだった癖に……。", "face": "u360"}, {"name": "アンナ", "text": "王子、さっきのレースでも、\nゴブリンの乱入がありましたし、\nまた罠が仕掛けられてるかもしれません。", "face": "lfeb669e7258e"}, {"name": "アンナ", "text": "私達も、出来る限りサポートしましょう！", "face": "lfeb669e7258e"}]}], "active": true}