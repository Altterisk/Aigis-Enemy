{"quest_id": 6151, "name": "ライダーの誇り", "description": "ゴブリン主催のくぐつレース。\n決死のレースに挑むティアルのため、\nゴブリン達の妨害を食い止めよ！\n上級（★１獲得の目安：平均Lv10）", "event": "スカイ・レーサー", "event_category": "History", "mission_id": 920092, "map_no": 3992, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110688, "race_id": 9, "special_effect_id": 49, "change_to": 1, "change_condition": 2, "missile_id": 26, "master_id": 30379, "global_id": 3998, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110656, "race_id": 9, "special_effect_id": 49, "change_to": 4, "change_condition": 2, "missile_id": 26, "master_id": 30378, "global_id": 3997, "ranged": true}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110720, "race_id": 9, "special_effect_id": 49, "change_to": 7, "change_condition": 2, "missile_id": 26, "master_id": 30380, "global_id": 3999, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 68