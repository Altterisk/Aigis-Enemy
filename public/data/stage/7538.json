111792, "race_id": 16, "master_id": 30637, "global_id": 4256, "spawn_sec": 78}, {"enemy_id": 13, "source": "local", "count": 21, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 80}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["帝国"], "hp": 18000, "attack": 600, "base_hp": 18000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "magic_defense": 10, "attack_range": 240, "attack_speed": 90, "attack_wait": 30, "attack_interval": 121, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133120, "race_id": 16, "change_to": 8, "missile_id": 26, "master_id": 34622, "global_id": 8239, "ranged": true, "to_condition": 0, "to_global_id": 8238, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 105}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["帝国"], "hp": 18000, "attack": 600, "base_hp": 18000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "magic_defense": 10, "attack_range": 240, "attack_speed": 90, "attack_wait": 30, "attack_interval": 121, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2133136, "race_id": 16, "special_effect_id": 947, "change_to": 9, "missile_id": 26, "master_id": 34621, "global_id": 8238, "ranged": true, "from_condition": 0}], "dialogue": [{"trigger": "start", "lines": [{"name": "マルレーン", "text": "――ねぇレーネ、どうして追ってきたの？", "face": "u1434a1"}, {"name": "レーネ", "text": "どうしてって……それはあんたが――\nうぅん、ほら、えっと……。\nあっ、この先！　山を超えたらボクらの街だから……。", "face": "u1432a1"}, {"name": "マルレーン", "text": "あっ、そっか、そうだよね！\nあはは、やっぱ故郷は守らないとだしね！", "face": "u1434a1"}, {"name": "マレブランケ", "text": "（初々しいなぁ……。\nこれが人間の友情、というものか）", "face": "u1225a1"}, {"name": "サザンカ", "text": "（マレブランケ、目ぇ閉じて歩いてると転ぶよ？）", "face": "u1347a1"}, {"name": "マレブランケ", "text": "（おっと失敬、転んだ時はよろしく頼むよ）\n――それにしても、いやぁ、心残りだなぁ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "はっ？　あんた突然何を言い出して――", "face": "u1347a1"}, {"name": "マレブランケ", "text": "故郷に残してきた友に、\n言いたいことはしっかり伝えておくべきだったなぁ。\nあー、心残りだなぁ。とっても心残りだなぁ。", "face": "u1225a1"}, {"name": "レーネ", "text": "……言いたいことは、伝えておく……か。", "face": "u1432a1"}, {"name": "マルレーン", "text": "…………レーネ？", "face": "u1434a1"}, {"name": "レーネ", "text": "ふふっ、ノンノン♪　何でもないよ！\nやっぱりマルレーンは、\nボクがいないとダメなんだなーってさ♪", "face": "u1432a1"}, {"name": "マルレーン", "text": "なっ……アタシは別に、レーネがいなくても……。\nいなくても……うーん……いないと、\nうん、やっぱりダメなのかもなぁ。", "face": "u1434a1"}, {"name": "マルレーン", "text": "ねぇ、これが終わったらさ、一緒に軍で働かない？\nアタシの部屋、ちょっと広すぎて困ってたんだよね。", "face": "u1434a1"}, {"name": "レーネ", "text": "えぇー、マルレーン寝相悪いしなぁ。", "face": "u1432a1"}, {"name": "マルレーン", "text": "何をぉ！？　寝言が激しいのはレーネの方だし！", "face": "u1434a1"}, {"name": "マレブランケ", "text": "うんうん、これでよし。\n人の子の友情は、なんと尊きものなのだろう。", "face": "u1225a1"}, {"name": "サザンカ", "text": "うわぁ、すごい満足そう。\n――それより、そろそろ敵が追いついてくる頃だよ。\n周辺警戒、怠らないように！", "face": "u1347a1"}]}, {"trigger": "end", "lines": [{"name": "メフィスト", "text": "やれやれ、しつこいな。\nさすがはベラート伯爵の兵か。", "face": "u526"}, {"name": "エルミラ", "text": "ですが、ふもとが見えてきました。\nあの丘に陣取れば、反転攻勢にはうってつけですよ。", "face": "u427"}, {"name": "メフィスト", "text": "ただ、その先は街だ。\n正直、事態はまったく好転していないぞ。", "face": "u526"}, {"name": "エルミラ", "text": "でも、今回は王子がいますから。", "face": "u427"}, {"name": "メフィスト", "text": "……それはもしや、女の勘というやつかな？", "face": "u526"}, {"name": "エルミラ", "text": "それもありますけど……。\n王国軍は、こういう事態に関してはエキスパートですから。\n窮地からの反撃において、王子を超える者はいませんよ。", "face": "u427"}, {"name": "メフィスト", "text": "なるほど、そこは同意しておこう。\nさぁ、一気に山を下るぞ！\n全員逸れないように気をつけ給えよ！", "face": "u526"}]}], "map": {"image": "Map940005_4584", "w": 960, "h": 640, "spots": [{"k": "b", "x": 28, "y": 348}, {"k": 