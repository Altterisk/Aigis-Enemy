base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "change_to": 8, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 827, "global_id": 826, "ranged": true, "to_global_id": 827, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 115}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 6720, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 171, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101136, "race_id": 7, "change_to": 9, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 828, "global_id": 827, "ranged": true}], "dialogue": [{"trigger": "end", "lines": [{"name": "ビエラ", "text": "魔神ウェパルから、\n攻撃の意思を感じなくなったわ……。\nこれって……私たちの勝ちってこと？", "face": "u176"}, {"name": "ケイティ", "text": "王子、ウェパルが撤退していきます！\nどうやら海底へ逃げようとしているみたいです！", "face": "u114"}, {"name": "ビエラ", "text": "ここまで来て逃がすもんですか！\n王子、このままアイツにトドメをさすわよ！", "face": "u176"}, {"name": "バルバストラフ", "text": "待つのだ、ビエラ！\nウェパルは魔界へと還っていくようじゃ……、\n後を追えば、おぬしも無事では済まんぞ。", "face": "u63"}, {"name": "ビエラ", "text": "そんな……あそこまで魔神を\n追い詰めたっていうのに、\nこのまま見過ごすしかないなんて……。", "face": "u176"}, {"name": "アンナ", "text": "ビエラさん、伝説の魔神をこの海から\n退けただけでも、私達にとっては\n奇跡のような成果ではないでしょうか？", "face": "l26f6d378e2bc"}, {"name": "ビエラ", "text": "そうね……あのウェパルから\n海の平和を守ることが出来たんだもの……、\nこれ以上を望んだら罰が当たるわね♪", "face": "u176"}, {"name": "アンナ", "text": "これで、ビエラさんからの依頼は\n達成ということになりますね、王子。\nそれでは帰還するとしましょう。"}, {"name": "ビエラ", "text": "ごめん、アンナ。私も一緒に行きたいけど、\nこのまま仲間の水兵達のもとへ向かう事にするわ。\nみんなを早く安心させてあげたいからね♪", "face": "u176"}, {"name": "ビエラ", "text": "王子、力を貸してくれてありがとう。\nあなたに頼んで、本当によかったわ。\nいつか、このお礼をさせてね？", "face": "u176"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "ビエラ", "text": "ふふ……ええ、愉しみにしてていいわ。\n王子が望むこと、何でもしてあげるから♪\nそれじゃ、もう行くわね。本当にありがとう！", "face": "u176"}]}], "active": true}