": 1.5, "pattern_id": 2155168, "race_id": 19, "special_effect_id": 1039, "change_to": 44, "master_id": 37830, "global_id": 11447, "to_global_id": 11448, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 321}, {"enemy_id": 44, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 550000, "attack": 5500, "base_hp": 550000, "base_attack": 5500, "damage_type": "magical", "armor_defense": 1700, "magic_defense": 55, "attack_wait": 54, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2155264, "race_id": 19, "master_id": 37831, "global_id": 11448}, {"enemy_id": 46, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 360000, "base_hp": 360000, "damage_type": "magical", "armor_defense": 800, "magic_defense": 45, "attack_speed": 30, "attack_wait": 40, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2155184, "race_id": 19, "special_effect_id": 1176, "missile_id": 1137, "missile": {"speed": 8.0, "splash": 133}, "master_id": 38687, "global_id": 12304, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 324}], "popups": ["大神ハイドースは\nブロックされていない間は味方の\n遠距離攻撃の対象になりません。\n\nまた大神ハイドースが\n遠距離攻撃の体勢をとると\n姿隠しの兜の効果が切れて、\n味方の遠距離攻撃の対象になります。", "大神ハイドースは、\n戦場にいる黒炎の総数に応じて\n攻撃力と防御力がアップします。\n\nまた大神ハイドースが\n遠距離攻撃を行うと\n戦場にいる黒炎は\n全て消滅します。", "大神ハイドースが召喚する\n黒炎のバイデントは、\n地面に着弾すると\n黒炎に変化します。", "大神降臨ハイドースが\n解放されました。\n\nホーム画面左側の\nミッションクエストにある、\n魔神降臨のメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "カルペム", "text": "――タルタロスの門が、開きかけている……！", "face": "u2401a1"}, {"name": "ハイドース", "text": "愛を……。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "哀れなる人の子らに、離別の苦しみなき世界を。", "face": "le4066daa294e"}, {"name": "ヘカティエ", "text": "……やめなさい、ハイドース。\nその門を開けば、あなたも無事では済まないわ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "世界を書き換えるほどの魔力の奔流で、\n復讐相手もろとも消滅するつもり？", "face": "u1226a1"}, {"name": "ハイドース", "text": "…………復讐。\n…………おお、おお。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "ああ……！\nヘカティエよ、戻ってきたか！", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "冥界のこの荒れようはなんだ。\nいったい何が起きたというのだ。", "face": "le4066daa294e"}, {"name": "ヘカティエ", "text": "……ハイドース？", "face": "u1226a1"}, {"name": "ハイドース", "text": "霊魂たちが震えている……。\n冥界の主として、彼らを守ってやらねば……。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "ヘカティエよ、冥界騎士の力を借りたい。\nこの事態、必ず元凶がいるはずだ。\n我と協力し、冥界の安寧を取り戻すのだ。", "face": "le4066daa294e"}, {"name": "ヘカティエ", "text": "何をいっているの……？", "face": "u1226a1"}, {"name": "白の皇帝", "text": "……タルタロスの魔力を浴びたのか。", "face": "u418"}, {"name": "白の皇帝", "text": "ふざけた終焉だ。すべての元凶が、\nまさか自我も記憶も破壊されているとは。", "face": "u418"}, {"name": "ヘカティエ", "text": "皇帝、あなたが決めなさい。\n彼をどうするのか。", "face": "u1226a1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "ヴァルデ", "text": "……いや、待て！\nなんだこれ……何が起きて……。", "face": "u2403a1"}, {"name": "レオナ", "text": "何があった、ヴァルデ。", "face": "u311"}, {"name": "パルセ", "text": "ドーンブリンガーが、\n物質界全土の魔力総量を上回る、\n膨大な魔力の波動を検知しました。そちらも同じですね？", "face": "u2276a1"}, {"name": "ヴァルデ", "text": "ああ！　観測装置が振り切れてる！\n来るぞ、タルタロスの奥から、何かが――！！", "face": "u2403a1"}, {"name": "ハイドース", "text": "ああ、ペルセフォネ……我が妻にも手伝ってもらおう。\n彼女は本当に慈悲深く、優しい娘だ。\nきっと、冥界の霊魂たちを癒して――", "face": "le4066daa294e"}, {"name": "フローガ", "text": "これは……純粋な魔力の塊です！\nまるで、何かがハイドースに力を与えているような――", "face": "u878"}]}, {"trigger": "battle", "at_sec": 5, "lines": [{"name": "ハイドース", "text": "…………。", "face": "lce51ca3fb3ba"}, {"name": "ハイドース", "text": "我が、妻よ……。\n愛しきペルセフォネよ……。", "face": "lce51ca3fb3ba"}, {"name": "ハイドース", "text": "そうか、ここで立ち止まることを、許してはくれないか。", "face": "lce51ca3fb3ba"}, {"name": "白の皇帝", "text": "――目覚めたようだな、ハイドース。", "face": "u418"}, {"name": "ハイドース", "text": "ああ、我が宿敵、\n憎き仇敵たる男、白の帝国が皇帝よ。", "face": "lce51ca3fb3ba"}, {"name": "ハイドース", "text": "この武装を見せるのは、初めてだったな。\n確か……人類はこの姿を、大神と呼んでいたか？", "face": "lce51ca3fb3ba"}, {"name": "白の皇帝", "text": "これが、最後の戦いか。", "face": "u418"}, {"name": "ハイドース", "text": "然り。我が勝てば、世界は安寧の死に抱かれる。\n貴様が勝てば、この戦いは終わる。", "face": "lce51ca3fb3ba"}, {"name": "ハイドース", "text": "覚悟はできているな、\n白の皇帝、女神アダマスよ。", "face": "lce51ca3fb3ba"}, {"name": "白の皇帝", "text": "いまさらだ。覚悟など――", "face": "u418"}, {"name": "ヴィラヘルム", "text": "…………。", "face": "u2245a1"}, {"name": "アダマス", "text": "…………。", "face": "lddf7a687accd"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "白の皇帝", "text": "フッ……。", "face": "u418"}, {"name": "白の皇帝", "text": "ようやく、覚悟が決まったところだ。", "face": "u418"}, {"name": "白の皇帝", "text": "俺は、白の帝国を導く。\n何があろうと折れることなく、\n決して止まらず歩み続ける。", "face": "u418"}, {"name": "白の皇帝", "text": "白の帝国の戦士よ、\n胸に誇りを抱く者たちよ、俺に力を貸せ！", "face": "u418"}, {"name": "白の皇帝", "text": "――ここに宿敵、大神ハイドースを討つッ！！", "face": "u418"}]}, {"trigger": "battle", "at_sec": 322, "lines": [{"name": "ハイドース", "text": "――世界は、まだ、続くということか。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "ああ、生ある者たちが、生きることを望んだ結果だ。", "face": "u418"}, {"name": "白の皇帝", "text": "何か、言い残すことはあるか？", "face": "u418"}, {"name": "ハイドース", "text": "……庇護すべき者、死すべき運命にある人の子に、\n我が意志を委ねはしない。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "さらばだ、白の皇帝よ。\n悲しみに満ちた世界を征くがいい。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "……世界は、捨てたものではない。", "face": "u418"}, {"name": "白の皇帝", "text": "嘆く者がいれば、必ず俺が助けにいく。\nその程度の約束しかできないが――", "face": "u418"}, {"name": "ハイドース", "text": "……ああ。\nやってみせるといい。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "…………。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "……終わった、か。", "face": "u418"}, {"name": "レオナ", "text": "いいえ、陛下。", "face": "u311"}, {"name": "白の皇帝", "text": "…………？", "face": "u418"}, {"name": "ディアナ", "text": "ここから、ですよ。\nまずはあなたの背中を追い続けた兵たちに、\n勝利の演説のひとつでもしてあげてください。", "face": "u624"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "王子", "text": "…………（ぽんぽん）", "face": "u1"}, {"name": "ヴィラヘルム", "text": "…………（にこにこ）", "face": "u2245a1"}, {"name": "ヘイズル", "text": "…………（つんつん）", "face": "u2248a1"}, {"name": "アンジェリーネ", "text": "さぁ、振り返ってごらんなさい。\n皆があなたの言葉を待っていますわ。", "face": "u430"}, {"name": "白の皇帝", "text": "…………フッ。", "face": "u418"}, {"name": "白の皇帝", "text": "白の帝国の戦士たちよ、共に戦ってくれた者たちよ――", "face": "u418"}, {"name": "白の皇帝", "text": "――帰るぞ。勝利の凱旋だ。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "ハイドース", "text": "……やはり、そこにいてくれたのか。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "ペルセフォネ、君の魔力が消滅してなお、\n隣に小さなぬくもりを感じていた。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "約束は……果たせなかった……。\nこの世界には、これからも、\n離別の悲しみが生まれ続けるだろう……。", "face": "le4066daa294e"}, {"name": "ペルセフォネ", "text": "――、――――、\n―――――――――。", "face": "lb6c5301f531a"}, {"name": "ハイドース", "text": "…………ああ。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "ああ……っ、ペルセフォネ、\nもう、決して、君をひとりにはしない……！！", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "――君を、愛している。\n永遠に、世界が終わろうとも。", "face": "le4066daa294e"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "トットン", "text": "――ハイドースが消えました！？", "face": "u2405a1"}, {"name": "ヘイズル", "text": "これは姿隠しの兜……奴の神器の力だね。\n神器の出し惜しみをするつもりはないらしい。", "face": "u2248a1"}, {"name": "ヘイズル", "text": "姿は確かに見えている。\nただ、こちらの知覚を乱し、認識できなくなっただけ。", "face": "u2248a1"}, {"name": "ヘイズル", "text": "こっちも全力でぶつかって、足止めすれば問題ないよ。", "face": "u2248a1"}, {"name": "トットン", "text": "あ、あ、あ、あんなのと鍔迫り合いをぉ！？", "face": "u2405a1"}, {"name": "ヘイズル", "text": "できるできる。\nこっちは世界最強の白の帝国軍なんだからね！", "face": "u2248a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "メーア", "text": "飛んだぁ……！？", "face": "u2404a1"}, {"name": "ハイドース", "text": "黒き炎よ、冥界の焔よ……。\n我が刃に宿りて戦場に降り注げ。", "face": "lce51ca3fb3ba"}, {"name": "ツザーネ", "text": "ハイドースのバイデントに炎が集まって――\nそうか、降り注ぐ黒炎で地上を焼き払うつもりだな。", "face": "u2406a1"}, {"name": "ダグマール", "text": "そんなもの、\n落下する前に叩き潰せばいいのでしょう？", "face": "u2402a1"}, {"name": "ダグマール", "text": "こちらは白の帝国軍、世界最強の\n火力集団なのだと思い知らせてやりましょう！", "face": "u2402a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "パルセ", "text": "――ヴァルデさん！\nドーンブリンガーが強大な魔力を感知しました！", "face": "u2276a1"}, {"name": "ヴァルデ", "text": "こっちもだ！\n持ってきて正解だったな、新型魔力計！", "face": "u2403a1"}, {"name": "フローガ", "text": "正確な計測器が二台もあって助かりましたよ！\n今計算してます。ちょっとまって――", "face": "u878"}, {"name": "フローガ", "text": "あっ、あっ、あぁぁぁ！！\nこれは……っ！！", "face": "u878"}, {"name": "フローガ", "text": "落下した黒炎から、\nハイドースに魔力が集まっています！\nあれ、攻撃だけじゃない、魔力増幅器でもあるんだ！", "face": "u878"}, {"name": "ヴァルデ", "text": "みんな避けろー！！\nハイドースの狙いはこの遠距離攻撃だ！", "face": "u2403a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "ハイドース", "text": "――よくぞここまで耐えたものだ。\nこの一撃をもって、終わりとしよう。", "face": "lce51ca3fb3ba"}, {"name": "ハイドース", "text": "全ての時代、全ての場所で、世界を恨んだ者たちよ。\n離別の悲しみゆえに、世界を憎んだ者たちよ。", "face": "lce51ca3fb3ba"}, {"name": "ハイドース", "text": "創造神の生み出した悲しみの世界を、\nこの手で終わらせよう。", "face": "lce51ca3fb3ba"}, {"name": "メフィスト", "text": "……ッ、目眩がするな、こんな濃厚な魔力。", "face": "u526"}, {"name": "ヴィラヘルム", "text": "ハイドースの信徒の祈りと魔力の結晶……。\nこの世界を憎んだ者たちの、怨嗟の魔力。", "face": "u2245a1"}, {"name": "ヴィラヘルム", "text": "正面にいる者は退避を！\nさきほどの攻撃とは比較にならない一撃が来ます！", "face": "u2245a1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 20, "params": [150]}, {"kind": "term", "influence": 19, "params": [120]}, {"kind": "term", "influence": 25, "params": [300], "expression": "IsAssign(\"帝国\") != 1;", "expression_human": "it is assigned to [[tag:白の帝国]] != 1"}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}], "enemies": [{"enemy_id": 1, "hp": 400000, "damage_type": "true", "armor_defense": 500, "magic_defense": 80, "pattern_id": 2159920}, {"enemy_id": 1, "form_index": 1, "hp": 400000, "attack": 2000, "damage_type": "true", "armor_defense": 2000, "magic_defense": 80, "pattern_id": 2159936}, {"enemy_id": 1, "form_index": 2, "hp": 400000, "damage_type": "true", "armor_defense": 2000, "magic_defense": 80, "pattern_id": 2159952}, {"enemy_id": 1, "form_index": 3, "hp": 400000, "attack": 600, "damage_type": "true", "armor_defense": 2000, "magic_defense": 80, "pattern_id": 2159968}, {"enemy_id": 8, "hp": 999999, "attack": 1, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2097200}, {"enemy_id": 9, "hp": 9999999, "attack": 5000, "damage_type": "magical", "pattern_id": 2137216}, {"enemy_id": 9, "form_index": 1, "hp": 9999999, "attack": 5000, "damage_type": "true", "pattern_id": 2137216}, {"enemy_id": 11, "hp": 6000, "attack": 650, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "pattern_id": 2160016}, {"enemy_id": 11, "form_index": 1, "hp": 6000, "attack": 650, "damage_type": "true", "armor_defense": 100, "magic_defense": 20, "pattern_id": 2160032}, {"enemy_id": 11, "form_index": 2, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 14, "hp": 8000, "attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127824}, {"enemy_id": 14, "form_index": 1, "hp": 8000, "attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "pattern_id": 2127840}, {"enemy_id": 18, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 18, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 22, "hp": 2500, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 22, "form_index": 1, "hp": 2500, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 26, "hp": 3000, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2155216}, {"enemy_id": 26, "form_index": 1, "hp": 2000, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2155232}, {"enemy_id": 28, "hp": 2000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 29, "hp": 4000, "attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2159904}, {"enemy_id": 30, "hp": 5500, "attack": 250, "damage_type": "magical", "armor_defense": 40, "magic_defense": 50, "pattern_id": 2155440}, {"enemy_id": 30, "form_index": 1, "hp": 5500, "attack": 400, "damage_type": "true", "armor_defense": 40, "magic_defense": 50, "pattern_id": 2155456}, {"enemy_id": 34, "hp": 4500, "attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2159616}, {"enemy_id": 34, "form_index": 1, "hp": 4500, "attack": 700, "damage_type": "true", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2159632}, {"enemy_id": 38, "hp": 3500, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2142464}, {"enemy_id": 39, "hp": 23000, "attack": 700, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2138576}, {"enemy_id": 40, "hp": 142000, "attack": 2650, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 30, "pattern_id": 2159696}, {"enemy_id": 40, "form_index": 1, "hp": 142000, "attack": 1450, "damage_type": "true", "armor_defense": 5000, "magic_defense": 30, "pattern_id": 2159712}, {"enemy_id": 44, "hp": 550000, "attack": 5500, "damage_type": "magical", "armor_defense": 1700, "magic_defense": 55, "pattern_id": 2155168}, {"enemy_id": 44, "form_index": 1, "hp": 550000, "attack": 5500, "damage_type": "magical", "armor_defense": 1700, "magic_defense": 55, "pattern_id": 2155264}, {"enemy_id": 46, "hp": 360000, "damage_type": "magical", "armor_defense": 800, "magic_defense": 45, "pattern_id": 2155184}]}, "active": true}