": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 4, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 46}, {"enemy_id": 4, "source": "local", "count": 1, "level": 80, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 6, "source": "local", "count": 3, "level": 80, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 75}, {"enemy_id": 7, "source": "local", "count": 3, "level": 80, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 89}, {"enemy_id": 8, "source": "local", "count": 1, "level": 80, "form_count": 1, "hp": 5000, "attack": 600, "base_hp": 5000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097808, "master_id": 43, "global_id": 42, "spawn_sec": 90}], "popups": ["アースエレメンタルの\nHPを減らすと、\n強烈な遠距離攻撃をしてきます。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "モーティマ", "text": "ほら、アレだよアレ！　あの岩の塊みたいなのが\n大量発生しちまってるんだ。\nゴロゴロ転がってて危ないったらねぇよ。", "face": "u14"}, {"name": "アンナ", "text": "確かに岩の塊のような見た目ですね。\n……いったいあれは何なのでしょうか？", "face": "leed9510feffb"}, {"name": "メーリス", "text": "あれは……アースエレメンタルだね。", "face": "u78"}, {"name": "アンナ", "text": "アースエレメンタル……？", "face": "leed9510feffb"}, {"name": "メーリス", "text": "この世にある土や水、火、風なんかの\n自然物にはそれぞれ小さなエネルギーが\n宿っているのは知ってる……？", "face": "u78"}, {"name": "モーティマ", "text": "も、もちろん知ってるに決まってんだろ！\n(初めて知ったぜ……)", "face": "u14"}, {"name": "メーリス", "text": "そんな自然物に宿るエネルギーが何かのきっかけで\n異常に集まると、ある限界点に達した時に\nあんな風に具象化するの。", "face": "u78"}, {"name": "メーリス", "text": "それをエレメンタルって呼んでいるの。\n世の中には、自然物と交信して意図的に\n具象化できる人達もいるみたいだけど……。", "face": "u78"}, {"name": "メーリス", "text": "ただね、こっちから危害を加えなければ、\nエレメンタルは危険なものじゃないの。\nだから、今は無理に除去しなくても……。", "face": "u78"}, {"name": "ゴブリン", "text": "ギャギャッ！\nニンゲン、見ツケタ！　タオセ！　タオセッ！！", "face": "le7dbb13b7457"}, {"name": "モーティマ", "text": "チッ……何て間の悪い時に現れやがんだ。\nアースエレメンタルの間を縫って進んできてるぞ！", "face": "u14"}, {"name": "アンナ", "text": "さすがにゴブリン達を見逃すわけにはいきませんね。\n王子、ここで討伐しましょう！", "face": "leed9510feffb"}, {"name": "メーリス", "text": "王子、分かってると思うけど、\nアースエレメンタルには、\n絶対に手を出しちゃダメだよ！", "face": "u78"}]}, {"trigger": "end", "lines": [{"name": "モーティマ", "text": "これで、魔物は全部倒せたみてぇだな……。", "face": "u14"}, {"name": "モーティマ", "text": "ったく、アースエレメンタルなんか居なけりゃ\nもっと楽に勝てたのによぉ……。\nいつもの倍は疲れちまったぜ。", "face": "u14"}, {"name": "アンナ", "text": "それにしても、どうして急に\nアースエレメンタルがあんなに大量に\n発生してしまったのでしょうか……？", "face": "leed9510feffb"}, {"name": "メーリス", "text": "そこまでは私も分からないです……。", "face": "u78"}, {"name": "メーリス", "text": "でも、確かにあんなに沢山の\nアースエレメンタルが具象化するのは\nちょっと普通じゃないと思う。", "face": "u78"}, {"name": "メーリス", "text": "バルバス爺なら何か分かるかもしれないから、\n帰ったらすぐに聞きに行ってみるね。", "face": "u78"}, {"name": "アンナ", "text": "お願いします。\n私も過去の文献を見てみる事にします。\nでは王子、一度帰還しましょう。お疲れ様でした。"}]}], "story_talk": true, "active": true}