{"quest_id": 4152, "name": "忍びの隠れ里", "description": "卑劣な忍びに対抗するため\nアンナが奮闘！\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "アンナの大冒険", "event_category": "History", "mission_id": 920029, "map_no": 5377, "level": 95, "multiplier": 0.95, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 15, "form_count": 1, "hp": 855, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "tags": ["忍者"], "hp": 855, "attack": 190, "base_hp": 900, "base_attack": 190, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100032, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 212, "global_id": 211, "ranged": true, "spawn_sec": 49}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 2, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "move_speed": 900.0, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098848, "race_id": 16, "change_condition": 2, "master_id": 126, "global_id": 125, "to_condition": 2, "to_global_id": 121, "spawn_sec": 60}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 855, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここは……。\n道を間違ってしまったのでしょうか……。\n見た事もない場所です。", "face": "l823e80920327"}, {"name": "アンナ", "text": "すいません。誰かいませんか？", "face": "l823e80920327"}, {"name": "下忍", "text": "なにやつ。\n見慣れぬ者だな。合言葉を答えよ！\n……山！", "face": "u147"}, {"name": "アンナ", "text": "山？！　え、えーっと……や、山！！", "face": "l823e80920327"}, {"name": "下忍", "text": "怪しいやつめ。\n参る！", "face": "u147"}, {"name": "アンナ", "text": "王子、話が通じないようです！\n向かってきます！", "face": "l823e80920327"}, {"name": "ケイティ", "text": "王子、彼ら忍者は卑劣にも、\n遠巻きに手裏剣を投げる戦法を得意としています。\n一方的にやられる事もあるかもしれません……。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "ふう。\nそれにしても彼らの不規則な動きは\nやはり恐ろしいですね。", "face": "l823e80920327"}, {"name": "アンナ", "text": "忍者たちとのこれまでの闘いの経験が\nなければ、今頃……。", "face": "l823e80920327"}, {"name": "アンナ", "text": "それにしても、\n彼らの隠れ家がこんな所にあったなんて…。\n忍者達は諜報や謀略を得意としてたはず。", "face": "l823e80920327"}, {"name": "アンナ", "text": "彼らは本来、主につかえ、\n私たちと同じで魔物を倒し\n世界を護る事を役割としているのですが……。", "face": "l823e80920327"}, {"name": "アンナ", "text": "魔物がはびこっている今の世では、\n主を魔物に殺された忍者達が\n仕方なく魔物にくみする事もあるようです。", "face": "l823e80920327"}, {"name": "アンナ", "text": "これからも彼らが敵となる事が\nあるかもしれませんね……。\n王子、これからも充分気を付けておきましょう。", "face": "l823e80920327"}]}], "story_talk": true, "active": true}