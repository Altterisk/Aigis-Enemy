, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "spawn_sec": 125}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "base_hp": 4000, "damage_type": "physical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 10, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105296, "race_id": 16, "special_effect_id": 70, "master_id": 631, "global_id": 630, "spawn_sec": 156}, {"enemy_id": 9, "source": "local", "count": 3, "form_count": 2, "hp": 2000, "attack": 1500, "base_hp": 2000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 250, "magic_defense": 40, "attack_range": 160, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099504, "race_id": 4, "change_to": 6, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 106, "global_id": 105, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 106, "spawn_sec": 191}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 60, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "from_condition": 4, "trigger_ticks": 1}], "popups": ["   　　悪天候：炎熱波\n\n・味方に『強力な継続ダメージ』\n・悪天候の影響を受けない特性を持つ\nユニットは『強力な継続ダメージ』を\n受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "コノハ", "text": "……ふむ。\nアオバのやつ、掃除はきちんとやっておるかの？\nどれ、そろそろ確認をしに行くとするかな――。", "face": "u440"}, {"name": "アオバ", "text": "あ、コノハ様！　すみません、時間がかかってしまって。\nですが、きちんと汚れを落として見せました！", "face": "u441"}, {"name": "コノハ", "text": "――おお！？　灯篭がこんなにも綺麗に……ッ！\nアオバ、腕をあげたな。これならば文句はない。\nよし！　それでは今日の稽古を始めるとしよう！", "face": "u440"}, {"name": "アオバ", "text": "はいっ！　宜しくお願いします、コノハ様！", "face": "u441"}, {"name": "コノハ", "text": "――むっ！！　待て、アオバ……！\nこの妖気は……なるほど、餓鬼か。", "face": "u440"}, {"name": "アオバ", "text": "餓鬼……ッ！？\n一体どうしてヤツらが此処に？", "face": "u441"}, {"name": "コノハ", "text": "大方、我が力を欲する邪悪な妖の手先であろう。", "face": "u440"}, {"name": "コノハ", "text": "アオバよ、この窮地を好機へと転じてみせよ！\n今こそ稽古の成果を示す時なり……。\n此処で培った武技を以て奴等を退けるのだ！", "face": "u440"}, {"name": "アオバ", "text": "はい、分かりました！\n餓鬼など、今の私の敵ではありません。\nコノハ様が満足する様な戦をご覧に入れましょう！", "face": "u441"}]}, {"trigger": "battle", "at_sec": 35, "lines": [{"name": "コノハ", "text": "アオバのやつめ、なかなかやるではないか！", "face": "u440"}, {"name": "コノハ", "text": "これ程までに成長していたとはな。\nよし、いいだろう。此を以て最後の修行とする。\nいくぞ、アオバ！　我が進撃に耐えてみせよ！", "face": "u440"}]}, {"trigger": "end", "lines": [{"name": "コノハ", "text": "驚いた……まさか立っていられるとは思わなんだ。\n合格だ、アオバ。其方の執念には恐れ入った。", "face": "u440"}, {"name": "コノハ", "text": "まだ少し早いかもしれぬが、\n特別に其方にはコレを渡しておこう。\n有り難く受け取るのだな。", "face": "u440"}, {"name": "アオバ", "text": "――こ、これはッ……印可状！！\nコノハ様に真に認められたからこそ受け取れる証……。\nアオバは、今かつてないほど感動しています！", "face": "u441"}, {"name": "コノハ", "text": "ちょ、調子に乗るでないわ！\nまだ少し早いかも、と前置きしただろうに……！\nまったく、これだから其方は……。", "face": "u440"}, {"name": "コノハ", "text": "いいか、アオバ？　\n絶大な力を有したとて、流れ着く先を決するは「心」だ。\n力に囚われすぎれば其方も鬼と変わらぬ存在と化す。", "face": "u440"}, {"name": "コノハ", "text": "精神、武技、そして肉体……全ての理を悟り、\nお前自身が己という器の限界を越えることで、\n初めて、その印可状の意味が分かるはずだ。", "face": "u440"}, {"name": "アオバ", "text": "……コノハ様。はいッ、有り難う御座います！\n貴方様から教えて頂いた全ては私の生涯の宝となりました。\n慢心せず励み、酒呑童子を倒してみせます！", "face": "u441"}, {"name": "コノハ", "text": "うむ、息災でな……アオバ。\n然るべき時が来れば、また会う事もあるであろう。\nではな。", "face": "u440"}, {"name": "フドウ", "text": "ふむ、天狗の気配が消えたか。\n……全く以て不思議な存在だのう天狗とは。", "face": "u238"}, {"name": "アオバ", "text": "コノハ様……！　\n本当に、本当に有難うございました……。", "face": "u441"}, {"name": "アオバ", "text": "それと、王子、我が修験にお付き合い頂き感謝します。\n約束通り今よりアオバは貴方の力となりましょう。\nこれから宜しくお願いします！", "face": "u441"}, {"name": "アンナ", "text": "こちらこそ宜しくお願いしますね、アオバさん。\nそれでは王子、帰還するとしましょう！"}]}], "active": true}