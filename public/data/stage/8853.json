{"quest_id": 8853, "name": "黒い泥", "description": "市街地に黒い泥の様な魔物が現れる……。\n＜白の皇帝の出撃時の初期HP減少：中＞\n＜白の皇帝の攻撃力がダウン＞\n神級（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["白の皇帝の出撃時の初期HP減少：中", "白の皇帝の攻撃力がダウン"], "event": "帝国タルタロス編", "event_category": "Empire", "mission_id": 940011, "map_no": 7374, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "form_count": 1, "tags": ["タルタロスの呪縛"], "hp": 62000, "attack": 350, "base_hp": 62000, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 75, "attack_interval": 199, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2168528, "special_effect_id": 2344, "missile_id": 11, "master_id": 40010, "global_id": 13627, "ranged": true, "spawn_sec": 50}, {"enemy_id": 2, "source": "local", "count": 27, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 152, "global_id": 151, "spawn_sec": 151}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "tags": ["タルタロスの呪縛", "置物"], "fixture": true, "uncounted": true, "hp": 30000, "attack": 100, "base_hp": 30000, "base_attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "attack_speed": 1, "attack_wait": 90, "attack_interval": 222, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2168544, "special_effect_id": 2345, "master_id": 40011, "global_id": 13628, "spawn_sec": 178}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 2, "tags": ["ステルス"], "hp": 4000, "attack": 750, "base_hp": 4000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 16, "attack_wait": 10, "attack_interval": 95, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159904, "change_to": 4, "change_condition": 2, "master_id": 38671, "global_id": 12288, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 244}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "uncounted": true, "hp": 299999, "attack": 10, "base_hp": 299999, "base_attack": 10, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 15, "attack_interval": 156, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2168576, "race_id": 16, "master_id": 40013, "global_id": 13630, "route_behaviour": {"force_dead": true}, "spawn_sec": 334}], "popups": ["\n\n\n\n　　――深夜、帝都市街地", "呪いの泥の\n一定範囲内の味方ユニットは\n攻撃力がダウンし、\n継続ダメージを受けます。\n\nまた呪いの泥は、\n戦場にいる呪いの泥の総数に応じて\n攻撃と防御がアップします。", "不定形な呪いの泥は、\n攻撃を行わず\n撃破数に含まれません。", "タルタロスの残穢は、\nブロックされていない間は味方の\n遠距離攻撃の対象になりません。\n\nまたタルタロスの残穢は、\n倒されると黒炎に変化します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――深夜、帝都市街地"}, {"name": "ルチア", "text": "……帝都でも、夜はなんだか不気味だな。", "face": "u2741a1"}, {"name": "エリアス", "text": "おや、あなたも怖がることがあるんですね？", "face": "u2737a1"}, {"name": "ルチア", "text": "元から、そんなに強がりなわけでもない。\nこんな夜には、人並みに警戒だってする。", "face": "u2741a1"}, {"name": "エリアス", "text": "ふふっ、別にからかったわけではないですよ。\nそれに私も、ずっと何か、嫌な予感がしていますし。", "face": "u2737a1"}, {"name": "ルチア", "text": "……ただの予感で済めばいいけど。\n神官戦士と治癒士がそろって違和感を覚えてるんだ。\n今夜の巡回はいつも以上に注意を払って――", "face": "u2741a1"}, {"name": "メーア", "text": "――どわぁぁぁぁぁ！？\nフルスー！　なんでー！？\nなんで追いかけてくるんですかぁー！？", "face": "u2404a1"}, {"name": "フルス", "text": "お姉ちゃんが警邏中にサボって寝てたからです！\nこの一族の恥！　駄目姉！　愚姉ー！！", "face": "u2738a1"}, {"name": "ルチア", "text": "……嫌な予感、あれかな？", "face": "u2741a1"}, {"name": "エリアス", "text": "さすがに、あれはただの姉妹喧嘩かと。\n昇進したというのに、彼女はいつもどおりですね……。", "face": "u2737a1"}, {"name": "エリアス", "text": "それにしても、よくできた妹がいると、\n姉はダメになるものなのでしょうか……。", "face": "u2737a1"}, {"name": "メーア", "text": "だーれが駄目姉ですかー！", "face": "u2404a1"}, {"name": "フルス", "text": "お姉ちゃんのことですよ！\n――って、あっ、すみません、\nうちの愚姉がまたご迷惑をおかけしまして。", "face": "u2738a1"}, {"name": "エリアス", "text": "いえいえ。\nそれはともかく、今夜は何か起こる気配がします。\nおふたりも十分に警戒を――", "face": "u2737a1"}, {"name": "？？？", "text": "――みんな、ここは大丈夫？", "face": "u2740a1"}, {"name": "メーア", "text": "わわっと！？\nアネットじゃないですか。\nそんなに急いで、何かあったんですか？", "face": "u2404a1"}, {"name": "アネット", "text": "向こうの区画で、黒いどろどろした魔物が出たの。\nあちこちに出現してるから、ここにも出てくるかも。", "face": "u2740a1"}, {"name": "ルチア", "text": "黒い、泥……？", "face": "u2741a1"}, {"name": "エリアス", "text": "こんな市街地に魔物とは……。\n付近の詰め所に連絡を！\n市民に被害が出る前に討伐します！", "face": "u2737a1"}]}, {"trigger": "battle", "at_sec": 334, "lines": [{"name": "エリアス", "text": "このあたりに出現した魔物は、\nすべて倒せたようですね。", "face": "u2737a1"}, {"name": "フルス", "text": "はぁ……。切っても切ってもドロドロで、\nすごく気味が悪かったです……。", "face": "u2738a1"}, {"name": "ルチア", "text": "いったい何だったんだ、あれは。\n魔物にしては、何というのか、異質な感じだった。", "face": "u2741a1"}, {"name": "アネット", "text": "…………っ！\nルー、どうしたの……？", "face": "u2740a1"}, {"name": "エリアス", "text": "アネットのフェンリルが、\nまだ警戒態勢を解いていない……。", "face": "u2737a1"}, {"name": "エリアス", "text": "皆さん、警戒を。\n何かが潜んでいるのかもしれません！", "face": "u2737a1"}]}, {"trigger": "end", "lines": [{"name": "メーア", "text": "わっ、またどろどろしたのが！？", "face": "u2404a1"}, {"name": "エリアス", "text": "なっ……！　その姿は……！", "face": "u2737a1"}, {"name": "ルチア", "text": "ば、馬鹿な……陛下！？\nいや、黒い泥が陛下の形を模しているというのか！？", "face": "u2741a1"}]}, {"trigger": "end", "lines": [{"name": "アネット", "text": "……あっ、形が崩れて――", "face": "u2740a1"}, {"name": "フルス", "text": "……消えましたね。気配も、完全に。", "face": "u2738a1"}, {"name": "ルチア", "text": "いったい、何が起きているんだ……。", "face": "u2741a1"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 20, "params": [150]}, {"kind": "term", "influence": 18, "params": [150]}, {"kind": "term", "influence": 14, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}, {"kind": "term", "influence": 9, "params": [50], "expression": "IsClassType(98);", "expression_human": "its class type is one of 98"}], "enemies": [{"enemy_id": 1, "hp": 62000, "attack": 350, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2168528}, {"enemy_id": 2, "hp": 2500, "attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "pattern_id": 2097856}, {"enemy_id": 3, "hp": 30000, "attack": 100, "damage_type": "physical", "armor_defense": 100, "magic_defense": 5, "pattern_id": 2168544}, {"enemy_id": 4, "hp": 4000, "attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2159904}, {"enemy_id": 4, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 6, "hp": 299999, "attack": 10, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "pattern_id": 2168576}]}, "active": true}