{"quest_id": 1705, "name": "病魔の鼠", "description": "協力者を探す王子達を待ち受けるものとは。\n＜魔界深層：味方の攻撃、防御が半減＞\n＜魔界で能力低下しない味方の攻防1.3倍＞\n＜時間経過によるコスト回復量が低下＞", "modifier_notes": ["魔界深層：味方の攻撃、防御が半減", "魔界で能力低下しない味方の攻防1.3倍", "時間経過によるコスト回復量が低下"], "event": "ストーリーミッション7", "event_category": "Story", "mission_id": 100007, "map_no": 1112, "level": 100, "multiplier": 1.0, "charisma": 44, "capacity": 10, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}, {"kind": "term", "influence": 31, "params": [130]}, {"kind": "term", "influence": 32, "params": [130]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 10, "attack_interval": 76, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100224, "race_id": 3, "change_to": 1, "change_condition": 4, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 233, "global_id": 232, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 231, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 3, "source": "local", "count": 25, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 1, "attack_wait": 15, "attack_interval": 62, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110064, "race_id": 12, "special_effect_id": 168, "master_id": 30315, "global_id": 3934, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 34, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "true", "armor_defense": 50, "attack_range": 200, "attack_speed": 1, "attack_wait": 20, "attack_interval": 101, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109376, "missile_id": 204, "missile": {"speed": 8.0, "splash": 120}, "master_id": 30312, "global_id": 3931, "ranged": true, "spawn_sec": 3}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 100000, "attack": 4500, "base_hp": 100000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "attack_speed": 115, "attack_wait": 100, "attack_interval": 401, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109424, "race_id": 13, "master_id": 30314, "global_id": 3933, "spawn_sec": 77}, {"enemy_id": 6, "source": "local", "count": 7, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "attack_range": 160, "attack_speed": 1, "attack_wait": 40, "attack_interval": 143, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110128, "race_id": 2, "change_to": 6, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 30318, "global_id": 3937, "ranged": true, "variants": [{"hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110112, "race_id": 2, "master_id": 30319, "global_id": 3938}], "spawn_sec": 118}, {"enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "hp": 4000, "attack": 330, "base_hp": 4000, "base_attack": 330, "damage_type": "true", "armor_defense": 50, "attack_range": 250, "attack_speed": 1, "attack_wait": 20, "attack_interval": 101, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109376, "missile_id": 204, "missile": {"speed": 8.0, "splash": 120}, "master_id": 30313, "global_id": 3932, "ranged": true, "spawn_sec": 154}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 400, "magic_defense": 30, "attack_speed": 1, "attack_wait": 15, "attack_interval": 70, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110080, "special_effect_id": 222, "master_id": 30316, "global_id": 3935, "spawn_sec": 196}], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンメイジ", "text": "――我々に抵抗を続ける人間共が、\nここに近づいているとの事だ。\n見つけ次第殺しておけ、ヘンゼル。", "face": "l02bea2b15aeb"}, {"name": "ヘンゼル", "text": "はっ、デーモンメイジ様。\n……しかし何故デーモンメイジ様自ら\nこのような場所にお越しに？", "face": "lab29374aa197"}, {"name": "デーモンメイジ", "text": "我ら高位デーモンに召集がかかっている。\n用があるのはこの先だ、どうせ通るなら暇つぶしに\n奴隷の一匹でも連れて行こうかと思っただけだ。", "face": "l02bea2b15aeb"}, {"name": "ヘンゼル", "text": "……デーモンメイジ様、お言葉ですが\nここ最近デーモン様方の御遊びの相手にと、\n多数の奴隷が連れて行かれ、戻ってきておりません。", "face": "lab29374aa197"}, {"name": "ヘンゼル", "text": "抵抗を続ける人間達がきた際、これ以上\n奴隷の数が少なくなっていてはいささか不安かと。\n何せ、捨て駒程度にしか使えぬ奴隷達ですから。", "face": "lab29374aa197"}, {"name": "デーモンメイジ", "text": "我らデーモン以外の種は本当に脆弱すぎるな。\nあの程度の事で壊れ、使い物にならなくなるとは。\n……まぁそれならば仕方あるまい。", "face": "l02bea2b15aeb"}, {"name": "デーモンメイジ", "text": "レヴィアタン復活の時は近い。くれぐれも\n邪魔だてされぬよう、ここで奴らを排除しておけ。\n何かあればすぐ連絡を寄越すように。", "face": "l02bea2b15aeb"}, {"name": "ヘンゼル", "text": "畏まりました、デーモンメイジ様。", "face": "lab29374aa197"}, {"name": "ヘンゼル", "text": "（――……行ったか。\nしかし、上空にはフライデーモンの監視の目。\nこのまま彼らと接触する訳には……アレは！）", "face": "lab29374aa197"}, {"name": "バシラ", "text": "――この地形の特徴……待ち合わせ場所は\nこの辺りのようですが……。", "face": "u28"}, {"name": "ケイティ", "text": "……まだ誰も来ていないようですね。\n顔も名も判らぬ以上、ひとまずここで\n待つしかなさそうです。", "face": "u114"}, {"name": "フライデーモン", "text": "――……！！", "face": "l4606509e62e7"}, {"name": "ヘンゼル", "text": "（……ここに来たという事は恐らく彼らが……\nだがデーモンの目がある以上、見逃す訳にも\nいかないか……しょうがない）", "face": "lab29374aa197"}, {"name": "ヘンゼル", "text": "侵入者だ！　奴隷達よ、ワーラットを解き放て！\nデーモン様に逆らう愚かな人間達に、\n死の鉄槌を下すのだ！！", "face": "lab29374aa197"}]}, {"trigger": "start", "lines": [{"name": "バシラ", "text": "み、見つかってしまいました……\n……？　なんでしょう、\nあのネズミのような魔物……。", "face": "u28"}, {"name": "テルマ", "text": "あの容貌……恐らくは深層に住まう\n魔物の一種『ワーラット』かと。", "face": "u296"}, {"name": "シャロン", "text": "ワーラットは強力な疫病を宿しているとの事です。\n近づけば汚染され、痛手を負う事になるでしょう。\n接触の際はどうかお気を付けください！", "face": "u283"}, {"name": "アンナ", "text": "……王子、ここは一旦\n戦って切り抜けるしかなさそうです！\nご指示をお願いします！", "face": "l712fde1e615d"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "――落ち着いてください皆さん、\n我々は皆さんと戦いに来たわけでは！", "face": "u114"}, {"name": "バシラ", "text": "そうですよ～！　同じ人間同士、\n話合いましょう！", "face": "u28"}, {"name": "ヘンゼル", "text": "……ここならデーモンの目は届かないか。", "face": "lab29374aa197"}, {"name": "バシラ", "text": "……へ？", "face": "u28"}, {"name": "ヘンゼル", "text": "手荒な事をしてすまない。デーモン達の目がある中、\n堂々と君達と接触する訳にはいかなかったからね。\n君達が計画の協力者、王子達で間違いないね？", "face": "lab29374aa197"}, {"name": "ケイティ", "text": "はい……ということは、貴方が？", "face": "u114"}, {"name": "ヘンゼル", "text": "僕の名はヘンゼル。デーモン達の動向を探る為、\nデーモンメイジの下で働いている……っと、\n悠長に話している場合でもないね、手短に話そう。", "face": "lab29374aa197"}, {"name": "ヘンゼル", "text": "この魔界がレヴィアタンの背中にある事は\n聞いていると思う。そして、魔界……レヴィアタンが\n物質界に近づきつつあることも。", "face": "lab29374aa197"}, {"name": "バシラ", "text": "レヴィアタンが完全に復活すると、\n物質界を食い尽くすばかりか、\nこの魔界もろとも虚無に返す……でしたっけ？", "face": "u28"}, {"name": "ヘンゼル", "text": "あぁ、その通りさ。それを止める手段は一つだけ。\n……簡単な話だよ、レヴィアタンを倒し活動を\n停止させてしまえばいい。", "face": "lab29374aa197"}, {"name": "モーティマ", "text": "お、おいおい、こんなバカみたいなデカブツを\nぶっ倒すだと！　んな事、出来るわけねーだろ！？", "face": "u14"}, {"name": "ヘンゼル", "text": "もちろん外から幾ら攻撃しても無意味さ。\nけど、内側からなら……レヴィアタンの体内に入り、\n直接心臓を破壊すれば、活動は停止するはずだ。", "face": "lab29374aa197"}, {"name": "アンナ", "text": "レヴィアタンの心臓を破壊……しかし、\n体内に入るなど……そのような事が\n可能なのでしょうか？", "face": "l712fde1e615d"}, {"name": "ヘンゼル", "text": "レヴィアタンが動くには莫大なエネルギーを\n必要とする。そのエネルギーの糧を運ぶために、\n心臓へと繋がる道があるとは言われていた。", "face": "lab29374aa197"}, {"name": "ヘンゼル", "text": "ただその入り口はデーモンの中でも極一部、\n高位デーモンにしか知らされていなかったんだ。\n……けど、ようやくその入り口の調べがついた所さ。", "face": "lab29374aa197"}, {"name": "ケイティ", "text": "そのような入口が……時は一刻を争います。\n早速案内をお願いできますか！", "face": "u114"}, {"name": "ヘンゼル", "text": "もちろんだ。ただ、僕は引き続き\nデーモン達の動向を探る必要がある。\nリエーレ、すまないが彼らを頼むよ。", "face": "lab29374aa197"}, {"name": "リエーレ", "text": "了解、コイツらの事は任せといてくれ。\nさぁ王子とやら、時間がないんだろ。\nレヴィアタンの入り口はこっちだ、ついといで！", "face": "u490"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}, {"kind": "term", "influence": 31, "params": [130]}, {"kind": "term", "influence": 32, "params": [130]}, {"kind": "term", "influence": 18, "params": [300]}], "enemies": [{"enemy_id": 1, "hp": 2600, "attack": 600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2100224}, {"enemy_id": 1, "form_index": 1, "hp": 2600, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "pattern_id": 2100208}, {"enemy_id": 3, "hp": 5850, "attack": 390, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "pattern_id": 2110064}, {"enemy_id": 4, "hp": 3900, "attack": 250, "damage_type": "true", "armor_defense": 50, "pattern_id": 2109376}, {"enemy_id": 5, "hp": 130000, "attack": 5850, "damage_type": "physical", "armor_defense": 50, "magic_defense": 5, "pattern_id": 2109424}, {"enemy_id": 6, "hp": 7800, "attack": 300, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2110128}, {"enemy_id": 8, "hp": 5200, "attack": 330, "damage_type": "true", "armor_defense": 50, "pattern_id": 2109376}, {"enemy_id": 9, "hp": 39000, "attack": 1950, "damage_type": "physical", "armor_defense": 400, "magic_defense": 30, "pattern_id": 2110080}]}, "active": true}