"magic_defense": 60, "attack_range": 30, "attack_speed": 1, "attack_wait": 90, "attack_interval": 234, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2149168, "race_id": 4, "special_effect_id": 72, "missile_id": 275, "missile": {"speed": 7.0}, "master_id": 39537, "global_id": 13154, "ranged": true, "from_condition": 5}, {"enemy_id": 25, "source": "local", "count": 14, "form_count": 1, "tags": ["機械"], "hp": 50000, "attack": 800, "base_hp": 50000, "base_attack": 800, "damage_type": "physical", "armor_defense": 650, "magic_defense": 30, "attack_range": 150, "attack_speed": 80, "attack_wait": 75, "attack_interval": 235, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2171696, "race_id": 5, "special_effect_id": 2483, "missile_id": 45, "master_id": 40882, "ranged": true}, {"enemy_id": 26, "source": "local", "count": 3, "form_count": 1, "tags": ["機械"], "hp": 100000, "attack": 3000, "base_hp": 100000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 30, "attack_speed": 200, "attack_wait": 120, "attack_interval": 596, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120784, "race_id": 5, "special_effect_id": 451, "master_id": 40727, "global_id": 14344, "spawn_sec": 242}, {"enemy_id": 27, "source": "local", "count": 8, "form_count": 1, "tags": ["機械"], "hp": 14500, "attack": 1000, "base_hp": 14500, "base_attack": 1000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_speed": 200, "attack_wait": 120, "attack_interval": 596, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2120784, "race_id": 5, "special_effect_id": 450, "master_id": 40726, "global_id": 14343, "spawn_sec": 257}, {"enemy_id": 28, "source": "local", "count": 4, "form_count": 2, "hp": 225000, "attack": 4000, "base_hp": 225000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 711, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099712, "race_id": 5, "change_to": 28, "change_condition": 5, "master_id": 40901, "to_condition": 5, "spawn_sec": 353}, {"enemy_id": 28, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 225000, "attack": 3500, "base_hp": 225000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_range": 200, "attack_speed": 300, "attack_wait": 120, "attack_interval": 406, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099728, "race_id": 5, "change_to": 29, "change_condition": 1, "missile_id": 76, "missile": {"speed": 3.0, "splash": 133}, "master_id": 40902, "ranged": true, "from_condition": 5, "variants": [{"hp": 225000, "attack": 4000, "base_hp": 225000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 300, "attack_wait": 120, "attack_interval": 711, "move_speed": 120.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099712, "race_id": 5, "missile_id": 58, "master_id": 40903}]}], "popups": ["\n\n\n\n　──オロバスカップ終了後。", "魔神オロバスがいる間、\n全ての敵味方の\n攻撃がアップします。\n\nまた魔神オロバスは攻撃を受けると\n受けたダメージの50%のダメージで\n攻撃したユニットへ反撃を行います。", "魔神オロバスは\n特定の位置に到着すると\n黒いオーラを纏い、\n味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n\nしばらくすると疲れて反撃、\n引き付けの効果が一定時間\nなくなります。"], "dialogue": [{"trigger": "battle", "at_sec": 52, "lines": [{"text": "──オロバスカップ終了後。"}, {"name": "オロバス", "text": "まずはおめでとう。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "第一回オロバスカップの優勝者である君たちは、\n名実共に新時代のトップアイドルへ駆け上がった。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "そしてありがとう。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "素晴らしい……素晴らしいライブだったよ。\nアンコールの終わり、俺は一歩も動けなかった。\n君たちの成長に心から感動してしまったんだ。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "王子の呪いはすでに解いてある。\nだが、勝者への報酬には足りないだろう。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "願いを言ってくれ、魔神オロバスがそれを叶えよう。\nちなみに神の楔が必要なレベルの奇跡は無理だぜ！", "face": "l6c31c92fccb4"}, {"name": "ユキヒメ", "text": "……あの後、みんなで話し合ったんだ。"}, {"name": "ユキヒメ", "text": "最初はすっごく嫌だったし迷惑だったけど、\n結果的にはアイドルをやれてよかったねって。"}, {"name": "オロバス", "text": "うんうん。", "face": "l6c31c92fccb4"}, {"name": "ユキヒメ", "text": "こうしてアイドルをやって、初めて分かったの。\n私たちの心の中に、伝えたい想いがあったことを。"}, {"name": "アージェ", "text": "それは他者への愛であり、感謝であり、\nまた己という存在の証明でもありました。"}, {"name": "アルタ", "text": "故に、即物的な願いで思い出を穢したくはありません。"}, {"name": "ユキヒメ", "text": "だから、ね？"}, {"name": "ユキヒメ", "text": "──殴りたいんだって。"}, {"name": "オロバス", "text": "………………。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "……誰が？", "face": "l6c31c92fccb4"}, {"name": "ユキヒメ", "text": "みんなが。"}, {"name": "オロバス", "text": "……誰を？", "face": "l6c31c92fccb4"}, {"name": "ユキヒメ", "text": "あなたを。"}, {"name": "オロバス", "text": "……まじで？", "face": "l6c31c92fccb4"}, {"name": "ユキヒメ", "text": "うん。"}, {"name": "オロバス", "text": "～～～～ッ！", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "結構！　この魔神オロバス、不始末の責任は取る男！", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "新星たちよ、君たちの願いはここに成就する！", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "ちなみに俺は受けた攻撃を半分の威力で反射するが、\n生まれ持ったカルマだからそこだけは勘弁してくれな！", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "オロバス！(カモンの意)", "face": "l6c31c92fccb4"}]}, {"trigger": "end", "lines": [{"name": "オロバス", "text": "──ぐえーっ！？", "face": "l6c31c92fccb4"}, {"name": "キュウビ", "text": "気分爽快よのー。"}, {"name": "アルタ", "text": "全力殴打モードを終了します。お疲れさまでした。"}, {"name": "ユキヒメ", "text": "（ドキドキ）"}, {"name": "祓剣主神", "text": "まあまあ、今回はそれぐらいにね。\nオロバスの安否はどうでもいいけど、\n変な趣味に目覚めてもいけないし。", "face": "u2556a1"}, {"name": "ユキヒメ", "text": "はーい。"}, {"name": "オロバス", "text": "……もう手遅れだぜ？", "face": "l6c31c92fccb4"}, {"name": "祓剣主神", "text": "お前の話はしてないんだよ。", "face": "u2556a1"}, {"name": "アンナ", "text": "何はともあれ王子の呪いも解けたことですし、\n今回も無事に一件落着というところでしょうか？"}, {"name": "ポミエ", "text": "（あ、強引にまとめに入った）", "face": "u2828a1"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "キュウビ", "text": "うむうむ。わらわの献身に感謝するがいい。"}, {"name": "ラタトスク", "text": "オロバスも、これに懲りたらもう悪さをするでないぞ。"}, {"name": "オロバス", "text": "ああ、反省してこれからは真っ当に生きる──", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "──とでも言うと思ったか馬鹿め！", "face": "l6c31c92fccb4"}, {"name": "ケイティ", "text": "なっ、急に飛び上がって──", "face": "u2433a1"}, {"name": "祓剣主神", "text": "すごいな、どこにそんな力が残ってたんだろ。", "face": "u2556a1"}, {"name": "オロバス", "text": "ふっ、知らんようだから教えてやろう。\nこの魔神オロバス、元気だけは人一倍ある男！\nそして喉元を過ぎれば熱さを忘れる男だと！", "face": "l6c31c92fccb4"}, {"name": "ラタトスク", "text": "馬鹿はうぬじゃが？"}, {"name": "オロバス", "text": "しばしの別れだ、王国諸君。\n俺はこれより貯蓄フェーズへと入る、\n金と力が溜まった頃に再び相見えよう。", "face": "l6c31c92fccb4"}, {"name": "オロバス", "text": "オロバス！(また会おうねの意)", "face": "l6c31c92fccb4"}, {"name": "アンナ", "text": "…………。"}, {"name": "アラン", "text": "嵐のような男でしたね。", "face": "u1511a1"}, {"name": "ウルカノ", "text": "ありゃあ、マレスに準ずる厄介さだぜ。", "face": "u1669a1"}, {"name": "ラタトスク", "text": "最後にどっと疲れたのじゃあ……。"}, {"name": "ユキヒメ", "text": "アイドルは楽しかったけど──"}, {"name": "ユキヒメ", "text": "もう、会いたくないなぁ……。"}]}, {"trigger": "end", "lines": [{"name": "レーヴ", "text": "（長年その正体が謎に包まれていた馬面の魔神……）", "face": "u454"}, {"name": "レーヴ", "text": "（彼と相対した人々は、口を揃えてこう言いました）", "face": "u454"}, {"name": "レーヴ", "text": "（魔神オロバスは、特大級の馬鹿であったと──）", "face": "u454"}, {"name": "レーヴ", "text": "（著：王国書記官、レーヴ）", "face": "u454"}]}], "active": true}