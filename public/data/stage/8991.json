{"quest_id": 8991, "name": "勝者への報酬", "description": "第一回オロバスカップで優勝した王子たち。\nそんな一行による魔神オロバスへの願いは、\nこれまでの鬱憤を晴らす方法で……！？\n神級EX（★１獲得の目安：平均覚醒Lv25）", "event": "新星たちのトリニティライブ", "event_category": "Emergency", "mission_id": 200572, "map_no": 7460, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 4, "tags": ["魔神"], "hp": 488000, "attack": 2000, "base_hp": 488000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 12, "attack_interval": 74, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2171520, "race_id": 3, "special_effect_id": 2479, "change_to": 1, "master_id": 40883, "sp_change_to": [40886], "route_behaviour": {"transforms": [{"to": 40886}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["魔神"], "hp": 488000, "attack": 2000, "base_hp": 488000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 12, "attack_interval": 74, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2171712, "race_id": 3, "special_effect_id": 2480, "change_to": 3, "master_id": 40884}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["魔神"], "hp": 488000, "attack": 2000, "base_hp": 488000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 12, "attack_interval": 74, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2171728, "race_id": 3, "special_effect_id": 2481, "master_id": 40885}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["魔神"], "hp": 488000, "attack": 2000, "base_hp": 488000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 500,