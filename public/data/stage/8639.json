{"quest_id": 8639, "name": "雪原を覆う魔力の嵐", "description": "魔物を倒し、魔力嵐の圏内から退避せよ！\n＜魔力嵐(弱)：出撃時の初期HP減少(小)\n　爆風範囲、魔法ダメージが減少＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["魔力嵐(弱)：出撃時の初期HP減少(小)\n　爆風範囲、魔法ダメージが減少"], "event": "導きの白狼", "event_category": "History", "mission_id": 920236, "map_no": 9387, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 50, "params": [80]}, {"kind": "term", "influence": 22, "params": [80]}, {"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 22, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_speed": 50, "attack_wait": 30, "attack_interval": 165, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "master_id": 185, "global_id": 184, "spawn_sec": 47}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 184, "global_id": 183, "ranged": true, "spawn_sec": 72}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "spawn_sec