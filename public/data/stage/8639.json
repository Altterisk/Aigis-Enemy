": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2162320, "race_id": 11, "special_effect_id": 229, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38997, "global_id": 12614, "ranged": true, "spawn_sec": 120}, {"enemy_id": 9, "source": "local", "count": 1, "level": 90, "form_count": 2, "hp": 7000, "attack": 250, "base_hp": 7000, "base_attack": 250, "damage_type": "magical", "armor_defense": 450, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_to": 9, "change_condition": 4, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38793, "global_id": 12410, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 12409, "spawn_sec": 146}, {"enemy_id": 9, "source": "local", "count": 1, "level": 90, "form_index": 1, "form_count": 2, "hp": 7000, "attack": 350, "base_hp": 7000, "base_attack": 350, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 155, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2160624, "race_id": 18, "change_to": 8, "change_condition": 4, "missile_id": 330, "missile": {"speed": 7.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 38792, "global_id": 12409, "ranged": true, "from_condition": 4, "trigger_ticks": 1}], "popups": ["　　【魔力嵐(弱)】\n・ユニット配置時の\n　初期HPが少し減少\n\n・味方の魔法攻撃による\n　ダメージが減少\n\n・敵味方の爆風範囲が減少"], "dialogue": [{"trigger": "start", "lines": [{"name": "マータン", "text": "――うおー！\nマータンダッシュ！　マータンスプリントー！！", "face": "u2524a1"}, {"name": "フラフィー", "text": "これだけ雪が積もっている中を、\nどうしたらあんな勢いで……！？", "face": "u811"}, {"name": "ファオル", "text": "マータンは白熊の獣人族だから……。\nなんていうのか、勢いがすごいよね。", "face": "u2513a1"}, {"name": "ケイティ", "text": "単純に、この辺りに慣れているのも要因かと。\n我々にとっては未知の世界ですからね。", "face": "u114"}, {"name": "マータン", "text": "わはははー！\nついてきてるかー！？", "face": "u2524a1"}, {"name": "フラフィー", "text": "あのー！　もう少し速度をですねー！？", "face": "u811"}, {"name": "パルセ", "text": "……いえ、こちらの\n行軍速度を上げる方が良いかもしれません。", "face": "u2276a1"}, {"name": "パルセ", "text": "上空のドーンブリンガーが、\n魔力嵐の勢力増大を確認しました。\nもう少しで、この辺りを直撃します！", "face": "u2276a1"}, {"name": "クラリーチェ", "text": "魔力嵐って、狭間の雪原の空をずーっと覆ってる、\n魔力の乱流でしょ？\n空の上のことなら気にする必要ないんじゃないの？", "face": "u472"}, {"name": "ユキヒメ", "text": "うぅん……氷霊たちが怯えてる……。\n嵐が降りてくるって。\n空の上の嵐が、大地に吹き荒れるって。", "face": "u667"}, {"name": "クラリーチェ", "text": "やばいやつじゃん……！\n王子急いで急いで！", "face": "u472"}, {"name": "パルセ", "text": "ドーンブリンガーの観測した範囲では、\nまだ規模の小さな嵐のようではありますが……。", "face": "u2276a1"}, {"name": "パルセ", "text": "しかし、魔力嵐に巻き込まれれば\n魔力の散逸により魔法の力が弱体化し、\nさらには生命力も奪われる可能性があります。", "face": "u2276a1"}, {"name": "ファオル", "text": "……急ごう。\n魔力の乱れに釣られて、魔物も集まってきた！", "face": "u2513a1"}, {"name": "ユリクセス", "text": "総員戦闘準備！\n移動しつつ魔物を撃退するぞ！", "face": "u2193a1"}]}, {"trigger": "end", "lines": [{"name": "ユリクセス", "text": "ようやく魔力嵐を抜けたか……。", "face": "u2193a1"}, {"name": "メーリス", "text": "あれでまだ弱い方？\nもっと大きな魔力嵐とか想像したくないかも。", "face": "u78"}, {"name": "マータン", "text": "おっ、ちゃんとついてきたな！\n南の連中もなかなかやる！", "face": "u2524a1"}, {"name": "マータン", "text": "もう少しで雪枝の里に到着する。\nまずはマータンが、長老たちに報告するから、\nお前たちは入口で待ってるといい！", "face": "u2524a1"}, {"name": "ファオル", "text": "マータンひとりに任せて、大丈夫……？", "face": "u2513a1"}, {"name": "マータン", "text": "いや、わかんない。", "face": "u2524a1"}, {"name": "ファオル", "text": "まーたぁん！？", "face": "u2513a1"}, {"name": "マータン", "text": "でも、今は里長が出かけてるから、\nずばーんと勢いで行くのが大正解。\nこういうのはパワーが大事。", "face": "u2524a1"}, {"name": "ファオル", "text": "ああ、丁寧にあれこれ話すより、\n南の人たちの目的を端的に伝えて、\n敵対してないよって分かってもらうんだ？", "face": "u2513a1"}, {"name": "ユキヒメ", "text": "（あれで通じるの、親友同士って感じするね）", "face": "u667"}, {"name": "クラリーチェ", "text": "（友だちだからって分かるものじゃなくない？）", "face": "u472"}, {"name": "ユキヒメ", "text": "（私、クラリーチェの考えてること、\nちょっと分かるよ……？）", "face": "u667"}, {"name": "クラリーチェ", "text": "（……緊張してる場面で、\nそういう事言わないでよ！　もう！）", "face": "u472"}, {"name": "マータン", "text": "よーし、じゃあ行くぞー！\nマータン様のご帰還だー！", "face": "u2524a1"}]}], "active": true}