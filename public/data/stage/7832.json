"master_id": 30706, "global_id": 4325, "spawn_sec": 2}, {"enemy_id": 9, "source": "local", "count": 12, "form_count": 1, "tags": ["アーマー", "バレンタイン", "チョコレート騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132720, "master_id": 34530, "global_id": 8147, "spawn_sec": 13}, {"enemy_id": 10, "source": "local", "count": 12, "form_count": 1, "tags": ["バレンタイン"], "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 30, "attack_range": 170, "attack_speed": 26, "attack_wait": 20, "attack_interval": 89, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142160, "missile_id": 815, "missile": {"speed": 7.0}, "master_id": 35762, "global_id": 9379, "ranged": true, "spawn_sec": 39}, {"enemy_id": 11, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー", "バレンタイン", "チョコレート騎士団"], "hp": 10000, "attack": 650, "base_hp": 10000, "base_attack": 650, "damage_type": "physical", "armor_defense": 350, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132736, "master_id": 34531, "global_id": 8148, "spawn_sec": 84}], "dialogue": [{"trigger": "start", "lines": [{"name": "ローリエ", "text": "はっ、早く王子のところへ戻らないと！", "face": "u1692a1"}, {"name": "ミリアム", "text": "っ、少し待ってください。\n前方に誰かが倒れています。\nあれは……アヅミ、さん？", "face": "u1694a1"}, {"name": "ポミエ", "text": "アヅミさん！　どうしたんですかアヅミさん！", "face": "u1422a1"}, {"name": "アヅミ", "text": "ど、泥棒猫……旦那様が、危な……。", "face": "u1329a1"}, {"name": "ローリエ", "text": "き、気絶してしまわれました……。", "face": "u1692a1"}, {"name": "エクス", "text": "──ッ、みなさんちょうど良いところに！\n彼女たちを抑えるのを手伝ってください！", "face": "u963"}]}, {"trigger": "start", "lines": [{"name": "ローリエ", "text": "エクスさん？　ここでいったいなにが──", "face": "u1692a1"}, {"name": "堕姫", "text": "──おぬしらも、わらわから王子を奪う気か？", "face": "u547"}, {"name": "ポミエ", "text": "あっ……。", "face": "u1422a1"}, {"name": "ヒルデ", "text": "うふふ……これはおかしな話ですわね？", "face": "u797"}, {"name": "ヒルデ", "text": "私の王子様がいつ、\n貴方のものになったのかしら？\nねぇ、誘拐犯の女狐さん？", "face": "u797"}, {"name": "王子", "text": "…………（おろおろ）", "face": "u1"}, {"name": "ツキコ", "text": "みんな邪魔……王子さまは、ツキコと一緒にいるの。", "face": "u1105a1"}, {"name": "ミリアム", "text": "……少し、遅かったようですね。", "face": "u1694a1"}, {"name": "グレーターデーモン", "text": "精神干渉下にある女性は、\n魔界カカオの影響を強く受ける。\n今回も伐採は早めに行うことだね。", "face": "l45969ed547e2"}, {"name": "ローリエ", "text": "と、ととと、とにかく王子を救出しまーす！", "face": "u1692a1"}]}, {"trigger": "end", "lines": [{"name": "エクス", "text": "ローリエさん、ご協力感謝しますわ。\n急に色んな方が王子様を連れ去ろうとして、\nどうにも私たちだけでは手に負えず……。", "face": "u963"}, {"name": "ローリエ", "text": "あはは……大変でしたね。", "face": "u1692a1"}, {"name": "ポミエ", "text": "エクスさん、かくかくしかじかなのですが、\n魔界カカオの妖精さんを見掛けませんでしたか？", "face": "u1422a1"}, {"name": "エクス", "text": "なるほど……そういうことだったのですね。\nそれならツキコさんが何か知っているはず──", "face": "u963"}, {"name": "ツキコ", "text": "…………ぷぅ。", "face": "u1105a1"}, {"name": "ミリアム", "text": "（拗ねてる……）", "face": "u1694a1"}, {"name": "エクス", "text": "王子様、お願いします。", "face": "u963"}, {"name": "王子", "text": "…………（こしょこしょ）", "face": "u1"}, {"name": "ツキコ", "text": "妖精さんは世界樹に向かったみたいだよ。", "face": "u1105a1"}, {"name": "ミリアム", "text": "（なんて素早い手のひら返し……！？）", "face": "u1694a1"}, {"name": "ローリエ", "text": "世界樹といえばラタトス……\nあれ、ラタトスクさんはどこに？", "face": "u1692a1"}, {"name": "ミリアム", "text": "先ほどまで一緒にいたはずですが……\nはぐれたのかもしれません、探してきます。", "face": "u1694a1"}, {"name": "ツキコ", "text": "………………。", "face": "u1105a1"}, {"name": "王子", "text": "…………（冷や汗）", "face": "u1"}, {"name": "ツキコ", "text": "約束、ね？", "face": "u1105a1"}, {"name": "ローリエ", "text": "（二人の間にいったいどんな交渉が……！？）", "face": "u1692a1"}]}], "active": true}