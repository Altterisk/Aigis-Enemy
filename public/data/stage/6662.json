p": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 141}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 322, "global_id": 321, "ranged": true, "spawn_sec": 181}, {"enemy_id": 6, "source": "local", "count": 2, "level": 70, "form_count": 1, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_speed": 50, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100208, "race_id": 3, "master_id": 232, "global_id": 231, "spawn_sec": 186}, {"enemy_id": 7, "source": "local", "count": 7, "form_count": 1, "hp": 1200, "attack": 50, "base_hp": 1200, "base_attack": 50, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 140, "attack_speed": 30, "attack_wait": 75, "attack_interval": 241, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 30909, "global_id": 4528, "ranged": true, "spawn_sec": 211}], "popups": ["　　　　【魔界の瘴気】\n攻撃力と防御力、時間経過による\nコスト回復量が低下します。\n王子【神器装備】王子【ケラウノス】\n皇帝を配置すると攻撃力と防御力の\n低下について無効化することが\nできます。\n一部ユニットも無効化できます。", "魔界ボアは、拠点には向かわず\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ノワール", "text": "魔界ボアの群れが暴れているという話だったが……。\n何やら様子がおかしいな。", "face": "u679"}, {"name": "レアン", "text": "緊急事態だっていうから、\n振袖姿のままで急いで駆けつけたんだが……。\n何だか楽しそうに歩き回っているだけに見えるな。", "face": "u438"}, {"name": "ノワール", "text": "魔王軍が何かを企んでいるのかと思ったが、\nどうやらそういうわけでは無いらしい。\nはてさて、どうしたものか……食べるか？", "face": "u679"}, {"name": "フィリス", "text": "いや、害がないなら放っておいて良いんじゃないか？\n襲ってくるわけでもないし……。", "face": "u40"}, {"name": "アリサ", "text": "確かに……全くこっちを見ようともしませんね。\nぶももーって歩きまわって、すごく楽しそうです。", "face": "u24"}, {"name": "ケイティ", "text": "そうですね。害が無いのなら、\nあえて危険を冒す必要も無いのですが……。\n今回は魔界ボアの足音が問題なのでは？", "face": "u574"}, {"name": "レアン", "text": "数匹ならともかく、この数だからな……。\nもう周囲の魔物が聞きつけて、\nこの場所に集まり始めているぞ。", "face": "u438"}, {"name": "アンナ", "text": "仕方ありませんね。王子、\n魔界ボアがこちらに向かってくる様子はありませんが、\n別の場所からも突然飛び出してくるかもしれません。", "face": "l60362c483024"}, {"name": "アンナ", "text": "魔界ボアの進路には、\n十分に注意を払っておいてください。\n戦いにくい場所ですが、慎重な采配をお願いします。", "face": "l60362c483024"}]}, {"trigger": "end", "lines": [{"name": "レアン", "text": "お、向こうで歩き回っていた魔界ボアも、\n驚いたのか逃げていったぞ。", "face": "u438"}, {"name": "ノワール", "text": "どうやら、もう戻ってくる様子はないな。\nこれで一段落といったところか。", "face": "u679"}, {"name": "レアン", "text": "さて、王国に戻って\n新年会の続きと洒落込もうか。", "face": "u438"}, {"name": "フィリス", "text": "ま、まだ食べるつもりか？\nレアンの胃袋はどうなってるんだ？", "face": "u40"}, {"name": "レアン", "text": "食べれば食べる程、筋肉になるんだ。\nフィリスも前線を務めるなら、\nしっかり食べておかなくちゃダメだぞ？", "face": "u438"}, {"name": "フィリス", "text": "……はぁ。正月太りしないように、\n運動もしないとだめだぞ、レアン。", "face": "u40"}, {"name": "ノワール", "text": "……ぼたん肉、取り損ねたな。\nかわりに王国で、美味しいおせちを食べるとしよう。", "face": "u679"}, {"name": "アンナ", "text": "王子、新年早々お疲れ様でした。\n私達も王国へ帰還しましょう。"}]}], "active": true}