{"quest_id": 8153, "name": "チョコレート作り", "description": "王子たちは犯人を探すべく調査を開始。\nするとなにやら言い争いをしている\nシャディアとチョコ騎士団に出会って……？\n上級（★１獲得の目安：平均Lv10）", "event": "ビタースイートアイヴィワルツ", "event_category": "History", "mission_id": 920210, "map_no": 4839, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_count": 2, "tags": ["バレンタイン", "置物", "ステルス", "ブロック不可"], "fixture": true, "hp": 10000, "attack": 2400, "base_hp": 10000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 87, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "pattern_id": 2132768, "special_effect_id": 949, "change_to": 1, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 34535, "global_id": 8152, "ranged": true, "to_global_id": 8153, "route_behaviour": {"transforms": [{"wait": -1}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["バレンタイン", "置物", "ステルス", "ブロック不可"], "fixture": true, "hp": 10000, "attack": 2400, "base_hp": 10000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 88, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "pattern_id": 2132768, "special_effect_id": 230, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 34536, "global_id": 8153}, {"enemy_id": 3, "source": "local", "count": 8, "form_count": 1, "tags": ["バレンタイン"], "hp": 1600, "attack": 500, "base_hp": 1600, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "attack_range": 100, "attack_speed": 70, "attack_wait": 50, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113952, "missile_id": 257, "missile": {"speed": 2.0}, "master_id": 30905, "global_id": 4524, "ranged": true, "spawn_sec": 34}, {"enemy_id": 4, "source": "local", "count": 20, "form_count": 1, "tags": ["アーマー", "バレンタイン", "チョコレート騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 350, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132720, "master_id": 34530, "global_id": 8147, "spawn_sec": 77}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 308, "change_to": 5, "master_id": 32290, "global_id": 5909, "to_global_id": 5920, "spawn_sec": 123}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 2400, "attack": 240, "base_hp": 2400, "base_attack": 240, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121264, "special_effect_id": 275, "change_to": 4, "master_id": 32301, "global_id": 5920}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 39, "change_to": 7, "missile_id": 6, "master_id": 32291, "global_id": 5910, "ranged": true, "to_global_id": 5923, "spawn_sec": 162}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 6, "missile_id": 6, "master_id": 32304, "global_id": 5923}], "popups": ["チョコレートの箱は、\n周囲のチョコ騎士団の\nHPを回復します。\n一定時間経過すると\n回復効果は無くなります。\n\nまた、攻撃の対象にならず\n撃破数に含まれません。", "チョコマイコニドがいる間、\n全ての味方ユニットは\n継続ダメージを受けます。\n\nまた、チョコマイコニドの数に応じて\n効果が重複します。", "チョコトレントは\n徐々に自身のHPを回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シャディア", "text": "――なんだとッ！？\nもう一度言ってみろ！", "face": "u2056a1"}, {"name": "チョコレート騎士", "text": "ああ、何度でも言ってやる！\nシャディア、お前の作るチョコは……まずい！", "face": "l70733d6e01bc"}, {"name": "チョコ従士", "text": "シテ……コ……シテ……。", "face": "l70733d6e01bc"}, {"name": "チョコレート騎士", "text": "見ろ、いたいけなチョコ従士が\nお前のチョコを味見してから介錯を乞うている！", "face": "l70733d6e01bc"}, {"name": "チョコ従士", "text": "刻んだチョコを……目の細かいザルで濾して……、\n沸騰直前まで煮立てた生クリームを加えたのち……。", "face": "l70733d6e01bc"}, {"name": "チョコレート騎士", "text": "違うッ、こいつ……！\nおいしい生チョコの作り方を伝えようと……！？", "face": "l70733d6e01bc"}, {"name": "キャロップ", "text": "あれは……チョコ騎士団と、シャディアさん？\nなんだか言い争ってるけど。", "face": "u2059a1"}, {"name": "ワルツ", "text": "涙目の女の子相手に、寄ってたかって詰め寄ってる。\nあんなだからモテないのね。", "face": "u2058a1"}, {"name": "ポミエ", "text": "でも、シャディアさんが悪いようにも……？\n――って、わわっ！？　なにやら緊迫した気配ですよ！", "face": "u1422a1"}, {"name": "シャディア", "text": "――ほう、いいだろう。\n貴様らは顎を砕かれても「まずい」と言えるのか？", "face": "u2056a1"}, {"name": "チョコレート騎士", "text": "やる気か？　我らはチョコさえあれば負傷知らず。\n知り合いの町娘……の、お母さんから貰ったチョコより、\nカカオパワーを補給して傷も顎も癒してやろう！", "face": "l70733d6e01bc"}, {"name": "ワルツ", "text": "一触即発ね。仲裁に入ってあげましょう。", "face": "u2058a1"}, {"name": "キャロップ", "text": "チョコ騎士団は、お母さんのチョコで体力を回復する。\nあの箱には近付けないほうがよさそうだね。", "face": "u2059a1"}]}, {"trigger": "end", "lines": [{"name": "オーガスタ", "text": "はーい、シャディアさんどうどうっ。\nチョコ騎士団の皆さんに、『ごめんね』しましょうね。", "face": "u1153a1"}, {"name": "シャディア", "text": "……ごめんね。", "face": "u2056a1"}, {"name": "チョコレート騎士", "text": "いいよ。", "face": "l70733d6e01bc"}, {"name": "ワルツ", "text": "（五歳児の喧嘩みたい……）", "face": "u2058a1"}, {"name": "キャロップ", "text": "ねえ、チョコ騎士さん。\n街で起きている昏睡事件について、なにか知ってる？", "face": "u2059a1"}, {"name": "チョコレート騎士", "text": "ああ。チョコ騎士団長殿の命により、\n目下見廻り中なのだ。ただ、モテボーイ軍以上の\n情報を持っているとは思えんなぁ。", "face": "l70733d6e01bc"}, {"name": "チョコレート騎士", "text": "こういうのはどうせモーロンの仕業とは思うが、\n彼女の縄張りには、我々だけでは近付けないし……。", "face": "l70733d6e01bc"}, {"name": "ワルツ", "text": "そう……って、モーロンの居場所を知っているの！？", "face": "u2058a1"}, {"name": "チョコレート騎士", "text": "ああ、つい数日前に、偶然見かけてな。\nモーロンは貴様らに一度敗北したあと、\n拠点を別の森に移していたらしい。", "face": "l70733d6e01bc"}, {"name": "チョコレート騎士", "text": "貴様らが行くと言うなら案内するが、\nモーロンはお菓子を操る魔女。\nもし我々がしもべとされたら、ためらわず攻撃してくれ。", "face": "l70733d6e01bc"}, {"name": "シャディア", "text": "なに、近くまで案内してくれたら充分だ。\n申し出は嬉しいが、命まで懸けさせる訳にはいかない。", "face": "u2056a1"}, {"name": "チョコレート騎士", "text": "ああ、分かった。\n目指すはお菓子の街・移転地！\nいざ、眠れる女性たちを救う決戦へ！", "face": "l70733d6e01bc"}]}], "active": true}