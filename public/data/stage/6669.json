{"quest_id": 6669, "name": "伝承の地を目指して", "description": "病魔を払うという伝承の獣に望みを\n託すことにした一行は、カリンの案内で\nかの幻獣ハクタクの住まう地を目指す。\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ハクタクに選ばれし者", "event_category": "History", "mission_id": 920120, "map_no": 3334, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 25, "form_count": 2, "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104272, "race_id": 14, "change_to": 1, "master_id": 517, "global_id": 516, "to_global_id": 517, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 105, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104320, "race_id": 14, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 518, "global_id": 517, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 9, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 17}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 30}, {"enemy_id": 5, "source": "local", "count": 11, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 61}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 95}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 110}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "――なるほど、カリンさんの村のわらべうた、ですか。", "face": "lf3819494e5d1"}, {"name": "カリン", "text": "はい。私の村ではハクタク様を祀っていて、\nその昔ハクタク様が降臨した際の逸話の数々と、\n伝承の地のことがわらべうたとして残っているんです。", "face": "u734"}, {"name": "太公望", "text": "ハクタクは歴史上、何度か病魔や災いを祓うため\nその姿を現しました。カリンさんの村に\n伝わるわらべうたは、その時に紡がれたものでしょう。", "face": "u603"}, {"name": "カリン", "text": "そうだったんですね……。\nてっきり架空のおとぎ話だとばかり……。", "face": "u734"}, {"name": "アリサ", "text": "そういえばカリンさん、\nさきほど『教え子』と言っていましたが、\nカリンさんは学校の教師なんですか？", "face": "u24"}, {"name": "カリン", "text": "いえ、教師と名乗れるほど立派なものでは……。\n村には学校が無いので、私が子供達に\n算術や文字を教えているだけですから。", "face": "u734"}, {"name": "レーレン", "text": "教え子の病を治そうと、\n遠路はるばるあの村を訪ねてきたんだろう？", "face": "u614"}, {"name": "レーレン", "text": "教え子の為に必死になれるなら、\nカリンは立派な教師に違いないさ。", "face": "u614"}, {"name": "カリン", "text": "そう……でしょうか……？\nふふっ、それならあの子達の為にも、ちゃんと\n皆さんを伝承の地へ案内しなければなりませんね。", "face": "u734"}, {"name": "レーレン", "text": "そうそう、その調子だ。カリン先生？\n先生が弱気じゃ、生徒まで弱気になっちゃうからな！", "face": "u614"}, {"name": "マオ", "text": "――むっ、でも素直に伝承の地まで\n行くことは出来そうにないですね……。", "face": "u361"}, {"name": "太公望", "text": "確かにこの気配、近くに魔物がいるようです。\nカリンさんは後ろに下がっていてくださいね。", "face": "u603"}, {"name": "アンナ", "text": "王子、ここで足止めをされている時間はありません。\n迅速に魔物の群れを迎撃しましょう！", "face": "lf3819494e5d1"}]}, {"trigger": "end", "lines": [{"name": "カリン", "text": "み、皆さんお強いのですね……。\nけれど王子殿下自ら前線に立たれるなんて、\nびっくりしてしまいました。", "face": "u734"}, {"name": "マオ", "text": "確かに王子が前線にいるのは、\n珍しいかもしれませんね……。\nでも、ずっとこうして戦ってきましたから！", "face": "u361"}, {"name": "カリン", "text": "そうなのですか……。\nでも、守られるばかりなのは少し申し訳ないですね。\n私も案内以外でお役に立てると良いのですが……。", "face": "u734"}, {"name": "メイファ", "text": "……あ、あの。カリンさん、わたしも以前、\n王子様たちの道案内をした事があるのですが……。", "face": "u618"}, {"name": "メイファ", "text": "自分に出来る精一杯を頑張る事が助け合う事だって、\n太公望さんや王子様たちから教わったんです。\n……だからカリンさんも、そんな風に考えないで下さい。", "face": "u618"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "カリン", "text": "……ふふ、ありがとうございます。\nでは、私も伝承の地までの道案内の役目を\nしっかりと果たしますね！", "face": "u734"}]}], "active": true}