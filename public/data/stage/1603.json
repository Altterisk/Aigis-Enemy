wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 8, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "phases": [{"hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "condition": 3}], "spawn_sec": 122}], "popups": ["オーク旗手が持つ\n敵の攻撃と防御アップの能力は、\nオーク旗手の数に応じて効果が\n重複します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オーク", "text": "この村は今から俺たちのものだぁッ！！\n軍旗を掲げろォオッ！", "face": "lc3098a587432"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子！　すでに村にオークたちがッ！", "face": "lc1a894249b0f"}, {"name": "ルナール", "text": "そんな……、村のみんながっ……。", "face": "u300"}, {"name": "？？？", "text": "安心しろ。すでに住人たちは避難させている。", "face": "u276"}, {"name": "ルナール", "text": "ミトラさん！　良かった！\n無事だったんだね！", "face": "u300"}, {"name": "ミトラ", "text": "ああ。オークの大群が森のあちこちに現れたと\n見張り役から報告を受けたんだ。\nただ、この状況をどうしたものか。", "face": "u276"}, {"name": "？？？", "text": "……。", "face": "u299"}, {"name": "ミトラ", "text": "ダナン……！　なぜ戻ってきたッ！", "face": "u276"}, {"name": "ダナン", "text": "あたしは村を守るための盾だ。\nたとえ最後の一人になっても戦うと決めている！！", "face": "u299"}, {"name": "ミトラ", "text": "しかしこのオークの数を前にどうしろと言うんだ……。", "face": "u276"}, {"name": "王子", "text": "……ならば、村を解放する。", "face": "u1"}, {"name": "アンナ", "text": "そうですね！\n私たちも協力いたします。"}, {"name": "ミトラ", "text": "……しかし、これは私たち部族の問題だ。\nこの地に住む者以外の手を借りるわけにはいかん。", "face": "u276"}, {"name": "ダナン", "text": "だが、長。\n村にはあたし達が代々守ってきたものもある……。\nもし、魔物に奪われてしまえばそれこそ……。", "face": "u299"}, {"name": "ミトラ", "text": "……確かにそうだな。\nすまぬ。どこの者かは分からぬが、恩に着る。", "face": "u276"}, {"name": "オーク", "text": "懲りもせずに、村のやつらが戻ってきたようだな。\nお前ら、例のものを早く探せ！", "face": "lc3098a587432"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "何とか村を取り戻せましたね。"}, {"name": "ミトラ", "text": "ありがとう。助かった。", "face": "u276"}, {"name": "デーモンメイジ", "text": "ふふふ……。よくやったオークよ。", "face": "lf2f79ee8921e"}, {"name": "デーモンメイジ", "text": "お前たちが村の者どもを引き付けておいたお陰で、\n女神アイギスの武具は今や我が手中にある……。", "face": "lf2f79ee8921e"}, {"name": "アンナ", "text": "デーモン……！\n一体なぜデーモンが！！", "face": "lc1a894249b0f"}, {"name": "ミトラ", "text": "くそッッ！　なんてことだ……ッ！\nということは封印はすでに……。", "face": "u276"}, {"name": "デーモンメイジ", "text": "ハッ。卑小な人間どもめが。\n地上界に我が物顔でいられるのも、今のうちだ。", "face": "lf2f79ee8921e"}, {"name": "デーモンメイジ", "text": "では、さらばだ。", "face": "lf2f79ee8921e"}, {"name": "ミトラ", "text": "待て！！", "face": "u276"}, {"name": "アンナ", "text": "王子、デーモンが武具を……！\n追いかけましょう！", "face": "lc1a894249b0f"}]}], "hard": {"level": 150, "multiplier": 1.5, "modifiers": [{"kind": "term", "influence": 25, "params": [300], "expression": "IsRearguard();"}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 27000, "attack": 1200, "damage_type": "physical", "armor_defense": 500, "pattern_id": 2102672}, {"enemy_id": 3, "form_index": 0, "hp": 7500, "attack": 375, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2102608}, {"enemy_id": 4, "form_index": 0, "hp": 6000, "attack": 600, "damage_type": "physical", "armor_defense": 300, "pattern_id": 2102224}, {"enemy_id": 6, "form_index": 0, "hp": 4500, "attack": 300, "damage_type": "physical", "armor_defense": 200, "pattern_id": 2102544}, {"enemy_id": 8, "form_index": 0, "hp": 3750, "attack": 200, "damage_type": "magical", "armor_defense": 150, "pattern_id": 2102576}]}, "map": {"image": "Map1103", "w": 960, "h": 640, "spots": [{"k": "b", "x": 512, "y": 76}, {"k": "b", "x": 351, "y": 309}, {"k": "b", "x": 767, "y": 252}, {"k": "m", "x": 202, "y": 167, "id": 200}, {"k": "m", "x": 445, "y": 167, "id