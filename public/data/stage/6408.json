move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 17, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 60}]}, "spawn_sec": 382}], "dialogue": [{"trigger": "end", "lines": [{"name": "天使", "text": "……想定以上に被害が出ています。\nこのままでは使命の遂行に支障が……。", "face": "l24ab3a25201e"}, {"name": "大天使長", "text": "――……退きなさい、天使たちよ。", "face": "l083c117dd6b1"}, {"name": "天使", "text": "……大天使長様。\n……宜しいのですか？", "face": "l24ab3a25201e"}, {"name": "大天使長", "text": "この地で与えられし使命は\n既に果たされました。", "face": "l083c117dd6b1"}, {"name": "大天使長", "text": "やがて人は知る事になるでしょう、神の御心に逆らう\nその愚かさを……ですが、今はまだその時ではない。\nここは退き、来るべき時へと備えるのです。", "face": "l083c117dd6b1"}, {"name": "天使", "text": "……承知いたしました。\n全ては神の御心のままに……。", "face": "l24ab3a25201e"}, {"name": "兵士", "text": "――……報告！　\n天使達が魔法陣へと消えていきます！", "face": "l30e82a61201d"}, {"name": "ケイティ", "text": "……どうやら敵は退いたようですね。", "face": "u114"}, {"name": "バシラ", "text": "つ、疲れました～……。", "face": "u28"}, {"name": "ケイティ", "text": "あの様子であれば、またすぐに動き出すという事は\nなさそうです……ですが、いつこの門を利用し、\n天使達が攻め入ってくるか判りませんね……。", "face": "u114"}, {"name": "グスタフ", "text": "……そういう事なら、ここの見張りはワシに任せい。\nさっきの戦いで、そこら中ベヒモスの落とした\n爪牙の欠片だらけじゃわい。", "face": "u153"}, {"name": "グスタフ", "text": "神獣の爪牙、一体どのような材質なのか\n興味深い……何かに使えるやもしれん、\n拾い集めるついでじゃ。", "face": "u153"}, {"name": "バルバストラフ", "text": "わしはこの天界の門とやらを調べてみるとするかの。\n門を封ずる手立ても、何か見つかるかもしれん。\n王子、何か判ればすぐに連絡するわい。", "face": "u63"}, {"name": "アンナ", "text": "お二人ともありがとうございます。\n頼りにさせて頂きますね。"}, {"name": "アンナ", "text": "王子、この場は皆さんに任せ、\n私達は帰還致しましょうか。\n此度の激闘お疲れ様でした。"}]}], "map": {"image": "Map9184", "w": 960, "h": 640, "spots": [{"k": "b", "x": 948, "y": 380}, {"k": "b", "x": 554, "y": 536}, {"k": "m", "x": 276, "y": 235, "id": 200}, {"k": "m", "x": 355, "y": 291, "id": 201}, {"k": "m", "x": 426, "y": 352, "id": 202}, {"k": "m", "x": 630, "y": 293, "id": 203}, {"k": "m", "x": 738, "y": 323, "id": 204}, {"k": "m", "x": 845, "y": 347, "id": 205}, {"k": "m", "x": 532, "y": 