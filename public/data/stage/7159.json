m_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 72}, {"enemy_id": 6, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 86}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124096, "race_id": 20, "change_to": 7, "change_condition": 4, "master_id": 32748, "global_id": 6366, "to_condition": 4, "to_ticks": 3, "to_global_id": 6369, "spawn_sec": 131}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1400, "base_hp": 5000, "base_attack": 1400, "damage_type": "true", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 32751, "global_id": 6369, "from_condition": 4, "trigger_ticks": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "天使", "text": "――なぜ神の寵愛を拒むのですか。\nいずれ散りゆく者たちよ。", "face": "l5acdfefcd897"}, {"name": "？？？", "text": "なっ、なな、何が神さまですか！\nケラウノス様のいない今、\n亜神同士で争ってるだけですよね！？", "face": "u1094a1"}, {"name": "天使", "text": "…………？\n亜神？　何を言っているのでしょう。", "face": "l5acdfefcd897"}, {"name": "天使", "text": "哀れなる鳥人の子よ、\n神の寵愛を拒むその罪により、今ここで、\n我らが浄化の手を差し伸べましょう。", "face": "l5acdfefcd897"}, {"name": "ライノー", "text": "――いや、そんなことはさせない。\nどうやら間に合ったようだな、アエロ。", "face": "u1086a1"}, {"name": "アエロ", "text": "ら、ライノーさん！\nそれに、この方々は……？", "face": "u1094a1"}, {"name": "パリオス", "text": "物質界の王子さまだよ！\n天界の動乱を止めるために、\n地上からここまで来てくれたの！", "face": "u1109a1"}, {"name": "天使", "text": "……王国の、王子ですか。\n神の愛を拒み、神を殺した者が、\n次は天界で何をしようというのでしょうか。", "face": "l5acdfefcd897"}, {"name": "天使", "text": "あなた方がケラウノス様を倒さなければ、\n天界にこんな争いは起きなかったでしょうに。", "face": "l5acdfefcd897"}, {"name": "ライノー", "text": "……王子殿、惑わされるな。\nもとより多くの亜神たちは、ケラウノス様を\n疎ましく思っていたのだからな。", "face": "u1086a1"}, {"name": "ライノー", "text": "遅かれ早かれ、天界に戦火は起きていたはずだ。\n貴殿はその引き金を引かされただけ――っと、\nその表情、どうやら言うまでも無かったようだな。", "face": "u1086a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ライノー", "text": "さすがは魔王ガリウスを倒した男だ。\n貴殿になら、私たちの部族も安心して翼を預けられる。", "face": "u1086a1"}, {"name": "天使", "text": "……どこまでも罪深い者たちよ。\n祈りは済ませましたか？\nさぁ天界兵よ、この地をすべて浄化するのです。", "face": "l5acdfefcd897"}, {"name": "パリオス", "text": "王子さま、天界兵が来るよ！\nあいつらの武器は神聖な力を蓄積して、\n強力な攻撃をしてくるから注意してね！", "face": "u1109a1"}, {"name": "ライノー", "text": "あれは人の信ずる神とは別の神による創造物だ。\n物質界の人間に似てはいるが、\n根本から違う生物だと思って戦うんだぞ。", "face": "u1086a1"}]}, {"trigger": "end", "lines": [{"name": "パリオス", "text": "やった！　天界兵たちを倒したよー！！", "face": "u1109a1"}, {"name": "アエロ", "text": "だ、だめですパリオスちゃん！\nさっきのは本隊じゃないんですよ！", "face": "u1094a1"}, {"name": "アエロ", "text": "私たちの集落は、ずっと包囲されたまま、\n散発的な攻撃を受け続けていたんです。", "face": "u1094a1"}, {"name": "アエロ", "text": "きっとすぐ近くに、\n大規模な本隊が控えているはずです！", "face": "u1094a1"}, {"name": "天使", "text": "……知恵は回るようですね。\nですがそれに気付いたからといって、\n何か打つ手があるとでも？", "face": "l5acdfefcd897"}, {"name": "ノーマ", "text": "集落ひとつを落とすのに、\n随分な念の入れようね……。", "face": "u1047a1"}, {"name": "ライノー", "text": "……物質界を制した人間に\n与する者を減らそうとしているのだろう。", "face": "u1086a1"}, {"name": "ライノー", "text": "世界樹の魔物化を目論んだのも、\nきっと似たような考えによるものに違いない。", "face": "u1086a1"}, {"name": "天使", "text": "……やはり、王子の軍勢は厄介ですね。\nこれまで静観していたのは、\nやはり悪手だったのでしょう。", "face": "l5acdfefcd897"}, {"name": "天使", "text": "神の手を汚させるまでもありません。\nここで、我々の手で、物質界の王子を抹殺しましょう。", "face": "l5acdfefcd897"}]}], "map": {"image": "Map920151_3476", "w": 960, "h": 640, "spots": [{"k": "b", "x": 29, "y": 271}, {"k": "b", "x": 102, "y": 505}, {"k": "m", "x": 105, "y": 273, "id": 200}, {"k": "m", "x": 317, "y": 256, "id": 201}, {"k": "m", "x": 384, "y": 199, "id": 202}, {"k": "m", "x": 436, "y": 135, "id": 203}, {"k": "m", "x": 383, "y": 326, "id": 204}, {"k": "m", "x": 349, "y": 407, "id": 205}, {"k": "m", "x": 172, "y": 476, "id": 206}, {"k": "m", "x": 259, "y": 439, "id": 207}, {"k": "m", "x": 211, "y": 268, "id": 208}, {"k": "m", "x": 428, "y": 462, "id": 209}, {"k": "m", "x": 528, "y": 504, "id": 210}, {"k": "m", "x": 638, "y": 492, "id": 211}, {"k": "m", "x": 741, "y": 461, "id": 212}, {"k": "m", "x": 790, "y": 385, "id": 213}, {"k": "m", "x": 840, "y": 314, "id": 214}, {"k": "m", "x": 779, "y": 246, "id": 215}, {"k": "m", "x": 722, "y": 172, "id": 216}, {"k": "m", "x": 632, "y": 164, "id": 217}, {"k": "m", "x": 530, "y": 158, "id": 218}, {"k": "m", "x": 474, "y": 68, "id": 219}, {"k": "m", "x": 757, "y": 95, "id": 220}, {"k": "r", "x": 113, "y": 199, "id": 300}, {"k": "r", "x": 359, "y": 95, "id": 301}, {"k": "r", "x": 129, "y": 343, "id": 302}, {"k": "r", "x": 172, "y": 386, "id": 303}], "events": [{"t": 1.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_05", "fx": "Cluoud1", "x": 665, "y": 95}]}, {"t": 1.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_06", "fx": "Cluoud1", "x": 855, "y": 221}]}, {"t": 1.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_07", "fx": "Cluoud1", "x": 847, "y": 4