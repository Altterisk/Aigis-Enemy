ition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 106, "global_id": 105, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 106, "spawn_sec": 108}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "base_hp": 2000, "damage_type": "physical", "armor_defense": 250, "magic_defense": 40, "attack_speed": 60, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099520, "race_id": 4, "master_id": 107, "global_id": 106, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 300, "base_hp": 20000, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "magic_defense": 20, "attack_range": 280, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107232, "race_id": 4, "special_effect_id": 102, "missile_id": 169, "missile": {"speed": 15.0}, "master_id": 525, "global_id": 524, "ranged": true, "spawn_sec": 134}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 400, "base_hp": 25000, "base_attack": 400, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107248, "race_id": 4, "special_effect_id": 103, "master_id": 526, "global_id": 525, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "カヨウ", "text": "もぅ、イナリちゃん急に呼び出してどうしたのよ。\nそれに……、妖怪も集めちゃって、どうしたの？", "face": "u1325"}, {"name": "イナリ", "text": "ふっふっふ、カヨウさん！\nあたしたちの時代が来たのよ！\nこの巻物を見て！", "face": "u1243"}, {"name": "カヨウ", "text": "なぁに？\n……妖怪の総大将は、総大将に認められた者か、\n倒した者が次期総大将となり、受け継いでいく？", "face": "u1325"}, {"name": "イナリ", "text": "そうなのよ！\n妖怪の総大将ぬらりひょんを倒したのは\n誰だと思う？　王子なのよ！", "face": "u1243"}, {"name": "カヨウ", "text": "あらぁ～♪\n本当ね、イナリちゃん。わらわ達が王子を倒して\n認めさせれば妖怪の総大将じゃない♪", "face": "u1325"}, {"name": "イナリ", "text": "だから、こうして妖怪を集めて王子に\nせんせんふこくをしたのよ！！！\nそろそろ来ると思うわ！", "face": "u1243"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、どうやらここみたいですね。\nイナリさんから、お祭りに誘って頂いた場所は。\n……あ！　あちらにイナリさん達が――。"}, {"name": "アンナ", "text": "――えぇ！？　妖怪がいっぱい！？\nど、どういうことなのでしょうか？"}, {"name": "イナリ", "text": "よく来たわね！　妖怪の総大将「王子」！", "face": "u1243"}, {"name": "イナリ", "text": "あたしたち妖狐が次期妖怪の総大将になる為にも、\nここは全力でいかせてもらうからね♪\nさぁ、覚悟しろ～、王子ぃ！", "face": "u1243"}, {"name": "アンナ", "text": "理由はよくわかりませんが、\n戦闘は避けられそうにありませんね……。\n王子、戦いの準備をお願いします！", "face": "lef0cef750e7e"}]}, {"trigger": "end", "lines": [{"name": "イナリ", "text": "きゅぅ～。\nやっぱり王子は強かったね、カヨウさん。", "face": "u1243"}, {"name": "カヨウ", "text": "もぅ、ちゃんと準備しないからよイナリちゃん……。\n今日のところは降参しておきましょ。", "face": "u1325"}, {"name": "アンナ", "text": "イナリさんにカヨウさんまで……。\n妖怪の総大将とは、\nそれほどまでになりたいものなのでしょうか？", "face": "lef0cef750e7e"}, {"name": "イナリ", "text": "うん！　妖怪の総大将になったら、\nこの世の全てを手に入れることが出来るって、\nこの巻物に書いてあるんだから！！", "face": "u1243"}, {"name": "ケイティ", "text": "ちょっとその巻物を見せてください。", "face": "u114"}, {"name": "ケイティ", "text": "ん～？　ちょっと私には読めませんね。\nヒエンさん、読めますか？", "face": "u114"}, {"name": "ヒエン", "text": "巻物の解読ならば得意でござる！\nえ～何々……。", "face": "u112"}, {"name": "ヒエン", "text": "著作……偉大なる妖怪の総大将ぬらりひょん。\n四頁……総大将の特権。\nうむ、ここでござるな。", "face": "u112"}, {"name": "ヒエン", "text": "「妖怪の総大将を自称しておけば、\nのらりくらりとした単純な妖怪は意のままに操れる。\n規模が大きくなれば、それだけで妖怪が慕ってくる」", "face": "u112"}, {"name": "アンナ", "text": "イナリさん……この巻物全部読みましたか？", "face": "lef0cef750e7e"}, {"name": "イナリ", "text": "ううん！　最初に書いてあったから、これだ！\nって思って、妖怪の総大将の王子を\n倒そうとしたの！", "face": "u1243"}, {"name": "イナリ", "text": "でも、これを見ると、妖怪総大将の肩書きには\nそこまでの価値はなかったんだねぇ……はぁ～ぁ。", "face": "u1243"}, {"name": "カヨウ", "text": "残念ねぇ。\nイナリちゃんと、総大将になったら\n王子を馬にして一生こきつかうって約束したのにね。", "face": "u1325"}, {"name": "アンナ", "text": "王子……。\nそんな事の為に倒されそうになっていたのですか。", "face": "la3c1698418b6"}]}], "active": true}