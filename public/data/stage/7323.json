476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106704, "race_id": 8, "change_to": 26, "change_condition": 3, "master_id": 389, "global_id": 388, "to_condition": 3, "to_global_id": 389, "route_behaviour": {"sets_flags": [[0, 1, 0]]}, "spawn_sec": 149}, {"enemy_id": 26, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 550, "base_hp": 12000, "base_attack": 550, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 120, "attack_speed": 10, "attack_wait": 10, "attack_interval": 111, "move_speed": 1700.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106720, "race_id": 8, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 390, "global_id": 389, "ranged": true, "from_condition": 3}, {"enemy_id": 28, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102640, "race_id": 8, "change_to": 28, "change_condition": 3, "master_id": 383, "global_id": 382, "to_condition": 3, "to_global_id": 383, "route_behaviour": {"sets_flags": [[0, 1, 0]]}, "spawn_sec": 195}, {"enemy_id": 28, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アイドルリノのファン"], "hp": 15000, "attack": 2000, "base_hp": 15000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 450, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102656, "race_id": 8, "master_id": 384, "global_id": 383, "from_condition": 3}], "popups": ["オーク旗手が持つ\n敵の攻撃と防御アップの能力は、\nオーク旗手の数に応じて効果が\n重複します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "メーア", "text": "――敵襲ー！　敵襲です！！\nオークの部隊が動き始めましたー！！", "face": "u796"}, {"name": "レオナ", "text": "伝令ご苦労。\nいいか貴様ら、敵は籠城戦ではなく、\n正面からの戦いを望んでいるようだ！", "face": "u311"}, {"name": "レオナ", "text": "本来ならば付き合ってやる必要はないが、\nこちらもこの砦を失うわけにはいかない。\n全力で迎え撃て！！", "face": "u311"}, {"name": "マレブランケ", "text": "おぉおぉ、ここから見えるだけでも\nなかなかの大軍勢だ。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "でも、負傷者も増え始めている。\nこのまま戦いが進めば、\nいずれこちらの戦力で擦り潰せるだろうね。", "face": "u1225a1"}, {"name": "ヘカティエ", "text": "何よ、まるでこのまま進まないって\n予想してるような言いぶりじゃない。", "face": "u1226a1"}, {"name": "マレブランケ", "text": "さて、それを考えるのは戦闘が終わった後だ。\nここで砦が落ちたら何の意味もないからね。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "――でも、この戦いは勝てるよ。\n何しろ砦ひとつの防衛に、\n我が愛しの王子が参戦しているんだからね！！", "face": "u1225a1"}, {"name": "ヘカティエ", "text": "あー、はいはい……。\nそれじゃあ素敵な王子サマに任せるとするわ。", "face": "u1226a1"}, {"name": "カトリーナ", "text": "……よしっ！\n帝国式魔導砲台、整備完了です！\nいつでも撃てますよー！！", "face": "u989"}, {"name": "レオナ", "text": "――冥界軍を迎え撃つぞ、総員配置につけ！！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "……おかしい、先ほどまでとは動きが違う。\nまるで増援が来ると信じているかのような戦い方だ。", "face": "u311"}, {"name": "マレブランケ", "text": "それは妙な話だ。\n現状、冥界軍の各戦力は帝都周辺に分散している。\nどれかひとつでも落とせば血路が開けるんだからね。", "face": "u1225a1"}, {"name": "マレブランケ", "text": "そんな状況で……いや、だからこそ、か？\n獣人とオーク以外の戦力を伏せている、\nその可能性は十分すぎる程にありうる……。", "face": "u1225a1"}, {"name": "ヘカティエ", "text": "――いいえ、もっと単純な話よ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "敵の総指揮官はハイドース様なのよ？\n冥界の門を開く権限を持っている亜神なのよ？", "face": "u1226a1"}, {"name": "マレブランケ", "text": "……まさか。", "face": "u1225a1"}, {"name": "カーナ", "text": "――伝令！　伝令！\nオーク部隊に不穏な動きあり！\n敵部隊に――新たにオークの勇者が加わっています！", "face": "u1107a1"}, {"name": "レオナ", "text": "馬鹿な、どこから兵を――否、将を増員したというのだ。\nまさか本当に、冥界から喚び出したとでも！？", "face": "u311"}, {"name": "ヘカティエ", "text": "……そのまさか、よ。", "face": "u1226a1"}]}], "active": true}