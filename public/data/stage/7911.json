{"quest_id": 7911, "name": "砂漠の国の狂犬姉妹", "description": "選手の数も減った終盤戦、王子一行に\nファルアとシャジャルが手合わせを願う。\n＜出撃時の初期HP減少：大＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["出撃時の初期HP減少：大"], "event": "デザートストーム", "event_category": "History", "mission_id": 920194, "map_no": 7114, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [80], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 54000, "attack": 1350, "base_hp": 54000, "base_attack": 1350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 1, "attack_wait": 1, "attack_interval": 29, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2136864, "race_id": 16, "special_effect_id": 1040, "master_id": 34898, "global_id": 8515, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 33, "form_count": 1, "hp": 2000, "attack": 400, "base_hp": 2000, "base_attack": 400, "damage_type": "physical", "armor_defense": 75, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 121, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098048, "race_id": 16, "master_id": 81, "global_id": 80, "spawn_sec": 5}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 63000, "attack": 950, "base_hp": 63000, "base_attack": 950, "damage_type": "physical", "armor_defense": 650, "attack_speed": 1, "attack_wait": 1, "attack_interval": 29, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2136880, "race_id": 16, "special_effect_id": 1040, "master_id": 34900, "global_id": 8517, "spawn_sec": 55}, {"enemy_id": 4, "source": "local", "count": 11, "form_count": 1, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_range": 180, "attack_speed": 70, "attack_wait": 20, "attack_interval": 95, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109872, "race_id": 16, "special_effect_id": 72, "missile_id": 198, "missile": {"speed": 12.0}, "master_id": 30205, "global_id": 3824, "ranged": true, "spawn_sec": 68}, {"enemy_id": 5, "source": "local", "count": 10, "form_count": 1, "hp": 2000, "attack": 1000, "base_hp": 2000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_range": 300, "attack_speed": 70, "attack_wait": 90, "attack_interval": 253, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109888, "race_id": 16, "missile_id": 26, "master_id": 30206, "global_id": 3825, "ranged": true, "spawn_sec": 73}, {"enemy_id": 6, "source": "local", "count": 22, "form_count": 1, "hp": 4000, "attack": 450, "base_hp": 4000, "base_attack": 450, "damage_type": "physical", "armor_defense": 800, "magic_defense": 90, "attack_speed": 90, "attack_wait": 20, "attack_interval": 181, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100992, "race_id": 16, "special_effect_id": 227, "master_id": 308, "global_id": 307, "spawn_sec": 92}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルス"], "fixture": true, "hp": 600, "attack": 600, "base_hp": 600, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 1, "attack_wait": 100, "attack_interval": 242, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2097200, "special_effect_id": 604, "master_id": 32868, "global_id": 6486, "commands": {"raw": "DoEnemy_SetInvincible(1); DoEnemy_RegistCommand(\"OnChildAllDead\", \"DoEnemy_ForceDead();DoEnemy_SetInvincible(0);\");", "force_dead": true}, "spawn_sec": 119}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルス"], "fixture": true, "hp": 600, "attack": 600, "base_hp": 600, "base_attack": 600, "damage_type": "physical", "armor_defense": 600, "attack_speed": 1, "attack_wait": 100, "attack_interval": 242, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2097200, "special_effect_id": 605, "master_id": 32869, "global_id": 6487, "spawn_sec": 120}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 72000, "attack": 1000, "base_hp": 72000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 25, "attack_range": 300, "attack_speed": 60, "attack_wait": 90, "attack_interval": 225, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2143424, "race_id": 16, "special_effect_id": 1289, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 36011, "global_id": 9628, "ranged": true, "commands": {"raw": "DoEnemy_SetInvincible(1); DoEnemy_RegistCommand(\"OnChildAllDead\", \"DoEnemy_SetInvincible(0);\");"}, "route_behaviour": {"sets_flags": [[0, 1, 0], [0, 0, 0]]}, "spawn_sec": 121}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 52000, "attack": 900, "base_hp": 52000, "base_attack": 900, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 300, "attack_speed": 60, "attack_wait": 60, "attack_interval": 163, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2143392, "special_effect_id": 606, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 36009, "global_id": 9626, "ranged": true, "route_behaviour": {"sets_flags": [[1, 1, 0], [1, 0, 0]]}, "spawn_sec": 121}], "popups": ["妖霊使いはジンがいる間、\nダメージを受けません。\n以下の条件を満たすと弱体化し\nダメージを与える事ができます。\n\n・ジンを倒す\n・ジンが拠点に到達する"], "dialogue": [{"trigger": "start", "lines": [{"name": "シャジャル", "text": "――選手の数も少なくなってきた。\nそろそろ、メインディッシュに\n取り掛かってもいい頃合いだろう。", "face": "u1769a1"}, {"name": "ホルテウス", "text": "シャジャルにファルア、\n砂漠の国の狂犬姉妹か。", "face": "u1373a1"}, {"name": "ファルア", "text": "姉様のどこが狂犬ですか！\nホルテウス様とて許しませんよ！", "face": "u1569a1"}, {"name": "ホルテウス", "text": "いや、どちらかというと妹の方が――まぁよい。\n今を生きる砂漠の民の力、見せてみよ！", "face": "u1373a1"}, {"name": "シャジャル", "text": "言われるまでもない。\n王子、貴公の実力はファルアからよく聞いている。\n手合わせを願おうか。", "face": "u1769a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "シャジャル", "text": "砂漠の大樹、我が豪剣、\n英雄王の系譜にどこまで届くか――試させてもらう！", "face": "u1769a1"}]}, {"trigger": "battle", "at_sec": 168, "lines": [{"name": "シャジャル", "text": "くっ……あと一歩、あと一振りが足りない、か……。\n見事だ王子、貴公の剣は、確かに世界を救うに値する。", "face": "u1769a1"}, {"name": "ファルア", "text": "待って姉様！　まだ姉様は負けてないです！\nわ、私が膝をついてしまっただけで――", "face": "u1569a1"}, {"name": "シャジャル", "text": "負けは負けだ、ファルア。\nこれ以上は命の奪い合いになってしまう。", "face": "u1769a1"}, {"name": "シャジャル", "text": "人生最後の戦いは、\nなんの憂いもしがらみもなく、\n殺し合ってみたいものだな、貴公。", "face": "u1769a1"}, {"name": "王子", "text": "…………（にこり）", "face": "u1"}, {"name": "シャジャル", "text": "――む。\nファルア、気をつけろ！　新手だ！", "face": "u1769a1"}, {"name": "ファルア", "text": "えっ……きゃぁぁあッ！？", "face": "u1569a1"}, {"name": "シャジャル", "text": "貴様、妖霊使いか……。\n敗北を認めた者に刃を向けるとは、\n戦士の矜持もないらしいな。", "face": "u1769a1"}, {"name": "ニーヴ", "text": "……嫌な気配ね。\nあいつの操ってる精霊、かなり強力よ。", "face": "u1172a1"}, {"name": "カタラ", "text": "この気配……あいつ、精霊と魂を接続してるわね。\n精霊に守られているから、\n本体をどれだけ殴っても効かないと思うわ。", "face": "u912"}, {"name": "ニーヴ", "text": "じゃあどうするのよ？", "face": "u1172a1"}, {"name": "カタラ", "text": "精霊をぶっ倒す！\nそうすれば、術者本体も倒せるはずよ！", "face": "u912"}]}, {"trigger": "end", "lines": [{"name": "戦神マレス", "text": "――そこまでッ！！\n最後に戦場に立つはふたつの戦士団！\n決勝戦に挑む者たちが決まったぞッ！！", "face": "lc23d3669b6ff"}, {"name": "ファルア", "text": "ね、姉様！　異議申し立てを！\n姉様はまだ負けてませんし！", "face": "u1569a1"}, {"name": "シャジャル", "text": "いいや、いいんだファルア。\nわたしはまだ、王子と殺し合いをしたくはない。\nこういうのは最後にとっておくものだ。", "face": "u1769a1"}, {"name": "戦神マレス", "text": "砂漠の狂犬姉妹、見事な戦いだったぞ。\n戦場にあっても冷静な視点を失わない、\n熱き武技と冷たい心を持ち合わせる良い戦士だ。", "face": "lc23d3669b6ff"}, {"name": "シャジャル", "text": "光栄だ、戦神マレス。", "face": "u1769a1"}, {"name": "戦神マレス", "text": "妖霊使いよ、\n戦士としては少々気に入らぬが、\n戦略家としての実力は大いに認めよう。", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "精霊に己が身を守らせ、\n最後の最後まで生き延びる手法は、\n戦場にて磨き上げた生存術に違いあるまい。", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "そして王子よ、挑むもの全てを受け止め、\n実力をもって勝利をつかむ様は、\nまさに王者の戦いであった。", "face": "lc23d3669b6ff"}, {"name": "戦神マレス", "text": "決勝戦を戦うは、王国の王子、\nそして砂漠の妖霊使いに決まった！\n――観客どもよ、勇者たちの名を叫ぶがいい！！", "face": "lc23d3669b6ff"}, {"name": "観客Ａ", "text": "うぉぉぉぉぉッ！　王国に勝利を！\nうぉぉぉぉぉッ！　王子に栄光あれ！！", "face": "la14390605630"}, {"name": "観客Ｂ", "text": "砂漠に勝利を！　砂漠の嵐に勝利をッ！！", "face": "l03ef504c38ba"}]}], "active": true}