 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124208, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32926, "global_id": 6543, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 24, "source": "local", "count": 3, "form_count": 2, "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124096, "race_id": 20, "change_to": 24, "change_condition": 4, "master_id": 32748, "global_id": 6366, "to_condition": 4, "to_ticks": 3, "to_global_id": 6369, "spawn_sec": 93}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1400, "base_hp": 5000, "base_attack": 1400, "damage_type": "true", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 32751, "global_id": 6369, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 28, "source": "local", "count": 16, "form_count": 1, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 236, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2125968, "race_id": 12, "special_effect_id": 622, "master_id": 32939, "global_id": 6556, "spawn_sec": 109}, {"enemy_id": 29, "source": "local", "count": 1, "form_count": 1, "hp": 200000, "attack": 100, "base_hp": 200000, "base_attack": 100, "damage_type": "magical", "armor_defense": 500, "magic_defense": 40, "attack_range": 100, "attack_speed": 1, "attack_wait": 60, "attack_interval": 191, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2125984, "race_id": 19, "special_effect_id": 634, "missile_id": 26, "master_id": 32944, "global_id": 6561, "ranged": true, "route_behaviour": {"calls_event": [2193, 2194, 2195, 2196, 2197, 2198, 2199, 2200, 2201, 2202, 2203, 2204, 2205]}, "spawn_sec": 115}], "popups": ["ゴルゴーンから攻撃を受けると\n「蛇亜神の毒呪縛」状態になります。\n蛇亜神の毒呪縛によるダメージは、\n女神の加護や、攻撃の無効化、\n地形効果や状態異常を\n軽減するユニット能力の\n影響を受けません。\n　　　　　　(1/2)", "　　　　【蛇亜神の毒呪縛】\n・攻撃を受けると即座に麻痺\n　※特定のユニットで無効化可能\n・攻撃を受けると徐々にHPが減少\n　※継続ダメージは永続\n　　また、同一のゴルゴーンによる\n　　継続ダメージは重複しない\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴルゴーン", "text": "鳥人如きが妾の名を呼ぶデない。\n天使より鳥人の反逆を聞いテはいタが、\nまさか人間如きに懐いタか。", "face": "l7d1adc5b74dc"}, {"name": "ゴルゴーン", "text": "アイギスといいアダマスといい、\nさらにはトラム、鳥人のゴミクズまでも、\n何故人間如きに惹かれるのか理解デきぬ……。", "face": "l7d1adc5b74dc"}, {"name": "ゴルゴーン", "text": "さぁトラムよ、英傑タるその実力を妾に見せてみよ。\nこのまま手を抜くようなら、\nお前の民を何人か砕いてやるぞ？", "face": "l7d1adc5b74dc"}, {"name": "トラム", "text": "……っ。\nはい、ゴルゴーン様。", "face": "u1110a1"}, {"name": "オーキュ", "text": "民……トラム様の民……？\nまさか、トラム様の民が、\n都ごと石に変えられたというウワサは本当に――", "face": "u1101a1"}, {"name": "ユージェン", "text": "……人質をとられている、と？", "face": "u906"}, {"name": "トラム", "text": "……黙っていて、オーキュ。\nこれから私は、あなたたちを殺さなくてはいけない。\nそしてあなたたちは、私を殺さなくては。", "face": "u1110a1"}, {"name": "トラム", "text": "英雄王の名を継いだ者よ、\n私の剣と、私の右腕を受け継いだこと、感謝するわ。\nここまで歩んできたその実力で、私に勝ちなさい。", "face": "u1110a1"}, {"name": "アージェ", "text": "…………。", "face": "u1090a1"}, {"name": "アーニャ", "text": "…………。", "face": "u99"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "トゥアン", "text": "……民のために、己を犠牲にするか。\n馬鹿な考えだ、実に亜神らしい傲慢さだよ。", "face": "u1006a1"}, {"name": "アージェ", "text": "えぇ、銀腕はまごうことなき亜神ですので。\nしかしそれゆえに、一切融通がききません。", "face": "u1090a1"}, {"name": "アンブローズ", "text": "つまり、殺すって言った以上、\n本気でかかってくるってことですよねぇっ！\n子孫ちゃん、全力で迎撃準備ですよぅ！！", "face": "u1088a1"}]}, {"trigger": "end", "lines": [{"name": "ゴルゴーン", "text": "フシュシュ……。\n妾の身体に傷をツけタ……か……。", "face": "l7d1adc5b74dc"}, {"name": "ゴルゴーン", "text": "気に入らぬ、実に気に入らぬ……。\n人ごときが、亜神タるこの妾に……。", "face": "l7d1adc5b74dc"}, {"name": "アージェ", "text": "――警告。\nゴルゴーンの魔力、異常値を計測しました。\nまるで――そう、複数の身体があるかのような。", "face": "u1090a1"}, {"name": "サナラ", "text": "……複数の？　そ、それより！\n今なら「神の楔」を奪えるのでは！？", "face": "u921"}, {"name": "オーキュ", "text": "わ、私に任せてくださいな！\n飛んで行けばすぐですもの！", "face": "u1101a1"}, {"name": "ソラス", "text": "よし！　王子君、「神の楔」を回収したら、\nそのまま聖域を脱出しますよ！", "face": "u904"}, {"name": "アトナテス", "text": "おいソラス！　トラムはどうするんだ！？\nあの傷で置いてったら本当に死ぬぞ！", "face": "u908"}, {"name": "ソラス", "text": "……あの子は、死にません。\n大丈夫、というよりむしろ危険なんです！！", "face": "u904"}, {"name": "トゥアン", "text": "蘇生はするが、蘇生しても「契約」とやらで、\nゴルゴーンの命令下にあるからってことか。\n仕方ない、王子、急いで脱出するぞ！", "face": "u1006a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ソラス", "text": "王子君！　トラムを救いたいなら！\nここで情けをかけたら駄目なんです！！\n本当にあの子にトドメを刺すことになりますよ！", "face": "u904"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "ゴルゴーン", "text": "フシュシュ……。\n妾の怒りが聞こえるか、妾タちよ……。", "face": "l7d1adc5b74dc"}, {"name": "ゴルゴーン", "text": "そしていツまで眠っている、\n愚昧なる妾の手駒、英傑トラムよ……。", "face": "l7d1adc5b74dc"}, {"name": "ゴルゴーン", "text": "「神の楔」は渡さぬ……。\nそれはあの御方のものなのダから……。", "face": "l7d1adc5b74dc"}]}, {"trigger": "route", "enemy_ids": [29], "lines": [{"name": "トラム", "text": "……どうしたの？\n私すら殺せないなら、\n彼の地の亜神には到底敵わないわ。", "face": "u1110a1"}, {"name": "オーキュ", "text": "彼の地の……？　亜神……さま？\n銀腕さま、それはいったい誰の――", "face": "u1101a1"}, {"name": "ゴルゴーン", "text": "――トラム、「契約」を破るツもりか？\nあの御方の名を少しデも語れば、\n即座に石と化した民を根こそぎ砕いテやるぞ。", "face": "l7d1adc5b74dc"}, {"name": "ゴルゴーン", "text": "まぁ良い、手ぬるいお前に任せテはおけぬ。\n妾みずから、塵芥共に引導を渡しテやろう。", "face": "l7d1adc5b74dc"}, {"name": "オーキュ", "text": "お、王子さま、亜神ゴルゴーンは\n強力な毒を操ると聞きますわ！", "face": "u1101a1"}, {"name": "オーキュ", "text": "いかなる者をも蝕む猛毒で、\n身体の動きを縛り、蝕み続けるのだと……。\nどうか、どうかお気をつけて……！", "face": "u1101a1"}]}, {"trigger": "route", "enemy_ids": [29], "lines": [{"name": "トラム", "text": "……っ、強い。\n他の英傑が向こうにいるから……いえ、違うわ。", "face": "u1110a1"}, {"name": "トラム", "text": "これは彼が、王子が仲間を頼って\n歩んできたから、ということね……。", "face": "u1110a1"}, {"name": "アトナテス", "text": "……その上、敵である亜神サマの剣筋は、\nどこからどう見ても迷いだらけだからな。\nさぁ、そろそろ出てこいよゴルゴーン！", "face": "u908"}, {"name": "ゴルゴーン", "text": "剣を向けた者を生かしておくトは、\n物質界の者はドこまデもぬるい……。", "face": "l7d1adc5b74dc"}, {"name": "ゴルゴーン", "text": "けれド、亜神が一柱を討っタ実力は本物か。\nドれ、妾が遊んデやるとしよう。", "face": "l7d1adc5b74dc"}, {"name": "オーキュ", "text": "お、王子さま、亜神ゴルゴーンは\n強力な毒を操ると聞きますわ！", "face": "u1101a1"}, {"name": "オーキュ", "text": "いかなる者をも蝕む猛毒で、\n身体の動きを縛り、蝕み続けるのだと……。\nどうか、どうかお気をつけて……！", "face": "u1101a1"}]}], "active": true}