{"quest_id": 7173, "name": "蛇の亜神", "description": "トラムに戦いを強いるゴルゴーン。\n高みの見物を決め込む蛇亜神を\n戦いの舞台へ下ろし、勝利せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "集うは神の聖域", "event_category": "History", "mission_id": 920152, "map_no": 5766, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 2, "tags": ["アーマー", "置物"], "fixture": true, "hp": 10, "attack": 300, "base_hp": 10, "base_attack": 300, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 1, "attack_wait": 90, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125936, "special_effect_id": 623, "change_to": 1, "change_condition": 2, "master_id": 32940, "global_id": 6557, "to_condition": 2, "to_global_id": 6558, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "置物"], "fixture": true, "hp": 87000, "attack": 3500, "base_hp": 87000, "base_attack": 3500, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 50, "attack_range": 400, "attack_speed": 1, "attack_wait": 90, "attack_interval": 241, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125952, "special_effect_id": 623, "missile_id": 505, "missile": {"speed": 10.0}, "master_id": 32941, "global_id": 6558, "ranged": true, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["ヌアザ"], "hp": 7000, "attack": 400, "base_hp": 7000, "base_attack": 400, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 30, "attack_interval": 120, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126000, "race_id": 19, "special_effect_id": 648, "change_to": 3, "change_condition": 2, "master_id": 32945, "global_id": 6562, "to_condition": 2, "to_global_id": 6564, "route_behaviour": {"sets_flags": [[1, 0, 0], [2, 1, 0]]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ヌアザ"], "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 30, "attack_interval": 120, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2126000, "race_id": 19, "special_effect_id": 649, "master_id": 32947, "global_id": 6564, "from_condition": 2}, {"enemy_id": 6, "source": "local", "count": 10, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124128, "race_id": 20, "change_to": 6, "change_condition": 4, "master_id": 32919, "global_id": 6536, "to_condition": 4, "to_ticks": 3, "to_global_id": 6539, "spawn_sec": 7}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124144, "race_id": 20, "special_effect_id": 222, "master_id": 32922, "global_id": 6539, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_r