ttack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124192, "race_id": 20, "change_to": 18, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 33360, "global_id": 6977, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6980, "spawn_sec": 99}, {"enemy_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 240, "base_hp": 2500, "base_attack": 240, "damage_type": "true", "armor_defense": 240, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124208, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 33363, "global_id": 6980, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 22, "source": "local", "count": 1, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 620, "base_hp": 18000, "base_attack": 620, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126864, "race_id": 20, "change_to": 22, "master_id": 33340, "global_id": 6957, "to_global_id": 6958, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 124}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 1860, "base_hp": 18000, "base_attack": 1860, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126880, "race_id": 20, "change_to": 23, "change_condition": 4, "master_id": 33341, "global_id": 6958, "to_condition": 4, "to_ticks": 1, "to_global_id": 6959}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 620, "base_hp": 18000, "base_attack": 620, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126864, "race_id": 20, "master_id": 33342, "global_id": 6959, "from_condition": 4, "trigger_ticks": 1}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン", "text": "――ギャギャ！　モリ！　モエル！　アチチ！！", "face": "l0a641495f0e5"}, {"name": "ミーシャ", "text": "なっ……王子、大変です！\n森に火が……！！", "face": "u19"}, {"name": "アトナテス", "text": "……まさかこれも、連中の仕業か？\nこいつはさすがに頭に来たぜ……。", "face": "u908"}, {"name": "テティス", "text": "森を追われた魔物が溢れ出しています。\n……対処せざるを得ませんね。", "face": "u37"}, {"name": "ケイティ", "text": "我々の本隊は魔物の対処を。\nそれと近隣の街に伝令を出し、\n消火作業を急ぎましょう。", "face": "u114"}, {"name": "トラム", "text": "……物質界を何とも思わないこの所業、\n黒幕は創造神にでもなったつもりなのかしら。", "face": "u1110a1"}, {"name": "天槍騎兵長", "text": "――否、我らが父上は\nいずれ創造神をも超える御方だ。", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "さぁ物質界の有象無象よ、\n溢れ出す魔物の対処をしなくて良いのか？", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "……姉さま、どうして、こんなことを。\nもっと他に手段はあるはずでは……？", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "スルーズ、お前もいい加減に兵としての覚悟を持て。\nいずれ天界を統べる御方の覇道において、\n多少の犠牲はむしろ誉れと心得よ。", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "……はい、姉さま。", "face": "u1143a1"}, {"name": "トラム", "text": "スルーズ！　あなたは話が通じるみたいね。\nどうしてこんなことを？\n指示を出しているのは何者なの？", "face": "u1110a1"}, {"name": "スルーズ", "text": "……トラム様。\n言えません、私は、姉さまと共に戦うと誓ったのです。", "face": "u1143a1"}, {"name": "スルーズ", "text": "ごめんなさい……。\nあなた方を、私は、殺さなくてはならないのです……！", "face": "u1143a1"}, {"name": "トゥアン", "text": "ちっ……王子、魔物の群れが来るぞ！\n天槍騎兵団と同時に相手をしないといけない、\n絶対に気を抜くんじゃないぞ！", "face": "u1006a1"}]}, {"trigger": "end", "lines": [{"name": "天槍騎兵長", "text": "ふむ……まだ足りないのか……。\n魔王ガリウスを討ったという力は、\nより深き絶望の内からしか生まれないのか？", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "父上が気にかけるほどなのだから、\nさぞかし強い戦士たちだと思ったのだが……。", "face": "l2644ec5e215f"}, {"name": "トラム", "text": "あなたが、天槍騎兵団の指揮官ね？\nどうしてとは問わないわ。\n今のあなたは自我を奪われているのだろうから。", "face": "u1110a1"}, {"name": "トラム", "text": "――けれど、思い出して。\nあなたの父君は、千年戦争で倒れたのよ。", "face": "u1110a1"}, {"name": "天槍騎兵長", "text": "ふっ……何を言って――", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "そ、そうです姉さま！\nお父さまは、グングニルの担い手たる私たちの父は！\n永い眠りについているんですよ！", "face": "u1143a1"}, {"name": "スルーズ", "text": "もう帰りましょう？\n偵察だってもう十分じゃないですか、姉さま！", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "くっ……うるさい……うるさいうるさいうるさい！\n我らが偉大なる父上が、滅びるはずがない！", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "スルーズ、お前もいい加減に目を覚ませ……。\n私たちの父上は、あの御方なのだ……！", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "姉、さま……。", "face": "u1143a1"}]}], "story_talk": true, "active": true}