t": 1, "pattern_id": 2146160, "special_effect_id": 1454, "change_to": 18, "master_id": 36387, "global_id": 10004, "to_global_id": 10005}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "base_hp": 100000, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2146160, "special_effect_id": 1449, "change_to": 19, "master_id": 36388, "global_id": 10005, "to_global_id": 10006}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "base_hp": 100000, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 40, "attack_interval": 118, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2146160, "special_effect_id": 1455, "change_to": 20, "master_id": 36389, "global_id": 10006}, {"enemy_id": 29, "source": "local", "count": 1, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中", "水棲"], "hp": 420000, "attack": 2000, "base_hp": 420000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 40, "attack_range": 300, "attack_wait": 100, "attack_interval": 535, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2146144, "race_id": 19, "special_effect_id": 1460, "missile_id": 810, "missile": {"speed": 4.0}, "master_id": 36376, "global_id": 9993, "ranged": true, "spawn_sec": 196}, {"enemy_id": 30, "source": "local", "count": 35, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 35000, "attack": 800, "base_hp": 35000, "base_attack": 800, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 150, "attack_interval": 351, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124384, "race_id": 7, "special_effect_id": 232, "missile_id": 481, "missile": {"speed": 1.0}, "master_id": 34522, "global_id": 8139, "ranged": true, "spawn_sec": 214}, {"enemy_id": 31, "source": "local", "count": 22, "form_count": 2, "tags": ["水棲"], "hp": 68000, "attack": 1, "base_hp": 68000, "base_attack": 1, "damage_type": "physical", "armor_defense": 650, "magic_defense": 30, "attack_speed": 90, "attack_wait": 80, "attack_interval": 299, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142000, "special_effect_id": 1179, "change_to": 31, "change_condition": 3, "master_id": 35752, "global_id": 9369, "to_condition": 3, "to_global_id": 9370, "route_behaviour": {"transforms": [{"wait": 1200}]}, "spawn_sec": 237}, {"enemy_id": 31, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 68000, "attack": 650, "base_hp": 68000, "base_attack": 650, "damage_type": "magical", "armor_defense": 650, "magic_defense": 30, "attack_range": 200, "attack_speed": 90, "attack_wait": 80, "attack_interval": 225, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2142016, "special_effect_id": 1222, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 35753, "global_id": 9370, "ranged": true, "from_condition": 3}], "popups": ["乙姫がいる間は\n全ての敵ユニットの\n攻防がアップします。\n\nまた乙姫の攻撃は、\n魚人の味方ユニットに対する\nダメージが50％アップします。\n　　　　　　(1/2)", "乙姫は\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "イヲナミ", "text": "――ただいま戻りました！", "face": "u1722a1"}, {"name": "オオワタツミの化身", "text": "おぉ、戻ったか、イヲナミ。\n王子殿、その様子を見れば分かるぞ。\n見事やり遂げてくれたようだな。", "face": "l38fd31c4e097"}, {"name": "アンナ", "text": "誤解と危機感が重なって、\nこのような事態になっていたようです。\n今後は乙姫様に言い寄ってくることもないでしょう。"}, {"name": "オオワタツミの化身", "text": "ふむ……色々と世話を掛けたようだな。\nなればまずは、戦士たちのために、\nねぎらいの宴を開かねばならんな。", "face": "l38fd31c4e097"}, {"name": "アンナ", "text": "いえ、せっかくのお誘いですが、\n我々にはポセイオスの企みを挫くという目的が――", "face": "l518391df5146"}, {"name": "オオワタツミの化身", "text": "戦士にも休息は必要だろう？\n――皆のもの、おもてなしの準備じゃぁ！！\n乙姫！　乙姫も出て参れ！", "face": "l38fd31c4e097"}, {"name": "乙姫", "text": "うぅぅ、おとう様……？\nでもお外にはあのハマグリみたいな妖怪がぁ……。", "face": "u1803a1"}, {"name": "オオワタツミの化身", "text": "そやつをな、この王子殿が退治してくれたのだ。", "face": "l38fd31c4e097"}, {"name": "乙姫", "text": "えっ……ほ、本当に！？\n王子様ぁ～！　ありがとうございますぅ！", "face": "u1803a1"}, {"name": "オオワタツミの化身", "text": "鯛よ踊れ！　鯉よ舞え！\n今宵の主役は王子殿たちじゃぁ～！！", "face": "l38fd31c4e097"}, {"name": "イヲナミ", "text": "――って、あっ、あぁ～！！\nオオワタツミ様！　お酒は飲んじゃダメですよー！！", "face": "u1722a1"}, {"name": "カスミ", "text": "祝いの席ですし、お酒を嗜むくらいは良いのでは？", "face": "u470"}, {"name": "イヲナミ", "text": "だ、だめなんです！\nオオワタツミ様は普段、化身の姿で\n荒ぶる海の本性を抑えているのですが――", "face": "u1722a1"}, {"name": "イヲナミ", "text": "――酔っ払うと、楽しくなって暴れだすんです！！", "face": "u1722a1"}, {"name": "ヴィアベル", "text": "酒乱かー。", "face": "u1247a1"}, {"name": "オオワタツミの化身", "text": "ヌワッハッハッハぁ！\n王国といえばあの英雄王の子孫たちじゃろ？\nよぉし、模擬戦じゃ！　模擬戦をするぞ～！！", "face": "lb4568377d9e8"}, {"name": "乙姫", "text": "えっ、もぎせん？\nおもてなしの模擬戦？", "face": "u1803a1"}, {"name": "乙姫", "text": "乾いた地では不思議なおもてなしがあるのね♪\nよぉし、乙姫も一緒に模擬戦しちゃうよぉ！", "face": "u1803a1"}, {"name": "イヲナミ", "text": "こ、この父娘はぁ～！！\n仕方ありません、皆さん戦闘準備をお願いしますー！！", "face": "u1722a1"}]}, {"trigger": "end", "lines": [{"name": "オオワタツミの化身", "text": "うっぷ……。\nむぅ？　ワシはいったい何を……？", "face": "lb4568377d9e8"}, {"name": "イヲナミ", "text": "オオワタツミ様、これ以降はお酒禁止です！\nはぁ……皆さん、ご迷惑をおかけしました……。", "face": "u1722a1"}, {"name": "乙姫", "text": "ふふぅ、久々に身体を動かしたから、\nとーっても楽しかったぁ……♪", "face": "u1803a1"}, {"name": "アンナ", "text": "これで、ここからは普通の宴になりそうですね。"}, {"name": "シズカ", "text": "あっ……あなたが乙姫さま、でよかったかしら？", "face": "u101"}, {"name": "乙姫", "text": "ん？　乙姫に何か御用？", "face": "u1803a1"}, {"name": "シズカ", "text": "いえ、伝承に違わぬ美しい方だな、と。\nなるほど、あなたのことを言い伝えた、\n件の乙女は真実を語っていたのね。", "face": "u101"}, {"name": "乙姫", "text": "件の、乙女……？\nもしかして、あの子のことを知っているの……？", "face": "u1803a1"}, {"name": "シズカ", "text": "えぇ。随分と昔の話ではあるけれど、\n私の国の民が経験した真実の物語だから。", "face": "u101"}, {"name": "ヨシノ", "text": "東の国の者なら、みんな知ってる有名な物語だしね。\n助けた人魚さんに連れられて、\n龍宮城へ至った乙女の昔話。", "face": "u1104a1"}, {"name": "乙姫", "text": "あの子は……地上に戻ったあと、\nちゃんと幸せに暮らしてた……？", "face": "u1803a1"}, {"name": "ヨシノ", "text": "それはもう、有名作家になって\n乙姫様との思い出に始まり、\n数多の海洋ロマンを綴っていたみたいだよ。", "face": "u1104a1"}, {"name": "シズカ", "text": "だからこそ、今の時代に伝承が残っているのよ。\nその晩年は毎日浜辺に立って、\nあなたに向かって語りかけていたそうだけど。", "face": "u101"}, {"name": "乙姫", "text": "……そっか、覚えてて、くれたんだぁ。\nうぅ、ぐすっ……それなら、\nまた遊びにくればよかったのにぃ……。", "face": "u1803a1"}, {"name": "シズカ", "text": "地上と深海は、遠く離れた場所だから。\nそれでも、彼女はあなたを忘れたりしなかった。", "face": "u101"}, {"name": "乙姫", "text": "……うん。\nありがとう、乾いた地のあなた。", "face": "u1803a1"}, {"name": "乙姫", "text": "ようやくあの子との思い出の最後に、\nめでたしめでたしって書けそう……♪", "face": "u1803a1"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 49, "params": [50]}, {"kind": "term", "influence": 34, "params": [0, 10, 6], "ext": "攻撃待ち増加=90,ダメージ開始待ち=900"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 67200, "attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 25, "pattern_id": 2141968}, {"enemy_id": 1, "form_index": 1, "hp": 67200, "attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 25, "pattern_id": 2141984}, {"enemy_id": 3, "hp": 30000, "attack": 1920, "damage_type": "physical", "armor_defense": 2500, "pattern_id": 2136512}, {"enemy_id": 4, "hp": 7200, "attack": 480, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "pattern_id": 2136480}, {"enemy_id": 4, "form_index": 1, "hp": 7200, "attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "pattern_id": 2136496}, {"enemy_id": 6, "hp": 8400, "attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2136464}, {"enemy_id": 6, "form_index": 1, "hp"