{"quest_id": 1931, "name": "龍宮城の祝宴", "description": "宴に参加した一行は、酔ったオオワタツミ\nの化身や乙姫と模擬戦をすることになり！？\n＜深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞", "modifier_notes": ["深海：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "ストーリーミッション11", "event_category": "Story", "mission_id": 100011, "map_no": 1151, "level": 100, "multiplier": 1.0, "charisma": 56, "capacity": 10, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 2, "tags": ["水棲"], "hp": 56000, "attack": 1, "base_hp": 56000, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 25, "attack_speed": 90, "attack_wait": 45, "attack_interval": 229, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2141968, "special_effect_id": 1179, "change_to": 1, "change_condition": 3, "master_id": 35750, "global_id": 9367, "to_condition": 3, "to_global_id": 9368, "route_behaviour": {"transforms": [{"wait": 1200}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["水棲"], "hp": 56000, "attack": 1, "base_hp": 56000, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 25, "attack_speed": 90, "attack_wait": 45, "attack_interval": 229, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2141984, "special_effect_id": 1221, "master_id": 35751, "global_id": 9368, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 22, "form_count": 1, "tags": ["水棲", "アーマー"], "hp": 25000, "attack": 1600, "base_hp": 25000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 2500, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 300.0, "gain_cost": 2, "dot_r