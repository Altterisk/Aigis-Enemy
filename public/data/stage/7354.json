{"quest_id": 7354, "name": "異端審問官との共闘", "description": "妖精郷へ向かった神聖騎士団の後を追う\n王子一行。ドゥマルデと共に敵を撃退し、\nローズを精神支配から解放せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "最後に残された信仰", "event_category": "History", "mission_id": 920163, "map_no": 5897, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 35, "form_count": 2, "tags": ["植物"], "hp": 6000, "attack": 1200, "base_hp": 6000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2129392, "change_to": 1, "change_condition": 4, "master_id": 33834, "global_id": 7451, "to_condition": 4, "to_ticks": 1, "to_global_id": 7452}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物"], "hp": 6000, "attack": 1200, "base_hp": 6000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 10, "attack_interval": 66, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2129392, "special_effect_id": 548, "master_id": 33835, "global_id": 7452, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 13300, "base_hp": 13300, "damage_type": "physical", "armor_defense": 90, "attack_speed": 1, "attack_wait": 25, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2129376, "race_id": 16, "special_effect_id": 817, "master_id": 33833, "global_id": 7450, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 18, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 70, "attack_wait": 10, "attack_interval": 167, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2122400, "special_effect_id": 510, "master_id": 32496, "global_id": 6115, "spawn_sec": 8}, {"enemy_id": 5, "source": "local", "count": 16, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 13}, {"enemy_id": 6, "source": "local", "count": 8, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 49}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 3500, "attack": 240, "base_hp": 3500, "base_attack": 240, "damage_type": "magical", "armor_defense": 1500, "attack_range": 180, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127424, "special_effect_id": 510, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 33527, "global_id": 7144, "ranged": true, "spawn_sec": 93}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 236, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103248, "change_to": 8, "change_condition": 1, "missile_id": 6, "master_id": 424, "global_id": 423, "ranged": true, "variants": [{"hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "master_id": 423, "global_id": 422}], "spawn_sec": 110}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4200, "attack": 380, "base_hp": 4200, "base_attack": 380, "damage_type": "magical", "armor_defense": 1500, "attack_range": 140, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127440, "special_effect_id": 510, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33528, "global_id": 7145, "ranged": true, "spawn_sec": 160}], "dialogue": [{"trigger": "start", "lines": [{"name": "ププル", "text": "――な、何じゃこのマンドラゴラの数は！？", "face": "u225"}, {"name": "ローレン", "text": "王子、来てくれたか。\n妖精郷の現状は、見てのとおりだ。\n防衛部隊も散り散りになってしまった。", "face": "u118"}, {"name": "オリヴィエ", "text": "……妖精郷の至るところに\nマンドラゴラの種をばらまかれて、\n兵が上手く動けなくなってしまったのです。", "face": "u115"}, {"name": "リコラ", "text": "……ローズ、きっとこんな事したくないはずなのに。", "face": "u289"}, {"name": "ドゥマルデ", "text": "えぇ、彼女は優しい娘のようですからな。\n早く精神支配を解いてやらねば。", "face": "u1266a1"}, {"name": "神聖騎士団員", "text": "――ここにも目的のものは無かったか。\nだが、この罠に王国軍を追い込めたのは僥倖と言える。", "face": "l0443dc85feca"}, {"name": "神聖騎士団員", "text": "このマンドラゴラをもって、\n王国軍の戦力を削っておくとしようか。", "face": "l0443dc85feca"}, {"name": "千人隊長", "text": "さぁローズよ、種を撒け！\nお前の薬草は、異端を殺すためにあるのだ！！", "face": "l2d9e135a0aa1"}, {"name": "ローズ", "text": "いや……あぁっ……やめ……て……っ！", "face": "u1264a1"}, {"name": "ドゥマルデ", "text": "……自ら精神支配を解こうとしているのか。\nこれならば……あとひと押しだな。", "face": "u1266a1"}, {"name": "フィナン", "text": "えっと、どういうことですか……？", "face": "u1003a1"}, {"name": "ドゥマルデ", "text": "身柄さえ確保すれば、私の術で\n精神支配を解除できるということです、フィナンよ。", "face": "u1266a1"}, {"name": "リコラ", "text": "ほんとっ！？\n王子、お願い、力を貸して！\nローズを絶対に、絶対に取り戻すの！", "face": "u289"}, {"name": "ドゥマルデ", "text": "私も助力しましょう。\n神を裏切った身ゆえ、退魔の力は失ってしまいましたがね。", "face": "u1266a1"}, {"name": "リコラ", "text": "うぅん一緒に戦ってくれるだけで心強いよ！\n――ローズ、すぐに助けるからね！！", "face": "u289"}]}, {"trigger": "end", "lines": [{"name": "神聖騎士団長", "text": "――驚いたぞ。\nあれだけのマンドラゴラと、ダークエルフを退けるか。", "face": "l3b12cdb71005"}, {"name": "アレクシア", "text": "……あなたはっ！\n団長、どうしてここに！？", "face": "u1168a1"}, {"name": "神聖騎士団長", "text": "どうしてとはおかしな事を。\n神聖騎士団のあるところ、それすなわち我が戦場なるぞ。", "face": "l3b12cdb71005"}, {"name": "神聖騎士団長", "text": "だが、此度は個人的な興味があってのこと。\nふむ……貴様が王子、ガリウスを倒した英雄か。", "face": "l3b12cdb71005"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "神聖騎士団長", "text": "貴様も理解していよう。\n民にとって、英雄とは毒にしかならないということを。", "face": "l3b12cdb71005"}, {"name": "神聖騎士団長", "text": "次代はどうだ、その次は。\n貴様の子らが、\n貴様と同じく全てを救う英雄となると断言できるのか。", "face": "l3b12cdb71005"}, {"name": "神聖騎士団長", "text": "ただ民を甘言に惑わし、一時の幸福と引き換えに\n未来を奪うその所業――断じて許すことはできない。", "face": "l3b12cdb71005"}, {"name": "神聖騎士団長", "text": "――とはいえ、だ。\n神ならぬ貴様に、未来の話を答えることはできまい。\n少々意地の悪い質問をしてしまったな。", "face": "l3b12cdb71005"}, {"name": "アンナ", "text": "……あなたに、王子の何が分かると？", "face": "lee252eed067d"}, {"name": "神聖騎士団長", "text": "分かるとも！　正義を志したその決意、\n痛いほどによく分かる。", "face": "l3b12cdb71005"}, {"name": "神聖騎士団長", "text": "それゆえに、私は我が友、ドゥマルデを裏切ってまで、\n教団を、我らが主に明け渡したのだからな。", "face": "l3b12cdb71005"}, {"name": "アレクシア", "text": "……えっ？", "face": "u1168a1"}, {"name": "神聖騎士団長", "text": "神がこの世界をひっくり返すと言うのだ。\n救いの道は、強き神に示す方にしかない。", "face": "l3b12cdb71005"}, {"name": "神聖騎士団長", "text": "――だが、ドゥマルデだけは、それを理解して\n付いてきてくれていると思っていたのだがな。\n残念だよ、我が友。", "face": "l3b12cdb71005"}, {"name": "ドゥマルデ", "text": "……知っていたさ、我が友よ。\nだが、その未来に待つのは破滅だ。", "face": "u1266a1"}, {"name": "神聖騎士団長", "text": "……お前のその言葉、\n王子に惑わされてのものだと思っておこう。", "face": "l3b12cdb71005"}, {"name": "神聖騎士団長", "text": "そして王子よ、私は貴様を絶対に許さない。\nいずれ必ず、この剣の錆としてくれよう。", "face": "l3b12cdb71005"}, {"name": "フローガ", "text": "……神聖騎士団、転移魔法を使うようです！", "face": "u878"}, {"name": "アイリーン", "text": "今だ！　セブン、ベルナ！！\nローズの身柄を取り戻せ！！", "face": "u315"}, {"name": "セブン", "text": "アイリーン姐さんは！\n人使いがっ！　荒い！　なぁッ！！", "face": "u449"}, {"name": "ベルナ", "text": "よぉし、ローズちゃん奪還ッ！！\nリコラ！　受け止めて！！", "face": "u46"}, {"name": "リコラ", "text": "わっ、わわっ、わぁっ！？", "face": "u289"}, {"name": "アンナ", "text": "無事に、ローズさんを取り戻せましたね。\n……ただ、事態はより深刻になったようです。\nひとまず、今後の方針を検討することにしましょう。", "face": "le7f1df76e8c4"}]}], "active": true}