"transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 40058, "global_id": 13675}, {"enemy_id": 27, "source": "local", "count": 2, "form_count": 1, "hp": 65000, "attack": 500, "base_hp": 65000, "base_attack": 500, "damage_type": "magical", "armor_defense": 200, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 133, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100592, "race_id": 10, "special_effect_id": 232, "missile_id": 44, "missile": {"speed": 8.0}, "master_id": 40059, "global_id": 13676, "ranged": true}, {"enemy_id": 28, "source": "local", "count": 8, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 132}, {"enemy_id": 29, "source": "local", "count": 11, "form_count": 1, "hp": 12700, "attack": 850, "base_hp": 12700, "base_attack": 850, "damage_type": "physical", "armor_defense": 150, "magic_defense": 40, "attack_speed": 40, "attack_wait": 3, "attack_interval": 89, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098704, "race_id": 3, "special_effect_id": 42, "master_id": 40583, "global_id": 14200, "spawn_sec": 177}, {"enemy_id": 30, "source": "local", "count": 9, "form_count": 1, "hp": 25000, "attack": 1500, "base_hp": 25000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 380, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 40582, "global_id": 14199, "spawn_sec": 220}, {"enemy_id": 31, "source": "local", "count": 4, "form_count": 1, "hp": 60000, "attack": 1000, "base_hp": 60000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 40056, "global_id": 13673, "spawn_sec": 265}], "popups": ["\n\n\n\n――次元の狭間、どこでもない場所", "魔神セーレは特定のタイミングで\n特殊攻撃を行います。\n\n特殊攻撃が発動すると\n特定の近接マスに配置していた\nユニットは撤退します。\n撤退後は再出撃が可能です。", "第三形態の魔神セーレがいる間は\n敵のハニーの攻撃と防御が\nアップします。", "レッサーデーモンから\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "battle", "at_sec": 52, "lines": [{"text": "――次元の狭間,どこでもない場所"}, {"name": "貴族セーレ", "text": "クックック……。", "face": "l70921f716695"}, {"name": "貴族セーレ", "text": "見よ。砕かれた魂の欠片から、\nついにこの魔神セーレが蘇ったぞ。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "はにほー……くっ、ハニワに毒されている……。\nクックック。ともあれ\n蘇った本物のセーレは私だ。貴様は偽物だろう。", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "何を言う。かつての姿を保つ私こそ本物。\nハニーの力など宿した紛い物が。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "魂を砕かれてなお立ち上がった\nこの私こそ、真の魔神セーレ！　ハニホー！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "…………。\nまぁよい。\n今は言い争っている場合ではない。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "……そうだな。\nまずは、あのふたりに復讐を。", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "異世界の戦士ランス、そして王国の王子。\n今度こそ、貴様らに引導を渡してくれる。", "face": "l70921f716695"}, {"name": "貴族セーレ", "text": "――開け、異界の門。\nいでよ、異世界の英雄ランスよ！！", "face": "l70921f716695"}]}, {"trigger": "battle", "at_sec": 54, "lines": [{"name": "ランス", "text": "どわぁぁぁぁっ！？\nまたか！　またこれかー！！", "face": "u2897a1"}, {"name": "シィル", "text": "ひゃあっ！？\nら、ランス様ぁ！　どこですかー！？", "face": "u2900a1"}, {"name": "リア", "text": "きゃっ……何なの、ここ？\nダーリン、ダーリンはどこー？", "face": "u2901a1"}, {"name": "シルキィ", "text": "……転移？　いえ、これは召喚術ね。\nそれも、世界を跨ぐ規模の。", "face": "u2902a1"}, {"name": "志津香", "text": "ちょっと、なんで私まで……！\nはぁ、嫌な予感しかしないわ。", "face": "u1759a1"}, {"name": "貴族セーレ", "text": "ぬ……またしても余計な者が紛れ込んだか。", "face": "l70921f716695"}, {"name": "ランス", "text": "お前……誰だっけ？", "face": "u2897a1"}, {"name": "貴族セーレ", "text": "忘れたとは言わせぬぞ！　我が名は魔神セーレ！\n貴様に二度も敗れ、それでもなお――", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "待てぇい！\n私が魔神セーレだ！　コイツは偽物だ！！", "face": "l889a78825052"}, {"name": "ランス", "text": "魔人なんとかが二匹に増えとる。", "face": "u2897a1"}, {"name": "シィル", "text": "ランス様、魔人じゃなくて魔神さんです！", "face": "u2900a1"}, {"name": "魔剣カオス", "text": "そうじゃぞ心の友よ。異世界の魔神じゃ。\n無敵結界も持っとらんし、儂の出番はないのー。", "face": "le2e11fea1f65"}, {"name": "ランス", "text": "やかましい駄剣。\n二匹まとめてぶった斬るぞ！", "face": "u2897a1"}, {"name": "リア", "text": "ふぅ～ん……？　魔神ねぇ。\nダーリン、あいつら仲悪そうよ？", "face": "u2901a1"}, {"name": "シルキィ", "text": "確かに。互いを見る目に殺気があるわ。\n仲間じゃないのかしら。", "face": "u2902a1"}, {"name": "貴族セーレ", "text": "黙れ！　まぁよい！\n今回は前回までの教訓を活かし、\n確実に貴様を殺す術を用意したのだ。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "そうだぞ。私が編み上げた必殺の呪いだ！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "私が構築した呪いだ！　貴様は下がっていろ！", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "貴様こそ下がれ。私がかける！", "face": "l889a78825052"}, {"name": "Ｗセーレ", "text": "ぐぬぬぬぬぬぬぬ！\nもうどうなっても知らぬ！\nいざ、呪いの詠唱を！！", "face": "l8fe56f160a80"}, {"name": "貴族セーレ", "text": "「ランスよ、貴様は二度と我に近付くこと叶わぬ。\nもし近づけば、貴様のハイパー兵器は爆発し――」", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "「――盛大に吹き飛びランスは爆死する！」\nおい偽物の私、詠唱の邪魔をするな！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "お前こそ邪魔だ！　術式を譲れ！", "face": "l70921f716695"}, {"name": "志津香", "text": "……あの二人、同時に術を組んでるわよ。\n干渉して、とんでもないことになるんじゃ……。", "face": "u1759a1"}, {"name": "ランス", "text": "ふん、知ったことか。\nかかってこい魔人なんとか！　二匹まとめてだ！", "face": "u2897a1"}]}, {"trigger": "end", "lines": [{"name": "貴族セーレ", "text": "ぐっ……！　何という力だ……。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "だが、呪いは完成した！\nくらえ、ランス！", "face": "l889a78825052"}]}, {"trigger": "end", "lines": [{"name": "ランス", "text": "ぬおっ！？　何だ、身体が……いや、\nハイパー兵器が、熱いような……。", "face": "u2897a1"}, {"name": "貴族セーレ", "text": "クックック……これで貴様は、\n我らに近づけば爆死する身となった。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "そう、我らに近づけば……ん？", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "……なぜ、まだ生きている。\nこれだけ近くにいるというのに……。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "どうせ偽物の貴様が邪魔をしたからだ！\n術式が歪んだのだ！", "face": "l889a78825052"}, {"name": "貴族セーレ", "text": "貴様のせいであろうー！？", "face": "l70921f716695"}, {"name": "シィル", "text": "ら、ランス様、大丈夫ですかっ！？\nお怪我はありませんか！？", "face": "u2900a1"}, {"name": "ランス", "text": "シィル、い、嫌な予感がする！\nこっちに来るな……ぬおおおおおっ！？", "face": "u2897a1"}]}, {"trigger": "end", "lines": [{"name": "シィル", "text": "ひゃあああっ！？", "face": "u2900a1"}, {"name": "リア", "text": "ダーリンっ！？\nなに、今の爆発！？", "face": "u2901a1"}, {"name": "志津香", "text": "……もしかして、その術式、発動条件が\n「女性が数メートル以内に入ると」になってない？", "face": "u1759a1"}, {"name": "シルキィ", "text": "女性が近づくと、総統の……その、\nハイパー兵器が爆発する呪い、ということ？", "face": "u2902a1"}, {"name": "貴族セーレ", "text": "何……だと……？", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "なんという……。", "face": "l889a78825052"}, {"name": "志津香", "text": "ふ、ふふ……。ある意味、\nランスに一番効く呪いかもね……。", "face": "u1759a1"}, {"name": "ランス", "text": "はらほろ……女の子に、近づけん……？\nそれは死ねと言っとるのと同じではないか！", "face": "u2897a1"}, {"name": "志津香", "text": "あんたにはいい薬じゃない？\n――おっと、ちょうどお迎えが来たみたい。\nグリム！　こっち！　ここに門を開いて！", "face": "u1759a1"}, {"name": "グリム", "text": "――よいしょっとー！\n異界の門開通でーす。", "face": "u942"}, {"name": "グリム", "text": "はーい、王国軍とうちゃーく。\n異界の門、安定してます。皆さんこっちですよー。", "face": "u942"}, {"name": "シィル", "text": "あっ、王子様！　グリムさん！", "face": "u2900a1"}, {"name": "リア", "text": "あら、あれが噂の王子？\nふぅ～ん……。", "face": "u2901a1"}, {"name": "貴族セーレ", "text": "えぇい！　私を無視するな！\nちょうどいい、全員まとめてここで息の根を――", "face": "l70921f716695"}, {"name": "グリム", "text": "わっ、急いで急いで！\nみなさん急いで門の中へー！！", "face": "u942"}, {"name": "ランス", "text": "おのれ、おのれ魔人セーレ！\n俺様のハイパー兵器の恨み、覚えておけー！！", "face": "u2897a1"}, {"name": "貴族セーレ", "text": "ちっ……のがしたか……。\nまぁよい。呪いはかけた。じわじわ苦しむがいい。", "face": "l70921f716695"}, {"name": "ハニーセーレ", "text": "次に会う時が、貴様の最期だ。ハニホー！", "face": "l889a78825052"}]}], "active": true}