{"quest_id": 20025, "name": "再起した魔神セーレたち", "description": "魂を砕かれてもどうにか蘇った魔神セーレ。\nちょっとした問題はありつつも、めげずに\n復讐を果たそうと再びランスを召喚して？\n%c[ff4000]このミッションは固定メンバーで出撃します。%c[ffffff]", "event": "ランス1000　鬼畜戦士の降臨", "event_category": "Emergency", "mission_id": 200582, "map_no": 7491, "level": 100, "multiplier": 1.0, "charisma": 20, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 130000, "attack": 750, "base_hp": 130000, "base_attack": 750, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 20, "attack_interval": 84, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143184, "race_id": 3, "change_to": 1, "master_id": 35968, "global_id": 9585, "to_global_id": 9586, "route_behaviour": {"transforms": [{"wait": 80}], "creates_obj": 6}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルスII", "ブロック不可"], "hp": 130000, "base_hp": 130000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 1, "attack_wait": 60, "attack_interval": 202, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143200, "race_id": 3, "special_effect_id": 1160, "master_id": 35969, "global_id": 9586}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 12, "hp": 20000, "attack": 500, "base_hp": 20000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 90, "attack_range": 320, "attack_speed": 1, "attack_wait": 80, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2152608, "special_effect_id": 1714, "change_to": 3, "change_condition": 4, "missile_id": 1070, "master_id": 41093, "ranged": true, "to_condition": 4, "to_ticks": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 12, "hp": 20000, "attack": 380, "base_hp": 20000, "base_attack": 380, "damage_type": "true", "armor_defense": 200, "magic_defense":