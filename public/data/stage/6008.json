d": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 180, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106912, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 665, "global_id": 664, "ranged": true, "spawn_sec": 199}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 1300, "attack": 150, "base_hp": 1300, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 130, "attack_speed": 70, "attack_wait": 60, "attack_interval": 151, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106896, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 666, "global_id": 665, "ranged": true, "spawn_sec": 205}, {"enemy_id": 10, "source": "local", "count": 5, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 223}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 120, "attack_speed": 30, "attack_wait": 10, "attack_interval": 111, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103472, "race_id": 13, "missile_id": 125, "missile": {"speed": 8.0}, "master_id": 448, "global_id": 447, "ranged": true, "spawn_sec": 226}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 2, "hp": 12000, "attack": 900, "base_hp": 12000, "base_attack": 900, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 161, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2108944, "race_id": 8, "change_to": 12, "change_condition": 3, "master_id": 30121, "global_id": 3740, "to_condition": 3, "to_global_id": 3741, "spawn_sec": 245}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 900, "base_hp": 12000, "base_attack": 900, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 32, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108960, "race_id": 8, "special_effect_id": 222, "master_id": 30122, "global_id": 3741, "from_condition": 3}], "popups": ["オーク旗手が持つ\n敵の攻撃と防御アップの能力は、\nオーク旗手の数に応じて効果が\n重複します。", "オーク旗手は\n拠点には向かわず、\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "グレーターデーモン", "text": "さぁ、いよいよ魔界武術大会も大詰め。\n両チーム、入場してくれたまえ。", "face": "lbae05943f3b7"}, {"name": "ケイティ", "text": "決勝はやはりドゥーラさんのようですね。\n彼女であれば卑怯な行い等はないかと思います。\n正々堂々、正面から戦いましょう。", "face": "u114"}, {"name": "ドゥーラ", "text": "ようやくこの時が来たな。王子、見せてやるよ。\nオレの100%中の100%……\n……いや、120%の力をっ！！", "face": "u446"}, {"name": "アンナ", "text": "――ひゃ、120％！？", "face": "led53a08d844c"}, {"name": "モーティマ", "text": "おい、あんなのアリかよ！？\n前に戦ったときとは比べものにならない威圧感だぞ！", "face": "u14"}, {"name": "オーク", "text": "うおおおおおおおおぉぉっっ！！\nドゥーラッ！　ドゥーラッ！！", "face": "lac96ae3118cb"}, {"name": "ケイティ", "text": "……あの旗はオークの士気を高める軍旗のようですね。\n私達で言う王子……みたいなものでしょうか。", "face": "u114"}, {"name": "アンナ", "text": "あの旗が振られている限り、オークの方々は\n士気が高く、普段以上の力を発揮していると\n思った方がよさそうですね。王子、ご注意を！", "face": "led53a08d844c"}]}, {"trigger": "end", "lines": [{"name": "ドゥーラ", "text": "グッ……オレの負けだ。完敗だよ、王子。", "face": "u446"}, {"name": "アンナ", "text": "やった！　勝ちました！　\n優勝ですよ、王子っ！！"}, {"name": "グレーターデーモン", "text": "……優勝は王子チーム。\nまったくもってつまらない結果だねぇ……それじゃ。", "face": "lbae05943f3b7"}, {"name": "ケイティ", "text": "待ちなさい！　グレーターデーモン、\n捕虜の人達を解放しなさい！", "face": "u114"}, {"name": "グレーターデーモン", "text": "……断っても面倒そうだねぇ。\n――……ほら、甚だ不本意ではあるが\n捕虜の人間は解放しておいたよ。", "face": "lbae05943f3b7"}, {"name": "アンナ", "text": "……よかった。\n捕虜の皆さんは解放されたようです。"}, {"name": "ドゥーラ", "text": "あの場で断ってしまうのは会場すべてを敵に回す\nようなものだからな……改めて優勝おめでとう、王子。\nアンタ達との試合、楽しかったよ。", "face": "u446"}, {"name": "ケイティ", "text": "ありがとうございます。\nドゥーラさんこそ流石の気迫でした。\n試合が長引けば、どうなっていたかは分かりません。", "face": "u114"}, {"name": "ドゥーラ", "text": "そうかい？　そういって貰えるなら光栄だね。\nそれで……もしよければなんだが……。\nオレを仲間に入れてもらえないだろうか？", "face": "u446"}, {"name": "ドゥーラ", "text": "オレはもっともっと強くなりたい。\nアンタ達についていけば、沢山の強者と\n戦う機会がありそうでな……だめだろうか？", "face": "u446"}, {"name": "アンナ", "text": "とんでもないです！　ドゥーラさんが\n仲間になってくれるのであればとても心強いです。\nぜひ、よろしくお願いします！"}, {"name": "ドゥーラ", "text": "……ありがとう。王子の下でなら\n今よりずっと強くなる事ができそうだ。\n今後ともよろしく頼む！", "face": "u446"}]}], "active": true}