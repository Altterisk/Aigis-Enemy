resist": 100, "transform_resist": 100, "pattern_id": 2098528, "race_id": 2, "master_id": 30576, "global_id": 4195, "spawn_sec": 191}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 293, "global_id": 292, "ranged": true, "spawn_sec": 206}, {"enemy_id": 18, "source": "local", "count": 3, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 209}], "popups": ["合体デーモンから\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "北の大国の騎士", "text": "――どうして、北部戦線にデーモンが……！", "face": "l4dd5ef096b4e"}, {"name": "シビラ", "text": "うろたえないで。\n貴方たちは誇り高き人類の守護者、\n最前線を守り続けてきた騎士でしょう。", "face": "u39"}, {"name": "シビラ", "text": "民の避難を最優先。\n王国軍もこちらへ向かっているから、\n被害を抑えることに努めて。", "face": "u39"}, {"name": "北の大国の騎士", "text": "シビラ殿下……！\nはっ！　騎士の誇りにかけて！！", "face": "l4dd5ef096b4e"}, {"name": "トレシア", "text": "――シビラ様！　戻りました！\n戦況はどうなっていますか！？", "face": "u2314a1"}, {"name": "シビラ", "text": "トレシア！\n良かった、伝令が間に合ったのね。", "face": "u39"}, {"name": "トレシア", "text": "はい、えぇと、ゴブリンの絆のおかげです。", "face": "u2314a1"}, {"name": "シビラ", "text": "…………？", "face": "u39"}, {"name": "チャムチャム", "text": "マータン！　そっち任せたよ！\nアタシはこいつをぶっとばーす！", "face": "u2549a1"}, {"name": "マータン", "text": "心得た！\nマータンストラーイク！", "face": "u2524a1"}, {"name": "シビラ", "text": "私たちはここを抑えるわ。\n総員、剣をとれ！\n北の守りが鉄壁であると、魔物たちに見せてやりなさい！", "face": "u39"}]}, {"trigger": "end", "lines": [{"name": "チャムチャム", "text": "……この辺りに、あんな魔物いたっけ？", "face": "u2549a1"}, {"name": "マータン", "text": "マータンは見たことない。\n誰かが連れてきたのか、追い立てられてきたのか。\n何か原因がないとありえないと思う。", "face": "u2524a1"}, {"name": "シビラ", "text": "もしそうなのだとしたら、\n黒幕を追い詰める必要があるわね。", "face": "u39"}, {"name": "北の大国の騎士", "text": "――シビラ殿下、王国軍が到着しました。\n王子殿下の本隊です！", "face": "l4dd5ef096b4e"}, {"name": "シビラ", "text": "さすがは王子、ナイスタイミングね。\nトレシア、腕利きの騎士を選抜して。\n王国軍と合同で、魔物のあとを追うわ。", "face": "u39"}, {"name": "トレシア", "text": "はっ。当家の騎士たちを出します。\nしかし、魔物が逃げた先は――", "face": "u2314a1"}, {"name": "チャムチャム", "text": "さっき、ここへ駆けつける時に横を通ったよね。\nぼろぼろになった廃砦があったはず。", "face": "u2549a1"}, {"name": "シビラ", "text": "あら、よく見ているわね。\n魔物が逃げた方角はまさにその廃砦。\nおそらく、黒幕がそこから操っているんじゃないかしら。", "face": "u39"}, {"name": "トレシア", "text": "夏祭りの予定が、大変なことになってきましたね。", "face": "u2314a1"}, {"name": "シビラ", "text": "これが無事に終わったら、\n私が特別予算を出すわ。\nさらに盛大な夏祭りをしましょう。", "face": "u39"}, {"name": "チャムチャム", "text": "とくべつよさん！", "face": "u2549a1"}, {"name": "シビラ", "text": "せっかくだし、雪枝の里の戦士と一緒に、\n武闘大会でも開いてみたりとか。", "face": "u39"}, {"name": "チャムチャム", "text": "雪原の戦士たちと……。\nやる気出てきた！　待ってろー！　黒幕ー！！", "face": "u2549a1"}, {"name": "シビラ", "text": "……危なっかしい子ね。\nでも、将来が楽しみだわ。ね、王子？", "face": "u39"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}