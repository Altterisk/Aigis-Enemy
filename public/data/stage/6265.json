rce": "local", "count": 15, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 6, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 8}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107392, "race_id": 6, "change_to": 8, "master_id": 573, "global_id": 572, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 49}, {"enemy_id": 10, "source": "local", "count": 5, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 10, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 69}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107024, "race_id": 6, "master_id": 697, "global_id": 696, "spawn_sec": 119}, {"enemy_id": 13, "source": "local", "count": 3, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 13, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 120}]}, "spawn_sec": 193}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――みんなこっちだよ！　早く早く！", "face": "u527"}, {"name": "アンナ", "text": "ま、待ってくださいヴルムさん。", "face": "l6e8f96843e55"}, {"name": "モーティマ", "text": "ったく、こんな崖路だってのに\nどんだけ元気なんだよ。", "face": "u14"}, {"name": "ヴルム", "text": "でも急がないと、連中いなくなっちゃうかも。\nアタシ先に行って奴らの相手をしてくる！", "face": "u527"}, {"name": "ケイティ", "text": "待ってくださいヴルムさん。ヴルムさんが巡回中に\n見かけたという天使の兵団、奴らの目的が判らない以上\n単独で動くのは危険です。", "face": "u114"}, {"name": "ヴルム", "text": "そんなぁ……うぅ、折角皆の役に\n立てると思ったのにぃ……。", "face": "u527"}, {"name": "アンナ", "text": "帝国の方であるヴルムさんが、王国領内に\n天使が下りて来た事を報せに来てくれただけでも\n大変にありがたい事ですよ…………あれは！"}, {"name": "？？？", "text": "何故このような所に人の子が……？", "face": "u638"}, {"name": "ヴルム", "text": "見つけた！　お前達の目的が何か知らないけど、\nどうせ人間を滅ぼすとか言ってるんでしょ！\nそんなこと、絶対にさせないんだから！", "face": "u527"}, {"name": "？？？", "text": "此度の命にそのような命は含まれていませんが。\n……ですがそうですね、人を滅ぼすのは\n神より承った最大の命でもあります。", "face": "u638"}, {"name": "？？？", "text": "今この場から立ち去ると言うのであれば、\n幾何かの魂の猶予を与えましょう。ですが、\nもし我々の邪魔をするというのであれば……。", "face": "u638"}, {"name": "ケイティ", "text": "目的が判らぬ以上、放置する訳には参りません。\nそれに人を滅ぼすという使命についても、\n我々が絶対に阻止してみせます。", "face": "u114"}, {"name": "？？？", "text": "……愚かな人の子らよ。良いでしょう。\n浄化の炎に抱かれて消えなさい。", "face": "u638"}, {"name": "ヴルム", "text": "王子、アタシも一緒に戦うよ。\n銀竜の加護で皆を守るから！\n力を使いたい時は指示をお願いね！", "face": "u527"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "人の子にしては中々やるようですね。\nでは私も少々本気を――", "face": "u638"}, {"name": "天使", "text": "――セフィーレ様、どうやらこの辺りには\n神獣の卵はないようです。一通り捜索してみましたが、\n気配は感じられません。", "face": "l236921811bcc"}, {"name": "セフィーレ", "text": "そうですか……では、\nここに留まる理由もありませんね。", "face": "u638"}, {"name": "ヴルム", "text": "あ、まて！　逃げるなー！", "face": "u527"}, {"name": "ケイティ", "text": "ヴルムさん、深追いは危険です。\n……天使達の脅威は去りました。\nひとまずはこれで良しとしましょう。", "face": "u114"}, {"name": "ヴルム", "text": "う、うぅー……むぅー……\n…………足りないよ。", "face": "u527"}, {"name": "アンナ", "text": "どうかされましたか？", "face": "l6e8f96843e55"}, {"name": "ヴルム", "text": "……こんなんじゃ全然物足りない！\nもっともっと、強い相手と沢山戦って、\nワクワクドキドキしたいんだよー！", "face": "u527"}, {"name": "ヴルム", "text": "強い相手と戦いたくて帝国にいるのに、\n皇帝は全然相手してくれないし！\nもう、色々溜まっちゃってるんだよ！", "face": "u527"}, {"name": "アンナ", "text": "お、落ち着いて下さいヴルムさん！", "face": "l6e8f96843e55"}, {"name": "ヴルム", "text": "こうなったら、皇帝に……じき……そ？　するもん！\n皆、アタシは用事が出来たから行くね！\nそれじゃまた、ばいばーい！　", "face": "u527"}, {"name": "ケイティ", "text": "あ、ヴルムさ……行ってしまいました。\n既に影も見えません、あれが帝国の竜人部隊の中でも\n随一の力を持つ銀竜の少女ですか……。", "face": "u114"}, {"name": "アンナ", "text": "とても賑やかな方でしたね。……皇帝も、\nなんだか手を焼かされてそうです。"}, {"name": "アンナ", "text": "それでは私達も戻りましょうか。\n王子、お疲れ様です。"}]}], "active": true}