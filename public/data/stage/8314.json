{"quest_id": 8314, "name": "凶銃と射的", "description": "事件前の夏祭り会場。屋台荒らしが出ると\n聞いた王子たちの前に保安官や皆殺しの\n凶銃率いるガンスリンガーたちが現れる。\n神級（★１獲得の目安：平均Lv50）", "event": "鬼刃と死霊と夏祭り", "event_category": "History", "mission_id": 920218, "map_no": 4921, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_count": 1, "hp": 3000, "attack": 220, "base_hp": 3000, "base_attack": 220, "damage_type": "physical", "armor_defense": 80, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 237, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145136, "race_id": 16, "special_effect_id": 1415, "missile_id": 26, "master_id": 36279, "global_id": 9896, "ranged": true, "spawn_sec": 43}, {"enemy_id": 2, "source": "local", "count": 33, "form_count": 1, "tags": ["植物"], "hp": 3000, "attack": 100, "base_hp": 3000, "base_attack": 100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145184, "change_to": 2, "change_condition": 1, "master_id": 36282, "global_id": 9899, "variants": [{"tags": ["植物"], "hp": 3000, "attack": 100, "base_hp": 3000, "base_attack": 100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145200, "special_effect_id": 1416, "master_id": 36283, "global_id": 9900}], "spawn_sec": 46}, {"enemy_id": 4, "source": "local", "count": 12, "form_count": 1, "hp": 12000, "attack": 350, "base_hp": 12000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145152, "race_id": 16, "change_to": 4, "change_condition": 1, "master_id": 36280, "global_id": 9897, "variants": [{"hp": 12000, "attack": 350, "base_hp": 12000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145168, "race_id": 16, "special_effect_id": 1090, "master_id": 36281, "global_id": 9898}], "spawn_sec": 90}, {"enemy_id": 6, "source": "local", "count": 29, "form_count": 1, "hp": 7500, "attack": 500, "base_hp": 7500, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 237, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2145280, "race_id": 16, "special_effect_id": 1415, "missile_id": 26, "master_id": 36288, "global_id": 9905, "ranged": true, "spawn_sec": 103}, {"enemy_id": 7, "source": "local", "count": 29, "form_count": 1, "hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2145296, "race_id": 16, "change_to": 7, "change_condition": 1, "master_id": 36289, "global_id": 9906, "variants": [{"hp": 21000, "attack": 800, "base_hp": 21000, "base_attack": 800, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 1, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2145312, "race_id": 16, "special_effect_id": 1090, "master_id": 36290, "global_id": 9907}], "spawn_sec": 125}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 61000, "attack": 720, "base_hp": 61000, "base_attack": 720, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 267, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145248, "race_id": 16, "special_effect_id": 1415, "change_to": 9, "change_condition": 1, "missile_id": 723, "missile": {"speed": 12.0, "splash": 187}, "master_id": 36286, "global_id": 9903, "ranged": true, "variants": [{"hp": 61000, "attack": 1400, "base_hp": 61000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 40, "attack_interval": 207, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145264, "race_id": 16, "special_effect_id": 220, "master_id": 36287, "global_id": 9904}], "spawn_sec": 143}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 73000, "attack": 900, "base_hp": 73000, "base_attack": 900, "damage_type": "physical", "armor_defense": 120, "attack_range": 280, "attack_speed": 90, "attack_wait": 80, "attack_interval": 189, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2145232, "race_id": 16, "special_effect_id": 1414, "missile_id": 26, "master_id": 36285, "global_id": 9902, "ranged": true, "spawn_sec": 242}], "popups": ["\n\n\n　　　──事件の少し前。", "保安官の近接攻撃を\n複数回受けると、\n麻痺状態になります。", "皆殺しの凶銃の\n攻撃を受けた味方ユニットは\n2秒間、防御力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。"], "dialogue": [{"trigger": "start", "lines": [{"text": "──事件の少し前。"}, {"name": "焼きそば屋台", "text": "──聞いたかいショーユ、どうやら今日の夏祭りに、\nあの有名な屋台荒らしが来ているらしいじゃないか。", "face": "l0e195da3b369"}, {"name": "焼きとうもろこし屋台", "text": "なんだって？　おいおいソース、\nそいつはあまり笑えない冗談だな。", "face": "l0f420af24b07"}, {"name": "アンナ", "text": "屋台荒らし……？"}, {"name": "デューオ", "text": "ラトゥールのことじゃなくて？", "face": "u1890a1"}, {"name": "ラトゥール", "text": "本人が今ここにいるでしょうが。\n今年は大人しくしている方よ、私。", "face": "u1541a1"}, {"name": "ダニエラ", "text": "屋台荒らしの話は少し気になるけど……\nほらほら、ここが難しいって噂の射的屋台よ。", "face": "u518"}, {"name": "デューオ", "text": "あ、ちょうど先客が入っちゃった──って、んー？", "face": "u1890a1"}, {"name": "皆殺しの凶銃", "text": "店主、三回だ。", "face": "lc4bd63d950db"}, {"name": "アンナ", "text": "あれは、荒野の開拓地で会った皆殺しの凶銃さん？\n他にも保安官さんやガンスリンガーの方々もいますね。"}, {"name": "メル", "text": "やたらと大荷物ね……あれ全部屋台の景品じゃない？", "face": "u1888a1"}, {"name": "皆殺しの凶銃", "text": "あん？　なんだ、王国の王子様とそのツレじゃねぇか。", "face": "lc4bd63d950db"}, {"name": "デューオ", "text": "久しぶり凶銃、くまのぬいぐるみなんて担いで何してんの？", "face": "u1890a1"}, {"name": "デステリカ", "text": "二つ名で呼ぶなァ、アタシの名前はデステリカだ。", "face": "lc4bd63d950db"}, {"name": "デステリカ", "text": "それと、こいつらは今日の戦利品だぜ？\nこの祭りの射的はレベルが高いって聞いたんだが、\nどこもかしこも歯応えってモンがまるでねェ。", "face": "lc4bd63d950db"}, {"name": "デステリカ", "text": "あとはこの店で全制覇ってところだ。", "face": "lc4bd63d950db"}, {"name": "デューオ", "text": "もしかして、屋台荒らし？", "face": "u1890a1"}, {"name": "デステリカ", "text": "さあな、そんなもんになったつもりはねェが……\nもしそうだと言ったら、王子様たちはどうすんだァ？", "face": "lc4bd63d950db"}, {"name": "デューオ", "text": "歯応えが無くて退屈してるんでしょ？\nなら、アタシたちと射的勝負しようよ。", "face": "u1890a1"}, {"name": "デステリカ", "text": "王子様たちと？　いいぜ、面白そうじゃねェか！", "face": "lc4bd63d950db"}, {"name": "ラトゥール", "text": "あなたが勝ったらとびっきりの賞品をあげるわ。\n逆に、私たちの方が勝ったらだけど──", "face": "u1541a1"}, {"name": "デステリカ", "text": "いいぜ、取った景品は元に戻してやるよ。", "face": "lc4bd63d950db"}, {"name": "ラトゥール", "text": "ありがとう、代金は私の方でお返しするわね。", "face": "u1541a1"}, {"name": "デステリカ", "text": "オーケー、負ける気なんぞねェけどなァッ！？\n本場のクイックドロウってのを魅せてやるよォ！", "face": "lc4bd63d950db"}, {"name": "デステリカ", "text": "レディ！", "face": "lc4bd63d950db"}, {"name": "デューオ", "text": "ゴーッ！", "face": "u1890a1"}]}, {"trigger": "end", "lines": [{"name": "デステリカ", "text": "ンな馬鹿な、アタシが銃で負けた……？", "face": "lc4bd63d950db"}, {"name": "デューオ", "text": "残念、射的ではアタシに一日の長があったね。", "face": "u1890a1"}, {"name": "観客A", "text": "あれは……去年の夏祭りで射的屋台を荒らしに荒らした、\n伝説のダブルライフル、お祭り海賊デューオじゃねぇか！", "face": "l0e195da3b369"}, {"name": "観客B", "text": "まさか……射的は引退したと聞いていたが……。", "face": "l0f420af24b07"}, {"name": "メル", "text": "射的荒らし多すぎない？", "face": "u1888a1"}, {"name": "ダニエラ", "text": "来年は何件残ってるか分からないわねぇ。", "face": "u518"}, {"name": "デステリカ", "text": "くっ……仕方ねェな、勝負は勝負だ。\nほらよ景品だ、屋台に戻しといてくれ。", "face": "lc4bd63d950db"}, {"name": "デューオ", "text": "……あれ、そのぬいぐるみは？", "face": "u1890a1"}, {"name": "トネール", "text": "ああそれ、射的じゃなくてくじの景品なんだよ。\nこの子ったら当たらないからってくじを何回も──", "face": "u1885a1"}, {"name": "デステリカ", "text": "オォイッ！？　余計なことを言うんじゃねェ！", "face": "lc4bd63d950db"}, {"name": "デューオ", "text": "……なんかごめんね？", "face": "u1890a1"}, {"name": "デステリカ", "text": "謝んじゃねェよ！？", "face": "lc4bd63d950db"}, {"name": "デステリカ", "text": "くそっ、帰るぞ保安官殿！　またな王子様！", "face": "lc4bd63d950db"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "ラトゥール", "text": "なんにせよ、夏祭りの治安は守られたわね。", "face": "u1541a1"}, {"name": "デューオ", "text": "いやー、勝負したらお腹すいたなー。\nおじさーん、焼きそば一つちょうだい？", "face": "u1890a1"}, {"name": "焼きそば屋台", "text": "売り切れです。", "face": "l0e195da3b369"}, {"name": "デューオ", "text": "じゃあ、焼きとうもろこし……。", "face": "u1890a1"}, {"name": "焼きとうもろこし屋台", "text": "売り切れです。", "face": "l0f420af24b07"}, {"name": "デューオ", "text": "え、だってさっきまで普通に売って……。", "face": "u1890a1"}, {"name": "デューオ", "text": "……まさか、本当の屋台荒らしは凶銃じゃなくて──", "face": "u1890a1"}]}, {"trigger": "end", "lines": [{"name": "レギーナ", "text": "…………違うぞ？", "face": "u1045a1"}]}], "active": true}