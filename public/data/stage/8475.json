{"quest_id": 8475, "name": "溶岩焙煎", "description": "カカオ豆の魔物を焙煎するべく、\n一行は魔物がひしめく溶岩地帯に辿り着く。\n＜HPに継続ダメージ：小＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["HPに継続ダメージ：小"], "event": "不思議なカカオクッキング", "event_category": "History", "mission_id": 920226, "map_no": 9296, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 5, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["植物"], "hp": 27000, "attack": 1250, "base_hp": 27000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 1, "attack_wait": 50, "attack_interval": 148, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2158576, "change_to": 1, "master_id": 38501, "global_id": 12118, "to_global_id": 12119, "route_behaviour": {"transforms": [{}], "calls_event": [2065, 2066, 2067, 2068, 2069, 2070]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物"], "hp": 27000, "attack": 1050, "base_hp": 27000, "base_attack": 1050, "damage_type": "magical", "armor_defense": 350, "magic_defense": 10, "attack_speed": 1, "attack_wait": 50, "attack_interval": 148, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2158592, "master_id": 38502, "global_id": 12119}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 3, "change_condition": 5, "master_id": 780, "global_id": 779, "to_condition": 5, "to_global_id": 780, "spawn_sec": 51}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 781, "global_id": 780, "ranged": true, "from_condition": 5}, {"enemy_id": 5, "source": "local", "count": 22, "form_count": 1, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 221, "move_speed": 230.0, "gain_cost": 1, "dot_rate": 0.699999988079071, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100192, "missile_id": 52, "missile": {"speed": 6.0, "splash": 107}, "master_id": 282, "global_id": 281, "ranged": true, "spawn_sec": 58}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "hp": 4500, "attack": 150, "base_hp": 4500, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105584, "missile_id": 152, "missile": {"speed": 6.0, "splash": 133}, "master_id": 702, "global_id": 701, "ranged": true, "spawn_sec": 86}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 7, "change_condition": 5, "master_id": 782, "global_id": 781, "to_condition": 5, "to_global_id": 782, "spawn_sec": 142}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 783, "global_id": 782, "ranged": true, "from_condition": 5}, {"enemy_id": 9, "source": "local", "count": 9, "form_count": 1, "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "magical", "armor_defense": 150, "magic_defense": 30, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109920, "missile_id": 197, "missile": {"speed": 6.0, "splash": 80}, "master_id": 30249, "global_id": 3868, "ranged": true, "spawn_sec": 181}, {"enemy_id": 10, "source": "local", "count": 19, "form_count": 1, "hp": 1800, "attack": 300, "base_hp": 1800, "base_attack": 300, "damage_type": "magical", "armor_defense": 150, "magic_defense": 10, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 221, "move_speed": 230.0, "gain_cost": 1, "dot_rate": 0.699999988079071, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109904, "missile_id": 52, "missile": {"speed": 6.0, "splash": 107}, "master_id": 34907, "global_id": 8524, "ranged": true, "spawn_sec": 186}], "popups": ["カカオ豆の魔物は\n一定時間経過すると\n焙煎され攻撃性能が変化します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ノストラ", "text": "カカオ豆をチョコにするのに必要な工程は、\n焙煎と磨砕、あとは砂糖を混ぜて味を調えるくらいかしら。", "face": "u2364a1"}, {"name": "ノストラ", "text": "でも、通常の調理では無理だから、\nまずは高火力で焙ることにしたけれど……。\n流石に溶岩地帯は熱いわね。", "face": "u2364a1"}, {"name": "ミア", "text": "一応、風水的にはここが一番、\nチョコ作りに適している地点ではありますが……。", "face": "u2361a1"}, {"name": "マツリ", "text": "さて、カカオ豆の魔物はどうでしょう？\n溶岩の熱なら、しっかり焙れるはずですけど。", "face": "u2363a1"}, {"name": "カカオ豆の魔物", "text": "あちちっ！　身体が焦げていくのを感じる！\nこれすっごい焙煎されてるよ！！", "face": "le1ad1420c9f0"}, {"name": "エレイン", "text": "よし、大丈夫そうね！\nじゃあカカオ豆の魔物には、\nしばらく溶岩の近くにいてもらおうかしら。", "face": "u2365a1"}, {"name": "アデライド", "text": "とはいえ私たちもゆっくりできそうにはないぞ。\n見ろ、ここらの魔物が襲いかかろうと寄って来ている。", "face": "u2362a1"}, {"name": "カカオ豆の魔物", "text": "私が美味しそうに見えすぎてるからかな……？", "face": "le1ad1420c9f0"}, {"name": "ノストラ", "text": "まだそんなに美味しそうには見えないわよ。", "face": "u2364a1"}, {"name": "ミア", "text": "でも、これから美味しいチョコにしていきますから！\nカカオ豆さんはしっかり火を通してくださいね！", "face": "u2361a1"}, {"name": "カカオ豆の魔物", "text": "風水士の貴方……！\nありがとう！　アツアツのカカオマスになるよ！", "face": "le1ad1420c9f0"}, {"name": "アデライド", "text": "ではしっかり焙煎されるまで、\n襲いくる魔物をさばくとするか。", "face": "u2362a1"}]}, {"trigger": "end", "lines": [{"name": "ミア", "text": "危なかったですね……。\n溶岩地帯の火力が高すぎて、\nカカオ豆さんが黒焦げになっちゃうところでした。", "face": "u2361a1"}, {"name": "アデライド", "text": "実際、ちょっと燃えかけていたしな……。", "face": "u2362a1"}, {"name": "カカオ豆の魔物", "text": "ハァ、ハァ……！\nあ、ありがとう、みんな……！\nちょっと危なかったけど、無事に焙煎できたよ！", "face": "le1ad1420c9f0"}, {"name": "エレイン", "text": "そうね、今はなんだか、\n香ばしくてとってもいい匂いがするわ！", "face": "u2365a1"}, {"name": "カカオ豆の魔物", "text": "そ、そうかな……？\n私、美味しいチョコに近づけてる？", "face": "le1ad1420c9f0"}, {"name": "ミア", "text": "はい、近づけてますよ。\nこの調子で料理していけば、\nみんなを笑顔にするようなチョコになれるはずです。", "face": "u2361a1"}, {"name": "カカオ豆の魔物", "text": "わぁ……！\nみんな、本当にありがとう！\n私、美味しくなって恩返しする！", "face": "le1ad1420c9f0"}, {"name": "マツリ", "text": "それは嬉しいですけど、\n食べたらなくなってしまうのは、\nなんだか後味が悪いですね……。", "face": "u2363a1"}, {"name": "カカオ豆の魔物", "text": "大丈夫だよ！\n全部は食べられないようにするから！", "face": "le1ad1420c9f0"}, {"name": "カカオ豆の魔物", "text": "再生できるように身体を少し残して食べてもらうの。\nそうしたら、美味しいチョコを、\nずっとみんなにあげることができるから！", "face": "le1ad1420c9f0"}, {"name": "ノストラ", "text": "カカオ豆の魔物ってそういう生態なのね……。", "face": "u2364a1"}, {"name": "ミア", "text": "ふふっ。でも、それでいいと思います。\nせっかく出会えたカカオ豆さんが、\n食べられていなくなるのは寂しいですから。", "face": "u2361a1"}, {"name": "エレイン", "text": "さて、またカカオ豆が燃えちゃ嫌だし、\nそろそろ次の場所へ行きましょ！", "face": "u2365a1"}, {"name": "ミア", "text": "では、カカオ豆さん。\nこれからもよろしくお願いしますね。", "face": "u2361a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "カカオ豆の魔物", "text": "う、うわぁぁぁぁ！！\n溶岩から引火したぁぁぁっ！！", "face": "le1ad1420c9f0"}, {"name": "ミア", "text": "あぁっ！？　カカオ豆さんが燃えてますよ！？", "face": "u2361a1"}, {"name": "アデライド", "text": "流石に溶岩地帯は火力が高すぎたか……！", "face": "u2362a1"}, {"name": "カカオ豆の魔物", "text": "タスケテーーッ！！\nチョコになる前に消し炭になっちゃうゥーーッ！！", "face": "le1ad1420c9f0"}, {"name": "ミア", "text": "助けたいのは山々ですが、\n動き回られると上手く消火できませんし……。", "face": "u2361a1"}, {"name": "ミア", "text": "と、とりあえず、\n一旦倒してから鎮火してあげましょう！", "face": "u2361a1"}]}], "active": true}