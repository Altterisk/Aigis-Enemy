 250, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 140, "attack_speed": 60, "attack_wait": 10, "attack_interval": 56, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104352, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 10063, "global_id": 1062, "ranged": true, "spawn_sec": 64}, {"enemy_id": 5, "source": "local", "count": 9, "level": 80, "form_count": 1, "hp": 1500, "attack": 250, "base_hp": 1500, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 121, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098048, "race_id": 16, "master_id": 80, "global_id": 79, "spawn_sec": 77}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 120, "base_hp": 4000, "base_attack": 120, "damage_type": "physical", "armor_defense": 40, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 56, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099264, "race_id": 16, "special_effect_id": 234, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 31115, "global_id": 4734, "ranged": true, "spawn_sec": 81}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 3800, "base_hp": 3800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110896, "race_id": 16, "special_effect_id": 738, "master_id": 30411, "global_id": 4030, "spawn_sec": 83}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 500, "base_hp": 6500, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115168, "race_id": 16, "master_id": 31108, "global_id": 4727, "spawn_sec": 119}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 3500, "attack": 150, "base_hp": 3500, "base_attack": 150, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 20, "attack_interval": 77, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100400, "race_id": 16, "special_effect_id": 224, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 31117, "global_id": 4736, "ranged": true, "spawn_sec": 147}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 90, "attack_wait": 20, "attack_interval": 181, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2100992, "race_id": 16, "special_effect_id": 227, "master_id": 31118, "global_id": 4737, "spawn_sec": 150}], "popups": ["マーニーがいる間は\n全ての敵ユニットの\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フーリ", "text": "はぁ……いいなぁ、海。\n私も泳いでみたいなぁ……。", "face": "u174"}, {"name": "ホルエス", "text": "しかし、何度見ても圧倒されますね。\nこれが全て水だなんて……。", "face": "u149"}, {"name": "マーニー", "text": "これが私たちの故郷にあったら……って、\n砂漠出身の私たちは思っちゃいますよね。", "face": "u155"}, {"name": "ザラーム", "text": "…………。\n（塩水だから飲めはせんぞ、と言うのは野暮であろうな）", "face": "u175"}, {"name": "アザミ", "text": "……砂漠の民たちは少々気が緩んでいるようですね。\nここは我々東の国の者だけでも\n訓練に集中するとしましょう。", "face": "u160"}, {"name": "モミジ", "text": "ええ。どんなスイカであっても\nこの刀で一刀両断して進ぜましょう。", "face": "u164"}, {"name": "アザミ", "text": "……スイカ？", "face": "u160"}, {"name": "モミジ", "text": "……はっ！　ち、違いますッ！\nこのモミジ、決して久しぶりに海に来たことが\n嬉しくて浮かれていたわけでは……っ！", "face": "u164"}, {"name": "アザミ", "text": "……大丈夫ですか？　早口になっていますよ？", "face": "u160"}, {"name": "足軽", "text": "アザミ様、モミジ様！　王子たちが来ましたぞ！", "face": "u141"}, {"name": "ケイティ", "text": "お疲れ様です。\n攻め手の皆さんは既に配置に就いているようですね。", "face": "u114"}, {"name": "エレイン", "text": "じゃあさっそく訓練を始めちゃいましょ。\n……キャリー、奇襲を頼んだわよ？", "face": "u36"}, {"name": "キャリー", "text": "うん、わかってる。\n……王子、見ていてくださいね！", "face": "u646"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ケイティ", "text": "それではこれより訓練を開始します。\n用意――始めッ！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "ホルエス", "text": "ふぅ……いい汗かきました。", "face": "u149"}, {"name": "アリサ", "text": "お疲れ様です。\nお水が欲しい方は言ってくださいね？", "face": "u24"}, {"name": "ザラーム", "text": "それにしても、まさか伏兵がいたとは。\nこのザラームの目を以てしても見抜けなかった。", "face": "u175"}, {"name": "キャリー", "text": "えへへ、びっくりしました？", "face": "u646"}, {"name": "マーニー", "text": "しましたしました。\nそれに、なんですかその水着？\nズルいです、ちょっと可愛すぎです。", "face": "u155"}, {"name": "フーリ", "text": "そうですよキャリーさん。\nあーあ、私も水着持ってたら\nこのまま海に入っちゃうのに。", "face": "u174"}, {"name": "アザミ", "text": "まったく……砂漠の民はたるんでいますね。\nそもそも普段から水着のような格好をしているくせに。", "face": "u160"}, {"name": "モミジ", "text": "アザミさんも似たようなものなのでは……？", "face": "u164"}, {"name": "アザミ", "text": "笑止。これは忍びの正装です。", "face": "u160"}, {"name": "アンナ", "text": "……ふふっ。\n皆さん、心なしか普段よりも楽しそうですね。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "ですが、せっかく海に来たのですから、\nやはり泳ぎたくなるのが人情というもの。"}, {"name": "アンナ", "text": "全ての訓練が終わったら、皆の慰安のために\n一日くらい海で遊ぶのもいいかもしれませんね。"}]}], "active": true}