{"quest_id": 8518, "name": "第九陣 門の守護者", "description": "敵軍を追い、市街地へ向かう一行。\nそこには己が真意を語るに足るか見極め\nようと決意を固めたカルペムがいて……。\n神級（★１獲得の目安：平均Lv50）", "event": "帝国九陣", "event_category": "Empire", "mission_id": 940009, "map_no": 9321, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_index": 0, "form_count": 2, "tags": ["アンデッド"], "hp": 3500, "base_hp": 3500, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_interval": 50, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142464, "special_effect_id": 1179, "change_to": 1, "change_condition": 2, "master_id": 35805, "global_id": 9422, "to_condition": 2, "to_global_id": 8712}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2, "spawned_on_death_by": [1, 4, 29]}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 194000, "attack": 2450, "base_hp": 194000, "base_attack": 2450, "damage_type": "physical", "armor_defense": 1600, "magic_defense": 40, "attack_range": 312, "attack_speed": 1, "attack_wait": 40, "attack_interval": 139, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 100, "pattern_id": 2159888, "race_id": 2, "special_effect_id": 2028, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 38622, "global_id": 12239, "ranged": true, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 21, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_d