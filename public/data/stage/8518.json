", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 200, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159632, "race_id": 21, "special_effect_id": 1540, "master_id": 38612, "global_id": 12229, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 25, "source": "local", "count": 11, "form_index": 0, "form_count": 2, "hp": 8000, "attack": 1400, "base_hp": 8000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127824, "race_id": 21, "change_to": 25, "change_condition": 4, "master_id": 33563, "global_id": 7180, "to_condition": 4, "to_ticks": 3, "to_global_id": 7183, "spawn_sec": 95}, {"enemy_id": 25, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2127840, "race_id": 21, "special_effect_id": 563, "missile_id": 45, "master_id": 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 29, "source": "local", "count": 3, "form_index": 0, "form_count": 2, "hp": 23000, "attack": 700, "base_hp": 23000, "base_attack": 700, "damage_type": "magical", "armor_defense": 200, "attack_range": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 71, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138576, "race_id": 13, "special_effect_id": 216, "change_to": 1, "change_condition": 2, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 35093, "global_id": 8710, "ranged": true, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 122}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "（付いてきたわね。\n街へ逃げ込めば、己が民を守るため、\n精鋭が来るとは思っていたけど……）", "face": "u2401a1"}, {"name": "？？？", "text": "（あの男、おそらくは白の帝国の皇帝……。\nそれを見送ったのが、王国の王子？）", "face": "u2401a1"}, {"name": "？？？", "text": "（戦いの渦中に飛び込む者と、\nそれを止めることなく見送る者――）", "face": "u2401a1"}, {"name": "ヴァルデ", "text": "ははっ、うちの陛下を馬鹿だと思ってる顔だ。", "face": "u2403a1"}, {"name": "？？？", "text": "なっ……飛行船で市街地に……！？", "face": "u2401a1"}, {"name": "ヴァルデ", "text": "飛行船じゃないぜ？\nこいつは最新鋭の高速飛空戦艦だ！", "face": "u2403a1"}, {"name": "？？？", "text": "どちらにせよ頭が悪い……！！", "face": "u2401a1"}, {"name": "ヴァルデ", "text": "空から偵察したほうが早いんだよ。\nもう信号弾も上げた。\n――ほら、馬鹿の皇帝陛下のお出ましだ！", "face": "u2403a1"}, {"name": "白の皇帝", "text": "――俺に言いたいことがあるのだろう。\n冥界から来た、竜人の娘。", "face": "u418"}, {"name": "？？？", "text": "…………っ！！", "face": "u2401a1"}, {"name": "白の皇帝", "text": "俺にその器があるのか、好きに試すがいい。", "face": "u418"}, {"name": "？？？", "text": "感謝するわ。\n白の帝国の長。", "face": "u2401a1"}, {"name": "カルペム", "text": "――我が名はカルペム！\nタルタロスの門を守護する者！", "face": "u2401a1"}, {"name": "カルペム", "text": "その器、見極めさせてもらう！", "face": "u2401a1"}]}, {"trigger": "end", "lines": [{"name": "白の皇帝", "text": "――満足したか？", "face": "u418"}, {"name": "カルペム", "text": "……その強さの源までは分からなかった。\nでも、頼るべき力を持つ者だと理解できたわ。", "face": "u2401a1"}, {"name": "カルペム", "text": "牙を向けたこと、謝罪する。\n如何様にでも処分は受けよう。\nされど――力を貸してほしい。", "face": "u2401a1"}, {"name": "白の皇帝", "text": "話せ。", "face": "u418"}, {"name": "カルペム", "text": "私はタルタロスの番人。\n秘匿されてきた門の封印を、守護する一族の末裔。", "face": "u2401a1"}, {"name": "白の皇帝", "text": "タルタロスとは何だ。", "face": "u418"}, {"name": "カルペム", "text": "古き封印の地。\nその最奥に、眠るべき大いなる災禍を抱いた扉。", "face": "u2401a1"}, {"name": "カルペム", "text": "冥界深くに埋め込まれ、\n世界そのものを封印の要に用いた滅びの門。", "face": "u2401a1"}, {"name": "白の皇帝", "text": "内に眠るものとは？", "face": "u418"}, {"name": "カルペム", "text": "……ごめんなさい。\n私たちの一族にも、それは伝わっていないわ。", "face": "u2401a1"}, {"name": "カルペム", "text": "ただ、今その門が開かれようとしているの。\nそれだけは止めなければ。", "face": "u2401a1"}, {"name": "白の皇帝", "text": "――わかった。\nカルペム、共に来い。", "face": "u418"}, {"name": "白の皇帝", "text": "ハイドースは、俺たちが討つ。", "face": "u418"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 12, "params": [200]}, {"kind": "term", "influence": 20, "params": [150]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 3500, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2142464}, {"enemy_id": 1, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 3, "form_index": 0, "hp": 194000, "attack": 2450, "damage_type": "physical", "armor_defense": 1600, "magic_defense": 40, "pattern_id": 2159888}, {"enemy_id": 4, "form_index": 0, "hp": 2000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 5, "form_index": 0, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 5, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 9, "form_index": 0, "hp": 2500, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 9, "form_index": 1, "hp": 2500, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 13, "form_index": 0, "hp": 5500, "attack": 250, "damage_type": "magical", "armor_defense": 40, "magic_defense": 50, "pattern_id": 2155440}, {"enemy_id": 13, "form_index": 1, "hp": 5500, "attack": 400, "damage_type": "true", "armor_defense": 40, "magic_defense": 50, "pattern_id": 2155456}, {"enemy_id": 17, "form_index": 0, "hp": 142000, "attack": 2650, "damage_type": "physical", "armor_defense": 5000, "magic_defense": 30, "pattern_id": 2159696}, {"enemy_id": 17, "form_index": 1, "hp": 