: 2404, "missile_id": 1583, "missile": {"on_hit": {"kind": "攻撃遅延", "duration_f": 240, "attack_interval_f": 120, "effect_name": "HitEffectSlow"}}, "master_id": 40473, "global_id": 14090, "ranged": true, "spawn_sec": 86}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 2, "hp": 61600, "attack": 880, "base_hp": 88000, "base_attack": 880, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 160, "attack_speed": 1, "attack_wait": 7, "attack_interval": 80, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2169808, "race_id": 13, "special_effect_id": 232, "change_to": 8, "change_condition": 4, "missile_id": 476, "master_id": 40476, "global_id": 14093, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 14094, "spawn_sec": 91}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 61600, "attack": 931, "base_hp": 88000, "base_attack": 1330, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 7, "attack_interval": 81, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2169824, "race_id": 13, "master_id": 40477, "global_id": 14094, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 2, "tags": ["三つ目の種族"], "hp": 84000, "attack": 7, "base_hp": 120000, "base_attack": 10, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 60, "attack_interval": 172, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "pattern_id": 2170336, "special_effect_id": 2423, "change_to": 10, "master_id": 40549, "global_id": 14166, "to_global_id": 14167, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 93}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["三つ目の種族"], "hp": 84000, "attack": 7, "base_hp": 120000, "base_attack": 10, "damage_type": "magical", "armor_defense": 100, "magic_defense": 25, "attack_speed": 1, "attack_wait": 60, "attack_interval": 172, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "pattern_id": 2170336, "special_effect_id": 2424, "change_to": 9, "master_id": 40550, "global_id": 14167}], "dialogue": [{"trigger": "start", "lines": [{"name": "貴族院議員", "text": "――来たか、異端者ども。\nそれに、裏切り者の娘。", "face": "ld27c976377a6"}, {"name": "ニハラ", "text": "…………。", "face": "u2888a1"}, {"name": "貴族院議員", "text": "見るがいい。砕かれた神は、我らの手で蘇った。\nひとつではなく、数多の群体神として。", "face": "ld27c976377a6"}, {"name": "アルレット", "text": "ひぇ……ほんとに小さいヴィマーナがいっぱい……。\nあれ全部起動したら、\nこの辺の法則がぐちゃぐちゃになるよ。", "face": "u1453a1"}, {"name": "ユリクセス", "text": "まとめて叩くしかないな。", "face": "u2193a1"}, {"name": "貴族院議員", "text": "呪術師ども、神の目覚めを守れ。\n異端者どもに、滅びの慈悲を――", "face": "ld27c976377a6"}, {"name": "ラージヴィール", "text": "――フゥハハハハー！！\n待たせたな、我が友よ！！", "face": "ldaa9ce1c359e"}, {"name": "三つ目の従者", "text": "閣下、街は……って、聞くだけ無駄ですね。", "face": "l0da42f6d0d27"}, {"name": "ラージヴィール", "text": "街は臣下どもに任せた！\n我が友の戦場に、我がおらぬなど許されぬ！", "face": "ldaa9ce1c359e"}, {"name": "ニハラ", "text": "閣下……！", "face": "u2888a1"}, {"name": "ラージヴィール", "text": "ニハラ、その顔だ。\n貴様は昔から、我が来ると、その顔をする。\n実に父親冥利に尽きるぞ！", "face": "ldaa9ce1c359e"}, {"name": "ニハラ", "text": "……していません。", "face": "u2888a1"}, {"name": "三つ目の従者", "text": "（してるんだよな）", "face": "l0da42f6d0d27"}, {"name": "アナーニャ", "text": "王子殿下、小型ヴィマーナが目覚めます。\nここで、講和の値付けを跳ね上げてやりましょう。", "face": "u2873a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ラージヴィール", "text": "ついにこの日が来たな。\n稀なる勇者と肩を並べる日が来ようとは！\n天眼の民よ、これこそが戦場であるぞッ！！", "face": "ldaa9ce1c359e"}]}, {"trigger": "end", "lines": [{"name": "貴族院議員", "text": "馬鹿な……神が、再び、砕かれた……？", "face": "ld27c976377a6"}, {"name": "ラージヴィール", "text": "去れ。貴族院の犬よ。\n貴様らの神は、もう貴様らのものではない。", "face": "ldaa9ce1c359e"}, {"name": "三つ目の従者", "text": "……敵軍、退いていきます。\n閣下、貴族院とはこれで完全に決裂ですよ。", "face": "l0da42f6d0d27"}, {"name": "ラージヴィール", "text": "構わぬ。\n我が領と、この女狐の領は、王国と停戦協定を結ぶ！", "face": "ldaa9ce1c359e"}, {"name": "アナーニャ", "text": "いい加減に女狐呼びはやめてもらえます？\nそれに、ふたつの貴族家だけではありません。\nすでに天眼ノ国の半数の貴族はこちらについています。", "face": "u2873a1"}, {"name": "アンナ", "text": "いつの間に……。"}, {"name": "アナーニャ", "text": "王子殿下との秘密会談のあとすぐに。\n賭けは絶対に勝てるもの以外、\n手を出してはいけないのですよ。", "face": "u2873a1"}, {"name": "アナーニャ", "text": "（それに、この根回しの対価に、\n王国との間には、有利な\n貿易協定の条件も結ばせてもらいましたし……）", "face": "u2873a1"}, {"name": "ディエーラ", "text": "（今後ともご贔屓にお願いしますね？）", "face": "u538"}, {"name": "トトノ", "text": "（にこにこ、ほくほく）", "face": "u316"}, {"name": "シビラ", "text": "天眼ノ国の全てとはいかないけれど、\nそれだけの貴族を味方につけたなら、\n実効力のある講和会議を推し進められるわ。", "face": "u39"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ユリクセス", "text": "さて。停戦となれば、交渉団と連絡役が要る。\n王国とラージヴィール領を、行き来できる者が。", "face": "u2193a1"}, {"name": "ニハラ", "text": "…………。", "face": "u2888a1"}, {"name": "アナーニャ", "text": "ふふ。適任がひとり、思い当たりますね？", "face": "u2873a1"}, {"name": "ニハラ", "text": "えっと、なぜ私を見て……。", "face": "u2888a1"}, {"name": "ラージヴィール", "text": "貴族院議員の娘だぞ。\n交渉団に同行する連絡役としては最上だろう。", "face": "ldaa9ce1c359e"}, {"name": "ニハラ", "text": "――少し、考えさせてください。\n閣下への恩返しになるのなら……とは思うのですが。", "face": "u2888a1"}, {"name": "プリヤンカ", "text": "いいじゃん！\n異世界が心配ならあたしもついていこっか？", "face": "u2808a1"}, {"name": "ニハラ", "text": "いえ、心配というか、何というのか……。", "face": "u2888a1"}, {"name": "ラージヴィール", "text": "可愛い娘には旅をさせろ、だ。\nニハラ、貴様は世界一可愛い娘だからな！", "face": "ldaa9ce1c359e"}, {"name": "ニハラ", "text": "ああもう、交渉の余地はどこに……。", "face": "u2888a1"}]}], "active": true}