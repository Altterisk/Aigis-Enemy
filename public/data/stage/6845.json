d": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 6, "master_id": 626, "global_id": 625}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 3, "tags": ["植物"], "hp": 8000, "attack": 300, "base_hp": 8000, "base_attack": 300, "damage_type": "physical", "armor_defense": 130, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 5, "attack_interval": 81, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108704, "special_effect_id": 123, "change_to": 9, "missile_id": 179, "missile": {"speed": 9.0}, "master_id": 31905, "global_id": 5524, "ranged": true, "to_global_id": 5525, "route_behaviour": {"reroutes": ["Route=61"]}, "spawn_sec": 164}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["植物"], "hp": 8000, "attack": 300, "base_hp": 8000, "base_attack": 300, "damage_type": "physical", "armor_defense": 130, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 5, "attack_interval": 81, "move_speed": 200.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108704, "special_effect_id": 414, "change_to": 10, "change_condition": 2, "missile_id": 179, "missile": {"speed": 9.0}, "master_id": 31906, "global_id": 5525, "ranged": true, "to_condition": 2}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "スイカの魔物", "text": "――スイ。", "face": "lad5cc5b83212"}, {"name": "スイカの魔物", "text": "夏といえば海、海といえばスイカ。\nきっと王国の連中はそう思っているスイ。", "face": "lad5cc5b83212"}, {"name": "スイカの魔物", "text": "だからこそ、この森の中で！\n地道に戦力拡充をはかるスイ～♪\nまずは大きなスイカの魔物を召喚してやるスイ～♪", "face": "lad5cc5b83212"}, {"name": "アンナ", "text": "――王子、魔界アリ、及び異界の虫の大群が\n向かっていると報告があったのはこちらの方です。", "face": "l3d5e7de36b33"}, {"name": "エイル", "text": "森に虫はつきものですけど、\nいったい何に引き寄せられているのでしょうか。", "face": "u804"}, {"name": "クレア", "text": "虫が寄ってくるっていうと、やっぱり甘いものとか？\n……って、あれ？　ちょっと止まってください。\nあの木陰に、何か隠れているような……？", "face": "u30"}, {"name": "エイル", "text": "あれは……ス、スイカの魔物ですか？\n海じゃなくて森にあらわれるなんて……。", "face": "u804"}, {"name": "スイカの魔物", "text": "……スイ？　何か物音が聞こえるスイ。\n――アレ？　虫がこっちに向かってるスイ？\nな、なんでこっちにくるスイ～！？", "face": "lad5cc5b83212"}, {"name": "エイル", "text": "なるほど……スイカの甘い香りに、\n虫達が引き寄せられているということですね。", "face": "u804"}, {"name": "スイカの魔物", "text": "むむむっ、王子達まで来ているスイ！？\nこうなったら召喚を急ぐしかないスイ～！！", "face": "lad5cc5b83212"}, {"name": "エイル", "text": "……王子、どうやらあのスイカの魔物は、\n何か別の魔物を召喚しようとしているようです。\n先にあいつを倒して召喚を阻止しちゃいましょう！", "face": "u804"}, {"name": "スイカの魔物", "text": "ス、スイ～！？\nなんでバレてるスイ～！？", "face": "lad5cc5b83212"}, {"name": "クレア", "text": "王子、虫の群れも迫っています！\n慎重な采配をお願いしまーす！", "face": "u30"}]}, {"trigger": "end", "lines": [{"name": "スイカの魔物", "text": "ス、スイ……。\nもうダメ……スイ……。", "face": "lad5cc5b83212"}, {"name": "アンナ", "text": "スイカの魔物も虫の群れも、\nどうにか退治できましたね。"}, {"name": "エイル", "text": "まさかスイカの魔物が、\n森の奥で召喚儀式をしようとするなんて。\nちょっと予想外過ぎましたね……。", "face": "u804"}, {"name": "クレア", "text": "……スイカを森の奥においたら、\n虫が寄ってくるのも分かりそうなものですけどね。", "face": "u30"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "ともかく、これで森の安全は確保できましたね。\nスイカの魔物と虫の討伐、お疲れさまでした！"}]}, {"trigger": "route", "lines": [{"name": "スイカの魔物", "text": "最終的にはビフロンス様の復活のため！\nされど息切れを防止するためにもう一声！\nまずはスイカの魔物の戦力拡充スイ～！！", "face": "lad5cc5b83212"}, {"name": "スイカの魔物", "text": "大きなスイカの魔物！　召喚ッ！！", "face": "lad5cc5b83212"}, {"name": "エイル", "text": "王子、スイカの魔物の\n召喚儀式が成功してしまいましたぁー！！\n大きなスイカの魔物に注意してくださいね！！", "face": "u804"}]}, {"trigger": "route", "lines": [{"name": "スイカの魔物", "text": "ス、スイ……もう、力が出ないスイ……。", "face": "lad5cc5b83212"}, {"name": "ゴブリン", "text": "ギャギャ？　ココ、ドコ？　", "face": "lca372f764f5d"}, {"name": "クレア", "text": "王子、どうやらスイカの魔物の召喚は\n失敗してゴブリンを呼び出してしまったみたいです！\nささっと倒しちゃいましょう！", "face": "u30"}]}], "active": true}