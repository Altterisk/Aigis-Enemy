{"quest_id": 6845, "name": "スイカの甘い香り", "description": "虫の討伐に向かっていた一行は、仲間の\n召喚儀式を行うスイカの魔物を発見する。\n集まる虫を撃退しつつ、儀式を阻止せよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ24(2019)", "event_category": "Reproduce", "mission_id": 300243, "map_no": 5823, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 150, "base_hp": 4000, "base_attack": 150, "damage_type": "physical", "armor_defense": 60, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 5, "attack_interval": 81, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108704, "special_effect_id": 123, "missile_id": 179, "missile": {"speed": 9.0}, "master_id": 457, "global_id": 456, "ranged": true, "route_behaviour": {"sets_flags": [[0, 1, 210], [0, 0, 210]]}}, {"enemy_id": 2, "source": "local", "count": 18, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 2, "master_id": 986, "global_id": 985, "to_global_id": 987}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 1, "master_id": 988, "global_id": 987}, {"enemy_id": 4, "source": "local", "count": 19, "form_count": 1, "hp": 3000, "attack": 220, "base_hp": 3000