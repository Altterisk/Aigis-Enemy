id": 219, "global_id": 218, "spawn_sec": 42}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 112}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 2000, "base_hp": 20000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 321, "global_id": 320, "spawn_sec": 155}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 175}, {"enemy_id": 12, "source": "local", "count": 6, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 176}], "dialogue": [{"trigger": "start", "lines": [{"name": "ギガース", "text": "ついに……ついに見つけたぞ。\nこれで三つの『卵』が我らの手に……！", "face": "lfe26e9cdce65"}, {"name": "ギガース", "text": "あとはヘカトンケイル様を復活させられれば、\n我らの領土を人間どもから取り戻す上での障害は\n皆無に等しくなるわけだ……フフ、ふはははっ！", "face": "lfe26e9cdce65"}, {"name": "アンナ", "text": "――ッ！\nあのギガースが掲げているのは、まさか――！", "face": "ld0c6fac768c7"}, {"name": "ルミアン", "text": "そ、そんな……間に合わなかったなんて。", "face": "u634"}, {"name": "ギガース", "text": "……貴様らか、\n各地で我らの邪魔をしていた人間どもというのは。", "face": "lfe26e9cdce65"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ギガース", "text": "……そうか。\nここまで来たということは、\n我らの同胞の屍を踏み越えてきたのだろう。", "face": "lfe26e9cdce65"}, {"name": "ギガース", "text": "然らば尚更、貴様らに『卵』を渡すわけにはゆかぬ。\n同胞を殺め、あまつさえ我ら巨人族千年の悲願の\n実現を阻まんとするその暴挙、死を以て詫びるがいい！", "face": "lfe26e9cdce65"}, {"name": "ギガース", "text": "――総員、進撃！　今こそ千年の恨みを晴らす時ぞ！\nこの白き大地を人間どもの血で赤く染めてやるのだ！！", "face": "lfe26e9cdce65"}]}, {"trigger": "end", "lines": [{"name": "ユリアン", "text": "はぁッ、はぁッ……やっと片付いたか。\n……よし、今のうちに神獣の卵を奪い返すぞ！", "face": "u7"}, {"name": "ギガース", "text": "ぐふッ……ば、馬鹿め……ッ。\n貴様らが我らとの戦いに心血を注いでいる間に、\n『卵』は既に、別の者が運び去ったわ……。", "face": "lfe26e9cdce65"}, {"name": "ユリアン", "text": "なんだって！？\n……クソッ、謀られたか！", "face": "u7"}, {"name": "ギガース", "text": "フフ……せいぜい震えて待つがいい……。\n復活したヘカトンケイル様と……我ら巨人族が……、\n壁の中の人間どもに……千年の雪辱を果たす日を……。", "face": "lfe26e9cdce65"}, {"name": "ルミアン", "text": "そ、そんなぁ……。\n巨人を相手にするだけでも大変なのに、\nヘカトンケイルまで一緒に攻めてきたら……。", "face": "u634"}, {"name": "ケイティ", "text": "ですが、神獣とは神によってつくり出された存在の筈。\n仮に卵から復活したとして、ヘカトンケイルは\n巨人の思惑通りに動くものでしょうか。", "face": "u114"}, {"name": "ニエル", "text": "……残念だけど、その可能性は高いと思う。\n確かにヘカトンケイルは神によってつくられた神獣の\n一種だけど、その素材には巨人の血肉が使われている。", "face": "u206"}, {"name": "ニエル", "text": "その結びつきのためか、かつての巨人との戦いで\n投入された際も、ヘカトンケイルは\n天界側を裏切って巨人の味方についたんだ。", "face": "u206"}, {"name": "ニエル", "text": "「裏切りの神獣」――そう呼ばれる所以だ。\nだから、復活を果たしたヤツらが巨人たちに味方して\n人間を滅ぼすために戦ったとしても不思議じゃないよ。", "face": "u206"}, {"name": "ルミアン", "text": "ぼ……ボクがもっと早く皆さんを案内できていれば……。\nボクが、皆さんと一緒に戦えていれば……っ。", "face": "u634"}, {"name": "キャリー", "text": "――違うよ、ルミアンくん！\nたとえ戦場には出ていなくても、\nルミアンくんは一緒に戦ってくれたじゃない！", "face": "u26"}, {"name": "ルミアン", "text": "……え？\nで、でも……ボクなんてなんのお役にも……。", "face": "u634"}, {"name": "ケイティ", "text": "貴方が勇気を出して案内して下さったおかげで、\n敵の目論見や戦力に関する情報を事前に掴めたのです。\n此度の最大の功労者は、他ならぬ貴方ですよ。", "face": "u114"}, {"name": "ユリアン", "text": "ああ。神獣の卵が巨人の手に渡ったのは痛手だが、\nそうと知っていれば対策の立てようはあるはずだ。\nルミアン、お前のおかげで多くの人が救われるんだぜ？", "face": "u7"}, {"name": "ルミアン", "text": "み、皆さん……っ。\nボク、皆さんが戦う姿を見て\n自分も戦わなきゃって思ったんです……。", "face": "u634"}, {"name": "アンナ", "text": "ええ、とてもご立派でしたよ。\n……それでは皆さん、ひとまず帰還して\n今回の戦果を都市国家の方々に報告しましょう。"}]}], "active": true}