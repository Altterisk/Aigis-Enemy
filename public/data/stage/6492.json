{"quest_id": 6492, "name": "巨神の卵", "description": "道阻む巨人の群れを打ち倒し、\n雪原を進む王子達だが……。\n＜特定のタイミングで吹雪が発生＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "見習い鍛冶師と巨人の神威", "event_category": "History", "mission_id": 920110, "map_no": 5353, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "hp": 70000, "attack": 1500, "base_hp": 70000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "attack_range": 100, "attack_speed": 150, "attack_wait": 90, "attack_interval": 301, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115008, "race_id": 10, "special_effect_id": 232, "missile_id": 274, "master_id": 31071, "global_id": 4690, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 120000, "attack": 1450, "base_hp": 120000, "base_attack": 1450, "damage_type": "physical", "armor_defense": 10, "attack_range": 300, "attack_speed": 250, "attack_wait": 70, "attack_interval": 241, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110224, "race_id": 10, "change_to": 2, "change_condition": 1, "missile_id": 200, "missile": {"speed": 8.0}, "master_id": 30328, "global_id": 3947, "ranged": true, "variants": [{"hp": 120000, "attack": 5000, "base_hp": 120000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 10, "attack_speed": 250, "attack_wait": 90, "attack_interval": 541, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110240, "race_id": 10, "master_id": 30329, "global_id": 3948}], "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 120000, "attack": 3500, "base_hp": 120000, "base_attack": 3500, "damage_type": "physical", "arm