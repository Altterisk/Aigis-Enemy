ase_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 6, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "hp": 850, "attack": 128, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 41}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "hp": 1020, "attack": 238, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 57}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 4250, "attack": 340, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 58}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 4250, "attack": 510, "base_hp": 5000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097808, "master_id": 43, "global_id": 42, "spawn_sec": 65}, {"enemy_id": 13, "source": "local", "count": 9, "form_count": 1, "hp": 544, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 71}, {"enemy_id": 14, "source": "local", "count": 3, "level": 90, "form_count": 1, "hp": 850, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 85}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここ最近、古戦場あたりに魔物の目撃情報が\n多いと聞きましたが……。", "face": "l39d7f2a90b0e"}, {"name": "鬼刃衆", "text": "おい！　そっちにいったぞ！！", "face": "l64e293a0891a"}, {"name": "？？？", "text": "流石に、これ以上は無理か……。", "face": "u1160"}, {"name": "アンナ", "text": "王子、あの方は……！", "face": "l39d7f2a90b0e"}, {"name": "鬼刃衆", "text": "ようやく追い詰めたぞアザミ。\nこれが最後のチャンスだ。", "face": "l64e293a0891a"}, {"name": "鬼刃衆", "text": "アザミ、我々のもとにきてもらおう。\nなに、悪いようにはしないさ……。", "face": "l64e293a0891a"}, {"name": "鬼刃衆", "text": "お前のその力を俺たちが\n使ってやろうと言っているんだ。", "face": "l64e293a0891a"}, {"name": "アザミ", "text": "何度言われても私の答えは変わりません。\nお断りさせていただきます。", "face": "u1160"}, {"name": "鬼刃衆", "text": "……そうか。それは残念だ。\n我々の鬼刃衆の仲間にならぬのなら邪魔なだけ。\nここで消えてもらおう。", "face": "l64e293a0891a"}, {"name": "アンナ", "text": "鬼刃衆……聞き覚えがあります。\nたしか高い戦闘力を持ち、\n回避能力に優れているとか。", "face": "l39d7f2a90b0e"}, {"name": "アンナ", "text": "真っ向から仕掛けては、攻撃を回避されて\nしまうかもしれません。", "face": "l39d7f2a90b0e"}, {"name": "アンナ", "text": "魔法ならば回避されることもないはずですので\n優位に立てるでしょう。", "face": "l39d7f2a90b0e"}, {"name": "アンナ", "text": "では王子、アザミさんを助けましょう！", "face": "l39d7f2a90b0e"}]}, {"trigger": "end", "lines": [{"name": "鬼刃衆", "text": "やはりその力、殺してしまうには惜しいな。\n邪魔も入ったことだ。ここは一旦退くとしよう。\nくくく……。", "face": "l64e293a0891a"}, {"name": "アザミ", "text": "……いきましたか。", "face": "u1160"}, {"name": "アザミ", "text": "助けていただいて、ありがとうございます。\n王子のおかげで、\nなんとか彼らを退けることができました。", "face": "u1160"}, {"name": "アンナ", "text": "たしか、鬼刃衆と名乗っていましたね。", "face": "l39d7f2a90b0e"}, {"name": "アザミ", "text": "はい。彼らは鬼刃衆。\n戦闘に特化した忍の集団です。", "face": "u1160"}, {"name": "アザミ", "text": "……王子と出会って、全てが終わったあと\n私は抜け忍となりました。", "face": "u1160"}, {"name": "アザミ", "text": "人を傷つけることしかできなかった私が\n変わることが出来たのも、王子たちのおかげです。", "face": "u1160"}, {"name": "アザミ", "text": "あの時から無益な争いをしないと\n自分のなかで誓いを立て、\n生きていこうと決めたんです。", "face": "u1160"}, {"name": "アザミ", "text": "しかし、彼ら鬼刃衆は執拗に\n私を引き込もうと付け狙ってきます。", "face": "u1160"}, {"name": "アザミ", "text": "私は彼らには屈しません。\n自分が行ってきたことを償うためにも\nここで旅を終えるわけには参りませんから。", "face": "u1160"}, {"name": "アンナ", "text": "そうだったんですね……。\n落ち着いたらぜひ王国に遊びに来てくださいね。", "face": "l39d7f2a90b0e"}, {"name": "アザミ", "text": "ありがとうございます。必ず……。", "face": "u1160"}]}], "active": true}