{"quest_id": 1703, "name": "ダークエルフの女王", "description": "女王との謁見のため、ダークエルフの\n居住区へ赴いた王子たちだったが……。\n＜魔界：味方の攻撃力と防御力が半減＞\n＜時間経過によるコスト回復量が低下＞", "modifier_notes": ["魔界：味方の攻撃力と防御力が半減", "時間経過によるコスト回復量が低下"], "event": "ストーリーミッション7", "event_category": "Story", "mission_id": 100007, "map_no": 1110, "level": 100, "multiplier": 1.0, "charisma": 43, "capacity": 10, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "attack_range": 260, "attack_speed": 30, "attack_wait": 200, "attack_interval": 473, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107952, "missile_id": 6, "master_id": 959, "global_id": 958, "ranged": true, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 19, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "ma