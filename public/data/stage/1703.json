 3}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 142}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "special_effect_id": 222, "missile_id": 6, "master_id": 137, "global_id": 136, "ranged": true, "spawn_sec": 183}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_range": 200, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "special_effect_id": 222, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 136, "global_id": 135, "ranged": true, "spawn_sec": 186}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 1, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 223, "master_id": 138, "global_id": 137, "spawn_sec": 202}, {"enemy_id": 12, "source": "local", "count": 5, "form_count": 1, "hp": 11000, "attack": 600, "base_hp": 11000, "base_attack": 600, "damage_type": "magical", "armor_defense": 350, "magic_defense": 50, "attack_range": 300, "attack_speed": 70, "attack_wait": 15, "attack_interval": 236, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103248, "special_effect_id": 222, "change_to": 12, "change_condition": 1, "missile_id": 6, "master_id": 968, "global_id": 967, "ranged": true, "variants": [{"hp": 11000, "attack": 800, "base_hp": 11000, "base_attack": 800, "damage_type": "physical", "armor_defense": 350, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "special_effect_id": 222, "master_id": 967, "global_id": 966}], "spawn_sec": 202}], "dialogue": [{"trigger": "start", "lines": [{"name": "ネヴィン", "text": "ここが俺達ダークエルフが住んでいる区域だ。\nちょっと待っててくれ。女王に「謁見」の\n願出をしなくてはいけないからな。", "face": "u407"}, {"name": "モーティマ", "text": "「謁見」か……緊張すんなぁ。女王様なんて人種は\n滅多に近くで見られねぇからな……。\nよしっ、俺の武勇伝で夢中にさせてやるぜ！", "face": "u14"}, {"name": "ネヴィン", "text": "……ま、まぁ「謁見」って言っても、ここは魔界だ。\nアンタらの思ってるものとは違うかもしれないがな。\nとりあえずは、魔界流ってことで覚悟しておいてくれな。", "face": "u407"}, {"name": "ソーマ", "text": "……魔界流。\n嫌な予感がします……。", "face": "u23"}, {"name": "ダークエルフ", "text": "おい、ネヴィン！　誰だそいつらは？\n地上界の人間のように見えるが。\n――ハッ！？　もしや、そいつらが例の計画の……？", "face": "l3363ae2de404"}, {"name": "ネヴィン", "text": "ま、そんなとこだ。\nかなり見込みはあると思うぜ。\nさっそく女王ドロテア様に「謁見」をお願いしたい。", "face": "u407"}, {"name": "ダークエルフ", "text": "分かった、すぐにドロテア様に申し伝えよう。", "face": "l3363ae2de404"}]}, {"trigger": "start", "lines": [{"name": "ドロテア", "text": "よくぞここまで辿り着いた、地上界の者たちよ。\n私がダークエルフの女王ドロテアである。", "face": "u408"}, {"name": "ドロテア", "text": "ふむ……ネヴィンの推挙する程ならばと\n期待していたが、一見して、思ったほどの\n覇気は感じられぬな……。\n", "face": "u408"}, {"name": "ドロテア", "text": "本当に、この者たちで間違いないのだろうな？", "face": "u408"}, {"name": "ネヴィン", "text": "俺の目には、計画遂行に足る力の持ち主と映りました。\n……あとはドロテア様がどう判断なされるかだけかと。", "face": "u407"}, {"name": "ドロテア", "text": "……よかろう。\nならばこの女王ドロテア、自らが相手をしてやる。", "face": "u408"}, {"name": "ドロテア", "text": "さあ武器を取るが良い、地上界の者達よ。\nこの謁見を経ても尚、立っていることが出来るのならば\n貴様らが望むことを教えてやろうではないか。", "face": "u408"}, {"name": "ソーマ", "text": "――ええッ！？\n謁見って、話合いじゃないんですか！？\n魔界では何を得るにも戦いが必要なのですね……。", "face": "u23"}]}, {"trigger": "end", "lines": [{"name": "ドロテア", "text": "……どうやらネヴィンの見立ては正しかったようだな。\n合格だ、王子よ。貴様の力は\nこのドロテアの心を満たすに足るものだった。", "face": "u408"}, {"name": "ドロテア", "text": "人の身でありながら、女神アイギスの加護だけでなく、\nその神器すらも使いこなすとは……。\n大したものだな。", "face": "u408"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "ドロテア", "text": "余計な話は無用……とでも言いたげだな。\n分かっている。今度は我々が其方達の信服を得る番。\nでは、魔神レヴィアタンについて教えてやろう。", "face": "u408"}, {"name": "ドロテア", "text": "実は、ヤツの復活までは、あまり猶予がない。\nもしそうなれば、間違いなく\nレヴィアタンは地上界すべてを食い尽くすだろう。", "face": "u408"}, {"name": "アンナ", "text": "地上界を、食い尽くす……？\nそ、そんな事が起こり得るのでしょうか？", "face": "lc360781a29d4"}, {"name": "ドロテア", "text": "魔神レヴィアタンとは全てを無に帰す存在だ。\nヤツの復活は地上界だけでなく\n魔界の消滅をも意味する。\n", "face": "u408"}, {"name": "ドロテア", "text": "……そうなれば、後に残るのは虚無のみとなる。", "face": "u408"}, {"name": "モーティマ", "text": "ま、魔界まで無くなっちまうだってッ！？\nおいおい、それじゃあ本末転倒じゃねえか！\n復活させようとしてるデーモンは何を考えてんだよ！？", "face": "u14"}, {"name": "ドロテア", "text": "定命の者は滅びるが、デーモンだけは別。\n私達が目にしているデーモンの肉体は仮の器であり、\nヤツらは精神を宿しているだけなのだ。", "face": "u408"}, {"name": "ゼンメル", "text": "つまり、全てが無に帰したとしても\nデーモンは精神だけを残すことができる……と？", "face": "u284"}, {"name": "ドロテア", "text": "そう。そして、破壊により新生する\n次の世界においては、デーモンのみが存在する\n真の魔界が出来上がるというわけだ。", "face": "u408"}, {"name": "ドロテア", "text": "……それこそがデーモンの本懐。", "face": "u408"}, {"name": "アンナ", "text": "…………そんな。\nデーモンのみが存在する世界だなんて……。", "face": "lc360781a29d4"}, {"name": "ドロテア", "text": "もちろん、我等ダークエルフもその様なものなど\n望むわけがない……。だからこそ\n魔神レヴィアタンの復活は阻止したいのだ。", "face": "u408"}, {"name": "ドロテア", "text": "しかし、魔界の住人である我等は表立って\n行動する事が出来ぬ。デーモンに露呈してしまえば、\n種族そのものを滅ぼされるのは必至。", "face": "u408"}, {"name": "ドロテア", "text": "だからこそ、地上界の者達と手を結びたいのだ。\nどうだろう、王子？　魔界のダークエルフの助力は、\n其方達にとっても利は多いと思うが。", "face": "u408"}, {"name": "ケイティ", "text": "……確かに、貴方の仰る通り、魔界の者と\n手を組めば私達にとってもメリットがあります。", "face": "u114"}, {"name": "ケイティ", "text": "それに、ここ魔界で私達には\n他に選択肢もないでしょう。", "face": "u114"}, {"name": "ドロテア", "text": "賢明な判断に感謝する、地上界の者達よ。", "face": "u408"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}, {"kind": "term", "influence": 19, "params": [250]}], "enemies": [{"enemy_id": 1, "hp": 30000, "attack": 1500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "pattern_id": 2107952}, {"enemy_id": 2, "hp": 1200, "attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "pattern_id": 2098976}, {"enemy_id": 3, "hp": 2000, "attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "pattern_id": 2098992}, {"enemy_id": 4, "hp": 30000, "attack": 1100, "damage_type": "physical", "pattern_id": 2103568}, {"enemy_id": 5, "hp": 70000, "attack": 2500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2108064}, {"enemy_id": 6, "hp": 12000, "attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "pattern_id": 2099024}, {"enemy_id": 6, "form_index": 1, "hp": 12000, "attack": 1100, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "pattern_id": 2099040}, {"enemy_id": 8, "hp": 6000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "pattern_id": 2099008}, {"enemy_id": 9, "hp": 3000, "attack": 400, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "pattern_id": 2098992}, {"enemy_id": 10, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "pattern_id": 2098976}, {"enemy_id": 11, "hp": 8000, "attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "pattern_id": 2099008}, {"enemy_id": 12, "hp": 11000, "attack": 600, "damage_type": "magical", "armor_defense": 350, "magic_defense": 50, "pattern_id": 2103248}]}, "active": true}