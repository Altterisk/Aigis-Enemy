_id": 2101136, "race_id": 7, "change_to": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 658, "global_id": 657, "ranged": true, "to_global_id": 348, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 127}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 349, "global_id": 348, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 137}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 138}], "popups": ["クラールフがいる間は\n悪天候『豪雨』が発生します。\n\n 　　悪天候：豪雨\n\n・敵味方の『射程』減少\n・一部の味方は影響を受けない\n　　　　　　(1/2)", "クラールフから攻撃を受けると、\n攻撃後の待ち時間が増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "クラールフ", "text": "――神なき大地、か。", "face": "l816b82358187"}, {"name": "マーマン", "text": "……どうかなさいましたか、我らが深海の王よ。", "face": "lbd3a58bb0e9c"}, {"name": "クラールフ", "text": "いや、ただ少しの感傷を抱いただけだ。\n卑小なる溺れる者達とて、\n滅びを迎えるとなれば憐れみたくもなる。", "face": "l816b82358187"}, {"name": "クラールフ", "text": "数多の海を巡った意味もなかった……。\n人の子の力ではあのガリウスめには敵わぬだろうが、\n神々の力があれば、物質界も存続できたかもしれぬ。", "face": "l816b82358187"}, {"name": "クラールフ", "text": "ゆえにせめて、我に並ぶ力を持つ神が目覚めておればと、\n世界を巡ってはみたが……。\nまさかこれ程までに、力が失われているとは……。", "face": "l816b82358187"}, {"name": "マーマン", "text": "クラールフ様……。\nやはり、魔王ガリウスについたことを、\n後悔されているのでは……？", "face": "lbd3a58bb0e9c"}, {"name": "クラールフ", "text": "さて、そういうこともあるだろう。\nだが、そうでないこともある……。", "face": "l816b82358187"}, {"name": "クラールフ", "text": "ガリウスと結んだ契約は、滅びの道より\n深海を見逃すというもの……。\nこれ自体は屈辱的なものなれど――", "face": "l816b82358187"}, {"name": "クラールフ", "text": "――愛しき溺れる者どもには、\nせめて我が手で滅びをもたらしてやることが出来る。\nそれだけが救いというものか……。", "face": "l816b82358187"}, {"name": "シャディア", "text": "――交渉は、決裂ということですか。\n偉大なる深海の王、クラールフ殿。", "face": "u713"}, {"name": "クラールフ", "text": "おお、来たかシャディア。\nそして人類を率いる当代の英雄、王子よ。", "face": "l816b82358187"}, {"name": "クラールフ", "text": "我は寛大だ。お前達が我らに与するならば、\nガリウスめに口利きをしてやっても良い。\n世界が終わった後、再び生を紡ぐこともできよう。", "face": "l816b82358187"}, {"name": "王子", "text": "……如何なる事情があるのかは知らない。\nだが、物質界を終わらせるわけにはいかない。", "face": "u1"}, {"name": "王子", "text": "この地に生きる人々を守ること、\nそれが俺の成すべき使命だ。", "face": "u1"}, {"name": "クラールフ", "text": "……神の力が失われたこの大地が、\nそれほどまでに愛おしいか。\n愚かだな、やはり、地上の生命というものは。", "face": "l816b82358187"}, {"name": "クラールフ", "text": "だが、故にかつては味方をしたものだった。\nせめて此度の戦いでは、\n苦しまぬように逝かせてやるとしよう……。", "face": "l816b82358187"}, {"name": "シャディア", "text": "……残念です。クラールフ殿。", "face": "u713"}, {"name": "クラールフ", "text": "嗚呼、本当に残念だ。\n死後の世では、お前の兄に\n我が愚かなる所業を伝えてくれ。", "face": "l816b82358187"}, {"name": "シャディア", "text": "王子、クラールフ殿は天候を操り、\n遠くを見通せなくなる豪雨を呼び起こす。", "face": "u713"}, {"name": "シャディア", "text": "そして放たれし水の一撃を受ければ、\n身動きが取れなくなってしまうはずだ。", "face": "u713"}, {"name": "シャディア", "text": "向こうについている魔王軍の手勢も含め、\n十分に注意して指揮をとってくれ。", "face": "u713"}]}, {"trigger": "end", "lines": [{"name": "クラールフ", "text": "……これほどの力、本当に失うには惜しいものよ。\nさぁ、退くぞ我が眷属達よ。\n我らの刃を研ぎ、物質界の蹂躙に備えるのだ……。", "face": "l816b82358187"}, {"name": "アンナ", "text": "……クラールフ達が、撤退していきます。"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "シャディア", "text": "かつての千年戦争を知る彼が、\nガリウスの側についた、か。", "face": "u713"}, {"name": "シャディア", "text": "だが、かつての戦いとは異なる点も多い。\nその最たるものが、英雄たるお前だ、王子。", "face": "u713"}, {"name": "シャディア", "text": "お前のもとに集った数多の仲間達。\nそしてお前自身の力があれば、\n此度の戦い、無事に勝利出来ると、私は信じているよ。", "face": "u713"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "story_talk": true, "active": true}