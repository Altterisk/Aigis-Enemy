{"quest_id": 6888, "name": "深海の総意", "description": "大海のため、魔王に与することを決断した\n深海の王クラールフ率いる部隊を退けよ！\n＜クラールフがいる間豪雨が発生＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["クラールフがいる間豪雨が発生"], "event": "ゴールドラッシュ25(2019)", "event_category": "Reproduce", "mission_id": 300251, "map_no": 5831, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 20, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 6}, {"enemy_id": 3, "source": "local", "count": 34, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 8}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 35000, "attack": 300, "base_hp": 35000, "base_attack": 300, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 280, "attack_speed": 1, "attack_wait": 50, "attack_interval": 1