tion": 2, "master_id": 30701, "global_id": 4320, "to_condition": 2, "to_global_id": 4321, "spawn_sec": 201}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 50000, "attack": 2000, "base_hp": 50000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_speed": 30, "attack_wait": 40, "attack_interval": 161, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2107344, "race_id": 3, "special_effect_id": 105, "master_id": 30702, "global_id": 4321, "from_condition": 2}, {"enemy_id": 21, "source": "local", "count": 6, "form_count": 1, "tags": ["スライム"], "hp": 30000, "attack": 800, "base_hp": 30000, "base_attack": 800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 60, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112608, "missile_id": 11, "master_id": 30698, "global_id": 4317, "ranged": true, "spawn_sec": 227}, {"enemy_id": 22, "source": "local", "count": 4, "form_count": 1, "hp": 12000, "attack": 1300, "base_hp": 12000, "base_attack": 1300, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112560, "race_id": 18, "master_id": 30695, "global_id": 4314, "spawn_sec": 284}], "popups": ["ベルゼビュートの配下(幼虫)は、\n一定時間の経過、もしくは撃破すると\nベルゼビュートの配下に変身します。\n\nベルゼビュートの配下の\n一定範囲内のユニットは攻撃力低下と\n継続ダメージを受けます。", "ベルゼビュートの\n一定範囲内のユニットは攻撃力低下と\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "……ふぅ。\nかなりの距離を歩いた気がしますが、\n周囲の景観に大きな変化はありませんね。", "face": "lab64724fd72f"}, {"name": "ゼンメル", "text": "まだ食道を抜けてはおらんようじゃな。\nじゃが、じきに胃の方に出ると思うぞ？", "face": "u284"}, {"name": "モーティマ", "text": "っつーか、さっきも言ったけどよ。\n本当にこのデカブツの心臓を止めるなんてできんのか？", "face": "u14"}, {"name": "ケイティ", "text": "確かに、これだけ相手が大きいと\n少し不安になりますね……。\n情報提供者の方々を疑うわけではないですが。", "face": "u114"}, {"name": "アンナ", "text": "だ……大丈夫ですよ。\n私たちにはアイギス様のご加護と、\n神器を持った王子がついているのですから――"}, {"name": "兵士", "text": "――報告！　前方空中に敵影を確認！\nこちらへ接近中――って、うわぁっ！？　は、蝿です！", "face": "l7e0e78259a84"}, {"name": "ゼンメル", "text": "蝿の魔物――魔神ベルゼビュートの配下か！", "face": "u284"}, {"name": "ベルゼビュートの配下", "text": "――ブブッ……目障りな奴らめ。\nせっかくベルゼビュート様が傷を\nお癒やしになろうという時に……。", "face": "lce4dbb20c921"}, {"name": "ロイ", "text": "なんと！？\n魔神ベルゼビュートがレヴィアタンの体内で\n復活しようとしているというのか？", "face": "u11"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……活性化したレヴィアタンから\n生命力の一部を拝借し、再生を果たす……。\nベルゼビュート様の深遠なる智謀の為せる技だ……。", "face": "lce4dbb20c921"}, {"name": "ベルゼビュートの配下", "text": "もっとも……実際に拝借するのは\nレヴィアタン自身の力ではない……。\nヤツが糧としている……膨大なエネルギーの源だ。", "face": "lce4dbb20c921"}, {"name": "アンナ", "text": "エネルギーの源？\nレヴィアタンの復活には\nそれが使われているというのですか？", "face": "lab64724fd72f"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……余計なことを喋ってしまったか……。\n……まぁいい。元より貴様ら人間どもは\n皆殺しにするつもりだったのだからな……。", "face": "lce4dbb20c921"}, {"name": "ベルゼビュートの配下", "text": "ベルゼビュート様がお目覚めになる前に、\n我々の手で葬ってやる……ブブッ。", "face": "lce4dbb20c921"}]}, {"trigger": "battle", "at_sec": 200, "lines": [{"name": "ベルゼビュートの配下", "text": "――ブブッ！？　ベルゼビュート様！\nお待ち下さい、お目覚めにはまだ早すぎます……！", "face": "lce4dbb20c921"}, {"name": "ベルゼビュートの配下", "text": "くっ……皆の者、ベルゼビュート様が出撃されるぞ！\n総力を挙げて援護するのだ……ブブッ！", "face": "lce4dbb20c921"}]}, {"trigger": "end", "lines": [{"name": "ベルゼビュートの配下", "text": "ブブッ……ベルゼビュート様……。\nやはりまだ、完全な状態ではありませんでしたか……。\nですが、人間どもを疲弊させることはできました……。", "face": "lce4dbb20c921"}, {"name": "ベルゼビュートの配下", "text": "……総員、撤退！　ベルゼビュート様を護送せよ！\n急ぎレヴィアタンの心臓へ向かい、\nそこで真の再生への糧を得るのだ……！", "face": "lce4dbb20c921"}, {"name": "ベルゼビュートの配下", "text": "今はまだ……人間との決戦の機ではない……！\n最も優先すべきは、我々の悲願……。\nベルゼビュート様の……完全復活の実現だ……ブブッ。", "face": "lce4dbb20c921"}, {"name": "兵士", "text": "――敵部隊、撤退していきます！", "face": "l7e0e78259a84"}, {"name": "ケイティ", "text": "なんという逃げ足の速さ……。\nあと一息で魔神ベルゼビュートに\nトドメを刺せるところでしたのに。", "face": "u114"}, {"name": "ロイ", "text": "しかし……厄介なことになりましたな。\nベルゼビュートとその配下たちも、我々と同様、\nレヴィアタンの心臓へ向かっているようですぞ。", "face": "u11"}, {"name": "ゼンメル", "text": "……じゃが、奴らの言うとった\nエネルギーの源とやらがなんなのかは、気になるのう。", "face": "u284"}, {"name": "ケイティ", "text": "それもレヴィアタンの心臓にあるようですね。\nベルゼビュートの配下の話が正しければ、ですが。", "face": "u114"}, {"name": "アンナ", "text": "レヴィアタンが糧としている、エネルギーの源……。\nそれを取り除ければ、心臓を止めなくとも\nレヴィアタンの復活を阻止できるかもしれませんね。", "face": "lab64724fd72f"}, {"name": "リエーレ", "text": "ま、いずれにせよ\nヤツの心臓まで行く必要があることに\n変わりはねーけどな。", "face": "u490"}, {"name": "モーティマ", "text": "チッ……ったく、\n心臓までにはまだまだ魔物がいやがんだろ。\n楽な道のりにはなりそうにねぇな。", "face": "u14"}, {"name": "ケイティ", "text": "そうですね……魔物達の抵抗も、\nこの先一層激しさを増していくでしょう。", "face": "u114"}, {"name": "アンナ", "text": "はい、ですが私達は\n歩みを止める訳には参りません。\n準備を整え、心して向かいましょう、王子。", "face": "lab64724fd72f"}]}], "hard": {"level": 80, "multiplier": 0.8, "modifiers": [{"kind": "term", "influence": 16, "params": [50]}], "enemies": [{"enemy_id": 1, "hp": 9600, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2112512}, {"enemy_id": 1, "form_index": 1, "hp": 1, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2112528}, {"enemy_id": 1, "form_index": 2, "hp": 4800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "pattern_id": 2101840}, {"enemy_id": 3, "hp": 4800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "pattern_id": 2101840}, {"enemy_id": 4, "hp": 2400, "attack": 320, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "pattern_id": 2103920}, {"enemy_id": 4, "form_index": 1, "hp": 2400, "attack": 320, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "pattern_id": 2105232}, {"enemy_id": 6, "hp": 800, "attack": 240, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "pattern_id": 2103920}, {"enemy_id": 6, "form_index": 1, "hp": 800, "attack": 240, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "pattern_id": 2105232}, {"enemy_id": 8, "hp": 4800, "attack": 720, "damage_