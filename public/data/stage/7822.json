peed": 1000.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098912, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 118, "global_id": 117, "ranged": true, "spawn_sec": 71}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 74}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 15, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 74}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 14, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 17, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 74}, {"enemy_id": 18, "source": "local", "count": 10, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true, "spawn_sec": 99}, {"enemy_id": 19, "source": "local", "count": 8, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 100}, {"enemy_id": 20, "source": "local", "count": 6, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 133}], "dialogue": [{"trigger": "start", "lines": [{"name": "ミヤビ", "text": "いっちにー、さんしー。\nにーにー、さんしー。", "face": "u496"}, {"name": "リノ", "text": "すてっぷすてっぷ、クルッと回って、\nはーとまーくでにこっ♪　――ふぁぁぁ、できたぁ！", "face": "u350"}, {"name": "ミヤビ", "text": "リノさん、筋が良いとは思っていましたけど、\nもうダンスの基礎を覚えてきましたね。", "face": "u496"}, {"name": "リノ", "text": "師匠がいいからだよぉ。\nありがとね、ミヤビ！", "face": "u350"}, {"name": "ミヤビ", "text": "素材がいいからだと思うんですけどねぇ……。\nふふ、それにしても、\nアイドルになりたい、と聞いた時はびっくりしました。", "face": "u496"}, {"name": "リノ", "text": "うぅぅ、だってアンナさん、\nとっても素敵だったから……。", "face": "u350"}, {"name": "リノ", "text": "それに、こんな夢のこと話せるの、\nあの時あの場所にいたミヤビくらいで……。", "face": "u350"}, {"name": "ミヤビ", "text": "おやおや、この王国に、\n誰かの夢を笑うような人はいないと思いますよ？", "face": "u496"}, {"name": "ミヤビ", "text": "でも、アイドルのライブを見た後に、\nファンになるどころか、\n自分もアイドルになりたいだなんて。", "face": "u496"}, {"name": "リノ", "text": "……おかしい、かな？", "face": "u350"}, {"name": "ミヤビ", "text": "いえ、とっても素敵です♪\n伝説のアイドル、アンナさんを超える、\n超千年戦争級アイドルを目指しちゃいましょう！", "face": "u496"}, {"name": "リノ", "text": "うん！　じゃあさっきのステップの続きから――", "face": "u350"}, {"name": "村人", "text": "――た、助けてくれー！\n魔物が村に向かっているぞー！！", "face": "lbc816400d0f7"}, {"name": "リノ", "text": "えっ？　ま、魔物！？\n大変だ……ミヤビ、近くの砦に報告をお願い！", "face": "u350"}, {"name": "ミヤビ", "text": "分かりました！　リノさんは！？", "face": "u496"}, {"name": "リノ", "text": "リノは時間を稼ぐよ！\nリノだって、王国の召喚士なんだから！", "face": "u350"}]}, {"trigger": "battle", "at_sec": 68, "lines": [{"name": "リノ", "text": "はぁ、はぁ……。\nきりがないなぁ……！　オーガまで出てきたし……。", "face": "u350"}, {"name": "リノ", "text": "でも、リノが頑張らなくちゃ。\n村のみんなを、リノが守るんだ……！", "face": "u350"}, {"name": "ファルネ", "text": "――ッ！！　あれは！？\nサラマンダーの炎が、リノさんに集まって……！", "face": "u158"}, {"name": "ソラノ", "text": "召喚獣が、召喚士の想いに応えてるの？\nみんなを守りたいって気持ちに……。", "face": "u134"}, {"name": "ファルネ", "text": "えぇ、そしてリノさんの――\nアイドルになりたいという小さな願いにも。", "face": "u158"}]}, {"trigger": "battle", "at_sec": 71, "lines": [{"name": "リノ", "text": "これ……あ、アイドルの衣装！？\nサラマンダー、違うよ、今必要なのは戦う力で――", "face": "u1683a1"}, {"name": "ファルネ", "text": "リノさん！　炎の声を聞いて！\n今必要なのは、戦うだけの力ではないはずよ！", "face": "u158"}, {"name": "リノ", "text": "炎の……サラマンダーの声を……。\nサラマンダーは、リノに、戦うだけじゃなくて、\nみんなに力を与えろって……。", "face": "u1683a1"}, {"name": "リノ", "text": "うん、わかった！\nみんな、リノと一緒に戦おう！\n千年先も、一緒に輝いちゃえー！！", "face": "u1683a1"}]}, {"trigger": "end", "lines": [{"name": "ソラノ", "text": "……召喚獣が召喚士の願いを叶えたのね。\nまさか、こんな現象が起きるなんて。", "face": "u134"}, {"name": "ファルネ", "text": "……アイドル、だからかしら。", "face": "u158"}, {"name": "ソラノ", "text": "えっ、アイドルって、歌って踊る子のことよね？\nそんな特殊な存在なの？", "face": "u134"}, {"name": "ファルネ", "text": "いいえ、アイドルとは民を鼓舞する者に由来する者です。\n信仰対象のようでありながら、\n同時に皆を勇気づける、仲間のようでもある存在……。", "face": "u158"}, {"name": "ソラノ", "text": "……あぁ、たしかに、それはあってるかも。\n見てよリノのあの姿。", "face": "u134"}, {"name": "リノ", "text": "――みんな、大丈夫！？\n怪我してる人とかいない！？", "face": "u1683a1"}, {"name": "村長", "text": "怪我がないどころか、\n魔物に一撃カマしてやりましたぞ！\nふんっ、ふんっ、全盛期に戻ったようですじゃ！", "face": "l7f6ffd8de701"}, {"name": "村人", "text": "へへっ、リノちゃんの歌を聞いてたら、\nなぜか力が湧いてきたんだ！", "face": "lbc816400d0f7"}, {"name": "ミヤビ", "text": "……まだまだ技術は荒削りですが、\nリノさんには、アイドルに一番必要な要素が、\nもう大きく育っていたみたいですね。", "face": "u496"}, {"name": "ソラノ", "text": "一番必要な要素？", "face": "u134"}, {"name": "ミヤビ", "text": "えぇ、誰もが追いかけたくなる、\n太陽のような魂の輝きです。", "face": "u496"}, {"name": "ミヤビ", "text": "――はっ、そうです！\nこれはさっそく、企画を進めないと……！", "face": "u496"}, {"name": "リノ", "text": "よぉし、じゃあもう一曲歌っちゃうね！\nミヤビ、ミヤビも一緒に……って、あれ？\nどこいったのー！？　ミヤビー！　ねーっ！！", "face": "u1683a1"}]}], "active": true}