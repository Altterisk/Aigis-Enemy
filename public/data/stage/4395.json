r_id": 378, "global_id": 377, "ranged": true, "condition": 3}], "spawn_sec": 73}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 11000, "attack": 660, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 194, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103856, "master_id": 326, "global_id": 325, "spawn_sec": 83}, {"enemy_id": 10, "source": "local", "count": 9, "form_index": 0, "form_count": 1, "hp": 2750, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 10, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "phases": [{"hp": 2750, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "condition": 3}], "spawn_sec": 119}], "dialogue": [{"trigger": "start", "lines": [{"name": "ハイオーク", "text": "くくくっ……。森の中をさまよい歩いていたが、\nどうやら逆に幸運に当たったようだ。", "face": "lf7b208eb8d1f"}, {"name": "ユリナ", "text": "まさかこんなところでハイオークに出会うとはな。", "face": "u1111"}, {"name": "エルヴァ", "text": "団長のお墓参りに来たってだけなのに。\n団長の心がアタシたちに呼びかけたのかしら？", "face": "u1211"}, {"name": "ハイオーク", "text": "お前たち、強そうだな……。\n暇ならば俺の相手でもしてもらおうか？", "face": "lf7b208eb8d1f"}, {"name": "ハイオーク", "text": "ん？\nあそこに刺さっているあの剣、なにやら強そうだな。\n俺が勝ったあかつきには、それをいただくとしようか。", "face": "lf7b208eb8d1f"}, {"name": "エルヴァ", "text": "ちょっとちょっと。\n残念だけど、団長の剣をそう易々と\n渡す訳にはいかないわ。", "face": "u1211"}, {"name": "アンナ", "text": "王子、こちらです！\nあそこにハイオークが！", "face": "l1813779fe06c"}, {"name": "ユリナ", "text": "あなた方は……。", "face": "u1111"}, {"name": "アンナ", "text": "よろしければ一緒に戦ってくれませんか？\n相手はハイオーク。油断できません。", "face": "l1813779fe06c"}, {"name": "エルヴァ", "text": "わかったわ。\n団長の前で無様に負ける訳にはいかないしね。", "face": "u1211"}, {"name": "ユリナ", "text": "勝利を団長への手向けとしよう。", "face": "u1111"}, {"name": "エルヴァ", "text": "元暗黒騎士を舐めないことね。", "face": "u1211"}]}, {"trigger": "battle", "at_sec": 84, "lines": [{"name": "暗黒騎士デシウス", "text": "よ、ようやく開けた場所にでたぞ……。\nぜぇ……ぜぇ……。", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "ん？　あそこに見えるのは……まさか団長の証！\nついに見つけたぞ！！", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "ふはは！！　\nこれでいよいよ我輩も大いなる力を……！！", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "だが王子とハイオークどもまでいるとは……。\nこうなったら奴らの戦闘の隙をついて団長の証を\n奪うまでだ！", "face": "ld336215cf73a"}, {"name": "暗黒騎士デシウス", "text": "そしてあの証が持つ力を使い、自らが団長となって\n新しい『暗黒騎士団』を作るのだ！！", "face": "ld336215cf73a"}]}, {"trigger": "end", "lines": [{"name": "エルヴァ", "text": "団長、この勝利あんたにあげるよ。", "face": "u1211"}, {"name": "ユリナ", "text": "安らかに……。", "face": "u1111"}, {"name": "アンナ", "text": "何とか撃退できました。\nひとまずこの場は収まったようです。\n参りましょう、王子。"}, {"name": "暗黒騎士デシウス", "text": "……くそっ！　くそっ！　\nあともう少しだったというのに……っ！！\nおのれ王子……ッ！！　おのれぇッ……！！", "face": "ld336215cf73a"}, {"name": "？？？", "text": "いやはや。実に面白いものを見せてもらったよ。", "face": "l675fb6b929e0"}, {"name": "暗黒騎士デシウス", "text": "あなたは……！", "face": "ld336215cf73a"}, {"name": "？？？", "text": "君の力への渇望が私を呼び寄せたようだね。\n目的のためなら手段を選ばないその美しい姿。\n拝見させてもらったよ。", "face": "l675fb6b929e0"}, {"name": "？？？", "text": "君は見込みがあるね。\nよし。ならば新しい団長の証を作ってあげようかね。", "face": "l675fb6b929e0"}, {"name": "暗黒騎士デシウス", "text": "本当ですか……！", "face": "ld336215cf73a"}, {"name": "？？？", "text": "それがあれば、君の元には\nすぐに新しい暗黒騎士たちが集まるだろう。", "face": "l675fb6b929e0"}, {"name": "？？？", "text": "前の団長もなかなか愉快なものだったけど、\n君はまた違った面白さがありそうだね。\n期待しているよ？", "face": "l675fb6b929e0"}]}], "map": {"image": "Map920051_3623", "w": 960, "h": 640, "spots": [{"k": "b", "x": 813, "y": 122}, {"k": "m", "x": 800, "y": 409, "id": 200}, {"k": "m", "x": 789, "y": 226, "id": 201}, {"k": "m", "x": 580, "y": 214, "id": 202}, {"k": "m", "x": 672, "y": 131, "id": 203}, {"k": "m", "x": 587, "y": 132, "id": 204}, {"k": "m", "x": 234, "y": 475, "id": 205}, {"k": "m", "x": 191, "y": 408, "id": 206}, {"k": "m", "x": 392, "y": 314, "id": 207}, {"k": "m", "x": 491, "y": 269, "id": 208}, {"k": "m", "x": 675, "y": 216, "id": 209}, {"k": "m", "x": 785, "y": 300, "id": 210}, {"k": "m", "x": 813, "y": 502, "id": 211}, {"k": "m", "x": 437, "y": 380, "id": 212}, {"k": "m", "x": 540, "y": 332, "id": 213}, {"k": "m", "x": 290, "y": 360, "id": 214}, {"k": "m", "x": 335, "y": 426, "id": 215}, {"k": "m", "x": 469, "y": 131, "id": 216}, {"k": "m", "x": 356, "y": 134, "id": 217}, {"k": "m", "x": 252, "y": 135, "id": 218}, {"k": "m", "x": 134, "y": 136, "id": 219}, {"k": "m", "x": 636, "y": 279, "id": 220}, {"k": "r", "x": 654, "y": 351, "id": 300}, {"k": "r", "x": 373, "y": 242, "id": 301}, {"k": "r", "x": 867, "y": 346, "id": 302}, {"k": "r", "x": 492, "y": 193, "id": 303}, {"k": "r", "x": 378, "y": 489, "id": 304}, {"k": "r", "x": 199, "y": 330, "id": 305}, {"k": "r", "x": 106, "y": 210, "id": 306}, {"k": "r", "x": 725, "y": 445, "id": 307}, {"k": "r", "x": 571, "y": 389, "id": 308}, {"k": "r", "x": 121, "y": 303, "id": 309}]}, "active": true, "story_talk": true}