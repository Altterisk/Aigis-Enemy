{"quest_id": 6382, "name": "荒ぶ豪風、爆ぜる炎獄", "description": "豪風と炎獄、鬼軍の二大勢力が\n都に向け進軍中との報。両者の\n争いを止めるべく、都へと急げ！\n極級（★１獲得の目安：平均Lv25）", "event": "青鬼娘と鬼一門", "event_category": "History", "mission_id": 920103, "map_no": 5294, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1200, "base_hp": 15000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105904, "race_id": 4, "special_effect_id": 232, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 30907, "global_id": 4526, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1500, "base_hp": 15000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104000, "race_id": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30908, "global_id": 4527, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 22, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 7}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 31}, {"enemy_id": 5, "source": "local", "count": 11, "form_count": 1, "tags": ["アンデッド"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 161, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112288, "race_id": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30683, "global_id": 4302, "ranged": true, "spawn_sec": 48}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 88}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 101}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 161}], "dialogue": [{"trigger": "start", "lines": [{"name": "リンドウ", "text": "――ハァッ、ハァッ……！\nま、間に合ったか！？", "face": "u587"}, {"name": "アンナ", "text": "いえ、あれを――！", "face": "l82ee8a934738"}]}, {"trigger": "start", "lines": [{"name": "豪風の四天王", "text": "……ここで雌雄を決せねばならぬようだな、炎よ。", "face": "l25b08bd7df26"}, {"name": "鬼刃姫", "text": "あれは――！　\n豪風と……炎獄の四天王！", "face": "u435"}, {"name": "リンドウ", "text": "くっ……都に向けて進軍中とは聞いとったけど、\n鬼の二大勢力がホンマに都でかち合うなんて！", "face": "u587"}, {"name": "アンナ", "text": "このままでは都の人々も巻き込まれてしまいます！\n両軍が動き出す前に止めなくては！", "face": "l82ee8a934738"}, {"name": "リンドウ", "text": "よっしゃ！\nそんじゃアンナはん、『アレ』、頼むでぇッ！", "face": "u587"}, {"name": "豪風の四天王", "text": "……む？\n誰だ、我らが戦場に足を踏み入れる愚か者は？", "face": "l25b08bd7df26"}, {"name": "リンドウ", "text": "愚か者はどっちじゃい！\n同じ鬼同士で争うなんてアホちゃうか！", "face": "u587"}, {"name": "豪風の四天王", "text": "……大人には色々と事情があるのだ。\nぬしのような小娘には理解できぬだろうがな。", "face": "l25b08bd7df26"}, {"name": "リンドウ", "text": "フン、仲間同士で殺し合わなあかん事情なんて\n一生わかりたくもないわ！\nアンナはん、あれを――！", "face": "u587"}, {"name": "アンナ", "text": "はいッ！\nこの節分豆が目に入らぬかーッ！！", "face": "l82ee8a934738"}, {"name": "豪風の四天王", "text": "ぬぅッ！？　そ、それは……ッ！\nそうか……貴様ら、いつぞやの王子らか！", "face": "l25b08bd7df26"}, {"name": "豪風の四天王", "text": "……炎よ、ここは一時停戦といこう。\nまずは不倶戴天の敵、王子らをここで滅ぼすぞ！", "face": "l25b08bd7df26"}]}, {"trigger": "end", "lines": [{"name": "豪風の四天王", "text": "ぐぅッ……力が、抜けてゆく……ッ！\n節分豆の力、これほどとは……ッ！", "face": "l25b08bd7df26"}, {"name": "リンドウ", "text": "……なぁ、もうええやろ？\nうちだって、ホンマはこないなことしたかない。\n同じ鬼同士、仲良ぅしてほしいだけなんや。", "face": "u587"}, {"name": "豪風の四天王", "text": "ぐぬぅッ……ほ、炎よ！\nぬしがこの豪風の指揮に従っておれば\nこやつらに後れを取ることなどなかったのだ！", "face": "l25b08bd7df26"}, {"name": "リンドウ", "text": "ああっ！？\nなんでや……なんでまた喧嘩せな――", "face": "u587"}, {"name": "？？？", "text": "――馬鹿野郎ッ！！\n下らねえことで仲間割れしてんじゃねえッ！！", "face": "lea9f1966cc5c"}, {"name": "鬼刃姫", "text": "あれは――！\n父上……いえ――。", "face": "u435"}, {"name": "豪風の四天王", "text": "――酒呑童子様！？\nなぜ此方に……。", "face": "l25b08bd7df26"}, {"name": "酒呑童子", "text": "蘇ったのさ。人間どもの『畏れ』を糧にな。\nお前らの馬鹿げた抗争も、人間どもの『畏れ』を集めて\nこの俺を復活させるのには役立ったってわけだ。", "face": "lea9f1966cc5c"}, {"name": "酒呑童子", "text": "無論まだ本調子ってわけじゃねえが、\n酒でも呑んでりゃすぐに回復すんだろう。", "face": "lea9f1966cc5c"}, {"name": "酒呑童子", "text": "それに……くっくっく、いるじゃねえか？\n病み上がりの景気づけに相応しい相手がな。\n――なァ、人間ども！　そして茨木童子ッ！", "face": "lea9f1966cc5c"}, {"name": "鬼刃姫", "text": "――ッ！　\nわ、笑っていられるのも今のうちよ！\n病み上がりのあなたなんか、返り討ちにしてやるわ！", "face": "u435"}, {"name": "酒呑童子", "text": "ふははっ、できるもんならやってみなッ！\nおい、戦える鬼どもは全員俺に加勢しろ！\n王子たちを滅ぼし、そのまま都を占領するぞ！", "face": "lea9f1966cc5c"}, {"name": "アンナ", "text": "そうはさせません！\n王子、迎え撃ちましょう！", "face": "l82ee8a934738"}, {"name": "アンナ", "text": "鬼封じの節分豆が我々の手にある今、今度こそ完全に\n酒呑童子を倒すことができるかもしれません！\n本来の力を取り戻される前に、ここで討ちましょう！", "face": "l82ee8a934738"}]}], "active": true}