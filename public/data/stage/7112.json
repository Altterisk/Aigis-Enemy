 "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 13, "master_id": 873, "global_id": 872, "spawn_sec": 108}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 35000, "base_hp": 35000, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 30, "attack_speed": 30, "attack_wait": 110, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2115872, "race_id": 9, "missile_id": 6, "master_id": 32734, "global_id": 6352, "spawn_sec": 177}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 28000, "attack": 880, "base_hp": 28000, "base_attack": 880, "damage_type": "physical", "armor_defense": 680, "magic_defense": 20, "attack_speed": 10, "attack_wait": 1, "attack_interval": 68, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2121728, "race_id": 16, "master_id": 32731, "global_id": 6349, "spawn_sec": 177}, {"enemy_id": 17, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 56, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117648, "race_id": 12, "change_to": 17, "change_condition": 1, "master_id": 32733, "global_id": 6351, "variants": [{"hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 56, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117664, "race_id": 12, "special_effect_id": 275, "master_id": 31574, "global_id": 5193}], "spawn_sec": 182}, {"enemy_id": 19, "source": "local", "count": 1, "form_count": 1, "tags": ["置物"], "fixture": true, "hp": 35000, "attack": 300, "base_hp": 35000, "base_attack": 300, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 280, "attack_speed": 1, "attack_wait": 50, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2119680, "race_id": 7, "missile_id": 376, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 32732, "global_id": 6350, "ranged": true, "spawn_sec": 186}], "dialogue": [{"trigger": "start", "lines": [{"name": "デシウス", "text": "さぁ剣をとれ、我輩と共に並び立て！！\n我輩との誓いを忘れたとは言わせないぞ！", "face": "l6607c719ec5f"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ノーマ", "text": "ガオレオン様に信頼されていて、\nデシウス様にここまで慕われていて、\nいったいこの人類何者なの……？", "face": "u1047a1"}, {"name": "ノーマ", "text": "王国軍は、魔王軍の敵だったのよね……？", "face": "u1047a1"}, {"name": "トゥアン", "text": "……知らん。\nだがあいつも、英雄王もそうだった。\n王子はしっかりと、あいつの血を受け継いだんだろう。", "face": "u1006a1"}, {"name": "アトナテス", "text": "……それ以上だぜ？\nあいつだって、いくらなんでも\n魔王の幹部と楽しそうに共闘まではしなかったさ。", "face": "u908"}, {"name": "ノーマ", "text": "わ、わけが分からないわ……！！\nでも勝てる！　これ勝てるってことよね！", "face": "u1047a1"}, {"name": "トゥアン", "text": "むぅ。それとこれとは話が別だ。\n敵は神獣、エインヘリヤルだぞ？\nだが実に――", "face": "u1006a1"}, {"name": "アトナテス", "text": "おう、実に喰い甲斐があるってものだぜ。\n神獣狩りは久々だ。\n出てくるヤツは全員倒してやろうか！", "face": "u908"}, {"name": "ノーマ", "text": "（全然物怖じしてないとか！\n王国軍って、私たちが戦ってた相手って、\nこんなにヤバイ連中だったの！？）", "face": "u1047a1"}, {"name": "デシウス", "text": "王子よ、今の我輩は何者にも負ける気がしない。\n第二形態を解放するタイミングは貴様に任せるぞ！", "face": "l6607c719ec5f"}, {"name": "王子", "text": "――行くぞ、デシウス。\n俺達の戦いを、神獣に見せてやろう。", "face": "u1"}, {"name": "デシウス", "text": "――応ッ！！", "face": "l6607c719ec5f"}]}, {"trigger": "end", "lines": [{"name": "神聖騎士団員", "text": "くっ……何だこの力は！\nエインヘリヤルを倒しただと……！？", "face": "lf1e56eb7fd73"}, {"name": "神聖騎士団員", "text": "仕方ない、撤退するぞ！\nこの娘は殺すように神託を受けている、\n奪われないよう連れて行け！", "face": "lf1e56eb7fd73"}, {"name": "鷲翼の鳥人", "text": "――痛っ……！　くそっ、離せ！！\n王子に伝えることがあるんだ！", "face": "u1086a1"}, {"name": "女王子", "text": "――乙女に手をあげるとは、\nその罪、万死に値すると知りなさい。", "face": "le1a0323ff10f"}, {"name": "神聖騎士団員", "text": "……な、何だ？\nいま空から声が――グワァァァッ！？", "face": "lf1e56eb7fd73"}, {"name": "女王子", "text": "ご無事ですか、麗しき翼の乙女よ。\n……なんて、ちょっと格好つけすぎですかね。", "face": "le1a0323ff10f"}, {"name": "鷲翼の鳥人", "text": "あ、ありがとう……。", "face": "u1086a1"}, {"name": "アンナ", "text": "あなたは……それに\nメカゴブリンクイーンまで！？", "face": "l34d9eaa35f12"}, {"name": "ガオレオン", "text": "おぉ、やはり来てくれたかメカゴブリンクイーンよ！\nガオーッ！！　やはり我らは\n固い絆で結ばれているのだなッ！！", "face": "l3179d9738cce"}, {"name": "メカゴブリンクイーン", "text": "……ガオレオン、あなたの誘いだけなら断っていたわ。\n王子はゴブリン族の宿敵だもの。\nだからこの子に協力を打診させたのは正解だったわね。", "face": "le219b5be753d"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、この子が「王子を助けて」と叫んだから、\n天界との戦いに、一緒に挑んであげる気になったのよ。", "face": "le219b5be753d"}, {"name": "女王子", "text": "メカゴブリンクイーン様……。", "face": "le1a0323ff10f"}, {"name": "メカゴブリンクイーン", "text": "あなたはね、昔の私によく似ているの。\n裏切られ、踏みにじられ、自分の弱さを知り、\nそれでも立ち上がることを選んだ強い女だから。", "face": "le219b5be753d"}, {"name": "メカゴブリンクイーン", "text": "それよりクロコはどうしたのかしら？\n姿が見えないじゃないの。", "face": "le219b5be753d"}, {"name": "クラールフ", "text": "あやつは行方が分からぬゆえな。\nゴブリン族のように盛大に暴れてくれたなら、\nその行方も知れようというものだが。", "face": "l00c08af544f1"}, {"name": "ノーマ", "text": "ま、魔王軍幹部様が……こんなに……。\n王子ぃっ！　いったいどうなってるの！？", "face": "u1047a1"}, {"name": "王子", "text": "………（こくこく）", "face": "u1"}, {"name": "ノーマ", "text": "嬉しそうにこくこくしてても分からないわ！！\nちゃんと説明しなさい！　人類のくせにー！！", "face": "u1047a1"}, {"name": "鷲翼の鳥人", "text": "……はっ、そうだ！\n呆気にとられている場合じゃない！", "face": "u1086a1"}, {"name": "鷲翼の鳥人", "text": "物質界の王子、ここに\nクラールフ様がいるということは、\n神の楔は無事に受け取ったのか？", "face": "u1086a1"}, {"name": "クラールフ", "text": "然り、確かに乾いた地の王子に、\n我が最後の神の楔を譲り渡した。", "face": "l00c08af544f1"}, {"name": "鷲翼の鳥人", "text": "ならば……これが勝手な頼みだとは分かっている。\nだが、どうか私の里を助けてほしい……。", "face": "u1086a1"}, {"name": "鷲翼の鳥人", "text": "天界の障壁を超える術を教えたことが罪に問われ、\n隠れ里が天使の襲撃を受けているんだ……。", "face": "u1086a1"}, {"name": "アンナ", "text": "……王子、天界へ行きましょう。\nもはやこれは、私たちだけの戦いではないようです。", "face": "l34d9eaa35f12"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}