{"quest_id": 7112, "name": "集いし力", "description": "好敵手デシウスと協力し、神獣を撃破せよ！\n＜味方のデーモン、アンデッドの\n　攻撃力、防御力が70％ダウン＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["味方のデーモン、アンデッドの\n　攻撃力、防御力が70％ダウン"], "event": "開かれし扉と集う戦士たち", "event_category": "History", "mission_id": 920149, "map_no": 5752, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 1;", "expression_human": "(it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 13, "params": [30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 1;", "expression_human": "(it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 1600, "base_hp": 60000, "base_attack": 1600, "damage_type": "magical", "armor_defense": 600, "magic_defense": 40, "attack_range": 220, "attack_speed": 20, "attack_wait": 80, "attack_interval": 233, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2117504, "race_id": 15, "special_effect_id": 108, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 31579, "global_id": 5198, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 18, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 2, "master_id": 655, "global_id": 654, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_int