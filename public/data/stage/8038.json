ed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133056, "race_id": 16, "special_effect_id": 1483, "change_to": 7, "change_condition": 1, "missile_id": 26, "master_id": 36436, "global_id": 10053, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133264, "race_id": 16, "master_id": 34629, "global_id": 8246}, {"tags": ["帝国"], "hp": 18000, "attack": 500, "base_hp": 18000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133056, "race_id": 16, "special_effect_id": 229, "change_to": 6, "missile_id": 26, "master_id": 36438, "global_id": 10055, "ranged": true}], "sp_change_to": [36438], "spawn_sec": 223}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "tags": ["帝国"], "hp": 46000, "attack": 650, "base_hp": 46000, "base_attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 210, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133312, "race_id": 16, "special_effect_id": 1483, "change_to": 10, "change_condition": 1, "missile_id": 26, "master_id": 36439, "global_id": 10056, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 46000, "attack": 1800, "base_hp": 46000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133328, "race_id": 16, "master_id": 34631, "global_id": 8248}, {"tags": ["帝国"], "hp": 46000, "attack": 650, "base_hp": 46000, "base_attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 210, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133312, "race_id": 16, "special_effect_id": 229, "change_to": 9, "missile_id": 26, "master_id": 36441, "global_id": 10058, "ranged": true}], "sp_change_to": [36441], "route_behaviour": {"transforms": [{"to": 36441}, {}]}, "spawn_sec": 280}], "popups": ["ダークエルフの野営地は\n倒されると★の評価に影響します。", "古の帝国騎士は体力が\n徐々に減少していきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "骸帝", "text": "――弱い、弱すぎるぞ。\nそれでも白の帝国の名を継ぐ者たちか？", "face": "lf035f042ddb3"}, {"name": "レオラ", "text": "失礼ねぇ。\n現陛下は亜神とすら斬り結ぶお人よ？", "face": "u464"}, {"name": "骸帝", "text": "それがどうしたというのだ。\n強さとは畏怖と恐怖をもたらすものだ。\nだというのに、今の帝国はどうだ？", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "力で抑えつけるべき者どもに反逆され、\n一国ではそれを鎮圧することもできず、\n英雄王の子孫と馴れ合いとは。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "――もう、気付いているのだろう？\n今の帝国は、既に限界なのだと。", "face": "lf035f042ddb3"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "骸帝", "text": "ハハハッ、分かっていても、\n兵の前では同意しない程度の気概はあるか。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "こちらにも、可愛くも愚かな後継者に、\n自ら引導を渡すくらいの慈悲はある。\n剣を抜け、帝国全軍をもって相対してみせよ。", "face": "lf035f042ddb3"}, {"name": "骸帝", "text": "――この冥界にて蘇りし、\n最も強き時代の帝国軍にて、今の帝国を終わらせよう。", "face": "lf035f042ddb3"}, {"name": "マルゴット", "text": "あの鎧……あの構え、まさか……。", "face": "u1343a1"}, {"name": "ディアナ", "text": "古い構えです。\n今では誰も使わない、基礎教練で学ぶだけの。", "face": "u624"}, {"name": "ディアナ", "text": "しかし、そんな古い構えを、\n今の時代でも伝承しているのは、\n重要な意味があるから。", "face": "u624"}, {"name": "ディアナ", "text": "――あれは古の、帝国騎士団。\n骸帝が編み出した剣技を担う、我々の先達です！", "face": "u624"}, {"name": "白の皇帝", "text": "……剣をとれ。\n敵が誰であろうと、関係ない。", "face": "u418"}, {"name": "白の皇帝", "text": "俺たちには、守るべき者がいる。\n新たに、共に歩む道を模索しはじめた、\nダークエルフたちを殺させてはならない。", "face": "u418"}, {"name": "レオナ", "text": "野営地の城壁を活用しろ！\n敵を身内だと思うな、あれは我らの、\n忘れてはならない、だが祓うべき呪われた過去の亡霊だ！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "メーア", "text": "……やーな感じですね。\nあのご先祖様軍、皆笑いながら消えていきますよ。", "face": "u796"}, {"name": "メフィスト", "text": "嬉しいんだろうね。\n身内だからと遠慮することなく、\n全力で殺しにかかってくれる、今の帝国軍の存在が。", "face": "u526"}, {"name": "クリスタ", "text": "なんですの、それ。\nせっかく死んだ後にも自我を保っているなら、\n楽しく仲良く生きる道を選べば良いのに。", "face": "u709"}, {"name": "ハリナ", "text": "未来の子らを任せられる、\nその事実を喜んでいるのだろう。\n己の死は、そのまま子孫を守る力の証明になる。", "face": "u988"}, {"name": "フィリーネ", "text": "……では、骸帝の目的は？\nまさか、本当に帝国の未来を憂えて……。", "face": "u621"}, {"name": "レオラ", "text": "本気、だと思うわよ？\nただその本気は、本気で今の帝国軍を潰し、\n再び自分が統治すべきだ、と考えているみたいだけどね。", "face": "u464"}, {"name": "レオナ", "text": "今のうちに陣形を立て直せ！\n敵はこちらの戦術の基礎を作った者たちだ、\n隙を見せれば食い破られるぞ！", "face": "u311"}, {"name": "ゲオルグ", "text": "ちっ……どうしたもんかね、こいつは……。", "face": "u424"}, {"name": "ディルク", "text": "――で、伝令！　伝令ッ！！\n左翼歩兵部隊、被害甚大！\n再編成が間に合いません、至急増援を！", "face": "u287"}, {"name": "セグナンド", "text": "……我々が行こう。\nダークエルフが誇りを胸に抱く者たちよ！\n死氷の亜神、白の帝国の恩に報いるぞ！！", "face": "l20ac59a2a223"}, {"name": "レオナ", "text": "馬鹿な……！！\nやめろ、死にに行くようなものだぞ！？", "face": "u311"}, {"name": "セグナンド", "text": "皇帝――いや、陛下、そして王子。\n未来の子ら、イルヴィを頼むぞ。\n未来の恩は、今ここで先に返しておく！", "face": "l20ac59a2a223"}, {"name": "イルヴィ", "text": "父上――ッ！！", "face": "u1918a1"}, {"name": "イルヴィ", "text": "父、上……。", "face": "u1918a1"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}, {"kind": "term", "influence": 20, "params": [200]}], "enemies": [{"enemy_id": 1, "hp": 27300, "attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "pattern_id": 2146224}, {"enemy_id": 1, "form_index": 1, "hp": 27300, "attack": 1400, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "pattern_id": 2146224}, {"enemy_id": 3, "hp": 2600, "attack": 455, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2102256}, {"enemy_id": 4, "hp": 3250, "attack": 624, "damage_type": "physical", "armor_defense": 250, "pattern_id": 2111792}, {"enemy_id": 5, "hp": 26000, "attack": 585, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2130064}, {"enemy_id": 6, "hp": 14300, "attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "pattern_id": 2108336}, {"enemy_id": 7, "hp": 23400, "attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133056}, {"enemy_id": 10, "hp": 59800, "attack": 650, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133312}]}, "active": true}