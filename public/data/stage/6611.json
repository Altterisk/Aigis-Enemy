cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 4}, {"enemy_id": 5, "source": "local", "count": 38, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 4}, {"enemy_id": 6, "source": "local", "count": 16, "form_count": 1, "hp": 1200, "attack": 110, "base_hp": 1200, "base_attack": 110, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31348, "global_id": 4967, "ranged": true, "spawn_sec": 5}, {"enemy_id": 7, "source": "local", "count": 40, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 7, "change_condition": 3, "master_id": 800, "global_id": 799, "to_condition": 3, "to_global_id": 800, "spawn_sec": 6}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 500, "base_hp": 1200, "base_attack": 500, "damage_type": "physical", "armor_defense": 130, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "クロコ", "text": "――三勢力共に、全軍集結したようダナ。\n貴公らが我が招集に応じたコト、嬉しく思ウ。", "face": "l6f8570c134f2"}, {"name": "メカゴブリンクイーン", "text": "魔王軍幹部に相応しい美しさを誇る、\nこのワタシに声をかけたのは、\n正解と言わざるを得ないわ……ウフフ……。", "face": "l22ab85d2e7c4"}, {"name": "ダークエルフ", "text": "この戦いを制した勢力が、\n新たな魔王軍幹部に取り上げられると聞けば、\n怪しい誘いにも乗ろうというものだ。", "face": "lbb5b135454d4"}, {"name": "オーク", "text": "ふん、魔王軍幹部などついでだ。\nダークエルフとゴブリンの強者と戦えるというから、\nクロコ、貴様の招集に応じたのだ。", "face": "l4cee86851473"}, {"name": "クロコ", "text": "既に理解してイルようで助かル。\n知ってのトオリ、これは新たナ魔王軍幹部を\n決める為の戦いダ。", "face": "l6f8570c134f2"}, {"name": "クロコ", "text": "魔王様に仕えル以上、力なき弱者は必要ナイ。\nこの戦いにて、己が種族こそが幹部に相応しいト、\n力をモッテ示スが良イ。", "face": "l6f8570c134f2"}, {"name": "ケイティ", "text": "――成る程、そういうことだったのですね。\n魔王軍幹部、竜将クロコ！", "face": "u114"}, {"name": "クロコ", "text": "ククク……いつまで経っても姿を見せヌ故、\n怖気づいたのかと思ってイタゾ、人間。", "face": "l6f8570c134f2"}, {"name": "アンナ", "text": "私達の接近に気付いていて、\nあえて先の情報を聞かせたというのですか。", "face": "l77158d57ca16"}, {"name": "クロコ", "text": "無論。だが、ある意味ではこれは良い機会ダ……。\n三勢力共に、王子には思う所があるダロウ。", "face": "l6f8570c134f2"}, {"name": "クロコ", "text": "――趣向を変えヨウ。\nこの三勢力の何れが、最も王子達相手に善戦スルカ、\nその戦いぶりを見テ、新たナ魔王軍幹部を決めるノダ。", "face": "l6f8570c134f2"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}, {"name": "クロコ", "text": "よもや、逃げヨウなどとは思うまいナ。\n王子よ、魔王様の為の試金石とナルが良イ。\n貴様ラの戦いブリは、私がとくと見届けヨウ。", "face": "l6f8570c134f2"}, {"name": "ゴライア", "text": "高みノ見物ッテカ。\nイケスカネェ野郎ダゼ。\nオイ王子！　売られた喧嘩ダ、買ってやろうゼ。", "face": "u385"}, {"name": "アンナ", "text": "どうやら、撤退するという選択肢は無さそうです。\n王子、全力を以て三勢力を迎撃しましょう！", "face": "l77158d57ca16"}]}], "active": true}