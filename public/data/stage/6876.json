assin_resist": 1, "transform_resist": 100, "pattern_id": 2120064, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31985, "global_id": 5604, "ranged": true, "spawn_sec": 61}, {"enemy_id": 5, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 2500, "attack": 30, "base_hp": 2500, "base_attack": 30, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.149999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 30011, "global_id": 3630, "ranged": true, "spawn_sec": 65}, {"enemy_id": 6, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 111}], "dialogue": [{"trigger": "start", "lines": [{"name": "ルナール", "text": "カボカボ……。\nルナール探検隊カボ……。", "face": "u889"}, {"name": "エデン", "text": "王子、ルナールちゃんがいたよ！\nやっぱりカボチャの魔物に\n操られているみたいだね……。", "face": "u239"}, {"name": "ミトラ", "text": "ルナール！　しっかりしろ！\nカボチャの魔物如きに負けるんじゃない！", "face": "u276"}, {"name": "ルナール", "text": "カボカボ？　ルナール探検隊の前に、\n凶悪な魔物の群れが現れたカボ……。", "face": "u889"}, {"name": "カボチャの魔物", "text": "ルナールちゃーん、怖い魔物が現れたカボ～！\nボク達と一緒に、あの魔物をやっつけるカボ～♪", "face": "l2fdcdf2e8489"}, {"name": "アンナ", "text": "どうやら戦闘は避けられそうにないですね……。\n王子、ルナールさんを助けるためにも、\n戦闘の準備をお願いします！", "face": "l41684efb6159"}]}, {"trigger": "end", "lines": [{"name": "カボチャの魔物", "text": "カボぉ！？\nやっぱり王子達は強いカボ……！", "face": "l2fdcdf2e8489"}, {"name": "カボチャの魔物", "text": "でも操ったルナールちゃんから、\n魔界の門の場所はもう聞き出してあるカボ♪\nさぁ皆、魔界の門へ急ぐカボ～！", "face": "l2fdcdf2e8489"}, {"name": "ルナール", "text": "あやつった……？\n……あたし……操られてるカボ……？", "face": "u889"}, {"name": "カボチャの魔物", "text": "カボー！　そんなことないカボ！\nルナールちゃんはボクらの親友カボ～♪", "face": "l2fdcdf2e8489"}, {"name": "ミトラ", "text": "そう簡単に逃がすと思うか？\n魔界の門へは行かせないぞ。", "face": "u276"}, {"name": "カボチャの魔物", "text": "カボ～！？\n邪魔をするつもりカボ？\nそれならもっと強いナカマを呼ぶカボ～！", "face": "l2fdcdf2e8489"}, {"name": "アンナ", "text": "王子、森の奥から魔物の増援が来ます……！", "face": "l41684efb6159"}]}], "map": {"image": "Map920134_3355", "w": 960, "h": 640, "spots": [{"k": "b", "x": 944, "y": 122}, {"k": "b", "x": 945, "y": 489}, {"k": "m", "x": 827, "y": 142, "id": 200}, {"k": "m", "x": 753, "y": 211, "id": 201}, {"k": "m", "x": 727, "y": 329, "id": 202}, {"k": "m", "x": 638, "y": 427, "id": 203}, {"k": "m", "x": 737, "y": 463, "id": 204}, {"k": "m", "x": 843, "y": 496, "id": 205}, {"k": "m", "x": 496, "y": 457, "id": 206}, {"k": "m", "x": 352, "y": 431, "id": 207}, {"k": "m", "x": 276, "y": 352, "id": 208}, {"k": "m", "x": 252, "y": 253, "id": 209}, {"k": "m", "x": 182, "y": 185, "id": 210}, {"k": "m", "x": 239, "y": 457, "id": 211}, {"k": "m", "x": 127, "y": 433, "id": 212}, {"k": "r", "x": 823, "y": 246, "id": 300}, {"k": "r", "x": 789, "y": 401, "id": 301}, {"k": "r", "x": 642, "y": 490, "id": 302}, {"k": "r", "x": 347, "y": 487, "id": 303}, {"k": "r", "x": 209, "y": 389, "id": 304}, {"k": "r", "x": 214, "y": 128, "id": 305}]}, "active": true}