{"quest_id": 4328, "name": "聖騎士の導き", "description": "再び操られることのない\n魔に打ち勝つ心を得るため\nユリナとの特訓に挑め！\n極級（★１獲得の目安：平均Lv25）", "event": "大地を震わす必殺剣", "event_category": "History", "mission_id": 920045, "map_no": 3590, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "level": 85, "form_count": 1, "hp": 16000, "attack": 420, "base_hp": 16000, "base_attack": 420, "damage_type": "physical", "armor_defense": 600, "magic_defense": 90, "attack_speed": 90, "attack_wait": 10, "attack_interval": 141, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101312, "race_id": 16, "special_effect_id": 242, "master_id": 20046, "global_id": 1121, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097824, "master_id": 44, "global_id": 43, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 18}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 19}, {"enemy_id": 5, "source": "local", "count": 12, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 31}, {"enemy_id": 6, "source": "local", "count": 30, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 52}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 60, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097376, "master_id": 17, "spawn_sec": 63}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 102}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 110}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "グローリアさんがこれ以上デーモンに\n操られないように、どうか特訓を\nしていただけないでしょうか？", "face": "l4f5c372ca8da"}, {"name": "グローリア", "text": "頼む。魔に打ち勝つ心を持ちたいんだ。", "face": "u259"}, {"name": "ユリナ", "text": "わかった。\n私も初めは暗黒騎士団の一人だった。", "face": "u1111"}, {"name": "ユリナ", "text": "今は王子たちのおかげで人間の心を取り戻し、\n誰かを大事に思えるようになった。\nその恩に報えるなら……。", "face": "u1111"}, {"name": "兵士", "text": "報告します！\n魔物がこちらに向かってきています！", "face": "l36734f4e6cf3"}, {"name": "グローリア", "text": "ま……もの……っ。", "face": "u259"}, {"name": "アンナ", "text": "グローリアさん、ユリナさん、\n魔物は私たちに任せて\nお二人は特訓に集中してください。", "face": "l4f5c372ca8da"}, {"name": "ユリナ", "text": "ああ、ありがとう。\nグローリア、落ち着いて。\n心を強く持って。", "face": "u1111"}, {"name": "グローリア", "text": "魔物なんかに、屈しない……っ。\nあたしは……。", "face": "u259"}, {"name": "ユリナ", "text": "（目に生気が……）\nそのまま、気持ちを強く持って。\n大丈夫だ。私たちがいる。", "face": "u1111"}, {"name": "グローリア", "text": "あぁ、ありがとう……。", "face": "u259"}, {"name": "ユリナ", "text": "では、いくぞ。", "face": "u1111"}]}, {"trigger": "end", "lines": [{"name": "ユリナ", "text": "私は母親に捨てられた哀しみで世界を憎んでいた。\n憎んで、憎んで、気づけばこの心のスキを突かれて\n魔物に操られ、いつしか人間の心を失くしていった。", "face": "u1111"}, {"name": "ユリナ", "text": "取り返しのつかない罪を重ねていった……。", "face": "u1111"}, {"name": "ユリナ", "text": "だが、後悔するよりも前に進むことを選んだ。\n今は少しでも私のような子供を増やさないように\n森に孤児院を建てて、しょく罪の日々を送っている。", "face": "u1111"}, {"name": "ユリナ", "text": "何かを大事に思う強い心があれば、\n魔の力に打ち勝つことはできるはずだ。", "face": "u1111"}, {"name": "ユリナ", "text": "もし何か守りたいと思うものを見つけたなら、\nもう大丈夫だ。", "face": "u1111"}, {"name": "アンナ", "text": "グローリアさんは大丈夫そうですね。\n王城へ戻りましょうか、王子。", "face": "l4f5c372ca8da"}]}], "active": true}