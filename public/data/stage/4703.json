al_id": 111, "spawn_sec": 6}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098640, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 151, "global_id": 150, "ranged": true, "spawn_sec": 45}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 1000, "attack": 230, "base_hp": 1000, "base_attack": 230, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098624, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 150, "global_id": 149, "ranged": true, "spawn_sec": 68}, {"enemy_id": 7, "source": "local", "count": 8, "form_count": 1, "hp": 2800, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 101}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 161, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107264, "race_id": 2, "master_id": 877, "global_id": 876, "spawn_sec": 131}], "dialogue": [{"trigger": "start", "lines": [{"name": "イグニス", "text": "……大長老様、\n魔物に加担するって……本気なのですか？", "face": "u396"}, {"name": "イグニス", "text": "今まで我らは平穏にこの島で暮らしてきました……。\nやっと種の数も増えてきたのに、\n再び戦争なんて……。", "face": "u396"}, {"name": "大長老", "text": "我らは、かつての千年戦争において\n魔物側で武勇を振るった竜人を先祖に持つ。\nこれは種の更なる繁栄への絶好の機会なのじゃ。", "face": "lc718fe4021f3"}, {"name": "イグニス", "text": "しかし、千年戦争ははるか昔の事……。\n今この島にいる皆には関係の無いことです。\n大長老様……お考え直しください……！", "face": "u396"}, {"name": "大長老", "text": "何を愚かなことを言っている、イグニス！", "face": "lc718fe4021f3"}, {"name": "大長老", "text": "我らは先の戦争で敗れてこの島に流れ着いただけ。\n今こそ、誇り高き竜人種の\n再興を果たすべきなのじゃ！", "face": "lc718fe4021f3"}, {"name": "大長老", "text": "まずは魔界への手土産として\n王子の首を貰い受ける。", "face": "lc718fe4021f3"}, {"name": "大長老", "text": "……さすれば、我等竜人種が長きに渡り戦いに\n参加出来なかった事を水に流してくれるであろう。", "face": "lc718fe4021f3"}, {"name": "竜人戦士", "text": "――大長老ッ！", "face": "u95"}, {"name": "竜人戦士", "text": "仰せの通り我ラが守り神様の準備が整いましタ！\nここは危険デス……さあ、ドウゾこちらへ……。", "face": "u95"}, {"name": "大長老", "text": "分かった。\n後のことはおぬしらに任せるぞ。\nイグニス……貴様もしっかりと責務を果たすのじゃ。", "face": "lc718fe4021f3"}, {"name": "イグニス", "text": "……分かりました。大長老様……。", "face": "u396"}, {"name": "兵士", "text": "飛竜の来襲を多数確認！\n警戒を強めて下さい！", "face": "ld8c6d4cd70dd"}, {"name": "アンナ", "text": "どうしてこんなことに……。\nいえ、今は悩んでいる場合ではありませんね。\n王子、戦いの準備をお願いします！", "face": "l208dea54255d"}]}, {"trigger": "end", "lines": [{"name": "竜人戦士", "text": "そんな……バカな！？\n守り神様が、やられてしまっタ……。", "face": "u95"}, {"name": "イグニス", "text": "……こんな戦いはするべきではなかったんだ。\n戦で血を流し、仲間が倒れるくらいなら、この島で\n平穏に暮らしていた方が良いに決まってる。", "face": "u396"}, {"name": "アンナ", "text": "まだ、戦いを続けるつもりならば、\n犠牲はさらに増えます。\nどうか、武器をおさめてください。", "face": "l208dea54255d"}, {"name": "イグニス", "text": "……分かった。アタシ達は撤退する。\nだから……この島には手を出さないと約束してくれ。", "face": "u396"}, {"name": "アンナ", "text": "もちろんです。\n元より私達には危害を加えるつもりは\nないのですから。", "face": "l208dea54255d"}, {"name": "イグニス", "text": "それじゃあ、私についてきて。\n大長老の許へ行き、アタシ達の協約を伝えなきゃ！\nそうすることで争いを防げると思うんだ。", "face": "u396"}, {"name": "アンナ", "text": "わかりました。\nそれでは王子、行きましょう。"}]}], "active": true}