 "attack_range": 250, "attack_speed": 70, "attack_wait": 60, "attack_interval": 229, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101440, "race_id": 16, "special_effect_id": 222, "missile_id": 222, "missile": {"speed": 4.0, "splash": 120}, "master_id": 30529, "global_id": 4148, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "hp": 9100, "attack": 730, "base_hp": 13000, "base_attack": 730, "damage_type": "physical", "armor_defense": 100, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 343, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101360, "race_id": 16, "change_to": 8, "missile_id": 222, "missile": {"speed": 4.0, "splash": 120}, "master_id": 30530, "global_id": 4149, "ranged": true, "to_global_id": 4150, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 129}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 9100, "attack": 730, "base_hp": 13000, "base_attack": 730, "damage_type": "physical", "armor_defense": 100, "attack_range": 510, "attack_speed": 90, "attack_wait": 120, "attack_interval": 343, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101360, "race_id": 16, "special_effect_id": 222, "missile_id": 222, "missile": {"speed": 4.0, "splash": 120}, "master_id": 30531, "global_id": 4150, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 14000, "attack": 1200, "base_hp": 20000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 200, "attack_range": 300, "attack_speed": 75, "attack_wait": 75, "attack_interval": 199, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111280, "race_id": 16, "special_effect_id": 235, "missile_id": 220, "missile": {"speed": 8.0, "splash": 80, "slow": [40, 15]}, "master_id": 30532, "global_id": 4151, "ranged": true, "spawn_sec": 135}], "dialogue": [{"trigger": "start", "lines": [{"name": "イブキ", "text": "ふふっ、まさか王子軍を相手に戦う日がくるとは。\n英雄率いる歴戦の強者との戦い……相手にとって\n不足なし、実に楽しみだ。", "face": "u1511"}, {"name": "ジャンナ", "text": "あの、イブキさん？\n弾は水風船を使った船上演習ですからね？", "face": "u1154"}, {"name": "イブキ", "text": "ああ、もちろん把握している。\nこれなら怪我の心配もないし、\n気兼ねなく全力でぶつかれるというものだな！", "face": "u1511"}, {"name": "メル", "text": "演習部隊に砲術隊を選ぶなんてわかってるじゃない。\n王子には悪いけど、手加減はなしでやらせてもらうわよ！", "face": "u1199"}, {"name": "カノン", "text": "私も負けてられないわね。\n砲術士の学校で学んだ成果を見せてあげるわ。", "face": "u264"}, {"name": "フレデリカ", "text": "演習と言っても、\nやるからには負けるつもりはありません。\n海軍元帥の采配、期待させてもらいます。", "face": "u362"}, {"name": "イブキ", "text": "もちろんだ。\n新参者に指揮を執らせて頂き感謝している。\n采配、号令を以て私の実力を披露して見せよう。", "face": "u1511"}, {"name": "イブキ", "text": "私の号令に合わせ、皆存分に\nその全力を発揮して貰えればと思う。\nそれでは……演習開始だッ！", "face": "u1511"}]}, {"trigger": "end", "lines": [{"name": "イブキ", "text": "砲術士の皆、配置についたようだな。\nよし、私も出撃する！　『一斉射撃』開始！\n王子……勝負だッ！", "face": "u1511"}]}, {"trigger": "end", "lines": [{"name": "イブキ", "text": "……流石は王子。歴戦の手腕、見せてもらったよ。\nそして砲術隊の皆もありがとう。\n敗れはしたが、悔いの無い戦いができた。", "face": "u1511"}, {"name": "フレデリカ", "text": "王子たちの強さと指揮が一枚上手だったわね。\n……でも、イブキの指揮も流石だったわ。", "face": "u362"}, {"name": "カノン", "text": "そうね。負けたのは残念だけど、\n全力を尽くす、悔いの無い戦いができたわ。", "face": "u264"}, {"name": "メル", "text": "砲術士では無いけれど、\nイブキさんの大砲も良い武器ですね！", "face": "u1199"}, {"name": "ジャンナ", "text": "それにその大砲を使いこなす技術……\nイブキさんでしたら、砲術士としても\nやっていけそうな気がします。", "face": "u1154"}, {"name": "メル", "text": "そうだ！　イブキさんも砲術隊に入りませんか！\nイブキさんが入ってくれれば、\n戦力アップ間違いなしですよ！", "face": "u1199"}, {"name": "イブキ", "text": "砲の専門家である皆にお墨付きを頂けるとは光栄だ。\nだが、やはり私はこの海を守る一人として、\n今後とも皆の為に尽力していきたいと考えている。", "face": "u1511"}, {"name": "イブキ", "text": "誘いの申し出は嬉しいが、\nその誘いは謹んで断らせて頂こう。", "face": "u1511"}, {"name": "メル", "text": "そうですか……うーん、残念です。", "face": "u1199"}, {"name": "イブキ", "text": "ふふ、ありがとう。……王子、良ければもう少し、\n私たちで演習を続けさせてくれないか。\n今ならもっと良い連携ができそうだ。", "face": "u1511"}, {"name": "フレデリカ", "text": "そうね。だったら次はここをこうしたら……。", "face": "u362"}, {"name": "アンナ", "text": "……イブキさんと砲術隊の皆さん、\nすっかり意気投合したみたいで何よりです。\n王子、お疲れ様です。"}]}], "active": true}