{"quest_id": 7608, "name": "予選のライバル", "description": "砂漠の国で資格証を集める王子たちにメカ\nゴブリンクイーンが勝負を仕掛けてくる。\n＜出撃時の初期ＨＰ減少：中＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["出撃時の初期ＨＰ減少：中"], "event": "戦神からの招待状", "event_category": "History", "mission_id": 920176, "map_no": 4115, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [50], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 80, "attack_interval": 111, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103280, "special_effect_id": 227, "master_id": 425, "global_id": 424, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112080, "race_id": 9, "special_effect_id": 229, "missile_id": 6, "master_id": 31092, "global_id": 4711, "ranged": true, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112096, "race_id": 9, "special_effect_id": 229, "missile_id": 6, "master_id": 31093, "global_id": 4712, "ranged": true, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2112112, "race_id": 9, "special_effect_id": 229, "missile_id": 6, "master_id": 31094, "global_id": 4713, "ranged": true, "spawn_sec": 3}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 8000, "attack": 200, "base_hp": 8000, "base_attack": 200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 400, "attack_wait": 60, "attack_interval": 261, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114624, "race_id": 9, "special_effect_id": 293, "change_to": 5, "change_condition": 1, "missile_id": 26, "master_id": 31351, "global_id": 4970, "ranged": true, "variants": [{"tags": ["アーマー", "機械"], "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "magical", "armor_defense": 400, "magic_defense": 10, "attack_wait": 80, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114640, "race_id": 9, "master_id": 31352, "global_id": 4971}], "spawn_sec": 3}, {"enemy_id": 7, "source": "local", "count": 24, "form_count": 1, "tags": ["アンデッド"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 6}, {"enemy_id": 8, "source": "local", "count": 16, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 88}, {"enemy_id": 9, "source": "local", "count": 12, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098448, "race_id": 18, "special_effect_id": 220, "master_id": 96, "global_id": 95, "spawn_sec": 128}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 50000, "attack": 500, "base_hp": 50000, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 80, "attack_interval": 111, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 2.0999999046325684, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103280, "special_effect_id": 227, "master_id": 30781, "global_id": 4400, "spawn_sec": 166}], "dialogue": [{"trigger": "start", "lines": [{"name": "アサル", "text": "――えぇと、なるほど……？\n砂漠の国にマミーが大量発生したのは、\nその戦神マレス様が原因だと……。", "face": "u172"}, {"name": "ハシム", "text": "……困ったものだな。\n新兵どもが慌てふためいていたぞ。", "face": "u170"}, {"name": "ホルエス", "text": "マレス様、砂漠の神々には\nちゃんと許可を取っているのでしょうか……。", "face": "u149"}, {"name": "ネフティ", "text": "どう考えても無断でしょう。\n先程から、砂漠の空気が\nざわついているような気もします。", "face": "u551"}, {"name": "バラッド", "text": "……いや、原因はそれだけじゃねぇ。\nアンタ、気付いているか？", "face": "u173"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、さすがは王子ねぇ！\nこの距離から気づかれるなんて！", "face": "l0feebe8ca842"}, {"name": "メカゴブリンクイーン", "text": "それにしても、さっきは\n娘たちが迷惑をかけてしまったようね。", "face": "l0feebe8ca842"}, {"name": "ゴブリンプリンセス長女", "text": "お、お母さま、\nあれは私たちが勝利するために必要な――", "face": "ld8d5bb09ef4f"}, {"name": "メカゴブリンクイーン", "text": "おだまり！\n戦神の大祭に挑むのだから、\nちゃんと女王の娘らしく振る舞いなさい！", "face": "l0feebe8ca842"}, {"name": "ゴブリンプリンセス次女", "text": "は、はぃぃぃっ！", "face": "la6cd8f3be398"}, {"name": "メカゴブリンクイーン", "text": "さぁ王子、覚悟はいいかしらぁ？\n出場資格証を賭けて勝負よぉ！！", "face": "l0feebe8ca842"}, {"name": "ザラーム", "text": "王子、敵が来るぞ。\n亜神マレスに、お前の戦いを見せてやれ。", "face": "u175"}]}, {"trigger": "end", "lines": [{"name": "フーリ", "text": "……あっ、マミーが何か落としましたよ？\n出場資格証、でしょうか。", "face": "u174"}, {"name": "アスラハ", "text": "汚れて読めなくなっているが……。\n込められた魔力からして、間違いないだろう。", "face": "u1427a1"}, {"name": "メカゴブリンクイーン", "text": "ウフフ……やはり王子は只者じゃないわねぇ。\nますます欲しくなってしまうわぁ。", "face": "l0feebe8ca842"}, {"name": "ゴブリン博士", "text": "め、メカゴブリンクイーン様！\nサァ、次の魔物を倒しにいきますゾ！", "face": "lbbc2b31ad6b9"}, {"name": "ゴブリン博士", "text": "ココデ足踏みしていてハ、\n出場資格証ヲ集められませんからナ！！", "face": "lbbc2b31ad6b9"}, {"name": "ゴブリン博士", "text": "さぁ王子ヨ！　次の戦場へ向かうがヨイ！！", "face": "lbbc2b31ad6b9"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "シェミア", "text": "……王子殿下は、魔物とも友誼を結んでいるのですか。\nなんだか、千年戦争の頃を思い出しますね。", "face": "u1505a1"}, {"name": "シェミア", "text": "英雄王のもとに集ったのは人間だけでなく、\nありとあらゆる種族でしたから。", "face": "u1505a1"}, {"name": "アトナテス", "text": "その中に、堕天したお前もいたんだろ？\n思い出してきたぜ、人類を愛してしまったので\nちょっと堕天してきましたって言ってた天使がいたよな。", "face": "u908"}, {"name": "シェミア", "text": "…………あの頃は、私も向こう見ずだったもので。", "face": "u1505a1"}, {"name": "サナラ", "text": "あれ、さっきトラム様のこと、\n似たようなことを言ってからかっていたような――", "face": "u921"}, {"name": "シェミア", "text": "な、なんでもありません！\nさぁ、ピラミッドの奥へ向かいますよ！", "face": "u1505a1"}]}], "active": true}