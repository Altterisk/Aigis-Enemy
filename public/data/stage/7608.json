 "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 6}, {"enemy_id": 8, "source": "local", "count": 16, "form_index": 0, "form_count": 1, "hp": 2100, "attack": 400, "base_hp": 2100, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098256, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 77, "global_id": 76, "ranged": true, "spawn_sec": 88}, {"enemy_id": 9, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098448, "race_id": 18, "special_effect_id": 220, "master_id": 96, "global_id": 95, "spawn_sec": 128}, {"enemy_id": 10, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 50000, "attack": 500, "base_hp": 50000, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 80, "attack_interval": 111, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 2.0999999046325684, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103280, "special_effect_id": 227, "master_id": 30781, "global_id": 4400, "spawn_sec": 166}], "dialogue": [{"trigger": "start", "lines": [{"name": "アサル", "text": "――えぇと、なるほど……？\n砂漠の国にマミーが大量発生したのは、\nその戦神マレス様が原因だと……。", "face": "u172"}, {"name": "ハシム", "text": "……困ったものだな。\n新兵どもが慌てふためいていたぞ。", "face": "u170"}, {"name": "ホルエス", "text": "マレス様、砂漠の神々には\nちゃんと許可を取っているのでしょうか……。", "face": "u149"}, {"name": "ネフティ", "text": "どう考えても無断でしょう。\n先程から、砂漠の空気が\nざわついているような気もします。", "face": "u551"}, {"name": "バラッド", "text": "……いや、原因はそれだけじゃねぇ。\nアンタ、気付いているか？", "face": "u173"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、さすがは王子ねぇ！\nこの距離から気づかれるなんて！", "face": "l0feebe8ca842"}, {"name": "メカゴブリンクイーン", "text": "それにしても、さっきは\n娘たちが迷惑をかけてしまったようね。", "face": "l0feebe8ca842"}, {"name": "ゴブリンプリンセス長女", "text": "お、お母さま、\nあれは私たちが勝利するために必要な――", "face": "ld8d5bb09ef4f"}, {"name": "メカゴブリンクイーン", "text": "おだまり！\n戦神の大祭に挑むのだから、\nちゃんと女王の娘らしく振る舞いなさい！", "face": "l0feebe8ca842"}, {"name": "ゴブリンプリンセス次女", "text": "は、はぃぃぃっ！", "face": "la6cd8f3be398"}, {"name": "メカゴブリンクイーン", "text": "さぁ王子、覚悟はいいかしらぁ？\n出場資格証を賭けて勝負よぉ！！", "face": "l0feebe8ca842"}, {"name": "ザラーム", "text": "王子、敵が来るぞ。\n亜神マレスに、お前の戦いを見せてやれ。", "face": "u175"}]}, {"trigger": "end", "lines": [{"name": "フーリ", "text": "……あっ、マミーが何か落としましたよ？\n出場資格証、でしょうか。", "face": "u174"}, {"name": "アスラハ", "text": "汚れて読めなくなっているが……。\n込められた魔力からして、間違いないだろう。", "face": "u1427a1"}, {"name": "メカゴブリンクイーン", "text": "ウフフ……やはり王子は只者じゃないわねぇ。\nますます欲しくなってしまうわぁ。", "face": "l0feebe8ca842"}, {"name": "ゴブリン博士", "text": "め、メカゴブリンクイーン様！\nサァ、次の魔物を倒しにいきますゾ！", "face": "lbbc2b31ad6b9"}, {"name": "ゴブリン博士", "text": "ココデ足踏みしていてハ、\n出場資格証ヲ集められませんからナ！！", "face": "lbbc2b31ad6b9"}, {"name": "ゴブリン博士", "text": "さぁ王子ヨ！　次の戦場へ向かうがヨイ！！", "face": "lbbc2b31ad6b9"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "シェミア", "text": "……王子殿下は、魔物とも友誼を結んでいるのですか。\nなんだか、千年戦争の頃を思い出しますね。", "face": "u1505a1"}, {"name": "シェミア", "text": "英雄王のもとに集ったのは人間だけでなく、\nありとあらゆる種族でしたから。", "face": "u1505a1"}, {"name": "アトナテス", "text": "その中に、堕天したお前もいたんだろ？\n思い出してきたぜ、人類を愛してしまったので\nちょっと堕天してきましたって言ってた天使がいたよな。", "face": "u908"}, {"name": "シェミア", "text": "…………あの頃は、私も向こう見ずだったもので。", "face": "u1505a1"}, {"name": "サナラ", "text": "あれ、さっきトラム様のこと、\n似たようなことを言ってからかっていたような――", "face": "u921"}, {"name": "シェミア", "text": "な、なんでもありません！\nさぁ、ピラミッドの奥へ向かいますよ！", "face": "u1505a1"}]}], "map": {"image": "Map920176_4115", "w": 960, "h": 640, "spots": [{"k": "b", "x": 29, "y": 366}, {"k": "m", "x": 105, "y": 330, "id": 200}, {"k": "m", "x": 193, "y": 281, "id": 201}, {"k": "m", "x": 273, "y": 219, "id": 202}, {"k": "m", "x": 387, "y": 192, "id": 203}, {"k": "m", "x": 330, "y": 140, "id": 204}, {"k": "m", "x": 472, "y": 187, "id": 205}, {"k": "m", "x": 608, "y": 264, "id": 206}, {"k": "m", "x": 552, "y": 217, "id": 207}, {"k": "m", "x": 107, "y": 400, "id": 208}, {"k": "m", "x": 198, "y": 407, "id": 209}, {"k": "m", "x": 284, "y": 426, "id": 210}, {"k": "m", "x": 375, "y": 449, "id": 211}, {"k": "m", "x": 566, "y": 458, "id": 212}, {"k": "m", "x": 632, "y": 395, "id": 213}, {"k": "m", "x": 652, "y": 318, "id": 214}, {"k": "m", "x": 756, "y": 346, "id": 215}, {"k": "m", "x": 751, "y": 467, "id": 216}, {"k": "m", "x": 826, "y": 437, "id": 217}, {"k": "m", "x": 868, "y": 371, "id": 218}, {"k": "m", "x": 664, "y": 218, "id": 219}, {"k": "m", "x": 474, "y": 463, "id": 220}, {"k": "m", "x": 667, "y": 469, "id": 221}, {"k": "r", "x": 212, "y": 345, "id": 300}, {"k": "r", "x": 204, "y": 461, "id": 301}, {"k": "r", "x": 587, "y": 333, "id": 302}, {"k": "r", "x": 301, "y": 484, "id": 303}, {"k": "r", "x": 727, "y": 406, "id": 304}, {"k": "r", "x": 521, "y": 261, "id": 305}, {"k": "r", "x": 284, "y": 278, "id": 306}, {"k": "r", "x": 556, "y": 389, "id": 307}, {"k": "r", "x": 166, "y": 224, "id": 308}]}, "start_cost": 10, "active": true, "name_en": "Preliminary Rival", "description_en": "The Mech Goblin Queen challenges the Princes as they gather qualification certificates in the desert nation. <Initial HP reduction on deployment: Medium> Extreme (Target for ★1: Avg Lv25)"}