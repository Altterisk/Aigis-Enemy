{"quest_id": 7472, "name": "邪竜樹ユグドラシル", "description": "英雄は仲間と共に世界樹の災厄に挑む。\n皆で、次の千年を勝ち取るために――\n＜広域戦闘：敵味方の射程減少＞\n中級（★１獲得の目安：平均Lv1 出撃8体）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "未来へ架ける橋", "event_category": "History", "mission_id": 920168, "map_no": 4001, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 250, "gold": 1200, "drops": [{"card": 57, "c": 1}, {"card": 58, "c": 1}, {"card": 59, "c": 1}, {"card": 194}], "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 3, "tags": ["植物"], "hp": 500000, "base_hp": 500000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 1, "attack_wait": 600, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2131632, "change_to": 1, "missile_id": 627, "missile": {"speed": 8.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 900, "attack_interval_f": 900, "relief": true, "effect_name": "HitEffectSlow"}}, "master_id": 34185, "global_id": 7802, "to_condition": 0, "to_global_id": 7803, "commands": {"raw": "CallEvent(2258, 2259, 2260, 2261, 2262);"}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["植物"], "hp": 500000, "base_hp": 500000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 15, "attack_speed": 1, "attack_wait": 600, "attack_interval": 1404, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2131648, "change_to": 2, "missile_id": 627, "missile": {"speed": 8.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 900, "attack_interval_f": 900, "relief": true, "effect_name": "HitEffectSlow"}}, "master_id": 34186, "global_id": 7803, "from_condition": 0, "to_condition": 0, "to_global_id": 7801}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["植物", "ニーズヘッグ"], "hp": 500000, "attack": 3500, "base_hp": 500000, "