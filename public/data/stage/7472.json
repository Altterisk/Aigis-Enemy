 100, "pattern_id": 2131664, "special_effect_id": 887, "master_id": 34187, "global_id": 7804, "spawn_sec": 316}, {"enemy_id": 7, "source": "local", "count": 20, "form_index": 0, "form_count": 1, "tags": ["植物", "スライム"], "hp": 8500, "attack": 450, "base_hp": 8500, "base_attack": 450, "damage_type": "physical", "armor_defense": 200, "attack_range": 55, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131408, "special_effect_id": 872, "missile_id": 11, "master_id": 34174, "global_id": 7791, "ranged": true, "spawn_sec": 351}, {"enemy_id": 8, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["植物"], "hp": 22000, "attack": 600, "base_hp": 22000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 1, "attack_wait": 30, "attack_interval": 102, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2116192, "special_effect_id": 320, "master_id": 31315, "global_id": 4934, "route_behaviour": {"transforms": [{"wait": 10}], "creates_obj": 54, "creates_guest": 8}, "spawn_sec": 438}], "popups": ["同盟勢力が駆けつけました！\nクゥイル、メカゴブリンクイーンと\nレオナは邪竜樹ユグドラシルを\n優先的に攻撃する特殊な\n支援攻撃スキルを使用可能です！\n\n上記NPCは倒されても\n★の評価に影響しません。", "邪竜樹ユグドラシルは\n周囲の味方ユニット全員に\n攻撃を行います。\n\n\n\n\n　　　　　　(1/2)", "邪竜樹ユグドラシルの攻撃を\n受けると、味方ユニットの\n攻撃後の待ち時間が15秒に\n増加します。上記の効果は、\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。\n　　　　　　(2/2)"], "dialogue": [{"trigger": "enemy_death", "enemy_id": 1, "lines": [{"name": "クゥイル", "text": "邪竜樹ユグドラシル、動きが止まりました！", "face": "u702"}, {"name": "アナベラ", "text": "やれ！　やってしまえ王子！\n天界に喧嘩を売るんだ、こんな怪物くらいぶった斬れ！", "face": "u1309a1"}, {"name": "ラーワル", "text": "王子には、正義の味方がついてるよ。\n何も気にしなくていい、雑魚は全部薙ぎ払う！\nまっすぐ突っ込んでぶちかませー！", "face": "u1366a1"}, {"name": "ラタトスク", "text": "王子よ、どうか世界樹を救ってくれ。\n邪竜樹ユグドラシルを討つのじゃ……！！", "face": "u1375a1"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}]}, {"trigger": "battle", "at_sec": 30, "lines": [{"name": "レオナ", "text": "――あれが、世界樹の災厄とやらか？", "face": "u311"}, {"name": "ディアナ", "text": "なるほど、斬るには少々骨が折れそうですね。\n航空艦隊を出して正解でした。", "face": "u624"}, {"name": "白の皇帝", "text": "レオナ、飛空戦艦からの支援砲撃を指揮しろ。\nあの怪物を、森の外へ出すわけにはいかない。", "face": "u418"}]}, {"trigger": "battle", "at_sec": 31, "lines": [{"name": "メカゴブリンクイーン", "text": "ウフフ、中々可愛いじゃない。\nちょっと大きすぎるから、\nペットにするには難しいかしら？", "face": "l87c9090b9eaf"}, {"name": "ゴブリン博士", "text": "王子ヨ、我が魂の盟友ヨ！\nイツデモ指示を出すがヨイ！\nゴブリン軍団ノ援護射撃ヲ見せてヤロウ！！", "face": "lef44e21e3b0e"}]}, {"trigger": "battle", "at_sec": 32, "lines": [{"name": "リュクス", "text": "クゥイル、お待たせしました！\nグリフィン騎兵、いつでも出られますよ！", "face": "u550"}, {"name": "クゥイル", "text": "リュクスさん！　皆さんも……！？", "face": "u702"}, {"name": "リュクス", "text": "指揮はクゥイルに任せます。\nグリフィン騎兵の槍さばき、\n世界樹の災厄に見せてやりましょう。", "face": "u550"}, {"name": "クゥイル", "text": "ですね！　――総員、槍を構えよ！\nこれは世界樹を守護する戦い。\n物質界連合軍に後れをとるな！！", "face": "u702"}, {"name": "アナベラ", "text": "……あはは、なんだこれ。\n王子、いったいどれだけの勢力をたぶらかしたんだい？", "face": "u1309a1"}, {"name": "アナベラ", "text": "飛空戦艦まで引っ張り出して、\nこれじゃあまるで、戦争じゃないか！", "face": "u1309a1"}, {"name": "シビラ", "text": "――そうよ。\n次の千年を勝ち取るために、\n誰もが、諦めることなく生きられる世界のために。", "face": "u39"}, {"name": "シビラ", "text": "過去の清算でも、望まぬ戦でもなく、\nこれは私たちが\n未来のために挑む、新たなる千年戦争なのだから。", "face": "u39"}, {"name": "アナベラ", "text": "……ははっ、あははっ！\n本当に戦争を始めるつもりなら、有能な参謀の出番だ。\nぼくも嘆いている暇はなさそうだね。", "face": "u1309a1"}, {"name": "ラーワル", "text": "それで、作戦名は？\n正義の味方としては、カッコイイ名前が良いと思うけど！", "face": "u1366a1"}, {"name": "アナベラ", "text": "形態変化した以上、\nユグドラシルと呼ぶのも不自然か……。\nラーワル殿、何か良い案はないかな？", "face": "u1309a1"}, {"name": "ラーワル", "text": "えぇっ、僕！？\nそうだなぁ……じゃあ王子、耳貸して？", "face": "u1366a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "王子、敵が動き始めます。\n全軍の指揮をお願いします！", "face": "l6776721ae19f"}, {"name": "王子", "text": "――世界樹の災厄は、今や手の届く場所にある。\nそれを討つ力もまた、俺たちの手の中にある。", "face": "u1"}, {"name": "王子", "text": "皆、剣をとれ。\n邪竜樹ユグドラシルを討ち、未来を掴むのは、俺たちだ。", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "フローガ", "text": "魔物の気配が消えていきます……。\n邪竜樹ユグドラシルも、崩壊が始まっているようです！", "face": "u878"}, {"name": "アナベラ", "text": "……見ろ、王子。\n世界樹から、光の橋が伸びていく。", "face": "u1309a1"}]}, {"trigger": "end", "lines": [{"name": "アナベラ", "text": "これが創造神が物質界に残してくれた、\n天界に――オリュンポスに繋がる橋、ビフロスト。", "face": "u1309a1"}, {"name": "ラーワル", "text": "おぉー！　すごいっ、すごくないっ？\nどこまでも空に向かってのびてくよ！", "face": "u1366a1"}, {"name": "ラタトスク", "text": "……吾輩の使命も、ようやく完遂じゃな。\n創造神の遺構は、無事に人類の手に渡ったのだからの。", "face": "u1375a1"}, {"name": "マリレーヌ", "text": "では、今後はどうなさるのですか？", "face": "u1354a1"}, {"name": "ラタトスク", "text": "そうじゃのー。\n世界樹の面倒でも見つつ、王国を手伝うのも悪くないのう。", "face": "u1375a1"}, {"name": "ラーワル", "text": "えぇっ、じゃあ僕も！\n正義をなせ！　って言われてきたし、\n遠慮なく王子の味方になっちゃおうかな♪", "face": "u1366a1"}, {"name": "アンナ", "text": "……この橋を超えれば、\n障壁に阻まれることなく、\nオリュンポスにたどり着けるのですね。", "face": "l6776721ae19f"}, {"name": "アンナ", "text": "もう、迷うことはありません。\n亜神との戦い、天界との戦いであっても。", "face": "l6776721ae19f"}, {"name": "アンナ", "text": "これは押し付けられた戦いではなく、\n私たちが未来を勝ち取るために、望んだ戦いなのですから。", "face": "l6776721ae19f"}, {"name": "王子", "text": "――ああ、俺たちは諦めない。\n皆、これからも、俺に力をかしてくれ。", "face": "u1"}]}, {"trigger": "route", "lines": [{"name": "ラーワル", "text": "邪竜樹ユグドラシル、近づいてきてるよ！\nうっわぁ、ちょっとデカすぎないかなぁ！？", "face": "u1366a1"}, {"name": "ラタトスク", "text": "ユグドラシルめ、いったいどこで\nあんな姿を覚えてきたのじゃろうなぁ！？\nあれでは樹木というよりドラゴンじゃぞ！", "face": "u1375a1"}, {"name": "ラーワル", "text": "ドラゴン……？\nまさか、ニーズヘッグを模倣して……。", "face": "u1366a1"}, {"name": "アトナテス", "text": "ラーワル、手を貸せ！\nこいつらまとめて焼き払うぞ！", "face": "u908"}, {"name": "ラーワル", "text": "あっ、う、うん！　わかったよアトにぃ！\nうおー！　こっちの前線はまかせろー！！", "face": "u1366a1"}]}, {"trigger": "route", "lines": [{"name": "アンナ", "text": "邪竜樹ユグドラシル、拠点の目前です！\nこのままでは森を突破されます！！", "face": "l6776721ae19f"}, {"name": "白の皇帝", "text": "王子、苦戦しているようだな。", "face": "u418"}, {"name": "白の皇帝", "text": "貴様の力を見せてみろ。\n女神ケラウノスを討ち、魔王ガリウスを討ち、\n今や天界にすら戦いを挑む、英雄の力を。", "face": "u418"}]}], "map": {"image": "Map920168_4001", "w": 960, "h": 640, "spots": [{"k": "b", "x": 894, "y": 426}], "events": [{"t": 30.0, "when": "time", "ops": [{"op": "+fx", "name": "obj_11", "fx