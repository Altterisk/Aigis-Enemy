my_id": 18, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4800, "attack": 550, "base_hp": 6000, "base_attack": 550, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 30, "attack_interval": 105, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104320, "race_id": 14, "change_to": 17, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 21532, "global_id": 1815, "ranged": true, "from_condition": 0}, {"enemy_id": 20, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 8000, "attack": 560, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105152, "race_id": 14, "change_to": 20, "change_condition": 5, "master_id": 604, "global_id": 603, "phases": [{"hp": 8000, "attack": 560, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "master_id": 605, "global_id": 604, "condition": 5}], "spawn_sec": 156}], "popups": ["第二形態の玉兎は\n2000ダメージ以下の\nあらゆる攻撃を受け付けません。\n\n敵の攻撃力と防御力の\n上昇効果は消滅します。"], "dialogue": [{"trigger": "end", "lines": [{"name": "レーヴ", "text": "神獣玉兎の伝承どおりなら、\nこれから数年は豊作が約束されるはず。\n王国もますます繁栄しそうですね！", "face": "u454"}, {"name": "ミスリア", "text": "んー、んっんー？\nあれぇ、使えそうな素材が落ちてないなー。", "face": "u846"}, {"name": "キャラット", "text": "そりゃまぁ、ドラゴンみたいに鱗があったり、\n獰猛な獣みたいに牙があったりするわけじゃないし……。", "face": "u593"}, {"name": "ミスリア", "text": "残念むねんー。\nせっかく新装備を作ろうと思ったのに――あれっ？", "face": "u846"}, {"name": "ミスリア", "text": "ほほう、これは……ふむふむ、ふふーん。", "face": "u846"}, {"name": "キャラット", "text": "あれ……？\nそれって、玉兎の着ていた衣装と同じもの？", "face": "u593"}, {"name": "ミスリア", "text": "ふっふー、神獣玉兎のお着物げっとー♪\nこれは複製品というか、人間用サイズかな？\nすっごい魔力を感じるよー！", "face": "u846"}, {"name": "レーヴ", "text": "えっ……神獣の衣装貰っちゃったんですか！？", "face": "u454"}, {"name": "シュシュ", "text": "わわ、何かまずいことでも……？", "face": "u656"}, {"name": "レーヴ", "text": "むしろその逆ですね……。\n祝祭を執り行う玉兎の神官は、同じ装いをするもの。\nつまり王子は玉兎の神官に任命されちゃったみたいです。", "face": "u454"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "レーヴ", "text": "また目覚めた時は、ぜひとも相手をしてくれ、\nということではないかなーっと……。", "face": "u454"}, {"name": "アンナ", "text": "神獣にまで好かれてしまうなんて、\n王子らしいというか、何というか……。"}, {"name": "ラテリア", "text": "ともあれ、縁起が良いことに変わりはないさ。\n王子、今年はきっといいことがあるに違いないよ。", "face": "u532"}]}, {"trigger": "route", "enemy_ids": [16], "lines": [{"name": "シュシュ", "text": "――あれ？\nなんだか玉兎さんの雰囲気が変わりました？", "face": "u656"}, {"name": "キャロップ", "text": "怒ってる……いや、興奮してる？", "face": "u698"}, {"name": "バイン", "text": "これが伝承にある、\n自分も戦いたくなっちゃったモードなんじゃない！？", "face": "u712"}, {"name": "レーヴ", "text": "王子、神獣玉兎が仲間への支援をやめて、\nこっちに突っ込んできます！", "face": "u454"}, {"name": "レーヴ", "text": "強力な障壁をまとっていますから、\n弱い攻撃では傷すら付けられないはずです。\n全力で火力を集中してください……！！", "face": "u454"}]}], "map": {"image": "Map9265", "w": 960, "h": 640, "spots": [{"k": "b", "x": 15, "y": 473}, {"k": "m", "x": 145, "y": 471, "id": 200}, {"k": "m", "x": 236, "y": 445, "id": 201}, {"k": "m", "x": 335, "y": 429, "id": 202}, {"k": "m", "x": 422, "y": 435, "id": 203}, {"k": "m", "x": 517, "y": 450, "id": 204}, {"k": "m", "x": 617, "y": 458, "id": 205}, {"k": "m", "x": 717, "y": 459, "id": 206}, {"k": "m", "x": 806, "y": 462, "id": 207}, {"k": "m", "x": 257, "y": 363, "id": 208}, {"k": "m", "x": 256, "y": 296, "id": 209}, {"k": "m", "x": 250, "y": 230, "id": 210}, {"k": "m", "x": 237, "y": 159, "id": 211}, {"k": "m", "x": 297, "y": 106, "id": 212}, {"k": "m", "x": 370, "y": 68, "id": 213}, {"k": "m", "x": 167, "y": 123, "id": 214}, {"k": "m", "x