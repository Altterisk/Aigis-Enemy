sin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 32, "global_id": 31, "ranged": true, "spawn_sec": 28}, {"enemy_id": 6, "source": "local", "count": 8, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 78}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30, "global_id": 29, "ranged": true, "spawn_sec": 100}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 200, "base_hp": 4500, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_range": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105376, "race_id": 16, "special_effect_id": 72, "change_to": 8, "change_condition": 2, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 639, "global_id": 638, "ranged": true, "spawn_sec": 119}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "hp": 2500, "attack": 600, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 27, "global_id": 26, "spawn_sec": 122}], "dialogue": [{"trigger": "start", "lines": [{"name": "ルマリア", "text": "ニコラウス様！？\n救援に来てくださったのですね！\nなんと心強い加勢でしょう。", "face": "u343"}, {"name": "ニコラウス", "text": "がっはっはっはっ！\nワシが来たからにはもう心配はいらんですぞ。\nさあ、共にラキュアを追い詰めましょうぞ！", "face": "u345"}, {"name": "ルマリア", "text": "はい！　ですが、気をつけてください。\n公爵様の言によれば、あのヴァンパイアは\n相当な力を有しています。", "face": "u343"}, {"name": "ルマリア", "text": "それに、普通の吸血鬼なら殺して灰にすれば、\nそのまま滅びるはずですが、\nあのヴァンパイアは蘇生を果たしています。", "face": "u343"}, {"name": "ニコラウス", "text": "それだけの蘇生力をもつということは、ヴァン\nパイアの中でも相当な上位種ということですな。", "face": "u345"}, {"name": "ルマリア", "text": "――ッ！\nあれは、ラキュア！\n氏族の者達も連れているようですね。", "face": "u343"}, {"name": "アンナ", "text": "ま、待って下さい！\n私達は貴方達の敵ではありません。\n人間です！　どうか、武器を収めて下さい！", "face": "lcbd0debec38a"}, {"name": "ニコラウス", "text": "ヴァンパイアの氏族が何を言うのかと思えば\nいうに事欠いて人間であるなどと……。", "face": "u345"}, {"name": "ルマリア", "text": "灰を集めてヴァンパイアを復活させ……、\n行動を伴にする……。\nそこから考えられる事は一つしかありません。", "face": "u343"}, {"name": "ルマリア", "text": "貴方たちヴァンパイアを、\nこのルマリアは絶対に赦しません！\nさあ、覚悟してください！！", "face": "u343"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "皆さん、もう争うのは止めて下さい！\n私達は敵ではありません！　そして、\nそれはラキュアさんも同じです。", "face": "lcbd0debec38a"}, {"name": "アンナ", "text": "貴方達を先導する公爵こそが、\nヴァンパイアであり、この争いの元凶なのです。\nどうか、私達の話を聞き入れて下さい！", "face": "lcbd0debec38a"}, {"name": "ニコラウス", "text": "公爵殿が……ヴァンパイア？\nだっはっは、これは参りましたな。\n久しぶりに笑わせて頂きましたぞ。", "face": "u345"}, {"name": "ルマリア", "text": "高き品性と人望厚き公爵様が、\n冷血なヴァンパイアですって……、\n愚弄するのもいい加減にして下さい！", "face": "u343"}, {"name": "ルマリア", "text": "貴方たちの戯れ言に付き合う暇はありません。\nニコラウス様、ここは一時撤退し\n公爵様に助力願いましょう。", "face": "u343"}, {"name": "ラキュア", "text": "…………行ってしまったな。\n公爵め、人心掌握の手管は完璧のようだ。\nしかし、彼らはいずれ公爵に……。", "face": "u344"}, {"name": "アンナ", "text": "悪い予感がします……。\n王子、彼らのあとを追いましょう！", "face": "lcbd0debec38a"}]}], "active": true}