{"quest_id": 4518, "name": "黒き崖壁", "description": "魔界アリの大群と、\nそこに混じる炎を放つ赤き個体に\n注意せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "莫邪の宝剣", "event_category": "History", "mission_id": 920062, "map_no": 3670, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 35, "level": 95, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 1, "master_id": 626, "global_id": 625, "to_global_id": 484, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "level": 95, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "master_id": 485, "global_id": 484}, {"enemy_id": 3, "source": "local", "count": 6, "level": 95, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 3, "master_id": 625, "global_id": 624, "to_global_id": 483, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "level": 95, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 7, "level": 95, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "master_id": 485, "global_id": 484, "to_global_id": 625, "spawn_sec": 4}, {"enemy_id": 2, "source": "local", "count": 1, "level": 95, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 1, "master_id": 626, "global_id": 625}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_speed": 90, "attack_wait": 30, "attack_interval": 191, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "change_to": 5, "master_id": 632, "global_id": 631, "to_global_id": 75, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 114}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098240, "race_id": 9, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 76, "global_id": 75, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "随分と高い場所まで登ってきましたね。\nいよいよ山道も佳境のようです。", "face": "l077ae4c90c18"}, {"name": "アサル", "text": "ひっ……！　み、皆さん、あれを！\n崖にびっしりと魔界アリが……！", "face": "u172"}, {"name": "スクハ", "text": "どうやらここは魔界アリの巣と\n化しているようですね。", "face": "u341"}, {"name": "エレイン", "text": "ウソでしょう……？\nいったいどれだけの数を相手にしなきゃ\nいけないって言うのよぉ……。", "face": "u36"}, {"name": "スクハ", "text": "ですがここを通らなくては、妖虎仙の許に辿り\n着けません……。本当に申し訳ありません。\n巻き込んでしまって……。", "face": "u341"}, {"name": "エレイン", "text": "なッ、何言っちゃってるのよスクハちゃん！\nあんまり私を見くびらないで。まだやれるわ！\nはぁッ！！　槍騎兵エレイン、推して参るーっ！　", "face": "u36"}, {"name": "スクハ", "text": "エレインさん……。\n（とても疲れているはずなのに、\n本当になんとお礼を言っていいか……。）", "face": "u341"}, {"name": "アンナ", "text": "王子、私達も続きましょう！\n力を合わせ、この死地を脱するのです！", "face": "l077ae4c90c18"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "敵影、すべて消失。\nやりましたね、魔界アリを退けたようです！\n本当にお疲れ様でした、王子。"}, {"name": "エレイン", "text": "はぁ……はぁ、ど、どうよスクハちゃん？\nわ、私だってこれくらい、やれるんだから。\nあまり見くびらないで……！", "face": "u36"}, {"name": "スクハ", "text": "エレインさんの勇姿、しかとこのスクハの目に\n焼き付けました。その武勇と知略ゆえに、\nあの勇敢な王子の仲間たり得るのでしょうね。", "face": "u341"}, {"name": "エレイン", "text": "見直した？　ふふーん、じゃあ当分は真剣に\nやるのやーめた……って言いたいところだけど\n妖虎仙との対決は間近に迫ってるんだよね？", "face": "u36"}, {"name": "スクハ", "text": "恐らくは間違いないかと。祖国に着くのが先か\n妖虎仙が現れるのが先か――えッ？　急に、\n莫邪の剣が光り出して……きゃぁっ――", "face": "u341"}, {"name": "スクハ", "text": "――ッあ、く……か、干将は……ドコ……？\n干将に……アイタイ……。ワタシの夫……。", "face": "u341"}, {"name": "アンナ", "text": "スクハさん？　だ、大丈夫ですか？\n干将……？　まさか宝剣に宿る魂が、\nスクハさんの身に何か影響を……？", "face": "l077ae4c90c18"}, {"name": "スクハ", "text": "――……くぁッ、あ……はぁ、はぁ、私は……\nいま何が……宝剣の想念が急に入り込んで……\n妖虎仙が近くにいるのですね……。", "face": "u341"}, {"name": "アンナ", "text": "妖虎仙との対決は近いですね、王子。\n干将莫邪の神秘と因果……そして妖虎仙。\n全てに決着をつけるため、今は進みましょう。", "face": "l077ae4c90c18"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "ふぉっふぉっふぉ、見つけたぞ皇女スクハ。\n干将もさぞや嬉しかろう。見えるか？　お前と、\nわしの妻が。ああ……もうすぐじゃ……。", "face": "ldbcf6253dbff"}]}], "active": true}