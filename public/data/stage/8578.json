d": 38836, "global_id": 12453}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["猫", "ステルス"], "hp": 2800, "attack": 200, "base_hp": 2800, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 45, "attack_wait": 50, "attack_interval": 198, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160064, "race_id": 13, "special_effect_id": 2052, "change_to": 4, "master_id": 38699, "global_id": 12316, "from_condition": "sp_change"}, {"enemy_id": 6, "source": "local", "count": 19, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 6, "master_id": 485, "global_id": 484, "to_global_id": 625, "spawn_sec": 94}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 5, "master_id": 626, "global_id": 625}, {"enemy_id": 8, "source": "local", "count": 3, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 8, "master_id": 986, "global_id": 985, "to_global_id": 987, "spawn_sec": 97}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "change_to": 7, "master_id": 988, "global_id": 987}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "hp": 8000, "base_hp": 8000, "damage_type": "physical", "armor_defense": 120, "attack_speed": 1, "attack_wait": 120, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126016, "race_id": 18, "special_effect_id": 774, "master_id": 38830, "global_id": 12447, "spawn_sec": 142}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 900, "base_hp": 6000, "base_attack": 900, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 77, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112544, "race_id": 18, "master_id": 30694, "global_id": 4313, "spawn_sec": 238}], "popups": ["ココンから攻撃を受けると、\n攻撃後の待ち時間が\n大幅に増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。", "スズムシの魔物が\n特定の位置に到着すると\n鳴き始め全ての敵の\nHPが徐々に回復します。\n\n鳴き止むと\n回復効果は無くなります。", "碧羽の魔蝶は、一定範囲内に\n存在する味方ユニットを\n時間経過で麻痺状態にします。\n\nまた、一定確率で\n物理攻撃を回避します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "蟲王国のエース、どんな方なのでしょうか。"}, {"name": "ハニービー", "text": "ふふ、それは見てのお楽しみね。\nおっ、いたいた。ココンちゃーん！", "face": "u2466a1"}, {"name": "ココン", "text": "んー。", "face": "l12314f6975de"}, {"name": "チェルシー", "text": "（わぁ、綺麗な女の子……）", "face": "u2369a1"}, {"name": "ココン", "text": "ビーねえさん、その人たちが？", "face": "l12314f6975de"}, {"name": "ハニービー", "text": "そう、戦神マレス様も認める王国の王子ちゃん御一行。", "face": "u2466a1"}, {"name": "ココン", "text": "そっか、間に合ったんだね。", "face": "l12314f6975de"}, {"name": "アンナ", "text": "（間に合った……？）", "face": "l8cb4348c8c2b"}, {"name": "ココン", "text": "……それなら、私も役目を果たさないとだね。", "face": "l12314f6975de"}, {"name": "ココン", "text": "こんにちは、王国の王子様。", "face": "l12314f6975de"}, {"name": "王子", "text": "…………(こんにちは)", "face": "u1"}, {"name": "ココン", "text": "私の名前はココン、蟲の森の繭守。\n戦神コロッセウムのルールに則り、\n貴方たちに勝負を挑ませてもらう。", "face": "l12314f6975de"}, {"name": "ハニービー", "text": "さあ、次鋒戦の始まりよ！", "face": "u2466a1"}]}, {"trigger": "end", "lines": [{"name": "ハニービー", "text": "そこまでね。ココンちゃん、大丈夫？", "face": "u2466a1"}, {"name": "ココン", "text": "うん、ビーねえさんの言った通りだった。", "face": "l12314f6975de"}, {"name": "ハニービー", "text": "だから言ったでしょ、心配無用だって。", "face": "u2466a1"}, {"name": "ココン", "text": "別に私だって疑ってたわけじゃない。\nだけど、先入観は野生の勘を鈍らせる。", "face": "l12314f6975de"}, {"name": "ハニービー", "text": "それで、どう？", "face": "u2466a1"}, {"name": "ココン", "text": "……これなら、託せる。", "face": "l12314f6975de"}, {"name": "チェルシー", "text": "すみません、先程から何の話を……。", "face": "u2369a1"}, {"name": "ハニービー", "text": "……ああ、ごめんなさい。\n実は戦神コロッセウムで蟲王国の\n宣伝をしたいって話は嘘なの。", "face": "u2466a1"}, {"name": "ココン", "text": "私は蟲王国なんて口にするのも嫌。あそこは私たちの森。", "face": "l12314f6975de"}, {"name": "ラタトスク", "text": "……ふむ、説明してもらえるかの。", "face": "u1375a1"}, {"name": "ハニービー", "text": "蟲王国……いいえ、私たちの暮らしている森は、\n数か月前に現れた女王によって支配されているわ。", "face": "u2466a1"}, {"name": "ハニービー", "text": "女王は森の蟲たちを操って軍備を整えている。\nそして、その標的は王国……王子ちゃんたちよ。", "face": "u2466a1"}, {"name": "王子", "text": "────！？", "face": "u1"}, {"name": "ココン", "text": "戦神コロッセウムは王国を森に呼ぶための建前。", "face": "l12314f6975de"}, {"name": "ココン", "text": "王子……貴方たちに、戦ってほしい相手がいる。", "face": "l12314f6975de"}]}, {"trigger": "end", "lines": [{"name": "コウメ", "text": "あ、シナトさん。コマちゃん知りませんか？\nちょうちょを追ってどっか行っちゃって。", "face": "u1312a1"}, {"name": "シナト", "text": "またぁ？", "face": "u773"}]}], "active": true}