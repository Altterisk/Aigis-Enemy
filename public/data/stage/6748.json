{"quest_id": 6748, "name": "浮遊する巨兵", "description": "アンデッドの目撃報告を受け遺跡を訪れた\n王子一行。しかし、遺跡には亡者だけで\nなく未知のゴーレムまで眠っていた！？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ23(2019)", "event_category": "Reproduce", "mission_id": 300232, "map_no": 5815, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 120000, "base_hp": 120000, "damage_type": "magical", "armor_defense": 3000, "magic_defense": 35, "attack_speed": 1, "attack_wait": 120, "attack_interval": 342, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118368, "race_id": 5, "special_effect_id": 242, "change_to": 1, "change_condition": 5, "missile_id": 348, "missile": {"speed": 7.0}, "master_id": 31689, "global_id": 5308, "to_condition": 5, "to_global_id": 5309, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 120000, "attack": 7500, "base_hp": 120000, "base_attack": 7500, "damage_type": "magical", "armor_defense": 3000, "magic_defense": 35, "attack_range": 250, "attack_speed": 1, "attack_wait": 120, "attack_interval": 341, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2118368, "race_id": 5, "special_effect_id": 229, "missile_id": 348, "missile": {"speed": 7.0}, "master_id": 31690, "global_id": 5309, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 7, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 29}, {"enemy_id": 4, "source": "local", "count": 15, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 39}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 63}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 90}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 128}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 5000, "attack": 90, "base_hp": 5000, "base_attack": 90, "damage_type": "physical", "armor_defense": 50, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31428, "global_id": 5047, "ranged": true, "spawn_sec": 167}], "popups": ["飛行型アイアンゴーレムは\n拠点には向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リルケ", "text": "――へぇ、報告は本当だったみたいね。\nこの遺跡の奥、スケルトンだらけよ。", "face": "u330"}, {"name": "ティール", "text": "スケルトンが地上に溢れ出す前に\n発見できて良かったですねぇ……。\nうぅぅ、骨が動くのは何度見ても不気味ですよぉ……。", "face": "u615"}, {"name": "リルケ", "text": "ゴーレムだって、\n石とか金属とかが動いてるじゃない。\n似たようなものじゃないの？", "face": "u330"}, {"name": "ティール", "text": "ゴーレムとスケルトンは大違いですっ！\n問題は動いてるかどうかじゃなくて、\nスケルトンが骨で出来てることですからぁっ！", "face": "u615"}, {"name": "リルケ", "text": "そういうものなのかしら……。\n意思の無いものを動かすという意味では\nどちらも同じような気がするのだけれど。", "face": "u330"}, {"name": "ティール", "text": "うぅぅぅ……。\nリルケさんはおばけ怖くないんですかぁ……？", "face": "u615"}, {"name": "リルケ", "text": "怖いに決まってるでしょ！\n……じゃなくて、スケルトンはおばけじゃなくて、\nれっきとした魔物のひとつよ。", "face": "u330"}, {"name": "シャロン", "text": "……まぁまぁ。\n仲良く喧嘩するのは後にして、\nまずはスケルトンを倒しちゃいましょう？", "face": "u283"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ティール", "text": "そ、そうでした……。\nよぉし、頑張りま――", "face": "u615"}]}, {"trigger": "start", "lines": [{"name": "ティール", "text": "――わわー！？\nゴーレムも出てきましたよ……！？", "face": "u615"}, {"name": "リルケ", "text": "ティールがゴーレムの話をするからよ！\nそ、それにあのゴーレムおかしくない？\n空を飛んでるように見えるわ……！？", "face": "u330"}, {"name": "ティール", "text": "ゴーレムの話をしてきたのはリルケさんです！\n――それより、本当に飛んでますねあのゴーレム。", "face": "u615"}, {"name": "ティール", "text": "でも暴走している様子はありません。\nおそらくこの遺跡を巡回しているだけなので、\n攻撃しなければそのまま去っていくかと……！", "face": "u615"}, {"name": "アンナ", "text": "ゴーレムに攻撃しないよう、注意が必要ですね……。\n王子、慎重な采配をお願いします！", "face": "l6ad2d2ab4d1f"}]}, {"trigger": "end", "lines": [{"name": "リルケ", "text": "……ふぅ。\n何とかなったわね。", "face": "u330"}, {"name": "ティール", "text": "スケルトンは無事に討伐できましたけど、\nまさか飛行型ゴーレムがいるなんて\nぜんっぜん想像しませんでしたねぇ……。", "face": "u615"}, {"name": "リルケ", "text": "あら、怖かったの？", "face": "u330"}, {"name": "ティール", "text": "怖かったですよ！\n当たり前ですよー！！　もー！！", "face": "u615"}, {"name": "リルケ", "text": "ふふっ、私達はゴーレムの専門家なのに、\nゴーレムが怖いなんて不思議なものね。", "face": "u330"}, {"name": "リルケ", "text": "それよりティール、早く王国に帰って、\nあのゴーレムについての資料を探しましょ。\nほらほら、急いで急いで！", "face": "u330"}, {"name": "ティール", "text": "えっ、えっ、あっ、あのっ！　リルケさん！？\n引っ張らないでくださいー！？", "face": "u615"}, {"name": "アンナ", "text": "……それでは、我々も王国へ帰還しましょうか。\n王子、スケルトン討伐お疲れ様でした！"}]}], "story_talk": true, "active": true}