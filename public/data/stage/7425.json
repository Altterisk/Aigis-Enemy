or_defense": 200, "magic_defense": 50, "attack_range": 30, "attack_speed": 1, "attack_wait": 30, "attack_interval": 116, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130864, "special_effect_id": 242, "change_to": 5, "missile_id": 597, "missile": {"speed": 17.0, "on_hit": {"kind": "DOT", "duration_f": 1200, "interval_f": 30, "flat": 5, "expire_duration_only": true, "relief": true, "effect_name": "DebuffEffectPoison"}}, "master_id": 34068, "global_id": 7685, "ranged": true, "to_global_id": 7672, "route_behaviour": {"reroutes": ["Route=25", "Route=26", "Route=27", "Route=28", "Route=29", "Route=35", "Route=40", "Route=41", "Route=42", "Route=43", "Route=52", "Route=54", "Route=56", "Route=58", "Route=60", "Route=62", "Route=64", "Route=66", "Route=75", "Route=76", "Route=77"]}, "spawn_sec": 128}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 700, "base_hp": 8000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_range": 30, "attack_speed": 1, "attack_wait": 30, "attack_interval": 116, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130864, "missile_id": 597, "missile": {"speed": 17.0, "on_hit": {"kind": "DOT", "duration_f": 1200, "interval_f": 30, "flat": 5, "expire_duration_only": true, "relief": true, "effect_name": "DebuffEffectPoison"}}, "master_id": 34055, "global_id": 7672, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 24000, "attack": 350, "base_hp": 24000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2130848, "special_effect_id": 38, "master_id": 34054, "global_id": 7671, "spawn_sec": 204}], "popups": ["ダークエルフドルイドから攻撃を\n受けると「毒」状態になり、\n一定時間継続ダメージを受けます。\n\n複数のダークエルフドルイドから\n攻撃を受けた場合、\n継続ダメージ効果が重複します。\n　　　　　　(1/2)", "ダークエルフドルイドの\n毒によるダメージは、女神の加護や\n攻撃の無効化の影響を受けませんが\n状態異常に対するユニット能力で\n軽減や回復、無効化が可能です。\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "セグナンド", "text": "……初めて斬り結んだが、\nこれが帝国、そして王国の精鋭たちか。", "face": "l20ac59a2a223"}, {"name": "ダークエルフ", "text": "えぇ、人間にしておくには惜しい戦士ばかり――と、\nセグナンド様、何か良いことでもありましたか？", "face": "l0e68ae181da5"}, {"name": "セグナンド", "text": "……どういうことだ？", "face": "l20ac59a2a223"}, {"name": "ダークエルフ", "text": "いえ、まるで微笑んでいるように見えましたので。", "face": "l0e68ae181da5"}, {"name": "セグナンド", "text": "……気のせいだ。\nこれは我らが怒りを突き立てるための戦い、\n享楽のための戦ではないのだからな。", "face": "l20ac59a2a223"}, {"name": "セグナンド", "text": "敵の戦術、布陣も分かってきた。\n次は毒茨のドルイドたちを出せ。", "face": "l20ac59a2a223"}, {"name": "ダークエルフ", "text": "――はっ、セグナンド様。", "face": "l0e68ae181da5"}]}, {"trigger": "start", "lines": [{"name": "ハリナ", "text": "――まったく、セグナンドにも呆れたものだな。\n前線に出た時の、あの表情を見たか？", "face": "u988"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "ハリナ", "text": "あいつは根っからの戦闘狂だ。\n強者と戦うのが、楽しくて楽しくて仕方ない類のな。", "face": "u988"}, {"name": "ハリナ", "text": "むしろあいつこそ、\n白の帝国のやり方にふさわしい人材だろう。", "face": "u988"}, {"name": "レオナ", "text": "何が言いたいのか、手に取るように分かるぞ、ハリナ。\n白の帝国が、奴と同じ狂犬だと言っているのだろう。", "face": "u311"}, {"name": "ハリナ", "text": "ははっ、皮肉が分かる知能は残っていたか。\n――何、心配するな。\n私はこちら側で戦ってやろうとも。", "face": "u988"}, {"name": "レオナ", "text": "貴様がまっさきに裏切ると思っていたのだがな……。\nいったいどんな心境の変化だ？", "face": "u311"}, {"name": "ハリナ", "text": "それを教えてしまえば、お前を安心させてしまうだろう。\nせいぜい不安を抱えて日々を過ごすがいい、侵略者。", "face": "u988"}, {"name": "ハリナ", "text": "さて王子よ、貴君にはひとつ助言を授けよう。\nセグナンドたちダークエルフにも、\nドルイドと呼ばれる術者たちが存在する。", "face": "u988"}, {"name": "ハリナ", "text": "そろそろ、件のダークエルフドルイドを出してくるはずだ。\n連中は茨を振るい、戦士を毒で冒していく。\n兵に指示を出す時には、配置に注意するがよい。", "face": "u988"}]}, {"trigger": "end", "lines": [{"name": "ディアナ", "text": "……兵を引き上げました、か。\n次の激突に、全戦力を当てるつもりでしょうね。", "face": "u624"}, {"name": "マルゴット", "text": "ディアナ様、敵の采配が分かるのですか？", "face": "u1343a1"}, {"name": "ディアナ", "text": "――私ならそうする、ということです。\nまだセグナンドは手の内を見せていない、\nならば本気を出すのは、次の激突しかありません。", "face": "u624"}, {"name": "ディアナ", "text": "マルゴット、兵たちに交代で休息を。\nそれからあなたも、しばらく休んでおきなさい。", "face": "u624"}, {"name": "マルゴット", "text": "しかし、私はまだ――", "face": "u1343a1"}, {"name": "ディアナ", "text": "命令です、教導隊長。\nあれだけの艦隊を惜しみなく出してきた以上、\n敵の攻勢も、次が最後ではないはずですから。", "face": "u624"}, {"name": "マルゴット", "text": "は、はいっ。\n了解しました、ディアナ様！", "face": "u1343a1"}, {"name": "ディアナ", "text": "（……こんな戦いは、間違っています。\n民を巻き込むような反乱が、正しいはずがありません）", "face": "u624"}, {"name": "ディアナ", "text": "（誰もが己の欲望を、\n見せかけの正しさで覆い隠している……。\n亜神ハイドース、あなたは何を隠しているのですか）", "face": "u624"}]}], "active": true}