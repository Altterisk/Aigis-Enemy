type": "magical", "armor_defense": 60, "magic_defense": 30, "attack_range": 190, "attack_speed": 1, "attack_wait": 45, "attack_interval": 151, "move_speed": 300.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2121440, "race_id": 3, "change_to": 8, "change_condition": 2, "missile_id": 6, "master_id": 35487, "global_id": 9104, "ranged": true, "to_condition": 2, "to_global_id": 9105, "spawn_sec": 35}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 11000, "attack": 1000, "base_hp": 11000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 220, "magic_defense": 40, "attack_range": 190, "attack_speed": 1, "attack_wait": 45, "attack_interval": 151, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2121440, "race_id": 3, "change_to": 9, "change_condition": 2, "missile_id": 6, "master_id": 35488, "global_id": 9105, "ranged": true, "from_condition": 2, "to_condition": 2, "to_global_id": 9106}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 16000, "attack": 1500, "base_hp": 16000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 400, "magic_defense": 60, "attack_range": 190, "attack_speed": 1, "attack_wait": 45, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2121440, "race_id": 3, "special_effect_id": 222, "missile_id": 6, "master_id": 35489, "global_id": 9106, "ranged": true, "from_condition": 2}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "tags": ["植物"], "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 25, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2140704, "missile_id": 47, "master_id": 35481, "global_id": 9098, "ranged": true, "spawn_sec": 112}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 21000, "attack": 950, "base_hp": 21000, "base_attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 1, "attack_wait": 15, "attack_interval": 70, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110080, "master_id": 35486, "global_id": 9103, "spawn_sec": 224}], "popups": ["エスネア、エフネは倒されると\nその場で復活します。\n\n２回まで復活し、\n復活するたびに強くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "グレーテル", "text": "わぁ……なにここ、すごい……！", "face": "u1652a1"}, {"name": "ローズ", "text": "お菓子の家……いえ、これはお菓子の街？\nどうして森の奥深くこんな大規模なものが？", "face": "u1649a1"}, {"name": "グレーテル", "text": "待って、そこに誰か隠れてる。", "face": "u1652a1"}, {"name": "？？？", "text": "──へぇ、目敏いお嬢ちゃんじゃないかい。\nカワイイ見た目して、中々やり手みたいだね。", "face": "l00e7059bc459"}, {"name": "ハルモニア", "text": "……あなたが誘拐犯ですね、\nエスネアたちを解放しなさい。", "face": "u1651a1"}, {"name": "モーロン", "text": "誘拐犯だなんてよしとくれよ。\nあたしの名前はモーロン、\nお菓子が大好きなだけの普通の魔女さ。", "face": "l00e7059bc459"}, {"name": "ヘレナ", "text": "モーロン……他人から魔力を奪い、\n無限にお菓子を生み出し歩くパティスリー。\nマズゥに並ぶ、災厄の魔女の一人だな？", "face": "u1397a1"}, {"name": "コーネリア", "text": "……エスネアたちを攫ったのも、\n魔力を奪ってお菓子を作るためか。", "face": "u725"}, {"name": "モーロン", "text": "知ってるかい？　心が汚れちまった大人の魔力より、\n純粋な子の魔力の方が美味しいお菓子を作れるんだよ。\nだから、ちょいとお手伝いをしてもらおうと思ってね。", "face": "l00e7059bc459"}, {"name": "エスネア", "text": "つかまえなきゃ、つかまえなきゃ。", "face": "u997"}, {"name": "エフネ", "text": "あなたも、おいしいおかしに、なりませんか。", "face": "u969"}, {"name": "ハルモニア", "text": "エスネア！？　エフネ！", "face": "u1651a1"}, {"name": "モーロン", "text": "呼び掛けても無駄さ！\nこの子たちはあたしのお菓子の虜！\nあんたの声なんて聞こえないよ！", "face": "l00e7059bc459"}, {"name": "ローズ", "text": "……魔力からお菓子を生み出す力と、\nお菓子を操る力、お菓子を食べた者を魅了する力。\nこの三つが、モーロンの能力のようですね。", "face": "u1649a1"}, {"name": "ハルモニア", "text": "……エスネア、エフネ、ヘンゼルも。\nすぐに目を覚まさせてあげますからね。", "face": "u1651a1"}, {"name": "モーロン", "text": "はん、ちょうど新しいお菓子が完成したところさ。\nどこまで戦えるかお手並み拝見といこうじゃないか！", "face": "l00e7059bc459"}]}, {"trigger": "end", "lines": [{"name": "ハルモニア", "text": "今ですローズ！", "face": "u1651a1"}, {"name": "ローズ", "text": "はっ、はい！", "face": "u1649a1"}, {"name": "モーロン", "text": "はん、小手先で何をやったところで、\nあたしのお菓子の魅力からは逃れられ──", "face": "l00e7059bc459"}, {"name": "エスネア", "text": "にっがぁーーーーいっ！？\nなにこれなにこれなにこれ！？", "face": "u997"}, {"name": "エフネ", "text": "ぺっぺっぺっ！　\n口の中に変な草が──って、\nあれ？　どこですかここ？", "face": "u969"}, {"name": "モーロン", "text": "なっ──！？", "face": "l00e7059bc459"}, {"name": "グレーテル", "text": "お兄ちゃん、大丈夫……？", "face": "u1652a1"}, {"name": "ヘンゼル", "text": "ああ、大丈夫だよ。心配を掛けたね……。", "face": "u1622a1"}, {"name": "ハルモニア", "text": "……良薬とは口に苦きもの、\n甘い夢から覚めるには丁度良いでしょう。\nさすがは王宮薬草師、見事な手際です。", "face": "u1651a1"}, {"name": "ローズ", "text": "あはは……急ごしらえですが、なんとかなりました。", "face": "u1649a1"}, {"name": "コーネリア", "text": "あとは首謀者を捕まえれば終わりだな。", "face": "u725"}, {"name": "ヘレナ", "text": "いや、そう簡単な話ではなさそうだぞ。\nいつの間にか街の真ん中に誘い込まれている。\nまあ要約するとあれだな、全周包囲ってやつだ。", "face": "u1397a1"}, {"name": "ドリー", "text": "大ピンチじゃねぇか！？", "face": "u1399a1"}, {"name": "ヘレナ", "text": "寡兵に対し、お菓子の大量生産によるゴリ押しか。\n優雅さには欠けるが、確かにこれ以上の策はないな。", "face": "u1397a1"}, {"name": "モーロン", "text": "調子に乗ったね、お嬢さん方！\nあんたら全員お菓子にしてやるよ！", "face": "l00e7059bc459"}]}], "active": true}