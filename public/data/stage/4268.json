{"quest_id": 4268, "name": "封妖の忍者", "description": "王子の前に立ちふさがる強敵\nナギ率いる忍者軍団に打ち勝て！\n\n極級（★１獲得の目安：平均Lv25）", "event": "妖怪大戦", "event_category": "History", "mission_id": 920040, "map_no": 3561, "level": 100, "multiplier": 1.0, "charisma": 100, "exp": 400, "gold": 1700, "drops": [{"item": 5003, "c": 3}, {"card": 1654, "c": 1}, {"card": 126, "c": 1}, {"card": 206, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 15, "form_index": 0, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["忍者"], "hp": 900, "attack": 190, "base_hp": 900, "base_attack": 190, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100032, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 212, "global_id": 211, "ranged": true, "spawn_sec": 11}, {"enemy_id": 3, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["忍者"], "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 160, "attack_speed": 37, "attack_wait": 5, "attack_interval": 47, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098816, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 123, "global_id": 122, "ranged": true, "spawn_sec": 33}, {"enemy_id": 4, "source": "local", "count": 1, "level": 120, "form_index": 0, "form_count": 1, "tags": ["忍者"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 51, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099984, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 209, "global_id": 208, "ranged": true, "spawn_sec": 87}, {"enemy_id": 5, "source": "local", "count": 2, "level": 80, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 4000, "attack": 750, "base_hp": 4000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098832, "race_id": 16, "master_id": 124, "global_id": 123, "spawn_sec": 93}], "dialogue": [{"trigger": "start", "lines": [{"name": "イナリ", "text": "ぬらりひょんの復活で、強い妖怪も\n現れ始めちゃってるみたいだね。", "face": "u243"}, {"name": "アンナ", "text": "王子、ぬらりひょんは東の国の都に\n根城を構えているという報告を受けました。\n急ぎましょう！", "face": "l3ce37df4acc6"}, {"name": "ナギ", "text": "待っていたぞ。\nお前たちが集めている封印の札、\nそれを渡してもらおう。", "face": "u1244"}, {"name": "アンナ", "text": "封印の札をどうするおつもりですか？", "face": "l3ce37df4acc6"}, {"name": "ナギ", "text": "知れたこと。ぬらりひょん様に献上する。", "face": "u1244"}, {"name": "イナリ", "text": "操られてしまっている今、\nあの子には何を言っても無駄だと思うよ。", "face": "u243"}, {"name": "ナギ", "text": "……札を渡すつもりがないなら\n力ずくで奪うまでだ……！", "face": "u1244"}]}, {"trigger": "end", "lines": [{"name": "ナギ", "text": "……はッ！　私は、今まで何を……。\nくっ、操られてしまっていたのか。\n不覚だ……、おのれ妖怪め……！", "face": "u1244"}, {"name": "アンナ", "text": "あっ……！　行ってしまわれましたか……。", "face": "l3ce37df4acc6"}, {"name": "イナリ", "text": "あれー？　……あっ、思い出した！\n彼女って確か……、封妖の忍者とかって\n妖怪退治を専門にする忍者だね。", "face": "u243"}, {"name": "イナリ", "text": "人間に危害を加える妖怪を封印したり、\n妖怪が封印されている場所を守ったりしてるはず。\n封印の札もその一族が作ったものだね。", "face": "u243"}, {"name": "アンナ", "text": "なるほど。封印の札を管理している一族を操れば、\n封印の札を剥がすことも容易ですね……。", "face": "l3ce37df4acc6"}, {"name": "アンナ", "text": "って、なぜナギさんの事を知っているんですか？", "face": "l3ce37df4acc6"}, {"name": "イナリ", "text": "前に人間を驚かせて遊んでた時、\nあのナギちゃんに退治されそうになったんだ。\n化かして逃げてやったけどね♪", "face": "u243"}, {"name": "イナリ", "text": "それに封妖の忍者は妖怪たちの中では有名だよ。\n妖怪にとっては天敵みたいな物だから。", "face": "u243"}, {"name": "イナリ", "text": "さあさあ、そんなことよりさ\n彼女は都の中心部に行ったようだよ。", "face": "u243"}, {"name": "イナリ", "text": "ぬらりひょんもそこに\nいるんじゃないかな？\n王子、追いかけよっ！", "face": "u243"}]}], "map": {"image": "Map920040_3561", "w": 960, "h": 640, "spots": [{"k": "b", "x": 920, "y": 364}, {"k": "b", "x": 516, "y": 514}, {"k": "m", "x": 489, "y": 386, "id": 200}, {"k": "m", "x": 614, "y": 308, "id": 201}, {"k": "m", "x": 635, "y": 191, "id": 202}, {"k": "m", "x": 537, "y": 131, "id": 203}, {"k": "m", "x": 379, "y": 144, "id": 204}, {"k": "m", "x": 263, "y": 214, "id": 205}, {"k": "m", "x": 222, "y": 335, "id": 206}, {"k": "m", "x": 311, "y": 395, "id": 207}, {"k": "m", "x": 722, "y": 245, "id": 208}, {"k": "m", "x": 810, "y": 304, "id": 209}, {"k": "m", "x": 145, "y": 288, "id": 210}, {"k": "m", "x": 457, "y": 93, "id": 211}, {"k": "m", "x": 393, "y": 445, "id": 212}, {"k": "m", "x": 805, "y": 190, "id": 213}, {"k": "r", "x": 155, "y": 209, "id": 300}, {"k": "r", "x": 140, "y": 359, "id": 301}, {"k": "r", "x": 266, "y": 433, "id": 302}, {"k": "r", "x": 683, "y": 358, "id": 303}, {"k": "r", "x": 598, "y": 234, "id": 304}, {"k": "r", "x": 478, "y": 154, "id": 305}, {"k": "r", "x": 355, "y": 87, "id": 306}, {"k": "r", "x": 921, "y": 215, "id": 307}, {"k": "r", "x": 714, "y": 168, "id": 308}, {"k": "r", "x": 256, "y": 288, "id": 309}, {"k": "r", "x": 389, "y": 373, "id": 310}]}, "start_cost": 10, "active": tru