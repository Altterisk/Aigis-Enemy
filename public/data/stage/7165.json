{"quest_id": 7165, "name": "アラエルの脅威", "description": "アラエルとの戦いに勝利せよ！\n＜天界：攻撃力がダウン。\r\n　一部を除く敵味方のＨＰが徐々に回復＞\r\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["天界：攻撃力がダウン。\r\n　一部を除く敵味方のＨＰが徐々に回復"], "event": "縛られた空、解放の戦端", "event_category": "History", "mission_id": 920151, "map_no": 3482, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 45, "params": [100, -500]}, {"kind": "term", "influence": 41, "params": [0, 100, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}, {"kind": "term", "influence": 29, "params": [0, 20, 30], "expression": "(IsIdentitiy(\"アンデッド\") || IsRace(\"デーモン\")) == 0;", "expression_human": "not (it has the identity [[tag:アンデッド]] or its race is [[tag:デーモン]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124128, "race_id": 20, "change_to": 1, "change_condition": 4, "master_id": 32919, "global_id": 6536, "to_condition": 4, "to_ticks": 3, "to_global_id": 6539, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124144, "race_id": 20, "special_effect_id": 222, "master_id": 32922, "global_id": 6539, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 5, "source": "local", "count": 6, "form_count"