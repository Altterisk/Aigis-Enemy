ck": 700, "damage_type": "physical", "armor_defense": 450, "magic_defense": 40, "attack_range": 350, "attack_speed": 1, "attack_wait": 30, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125824, "race_id": 11, "special_effect_id": 619, "missile_id": 207, "missile": {"speed": 2.0}, "master_id": 32932, "global_id": 6549, "ranged": true, "spawn_sec": 203}, {"enemy_id": 28, "source": "local", "count": 1, "form_count": 1, "hp": 100000, "attack": 2800, "base_hp": 100000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_speed": 1, "attack_wait": 70, "attack_interval": 212, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2125808, "race_id": 6, "special_effect_id": 618, "master_id": 32931, "global_id": 6548, "spawn_sec": 203}], "popups": ["アラエルがいる間は、\n鳥人系の敵の攻撃と防御が\nアップします。", "アラエルが使役する霊鳥は\nあらゆる攻撃を受け付けません。\n\nアラエルの撃破、もしくは\nアラエルが拠点を通過すると\n消滅します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "パリオス", "text": "……アラエルさま。\n次のご命令を……。", "face": "l071c3621fe6f"}, {"name": "アラエル", "text": "……命令は変わりません。\nこの集落を殲滅するのです、僕の小鳥よ。", "face": "l7c04f1b6c641"}, {"name": "パリオス", "text": "…………はい。", "face": "l071c3621fe6f"}, {"name": "アラエル", "text": "次は僕も前線に出ましょう。\n神の実在を疑う者には、\n相応の罰を与えなければなりません。", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "罪深き者たちよ、これが最後の問いかけです。\n神を信じ、こちらへ下りなさい。\n僕らの神は滅んでなどいないのですから。", "face": "l7c04f1b6c641"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アラエル", "text": "……生意気な目です。\n信仰心のかけらも感じられない。", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "ならば、ここでその生命を終わらせましょう。\nただ、ただ祈り続けなさい、人の子らよ。", "face": "l7c04f1b6c641"}, {"name": "ライノー", "text": "王子殿、アラエル様は我ら空に生きる者の守護者。\n鳥や鳥人を強化する加護を持っている。", "face": "u1086a1"}, {"name": "ライノー", "text": "先程よりも激しい戦いとなることだろう。\nどうか、私たちに力を貸してほしい。", "face": "u1086a1"}]}, {"trigger": "battle", "at_sec": 215, "lines": [{"name": "アラエル", "text": "……どこまでも目障りな者共め。\nならば僕の子らを呼ぶとしましょうか。", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "霊鳥たちよ、神に仇なす者らを滅ぼすのです！", "face": "l7c04f1b6c641"}, {"name": "シャルロット", "text": "と、鳥さん、ですの？", "face": "u128"}, {"name": "ライノー", "text": "あれはアラエル様に仕える霊鳥だ。\nその生命は不滅で、倒すことができないという。", "face": "u1086a1"}, {"name": "シャルロット", "text": "どうやって倒すんですのそれー！？", "face": "u128"}, {"name": "ライノー", "text": "霊鳥たちはアラエル様の魔力で編まれている。\nアラエル様を倒せば、不滅ではなくなるはずだ。", "face": "u1086a1"}]}, {"trigger": "end", "lines": [{"name": "アラエル", "text": "僕の……僕の鳥たちが……。\nどうして……こんなことが……ッ！？", "face": "l7c04f1b6c641"}, {"name": "ライノー", "text": "アラエル様！　こちらへ！！\nもしかしたら精神支配を解くことが――", "face": "u1086a1"}, {"name": "アラエル", "text": "黙れぇぇぇ――ッ！！\n神なき今、僕たちが\n神の伝承を伝えなければならないんだッ！！", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "神の愛を！　あの御方の伝承を！\n後世の空に生きる者たちに伝えなければ！！", "face": "l7c04f1b6c641"}, {"name": "アラエル", "text": "僕がここで負けるわけには……ぐぅッ！\nあ、頭が割れそうだ……くそっ、くそぉぉぉッ！！", "face": "l7c04f1b6c641"}, {"name": "シャルロット", "text": "なんて強力な精神支配ですの……。\nこれでは一度解呪しても、\nまたすぐに支配されてしまいますわね……。", "face": "u128"}, {"name": "パリオス", "text": "……アラエルさま。\nアラエルさま、苦しそう……。", "face": "l071c3621fe6f"}, {"name": "パリオス", "text": "ぼくが、お助けしないと……。\nアラエルさまを、助けないと……。", "face": "l071c3621fe6f"}, {"name": "ライノー", "text": "パリオス……？\nいったい何をして――", "face": "u1086a1"}, {"name": "パリオス", "text": "……みんな、アラエルさまを連れて撤退するよ。\nこんなに苦しそうなの……可哀想、だもん……。", "face": "l071c3621fe6f"}, {"name": "アラエル", "text": "なっ……何をする！？\n僕はまだ戦える！\n神の愛を伝えなければいけないのに！", "face": "l7c04f1b6c641"}, {"name": "ライノー", "text": "くっ……やめろパリオス！\n行かないでくれ！！", "face": "u1086a1"}, {"name": "パリオス", "text": "ばいばい、ライノー。", "face": "l071c3621fe6f"}, {"name": "アンナ", "text": "……アラエル、撤退しました。\nパリオスさんや、他の操られた鳥人さんたちも。", "face": "l9a7c79d45da3"}, {"name": "ライノー", "text": "……パリオス。\nくそっ、私の、せいだ……。", "face": "u1086a1"}]}], "active": true}