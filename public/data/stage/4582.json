15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 122}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1250, "base_hp": 10000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 650, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099360, "race_id": 4, "master_id": 104, "global_id": 103, "spawn_sec": 151}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "伝令！\n斥候部隊が魔物の姿を確認！\n発見者によれば鬼の姿をしているとのことです！", "face": "l6240fb82ec01"}, {"name": "ヨジロウ", "text": "おおッ！？\nあの出で立ち、間違いのう酒呑童子の手下だ！\nいっちょオイがくらしつけてやる！　覚悟ぉッ！", "face": "u236"}, {"name": "チズル", "text": "待てヨジロウッ！\n無闇に飛び出しちゃ危ないって――。", "face": "u159"}, {"name": "ヨジロウ", "text": "ぐうぅッーー！？\n何だ、この強ぇ風は……\nこれじゃ近寄ることもできん……。", "face": "u236"}, {"name": "チズル", "text": "無理すんなヨジロウ。\n敵の放つ風技を見切れないようじゃあ\n怪我するだけだぜ。", "face": "u159"}, {"name": "ヨジロウ", "text": "面目ねぇ、チズルさん……。", "face": "u236"}, {"name": "チズル", "text": "いいってことよ！\nさってと、久しぶりに暴れてみるかねぇ……。", "face": "u159"}, {"name": "アンナ", "text": "王子、私達もチズルさんに続きましょう！\n急ぎ、戦いの準備をお願いします！", "face": "l15bcf247e4c0"}]}, {"trigger": "end", "lines": [{"name": "チズル", "text": "ふぅ、どうやら全て倒したようだな。\nあ～疲れた。今日は良い酒が飲めそうだぜ。", "face": "u159"}, {"name": "ヨジロウ", "text": "チズルさん、やっぱあんたはスゲえ侍だ！\nいっつも酒飲んで寝てるだけの\n益体なしじゃ無がったんだな？", "face": "u236"}, {"name": "チズル", "text": "お前、私のこと\nそんな風に思ってたのか……？", "face": "u159"}, {"name": "ヨジロウ", "text": "気を悪くしないでくれよ……そうだ！\n今日はオイが丹精込めて作った濁り酒を\nたっぷりと振る舞わせてくれ！", "face": "u236"}, {"name": "チズル", "text": "濁り酒だって！？　そいつぁ嬉しいねぇ！\nよし、そうと決まれば、とっとと帰ろうぜ！\nフドウのおっさんに飲まれる危険があるからな。", "face": "u159"}, {"name": "アンナ", "text": "お酒……ですか。\n祝い酒で済めばいいのですが……。", "face": "l483935b08d02"}, {"name": "チズル", "text": "お～い、王子、アンナぁ！！\n駄弁ってないで早く帰ろうぜー？\n今夜の酒宴は王子も主役の一人なんだからよ。", "face": "u159"}]}], "active": true}