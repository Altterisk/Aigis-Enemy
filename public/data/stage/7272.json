rm_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 10, "master_id": 33586, "global_id": 7203, "from_condition": 0, "to_condition": 0, "to_global_id": 7204}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 9800, "attack": 460, "base_hp": 9800, "base_attack": 460, "damage_type": "magical", "armor_defense": 120, "magic_defense": 10, "attack_range": 230, "attack_speed": 1, "attack_wait": 23, "attack_interval": 89, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127984, "race_id": 4, "missile_id": 169, "missile": {"speed": 15.0}, "master_id": 33587, "global_id": 7204, "ranged": true, "from_condition": 0}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 9800, "attack": 460, "base_hp": 9800, "base_attack": 460, "damage_type": "magical", "armor_defense": 120, "magic_defense": 10, "attack_range": 230, "attack_speed": 1, "attack_wait": 23, "attack_interval": 89, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127984, "race_id": 4, "missile_id": 169, "missile": {"speed": 15.0}, "master_id": 33582, "global_id": 7199, "ranged": true, "spawn_sec": 203}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "attack_range": 80, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113904, "race_id": 4, "special_effect_id": 232, "missile_id": 11, "master_id": 30900, "global_id": 4519, "ranged": true, "spawn_sec": 217}], "popups": ["錫杖を装備したカラス天狗は\n一度だけ攻撃を行います。", "スズネは\n特定のタイミングで\n変身します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "学生", "text": "ホムラっちさん！\nあのグレンってセンコー、ぶっ潰してやりましょう！", "face": "lc5c688b8f12d"}, {"name": "ホムラ", "text": "だ、だめだ！　それはダメだって！！\nっていうかオレはお前らの\nヘッドになったつもりはないんだからな！？", "face": "u1185a1"}, {"name": "学生", "text": "いやいや、ホムラっちさんは\n入学初日に粋がってた俺たちを、\n一撃でノックアウトした女番長じゃないっスか！", "face": "lc5c688b8f12d"}, {"name": "学生", "text": "あの日、あの時、\n学園の勢力図は塗り替えられたんスよ……！！", "face": "lc5c688b8f12d"}, {"name": "ホムラ", "text": "っるっせぇ！！\nそのホムラっちさんってのもやめろォ！？", "face": "u1185a1"}, {"name": "学生", "text": "な、なんでっスか！？\n最初に「ホムラっちって呼んでね♪」って\n言ったの、ホムラっちさんっスよ！？", "face": "lc5c688b8f12d"}, {"name": "ホムラ", "text": "あ、あれは学園デビューしようとして\n全力で失敗しただけなんだよ！\n普通にホムラって呼べ！　大馬鹿ども！！", "face": "u1185a1"}, {"name": "学生", "text": "じゃ、じゃあホムラサンで……。\nともかくホムラサン、\nあのグレンってセンコーだけは許せませんよ！", "face": "lc5c688b8f12d"}, {"name": "グレン", "text": "――へぇ、誰を許せないって？\nもう一度言ってみな、悪ガキども。", "face": "u1186a1"}, {"name": "学生", "text": "！？", "face": "lc5c688b8f12d"}, {"name": "学生", "text": "来やがったな……！？\n俺たちに言うこと聞かせようなんて百年早いぜ。\nホムラサン、やっちまいましょう！！", "face": "lc5c688b8f12d"}, {"name": "ホムラ", "text": "（お、親父！　なんでここに来るんだよ！！）", "face": "u1185a1"}, {"name": "グレン", "text": "（良いから、黙ってそいつらのヘッドごっこをしてな。\n悪いようにはしねェからよォ）", "face": "u1186a1"}, {"name": "グレン", "text": "テメェら、ホムラとナシは付けたぜ。\n互いに全力の喧嘩をして、\n負けた方は勝った方の舎弟になる。――どうだ？", "face": "u1186a1"}, {"name": "学生", "text": "ハッ、ナメてんじゃねーぞセンコー！\nやってやりましょうぜ、ホムラサン！！", "face": "lc5c688b8f12d"}, {"name": "グレン", "text": "よし、それじゃあ遠慮はしねェ。\nさぁ行くぜ、俺たちのヘッド――王子ッ！！", "face": "u1186a1"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "学生", "text": "なっ、なっ、なっ、なんだってー！？", "face": "lc5c688b8f12d"}]}, {"trigger": "end", "lines": [{"name": "学生", "text": "まさか……センコーたちが、\n俺たちに付き合ってステゴロしてくれるなんてな……。", "face": "lc5c688b8f12d"}, {"name": "グレン", "text": "ステゴロだったかちょっと自信はねェが……。\nだが、こういうのも悪くねェだろ？", "face": "u1186a1"}, {"name": "学生", "text": "ああ、いい気分だ……。\n約束どおり、俺たちは舎弟になるぜ……。", "face": "lc5c688b8f12d"}, {"name": "ホムラ", "text": "……ありがとな、親父。\n正直どうしていいか分かんなかったんだよ。", "face": "u1185a1"}, {"name": "グレン", "text": "やれやれ、馬鹿娘が。\nお前を慕って付いてきた連中だろう？\nなら、面倒みてやるのも甲斐性ってやつだ。", "face": "u1186a1"}, {"name": "ホムラ", "text": "でもオレはまだ一人前の天狗じゃ……。", "face": "u1185a1"}, {"name": "グレン", "text": "最初から一人前の大将なんざいねェよ。\n部下を率いる能力なんて、\n部下を実際に率いてみないと分かんねェもんさ。", "face": "u1186a1"}, {"name": "グレン", "text": "それに俺はもう、\nお前を一人前だと認めてるんだゼ？", "face": "u1186a1"}, {"name": "ホムラ", "text": "……うん、ありがと。", "face": "u1185a1"}, {"name": "グレン", "text": "さぁ王子、次はどこへ向かうんだ？\n本物のヘッドの器ってやつを見せてやりな。", "face": "u1186a1"}]}], "map": {"image": "Map920158_5916", "w": 960, "h": 640, "spots": [{"k": "b", "x": 941, "y": 149}, {"k": "b", "x": 943, "y": 473}, {"k": "m", "x": 105, "y": 409, "id": 200}, {"k": "m", "x": 215, "y": 143, "id": 201}, {"k": "m", "x": 233, "y": 232, "id": 202}, {"k": "m", "x": 192, "y": 320, "id": 203}, {"k": "m", "x": 235, "y": 419, "id": 204}, {"k": "m", "x": 343, "y": 452, "id": 205}, {"k": "m", "x": 469, "y": 454, "id": 206}, {"k": "m", "x": 596, "y": 453, "id": 207}, {"k": "m", "x": 706, "y": 418, "id": 208}, {"k": "m", "x": 745, "y": 322, "id": 209}, {"k": "m", "x": 708, "y": 231, "id": 210}, {"k": "m", "x": 595, "y": 192, "id": 211}, {"k": "m", "x": 470, "y": 192, "id": 212}, {"k": "m", "x": 343, "y": 190, "id": 213}, {"k": "m", "x": 839, "y": 220, "id": 214}, {"k": "m", "x": 840, "y": 416, "id": 215}, {"k": "r", "x": 133, "y": 208, "id": 300}, {"k": "r", "x": 89, "y": 308, "id": 301}, {"k": "r", "x": 281, "y": 313, "id": 302}, {"k": "r", "x": 464, "y": 259, "id": 303}, {"k": "r", "x": 658, "y": 319, "id": 304}, {"k": "r", "x": 464, "y": 381, "id": 305}, {"k": "r", "x": 752, "y": 151, "id": 306}, {"k": "r", "x": 856, "y": 319, "id": 307}, {"k": "r", "x": 760, "y": 484, "id": 308}]}, "start_cost": 10, "active": true, "name_en": "Homura, the Tengu Head", "description_en": "To seize the seat of the First Principal, he plunges into a fierce struggle.\nAs the first step toward dominance, take down Homura's delinquent gang! Extreme (★1 Target: Avg Lv25)"}