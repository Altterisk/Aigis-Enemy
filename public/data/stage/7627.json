"attack_wait": 10, "attack_interval": 77, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2126240, "change_to": 7, "change_condition": 1, "master_id": 33277, "global_id": 6894, "variants": [{"tags": ["ステルス"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113920, "master_id": 30917, "global_id": 4536}], "spawn_sec": 76}, {"enemy_id": 9, "source": "local", "count": 16, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 152, "global_id": 151, "spawn_sec": 81}, {"enemy_id": 10, "source": "local", "count": 14, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 119}], "popups": ["大魔女マズゥは、自身の攻撃力の値で\n自身を含む周囲の敵を回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ベルニス", "text": "さあ、追い詰めましたよ！　観念してください！", "face": "u1513a1"}, {"name": "マズゥ", "text": "さぁて？　追い詰められたのはどっちだろうね？", "face": "l47a1a66e1036"}, {"name": "スプリガン", "text": "うおぉー！！　コマちゃーん！！", "face": "l34839ebdf8c5"}, {"name": "小人", "text": "ご馳走！　ご馳走！　バンザーイ！", "face": "l8c2358acb990"}, {"name": "ベルニス", "text": "急に元気に！？　こらっ、待ちなさーい！", "face": "u1513a1"}, {"name": "マズゥ", "text": "魔女の工房に土足で踏み入った、\nその時点であんたらの負けは決まりさね。\nここには大量の呪いを仕掛けてあるのさ。", "face": "l47a1a66e1036"}, {"name": "ユーティ", "text": "いけません！？　王子だけでも外に──", "face": "u1514a1"}, {"name": "マズゥ", "text": "もう手遅れさ！　あんたらの命、\nあたしのために使わせてもらうよ！", "face": "l47a1a66e1036"}, {"name": "ユーティ", "text": "────ッ！", "face": "u1514a1"}, {"name": "王子", "text": "………………？", "face": "u1"}, {"name": "フーロン", "text": "……何も起きませんね。", "face": "u1512a1"}, {"name": "マズゥ", "text": "そっ、そんな馬鹿なことがあるかい！？\nここはあたしが何年も育て続けた工房だよ！\n強力な抗魔のアイテムでもない限り──", "face": "l47a1a66e1036"}, {"name": "コマ", "text": "──わふぅ？", "face": "u1515a1"}, {"name": "フーロン", "text": "……狛犬とは魔除けの守護獣。\n魔を拒む力が、あるそうですね？", "face": "u1512a1"}, {"name": "ヨシノ", "text": "始まっちゃう？　コマちゃん最強伝説。", "face": "u1104a1"}, {"name": "マズゥ", "text": "あ、あたしの魔術が……\nこんな犬っころにぃぃぃぃいッ！", "face": "l47a1a66e1036"}, {"name": "ユーティ", "text": "好機です！　みなさん攻撃準備を！\nさあ、コマちゃん！　号令をどうぞ！", "face": "u1514a1"}, {"name": "コマ", "text": "ぶ、ぶちかませー！", "face": "u1515a1"}]}, {"trigger": "end", "lines": [{"name": "コマ", "text": "こっ、狛犬パーンチ！", "face": "u1515a1"}, {"name": "フーロン", "text": "（へっぴり腰……！）", "face": "u1512a1"}, {"name": "マズゥ", "text": "いだっ！　いだだだッ！？\nやめっ、やめないかこの犬っころ！\n老人は労われって教わらなかったのかい！？", "face": "l47a1a66e1036"}, {"name": "マズゥ", "text": "ええい、もう頭に来た！\nこんなところにいられるかい！\nあたしは家に帰らせてもらうよ！", "face": "l47a1a66e1036"}, {"name": "デスピア", "text": "私がマズゥを追うわ！　\nみんなは囚われてる人たちをお願い！\n小人たちも逃がしちゃダメよ！", "face": "u49"}, {"name": "スプリガン", "text": "わぁ……ァ……！", "face": "l34839ebdf8c5"}, {"name": "コウメ", "text": "姫様、こいつ泣いてますよ。\nどうします？　処しちゃいます？", "face": "u1312a1"}, {"name": "ヨシノ", "text": "あはは！　コウメちゃん、私たちは東の国だよ？\nサムライ相手にこうも舐めた真似されちゃあ……ねぇ？", "face": "u1104a1"}, {"name": "シズカ", "text": "誰かー！　布と水持って来てー！", "face": "u101"}, {"name": "コマ", "text": "えっと、コマは何もされてないので、\nあんまり怖いことはしないでほしいなって……。", "face": "u1515a1"}, {"name": "ユーティ", "text": "はーい、コマちゃんはあっち行きましょうねー。", "face": "u1514a1"}, {"name": "フーロン", "text": "あの人たちもコマちゃんの手前ですし、\n本当に危なくなったら止めるでしょう、多分。", "face": "u1512a1"}, {"name": "ベルニス", "text": "それにしてもコマちゃんは大活躍でしたね。\n鎧じゃ呪いは防げませんから、大助かりです。", "face": "u1513a1"}, {"name": "ユーティ", "text": "コマちゃんはとっても偉いですねぇ……。", "face": "u1514a1"}, {"name": "コマ", "text": "えへへ！　コマはお役立ちの狛犬なので！", "face": "u1515a1"}, {"name": "ユーティ", "text": "（今回はコマちゃんのおかげで助かりましたが、\n拒魔の力は無敵でもなければ万能でもありません。\nあのレベルの魔女は必ず対策の対策をしてくるはず）", "face": "u1514a1"}, {"name": "ユーティ", "text": "（危険……いえいえ、\n今はみんなの無事を喜ばないとですね。\nお祭りは笑顔で迎えないと！）", "face": "u1514a1"}, {"name": "スプリガン", "text": "お助けぇぇぇえ！！！！", "face": "l34839ebdf8c5"}]}, {"trigger": "route", "enemy_ids": [4], "lines": [{"name": "マズゥ", "text": "この薬は未完成だから使いたくなかったけどね、\nここまでコケにされちゃあ、黙ってられないよ！", "face": "l47a1a66e1036"}, {"name": "デスピア", "text": "彼女は永遠の美貌を求めて、\n数多の女性を手に掛けた大魔女よ！\nおそらくあれは──若返りの薬！", "face": "u49"}, {"name": "フィリス", "text": "そうか……事件の被害者たちが、\n外傷は無いのに異様に衰弱していたのは、\nあの魔女に生気を吸い取られていたからか！", "face": "u40"}, {"name": "ユーティ", "text": "気をつけてください王子！\n今から戦うのは全盛期の大魔女です！", "face": "u1514a1"}]}], "active": true}