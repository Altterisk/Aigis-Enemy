{"quest_id": 7627, "name": "悪しき魔女マズゥ", "description": "事件の黒幕は悪名高き大魔女マズゥだった！\n魔女の企みを挫き、\n幸福なジューンブライドを取り戻せ！\n極級（★１獲得の目安：平均Lv25）", "event": "白無垢姫とたくさんの小人", "event_category": "History", "mission_id": 920177, "map_no": 4100, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 2, "hp": 7000, "attack": 900, "base_hp": 7000, "base_attack": 900, "damage_type": "physical", "armor_defense": 200, "magic_defense": 15, "attack_speed": 1, "attack_wait": 40, "attack_interval": 130, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137072, "race_id": 10, "special_effect_id": 54, "change_to": 1, "change_condition": 2, "master_id": 34918, "global_id": 8535, "to_condition": 2, "to_global_id": 8536}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 90000, "attack": 2500, "base_hp": 90000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 900, "magic_defense": 5, "attack_speed": 150, "attack_wait": 10, "attack_interval": 231, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137088, "race_id": 10, "master_id": 34919, "global_id": 8536, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 46, "form_count": 1, "hp": 3500, "attack": 600, "base_hp": 3500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 122, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137056, "special_effect_id": 54, "master_id": 34917, "global_id": 8534}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 3, "hp": 20000, "attack": 750, "base_hp": 20000, "base_attack": 750, "damage_type": "physical", "armor_defense": 40, "magic_defense": 20, "at