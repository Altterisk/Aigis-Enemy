p": 1600, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "attack_range": 100, "attack_speed": 70, "attack_wait": 50, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113952, "missile_id": 257, "missile": {"speed": 2.0}, "master_id": 30905, "global_id": 4524, "ranged": true, "spawn_sec": 163}, {"enemy_id": 17, "source": "local", "count": 7, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 80, "base_hp": 8000, "base_attack": 80, "damage_type": "magical", "armor_defense": 130, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "special_effect_id": 609, "missile_id": 47, "master_id": 32874, "global_id": 6492, "ranged": true, "spawn_sec": 167}, {"enemy_id": 18, "source": "local", "count": 3, "form_count": 1, "tags": ["植物", "バレンタイン"], "hp": 40000, "attack": 650, "base_hp": 40000, "base_attack": 650, "damage_type": "magical", "armor_defense": 2500, "attack_range": 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 135, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 2.5999999046325684, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 474, "missile_id": 6, "master_id": 32310, "global_id": 5929, "ranged": true, "spawn_sec": 191}, {"enemy_id": 19, "source": "local", "count": 3, "form_count": 1, "tags": ["バレンタイン"], "hp": 35000, "attack": 1120, "base_hp": 35000, "base_attack": 1120, "damage_type": "physical", "armor_defense": 1200, "attack_range": 100, "attack_speed": 70, "attack_wait": 50, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 2.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113952, "missile_id": 521, "missile": {"speed": 2.0}, "master_id": 33413, "global_id": 7030, "ranged": true, "spawn_sec": 224}], "popups": ["\n\n\n　　　　――数日前。", "パンプキンデウスは、\n戦場にいるカボチャ系の敵の総数に\n応じて、攻撃と防御がアップします。", "カボチャの馬車がいる間\n全ての敵のHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。"], "dialogue": [{"trigger": "battle", "at_sec": 26, "lines": [{"text": "――数日前。"}, {"name": "キャロップ", "text": "バレンタインの祝祭が迫るチョコ沼地帯に、\nなにやら異変が起きつつあるという。", "face": "u2059a1"}, {"name": "キャロップ", "text": "大切なカカオを守るため、\n我々はグルメジャングルに向かったのだった……。", "face": "u2059a1"}, {"name": "キャロップ", "text": "――ってやつ、言ってみたかったんだ。", "face": "u2059a1"}, {"name": "オーガスタ", "text": "ふふ、とってもお上手ですよ。\nところで、異変というのは……？", "face": "u1153a1"}, {"name": "パンプキンデウス", "text": "バレンタインに、チョコを贈るなーー！", "face": "lbf0ed49f477d"}, {"name": "カボチャの魔物", "text": "カボー！", "face": "l6f3cd7063779"}, {"name": "パンプキンデウス", "text": "バレンタインには、カボチャを食べろーー！", "face": "lbf0ed49f477d"}, {"name": "カボチャの魔物", "text": "カボー！", "face": "l6f3cd7063779"}, {"name": "シャディア", "text": "あれは――パンプキンデウス！？\n馬鹿な、奴は……ええと……。\nしばらく見ていなかったから、まあ死んだのかと……。", "face": "u2056a1"}, {"name": "パンプキンキング", "text": "クヒュヒュ、ボクもいるカボよ！\n蒔かれて実って大復活、夢の共演カボ～☆", "face": "l12c28203f0a6"}, {"name": "パンプキンデウス", "text": "大いなる魔力と上等なカボチャを贄する者あらば、\nカボチャの神たる我は何度でも蘇るカボ……。", "face": "lbf0ed49f477d"}, {"name": "パンプキンデウス", "text": "だが今回は、望み持つ者に呼ばれた訳じゃないカボ。\nされば、我らは自由に動けるカボ……。\n全てのカカオを根絶やしにすることが我らの本懐……。", "face": "lbf0ed49f477d"}, {"name": "パンプキンデウス", "text": "バレンタインをカボチャで埋め尽くす。\nまずはうぬら全員、カボチャパンツにしてやるカボ……！", "face": "lbf0ed49f477d"}, {"name": "シャディア", "text": "パンプキンデウスに神性はない。\n神を騙る木偶など、畑の肥やしにしてやろう。", "face": "u2056a1"}, {"name": "キャロップ", "text": "せっかくだから、あれ言っちゃうね。\n『王子、ご指示をお願いします！』", "face": "u2059a1"}]}, {"trigger": "end", "lines": [{"name": "パンプキンデウス", "text": "くうっ……ここは、撤退するカボ……。\n今年のバレンタインは、チョコに譲るカボ……。", "face": "lbf0ed49f477d"}, {"name": "レギーナ", "text": "まッ――待ってくれ！\nおいしそうなカボチャごと消えないでくれ！", "face": "u405"}, {"name": "レギーナ", "text": "チョコかカボチャか、どちらかだけなんて寂しいだろう。\n皆で分け合い、皆でお腹いっぱい食べる。\nそれが、何より幸せなことなんだよ。", "face": "u405"}, {"name": "パンプキンデウス", "text": "うぬの考え方は、我にはまるで分らぬが。\nそんなにカボチャが好きなら、置いていくカボ……。", "face": "lbf0ed49f477d"}, {"name": "オーガスタ", "text": "……パンプキンデウスたち、消えてしまいましたね。\nちゃんと、魔力の籠っていないカボチャを残して。", "face": "u1153a1"}, {"name": "レギーナ", "text": "ああ、色が濃く実が詰まって、いいカボチャだ！\n植物に対する深い理解がなければ、こうは育てられない。", "face": "u405"}, {"name": "シャディア", "text": "改心した訳ではないようだがな。\nともあれ、カカオは守れたんだ。こちらも撤退しよう。", "face": "u2056a1"}, {"name": "シャディア", "text": "…………。", "face": "u2056a1"}, {"name": "シャディア", "text": "（残されたカボチャは、供物の横流しに過ぎない。\nこの冬場に、カボチャを捧げた者がいるのか？）", "face": "u2056a1"}, {"name": "シャディア", "text": "（パンプキンデウス復活のための供物は、\n強大な魔力と上等なカボチャ、と言っていたか。\n黒幕は恐らく、植物の扱いに長けた魔術師……）", "face": "u2056a1"}, {"name": "シャディア", "text": "（……いや、ここはグルメジャングル。\n復活が自然に起こったとしても、不思議ではないか）", "face": "u2056a1"}, {"name": "キャロップ", "text": "…………。", "face": "u2059a1"}, {"name": "キャロップ", "text": "（王子様のカボチャパンツ姿は、\nちょっとだけ見たかったなぁ……）", "face": "u2059a1"}]}], "active": true}