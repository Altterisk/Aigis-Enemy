{"quest_id": 8155, "name": "根絶！　カボチャの大掃除！！", "description": "異変！　グルメジャングルにやってきた\n我々の目に映ったのは、カカオを根絶やし\nにしようとするカボチャの魔物であった。\n神級（★１獲得の目安：平均Lv50）", "event": "ビタースイートアイヴィワルツ", "event_category": "History", "mission_id": 920210, "map_no": 4841, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["パンプキンデウス", "植物"], "hp": 77000, "attack": 2000, "base_hp": 77000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 750, "magic_defense": 20, "attack_range": 370, "attack_speed": 1, "attack_wait": 200, "attack_interval": 476, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125648, "special_effect_id": 232, "change_to": 1, "missile_id": 496, "missile": {"speed": 12.0}, "master_id": 37029, "global_id": 10646, "ranged": true, "route_behaviour": {"transforms": [{"wait": 6060}]}, "spawn_sec": 24}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 53000, "attack": 1850, "base_hp": 53000, "base_attack": 1850, "damage_type": "magical", "armor_defense": 1500, "magic_defense": 40, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 209, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102832, "special_effect_id": 609, "missile_id": 28, "missile": {"speed": 6.0, "splash": 200}, "master_id": 37028, "global_id": 10645, "ranged": true, "spawn_sec": 24}, {"enemy_id": 4, "source": "local", "count": 7, "form_count": 1, "tags": ["植物"], "hp": 2500, "attack": 30, "base_hp": 2500, "base_attack": 30, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.149999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "special_effect_id": 609, "missil