ack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 15, "attack_speed": 60, "attack_wait": 40, "attack_interval": 201, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.850000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099408, "change_to": 7, "change_condition": 3, "master_id": 162, "global_id": 161, "to_condition": 3, "to_global_id": 162, "spawn_sec": 185}, {"enemy_id": 7, "source": "local", "count": 1, "level": 70, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_speed": 24, "attack_interval": 55, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.850000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2099424, "special_effect_id": 222, "master_id": 163, "global_id": 162, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "カゲロウ", "text": "――王子、死した武者の亡霊を見かけた、\nという報告があったのは、この辺りだ。", "face": "u139"}, {"name": "イロハ", "text": "この近辺の建物は、過去の争乱の被害から\n放棄されて久しいのですが……。\nいったい何が起きているのでしょうか。", "face": "u242"}, {"name": "ソーマ", "text": "……あれ？\nあっちの方に誰か……って、大変です！\nあの人、落ち武者に囲まれています！", "face": "u23"}, {"name": "？？？", "text": "はぁ……はぁ……。\nどこまで追ってくるつもりなのよ……。", "face": "u663"}, {"name": "？？？", "text": "戦いは専門じゃないのに……！\nむしろ私は頭脳労働担当で……うぅぅ、\nこんな時、誰かが颯爽と助けてくれたら――", "face": "u663"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "？？？", "text": "……って、あら？　あの顔、背格好……。\n間違いないわ、あなたが王子ね！", "face": "u663"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "あの方、私達のことをご存知なのでしょうか……？", "face": "l773934036516"}, {"name": "？？？", "text": "あーっと、詳しい話は後で！\nまずはこいつらを蹴散らさなきゃ。", "face": "u663"}, {"name": "？？？", "text": "私の宝貝が届く範囲なら、\n一部だけど傷を肩代わりするわ。\nお礼はするから、お願い、手伝って！", "face": "u663"}, {"name": "アンナ", "text": "そうですね、敵を倒してから、\n詳しい事情を聞きましょう。\n王子、戦いの指揮をお願いします！", "face": "l773934036516"}]}, {"trigger": "end", "lines": [{"name": "竜吉公主", "text": "ふぅ……助かったわ。\n私は竜吉公主。華の国、神仙郷の仙人よ。", "face": "u663"}, {"name": "竜吉公主", "text": "知り合いからあなたが東の国にいる、\nという話を聞いて、追いかけてきたの。", "face": "u663"}, {"name": "竜吉公主", "text": "ヤツらに追われていたのも、そのせいでね……。\nどうしても伝えなくちゃいけないことがあったのよ。", "face": "u663"}, {"name": "アンナ", "text": "伝えなくてはいけないこと、ですか？", "face": "l773934036516"}, {"name": "竜吉公主", "text": "えぇ。単刀直入にいえば、\n華の国の邪仙、東天君がこの国で、\n暗躍しているという情報が入ってきたのよ。", "face": "u663"}, {"name": "アンナ", "text": "東天君……！　この東の国で、\nまた邪仙が何かを企んでいるのでしょうか……。", "face": "l773934036516"}, {"name": "竜吉公主", "text": "あなた達は、邪仙とその幹部、十天君とは\n因縁があると、知り合いから聞いているわ。\nだから伝えておいた方が良いと思ってね。", "face": "u663"}, {"name": "竜吉公主", "text": "それじゃあ、私は他の十天君の動向を探るから。\n生きていたらまた会いましょう？", "face": "u663"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "イロハ", "text": "あっ……行ってしまいました……。", "face": "u242"}, {"name": "アンナ", "text": "東天君が暗躍しているなんて……。\n王子、気を引き締めていきましょう。", "face": "l773934036516"}]}], "active": true}