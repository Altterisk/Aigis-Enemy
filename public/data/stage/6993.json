tack_wait": 10, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115664, "race_id": 16, "special_effect_id": 484, "master_id": 32389, "global_id": 6008, "spawn_sec": 147}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6500, "base_hp": 6500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110896, "race_id": 16, "special_effect_id": 484, "master_id": 32388, "global_id": 6007, "spawn_sec": 184}], "popups": ["ワルツ、ハナ、ビビアン、\nマーニーがいる間は\n全ての敵の攻撃力と\n防御力がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ライチ", "text": "……本番がきちゃったね。\nボクが総合優勝を勝ち取る日が！", "face": "u984"}, {"name": "アンリ", "text": "……いいえ、ボクがこの知力で、\n総合優勝を華麗に勝ち取る日ですよ！", "face": "u982"}, {"name": "ユキヒメ", "text": "ふたりとも、がんばってね……！", "face": "u983"}, {"name": "アンナ", "text": "――それではこれより、\n王国体育祭の開会セレモニーを行います。"}, {"name": "アンナ", "text": "開会セレモニーでは、王国軍、学園合同で、\n王子による軍団指揮のお披露目が行われます。\n選手の皆さんは、それぞれの陣地へ移動をお願いします。"}, {"name": "アンリ", "text": "あっ、ボクはセレモニーに出場するので行ってきますね。\nなんと王子の部隊なんですよ！　えへへ。", "face": "u982"}, {"name": "ライチ", "text": "むっ、ず、ずるい……！\nボクだって王子の部隊でセレモニー出たいのにー！", "face": "u984"}, {"name": "アンリ", "text": "ふっふっふ、既に勝負は始まっているんですよ！\nライチさんは観客席で見ていてくださいね♪", "face": "u982"}, {"name": "アンナ", "text": "皆さん、準備はよろしいですか？\nそれでは王子、軍団指揮をよろしくお願いします！"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "――そこまで！\n以上で開会セレモニーを終了します！"}, {"name": "ユキヒメ", "text": "アンリちゃん、大活躍だったね……♪", "face": "u983"}, {"name": "ライチ", "text": "うぅ、悔しいけど大活躍だったよぉ……。\nよぉし、体育祭本戦じゃ、\nボクの方が大活躍しちゃうんだから！", "face": "u984"}, {"name": "ユキヒメ", "text": "いっぱい特訓、したもんね。\n岩がごろごろ転がってくる坂を上ったり……。", "face": "u983"}, {"name": "ライチ", "text": "ダンスの練習したり、大食い勝負したり、\n本当にいっぱい特訓したもんね……。", "face": "u984"}, {"name": "ライチ", "text": "無敵の戦士目指して、がんばるぞー！", "face": "u984"}, {"name": "ユキヒメ", "text": "おー♪", "face": "u983"}]}], "map": {"image": "Map920140_5547", "w": 960, "h": 640, "spots": [{"k": "b", "x": 941, "y": 149}, {"k": "b", "x": 943, "y": 473}, {"k": "m", "x": 105, "y": 409, "id": 200}, {"k": "m", "x": 215, "y": 143, "id": 201}, {"k": "m", "x": 233, "y": 232, "id": 202}, {"k": "m", "x": 192, "y": 320, "id": 203}, {"k": "m", "x": 235, "y": 419, "id": 204}, {"k": "m", "x": 343, "y": 452, "id": 205}, {"k": "m", "x": 469, "y": 454, "id": 206}, {"k": "m", "x": 596, "y": 453, "id": 207}, {"k": "m", "x": 706, "y": 418, "id": 208}, {"k": "m", "x": 745, "y": 322, "id": 209}, {"k": "m", "x": 708, "y": 231, "id": 210}, {"k": "m", "x": 595, "y": 192, "id": 211}, {"k": "m", "x": 470, "y": 192, "id": 212}, {"k": "m", "x": 343, "y": 190, "id": 213}, {"k": "m", "x": 839, "y": 220, "id": 214}, {"k": "m", "x": 840, "y": 416, "id": 215}, {"k": "r", "x": 133, "y": 208, "id": 300}, {"k": "r", "x": 89, "y": 308, "id": 301}, {"k": "r", "x": 281, "y": 313, "id": 302}, {"k": "r", "x": 464, "y": 259, "id": 303}, {"k": "r", "x": 658, "y": 319, "id": 304}, {"k": "r", "x": 464, "y": 381, "id": 305}, {"k": "r", "x": 752, "y": 151, "id": 306}, {"k": "r", "x": 856, "y": 319, "id": 307}, {"k": "r", "x": 760, "y": 484, "id": 308}]}, "active": true}