000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 8, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "phases": [{"hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "condition": 3}], "spawn_sec": 62}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "報告！　前方にオーク達を発見！", "face": "ldf0741f19276"}, {"name": "アンナ", "text": "そんな……。\nさっき全て撃退できたと思っていたのにっ……。", "face": "lc1a894249b0f"}, {"name": "オーク", "text": "ん？　人間どもか。こざかしいな。", "face": "lc3098a587432"}, {"name": "オーク", "text": "お前らがいかに邪魔しようとも、\nこのジャングルの各所に散らばってる同胞たちが\nすぐにお前らを駆逐するだろう。", "face": "lc3098a587432"}, {"name": "アンナ", "text": "そんなことはさせません！\n一体なぜこんな事をするんですか！", "face": "lc1a894249b0f"}, {"name": "オーク", "text": "ふん。人間どもに教えてやる必要はない。\nお前ら！！　誇り高きオークの種族の名のもとに！\n俺たちの強さを奴らに見せつけろォオッ！！", "face": "lc3098a587432"}, {"name": "オーク", "text": "ウオオオオッ！！！", "face": "lc3098a587432"}]}, {"trigger": "end", "lines": [{"name": "オーク", "text": "お前たちなかなか強いな。\nこのまま戦いたいが……。ここは一旦引こう。\n（……任務もある事だ、仕方ない）", "face": "lc3098a587432"}, {"name": "アンナ", "text": "オーク達は去っていったようです。\nあの好戦的なオークがあっさり引いていくなんて、\n不思議ですが……。とにかく良かったです。", "face": "lc1a894249b0f"}, {"name": "アンナ", "text": "ただ、先ほど戦いの前にオークたちが言っていた話。\n「各所に散らばっている」という言葉、\nもしかして他の場所にも……。", "face": "lc1a894249b0f"}, {"name": "ルナール", "text": "そんな……。もしかして、\n村にもオーク達が……！", "face": "u300"}, {"name": "アンナ", "text": "……。そうかもしれませんね……。\n王子、急いで村に向かいましょう！", "face": "lc1a894249b0f"}]}], "hard": {"level": 170, "multiplier": 1.7, "modifiers": [{"kind": "term", "influence": 24, "param