{"quest_id": 7931, "name": "砕けた宝貝と妖怪", "description": "崑崙を進む王子たちを足止めするべく、\n誅子と普賢が姿を現す。それを見た\n東天君は、ある覚悟を決める。\n上級（★１獲得の目安：平均Lv10）", "event": "華国演義・封神決戦", "event_category": "History", "mission_id": 920196, "map_no": 4717, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 29, "form_count": 1, "hp": 2500, "attack": 350, "base_hp": 2500, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 150, "attack_wait": 50, "attack_interval": 341, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112624, "master_id": 30704, "global_id": 4323, "spawn_sec": 40}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["紂王"], "hp": 52000, "attack": 1400, "base_hp": 52000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 10, "attack_wait": 20, "attack_interval": 86, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2142864, "race_id": 16, "special_effect_id": 1265, "master_id": 35844, "global_id": 9461, "spawn_sec": 100}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 1254, "change_to": 3, "master_id": 35867, "global_id": 9484, "to_global_id": 9485, "route_behaviour": {"transforms": [{}], "reroutes": ["Route=998"]}, "spawn_sec": 100}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attac