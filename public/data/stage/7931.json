l_effect_id": 1258, "change_to": 11, "master_id": 35875, "global_id": 9492, "to_global_id": 9493}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 9, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 275, "change_to": 12, "master_id": 35876, "global_id": 9493, "to_global_id": 9494}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 10, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 1259, "change_to": 13, "master_id": 35877, "global_id": 9494, "to_global_id": 9495}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 11, "form_count": 12, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 39, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2142864, "special_effect_id": 275, "change_to": 14, "master_id": 35878, "global_id": 9495}, {"enemy_id": 24, "source": "local", "count": 5, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "magical", "armor_defense": 250, "attack_range": 200, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142784, "race_id": 16, "missile_id": 831, "missile": {"speed": 4.0, "splash": 133}, "master_id": 35836, "global_id": 9453, "ranged": true, "spawn_sec": 176}, {"enemy_id": 25, "source": "local", "count": 8, "form_count": 1, "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "attack_range": 160, "attack_speed": 70, "attack_wait": 120, "attack_interval": 301, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142800, "race_id": 16, "change_to": 25, "change_condition": 1, "missile_id": 26, "master_id": 35837, "global_id": 9454, "ranged": true, "variants": [{"hp": 4000, "attack": 450, "base_hp": 4000, "base_attack": 450, "damage_type": "physical", "armor_defense": 250, "attack_speed": 70, "attack_wait": 60, "attack_interval": 231, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142816, "race_id": 16, "master_id": 35838, "global_id": 9455}], "spawn_sec": 178}, {"enemy_id": 27, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 200, "base_hp": 6500, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_range": 220, "attack_speed": 1, "attack_wait": 15, "attack_interval": 61, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143680, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 36050, "global_id": 9667, "ranged": true, "spawn_sec": 232}], "popups": ["NPCの一目連は倒されても\n★の評価には影響しません。", "華王、誅子は\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ\n\n\n\n　　　　　　(1/2)", "また華王、誅子は一定確率で\n物理攻撃を回避します。\n\nさらに、華王、誅子がいる間は\n全ての敵の攻撃と防御が\nアップします。\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "東天君", "text": "俺を案内役にしようとは……。\nどこまで甘いんだ、王国軍は。", "face": "u1783a1"}, {"name": "ナタク", "text": "我々はオリュンポス第２階層について、\n何も知らない状態だ。", "face": "u297"}, {"name": "ナタク", "text": "ならば、ここを少しでも知っているキミに、\n情報源になってもらうのは妥当な選択じゃないかな？", "face": "u297"}, {"name": "東天君", "text": "……納得はしていないが、承服しよう。\nだが、この様を見れば、俺が教えるまでもないと思うが。", "face": "u1783a1"}, {"name": "清源妙道真君", "text": "……これは、華の国の街並み？\nいえ、華の国の都そのものでしょうか。", "face": "u866"}, {"name": "華王、誅子", "text": "――然り。\nされどこの地は余の庭に非ず。\n仙人ならば感じるだろう、この仙力の音色を。", "face": "lbd7844e34f72"}, {"name": "華王、誅子", "text": "華の国は、この崑崙から生まれ変わる。\n元始天尊様が、そう約束してくださった。", "face": "lbd7844e34f72"}, {"name": "太公望", "text": "……本当に、ここに元始天尊様が？", "face": "u603"}, {"name": "華王、誅子", "text": "いかにも。\nああ、元始天尊様は憂えておられる……。", "face": "lbd7844e34f72"}, {"name": "華王、誅子", "text": "魔物が復活した後、世界には深い爪痕が、\n民の心には絶望と嘆きが刻まれた。", "face": "lbd7844e34f72"}, {"name": "華王、誅子", "text": "もはや人の王に任せてはおけぬと、\n御自ら、華の国を書き換えんとしてくださったのだ。", "face": "lbd7844e34f72"}, {"name": "フェイロン", "text": "誅子さま、何を言って……。\n一度は誤った道を、今度こそ正しく歩み、\n民を導くと誓ったあなたはどこへ行った！", "face": "u1720a1"}, {"name": "東天君", "text": "……無駄だ。\nこいつは騙されている。\n今の元始天尊は、かつてのそれではないんだ。", "face": "u1783a1"}, {"name": "東天君", "text": "こいつを蹴散らし、\n一刻も早く「封神台」へ向かわなくては……。", "face": "u1783a1"}, {"name": "太公望", "text": "封神台、ですか……。\n仙人の力を集め、ひとつに束ねる術式……。", "face": "u603"}, {"name": "太公望", "text": "なるほど、では華王が十天君の討伐に打って出たのは、\n大罪人を罰するためではなく、\n封神台へ仙力を集めるための――", "face": "u603"}, {"name": "普賢", "text": "おっと、おしゃべりがすぎるなぁ太公望。\nしかし今回ばかりは、天才道士殿の思考速度より、\nこちらの方が上手だったようだ。", "face": "u1782a1"}, {"name": "普賢", "text": "封神計画は後少しで成就する。\nついでに貴様らの仙力も捧げてやってもいいが、\n今はここで、大人しく足止めされておけ！", "face": "u1782a1"}]}, {"trigger": "start", "lines": [{"name": "東天君", "text": "くぅっ……宝貝さえ、砕けていなければ……。", "face": "u1783a1"}, {"name": "フーコ", "text": "まだあんなガラクタのこと悔やんでるの？", "face": "u493"}, {"name": "東天君", "text": "が、ガラクタ……！？", "face": "u1783a1"}, {"name": "クーコ", "text": "一目連くん、何か忘れてないかなぁ？\nキミはさ、邪仙であると同時に、\n妖怪でもあるはずじゃない？", "face": "u617"}, {"name": "東天君", "text": "妖怪としての……力……。\nそんなもの、久しく忘れていたな……。", "face": "u1783a1"}]}, {"trigger": "start", "lines": [{"name": "一目連", "text": "命を救われた借りを返そう。\n王子、俺の力を使うがいい！", "face": "u1783a1"}]}, {"trigger": "end", "lines": [{"name": "普賢", "text": "さぁて、こんなところか。\n――って、おいおい誅子、もうバテたのか？", "face": "u1782a1"}, {"name": "華王、誅子", "text": "はぁ……はぁ……っ！\nくっ……なぜだ、余では届かぬというのか……。", "face": "lbd7844e34f72"}, {"name": "普賢", "text": "まぁ、仕方ないか。\n聞忠のやつ、貴様が封神されないように、\nあれこれ仕込んでいたようだしな。", "face": "u1782a1"}, {"name": "華王、誅子", "text": "はっ……？　聞忠が……？\n余に、いったい何を……。", "face": "lbd7844e34f72"}, {"name": "普賢", "text": "貴様には、仙人を目指すに値する仙力がある。\nそんな極上の人間を置いておいたら、\nあのクソ亜神が封神台に欲しがっちゃうじゃないか。", "face": "u1782a1"}, {"name": "太公望", "text": "……クソ亜神？\n封神計画を進めているのは元始天尊様では？", "face": "u603"}, {"name": "普賢", "text": "おぉっと、サービスはここまでだ。\n良かったな誅子、聞忠に死ぬほど愛されて。\n戦えなくても守ってもらえるぞ。", "face": "u1782a1"}, {"name": "華王、誅子", "text": "ふざけるなぁあぁぁぁッ！！\n普賢、元始天尊っ、聞忠……っ！！\nどうして、余は……いつも……。", "face": "lbd7844e34f72"}, {"name": "太公望", "text": "封神台とは、仙力を集める巨大な術式。\nそこに華王が捧げられることを危惧し、\n力を奪った、ということですか……。", "face": "u603"}, {"name": "ナタク", "text": "聞忠は人を愛しすぎているんだ。\nそしてとても大切だから、\n壊れないように、大切にしまい込んでしまう。", "face": "u297"}, {"name": "竜吉公主", "text": "閉じ込められた者がどれだけ嘆いても、\nそれに気付けないなんて、聞忠も可哀想な人ね。", "face": "u663"}, {"name": "華王、誅子", "text": "…………たの、む。", "face": "lbd7844e34f72"}, {"name": "華王、誅子", "text": "王子、余を連れて行ってくれ。\n……何ができるのかも、分からないが。", "face": "lbd7844e34f72"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "太公望", "text": "王子、この先は仙力渦巻く魔境、\n封神台が待ち構えているはずです。\nどうか心を強く持って、進んでください。", "face": "u603"}]}], "active": true}