{"quest_id": 4426, "name": "大槌を振るう巨人", "description": "地下洞窟に住む、\nオーガとサイクロプスの群れに\n臆することなく敵を打ち倒せ！\n神級（★１獲得の目安：平均Lv50）", "event": "光と闇の聖霊", "event_category": "History", "mission_id": 920055, "map_no": 5389, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 152, "global_id": 151, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 5}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "hp": 5000, "attack": 600, "base_hp": 5000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097808, "master_id": 43, "global_id": 42, "spawn_sec": 29}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097824, "master_id": 44, "global_id": 43, "spawn_sec": 56}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 96}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 9000, "attack": 350, "base_hp": 9000, "base_attack": 350, "damage_type": "magical", "armor_defense": 200, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 133, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.7999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100592, "race_id": 10, "special_effect_id": 232, "missile_id": 44, "missile": {"speed": 8.0}, "master_id": 270, "global_id": 269, "ranged": true, "spawn_sec": 104}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 112}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "hp": 20000, "attack": 2000, "base_hp": 20000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100176, "race_id": 10, "master_id": 321, "global_id": 320, "spawn_sec": 129}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 20000, "attack": 3900, "base_hp": 20000, "base_attack": 3900, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103296, "race_id": 10, "master_id": 263, "global_id": 262, "spawn_sec": 132}], "dialogue": [{"trigger": "start", "lines": [{"name": "フェス", "text": "これ以上はもうやめてくれ！\n私たち聖霊の役目を思い出すんだ！", "face": "u303"}, {"name": "常闇の聖霊", "text": "役目だと？　愚かなる人間にわれらの力を\n奪われることの何が役目だ。そなたこそ、\n早く目を覚ませ。いつまで人間に幻想を抱いておる。", "face": "u397"}, {"name": "常闇の聖霊", "text": "人間は自分の事しか考えていない\n自分勝手な生き物だ。われらの事なぞ、\n使い捨ての何かだと思っているに違いない。", "face": "u397"}, {"name": "常闇の聖霊", "text": "……まぁ、今のそなたには\n何を言っても分からぬだろうがな。", "face": "u397"}, {"name": "常闇の聖霊", "text": "われが魔物を使い、人間のいない世界を\n作ってみせよう。\nさすれば、そなたもわれの話が理解できようぞ。", "face": "u397"}, {"name": "常闇の聖霊", "text": "さぁ、魔物たちよ。われの力を受け取り\n思う存分暴れるがいい……！", "face": "u397"}, {"name": "常闇の聖霊", "text": "永久に揺蕩う深淵の闇の力よ、わが下に集え！\nわれは邪悪なる力を抱えし許されざる存在。\nわがしもべに滅びの呪いと闇の祝福を与えん……！", "face": "u397"}, {"name": "アンナ", "text": "そんな……。", "face": "leddf674e49c5"}, {"name": "フェス", "text": "あれは……サイクロプス！", "face": "u303"}]}, {"trigger": "battle", "at_sec": 79, "lines": [{"name": "常闇の聖霊", "text": "……うむ。そう簡単にあの巨体に合う武器は\n作りだせぬか。早くあの目障りな人間どもを\n葬ってやりたいが、少し時間がかかりそうだな……。", "face": "u397"}]}, {"trigger": "battle", "at_sec": 131, "lines": [{"name": "常闇の聖霊", "text": "おお。やっと出来たか。フフ、これはなかなかの\n出来だ。当たったら、少しは……。\nんー、いやかなり痛いだろうさ。", "face": "u397"}]}, {"trigger": "end", "lines": [{"name": "常闇の聖霊", "text": "少し寝ている間に……、\n人間も随分と強くなったものだ。", "face": "u397"}, {"name": "常闇の聖霊", "text": "まあ、いいさ。\nもっと強い魔物でも探しにいくとするか。", "face": "u397"}, {"name": "フェス", "text": "待て！", "face": "u303"}, {"name": "アンナ", "text": "……行ってしまったようです。", "face": "leddf674e49c5"}, {"name": "フェス", "text": "……彼女を止めることができなかった……。", "face": "u303"}, {"name": "アンナ", "text": "フェスさん、一緒に後を追いましょう！", "face": "leddf674e49c5"}, {"name": "フェス", "text": "ああ。行こう。", "face": "u303"}]}], "active": true}