{"quest_id": 8263, "name": "天使の企画", "description": "第四回人気闘兵凱旋パレードが開催！!\n一行は王国内を巡る中、祭りで熱くなった\n村人たちと模擬戦をすることになって……？\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "人気闘兵凱旋パレードIV", "event_category": "History", "mission_id": 920215, "map_no": 4900, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 180, "gold": 500, "drops": [{"card": 2164, "c": 1}, {"card": 55, "c": 1}, {"item": 1001, "c": 1}, {"item": 23000}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 8000, "attack": 320, "base_hp": 8000, "base_attack": 320, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_range": 240, "attack_speed": 1, "attack_wait": 15, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2118288, "race_id": 16, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 37449, "global_id": 11066, "ranged": true, "spawn_sec": 41}, {"enemy_id": 2, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 500, "attack": 300, "base_hp": 500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121616, "race_id": 16, "master_id": 32454, "global_id": 6073, "spawn_sec": 41}, {"enemy_id": 3, "source": "local", "count": 9, "form_index": 0, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 700, "attack": 120, "base_hp": 700, "base_attack": 120, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 126, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121600, "race_id": 16, "master_id": 32453, "global_id": 6072, "spawn_sec": 41}, {"enemy_id": 4, "source": "local", "count": 17, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 43}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 80, "attack_range": 250, "attack_speed": 1, "attack_wait": 15, "attack_interval": 57, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2153072, "race_id": 16, "special_effect_id": 1717, "change_to": 5, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 37445, "global_id": 11062, "ranged": true, "to_condition": 0, "to_global_id": 11092, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 84}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 80, "attack_range": 250, "attack_speed": 1, "attack_wait": 15, "attack_interval": 57, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2153072, "race_id": 16, "special_effect_id": 1309, "change_to": 4, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 37475, "global_id": 11092, "ranged": true, "from_condition": 0}, {"enemy_id": 7, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "hp": 2500, "attack": 600, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 27, "global_id": 26, "spawn_sec": 128}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 12000, "attack": 750, "base_hp": 12000, "base_attack": 750, "damage_type": "physical", "armor_defense": 120, "magic_defense": 10, "attack_speed": 1, "attack_wait": 30, "attack_interval": 88, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120976, "race_id": 16, "master_id": 37444, "global_id": 11061, "spawn_sec": 191}], "popups": ["\n\n\n　　　　――王国近郊", "レナータがいる間は\n味方の防御力、魔法耐性が\n40％ダウンします。"], "dialogue": [{"trigger": "battle", "at_sec": 42, "lines": [{"text": "――王国部門"}, {"name": "リズリー", "text": "はいはーい、次の芸いくよー？　そーい！", "face": "u716"}, {"name": "村娘", "text": "わーわー！", "face": "l61cea912b727"}, {"name": "アルティア", "text": "……平和、ですね。\nほんの少し前には、この辺りも魔物に蹂躙されていたのに。", "face": "u261"}, {"name": "レナータ", "text": "みんなで戦ってきた成果、ですよね。\n今も戦いは続いていますけど、\nこうして、村の人たちにも笑顔が戻ってきました。", "face": "u1430a1"}, {"name": "アルティア", "text": "えぇ、でも本当に頑張ったのは、\n今こうして祭りを楽しんでいる、\n非戦闘員の者たちなのだと思います。", "face": "u261"}, {"name": "アルティア", "text": "魔物と戦ったのは確かに我々ですが――", "face": "u261"}, {"name": "レナータ", "text": "……こうして、村を復興したのは、\n彼ら自身の力、ですからね。", "face": "u1430a1"}, {"name": "アルティア", "text": "倒れた家屋を修復し、荒らされた畑を再び耕し、\n魔物との戦いの爪痕から、\n一歩ずつ立ち直ってきた……本当に、強い国です、王国は。", "face": "u261"}, {"name": "リズリー", "text": "あっ、いたいた。\nおーい、しんみりしてるところに悪いんだけどさー？", "face": "u716"}, {"name": "レナータ", "text": "おや？　どうしましたリズリーさん。", "face": "u1430a1"}, {"name": "リズリー", "text": "うーん、なんかねー、\nみんな祭りで熱くなっちゃったみたいでさ？", "face": "u716"}, {"name": "リズリー", "text": "最初は村の男性陣が力比べをしてただけなんだけど、\nこのままだと乱闘騒ぎになっちゃいそうなんだよね。", "face": "u716"}, {"name": "レナータ", "text": "うわー、祝いの日にそれはよくないですね。\nこういう時は王国の伝統文化にのっとって――", "face": "u1430a1"}, {"name": "アルティア", "text": "えぇ、ルールある模擬戦に持ち込んで、\n皆の熱気を発散させてあげましょうか。", "face": "u261"}]}, {"trigger": "end", "lines": [{"name": "アルティア", "text": "――はい、そこまで！", "face": "u261"}, {"name": "村人", "text": "あ、アルティア様！\n稽古をつけていただき、光栄です！", "face": "l2f387128c716"}, {"name": "アルティア", "text": "いい腕でしたね。\n村の自警団所属でしょうか？\n訓練を怠らなければ、もっと強くなれますよ。", "face": "u261"}, {"name": "リズリー", "text": "わぁ、さすが光の守護者さまだ。\n自警団員の瞳がきらきらしてるよ。", "face": "u716"}, {"name": "レナータ", "text": "アルティアさんの戦い方、華がありますからねぇ。\n私もちょっと見とれちゃいましたよ。", "face": "u1430a1"}, {"name": "レナータ", "text": "あっ……そういえば、\nどうして王都じゃなくて、\nこの村でパーティをすることになったんです？", "face": "u1430a1"}, {"name": "リズリー", "text": "ああ、この企画はニエルちゃんが提案したらしいよ。\nえーっと、確か――", "face": "u716"}, {"name": "ニエル", "text": "――王国軍に感謝を伝えたい、と。\n前々から、各地の村でそういう声を聞いていたので。", "face": "u2164a1"}, {"name": "ニエル", "text": "ふぅ、ちょっと心配だったけど、\n交流も大成功みたいで、本当によかったぁ。", "face": "u2164a1"}, {"name": "リズリー", "text": "ふふん、ニエルちゃんお手柄だね。\nこのこのっ、つんつん、ふにふにー♪", "face": "u716"}, {"name": "ニエル", "text": "えぇっ、あのっ、くすぐったいよぉ！？", "face": "u2164a1"}, {"name": "レナータ", "text": "まぁまぁ、わぁっ、ほっぺやわらかーい♪\nいいなぁいいなぁ、もって帰りたいなぁー。", "face": "u1430a1"}, {"name": "ニエル", "text": "ま、まだパーティ実行委員の仕事があるので！！\nひぁぁっ！？　話を聞いてー！", "face": "u2164a1"}, {"name": "アルティア", "text": "こらふたりとも、親しき仲にも礼儀ありですよ。\nニエル、大丈夫ですか？", "face": "u261"}, {"name": "ニエル", "text": "た、助かったぁ……。", "face": "u2164a1"}, {"name": "アルティア", "text": "それにしても、ふたりとも、\nそんなにくすぐりがお好きなのですか？", "face": "u261"}, {"name": "レナータ", "text": "えっ、あっ、そういうわけじゃあ……。", "face": "u1430a1"}, {"name": "リズリー", "text": "逃げるよレナータ！！", "face": "u716"}, {"name": "アルティア", "text": "待ちなさい！\n思う存分くすぐってあげますからね！！", "face": "u261"}]}], "map": {"image": "Map920215_4900", "w": 960, "h": 640, "spots": [{"k": "b", "x": 470, "y": 344}, {"k": "m", "x": 251, "y": 177, "id": 200}, {"k": "m", "x": 403, "y": 118, "id": 201}, {"k": "m", "x": 349, "y": 190, "id": 202}, {"k": "m", "x": 336, "y": 279, "id": 203}, {"k": "m", "x": 313, "y": 349, "id": 204}, {"k": "m", "x": 248, "y": 408, "id": 205}, {"k": "m", "x": 353, "y": 417, "id": 206}, {"k": "m", "x": 448, "y": 417, "id": 207}, {"k": "m", "x": 527, "y": 434, "id": 208}, {"k": "m", "x": 617, "y": 440, "id": 209}, {"k": "m", "x": 670, "y": 388, "id": 210}, {"k":