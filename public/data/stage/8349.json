黒炎"], "hp": 2000, "attack": 1, "base_hp": 2000, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 70, "gain_cost": 1, "dot_rate": 1.5, "pattern_id": 2155232, "special_effect_id": 1799, "master_id": 37835, "global_id": 11452, "from_condition": 2}, {"enemy_id": 9, "source": "local", "count": 11, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127760, "race_id": 21, "change_to": 9, "change_condition": 4, "master_id": 33555, "global_id": 7172, "to_condition": 4, "to_ticks": 3, "to_global_id": 7175, "spawn_sec": 145}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127776, "race_id": 21, "special_effect_id": 222, "master_id": 33558, "global_id": 7175, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127792, "race_id": 21, "change_to": 13, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 33559, "global_id": 7176, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 7179, "spawn_sec": 147}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127808, "race_id": 21, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 33562, "global_id": 7179, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 17, "source": "local", "count": 3, "form_count": 2, "hp": 23000, "attack": 700, "base_hp": 23000, "base_attack": 700, "damage_type": "magical", "armor_defense": 200, "attack_range": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 71, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138576, "race_id": 13, "special_effect_id": 216, "change_to": 5, "change_condition": 2, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 35093, "global_id": 8710, "ranged": true, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 206}], "popups": ["スイゼがいる間は\n全ての敵ユニットの\n攻撃力がアップします。 ", "冥界のケルベロス、\n冥界のウルフは、\n倒されると黒炎に変化します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "スイゼ", "text": "――いいや、これ以上は進ませない。\n神聖なる庭園を、アダマスの信徒が穢すことは許さない。", "face": "u2250a1"}, {"name": "ヘイズル", "text": "来たか……。\nハイドースの庭師ちゃん、だったかな？", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "なるほど、庭園の庭師、ですか。\nあの時気付くべきでしたね。\n貴女がここの管理者だと。", "face": "u2245a1"}, {"name": "スイゼ", "text": "なぜ、この先に進もうとする。\n殺しただけで飽き足らず、\n穏やかな眠りすら邪魔しようというのか。", "face": "u2250a1"}, {"name": "アグナ", "text": "殺した……？\n何を言っているのか分からないが、\nこの先に進まねば世界が危うい。通してもらうぞ。", "face": "u2251a1"}, {"name": "スイゼ", "text": "……アダマスは、己の罪を隠しているのだな。", "face": "u2250a1"}, {"name": "スイゼ", "text": "あえて教えるつもりもない。\nここはあの方が愛した庭園。\n庭師として、その蹂躙を許すわけにはいかない。", "face": "u2250a1"}, {"name": "白の皇帝", "text": "……スイゼ、と言ったか。\nその忠義には、敬意を表そう。", "face": "u418"}, {"name": "白の皇帝", "text": "だが、貴様の感傷に付き合ってやるつもりはない。\n恨み言ならば、後で聞いてやる。\n今はそこを、通してもらおう。", "face": "u418"}, {"name": "スイゼ", "text": "勝手なことを……！", "face": "u2250a1"}, {"name": "スイゼ", "text": "裏切り者のヘカティエ！\n穢らわしきアダマスの信徒ども！\n我が主に代わり、貴様らの魂を刈り取ろう！！", "face": "u2250a1"}]}, {"trigger": "end", "lines": [{"name": "ヘカティエ", "text": "――届かないと分かっていて、なぜ？\nあなたなりの忠義心なのかしら。", "face": "u1226a1"}, {"name": "スイゼ", "text": "うるさい……お前に何がわかる……。\nハイドース様の悲しみを、嘆きを、どうして……。", "face": "u2250a1"}, {"name": "白の皇帝", "text": "――教えてくれ、スイゼ。\n俺たちは、貴様のいう真実を知らない。\nただ、帝国の民と、物質界の安寧のためにここに来た。", "face": "u418"}, {"name": "白の皇帝", "text": "ハイドースの儀式は、何を目指している？", "face": "u418"}, {"name": "スイゼ", "text": "……儀式の詳細までは、知らない。", "face": "u2250a1"}, {"name": "スイゼ", "text": "だが、お前たちは\nアダマスの罪を知る義務がある。", "face": "u2250a1"}, {"name": "白の皇帝", "text": "聞こう。\nアダマスの神器を担う者として。", "face": "u418"}, {"name": "アンジェリーネ", "text": "えぇ。\nそれを私たちに望むのなら。", "face": "u430"}, {"name": "スイゼ", "text": "――女神アダマスは、ハイドース様の奥方を殺したのだ。", "face": "u2250a1"}, {"name": "スイゼ", "text": "この地に眠る方こそ、ハイドース様の奥方その人。\n女神アダマスは、奥方の命を奪うだけでなく、\nこの地にて、魂に永劫の封印を施した。", "face": "u2250a1"}, {"name": "スイゼ", "text": "消えることもできず、\n眠ることもできない、永遠の牢獄……。", "face": "u2250a1"}, {"name": "スイゼ", "text": "あの方は、自身の愛した庭園の底に、\n今も縛り付けられたままだ。", "face": "u2250a1"}, {"name": "ヘイズル", "text": "どこまでが本当？\n私たちは、ここに封じられし者こそ、幾度も訪れた\n世界の滅び、その危機のひとつだって聞いたけど。", "face": "u2248a1"}, {"name": "スイゼ", "text": "嘘などひとつたりとも言うものか！", "face": "u2250a1"}, {"name": "スイゼ", "text": "生まれた者は嘆き、悲しみ、死に怯え、\n生命の終わりには後悔だけを抱えて冥界へ至る。", "face": "u2250a1"}, {"name": "スイゼ", "text": "おふたりは、そんなあらゆる生命を救おうとした。\n生の苦しみを、不平等なる世界を、\nせめて等しき死の安寧で抱きとめようと……。", "face": "u2250a1"}, {"name": "アンジェリーネ", "text": "……身勝手な言い分ですわね。", "face": "u430"}, {"name": "スイゼ", "text": "王族の貴様に何が分かる！", "face": "u2250a1"}, {"name": "スイゼ", "text": "飢えに苦しむ者、戦禍に翻弄される者、\n故郷を失った者、愛する者を奪われた者、\n彼らの苦しみは死によってのみ救われるというのに！", "face": "u2250a1"}, {"name": "アンジェリーネ", "text": "そんなもの――", "face": "u430"}, {"name": "白の皇帝", "text": "――そんなもの、知ったことか。", "face": "u418"}, {"name": "スイゼ", "text": "なっ……！？", "face": "u2250a1"}, {"name": "白の皇帝", "text": "誰もが、それぞれの人生を戦っている。\n生とは戦争そのものだ。\n生きるということは、何かに抗うことなのだから。", "face": "u418"}, {"name": "白の皇帝", "text": "だが、それでも、生きたいと願い、\n抗うことを諦めない者の命まで\n奪い去る権利など、誰も持っていない。", "face": "u418"}, {"name": "白の皇帝", "text": "ハイドースの思惑など、\n今を生きるあらゆる命にとって、知ったことではない。", "face": "u418"}, {"name": "白の皇帝", "text": "……だが、悲しみを拭わんとする\nハイドースの思想と、\n貴様のような臣下がいたことは、覚えておこう。", "face": "u418"}, {"name": "スイゼ", "text": "…………。", "face": "u2250a1"}, {"name": "スイゼ", "text": "（私だって……）", "face": "u2250a1"}, {"name": "ヘカティエ", "text": "私が言うべきことではないけれど、\nただ盲信するだけが忠義ではないと思うわ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "言うべきことがあるなら、\n問うべきことがあるのなら、\nきっと今が、唯一の機会なのではないかしら？", "face": "u1226a1"}, {"name": "スイゼ", "text": "…………。", "face": "u2250a1"}, {"name": "スイゼ", "text": "黙れ、裏切り者。\n……でも、その言葉には、感謝しておく。", "face": "u2250a1"}, {"name": "スイゼ", "text": "先へ進むがいい、アダマスの信徒ども。\nハイドース様の儀式は、あと少しで完成する。", "face": "u2250a1"}, {"name": "白の皇帝", "text": "……見届けるつもりなら、後を追ってこい。\n俺たちは先へ進む。", "face": "u418"}]}], "hard": {"level": 130, "multiplier": 1.3, "modifiers": [{"kind": "term", "influence": 22, "params": [10]}, {"kind": "term", "influence": 19, "params": [150]}], "enemies": [{"enemy_id": 1, "hp": 122200, "attack": 2100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "pattern_id": 2155072}, {"enemy_id": 2, "hp": 1300, "attack": 195, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2097184}, {"enemy_id": 3, "hp": 5200, "attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "pattern_id": 2101328}, {"enemy_id": 4, "hp": 7800, "attack": 450, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "pattern_id": 2103472}, {"enemy_id": 5, "hp": 2600, "attack": 585, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 5, "form_index": 1, "hp": 8450, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 7, "hp": 3900, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2155216}, {"enemy_id": 7, "form_index": 1, "hp": 2600, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2155232}, {"enemy_id": 9, "hp": 2600, "attack": 390, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 9, "form_index": 1, "hp": 2600, "attack": 780, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 13, "hp": 3250, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 13, "form_index": 1, "hp": 3250, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 17, "hp": 29900, "attack": 700, "damage_type": "magical", "armor_defense": 200, "pattern_id": 2138576}]}, "active": true}