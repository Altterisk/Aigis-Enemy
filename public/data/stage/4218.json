, "count": 2, "form_count": 1, "hp": 2850, "attack": 570, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100624, "race_id": 18, "special_effect_id": 220, "master_id": 272, "global_id": 271, "spawn_sec": 32}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "hp": 285, "attack": 150, "base_hp": 300, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 60, "attack_range": 180, "attack_speed": 26, "attack_wait": 30, "attack_interval": 93, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098320, "special_effect_id": 229, "missile_id": 40, "missile": {"speed": 7.0}, "master_id": 79, "global_id": 78, "ranged": true, "spawn_sec": 64}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "hp": 475, "attack": 150, "base_hp": 500, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 60, "attack_range": 180, "attack_speed": 26, "attack_wait": 30, "attack_interval": 93, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098320, "special_effect_id": 34, "missile_id": 40, "missile": {"speed": 7.0}, "master_id": 20193, "global_id": 1268, "ranged": true, "spawn_sec": 67}], "dialogue": [{"trigger": "start", "lines": [{"name": "リアナ", "text": "王子様、少しお待ちください。\nなにか気配が……！\n魔物かもしれません。", "face": "u219"}, {"name": "冒険者", "text": "おっと。構えないで大丈夫だぜ。\n俺たちは人間だ。\n魔物と一緒にしないでくれよ？", "face": "la214d2860c90"}, {"name": "アンナ", "text": "あなたたちは一体……？", "face": "l4990cdc1e19f"}, {"name": "冒険者", "text": "俺たちはこの迷宮に眠っている\n伝説の至宝とやらを探しにきたんだ。", "face": "la214d2860c90"}, {"name": "冒険者", "text": "後ろにいるのは俺のパーティ。\n重戦士にアーチャー、メイジ。\n共に死線を乗り越えてきた仲間たちだ。", "face": "la214d2860c90"}, {"name": "リアナ", "text": "見たところヒーラーがいないようですが、\nダンジョンの探索でケガをされた場合は\n大丈夫なんですか？", "face": "u219"}, {"name": "冒険者", "text": "回復薬は大量に持ってきているからな。\nまぁ、俺たちにかかれば魔物たちなんて\nケガをする前にたおし……。", "face": "la214d2860c90"}, {"name": "魔物", "text": "ゲギャッッ……！", "face": "l5f7ba607a7ac"}, {"name": "冒険者", "text": "げぇ！　魔物！？\nこここ…ここはあんたたちに任せた。\n俺たちは先を急ぐ！　じゃあな！！", "face": "la214d2860c90"}]}, {"trigger": "battle", "at_sec": 122, "lines": [{"name": "冒険者", "text": "（やはり、やつらは至宝のカケラを\n集めていやがったか）", "face": "la214d2860c90"}, {"name": "冒険者", "text": "（今なら魔物との戦いで消耗している。\n今、襲えば至宝のカケラを\nまとめてゲットするチャンス！）", "face": "la214d2860c90"}, {"name": "冒険者", "text": "（俺のパーティにはヒーラーがいねえ。\nダンジョンでお宝をゲットしても、\n回復薬代で赤字の毎日……）", "face": "la214d2860c90"}, {"name": "冒険者", "text": "（癒しの至宝さえ手に入れば\n回復薬なんてもういらねえ！\n貧乏生活ともおさらばだ！）", "face": "la214d2860c90"}, {"name": "冒険者", "text": "行くぞ、お前たち！！\n突撃しろおおおおおお！", "face": "la214d2860c90"}, {"name": "冒険者", "text": "「癒しの至宝」は俺たちのモンだあぁ！\nそのカケラを渡しやがれえええええ！", "face": "la214d2860c90"}]}], "active": true}