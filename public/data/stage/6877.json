{"quest_id": 6877, "name": "密林のカボチャ騎士団", "description": "ルナール奪還を狙う一行の前に敵の増援が\n立ち塞がる。カボチャの騎士隊と\nカボチャの馬車を撃破せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "密林のハロウィンパーティー", "event_category": "History", "mission_id": 920134, "map_no": 3356, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 500, "base_hp": 5500, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_range": 260, "attack_speed": 1, "attack_wait": 60, "attack_interval": 151, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2120064, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31985, "global_id": 5604, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 11, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 40, "base_hp": 4000, "base_attack": 40, "damage_type": "magical", "armor_defense": 60, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 241, "global_id": 240, "ranged": true, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "tags": ["植物"], "hp": 2500, "attack": 30, "base_hp": 2500, "base_attack": 30, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 10, "attack_speed": 24, "attack_interval": 25, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.149999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100336, "missile_id": 47, "master_id": 30011, "global_id": 3630, "ranged": true, "spawn_sec": 14}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 160, "attack_speed": 70, "attack_wait": 35, "attack_interval": 136, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116064, "special_effect_id": 319, "change_to": 4, "change_condition": 1, "missile_id": 306, "missile": {"speed": 4.0, "splash": 107}, "master_id": 31300, "global_id": 4919, "ranged": true, "variants": [{"tags": ["植物"], "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 160, "attack_speed": 70, "attack_wait": 35, "attack_interval": 136, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116096, "missile_id": 306, "missile": {"speed": 4.0, "splash": 107}, "master_id": 31301, "global_id": 4920, "ranged": true}], "spawn_sec": 65}, {"enemy_id": 6, "source": "local", "count": 14, "form_count": 1, "tags": ["植物"], "hp": 3200, "attack": 200, "base_hp": 3200, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 31298, "global_id": 4917, "spawn_sec": 89}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["植物"], "hp": 8000, "attack": 500, "base_hp": 8000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 30, "attack_wait": 20, "attack_interval": 111, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102816, "master_id": 398, "global_id": 397, "spawn_sec": 123}], "popups": ["カボチャの馬車がいる間\n全ての敵のHPが徐々に回復します。\nブロックされている間は回復効果が\n無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "カボチャの魔物", "text": "カボ～！？\n邪魔をするつもりカボ？\nそれならもっと強いナカマを呼ぶカボ～！", "face": "l2fdcdf2e8489"}, {"name": "アンナ", "text": "王子、森の奥から魔物の増援が来ます……！\nあれは……パンプキンナイト！？", "face": "la4f78a785d23"}, {"name": "カボチャの魔物", "text": "鎧をまとった勇壮なるカボチャの騎士、\nそしてあまーいお菓子でボクらを癒やす、\nちょっぴりキケンなカボチャの馬車カボ！", "face": "l2fdcdf2e8489"}, {"name": "ルナール", "text": "カボ……カボ……。\n魔物を倒すカボぉ……。", "face": "u889"}, {"name": "カボチャの魔物", "text": "そうそう、あれが魔物王子カボ～！\nルナールちゃん、あいつを倒すカボ～！", "face": "l2fdcdf2e8489"}, {"name": "エデン", "text": "むぅぅっ、早くルナールちゃんを返しなさい！", "face": "u239"}, {"name": "カボチャの魔物", "text": "嫌カボ～♪\nさぁルナールちゃん、王子達を蹴散らすカボ～！", "face": "l2fdcdf2e8489"}]}, {"trigger": "battle", "at_sec": 66, "lines": [{"name": "カボチャの馬車", "text": "ヤァヤァ、良い子の皆、\n愉快な夢とあまーいお菓子を運ぶ、\nステキなカボチャの馬車の到着カボよ。", "face": "ld99479d40a53"}, {"name": "カボチャの魔物", "text": "わーいカボ！\nあまいお菓子で皆回復するカボ～♪", "face": "l2fdcdf2e8489"}, {"name": "カボチャの魔物", "text": "でも行き先を遮られると、\nカンカンに怒って回復を忘れちゃう、\nちょっぴりキケンな紳士だから注意するカボ！", "face": "l2fdcdf2e8489"}, {"name": "ミトラ", "text": "なるほど、行く手を遮ってやればいいんだな。\n自分から弱点を語るとは、愚かなカボチャめ。", "face": "u276"}, {"name": "カボチャの魔物", "text": "カボ～！？　何でバレたカボ～！？", "face": "l2fdcdf2e8489"}]}, {"trigger": "end", "lines": [{"name": "カボチャの魔物", "text": "くぅぅぅっ！　やっぱり強いカボ……！！\nこれじゃあ魔界の門にたどり着けないカボぉ！", "face": "l2fdcdf2e8489"}, {"name": "カボチャの馬車", "text": "カボカボ。\nそれならルナールちゃんを人質に取れば良いカボよ。", "face": "ld99479d40a53"}, {"name": "カボチャの魔物", "text": "さすが紳士カボ！　頭がイイカボ～！\nやい王子！　ルナールちゃんを無事に返してほしければ、\nボクらに道をあけるカボ～！！", "face": "l2fdcdf2e8489"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "カボチャの魔物", "text": "早くしないとルナールちゃんの魂を、\nこの場で抜いてビフロンス様に捧げちゃうカボ～♪", "face": "l2fdcdf2e8489"}, {"name": "アンナ", "text": "王子、仕方ありません。\nここはカボチャの魔物に従いましょう……。", "face": "l8a03eb75fe38"}, {"name": "カボチャの魔物", "text": "（あ、あれ？　思った以上の効果カボ？\nこれならもっと要求しちゃっても良いカボ？）", "face": "l2fdcdf2e8489"}, {"name": "カボチャの魔物", "text": "（よぉし、ついでに王子達も連れて行って、\nあの方と一緒に倒してやるカボ～♪）", "face": "l2fdcdf2e8489"}, {"name": "カボチャの魔物", "text": "クヒヒ、興が乗ったカボ。\nついでにボクらを、魔界の門まで\n案内する大役を与えてやるカボ～♪", "face": "l2fdcdf2e8489"}, {"name": "ミトラ", "text": "（どうやら、従うしかなさそうだな。\nルナールの命を握られたままでは……）", "face": "u276"}, {"name": "アンナ", "text": "（魔物達の企みも気がかりです。\n魔界の門で、いったい何を企んでいるのでしょうか。\n王子、しばし様子をうかがってはいかがでしょう？）", "face": "la4f78a785d23"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "カボチャの魔物", "text": "カボカボカボ……。\nそれじゃあ案内するカボよ～♪", "face": "l2fdcdf2e8489"}]}], "active": true}