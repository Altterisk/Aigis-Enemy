al": 313, "move_speed": 750.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101392, "race_id": 16, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 260, "global_id": 259, "ranged": true, "spawn_sec": 127}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 4200, "base_hp": 4200, "damage_type": "physical", "armor_defense": 130, "attack_speed": 70, "attack_wait": 10, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115664, "race_id": 16, "special_effect_id": 738, "master_id": 31236, "global_id": 4855, "spawn_sec": 140}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 450, "base_hp": 10000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 280, "attack_speed": 70, "attack_wait": 120, "attack_interval": 313, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101344, "race_id": 16, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 30098, "global_id": 3717, "ranged": true, "route_behaviour": {"calls_event": [2016]}, "spawn_sec": 180}], "popups": ["マーニーがいる間は\n全ての敵ユニットの\n攻撃と防御がアップします。", "ビビアンがいる間は\n全ての敵ユニットの\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リーンベル", "text": "――ほう、なんと立派な艦だ。\nこれでこそ、王国海軍旗艦にふさわしい。", "face": "u268"}, {"name": "ケイティ", "text": "復興が進んだおかげで、\nようやく艦船の建造にも着手できました。\nこの艦なら、今まで以上の長期航行が可能ですね。", "face": "u114"}, {"name": "アンナ", "text": "しばらく国交の途絶えていた、\n遠方にも出向くことが出来ますね。"}, {"name": "ドリー", "text": "もちろんどんな海だって楽勝さ。\n何しろ王国の技術を全て詰め込んだ、\n正真正銘の最高傑作に仕上げたからなぁ♪", "face": "u599"}, {"name": "アンナ", "text": "ドリーさんたち工兵の方々や、\nくぐつ師の方々のおかげです。\n本当にありがとうございました。"}, {"name": "ドリー", "text": "いいっていいって。\nそれよりアイツら、放っておいていいのかい？", "face": "u599"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "ベアトリカ", "text": "さぁて、どこに海賊旗を掛けようかねぇ？\nてっぺんは王子にやるとしても、\n俺達海賊の旗もどこかに――", "face": "u157"}, {"name": "リーンベル", "text": "いや待てベアトリカ、これは王国海軍の艦だぞ。\n先に我々の海軍旗をだな……。", "face": "u268"}, {"name": "ビビアン", "text": "これは進水式……ということは……？", "face": "u404"}, {"name": "マーニー", "text": "お祭りです！　お祭りですよ！\nビビアンさん、いっぱい踊っちゃいましょう！", "face": "u155"}, {"name": "ティアル", "text": "やっぱりさぁ、ドリーには止められたけど、\n自爆装置とかつけるべきだったかなぁ？", "face": "u505"}, {"name": "リタ", "text": "自爆してどうするんだ。\n私たちが乗るんだぞ、この艦は。", "face": "u178"}, {"name": "カノン", "text": "えっと……い、いつ祝砲を放てばいいの？\n今？　今すぐ？　今ここでどかーん？", "face": "u264"}, {"name": "アンナ", "text": "……皆さん、新しい船に興奮して、\n全然まとまりがありませんね。", "face": "l558960536499"}, {"name": "アンナ", "text": "王子、ひとまず皆さんに落ち着いてもらいましょう。\nお互いにお怪我がない程度に……！", "face": "l91883c939536"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "何とか皆さん、落ち着いてくれたようですね……。", "face": "l558960536499"}, {"name": "ドリー", "text": "こんなデッカイ艦だから、\n興奮するのも分かるけどね。", "face": "u599"}, {"name": "アンナ", "text": "それでは王子、\n改めて進水式を始めましょう！"}]}, {"trigger": "route", "enemy_ids": [10], "lines": [{"name": "カノン", "text": "ここね、ここで祝砲ね！\nでっかい祝砲、いくわよ……！！", "face": "u264"}]}], "active": true}