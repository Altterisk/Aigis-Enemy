enemy_id": 31, "source": "local", "count": 2, "form_count": 1, "tags": ["帝国"], "hp": 14500, "attack": 900, "base_hp": 14500, "base_attack": 900, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 162, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2164768, "race_id": 16, "change_to": 31, "master_id": 22843, "global_id": 3126, "commands": {"raw": "SetStageFlag(24, 1);", "sets_flags": [[24, 1]]}, "route_behaviour": {"sets_flags": [[31, 1, 0], [24, 1, 0]]}, "spawn_sec": 247}, {"enemy_id": 33, "source": "local", "count": 4, "form_count": 1, "tags": ["帝国"], "hp": 16200, "attack": 2500, "base_hp": 16200, "base_attack": 2500, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 22850, "global_id": 3133, "ranged": true, "spawn_sec": 430}], "popups": ["連装砲台、ガトリング砲台を\n破壊すると、周囲のマスを\n解放することができます。\n\nまた、連装砲台と\nガトリング砲台は倒さなくても\n★の評価には影響しません。", "ベラートの黄金砲台は\n次々に登場するベラートを\n倒し続けるか、\n一定時間が経過すると\n起動します。\n\n\n　　　　　　(1/2)", "起動したベラートの黄金砲台は\n攻撃対象5体までの\n長射程遠距離攻撃を行います。\n\nまた、HPが50％以下になると、\n強力な砲撃を行うようになります。\n\n　　　　　　(2/2)", "帝国のスナイパーは\n随伴する観測兵がいる間、\nその場で狙撃を行います。\n\nまた、帝国のスナイパーから\n受けたダメージは\n２倍になります。\n　　　　　　(1/2)", "帝国のスナイパーは\n随伴する観測兵を倒すか\n一定時間が経過すると\n移動を開始します。\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "ベラート", "text": "――ベラドンナよ、兵たちの準備は万端か？", "face": "l9a1d40b4d2a2"}, {"name": "ベラドンナ", "text": "えぇ父様。\nそれにしても、このような要塞の晴れ舞台、\n父様自ら指揮をお取りになれば良いのに……。", "face": "u2598a1"}, {"name": "ベラート", "text": "否、これはいわばひとつの通過儀礼。\nベラドンナよ、お前が領主となるための儀式なのだ。", "face": "l9a1d40b4d2a2"}, {"name": "ベラート", "text": "あちらの観戦席を見てみよ。", "face": "l9a1d40b4d2a2"}, {"name": "伯爵領の少女", "text": "べらどんなさまー！\nてーこく軍にまけるなー！", "face": "laae878be1709"}, {"name": "ベラート", "text": "この一戦は、伯爵領が今後の帝国で、\nどれだけの発言力を持つかを占うものとなる。", "face": "l9a1d40b4d2a2"}, {"name": "ベラート", "text": "勝敗ではなく、良い戦いをすることを心がけるのだ。", "face": "l9a1d40b4d2a2"}, {"name": "ベラドンナ", "text": "勝たなくてもよろしいんですの？", "face": "u2598a1"}, {"name": "ベラート", "text": "うむ。やはり帝国軍はすごかった、\nしかしそこに一矢報いるベラドンナ伯爵は、\nさすが我々の領主様だと、そう受け止めさせるのだ。", "face": "l9a1d40b4d2a2"}, {"name": "ベラート", "text": "さすれば、帝国が強くなるほど伯爵領の名も上がり、\nなおかつ皇帝はお前を無視できなくなっていく。", "face": "l9a1d40b4d2a2"}, {"name": "ベラート", "text": "――すると、どうなるか分かるか？", "face": "l9a1d40b4d2a2"}, {"name": "ベラドンナ", "text": "……ごくり。", "face": "u2598a1"}, {"name": "ベラート", "text": "金が！　利権が！　向こうからやってくるのだ！", "face": "l9a1d40b4d2a2"}, {"name": "ベラドンナ", "text": "承知しましたわ父様！\nこのベラドンナ、最高の戦いをやり遂げますわよ！", "face": "u2598a1"}, {"name": "ベラート", "text": "その意気やよし！\nさぁ、皆のもの！　このベラートが出るぞぉぉぉッ！！", "face": "l9a1d40b4d2a2"}, {"name": "伯爵領民", "text": "うおー！！\nベラート様ー！　この腹黒元領主ー！！", "face": "l6981e2157c80"}, {"name": "伯爵領店主", "text": "帝国軍なんざやっちまえー！\nベラート様！　祝勝会はうちの酒場で頼みますぞー！", "face": "l4f4b8ea46799"}, {"name": "レオナ", "text": "……やりにくいな。", "face": "u2600a1"}, {"name": "レオラ", "text": "ふふ、どう転んでも帝国の国威発揚になるのだから、\n気軽に全力でぼっこぼこにしてやりなさい？", "face": "u2601a1"}, {"name": "ケイティ", "text": "――双方、準備はよろしいですか？\n立会人は、王国軍より私、ケイティが務めます。", "face": "u2433a1"}, {"name": "ケイティ", "text": "それでは――ベラート要塞攻略戦、開始です！", "face": "u2433a1"}]}, {"trigger": "route", "enemy_ids": [1, 4100, 4201], "lines": [{"name": "ベラート", "text": "――ここまで攻め込むとは、\nさすがは皇帝……いや、皇帝陛下と言うべきか。", "face": "l9a1d40b4d2a2"}, {"name": "ベラート", "text": "しかぁし！\nベラート要塞が最強たる所以はここにあり！", "face": "l9a1d40b4d2a2"}, {"name": "伯爵領の少女", "text": "あっ！　ベラートさまの巨大砲台だ！\nあの砲台ね、パパが作ったんだよ！", "face": "laae878be1709"}, {"name": "少女の父", "text": "こ、こらっ。\nいやすみませんね娘が。\n私はただ、あの砲台の歯車を担当しただけでして。", "face": "l6981e2157c80"}, {"name": "伯爵領の商人", "text": "いやいや、素晴らしい仕事です。\nかくいう私も砲弾を納品しておりましてな。", "face": "l4f4b8ea46799"}, {"name": "少女の父", "text": "おぉ、それはそれは！\nでは共に、あの最強の砲台を応援しましょう！", "face": "l6981e2157c80"}, {"name": "ベラート", "text": "さぁ帝国軍よ！\n湯水のように金を注ぎ込んだこの最強兵器！\nその威力、身を持って知るがいいッ！！", "face": "l9a1d40b4d2a2"}]}], "active": true}