ttern_id": 2099424, "special_effect_id": 222, "master_id": 163, "global_id": 162, "from_condition": 3}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 1, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "attack_interval": 164, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100016, "race_id": 4, "master_id": 863, "global_id": 862, "spawn_sec": 120}, {"enemy_id": 13, "source": "local", "count": 8, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099456, "change_to": 13, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 300, "global_id": 299, "ranged": true, "to_condition": 3, "to_global_id": 300, "spawn_sec": 174}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_range": 200, "attack_speed": 60, "attack_wait": 60, "attack_interval": 171, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099456, "special_effect_id": 248, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 301, "global_id": 300, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "アカネ", "text": "何度ふすまを開けても元の場所に戻ってしまう。\nどうやら閉じ込められてしまったようですね……。", "face": "u1678a1"}, {"name": "ミコト", "text": "一種の迷宮のようなものでしょうか。\n迷宮の主をどうにかするしか方法が──", "face": "u130"}, {"name": "宿の主人", "text": "──お呼びですかな？", "face": "l613d32145d89"}, {"name": "アカネ", "text": "……お呼びですとも。\nさあ、お客様のお帰りです。\n出口に案内していただきたい。", "face": "u1678a1"}, {"name": "宿の主人", "text": "カッカ、出口などありませんよ。\nここはすでに『迷い家』様の腹の中。\n大人しく諦めることをオススメします。", "face": "l613d32145d89"}, {"name": "宿の主人", "text": "衣食住と絶対の安全を保証しましょう。\nこの宿は外界から完全に隔離されております。\n死ぬまで面白おかしく過ごすことができますよ。", "face": "l613d32145d89"}, {"name": "アカネ", "text": "結構、その手の勧誘は聞き飽きております。\n何番煎じとも知れない問答は時間の無駄です。", "face": "u1678a1"}, {"name": "リズリー", "text": "そうだそうだー！　早くここから出せー！", "face": "u977"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "宿の主人", "text": "……黙って従っていればよいものを。", "face": "l613d32145d89"}, {"name": "宿の主人", "text": "──限り無き循環の輪に、呑まれよまろうど。", "face": "ld341290e5c05"}, {"name": "ソーマ", "text": "──ひっ！？", "face": "u1138a1"}, {"name": "宿の主人", "text": "さあ、おいでませ。我が主よ。", "face": "ld341290e5c05"}]}, {"trigger": "start", "lines": [{"name": "フィオレ", "text": "ふっ、ふすまに顔が！", "face": "u1679a1"}, {"name": "ミコト", "text": "迷い家……この温泉宿そのものが、\n妖怪の体内だったというわけですか。", "face": "u130"}, {"name": "アカネ", "text": "であれば、手当たり次第に切り刻めば、\n痛手を与えられるということでしょうか。", "face": "u1678a1"}, {"name": "ミコト", "text": "いいえ、それでは巨人に小石を投げるようなもの。\n膨大な体力を誇る迷い家には効果が薄いはずです。", "face": "u130"}, {"name": "ミコト", "text": "必要なのは急所に、針の一撃。", "face": "u130"}, {"name": "シエナ", "text": "……顔を殴れば、さすがに痛いはず。", "face": "u1680a1"}, {"name": "アカネ", "text": "やることは決まりましたね。王子、参りましょう！", "face": "u1678a1"}]}, {"trigger": "end", "lines": [{"name": "ソーマ", "text": "迷い家の沈黙を確認しました！", "face": "u1138a1"}, {"name": "宿の主人", "text": "カカカ、完敗と言う他ないな。\n永遠の安息も、恒久的な平穏も。\nここには確かに在ったというのに。", "face": "ld341290e5c05"}, {"name": "アカネ", "text": "生憎と、やるべきことが残っていますので。", "face": "u1678a1"}, {"name": "宿の主人", "text": "あえて動乱の中に身を投じるか。\n見たい夢を見せるはずの迷い家の湯で、\n悪夢を見るような者たちは格が違う。", "face": "ld341290e5c05"}, {"name": "宿の主人", "text": "安易な現実逃避を無意識下に拒絶する、\nとんだまろうどを招いてしまったものだ。", "face": "ld341290e5c05"}, {"name": "アカネ", "text": "迷い家は、何故このようなことを？", "face": "u1678a1"}, {"name": "宿の主人", "text": "さあ？　大方住人が少なくなって、\n迷い家様も寂しかったのではないか？", "face": "ld341290e5c05"}, {"name": "宿の主人", "text": "迷い家様は外界からの手の及ばぬ、\n弱き者たちにとっての最後の居場所だ。\nお前たちにはありがた迷惑だろうが……。", "face": "ld341290e5c05"}, {"name": "宿の主人", "text": "この方は罪なき民が死に逝く姿を忌み嫌う。\n我々にとっては間違いなく庇護者だったのだ。", "face": "ld341290e5c05"}, {"name": "アカネ", "text": "では、私たちをここに誘導したのは……。", "face": "u1678a1"}, {"name": "宿の主人", "text": "お前たちに死相でも見えたのかもしれぬな。\n故に庇護せんと、尊大かつ傲慢に考えられた。", "face": "ld341290e5c05"}, {"name": "アカネ", "text": "………………。", "face": "u1678a1"}, {"name": "宿の主人", "text": "それ、衝撃に備えよ。\n迷い家様が拗ねておられる。\nお帰りはあちらだお客様。", "face": "ld341290e5c05"}, {"name": "アカネ", "text": "待っ──", "face": "u1678a1"}, {"name": "宿の主人", "text": "ではな、つわものたちよ。", "face": "ld341290e5c05"}]}], "active": true}