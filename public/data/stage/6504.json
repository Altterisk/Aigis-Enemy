{"quest_id": 6504, "name": "黒に染まりし幻獣", "description": "湖のほとりにて、白き幻獣\n『ユニコーン』と戯れる少女。\nそこに闇エルフの魔の手が迫る……。\n上級（★１獲得の目安：平均Lv10）", "event": "世界樹の花嫁", "event_category": "History", "mission_id": 920111, "map_no": 5361, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 16, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 190, "attack_interval": 442, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115088, "race_id": 11, "master_id": 31082, "global_id": 4701, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 9}, {"enemy_id": 4, "source": "local", "count": 15, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 15}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "magical", "armor_defense": 150, "magic_defense": 70, "attack_speed": 1, "attack_wait": 190, "attack_interval": 442, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115088, "race_id": 11, "special_effect_id": 222, "master_id": 31083, "global_id": 4702, "spawn_sec": 94}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 106}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 5, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 120}], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "さぁ。ユニコーンの皆様、水浴びのお時間ですよ。", "face": "u647"}, {"name": "？？？", "text": "……ふふっ、こらこら♪\nそんな風に身体を擦り付けられては、\n皆様の白く美しい毛並みが荒れてしまいますよ？", "face": "u647"}, {"name": "ダークエルフ", "text": "……ほぅ、これは驚いた。\n幻獣とも称されるほど希少なユニコーンが、\nあれほど大規模な群れを為しているとはな。", "face": "la2af0c19fdd0"}, {"name": "ダークエルフ", "text": "この機を逃す手はあるまい。\n妖精郷への手土産に我らの戦力に加えてやろう。", "face": "la2af0c19fdd0"}, {"name": "？？？", "text": "――ッ！？\nな、何者ですか、貴方たちは？", "face": "u647"}, {"name": "ダークエルフ", "text": "答える義理もあるまい。\n我々は貴様ではなく、ユニコーンに用があるのだ。", "face": "la2af0c19fdd0"}, {"name": "？？？", "text": "……おやめなさい。\n気高き存在であるユニコーンには、\n貴方がたの邪な企みなど通用しません。", "face": "u647"}, {"name": "ダークエルフ", "text": "フッ、確かに個人の魔力で\n幻獣ユニコーンを操ることは困難だろう。", "face": "la2af0c19fdd0"}, {"name": "ダークエルフ", "text": "だが、この花びらの力を以ってすればどうかな？", "face": "la2af0c19fdd0"}, {"name": "？？？", "text": "え……う、嘘……。\n皆様の毛並みが、見る間に黒く染まって……。", "face": "u647"}]}, {"trigger": "start", "lines": [{"name": "ダークエルフ", "text": "くくっ、これでユニコーンは我らの支配下だ。\nそれでは、気高き幻獣諸君には\n手始めにその目障りな女を始末してもらうとしよう。", "face": "la2af0c19fdd0"}, {"name": "？？？", "text": "い、嫌……皆様、正気に戻ってください。\nお願いします……酷いことをしないで……。", "face": "u647"}, {"name": "ファルネ", "text": "――あれは、ユニコーン！？\nでも、どうしてあんな黒い毛並みをしているのかしら？", "face": "u640"}, {"name": "アンナ", "text": "事情はよくわかりませんが、\nダークエルフと共に女性を襲おうとしているようです。\nひとまず敵を退け、彼女を助け出しましょう！", "face": "lbb3a22565b44"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "……チッ、人間どもめ。どこから湧いてきたのやら。", "face": "la2af0c19fdd0"}, {"name": "ダークエルフ", "text": "ともあれ、せっかく手に入れたユニコーンを\nみすみす手放すわけにはいかん。\nヤツらと張り合うのはここまでにしておこう。", "face": "la2af0c19fdd0"}, {"name": "兵士", "text": "――ダークエルフ、撤退していきます。", "face": "u6"}, {"name": "？？？", "text": "そんな……ユニコーン様たちが\nあんなに大勢連れ去られてしまうなんて……。", "face": "u647"}, {"name": "アンナ", "text": "申し訳ありません。\n私たちがもう少し早く助けに来られていれば……。", "face": "l1e9a284d8d92"}, {"name": "？？？", "text": "いえ、助けていただけただけでも感謝せねばなりません。\n……それに、邪悪な者たちの操心術が\n私の主には及ばなかったことは不幸中の幸いでした。", "face": "u647"}, {"name": "バシラ", "text": "『あるじ』？\nユニコーンの他にも誰かいらっしゃるんですか？", "face": "u28"}, {"name": "？？？", "text": "……慈悲深き我らが主よ、\n願わくは彼らに御身の祝福があらんことを。", "face": "u647"}, {"name": "ファルネ", "text": "え……？\nいま、一瞬神々しい力が……。", "face": "u640"}, {"name": "バシラ", "text": "わわっ！　す、すごい……！\n倒れていたユニコーンたちが次々と起き上がってますっ！", "face": "u28"}, {"name": "？？？", "text": "……あらためて感謝いたします、皆様。\nですが、なぜこのような森の奥にいらしたのか、\n差し支えなければお教えいただけませんか？", "face": "u647"}, {"name": "ファルネ", "text": "……私たちは妖精郷に向かっていたんです。\nダークエルフたちの襲撃から守るために。", "face": "u640"}, {"name": "ケイティ", "text": "森の外の世界には、ダークエルフの他にも\n人々を脅かす種族や魔物が存在しています。\n我々はその脅威から人々を守るために戦っているのです。", "face": "u114"}, {"name": "？？？", "text": "（なるほど……私が森の奥で暮らしている間に、\n外の世界はそのような状況になっていたのですね）", "face": "u647"}, {"name": "？？？", "text": "……わかりました。では、先ほどのお礼に\n妖精郷への近道をお教えしましょう。", "face": "u647"}, {"name": "？？？", "text": "……この小路を道なりに進めば、妖精郷に着けるはず。\nまたお会いした時は、あらためてお礼をさせてください。\nそれでは、くれぐれもお気をつけて……。", "face": "u647"}]}], "active": true}