l": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105056, "race_id": 16, "change_to": 12, "master_id": 31273, "global_id": 4892, "from_condition": 0, "to_condition": 0, "to_global_id": 4893}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "tags": ["女性"], "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 100, "attack_interval": 236, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108768, "race_id": 16, "special_effect_id": 248, "change_to": 9, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 31274, "global_id": 4893, "ranged": true, "from_condition": 0}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["女性"], "hp": 13000, "attack": 1100, "base_hp": 13000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 191, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099792, "race_id": 16, "special_effect_id": 222, "master_id": 31267, "global_id": 4886, "spawn_sec": 151}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["女性"], "hp": 12000, "attack": 900, "base_hp": 12000, "base_attack": 900, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105072, "race_id": 16, "special_effect_id": 121, "master_id": 31266, "global_id": 4885, "spawn_sec": 156}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["女性"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "magical", "magic_defense": 30, "attack_speed": 1, "attack_wait": 1, "attack_interval": 29, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108656, "special_effect_id": 120, "master_id": 31265, "global_id": 4884, "spawn_sec": 161}], "popups": ["ティニーのいる間、\n女性の敵ユニットの\n攻撃と防御がアップし、\n敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マイン", "text": "…………はぁ。", "face": "u672"}, {"name": "ティニー", "text": "ん、マインじゃない。\nいったいどうしたの？　ため息なんてついて。", "face": "u523"}, {"name": "マイン", "text": "うわっ、うわぁあっ！？\nお、脅かすんじゃねぇよティニー！", "face": "u672"}, {"name": "マイン", "text": "いや何、どうでもいいことさ。\nただちょっと、悔しかったっつーか……。", "face": "u672"}, {"name": "マイン", "text": "王子に街の案内してもらったんだけどさ、\n服飾店のドレス、可愛かったなぁって……。", "face": "u672"}, {"name": "ティニー", "text": "…………？\nドレスが可愛いと、悔しいの？", "face": "u523"}, {"name": "マイン", "text": "ティニーは可愛いドレスが似合うから！\nそういうの気にならないかもしれないけど！！\nアタシにはさ、ドレスなんて似合わないだろ……？", "face": "u672"}, {"name": "テミス", "text": "――なるほど、そんなことでお悩みでしたのね。\n心配はいりませんわ。\n女の子は誰だって、プリンセスになれるのですわ！", "face": "u38"}, {"name": "マイン", "text": "うわぁ……ッ！？\nえっ、えっと、アンタは、\nいや、アンタたちはいったい……？", "face": "u672"}, {"name": "オリヴィエ", "text": "向こうでお茶会をしていたらね、\nあなたが落ち込んだ顔でこちらの方向へ\n歩いていくのが見えたから……。", "face": "u115"}, {"name": "リリア", "text": "何か困っているなら助けようって、\n話を聞いてみることにしたんです。", "face": "u20"}, {"name": "テミス", "text": "まず可愛くなるための最初の条件。\nそれは何よりも強くきらめく、\n強い輝きを持った存在であることですわ！", "face": "u38"}, {"name": "マイン", "text": "強い、輝きか……。\n強い、強さ、強者の輝きってことかな……？", "face": "u672"}, {"name": "テミス", "text": "…………？\nそ、そうですわね、確かに強者は輝いて――", "face": "u38"}, {"name": "マイン", "text": "そうと決まれば！　おーい！　王子ー！！\nちょっとこっちに来てくれー！！\nアタシと手合わせしてほしいんだー！！", "face": "u672"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "……よく分かりませんが、\nどちらもお怪我のないようにお願いしますね？", "face": "lce3866b60bb0"}]}, {"trigger": "end", "lines": [{"name": "テミス", "text": "…………何か可愛さとは違う、\n別のものを見つけてしまった気がしますわ。", "face": "u38"}, {"name": "ティニー", "text": "でも、確かにきらきら輝いてたわ。\n活き活きと戦うマインの姿、\nとっても魅力的に見えたもの。", "face": "u523"}, {"name": "マイン", "text": "へへっ、そう、かな？\nよぉし、テミス師匠、リリア師匠、オリヴィエ師匠！\nアタシに『可愛い』をもっと教えてくれよ！", "face": "u672"}, {"name": "オリヴィエ", "text": "そうですね、それでは王子、\nしばしマインさんをお借りしますね？", "face": "u115"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "リリア", "text": "マインさんを、とびっきり可愛く、\n着飾ってきますから、\n楽しみに待っていてくださいね。", "face": "u20"}, {"name": "マイン", "text": "それじゃあ王子、\nちょっと可愛さの修行に行ってくるぜ。", "face": "u672"}, {"name": "マイン", "text": "ぜーったいに、\n可愛い～ッて、悶えさせてやるからな！！", "face": "u672"}]}], "map": {"image": "Map920114_3309", "w": 960, "h": 640, "spots": [{"k": "b", "x": 25, "y": 112}, {"k": "b", "x": 28, "y": 215}, {"k": "b", "x": 78, "y": 467}, {"k": "m", "x": 805, "y": 124, "id": 200}, {"k": "m", "x": 655, "y": 121, "id": 201}, {"k": "m", "x": 539, "y": 121, "id": 202}, {"k": "m", "x": 419, "y": 121, "id": 203}, {"k": "m", "x": 283, "y": 125, "id": 204}, {"k": "m", "x": 171, "y": 115, "id": 205}, {"k": "m", "x": 710, "y": 205, "id": 206}, {"k": "m", "x": 757, "y": 317, "id": 207}, {"k": "m", "x": 503, "y": 439, "id": 208}, {"k": "m", "x": 460, "y": 341, "id": 209}, {"k": "m", "x": 350, "y": 193, "id": 210}, {"k": "m", "x": 408, "y": 268, "id": 211}, {"k": "m", "x": 579, "y": 186, "id": 212}, {"k": "m", "x": 536, "y": 269, "id": 213}, {"k": "m", "x": 605, "y": 427, "id": 214}, {"k": "m", "x": 693, "y": 383, "id": 215}, {"k": "m", "x": 397, "y": 431, "id": 216}, {"k": "m", "x": 267, "y": 420, "id": 217}, {"k": "m", "x": 341, "y": 359, "id": 218}, {"k": "m", "x": 259, "y": 292, "id": 219}, {"k": "m", "x": 193, "y": 225, "id": 220}, {"k": "m", "x": 813, "y": 409, "id": 221}, {"k": "m", "x": 843, "y": 272, "id": 222}, {"k": "r", "x": 362, "y": 302, "id": 300}, {"k": "r", "x": 227, "y": 175, "id": 301}, {"k": "r", "x": 187, "y": 362, "id": 302}, {"k": "r", "x": 636, "y": 208, "id": 303}, {"k": "r", "x": 543, "y": 351, "id": 304}, {"k": "r", "x": 598, "y": 280, "id": 305}, {"k": "r", "x": 741, "y": 418, "id": 306}, {"k": "r", "x": 316, "y": 471, "id": 307}, {"k": "r", "x": 439, "y": 479, "id": 308}, {"k": "r", "x": 776, "y": 179, "id": 309}, {"k": "r", "x": 795, "y": 468, "id": 310}, {"k": "r", "x": 421, "y": 174, "id": 311}, {"k": "r", "x": 190, "y": 279, "id": 312}]}, "start_cost": 10, "active": true, "name_en": "Inspired by the Princess", "description_en": "Mine, who visited the kingdom, tries to learn about \"cuteness\" from the princesses. <While Teeny is present, enemy women's offense and defense increase> Divine Rank (Target for 1★: Avg Lv50)"}