: 60, "attack_interval": 151, "move_speed": 1300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106288, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 799, "global_id": 798, "ranged": true, "spawn_sec": 118}, {"enemy_id": 9, "source": "local", "count": 1, "level": 190, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 126}, {"enemy_id": 10, "source": "local", "count": 1, "level": 140, "form_count": 1, "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 49, "global_id": 48, "ranged": true, "spawn_sec": 127}, {"enemy_id": 11, "source": "local", "count": 1, "level": 140, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 26, "global_id": 25, "spawn_sec": 129}], "dialogue": [{"trigger": "start", "lines": [{"name": "ジェイク", "text": "いいか？\nもうすぐここに王子が来る。\n女王様の為にも何としてでも生け捕りにしろ！", "face": "u367"}, {"name": "冒険者", "text": "任せてくれ。\nこの女王様のフェロモンを、\n王子に嗅がせればイチコロだ。", "face": "l39f8c23fb7e6"}, {"name": "ジェイク", "text": "頼むぞ。女王様は産卵期の大事な時期。\n餌となる男は上質なほど良い……、\n伝説の英雄の末裔を献上するのだ。", "face": "u367"}, {"name": "ジェイク", "text": "くれぐれも失敗はするなよ？\nそれを一度嗅がせるだけで、\n女王様の支配は永遠のものになるのだからな。", "face": "u367"}, {"name": "冒険者", "text": "へっ。心配性だぜ全く。\nオレ達がいれば王子なんて\n簡単に生け捕りにできるだろうよ。", "face": "l39f8c23fb7e6"}, {"name": "ジェイク", "text": "それじゃあ俺は女王様へ報告しに戻る。\n後のことは、頼んだぞ。", "face": "u367"}, {"name": "冒険者", "text": "王子、来たようだな！\n行くぞ！", "face": "l39f8c23fb7e6"}, {"name": "アンナ", "text": "王子、前方に敵が展開しています！\n女王蟻の兵隊かと思われます。\n戦闘のご準備を！", "face": "l345427989d85"}]}, {"trigger": "end", "lines": [{"name": "冒険者", "text": "うぐぐっ……くそっ。\n作戦失敗だ……後退するぞ！", "face": "l39f8c23fb7e6"}, {"name": "ミゲル", "text": "ふざけんな、あの王子とかいう\nとんでもなく上質な男を\nみすみす逃してたまっかよ！", "face": "u369"}, {"name": "ミゲル", "text": "オレだけでもまだやれるぜ、\nオッサンは勝手に逃げてろ！", "face": "u369"}, {"name": "冒険者", "text": "これだから若造は……いいから来るんだ。\n女王様に傷を癒やしてもらいにいくぞ！", "face": "l39f8c23fb7e6"}, {"name": "ミゲル", "text": "ちょ、こらぁっ、離しやがれっ！\nくっそー、覚えてやがれ、王子ぃー！！", "face": "u369"}, {"name": "アンナ", "text": "あのような方々まで、\n女王蟻の支配下にあるなんて……。", "face": "l345427989d85"}, {"name": "ケイティ", "text": "いったいどれだけの男を\n支配してるっていうのかしら？\nとんでもない魔物ね……。", "face": "u114"}, {"name": "アンナ", "text": "王子、一刻も早く彼らの後を追いましょう。\nさあ、進軍を再開です！", "face": "l345427989d85"}]}], "active": true}