{"quest_id": 4756, "name": "二人の女王の対決", "description": "女王ドロテアと協力し、\nダークエルフを扇動する\nゴブリンクイーンの軍勢を倒せ！\n神級（★１獲得の目安：平均Lv50）", "event": "カボチャの魔導鎧兵", "event_category": "History", "mission_id": 920078, "map_no": 3871, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_range