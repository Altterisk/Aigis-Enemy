defense": 300, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103360, "race_id": 9, "master_id": 441, "global_id": 440, "spawn_sec": 106}, {"enemy_id": 21, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098928, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 119, "global_id": 118, "ranged": true, "spawn_sec": 124}, {"enemy_id": 22, "source": "local", "count": 6, "form_count": 1, "hp": 1500, "attack": 800, "base_hp": 1500, "base_attack": 800, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099056, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 120, "global_id": 119, "ranged": true, "spawn_sec": 125}, {"enemy_id": 23, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 148}], "popups": ["ゴブリンクイーンの騎獣戦車と\nゴブリンの騎獣戦車は拠点には\n向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ダークエルフ", "text": "皆の者、準備はできたか！\nこれよりエルフどもの集落を襲撃する。\n今日こそ、われらの宿願を果たして見せようぞ！", "face": "l51eca20c00b2"}, {"name": "ドロテア", "text": "――待つのだ！\n地上界のダークエルフたちよ。", "face": "u408"}, {"name": "ダークエルフ", "text": "なっ……貴様、いったい何者だ！？", "face": "l51eca20c00b2"}, {"name": "ドロテア", "text": "我こそは闇の女王ドロテア。\n魔界のダークエルフの長にして\n正統なるダークエルフの統治者である。", "face": "u408"}, {"name": "ネヴィン", "text": "おい貴様たち、女王の御前であるぞ。\n頭が高い、控えおろう！", "face": "u407"}, {"name": "ダークエルフ", "text": "…………。", "face": "l51eca20c00b2"}, {"name": "ドロテア", "text": "聞け、我が同胞たちよ。\nエルフの集落を襲撃する計画を、即刻中止するのだ！", "face": "u408"}, {"name": "ドロテア", "text": "いけ好かぬエルフに一泡吹かせたい気持ちは分かる。\nだが、魔神レヴィアタンの復活が眼前に迫っている今、\nエルフ同士で争っている場合ではなかろう？", "face": "u408"}, {"name": "ダークエルフ", "text": "……何を言うかと思えば。全くもって話しにならんな！\n無責任に魔界へ逃げた貴様らに、地上に残された\nダークエルフの苦しみがどうしてわかるというのだ！", "face": "l51eca20c00b2"}, {"name": "ダークエルフ", "text": "今さら来て「正統なるダークエルフの統治者」だと？\n恥を知るがいい！　誰が貴様などに従うものか！\n", "face": "l51eca20c00b2"}, {"name": "ダークエルフ", "text": "……われらの邪魔をするならば、\n女王とてただでは済まさんぞ。", "face": "l51eca20c00b2"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "ゴブリンクイーン", "text": "ダークエルフたち。\n何をもたもたしているの？\n早くエルフの集落に向いなさい。", "face": "le364aea79bcc"}, {"name": "ダークエルフ", "text": "これは女王陛下……！\n申し訳ございません。\n邪魔者が現れまして。", "face": "l51eca20c00b2"}, {"name": "ドロテア", "text": "じょ、女王陛下だと……！？\nこのドロテアを差し置いて、ゴブリンクイーンに\n膝を屈するなど、言語道断であるぞ！", "face": "u408"}, {"name": "ゴブリンクイーン", "text": "あらぁ？　これは自称闇の女王ドロテア様じゃない。\n珍しいところで、お会いしましたわねぇ。", "face": "le364aea79bcc"}, {"name": "ゴブリンクイーン", "text": "地上のダークエルフたちは\n魔界でぬくぬくと暮らしてきたアナタには\n従う気はないそうよぉ……ウフフ。", "face": "le364aea79bcc"}, {"name": "ダークエルフ", "text": "その通りだ。\nよくもわれらの祖先を見捨ててくれたな。\n地上のダークエルフは、お前になど従わんぞ！", "face": "l51eca20c00b2"}, {"name": "ドロテア", "text": "愚かな、ゴブリンクイーンの妄語に惑わされよって。\n……どうやら貴様らには仕置きが必要なようだな。\n闇の女王が真の力……見せてやろう。", "face": "u408"}, {"name": "ネヴィン", "text": "とはいっても、多勢に無勢だぜ、ドロテア様。\n人間どもの加勢を頼んできますので、\nどうか無茶だけはしないでください。", "face": "u407"}, {"name": "ゴブリン博士", "text": "クイーン様……恐れながら申し上げまス。\n魔界のダークエルフの長であるドロテアとは、\n直接の戦いは避けるべきカト……。", "face": "l1c627a0d19c9"}, {"name": "ゴブリンクイーン", "text": "ウフフ……わかっているわ。\nゴブリンたちにもドロテアには、\n手を出さないように命令しなさい。", "face": "le364aea79bcc"}, {"name": "ゴブリンクイーン", "text": "ドロテアはダークエルフたちに任せるの。\nダークエルフ自身がドロテアを亡き者にすれば\nただの仲間割れ……何も問題はないわぁ。", "face": "le364aea79bcc"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "ゴブリンクイーン様！　予想以上の敵の抵抗に、\n我が軍の損害は増大するバカリ。\nエルフの集落を襲撃するのは中止すべきでハ……？", "face": "l1c627a0d19c9"}, {"name": "ゴブリンクイーン", "text": "うーん、そうねぇ……。\n大切な騎獣戦車をここで失うわけには\nいかないものねぇ。", "face": "le364aea79bcc"}, {"name": "ゴブリンクイーン", "text": "今回は魔界と地上のダークエルフたちを\n争わせることが出来ただけでも良しとしましょう。\n騎獣戦車だけでも撤退するわよ……ウフフ。", "face": "le364aea79bcc"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "――クソッ、\n撤退するしかないか……！", "face": "l51eca20c00b2"}, {"name": "ドロテア", "text": "待つのだ、貴様たち！\n……行ってしもうたか。\n愚か者達め……。", "face": "u408"}, {"name": "ドロテア", "text": "それにしても、ゴブリンクイーンめ。\n地上のダークエルフに、このドロテアを襲わせるとは。\nいずれ、あやつとも決着をつけねばならぬな……。", "face": "u408"}]}], "active": true}