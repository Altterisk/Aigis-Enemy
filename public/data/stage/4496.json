.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104976, "race_id": 16, "special_effect_id": 222, "missile_id": 26, "master_id": 584, "global_id": 583, "ranged": true, "spawn_sec": 124}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 900, "base_hp": 10000, "base_attack": 900, "damage_type": "physical", "armor_defense": 100, "attack_range": 280, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104800, "race_id": 16, "special_effect_id": 53, "missile_id": 26, "master_id": 582, "global_id": 581, "ranged": true, "spawn_sec": 124}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "hp": 3600, "attack": 300, "base_hp": 3000, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "attack_range": 200, "attack_speed": 40, "attack_wait": 40, "attack_interval": 119, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105008, "race_id": 16, "missile_id": 26, "master_id": 586, "global_id": 585, "ranged": true, "spawn_sec": 125}], "dialogue": [{"trigger": "start", "lines": [{"name": "サブリナ", "text": "聞けぇッ、野郎どもー！\n激戦の末、私達は魚人族からの支配を脱した！\nもう私らを縛るものは何もないわーッ！", "face": "u332"}, {"name": "私掠船長の部下", "text": "うぉおおおお！\n船長サブリナ―ッ！！\n俺らは自由だーッ！", "face": "u144"}, {"name": "サブリナ", "text": "そこで、サブリナ船団の再出発を祝おうと思う！\nそして……。\n新しい船長も指名する……っ！", "face": "u332"}, {"name": "私掠船長の部下", "text": "うぉぉおお―ッ！　って、え……。\n新しい船長？\n何言って……。", "face": "u144"}, {"name": "サブリナ", "text": "私ね。王子クンの仲間になることに決めたの。", "face": "u332"}, {"name": "私掠船長の部下", "text": "……俺たちを見捨てるって……、ことですかぃ。\nそいつはねぇよ！　せっかくこうして再出発できる\nっていうのによぉ！！", "face": "u144"}, {"name": "サブリナ", "text": "私が初めて心奪われた男なの。\nなにより、王子クンがいれば私はもっと\n強くなれる気がする……。", "face": "u332"}, {"name": "私掠船長の部下", "text": "船長がそこまでいうなら、俺たちは\nそれに従うだけだ……。\nだが――", "face": "u144"}, {"name": "私掠船長の部下", "text": "それは俺たちも認めた男だけだ！！\nおいそこの色男ォ！　船長に釣り合う男かどうか、\n試させてもらうからな！！", "face": "u144"}]}, {"trigger": "end", "lines": [{"name": "サブリナ", "text": "いやー、ここまでしても勝てないかぁ。\n王子クンの強さは本物だわ。彼がいれば、\n本当に海を制覇できるかも……ふふ。", "face": "u332"}, {"name": "私掠船長の部下", "text": "ま、まさか、船長。\n王子を海にひっぱりだそうって言うんですか？", "face": "u144"}, {"name": "サブリナ", "text": "と、一瞬は思ったんだけどね。\nそんな星の下にあの人は生まれてないみたい。\n海にも収まりきらない器ってことね。", "face": "u332"}, {"name": "私掠船長の部下", "text": "船長……。俺たちはいつでも船長の部下っす。\nたとえ新しい海賊として生まれ変わっても。\nこれだけは変わらねぇっすから！", "face": "u144"}, {"name": "サブリナ", "text": "全く……。そんな今生の別れみたいに言わないでよ！\n会おうと思えば会えるんだし。\nなんてったって海は繋がってるのよ？", "face": "u332"}, {"name": "サブリナ", "text": "船はいつだって私達を好きな所に\n連れてってくれるんだから！\nそこんとこ、ちゃーんと覚えておきなさい。", "face": "u332"}, {"name": "私掠船長の部下", "text": "へいっ！！", "face": "u144"}]}], "story_talk": true, "active": true}