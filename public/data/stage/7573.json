{"quest_id": 7573, "name": "砂漠の国のファンサ！", "description": "ついにパレード本番が開始！　竜人たちを\n相手に砂漠の国代表のアサル、アスラハ、\nホルテウスたちが模擬戦を開始する。\n極級（★１獲得の目安：平均Lv25）", "event": "人気闘兵凱旋パレード", "event_category": "History", "mission_id": 920174, "map_no": 4496, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 250, "base_hp": 4000, "base_attack": 250, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "attack_wait": 10, "attack_interval": 48, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2135648, "race_id": 16, "master_id": 34734, "global_id": 8351}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 32000, "attack": 750, "base_hp": 32000, "base_attack": 750, "damage_type": "magical", "armor_defense": 400, "magic_defense": 10, "attack_range": 280, "attack_speed": 1, "attack_wait": 60, "attack_interval": 173, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2131296, "race_id": 16, "missile_id": 620, "missile": {"speed": 8.0, "splash": 80}, "master_id": 34732, "global_id": 8349, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["アーマー"], "hp": 56000, "attack": 900, "base_hp": 56000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 15, "attack_range": 240, "attack_speed": 1, "attack_wait": 30, "attack_interval": 101, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2135632, "race_id": 16, "special_effect_id": 988, "change_to": 3, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 34733, "global_id": 8350, "ranged": true, "to_global_id": 8394}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 56000, "attack": 900, "base_hp":