p": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 300, "attack_range": 180, "attack_speed": 1, "attack_wait": 90, "attack_interval": 221, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132944, "race_id": 2, "change_to": 6, "missile_id": 667, "missile": {"speed": 6.0}, "master_id": 34564, "global_id": 8181, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 293, "global_id": 292, "ranged": true, "spawn_sec": 69}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "hp": 1000, "attack": 230, "base_hp": 1000, "base_attack": 230, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098624, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 150, "global_id": 149, "ranged": true, "spawn_sec": 71}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 180, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 250.0, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100256, "race_id": 2, "change_to": 11, "change_condition": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 712, "global_id": 711, "ranged": true, "to_condition": 2, "to_global_id": 712, "spawn_sec": 121}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 400, "base_hp": 12000, "base_attack": 400, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 90, "attack_speed": 60, "attack_wait": 30, "attack_interval": 161, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100272, "race_id": 2, "missile_id": 36, "missile": {"speed": 5.0, "splash": 160}, "master_id": 713, "global_id": 712, "ranged": true, "from_condition": 2}, {"enemy_id": 13, "source": "local", "count": 6, "form_count": 1, "hp": 2800, "attack": 350, "base_hp": 2800, "base_attack": 350, "damage_type": "magical", "armor_defense": 300, "attack_range": 60, "attack_speed": 57, "attack_wait": 180, "attack_interval": 541, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097232, "race_id": 2, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 5, "ranged": true, "spawn_sec": 124}], "popups": ["アスラハがいる間は\n全ての敵の防御が\n固定値で500アップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ホルテウス", "text": "――なるほど、これが当代のパレードか。\nどうにも懐かしい気分になってしまうものだな。", "face": "u1373a1"}, {"name": "アスラハ", "text": "千年前にも、やはりこういった催しを？", "face": "u1427a1"}, {"name": "ホルテウス", "text": "うむ、無理やり英雄王を招いたりしてな。\n夜会は国を動かし、祭りは民を潤す。\nこういう催しはどんどん開くべきだ。", "face": "u1373a1"}, {"name": "アサル", "text": "……今の砂漠の国には、\n少々荷が重すぎるかもしれませんね。", "face": "u172"}, {"name": "アスラハ", "text": "いやアサル、何事も\n豪勢にやることだけが祭りではない。", "face": "u1427a1"}, {"name": "アスラハ", "text": "民に仕事を与えることで、経済が動く。\n経済が育てば、国は強くなっていくのだ。", "face": "u1427a1"}, {"name": "アサル", "text": "……つまり、小規模でも、\n色々な仕事が生まれる祭りを開いていくといい、と？", "face": "u172"}, {"name": "アスラハ", "text": "女王陛下ならば、きっとそう言うことだろう。\n今のあのお方ならば。", "face": "u1427a1"}, {"name": "ホルテウス", "text": "うむ、未来の砂漠の国は、そなたらに任せたぞ。\n我はこれを終えたら、諸国漫遊にでも出てみるか。", "face": "u1373a1"}, {"name": "アサル", "text": "……王国には残らないのですか？", "face": "u172"}, {"name": "ホルテウス", "text": "ははっ、王子とホルエスの行く末を見届けたら、\nという意味に決まっている。", "face": "u1373a1"}, {"name": "ホルテウス", "text": "それに、我があまり砂漠の国にいると、\nホルエスめが政治をやりにくかろう。", "face": "u1373a1"}, {"name": "アスラハ", "text": "……はは、確かに。\nしかし目指すべき姿を目の当たりにしたことで、\n女王も今、目覚ましい成長を遂げている。", "face": "u1427a1"}, {"name": "アスラハ", "text": "偉大なるホルテウス様には、感謝してもしきれない。", "face": "u1427a1"}, {"name": "ホルテウス", "text": "はっはっは、我に頭を下げている暇があったら、\n竜人の民に手のひとつでも振ってやるといい。", "face": "u1373a1"}, {"name": "ホルテウス", "text": "――ところで、あやつら何故\nぷるぷる震えながら並んでおるのだ？", "face": "u1373a1"}, {"name": "竜人の若者", "text": "パレード中はお行儀ヨク、パレード中はお行儀ヨク……！", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "先程は思いっきり手合わせしてしまいましたからナ！\nパレード中ダケハ！　何とかお行儀ヨク……！！", "face": "l734e530db973"}, {"name": "アスラハ", "text": "……遠慮、しているのか？", "face": "u1427a1"}, {"name": "アサル", "text": "あのぉ、王国式のパレードは、\n腕に覚えのある方なら誰でも参加できる、\n模擬戦演武というものが――", "face": "u172"}, {"name": "竜人の若者", "text": "戦っていいノカ！？", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "コレが！　砂漠の国の！　ファンサ！！", "face": "l734e530db973"}, {"name": "ホルテウス", "text": "ふふっ、いいぞ、盛り上がってきた。\n我も少し、暴れてやるとするか！", "face": "u1373a1"}]}, {"trigger": "end", "lines": [{"name": "訳知り竜人", "text": "……至福……グフッ。", "face": "l734e530db973"}, {"name": "アスラハ", "text": "やるじゃないか、竜人も。\nこれは砂漠の国も、ますます訓練に力を入れないとな。", "face": "u1427a1"}, {"name": "ホルテウス", "text": "……ほどほどにな。\nまぁ、アスラハならば任せても問題ないか。", "face": "u1373a1"}, {"name": "アサル", "text": "兵からも民からも慕われていますからね。\nあとは、もう少し素直だとホルエスさまも――", "face": "u172"}, {"name": "アスラハ", "text": "――何のことだ。", "face": "u1427a1"}, {"name": "アサル", "text": "ふふっ、いいえ、なんでもありません♪", "face": "u172"}, {"name": "ホルテウス", "text": "ほら、ふたりとも、\nイチャついている暇があったら手を振るといい。\n東の国の者たちもやっていたようにな。", "face": "u1373a1"}, {"name": "アサル", "text": "おぉ、手を振るだけで竜人たちが幸せそうに……。", "face": "u172"}, {"name": "アスラハ", "text": "これが、ファンサ、か。\nふふ、今度砂漠の国でも試してみよう。", "face": "u1427a1"}]}], "active": true}