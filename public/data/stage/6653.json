 31392, "global_id": 5011, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2108896, "race_id": 8, "change_to": 11, "change_condition": 3, "master_id": 30119, "global_id": 3738, "to_condition": 3, "to_global_id": 3739, "spawn_sec": 87}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 30, "attack_wait": 10, "attack_interval": 91, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108928, "race_id": 8, "master_id": 30120, "global_id": 3739, "from_condition": 3}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 2, "attack_interval": 32, "move_speed": 1600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109744, "race_id": 8, "special_effect_id": 54, "master_id": 30227, "global_id": 3846, "spawn_sec": 89}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 2, "hp": 20000, "attack": 1750, "base_hp": 20000, "base_attack": 1750, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 165, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2108976, "race_id": 8, "change_to": 14, "change_condition": 3, "master_id": 30607, "global_id": 4226, "to_condition": 3, "to_global_id": 4227, "spawn_sec": 90}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 3500, "base_hp": 20000, "base_attack": 3500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_speed": 20, "attack_wait": 5, "attack_interval": 79, "move_speed": 1400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108992, "race_id": 8, "special_effect_id": 222, "master_id": 30608, "global_id": 4227, "from_condition": 3}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 2, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "change_to": 16, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31395, "global_id": 5014, "ranged": true, "to_global_id": 5013, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 97}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "special_effect_id": 229, "change_to": 15, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31394, "global_id": 5013, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "アナトリア", "text": "へぇ、こいつは面白いね。\n地面がここまで凍ってる戦場なんてね。", "face": "u522"}, {"name": "ベストラ", "text": "この足場の悪さ、修練にはもってこいですね！", "face": "u474"}, {"name": "ドゥーラ", "text": "氷の上で修練、しかもチャンプと一緒になんて！\nくぅぅ！　これは楽しそうだ！！", "face": "u446"}, {"name": "カミラ", "text": "で、でもこんなにつるつるの地面じゃ、\n歩くことも難し――きゃぁっ！？", "face": "u724"}, {"name": "ヴェルティ", "text": "おっと――大丈夫？\nほらカミラ、私から離れないで。", "face": "u477"}, {"name": "カミラ", "text": "あ、ありがとうございます……。", "face": "u724"}, {"name": "ヴェルティ", "text": "――人からお礼を言われるの、悪くない気分ね。\nさて、王子達も来たみたいだし、\n私達の実力を見せてあげないと。", "face": "u477"}, {"name": "スイル", "text": "やばっ……あたしってやっぱり天才？\nもう氷の上でもへっちゃらよ！\n魔獣たちだってスイスイ滑っちゃってるんだから。", "face": "u262"}, {"name": "ケイティ", "text": "王子、最後はアナトリアさん達が相手です。\nどうやら彼女らは、\n既に足場の悪さを克服したようですね。", "face": "u114"}, {"name": "レアン", "text": "くっ……この足場じゃ、\n近接戦闘は難しそうだな……。", "face": "u50"}, {"name": "カノン", "text": "それなら遠距離から攻撃すればいいのよ。\n王子、私も前線で戦うわ。", "face": "u726"}, {"name": "フィリス", "text": "……あれ？\nカノン、お前そのサンタの恰好どうしたんだ？", "face": "u40"}, {"name": "カノン", "text": "な、何よ……そんなに見ないでよ！\n成り行きで着ることになっただけなんだから！", "face": "u726"}, {"name": "アナトリア", "text": "いや、よく似合っているさ。なぁ王子？", "face": "u522"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ケイティ", "text": "それではこれより、\n最後の模擬戦を開始します！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "そこまで！　これにて、模擬戦を終了します！", "face": "u114"}, {"name": "アナトリア", "text": "ふぅ、氷の上を滑るっていうのは、\n何とも痛快だったねぇ。", "face": "u522"}, {"name": "カミラ", "text": "ようやく終わりました。\n人質役も大変ですね……。", "face": "u724"}, {"name": "ヴェルティ", "text": "短い時間だったけど楽しかったわ、カミラ。\n今度は模擬戦じゃなくて、普通に話ができたら良いわね。", "face": "u477"}, {"name": "カミラ", "text": "ふふっ、そうですね。\n今度、お茶でもご一緒しましょう。", "face": "u724"}, {"name": "ケイティ", "text": "カミラさんも、敵役の皆さんもお疲れ様でした。\n今後も雪中での戦闘は必ず起こるでしょうし、\n今回の経験が活きてくる時が、きっと来ると思います。", "face": "u114"}, {"name": "サラサ", "text": "さぁて、それじゃあ急いで戻って、\nクリスマスパーティの準備をしなくちゃね♪", "face": "u317"}, {"name": "カミラ", "text": "はい、腕によりをかけて、お料理を作ります。\n皆さん楽しみにしていてくださいね。", "face": "u724"}, {"name": "アンナ", "text": "たくさん動きましたから、\n皆さんもお腹が減ったことでしょう。\nそれでは王子、私達も王国へ戻りましょうか。"}]}], "story_talk": true, "active": true}