{"quest_id": 7455, "name": "聖域の侵犯者", "description": "マリレーヌと和解し、聖霊ラタトスクの\n元へと向かう一行だったが、これを\n阻止せんと天界の軍勢が襲い掛かる。\n上級（★１獲得の目安：平均Lv10）", "event": "世界の架け橋を求めて", "event_category": "History", "mission_id": 920167, "map_no": 5944, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 14, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105520, "race_id": 6, "change_to": 1, "master_id": 655, "global_id": 654, "route_behaviour": {"transforms": [{"wait": 50}]}, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 11, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 3, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{"wait": 50}]}, "spawn_sec": 11}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 55, "attack_wait": 30, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101072, "race_id": 6, "master_id": 648, "global_id": 647, "spawn_sec": 35}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true, "spawn_sec": 37}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 50}, {"enemy_id": 6, "source": "local", "count": 9, "form_count": 1, "tags": ["植物"], "hp": 4000, "attack": 240, "base_hp": 4000, "base_attack": 240, "damage_type": "physical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 30, "attack_interval": 98, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115520, "special_effect_id": 308, "master_id": 31219, "global_id": 4838, "spawn_sec": 66}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 500, "base_hp": 15000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "attack_range": 400, "attack_speed": 70, "attack_wait": 35, "attack_interval": 130, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105472, "race_id": 6, "special_effect_id": 73, "missile_id": 151, "missile": {"speed": 3.0}, "master_id": 650, "global_id": 649, "ranged": true, "spawn_sec": 112}], "popups": ["弓を持った上位天使は、\nHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "マリレーヌ", "text": "――そうか、貴殿らは世界樹の魔物化を\n止めるために来てくれたのか。", "face": "u1354a1"}, {"name": "クゥイル", "text": "はい……。\nただ、こちらの手元にある神の楔は\n天界侵攻のために消費したため、残りはひとつだけ。", "face": "u702"}, {"name": "クゥイル", "text": "世界樹に打ち込まれた神の楔を砕くことはできても、\n既に進行してしまった魔物化を治す手段はないのです。", "face": "u702"}, {"name": "トゥアン", "text": "だからこそ、その発端たる\n亜神ディアスをぶん殴りに行ったわけだが、\n生憎とオリュンポスの結界に足止めされたってわけだ。", "face": "u1006a1"}, {"name": "マリレーヌ", "text": "ゆえに、世界樹の魔物化を阻止し、\nビフロストを起動しようというわけだな。", "face": "u1354a1"}, {"name": "マリレーヌ", "text": "むむむ……重ね重ねすまなかった。\nここ最近は魔物の襲撃が多くて、\nつい問答無用で斬りかかってしまったのだ。", "face": "u1354a1"}, {"name": "アナベラ", "text": "まぁいいよ、事情が事情だしね。\nぼくだって叡智の園に来た王子たちを、\n割と全力で迎え撃ったりしたし……。", "face": "u1309a1"}, {"name": "マリレーヌ", "text": "ふふっ、私たちは似たもの同士ということだな！", "face": "u1354a1"}, {"name": "アナベラ", "text": "絶対違うッ！！\n断固として違うッ！！", "face": "u1309a1"}, {"name": "マリレーヌ", "text": "――と、友情を深めている暇はなさそうだな。\n貴殿ら、いったい何を連れてきた？", "face": "u1354a1"}, {"name": "フローガ", "text": "連れて……？\nはっ、この魔力の乱れ方……まさか……。", "face": "u878"}, {"name": "フローガ", "text": "王子殿下！　多数の天使が出現しました！\n結構近いですよ、これ。すぐに襲撃してきます！", "face": "u878"}, {"name": "マリレーヌ", "text": "天界の者をラタトスク様に近付けるわけにはいかない。\n貴殿らはそちらの天使どもを頼むぞ！", "face": "u1354a1"}, {"name": "アナベラ", "text": "あぁもう、返事も聞かずに向こうへ走っていったぞ。\n王子、聞いてのとおりだ。\nここで天使を迎撃するぞ！", "face": "u1309a1"}]}, {"trigger": "end", "lines": [{"name": "マリレーヌ", "text": "やれやれ……。\n天界との戦いというのは大変だな。", "face": "u1354a1"}, {"name": "マリレーヌ", "text": "どこにいても天使が襲撃してくるとは、\n気も休まらないことだろう。", "face": "u1354a1"}, {"name": "アナベラ", "text": "ぼくも仲間に加わったばかりではあるけど、\n今までが嘘みたいな忙しさだね……。\n王国軍なんて常に戦い続けてるわけだし。", "face": "u1309a1"}, {"name": "マリレーヌ", "text": "私も先祖から、英雄王の連戦具合は聞いているよ。\nどうやらこれは、王国の血筋というものらしいな。", "face": "u1354a1"}, {"name": "マリレーヌ", "text": "しかし、軍が常に戦い続けられるということは、\n国民の士気が高く、生産力も落ちていないということだ。\n私は随分な傑物に剣を向けてしまったようだな。", "face": "u1354a1"}, {"name": "アナベラ", "text": "分かってくれればいいよ。\nそれで、ラタトスク様の所までは\nあとどれくらいなんだい？", "face": "u1309a1"}, {"name": "マリレーヌ", "text": "何、もうすぐだ。\nそこの枝を登りきれば――", "face": "u1354a1"}, {"name": "？？？", "text": "――なんじゃぁ！？\n貴様らいったい何者じゃー！？", "face": "u1375a1"}, {"name": "マリレーヌ", "text": "今のは……ラタトスク様の声……っ！？\n急ぐぞ王子、アナベラ！", "face": "u1354a1"}]}], "active": true}