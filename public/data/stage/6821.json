1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 77}, {"enemy_id": 5, "source": "local", "count": 14, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_wait": 1, "attack_interval": 19, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "special_effect_id": 64, "master_id": 31837, "global_id": 5456, "spawn_sec": 93}], "dialogue": [{"trigger": "start", "lines": [{"name": "フウカ", "text": "――王子、大変！\n魔物の群れの前に女の子がいるわ！", "face": "u228"}, {"name": "？？？", "text": "――がうう。\nこわくない、こわくない……。\nボ、ボクが退治しないといけないんだから……っ。", "face": "u843"}, {"name": "ラテリア", "text": "村の他の出入り口は王国兵が抑えてるけど、\nここはもうあの子一人だけ、か。\n王子、すぐ助けに入ろう！", "face": "u532"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "？？？", "text": "がうぅっ、やっぱり怖い……！！\nでも、うぅぅ、ここで逃げたら――って\nあ、あれ？　あなた達は……？", "face": "u843"}, {"name": "アンナ", "text": "我々は王国の者です。\nここまで村を守っていただいて、\n本当にありがとうございます。", "face": "le4da4fde4f27"}, {"name": "ラテリア", "text": "ここからは僕達にまかせて……って、\nうわ、傷だらけじゃないか。\n早く後ろに下がって手当てを！", "face": "u532"}, {"name": "？？？", "text": "がう……うん。\n分かった、ありがとう。\nお兄ちゃん、お姉ちゃん。", "face": "u843"}, {"name": "アンナ", "text": "王子、魔物が包囲を狭めてきています。\n急ぎ迎撃の準備をお願いします！", "face": "le4da4fde4f27"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "周辺の魔物は、\n何とか全て退けられたようですね……。", "face": "le4da4fde4f27"}, {"name": "フウカ", "text": "他の地点からも伝令が来たわ。\n負傷者はいるけれど、\n村人も含め、全員無事みたいよ。", "face": "u228"}, {"name": "？？？", "text": "がう……助けてくれて、ありがとう。\nでも、ごめんなさい、ボクのせいで……。", "face": "u843"}, {"name": "ケイティ", "text": "あなたのせい……？\nそれはどういう事でしょうか……？", "face": "u114"}, {"name": "？？？", "text": "がう……。\nこの剣が、どこかにボクを導いているんだ……。", "face": "u843"}, {"name": "？？？", "text": "導かれるままに歩いてきたら、\nどんどん魔物が現れて……っ！\nだからきっと、これはボクのせいで……！", "face": "u843"}, {"name": "ラテリア", "text": "……うぅん、落ち着いて。大丈夫。\nひとまず詳しい話を聞かせてくれないかな？", "face": "u532"}, {"name": "ラテリア", "text": "ここにいるお兄さんはね、王国の王子様で、\n困ってる人を見捨てられない性分なんだ。――ね？", "face": "u532"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "？？？", "text": "わ、わわ……ありがとう。ありがとうっ！", "face": "u843"}, {"name": "アンナ", "text": "それでは、一度拠点へ戻りましょうか。\n皆さん、撤収の準備をお願いします！"}]}], "map": {"image": "Map920131_3415", "w": 960, "h": 640, "spots": [{"k": "b", "x": 945, "y": 264}, {"k": "m", "x": 199, "y": 155, "id": 200}, {"k": "m", "x": 399, "y": 231, "id": 201}, {"k": "m", "x": 440, "y": 413, "id": 202}, {"k": "m", "x": 547, "y": 375, "id": 203}, {"k": "m", "x": 648, "y": 359, "id": 204}, {"k": "m", "x": 744, "y": 324, "id": 205}, {"k": "m", "x": 849, "y": 284, "id": 206}, {"k": "m", "x": 309, "y": 173, "id": 207}, {"k": "m", "x": 464, "y": 297, "id": 208}, {"k": "m", "x": 477, "y": 493, "id": 209}, {"k": "m", "x": 587, "y": 515, "id": 210}, {"k": "m", "x": 712, "y": 512, "id": 211}, {"k": "m", "x": 586, "y": 107, "id": 212}, {"k": "m", "x": 612, "y": 190, "id": 213}, {"k": "m", "x": 660, "y": 269, "id": 214}, {"k": "r", "x": 752, "y": 256, "id": 300}, {"k": "r", "x": 603, "y": 299, "id": 301}, {"k": "r", "x": 205, "y": 248, "id": 302}, {"k": "r", "x": 287, "y": 250, "id": 303}, {"k": "r", "x": 655, "y": 126, "id": 304}, {"k": "r", "x": 423, "y": 332, "id": 305}, {"k": "r", "x": 391, "y": 474, "id": 306}, {"k": "r", "x": 521, "y": 436, "id": 307}, {"k": "r", "x": 219, "y": 115, "id": 308}, {"k": "r", "x": 810, "y": 369, "id": 309}, {"k": "r", "x": 722, "y": 396, "id": 310}, {"k": "r", "x": 626, "y": 415, "id": 311}]}, "start_cost": 10, "active": true, "name_en": "Guided by the Demon Sword", "description_en": "A Swordsman defending the village from Monsters\nis in dire straits. Repel the horde to save\nthe Swordsman and the village!\nIntermediate (Target for 1★: Avg Lv1, 8 units)"}