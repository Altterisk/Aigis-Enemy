damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 26}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 13500, "attack": 600, "base_hp": 13500, "base_attack": 600, "damage_type": "magical", "armor_defense": 375, "magic_defense": 90, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 236, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103248, "special_effect_id": 222, "change_to": 5, "change_condition": 1, "missile_id": 6, "master_id": 31091, "global_id": 4710, "ranged": true, "variants": [{"hp": 13500, "attack": 900, "base_hp": 13500, "base_attack": 900, "damage_type": "physical", "armor_defense": 375, "magic_defense": 90, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "special_effect_id": 222, "master_id": 31090, "global_id": 4709}], "spawn_sec": 52}, {"enemy_id": 7, "source": "local", "count": 10, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 55}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 450, "base_hp": 3000, "base_attack": 450, "damage_type": "magical", "armor_defense": 120, "magic_defense": 90, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "special_effect_id": 222, "missile_id": 6, "master_id": 31089, "global_id": 4708, "ranged": true, "spawn_sec": 64}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "magical", "armor_defense": 250, "magic_defense": 50, "attack_range": 250, "attack_speed": 70, "attack_wait": 15, "attack_interval": 236, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103248, "change_to": 9, "change_condition": 1, "missile_id": 6, "master_id": 424, "global_id": 423, "ranged": true, "variants": [{"hp": 9000, "attack": 600, "base_hp": 9000, "base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103232, "master_id": 423, "global_id": 422}], "spawn_sec": 78}, {"enemy_id": 11, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 296, "master_id": 31084, "global_id": 4703, "spawn_sec": 90}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 12000, "attack": 1200, "base_hp": 12000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 90, "attack_speed": 1, "attack_wait": 300, "attack_interval": 650, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115104, "special_effect_id": 297, "master_id": 31085, "global_id": 4704, "spawn_sec": 92}], "dialogue": [{"trigger": "start", "lines": [{"name": "スプラ", "text": "――き、来ましたっ！\nダークエルフの本隊が到着したみたいです！", "face": "u355"}, {"name": "アンナ", "text": "王子、戦闘のご準備を！", "face": "le9fe07963d6d"}, {"name": "ダークエルフ", "text": "フッ、エルフの腰抜けどもめ。\n自領の防衛を人間どもの手に委ねるとはな。", "face": "laf7c4466fda5"}, {"name": "ダークエルフ", "text": "聞け、同胞よ！　勇猛なる戦士たちよ！\n今こそ憎きエルフどもに誅を下す時ぞ！", "face": "laf7c4466fda5"}, {"name": "ダークエルフ", "text": "偉大なる力を秘めし花びらを手にした時より、\n天意は我らダークエルフと共にあるのだ！", "face": "laf7c4466fda5"}, {"name": "ファルネ", "text": "――いいえ、そんなの間違ってるわ！", "face": "u640"}, {"name": "ダークエルフ", "text": "……なんだと？", "face": "laf7c4466fda5"}, {"name": "ファルネ", "text": "偉大な力は、特定の誰かの野望を叶えるために\n使われるべきじゃない……。\n人々を救ったり、幸せにするために使われるべきよ！", "face": "u640"}, {"name": "ダークエルフ", "text": "……フン、綺麗事を。\nならばどちらが正しいか、\n貴様らの血で証明してやろう！", "face": "laf7c4466fda5"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "――ぐぁあッ！！　な、なぜだ……？\n花びらは……我らの手にあったというのに……。\n世界樹は、我らに味方したのではなかったのか……ッ！", "face": "laf7c4466fda5"}, {"name": "ダークエルフ", "text": "このままでは壊滅は逃れられん……。\n……クソッ！　ええい、総員撤退だッ！！", "face": "laf7c4466fda5"}, {"name": "ファルネ", "text": "（…………世界樹？）", "face": "u640"}, {"name": "オリヴィエ", "text": "――はぁ、はぁッ……。\n申し訳ありません、皆様。遅くなりました。\nして、敵はどちらですか？", "face": "u115"}, {"name": "アンナ", "text": "オリヴィエ様、増援に来てくださったのですね！\nですが、もう大丈夫です。敵はなんとか撃退しました。"}, {"name": "ププル", "text": "なんじゃ。せっかくこの可愛いププル様が\n走ってきてやったというに……ん？", "face": "u225"}, {"name": "ププル", "text": "ややっ！？　お、お主……、\nそれはひょっとして、世界樹の花びらではないか？", "face": "u225"}, {"name": "ファルネ", "text": "これが、世界樹の花びら……？\n……教えてください、世界樹とはなんなのですか？", "face": "u640"}, {"name": "ププル", "text": "うぅむ……教えたいのは山々じゃが、\nわしらもさほど詳しいことは知らぬでのぅ……。", "face": "u225"}, {"name": "オリヴィエ", "text": "世界樹の存在は、かつてはダークエルフを含む\n一部のエルフに伝承されていたようなのですが……、\n現在ではそのほとんどが失伝してしまっているのです。", "face": "u115"}, {"name": "ププル", "text": "わしが覚えておるのは、\n『世界樹はそれ自体が大いなる意志とも呼べる存在』\nと誰かが申しとったことくらいじゃが……。", "face": "u225"}, {"name": "ププル", "text": "その世界樹が花を咲かせたということは、\nなにか大きなことが起こる前触れかもしれんのぅ。", "face": "u225"}, {"name": "ファルネ", "text": "世界樹の意志……そうだ！\n意思があるのなら、この花びらを媒体にすれば\n世界樹の力を召喚できるかも……！", "face": "u640"}, {"name": "ファルネ", "text": "……なんて、そんなのダメよね。\n偉大な力を自分の研究のために使うなんて……。", "face": "u640"}, {"name": "オリヴィエ", "text": "……いえ、よいのではないでしょうか。\n私は今の貴方でしたら、世界樹の力をこの世界全体の\n平和と安寧のために使って頂けると信じております。", "face": "u115"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ファルネ", "text": "みんな…………ありがとう。\n『ジューンブライド』が終わったら、みんなの期待に\n応えられるよう、すぐに花びらの研究に取り掛かるわね。", "face": "u640"}, {"name": "アンナ", "text": "ええ。そのためにも、早く王国に戻って\n『ジューンブライド』を開催いたしましょう。\n……ふふっ、素敵なイベントになりそうですね、王子。"}]}], "active": true}