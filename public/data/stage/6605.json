{"quest_id": 6605, "name": "証明・英雄の器", "description": "全力を出したクゥイルとの最後の模擬戦。\n今までに示した力の全てでぶつかり合え！\n＜コハルがいる間は敵味方の能力減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["コハルがいる間は敵味方の能力減少"], "event": "雄飛せし鷲獅騎兵", "event_category": "History", "mission_id": 920117, "map_no": 3330, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 1, "hp": 1200, "attack": 150, "base_hp": 1200, "base_attack": 150, "damage_type": "physical", "armor_defense": 400, "magic_defense": 5, "attack_speed": 80, "attack_wait": 60, "attack_interval": 270, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097776, "race_id": 16, "master_id": 34, "global_id": 33, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 14, "form_count": 1, "hp": 2500, "attack": 600, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 27, "global_id": 26, "spawn_sec": 26}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 17250, "attack": 1200, "base_hp": 17250, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 50, "attack_interval": 189, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105792, "race_id": 16, "master_id": 733, "global_id": 732, "spawn_sec": 49}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 2200, "base_hp": 25000, "base_attack": 2200, "damage_type": "physical", "attack_speed": 55, "attack_wait": 10, "attack_interval": 157, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_