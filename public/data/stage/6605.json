": 25, "spawn_sec": 79}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "hp": 2800, "attack": 600, "base_hp": 2800, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097328, "race_id": 16, "master_id": 12, "spawn_sec": 88}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 22000, "base_hp": 22000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111216, "race_id": 4, "special_effect_id": 179, "master_id": 30536, "global_id": 4155, "spawn_sec": 121}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 25000, "attack": 400, "base_hp": 25000, "base_attack": 400, "damage_type": "magical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107248, "race_id": 4, "special_effect_id": 103, "master_id": 526, "global_id": 525, "spawn_sec": 125}, {"enemy_id": 12, "source": "local", "count": 2, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_range": 200, "attack_speed": 60, "attack_wait": 50, "attack_interval": 133, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110368, "special_effect_id": 165, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30286, "global_id": 3905, "ranged": true, "spawn_sec": 140}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "hp": 1300, "attack": 300, "base_hp": 1300, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_range": 200, "attack_speed": 60, "attack_wait": 50, "attack_interval": 139, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2116272, "special_effect_id": 165, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31319, "global_id": 4938, "ranged": true, "spawn_sec": 141}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 3, "hp": 14000, "attack": 1000, "base_hp": 14000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 400, "attack_range": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 59, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116240, "special_effect_id": 164, "change_to": 14, "missile_id": 45, "master_id": 31320, "global_id": 4939, "ranged": true, "to_global_id": 4940, "route_behaviour": {"transforms": [{"wait": 2200}], "calls_event": [2163, 2164, 2165, 2166, 2167]}, "spawn_sec": 143}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 14000, "attack": 1000, "base_hp": 14000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 400, "attack_speed": 60, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116256, "special_effect_id": 323, "change_to": 15, "missile_id": 45, "master_id": 31321, "global_id": 4940, "to_global_id": 4941}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 14000, "attack": 1500, "base_hp": 14000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 400, "attack_range": 200, "attack_speed": 60, "attack_wait": 40, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2116240, "special_effect_id": 322, "missile_id": 77, "missile": {"speed": 2.0}, "master_id": 31322, "global_id": 4941, "ranged": true}, {"enemy_id": 17, "source": "local", "count": 8, "form_count": 1, "hp": 1500, "attack": 400, "base_hp": 1500, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 111, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110320, "special_effect_id": 165, "missile_id": 45, "master_id": 30284, "global_id": 3903, "spawn_sec": 148}, {"enemy_id": 18, "source": "local", "count": 9, "form_count": 1, "hp": 1500, "attack": 400, "base_hp": 1500, "base_attack": 400, "damage_type": "physical", "armor_defense": 100, "attack_range": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 61, "move_speed": 1700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110336, "special_effect_id": 164, "missile_id": 45, "master_id": 30285, "global_id": 3904, "ranged": true, "spawn_sec": 158}], "dialogue": [{"trigger": "start", "lines": [{"name": "クゥイル", "text": "王子殿下の器、そして王国の皆様の実力は、\n見極めさせていただきました。", "face": "u702"}, {"name": "クゥイル", "text": "もはや貴殿らの実力に、\n疑う余地など一片もありません。", "face": "u702"}, {"name": "クゥイル", "text": "ですから最後のこの一戦は、\n一騎の武人として、王子殿下の胸を借りたく思います。", "face": "u702"}, {"name": "ディーネ", "text": "器の見極めを抜きにして、\n武人としてぶつかり合いたいということですね。\nふふ、腕がなります。", "face": "u223"}, {"name": "ディーナ", "text": "王子とは随分とご無沙汰だったしな。\nちょっと、稽古つけてやるとしようか。", "face": "u22"}, {"name": "ライラ", "text": "はぁ……模擬戦、模擬戦ねぇ……？\nま、やるんなら全力でやってやろうか！", "face": "u81"}, {"name": "イナリ", "text": "ライラちゃん、何だか嬉しそうじゃない？\n嫌々参加したようには見えないなぁ。", "face": "u243"}, {"name": "コハル", "text": "おや本当に。\nこれは武者震いというより、\n楽しくて仕方ないってぇ震え方だねぇ。", "face": "u450"}, {"name": "ライラ", "text": "うっせぇ狐と猫！\nコンラッド達が戦ってたの見てうずうずしてたんだよ！", "face": "u81"}, {"name": "レシア", "text": "まぁ確かに、一流の武人である王子と\n刃を交えるとなれば、同じく武を志す者として\n身体がうずいてしまうのもわかるというものだ。", "face": "u358"}, {"name": "クゥイル", "text": "最後の模擬戦は、これまでに見せていただいた、\n英雄の器に必要である、\n全ての要素をもって、王子殿下に挑みます。", "face": "u702"}, {"name": "クゥイル", "text": "準備は良いですか、王子殿下。\nそれでは……行きますよ……ッ！！", "face": "u1702"}, {"name": "アンナ", "text": "王子、これが最後の模擬戦です。\nクゥイルさんに、私達の全力をお見せしましょう！", "face": "l513e4e03b3fb"}]}, {"trigger": "end", "lines": [{"name": "クゥイル", "text": "――完敗です、王子殿下。\nやはり貴殿こそ、英雄と呼ぶに相応しい。", "face": "u702"}, {"name": "イナリ", "text": "すごかったよ、王子。\nこっち側から王子を見るのは久々だから、\nちょっとどきどきしちゃった。", "face": "u243"}, {"name": "クゥイル", "text": "えぇ、鬼気迫る表情、\n戦いの熱情の中に見える冷静さ、どれをとっても\n英雄譚にうたわれるそれに等しいものでした。", "face": "u702"}, {"name": "シュシュ", "text": "クゥイルちゃん、王子さまのことべた褒めですねぇ♪\nクゥイルちゃんが本気で戦う姿も\nひっさしぶりに見れちゃいました！", "face": "u656"}, {"name": "クゥイル", "text": "お恥ずかしい……つい熱くなってしまいました。\nけれど、王子殿下の戦いぶり、\n本当に素晴らしいものでした。", "face": "u702"}, {"name": "クゥイル", "text": "こんなお方のお側で戦えたら、\nどれだけ素敵でしょうね……。", "face": "u702"}, {"name": "シュシュ", "text": "えっ？　クゥイルちゃん王国に来るんですか？\nやった！　やーりまーしたー！！\nあっ、案内は私にまかせてくださいねー！", "face": "u656"}, {"name": "クゥイル", "text": "こ、こらシュシュ！　抱きつかないでください！\n私はお側で戦えたらと言っただけで、\n王国に来たいとはまだ一言も……！！", "face": "u702"}, {"name": "ライラ", "text": "あん？　「まだ」って言ったか？", "face": "u81"}, {"name": "クゥイル", "text": "はっ！？　うっ……うぅぅ……。\nさすがは山賊です。なんて耳聡い……。", "face": "u702"}, {"name": "クゥイル", "text": "あの、王子殿下……後ほどお話をよろしいですか？", "face": "u702"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "それでは、これにて模擬戦は終了です。\n皆さんお疲れだと思いますので、\nしっかりと身体を休めてくださいね。"}]}, {"trigger": "route", "enemy_ids": [14], "lines": [{"name": "クゥイル", "text": "やはり、王子殿下の実力は本物。\n相手にとって不足なし。", "face": "u1702"}, {"name": "クゥイル", "text": "ならば、我が全身全霊の一撃をもって\n挑むよりほかにはありません……ッ！！", "face": "u1702"}, {"name": "クゥイル", "text": "はぁぁ――ッ！！", "face": "u1702"}, {"name": "アンナ", "text": "王子、クゥイルさんは強力な攻撃を準備している様子。\n先手を打った方が良いかもしれませんね……。\n十分なご注意を！", "face": "l513e4e03b3fb"}]}, {"trigger": "route", "enemy_ids": [14], "lines": [{"name": "クゥイル", "text": "王子殿下、参ります！\n我が奥義、超えてみせて下さい！", "face": "u1702"}]}], "active": true}