{"quest_id": 8287, "name": "新時代のレクリエーション", "description": "グレーターデーモンによる密漁を阻止せよ！\n＜深海(弱)：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["深海(弱)：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "サマーオブバーバリアンズ", "event_category": "History", "mission_id": 920217, "map_no": 4909, "level": 100, "multiplier": 1.0, "charisma": 65, "exp": 300, "gold": 1500, "drops": [{"card": 23, "c": 1}, {"card": 50, "c": 1}, {"card": 133, "c": 1}, {"item": 1002, "c": 1}, {"item": 5003, "c": 2}], "capacity": 8, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 6, 30], "ext": "攻撃待ち増加=30,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中", "水棲", "アーマー"], "hp": 148000, "attack": 2800, "base_hp": 148000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 15, "attack_range": 90, "attack_speed": 1, "attack_wait": 60, "attack_interval": 185, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2153920, "missile_id": 11, "master_id": 37577, "global_id": 11194, "ranged": true, "spawn_sec": 42}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["水棲"], "hp": 125000, "attack": 2000, "base_hp": 125000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 40, "attack_range": 280, "attack_speed": 1, "attack_wait": 100, "attack_interval": 261, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2153952, "race_id": 3, "special_effect_id": 240, "missile_id": 1091, "missile": {"speed": 10.0}, "master_id": 37579, "global_id": 11196, "ranged": true, "spawn_sec": 45}, {"enemy_id": 3, "source": "local", "count": 53, "form_index": 0, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 120, "magic_defense": 15, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123728, "race_id": 7, "special_effect_id": 229, "missile_id": 232, "master_id": 32689, "global_id": 6307, "ranged": true, "spawn_sec": 89}, {"enemy_id": 4, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 226, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123040, "race_id": 7, "change_to": 4, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 32935, "global_id": 6552, "ranged": true, "variants": [{"hp": 10000, "attack": 1050, "base_hp": 10000, "base_attack": 1050, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 179, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123024, "race_id": 7, "master_id": 32936, "global_id": 6553}], "spawn_sec": 121}, {"enemy_id": 6, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["水中"], "hp": 25000, "attack": 1600, "base_hp": 25000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 150, "attack_interval": 358, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123680, "race_id": 7, "master_id": 32684, "global_id": 6302, "spawn_sec": 180}, {"enemy_id": 7, "source": "local", "count": 13, "form_index": 0, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 35000, "attack": 800, "base_hp": 35000, "base_attack": 800, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 150, "attack_interval": 351, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124384, "race_id": 7, "special_effect_id": 232, "missile_id": 481, "missile": {"speed": 1.0}, "master_id": 34522, "global_id": 8139, "ranged": true, "spawn_sec": 190}, {"enemy_id": 8, "source": "local", "count": 9, "form_index": 0, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 7000, "attack": 750, "base_hp": 7000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 60, "attack_speed": 1, "attack_wait": 25, "attack_interval": 109, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2123760, "race_id": 7, "missile_id": 11, "master_id": 32691, "global_id": 6309, "ranged": true, "spawn_sec": 203}], "popups": ["\n\n\n　　──事件発生の数時間前。", "ダイビングを楽しむ\nグレーターデーモンから\n攻撃を受けると、\n即座に麻痺状態になります。", "サラタンの幼体から\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\nブロックされている間は、\n攻撃に遅延効果が無くなります。"], "dialogue": [{"trigger": "battle", "at_sec": 44, "lines": [{"text": "──事件発生の数時間前。"}, {"name": "ハルフゥ", "text": "皆様、この度はデモシェフ商会プレゼンツ。\n人魚のスキューバダイビングにようこそ～♪", "face": "u1118a1"}, {"name": "メーア", "text": "はーい♪", "face": "u1038a1"}, {"name": "メフィスト", "text": "なるほど……海巫女の加護を活かした海中遊泳とは、\n確かにこれは新時代のレクリエーションだと言えるね。", "face": "u1036a1"}, {"name": "エリアス", "text": "海中ではいつも戦ってばかりでしたからね、\nたまにはこういうのも新鮮で良いと思います。", "face": "u1039a1"}, {"name": "エレオノーラ", "text": "王子殿下には改めて感謝しませんと。\n我々もリゾートに誘っていただけて──", "face": "u1023a1"}, {"name": "フレイ", "text": "──あっ、見て！　あそこに何か泳いでるよ！", "face": "u1025a1"}, {"name": "リバン", "text": "あれはジャイアントアノマロカリスさんですわね。\n今ではこの近辺でしか見られない希少な甲殻類で──", "face": "u1062a1"}]}, {"trigger": "battle", "at_sec": 48, "lines": [{"name": "グレーターデーモン", "text": "──よし、これで三匹目だねぇ。", "face": "l430a1d57d86b"}, {"name": "エリアス", "text": "グ、グレーターデーモン？　何故ここに……？", "face": "u1039a1"}, {"name": "グレーターデーモン", "text": "んん？　君たちは王国……ではなく帝国かな？\nこんなところで会うとは奇遇じゃないかい。", "face": "l430a1d57d86b"}, {"name": "グレーターデーモン", "text": "ワシはジャイアントアノマロカリス漁の途中でね。\n君たちはダイビングか、デモシェフ商会の提供かい？", "face": "l430a1d57d86b"}, {"name": "リーゼロッテ", "text": "あ、ああ……。", "face": "u1026a1"}, {"name": "グレーターデーモン", "text": "ふーむ、中々面白い試みだ、ゆっくり楽しむといい。\nそれじゃあワシは行くよ、邪魔したようで悪かったね。", "face": "l430a1d57d86b"}, {"name": "ハルフゥ", "text": "み、みみみ、みっ──", "face": "u1118a1"}, {"name": "リバン", "text": "密漁ですわーーーー！！！！", "face": "u1062a1"}, {"name": "メーア", "text": "えっ、密漁！？　こんな堂々としてるのに！？", "face": "u1038a1"}, {"name": "グレーターデーモン", "text": "ふむ、バレてしまったかい。", "face": "l430a1d57d86b"}, {"name": "リバン", "text": "ジャイアントアノマロカリスさんは絶滅危惧種ですのよ！\n近隣の漁師の方々の献身的な保護活動の甲斐があって、\n最近はようやく個体数が回復してきましたと言うのに……。", "face": "u1062a1"}, {"name": "ハルフゥ", "text": "そのアノマロカリスさんたちを密漁しようなんて、\n漁師さんたちの苦労を何だと思っているんですか！？", "face": "u1118a1"}, {"name": "グレーターデーモン", "text": "……ワシも過去には一次産業に従事した身、\n漁師たちの苦悩は理解しているつもりだとも。", "face": "l430a1d57d86b"}, {"name": "グレーターデーモン", "text": "だが、その上で宣言させてもらおう。密漁をすると。", "face": "l430a1d57d86b"}, {"name": "ジークリンデ", "text": "その意気や良し。であれば斬られても文句はないな？", "face": "u1024a1"}, {"name": "グレーターデーモン", "text": "……ワシにも譲れない理由があってね。\n悪いけれど、全力で抵抗させてもらうよ。", "face": "l430a1d57d86b"}]}, {"trigger": "end", "lines": [{"name": "ジークリンデ", "text": "……言い残すことはあるか。", "face": "u1024a1"}, {"name": "グレーターデーモン", "text": "何もないさ。", "face": "l430a1d57d86b"}, {"name": "ハルフゥ", "text": "わー！？　わー！？　殺しちゃダメですよー！？", "face": "u1118a1"}, {"name": "ジークリンデ", "text": "そうか？　被害者がそう言うのなら構わんが……。", "face": "u1024a1"}, {"name": "リバン", "text": "……グレーターデーモンさん。\nどうして密漁なんて真似をしたんですの？", "face": "u1062a1"}, {"name": "グレーターデーモン", "text": "大口の顧客から依頼があったんだよ。\nジャイアントアノマロカリスが欲しいとね。\nなんでも、娘の治療に使いたいそうだ。", "face": "l430a1d57d86b"}, {"name": "フレイ", "text": "治療……ってどういうこと？", "face": "u1025a1"}, {"name": "ハルフゥ", "text": "ジャイアントアノマロカリスさんは、\n全身がとある難病の薬になるんです。", "face": "u1118a1"}, {"name": "リバン", "text": "乱獲され個体数が激減したのも、\nそれが原因だったはずですわ。", "face": "u1062a1"}, {"name": "ジークリンデ", "text": "……なるほど理由は理解したが、\nそれでも密漁していい理由にはならないな。", "face": "u1024a1"}, {"name": "エリアス", "text": "ええ、まずは漁師の方と交渉するのが先では？", "face": "u1039a1"}, {"name": "グレーターデーモン", "text": "しようとしたとも、だけど門前払いを受けてね。\n大切なアノマロカリスを悪用させるわけにはいかないと。\nこれまでのワシの悪評が、ここにきて返ってきた形さ。", "face": "l430a1d57d86b"}, {"name": "メーア", "text": "あー。", "face": "u1038a1"}, {"name": "エリアス", "text": "……確かに、いきなりだと怪しい話に聞こえますね。", "face": "u1039a1"}, {"name": "ハルフゥ", "text": "……分かりました、私が間に立ちます。\n密漁のことをちゃんと謝ってから、\nそれから正規の手段で交渉してください。", "face": "u1118a1"}, {"name": "グレーターデーモン", "text": "ワシを、許すと言うのかい……？", "face": "l430a1d57d86b"}, {"name": "リバン", "text": "許すかどうかを決めるのは漁師の方々ですわ。\n私たちはただ、謝罪の場を設けるだけです。", "face": "u1062a1"}, {"name": "リバン", "text": "ですが、もしもあなたの誠意が相手方に伝われば、\n一匹ぐらいは融通してもらえるかもしれませんわね。", "face": "u1062a1"}, {"name": "グレーターデーモン", "text": "…………すまない、感謝するよ。", "face": "l430a1d57d86b"}, {"name": "グレーターデーモン", "text": "（やはり誠心誠意か……。\n結局のところ商売で一番大事なのは、\n『心』なのかもしれないねぇ……）", "face": "l430a1d57d86b"}]}], "map": {"image": "Map920217_4909", "w": 960, "h": 640, "spots": [{"k": "b", "x": 939, "y": 468}, {"k": "m", "x": 862, "y": 435, "id": 200}, {"k": "m", "x": 789, "y": 389, "id": 201}, {"k": "m", "x": 746, "y": 328, "id": 202}, {"k": "m", "x": 717, "y": 259, "id": 203}, {"k": "m", "x": 694, "y": 191, "id": 204}, {"k": "m", "x": 749, "y": 126, "id": 205}, {"k": "m", "x": 589, "y": 171, "id": 206}, {"k": "m", "x": 478, "y": 148, "id": 207}, {"k": "m", "x": 369, "y": 127, "id": 208}, {"k": "m", "x": 263, "y": 107, "id": 209}, {"k": "m", "x": 182, "y": 194, "id": 211}, {"k": "m", "x": 215, "y": 285, "id": 212}, {"k": "m", "x": 256, "y": 371, "id": 213}, {"k": "m", "x": 288, "y": 446, "id": 214}, {"k": "m", "x": 388, "y": 482, "id": 215}, {"k": "m", "x": 499, "y": 494, "id": 216}, {"k": "m", "x": 613, "y": 468, "id": 217}, {"k": "m", "x": 704, "y": 431, "id": 218}, {"k": "m", "x": 183, "y": 431, "id": 219}, {"k": "m", "x": 77, "y": 430, "id": 220}, {"k": "r", "x": 816, "y": 163, "id": 300}, {"k": "r", "x": 858, "y": 311, "id": 301}, {"k": "r", "x": 908, "y": 363, "id": 302}, {"k": "r", "x": 787, "y": 470, "id": 303}, {"k": "r", "x": 618, "y": 400, "id": 304}, {"k": "r", "x": 517, "y": 430, "id": 305}, {"k": "r", "x": 382, "y": 401, "id": 306}, {"k": "r", "x": 311, "y": 293, "id": 307}, {"k": "r", "x": 281, "y": 187, "id": 308}, {"k": "r", "x": 513, "y": 223, "id": 309}, {"k": "r", "x": 616, "y": 244, "id": 310}, {"k": "r", "x": 649, "y": 102, "id": 311}, {"k": "r", "x": 528, "y": 71, "id": 312}, {"k": "r", "x": 371, "y": 52, "id": 313}, {"k": "r", "x": 108, "y": 236, "id": 314}, {"k": "r", "x": 66, "y": 344, "id": 315}, {"k": "r", "x": 173, "y": 366, "id": 316}], "events": [{"t": 0, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "InTheSea", "x": 480, "y": 320}, {"op": "+fx", "name": "obj_01", "fx": "Bubble3", "x": 874, "y": 109}, {"op": "+fx", "name": "obj_02", "fx": "Bubble2", "x": 723, "y": 561}, {"op": "+fx", "name": "obj_03", "fx": "Bubble3", "x": 41, "y": 200}, {"op": "+fx", "name": "obj_04", "fx": "Bubble2", "x": 205, "y": 572}, {"op": "+fx", "name": "obj_05", "fx": "Bubble1", "x": 454, "y": -20}, {"op": "+fx", "name": "obj_06", "fx": "Bubble3", "x": 431, "y": 271}]}]}, "start_cost": 10, "active": true}