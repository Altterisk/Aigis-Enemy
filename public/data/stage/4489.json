cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 30}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104608, "missile_id": 6, "master_id": 556, "global_id": 555, "ranged": true, "spawn_sec": 54}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "attack_range": 100, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 350.0, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097280, "missile_id": 6, "master_id": 551, "global_id": 550, "ranged": true, "spawn_sec": 62}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 82}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 90000, "attack": 1500, "base_hp": 90000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 600, "magic_defense": 50, "attack_range": 90, "attack_speed": 100, "attack_wait": 80, "attack_interval": 271, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2102864, "race_id": 2, "change_to": 8, "change_condition": 1, "missile_id": 39, "missile": {"splash": 133}, "master_id": 402, "global_id": 401, "ranged": true, "variants": [{"tags": ["アンデッド"], "hp": 90000, "attack": 1200, "base_hp": 90000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 50, "attack_speed": 30, "attack_wait": 5, "attack_interval": 107, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2102848, "race_id": 2, "special_effect_id": 56, "master_id": 401, "global_id": 400}], "spawn_sec": 96}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 116}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "hp": 9000, "attack": 1000, "base_hp": 9000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 400, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102160, "special_effect_id": 222, "change_to": 11, "change_condition": 2, "master_id": 20058, "global_id": 1133, "to_condition": 2, "to_global_id": 559, "spawn_sec": 160}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 10000, "attack": 1100, "base_hp": 10000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 400, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 2000.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102160, "special_effect_id": 64, "master_id": 560, "global_id": 559, "from_condition": 2}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "伝令ッ！　\n敵影を確認！\nど、ドラコリッチです！", "face": "lc0e4661faf65"}, {"name": "ドラコリッチ", "text": "久しいな人間どもよ……。\nビフロンスの手により蘇った我の新たな力で、\n貴様らの血肉を喰らい尽くしてくれるわ。", "face": "la83de6d4f710"}, {"name": "カリオペ", "text": "ビフロンスって聞いた時から嫌な予感は\nしてたけど、やっぱり出てきたわね……。\nでも死ぬ気なんてこれっぽっちもないわ！", "face": "u42"}, {"name": "ドラコリッチ", "text": "解せんな……なぜ抗う？\nビフロンスは着々と不死者の配下を増やし、\n世界を支配するのはもはや時間の問題だ。", "face": "la83de6d4f710"}, {"name": "ドラコリッチ", "text": "それにメトゥス、貴様はなぜ我らに下らない？\nビフロンスは、貴様に永遠の快楽と\n安らぎを与えてくれるぞ。", "face": "la83de6d4f710"}, {"name": "メトゥス", "text": "安らぎ……ね。不死者は死なないし、\n強い主に従属すれば不安も何もないものね。\n……確かに魅力的な話かもしれないわ。", "face": "u329"}, {"name": "ドラコリッチ", "text": "ならば今すぐにでも――。", "face": "la83de6d4f710"}, {"name": "メトゥス", "text": "でもお断りよ。\nだってそこに自由はないもの。\nそれに私、ビフロンスにむかついてるの。", "face": "u329"}, {"name": "ドラコリッチ", "text": "な、なんだと……ッ！？", "face": "la83de6d4f710"}, {"name": "メトゥス", "text": "だって、ダーリンを不死者にして\n永久のアバンチュールを、っていう\n計画を台無しにされたのよ？", "face": "u329"}, {"name": "メトゥス", "text": "だけど一つ感謝してるわ。\nだって、新しい夢ができたんですもの。", "face": "u329"}, {"name": "メトゥス", "text": "それはね、完全に人間の女性となって、\n限りある人生を余すことなくダーリンに捧げ、\n死ぬまで添い遂げるっていう夢よ。", "face": "u329"}, {"name": "メトゥス", "text": "それって、不死者にはマネの出来ない、\nとっても素敵なことだと思わない？", "face": "u329"}, {"name": "ドラコリッチ", "text": "ふん……とんだ愚か者のようだな。\n不死者の風上にもおけぬわ。\n貴様だけは塵も残さず葬ってやろう。", "face": "la83de6d4f710"}, {"name": "メトゥス", "text": "残念ながら、私はもう「不死者」とは言えないのよ。\n体も温かくなってきたし、人間に近づいてきてるわ。", "face": "u329"}, {"name": "メトゥス", "text": "ビフロンスの下に還ったら伝えてくださる？\n「私は２度と貴方のいいなりにならない」ってね。", "face": "u329"}]}, {"trigger": "end", "lines": [{"name": "ドラコリッチ", "text": "たかだか死霊術師に我が敗れる……だと？\nだがこの魂が潰えぬ限り我は何度でも蘇る。\n次に会う時が貴様らの最後だ……。", "face": "la83de6d4f710"}, {"name": "アンナ", "text": "ドラコリッチの消失を確認。\n脅威は去りましたね。", "face": "l40c186734f05"}, {"name": "メトゥス", "text": "あら。なんて呆気ないのかしら。\nまあ仕方ないわよね。\n私とダーリンとの愛は無敵ですもの！", "face": "u329"}, {"name": "リアナ", "text": "メトゥスさん、すっかり人間らしくなられましたね。\n私の癒しの力も届きましたし、\n「反魂の至宝」が役に立って良かったです。", "face": "u219"}, {"name": "メトゥス", "text": "ふふ、ありがと。完全に人間に戻った私を\n見れば、ダーリンはさらに惚れ直すはずよ。\nああ、ワクワクがとまらないわー♪", "face": "u329"}, {"name": "ミーシャ", "text": "王子を引きずるようにして\n勝手に先に進んでますけど、\nいいんですか？", "face": "u19"}, {"name": "カリオペ", "text": "まぁ何だかんだ言って、\n元気なメトゥスの方がいいわね……って、\n待ちなさいよ、私も王子と一緒にいくのぉー！", "face": "u42"}, {"name": "ケイティ", "text": "不死者の時もそうでしたが、\n人間に戻ってもメトゥスさんに関しては、\n気苦労が絶えなさそうですわ……。", "face": "u114"}, {"name": "アンナ", "text": "彼女の償いも残っています……。\nですが、きっと王子なら\n清濁併せ、すべて包み込んでくれるはずです。", "face": "l40c186734f05"}, {"name": "アンナ", "text": "だから、メトゥスさんを信じましょう。\n王子もメトゥスさんの事をよろしくお願いしますね。"}]}], "active": true}