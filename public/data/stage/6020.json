 "transform_resist": 100, "pattern_id": 2103728, "race_id": 16, "special_effect_id": 61, "change_to": 7, "master_id": 472, "global_id": 471, "to_global_id": 472, "spawn_sec": 73}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109104, "race_id": 16, "special_effect_id": 61, "change_to": 6, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 473, "global_id": 472, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 220, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109120, "race_id": 16, "special_effect_id": 125, "missile_id": 26, "master_id": 30130, "global_id": 3749, "ranged": true, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 113}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108544, "race_id": 16, "special_effect_id": 54, "master_id": 30038, "global_id": 3657, "spawn_sec": 116}, {"enemy_id": 11, "source": "local", "count": 5, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 122}, {"enemy_id": 12, "source": "local", "count": 5, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "セブン", "text": "――シックス！　おい、聞いてんのかよ！\nどうしてナインを殺したんだ！\nアタシたち、仲間じゃなかったのかよ！！", "face": "u449"}, {"name": "シックス", "text": "ふふ、仲間を思えばこそですよ、セブンさん。あのまま\n組織の事を話されては、皆が危険に晒されますからね。\nそれに、私のおかげで貴方だって逃げられたでしょう？", "face": "le257fc2e93a0"}, {"name": "セブン", "text": "（くそ……あんなにあっさり仲間を殺すなんて。\n……ただ組織から逃げたって殺されるだけだ、\n王子を捕えて正式に組織を抜けないと……）", "face": "u449"}, {"name": "アンナ", "text": "――見つけましたよ！　セブンさん！\nさあ、もう追いかけっこは終わりです！", "face": "lee523e149977"}, {"name": "シックス", "text": "おやおや……どうやらつけられていたようですね。\nセブンさん、この失態は重いですよ？", "face": "le257fc2e93a0"}, {"name": "セブン", "text": "くっ……な、なんだよ、その目は……？\nアタシのことも、ナインのように、\n殺すって言いてぇのか！？", "face": "u449"}, {"name": "シックス", "text": "ふふ……これからの貴方の頑張り次第ですね、\n貴方が王子を殺せば全ては水に流します。\nそれに、組織を抜ける為の口添えをしてもいいですよ？", "face": "le257fc2e93a0"}, {"name": "セブン", "text": "……ずいぶんと気前の良い話じゃねーか？\nその言葉、信じていいんだろうな？", "face": "u449"}, {"name": "シックス", "text": "ええ。だって、賭けるチップは貴方の命ですもの。\n見返りだって相応のものにすべきでしょう？\nさあ、一世一代の大博打、見事勝ってみせなさい。", "face": "le257fc2e93a0"}, {"name": "セブン", "text": "殺し、か……。そんなこと、本当はしたくないけど……。\nでも、やるしか……やるしか道はないんだよな。\n……生きるには、奪うしか……ないんだよな……？", "face": "u449"}, {"name": "シックス", "text": "ええ、そうですとも、セブン。\n心配はいりません……私もお手伝いしますよ。\n貴方が初めて人を殺す、その大切な手伝いを、ね……フフ。", "face": "le257fc2e93a0"}, {"name": "アンナ", "text": "王子！　セブンさんたちが攻めてきます！\nここで、決着をつけましょう！", "face": "lee523e149977"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "見事な戦いでした、王子！\nおかげで、組織の中心人物と思われる者を\n捕縛することに成功しました。", "face": "u114"}, {"name": "シックス", "text": "……おやおや、捕まってしまいましたか。\nこういった経験は、なかなかできるものではないですね。", "face": "le257fc2e93a0"}, {"name": "セシリー", "text": "……随分と余裕だな。\nまさか、逃げられるとでも思っているのか？", "face": "u21"}, {"name": "シックス", "text": "ええ、思っていますとも。\nなぜなら、王子を賞金首に仕立て上げたのは\n私なのですからね……フフフ。", "face": "le257fc2e93a0"}, {"name": "ケイティ", "text": "手配を取り下げる代わりに見逃せと\n……そう、言いたいのですか？", "face": "u114"}, {"name": "シックス", "text": "ええ、話が早くて助かります。\nさぁ、そちらの政務官はどうでしょうか？", "face": "le257fc2e93a0"}, {"name": "アンナ", "text": "……条件があります。", "face": "lee523e149977"}, {"name": "アンナ", "text": "王子の手配取り下げに加え、\nセブンさんの組織抜けを許諾し、\n今後一切、彼女に関わらないと約束してください。", "face": "lee523e149977"}, {"name": "シックス", "text": "殺そうとしたセブンを助けたいとは、殊勝な方々ですね。\nいいでしょう。元々大した情報も持たない売人風情、\nお好きなように……それでは交渉成立ということで。", "face": "le257fc2e93a0"}, {"name": "ユリアン", "text": "王子の手配を取り下げるまでは、\n見張りはつけさせてもらうからな。\n……おい！　コイツを連れていけ！", "face": "u7"}, {"name": "兵士", "text": "はっ！", "face": "lbdd9502568d1"}, {"name": "セブン", "text": "…………なぁ、なんでアタシを助けたんだ？\nアンタらに、何か得なことでもあんのかよ？", "face": "u449"}, {"name": "アンナ", "text": "セブンさんのおかげで、首謀者を捕え\n手配を取り下げる事が出来ましたから。"}, {"name": "アンナ", "text": "……それに何より、王子は困っている\n女性を放っておく事は出来ませんので。"}, {"name": "セブン", "text": "ば、バッカじゃねーの！？　お人好しにも程があんだろ！\nいいか、助けて貰ったからって金なんか払わねえからな！\nでもまぁ、礼だけは言っておくよ………………ありがとな。", "face": "u449"}, {"name": "ケイティ", "text": "……ふふ、まったく素直じゃありませんね。\n王子の懸賞金はなくなり、セブンさんも\n組織を抜けられ一件落着と言ったところでしょうか。", "face": "u114"}, {"name": "アンナ", "text": "今夜は安心して眠れそうですね、王子。\nそれでは、帰還するとしましょう。\n王子、本当にお疲れ様でした！"}]}], "active": true}