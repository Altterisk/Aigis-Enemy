{"quest_id": 8436, "name": "派手なコマ回し", "description": "コマ界隈に商機を見出したデモシェフ商会。\nしかし販売前にコマが暴走を始める……。\n暴れ回る大量のコマを回収せよ！！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ゴールドラッシュ33(2024)", "event_category": "Reproduce", "mission_id": 300481, "map_no": 4978, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 300, "gold": 800, "drops": [{"item": 2001, "c": 1}, {"item": 1003, "c": 1}, {"card": 56, "c": 1}, {"card": 194}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 500, "attack": 300, "base_hp": 500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121616, "race_id": 16, "change_to": 2, "change_condition": 2, "master_id": 32321, "global_id": 5940, "to_condition": 2, "to_global_id": 403, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1500, "attack": 100, "base_hp": 1500, "base_attack": 100, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2102912, "master_id": 404, "global_id": 403, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 700