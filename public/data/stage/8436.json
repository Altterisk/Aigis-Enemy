"pattern_id": 2103456, "race_id": 3, "special_effect_id": 242, "change_to": 8, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 36793, "global_id": 10410, "ranged": true, "variants": [{"hp": 52000, "attack": 6000, "base_hp": 52000, "base_attack": 6000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 40, "attack_speed": 50, "attack_wait": 50, "attack_interval": 245, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "pattern_id": 2103440, "race_id": 3, "special_effect_id": 242, "master_id": 36794, "global_id": 10411}], "spawn_sec": 72}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド", "機械"], "hp": 240000, "attack": 1200, "base_hp": 240000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 250, "attack_speed": 1, "attack_wait": 150, "attack_interval": 466, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "pattern_id": 2129248, "special_effect_id": 1598, "master_id": 36795, "global_id": 10412, "spawn_sec": 76}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 48000, "attack": 150, "base_hp": 48000, "base_attack": 150, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 50, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149248, "special_effect_id": 1599, "change_to": 11, "change_condition": 1, "master_id": 36796, "global_id": 10413, "variants": [{"hp": 48000, "attack": 150, "base_hp": 48000, "base_attack": 150, "damage_type": "physical", "armor_defense": 400, "magic_defense": 15, "attack_speed": 50, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149360, "special_effect_id": 1597, "master_id": 36797, "global_id": 10414}], "spawn_sec": 144}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 36000, "attack": 400, "base_hp": 36000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149264, "special_effect_id": 1599, "change_to": 13, "change_condition": 1, "master_id": 36798, "global_id": 10415, "variants": [{"hp": 36000, "attack": 400, "base_hp": 36000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 1, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "pattern_id": 2149376, "special_effect_id": 1597, "master_id": 36799, "global_id": 10416}], "spawn_sec": 144}], "popups": ["ゴールデンデーモンと\nチェインソン男は\n拠点には向かわず、\nしばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 "], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンシェフ", "text": "――去年なぜか盛り上がったコマ界隈に\n商機を見出し我々も参戦してみたが、\nどうにか正月に間に合ったか。", "face": "lac5181c4fcce"}, {"name": "副デーモンシェフ", "text": "デモシェフ商会製のコマの用意ができました。\n低価格の大量生産にも成功！\nメインターゲットの子どもたちにメガヒット間違いなし！", "face": "l37bb2dab53b9"}, {"name": "副デーモンシェフ", "text": "発売にあわせ、コマ回し大会の開催も万全！\n買ってすぐ遊べる場を作ったことで、\n商品のリピートに繋がることが予測されます！", "face": "l37bb2dab53b9"}, {"name": "デーモンシェフ", "text": "よし、準備は万端のようだ。\nでは早速、コマの販売を開始し――", "face": "lac5181c4fcce"}, {"name": "エピウス", "text": "ひ、ひえぇぇーッ！？\n大量のコマが暴れ回ってますよぉー！？", "face": "u2194a1"}, {"name": "デーモンシェフ", "text": "……インテリデーモン。\n開発はそちらに任せていたが、\nいったい何をしたのかね。", "face": "lac5181c4fcce"}, {"name": "インテリデーモン", "text": "フフフ、派手なほうがいいかと思い、\n極めて攻撃的な挙動で\nすべてを破壊し尽くすようになっております！", "face": "l75eaba504c7d"}, {"name": "デーモンシェフ", "text": "派手にしたいという考え方は間違っていないが！\nそれで楽しめるのは魔界の子どもたちだけだ。\n人間が遊ぶには危なすぎる！", "face": "lac5181c4fcce"}, {"name": "インテリデーモン", "text": "なんと……！？\nくっ、人間の耐久力を高く見積もりすぎたのか！？", "face": "l75eaba504c7d"}, {"name": "デーモンシェフ", "text": "しかし困ったぞ、コマの勢いが激しすぎる。\n我が商会の人員だけでは\nとても回収しきれない……！", "face": "lac5181c4fcce"}, {"name": "王子", "text": "…………（ぽんぽん）", "face": "u1"}, {"name": "デーモンシェフ", "text": "王子よ、まさか回収を手伝ってくれるのか！？", "face": "lac5181c4fcce"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ユリクセス", "text": "穏やかな正月を過ごすつもりが、\n何やらおかしなことに巻き込まれたようだ。", "face": "u2193a1"}, {"name": "エピウス", "text": "新年早々、大変ですね……。\nじゃあ、私は後ろで見てますので……。", "face": "u2194a1"}, {"name": "アキレア", "text": "なに言ってんだ、お前も戦うんだよ。\nほら、さっさと行くぞ！", "face": "u1972a1"}, {"name": "エピウス", "text": "ひぇぇ……正月からあんまりですぅ……！", "face": "u2194a1"}]}, {"trigger": "battle", "at_sec": 72, "lines": [{"name": "アキレア", "text": "ははははっ！　コマと戦うってのも、\n案外面白いじゃねぇか！\nおらァ！　次はどのコマが相手だ！", "face": "u1972a1"}, {"name": "ユリクセス", "text": "この調子ならすぐに片付きそうか。\n……ん？　なんだこの音は？", "face": "u2193a1"}, {"name": "ユリクセス", "text": "回転音……いや、エンジンの駆動音か？", "face": "u2193a1"}, {"name": "コレット", "text": "……奴が来る。", "face": "u1615a1"}, {"name": "エピウス", "text": "奴？　それはいったい……。", "face": "u2194a1"}, {"name": "チェインソン男", "text": "チェーンソッソッソォ！！\nハロウィンの時間だぁぁーーッ！！\nコマを回すぜェーーッ！！", "face": "l6d8fa28cc7aa"}, {"name": "ユリクセス＆アキレア", "text": "…………はっ？", "face": "l72b69a0fe77a"}, {"name": "ゴールデンデーモン", "text": "伝説のコマ回しということで、\nデモシェフ商会に呼ばれてきてみれば、\nもうすでにコマを戦わせているようだね。", "face": "l5ef83cdfcdb1"}, {"name": "アキレア", "text": "なんなんだアイツらは……？\nいや、片方は見覚えがあるけどよ。", "face": "u1972a1"}, {"name": "ウィリアス", "text": "あれはチェインソン男と、\n魔王軍時代にコマでブイブイ言わせてきた\nゴールデンデーモンよ！", "face": "u1213a1"}, {"name": "アキレア", "text": "説明されても分かんねぇのは俺だけか？", "face": "u1972a1"}, {"name": "ユリクセス", "text": "僕だってなにがなんだか分からないが、\nとりあえずチェインソン男と\nゴールデンデーモンに敵意はないらしい！", "face": "u2193a1"}, {"name": "ユリクセス", "text": "問題は二人が放たんとするコマだ！\nあれが被害を出す前に止めるぞ！", "face": "u2193a1"}, {"name": "チェインソン男", "text": "さぁ行くぜゴールデンデーモンッ！\nどっちが最強のコマ回しか決めようぜッ！", "face": "l6d8fa28cc7aa"}, {"name": "ゴールデンデーモン", "text": "望むところだよチェインソン男。\nワシの超絶爆転コマ回しを、再び見せてやろう。", "face": "l5ef83cdfcdb1"}, {"name": "チェインソン男＆ゴールデンデーモン", "text": "――３、２、１ッ！\nことよろォォォォォッ！！", "face": "l95d0bc49549a"}]}, {"trigger": "end", "lines": [{"name": "インテリデーモン", "text": "あぁっ、我らがデモシェフ商会のコマが！？", "face": "l75eaba504c7d"}, {"name": "ゴールデンデーモン", "text": "ワ、ワシのコマも粉々にぃーー！？", "face": "l5ef83cdfcdb1"}, {"name": "チェインソン男", "text": "う、うわぁぁあぁぁああッ！？\n死んだぜッ！！", "face": "l6d8fa28cc7aa"}, {"name": "コレット", "text": "しゃあっ！　チェインソン男、爆散！", "face": "u1615a1"}, {"name": "ユリクセス", "text": "チェインソン男爆散！？", "face": "u2193a1"}, {"name": "エピウス", "text": "と、とにかく、これで一件落着でしょうか……？", "face": "u2194a1"}, {"name": "デーモンシェフ", "text": "そうだな。\n我が社のコマが街を破壊する前に止めてくれて、\n心から感謝する。", "face": "lac5181c4fcce"}, {"name": "デーモンシェフ", "text": "しかし……我々の落ち度とはいえ、\nせっかく作ったコマたちが廃品になるのは、\n少しばかり勿体ない気持ちになるな……。", "face": "lac5181c4fcce"}, {"name": "エピウス", "text": "でしたら、修理しましょうか？\n私、天才技師ですし……。", "face": "u2194a1"}, {"name": "ゴールデンデーモン", "text": "そういうことならワシも手伝おう。\nコマには一家言あるからね。\n力になれるはずだ。", "face": "l5ef83cdfcdb1"}, {"name": "チェインソン男", "text": "チェーンソッソッソォ！！\nもちろん俺も手を貸すぜぇーッ！\n子どもたちにコマで遊んでほしいからなぁッ！", "face": "l6d8fa28cc7aa"}, {"name": "シャルロット", "text": "私も協力しますわ！\nなんでも任せてくださいませ！", "face": "u128"}, {"name": "アンナ", "text": "通りすがりのシャルロットさん！"}, {"name": "アキレア", "text": "ユリクセス、俺は悪い夢でも見てんのか？", "face": "u1972a1"}, {"name": "ユリクセス", "text": "知らないよ。\n僕だって未知の体験に震えているんだ。", "face": "u2193a1"}, {"name": "エピウス", "text": "えへへ……でも、たまにはこんなお正月も、\n楽しくていいんじゃないですか……？", "face": "u2194a1"}, {"name": "アキレア", "text": "まぁ……そうかもな……？", "face": "u1972a1"}, {"name": "ユリクセス", "text": "いや、どう取り繕っても\nこんな正月はおかしいが……？", "face": "u2193a1"}]}], "map": {"image": "Map4978", "w": 960, "h": 640, "spots": [{"k": "b", "x": 478, "y": 498}, {"k": "m", "x": 799, "y": 187, "id": 200}, {"k": "m", "x": 152, "y": 186, "id": 201}, {"k": "m", "x": 182, "y": 280, "id": 202}, {"k": "m", "x": 267, "y": 184, "id": 203}, {"k": "m", "x": 228, "y": 356, "id": 204}, {"k": "m", "x": 782, "y": 278, "id": 205}, {"k": "m", "x": 734, "y": 356, "id": 206}, {"k": "m", "x": 287, "y": 275, "id": 207}, {"k": "m", "x": 330, "y": 375, "id": 208}, {"k": "m", "x": 409, "y": 423, "id": 209}, {"k": "m", "x": 481, "y": 371, "id": 210}, {"k": "m", "x": 546, "y": 425, "id": 211}, {"k": "m", "x": 681, "y": 185, "id": 212}, {"k": "m", "x": 660, "y": 277, "id": 213}, {"k": "m", "x": 627, "y": 372, "id": 214}, {"k": "m", "x": 479, "y": 160, "id": 215}, {"k": "m", "x": 480, "y": 271, "id": 216}, {"k": "r", "x": 865, "y": 265, "id": 300}, {"k": "r", "x": 810, "y": 366, "id": 301}, {"k": "r", "x": 78, "y": 139, "id": 302}, {"k": "r", "x": 720, "y": 446, "id": 303}, {"k": "r", "x": 609, "y": 493, "id": 304}, {"k": "r", "x": 231, "y": 443, "id": 305}, {"k": "r", "x": 347, "y": 492, "id": 306}, {"k": "r", "x": 91, "y": 267, "id": 307}, {"k": "r", "x": 146, "y": 367, "id": 308}, {"k": "r", "x": 880, "y": 136, "id": 309}]}, "start_cost": 10, "active": true, "name_en": "Flashy Koma Spin", "description_en": "Demoshop has spotted a business opportunity in the Koma scene.\nHowever, the Koma starts running wild before it can be sold...\nRecover the massive number of rampaging Koma!!\nIntermediate (★1 acquisition benchmark: Average Lv1, 8 units deployed)"}