5, "change_condition": 2, "master_id": 35972, "global_id": 9589, "to_condition": 2, "to_global_id": 403, "spawn_sec": 104}, {"enemy_id": 33, "source": "local", "count": 6, "form_count": 2, "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 60, "attack_interval": 193, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143088, "race_id": 16, "special_effect_id": 818, "change_to": 25, "change_condition": 2, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 35961, "global_id": 9578, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 105}, {"enemy_id": 34, "source": "local", "count": 10, "form_count": 2, "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "magical", "armor_defense": 250, "magic_defense": 10, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143216, "race_id": 16, "special_effect_id": 1285, "change_to": 25, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 35974, "global_id": 9591, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 152}, {"enemy_id": 35, "source": "local", "count": 6, "form_count": 2, "hp": 14000, "attack": 450, "base_hp": 14000, "base_attack": 450, "damage_type": "physical", "armor_defense": 350, "magic_defense": 15, "attack_range": 160, "attack_wait": 10, "attack_interval": 79, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143120, "special_effect_id": 1286, "change_to": 25, "change_condition": 2, "missile_id": 45, "master_id": 35973, "global_id": 9590, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 171}], "popups": ["かまいたち紫苑姉妹の三女\nヤタケのドッペルゲンガーがいる間\n全ての敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "魔神セーレ", "text": "――ここは、どこだ……。\n物質界でも魔界でもない、何も感じれぬ空間だと……？", "face": "l56c324708564"}, {"name": "志津香", "text": "次元の狭間、というそうね。\nいわばどこでもない場所、かしら？", "face": "u1759a1"}, {"name": "グリム", "text": "ここなら、異界の門を用いた転移以外は無効です。\nぼっこぼこにして、\nランスさんの身体を取り戻しちゃいましょー。", "face": "u942"}, {"name": "魔神セーレ", "text": "ほざけぇ！！\nどちらにせよ、貴様らはこの肉体を殺せまい！\n手加減してこのセーレを倒せると思うな！！", "face": "l56c324708564"}, {"name": "魔剣カオス", "text": "む、いいのか？\nそのままランスの肉体に収まっていると、ありあまる\n人間の欲望に押しつぶされ、自我が崩壊しかねんぞ？", "face": "le2e11fea1f65"}, {"name": "魔神セーレ", "text": "まさか、先程からの不調は――\nふざけるな、人間ごときがそんな巨大な欲望を……！？", "face": "l56c324708564"}, {"name": "霊体ランス", "text": "がはははは。\n甘く見るなよ魔神なんとか。", "face": "la0f84dc30bec"}, {"name": "霊体ランス", "text": "俺様はスーパーな男だ。\nスーパーな欲望を、お前ごときが制御できるものか。", "face": "la0f84dc30bec"}, {"name": "魔神セーレ", "text": "くっ……どこまでもふざけた男め。\nいいだろう、ならば我が本来の力をもって、\n貴様らを皆殺しにし、物質界へ戻るまでだ！！", "face": "l56c324708564"}]}, {"trigger": "start", "lines": [{"name": "レーヴ", "text": "あれが、魔神セーレの本体ですか。\n伝承に謳われているとおりの姿ですね……！", "face": "u454"}, {"name": "サテラ", "text": "はっ、あいつが飛び出た今なら！\nランス！　今すぐ身体にもどれ！！", "face": "u1760a1"}, {"name": "霊体ランス", "text": "おう！！", "face": "la0f84dc30bec"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "ランス", "text": "がははははは！\n久々の復っ活っ！！", "face": "l56c324708564"}, {"name": "ランス", "text": "おい魔神セーレ、\n散々俺様の肉体を好き勝手してくれたな。", "face": "l56c324708564"}, {"name": "ランス", "text": "それに王子、なんというか、世話になったな。", "face": "l56c324708564"}, {"name": "王子", "text": "…………（にこにこ）", "face": "u1"}, {"name": "魔神セーレ", "text": "どこまでも規格外な男め……。", "face": "lb2a94b89d98f"}, {"name": "魔神セーレ", "text": "ランスよ、貴様が優れた戦士であることは分かった。\n我が配下となれば、\n物質界の領主に据えてやってもいいぞ？", "face": "lb2a94b89d98f"}, {"name": "ランス", "text": "知ったことか。\n俺は誰の下にもつかん。\nそれに何より、お前は気に食わん。", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "その選択、後悔するがいいッ！！", "face": "lb2a94b89d98f"}, {"name": "グリム", "text": "王子、ここなら魔神セーレの強制転移も効かないです。\nでも物体を引き寄せる力は\n残ってますので、油断は禁物ですー。", "face": "u942"}, {"name": "ランス", "text": "よし、行くぞ王子。\nあいつをぼっこぼこにしてやる！", "face": "l56c324708564"}]}, {"trigger": "end", "lines": [{"name": "ランス", "text": "――ランスあたたたたーーっく！！", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "なぜだ、なぜ人間ごときが――", "face": "lb2a94b89d98f"}, {"name": "ランス", "text": "ただの人間じゃない。\nスーパーな俺様と、王国の王子だ。", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "おのれ……おのれぇぇッ！！", "face": "lb2a94b89d98f"}, {"name": "魔神セーレ", "text": "魔神の魂は滅びぬ！\n必ず貴様を、この手で殺してやろうぞ……ッ！！", "face": "lb2a94b89d98f"}, {"name": "ランス", "text": "うるさい、さっさと死ね。", "face": "l56c324708564"}, {"name": "志津香", "text": "ここは次元の狭間よ。\n永遠にそうやって、何もない空間にわめき続けてなさい。", "face": "u1759a1"}, {"name": "魔神セーレ", "text": "くっ、ぐぉぉぉぉッ、ぐわぁぁぁ――ッ！！", "face": "lb2a94b89d98f"}, {"name": "シーラ", "text": "――ふぅ。\nどうにかなりましたね。\nランス様の肉体も元通りですし。", "face": "u1758a1"}, {"name": "サテラ", "text": "後は元の世界に帰るだけ、か。\n……どうやって帰る？", "face": "u1760a1"}, {"name": "グリム", "text": "ここは次元の狭間なので、\nふたつの世界を接続するよりは簡単に、\n元の世界への門を作れそうですねー。", "face": "u942"}, {"name": "志津香", "text": "おぉ、さすがは召喚士。\n今度機会があったら、その魔法教えてくれない？", "face": "u1759a1"}, {"name": "グリム", "text": "のんのん。異界召喚士です。\nただ、たぶん一瞬しか開かないので、\n迅速に、すすすーっと飛び込んでくださいねー。", "face": "u942"}, {"name": "シィル", "text": "えっとぉ……もし中途半端に飛び込むと？", "face": "u581"}, {"name": "グリム", "text": "まっぷたつか、肉体と魂がばらばらになるか？", "face": "u942"}, {"name": "シィル", "text": "ら、ランス様ぁ！", "face": "u581"}, {"name": "ランス", "text": "えぇい、うっとうしい（ぽかっ）\nグリムの実力は見ただろ。\nそう簡単に失敗などせん。", "face": "l56c324708564"}, {"name": "志津香", "text": "それじゃあ、お別れね。\nグリム、次にあったら魔法のこと聞かせてね？", "face": "u1759a1"}, {"name": "サテラ", "text": "おっと、メカゴブリンクイーンに挨拶を忘れた。\nソーマ、よろしくと伝えておいてくれ。", "face": "u1760a1"}, {"name": "かなみ", "text": "王国の忍者さんたちもお元気で！", "face": "u1761a1"}, {"name": "シーラ", "text": "王子殿下、次は国家元首同士、\n友好条約の締結を結びに来ますね。", "face": "u1758a1"}, {"name": "シィル", "text": "さぁランス様、お別れを言いますよ。\n本当に色々お世話になったんですから。", "face": "u581"}, {"name": "ランス", "text": "むっ……そうか、そうだな……。", "face": "l56c324708564"}]}, {"trigger": "end", "lines": [{"name": "ランス", "text": "……王子、グッドだ！\nがはははは！　また会おう！！", "face": "l56c324708564"}, {"name": "グリム", "text": "では、門を開きます。\nみなさん、お元気でー。", "face": "u942"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "…………行ってしまいましたね。"}, {"name": "グリム", "text": "こっちも迅速に帰らないとです。\n次元の狭間から出られなくなると大変なのでー。", "face": "u942"}, {"name": "アンナ", "text": "おっと、急ぎましょう！\nそれでは王子、此度の魔神討伐、お疲れ様でした！"}]}], "active": true}