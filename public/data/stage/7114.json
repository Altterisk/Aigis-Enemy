d": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_range": 180, "attack_speed": 55, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114192, "race_id": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30948, "global_id": 4567, "ranged": true}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 1000, "base_hp": 20000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 40, "attack_range": 300, "attack_speed": 200, "attack_wait": 80, "attack_interval": 281, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105504, "race_id": 6, "special_effect_id": 89, "change_to": 13, "change_condition": 1, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 838, "global_id": 837, "ranged": true, "variants": [{"hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 40, "attack_speed": 50, "attack_wait": 10, "attack_interval": 151, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105552, "race_id": 6, "special_effect_id": 86, "master_id": 839, "global_id": 838}], "spawn_sec": 149}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 15, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 1000}]}, "spawn_sec": 190}], "popups": ["サンダーバードは\nダメージを受けると反撃を行います。\n拠点には向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。 ", "天界では、時間経過によって\n雲の足場が出現する\nことがあります。\n\n出現した雲の足場には、\n遠距離ユニットを\n配置できるようになります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "白の皇帝", "text": "――天使どもめ、先日の慢心が嘘のようだな。\n天界の門に防衛部隊を置いているらしい。", "face": "u418"}, {"name": "ミルノ", "text": "世界樹の魔物化を進め、深海に尖兵を作り出し、\n物質界の民はその対処に手一杯になっている――\n当初はそれが彼らの描いたシナリオだったのでしょう。", "face": "u337"}, {"name": "シャディア", "text": "それがまさか、物質界の住人が、\n直接天界に乗り込んでくるとは予想外だったのだろうな。", "face": "u713"}, {"name": "ソシエ", "text": "でも、この侵攻から先は、\n天界も物質界を真に敵と認めることになるはず……。\n神を殺した人間が、その刃を今度は天に向けるんだから。", "face": "u486"}, {"name": "ノーマ", "text": "んん……でも鳥人の村を助けるだけなら、\nこんな大部隊じゃなくて、少人数で\nこっそり救出した方がよくないかしら？", "face": "u1047a1"}, {"name": "ガオレオン", "text": "ノーマよッ！　時代のチャンピオンたる王子がッ！\nこっそりこそこそなどッ！\nどう考えても似合わな――", "face": "l3179d9738cce"}, {"name": "メカゴブリンクイーン", "text": "――ウフフッ。うるさいわよガオレオン。\nノーマ、王子は村の救出だけではなく、\nそのまま天界に侵攻拠点を築くつもりなのよ。", "face": "le219b5be753d"}, {"name": "メカゴブリンクイーン", "text": "討伐には精鋭がいればいい、侵攻もまた然り。\nけれど制圧し、そこを防衛するには軍が必要なの。\nそれこそ、私たちゴブリン族の得意分野よぉ？", "face": "le219b5be753d"}, {"name": "女王子", "text": "それゆえ、天界の門直下の海上まで、\nクラールフ様率いる部隊が\n完全に制圧しているのですよ、ノーマ嬢。", "face": "le1a0323ff10f"}, {"name": "ボリス", "text": "――長話はそこまでだ。\n王子、そろそろ天界の門に接舷するぞ。", "face": "u360"}, {"name": "ノーマ", "text": "うっわぁ、本当に天使の大部隊が陣取ってるわ。\n簡単には突破させてくれそうにないわね……。\nそれになんだか大きな鳥までいるじゃない。", "face": "u1047a1"}, {"name": "ラテリア", "text": "あぁ、あれはこの空中遺跡を巣にしてた、\nサンダーバードだね。\nあの子からすれば、この戦いはいい迷惑かも。", "face": "u532"}, {"name": "ラテリア", "text": "王子、サンダーバードは本来温厚な生き物だから、\nこっちから手を出さなければ敵対してこないはず。\n攻撃に巻き込まないように気をつけてね。", "face": "u532"}, {"name": "メカゴブリンクイーン", "text": "さぁて、それじゃあ戦争を始めましょう。\nゴブリン博士、飛行くぐつを起動なさい！！", "face": "le219b5be753d"}, {"name": "ゴブリン博士", "text": "ハハァッ！！\n王子よ、私は貴様を味方とは思っていナイ！\nダガ！　今だけハ手を貸してやろうトモ！！", "face": "l6f1c08263e70"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "――王子、天界の門、制圧完了しました！", "face": "l34d9eaa35f12"}, {"name": "リーナ", "text": "（お、お母さまと一緒に戦っちゃいました！\n初めて一緒に……うぅ、嬉しいです……。\nお声はかけられなかったけど、一緒に戦えました！）", "face": "u521"}, {"name": "メカゴブリンクイーン", "text": "……王子、そこにいる緑髪の子なのだけれど。", "face": "le219b5be753d"}, {"name": "リーナ", "text": "…………！！", "face": "u521"}, {"name": "メカゴブリンクイーン", "text": "昔ね、お使いに出した娘が、\nそのまま帰ってこなかったことがあったの。", "face": "le219b5be753d"}, {"name": "メカゴブリンクイーン", "text": "他の魔物に喰われるなんて、ゴブリンにはよくある話。\nきっとあの子もそうだったのだと、\nもうずっと前に諦めていたのよ。", "face": "le219b5be753d"}, {"name": "メカゴブリンクイーン", "text": "……その子はね、娘によく似ているわ。\nちゃんと可愛がって、一生大事になさい。\nそうしないと、王国を攻め滅ぼしてやるからねぇ。", "face": "le219b5be753d"}, {"name": "リーナ", "text": "（お母さま……）", "face": "u521"}, {"name": "メカゴブリンクイーン", "text": "オーッホッホッホ！\nさぁ王子、天界に乗り込むわよぉ！！", "face": "le219b5be753d"}, {"name": "ガオレオン", "text": "うむ、我は予定通り、デシウス、帝国軍と共に\n天界の門と飛空船の防衛にあたるッ！\n王子よ、天界というリングに乱入するのは今だッ！！", "face": "l3179d9738cce"}, {"name": "デシウス", "text": "王子、お前たちの帰るべき道は我輩たちが守る。\n天界にお前の名を刻み込んでくるのだ！！", "face": "l6607c719ec5f"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン博士", "text": "――メカゴブリンクイーン様、\nあの娘、似ているというより、むしろ本人なのデハ？", "face": "l6f1c08263e70"}, {"name": "メカゴブリンクイーン", "text": "ウフフッ、すべての女の子にはねぇ、\n幸せになる権利というものがあるのよ。\nリーナにとっての幸せは、王国にいることだもの。", "face": "le219b5be753d"}, {"name": "ゴブリン博士", "text": "な、なるホド……？", "face": "l6f1c08263e70"}]}], "active": true}