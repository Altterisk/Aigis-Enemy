_id": 378, "global_id": 377, "ranged": true, "from_condition": 3}, {"enemy_id": 19, "source": "local", "count": 6, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 19, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 131}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}, {"enemy_id": 21, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー", "アイドルリノのファン"], "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 50, "attack_speed": 40, "attack_wait": 30, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118848, "race_id": 8, "special_effect_id": 378, "change_to": 21, "change_condition": 1, "master_id": 31772, "global_id": 5391, "variants": [{"tags": ["アーマー", "アイドルリノのファン"], "hp": 4500, "attack": 300, "base_hp": 4500, "base_attack": 300, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 50, "attack_speed": 40, "attack_wait": 30, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118864, "race_id": 8, "master_id": 31773, "global_id": 5392}], "spawn_sec": 191}], "popups": ["\n\n\n　　　　――数日前。", "オークシールダーは\n味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nブロックされている間、\n引き付けの効果を失います。\n　　　　　　(1/2)", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n\n\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "デーモンシェフ", "text": "よりコクの出るチョコレートの材料はないものか。\n我らお菓子工場職員は、新材料を求めて\nジャングルの奥地へ向かったのだった――と。", "face": "l1cb44203deef"}, {"name": "ゴブリン", "text": "ギャギャ？　工場長　ナニカイテル？", "face": "l07267ed6c1ce"}, {"name": "デーモンシェフ", "text": "工場長ではない、おしゃれで素敵なデーモンシェフだ！\nこれは我らが物質界を支配するまでの道程を\n未来に残すための探検日誌というものだぞ。", "face": "l1cb44203deef"}, {"name": "ゴブリン", "text": "ギャギャ！　ユメ！　オオキイ！", "face": "l07267ed6c1ce"}, {"name": "デーモンシェフ", "text": "ともかく次はこの材料の効果を試してみよう。\n味だけでなく、付加効果が重要だからな。\nさぁ、先程捕えたオークを連れてこい！", "face": "l1cb44203deef"}, {"name": "オーク勇者", "text": "くっ……薬を盛るとは卑怯な……。\nだがオレの負けには違いない……さぁ、殺すがいい……。", "face": "la91e5775ec3c"}, {"name": "デーモンシェフ", "text": "殺すなどもったいない……。\nお前は我らの物質界征服の礎となるのだ！\nさぁ美味しく食べろ、新鮮な木の実だぞ。", "face": "l1cb44203deef"}, {"name": "オーク勇者", "text": "グッ、グォォォッ！？\n何をっ、何を食わせたッ！！\n身体が大きくッ、力がッ、グォアァアァァッ！？", "face": "la91e5775ec3c"}]}, {"trigger": "start", "lines": [{"name": "エクス", "text": "――ジャングルの奥深くまで来ましたが、\n中々チョコレートの原料が見つかりませんわね……。", "face": "u963"}, {"name": "エメルダ", "text": "アリスに聞いた話だと、\nこんな感じの形の実の中に、\nチョコの原料になる種が入っているらしいよ。", "face": "u964"}, {"name": "エクス", "text": "やはり愛と日頃の感謝を伝えるなら、\n原材料の入手からと思いましたが、\nチョコ作りの道はこれ程までに厳しかったのですね。", "face": "u963"}, {"name": "エメルダ", "text": "でも、せっかくここまで来たんだから、\n最高の材料で、最高に美味しいチョコを――って、\nあれ？　何か雄叫びが聞こえてこない？", "face": "u964"}, {"name": "オーク勇者", "text": "グォォォオオオオオオッ！！\n戦士タチヨォ！！　我が筋肉に集えェェェッ！！", "face": "la91e5775ec3c"}, {"name": "オーク", "text": "何と巨大な肉体だ！\nあれほどの筋肉を育てるには、\nさぞかし多くの死線をくぐり抜けたことだろう！", "face": "l36c9ad036349"}, {"name": "エクス", "text": "た、大変です！\nエメルダさん、向こうからオークの群れが！", "face": "u963"}, {"name": "エメルダ", "text": "仕方ない、他の子達に応援を頼もう。\nあんなオークの群れ、私達だけじゃしのぎきれないよ。", "face": "u964"}, {"name": "オーク勇者", "text": "戦士の匂いがするぞ！　近くに戦の気配がッ！！\n戦えッ！　オレと戦えェェェェッ！！", "face": "la91e5775ec3c"}]}, {"trigger": "end", "lines": [{"name": "オーク勇者", "text": "オレは……いったい何を……。\nくっ……偽りの筋肉に踊らされるとは、\n戦士として一生の不覚だ……。", "face": "la91e5775ec3c"}, {"name": "エクス", "text": "はぁ……はぁ……。\n変な木の実を吐き出させたら、\n元に戻ってくれましたね……。", "face": "u963"}, {"name": "エメルダ", "text": "もう、変な物食べちゃだめだよ？\nそれよりあなた達、このジャングルには詳しい？\nチョコの材料とか知らない？", "face": "u964"}, {"name": "オーク勇者", "text": "おぉ、勝者には褒美があって然るべき。\n我が暴走を止めてくれた礼もしなければならぬ。\nチョコレートの材料が実る場所を教えようとも。", "face": "la91e5775ec3c"}, {"name": "エクス", "text": "ふふっ、これもきっと神のお導き。\nエメルダさん、案内してもらいましょうか。", "face": "u963"}, {"name": "エメルダ", "text": "うん。これで美味しいチョコが作れるね。", "face": "u964"}, {"name": "デーモンシェフ", "text": "――なるほど、あの実は巨大化する効果があるのか。\n中々に良い実験であった……。", "face": "l1cb44203deef"}, {"name": "ゴブリン", "text": "ギャギャ　デモ　ボウソウシテタ！", "face": "l07267ed6c1ce"}, {"name": "デーモンシェフ", "text": "黙れ！　一流シェフへの道は長いのだ！\nさぁ次の食材を試しに行くぞ！", "face": "l1cb44203deef"}]}], "story_talk": true, "active": true}