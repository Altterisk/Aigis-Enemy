{"quest_id": 6309, "name": "妖魔軍の陣形演習", "description": "熟達した妖魔軍の陣形にかつ目せよ！\n＜クイーン三姉妹がいる間敵の攻撃力\n上昇、徐々にＨＰ回復、味方魔耐減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["クイーン三姉妹がいる間敵の攻撃力\n上昇、徐々にＨＰ回復、味方魔耐減少"], "event": "神殺しの聖槍", "event_category": "History", "mission_id": 920185, "map_no": 5110, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["機械"], "hp": 40000, "attack": 1200, "base_hp": 40000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 250, "attack_speed": 30, "attack_wait": 110, "attack_interval": 261, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112400, "race_id": 9, "change_to": 1, "change_condition": 2, "missile_id": 234, "missile": {"speed": 4.0, "splash": 120}, "master_id": 30743, "global_id": 4362, "ranged": true, "to_condition": 2, "to_global_id": 4363, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 40000, "attack": 1200, "base_hp": 40000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 1000, "magic_defense": 10, "attack_range": 200, "attack_speed": 30, "attack_wait": 110, "attack_interval": 271, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112464, "race_id": 9, "special_effect_id": 232, "missile_id": 104, "master_id": 30744, "global_id": 4363, "ranged": true, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["機械"], "hp": 6000, "attack": 150, "base_hp": 6000, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 60, "attack_speed": 100, "attack_wait": 50, "attack_interval": 125, "move_speed": 1500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110720, "race_id": 9, "special_effect_id": 234, "c