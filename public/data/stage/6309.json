tack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112096, "race_id": 9, "special_effect_id": 209, "change_to": 22, "missile_id": 6, "master_id": 30746, "global_id": 4365, "ranged": true, "to_global_id": 6392, "spawn_sec": 188}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 16000, "attack": 450, "base_hp": 16000, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112096, "race_id": 9, "special_effect_id": 470, "change_to": 21, "missile_id": 6, "master_id": 32774, "global_id": 6392, "ranged": true}, {"enemy_id": 24, "source": "local", "count": 1, "form_count": 2, "hp": 16000, "attack": 450, "base_hp": 16000, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112080, "race_id": 9, "special_effect_id": 208, "change_to": 24, "missile_id": 6, "master_id": 30745, "global_id": 4364, "ranged": true, "to_global_id": 6391, "spawn_sec": 188}, {"enemy_id": 24, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 16000, "attack": 450, "base_hp": 16000, "base_attack": 450, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2112080, "race_id": 9, "special_effect_id": 470, "change_to": 23, "missile_id": 6, "master_id": 32773, "global_id": 6391, "ranged": true}, {"enemy_id": 26, "source": "local", "count": 1, "form_count": 1, "hp": 100000, "attack": 250, "base_hp": 100000, "base_attack": 250, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 10, "attack_range": 200, "attack_speed": 150, "attack_wait": 30, "attack_interval": 161, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104464, "race_id": 9, "change_to": 26, "change_condition": 1, "missile_id": 132, "missile": {"speed": 4.0, "splash": 133}, "master_id": 533, "global_id": 532, "ranged": true, "variants": [{"hp": 100000, "attack": 4000, "base_hp": 100000, "base_attack": 4000, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 10, "attack_speed": 150, "attack_wait": 50, "attack_interval": 401, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2104448, "race_id": 9, "master_id": 532, "global_id": 531}], "spawn_sec": 210}, {"enemy_id": 28, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 700, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 6000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2101616, "race_id": 16, "special_effect_id": 222, "master_id": 268, "global_id": 267, "spawn_sec": 259}], "popups": ["ゴブリンクイーン長女がいる間は\n敵の攻撃力がアップします。\n\nゴブリンクイーン次女がいる間は\n味方の魔法耐性が低下します。\n\nゴブリンクイーン三女がいる間は\n敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "アーアー……コホン。\n諸君、聞こえてイルカ？", "face": "lc0f2369d37f7"}, {"name": "ゴブリン", "text": "ギャッギャッ！\nハカセ、オーケー！", "face": "l72e5ed468f99"}, {"name": "ゴブリン博士", "text": "ウム……デハこれヨリ演説を行ウ。", "face": "lc0f2369d37f7"}, {"name": "ゴブリン博士", "text": "諸君！　我々魔物の復活カラ早４年が過ぎタ。\nしかし、未だに人間どもを駆逐スルには至っていナイ！\n特に、王子たちの軍には痛イ目にあわサレてばかりダ！", "face": "lc0f2369d37f7"}, {"name": "ゴブリン博士", "text": "……だが、悲観スルことハナイ。\n我々ゴブリン族はこの１年で\n着実に力を付けてきてイル。", "face": "lc0f2369d37f7"}, {"name": "ゴブリン博士", "text": "隊列ヲ組んでノ戦闘ニモますます習熟シタ。\nワタクシの天才的頭脳の真髄デアル、\n飛行くぐつの開発、ならびに実用化にも成功シタ。", "face": "lc0f2369d37f7"}, {"name": "ゴブリン博士", "text": "本日の演習ハその集大成デアル！\nクイーン三姉妹様たちも見学ニいらっしゃるそうダ！\n故に、必ずや成功させるノダ！　", "face": "lc0f2369d37f7"}, {"name": "ゴブリン", "text": "ギャッギャ！\nエンシュウ、セイコウ！　ハカセ、バンザイ！", "face": "l72e5ed468f99"}, {"name": "アンナ", "text": "……報告を聞いて来てみれば。\n一体これは何事でしょうか？", "face": "la7f94b5d2087"}, {"name": "ゴブリン博士", "text": "グフフ……人間ども、丁度いいところに来タ。", "face": "lc0f2369d37f7"}, {"name": "ゴブリン博士", "text": "行け、勇敢ナル戦士たちヨ！\nこの一年の成長の証ヲ人間どもの肉体に刻むノダ！", "face": "lc0f2369d37f7"}]}, {"trigger": "battle", "at_sec": 190, "lines": [{"name": "ゴブリンクイーン長女", "text": "ふふっ、やってるわねぇ博士。\n面白いことになってるじゃない？", "face": "l19db271e5ebd"}, {"name": "ゴブリン博士", "text": "く……クイーン三姉妹様！\nず、随分早いお出ましデ……。", "face": "lc0f2369d37f7"}, {"name": "ゴブリンクイーン次女", "text": "へぇ、もう演習も佳境に入っちゃってるようにも\n見えるけど？　まぁそれはともかく、\nあの王子たちの軍に押されちゃってるみたいねぇ？", "face": "l11ce71c2a815"}, {"name": "ゴブリン博士", "text": "ウ……そ、ソレは……。", "face": "lc0f2369d37f7"}, {"name": "ゴブリンクイーン三女", "text": "お姉さま、このままじゃつまらないわ。\n――そうだ。ねぇ、私たちも参加しちゃいましょうよ？\nこんな時のために、実は騎獣戦車を連れてきてるの。", "face": "la75f692fc65a"}, {"name": "ゴブリンクイーン次女", "text": "あらぁ、素敵じゃない！\n流石は三女、準備がいいわねぇ。", "face": "l11ce71c2a815"}, {"name": "ゴブリン博士", "text": "ナッ……き、危険デス！\nお考え直しクダサイ！", "face": "lc0f2369d37f7"}, {"name": "ゴブリンクイーン長女", "text": "なら博士が私たちを守ってくれればいいじゃない？\n軍の予算をたっぷり注ぎ込んだ飛行くぐつを使ってね。\nウフフ、さぞかし高性能なんでしょうねぇ？", "face": "l19db271e5ebd"}, {"name": "ゴブリン博士", "text": "ウグ……し、承知イタシましタ。\n我ガ傑作の性能、とくとゴ覧に入れマショウ！", "face": "lc0f2369d37f7"}]}, {"trigger": "end", "lines": [{"name": "キャリー", "text": "うわわわわっ！\nと、止めてくださいぃ～～～！！", "face": "u1026"}, {"name": "ケイティ", "text": "この声は……キャリーさん？\nですが、一体どこから……？", "face": "u114"}, {"name": "エレイン", "text": "この水音は……！\n来るわ、王子！　海からよ！", "face": "u36"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンクイーン三女", "text": "もう、なにやってるのよ博士！\n私たちを守るってお姉さまに約束したじゃない！", "face": "la75f692fc65a"}, {"name": "ゴブリンクイーン次女", "text": "全くよぉ。演習の出来もさんざんだったし。\nせめて私たちが逃げるまでの\n時間稼ぎくらいはしてくれるんでしょうねぇ？", "face": "l11ce71c2a815"}, {"name": "ゴブリン博士", "text": "ハヒッ！？\nわ……ワタクシを捨て駒になさるト……？", "face": "lc0f2369d37f7"}, {"name": "ゴブリンクイーン次女", "text": "し・て・く・れ・る・ん・で・しょ・う・ね・え？", "face": "l11ce71c2a815"}, {"name": "ゴブリン博士", "text": "……に、ニニニ人間ドモ！\nクイーン三姉妹様に近寄るナ！\n近寄レバこの……じ、自爆スイッチを押すのデアル！", "face": "lc0f2369d37f7"}, {"name": "アンナ", "text": "自爆スイッチ！？\nそんな物騒な機能を\n飛行くぐつに搭載したというのですか？", "face": "la7f94b5d2087"}, {"name": "ゴブリンクイーン長女", "text": "ウフフ、気になる？　でも試そうとしちゃダメよ？\n貴方たち人間は、そんな安っぽいスイッチではなく\n私たち自身の手で抹殺してあげるんだから……。", "face": "l19db271e5ebd"}, {"name": "ケイティ", "text": "……また逃げられてしまいましたね。\nさて、残る一人は…………。", "face": "u114"}, {"name": "ゴブリン博士", "text": "ヒ……ヒヒヒッ！　バカめ、騙されたナ！\n自爆スイッチなんて嘘なのデアル！\nこのスイッチはなんト――脱出装置なのデアル！", "face": "lc0f2369d37f7"}, {"name": "アリサ", "text": "と……飛んで行ってしまいました……。\nあんなすごい技術を開発してたなんて……びっくりです。", "face": "u24"}, {"name": "ケイティ", "text": "ゴブリン軍も着々と力を付けてきているようです。\n我々も気を引き締めていかなくてはなりませんね。", "face": "u114"}, {"name": "アンナ", "text": "ですが、少しは胸を張ってもいいのではないでしょうか。\n私たちも王子のもとで、ゴブリンたちに負けないくらい\n力をつけてきているのですから。"}, {"name": "アンナ", "text": "王子と共に歩んでいければ、\n私たちは今後もさらに成長していけると思います。\nこれからもよろしくお願いしますね、王子。"}]}], "active": true}