enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "hp": 1050, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101536, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 316, "global_id": 315, "ranged": true, "spawn_sec": 126}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 1, "hp": 2100, "attack": 175, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 129}], "popups": ["ヴェルティは\n一定範囲内のユニットに\n継続してダメージを与えます。", "ベルゼビュートと契約する\n教団員は変身後\n一定範囲内のユニットに\n継続ダメージを与え\n攻撃力を低下させます。  "], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴェルティ", "text": "ん……ここは……？", "face": "u477"}, {"name": "レーヴ", "text": "あっ、気が付きましたね！\nヴェルティさん、大変なんです！\nここはヴェルティさんの夢の中で――", "face": "u454"}, {"name": "夢の中の教団員", "text": "――さぁ、早くキメリエス様を呼び出すんだ！", "face": "lf92625ad33fb"}, {"name": "ヴェルティ", "text": "こ、れは……？\nどうなっているの？", "face": "u477"}, {"name": "レーヴ", "text": "これは以前、ヴェルティさんが\nキメリエスを呼び出してしまったときの記憶が\n夢の中で再生されているんです。", "face": "u454"}, {"name": "ヴェルティ", "text": "ああ、私がキメリエスを召喚して、\nその知識を得ようとした時の記憶なのね……。", "face": "u477"}, {"name": "レーヴ", "text": "ですです。\nそ、それはそれとして、\nこの状況はとてもマズくて……！", "face": "u454"}, {"name": "夢の中のヴェルティ", "text": "……本当にどうなっても\n知らないんだからね。", "face": "u477"}, {"name": "夢の中のヴェルティ", "text": "さぁ現れなさい。魔神、キメリエス！", "face": "u477"}]}, {"trigger": "start", "lines": [{"name": "夢の中のキメリエス", "text": "……我は深淵を統べし魔が一柱、\n魔神キメリエス。\n人間よ、我を呼び出したのは貴様等か。", "face": "la61d9da0fd82"}, {"name": "レーヴ", "text": "わ、わー！　間に合いませんでした！\n夢の中でキメリエスが召喚されちゃいました！", "face": "u454"}, {"name": "ヴェルティ", "text": "ふふ、夢の中とはいえ、\n過去の自分の失敗を目にするのは辛いわね。", "face": "u477"}, {"name": "ヴェルティ", "text": "レーヴ、手伝って。\n起きて研究の続きをするためにも、\nこの夢を寝覚めのいいハッピーエンドにするわ。", "face": "u477"}, {"name": "レーヴ", "text": "えぇと、つまり……？", "face": "u454"}, {"name": "ヴェルティ", "text": "夢の中の王子たちと協力して、\nあのキメリエスをぶっ飛ばすのよ。", "face": "u477"}, {"name": "レーヴ", "text": "……ですよね。\n急いで夢の中の王子に協力要請してきます！", "face": "u454"}]}, {"trigger": "end", "lines": [{"name": "夢の中のヴェルティ", "text": "……今、もうひとりの私が見えたような。", "face": "u477"}, {"name": "夢の中のアンナ", "text": "ヴェルティさん、大丈夫ですか？"}, {"name": "夢の中のヴェルティ", "text": "え、えぇ。研究のしすぎで夢でも見たのかも……。\n息抜きに別分野の研究が必要かしら。", "face": "u477"}, {"name": "夢の中のアンナ", "text": "まったく、危うく命が奪われるところだったんですよ？", "face": "l6620c6bdd67d"}, {"name": "ヴェルティ", "text": "……ふふ、我ながら私らしいわ。", "face": "u477"}, {"name": "レーヴ", "text": "もう、笑い事じゃないですよ。\n現実に戻っても、命は大切にしてくださいね？", "face": "u454"}, {"name": "ヴェルティ", "text": "前向きに善処しておくわ。\nレーヴに心配かけない程度にね。", "face": "u477"}, {"name": "レーヴ", "text": "それでは、現実に戻りましょうか。\nゆっくりと目を覚ましていきますよー。", "face": "u454"}]}], "story_talk": true, "active": true}