"missile": {"speed": 6.0, "splash": 133}, "master_id": 71, "global_id": 70, "ranged": true, "to_global_id": 534, "spawn_sec": 128}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "magical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 11, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}], "dialogue": [{"trigger": "start", "lines": [{"name": "サラサ", "text": "よーし。ここのエリアは終わり！　", "face": "u317"}, {"name": "サラサ", "text": "さ、次の場所に行こっと。", "face": "u317"}, {"name": "トロル", "text": "クンクン……。\n人間の肉の匂い……。", "face": "l4e090980ec96"}, {"name": "サラサ", "text": "えっと……。\nあんたは……。\n人間……、なわけないわよねぇ……。", "face": "u317"}, {"name": "トロル", "text": "喰いたい……。その肉……。\nその袋の中身も、全部……！", "face": "l4e090980ec96"}, {"name": "サラサ", "text": "うーん。困ったわね。\nあたし、あんまり美味しくないと思うけどなぁ……。", "face": "u317"}, {"name": "アンナ", "text": "王子、サラサさんが……！\n助けないと！", "face": "l840576953c3c"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "トトノ", "text": "あれはトロル、ですね。", "face": "u316"}, {"name": "アンナ", "text": "トロル？　ってあなたはトトノさん！", "face": "l840576953c3c"}, {"name": "トトノ", "text": "トロルは興味がある物への執着心が\n強いんです。宝石とか……高価な宝物が\n大好きで、おまけに人間が大好物なんです。", "face": "u316"}, {"name": "トトノ", "text": "だから私たち行商人は、\nトロルに目をつけられないように、なるだけ荷物を\n隠したりして移動するんだけど……。", "face": "u316"}, {"name": "トトノ", "text": "まさかあんな派手な格好のままで\n動き回るなんて……。", "face": "u316"}, {"name": "アンナ", "text": "なるほど……。", "face": "l840576953c3c"}, {"name": "トトノ", "text": "気をつけてください。あいつは傷を負っても\nすぐに回復します。", "face": "u316"}, {"name": "トトノ", "text": "ただどんな攻撃でもそこそこ効くはずなので、\n全員で一気に畳みかければ再生が\n追いつかないでしょうから、倒せると思います。", "face": "u316"}, {"name": "アンナ", "text": "分かりました。ありがとうございます！\nでは王子、今のことに注意していきましょう！", "face": "l840576953c3c"}]}, {"trigger": "end", "lines": [{"name": "サラサ", "text": "敵だったあたしを助けてくれて、\n本当にありがとう。感謝しているわ。", "face": "u317"}, {"name": "アンナ", "text": "事情はトトノさんに伺っています。\nご無事でよかった……。"}, {"name": "サラサ", "text": "あっ、あたし急いでるんだった！\nごめんなさい、\nまた今度ゆっくり会いましょう！", "face": "u317"}]}], "active": true}