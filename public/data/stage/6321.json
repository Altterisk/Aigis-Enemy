{"quest_id": 6321, "name": "夢現に潜む魔性", "description": "プシュケを眠りに誘う魔性の正体とは。\n＜毒：HPに継続ダメージ＞\n＜プシュケ出現中魔界の瘴気（中）発生＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["毒：HPに継続ダメージ", "プシュケ出現中魔界の瘴気（中）発生"], "event": "夢現のダークプリースト", "event_category": "History", "mission_id": 920100, "map_no": 3258, "level": 80, "multiplier": 0.8, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 26, "params": [70], "expression": "IsStageFlag( 1);", "expression_human": "stage flag 1 is set"}, {"kind": "term", "influence": 27, "params": [70], "expression": "IsStageFlag( 1);", "expression_human": "stage flag 1 is set"}, {"kind": "term", "influence": 30, "params": [70], "expression": "IsStageFlag( 1);", "expression_human": "stage flag 1 is set"}, {"kind": "term", "influence": 8, "params": [0, 5, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 22, "form_count": 2, "hp": 800, "attack": 240, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 76, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103920, "race_id": 18, "change_to": 1, "master_id": 986, "global_id": 985, "to_global_id": 987, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 800, "attack": 240, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105232, "race_id": 18, "master_id": 988, "global_id": 987}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 960, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "atta