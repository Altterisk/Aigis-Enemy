d": 2111504, "race_id": 18, "change_to": 2, "master_id": 30596, "global_id": 4215, "to_global_id": 3857, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 96}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 960, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30238, "global_id": 3857, "ranged": true}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 4400, "attack": 300, "base_hp": 5500, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "attack_range": 180, "attack_speed": 30, "attack_wait": 50, "attack_interval": 173, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112976, "race_id": 16, "missile_id": 6, "master_id": 30771, "global_id": 4390, "ranged": true, "route_behaviour": {"sets_flags": [[1, 1, 0], [1, 0, 0]]}, "spawn_sec": 112}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 3, "hp": 3200, "attack": 400, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111504, "race_id": 18, "change_to": 11, "master_id": 795, "global_id": 794, "to_global_id": 483, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 136}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 3200, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 150, "attack_speed": 10, "attack_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 12, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_global_id": 624}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 3200, "attack": 400, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 11, "master_id": 625, "global_id": 624}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 1, "hp": 4400, "attack": 8, "base_hp": 5500, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_speed": 30, "attack_interval": 61, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098352, "special_effect_id": 220, "master_id": 23, "global_id": 22, "spawn_sec": 163}], "popups": ["プシュケがいる間は味方の\n攻撃力と防御力、時間経過による\nコスト回復量が30％低下します。\n王子【神器装備】王子【ケラウノス】\n皇帝を配置すると攻撃力と防御力の\n低下について無効化することが\nできます。\n一部ユニットも無効化できます。\n"], "dialogue": [{"trigger": "start", "lines": [{"name": "ユリアン", "text": "……おいおい、一体どういうことだよ？\nいつになったら俺たちは\n魔物に襲われてる村に案内してもらえるんだ？", "face": "u7"}, {"name": "プシュケ", "text": "…………はっ！\nす、すみません……こんな場所に\nお連れするつもりはありませんでしたのに……。", "face": "u558"}, {"name": "ユリアン", "text": "……なあ、あんたワザとやってねえか？", "face": "u7"}, {"name": "プシュケ", "text": "ち……違いますっ！　それだけは誓って！", "face": "u558"}, {"name": "プシュケ", "text": "……ですが、実はひとつだけ\n思い出したことがあるのです。", "face": "u558"}, {"name": "アンナ", "text": "思い出したこと？", "face": "lbd9f6e8ca00c"}, {"name": "プシュケ", "text": "……はい。もしかすると私は、\nなにかしら邪悪な存在に\n取り付かれてしまっているのかもしれないのです。", "face": "u558"}, {"name": "プシュケ", "text": "……自分で言うのも変な話ですが、\n力を得る前の私は典型的な箱入り娘でして……。", "face": "u558"}, {"name": "プシュケ", "text": "そんな私が戦える力を得たのは、\n夢の中によくお出でになる、神のような御方の\nお告げに従って修行をしたからなのです……。", "face": "u558"}, {"name": "アンナ", "text": "そういえば、様子がおかしくなる前の\nプシュケさんは必ずと言っていいほど\n睡魔に襲われて意識が混濁していたようですね。", "face": "lbd9f6e8ca00c"}, {"name": "ケイティ", "text": "プシュケさんの言う神のような存在は、\nプシュケさんが眠るたびに現れる\n――ということでしょうか？", "face": "u114"}, {"name": "プシュケ", "text": "……わかりません。\nでも、もしそうだとしたら……。\nあぁ、考えるだけでも恐ろしいですわ！", "face": "u558"}, {"name": "ユリアン", "text": "だろうな……でも悪いが\n話の続きは俺たちを狙ってる\n魔物どもを追っ払ってからにしようぜ！", "face": "u7"}]}, {"trigger": "battle", "at_sec": 113, "lines": [{"name": "アンナ", "text": "プシュケさん、目を覚ましてください！\nプシュケさんっ！", "face": "lbd9f6e8ca00c"}, {"name": "プシュケ", "text": "…………ふふっ。\nここの魔物も期待はずれねぇ。\n私もそろそろ、少しは本気を出そうかしら？", "face": "u558"}, {"name": "バシラ", "text": "――ッ！\nいままでよりもさらに瘴気が強くなったみたいです！\n皆さん、早くプシュケさんを止めましょう！", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "ユリアン", "text": "……おいあんた、大丈夫か？", "face": "u7"}, {"name": "プシュケ", "text": "はぁっ、はぁっ……うぅぅ……ん……っ。\n……す、すみません……また私……、\n皆さんを襲ってしまったみたいですね……。", "face": "u558"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "プシュケ", "text": "神様……いえ、悪魔でしょうか？\nよく判らないけれど、私の中にいるのでしょう？\nお願いします……もう、出ていって――", "face": "u558"}, {"name": "プシュケ", "text": "――――く、うぅッ！？　……うあぁああぁッ！！", "face": "u558"}, {"name": "アンナ", "text": "――プシュケさん！？", "face": "lbd9f6e8ca00c"}, {"name": "プシュケ", "text": "………………あらあらあらあら～？\n追い出したいの？　本当に？\n追い出していいの？　本当に？　本当に？", "face": "u558"}, {"name": "ニコラウス", "text": "なっ……！？\nき、貴様……何者だッ！？", "face": "u345"}, {"name": "プシュケ", "text": "……本当に追い出していいの、プシュケ？\n『私』が出ていったら、せっかく授けてもらった\n闇の司祭としての力を失っちゃうかもしれないのよ？", "face": "u558"}, {"name": "プシュケ", "text": "誰かを救うための力がほしかったんじゃないの？\n誰も救えない無力な自分が嫌だったんじゃないの？", "face": "u558"}, {"name": "プシュケ", "text": "戦えなくなるなんて嫌でしょう？\nもっと強くなりたいんでしょう？\nなら、『私』とず～っと一緒にいなくちゃ♪", "face": "u558"}, {"name": "プシュケ", "text": "そのためには、『私』の敵である\n邪魔な王子たちを早く殺さなくちゃね？\n……ふふ、うふふっ、うふふふふっ♪", "face": "u558"}, {"name": "ユリアン", "text": "お、おい、待てって！\n……くそっ、あいつ、走ってどこか行きやがった！", "face": "u7"}, {"name": "シャロン", "text": "……思い出しました！\n魔界の瘴気を自在に操る能力を持つ魔神。\nその名は――魔神サブノック。", "face": "u283"}, {"name": "アンナ", "text": "魔神サブノック！？\nプシュケさんは魔神に取り付かれているのですか！\nこうしてはいられません、すぐに後を追いましょう！", "face": "lbd9f6e8ca00c"}]}], "active": true}