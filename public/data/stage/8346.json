"form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 4}, {"enemy_id": 5, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 2500, "attack": 480, "base_hp": 2500, "base_attack": 480, "damage_type": "physical", "armor_defense": 250, "attack_speed": 10, "attack_wait": 1, "attack_interval": 45, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2111792, "race_id": 16, "master_id": 30637, "global_id": 4256, "spawn_sec": 44}, {"enemy_id": 6, "source": "local", "count": 24, "form_index": 0, "form_count": 1, "tags": ["帝国", "女性"], "hp": 2000, "attack": 500, "base_hp": 2000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_range": 40, "attack_speed": 80, "attack_wait": 30, "attack_interval": 91, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102496, "race_id": 16, "special_effect_id": 229, "missile_id": 45, "master_id": 335, "global_id": 334, "ranged": true, "spawn_sec": 79}, {"enemy_id": 7, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 18000, "attack": 500, "base_hp": 18000, "base_attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 15, "attack_interval": 85, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133056, "race_id": 16, "change_to": 7, "change_condition": 1, "missile_id": 26, "master_id": 34628, "global_id": 8245, "ranged": true, "variants": [{"tags": ["帝国"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 238, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2133264, "race_id": 16, "master_id": 34629, "global_id": 8246}], "spawn_sec": 107}], "dialogue": [{"trigger": "start", "lines": [{"name": "ディルク", "text": "――初代皇帝陛下がご帰還なされたと？", "face": "u287"}, {"name": "ドワイト", "text": "それも、初代騎士団長と共に、とのことだ。\n聞くところによれば、アダマス様の奇跡だとか……。", "face": "u348"}, {"name": "エリック", "text": "ルーテ、お前は姿を見たんだろう？\n肖像画のとおりの方だったか？", "face": "u419"}, {"name": "ルーテ", "text": "……多少の違いはありましたが、\n伝承に謳われるとおりの、美しい方々でした。\nそれに、神器のレプリカも確かにお持ちで……。", "face": "u529"}, {"name": "ヒース", "text": "帝国は、どうなるのだろうか……。\n実力を第一とする現体制だが、\n初代がご帰還したとなれば……。", "face": "u421"}, {"name": "エリック", "text": "ああ、貴族連中が黙ってな――あっ、いや、悪いルーテ。", "face": "u419"}, {"name": "ルーテ", "text": "いえ、お気になさらず。\nですがその懸念はもっともです。", "face": "u529"}, {"name": "ルーテ", "text": "冥界軍、そしてハイドースとの戦いを、\n初代皇帝陛下に委ねるべきだという言説は、必ず出ます。\n現陛下は確実に勝利を重ねてはいますが――", "face": "u529"}, {"name": "ヒース", "text": "これまでの、被害が大きすぎたからな……。", "face": "u421"}, {"name": "ヘイズル", "text": "――いつの時代も内緒話は楽しいものだね。", "face": "u2248a1"}, {"name": "ルーテ", "text": "へ、ヘイズル様！？", "face": "u529"}, {"name": "ヘイズル", "text": "ごめんね、立ち聞きするつもりはなかったんだけど。\nでも、私たちとしては今の帝国を壊したくはない。\nだからさっさと誤解を解かないと、と思ってね。", "face": "u2248a1"}, {"name": "ヘイズル", "text": "私たちはこれから、白の皇帝に決闘を挑む。\n帝位を賭けた、正式な決闘だ。", "face": "u2248a1"}, {"name": "ヘイズル", "text": "面倒な貴族と、迷える臣民を一気に理解させるには、\n今の帝国法に則って戦う方が手っ取り早いでしょ。", "face": "u2248a1"}, {"name": "ルーテ", "text": "それは、その、そうですが……？", "face": "u529"}, {"name": "ヘイズル", "text": "まぁ、きっと上手くいくから。\n君たちは大々的に、民に噂を流す準備をしておいてよ。", "face": "u2248a1"}, {"name": "ディルク", "text": "噂、というと……？", "face": "u287"}, {"name": "ヘイズル", "text": "――現皇帝、初代騎士団長に勝利す！\nあるいは……ぼっこぼこのギッタギタにされて、\n皇帝の座を明け渡す……のどっちかの噂だよ。", "face": "u2248a1"}, {"name": "ドワイト", "text": "……さすがに、笑えない冗談です。", "face": "u348"}, {"name": "ヘイズル", "text": "むっ……眠ってる間に冗談が下手になったかな……。\nまぁいいや、ともかく、そういうわけだ！\n白の皇帝！　私からの決闘、受けてくれるね？", "face": "u2248a1"}, {"name": "白の皇帝", "text": "……受けて立とう。", "face": "u418"}, {"name": "白の皇帝", "text": "白の帝国は、常に強くあり続けている。\n過去の先達に、それを証明してみせよう。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "ヘイズル", "text": "……ふぅ。\n後輩が強くて嬉しいよ、本当に。", "face": "u2248a1"}, {"name": "ヘイズル", "text": "私の負け。\n君こそ、白の皇帝にふさわしいと認めよう。", "face": "u2248a1"}, {"name": "白の皇帝", "text": "……感謝する。", "face": "u418"}, {"name": "マルゴット", "text": "（ディアナ様、騎士団長としてどうです？\n初代に勝てると思いますか？）", "face": "u1343a1"}, {"name": "ディアナ", "text": "（いい勝負はできると思いますよ。\nですが、殺し合いをしたい相手ではありませんね。\n双方無事では済みません）", "face": "u624"}, {"name": "ヘイズル", "text": "ディアナ、今度やる？", "face": "u2248a1"}, {"name": "ディアナ", "text": "御冗談を。\nお茶のお誘いでしたら喜んで。", "face": "u624"}, {"name": "ヘイズル", "text": "さて……じゃあ次は市街地に行こっか。\n本命が待ちくたびれてるよ。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "……あなたが方を付けてくれたら楽だったのですが。", "face": "u2245a1"}, {"name": "ヘイズル", "text": "それこそ冗談でしょ。\n後輩の実力、見たくてうずうずしてるくせに。", "face": "u2248a1"}, {"name": "ヴィラヘルム", "text": "それは確かに。\n私たちが築いた帝国、その未来の姿。\nこの目で見せてもらいましょう。", "face": "u2245a1"}]}], "hard": {"level": 140, "multiplier": 1.4, "modifiers": [{"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 154000, "attack": 2800, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "pattern_id": 2155088}, {"enemy_id": 2, "form_index": 0, "hp": 7000, "attack": 770, "damage_type": "physical", "armor_defense": 400, "pattern_id": 2155120}, {"enemy_id": 3, "form_index": 0, "hp": 15400, "attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "pattern_id": 2108336}, {"enemy_id": 4, "form_index": 0, "hp": 2800, "attack": 490, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2102256}, {"enemy_id": 5, "form_index": 0, "hp": 3500, "attack": 672, "damage_type": "physical", "armor_defense": 250, "pattern_id": 2111792}, {"enemy_id": 6, "form_index": 0, "hp": 2800, "attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "pattern_id": 2102496}, {"enemy_id": 7, "form_index": 0, "hp": 25200, "attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133056}]}, "active": true}