{"quest_id": 4559, "name": "怒涛の滅多打ち", "description": "硬き鎚矛による\n滅多打ちをしのぎ\n鎧たちを掃討せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "暗黒騎士団と英霊の守り手", "event_category": "History", "mission_id": 920066, "map_no": 3686, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 13, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 15}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 10000, "attack": 300, "base_hp": 10000, "base_attack": 300, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_range": 150, "attack_speed": 90, "attack_wait": 40, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103840, "change_to": 3, "change_condition": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 325, "global_id": 324, "ranged": true, "variants": [{"tags": ["アーマー"], "hp": 10000, "attack": 600, "base_hp": 10000, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 194, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2103856, "master_id": 326, "global_id": 325}], "spawn_sec": 30}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104592, "special_effect_id": 235, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 722, "global_id": 721, "ranged": true, "spawn_sec": 59}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 600, "base_hp": 2800, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097712, "master_id": 40, "global_id": 39, "spawn_sec": 81}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "attack_range": 510, "attack_speed": 70, "attack_wait": 90, "attack_interval": 261, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098480, "special_effect_id": 222, "missile_id": 155, "missile": {"speed": 4.0, "splash": 67}, "master_id": 723, "global_id": 722, "ranged": true, "spawn_sec": 116}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "physical", "armor_defense": 1200, "attack_speed": 1, "attack_wait": 1, "attack_interval": 38, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105696, "special_effect_id": 222, "master_id": 724, "global_id": 723, "spawn_sec": 116}], "dialogue": [{"trigger": "start", "lines": [{"name": "暗黒騎士デシウス", "text": "また新たな英霊の魂が我が手に……。\nフハハハ……よし、次は貴様だ。\n前に出ろ！", "face": "l84dc0540de08"}, {"name": "暗黒騎士の手下", "text": "は、はいッ！\n魂の注入、お願いしますッ！！", "face": "l7fd7fe66ea49"}, {"name": "レシア", "text": "待てッ！！　魂を奪っているのはお前か！\n英霊の魂はお前達の様な邪悪な者達が\n手にしていい力ではない！", "face": "u358"}, {"name": "暗黒騎士デシウス", "text": "待てと言われて待つ馬鹿がいるか！\nさあ、これで貴様は過去の英霊の力を\n授かったのだ！　行くがよいッ！！", "face": "l84dc0540de08"}, {"name": "暗黒騎士の手下", "text": "ひぐぁ……う……うぉぉおぉおおっ！！\nこれで奴らを滅多打ちにします、団長！", "face": "l7fd7fe66ea49"}, {"name": "暗黒騎士デシウス", "text": "その調子だ！　貴様は破壊者だ！　\n敵を全て、滅多打ちにするのだ！\n(さて、我輩は安全な場所に身を潜めて……と。)", "face": "l84dc0540de08"}, {"name": "ギャレット", "text": "滅多打ちのボッコボコ……だと？\nおい、あんた……何を勘違いしてる？\nこの戦場での破壊は全て俺のものだ。", "face": "u1009"}, {"name": "ベルナール", "text": "ギャレット殿、あまり熱くならぬように……\nって聞いておるのか？　ああ、もう……。\nまあいい、私が彼を守ればいいだけのことだ！", "face": "u10"}, {"name": "アンナ", "text": "ギャレットさんに、ベルナールさんも\nもの凄い気迫ですね……私達も続きましょう！\n王子、戦いのご準備をお願いします！", "face": "l9aa58d4440c1"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士デシウス", "text": "クソッ！！\n滅多打ちのボッコボコにされよってからに。\n味方も残ってないし……我輩は退却する！", "face": "l84dc0540de08"}, {"name": "レシア", "text": "待て卑怯者ッ！！\n……くそ、何という逃げ足の速さだ。", "face": "u358"}, {"name": "ベルナール", "text": "深追いは無用です、レシア殿。\n今は守ることの出来た仲間の命と、\n取り返せた英霊の魂に喜びを向けましょう。", "face": "u10"}, {"name": "レシア", "text": "貴方の言うとおりかもしれないな。\n少し、熱くなっていたようだ。\n助言、感謝する。", "face": "u358"}, {"name": "ギャレット", "text": "ちッ、暴れたりないな……。\nなあ王子、早く進軍を再開しよう。\n立ち止まって考えたりするのは苦手なんだ。", "face": "u1009"}, {"name": "ベルナール", "text": "慌てなさるなギャレット殿。\n武具の損傷度合いや兵たちの疲労も考えるのだ。\nここで一度、隊を整えてだな……。", "face": "u10"}, {"name": "ギャレット", "text": "ふん……小難しいことを考えるのは任せる。\n俺のやることは変わらない。\n目の前にいる魔物をぶっ潰す。それだけだろ？", "face": "u1009"}, {"name": "レシア", "text": "攻守において共に両極の武人たちか……。\n個性的な仲間が皆いきいきとしている。\n王子は度量の広き統率者なのだな。", "face": "u358"}, {"name": "アンナ", "text": "そろそろ皆さんの準備も整ったようですね。\n王子、さらに森の奥へと向かいましょう。", "face": "l9aa58d4440c1"}]}], "active": true}