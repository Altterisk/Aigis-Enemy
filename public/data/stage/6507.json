 187, "master_id": 30582, "global_id": 4201, "from_condition": 2}, {"enemy_id": 22, "source": "local", "count": 1, "form_count": 4, "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105056, "race_id": 16, "change_to": 22, "master_id": 30072, "global_id": 3691, "to_global_id": 3692, "route_behaviour": {"transforms": [{"wait": 700}]}, "spawn_sec": 141}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "hp": 8000, "base_hp": 8000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108752, "race_id": 16, "special_effect_id": 222, "change_to": 23, "master_id": 30073, "global_id": 3692, "to_global_id": 3693}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105056, "race_id": 16, "change_to": 24, "master_id": 30074, "global_id": 3693, "to_global_id": 3694}, {"enemy_id": 22, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 8000, "attack": 750, "base_hp": 8000, "base_attack": 750, "damage_type": "magical", "armor_defense": 500, "magic_defense": 10, "attack_range": 180, "attack_speed": 1, "attack_wait": 100, "attack_interval": 236, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108768, "race_id": 16, "special_effect_id": 248, "change_to": 21, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30075, "global_id": 3694, "ranged": true}, {"enemy_id": 26, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2110352, "race_id": 16, "special_effect_id": 166, "master_id": 30287, "global_id": 3906, "spawn_sec": 145}, {"enemy_id": 27, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "magical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 40, "attack_interval": 213, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101664, "race_id": 16, "special_effect_id": 222, "master_id": 30070, "global_id": 3689, "spawn_sec": 147}, {"enemy_id": 28, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 900, "base_hp": 12000, "base_attack": 900, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105072, "race_id": 16, "special_effect_id": 121, "master_id": 30071, "global_id": 3690, "spawn_sec": 175}], "popups": ["ラクシャーサは倒されると、\nその場で復活します。\n復活は5回まで行われます。\n\nオーラをまとったラクシャーサは\n倒されると、自身の周囲に\nダメージを与えます。 ", "メルヴィナは倒されると\n自身の周囲にダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "テミス", "text": "くっ……負けませんわ！\nもう一着のドレスに相応しいのは私ですっ！", "face": "u38"}, {"name": "シェリー", "text": "私だって負けません！\n明日の『ジューンブライド』でドレスを着て\n王子の隣を歩く権利、絶対に手に入れてみせます！", "face": "u1027"}, {"name": "アンナ", "text": "――これは一体……。\n皆さん、どうして争っているのですか？", "face": "le9fe07963d6d"}, {"name": "メルヴィナ", "text": "……あぁ、王子か。\n実は『ジューンブライド』用のドレスが\nもう一着用意されていると聞いてな。", "face": "u326"}, {"name": "メルヴィナ", "text": "それで、誰がそのドレスを着るのに相応しいかを\n実力で決めようという話になったんだが……。", "face": "u326"}, {"name": "クリッサ", "text": "……実力で決めるというのなら、\nプリンセスではない私にもチャンスはあるはず……。", "face": "u52"}, {"name": "フェルミ", "text": "ふふっ。綺麗なドレスを着て聖歌を歌ったら、\nきっといつもの何倍も素敵だと思うの♪", "face": "u324"}, {"name": "堕姫", "text": "くふふ……普段よりもさらに美しきわらわを見れば、\nきっと王子もわらわにメロメロになるはずじゃ♪", "face": "u547"}, {"name": "メルヴィナ", "text": "…………先ほどから皆、この調子だ。\nもう一着のドレスは黒系統だと聞いたから、\n一番似合うのは私だと、何度も説明したのだがな……。", "face": "u1326"}, {"name": "アンナ", "text": "そ、その理屈もどうかと思いますが……。", "face": "le9fe07963d6d"}, {"name": "ラクシャーサ", "text": "――そうだメルヴィナ。\nこの私を差し置いて、己が最も黒のドレスが似合うだと？\nフッ、笑わせてくれる。", "face": "u306"}, {"name": "アンナ", "text": "なッ――あ、貴方は……！？", "face": "le9fe07963d6d"}, {"name": "ラクシャーサ", "text": "皆、聞いてくれ。このままでは話がまとまらん。\nここはひとつ、王子と戦って勝利した者を\nもう一着のドレスの所有者と認めようではないか。", "face": "u306"}, {"name": "バシラ", "text": "あ、それいいですね！\nよーし！　王子、負けませんよぉーっ！", "face": "u28"}, {"name": "アンナ", "text": "はぁ……結局こうなってしまうのですね。\n王子、ひとまず応戦して彼女たちを鎮めましょう。", "face": "l490bae3b1e33"}]}, {"trigger": "end", "lines": [{"name": "テミス", "text": "はぁっ、はぁっ……ま、まだ戦えますわ……っ。", "face": "u38"}, {"name": "リリア", "text": "ふ、ふふ……ご無理をなさらずに、\nご休憩なさった方がよろしいんじゃないですか？", "face": "u1020"}, {"name": "ファルネ", "text": "……な、なによこれ？\nどうしてみんな息切れしてるの？", "face": "u1640"}, {"name": "シプリア", "text": "――って、ちょっと待った！\nなんでファルネがもう一着のドレスを着てるんだ？", "face": "u51"}, {"name": "ナディア", "text": "あ、ホントだ！　ファルネさんずるーい！", "face": "u304"}, {"name": "ファルネ", "text": "……え？\nあ、ええと、これはその……。", "face": "u1640"}, {"name": "トトノ", "text": "ここは私からご説明した方が良さそうですね。", "face": "u316"}, {"name": "セラ", "text": "トトノさん！　一体どういうことなんですの？", "face": "u255"}, {"name": "トトノ", "text": "どうもこうも、あの黒いドレスは\nもともとファルネさんに着て頂くために\n仕立てられたものなのです。", "face": "u316"}, {"name": "トトノ", "text": "文献によると『ジューンブライド』においては、\n所定の衣装を着た女性が儀式中にお召し物を\n変えることが推奨されているそうですので。", "face": "u316"}, {"name": "シェリー", "text": "そうだったんですか……でも、なんだか納得です。\n今のファルネさん、嫉妬しちゃうくらい綺麗だから。", "face": "u27"}, {"name": "ラクシャーサ", "text": "あぁ、認めざるを得ないな。\nおめでとう、ファルネ。", "face": "u306"}, {"name": "エレット", "text": "明日はあたしたちがいっぱい花びらを撒くから、\nファルネさんと王子も、あたしたちの分まで\nい～っぱい幸せを振りまいてね！", "face": "u217"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ファルネ", "text": "う、うん。頑張るわ。\n……王子、こんなあたしだけど、\n明日の式は、その……一緒にいい思い出にしようね？", "face": "u1640"}]}], "active": true}