_condition": 3, "master_id": 39233, "global_id": 12850, "to_condition": 3, "to_global_id": 12851, "spawn_sec": 134}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["帝国"], "hp": 15000, "attack": 1050, "base_hp": 15000, "base_attack": 1050, "damage_type": "true", "armor_defense": 1500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 85, "attack_interval": 246, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2164560, "race_id": 16, "master_id": 39234, "global_id": 12851, "from_condition": 3}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 45, "attack_interval": 241, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2164976, "race_id": 16, "change_to": 16, "master_id": 39241, "global_id": 12858, "route_behaviour": {"transforms": [{"flag": 6, "val": 1}]}, "spawn_sec": 211}, {"enemy_id": 18, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 299999, "attack": 1, "base_hp": 299999, "base_attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "attack_speed": 90, "attack_wait": 45, "attack_interval": 238, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2165008, "race_id": 16, "change_to": 18, "master_id": 39243, "global_id": 12860, "route_behaviour": {"transforms": [{"flag": 7, "val": 1}]}, "spawn_sec": 211}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "true", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 97, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2151648, "race_id": 16, "change_to": 20, "master_id": 37827, "global_id": 11444, "variants": [{"tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 300000, "base_hp": 300000, "damage_type": "true", "armor_defense": 1300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 30, "attack_interval": 97, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2155296, "race_id": 16, "master_id": 37839, "global_id": 11456}], "sp_change_to": [37839], "spawn_sec": 211}], "popups": ["壊れかけたベラート専用\nバトルタンクがいる間、\n全ての敵の攻撃力と\n防御力がアップします。\n\nまた壊れかけたベラート専用\nバトルタンクは\n体力が徐々に減少していきます。", "偉大なるベラート降臨が\n解放されました。\n\nホーム画面左側の\nミッションクエストにある、\n魔神降臨のメニューから\n遷移可能です。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ベラート", "text": "――黄金戦車！　イグニッションッ！！\n皇帝をひき肉にしてやるのだぁぁぁぁぁッ！！", "face": "lc1cc7aaf9a82"}, {"name": "伯爵領騎士", "text": "か、閣下！\nエンジンが赤熱しています！\n冷却装置破損！　このままでは爆発します！", "face": "l36511b202f8c"}]}, {"trigger": "route", "lines": [{"name": "ベラート", "text": "そんな馬鹿な……我が黄金は……ッ！\n栄光の日々はまだ――", "face": "lc1cc7aaf9a82"}, {"name": "サザンカ", "text": "あっ、爆発した。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "うん、いい爆発っぷりだね。", "face": "u1225a1"}, {"name": "白の皇帝", "text": "……期待外れ、だったか。", "face": "u418"}, {"name": "レオナ", "text": "陛下、いったいあの男に何を期待していたのですか。\n帝国を蝕む害虫そのものではありませんか。", "face": "u2600a1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}]}, {"trigger": "route", "lines": [{"name": "？？？", "text": "――聞き捨てなりませんわ。\n撤回しなさい、平民風情が！", "face": "u2598a1"}, {"name": "レオナ", "text": "なっ……何者だ！\nベラート伯爵の手勢か！？", "face": "u2600a1"}, {"name": "？？？", "text": "父様も父様ですわ！\n鎧と戦車だけを持ち出して、\n伯爵領の誇る最強の武具を置いていくなんて。", "face": "u2598a1"}, {"name": "オルドネッタ", "text": "とう、さま？　ベラート伯爵が父様……？\nって、ま、まさか！　あの子って！？", "face": "u2602a1"}, {"name": "アンジェリーネ", "text": "ようやく来ましたわね。\nベラート伯爵が末娘、魔剣に選ばれしじゃじゃ馬娘。", "face": "u430"}, {"name": "ベラート", "text": "べ、ベラドンナ、我が娘よ！\nなぜここに！？　食事には睡眠薬を――", "face": "lc1cc7aaf9a82"}, {"name": "ベラドンナ", "text": "手段が汚いんですのよ！\nそんなの食べたフリしてポイしましたわ！！", "face": "u2598a1"}, {"name": "ベラート", "text": "おぉぅ……幼い頃から\n毒殺対策を仕込み続けた弊害が……。", "face": "lc1cc7aaf9a82"}, {"name": "メーア", "text": "（どれだけ命狙われてんですかあの伯爵）", "face": "u2404a1"}, {"name": "マレブランケ", "text": "（私腹を肥やしまくるから自領は豊かだけど、\n交易相手には無理難題をふっかけまくってるからねぇ）", "face": "u1225a1"}, {"name": "ベラート", "text": "ベラドンナよ、お前は生き延びるのだ！\n家宝の剣を持ち出せば、\n王国なりどこなりで匿ってもらえるだろう！", "face": "lc1cc7aaf9a82"}, {"name": "ベラドンナ", "text": "ふざけんなですわ！\nクソ喰らえって言ってんですのよ！", "face": "u2598a1"}, {"name": "ベラート", "text": "ど、どこでそんな汚い言葉をぉっ！？", "face": "lc1cc7aaf9a82"}, {"name": "ベラドンナ", "text": "父様直伝ですわよ。\nさぁ、お立ちになって。\n伯爵家が家宝は、まだ父様を見限っていませんわ。", "face": "u2598a1"}, {"name": "ベラート", "text": "う、うむ……。\n私は、娘の育て方を間違ったのだろうか……。", "face": "lc1cc7aaf9a82"}, {"name": "ベラドンナ", "text": "大正解の育て方をしてもらいましたわ。\nだからこそ、お家の一大事において、\nここに駆けつけてきたのですわ。", "face": "u2598a1"}, {"name": "ベラドンナ", "text": "――皇帝陛下！\nここにわたくしも、決闘を申し込みますわ！", "face": "u2598a1"}, {"name": "白の皇帝", "text": "ああ。帝国法にのっとり、応じよう。", "face": "u418"}, {"name": "ベラドンナ", "text": "さぁ父様、剣を。", "face": "u2598a1"}, {"name": "ベラート", "text": "……うむ。", "face": "lc1cc7aaf9a82"}, {"name": "ベラドンナ", "text": "悲嘆の薔薇、魔剣アングルヴァダル！\n一族の危機たる今こそ、吠えて見せなさい！", "face": "u2598a1"}]}, {"trigger": "route", "enemy_ids": [7], "lines": [{"name": "ベラート", "text": "希望の薔薇、聖剣アングルヴァダル。\n我が娘に、背中を支えられる日が来るとは。\n一族の誇りと栄光にかけて、ここに勝利をもたらせ！", "face": "lc1cc7aaf9a82"}, {"name": "レオナ", "text": "……陛下、まさかこれを待っていたのですか？", "face": "u2600a1"}, {"name": "白の皇帝", "text": "……フッ。\n行くぞ、勝利をもってこの決闘を終わらせる。", "face": "u418"}]}, {"trigger": "route", "enemy_ids": [7], "lines": [{"name": "ベラート", "text": "――完敗だ、皇帝よ。", "face": "lc1cc7aaf9a82"}, {"name": "ベラドンナ", "text": "負けを認めますわ。\nさぁ、ここで首を刎ねなさい。", "face": "u2598a1"}, {"name": "ベラート", "text": "お、お待ちを！\nこのベラート、どうなっても構いませぬ！\nですからどうか、娘の命だけは――", "face": "lc1cc7aaf9a82"}, {"name": "白の皇帝", "text": "…………参ったな。\nこれでは俺が悪役のようだ。", "face": "u418"}, {"name": "カルラ", "text": "陛下、処分を法に則るのなら、\n伯爵らの身柄は帝国法務院に――", "face": "u2603a1"}, {"name": "白の皇帝", "text": "いや、決闘においては例外が認められるはずだ。", "face": "u418"}, {"name": "白の皇帝", "text": "ベラート、ベラート伯爵。\n貴様は俺に敗北した。そうだな？", "face": "u418"}, {"name": "ベラート", "text": "はっ……。", "face": "lc1cc7aaf9a82"}, {"name": "白の皇帝", "text": "これまでのクーデター、冥界軍との内通、\n帝国領土の毀損、あらゆる罪は貴様にある。そうだな？", "face": "u418"}, {"name": "ベラート", "text": "はっ。ははぁっ！", "face": "lc1cc7aaf9a82"}, {"name": "白の皇帝", "text": "よって、伯爵領は末娘――\nベラドンナに継承することを命ずる。\nベラドンナ、貴様が今日から伯爵だ。", "face": "u418"}]}, {"trigger": "route", "enemy_ids": [7], "lines": [{"name": "白の皇帝", "text": "そしてベラート、貴様は俺の下で働け。\n白の帝国貴族の名にかけて、\nその血の全てを帝国に捧げることを誓え。", "face": "u418"}]}, {"trigger": "route", "enemy_ids": [7], "lines": [{"name": "ベラート", "text": "…………ふぇえ？", "face": "lc1cc7aaf9a82"}, {"name": "ベラドンナ", "text": "と、父様！　顔が面白い形になってますわよ！\nしっかりしてくださいな！！", "face": "u2598a1"}, {"name": "ベラドンナ", "text": "陛下、しかしそれでは兵が納得しないのでは――", "face": "u2598a1"}, {"name": "白の皇帝", "text": "それも全て、ベラートの働き次第だ。", "face": "u418"}, {"name": "白の皇帝", "text": "これまで帝国の血肉を啜ってきたのだ。\n今度は、その人脈と悪知恵を、\n干からびるまで使わせてもらう。", "face": "u418"}]}], "hard": {"level": 120, "multiplier": 1.2, "modifiers": [{"kind": "term", "influence": 20, "params": [200]}, {"kind": "term", "influence": 21, "params": [0, 60]}], "enemies": [{"enemy_id": 1, "hp": 115200, "attack": 2400, "damage_type": "physical", "armor_defense": 1000, "pattern_id": 2133296}, {"enemy_id": 1, "form_index": 1, "hp": 115200, "attack": 2400, "damage_type": "physical", "armor_defense": 1000, "pattern_id": 2133296}, {"enemy_id": 3, "hp": 146400, "attack": 2640, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "pattern_id": 2164624}, {"enemy_id": 3, "form_index": 1, "hp": 146400, "attack": 2200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "pattern_id": 2164576}, {"enemy_id": 6, "hp": 110400, "attack": 2100, "damage_type": "magical", "armor_defense": 750, "magic_defense": 20, "pattern_id": 2164608}, {"enemy_id": 7, "hp": 1200, "attack": 1, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2097200}, {"enemy_id": 8, "hp": 2400, "attack": 420, "damage_type": "physical", "armor_defense": 150, "pattern_id": 2102256}, {"enemy_id": 9, "hp": 3000, "attack": 576, "damage_type": "physical", "armor_defense": 250, "pattern_id": 2111792}, {"enemy_id": 10, "hp": 12000, "attack": 560, "damage_type": "physical", "armor_defense": 650, "pattern_id": 2132992}, {"enemy_id": 11, "hp": 21600, "attack": 500, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "pattern_id": 2133056}, {"enemy_id": 13, "hp": 6000, "attack": 660, "damage_type": "physical", "armor_defense": 400, "pattern_id": 2155120}, {"enemy_id": 14, "hp": 18000, "attack": 2220, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 5, "pattern_id": 2164544}, {"enemy_id": 14, "form_index": 1, "hp": 18000, "attack": 1260, "damage_type": "true", "armor_defense": 1500, "magic_defense": 5, "pattern_id": 2164560}, {"enemy_id": 16, "hp": 359999, "attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "pattern_id": 2164976}, {"enemy_id": 18, "hp": 359999, "attack": 1, "damage_type": "physical", "armor_defense": 600, "magic_defense": 99, "pattern_id": 2165008}, {"enemy_id": 20, "hp": 360000, "damage_type": "true", "armor_defense": 1300, "magic_defense": 20, "pattern_id": 2151648}]}, "active": true}