{"quest_id": 8721, "name": "第十陣 悲嘆と希望の剣", "description": "執念で再び立ち上がるベラート伯爵。\nそんな伯爵を支えるかのように、\n少女の声が戦場に響き渡る……。\n神級（★１獲得の目安：平均Lv50）", "event": "帝国十陣", "event_category": "Empire", "mission_id": 940010, "map_no": 9433, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["機械", "帝国"], "hp": 96000, "attack": 2400, "base_hp": 96000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 1000, "attack_range": 300, "attack_wait": 200, "attack_interval": 461, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2133296, "race_id": 16, "special_effect_id": 2201, "change_to": 1, "change_condition": 5, "missile_id": 673, "missile": {"speed": 6.0, "splash": 133}, "master_id": 39235, "global_id": 12852, "ranged": true, "to_condition": 5, "to_global_id": 12853, "commands": {"raw": "SetStageFlag(0, 1);", "sets_flags": [[0, 1]]}, "route_behaviour": {"sets_flags": [[0, 1, 0]]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "帝国"], "hp": 96000, "attack": 2400, "base_hp": 96000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 1000, "attack_range": 300, "attack_wait": 200, "attack_interval": 461, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2133296, "race_id": 16, "special_effect_id": 2202, "missile_id": 673, "missile": {"speed": 6.0, "splash": 133}, "master_id": 39236, "global_id": 12853, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["ステルスII", "ブロック不可", "帝国"], "hp": 122000, "attack": 2200, "base_hp": 122000, "base_attack": 2200, "damage_type": "physical", "armor_defense": 800, "magic_defense": 10, "attack_speed": 90, "attack_wait": 80, "attack_interval": 341, "move_speed": 2400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2164624, "race_id": 16,