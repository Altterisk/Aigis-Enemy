{"quest_id": 6671, "name": "嘲う迅天君", "description": "電絶陣を操る邪仙、迅天君が襲い掛かる。\n＜病毒(中)：HPに継続ダメージ\n味方の攻防30％ダウン＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["病毒(中)：HPに継続ダメージ\n味方の攻防30％ダウン"], "event": "ハクタクに選ばれし者", "event_category": "History", "mission_id": 920120, "map_no": 3336, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 10, 30]}, {"kind": "term", "influence": 14, "params": [70]}, {"kind": "term", "influence": 13, "params": [70]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 8, "form_index": 0, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105120, "race_id": 14, "change_to": 1, "change_condition": 5, "master_id": 602, "global_id": 601, "to_condition": 5, "to_global_id": 602, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 10, "attack_wait": 30, "attack_interval": 106, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105136, "race_id": 14, "master_id": 603, "global_id": 602, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108080, "master_id": 991, "global_id": 990, "spawn_sec": 8}, {"enemy_id": 4, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106688, "master_id": 849, "global_id": 848, "spawn_sec": 64}, {"enemy_id": 5, "source": "local", "count": 6, "level": 90, "form_index": 0, "form_count": 1, "tags": ["アーマー", "機械"], "hp": 10000, "attack": 1200, "base_hp": 10000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 2000, "attack_speed": 55, "attack_wait": 50, "attack_interval": 236, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114384, "master_id": 31001, "global_id": 4620, "spawn_sec": 69}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 25000, "attack": 550, "base_hp": 25000, "base_attack": 550, "damage_type": "magical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 1, "attack_wait": 25, "attack_interval": 78, "move_speed": 3500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114240, "special_effect_id": 43, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30950, "global_id": 4569, "spawn_sec": 184}], "dialogue": [{"trigger": "start", "lines": [{"name": "迅天君", "text": "（――ほう？　こいつら我らの研究施設へ、\n真っ直ぐに向かってくるみたいだな……）", "face": "l738870861e7f"}, {"name": "迅天君", "text": "（まさか場所を知っているのか？\nそれともあの、うさんくさい\n『おとぎ話』を信じて進んでいるのか……？）", "face": "l738870861e7f"}, {"name": "アンナ", "text": "――王子、前方に……こほっ、けほっ……。\n前方に迅天君の姿を確認しました……っ。", "face": "le9788763bdb1"}, {"name": "迅天君", "text": "いやいや、感服したよ。\nそこまで病に蝕まれて、まだ先へ進めるとはね。", "face": "l738870861e7f"}, {"name": "カリン", "text": "くっ……どうして……。\nどうしてこんなことを、するのですか……？", "face": "u734"}, {"name": "迅天君", "text": "ははは、どうして、だって？\n君達の苦しそうに歪んだ顔を見ることが出来たんだ、\nこれだけで実験に協力した甲斐もあったというものさ。", "face": "l738870861e7f"}, {"name": "迅天君", "text": "病を操る宝貝とやら、\n我が電絶陣の力に比すれば児戯のようなものだと\n思っていたが、なかなかどうして面白い。", "face": "l738870861e7f"}, {"name": "太公望", "text": "邪仙が作り出した宝貝……。\nなるほど、だから邪仙たるあなたは、\nこの病の影響を受けていないのですね。", "face": "u603"}, {"name": "カリン", "text": "……先程、実験と言いましたか？\nこほっ……子供達を、村の人達を苦しめて、\nこんなものを、実験と言いましたか……？", "face": "u734"}, {"name": "迅天君", "text": "良いじゃないか、無価値な有象無象が、\n価値ある実験の糧になれるのだから。", "face": "l738870861e7f"}, {"name": "迅天君", "text": "それに死んでも何も失う物はないぞ？\nオレ達がキョンシーとして、\n有効活用してやろうじゃないか！", "face": "l738870861e7f"}, {"name": "カリン", "text": "…………ッ！！", "face": "u734"}, {"name": "迅天君", "text": "ははッ！　何も出来ない小娘のくせに、\n表情だけは一人前か！\nまぁいい、少しだけ遊んでやるとしようか！", "face": "l738870861e7f"}, {"name": "太公望", "text": "迅天君の操る電絶陣には、\n人を麻痺させる力があります。十分に警戒を。", "face": "u603"}, {"name": "アンナ", "text": "迅天君、配下への出撃指示を出したようです！\n王子、迎撃の指揮をお願いします！", "face": "lace48cea1f67"}]}, {"trigger": "end", "lines": [{"name": "迅天君", "text": "へぇ……病に蝕まれた身体で、\nまだそんな力を残しているとは、実に興味深い……。", "face": "l738870861e7f"}, {"name": "迅天君", "text": "ちょうどいい。病の末期症状が如何なるものか、\n王子達の身体で実験させてもらうとしようか。", "face": "l738870861e7f"}, {"name": "アンナ", "text": "くっ……迅天君、撤退していきます……。", "face": "le9788763bdb1"}, {"name": "フィリス", "text": "王子、追撃しよう。\nあいつらが病を蔓延させたんだ。\nここで見逃したら……くっ……ごほっ、ごほごほっ……。", "face": "u40"}, {"name": "太公望", "text": "……いえ、ここは見逃す他に手はありません。\nこのままでは私達の症状も進行するばかり。\n次の激突では、もはやまともに戦えるかどうか……。", "face": "u603"}, {"name": "フィリス", "text": "それは分かるけど……。\nじゃあどうするって言うんだよ……。", "face": "u40"}, {"name": "太公望", "text": "幸い、私達はハクタクの住処の伝承を知っています。\nごほっ、けほっ……この病さえ快癒すれば、\n万全の状態で邪仙と相対することが出来ます。", "face": "u603"}, {"name": "メイファ", "text": "つまり、このまま一直線に\nハクタクの伝承の地へ向かうのが最善手、\nということですね……？", "face": "u618"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "カリン", "text": "……わかりました。\n皆さん、わらべうたによれば、\nこちらの方角へ進めば伝承の地へたどり着くはずです。", "face": "u734"}]}, {"trigger": "end", "lines": [{"name": "迅天君", "text": "――ふむ、やはり連中、\nオレ達の研究施設の場所へまっすぐに向かっていくな。", "face": "l738870861e7f"}, {"name": "迅天君", "text": "自ら病毒の最も深き場所へ進むとは、\nどうやら本当に、ハクタクだなんて、\n架空のおとぎ話にすがるつもりのようだ……。", "face": "l738870861e7f"}]}], "map": {"image": "Map920120_3336", "w": 960, "h": 640, "spots": [{"k": "b", "x": 195, "y": 533}, {"k": "b", "x": 498, "y": 533}, {"k": "b", "x": 790, "y": 533}, {"k": "m", "x": 789, "y": 207, "id": 200}, {"k": "m", "x": 196, "y": 206, "id": 201}, {"k": "m", "x": 789, "y": 346, "id": 202}, {"k": "m", "x": 788, "y": 470, "id": 203}, {"k": "m", "x": 498, "y": 207, "id": 204}, {"k": "m", "x": 496, "y": 470, "id": 205}, {"k": "m", "x": 496, "y": 347, "id": 206}, {"k": "m", "x": 195, "y": 336, "id": 207}, {"k": "m", "x": 194, "y": 470, "id": 208}, {"k": "m", "x": 647, "y": 413, "id": 209}, {"k": "m", "x": 644, "y": 231, "id": 210}, {"k": "m", "x": 350, "y": 266, "id": 211}, {"k": "m", "x": 349, "y": 372, "id": 212}, {"k": "r", "x": 560, "y": 458, "id": 300}, {"k": "r", "x": 721, "y": 470, "id": 301}, {"k": "r", "x": 396, "y": 316, "id": 302}, {"k": "r", "x": 280, "y": 448, "id": 303}, {"k": "r", "x": 599, "y": 328, "id": 304}, {"k": "r", "x": 666, "y": 186, "id": 305}, {"k": "r", "x": 326, "y": 213, "id": 306}, {"k": "r", "x": 428, "y": 419, "id": 307}]}, "active": true}