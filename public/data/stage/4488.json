"enemy_id": 4, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 18}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "attack_speed": 20, "attack_wait": 10, "attack_interval": 86, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102080, "race_id": 2, "master_id": 356, "global_id": 355, "spawn_sec": 56}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 4000, "attack": 850, "base_hp": 4000, "base_attack": 850, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "special_effect_id": 222, "change_to": 6, "change_condition": 2, "master_id": 20056, "global_id": 1131, "to_condition": 2, "to_global_id": 1132, "spawn_sec": 60}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 950, "base_hp": 5000, "base_attack": 950, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 2000.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "special_effect_id": 64, "master_id": 20057, "global_id": 1132, "from_condition": 2}, {"enemy_id": 8, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "tags": ["アンデッド"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104544, "special_effect_id": 222, "change_to": 8, "change_condition": 2, "missile_id": 6, "master_id": 541, "global_id": 540, "ranged": true, "to_condition": 2, "to_global_id": 541, "spawn_sec": 70}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 350.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104544, "special_effect_id": 64, "missile_id": 6, "master_id": 542, "global_id": 541, "ranged": true, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 101}], "dialogue": [{"trigger": "start", "lines": [{"name": "メトゥス", "text": "（人間に戻る……それは、死を内包した存在\nにも戻るってことよね？　支配を恐れるか、\n死を恐れるか……。私は……。）", "face": "u329"}, {"name": "カリオペ", "text": "メトゥス、やっぱり元気ないね……。\nそりゃあそうよね。自分が操られたんだもの。\n力になりたいけど、どうしようもないわよね。", "face": "u42"}, {"name": "バルバストラフ", "text": "悩むことも時には重要。\n思索なくして、決意は生まれ得ぬものよ……。\n今はただ見守るしかなかろうて。", "face": "u63"}, {"name": "？？？", "text": "――フフフ、悩む必要などありませんよ。", "face": "l6be2b1e870a8"}, {"name": "カリオペ", "text": "だ、誰よッ！？", "face": "u42"}, {"name": "リッチロード", "text": "私はビフロンス様の忠実なる配下の一人、\nリッチロード。主の命によりメトゥス様を\nお迎えにあがりました。", "face": "l6be2b1e870a8"}, {"name": "メトゥス", "text": "追っ手を差し向けてまで魂を求めるなんてね。\nビフロンスも見る眼はあるようじゃない。\nだけど、私の魂はそう安くないのよ。", "face": "u329"}, {"name": "リッチロード", "text": "苦悩、煩い、恐怖……あなたを取り巻く\n負の楔は、ビフロンス様への忠誠ひとつで、\nすべて取り除かれるものなのですよ？", "face": "l6be2b1e870a8"}, {"name": "メトゥス", "text": "耳障りな台詞を並べ立てないでもらえるかしら？\nお喋りなリッチってキライなの……。\n私の魂がほしいなら、もぎ取ってみなさいよ。", "face": "u329"}, {"name": "リッチロード", "text": "仕方ありませんね……。\n我が主は私にこうも言っていました。", "face": "l6be2b1e870a8"}, {"name": "リッチロード", "text": "『生死は問わぬ』とね。\n我が主ながら実にユーモアがある。\n不死者に生死を問わないとは……くくく。", "face": "l6be2b1e870a8"}, {"name": "バルバストラフ", "text": "威圧感が増しよったわい……。\n気をつけることじゃ。\nあやつ、ただのリッチではないようじゃぞ。", "face": "u63"}, {"name": "リッチロード", "text": "フフ、ビフロンス様より与えられた\nこの強大な力をもって、\n貴方達を殺し尽くして上げましょう。", "face": "l6be2b1e870a8"}]}, {"trigger": "battle", "at_sec": 76, "lines": [{"name": "助手リッチ", "text": "コロス……人間ハ、ミナゴロシダ……。\n我ガ主ビフロンス様の御心のママニ……。", "face": "l0d7122ded6a9"}, {"name": "メトゥス", "text": "あら！　あなた達ッ！！　生きてたのね！？\nもうっ！　どれだけ心配させるのよ！\n少しだけだけど寂しかったのよ？", "face": "u329"}, {"name": "メトゥス", "text": "って、そうよね。魂が残っていれば\n何度だって蘇るのが不死者ですもの。\nあぁ、私ったらそんな単純なことを――。", "face": "u329"}, {"name": "助手リッチ", "text": "誰ダ、貴様ハ？\n死霊ガ……ナゼ人間に与スル？", "face": "l0d7122ded6a9"}, {"name": "メトゥス", "text": "――ッ！？　何を……言ってるの？\n私よ！　メトゥスよ！　あなたのマスター！\n……ほんとうに、覚えていないの？", "face": "u329"}, {"name": "助手リッチ", "text": "訳ノ分カラヌ事ヲ……。\n出来損ナイメ……コロシテヤル。\n役立タズノ不死者ナド必要ナイ……。", "face": "l0d7122ded6a9"}, {"name": "メトゥス", "text": "……うそよ。\nだって、あなたは私の死霊で。\n私はあなたのマスターで……こんなことって。", "face": "u329"}]}, {"trigger": "end", "lines": [{"name": "助手リッチ", "text": "……め、トゥス、さま……？\nメトゥス様ではないですか……ぅッ、ぐぐ……。", "face": "l0d7122ded6a9"}, {"name": "メトゥス", "text": "待っていなさい！　\nすぐに私が魂への支配を上書きしてあげるわ！\nはぁぁあッ――！", "face": "u329"}, {"name": "助手リッチ", "text": "……コロス……ち、ちがう……めとぅす……。\n……ビフロンスサマ、今、貴方様ノ下へ、\n還リマス……。再ビ、新タナ屍体ヲ私ニ……。", "face": "l0d7122ded6a9"}, {"name": "バルバストラフ", "text": "駄目じゃな……。\n助手の魂がビフロンスの下に還ろうとしておる。\nこれほどまでにビフロンスの力が強大とはのぅ。", "face": "u63"}, {"name": "バルバストラフ", "text": "メトゥスよ、聡明なおぬしなら残った手段は、\nもう理解しておるのじゃろう……。", "face": "u63"}, {"name": "メトゥス", "text": "信じないわ！\n私のネクロマンシーは、完璧なの、にっ……。\nなんでよ……私は最強の死霊術師なのよ！？", "face": "u329"}, {"name": "バルバストラフ", "text": "現実を見るのじゃッ！　おぬしの我が儘で、\nあやつを永遠に苦しめるつもりか？\nおぬしにしか救う事はできないのじゃぞ！", "face": "u63"}, {"name": "メトゥス", "text": "……このリッチはね、私のネクロマンシーで\n最初にこの世に生み出した不死者なの。", "face": "u329"}, {"name": "カリオペ", "text": "……メトゥス？", "face": "u42"}, {"name": "メトゥス", "text": "ただ嬉しかった……父上も母上もいない、\n孤独な不死者となった私にとって、\nこいつは家族以上の存在だった……。", "face": "u329"}, {"name": "メトゥス", "text": "でも……だからこそ、私なのよね……。\nあなたを完全に消滅させるのは、\n他の誰でもない、私にしかできないこと……。", "face": "u329"}, {"name": "バルバストラフ", "text": "皆、下がるがよい。\n不死者の創造主のみが行使できる、\n滅びの術を使う気じゃ……。", "face": "u63"}, {"name": "メトゥス", "text": "……汝を造りし、主メトゥスが命ずる！\n汝、骸なれば骸に還るべきなり！\nはぁあ……ッ！", "face": "u329"}, {"name": "助手リッチ", "text": "――ぁぁ…ぁ…メトゥス様……有り難うございます。\n……お泣きになることは……ないのです……。\n貴方には……もう、沢山の、仲間……が……。", "face": "l0d7122ded6a9"}, {"name": "メトゥス", "text": "……今まで、ありがとう。\nそして、さようなら……。", "face": "u329"}, {"name": "アンナ", "text": "……。", "face": "l25d711b332ee"}, {"name": "メトゥス", "text": "……大丈夫よ。\nさあ、先に進みましょう。\nもう後ろを向くのには、些か疲れましたわ。", "face": "u329"}]}], "map": {"image": "Map920060_3661", "w": 960, "h": 640, "spots": [{"k": "b", "x": 47, "y": 485}, {"k": "m", "x": 199, "y": 209, "id": 200}, {"k": "m", "x": 366, "y": 125, "id": 201}, {"k": "m", "x": 282, "y": 169, "id": 202}, {"k": "m", "x": 460, "y": 269, "id": 203}, {"k": "m", "x": 116, "y": 257, "id": 204}, {"k": "m", "x": 440, "y": 83, "id": 205}, {"k": "m", "x": 194, "y": 305, "id": 206}, {"k": "m", "x": 375, "y": 312, "id": 207}, {"k": "m", "x": 284, "y": 356, "id": 208}, {"k": "m", "x": 542, "y": 229, "id": 209}, {"k": "m", "x": 193, "y": 406, "id": 210}, {"k": "m", "x": 499, "y": 459, "id": 211}, {"k": "m", "x": 399, "y": 408, "id": 212}, {"k": "m", "x": 603, "y": 409, "id": 213}, {"k": "m", "x": 703, "y": 360, "id": 214}, {"k": "m", "x": 806, "y": 410, "id": 215}, {"k": "r", "x": 124, "y": 127, "id": 300}, {"k": "r", "x": 695, "y": 285, "id": 301}, {"k": "r", "x": 73, "y": 334, "id": 302}, {"k": "r", "x": 416, "y": 189, "id": 303}, {"k": "r", "x": 621, "y": 282, "id": 304}, {"k": "r", "x": 631, "y": 489, "id": 305}, {"k": "r", "x": 258, "y": 483, "id": 306}]}, "start_cost": 10, "active": true}