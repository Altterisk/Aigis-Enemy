ck_wait": 50, "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 76, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_global_id": 624, "spawn_sec": 360}, {"enemy_id": 76, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5200, "attack": 650, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 75, "master_id": 625, "global_id": 624}, {"enemy_id": 78, "source": "local", "count": 1, "form_count": 1, "hp": 32500, "attack": 1560, "base_hp": 25000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1200, "magic_defense": 40, "attack_speed": 10, "attack_wait": 15, "attack_interval": 96, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106304, "race_id": 18, "master_id": 30263, "global_id": 3882, "spawn_sec": 366}], "popups": ["2体の魔神は\n臨界近く溜め込んだ魔力の影響で\n体が崩壊を始めました。\n\nHPが徐々に減少し\n一定時間が経過するたびに\n攻撃力がアップします。\n　　　　　　(1/2)", "第二形態に変身した魔神は\n一定時間が経過すると\n能力が暴走を始め、戦場に\nさらなる影響を及ぼします。\n\n\n\n　　　　　　(2/2)", "オーラをまとった魔物がいる間は、\n全てのアンデッドの攻撃と防御が\nアップします。\n\n攻撃と防御アップの効果は、\nオーラをまとった魔物の数に\n応じて重複します。", "浮遊する頭蓋は倒されると\n自身の周囲にダメージを与えます。", "スケルトンバーサーカーは\n倒されると２回まで\nその場で復活します。\n\nまた、復活するごとに\nHP、攻撃、防御がアップします。", "魔神フェネクスがいる間は、\n全ての敵のHPが\n瞬時に回復します。\n\nまた、魔神フェネクスは体力が\n徐々に減少し、いずれ自滅します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アサル", "text": "――嫌な雰囲気ですね。\n砂漠の地下だというのに、何か異質なものを感じます。", "face": "u2163a1"}, {"name": "ザラーム", "text": "これは……まさか魔界の瘴気か？", "face": "u175"}, {"name": "メトゥス", "text": "……ビフロンスの魔力を感じるわ。\nフェネクスを配下としたことで、\n物質界を魔界化する力を得たのね。", "face": "u329"}, {"name": "メトゥス", "text": "このまま放置すれば、\nいずれ物質界全体がビフロンスの魔力に覆われて――", "face": "u329"}, {"name": "ホルエス", "text": "……不死者の統治する魔界と化す、ということですね。", "face": "u149"}, {"name": "ホルエス", "text": "そんなことは、絶対にさせません。\nここでビフロンス、フェネクスを叩きます！", "face": "u149"}, {"name": "メトゥス", "text": "その意気よ、砂漠の女王さま。", "face": "u329"}, {"name": "メトゥス", "text": "いい、ダーリン？\nビフロンスはアンデッドの能力を向上させる、\n死霊術師としての力を持っているわ。", "face": "u329"}, {"name": "メトゥス", "text": "見た目以上の力を持っているだろうから、\n油断しないように気をつけてね。", "face": "u329"}, {"name": "ハシム", "text": "ビフロンスばかりが敵じゃない。\nフェネクスの出現にも備えておけよ。", "face": "u170"}, {"name": "メトゥス", "text": "それじゃあ、魔神退治と行きましょうか。\nダーリン、あなたの力、みせてちょうだい！", "face": "u329"}]}, {"trigger": "battle", "at_sec": 229, "lines": [{"name": "アサル", "text": "――王子、魔神フェネクスが出現しました！", "face": "u2163a1"}, {"name": "メトゥス", "text": "ビフロンスによって、\n魔力が暴走させられているみたいね。", "face": "u329"}, {"name": "セシリー", "text": "フェネクスか……。\nまたこいつと戦うことになるなんてな。", "face": "u21"}, {"name": "ファルネ", "text": "フェネクスは周囲の敵を回復させる力を持っているわ。\n戦いが長引けば、それだけこちらが不利になるわよ！", "face": "u158"}]}, {"trigger": "end", "lines": [{"name": "フローガ", "text": "魔神ビフロンス、魔神フェネクス、\n魔力が暴走しています！", "face": "u878"}, {"name": "メトゥス", "text": "ダーリン、今なら\n魔神を消滅させられるわ！　とどめを！！", "face": "u329"}, {"name": "王子", "text": "…………ッ！！", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "フローガ", "text": "……魔神の魔力、霧散していきます！\nやりました、完全消滅です！", "face": "u878"}, {"name": "ホルエス", "text": "ふぅ……良かった……。\nこれで、砂漠地下の魔界化も止まるでしょうか。", "face": "u149"}, {"name": "メトゥス", "text": "えぇ、中心地点であったビフロンスが消滅したなら、\nここも徐々に、通常の地下空間に戻っていくはずよ。", "face": "u329"}, {"name": "ホルエス", "text": "間に合って、よかった……。", "face": "u149"}, {"name": "ホルエス", "text": "王子、みなさん、\n砂漠の国を危機から\n救っていただき、ありがとうございました。", "face": "u149"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ホルエス", "text": "……えぇと？\n恩返しをしただけ、だと……？", "face": "u149"}, {"name": "アンナ", "text": "砂漠の国は、\nいつも王国と共に戦ってくれていますから。"}, {"name": "ホルエス", "text": "うぅ、ずるい言い方です……。", "face": "u149"}, {"name": "ホルテウス", "text": "厚意は遠慮なく受け取っておけばいい。\n次に王国の窮地を救えば、\nそれが恩返しになるというものだ。", "face": "u1373a1"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "ホルエス", "text": "ふふっ……はい、分かりました。\n必ずや、この御恩はお返ししますね。", "face": "u149"}, {"name": "アンナ", "text": "それでは、拠点へ戻りましょうか。\n王子、此度の魔神討伐、お疲れ様でした！"}]}, {"trigger": "route", "lines": [{"name": "フローガ", "text": "――殿下！　ビフロンス内部の魔力、暴走しています！\nこれは……まさか、第二形態に！？", "face": "u878"}, {"name": "メトゥス", "text": "なに、この死霊術は……。\nいいえ、違う、これは……。", "face": "u329"}, {"name": "エマ", "text": "この力、私たち\nヴァンパイアの血族に近いものですね。", "face": "u582"}, {"name": "メトゥス", "text": "攻撃を受けたら、\nその分ビフロンスの傷が癒えていくということね？", "face": "u329"}, {"name": "エマ", "text": "えぇ、あのような下賎の魔神が、\n我々の真似事をしようとは。\n不愉快極まりないことですが。", "face": "u582"}, {"name": "メトゥス", "text": "ふふっ、夜の王の機嫌を損ねるなんて、\nビフロンスも運の尽きかしら。", "face": "u329"}]}, {"trigger": "route", "lines": [{"name": "アサル", "text": "っはぁ、はぁ……。\nくっ……生命力の吸収が、止まった？", "face": "u2163a1"}, {"name": "ネフティ", "text": "な、何ですかあれ？\n小さな鳥みたいなものが召喚されました！", "face": "u551"}, {"name": "ファルネ", "text": "気持ち悪いくらいの生命力を感じるわ。\nおそらく、フェネクスの回復の権能が\n具現化したものみたいね。", "face": "u158"}, {"name": "メトゥス", "text": "フェネクスの残穢、とでも呼ぶべきかしら。\n拠点に向かってくる様子はなさそうね。\nあれ自体に意思はないのかしら。", "face": "u329"}, {"name": "アサル", "text": "意思の有無は関係ありません！\n放置すれば敵の傷が癒えていきます。\n王子、手早く仕留めてしまいましょう！", "face": "u2163a1"}]}, {"trigger": "route", "lines": [{"name": "アサル", "text": "――ッ！？\n何、この圧力……身体から力が抜けて……。", "face": "u2163a1"}, {"name": "メトゥス", "text": "フェネクスが……生命力を吸い取っているの！？", "face": "u329"}, {"name": "フローガ", "text": "癒やしではなく、生命力を奪うとは……。\n再生の権能とは、\nまるっきり正反対の力に目覚めたようですね。", "face": "u878"}]}], "active": true}