_id": 30132, "global_id": 3751, "from_condition": 0}, {"enemy_id": 8, "source": "local", "count": 2, "form_index": 0, "form_count": 2, "tags": ["ステルス"], "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 135, "attack_interval": 361, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122544, "race_id": 16, "special_effect_id": 61, "change_to": 8, "missile_id": 26, "master_id": 32511, "global_id": 6130, "ranged": true, "to_condition": 0, "to_global_id": 6129, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 26}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス"], "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122528, "race_id": 16, "special_effect_id": 61, "change_to": 7, "master_id": 32510, "global_id": 6129, "from_condition": 0}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 24000, "attack": 420, "base_hp": 24000, "base_attack": 420, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_interval": 25, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118672, "race_id": 16, "special_effect_id": 61, "change_to": 10, "change_condition": 1, "missile_id": 358, "missile": {"speed": 10.0}, "master_id": 31751, "global_id": 5370, "ranged": true, "variants": [{"hp": 24000, "attack": 420, "base_hp": 24000, "base_attack": 420, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_interval": 25, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118688, "race_id": 16, "special_effect_id": 61, "missile_id": 358, "missile": {"speed": 10.0}, "master_id": 31752, "global_id": 5371, "ranged": true}], "spawn_sec": 26}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 220, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2122512, "race_id": 16, "special_effect_id": 125, "change_to": 12, "change_condition": 1, "missile_id": 26, "master_id": 32509, "global_id": 6128, "ranged": true, "variants": [{"hp": 18000, "attack": 800, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_range": 220, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109120, "race_id": 16, "special_effect_id": 125, "missile_id": 26, "master_id": 30130, "global_id": 3749, "ranged": true}], "spawn_sec": 26}], "popups": ["\n\n\n　　　　――数日前。", "アサシンから受けたダメージは\n２倍になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ファイブ", "text": "こんな大部隊を動かす必要はあったのか、シックス。\n商隊をしばらく引き止めるだけで良いのだろう？", "face": "l57c2bc17b898"}, {"name": "シックス", "text": "いえいえ、相手は商人とはいえ、\nあの王国に縁のある者ですからね。", "face": "lecd841872632"}, {"name": "シックス", "text": "前払いでこの石を受け取ったのです。\n仕事は完璧にやり遂げなければ。", "face": "lecd841872632"}, {"name": "ファイブ", "text": "まぁ、こちらとしては儲かればそれで良い。\nその点ブラッドストーンの価値は破格。\n今後の仕事も随分と楽になるだろう。", "face": "l57c2bc17b898"}, {"name": "シックス", "text": "そういうことです。ことが上手く運べば、\n何人かさらって売り払うのも良いでしょう。\nさぁ、仕事に取り掛かりますよ。", "face": "lecd841872632"}]}, {"trigger": "start", "lines": [{"name": "ディエーラ", "text": "――この辺りは、まだ復興が進んでいないんですね。", "face": "u538"}, {"name": "リッカ", "text": "魔王軍による被害は全世界規模でしたからね。\nでも大丈夫、盗賊が出たってへっちゃらですよ？", "face": "u152"}, {"name": "リッカ", "text": "何しろ王子の本隊と合流できましたし、\nキャラバンには私とこの子がついてますし！", "face": "u152"}, {"name": "ディエーラ", "text": "ふふっ、頼りにしていますよ？\n荷物は各地で仕入れた花嫁衣装です。\n夢見る女の子のためにも、絶対に守り抜かないと。", "face": "u538"}, {"name": "エターナー", "text": "……いや、待て。\nどうにも静か過ぎるぞ。", "face": "u298"}, {"name": "リッカ", "text": "誰もいないんだから、\n静かで当たり前じゃないですか？", "face": "u152"}, {"name": "エターナー", "text": "いや、不自然過ぎるんだ。\nまるで何かが隠れているような――", "face": "u298"}, {"name": "セブン", "text": "……はっ、この手口！\n王子、これは罠だ！　闇の組織の連中が潜んでるぞ！", "face": "u449"}, {"name": "ファイブ", "text": "――バレたぞ、シックス。", "face": "l57c2bc17b898"}, {"name": "シックス", "text": "元より王国軍相手にからめ手は通用しませんか。\nさぁ、仕事を始めましょうか！", "face": "lecd841872632"}]}, {"trigger": "end", "lines": [{"name": "シックス", "text": "さてファイブ、仕込みは済みましたか？", "face": "lecd841872632"}, {"name": "ファイブ", "text": "抜かり無い。ブラッドストーンを仕込んだ装飾品は、\nドレスと一緒に荷車の中だ。――さぁ撤退するぞ。", "face": "l57c2bc17b898"}, {"name": "セブン", "text": "あ、あれ？\n闇の組織の連中が退いていくぞ……？", "face": "u449"}, {"name": "ディエーラ", "text": "諦めた、ということでしょうか……？", "face": "u538"}, {"name": "セブン", "text": "あいつらがこんな簡単に退くとは思えないけど……。\n――アイリーン姐さん、どう思う？", "face": "u449"}, {"name": "アイリーン", "text": "……こちらの情報網で探っておこう。\n金の動きだけでは把握できない、\n別の何かを目的に動いているのかもしれない。", "face": "u315"}, {"name": "アンナ", "text": "闇の組織はいったい何を狙っていたのでしょうか。\n原因が分からないのが不気味ですね……。", "face": "ld25eb68c1dfc"}, {"name": "アンナ", "text": "ともかく王子、此度の戦闘お疲れさまでした！"}]}], "map": {"image": "Map920145_5558", "w": 960, "h": 640, "spots": [{"k": "b", "x": 931, "y": 228}, {"k": "b", "x": 927, "y": 424}, {"k": "m", "x": 744, "y": 372, "id": 200}, {"k": "m", "x": 649, "y": 349, "id": 201}, {"k": "m", "x": 544, "y": 166, "id": 202}, {"k": "m", "x": 310, "y": 400, "id": 203}, {"k": "m", "x": 823, "y": 198, "id": 204}, {"k": "m", "x": 714, "y": 177, "id": 205}, {"k": "m"