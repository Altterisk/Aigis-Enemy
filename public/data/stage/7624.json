0, "attack_speed": 1, "attack_wait": 10, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117968, "missile_id": 11, "master_id": 31616, "global_id": 5235, "ranged": true, "spawn_sec": 137}, {"enemy_id": 13, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 700, "base_hp": 12000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 30, "attack_range": 80, "attack_speed": 1, "attack_wait": 10, "attack_interval": 71, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117984, "missile_id": 11, "master_id": 31617, "global_id": 5236, "ranged": true, "spawn_sec": 175}, {"enemy_id": 14, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_speed": 1, "attack_wait": 1, "attack_interval": 54, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108112, "master_id": 993, "global_id": 992, "spawn_sec": 203}, {"enemy_id": 15, "source": "local", "count": 2, "form_count": 1, "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "magical", "armor_defense": 400, "magic_defense": 20, "attack_range": 150, "attack_speed": 1, "attack_wait": 55, "attack_interval": 201, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112848, "special_effect_id": 229, "missile_id": 237, "missile": {"speed": 8.0}, "master_id": 30727, "global_id": 4346, "ranged": true, "spawn_sec": 223}], "popups": [" 　　悪天候：豪雨\n\n・敵味方の『射程』減少\n・悪天候の影響を受けない特性を持つ\n　ユニットは『射程』減少の影響を\n　受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "迅天君", "text": "おやおや、そこの綺麗なお嬢さん。\nこんな雨の中に傘も差さずにどうしたんだい？\nもしよければ少し雨宿りしていくといい。", "face": "l058b5a21f043"}, {"name": "フーロン", "text": "──結構です。今、とても忙しいので。", "face": "u1512a1"}, {"name": "迅天君", "text": "ははッ、美人はツレないねぇ。\nそこの爺さんがキミに話があるらしい。\n少しばかり時間をくれたりしないか？", "face": "l058b5a21f043"}, {"name": "フーロン", "text": "断固としてお断りします。人を探しているんです。\n今この瞬間にもコマちゃんは泣いているかもしれない。", "face": "u1512a1"}, {"name": "迅天君", "text": "（コマちゃん……？）", "face": "l058b5a21f043"}, {"name": "屍解仙", "text": "カッカッカ！　珍しい個体がいると噂には聞いていたが、\nなるほどのぉ、こやつあの男の娘か……こいつは愉快愉快！", "face": "l9a13a17318d9"}, {"name": "フーロン", "text": "────ッ！", "face": "u1512a1"}, {"name": "迅天君", "text": "なんだい爺さん、知ってるのかい？", "face": "l058b5a21f043"}, {"name": "屍解仙", "text": "おお、そこの娘の父親はな、\n化境に至るだけの素質を持ちながら、\n女のために武の道を捨てた半端者よ。", "face": "l9a13a17318d9"}, {"name": "屍解仙", "text": "妻子を病で亡くしたと聞いたが、\nまさかキョンシーにしていたとはのぉ。\nだが、素人の作品にしてはよく出来ておる。", "face": "l9a13a17318d9"}, {"name": "屍解仙", "text": "どれ、わしが有効活用して──", "face": "l9a13a17318d9"}, {"name": "フーロン", "text": "──耳障りです。口を閉じてください、三下。", "face": "u1512a1"}, {"name": "迅天君", "text": "……おいおいお嬢さんよ、\nそれはオレたちに言ったのか？", "face": "l058b5a21f043"}, {"name": "フーロン", "text": "ええ、もちろん。", "face": "u1512a1"}, {"name": "フーロン", "text": "かけっこ自慢に人形趣味の変態爺。\n王子に怯えてコソコソするしか能の無い、\n邪仙郷の面汚しだと聞き及んでいますが？", "face": "u1512a1"}, {"name": "迅天君", "text": "はっはァ！　死体の分際で吠えるじゃないか！\n──あんまり舐めたこと言うと蹴り殺しちまうぞ？", "face": "l058b5a21f043"}, {"name": "屍解仙", "text": "おい、貴重な研究材料じゃ、加減には気をつけい。", "face": "l9a13a17318d9"}, {"name": "フーロン", "text": "（この雨の中では遠間の狙いは付けにくい……\n少々厳しい条件ではありますが、仕方ありません）", "face": "u1512a1"}, {"name": "フーロン", "text": "敗北の言い訳を考えておくことをオススメしますよ。\n貴方たちは今から、その半端者の技に負けるのですから。", "face": "u1512a1"}]}, {"trigger": "end", "lines": [{"name": "フーロン", "text": "わぁ、本当に速いんですね！　に・げ・あ・し！", "face": "u1512a1"}, {"name": "迅天君", "text": "くっ……そっがァ！　キョンシー風情が……！", "face": "l058b5a21f043"}, {"name": "屍解仙", "text": "やめい迅天君！　ここは一旦退くのじゃ！", "face": "l9a13a17318d9"}, {"name": "迅天君", "text": "指図するな爺さん。オレはアンタの部下じゃない。\nアンタの言う天雷がオレの仙術に役立つって言うから、\n一時的に協力してやっているだけなのを忘れるなよ。", "face": "l058b5a21f043"}, {"name": "屍解仙", "text": "分かっておるわい、その上でじゃ。\n収穫はあった、あれはもう放っておけ。", "face": "l9a13a17318d9"}, {"name": "屍解仙", "text": "今は雌伏の時、無駄に力を使うでない。", "face": "l9a13a17318d9"}, {"name": "迅天君", "text": "チッ……分かったよ、爺さん。", "face": "l058b5a21f043"}, {"name": "フーロン", "text": "……ふぅ、本当に逃げましたか。\nあと少しで首が落とせそうでしたが、\nさすがにそう甘くはありませんね。", "face": "u1512a1"}, {"name": "フーロン", "text": "まあ、撃退できただけでも良しとしましょう。\nそれよりも、取り急ぎ解決すべき問題は──", "face": "u1512a1"}, {"name": "フーロン", "text": "──私が迷子ということですね。", "face": "u1512a1"}, {"name": "フーロン", "text": "スプリガンに誘拐されたコマちゃんを探しに来たはずが、\nまさにミイラ取りがミイラ、いえ私はキョンシーですが……。", "face": "u1512a1"}, {"name": "フーロン", "text": "はてさて、ここからどうやって帰りましょうか……。", "face": "u1512a1"}, {"name": "ユーティ", "text": "フーロンさーん！　はぁ、はぁ、\nやっと見つけましたよ……！", "face": "u1514a1"}, {"name": "フーロン", "text": "ユーティさん、よくここが分かりましたね。\nちなみに私はここが何処だか分かりません。", "face": "u1512a1"}, {"name": "ユーティ", "text": "えぇぇ……フーロンさんて意外と──じゃなくて、\n緊急事態です……急いで王城の方に戻りましょう。", "face": "u1514a1"}, {"name": "ユーティ", "text": "──コマちゃんの居場所が分かりました。", "face": "u1514a1"}]}], "active": true}