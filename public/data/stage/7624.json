{"quest_id": 7624, "name": "コマちゃんを探して", "description": "攫われたコマを探して一人捜索を続ける\nフーロンに、迅天君と屍解仙が襲い掛かる！\n＜特定のタイミングで豪雨が発生＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["特定のタイミングで豪雨が発生"], "event": "白無垢姫とたくさんの小人", "event_category": "History", "mission_id": 920177, "map_no": 4097, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 23000, "attack": 500, "base_hp": 23000, "base_attack": 500, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_range": 200, "attack_speed": 30, "attack_wait": 10, "attack_interval": 91, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106736, "special_effect_id": 229, "change_to": 1, "change_condition": 2, "missile_id": 6, "master_id": 31876, "global_id": 5495, "ranged": true, "to_condition": 2, "to_global_id": 5496}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド"], "hp": 23000, "attack": 3000, "base_hp": 23000, "base_attack": 3000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 30, "attack_speed": 150, "attack_wait": 50, "attack_interval": 351, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106752, "master_id": 31877, "global_id": 5496, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 13, "form_count": 1, "tags": ["アンデッド"], "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106672, "master_id": 842, "global_id": 841, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 700, "base_hp": 6000