12, "source": "local", "count": 1, "form_count": 1, "tags": ["ゴールドユニット"], "hp": 5000, "attack": 450, "base_hp": 5000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 137, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109792, "race_id": 16, "special_effect_id": 54, "master_id": 31437, "global_id": 5056, "spawn_sec": 43}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "tags": ["ゴールドユニット"], "hp": 6000, "attack": 275, "base_hp": 6000, "base_attack": 275, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 181, "move_speed": 200.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102992, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31441, "global_id": 5060, "ranged": true, "spawn_sec": 44}], "popups": ["ロゼットがいる間は\nレアリティゴールドの\n敵ユニットの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シェリー", "text": "――少し、食べ過ぎちゃった気がします。", "face": "u1027"}, {"name": "リリア", "text": "東の国のお料理、\nとっても美味しかったですからね……。", "face": "u1020"}, {"name": "ロゼット", "text": "――あぁっ！　皆さんまだ食べていらしたのですか？", "face": "u1729"}, {"name": "オリヴィエ", "text": "ちょうど食べ終わって休んでいたところですよ。\nそれよりロゼット、その恰好は？\n着物、似合っているじゃないですか。", "face": "u1115"}, {"name": "ロゼット", "text": "これはですね……皆で東の国の散策を\nしていたのですが、\n無理やり着せられてしまいまして……。", "face": "u1729"}, {"name": "メーリス", "text": "あら、ロゼットはとっても可愛いんだから、\nこういう恰好も絶対似合うって思っただけよ？", "face": "u1078"}, {"name": "モモ", "text": "わたしたちの見立て通りだったよね！\nやっぱりお姫さまだし……。\nきらきらして、とっても素敵で……はぁ、可愛いなぁ。", "face": "u1249"}, {"name": "ステラ", "text": "体型の維持とかも大変そうですよね！\n天馬の負担にならないよう、\n私もしっかり運動しておかないと。", "face": "u1148"}, {"name": "テミス", "text": "（くっ……無意識なのかしら。\n食べ過ぎた私達にとって、\n限りなく痛いところを突いてきますわ……）", "face": "u38"}, {"name": "シビラ", "text": "（そうね……たくさん食べた以上、\nたくさん運動をしておかなければ……）", "face": "u1039"}, {"name": "リリア", "text": "あの、皆さん良かったら、\n食後の運動に付き合っていただけませんか？", "face": "u1020"}, {"name": "ロゼット", "text": "運動ですか……？　でももうちょっと、\n散策したいところもあるんですけど……。", "face": "u1729"}, {"name": "ジーナ", "text": "じゃあ運動しながら散策すれば、\n一石二鳥ってやつだな！\nそうと決まれば、よーし、行くぞみんな！！", "face": "u1131"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アンナ", "text": "王子、どうかなさいましたか？\n――あら、あちらで騒いでいるのは……。\nはぁ、少し羽目を外しすぎですね……。"}, {"name": "アンナ", "text": "王子、ひとまず皆さんを止めましょう。\nお説教はその後です！", "face": "l6ad2d2ab4d1f"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "もう、運動をするのは良いことですが、\nあまりはしゃぎ過ぎてはいけませんよ？", "face": "l6ad2d2ab4d1f"}, {"name": "ジーナ", "text": "いやぁ、ついつい熱くなっちゃって。\n悪かったね。", "face": "u131"}, {"name": "シビラ", "text": "あら？　でもアンナも\n少しふくよかになったんじゃない？\n東の国のご飯はおいしいものね。", "face": "u39"}, {"name": "アンナ", "text": "…………くっ。\nあの、後で別の場所で、\n私も一緒に運動しても良いですか？", "face": "lcd5b67a8847f"}, {"name": "シビラ", "text": "ふふっ、もちろんよ。", "face": "u39"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "アンナ", "text": "そ、それでは、とにかく一段落ということで！\n王子はお気になさらないでください！"}]}], "active": true}