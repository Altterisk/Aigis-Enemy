ate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 6, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 9, "source": "local", "count": 11, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 121}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 122}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "race_id": 9, "master_id": 38, "global_id": 37, "spawn_sec": 125}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 320, "magic_defense": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 132}, {"enemy_id": 13, "source": "local", "count": 2, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 166}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 9000, "attack": 500, "base_hp": 9000, "base_attack": 500, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 40, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105776, "race_id": 16, "master_id": 719, "global_id": 718, "spawn_sec": 184}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンクイーン", "text": "何でこんなに邪魔な岩が転がってるのよぉ！\nこれじゃあ騎獣戦車の進行の邪魔になるわ！\nいったいどういうことなのぉ！？", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "一体何故でしょうねぇ……？\n……実に不思議です。\n無能な戦術家にはさっぱり分かりません。", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "まぁいいわ。\n最新式のこの戦車を使えば、\n戦術なんて関係ないわ。王子軍を蹂躙するのよッ！", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "（王子……。\n後は君らにかかっている……。\n何が何でも勝ってくれ……）", "face": "u354"}, {"name": "へクター", "text": "ゴブリンの軍勢を確認！\n……あ、あれは！？\nせ、戦車！？", "face": "u74"}, {"name": "アンナ", "text": "王子！　ゴブリンが新たな兵器を投入しています！\n十分に注意してご采配をお願いします！", "face": "la0e94353615f"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンクイーン", "text": "最新の騎獣戦車が敗れるなんて……。\nゴブリン兵も数が減りすぎたし、一旦去るしかないわ。\n――ただ、一つやっておく事があるわね。", "face": "ldf5e1bdd1e51"}, {"name": "ゴブリンクイーン", "text": "そこの愚鈍な戦術家！\nあなたみたいな使えない軍師なんて\n私のゴブリン軍団にはいらないわ。", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "…………。", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "あなたのせいで、私のゴブリン軍団も、\n最新式の戦車もすべて壊滅したの……。\n分かる？　分からないかしらね、愚鈍ですものね。", "face": "ldf5e1bdd1e51"}, {"name": "ゴブリンクイーン", "text": "もう顔も見たくないけど……、\n手を汚すのもイヤだし、そうねぇ……。\nあなた、自害しなさい。", "face": "ldf5e1bdd1e51"}, {"name": "ヘレナ", "text": "はい、ゴブリンクイーン様。\n仰せのままに。\nでは……。　――ッ！！", "face": "u354"}, {"name": "ゴブリンクイーン", "text": "ウフフ……いい子ね。ヘレナ。\n最後の潔さだけは良かったわよ。\nさようなら、愚鈍な戦術家さん……ウフフ……。", "face": "ldf5e1bdd1e51"}]}, {"trigger": "end", "lines": [{"name": "ヘレナ", "text": "――行ったか。\n馬鹿な女王だ。\n奴の催眠などとうに破っているというのに。", "face": "u354"}, {"name": "ヘレナ", "text": "さて……、\n英雄の子孫の王子とやらに、\n挨拶にいくか――っと、向こうからやってきたか。", "face": "u354"}, {"name": "へクター", "text": "王子！\nゴブリン軍にいた女性を発見しました！", "face": "u74"}, {"name": "ユリアン", "text": "おい！　うかつに近づくなヘクター！\nまだゴブリンクイーンに\n操られているかもしれないだろ！", "face": "u7"}, {"name": "ヘレナ", "text": "ん？　操られている？\n何を言っているんだ君は。\nそんな不覚を私がとると思ったか？", "face": "u354"}, {"name": "ヘレナ", "text": "私は天才戦術家ヘレナだ。\n全ては想定通り。君達は良くやってくれた！\n惜しみない賛辞をおくろう。", "face": "u354"}, {"name": "アンナ", "text": "えっ！？　操られていたのではないのですか！？\nあの女王の催眠に対抗するなんて、\n一体どういう事なのですか……？", "face": "la0e94353615f"}, {"name": "ヘレナ", "text": "私は、ゴブリンクイーンに\n軍師としてゴブリン軍を指揮する事を\n強要させられていた。", "face": "u354"}, {"name": "ヘレナ", "text": "見てのとおり、\n君らのお陰もあって、今は自由の身だがな。\n――ッつぅ……くそ……傷が。", "face": "u354"}, {"name": "アンナ", "text": "ヘレナさん……！　腕から大量の出血が……！？　\nすぐに治療できる場所へ移動しましょう！\n詳しい話はそれからお伺いします。", "face": "la0e94353615f"}]}], "active": true}