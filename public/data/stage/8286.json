e_id": 2, "special_effect_id": 232, "change_to": 11, "change_condition": 4, "missile_id": 476, "master_id": 34986, "global_id": 8603, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 8604, "route_behaviour": {"sets_flags": [[2, 1, 0], [1, 1, 0], [3, 1, 0]]}, "spawn_sec": 48}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 18000, "attack": 400, "base_hp": 18000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 28, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2137664, "race_id": 2, "master_id": 34987, "global_id": 8604, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 13, "source": "local", "count": 6, "form_count": 2, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_range": 160, "attack_speed": 1, "attack_wait": 10, "attack_interval": 96, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123904, "race_id": 2, "special_effect_id": 232, "change_to": 13, "change_condition": 4, "missile_id": 476, "master_id": 32700, "global_id": 6318, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6319, "route_behaviour": {"sets_flags": [[3, 1, 0], [1, 1, 0], [2, 1, 0]]}, "spawn_sec": 87}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 5, "attack_speed": 1, "attack_wait": 10, "attack_interval": 87, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123920, "race_id": 2, "master_id": 32701, "global_id": 6319, "from_condition": 4, "trigger_ticks": 1}], "popups": ["ドラコトプスは味方ユニットを\n発見すると、咆哮を行います。\n咆哮後、移動速度が上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "宿泊客のゴブリン", "text": "ワオ！　ユーアーグレートソルジャー！", "face": "l747c5179b17d"}, {"name": "トゥアン", "text": "お、おう。さっさとホテル戻れよな。", "face": "u2189a1"}, {"name": "宿泊客のゴブリン", "text": "センキューベリーマッチ！", "face": "l747c5179b17d"}, {"name": "トゥアン", "text": "……やけに流暢なゴブリンだったな。", "face": "u2189a1"}, {"name": "ソラス", "text": "出来立てのリゾート地に来てるぐらいですからねー。\nゴブリンの中でもかなりの富裕層なのかもしれません。\nその分、他より教養とか余裕とかあるんじゃないですか？", "face": "u2185a1"}, {"name": "トゥアン", "text": "脳が理解を拒否するワードだぜ……。", "face": "u2189a1"}, {"name": "ラーワル", "text": "よっ、脳筋女王！", "face": "u2181a1"}, {"name": "ホルテウス", "text": "トゥアンよ、我は同じ女王として恥ずかしいぞ。", "face": "u1837a1"}, {"name": "トゥアン", "text": "殴るぞ。", "face": "u2189a1"}, {"name": "トラム", "text": "喧嘩しないの。そろそろ次の波が来るわよ。", "face": "u1838a1"}, {"name": "サナラ", "text": "かなりの大群みたいですね。\nグルメジャングル中の魔獣さんたちが、\nリゾートに向かってるのかもしれません。", "face": "u1830a1"}, {"name": "トゥアン", "text": "仕方ねぇ、避難完了までの時間稼ぎだ。", "face": "u2189a1"}, {"name": "トゥアン", "text": "自分たちが狩る側だと思ってる馬鹿共に、\n年季の違いってやつを教えてやるとするか。", "face": "u2189a1"}, {"name": "ソラス", "text": "……トゥアン。", "face": "u2185a1"}, {"name": "トゥアン", "text": "なんだよ。", "face": "u2189a1"}, {"name": "ラーワル", "text": "年寄りくさいよ？", "face": "u2181a1"}, {"name": "トゥアン", "text": "うるさいな！！！！", "face": "u2189a1"}]}, {"trigger": "end", "lines": [{"name": "トゥアン", "text": "──そぉらっとォ！", "face": "u2189a1"}, {"name": "ラーワル", "text": "トゥアン、ナイス―！", "face": "u2181a1"}, {"name": "サナラ", "text": "もう逃げ遅れた宿泊客はいないみたいですね。", "face": "u1830a1"}, {"name": "トラム", "text": "だけど、急にどうして魔獣が暴れ出したのかしら。\nデモシェフ商会に手落ちはなさそうだったけど……。", "face": "u1838a1"}, {"name": "ラーワル", "text": "そうだとしたら他の商会からの妨害工作とか？\n手広く事業をやってるから競合とか多そうだし。", "face": "u2181a1"}, {"name": "ホルテウス", "text": "その割には駒の動かし方が稚拙であろうよ。\n我ならばより効率的にリゾートを破壊できる。", "face": "u1837a1"}, {"name": "トゥアン", "text": "そんなこと誇られてもなぁ。", "face": "u2189a1"}, {"name": "サナラ", "text": "ともかく、一先ず拠点に戻りませんか？\n襲撃がこれで終わりとは思えないですし。", "face": "u1830a1"}, {"name": "トラム", "text": "そうね、何か対策を立てないと。\nこのままだといつか限界が来るわ。", "face": "u1838a1"}, {"name": "ホルテウス", "text": "ふふふ、案ずるな。我に秘策がある。", "face": "u1837a1"}, {"name": "ラーワル", "text": "秘策？", "face": "u2181a1"}, {"name": "トゥアン", "text": "（こいつが自信満々のときって、\nなんかちょっと不安なんだよなー）", "face": "u2189a1"}]}], "active": true}