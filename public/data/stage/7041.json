{"quest_id": 7041, "name": "さらわれた花嫁", "description": "王国にジューンブライドの季節が訪れた。\nだが華やかな祝祭の影で花嫁姿の女性が\n次々と姿を消す事件が起きており……？\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "ジューンブライド・ミッドナイト", "event_category": "History", "mission_id": 920145, "map_no": 5554, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 15, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 28}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 57}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 79}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 111}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 125}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 139}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 146}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 152}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2122464, "special_effect_id": 233, "change_to": 3, "change_condition": 1, "master_id": 32506, "global_id": 6125, "variants": [{"tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160}], "spawn_sec": 160}], "popups": ["\n\n\n　　　　――次の日。"], "dialogue": [{"trigger": "start", "lines": [{"name": "スイレン", "text": "――よぉし、連続花嫁誘拐事件の犯人は、\nぜ～ったい私が捕まえちゃうんだから～！", "face": "u1013a1"}, {"name": "スイレン", "text": "魔物だって天使だってヴァンパイアだって、\n何が相手でも――って、あ、あれ……？", "face": "u1013a1"}, {"name": "スイレン", "text": "宝石が熱い……。\n身体の、力が……抜けて……あっ……。", "face": "u1013a1"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "――王子、ここがスイレンさんが\n失そうしたという事件現場です。", "face": "ld25eb68c1dfc"}, {"name": "アンナ", "text": "兵の報告によれば、ここ数日\nジューンブライドの祝祭の花嫁役に選ばれた女性が、\n突然姿を消す事件が続いているそうです。", "face": "ld25eb68c1dfc"}, {"name": "ケイティ", "text": "犯人の足取りは全くつかめていません。\n姿を消した方々が心配ですね……。", "face": "u114"}, {"name": "ルシル", "text": "スイレンめ、昨日はあんなに嬉しそうに、\n祝祭用のドレスを自慢してきたというのに。", "face": "u222"}, {"name": "リエーレ", "text": "無事に帰ってきたらお仕置きだな。\n心配させた分、訓練に付き合わせてやらないと。", "face": "u490"}, {"name": "ヒューナ", "text": "でも、もしこれが魔物による誘拐事件だとしても、\nあの子がそんな簡単に捕まるかしら？", "face": "u627"}, {"name": "フーリ", "text": "あっ……もしかして、\n花嫁役の姿で囮になろうとしたのかも……？", "face": "u174"}, {"name": "ディエーラ", "text": "おとり……ですか……。\nそうですね、スイレンさんは優しい方ですから……。", "face": "u538"}, {"name": "フラン", "text": "――ん、皆止まって。\n向こうから何かが近づいてきてるみたい。", "face": "u183"}, {"name": "ヒューナ", "text": "あれは……ふぅん、\n魔物に交じってヴァンパイアがいるじゃない。\n王子、連中の爪牙には気をつけなさい？", "face": "u627"}, {"name": "フラン", "text": "連中の攻撃を何度も受け止めると、\n身体が麻痺してしまうからね。", "face": "u183"}, {"name": "アンナ", "text": "今回の事件に関係があるのかもしれません。\n王子、急ぎ迎撃の準備をお願いします！", "face": "ld25eb68c1dfc"}]}, {"trigger": "battle", "at_sec": 162, "lines": [{"name": "フーリ", "text": "ヒューナさん、あの魔物、矢が当たりません！\n霧に姿を変える力を持っているみたいです！", "face": "u174"}, {"name": "ヒューナ", "text": "なるほどね。王子、ヴァンパイアの中には\n霧化する能力を持つ連中がいるの。\n接近戦に持ち込めばその能力を無力化できるはずよ。", "face": "u627"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "無事に撃退はできましたが……。", "face": "u114"}, {"name": "ヒューナ", "text": "手がかりらしい手がかりは無し、ね……。", "face": "u627"}, {"name": "ヴィンセント", "text": "とはいえ、事件現場にヴァンパイアがいたんだ。\nもはや迷子や家出とは言っていられないだろう。", "face": "u103"}, {"name": "ヒューナ", "text": "そうね、人を惑わすのはヴァンパイアの得意分野。\n祝祭の花嫁役の子たちも、\n魅了の力でさらわれちゃったのかも。", "face": "u627"}, {"name": "ディエーラ", "text": "…………。", "face": "u538"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "フーリ", "text": "あの、ディエーラさん？\nなにか気になることでもありましたか？", "face": "u174"}, {"name": "ディエーラ", "text": "あ、いえ……えぇと……はい……。\n失そうした女性には、もうひとつ\n共通点があることに、気付いてしまったんです。", "face": "u538"}, {"name": "ルマリア", "text": "共通点、ですか？", "face": "u343"}, {"name": "ディエーラ", "text": "はい……思い違いであってほしかったんですけどね……。", "face": "u538"}, {"name": "ディエーラ", "text": "――失そうした祝祭の花嫁さんたちはみんな、\n私のキャラバンが手配したドレスを着ていたんです。", "face": "u538"}]}], "active": true}