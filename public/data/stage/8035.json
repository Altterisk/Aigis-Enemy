{"quest_id": 8035, "name": "第六陣 死者の国の砦", "description": "古い砦を利用し、陣地を構築した同盟軍に\n再びアンデッドの群れが襲い来る！！\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国六陣", "event_category": "Empire", "mission_id": 940002, "map_no": 4778, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 17, "form_count": 1, "tags": ["アンデッド"], "hp": 18000, "attack": 900, "base_hp": 18000, "base_attack": 900, "damage_type": "physical", "armor_defense": 660, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2146176, "master_id": 36399, "global_id": 10016, "spawn_sec": 67}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 72}, {"enemy_id": 3, "source": "local", "count": 16, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 98}, {"enemy_id": 4, "source": "local", "count": 13, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 124}, {"enemy_id": 5, "source": "local", "count": 21, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 163}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 30000, "attack": 1000, "base_hp": 30000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "attack_range": 250, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2104608, "missile_id": 6, "master_id": 556, "global_id": 555, "ranged": true, "spawn_sec": 186}, {"enemy_id": 7, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 120000, "attack": 5000, "base_hp": 120000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 800, "attack_speed": 120, "attack_wait": 10, "attack_interval": 221, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2127520, "race_id": 10, "master_id": 36422, "global_id": 10039, "spawn_sec": 188}], "popups": ["前線拠点は倒されると\n★の評価に影響します。", "発光するマスに配置した\nユニットは射程が\n上昇します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "白の皇帝", "text": "――古い砦だな。\n冥界にこんなものがあるとは、\n死者の国にも、穏やかでない時代があったのか。", "face": "u418"}, {"name": "ヘカティエ", "text": "ヘリューズが築いたものかもしれないわね。\nひとりぼっちの居場所を守ろうとしたのか、\nあるいは、他に何か目的があったのか……。", "face": "u1226a1"}, {"name": "パラベル", "text": "自分と同じ境遇の者がいたときに、\n守ってあげるため、とかですの？", "face": "u1922a1"}, {"name": "ハリンヘイム", "text": "…………反逆者に、\nそんな目的があったとは思えません。", "face": "u1854a1"}, {"name": "ジェニー", "text": "ハリンヘイムは、本音を隠すのが下手。", "face": "u1923a1"}, {"name": "ハリンヘイム", "text": "なっ……何を言うんですか！", "face": "u1854a1"}, {"name": "ティルト", "text": "宿敵の妹だからと毛嫌いする必要はない。\nいや、毛嫌いするフリ、か？", "face": "u1705a1"}, {"name": "ハイデマリー", "text": "ティルトも素直になるまで、\nすごーく時間がかかったけどね。", "face": "u1704a1"}, {"name": "ティルト", "text": "むっ……ハリンヘイムほどじゃ……。\nこほんっ。ともあれ、ここを野戦陣地としよう。\n正気を失った亜神と、陣地なしに戦うのは難しいだろう。", "face": "u1705a1"}, {"name": "カーナ", "text": "――報告！\n無数のアンデッドが砦に接近中！", "face": "u1107a1"}, {"name": "レオラ", "text": "規模は？　亜神らしき者はいるかしら？", "face": "u464"}, {"name": "カーナ", "text": "いえ、スケルトンサイクロプスの影は見えましたが、\nほかは雑兵ばかりです。", "face": "u1107a1"}, {"name": "白の皇帝", "text": "戦い慣れた相手といえど、ここは敵地だ。\n兵に油断するなと伝えろ。", "face": "u418"}, {"name": "レオナ", "text": "はっ。前線拠点の守備を厳となせ！\n広域戦闘となるぞ！", "face": "u311"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "――悲しみが聴こえます。\nただただ、悲哀が、嘆きの音だけが。", "face": "u1919a1"}, {"name": "？？？", "text": "私の可愛い子どもたち、\nどうか泣かないで、死とはただ怖ろしいものだけれど、\nせめてその瞬間を、少しでも遠ざけましょう。", "face": "u1919a1"}, {"name": "レオナ", "text": "……来たか、亜神ヘリューズ。\n陛下、どうなさいますか。", "face": "u311"}, {"name": "白の皇帝", "text": "亜神ヘリューズ、言葉は届いているか。", "face": "u418"}, {"name": "ヘリューズ", "text": "……死の音色。\nどれだけの命を、奪ってきたのでしょう。\nあなたの背後には怨嗟の声ばかりが響いています。", "face": "u1919a1"}, {"name": "イルヴィ", "text": "ヘリューズ様！　私だ！\nセグナンドが娘、イルヴィだ！", "face": "u1918a1"}, {"name": "ヘリューズ", "text": "私は、守らなければ。\n行き場もなく、ただ悲しみを抱いたあの子らを。\n死を抱くあの子らが、せめて安寧の内に逝けるように。", "face": "u1919a1"}, {"name": "白の皇帝", "text": "……どうやら、話は通じていないようだな。", "face": "u418"}, {"name": "ヘカティエ", "text": "戦いの中に身を置いたあの子は、\n死の亜神というより、半ば戦神に近い存在になるのよ。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "全ての者の、死の痛みが分かってしまうから、\nせめて楽に殺してあげようと、\nあまりに優しすぎて、そう考えてしまうのね。", "face": "u1226a1"}, {"name": "白の皇帝", "text": "……話をするには、戦いを止めさせねばならないか。", "face": "u418"}, {"name": "レオナ", "text": "骸帝と激突する前に、\nまさか亜神との決戦が待っているとは……。", "face": "u311"}, {"name": "レオナ", "text": "急ぎ補給を済ませろ！\n決戦まで、あまり時間はないぞ！", "face": "u311"}]}], "hard": {"level": 140, "multiplier": 1.4, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 11, "params": [300]}, {"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "hp": 25200, "attack": 1260, "damage_type": "physical", "armor_defense": 660, "pattern_id": 2146176}, {"enemy_id": 2, "hp": 1120, "attack": 250, "damage_type": "physical", "armor_defense": 50, "pattern_id": 2098656}, {"enemy_id": 3, "hp": 1400, "attack": 420, "damage_type": "physical", "armor_defense": 120, "pattern_id": 2098672}, {"enemy_id": 4, "hp": 4200, "attack": 840, "damage_type": "physical", "armor_defense": 220, "pattern_id": 2098688}, {"enemy_id": 5, "hp": 3920, "attack": 1050, "damage_type": "physical", "armor_defense": 280, "pattern_id": 2102064}, {"enemy_id": 6, "hp": 42000, "attack": 1000, "damage_type": "magical", "armor_defense": 400, "magic_defense": 30, "pattern_id": 2104608}, {"enemy_id": 7, "hp": 168000, "attack": 7000, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2127520}]}, "active": true}