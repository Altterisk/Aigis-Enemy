{"quest_id": 6853, "name": "捕らえられた妖狸", "description": "たぬきの里の長に導かれ、\n森の奥に進む一行の前に\n重水の四天王が現れる。\n極級（★１獲得の目安：平均Lv25）", "event": "あやかし狸と浴衣の拳士", "event_category": "History", "mission_id": 920132, "map_no": 5508, "level": 100, "multiplier": 1.0, "charisma": 65, "exp": 300, "gold": 1500, "drops": [{"card": 135, "c": 1}, {"card": 237, "c": 1}, {"card": 133, "c": 1}, {"item": 1002, "c": 1}, {"item": 5003, "c": 2}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 11000, "attack": 800, "base_hp": 11000, "base_attack": 800, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 387, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117104, "race_id": 4, "missile_id": 167, "master_id": 31468, "global_id": 5087, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 15000, "attack": 400, "base_hp": 15000, "base_attack": 400, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107216, "race_id": 4, "special_effect_id": 101, "missile_id": 168, "missile": {"speed": 2.0}, "master_id": 458, "global_id": 457, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 24, "form_index": 0, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 3}, {