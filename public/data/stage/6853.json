{"quest_id": 6853, "name": "捕らえられた妖狸", "description": "たぬきの里の長に導かれ、\n森の奥に進む一行の前に\n重水の四天王が現れる。\n極級（★１獲得の目安：平均Lv25）", "event": "あやかし狸と浴衣の拳士", "event_category": "History", "mission_id": 920132, "map_no": 5508, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "hp": 11000, "attack": 800, "base_hp": 11000, "base_attack": 800, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 387, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2117104, "race_id": 4, "missile_id": 167, "master_id": 31468, "global_id": 5087, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 400, "base_hp": 15000, "base_attack": 400, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107216, "race_id": 4, "special_effect_id": 101, "missile_id": 168, "missile": {"speed": 2.0}, "master_id": 458, "global_id": 457, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 24, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 14, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "change_to": 4, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31930, "global_id": 5549, "to_global_id": 5550, "spawn_sec": 26}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 4, "special_effect_id": 415, "change_to": 5, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31931, "global_id": 5550, "ranged": true, "to_global_id": 5551}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 10000, "attack": 450, "base_hp": 10000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 6, "master_id": 31932, "global_id": 5551, "to_global_id": 5552}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 10000, "attack": 120, "base_hp": 10000, "base_attack": 120, "damage_type": "magical", "armor_defense": 300, "magic_defense": 30, "attack_range": 200, "attack_speed": 70, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107216, "race_id": 4, "special_effect_id": 101, "missile_id": 168, "missile": {"speed": 2.0}, "master_id": 31933, "global_id": 5552, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 47}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 63}], "dialogue": [{"trigger": "start", "lines": [{"name": "重水の四天王", "text": "くっくっく……。\nあなた方妖狸が、\n忍者に匹敵する情報網を持つ事は知っています。", "face": "l6cef78df3f16"}, {"name": "重水の四天王", "text": "それが妖怪ともなれば、\n大嶽丸様の封印当時の情報も知っているはず。", "face": "l6cef78df3f16"}, {"name": "捕まった妖狸", "text": "たぬ……たぬぬぬ……。\n鬼なんかに教えないぽん……っ！！\nすぐに長さまが助けを呼んでくるぽん！！", "face": "lb11a98406858"}, {"name": "重水の四天王", "text": "口の堅いたぬきですねぇ……。\nならばこうしてやりましょう。\n情報をもたらさない妖狸に用はありませんからねぇ！", "face": "l6cef78df3f16"}, {"name": "マオ", "text": "――やめなさい！！\n重水の四天王……妖狸の里を襲ったのは、\nあなたの軍勢だったんですね！", "face": "u867"}, {"name": "たぬきの里の長", "text": "ま、マオさまカッコイイぽん……！！\nさぁボクさまの民よ、ちゃんと援軍を呼んできたぽんよ！", "face": "u1019a1"}, {"name": "捕まった妖狸", "text": "長さまぁー！\nきっと来てくれるって信じてたぽんー！", "face": "lb11a98406858"}, {"name": "重水の四天王", "text": "……くっくっく。\n逃げ出した妖狸を追ってみれば、\n王子という獲物が出てくるとは……。", "face": "l6cef78df3f16"}, {"name": "マオ", "text": "そんなもふもふの子を虐めるなんて許せません。\nぼっこぼこにした後で、\n何を企んでいるのか吐かせてやりますからね！", "face": "u867"}, {"name": "捕まった妖狸", "text": "た、たぬ……！\nなんてカッコイイ格闘家さんだぽん！", "face": "lb11a98406858"}, {"name": "重水の四天王", "text": "――おだまりなさい。\nそれ以上無駄口を叩くと、たぬき鍋にしてやりますよ？", "face": "l6cef78df3f16"}, {"name": "捕まった妖狸", "text": "たぬぅぅぅぅっ！？\nやめてぽん！　たぬき鍋は嫌だぽんー！", "face": "lb11a98406858"}, {"name": "重水の四天王", "text": "それなら我らに協力なさい。\n王子の首級をあげれば、\n無事に解放すると約束してあげましょう。", "face": "l6cef78df3f16"}, {"name": "捕まった妖狸", "text": "たぬぅぅぅっ！？\nたぬ……うぅぅ。\n王子さん、長さまぁっ、ごめんなさいぽん……！", "face": "lb11a98406858"}, {"name": "マオ", "text": "なんて卑怯な……！！\n王子、重水の四天王を許すわけにはいきません。\nぼっこぼこにしてやりましょう……！", "face": "u867"}]}, {"trigger": "end", "lines": [{"name": "重水の四天王", "text": "くっ……！？\nたかが人間如きが、この短期間で\nこれ程までに力を増しているというのですか！？", "face": "l6cef78df3f16"}, {"name": "重水の四天王", "text": "これは刀の捜索を急がねばなりませんね……。\n勝負は預けておきますよ！", "face": "l6cef78df3f16"}, {"name": "アンナ", "text": "……重水の四天王、撤退していきます。"}, {"name": "捕まっていた妖狸", "text": "長さまー！　王国の皆さまー！！\n助けていただいてありがとうですぽんー！！", "face": "lb11a98406858"}, {"name": "たぬきの里の長", "text": "おー、よしよし！　無事でよかったぽん！\n他の皆はどうしているぽん？", "face": "u1019a1"}, {"name": "捕まっていた妖狸", "text": "たぬぬ……。\n里はまだ占領されたままだぽん……。\n鬼達が、刀の隠し場所を吐けーって怖かったぽん……。", "face": "lb11a98406858"}, {"name": "マオ", "text": "刀の隠し場所……。\nいったい何のことなんでしょうか……？", "face": "u867"}, {"name": "ホムラ", "text": "……もしかして、\n大嶽丸がかつて振るっていた、\n残る二本の刀を探してるってことか……？", "face": "u739"}, {"name": "マオ", "text": "大嶽丸の三振りの宝剣、ってやつですか？\n可能性は高そうですね……。", "face": "u867"}, {"name": "マオ", "text": "ともかく、一度王国へ戻りませんか？\n妖狸さんたちの手当もしないといけませんし。", "face": "u867"}, {"name": "アンナ", "text": "そうですね……。\n妖狸さん達の詳しい話も、\n王国で聞くことにしましょうか。"}]}], "active": true}