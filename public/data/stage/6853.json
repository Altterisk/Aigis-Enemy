peed": 500.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107216, "race_id": 4, "special_effect_id": 101, "missile_id": 168, "missile": {"speed": 2.0}, "master_id": 31933, "global_id": 5552, "ranged": true, "from_condition": 0}, {"enemy_id": 8, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 47}, {"enemy_id": 9, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 63}], "dialogue": [{"trigger": "start", "lines": [{"name": "重水の四天王", "text": "くっくっく……。\nあなた方妖狸が、\n忍者に匹敵する情報網を持つ事は知っています。", "face": "l6cef78df3f16"}, {"name": "重水の四天王", "text": "それが妖怪ともなれば、\n大嶽丸様の封印当時の情報も知っているはず。", "face": "l6cef78df3f16"}, {"name": "捕まった妖狸", "text": "たぬ……たぬぬぬ……。\n鬼なんかに教えないぽん……っ！！\nすぐに長さまが助けを呼んでくるぽん！！", "face": "lb11a98406858"}, {"name": "重水の四天王", "text": "口の堅いたぬきですねぇ……。\nならばこうしてやりましょう。\n情報をもたらさない妖狸に用はありませんからねぇ！", "face": "l6cef78df3f16"}, {"name": "マオ", "text": "――やめなさい！！\n重水の四天王……妖狸の里を襲ったのは、\nあなたの軍勢だったんですね！", "face": "u867"}, {"name": "たぬきの里の長", "text": "ま、マオさまカッコイイぽん……！！\nさぁボクさまの民よ、ちゃんと援軍を呼んできたぽんよ！", "face": "u1019a1"}, {"name": "捕まった妖狸", "text": "長さまぁー！\nきっと来てくれるって信じてたぽんー！", "face": "lb11a98406858"}, {"name": "重水の四天王", "text": "……くっくっく。\n逃げ出した妖狸を追ってみれば、\n王子という獲物が出てくるとは……。", "face": "l6cef78df3f16"}, {"name": "マオ", "text": "そんなもふもふの子を虐めるなんて許せません。\nぼっこぼこにした後で、\n何を企んでいるのか吐かせてやりますからね！", "face": "u867"}, {"name": "捕まった妖狸", "text": "た、たぬ……！\nなんてカッコイイ格闘家さんだぽん！", "face": "lb11a98406858"}, {"name": "重水の四天王", "text": "――おだまりなさい。\nそれ以上無駄口を叩くと、たぬき鍋にしてやりますよ？", "face": "l6cef78df3f16"}, {"name": "捕まった妖狸", "text": "たぬぅぅぅぅっ！？\nやめてぽん！　たぬき鍋は嫌だぽんー！", "face": "lb11a98406858"}, {"name": "重水の四天王", "text": "それなら我らに協力なさい。\n王子の首級をあげれば、\n無事に解放すると約束してあげましょう。", "face": "l6cef78df3f16"}, {"name": "捕まった妖狸", "text": "たぬぅぅぅっ！？\nたぬ……うぅぅ。\n王子さん、長さまぁっ、ごめんなさいぽん……！", "face": "lb11a98406858"}, {"name": "マオ", "text": "なんて卑怯な……！！\n王子、重水の四天王を許すわけにはいきません。\nぼっこぼこにしてやりましょう……！", "face": "u867"}]}, {"trigger": "end", "lines": [{"name": "重水の四天王", "text": "くっ……！？\nたかが人間如きが、この短期間で\nこれ程までに力を増しているというのですか！？", "face": "l6cef78df3f16"}, {"name": "重水の四天王", "text": "これは刀の捜索を急がねばなりませんね……。\n勝負は預けておきますよ！", "face": "l6cef78df3f16"}, {"name": "アンナ", "text": "……重水の四天王、撤退していきます。"}, {"name": "捕まっていた妖狸", "text": "長さまー！　王国の皆さまー！！\n助けていただいてありがとうですぽんー！！", "face": "lb11a98406858"}, {"name": "たぬきの里の長", "text": "おー、よしよし！　無事でよかったぽん！\n他の皆はどうしているぽん？", "face": "u1019a1"}, {"name": "捕まっていた妖狸", "text": "たぬぬ……。\n里はまだ占領されたままだぽん……。\n鬼達が、刀の隠し場所を吐けーって怖かったぽん……。", "face": "lb11a98406858"}, {"name": "マオ", "text": "刀の隠し場所……。\nいったい何のことなんでしょうか……？", "face": "u867"}, {"name": "ホムラ", "text": "……もしかして、\n大嶽丸がかつて振るっていた、\n残る二本の刀を探してるってことか……？", "face": "u739"}, {"name": "マオ", "text": "大嶽丸の三振りの宝剣、ってやつですか？\n可能性は高そうですね……。", "face": "u867"}, {"name": "マオ", "text": "ともかく、一度王国へ戻りませんか？\n妖狸さんたちの手当もしないといけませんし。", "face": "u867"}, {"name": "アンナ", "text": "そうですね……。\n妖狸さん達の詳しい話も、\n王国で聞くことにしましょうか。"}]}], "map": {"image": "Map920132_5508", "w": 960, "h": 640, "spots": [{"k": "b", "x": 604, "y": 367}, {"k": "m", "x": 124, "y": 411, "id": 200}, {"k": "m", "x": 666, "y": 464, "id": 201}, {"k": "m", "x": 759, "y": 464, "id": 202}, {"k": "m", "x": 527, "y": 463, "id": 203}, {"k": "m", "x": 424, "y": 463, "id": 204}, {"k": "m", "x": 325, "y": 440, "id": 205}, {"k": "m", "x": 171, "y": 165, "id": 206}, {"k": "m", "x": 233, "y": 384, "id": 207}, {"k": "m", "x": 248, "y": 289, "id": 208}, {"k": "m", "x": 275, "y": 194, "id": 209}, {"k": "m", "x": 308, "y": 110, "id": 210}, {"k": "m", "x": 867, "y": 196, "id": 211}, {"k": "m", "x": 628, "y": 68, "id": 212}, {"k": "m", "x": 849, "y": 465, "id": 213}, {"k": "r", "x": 784, "y": 395, "id": 300}, {"k": "r", "x": 519, "y": 392, "id": 301}, {"k": "r", "x": 164, "y": 300, "id": 302}, {"k": "r", "x": 183, "y": 239, "id": 303}, {"k": "r", "x": 356, "y": 233, "id": 304}, {"k": "r", "x": 453, "y": 391, "id": 305}, {"k": "r", "x": 385, "y": 384, "id": 306}, {"k": "r", "x": 184, "y": 103, "id": 307}, {"k": "r", "x": 617, "y": 140, "id": 308}, {"k": "r", "x": 784, "y": 227, "id": 309}, {"k": "r", "x": 239, "y": 465, "id": 310}, {"k": "r", "x": 897, "y": 286, "id": 311}]}, "start_cost": 10, "active": true}