": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100576, "master_id": 269, "global_id": 268, "spawn_sec": 18}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "tags": ["アーマー"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097680, "special_effect_id": 251, "master_id": 392, "global_id": 391, "spawn_sec": 33}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 5500, "attack": 10, "base_hp": 5500, "base_attack": 10, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_speed": 30, "attack_interval": 61, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098352, "special_effect_id": 220, "master_id": 23, "global_id": 22, "spawn_sec": 48}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "大分深い階層まで来ましたね……。", "face": "l32e5f45d1a28"}, {"name": "リアナ", "text": "ええ、魔物の強さも増しているようです。\nもう少しで最深部みたいですよ。", "face": "u219"}, {"name": "アンナ", "text": "しっ……静かに……！\n魔物たちの姿を確認しました。\n王子、戦闘開始の合図をお願いします。", "face": "l32e5f45d1a28"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "あの魔物は！？", "face": "l32e5f45d1a28"}, {"name": "リアナ", "text": "あれは……キマイラ……！\n王子様、気をつけてください！", "face": "u219"}, {"name": "リアナ", "text": "キマイラは数多の魔物を\n魔法の力で合成させた\n強大な戦闘能力を持つ魔物です！", "face": "u219"}, {"name": "リアナ", "text": "魔法の力によって作られた身体は\n強靭で高い攻撃力を誇り、\n魔法攻撃を半減すると聞きます。", "face": "u219"}, {"name": "リアナ", "text": "今は動き出す様子はありませんが、\n自身の攻撃範囲に入った者には容赦なく\n強力な遠距離攻撃を放ってくるはずです。", "face": "u219"}, {"name": "リアナ", "text": "王子様、今回の戦いはキマイラへの\n対処方法がカギとなります。\n攻撃を仕掛ける際は細心の注意を……！", "face": "u219"}]}], "active": true}