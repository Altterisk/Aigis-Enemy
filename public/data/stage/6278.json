{"quest_id": 6278, "name": "ピラミッドへの道", "description": "王子達の前に立ちはだかる魔物の群れ。\n敵を制し、ピラミッドへの道を切り開け！\n＜出撃時の初期ＨＰ減少：中＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["出撃時の初期ＨＰ減少：中"], "event": "大怪盗とピラミッドの秘宝", "event_category": "History", "mission_id": 920098, "map_no": 5253, "level": 100, "multiplier": 1.0, "charisma": 90, "exp": 360, "gold": 1400, "drops": [{"item": 5003, "c": 2}, {"item": 5002, "c": 1}, {"card": 12, "c": 1}, {"card": 58, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [50], "expression": "!IsPlayerSupportUnit();"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 260, "base_hp": 12000, "base_attack": 260, "damage_type": "physical", "armor_defense": 210, "magic_defense": 30, "attack_range": 100, "attack_speed": 70, "attack_wait": 30, "attack_interval": 93, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112048, "race_id": 12, "special_effect_id": 193, "missile_id": 45, "master_id": 30641, "global_id": 4260, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 34, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 6000, "attack": 450, "base_hp": 6000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 195, "master_id": 30643, "global_id": 4262, "spawn_sec": 50}, {"enemy_id": 4, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 161, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098304, "special_effect_id": 227, "master_id": 90, "global_id": 89, "spawn_sec": 89}, {"enemy_id": 5, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 18000, "attack": 390, "base_hp": 18000, "base_attack": 390, "damage_type": "physical", "armor_defense": 210, "magic_defense": 30, "attack_range": 100, "attack_speed": 70, "attack_wait": 30, "attack_interval": 93, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112048, "race_id": 12, "special_effect_id": 194, "missile_id": 45, "master_id": 30642, "global_id": 4261, "ranged": true, "spawn_sec": 117}], "dialogue": [{"trigger": "start", "lines": [{"name": "サバル", "text": "――ピラミッドへの入り口はこっちだ！　\n急いで……っ！！", "face": "u536"}, {"name": "アンナ", "text": "こんな所にも大量の魔物が……。", "face": "lbfab4fba6540"}, {"name": "サバル", "text": "さっきまではいなかったのに……\n……そうか、欠片の気配を追って来たのか。", "face": "u536"}, {"name": "ケイティ", "text": "欠片の気配がある以上、\n魔物には勘付かれてしまいますか。", "face": "u114"}, {"name": "サバル", "text": "いや、敵が欠片を狙っているのなら……。", "face": "u536"}, {"name": "アンナ", "text": "サバルさん、欠片を持ってどこへ……！", "face": "lbfab4fba6540"}, {"name": "サバル", "text": "私がおとりになって奴らを引き付ける。\n皆は残った敵を頼む。", "face": "u536"}, {"name": "ケイティ", "text": "しかし、それではサバルさんが危険です！", "face": "u114"}, {"name": "サバル", "text": "あの程度の魔物に捕まってちゃ、\n大怪盗の名折れだよ……それじゃ、\n入口の敵は任せたよ！", "face": "u536"}, {"name": "ケイティ", "text": "行ってしまいました……ですが、魔物の大半は\nサバルさんを追って行ったようですね。", "face": "u114"}, {"name": "アンナ", "text": "はい。サバルさんが作ってくれたこの好機、\n無駄に出来ません。\n王子、ピラミッドへの道を確保致しましょう！", "face": "lbfab4fba6540"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "ひとまず入口は確保できました。\nあとは、サバルさんが戻ってくるのを待つだけです。", "face": "u114"}, {"name": "アンナ", "text": "サバルさん、どうかご無事で……。", "face": "lbfab4fba6540"}, {"name": "サバル", "text": "――……全く、心配しすぎだよ。", "face": "u536"}, {"name": "アンナ", "text": "サバルさん！"}, {"name": "ケイティ", "text": "良かった……ご無事だったのですね。\nあれだけの量の魔物、\n逃げ切るには大変だったでしょう。", "face": "u114"}, {"name": "サバル", "text": "あんなノロマな連中に、\nこの私が捕まる訳ないだろう。", "face": "u536"}, {"name": "アンナ", "text": "それはそうかもしれませんが……ですが、\n今後あのような無茶はしないと約束してください。\n王子も心配していましたよ。ね、王子？"}, {"name": "王子", "text": "……（こくり）。", "face": "u1"}, {"name": "サバル", "text": "だから心配なんていらないと……ってこら、\n頭を撫でるな！　み、耳をさわ……ふみゃ。", "face": "u536"}, {"name": "アンナ", "text": "……ふみゃ？", "face": "lbfab4fba6540"}, {"name": "サバル", "text": "……こ、コホン。なんでもない。\n兎に角、私の心配なんて必要ないよ。", "face": "u536"}, {"name": "アンナ", "text": "そうですか……ですが、\n無事に戻って来て頂けて本当に何よりです。\nこれでピラミッドへの道が開けましたね。"}, {"name": "ケイティ", "text": "果たして中で何が起こっているのか。\n……慎重に進まねばなりませんね。", "face": "u114"}, {"name": "サバル", "text": "さっきの魔物達はずっと遠くに撒いてきた。\n当分は戻ってこれない筈だ、\n今なら少しくらい休んでも大丈夫だと思うよ。", "face": "u536"}, {"name": "アンナ", "text": "ありがとうございます、サバルさん。\n王子、少し休憩してからピラミッドへと\n突入致しましょうか。お疲れ様でした。"}]}], "map": {"image": "Map920098_5253", "w": 960, "h": 640, "spots": [{"k": "b", "x": 29, "y": 366}, {"k": "m", "x": 105, "y": 330, "id": 200}, {"k": "m", "x": 193, "y": 281, "id": 201}, {"k": "m", "x": 273, "y": 219, "id": 202}, {"k": "m", "x": 387, "y": 192, "id": 203}, {"k": "m", "x": 330, "y": 140, "id": 204}, {"k": "m", "x": 472, "y": 187, "id": 205}, {"k": "m", "x": 608, "y": 264, "id": 206}, {"k": "m", "x": 552, "y": 217, "id": 207}, {"k": "m", "x": 107, "y": 400, "id": 208}, {"k": "m", "x": 198, "y": 407, "id": 209}, {"k": "m", "x": 284, "y": 426, "id": 210}, {"k": "m", "x": 375, "y": 449, "id": 211}, {"k": "m", "x": 566, "y": 458, "id": 212}, {"