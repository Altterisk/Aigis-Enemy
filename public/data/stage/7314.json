e": 20, "attack_speed": 40, "attack_wait": 30, "attack_interval": 129, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098880, "race_id": 9, "master_id": 121, "global_id": 120, "spawn_sec": 118}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117344, "race_id": 9, "special_effect_id": 349, "missile_id": 6, "master_id": 31516, "global_id": 5135, "ranged": true, "spawn_sec": 128}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 600, "attack_speed": 45, "attack_wait": 10, "attack_interval": 113, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122096, "race_id": 9, "master_id": 32439, "global_id": 6058, "spawn_sec": 156}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "magic_defense": 30, "attack_range": 400, "attack_speed": 30, "attack_wait": 120, "attack_interval": 283, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117328, "race_id": 9, "special_effect_id": 349, "missile_id": 6, "master_id": 31515, "global_id": 5134, "ranged": true, "spawn_sec": 156}], "popups": ["ゴブリン騎獣楽団がいる間は\n敵のゴブリンの攻撃と防御が\nアップします。", "アイドル衣装を着た\nゴブリンプリンセス三姉妹がいる間は\n敵のゴブリンの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンプリンセス長女", "text": "……お母様が、まさか人間と結婚するなんてね。", "face": "l06555bfb2238"}, {"name": "ゴブリンプリンセス次女", "text": "ゴブリン族の誇りを失ってしまったのかしら。\nまったく、お母さまったら何を考えているのか……！", "face": "l82d934a5e29e"}, {"name": "ゴブリンプリンセス三女", "text": "……たぶん、私たちのことを\n考えているのではないでしょうか。", "face": "l2bb2c2f1a909"}, {"name": "ゴブリンプリンセス次女", "text": "どういうこと？\n三女、説明しなさい。", "face": "l82d934a5e29e"}, {"name": "ゴブリンプリンセス三女", "text": "魔王決戦の時にも、お母さまは私たち姉妹を\n僻地の防衛に派遣しましたよね？", "face": "l2bb2c2f1a909"}, {"name": "ゴブリンプリンセス三女", "text": "きっと、命がかかった危険な戦いになると、\n知っていたからこそ私たちを遠ざけたんです。", "face": "l2bb2c2f1a909"}, {"name": "ゴブリンプリンセス長女", "text": "……それは、私だって気付いていたわ。\nでも、それと結婚に何の関係があるのかしら？", "face": "l06555bfb2238"}, {"name": "ゴブリンプリンセス三女", "text": "お母さまは、ゴブリン族を、\nそして私たちを守るために、\n王国に自分を売り渡すつもりなのでは……？", "face": "l2bb2c2f1a909"}, {"name": "ゴブリンプリンセス次女", "text": "はっ……そんな……！\nあの世界一美しいお母さまが、\n人間の男ごときの手に堕ちるなんて……！", "face": "l82d934a5e29e"}, {"name": "ゴブリンプリンセス長女", "text": "……いいえ、麗しの美女たるお母様だからこそ、なのね。\nあの美貌をもって、王子を籠絡し、\nゴブリン族と王国の結びつきを強めるつもりなのよ。", "face": "l06555bfb2238"}, {"name": "ゴブリンプリンセス三女", "text": "……ふふ、お母さまがそこまでの覚悟をしているなら、\n最高の結婚式にしないといけないですよね。", "face": "l2bb2c2f1a909"}, {"name": "ゴブリンプリンセス長女", "text": "えぇ！　さぁ、祝福のコーラスの練習を続けるわよ！", "face": "l06555bfb2238"}]}, {"trigger": "start", "lines": [{"name": "シルセス", "text": "――にぎやかな音楽が聴こえると思ったら、\nどうやらゴブリンプリンセスたちが\nコーラスの練習をしていたようですね。", "face": "u451"}, {"name": "メリュジアナ", "text": "……だがどうする、手紙にあった式場の場所は、\nこの街道を抜けないとたどり着けないぞ？", "face": "u1218a1"}, {"name": "ナナリー", "text": "……突破、しましょう。\n時間がありませんから。", "face": "u1217a1"}, {"name": "シルセス", "text": "えぇ、事態は一刻を争います。\nなし崩しに結婚式を進められたら大変です！", "face": "u451"}, {"name": "アンナ", "text": "王子、この戦いには王国の未来がかかっています。\n急いで街道を突破しましょう！", "face": "lde8d62bd622a"}]}, {"trigger": "end", "lines": [{"name": "ゴブリンプリンセス長女", "text": "けほっ、けほっ……。\nまったく、あんなに急いで駆け抜けていくなんて……。", "face": "l06555bfb2238"}, {"name": "ゴブリンプリンセス三女", "text": "ふふ、よっぽどお母さまとの\n結婚式が楽しみなんですね。", "face": "l2bb2c2f1a909"}, {"name": "ゴブリンプリンセス次女", "text": "……それにしては、ドレス姿の子たちから、\n激しい殺意を感じたような気もするけれど。", "face": "l82d934a5e29e"}, {"name": "ゴブリン博士", "text": "はぁ……どうしたラ……どうしたラいいのダ……。", "face": "l7590e38ca391"}, {"name": "ゴブリンプリンセス長女", "text": "あら、ゴブリン博士じゃないの。\nいったいどうしたの？", "face": "l06555bfb2238"}, {"name": "ゴブリン博士", "text": "おぉ、王女さま方……。\nいえ、大したことではありませヌ……。", "face": "l7590e38ca391"}, {"name": "ゴブリン博士", "text": "……ただ、メカゴブリンクイーン様が\nあの王子と結婚など、うぅ……ぐすっ……うおぉぉんっ！", "face": "l7590e38ca391"}, {"name": "ゴブリンプリンセス三女", "text": "……ゴブリン博士。", "face": "l2bb2c2f1a909"}, {"name": "ゴブリンプリンセス次女", "text": "あなた、もしかして、お母さまのことを……。", "face": "l82d934a5e29e"}, {"name": "ゴブリンプリンセス長女", "text": "…………。\n……行きなさい、ゴブリン博士。", "face": "l06555bfb2238"}, {"name": "ゴブリン博士", "text": "……は……い、行くトハ、ドコへ……？", "face": "l7590e38ca391"}, {"name": "ゴブリンプリンセス長女", "text": "決まっていますわ。\n――式場に乗り込むんですのよ！！", "face": "l06555bfb2238"}, {"name": "ゴブリンプリンセス長女", "text": "あなたがお母様を愛しているのなら！\n今が最後の、たった一度のチャンスですのよ！？", "face": "l06555bfb2238"}, {"name": "ゴブリン博士", "text": "おぉ……おぉ……！！\nしかし、ワタクシごときが結婚に異議を唱えるナド……。", "face": "l7590e38ca391"}, {"name": "ゴブリンプリンセス三女", "text": "ふふ、ゴブリン博士。\n長い人間との関わりで、何を学んだのですか？", "face": "l2bb2c2f1a909"}, {"name": "ゴブリンプリンセス三女", "text": "――愛に勝るものはない。\n人間たちが、いつもそう言っているじゃないですか。", "face": "l2bb2c2f1a909"}, {"name": "ゴブリン博士", "text": "……愛……そうか、これが、愛ナノカ。\n王女さま方、この恩は必ず返しますユエ。\n今は……今は式場に参りマス……ッ！！", "face": "l7590e38ca391"}, {"name": "ゴブリンプリンセス長女", "text": "……走りなさい、そして、愛を伝えなさい。\nあんな男の涙を見せられてしまったら、\n応援するしかないものね……！", "face": "l06555bfb2238"}]}], "story_talk": true, "active": true}