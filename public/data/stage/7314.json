{"quest_id": 7314, "name": "ゴブリンプリンセスのトリオ", "description": "招待状に書かれた衝撃の内容を阻止すべく\n一行は式場へと急ぐ。ゴブリンプリンセス\n三姉妹が立ちはだかる街道を突破せよ！\n極級（★１獲得の目安：平均Lv25）", "event": "クイーンズ・ウェディング", "event_category": "History", "mission_id": 920160, "map_no": 5940, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 1, "base_hp": 1, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 50, "attack_wait": 30, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128544, "change_to": 1, "change_condition": 2, "master_id": 33692, "global_id": 7309, "to_condition": 2, "to_global_id": 7310, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 400, "base_hp": 12000, "base_attack": 400, "damage_type": "physical", "armor_defense": 370, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "attack_interval": 58, "move_speed": 4500.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128560, "master_id": 33693, "global_id": 7310, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 2, "hp": 1, "base_hp": 1, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 50, "attack_wait": 30, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128544, "change_to": 3, "change_condition": 2, "master_id": 33690, "global_id": 7307, "to_condition": 2, "to_global_id": 7308, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 370, "magic_defense": 10, "attack_speed": 1, "att