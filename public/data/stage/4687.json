{"quest_id": 4687, "name": "エルフの里の襲撃", "description": "エルフの里を襲うダークエルフたち\nを撃退せよ！\n＜味方ユニットの攻撃力減少：中＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["味方ユニットの攻撃力減少：中"], "event": "帝国の治癒士", "event_category": "History", "mission_id": 920074, "map_no": 3842, "level": 100, "multiplier": 1.0, "charisma": 40, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [50]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 13, "form_count": 1, "hp": 1200, "attack": 220, "base_hp": 1200, "base_attack": 220, "damage_type": "physical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 15, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098976, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 133, "global_id": 132, "ranged": true, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 10, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 10}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 15, "attack_interval": 251, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098992, "missile_id": 6, "master_id": 134, "global_id": 133, "ranged": true, "spawn_sec": 68}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 95}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 154, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099008, "special_effect_id": 38, "master_id": 135, "global_id": 134, "spawn_sec": 145}, {"enemy_id": 6, "source": "local", "count": 1, "level": 90, "form_count": 2, "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 30, "attack_wait": 40, "attack_interval": 157, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099024, "race_id": 13, "special_effect_id": 220, "change_to": 6, "change_condition": 3, "master_id": 141, "global_id": 140, "to_condition": 3, "to_global_id": 141, "spawn_sec": 149}, {"enemy_id": 6, "source": "local", "count": 1, "level": 90, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099040, "race_id": 13, "master_id": 142, "global_id": 141, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "ローレン", "text": "疫病感染者の治療はどうなっている？", "face": "u118"}, {"name": "ロザリー", "text": "……一応、対処はしているけど、\n効果はほとんどないわ……。\nあなたもあまり調子が良くなさそうね……。", "face": "u117"}, {"name": "ダークエルフ", "text": "フフフ……人間の地で生まれた病に\nエルフ族が倒れるとは実に滑稽だな。", "face": "l147e8eb2f0fd"}, {"name": "ロザリー", "text": "――ダークエルフ！？\nこんな時に里を襲ってくるなんて……！", "face": "u117"}, {"name": "ダークエルフ", "text": "人間と手を取り合おうなどとするから\nこのような事態を招くのだ。\n自分達の愚かさを悔いるのだな！", "face": "l147e8eb2f0fd"}, {"name": "ローレン", "text": "くそっ……。\nこの状況下では、ダークエルフの勢力に\n対抗できるほどの戦力を確保できないぞ……。", "face": "u118"}, {"name": "アトラ", "text": "――ローレン！　ロザリー！\nもう大丈夫だ、王子たちが来てくれたぞ！", "face": "u119"}, {"name": "ロザリー", "text": "王子……！？\nよかった……本当に、助けに来てくれたのね！", "face": "u117"}, {"name": "ダークエルフ", "text": "（人間か……見たところやつらも病に\n感染しているようだな）", "face": "l147e8eb2f0fd"}, {"name": "ダークエルフ", "text": "（フフフ、我らは『アイツ』から抗体を\nもらっている為、体調は万全……。\n勝機は我らにあるのは明白だ！）", "face": "l147e8eb2f0fd"}]}, {"trigger": "end", "lines": [{"name": "ダークエルフ", "text": "――クッ……そんな、まさか……！！\nやつらは確かに弱っていたはず、なのに……。\n……撤退するしかない。", "face": "l147e8eb2f0fd"}, {"name": "ロザリー", "text": "やったぁ！\nダークエルフ達を退けることができたわ！\n王子、助けてくれてありがとう！", "face": "u117"}, {"name": "ローレン", "text": "今回ばかりは本当に助かったよ。\n……だが、この疫病に対抗する手段がわからない。\nいったいどうしたらいいんだ……。", "face": "u118"}, {"name": "？？？", "text": "――その件に関しては、\n我ら帝国軍にお任せ下さい。", "face": "u373"}, {"name": "ロザリー", "text": "だ、誰……！？", "face": "u117"}, {"name": "エリアス", "text": "身構える必要はありません。\n私は白の帝国の治癒士エリアスといいます。", "face": "u373"}, {"name": "エリアス", "text": "今、各地に蔓延している疫病ですが、\n我が白の帝国には対抗策があります。", "face": "u373"}, {"name": "ローレン", "text": "そ、それは本当なのか？", "face": "u118"}, {"name": "エリアス", "text": "はい。私の言葉に偽りはありません。\n治療の方法はお教え致します。\n疫病に関する情報も全て共有しましょう。", "face": "u373"}, {"name": "エリアス", "text": "ですがその代わり、王子には\n私たち白の帝国の要求を受け入れてもらいます。\nよろしいですか……？", "face": "u373"}, {"name": "ユリアン", "text": "タダで治療薬を届けに来ただけって訳じゃ\nなかったみたいだな……どうする、王子？", "face": "u7"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "アンナ", "text": "分かりました、王子。\nそれでは場所を移し、\nエリアスさんの話を聞きましょう。", "face": "lab3e5c39447d"}]}], "active": true}