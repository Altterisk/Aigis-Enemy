{"quest_id": 7247, "name": "男たちのバレンタイン", "description": "戦場の男たちにバレンタインは関係ない。\r\n来るべき日に備えて模擬戦だ！\n＜王子と女性ユニットのみ出撃可＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["王子と女性ユニットのみ出撃可"], "event": "魅惑のチョコレート・トラップ", "event_category": "History", "mission_id": 920156, "map_no": 5869, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "expression": "IsPrince() || ((IsGender(0) == 0) && (IsToken()) || IsGender(1) || IsPlayerSupportUnit();", "expression_human": "it is the Prince or ((it is not male) and (it is a token) or it is female or it is a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 20018, "global_id": 1093, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 1200, "attack": 350, "base_hp": 1200, "base_attack": 350, "damage_type": "magical", "armor_defense": 20, "attack_range": 150, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 20019, "global_id": 1094, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id":