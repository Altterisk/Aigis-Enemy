3}, {"enemy_id": 8, "source": "local", "count": 4, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 160, "attack_speed": 60, "attack_wait": 10, "attack_interval": 57, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098800, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 122, "global_id": 121, "ranged": true, "spawn_sec": 48}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 1, "hp": 3200, "attack": 220, "base_hp": 3200, "base_attack": 220, "damage_type": "physical", "armor_defense": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 162, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 1, "spawn_sec": 56}, {"enemy_id": 10, "source": "local", "count": 4, "form_count": 1, "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 80, "attack_range": 250, "attack_speed": 90, "attack_wait": 100, "attack_interval": 251, "move_speed": 200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101104, "race_id": 16, "missile_id": 26, "master_id": 317, "global_id": 316, "ranged": true, "spawn_sec": 87}, {"enemy_id": 11, "source": "local", "count": 10, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 700, "attack": 120, "base_hp": 700, "base_attack": 120, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 126, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121600, "race_id": 16, "master_id": 32453, "global_id": 6072, "spawn_sec": 94}, {"enemy_id": 12, "source": "local", "count": 10, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 115}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー", "帝国"], "hp": 3500, "attack": 250, "base_hp": 3500, "base_attack": 250, "damage_type": "physical", "armor_defense": 250, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 321, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113104, "race_id": 16, "change_to": 13, "change_condition": 1, "missile_id": 244, "missile": {"speed": 4.0, "splash": 53}, "master_id": 30775, "global_id": 4394, "ranged": true, "variants": [{"tags": ["アーマー", "帝国"], "hp": 3500, "attack": 250, "base_hp": 3500, "base_attack": 250, "damage_type": "physical", "armor_defense": 250, "attack_speed": 60, "attack_wait": 60, "attack_interval": 206, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2113120, "race_id": 16, "master_id": 30776, "global_id": 4395}], "spawn_sec": 125}], "dialogue": [{"trigger": "start", "lines": [{"name": "冒険者", "text": "――この世界はモテる者と、\nモテない者に分けられる。", "face": "l9cc21c613d4f"}, {"name": "義勇兵", "text": "おぉ……確かに……。", "face": "l9dfdf11bf209"}, {"name": "冒険者", "text": "物質界連合軍の一員として、\n俺たちが模擬戦に出ている間にも――", "face": "l9cc21c613d4f"}, {"name": "冒険者", "text": "――街では、モテている奴がいるッ！！", "face": "l9cc21c613d4f"}, {"name": "海賊", "text": "くっ……なぜだ……。\n世界のために戦う俺たちよりモテるなんて！", "face": "lac8578c76b77"}, {"name": "冒険者", "text": "それはな、俺たちがずっと戦場にいるからだ！！", "face": "l9cc21c613d4f"}, {"name": "帝国兵", "text": "なっ……！？　確かに……！！", "face": "u287"}, {"name": "冒険者", "text": "でもな、俺は思うんだ。\n俺たちが王国と協力して戦っているから、\n街の連中が平和に恋愛できるんだってな。", "face": "l9cc21c613d4f"}, {"name": "冒険者", "text": "そう、俺たちはいわば愛の守護者。\n人知れず恋人たちを守る騎士様なのさ……。", "face": "l9cc21c613d4f"}, {"name": "帝国兵", "text": "そう、か……そうだな……。\n俺たちは恋人たちの愛を守っていたのか！", "face": "u287"}, {"name": "冒険者", "text": "そういうわけだ。\nだから今日の模擬戦も、チョコなんて忘れて――", "face": "l9cc21c613d4f"}, {"name": "ルヴェア", "text": "――ふふ、みなさん準備万端みたいですね。", "face": "u1149a1"}, {"name": "エレット", "text": "ごめんね、チョコの準備してたら遅くなっちゃった。\n模擬戦が終わったら、皆でチョコパーティだよ♪", "face": "u1152a1"}, {"name": "冒険者", "text": "……えっ？　チョコパーティ？", "face": "l9cc21c613d4f"}, {"name": "ソフィー", "text": "王国主催で、街の皆さんにチョコを振る舞うのです。\nもちろん、みなさんも来てくれますよね？", "face": "u746"}, {"name": "冒険者", "text": "……ぉ……ぉぉおおおおッ！！\n聞いたかお前ら！\nチョコだ！　俺たちもチョコがもらえるぞ！！", "face": "l9cc21c613d4f"}, {"name": "帝国兵", "text": "俄然やる気が出てきたぞ！\nこの模擬戦、我々が勝利するッ！！", "face": "u287"}, {"name": "義勇兵", "text": "うおおおお！　バレンタイン！！\nうおおおお！　チョコレート！！", "face": "l9dfdf11bf209"}, {"name": "アリス", "text": "……いつもより元気がいいですね？\n何か良いことでもあったんでしょうか。", "face": "u589"}, {"name": "ルヴェア", "text": "元気がいいのは良いことですよ。\nそれでは模擬戦――開始です！", "face": "u1149a1"}]}, {"trigger": "end", "lines": [{"name": "ルヴェア", "text": "充実した模擬戦でしたね！", "face": "u1149a1"}, {"name": "エレット", "text": "うんうん、皆もやる気いっぱいだったし！", "face": "u1152a1"}, {"name": "アリス", "text": "物質界連合軍の皆さんも、\nなんだか友情が深まったような顔してますよ？", "face": "u589"}, {"name": "冒険者", "text": "――バレンタイン、最高だな！", "face": "l9cc21c613d4f"}, {"name": "帝国兵", "text": "ああ、チョコがもらえない日々もこれでおしまいだ！", "face": "u287"}, {"name": "ポーラ", "text": "……やれやれです。\nきっと自分たちが\nモテてないとか勘違いしてるです。", "face": "u253"}, {"name": "リュリュ", "text": "街のみなさんも、\n世界のために戦ってる兵士さんたちに、\nお礼のチョコを贈りたいって言ってましたしね……。", "face": "u591"}, {"name": "エクス", "text": "ふふ、殿方は鈍感なものなのですわ。\nもちろん、私たちの王子も。", "face": "u963"}, {"name": "マーニー", "text": "ほんと、困ったものですよねぇ。\n――さて、私たちもパーティ会場に行きましょうか！", "face": "u745"}]}], "active": true}