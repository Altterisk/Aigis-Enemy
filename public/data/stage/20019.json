bal_id": 780, "spawn_sec": 130}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 61, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 232, "missile_id": 108, "missile": {"speed": 8.0}, "master_id": 781, "global_id": 780, "ranged": true, "from_condition": 5}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 1, "attack_wait": 33, "attack_interval": 128, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 70, "change_to": 17, "change_condition": 5, "master_id": 30401, "global_id": 4020, "to_condition": 5, "to_global_id": 4021, "spawn_sec": 135}, {"enemy_id": 17, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 200, "base_hp": 4000, "base_attack": 200, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 230, "attack_speed": 1, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30402, "global_id": 4021, "ranged": true, "from_condition": 5}, {"enemy_id": 19, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107376, "race_id": 6, "master_id": 572, "global_id": 571, "spawn_sec": 142}, {"enemy_id": 20, "source": "local", "count": 1, "form_count": 1, "tags": ["機械", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 1000000, "attack": 2000, "base_hp": 1000000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 1200, "magic_defense": 20, "attack_speed": 1, "attack_wait": 120, "attack_interval": 292, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2156752, "change_to": 20, "master_id": 38001, "global_id": 11618, "spawn_sec": 186}], "dialogue": [{"trigger": "start", "lines": [{"name": "エィス", "text": "――というわけで、この世界の調査や、\n皆さんとの連絡役として\n派遣されたのがえっちゃんなのでした。", "face": "u2885a1"}, {"name": "アンナ", "text": "なるほど……。\nでも、たわーさんは確か、\n常にこの世界の監視をしているのでは……？"}, {"name": "エィス", "text": "全世界同時観測ですからねぇ。\nさすがに大変なので、子分を派遣したのかと。", "face": "u2885a1"}, {"name": "エィス", "text": "何より、ちょっとさみしがりやなので、\nえっちゃんたちから、おみやげ話とか\n聞きたいんじゃないかなぁって。", "face": "u2885a1"}, {"name": "コメット", "text": "いいじゃんいいじゃん。\n楽しい思い出いっぱい作って、\nたわーちゃんに色々話してあげよう！", "face": "u2770a1"}, {"name": "ファリエ", "text": "ただ、できれば歓迎会を開いてあげたいんですけど、\n実はいま、王国軍はすごーく取り込み中で……。", "face": "u2533a1"}, {"name": "エィス", "text": "お気になさらずです。\nむしろかしこまった挨拶より、\nえっちゃんはこういう雰囲気の方が好きですよ？", "face": "u2885a1"}, {"name": "アカツキ", "text": "――あっ、取り込み中の原因が見えてきました！", "face": "u2578a1"}, {"name": "スウィーティア", "text": "えぇっ！？　隕石って一個じゃないの！？", "face": "u2577a1"}, {"name": "アカツキ", "text": "いやぁ、いっぱいありますねぇ。", "face": "u2578a1"}, {"name": "アカツキ", "text": "結構な速度で降ってきてます！\nみなさん、めいっぱい火力を叩き込みまくってください！", "face": "u2578a1"}, {"name": "エィス", "text": "えっちゃんもお手伝いします。\nかっこいいトコ見せて、いっぱい褒めてもらいますよー。", "face": "u2885a1"}]}, {"trigger": "battle", "at_sec": 186, "lines": [{"name": "フローガ", "text": "――『あーあー、聞こえますか？』", "face": "u878"}, {"name": "フローガ", "text": "『要塞宮殿から観測できる範囲の、\n魔力を帯びた隕石はすべて撃破できたようです。\n殿下、皆さん、それからえっちゃん？　お疲れ様です！』", "face": "u878"}, {"name": "コメット", "text": "えっちゃん、連絡係って話だったけど、\n結構戦える感じじゃない？", "face": "u2770a1"}, {"name": "エィス", "text": "ふふふ、王国軍についていくなら、\nしっかり戦場にも出られないとですし。", "face": "u2885a1"}, {"name": "エィス", "text": "というわけで、これから末永く、\n姉や他の世界へ行った姉妹ともども、\nえっちゃんをよろしくおねがいしまーす。", "face": "u2885a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "コメット", "text": "――よし、そうと決まれば、\n要塞宮殿の調査組を回収して、王国で歓迎パーティだ！", "face": "u2770a1"}, {"name": "ファリエ", "text": "模擬戦――は今度にしましょうか。\nたぶん技術屋さんたちが、\nえっちゃんを質問攻めにするでしょうし……。", "face": "u2533a1"}, {"name": "アカツキ", "text": "ではでは、えっちゃんご一緒に！", "face": "u2578a1"}, {"name": "エィス", "text": "ふぁい？", "face": "u2885a1"}, {"name": "パルセ", "text": "回頭、進路王国。\n――ドーンブリンガー、発進。", "face": "u2276a1"}, {"name": "エィス", "text": "ふふ、なるほど。では――", "face": "u2885a1"}, {"name": "エィス", "text": "――ドーンブリンガー、発進、です♪", "face": "u2885a1"}]}], "active": true}