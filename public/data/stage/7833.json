29, "missile_id": 45, "master_id": 335, "global_id": 334, "ranged": true, "spawn_sec": 130}, {"enemy_id": 8, "source": "local", "count": 10, "form_count": 1, "tags": ["女性"], "hp": 1500, "attack": 250, "base_hp": 1500, "base_attack": 250, "damage_type": "magical", "armor_defense": 50, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 31680, "global_id": 5299, "ranged": true, "spawn_sec": 164}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["サムライ"], "hp": 1500, "attack": 200, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099952, "race_id": 16, "master_id": 207, "global_id": 206, "spawn_sec": 203}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "tags": ["忍者"], "hp": 3500, "attack": 450, "base_hp": 3500, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 160, "attack_speed": 37, "attack_wait": 5, "attack_interval": 47, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098816, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 123, "global_id": 122, "ranged": true, "spawn_sec": 205}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "tags": ["サムライ"], "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100464, "race_id": 16, "master_id": 246, "global_id": 245, "spawn_sec": 207}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 350, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2126720, "race_id": 16, "special_effect_id": 665, "master_id": 33071, "global_id": 6688, "spawn_sec": 211}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 25000, "attack": 1000, "base_hp": 25000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109168, "race_id": 4, "special_effect_id": 130, "master_id": 30162, "global_id": 3781, "spawn_sec": 223}], "popups": ["カカオの木がいる間は、\n女性、バレンタイン属性の\n敵の攻撃と防御がアップします。\n\n攻撃と防御アップの効果は、\nカカオの木の数に\n応じて重複します。", "ミリアムがいる間は\n味方の防御、魔法耐性が\n40％ダウンします。", "ラタトスクがいる間は\n敵のHPが徐々に回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ラタトスク", "text": "吾輩たちは長期休暇を要求するー！", "face": "u1693a1"}, {"name": "キュウビ", "text": "要求するー！", "face": "u465"}, {"name": "ヨシノ", "text": "権力の一極集中による過剰労働反対！\n東の国のサムライはちゃんと机に向かえー！\n刀ばっかり振ってないで責任を放棄するなー！", "face": "u1104a1"}, {"name": "メーア", "text": "帝国軍上層部は抜き打ち視察を廃止せよー！\n自分たちの部下が信用できないのですかーっ！", "face": "u1038a1"}, {"name": "ローリエ", "text": "……なんですか、あれ？", "face": "u1692a1"}, {"name": "ポミエ", "text": "ちょっとよくわからないですね。", "face": "u1422a1"}, {"name": "グレーターデーモン", "text": "ふむ……あれも妖精の仕業だろうね。\n労働への憎悪は、裏を返せば休暇への思慕。\nやりようによっては精神干渉も可能なわけだ。", "face": "l45969ed547e2"}, {"name": "ローリエ", "text": "えぇ……？", "face": "u1692a1"}, {"name": "キュウビ", "text": "ほれ、そなたも声を出さぬか。", "face": "u465"}, {"name": "ミリアム", "text": "え、えっと……三時にはおやつの時間を……。", "face": "u1694a1"}, {"name": "ローリエ", "text": "ミリアムさんまで……。", "face": "u1692a1"}, {"name": "ミリアム", "text": "その、指揮系統の関係で……。", "face": "u1694a1"}, {"name": "ポミエ", "text": "世界樹の代表、帝国の守護獣、東の国のお姫様。\nさすがに私たち一兵士では逆らえませんよね……。", "face": "u1422a1"}, {"name": "ローリエ", "text": "あの冬に水着を着た青い髪の方は……？", "face": "u1692a1"}, {"name": "ポミエ", "text": "ちょっとよくわからないですね。", "face": "u1422a1"}, {"name": "ヨシノ", "text": "我らお仕事したくない同盟。\n労働を憎み、自由を愛する者なり。\n今こそ、悪しき国体を打破するとき。", "face": "u1104a1"}, {"name": "キュウビ", "text": "征けぇい！　鉄砲玉一号！", "face": "u465"}, {"name": "メーア", "text": "うぉおおおお！　有休こそ我がエル・ドラドー！", "face": "u1038a1"}, {"name": "ローリエ", "text": "こっ、こっち来てますぅ！？", "face": "u1692a1"}]}, {"trigger": "end", "lines": [{"name": "ポミエ", "text": "せ、制圧完了……です？", "face": "u1422a1"}, {"name": "メーア", "text": "くぅ……っ！　たとえ我が身が倒れようとも、\n有給休暇を求める意志が途絶えることは……！", "face": "u1038a1"}, {"name": "ヨシノ", "text": "いやぁ、さすがに代理とはいえ一応国主だしねぇ、\n繁忙期に仕事を投げ出すほど私も無責任じゃないよ。", "face": "u1104a1"}, {"name": "ラタトスク", "text": "世界樹の危機には吾輩がおらねば始まらんじゃろ。", "face": "u1693a1"}, {"name": "キュウビ", "text": "そもそもわらわに命令できる者がおらんかったわ。", "face": "u465"}, {"name": "メーア", "text": "えっ……？", "face": "u1038a1"}, {"name": "ヨシノ", "text": "はい撤収ー、さあ仕事仕事。", "face": "u1104a1"}, {"name": "キュウビ", "text": "今日の三時のおやつにはチョコレートを所望するぞ。", "face": "u465"}, {"name": "ラタトスク", "text": "こんなことしてる場合ではない。\nうぬら、早く世界樹に向かうぞ！", "face": "u1693a1"}, {"name": "ローリエ", "text": "はい！　急ぎましょう！", "face": "u1692a1"}, {"name": "ミリアム", "text": "わ、私も合流します！", "face": "u1694a1"}, {"name": "メーア", "text": "え、ちょ──", "face": "u1038a1"}, {"name": "メーア", "text": "………………。", "face": "u1038a1"}, {"name": "メーア", "text": "帰って寝よーっと。", "face": "u1038a1"}, {"name": "レオラ", "text": "…………（ニッコリ）", "face": "u464"}, {"name": "メーア", "text": "ぎゃっ──！？", "face": "u1038a1"}]}], "active": true}