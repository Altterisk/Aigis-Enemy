": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 77}, {"enemy_id": 9, "source": "local", "count": 9, "form_count": 4, "hp": 3000, "attack": 320, "base_hp": 3000, "base_attack": 320, "damage_type": "physical", "armor_defense": 100, "magic_defense": 40, "attack_speed": 30, "attack_wait": 30, "attack_interval": 139, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2119728, "race_id": 4, "change_to": 9, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 31912, "global_id": 5531, "to_global_id": 5532, "spawn_sec": 136}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ステルス"], "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 4, "special_effect_id": 415, "change_to": 10, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31913, "global_id": 5532, "ranged": true, "to_global_id": 5533}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "hp": 9000, "attack": 450, "base_hp": 9000, "base_attack": 450, "damage_type": "physical", "armor_defense": 150, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119744, "race_id": 4, "change_to": 11, "master_id": 31914, "global_id": 5533, "to_global_id": 5534}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 3, "form_count": 4, "hp": 9000, "attack": 400, "base_hp": 9000, "base_attack": 400, "damage_type": "physical", "armor_defense": 140, "attack_range": 220, "attack_speed": 30, "attack_wait": 30, "attack_interval": 70, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112384, "race_id": 12, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31915, "global_id": 5534, "ranged": true}], "popups": ["三味線の付喪神が\n動き出すと敵の妖怪の\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ラタトスク", "text": "いやはや、丁度いい宴会場があって助かったのじゃ！\nまぁふらふら歩いてたら急に宿が現れてビックリしたが。", "face": "u1375a1"}, {"name": "誅子", "text": "王国に華の国、世界樹と他にも諸々の皆が入って、\nなお余裕のある宿があるとはな！\nまぁ明らかに妖しい気配がしているが。", "face": "u2018a1"}, {"name": "クゥイル", "text": "あの、ラタトスク様。\nお酒を飲みすぎでは……？", "face": "u2328a1"}, {"name": "聞忠", "text": "誅子も。正月だからとはめを外しすぎですよ。\nほら、お水を飲んでください。", "face": "u2325a1"}, {"name": "クゥイル", "text": "なんというか……。\nそちらも苦労しているんですね。", "face": "u2328a1"}, {"name": "聞忠", "text": "私は好きで仕えていますから、\n苦労だとは思ってませんよ。", "face": "u2325a1"}, {"name": "聞忠", "text": "それよりも、この宿から感じる妙な気配……。\nそろそろ姿を現したらどうですか？", "face": "u2325a1"}, {"name": "迷い家の従者", "text": "――久しいな、まろうどよ。\n迷い家様もこう仰られている、\n『あけましておめでとう』と。", "face": "l6e9dc9bc48aa"}, {"name": "イーファ", "text": "あっ！？　貴方は確か、\n迷い家の従者の……！", "face": "u2324a1"}, {"name": "迷い家の従者", "text": "先に言っておこう。\n知り合いの妖怪たちが、\nおとし玉の風習を誤って学んでしまった。", "face": "l6e9dc9bc48aa"}, {"name": "迷い家の従者", "text": "すなわち、顔見知りに挑み、\nその力で落とさせるものだと。", "face": "l6e9dc9bc48aa"}, {"name": "クゥイル", "text": "あの、どうして\nそんなことを説明するのですか……？", "face": "u2328a1"}, {"name": "迷い家の従者", "text": "これから妖怪たちがおとし玉をせびりに、\nお主らに突撃しにくるからだ。", "face": "l6e9dc9bc48aa"}, {"name": "迷い家の従者", "text": "迷い家様はこう仰っている、\n『間違った認識だけど楽しそうだから訂正はしない』と。\nお主らが相手なら妖怪がじゃれても大丈夫だろうしな。", "face": "l6e9dc9bc48aa"}, {"name": "クゥイル", "text": "無茶苦茶ですよ！？\nど、どうしましょうラタトスク様……ラタトスク様？", "face": "u2328a1"}, {"name": "ラタトスク", "text": "ぐぅ、ぐぅ……。", "face": "u1375a1"}, {"name": "誅子", "text": "すぅ、すぅ……。", "face": "u2018a1"}, {"name": "聞忠", "text": "駄目です。酔っていたせいで、\n二人とも気持ちよく寝てしまっています。", "face": "u2325a1"}, {"name": "クゥイル", "text": "ラタトスク様ぁ――ッ！！", "face": "u2328a1"}, {"name": "イーファ", "text": "……なんというのか、大変ですわね？", "face": "u2324a1"}, {"name": "聞忠", "text": "いえ、むしろ頼ってもらえている感がいい感じです。", "face": "u2325a1"}, {"name": "クゥイル", "text": "私は振り回されてる感じです……。", "face": "u2328a1"}, {"name": "イーファ", "text": "では、僭越ながら私もお手伝いしましょう。\nクゥイルさんはおふたりを安全な場所へ！", "face": "u2324a1"}, {"name": "クゥイル", "text": "は、はい！（ずるずる）", "face": "u2328a1"}, {"name": "聞忠", "text": "さぁ、妖怪たちを迎え撃ちますよ。\n華麗に勝利して、誅子に武勇伝を聞かせるのです。", "face": "u2325a1"}]}, {"trigger": "end", "lines": [{"name": "イーファ", "text": "た、大変な目にあいましたわ……。", "face": "u2324a1"}, {"name": "迷い家の従者", "text": "……妖怪を退けるか。\n見事だ、まろうどたちよ。", "face": "l6e9dc9bc48aa"}, {"name": "迷い家の従者", "text": "迷い家様も褒めていらっしゃる。\n『頑張った皆におとし玉をあげる』と。", "face": "l6e9dc9bc48aa"}, {"name": "クゥイル", "text": "うわぁっ、床からおとし玉が生えてきましたよ……！？", "face": "u2328a1"}, {"name": "聞忠", "text": "つくづく、迷い家という妖怪は面妖ですね。", "face": "u2325a1"}, {"name": "クゥイル", "text": "でも王国はこの迷い家と協力関係を結んで、\n学園の多目的室として\n使わせてもらっているみたいですよ。", "face": "u2328a1"}, {"name": "聞忠", "text": "……本当に恐ろしいのは、\n王国なのかもしれませんね。", "face": "u2325a1"}, {"name": "迷い家の従者", "text": "さて、迷い家様はこう仰られている。\n『正月だしここでゆっくりしていくといい』と。", "face": "l6e9dc9bc48aa"}, {"name": "迷い家の従者", "text": "そして、迷い家様はこうも仰られている。\n『温泉まんじゅうがあるが食べていくか？』と。", "face": "l6e9dc9bc48aa"}, {"name": "クゥイル", "text": "なんだか、親戚のおじさんみたいですね……。", "face": "u2328a1"}, {"name": "聞忠", "text": "とにかく、もう危害は加えてはこないならいいでしょう。\nそれより我々は、主の介抱をしなければ。", "face": "u2325a1"}, {"name": "クゥイル", "text": "はぁ、そうですね……。\nまったく、気持ちよさそうに寝て……。", "face": "u2328a1"}, {"name": "クゥイル", "text": "本当に、偉い人に仕えるというのは大変ですよ。", "face": "u2328a1"}, {"name": "聞忠", "text": "…………？", "face": "u2325a1"}, {"name": "迷い家の従者", "text": "…………？", "face": "l6e9dc9bc48aa"}, {"name": "イーファ", "text": "…………？", "face": "u2324a1"}, {"name": "クゥイル", "text": "そう思っているのって、私だけなんですか……？\nって、イーファさんは常識人枠じゃないんですかー！？", "face": "u2328a1"}, {"name": "イーファ", "text": "私は主君に恵まれましたし……？", "face": "u2324a1"}, {"name": "クゥイル", "text": "うぅー、ぐすん……。", "face": "u2328a1"}]}], "active": true}