{"quest_id": 6420, "name": "怯える兵士", "description": "謎の女騎士を追う王子達の前に、\n恐怖に我をなくした兵達が襲い来る。\n戦いを制し、兵士の正気を取り戻せ！\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "彷徨える守護の盾", "event_category": "History", "mission_id": 920106, "map_no": 3268, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 220, "gold": 750, "drops": [{"card": 50, "c": 1}, {"card": 12, "c": 1}, {"card": 56, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 3200, "attack": 220, "base_hp": 3200, "base_attack": 220, "damage_type": "physical", "armor_defense": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 162, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 1, "spawn_sec": 35}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 54}, {"enemy_id": 4, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 57}, {"enemy_id": 5, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 65}, {"enemy_id": 6, "source": "local", "count": 5, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 77}, {"enemy_id": 7, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 26, "global_id": 25, "spawn_sec": 121}], "dialogue": [{"trigger": "start", "lines": [{"name": "サイゾウ", "text": "王子、お待ちしておりました。", "face": "u237"}, {"name": "カゲロウ", "text": "あの娘はこの先の城壁を越えていった。\nどうやらあの国の騎士だとみえる。", "face": "u139"}, {"name": "フーリ", "text": "あれ……？\nこっちに誰か走ってきますよ？", "face": "u174"}, {"name": "怯える兵士", "text": "ひっ、ひぃぃッ！？　た、助けて――ッ！！", "face": "u64"}, {"name": "ケイティ", "text": "落ち着いてください。\nいったい何が――", "face": "u114"}, {"name": "怯える兵士", "text": "う、うわぁああッ！？\n貴様らも……ヤツの手先かァッ！？", "face": "u64"}, {"name": "フーリ", "text": "えっ……ヤツ……？", "face": "u174"}, {"name": "怯える兵士", "text": "こ、ここで捕まったら……、\n俺達も……食われちまう……ッ！", "face": "u64"}, {"name": "怯える兵士", "text": "こ、殺される前に、殺すしかないんだ……！！", "face": "u64"}, {"name": "アンナ", "text": "どうやら話は通じそうにないですね……。\n王子、迎撃の準備を！！", "face": "le0bbabf76503"}]}, {"trigger": "end", "lines": [{"name": "カゲロウ", "text": "峰打ちだ、安心しろ。", "face": "u139"}, {"name": "怯える兵士", "text": "うぅ……もしやあなた方は……王国の……？", "face": "u64"}, {"name": "アンナ", "text": "そのとおりです。\nどうやら正気に戻ったようですね。"}, {"name": "怯える兵士", "text": "あぁ……大変なご無礼……を……。", "face": "u64"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ケイティ", "text": "……確かに王子の仰るとおり、\n今は少しでも情報が欲しいところですね。", "face": "u114"}, {"name": "ケイティ", "text": "いったい何があったというのですか？", "face": "u114"}, {"name": "亡国の兵士", "text": "ヤツが……公爵が攻めてきた……。\n皆……皆ヤツの眷属に食われ……、\n国が、祖国が……滅びた……あぁ……。", "face": "u64"}, {"name": "フーリ", "text": "公爵……？", "face": "u174"}, {"name": "ラキュア", "text": "――なるほど、やはり公爵の仕業か。", "face": "u344"}, {"name": "アンナ", "text": "ラキュアさん！？", "face": "le0bbabf76503"}, {"name": "ラキュア", "text": "王子達も公爵を追っていたのかと思ったが、\nどうやら偶然のようだな。これも運命というやつか。", "face": "u344"}, {"name": "ラキュア", "text": "さて、まずは場所を移動すべきだな。\nここでは城壁から丸見えだろう。", "face": "u344"}, {"name": "アンナ", "text": "そうですね。\n急ぎ安全な場所へ移動しましょう！"}]}], "map": {"image": "Map920106_3268", "w": 960, "h": 640, "spots": [{"k": "b", "x": 931, "y": 493}, {"k": "m", "x": 237, "y": 421, "id": 200}, {"k": "m", "x": 381, "y": 282, "id": 201}, {"k": "m", "x": 508, "y": 132, "id": 202}, {"k": "m", "x": 540, "y": 305, "id": 203}, {"k": "m", "x": 491, "y": 373, "id": 204}, {"k": "m", "x": 482, "y": 222, "id": 205}, {"k": "m", "x": 733, "y": 376, "id": 206}, {"k": "m", "x": 786, "y": 477, "id": 207}, {"k": "m", "x": 375, "y": 184, "id": 208}, {"k": "m", "x": 414, "y": 91, "id": 209}, {"k": "m", "x": 690, "y": 443, "id": 210}, {"k": "m", "x": 586, "y": 406, "id": 211}, {"k": "m", "x": 637, "y": 339, "id": 212}, {"k": "m", "x": 131, "y": 467, "id": 213}, {"k": "m", "x": 33