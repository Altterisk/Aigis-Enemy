al": 61, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2119696, "race_id": 4, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 31949, "global_id": 5568, "ranged": true}]}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス", "忍者"], "hp": 16000, "attack": 800, "base_hp": 16000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 36, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126960, "race_id": 16, "change_to": 9, "change_condition": 1, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 33370, "global_id": 6987, "ranged": true, "variants": [{"tags": ["忍者"], "hp": 16000, "attack": 800, "base_hp": 16000, "base_attack": 800, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 60, "attack_interval": 36, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127008, "race_id": 16, "missile_id": 32, "missile": {"speed": 7.0, "deflectable": true}, "master_id": 33371, "global_id": 6988, "ranged": true}], "spawn_sec": 2}, {"enemy_id": 11, "source": "local", "count": 63, "form_count": 1, "hp": 1000, "attack": 320, "base_hp": 1000, "base_attack": 320, "damage_type": "physical", "armor_defense": 170, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 16, "master_id": 31164, "global_id": 4783, "spawn_sec": 13}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "hp": 2100, "attack": 520, "base_hp": 2100, "base_attack": 520, "damage_type": "physical", "armor_defense": 170, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 16, "master_id": 31166, "global_id": 4785, "spawn_sec": 37}, {"enemy_id": 13, "source": "local", "count": 7, "form_count": 1, "hp": 3800, "attack": 630, "base_hp": 3800, "base_attack": 630, "damage_type": "physical", "armor_defense": 240, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 16, "master_id": 31167, "global_id": 4786, "spawn_sec": 61}, {"enemy_id": 14, "source": "local", "count": 2, "form_count": 1, "hp": 7000, "attack": 870, "base_hp": 7000, "base_attack": 870, "damage_type": "physical", "armor_defense": 450, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099360, "race_id": 16, "master_id": 31168, "global_id": 4787, "spawn_sec": 84}], "dialogue": [{"trigger": "start", "lines": [{"name": "スズネ", "text": "――ぽぽんっ！\nとうとう相対するは王子とぬらりひょん！\n此度の物語、果たしてどうなってしまうのか！？", "face": "u936"}, {"name": "オーキュ", "text": "（そわそわ……どうなっちゃうんでしょう！？\nカブキってこんなにドキドキするんですのね！）", "face": "u1101a1"}, {"name": "ライノー", "text": "（ふふ、私は予習済みだぞ？\nこの時は確か、王子がぬらりひょんを――）", "face": "u1086a1"}, {"name": "ぬらりひょん", "text": "ヒョッヒョッ……。\nさぁとどめを刺すがいい、人間の王子よ！", "face": "l356b916aa75e"}, {"name": "王子", "text": "民を苦しませるぬらりひょん、\n貴様の悪事もここまでよ。\n王国が王子、この俺の刃で引導を渡してくれようぞ！", "face": "u661"}, {"name": "パリオス", "text": "（紅牡丹さんかっこいい～！！\nうぅっ、でももう終わっちゃうの！？）", "face": "u1109a1"}, {"name": "シノ", "text": "――あいや待たれい！\n王子よ、何か忘れていやしまいか！", "face": "u403"}, {"name": "王子", "text": "ムゥッ、貴様ら何者だ！　名を名乗れィ！", "face": "u661"}, {"name": "シノ", "text": "知らざぁ言って聞かせやしょう。\nぬらりひょんが長姉、シノたあ私のことよ！", "face": "u403"}, {"name": "カスミ", "text": "我らぬらりひょんが次代を継ぐ三姉妹。\n人間ごときに後れはとりません！", "face": "u470"}, {"name": "サギリ", "text": "（ちっ……どうしてあたしがこんな演劇なんか……）", "face": "u869"}, {"name": "シノ", "text": "（サギリ、姉妹で舞台に上がるのも悪くないですね。\nほら、王子なんてあんなに目を輝かせて）", "face": "u403"}, {"name": "サギリ", "text": "（……くっ。分かった、分かったよ！）\n妖怪総大将を討つつもりなら、\nさぁさ、我ら三姉妹がお相手つかまつる！！", "face": "u869"}, {"name": "チヨメ", "text": "あいやまたれーい。\n四対一とは卑怯なり、このチヨメ、\n義によって助太刀いたすぅ。", "face": "u1144a1"}]}, {"trigger": "battle", "at_sec": 6, "lines": [{"name": "パリオス", "text": "（あっ、王国軍の新人さんだ！\nいいなぁいいなぁ、ぼくも出たかったなぁ）", "face": "u1109a1"}, {"name": "紅牡丹", "text": "（ん、あれ？　チヨメ！　そっちぬらりひょん側だよ！\nそれじゃあ王子と戦う方になっちゃうって！）", "face": "u661"}, {"name": "チヨメ", "text": "（あっ！　しまったなー。\nどうしよ？　どうするー？）", "face": "u1144a1"}, {"name": "紅牡丹", "text": "（ふふん、こういう時にも焦らないのが役者さ！\nさぁ大立ち回りを始めるよ！！）", "face": "u661"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "――以上をもちまして、\n本日の公演は、すべて終了となります。"}, {"name": "パリオス", "text": "はぁ～、かっこよかったぁ……♪\nこれが東の国のカブキなんだぁ♪", "face": "u1109a1"}, {"name": "ライノー", "text": "王国風の演劇も混ぜて、\nこの国でもわかりやすくしているらしいぞ。\nこれがたゆまぬ努力というものか……。", "face": "u1086a1"}, {"name": "アンナ", "text": "――また、本日の公演では、\nお見送り会を行っております。\n順番にご案内しますので、少々おまちください。"}, {"name": "オーキュ", "text": "おみおくりかい、ですの？", "face": "u1101a1"}, {"name": "エルドラ", "text": "ふっふっふ、王国の演劇では、\n役者さんが出口で\nお見送りしてくれる日があるんですのよ！", "face": "u549"}, {"name": "パリオス", "text": "えぇー！？\nど、どうしよう！？　まだ心の準備がぁ！？", "face": "u1109a1"}, {"name": "オーキュ", "text": "ふふっ、目の前でシノ様のお姿を……。\nどきどきしますわね……！", "face": "u1101a1"}, {"name": "紅牡丹", "text": "――ふぅ、皆お疲れ様だ！\n次の公演もよろしく頼むよ！", "face": "u661"}, {"name": "チヨメ", "text": "それでは此度の舞台、\nこれにて、これにてー♪", "face": "u1144a1"}]}], "story_talk": true, "active": true}