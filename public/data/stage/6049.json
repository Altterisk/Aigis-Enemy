peed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106496, "race_id": 8, "change_to": 12, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 387, "global_id": 386, "ranged": true, "to_condition": 3, "to_global_id": 387, "spawn_sec": 91}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 720, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106512, "race_id": 8, "special_effect_id": 234, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 388, "global_id": 387, "ranged": true, "from_condition": 3}, {"enemy_id": 14, "source": "local", "count": 9, "form_count": 2, "hp": 2000, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 14, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 117}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "「聖なる森」……。戦いで命を落とした戦士たちの魂が\n眠る場所……一体なぜ、このような場所に\n魔物達は襲撃をかけたのでしょう。", "face": "l832b17122fb2"}, {"name": "アンナ", "text": "リコラさんは何かご存じですか？", "face": "l832b17122fb2"}, {"name": "リコラ", "text": "うーん……長い事この聖なる森の番人をしてるけど、\nちょくちょく魔物が迷い込むことはあっても\n今回みたいにぞろぞろと来るなんて初めてだよ。", "face": "u289"}, {"name": "リコラ", "text": "それに今回の襲撃は、魔物が森で\n何かを探しているようにも見えたっていうか……。", "face": "u289"}, {"name": "アンナ", "text": "探しもの、ですか？", "face": "l832b17122fb2"}, {"name": "リコラ", "text": "ええ。アタシの野生の勘では、\n何者かが意図的に裏で糸を引いている……、\nそんな気がしてならないの。", "face": "u289"}, {"name": "アンナ", "text": "裏で糸を引いてる者。一体何者なのでしょうね。\n……！　王子、あちらをご覧ください！", "face": "l832b17122fb2"}, {"name": "ハイオーク", "text": "くくくっ……。デシウスとやらとはぐれ\n森の中をさまよい歩いていたが、\nどうやら逆に幸運に当たったようだ。", "face": "l9e1159324b5c"}, {"name": "ユリナ", "text": "……まさかこんなところでハイオークに出会うとはな。", "face": "u1111"}, {"name": "エルヴァ", "text": "団長のお墓参りに来たってだけなのに。\n団長の心がアタシたちに呼びかけたのかしら？", "face": "u1211"}, {"name": "ハイオーク", "text": "お前たち、強そうだな……。\n暇ならば俺の相手でもしてもらおうか？\n", "face": "l9e1159324b5c"}, {"name": "ハイオーク", "text": "ん？　あそこに刺さっているあの剣、なにやら強そうだな。\n俺が勝ったあかつきには、それをいただくとしようか。", "face": "l9e1159324b5c"}, {"name": "エルヴァ", "text": "ちょっとちょっと。\n残念だけど、団長の剣をそう易々と\n渡す訳にはいかないわ。", "face": "u1211"}, {"name": "アンナ", "text": "王子、どうやら魔物に襲われている方がいるようです！\n協力致しましょう！", "face": "l832b17122fb2"}]}, {"trigger": "battle", "at_sec": 88, "lines": [{"name": "暗黒騎士デシウス", "text": "よ、ようやく開けた場所にでたぞ……。\nぜぇ……ぜぇ…………む、アレは！", "face": "lfc19600846f5"}, {"name": "暗黒騎士デシウス", "text": "あそこに見えるのは……間違いない、団長の証！\nようやく見つけたぞ。わざわざこの地まで魔物を\n引き連れてきた甲斐があったというものよ！", "face": "lfc19600846f5"}, {"name": "暗黒騎士デシウス", "text": "ふはは！　これでいよいよ我輩も大いなる力を……！！\nあの証が持つ力を使い、自らが団長となって\n新しい『暗黒騎士団』を作るのだ！！", "face": "lfc19600846f5"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "もう逃げられません！\n魔物たちを先導していたのはあなたですね？", "face": "l832b17122fb2"}, {"name": "暗黒騎士デシウス", "text": "ぐ……。我輩の邪魔をしよって……。\n貴様ら何者だ！", "face": "lfc19600846f5"}, {"name": "アンナ", "text": "私たちは英雄の末裔の王子が率いる軍です。\n降参、していただけますね？", "face": "l832b17122fb2"}, {"name": "暗黒騎士デシウス", "text": "なに！　あの噂の英雄の末裔の……。\nわ、わかった！　降参しよう！\nこの森ではちょっと探し物をしていただけなんだ！", "face": "lfc19600846f5"}, {"name": "アンナ", "text": "探しものですか……一体何をお探しに？", "face": "l832b17122fb2"}, {"name": "暗黒騎士デシウス", "text": "（油断したな……今のうちだ……！）\n馬鹿め！　誰が貴様らなどに降参するものか！　", "face": "lfc19600846f5"}, {"name": "暗黒騎士デシウス", "text": "我輩はいずれ必ずや証を入手し、\n暗黒騎士団を結成してみせる！　さらばだ！", "face": "lfc19600846f5"}, {"name": "リコラ", "text": "あっ、逃げた！！", "face": "u289"}, {"name": "ハイオーク", "text": "全く、何とも情けなく愚かなものよ。\n……しかし、実に楽しい戦いだった。\n機会があればまたいずれ会おう。", "face": "l9e1159324b5c"}, {"name": "アンナ", "text": "……オークが去って行きます。\nひとまずこの森は安全になりましたね。", "face": "l832b17122fb2"}, {"name": "エルヴァ", "text": "団長、この勝利あんたにあげるよ。", "face": "u1211"}, {"name": "ユリナ", "text": "安らかに……。", "face": "u1111"}, {"name": "リコラ", "text": "本当にありがとうっ！\nこの森に眠る戦士の魂も\nきっと安心して眠れるに違いないわ。", "face": "u289"}, {"name": "アンナ", "text": "それは良かったです。\nでは、王子。帰還しましょうか。"}, {"name": "レーヴ", "text": "――団長の証を狙っていた方……。\n暗黒騎士団を結成し、\n一体何をしようとしているのでしょうか？", "face": "u454"}, {"name": "レーヴ", "text": "魔の力を欲する心は魔を呼び寄せますから、\n悪しき者に目をつけられないか心配ですね。\nよからぬことを企んでなければよいのですが……。", "face": "u454"}, {"name": "レーヴ", "text": "…………そ、そうですか。この後、何度もあの者と\n戦うこととなるのですね。強大な力とはいえ、\n自身を見失っては元も子もないと言うのに……。", "face": "u454"}, {"name": "レーヴ", "text": "それでは、次の記憶へと参りましょうか。\nさあ、お手をどうぞ。", "face": "u454"}]}], "active": true}