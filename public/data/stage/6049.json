{"quest_id": 6049, "name": "暗黒騎士と聖なる森の番人（記憶）", "description": "戦士たちの魂が眠る聖なる森。\n森を襲う魔物達の目的とは……。\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "戦場の記憶", "event_category": "History", "mission_id": 920085, "map_no": 3779, "level": 80, "multiplier": 0.8, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "level": 70, "form_count": 2, "hp": 14400, "attack": 640, "base_hp": 18000, "base_attack": 800, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102672, "race_id": 8, "change_to": 1, "change_condition": 3, "master_id": 385, "global_id": 384, "to_condition": 3, "to_global_id": 385, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "level": 70, "form_index": 1, "form_count": 2, "hp": 14400, "attack": 1280, "base_hp": 18000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 700, "attack_speed": 20, "attack_wait": 15, "attack_interval": 116, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102688, "race_id": 8, "master_id": 386, "global_id": 385, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 28, "form_count": 1, "hp": 512, "attack": 112, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 4}, {"enemy_id": 4, "source": "local", "count": 18, "form_count": 1, "hp": 960, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 90, "attack_wait": 30, "attack_interval": 101, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000,