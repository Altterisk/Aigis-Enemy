se_hp": 5000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124096, "race_id": 20, "change_to": 11, "change_condition": 4, "master_id": 32748, "global_id": 6366, "to_condition": 4, "to_ticks": 3, "to_global_id": 6369, "spawn_sec": 213}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 1400, "base_hp": 5000, "base_attack": 1400, "damage_type": "true", "armor_defense": 300, "magic_defense": 30, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124112, "race_id": 20, "special_effect_id": 222, "master_id": 32751, "global_id": 6369, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 15, "source": "local", "count": 4, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 400, "base_hp": 5500, "base_attack": 400, "damage_type": "physical", "armor_defense": 600, "magic_defense": 15, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124160, "race_id": 20, "change_to": 15, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 32915, "global_id": 6532, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 6535, "spawn_sec": 218}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 5500, "attack": 800, "base_hp": 5500, "base_attack": 800, "damage_type": "true", "armor_defense": 600, "magic_defense": 15, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124176, "race_id": 20, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 32918, "global_id": 6535, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 19, "source": "local", "count": 2, "form_count": 2, "hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 262, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124224, "race_id": 20, "change_to": 19, "change_condition": 4, "master_id": 32752, "global_id": 6370, "to_condition": 4, "to_ticks": 3, "to_global_id": 6375, "spawn_sec": 235}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 100, "attack_interval": 405, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124240, "race_id": 20, "special_effect_id": 563, "change_to": 22, "change_condition": 1, "master_id": 32757, "global_id": 6375, "from_condition": 4, "trigger_ticks": 3, "variants": [{"hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "true", "armor_defense": 2000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 150, "attack_interval": 505, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2124240, "race_id": 20, "special_effect_id": 563, "missile_id": 45, "master_id": 32755, "global_id": 6373}]}], "popups": ["ラミアから攻撃を受けると\n「蛇眷属の毒」状態になります。\n蛇眷属の毒によるダメージは、\n女神の加護や、攻撃の無効化、\n地形効果や状態異常を\n軽減するユニット能力の\n影響を受けません。\n　　　　　　　　　　　(1/2)", "　　　　【蛇眷属の毒】\n・攻撃を受けると徐々にHPが減少\n\n・複数のラミアから攻撃を受けた\n　場合、継続ダメージ効果が重複\n\n・一定時間の経過でのみ解除可能\n　　　　　　　　　　　(2/2)", "ゴルゴーンから攻撃を受けると\n「蛇亜神の毒呪縛」状態になります。\n蛇亜神の毒呪縛によるダメージは、\n女神の加護や、攻撃の無効化、\n地形効果や状態異常を\n軽減するユニット能力の\n影響を受けません。\n　　　　　　(1/2)", "　　　　【蛇亜神の毒呪縛】\n・攻撃を受けると即座に麻痺\n　※特定のユニットで無効化可能\n・攻撃を受けると徐々にHPが減少\n　※継続ダメージは永続\n　　また、同一のゴルゴーンによる\n　　継続ダメージは重複しない\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "グレーターデーモン", "text": "――フムゥ、やはり魔界の品は一級品ばかり。\n魔界マーケットまで買付にきた甲斐があったねぇ。", "face": "laaaddea338a6"}, {"name": "グレーターデーモン", "text": "企業買収のためにも資金は不可欠。\nここはひとつ、魔界との貿易をより強固にするのも――", "face": "laaaddea338a6"}, {"name": "ゴブリン", "text": "ギャギャーッ！！\nテキシュウ！　テキシュウ！！", "face": "l5d0d4f1492c6"}]}, {"trigger": "battle", "at_sec": 8, "lines": [{"name": "オーク", "text": "なぜ魔界マーケットに天界兵が――ぐわぁぁぁぁッ！？", "face": "leff6e7005eb1"}, {"name": "ゴルゴーン", "text": "フシュシュ……弱い……なんと弱イ……。\n魔界の民トハこんなモノか……。", "face": "l9a5578895f23"}, {"name": "グレーターデーモン", "text": "フム……騒がしいねぇ……。\n仕入れを邪魔するとは、不届き者がいたものだ。", "face": "laaaddea338a6"}, {"name": "グレーターデーモン", "text": "しかし……こんな時、デーモンシェフや王子ならば、\nどのように稼ぐ機会を掴むのか……。", "face": "laaaddea338a6"}, {"name": "グレーターデーモン", "text": "商機は――そう、己の利益を捨てた先にある。\n小さな稼ぎではなく、大きな稼ぎのための投資こそ、\n未来の大商人への近道に違いない、ねえ。", "face": "laaaddea338a6"}, {"name": "ゴブリン", "text": "ギャギャ……グレーターデーモンサマ……？", "face": "l5d0d4f1492c6"}]}, {"trigger": "battle", "at_sec": 11, "lines": [{"name": "グレーターデーモン", "text": "さぁ、逃げるといい。\nここはワシが引き受けよう。\n未来の大商人、グレーターデーモン様がねぇ。", "face": "laaaddea338a6"}, {"name": "アンナ", "text": "――王子、魔界マーケットにも天界の軍勢が！\nあれは……亜神ゴルゴーンと……グレーターデーモン！？", "face": "l22aa8b9f4f10"}, {"name": "グレーターデーモン", "text": "フム……まさかこんな所で、\n王子と遭遇することになるとはねぇ。", "face": "laaaddea338a6"}, {"name": "ゴルゴーン", "text": "我が姉妹を滅ぼしタ、憎き王子と相まみえルトハ……。\nココデ、その息の根止めテやろう……！！", "face": "l9a5578895f23"}, {"name": "トラム", "text": "王子、気をつけて。\nゴルゴーンは強力な毒を備えているわ。", "face": "u1110a1"}, {"name": "レーヴ", "text": "それから、伝承どおりの\n触れた者を動けなくする力も健在のようです！\n接近戦は危険です！", "face": "u454"}, {"name": "グレーターデーモン", "text": "かつての敵――いや、今も敵には違いないかねぇ。\n剣を交えた者同士ではあるが、\n今は手を取り合うとしようか、王子。", "face": "laaaddea338a6"}]}, {"trigger": "end", "lines": [{"name": "ゴルゴーン", "text": "フシュシュ……！\nナゼだ、ナゼデーモンと王国が手を取り合ウ……。", "face": "l9a5578895f23"}, {"name": "グレーターデーモン", "text": "――未来のためだよ。", "face": "laaaddea338a6"}, {"name": "アンナ", "text": "グレーターデーモン、あなたは……。", "face": "l22aa8b9f4f10"}, {"name": "グレーターデーモン", "text": "未来の利益のためには、\nまずは投資が必要だとようやく気付いてねぇ。", "face": "laaaddea338a6"}, {"name": "トトノ", "text": "……まぁ、その、そうですね。\n王子と共闘したという事実も、\nひとつの投資かもしれません……。", "face": "u316"}, {"name": "ゴルゴーン", "text": "くだらナイ……。\n兵タチよ、ここは退くぞ。\nディアス様のタメ、次ナル戦場へ向かうのだ。", "face": "l9a5578895f23"}, {"name": "グレーターデーモン", "text": "フゥ……魔界マーケットがめちゃくちゃだ。\n賠償金請求は亜神ディアス宛てかな？", "face": "laaaddea338a6"}, {"name": "グレーターデーモン", "text": "さぁ王子よ、先へ進むといい。\nワシは負傷者に恩を売る仕事があるからねぇ。", "face": "laaaddea338a6"}, {"name": "王子", "text": "…………（にこにこ）", "face": "u1"}, {"name": "グレーターデーモン", "text": "まさか、ワシが改心したとでも思っているのかな？\nこれもすべて、未来の稼ぎのためだよ。", "face": "laaaddea338a6"}, {"name": "アンナ", "text": "王子、ここはグレーターデーモンに任せましょう。\n少々不安ではありますが……。", "face": "l22aa8b9f4f10"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}], "active": true}