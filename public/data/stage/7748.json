{"quest_id": 7748, "name": "投資と共闘", "description": "ゴルゴーンを倒し魔界マーケットを守れ！\n＜魔界：味方の攻撃力と防御力が半減＞\n＜時間経過によるコスト回復量が低下＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["魔界：味方の攻撃力と防御力が半減", "時間経過によるコスト回復量が低下"], "event": "魔界動乱", "event_category": "History", "mission_id": 920183, "map_no": 4161, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 26, "params": [50]}, {"kind": "term", "influence": 27, "params": [50]}, {"kind": "term", "influence": 30, "params": [50]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 200000, "attack": 100, "base_hp": 200000, "base_attack": 100, "damage_type": "magical", "armor_defense": 500, "magic_defense": 40, "attack_range": 100, "attack_speed": 1, "attack_wait": 60, "attack_interval": 191, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2125984, "race_id": 19, "special_effect_id": 634, "missile_id": 26, "master_id": 32944, "global_id": 6561, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 40, "form_count": 1, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 236, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2125968, "race_id": 12, "special_effect_id": 622, "master_id": 32939, "global_id": 6556, "spawn_sec": 7}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 2, "hp": 2000, "attack": 300, "base_hp": 2000, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124128, "race_id": 20, "change_to": 3, "change_condition": 4, "master_id": 32919, "global_id": 653