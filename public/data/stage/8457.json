{"quest_id": 8457, "name": "英雄たちの模擬演武", "description": "第五回人気闘兵凱旋パレードが開幕！\n温泉街を舞台に祓剣主神、オラティル、\nサフィールたちを相手に武威を示せ！！\n神級EX（★１獲得の目安：平均覚醒Lv25）", "event": "人気闘兵凱旋パレードV", "event_category": "History", "mission_id": 920224, "map_no": 4970, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 38000, "attack": 1250, "base_hp": 38000, "base_attack": 1250, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_speed": 90, "attack_wait": 20, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158256, "race_id": 16, "special_effect_id": 166, "master_id": 38482, "global_id": 12099, "spawn_sec": 45}, {"enemy_id": 2, "source": "local", "count": 13, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 48}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 83000, "attack": 2800, "base_hp": 83000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 100, "attack_range": 300, "attack_speed": 70, "attack_wait": 90, "attack_interval": 253, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2158352, "race_id": 16, "special_effect_id": 222, "missile_id": 94, "missile": {"speed": 4.0, "splash": 80}, "master_id": 38456, "global_id": 12073, "ranged": true, "spawn_sec": 94}, {"enemy_id": 4, "source": "local", "count": 26, "form_count": 1, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 70, "attack_range": 280, "atta