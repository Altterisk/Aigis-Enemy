 "attack_wait": 75, "attack_interval": 223, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2158016, "race_id": 19, "special_effect_id": 1932, "change_to": 31, "change_condition": 4, "missile_id": 617, "missile": {"speed": 8.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 280, "attack_interval_f": 280, "effect_name": "HitEffectSlow"}}, "master_id": 38176, "global_id": 11793, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 11794, "spawn_sec": 213}, {"enemy_id": 31, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 76000, "attack": 2500, "base_hp": 76000, "base_attack": 2500, "damage_type": "magical", "armor_defense": 270, "magic_defense": 15, "attack_range": 300, "attack_speed": 1, "attack_wait": 75, "attack_interval": 223, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2158016, "race_id": 19, "special_effect_id": 1933, "change_to": 30, "change_condition": 4, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 38177, "global_id": 11794, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 33, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 128000, "attack": 2400, "base_hp": 128000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 3500, "magic_defense": 30, "attack_range": 270, "attack_speed": 70, "attack_wait": 80, "attack_interval": 206, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2158384, "race_id": 16, "special_effect_id": 1963, "missile_id": 45, "master_id": 38458, "global_id": 12075, "ranged": true, "spawn_sec": 215}], "popups": ["\n\n\n　　　　　──翌日。", "カーニアがいる間は、\n全ての味方ユニットの\n防御力と魔法耐性が\n30％ダウンします。", "サフィールから\n攻撃を複数回受けると、\n麻痺状態になります。", "サフィールが味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nスキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。", "祓剣主神は\n一定時間が経過するたびに\n攻撃力がアップします。\n※最大で３倍までアップ\n\n\n\n　　　　　　(1/2)", "祓剣主神から攻撃を\n受けると「マグマ付着」状態になり、\n一定時間継続ダメージを受けます。\n\nマグマ付着によるダメージは、\n女神の加護や\n攻撃の無効化の影響を受けません。\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"text": "──翌日。"}, {"name": "シロガネ", "text": "うっすで、よっすの、こんちゃっす。\n鬼刃忍シロガネ、再々登板の時間っす。", "face": "u1657a1"}, {"name": "シロガネ", "text": "人気闘兵凱旋パレードも今回で早くも五回目。\n実況解説司会進行はお馴染み鬼刃衆で送るっす。", "face": "u1657a1"}, {"name": "シロガネ", "text": "今回のスタート地点は東の国のとある温泉街。\n前日まで温泉でじっくり英気を養った英雄たちが、\n素晴らしい演武を披露してくれることでしょう。", "face": "u1657a1"}, {"name": "町人", "text": "ひゅーひゅー！", "face": "l4da0d2780662"}, {"name": "シロガネ", "text": "まずはこの方、翠の花を守りし緋き盾。\n絶対的安心感を誇る鉄壁の人間城塞──", "face": "u1657a1"}, {"name": "シロガネ", "text": "戦華の盾騎士、サフィール！！", "face": "u1657a1"}, {"name": "サフィール", "text": "メアリ様の名に恥じぬ戦いをお見せしましょう。", "face": "u2208a1"}, {"name": "シロガネ", "text": "えー、次は……おかゆ大好きな謎多き美女。\nミステリアスで知的なお姉さんは好きですか？", "face": "u1657a1"}, {"name": "シロガネ", "text": "それじゃあ早速ご登場、オラティルさんっすねー。\n自分は渡された台本読んでるだけなんで悪しからず。", "face": "u1657a1"}, {"name": "オラティル", "text": "おかゆを食べたい子は演武後に私のところにきたまえよ。", "face": "u2149a1"}, {"name": "アラン", "text": "……またあの人は。", "face": "u1511a1"}, {"name": "トラム", "text": "まあまあ、姉さんらしいじゃない。", "face": "u1110a1"}, {"name": "シロガネ", "text": "最後はこの方、東の国で知らぬ者なし。\n流麗無比な剣技は神話の実在を証明します。\nさあ高らかに叫びましょう、剣の神の名を──", "face": "u1657a1"}, {"name": "シロガネ", "text": "祓・剣・主・神ッ！", "face": "u1657a1"}, {"name": "足軽", "text": "うぉおおおおおおおおおっ！！！！", "face": "u141"}, {"name": "ハイデマリー", "text": "わぁ、すごい熱気……。", "face": "u2340a1"}, {"name": "ヨシノ", "text": "地元も地元だからね、それはこうもなるよ。\n侍の中にはあの方を信仰してる人も多いしさ。", "face": "u1104a1"}, {"name": "祓剣主神", "text": "美味しいご飯とお酒、温泉とふかふかのお布団。\n贅沢した分はちょっといいとこ見せちゃおっかな？", "face": "u2154a1"}, {"name": "シロガネ", "text": "また今回の演武には特別ゲストが参加いたします。\n神仙郷の長、元始天尊。魔剣の使い手、メルヴィナ。", "face": "u1657a1"}, {"name": "ハイデマリー", "text": "（え、この流れって……）", "face": "u2340a1"}, {"name": "シロガネ", "text": "カニなのかタカなのかよくわからんトリ、カーニア。", "face": "u1657a1"}, {"name": "カーニア", "text": "ゼッコーチョー！", "face": "u1685a1"}, {"name": "シロガネ", "text": "そして白の帝国の精鋭砲術士、ハイデマリー！", "face": "u1657a1"}, {"name": "ハイデマリー", "text": "やっぱりね！　聞いてなかったんだけど！？", "face": "u2340a1"}, {"name": "シロガネ", "text": "あれ、棄権っすか？　あっちゃー、それは残念っすねー。", "face": "u1657a1"}, {"name": "ハイデマリー", "text": "やるわよ！　やればいいんでしょ！？\nこの際とことんやってやろうじゃない！", "face": "u2340a1"}, {"name": "カゴメ", "text": "ハイデマリーさん頑張れー！", "face": "u2061a1"}, {"name": "シロガネ", "text": "それでは第五回人気闘兵凱旋パレード、開ッ幕ッ！", "face": "u1657a1"}]}, {"trigger": "end", "lines": [{"name": "祓剣主神", "text": "いやー、楽しかった。強者との戦いは心躍るねぇ！", "face": "u2154a1"}, {"name": "メルヴィナ", "text": "さすが東の国に名高き剣の亜神・祓剣主神、\n魔剣に振り回されているようでは届かないか。\nもっとこれを制御できるようにならないと──", "face": "u2341a1"}, {"name": "サフィール", "text": "……次は、完全に防ぎます。我が翠花に誓って。", "face": "u2208a1"}, {"name": "祓剣主神", "text": "二人とも熱意があって大変結構、\n再戦はいつでも受け付けてるよ。", "face": "u2154a1"}, {"name": "祓剣主神", "text": "そこでソワソワしてるジュウベエもね。", "face": "u2154a1"}, {"name": "ジュウベエ", "text": "……バレていましたか。", "face": "u699"}, {"name": "オラティル", "text": "やあ可愛い妹たち、私の演武はどうだったかな？", "face": "u2149a1"}, {"name": "アラン", "text": "……まあ、楽しんでいましたね。", "face": "u1511a1"}, {"name": "トラム", "text": "姉さんらしくて良かったと思うわよ？", "face": "u1110a1"}, {"name": "少女", "text": "おねえちゃーん、おかゆ食べたーい！", "face": "l87f8150ca9cf"}, {"name": "オラティル", "text": "よしきた任せたまえ！", "face": "u2149a1"}, {"name": "アラン", "text": "あれでも偉大な豊穣神のはずなのですけどね……。", "face": "u1511a1"}, {"name": "レオナ", "text": "──ハイデマリー。", "face": "u311"}, {"name": "ハイデマリー", "text": "レ、レオナさま！？　来てたんですか！？", "face": "u2340a1"}, {"name": "レオナ", "text": "たまたま予定が空いていたからな。\nお前の顔も見ておきたかったし……。", "face": "u311"}, {"name": "レオナ", "text": "まあ、なんだ、楽しくやってるようで安心した。\n王国の空気にも問題なく馴染めているようだな。", "face": "u311"}, {"name": "ハイデマリー", "text": "…………楽しく、馴染んで。", "face": "u2340a1"}, {"name": "レオナ", "text": "前は悪かった、急に出向などさせて。", "face": "u311"}, {"name": "ハイデマリー", "text": "いえ、当時は確かにビックリしましたけど、\n今ではあれが最善だったと私も理解してます。\n感謝こそすれ、不満なんてまったくありません。", "face": "u2340a1"}, {"name": "レオナ", "text": "……そう言ってもらえると助かる。\nハイデマリー、私はお前を尊重しよう。\n相談事があれば遠慮なく手紙をくれ。", "face": "u311"}, {"name": "レオナ", "text": "何を置いても最優先で検討すると約束する。", "face": "u311"}, {"name": "ハイデマリー", "text": "……はい、ありがとうございます。", "face": "u2340a1"}, {"name": "レオナ", "text": "ではな、体調には気を付けろよ。", "face": "u311"}, {"name": "ハイデマリー", "text": "レオナさまも！", "face": "u2340a1"}]}, {"trigger": "end", "lines": [{"name": "ハイデマリー", "text": "（そっか、私も結構変わっちゃったのかなー。\n帝国にいた頃の自分には戻れないかもだけど……）", "face": "u2340a1"}, {"name": "ハイデマリー", "text": "うん、楽しかったー！", "face": "u2340a1"}, {"name": "シロガネ", "text": "さあ、人気闘兵凱旋パレードはまだまだ続きます。\n東の国を離れ、次なる模擬戦演武の舞台は────", "face": "u1657a1"}]}], "active": true}