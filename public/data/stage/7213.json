{"quest_id": 7213, "name": "第六回新春熱血〇×クイズ大会", "description": "がおーっ！　今年もあるぞ新春クイズ大会！\n今回の進行はレオーネが務めるよっ！\n目指せ全問正解！\n<遠距離ユニット出撃禁止>", "modifier_notes": ["遠距離ユニット出撃禁止"], "event": "ゴールドラッシュ28(2020)", "event_category": "Reproduce", "mission_id": 300293, "map_no": 4038, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 24, "params": [4], "expression": "IsVanguard();", "expression_human": "it is a melee unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "tags": ["ステルス"], "hp": 150000, "attack": 2600, "base_hp": 150000, "base_attack": 2600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 20, "attack_wait": 5, "attack_interval": 82, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2121504, "race_id": 12, "special_effect_id": 683, "change_to": 1, "master_id": 33107, "global_id": 6724, "to_global_id": 5934, "route_behaviour": {"sets_flags": [[0, 0, 160], [1, 0, 160], [2, 0, 160], [3, 0, 160], [4, 0, 160], [5, 0, 160], [6, 0, 160], [8, 0, 160], [13, 0, 160], [14, 0, 160], [70, 0, 160], [71, 0, 160], [80, 0, 160], [81, 0, 160], [82, 0, 160], [90, 0, 160], [91, 0, 160], [92, 0, 160]], "calls_event": [2257, 2258, 2259], "reroutes": ["Route=51"]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 150000, "attack": 2600, "base_hp": 150000, "base_attack": 2600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 20, "attack_wait": 5, "attack_interval": 82, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2121504, "race_id": 12, "special_effect_id": 476, "master_id": 32315, "global_id": 5934}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 2, "tags": ["ステルス"], "hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 56, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117648, "race_id": 12, "special_effect_id": 682, "change_to": 3, "master_id": 33106, "global_id": 6723, "to_global_id": 5192, "route_behaviour": {"reroutes": ["Route=01"]}}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 56, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117648, "race_id": 12, "special_effect_id": 354, "change_to": 4, "change_condition": 1, "master_id": 31573, "global_id": 5192, "variants": [{"hp": 70000, "attack": 3000, "base_hp": 70000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 56, "attack_interval": 166, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117664, "race_id": 12, "special_effect_id": 275, "master_id": 31574, "global_id": 5193}]}, {"enemy_id": 6, "source": "local", "count": 3, "form_count": 2, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "attack": 30000, "base_hp": 10000, "base_attack": 30000, "damage_type": "physical", "armor_defense": 300, "attack_range": 50, "attack_speed": 1, "attack_wait": 1, "attack_interval": 23, "move_speed": 4000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126752, "change_to": 6, "change_condition": 4, "missile_id": 11, "master_id": 33104, "global_id": 6721, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6722, "route_behaviour": {"reroutes": ["Route=800", "Route=801", "Route=802", "Route=900", "Route=901", "Route=902", "Route=999"]}}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "attack": 30000, "base_hp": 10000, "base_attack": 30000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 24, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126752, "special_effect_id": 548, "master_id": 33105, "global_id": 6722, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "attack": 10, "base_hp": 10000, "base_attack": 10, "damage_type": "physical", "armor_defense": 300, "attack_range": 50, "attack_speed": 1, "attack_wait": 1, "attack_interval": 23, "move_speed": 4000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126752, "change_to": 8, "change_condition": 4, "missile_id": 11, "master_id": 33118, "global_id": 6735, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 6736, "route_behaviour": {"reroutes": ["Route=710", "Route=910", "Route=999"]}}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス", "置物"], "fixture": true, "hp": 10000, "attack": 10, "base_hp": 10000, "base_attack": 10, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 1, "attack_interval": 24, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126752, "special_effect_id": 548, "master_id": 33119, "global_id": 6736, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "tags": ["ステルス"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_range": 120, "attack_wait": 15, "attack_interval": 83, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2111568, "special_effect_id": 434, "change_to": 10, "missile_id": 643, "missile": {"speed": 3.0}, "master_id": 33108, "global_id": 6725, "ranged": true, "to_global_id": 6737, "route_behaviour": {"sets_flags": [[8, 1, 1600], [30, 1, 1600], [8, 0, 320], [31, 1, 1600], [32, 1, 1600], [8, 1, 2200], [33, 1, 2200]]}, "spawn_sec": 32}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス"], "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_wait": 15, "attack_interval": 83, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2111568, "special_effect_id": 434, "change_to": 9, "master_id": 33120, "global_id": 6737}, {"enemy_id": 12, "source": "local", "count": 4, "form_count": 1, "tags": ["ステルス", "置物"], "fixture": true, "hp": 1000, "attack": 1, "base_hp": 1000, "base_attack": 1, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 1000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2097200, "master_id": 33851, "global_id": 7468, "route_behaviour": {"calls_event": [2207, 2208, 2209, 2220, 2221, 2229, 2230, 2231, 2242, 2243, 2244, 2245]}, "spawn_sec": 32}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 2, "tags": ["ステルス"], "hp": 750, "base_hp": 750, "damage_type": "physical", "attack_range": 200, "attack_speed": 1, "attack_wait": 3, "attack_interval": 47, "move_speed": 600.0, "dot_rate": 1.5, "pattern_id": 2118304, "special_effect_id": 368, "change_to": 13, "master_id": 31685, "global_id": 5304, "ranged": true, "to_global_id": 5305, "route_behaviour": {"transforms": [{"wait": 10000}], "sets_flags": [[13, 1, 10000], [1, 1, 10000], [0, 1, 10000], [3, 1, 10000], [5, 1, 10000]]}, "spawn_sec": 34}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス"], "hp": 750, "base_hp": 750, "damage_type": "physical", "attack_speed": 1, "attack_wait": 3, "attack_interval": 48, "move_speed": 600.0, "dot_rate": 1.5, "pattern_id": 2118320, "special_effect_id": 369, "master_id": 31686, "global_id": 5305}, {"enemy_id": 15, "source": "local", "count": 4, "form_count": 2, "tags": ["ステルス"], "hp": 750, "base_hp": 750, "damage_type": "physical", "attack_range": 200, "attack_speed": 1, "attack_wait": 3, "attack_interval": 47, "move_speed": 600.0, "dot_rate": 1.5, "pattern_id": 2118336, "special_effect_id": 368, "change_to": 15, "master_id": 31687, "global_id": 5306, "ranged": true, "to_global_id": 5307, "route_behaviour": {"transforms": [{"wait": 10000}], "sets_flags": [[9, 1, 10000], [14, 1, 10000], [2, 1, 10000], [10, 1, 10000], [0, 1, 10000], [4, 1, 10000], [11, 1, 10000], [6, 1, 10000], [12, 1, 10000]]}, "spawn_sec": 34}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルス"], "hp": 750, "base_hp": 750, "damage_type": "physical", "attack_speed": 1, "attack_wait": 3, "attack_interval": 48, "move_speed": 600.0, "dot_rate": 1.5, "pattern_id": 2118352, "special_effect_id": 369, "master_id": 31688, "global_id": 5307}], "popups": ["レオーネ、ガオレオン\nシャディアは倒さなくても\n★の評価には影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リズリー", "text": "――はい、満員御礼、拍手喝采、がおがおーっ♪\nさぁレオーネちゃん、教えたとおりに吼えるんだ！", "face": "u716"}, {"name": "レオーネ", "text": "が、がおーっ！！\n新春熱血クイズ大会、はじまるよー！！", "face": "u926"}, {"name": "レオーネ", "text": "というわけで、今回はアタシが、\nクイズ大会の司会進行をつとめちゃうよ！", "face": "u926"}, {"name": "ガオレオン", "text": "ガオーッ！！　父娘揃っての司会とは、\nリズリー殿の粋な計らいであるッ！！", "face": "l274443d90da8"}, {"name": "シャディア", "text": "ガオレオン、吼え過ぎだ！\nやれやれ、ヒントは私が担当しよう。\n困ったら私を頼るといい。", "face": "u713"}, {"name": "リズリー", "text": "よしよしよしよし、雄叫びよーし！\nじゃあルール説明行ってみよう♪", "face": "u716"}, {"name": "レオーネ", "text": "クイズは全部で３問。\n全部『○か×か』で答えられる問題だよ。", "face": "u926"}, {"name": "ガオレオン", "text": "地面に大きく、○と×が描いてあるだろうッ！\n答える時は、これぞ正解ッ！\nと思う方の『近接マス』に仲間を配置するのだッ！！", "face": "l274443d90da8"}, {"name": "レオーネ", "text": "でも、解答者が姿を隠していると\nどちらの答えを選んだか分からないからね。\nちゃんと姿が見えてる子を配置するんだよ？", "face": "u926"}, {"name": "ガオレオン", "text": "うむッ！　隠密は見えなくて困るからなッ！！", "face": "l274443d90da8"}, {"name": "レオーネ", "text": "それから制限時間にも注意注意！\n解答ボタンの看板を支えてる、\n兵士さんの体力が無くなる前に解答してね♪", "face": "u926"}, {"name": "リズリー", "text": "はぁいありがとー！\nそれから今回も、豪華な賞品を用意したよー？", "face": "u716"}, {"name": "シャディア", "text": "開拓村の職人の手による……な、何？\n「等身大ガオレオン村長人形」だと？", "face": "u713"}, {"name": "レオーネ", "text": "……えっ？", "face": "u926"}, {"name": "ガオレオン", "text": "……な、何！？\nレオーネ人形にしろとあれほど言ったのにッ！！", "face": "l274443d90da8"}, {"name": "開拓村の民", "text": "ガオレオン村長ー！！\n最高の出来にしておきましたー！！", "face": "l3a3349faea8b"}, {"name": "リズリー", "text": "――まぁいっか！　じゃぁクイズ開始の前に！\nレオーネちゃん、\nズルして両方選んだらどうなるか教えてあげようか！", "face": "u716"}, {"name": "レオーネ", "text": "ふっふっふ、その時は決まってるでしょ？\nもちろんお・し・お・き、だよー！", "face": "u926"}, {"name": "シャディア", "text": "まぁ、反則などしなくても、\n分からない時には\n私の前に兵を配置するといい。", "face": "u713"}, {"name": "シャディア", "text": "これでも魔王軍に潜入していた身だ。\n今回の問題には詳しいぞ？", "face": "u713"}]}, {"trigger": "battle", "at_sec": 30, "lines": [{"name": "レオーネ", "text": "それじゃあ、まずは練習問題！\nいっくよー！！", "face": "u926"}]}, {"trigger": "battle", "at_sec": 47, "lines": [{"name": "ガオレオン", "text": "ガオーッ！　まずは小手調べであるッ！！\n気軽に答えるとイイッ！！", "face": "l274443d90da8"}, {"name": "レオーネ", "text": "あっ、でも間違えると「タライ」が\n頭の上に降ってくるからね！", "face": "u926"}]}, {"trigger": "battle", "at_sec": 59, "lines": [{"name": "レオーネ", "text": "そこまで！　はい、正解は～？", "face": "u926"}, {"name": "ガオレオン", "text": "ガオーッ！　【○】であるッ！！", "face": "l274443d90da8"}]}, {"trigger": "battle", "at_sec": 63, "lines": [{"name": "レオーネ", "text": "ふっふっふ、さすがは王子！\n時代のスターをアタシと争うだけあるね！", "face": "u926"}]}, {"trigger": "battle", "at_sec": 63, "lines": [{"name": "レオーネ", "text": "王子ぃ、エスネアに算数教えてもらったら？\n計算間違いは仕方ないから、一緒に勉強だ！", "face": "u926"}]}, {"trigger": "battle", "at_sec": 63, "lines": [{"name": "レオーネ", "text": "あーあ、やっちゃったねぇ王子。", "face": "u926"}, {"name": "ガオレオン", "text": "王子よ！　時代のスターとて、\n反則行為には罰則が待っているぞッ！！", "face": "l274443d90da8"}]}, {"trigger": "battle", "at_sec": 67, "lines": [{"name": "レオーネ", "text": "それじゃあさっそく！\n本番いってみようかー！", "face": "u926"}, {"name": "レオーネ", "text": "第１問は……これだー！！", "face": "u926"}]}, {"trigger": "battle", "at_sec": 81, "lines": [{"name": "レオーネ", "text": "こ、これはさすがに分からないよね！\n……いや、うーん、わかっちゃう？", "face": "u926"}]}, {"trigger": "battle", "at_sec": 94, "lines": [{"name": "レオーネ", "text": "はい、そこまで！\n正解は――", "face": "u926"}, {"name": "ガオレオン", "text": "うむッ！！　【○】であるッ！！", "face": "l274443d90da8"}]}, {"trigger": "battle", "at_sec": 97, "lines": [{"name": "レオーネ", "text": "誰この問題作ったの！\n正解だけど恥ずかしいなぁ、もう！", "face": "u926"}]}, {"trigger": "battle", "at_sec": 97, "lines": [{"name": "ガオレオン", "text": "王子よ、そんなに似ていないか……？\n我が娘の、ほら、毛並みなんか似ていると……。", "face": "l274443d90da8"}]}, {"trigger": "battle", "at_sec": 97, "lines": [{"name": "ガオレオン", "text": "ガオーッ！！\n不正行為は禁止だぞッ！！", "face": "l274443d90da8"}]}, {"trigger": "battle", "at_sec": 101, "lines": [{"name": "レオーネ", "text": "続いて第２問！\n次の問題は……これだー！", "face": "u926"}]}, {"trigger": "battle", "at_sec": 116, "lines": [{"name": "レオーネ", "text": "ちくたく♪　ちくたく♪\nさぁ答えはどっちだー！", "face": "u926"}]}, {"trigger": "battle", "at_sec": 128, "lines": [{"name": "レオーネ", "text": "そこまでー！\nはい、答えはー？", "face": "u926"}, {"name": "ガオレオン", "text": "うむッ！　【○】だッ！！", "face": "l274443d90da8"}]}, {"trigger": "battle", "at_sec": 132, "lines": [{"name": "ガオレオン", "text": "見ていられぬちびっこかと思えば、\nデシウスの執念はまさしく勇猛苛烈なものだったッ！", "face": "l274443d90da8"}, {"name": "シャディア", "text": "ああ、デシウスの折れない心は、\n私にもまばゆく輝いて映ったものだ。", "face": "u713"}, {"name": "ヘイオス", "text": "……ふふ、良かったですね、デシウス。", "face": "u915"}, {"name": "デシウス", "text": "ヌゥゥッ、記憶がないのがもどかしいぞ！！", "face": "l6f317147a771"}]}, {"trigger": "battle", "at_sec": 132, "lines": [{"name": "レオーネ", "text": "んー、不正解かぁ。\nまぁこういうこともあるよ。", "face": "u926"}]}, {"trigger": "battle", "at_sec": 132, "lines": [{"name": "ガオレオン", "text": "不正行為を見逃す我ではないぞッ！！", "face": "l274443d90da8"}]}, {"trigger": "battle", "at_sec": 136, "lines": [{"name": "レオーネ", "text": "とうとう最後の第３問！\n気合いれて吼えていこう！", "face": "u926"}]}, {"trigger": "end", "lines": [{"name": "ガオレオン", "text": "存分に悩め、若人よッ！！", "face": "l274443d90da8"}]}, {"trigger": "end", "lines": [{"name": "レオーネ", "text": "さぁ正解は……！", "face": "u926"}, {"name": "ガオレオン", "text": "うむッ！　【×】であるッ！！", "face": "l274443d90da8"}]}, {"trigger": "end", "lines": [{"name": "レオーネ", "text": "さっすがー！　さすがは王子！！\n大正解だよー！！", "face": "u926"}]}, {"trigger": "end", "lines": [{"name": "レオーネ", "text": "あーあ、おしかったねぇ。", "face": "u926"}]}, {"trigger": "end", "lines": [{"name": "ガオレオン", "text": "王子よッ！　時に戯れたくなる気持ちは分かるッ！\nだが今は王国の行事の最中だぞッ！！", "face": "l274443d90da8"}]}, {"trigger": "end", "lines": [{"name": "レオーネ", "text": "全問～正解～ッ♪\n言うこと無し！　完全制覇ー！！", "face": "u926"}, {"name": "ガオレオン", "text": "うむうむッ！　素晴らしい戦いぶりだったぞッ！！", "face": "l274443d90da8"}]}, {"trigger": "end", "lines": [{"name": "シャディア", "text": "ん、１問間違えているのか。\nだがこうした余興には必要なことだろう。", "face": "u713"}]}, {"trigger": "end", "lines": [{"name": "ガオレオン", "text": "ムゥ、さすがに天界のことで手一杯だったか？\nだが我のことは覚えておいてくれッ！！", "face": "l274443d90da8"}]}, {"trigger": "route", "enemy_ids": [12], "lines": [{"name": "シャディア", "text": "確か田園で３回、浜辺で１回……。\nそれからメカゴブリンクイーンの司会で１回か。", "face": "u713"}, {"name": "エスネア", "text": "えぇと、３たす１たす……１たす……えぇと、１？\nで、今回をたすと……６回目だ！", "face": "u997"}, {"name": "シャディア", "text": "ほう、商人の計算機の使い方を覚えたのか。\n勉強熱心だな、エスネア。", "face": "u713"}]}, {"trigger": "route", "enemy_ids": [12], "lines": [{"name": "シャディア", "text": "あの父ありにして、あの娘ありだな。\nいつか親父を倒してチャンピオンになると、\nレオーネがよく言っているだろう。", "face": "u713"}, {"name": "シャディア", "text": "……んっ、これでは\n答えを言っているようなものじゃないか？", "face": "u713"}]}, {"trigger": "route", "enemy_ids": [12], "lines": [{"name": "デシウス", "text": "ヌッ！？　我輩の問題だと！？", "face": "l6f317147a771"}, {"name": "シャディア", "text": "デシウス、勝手に観客席から出てくるんじゃない。\nさて、鎧の種類だったか……。", "face": "u713"}, {"name": "シャディア", "text": "強力な一撃を放つ鎧姿に、\n地中を進む策士の如き鎧姿、\n強くなるための執念がふたつの姿を生み出したんだな。", "face": "u713"}]}, {"trigger": "route", "enemy_ids": [12], "lines": [{"name": "シャディア", "text": "私にこのヒントを出させるのか？", "face": "u713"}, {"name": "シャディア", "text": "ガオレオンは魔王軍幹部の中でも、\nもっとも最前線が似合う男だった。", "face": "u713"}, {"name": "シャディア", "text": "あらゆる遠距離攻撃を引きつける、\nあの構えこそ魔王軍幹部にふさわしいものだ。", "face": "u713"}, {"name": "シャディア", "text": "まぁ、昔の話だがな。", "face": "u713"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "リズリー", "text": "それでは次のクイズ大会でお会いしましょう♪\nレオーネちゃん、最後のご挨拶だ！", "face": "u716"}, {"name": "レオーネ", "text": "今年も元気に雄叫びあげていこうね！\n一緒に「ガオーッ！」だよ！", "face": "u926"}, {"name": "レオーネ", "text": "はい、みんなも一緒に～？\nガオーッ！！　ガオーッ！！　ガオーッ！！", "face": "u926"}]}, {"trigger": "route", "lines": [{"name": "レオーネ", "text": "やれやれ、駄目だって言ったのになぁ。", "face": "u926"}, {"name": "ガオレオン", "text": "不正には罰則をッ！\n鉄拳制裁であるッ！！", "face": "l274443d90da8"}]}], "story_talk": true, "active": true}