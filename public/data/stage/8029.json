{"quest_id": 8029, "name": "聖職者たちのパレード", "description": "王子たちは闇の組織に警戒しつつパレード\nを再開。カーニア、トゥーダ、エクスたち\n聖職者との模擬戦演武で会場を盛り上げろ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "人気闘兵凱旋パレードIII", "event_category": "History", "mission_id": 920202, "map_no": 4772, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 4200, "attack": 700, "base_hp": 4200, "base_attack": 700, "damage_type": "physical", "armor_defense": 60, "magic_defense": 10, "attack_range": 234, "attack_speed": 20, "attack_interval": 143, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2145888, "race_id": 16, "special_effect_id": 1440, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 36346, "global_id": 9963, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 26, "global_id": 25, "spawn_sec": 45}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 4600, "attack": 750, "base_hp": 4600, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 15, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2126144, "race_id": 16, "special_effect_id": 1441, "master_id": 36348, "global_id": 9965, "spawn_sec": 45}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["鳥"], "hp": 4000, "attack": 800, "base_hp": 4000, "base_attack": 800, "damage_type": "physical", "armor_defense": 30, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_wait": 70, "attack_interval": 213, "move_speed": 1250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2145904, "race_id": 12, "special_effect_id": 1095, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 36347, "global_id": 9964, "ranged": true, "spawn_sec": 142}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス"], "hp": 12000, "attack": 210, "base_hp": 12000, "base_attack": 210, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_interval": 25, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118672, "race_id": 16, "special_effect_id": 61, "change_to": 6, "change_condition": 1, "missile_id": 358, "missile": {"speed": 10.0}, "master_id": 34789, "global_id": 8406, "ranged": true, "variants": [{"hp": 12000, "attack": 210, "base_hp": 12000, "base_attack": 210, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 250, "attack_speed": 1, "attack_interval": 25, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2118688, "race_id": 16, "special_effect_id": 61, "missile_id": 358, "missile": {"speed": 10.0}, "master_id": 34790, "global_id": 8407, "ranged": true}], "spawn_sec": 171}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "tags": ["ステルス"], "hp": 9000, "attack": 320, "base_hp": 9000, "base_attack": 320, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2136048, "race_id": 16, "special_effect_id": 54, "master_id": 34788, "global_id": 8405, "spawn_sec": 199}, {"enemy_id": 9, "source": "local", "count": 14, "form_count": 1, "tags": ["ステルス"], "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2136016, "race_id": 16, "master_id": 34785, "global_id": 8402, "spawn_sec": 199}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 2, "tags": ["ステルス"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103728, "race_id": 16, "special_effect_id": 61, "change_to": 10, "master_id": 32554, "spawn_sec": 245}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109104, "race_id": 16, "special_effect_id": 61, "change_to": 9, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 32555, "ranged": true}], "popups": ["トゥーダは\n一定範囲内のユニットに\n継続してダメージを与えます。", "エクスがいる間は\n全ての敵のHPが\n徐々に回復します。\n\nまた、エクスの\n周囲にいる敵は\n防御力が上昇します。", "ファイブから受けたダメージは\n２倍になります。", "マスターローグは一定確率で\n物理攻撃を回避します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "シロガネ", "text": "う～ん、厄介なことになってきたっす。", "face": "u1657a1"}, {"name": "アクラ", "text": "はは、心配は無用ですよシロガネ。\nこの私を引っ張り出してきたからには、\n暗殺者なぞ叩き潰して差し上げましょう。", "face": "u1454a1"}, {"name": "シロガネ", "text": "市民の前でひき肉祭り開催は勘弁っすね～。\nそれよりも、本当に襲撃があるかどうか……。", "face": "u1657a1"}, {"name": "アクラ", "text": "ふむ、あの御仁が虚言を弄している可能性ですか。\nおそらく何か企んでいることは間違いありませんが、\nどちらにせよ、警戒し過ぎて悪いということもなし。", "face": "u1454a1"}, {"name": "シロガネ", "text": "まっ、確かに準備はしたし出たとこ勝負っすね。", "face": "u1657a1"}, {"name": "シロガネ", "text": "お集まりの皆様、大変長らくお待たせしました。\nこれより、人気闘兵凱旋パレードを再開いたします。", "face": "u1657a1"}, {"name": "観客", "text": "ひゅーひゅー！", "face": "l27837385eb87"}, {"name": "シロガネ", "text": "気高き鷹は、戦うための力よりも、\n誰かを笑顔にする道を選びました。", "face": "u1657a1"}, {"name": "シロガネ", "text": "いと慈悲深き天翼の守護、その名も──", "face": "u1657a1"}, {"name": "カーニア", "text": "──カニだよ！", "face": "u1685a1"}, {"name": "トゥーダ", "text": "トリでは？", "face": "u1554a1"}, {"name": "エクス", "text": "カーニアさんですわね。", "face": "u487"}, {"name": "シロガネ", "text": "あっ、全員出てきちゃった。", "face": "u1657a1"}, {"name": "アクラ", "text": "ほほう、王国と帝国の両神官戦士長に、\n鷹翼には珍しい天界の治癒士ですか……。", "face": "u1454a1"}, {"name": "シロガネ", "text": "世界の癒し大集合って感じっすね。", "face": "u1657a1"}, {"name": "観客", "text": "わぁ素敵！　私も癒されたーい！", "face": "l33d2d5fe6b8e"}, {"name": "シロガネ", "text": "んじゃ、もう始めちゃうっすねー。", "face": "u1657a1"}]}, {"trigger": "battle", "at_sec": 174, "lines": [{"name": "ファイブ", "text": "（まったく、シックスのやつも無茶を言ってくれる。\nボスが戻ってくるから張り切るのも理解はできるが……）", "face": "l3fa1c8baa5d7"}, {"name": "ファイブ", "text": "……いや、仕事は仕事だ。行くぞお前たち！", "face": "l3fa1c8baa5d7"}, {"name": "シロガネ", "text": "──ッ、まじで来たっすね。", "face": "u1657a1"}, {"name": "アクラ", "text": "来ると分かっていれば対処も容易いというもの。\n鬼刃衆は私に続いてください、露払いをしますよ。", "face": "u1454a1"}, {"name": "トゥーダ", "text": "それでは私たちで主力を叩くとしましょう。\nアダマス様の名のもとに、神罰を執行します。", "face": "u1554a1"}, {"name": "ファイブ", "text": "チッ……アダマス教の最高戦力か。\nとんだ外れくじだ、恨むぞシックス。", "face": "l3fa1c8baa5d7"}, {"name": "エクス", "text": "あら、アイギス教徒も隣にいましてよ？\n姉妹神の信徒同士、共同作業と参りましょう。", "face": "u487"}, {"name": "カーニア", "text": "トリもいるよ！　トラム教徒！", "face": "u1685a1"}, {"name": "アクラ", "text": "此奴らの中には隠密を心得た者がいます。\n見逃さぬよう、しっかりと足止めしてください。\nなに、見付けさえすれば大した敵ではありません。", "face": "u1454a1"}, {"name": "トゥーダ", "text": "治癒が必要なときは我々にお任せを。", "face": "u1554a1"}, {"name": "エクス", "text": "敵の攻撃が激しいときは私たちで前線を請け負いますわ。", "face": "u487"}, {"name": "カーニア", "text": "よーし、いっチョウいっちゃうよー！", "face": "u1685a1"}]}, {"trigger": "end", "lines": [{"name": "闇組織構成員", "text": "ファ、ファイブ様！　これ以上は限界です！", "face": "l7ef7f376a7ca"}, {"name": "ファイブ", "text": "相性も最悪なら迎撃態勢も万全とはな！\n退却だ！　こんな仕事やってられるかっ！", "face": "l3fa1c8baa5d7"}, {"name": "アクラ", "text": "追いなさい鬼刃衆！　地獄の果てまで！", "face": "u1454a1"}, {"name": "エクス", "text": "パレードを囮に闇の組織を迎撃する作戦、成功ですわね。", "face": "u487"}, {"name": "トゥーダ", "text": "ええ、ここまで上手く回るとは思いませんでしたが……\n襲撃の時間も人数も、情報は確かに正しかったようです。", "face": "u1554a1"}, {"name": "ノストラ", "text": "ファイブは仕事人ながら組織に数少ない人情派。\n長期戦を強いれば部下思いの彼はすぐに退却する。", "face": "u1912a1"}, {"name": "ノストラ", "text": "相手に合わせて適した戦力を揃えれば、こんなものよね。", "face": "u1912a1"}, {"name": "ノストラ", "text": "どう？　これで信じてもらえたかしら？", "face": "u1912a1"}, {"name": "アイリーン", "text": "……別に、最初から疑ってなどいない。\nお前が嘘をつかないことはよく知っている。", "face": "u315"}, {"name": "アイリーン", "text": "いつだって、相手が勝手に騙されるだけだ。", "face": "u315"}, {"name": "ノストラ", "text": "……そ、つまらないわね。", "face": "u1912a1"}, {"name": "シロガネ", "text": "（いや空気重っ）", "face": "u1657a1"}]}], "active": true}