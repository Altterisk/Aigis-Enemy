sical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 11, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 2600}]}, "spawn_sec": 174}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 2, "hp": 100000, "attack": 3000, "base_hp": 100000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 40, "attack_speed": 120, "attack_wait": 30, "attack_interval": 261, "move_speed": 250.0, "dot_rate": 1.7999999523162842, "pattern_id": 2108368, "special_effect_id": 242, "change_to": 13, "change_condition": 3, "master_id": 30023, "global_id": 3642, "to_condition": 3, "to_global_id": 3643, "spawn_sec": 183}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 100000, "attack": 3000, "base_hp": 100000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 40, "attack_range": 300, "attack_speed": 120, "attack_wait": 30, "attack_interval": 141, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.7999999523162842, "pattern_id": 2108368, "special_effect_id": 48, "missile_id": 57, "missile": {"speed": 12.0}, "master_id": 30024, "global_id": 3643, "ranged": true, "from_condition": 3}, {"enemy_id": 15, "source": "local", "count": 8, "form_count": 1, "hp": 10000, "attack": 800, "base_hp": 10000, "base_attack": 800, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 55, "attack_wait": 60, "attack_interval": 206, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107024, "race_id": 6, "master_id": 697, "global_id": 696, "spawn_sec": 211}], "popups": ["上位天使がいる間は\n全ての天使のHPが\n徐々に回復します。", "ケラウノスは拠点には\n向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。", "魔王は、拠点には向かわず\nしばらくすると戦場から\nいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ユリアン", "text": "すごいな……これなら王国まであっと言う間に着くぞ。\nさすがは噂に名高き白の帝国の飛空船だぜ！", "face": "u7"}, {"name": "アンナ", "text": "こうして、帝国の飛空船に搭乗すると、\n改めて我が国との協力体制が実現したことを実感します。\n王子……本当に、良かったですね。"}, {"name": "ケラウノス", "text": "……愚かな。\n人間同士が手を組んだところで\n一体何ができると思っているのでしょうか。", "face": "le9b92fb69cfb"}, {"name": "アダマス", "text": "――ケラウノス姉様！？\nどうしてここに……ッ！", "face": "lddf7a687accd"}, {"name": "ケラウノス", "text": "神器を受け継ぎし者を一掃する機会を窺っていたのですよ。\n空の上では、逃げることもできませんからね。\n……さあ魔王、今こそ受肉の刻を迎えよ！", "face": "le9b92fb69cfb"}, {"name": "魔王", "text": "……。\nこの力……予の真の肉体……か。", "face": "l5d6471e132fe"}, {"name": "アダマス", "text": "そ、そんな……あれは、精神体ではない……。\n間違いありません。あれは、実体の魔王……！\n完全に復活したという事……ですね……。", "face": "lddf7a687accd"}, {"name": "アンナ", "text": "そ、そんな……。", "face": "l74433d6886cc"}, {"name": "皇帝", "text": "狼狽える必要はない。\n今ここに、二柱の神の加護があるという事を忘れるな。", "face": "u418"}, {"name": "シャルム", "text": "そうだよ！\nぜ～ったいに、負けたりなんかしないんだからね！", "face": "u417"}, {"name": "皇帝", "text": "……白く、一点の曇りなき尊き信念の元に、\n我ら、世界を統べる次代の覇者とならん……。\n女神ケラウノス。お前がこの世界を滅ぼす事は出来ん。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "シャルム", "text": "――ああッ！？\nコウテイ、メガミってのが逃げていくよ！\n追いかけなくていいの！？", "face": "u417"}, {"name": "皇帝", "text": "無様な敗者の背を斬る趣味は持ち合わせていない。\n好きにさせろ。", "face": "u418"}, {"name": "レオナ", "text": "シャルム、今は我が軍も王子軍も疲弊している。\nまずは、自国へ戻りお互いに兵を休ませるのが、\n良策といえよう。", "face": "u311"}, {"name": "アンナ", "text": "そうですね！\n今はいち早く戦力を整え、\n魔物との戦いに備えましょう！", "face": "l8b956a21ebca"}, {"name": "アンナ", "text": "帰ったら帝国軍との連絡手段や、\n様々な取り決めもしなくてはいけないですし、\nしばらくは忙しくなりますよ、王子！"}, {"name": "アダマス", "text": "（あの刻より千年……。\nまさか、あの苛烈な戦いよりも、\n厳しい状況になるなんて……）", "face": "lddf7a687accd"}, {"name": "アダマス", "text": "（ですが、今はわずかな希望に全てを託す他ありま\nせん……。アイギス姉様の信徒と我が信徒が手を取り\n合って、地上界を取り戻す事を切に願っています……）", "face": "lddf7a687accd"}]}], "active": true}