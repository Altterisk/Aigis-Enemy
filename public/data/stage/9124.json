"assassin_resist": 100, "transform_resist": 100, "pattern_id": 2158928, "race_id": 16, "change_to": 9, "change_condition": 4, "missile_id": 1222, "missile": {"speed": 3.0}, "master_id": 38523, "global_id": 12140, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 12, "source": "local", "count": 9, "form_count": 1, "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "magical", "armor_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 20, "attack_interval": 75, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131072, "race_id": 16, "missile_id": 614, "missile": {"speed": 4.0}, "master_id": 34132, "global_id": 7749, "ranged": true, "spawn_sec": 92}, {"enemy_id": 13, "source": "local", "count": 7, "form_count": 1, "hp": 19000, "attack": 900, "base_hp": 19000, "base_attack": 900, "damage_type": "physical", "armor_defense": 240, "attack_range": 360, "attack_speed": 1, "attack_wait": 90, "attack_interval": 223, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131088, "race_id": 16, "missile_id": 615, "missile": {"speed": 6.0}, "master_id": 34134, "global_id": 7751, "ranged": true, "spawn_sec": 97}, {"enemy_id": 14, "source": "local", "count": 26, "form_count": 1, "hp": 9000, "attack": 650, "base_hp": 9000, "base_attack": 650, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 40, "attack_interval": 125, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2158864, "race_id": 16, "missile_id": 509, "missile": {"speed": 15.0, "splash": 67, "slow": [50, 65]}, "master_id": 38528, "global_id": 12145, "ranged": true, "spawn_sec": 103}], "dialogue": [{"trigger": "start", "lines": [{"name": "マレス", "text": "──これより戦神コロッセウム・冒険者の部、\nブレイブリージャーニーの決勝戦を執り行うッ！", "face": "l5b7fe1d60167"}, {"name": "観客", "text": "うぉおおおおおおおおおッ！", "face": "lad5b1daab0cb"}, {"name": "マレス", "text": "冒険者よ！　自由を愛する者！　誇りに生きる者！\n勇を携え未知へと挑み、見果てぬ夢を追う者たちよ！", "face": "l5b7fe1d60167"}, {"name": "マレス", "text": "今日此処に、お前たちのそれを体現する者たちがいる。", "face": "l5b7fe1d60167"}, {"name": "マレス", "text": "刹那に生きる者たちよ、今だけは夢に酔いしれるが良い！", "face": "l5b7fe1d60167"}, {"name": "マレス", "text": "さあ、戦士たちの入場だッ！！", "face": "l5b7fe1d60167"}, {"name": "冒険者", "text": "……相も変わらず凄い盛り上がりだな。\n決勝の相手は『虚空の花』の最後の一人。\n世界最高の幻術使いとも称される──", "face": "ld12e12cfde46"}, {"name": "？？？", "text": "『えー、マイクテスマイクテス』", "face": "l9c4b4d3455e5"}, {"name": "チェルシー", "text": "え、ゴブリンがマイク持って……？", "face": "u2369a1"}, {"name": "？？？", "text": "『放蕩中の我が不肖の弟子に告げる。\n軍人ごっこはさっさと終わらせて、\n早く家に帰ってくるように』", "face": "l2a9eb95b4a65"}, {"name": "チェルシー", "text": "オーク！？　──じゃなくて師匠！？", "face": "u2369a1"}, {"name": "ジンレイ", "text": "なになになに、顔と身体がコロコロ変わってるんだけど！", "face": "u2065a1"}, {"name": "ジークリンデ", "text": "幻術だ！　構えろ、戦いはすでに始まっている！", "face": "u429"}, {"name": "幻術使い", "text": "『今回の戦神コロッセウムの期間、\n私は貴女の戦いぶりを監視していました。\n率直に言って、かなり失望しました』", "face": "lf620cc73355f"}, {"name": "チェルシー", "text": "──ッ！？", "face": "u2369a1"}, {"name": "幻術使い", "text": "『貴女はそこにいて良い水準の人間ではありません。\n取り返しのつかない事態になる前に、軍を辞めなさい』", "face": "l4e1b13d0d4df"}, {"name": "チェルシー", "text": "でも私は、師匠みたいになりたくて、\n色んな人の役に立ちたかったから──", "face": "u2369a1"}, {"name": "幻術使い", "text": "『自分でもよく分かっているでしょう。\n貴女はこの大会で何も成し遂げていない。\n仲間の陰に隠れてばかりの役立たず──』", "face": "lfbc401efc576"}, {"name": "幻術使い", "text": "『実力不足、経験不足は問題ではありません。\n貴女には決定的に、戦う意志が欠如しています』", "face": "l9dfa402a9c11"}, {"name": "幻術使い", "text": "『自分は新人だから負けてたって仕方ない？\nそんな負け犬思考の人間はいるだけ邪魔です』", "face": "l448a0ffddb67"}, {"name": "チェルシー", "text": "………………。", "face": "u2369a1"}, {"name": "幻術使い", "text": "『貴女はいつか私のようになりたいと言いました。\nそのいつかとは具体的にいつのことなのでしょうか？』", "face": "l735e88a0a6d1"}, {"name": "幻術使い", "text": "『いつか、いつか、いつか』", "face": "l6e585cd9aebe"}, {"name": "幻術使い", "text": "『貴女のそれは、いつか仲間を殺しますよ』", "face": "la8bb03133e98"}, {"name": "チェルシー", "text": "わ、私は……。", "face": "u2369a1"}]}, {"trigger": "start", "lines": [{"name": "王子", "text": "…………(ふるふる)", "face": "u1"}, {"name": "チェルシー", "text": "王子、殿下……？", "face": "u2369a1"}, {"name": "幻術使い", "text": "『ほう、私の言葉を否定しますか。\n普通なら一笑に付すところではありますが、\n他ならぬ貴方の言葉なら無視もできませんね』", "face": "l533064765ab5"}, {"name": "幻術使い", "text": "『ならばこの一戦で証明してください。\n我が弟子が、真に戦士と成り得るのかを』", "face": "l4df18d819f49"}, {"name": "幻術使い", "text": "『すでにこの地は私の領域、虚空の花園。\n貴女の全力を以って破ってみなさい、チェルシー。\nできなければ、無理にでも連れ帰るのみです』", "face": "lf57a99554c1a"}, {"name": "チェルシー", "text": "……師匠、私は負けません。", "face": "u2369a1"}, {"name": "チェルシー", "text": "こんな私を、信じてくれる人がいるから！", "face": "u2369a1"}]}, {"trigger": "end", "lines": [{"name": "ニーカ", "text": "チェルシーちゃん！", "face": "u2282a1"}, {"name": "チェルシー", "text": "（やっぱり私じゃ師匠に及ばない……！\n地力も、経験も、幻術の精度も天と地！）", "face": "u2369a1"}, {"name": "チェルシー", "text": "（だけど私は、独りじゃないから──！）", "face": "u2369a1"}, {"name": "チェルシー", "text": "ああああああああああッ！", "face": "u2369a1"}, {"name": "マレス", "text": "──そこまでっ！", "face": "l5b7fe1d60167"}, {"name": "チェルシー", "text": "えっ。", "face": "u2369a1"}, {"name": "マレス", "text": "若き幻術士よ、すでに勝負はついた。\nそれ以上は無用な禍根を残すことになる。\n異論はあるまいな、虚空の花よ。", "face": "l5b7fe1d60167"}, {"name": "幻術使い", "text": "『……………………』", "face": "lda804a28b73b"}, {"name": "幻術使い", "text": "『……認めましょう、私の敗北です』", "face": "l94b32620d537"}, {"name": "ウルカノ", "text": "（すっげぇ溜めたな……）", "face": "u1669a1"}, {"name": "チェルシー", "text": "……勝った？　そっ、それじゃあ！？", "face": "u2369a1"}, {"name": "幻術使い", "text": "『どこへなりともお行きなさい。\n今回の件は馬鹿弟子の放蕩ではなく、\n独り立ちということにしておきます』", "face": "ld1a05d28e9cf"}, {"name": "チェルシー", "text": "～～っ、ありがとうございます師匠！", "face": "u2369a1"}, {"name": "幻術使い", "text": "『……ふん』", "face": "l259b9c6334a6"}, {"name": "メーア", "text": "そろそろ幻術で話すのやめません？", "face": "u796"}, {"name": "チェルシー", "text": "師匠は知らない人が苦手なので、\n幻術を使わないと喋れないんです。", "face": "u2369a1"}, {"name": "幻術使い", "text": "『初対面の人間と長時間同じ空間にいたくありません』", "face": "l5676709425d4"}, {"name": "ジンレイ", "text": "その感じで人見知りなんだ！？", "face": "u2065a1"}, {"name": "マレス", "text": "──さて、そろそろ勝ち名乗りの時間だ。", "face": "l5b7fe1d60167"}, {"name": "マレス", "text": "戦神コロッセウム・冒険者の部！\nブレイブリージャーニーの優勝者は──王国の王子ィ！", "face": "l5b7fe1d60167"}, {"name": "観客", "text": "うぉおおおおおおおおおッ！　熱い闘いだったぜぇッ！", "face": "l3ce0d5cadd16"}, {"name": "マレス", "text": "だが、冒険者の旅路はまだまだ終わらない！\n次は夢のエキシビションマッチの時間だァッ！", "face": "l5b7fe1d60167"}, {"name": "マレス", "text": "お前たち！　座席はそのまま、だぜ？", "face": "l5b7fe1d60167"}]}], "active": true}