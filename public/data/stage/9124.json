{"quest_id": 9124, "name": "決勝Lv1", "description": "決勝戦の舞台で幻術使いの師弟は相対する。\n虚空の花、最後の一人である幻術使いを\n相手に意志と力を示して勝利を掴め！！\n＜ユニット、アイテムのドロップなし＞", "modifier_notes": ["ユニット、アイテムのドロップなし"], "event": "ブレイブリージャーニー", "event_category": "History", "mission_id": 920227, "map_no": 9306, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 96000, "attack": 2000, "base_hp": 96000, "base_attack": 2000, "damage_type": "magical", "armor_defense": 600, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 40, "attack_interval": 125, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2158768, "race_id": 16, "missile_id": 509, "missile": {"speed": 15.0, "splash": 67, "slow": [50, 65]}, "master_id": 38519, "global_id": 12136, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 18, "form_count": 4, "hp": 7500, "attack": 600, "base_hp": 7500, "base_attack": 600, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 65, "attack_interval": 206, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2158832, "race_id": 16, "special_effect_id": 1991, "change_to": 2, "master_id": 38524, "global_id": 12141, "to_global_id": 12142, "spawn_sec": 6}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["ブロック不可"], "hp": 7500, "attack": 1000, "base_hp": 7500, "base_attack": 1000, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 7, "attack_interval": 116, "move_speed": 3600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2158848, "race_id": 16, "special_effect_id": 1986, "change_to": 3, "missile_id": 45, "master_id": 38525, "global_id": 12142, "to_global_id":