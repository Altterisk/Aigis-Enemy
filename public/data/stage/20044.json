, "source": "local", "count": 16, "form_index": 0, "form_count": 1, "hp": 2400, "attack": 650, "base_hp": 2400, "base_attack": 650, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 109, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2150416, "race_id": 9, "special_effect_id": 1653, "master_id": 37126, "global_id": 10743, "route_behaviour": {"transforms": [{"wait": 600}]}, "spawn_sec": 150}, {"enemy_id": 13, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 160, "attack_speed": 40, "attack_wait": 10, "attack_interval": 109, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2150400, "race_id": 9, "special_effect_id": 1653, "master_id": 37108, "global_id": 10725, "spawn_sec": 162}, {"enemy_id": 14, "source": "local", "count": 12, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 250, "base_hp": 1000, "base_attack": 250, "damage_type": "physical", "armor_defense": 80, "attack_speed": 40, "attack_wait": 10, "attack_interval": 109, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2150384, "race_id": 9, "special_effect_id": 1653, "master_id": 37107, "global_id": 10724, "spawn_sec": 170}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリン博士", "text": "――諸君、１３周年デアル！！\n王子ノ救援要請ニ応エ、\n我らゴブリン軍団、世界ヲ越エテ参上デアル！！", "face": "lef44e21e3b0e"}, {"name": "ゴブリン", "text": "ギャギャ！　エングン！　エングン！\nオウジタスケル！", "face": "le8d755eebd6e"}, {"name": "ゴブリン博士", "text": "ウム！　目指スハ、王子の待ツ天眼ノ国！\n正式ナ援軍トシテ、我らノ力ヲ貸ス時デアル！\n総員、行軍準備！！", "face": "lef44e21e3b0e"}, {"name": "ゴブリン", "text": "タイヘン！　イソグ！\nオウジノトコ、イチバン！！", "face": "le8d755eebd6e"}, {"name": "ゴブリン博士", "text": "コラーッ！　隊列ヲ乱すデナイ！\n緊急時コソ、訓練通リニ進むノダ！", "face": "lef44e21e3b0e"}, {"name": "ゴブリン", "text": "デモ、オウジ、コマッテル？\nユックリダメ。", "face": "le8d755eebd6e"}, {"name": "ゴブリン博士", "text": "誰ガ、ゆっくり歩ケと言ッタ！\n足並ミヲ揃エテ急グノダ！\nバラバラに着イテハ、援軍ニナラン！！", "face": "lef44e21e3b0e"}, {"name": "ゴブリン", "text": "ギャッ！　イッショ！\nミンナデ、オウジノトコ、イク！", "face": "le8d755eebd6e"}, {"name": "ゴブリン博士", "text": "ソウデアル！\n前ノ者ヲ押スナ！　遅レタ者ヲ置イテイクナ！\n訓練デ、何度モ教エタ通リダ！", "face": "lef44e21e3b0e"}, {"name": "ゴブリン", "text": "ギャギャッ！", "face": "le8d755eebd6e"}, {"name": "ゴブリン博士", "text": "（人類トノ戦争のタメに重ねて来た訓練ガ……。\nマサカ、異世界のトモを\n救うタメのチカラになるトハ……）", "face": "lef44e21e3b0e"}, {"name": "ゴブリン", "text": "ギャギャ？　ハカセウレシソウ！", "face": "le8d755eebd6e"}, {"name": "ゴブリン博士", "text": "そ、そそそそ、ソンナことはナイゾ！？", "face": "lef44e21e3b0e"}, {"name": "ゴブリン博士", "text": "諸君、我ラゴブリン軍団、１３年の歩み！\n迅速ナル行軍ニテ見せつけるノダ！！", "face": "lef44e21e3b0e"}]}, {"trigger": "end", "lines": [{"name": "ゴブリン", "text": "ハカセ！　デッカイマチ！　ミエタ！\nモットデッカイドラゴン！　トンデル！", "face": "le8d755eebd6e"}, {"name": "ゴブリン博士", "text": "ドラゴン……？　イヤ、あれは、都市カ……？\n空ガ巨大なドラゴンの都市デ覆われてイル。\n王子ガ援軍ヲ求メルワケダナ。", "face": "lef44e21e3b0e"}, {"name": "ゴブリン博士", "text": "ゴブリン軍団、隊列ヲ保テ！\nコノママ天眼ノ国、首都へ向かう！", "face": "lef44e21e3b0e"}, {"name": "プリヤンカ", "text": "――あれ？　あっちに見えるのは……。\nま、ま、魔物の群れ！？", "face": "u2808a1"}, {"name": "ニーカ", "text": "心配いりません。\nあれは「友軍」です！", "face": "u2282a1"}, {"name": "ゴブリン博士", "text": "おぉ、ニーカ殿！\nゴブリン軍団、可能ナ限りの全戦力、\nココニ集結シマシタゾ！", "face": "lef44e21e3b0e"}, {"name": "ナナリー", "text": "（ほぼ、全軍……？）", "face": "u29"}, {"name": "デスピア", "text": "（……王国軍が大半の戦力を\n天眼ノ国へ集結させているんだから、\n今こそゴブリンが世界征服する好機なのにね）", "face": "u49"}, {"name": "ナナリー", "text": "……王子のこと、みんな大好きなんだと思います。", "face": "u29"}, {"name": "デスピア", "text": "そうね。\n打算や策略もあるだろうけれど、最後の一押しは、\nやっぱり「王子のため」なんでしょうね。", "face": "u49"}, {"name": "ニハラ", "text": "ゴブリン軍団の皆さん、\n王子殿下から伺っています。\nお待ちしておりました！", "face": "u2888a1"}, {"name": "ゴブリン博士", "text": "ゴブリン軍団、要請ニ応ジ、到着デアル！\n兵員、食料、医薬品、一式揃ッテいるゾ！\n我らハ、何ヲすればヨイ？", "face": "lef44e21e3b0e"}, {"name": "ニハラ", "text": "まずは外縁にお住まいの方々の\n避難誘導をお願いします！\n天眼ノ国と、スカベンジャーの里に振り分けます！", "face": "u2888a1"}, {"name": "プリヤンカ", "text": "うんうん、こっちについてきて！\nあたしたちが、通れる道を案内するから！", "face": "u2808a1"}, {"name": "ゴブリン博士", "text": "ヨシ、ゴブリン軍団、作戦開始デアル！！\nメカゴブリンクイーン様の威光ヲ、\nもうひとつの世界ノ民ニモ知らしめるノダ！", "face": "lef44e21e3b0e"}]}], "map": {"image": "Map7520", "w": 960, "h": 640, "spots": [{"k": "b", "x": 7, "y": 377}, {"k": "m", "x": 123, "y": 272, "id": 200}, {"k": "m", "x": 122, "y": 350, "id": 201}, {"k": "m", "x": 121, "y": 423, "id": 202}, {"k": "m", "x": 235, "y": 269, "id": 203}, {"k": "m", "x": 235, "y": 348, "id": 204}, {"k": "m", "x": 237, "y": 422, "id": 205}, {"k": "m", "x": 358, "y": 266, "id": 206}, {"k": "m", "x": 478, "y": 266, "id": 209}, {"k": "m", "x": 478, "y": 345, "id": 210}, {"k": "m", "x": 482, "y": 424, "id": 211}, {"k": "m", "x": 599, "y": 266, "id": 212}, {"k": "m", "x": 601, "y": 341, "id": 213}, {"k": "m", "x": 604, "y": 423, "id": 214}, {"k": "m", "x": 726, "y": 263, "id": 215}, {"k": "m", "x": 726, "y": 343, "id": 216}, {"k": "m", "x": 728, "y": 426, "id": 217}, {"k": "r", "x": 49, "y": 198, "id": 300}, {"k": "r", "x": 290, "y": 152, "id": 301}, {"k": "r", "x": 501, "y": 146, "id": 302}, {"k": "r", "x": 130, "y": 486, "id": 303}, {"k": "r", "x": 456, "y": 478, "id": 304}, {"k": "r", "x": 684, "y": 491, "id": 305}, {"k": "r", "x": 786, "y": 486, "id": 306}], "events": [{"t": 56.6, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "WhiteOut4", "x": 480, "y": 320}]}, {"t": 59.4, "when": "time", "ops": [{"op": "-fx", "name": "obj_00"}]}]}, "start_cost": 10, "active": true}