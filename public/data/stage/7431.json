{"quest_id": 7431, "name": "第二陣 雷霆を纏いし槍", "description": "闇水晶によって新たな力を手にした\nクロコとの熾烈な決戦に勝利せよ！\n＜広域戦闘：敵味方の射程減少＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国二陣", "event_category": "Empire", "mission_id": 940006, "map_no": 4580, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 18, "params": [15]}, {"kind": "term", "influence": 20, "params": [15]}, {"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 2, "hp": 6500, "attack": 400, "base_hp": 6500, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 1, "attack_wait": 30, "attack_interval": 116, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130944, "race_id": 2, "change_to": 1, "missile_id": 608, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34110, "global_id": 7727, "to_global_id": 7709, "route_behaviour": {"transforms": [{"wait": 3400}]}, "spawn_sec": 3}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6500, "attack": 400, "base_hp": 6500, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "attack_range": 270, "attack_speed": 1, "attack_wait": 30, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130944, "race_id": 2, "change_to": 2, "change_condition": 1, "missile_id": 608, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34092, "global_id": 7709, "ranged": true, "variants": [{"hp": 6500, "attack": 600, "base_hp": 6500, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 30, "attack_wait": 20, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130960, "race_id": 2, "master_id": 34093, "global_id": 7710}]}, {"enemy_id": 4, "source": "local", "count": 11, "form_count": 1, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098576, "race_id": 2, "master_id": 147, "global_id": 146, "spawn_sec": 6}, {"enemy_id": 5, "source": "local", "count": 11, "form_count": 1, "hp": 4000, "attack": 700, "base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098528, "race_id": 2, "master_id": 297, "global_id": 296, "route_behaviour": {"transforms": [{"wait": 1300}]}, "spawn_sec": 19}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 2, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_speed": 90, "attack_wait": 25, "attack_interval": 221, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098640, "race_id": 2, "change_to": 6, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 31275, "global_id": 4894, "to_global_id": 150, "route_behaviour": {"transforms": [{"wait": 240}]}, "spawn_sec": 30}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 600, "attack": 300, "base_hp": 600, "base_attack": 300, "damage_type": "physical", "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist"