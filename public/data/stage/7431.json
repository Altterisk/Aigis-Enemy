: 1, "form_count": 2, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130992, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34095, "global_id": 7712, "ranged": true}, {"enemy_id": 19, "source": "local", "count": 4, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_speed": 60, "attack_wait": 60, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "change_to": 19, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34117, "global_id": 7734, "to_global_id": 292, "route_behaviour": {"transforms": [{"wait": 2400}]}, "spawn_sec": 87}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 293, "global_id": 292, "ranged": true}, {"enemy_id": 21, "source": "local", "count": 1, "form_count": 2, "hp": 120000, "base_hp": 120000, "damage_type": "physical", "armor_defense": 600, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130912, "race_id": 2, "change_to": 21, "master_id": 34090, "global_id": 7707, "to_global_id": 7708, "spawn_sec": 91}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 120000, "attack": 3300, "base_hp": 120000, "base_attack": 3300, "damage_type": "true", "armor_defense": 600, "magic_defense": 10, "attack_range": 1030, "attack_speed": 1, "attack_wait": 300, "attack_interval": 681, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2130928, "race_id": 2, "change_to": 20, "missile_id": 607, "missile": {"speed": 12.0, "splash": 133}, "master_id": 34091, "global_id": 7708, "ranged": true}, {"enemy_id": 23, "source": "local", "count": 10, "form_count": 1, "hp": 6000, "attack": 300, "base_hp": 6000, "base_attack": 300, "damage_type": "magical", "armor_defense": 200, "attack_range": 210, "attack_speed": 1, "attack_wait": 25, "attack_interval": 141, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130976, "race_id": 2, "missile_id": 609, "missile": {"speed": 10.0}, "master_id": 34094, "global_id": 7711, "ranged": true, "spawn_sec": 130}], "popups": ["飛翔するクロコは、\n移動中は攻撃を行いません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ハイドース", "text": "――この港が落ちるか否か。\nこの戦いが、帝国の試金石となる。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "見事耐えきるのならば、\nこちらも手段を講じる必要があるだろう。", "face": "le4066daa294e"}, {"name": "クロコ", "text": "――笑止。\nソレは我が雷霆を侮っているノカ？", "face": "l9164578f1e0d"}, {"name": "ハイドース", "text": "そう聞こえたならば謝罪しよう。\nただ、真なる雷を、知っているがゆえな。", "face": "le4066daa294e"}, {"name": "クロコ", "text": "女神ケラウノスの――否、\n神であっタ頃の、ディアスの雷カ。", "face": "l9164578f1e0d"}, {"name": "ハイドース", "text": "しかし、それゆえに期待しよう。\n神なる竜に連なる戦士よ。\n竜族の雷、この目に見せてもらおうか。", "face": "le4066daa294e"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "……王子、冥界軍が動きます。", "face": "l91db55a83012"}, {"name": "白の皇帝", "text": "この都市には、古くから住まう者もいれば、\n航海の果てに住み着いた者たちもいる。\nそして、俺たちが戦によって併合した者たちも。", "face": "u418"}, {"name": "白の皇帝", "text": "その全てが、帝国の臣民だ。\nレオナ、街の防備を固めろ。\n誰ひとりとして、死者を出すな。", "face": "u418"}, {"name": "レオナ", "text": "はっ！　総員、戦闘に備えろ！\nこれを海岸防衛、最後の戦いとするぞ！", "face": "u311"}, {"name": "サザンカ", "text": "……あ、たしも！　戦う！　戦うからー！", "face": "u1347a1"}, {"name": "マレブランケ", "text": "こらっ、また起きてきたな！？\n前線は王子たちに任せたまえ。\nサザンカはよく戦ったよ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "でも！　でも……っ！\nあたしだけ後方なんて！", "face": "u1347a1"}, {"name": "白の皇帝", "text": "帝国に住まう、鬼の部族が長よ。\n――貴様に、頼みたいことがある。\n街への侵入を許した時には、その金棒の力を借りたい。", "face": "u418"}, {"name": "レオナ", "text": "陛下……。", "face": "u311"}, {"name": "サザンカ", "text": "……はぁ。分かったよ、皇帝。\nだからそんな、らしくもない顔しないで。\nあんたに王子の真似は似合わないよ。", "face": "u1347a1"}, {"name": "白の皇帝", "text": "…………そうか。", "face": "u418"}, {"name": "白の皇帝", "text": "帝国軍兵士たちよ、剣をとれ。\n死者どもには、冥界へお帰り願おう。", "face": "u418"}]}, {"trigger": "end", "lines": [{"name": "クロコ", "text": "……闇水晶の力だけデハ、ここが限界カ。\n冥界の亜神ヨ、私ハ退くぞ。", "face": "l9164578f1e0d"}, {"name": "ハイドース", "text": "よかろう。\nダークエルフ、竜人の連合をもってなお、\n帝国の防備は万全であったということだ。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "兵を退け、これ以上の損耗は避けよ。\n此度の戦、我らの敗北だ。", "face": "le4066daa294e"}, {"name": "レオナ", "text": "冥界軍、撤退していきます。\n陛下、我々の勝利です。", "face": "u311"}, {"name": "白の皇帝", "text": "……これが、勝利か。\nこの街の復興には、時間がかかるだろうな。", "face": "u418"}, {"name": "サザンカ", "text": "はぁ……勝ちは勝ちだよ。\nなに痛み分けみたいな顔してるのさ。", "face": "u1347a1"}, {"name": "サザンカ", "text": "街の皆は、誰も死んでない！\n全員守ったんだよ、誇れよ皇帝！", "face": "u1347a1"}, {"name": "白の皇帝", "text": "……ああ。\n礼を言おう、鬼の族長よ。\n帝国のため、立ち上がってくれたことに。", "face": "u418"}, {"name": "マレブランケ", "text": "おっと、それは違うぞ陛下。\nサザンカは決して、帝国のためには戦っていない。", "face": "u1225a1"}, {"name": "サザンカ", "text": "――国とか種族とかどうでもいい。\nあたしが戦うのは、あたしの前で誰も死なせないため。", "face": "u1347a1"}, {"name": "サザンカ", "text": "最強の鬼が、これからも手を貸してあげるよ。\nだから皇帝も王子も、\n絶対に、だれにも、負けたりするんじゃないよ！", "face": "u1347a1"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "――勝利より、兵を取りましたか。\nさすがは冥界の亜神。", "face": "u1645a1"}, {"name": "ハイドース", "text": "貴様か……。\nどうした、ディアスのところにいると思っていたが。", "face": "le4066daa294e"}, {"name": "？？？", "text": "味方になれと誘われはしましたが、\n兵を捨てる思想は、どうにも気に入らず。", "face": "u1645a1"}, {"name": "ハイドース", "text": "……そうだろうな。\nでなければ、あの戦の折、剣を取ることは無かっただろう。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "それで、我が戦を、貴様はどう捉えた。\n我が配下に加わるというのなら、\n喜んで迎え入れるつもりだが。", "face": "le4066daa294e"}, {"name": "？？？", "text": "いえ、遠慮しておきましょう。\n我が使命はただひとつ、\n彼に「世界を頼む」と託されてしまいましたから。", "face": "u1645a1"}, {"name": "ハイドース", "text": "ははっ、何とも重い使命だ。\n――なれば、今宵は世界に杯を捧げるとしよう。", "face": "le4066daa294e"}]}, {"trigger": "route", "lines": [{"name": "クロコ", "text": "――未だコノ身、雷霆まとう竜には及ばヌが。\n闇水晶が力をモッテ、その一端を見せてヤロウ。", "face": "l9164578f1e0d"}, {"name": "エレニア", "text": "……あれは、サンダードレイクの閃光……？\nいえ、それよりももっと、雷竜のそれに近いような……。", "face": "u252"}, {"name": "アーニャ", "text": "違う……あれはもっと異質な……。\nあたしたちより、古い竜の雷……？", "face": "u99"}, {"name": "アーニャ", "text": "王子さま！　気をつけて！！\nクロコのハルバードがまとっているのは、\n古代の雷竜が放ったドラゴンブレスと等しいものです！", "face": "u99"}, {"name": "リキュノス", "text": "帝国艦隊の砲撃だけでも厄介だというのに……。\n王子殿、クロコを全力で叩くぞ！", "face": "u637"}]}], "active": true}