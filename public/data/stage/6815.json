{"quest_id": 6815, "name": "大胆なる夏の魔術", "description": "水着姿に着替えた華やかな女性陣が\n訓練に合流した。夏の装いに張り切る\nマーヤたちの訓練相手を務めよ！\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "砂浜を駆ける魔術師", "event_category": "History", "mission_id": 920130, "map_no": 3318, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 220, "gold": 750, "drops": [{"card": 839, "c": 1}, {"card": 36, "c": 1}, {"card": 56, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6500, "attack": 500, "base_hp": 6500, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115168, "race_id": 16, "master_id": 31108, "global_id": 4727, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 2500, "attack": 600, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 27, "global_id": 26, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 11, "form_index": 0, "form_count": 1, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 25, "global_id": 24, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 120, "base_hp": 5000, "base_attack": 120, "damage_type": "physical", "armor_defense": 65, "attack_range": 150, "attack_speed": 1, "attack_wait": 30, "attack_interval": 106, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2115200, "race_id": 16, "special_effect_id": 72, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 31827, "global_id": 5446, "ranged": true, "spawn_sec": 7}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 2500, "attack": 180, "base_hp": 2500, "base_attack": 180, "damage_type": "magical", "armor_defense": 10, "magic_defense": 10, "attack_range": 180, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2119120, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 31824, "global_id": 5443, "ranged": true, "spawn_sec": 8}, {"enemy_id": 6, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 90}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 32, "global_id": 31, "ranged": true, "spawn_sec": 108}], "dialogue": [{"trigger": "start", "lines": [{"name": "ポーラ", "text": "あっ、ようやく見つけたです。\nいつの間にこんな離れ小島にきてたですか？", "face": "u519"}, {"name": "ダン", "text": "おっ、ようやく追いついたか――って、\n着替えってお前ら、水着に着替えてたのかよ！？\n完全に遊ぶ気じゃねぇか……！！", "face": "u204"}, {"name": "エレイン", "text": "あら？　その環境に適した装備をするのは当然でしょ？\n夏といえば海、海といえば水着よ！", "face": "u517"}, {"name": "ポーラ", "text": "エレインの言うとおりです。\nむしろ服を着たまま遠泳する\n男性陣の方がおかしいくらいです。", "face": "u519"}, {"name": "エレイン", "text": "まぁまぁ。ところでそろそろお腹空いてない？\n次の模擬戦している間に、\n私達がお昼ご飯作っておいてあげるわ♪", "face": "u517"}, {"name": "シルヴィア", "text": "それなら私も、昼食の準備を手伝いましょうか。\nここは眩しすぎますもの。", "face": "u833"}, {"name": "アンナ", "text": "それでは我々は、模擬戦の続きをしましょうか。\n王子、戦闘準備をお願いします！", "face": "u437"}]}, {"trigger": "battle", "at_sec": 11, "lines": [{"name": "シルヴィア", "text": "――あら？\nマーヤ、こんな所で何をしていますの？\nもう模擬戦は始まっていますわよ？", "face": "u833"}, {"name": "マーヤ", "text": "……あっ、いえ、その。\nちょっと、恥ずかしくてですね……？", "face": "u839"}, {"name": "フーリ", "text": "恥ずかしいなんて言っていたら、\n王子にアピール出来ないですよ？\nせっかくの可愛い水着姿なのに……！", "face": "u658"}, {"name": "マーヤ", "text": "えっ、えぇぇっ、\n私そんなつもりでは……！？", "face": "u839"}, {"name": "ポーラ", "text": "さっき王子の側で模擬戦に参加した時、\n王子に頼ってほしいアピールをしていたです。\nいまさらというやつです。", "face": "u519"}, {"name": "キャリー", "text": "せっかく可愛い水着を選んだんですから、\nここは元気よく行かないと損ですよ！\nさぁマーヤ、行きますよー！！", "face": "u646"}, {"name": "マーヤ", "text": "わっ、わわっ、きゃぁぁ！？", "face": "u839"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "マーヤ", "text": "（ど、どうしよう、どうしましょうっ！？\n王子と目があってしまいました……！！\nこ、こうなったら、もう後には退けません！）", "face": "u839"}, {"name": "マーヤ", "text": "王子っ、私がお相手します！！\n精一杯頑張りますから、私を見て――じゃなくて、\n私の活躍を、いっぱい見ていてくださいね……！！", "face": "u839"}]}, {"trigger": "end", "lines": [{"name": "キャリー", "text": "マーヤ、やるじゃないですか！\nいつもより前に踏み込んでいたし、\n魔法使いとは思えない勇気ある戦法でしたよ！", "face": "u646"}, {"name": "フーリ", "text": "もしかして、水着姿になったことで、\nちょっぴり大胆になれたのではないですか？", "face": "u658"}, {"name": "マーヤ", "text": "そ、そうでしょうか……？\nでも負けてしまいましたし……。", "face": "u839"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "マーヤ", "text": "……えっ？　す、すごい活躍だった、ですか？", "face": "u839"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "マーヤ", "text": "あ……ありがとうございます、王子っ！\n私っ、も、もっと頑張りますね！", "face": "u839"}, {"name": "ポーラ", "text": "でもその前にお昼ご飯です。\nお腹が減っては冒険も出来ないですよ？", "face": "u519"}, {"name": "シルヴィア", "text": "そういえば王子、お昼の支度をしにいった時、\nこの先に洞窟のようなものが見えましたわ？", "face": "u833"}, {"name": "フーリ", "text": "洞窟ですか……！\nそれでは、食事が終わったらその洞窟で、\n模擬戦再開ということでいかがでしょうか？", "face": "u658"}, {"name": "アンナ", "text": "なるほど、せっかく普段とは違う環境での\n戦い方を訓練しに来たのですから、\n良いアイデアかもしれませんね！", "face": "u437"}]}], "map": {"image": "Map920130_3318", "w": 960, "h": 640, "spots": [{"k": "b", "x": 10, "y": 419}, {"k": "m", "x": 425, "y": 359, "id": 200}, {"k": "m", "x": 535, "y": 382, "id": 201}, {"k": "m", "x": 615, "y": 310, "id": 202}, {"k": "m", "x": 602, "y": 221, "id": 203}, {"k": "m", "x": 488, "y": 193, "id": 204}, {"k": "m", "x": 422, "y": 261, "id": 205}, {"k": "m", "x": 338, "y": 409, "id": 206}, {"k": "m", "x": 205, "y": 438, "id": 207}, {"k": "m", "x": 83, "y": 428, "id": 208}, {"k": "m", "x": 581, "y": 456, "id": 209}, {"k": "m", "x": 703, "y": 485, "id": 210}, {"k": "m", "x": 847, "y": 503, "id": 211}, {"k": "m", "x": 709, "y": 204, "id": 212}, {"k": "m", "x": 831, "y": 178, "id": 213}, {"k": "r", "x": 557, "y": 179, "id": 300}, {"k": "r", "x": 658, "y": 267, "id": 301}, {"k": "r", "x": 481, "y": 405, "id": 302}, {"k": "r", "x": 376, "y": 308, "id": 303}, {"k": "r", "x": 180, "y": 325, "id": 304}, {"k": "r", "x": 865, "y": 448, "id": 305}, {"k": "r", "x": 413, "y": 191, "id": 306}, {"k": "r", "x": 624, "y": 385, "id": 307}]}, "start_cost": 10, "active": true, "name_en": "Bold Summer Magic", "description_en": "The glamorous Women, now in swimsuits, have joined the training.\nServe as Maya's sparring partner in her summer attire!\nBeginner (★1 acquisition guideline: Avg Lv1, 5 units deployed)"}