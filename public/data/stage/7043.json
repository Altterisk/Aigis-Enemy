{"quest_id": 7043, "name": "花嫁たちを追って", "description": "囮となったディエーラがさらわれた！\n霧となった吸血鬼たちの妨害を退けつつ、\n消えた花嫁たちの痕跡を追え！\n上級（★１獲得の目安：平均Lv10）", "event": "ジューンブライド・ミッドナイト", "event_category": "History", "mission_id": 920145, "map_no": 5556, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 13, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 3}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "hp": 5000, "attack": 600, "base_hp": 5000, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097808, "master_id": 43, "global_id": 42, "spawn_sec": 20}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097664, "race_id": 9, "master_id": 37, "global_id": 36, "spawn_sec": 32}, {"enemy_id": 4, "source": "local", "count": 5, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 4, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_global_id": 533, "spawn_sec": 35}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533}, {"enemy_id": 6, "source": "local", "count": 18, "form_count": 1, "tags": ["アンデッド"], "hp": 2100, "attack": 220, "base_hp": 2100, "base_attack": 220, "damage_type": "physical", "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099168, "race_id": 9, "special_effect_id": 233, "master_id": 166, "global_id": 165, "spawn_sec": 48}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド", "ステルス"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2122480, "special_effect_id": 233, "change_to": 7, "change_condition": 1, "master_id": 32507, "global_id": 6126, "variants": [{"tags": ["アンデッド"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157}], "spawn_sec": 55}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111632, "race_id": 11, "special_effect_id": 233, "master_id": 30613, "global_id": 4232, "spawn_sec": 65}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157, "spawn_sec": 111}], "dialogue": [{"trigger": "start", "lines": [{"name": "エマ", "text": "――姫、こちらです。\nあの者の残り香が、色濃く残っております。", "face": "u582"}, {"name": "シルヴィア", "text": "えぇ、そのまま後を追ってくださいな。\nけれどエマ、あまり怖い顔をしないように。\n他の皆さんが怯えてしまいますわよ？", "face": "u442"}, {"name": "エマ", "text": "……申し訳ありません。\n怯えさせるつもりは無かったのですが。", "face": "u582"}, {"name": "シルヴィア", "text": "仕方ありませんわ。あなたは真面目ですもの。\n――こほん。私が今はなきヴァンパイアの王国の、\nプリンセスだったことは、以前にお話しましたわね？", "face": "u442"}, {"name": "シルヴィア", "text": "私が目覚めた時には国は滅んでいましたから、\n具体的に何が起きたのかは、\n執事やエマから伝え聞いた程度なのですけれど――", "face": "u442"}, {"name": "エマ", "text": "……あの女が、ヴァンパイアの王国の\n一部の貴族をそそのかし、\n国が滅ぶ原因のひとつを作ったのです。", "face": "u582"}, {"name": "ヴィンセント", "text": "あの女……？", "face": "u103"}, {"name": "シルヴィア", "text": "ヴァンパイアには似て非なるもの、\nその正体のしれない奇妙な女。", "face": "u442"}, {"name": "シルヴィア", "text": "その者は、まさに今夜と同じような、\n血で出来た宝石――ブラッドストーンを用いて、\n次々に人々をさらっていったそうですわ……。", "face": "u442"}, {"name": "ヒューナ", "text": "ブラッドストーン……。\nディエーラ達が身につけていた宝石ね。", "face": "u627"}, {"name": "フーリ", "text": "そういえば、霧化する魔物が落とした宝石も、\n同じように赤く輝いていた気がします。", "face": "u174"}, {"name": "シルヴィア", "text": "人も獣も、力弱きものであればヴァンパイアも、\nあの石を前にして、抗うことはできないでしょう。", "face": "u442"}, {"name": "エマ", "text": "並ぶものなきヴァンパイアの血族であれど、\n同族での争いとなれば、\nその被害は国を傾けるに十分なものとなりました。", "face": "u582"}, {"name": "ヒューナ", "text": "……そんなヴァンパイアが、\n今回の誘拐事件を引き起こしていると？", "face": "u627"}, {"name": "エマ", "text": "……その可能性は高いかと。\nただ、血の香りは当時よりも随分と薄い様子。", "face": "u582"}, {"name": "エマ", "text": "力を蓄えるために、\n花嫁役の麗しき少女たちをさらっている、\nというのが、実際のところではないかと。", "face": "u582"}, {"name": "ヴィンセント", "text": "……滅ぼす相手が増えただけだ。\nそれより王子、気付いているな？\nどうやら連中、こちらを足止めするつもりらしい。", "face": "u103"}, {"name": "エリザベート", "text": "なるほど、獣と違って知恵が回るわね。\n王子、急いで迎撃の準備をしなさいな。", "face": "u104"}]}, {"trigger": "end", "lines": [{"name": "ヴィンセント", "text": "……敵の抵抗が強くなっている。\nどうやら拠点が近いようだな。", "face": "u103"}, {"name": "エマ", "text": "間違えようもありませんとも。\nしかし人の身が羨ましいものです。\nこれ程に醜く濃い血の香りが分からないとは。", "face": "u582"}, {"name": "ヴィンセント", "text": "あいにくと、血は主食じゃないんでな。\nだが、お前達の実力は信用している。\n今は共に、花嫁達を救うとしよう。", "face": "u103"}, {"name": "エマ", "text": "……ふふ、えぇ、えぇ、お任せあれ。\nあの女の拠点まで、そう遠くはありますまい。", "face": "u582"}, {"name": "シルヴィア", "text": "王子様、そろそろ敵の拠点の付近ですわ。\nどんな手駒を放ってくるかわかりません。\n注意して進みますわよ！", "face": "u442"}]}], "active": true}