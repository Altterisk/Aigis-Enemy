{"quest_id": 20007, "name": "変わるために必要なこと", "description": "王子たちは話し合いの末、雪枝の戦士の\n不平不満を受け止めるべく剣を取る。\n止まりどころを見失った獣人を撃退せよ！\n神級（★１獲得の目安：平均覚醒Lv25）", "event": "雪の枝に花火が咲く", "event_category": "Emergency", "mission_id": 200574, "map_no": 7468, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 457000, "attack": 2650, "base_hp": 457000, "base_attack": 2650, "damage_type": "physical", "armor_defense": 640, "magic_defense": 15, "attack_range": 300, "attack_speed": 90, "attack_wait": 80, "attack_interval": 221, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171904, "race_id": 12, "change_to": 1, "change_condition": 1, "missile_id": 1656, "missile": {"speed": 6.0, "splash": 133}, "master_id": 40938, "ranged": true, "variants": [{"hp": 457000, "attack": 4050, "base_hp": 457000, "base_attack": 4050, "damage_type": "physical", "armor_defense": 640, "magic_defense": 15, "attack_speed": 5, "attack_wait": 45, "attack_interval": 158, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171920, "race_id": 12, "master_id": 40939}]}, {"enemy_id": 3, "source": "local", "count": 11, "form_count": 1, "hp": 3500, "attack": 300, "base_hp": 3500, "base_attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 179, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2162336, "race_id": 12, "change_to": 3, "change_condition": 1, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 38998, "global_id": 12615, "ranged": true, "variants": [{"hp": 3500, "attack": 500, "base_hp": 3500, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed