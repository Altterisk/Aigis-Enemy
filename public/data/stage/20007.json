, "attack": 500, "base_hp": 12400, "base_attack": 500, "damage_type": "physical", "armor_defense": 700, "magic_defense": 25, "attack_speed": 60, "attack_wait": 90, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2151568, "master_id": 37237, "global_id": 10854, "spawn_sec": 57}, {"enemy_id": 9, "source": "local", "count": 19, "form_count": 2, "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 90, "attack_wait": 25, "attack_interval": 175, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2165088, "race_id": 12, "change_to": 9, "change_condition": 3, "master_id": 39284, "global_id": 12901, "to_condition": 3, "to_global_id": 12902, "spawn_sec": 57}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 5, "attack_speed": 90, "attack_wait": 25, "attack_interval": 175, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2165104, "race_id": 12, "master_id": 39285, "global_id": 12902, "from_condition": 3}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 2, "hp": 16000, "attack": 900, "base_hp": 16000, "base_attack": 900, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 5, "attack_wait": 60, "attack_interval": 202, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2162096, "race_id": 12, "special_effect_id": 2150, "change_to": 11, "change_condition": 3, "master_id": 39010, "global_id": 12627, "to_condition": 3, "to_global_id": 12628, "spawn_sec": 68}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 16000, "attack": 450, "base_hp": 16000, "base_attack": 450, "damage_type": "true", "armor_defense": 200, "magic_defense": 10, "attack_speed": 5, "attack_wait": 50, "attack_interval": 216, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2162112, "race_id": 12, "special_effect_id": 2151, "master_id": 39011, "global_id": 12628, "from_condition": 3}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 2, "hp": 172000, "attack": 2000, "base_hp": 172000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 300, "attack_speed": 20, "attack_wait": 75, "attack_interval": 241, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118528, "race_id": 12, "change_to": 13, "change_condition": 3, "master_id": 40932, "to_condition": 3, "spawn_sec": 97}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 172000, "attack": 1800, "base_hp": 172000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 300, "attack_range": 200, "attack_speed": 20, "attack_wait": 50, "attack_interval": 137, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2118544, "race_id": 12, "special_effect_id": 374, "missile_id": 357, "missile": {"speed": 10.0}, "master_id": 40933, "ranged": true, "from_condition": 3}], "dialogue": [{"trigger": "start", "lines": [{"name": "リッチ", "text": "一応、花火はまだ無事みたいですな。", "face": "u2863a1"}, {"name": "ボブキャットの獣人", "text": "駄目にする方法が分からなかったもんでね。\nちょうど今、池に沈めるのを思いついたところだよ。", "face": "l3900c52f6a46"}, {"name": "マータン", "text": "……マータンは、もうお前を説得するつもりはない。\nお前は納得しようがなんだろうが、\n最後まで止まらないことが分かったからだ。", "face": "u2862a1"}, {"name": "マータン", "text": "だが、マータンの意見ははっきり言わせてもらうぞ。", "face": "u2862a1"}, {"name": "マータン", "text": "お前の気持ちだとか言いたいことは、\n正直、里の総意ではあるんだと思う。", "face": "u2862a1"}, {"name": "ボブキャットの獣人", "text": "……総意ってことはねぇだろ。\n族長はこんなこと考えてないだろうし、\nお前の親友だってそうだろ？", "face": "l3900c52f6a46"}, {"name": "マータン", "text": "それ以外のみんなは、うっすら抵抗を持ってるだろ。\n他ならぬマータンだってそうだ。", "face": "u2862a1"}, {"name": "マータン", "text": "このまま外の文化とか考え方とか、食べ物とか、置物とか。\nそういうのが里に入ってくるのを考えると……怖い。", "face": "u2862a1"}, {"name": "マータン", "text": "雪枝の里はいいところだ。\nみんな見知った顔で、穏やかないつもが続いていく。", "face": "u2862a1"}, {"name": "マータン", "text": "安心できる毎日が、変わろうとしている。\nそれに無理やりにでも適応しなくちゃならない。\nそんなの最悪だって、マータンも思う。", "face": "u2862a1"}, {"name": "マータン", "text": "その上で、言うぞ。", "face": "u2862a1"}, {"name": "マータン", "text": "――変わらないいつもなんて、あるわけないだろ。", "face": "u2862a1"}, {"name": "ボブキャットの獣人", "text": "……正論だな。", "face": "l3900c52f6a46"}, {"name": "マータン", "text": "お前もマータンも、他の仲間たちだって分かってるはずだ。\n里が変わることを受け入れて、生きるしかないんだって。", "face": "u2862a1"}, {"name": "マータン", "text": "けど、お前たちはこうすることでしか、\n変わることを受け入れられないんだって、\nマータンも分かっている。", "face": "u2862a1"}, {"name": "マータン", "text": "だから里の仲間として止めてやる。", "face": "u2862a1"}, {"name": "マータン", "text": "覚悟しろよ、ボッコボコのギッタギタの、\nぐちゃどろばこーんにしてやるからな。", "face": "u2862a1"}, {"name": "ボブキャットの獣人", "text": "……そりゃどうも。\nなら、大暴れさせてもらうぞ。", "face": "l3900c52f6a46"}, {"name": "ボブキャットの獣人", "text": "とことん、ろくでもないやり方でなぁ！！", "face": "l3900c52f6a46"}, {"name": "エターナー", "text": "花火を手に取った……！？\n貴様、なにをやるつもりだ！？", "face": "u2864a1"}, {"name": "ボブキャットの獣人", "text": "この花火とやらは大層綺麗らしいなぁ！\nだからよぉ、俺たちに教えてくれよ！", "face": "l3900c52f6a46"}, {"name": "ボブキャットの獣人", "text": "一緒に爆ぜて！　どれだけ綺麗か教えてくれよぉ！！", "face": "l3900c52f6a46"}, {"name": "ボブキャットの獣人", "text": "全然綺麗じゃないって、思わせてくれよ……！！", "face": "l3900c52f6a46"}, {"name": "マータン", "text": "ああ、教えてやる。\nお前を倒して、みんなで祭りの準備を終わらせて――", "face": "u2862a1"}, {"name": "マータン", "text": "――祭りの夜に咲く花火を、\nお前に無理やり見せて教えてやる！", "face": "u2862a1"}]}, {"trigger": "end", "lines": [{"name": "マータン", "text": "……気は済んだか？", "face": "u2862a1"}, {"name": "ボブキャットの獣人", "text": "済んでなんかねぇよ。\nだけどもう、指一本動かせねぇからなぁ……。", "face": "l3900c52f6a46"}, {"name": "ボブキャットの獣人", "text": "……俺たちの負けだな。\n当たり前みたいに、惨敗だ。", "face": "l3900c52f6a46"}, {"name": "マータン", "text": "そうか。ようやく諦めがつくな。", "face": "u2862a1"}, {"name": "ボブキャットの獣人", "text": "ああ……もう、我儘言って迷惑かけるのは、やめるよ。", "face": "l3900c52f6a46"}, {"name": "ボブキャットの獣人", "text": "……王国の奴らには、本当に申し訳ない。", "face": "l3900c52f6a46"}, {"name": "ボブキャットの獣人", "text": "あんたらが楽しみにしていた祭りを……。\n大切ないつもを、踏みにじるような真似をしちまった。", "face": "l3900c52f6a46"}, {"name": "マータン", "text": "まったくだぞ！　反省しろ！\nそれでたくさんごめんなさいしてもらうからな！", "face": "u2862a1"}, {"name": "マータン", "text": "あと夏祭りの準備は絶対手伝え！\nこれで開催日に間に合わないとか許さないぞ！", "face": "u2862a1"}, {"name": "マータン", "text": "その後は、王国の手伝いとか色々するんだぞ！\n雪枝の里の者として、やったことの責任は必ず果たせ！", "face": "u2862a1"}, {"name": "マータン", "text": "……それで、手打ちにしてもらえるか？", "face": "u2862a1"}, {"name": "リッチ", "text": "ええ、祭りの手伝いと奉仕活動で、\n王子殿も許してくれると思いますぞ。", "face": "u2863a1"}, {"name": "マータン", "text": "だそうだ。\nきびきび働くんだぞ。", "face": "u2862a1"}, {"name": "エターナー", "text": "さて、これで一件落着か。", "face": "u2864a1"}, {"name": "リッチ", "text": "いやいや、まだ夏祭りの準備がありますぞ。\n滞っていた分、頑張らなくては。", "face": "u2863a1"}, {"name": "マータン", "text": "なるほど、さっそくこいつらの出番みたいだな！", "face": "u2862a1"}, {"name": "エターナー", "text": "……動けるような状態じゃないんじゃないか？", "face": "u2864a1"}, {"name": "マータン", "text": "雪枝の戦士がこれくらいで根を上げるわけないだろ！\n身動きひとつできなくても、気合で働けるはずだ！", "face": "u2862a1"}, {"name": "マータン", "text": "というわけで行くぞお前たち！\n死ぬ気で働くぞー！！　雪枝ワーキング！！", "face": "u2862a1"}]}]}