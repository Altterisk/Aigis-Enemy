k": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 8, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "phases": [{"hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "condition": 3}], "spawn_sec": 187}, {"enemy_id": 10, "source": "local", "count": 1, "level": 60, "form_index": 0, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 10, "change_condition": 2, "master_id": 30503, "global_id": 4122, "to_condition": 2, "to_global_id": 4054, "spawn_sec": 191}, {"enemy_id": 10, "source": "local", "count": 1, "level": 60, "form_index": 1, "form_count": 2, "hp": 6300, "attack": 320, "base_hp": 6300, "base_attack": 320, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30435, "global_id": 4054, "from_condition": 2}], "popups": ["オーク旗手がいる間は\n敵の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "サヨ", "text": "次の話はオークの部族長に挑戦された時の事ね。\nレーゼルさんを助けた時を超える、\nオークの大軍勢との大決戦。", "face": "u510"}, {"name": "サヨ", "text": "あの戦いは、オークに捕まったソーマさんが、\nオークからの言付けを\n預かってきたところから始まったのよね。", "face": "u510"}, {"name": "ソーマ", "text": "――王子、もうすぐオーク軍との戦いですね。\nもう一度、状況を確認してもいいですか？", "face": "u23"}, {"name": "ソーマ", "text": "私が偵察中にオークさんたちに捕まってしまって……、\nオーク部族長から王子への言付けを伝える事を条件に、\nそのまま解放して貰いました。", "face": "u23"}, {"name": "ソーマ", "text": "「王子よ、其方の度重なる武勇は聞いている。\n魔界でも名を轟かせている王子軍を打ち取ったとあれば、\nオレは部族長の長、大部族長になれるであろう。」", "face": "u23"}, {"name": "ソーマ", "text": "「勝手だが、これはオレが大部族長になる試練でもある。\n魔物が領内に滞在していると噂になれば、\n其方も面目が保てないであろう。」", "face": "u23"}, {"name": "ソーマ", "text": "「勝てばオレの『大部族長』への道が開ける。\n負ければ其方の領内から引き上げる。\nどちらが最強か、決闘をしようではないか。」", "face": "u23"}, {"name": "ソーマ", "text": "……オークさん達、凄く戦いを楽しみにしていました。\n100を超えるオークとの激しい戦いになると思います。\n王子、くれぐれも無茶はしないで下さいね！", "face": "u23"}]}, {"trigger": "end", "lines": [{"name": "サヨ", "text": "オーク勇者と王子の一騎打ち。\nすごかったわ。戦いに目を奪われて、\nわたしはすぐにソーマさんに倒されちゃったけど。", "face": "u510"}, {"name": "サヨ", "text": "人を支配するためだけに、強さを求める支配者は\n沢山見てきたけど、この戦いの中で\n王子は違うんだって思った。", "face": "u510"}, {"name": "サヨ", "text": "正々堂々とオークの挑戦を受け止めた、\n王子の戦う姿を見て、\n王子の力は皆を守る為なんだって分かったの。", "face": "u510"}, {"name": "サヨ", "text": "こうして、オークの軍勢を魔界に退けて。\n次の戦いは妖怪総大将、ぬらりひょんとの\n決着の話ね。", "face": "u510"}]}], "map": {"image": "Map920094_5237", "w": 960, "h": 640, "spots": [{"k": "b", "x": 939, "y": 298}, {"k": "b", "x": 940, "y": 482}, {"k": "m", "x": 784, "y": 377, "id": 200}, {"k": "m", "x": 851, "y": 477, "id": 201}, {"k": "m", "x": 760, "y": 477, "id": 202}, {"k": "m", "x": 666, "y": 477, "id": 203}, {"k": "m", "x": 503, "y": 425, "id": 204}, {"k": "m", "x": 611, "y": 221, "id": 205}, {"k": "m", "x": 765, "y": 311, "id": 206}, {"k": "m", "x": 801, "y": 235, "id": 207}, {"k": "m", "x": 312, "y": 280, "id": 208}, {"k": "m", "x": 258, "y": 320, "id": 209}, {"k": "m", "x": 171, "y": 395, "id": 210}, {"k": "m", "x": 676, "y":