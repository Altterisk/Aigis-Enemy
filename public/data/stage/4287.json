, {"enemy_id": 4, "source": "local", "count": 21, "form_index": 0, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 73}, {"enemy_id": 5, "source": "local", "count": 3, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 125}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "報告では、空飛ぶ魔物たちが大量に出現している\nポイントというのはここのはずですが……あれは！", "face": "l56bb55a8b0e9"}, {"name": "アンナ", "text": "空が黒く……！　どうやらあの本隊は\nあそこからやって来ているようです。", "face": "l56bb55a8b0e9"}, {"name": "デーモン", "text": "ご明察。我らデーモンは\n魔界に繋がるこのゲートよりやってきたのだ。", "face": "l27b48b695b23"}, {"name": "デーモン", "text": "大量の空飛ぶ魔物たちを用意したぞ……。\nさぁ、本格的な侵攻がこれから始まる。", "face": "l27b48b695b23"}, {"name": "デーモン", "text": "果たしてこやつらを止めることができるかな？", "face": "l27b48b695b23"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "王子、お疲れ様です。\nサンドラさんもこちらに合流されました。", "face": "l56bb55a8b0e9"}, {"name": "サンドラ", "text": "特訓は完了したわ。これであなたたちの\n力になれる……！", "face": "u248"}, {"name": "サンドラ", "text": "あれは……！", "face": "u248"}, {"name": "アンナ", "text": "魔界に繋がるゲートというものです……。\n敵はあそこを起点に侵攻を目論んでいたようです。", "face": "l56bb55a8b0e9"}, {"name": "サンドラ", "text": "……ということはあの先には\nこの世界に進軍しようとしているデーモンたちが\nまだ控えているはず。", "face": "u248"}, {"name": "サンドラ", "text": "奴らを倒さない限り、\n今回の事態は収束しないでしょうね。", "face": "u248"}, {"name": "アンナ", "text": "サンドラさんのおっしゃる通りですね。\n王子、今すぐ魔界に乗り込み、\nこの戦いの決着をつけましょう！", "face": "l56bb55a8b0e9"}]}], "map": {"image": "Map920042_3900", "w": 960, "h": 640, "spots": [{"k": "b", "x": 27, "y": 306}, {"k": "m", "x": 164, "y": 311, "id": 200}, {"k": "m", "x": 287, "y": 313, "id": 201}, {"k": "m", "x": 402, "y": 310, "id": 202}, {"k": "m", "x": 629, "y": 310, "id": 203}, {"k": "m", "x": 519, "y": 310, "id": 204}, {"k": "m", "x": 760, "y": 185, "id": 205}, {"k": "m", "x": 743, "y": 445, "id": 206}, {"k": "m", "x": 733, "y": 310, "id": 207}, {"k": "m", "x": 836, "y": 310, "id": 208}, {"k": "r", "x": 670, "y": 224, "id": 300}, {"k": "r", "x": 841, "y": 210, "id": 301}, {"k": "r", "x": 826, "y": 420, "id": 302}, {"k": "r", "x": 659, "y": 417, "id": 303}, {"k": "r", "x": 711, "y": 125, "id": 304}, {"k": "r", "x": 686, "y": 522, "id": 305}, {"k": "r", "x": 559, "y": 72, "id": 306}, {"k": "r", "x": 537, "y": 443, "id": 307}]}, "start_cost": 30, "active": true}