 6.0, "splash": 133}, "master_id": 314, "global_id": 313, "ranged": true, "spawn_sec": 156}, {"enemy_id": 8, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "hp": 1800, "attack": 200, "base_hp": 1800, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 101, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101552, "race_id": 16, "missile_id": 6, "master_id": 315, "global_id": 314, "ranged": true, "spawn_sec": 157}, {"enemy_id": 9, "source": "local", "count": 10, "form_index": 0, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 165}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_range": 160, "attack_speed": 70, "attack_wait": 45, "attack_interval": 141, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 10, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 70, "global_id": 69, "ranged": true, "to_condition": 0, "to_global_id": 533, "spawn_sec": 212}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1300, "attack": 350, "base_hp": 1300, "base_attack": 350, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 45, "attack_interval": 211, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098208, "race_id": 9, "change_to": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 534, "global_id": 533, "from_condition": 0}], "popups": ["ベルゼビュートの配下の\n一定範囲内のユニットは攻撃力低下と\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "教団員", "text": "どうしたら……ああ、どうしたらいいのだ……。\nこのままではベルゼビュート様の復活が……。\nアイーダ、どうすればいいのだ……？", "face": "lfc9619810aa7"}, {"name": "アイーダ", "text": "……少し黙っててくれないか！？\n（こうなれば、この身がどうなってでも、\n王子を何とかして倒すしか……。）", "face": "u381"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……いい加減にするのだ……！", "face": "l60231936c46a"}, {"name": "ベルゼビュートの配下", "text": "ここにいる者すべてで互いに協力しなくては、\nやつらを倒せないのは明白だ……。", "face": "l60231936c46a"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……ベルゼビュート様も、\n我らが力を合わせて戦うことを\nきっと望んでおられる……ブブッ。", "face": "l60231936c46a"}, {"name": "教団員", "text": "ベルゼビュート様が……！\nそうだ、目的が同じであれば、我々は仲間同士\nであるはずだ。なぜ気が付かなかったのか！", "face": "lfc9619810aa7"}, {"name": "アイーダ", "text": "……仲間ではない……。\nが、背に腹はかえられない。\n協力するしかないな。", "face": "u381"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……。\nベルゼビュート様の為だ、\n私も戦闘に参加する……ブブッ。", "face": "l60231936c46a"}, {"name": "兵士", "text": "報告！\n前方から敵が進軍してきます！", "face": "l408d498445ba"}, {"name": "アンナ", "text": "あの編成や布陣から察するに、\n相手も後がないということでしょうね……。\n王子、慎重なご采配をお願い致します！", "face": "l8de2e2200bf7"}]}, {"trigger": "end", "lines": [{"name": "教団員", "text": "だ、ダメだ……もう終わりだ……。\nベルゼビュート様を、御守りすることは、\n私達にはできないのだ……うぅぅ……。", "face": "lfc9619810aa7"}, {"name": "アイーダ", "text": "くそ……。\nこのままではベルゼビュート様が、\n奴らの手に……。", "face": "u381"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……。\n万事休す……ブブッ……。", "face": "l60231936c46a"}, {"name": "ベルゼビュートの配下", "text": "――ブブッ！？　そ、そんな……まさか……！？\nべ、ベルゼビュート様の声が……いけません！　\nまだ復活するには……早すぎます！", "face": "l60231936c46a"}, {"name": "アイーダ", "text": "……え？\n復活……？　ベルゼビュート様が？\nどういうことだ！？　力を取り戻されたのか！？", "face": "u381"}, {"name": "ベルゼビュートの配下", "text": "ブブッ……分からぬ……。\nだが、ベルゼビュート様に異変が起きていることは\n確かだ。一刻も早くベルゼビュート様の元に！！", "face": "l60231936c46a"}, {"name": "兵士", "text": "敵の撤退を確認！\n全軍、森の奥へと退いていきます。", "face": "l408d498445ba"}, {"name": "兵士", "text": "前線の兵士の報告によると、\n敵側はベルゼビュートが復活したと\n騒いでいたようです！", "face": "l408d498445ba"}, {"name": "アンナ", "text": "ベルゼビュートが復活……！？\n王子、急ぎ彼らを追いかけましょう！", "face": "l8de2e2200bf7"}]}], "map": {"image": "Map920072_3200", "w": 960, "h": 640, "spots": [{"k": "b", "x": 510, "y": 229}, {"k": "m", "x": 421, "y": 257, "id": 200}, {"k": "m", "x": 491, "y": 416, "id": 201}, {"k": "m", "x": 396, "y": 397, "id": 202}, {"k": "m", "x": 312, "y": 369, "id": 203}, {"k": "m", "x": 243, "y": 309, "id": 204}, {"k": "m", "x": 179, "y": 240, "id": 205}, {"k": "m", "x": 101, "y": 239, "id": 206}, {"k": "m", "x": 235, "y": 184, "id": 207}, {"k": "m", "x": 306, "y": 127, "id": 208}, {"k": "m", "x": 742, "y": 166, "id": 209}, {"k": "m", "x": 747, "y": 239, "id": 210}, {"k": "m", "x": 765, "y": 318, "id": 211}, {"k": "m", "x": 785, "y": 400, "id": 212}, {"k": "m", "x": 692, "y": 421, "id": 213}, {"k": "m", "x": 585, "y": 421, "id": 214}, {"k": "m", "x": 366, "y": 192, "id": 215}, {"k": "m", "x": 530, "y": 313, "id": 216}, {"k": "m", "x": 539, "y": 372, "id": 217}, {"k": "m", "x": 367, "y": 87, "id": 218}, {"k": "m", "x": 866, "y": 420, "id": 219}, {"k": "m", "x": 809, "y": 138, "id": 220}, {"k": "r", "x": 379, "y": 290, "id": 300}, {"k": "r", "x": 395, "y": 450, "id": 301}, {"k": "r", "x": 609, "y": 468, "id": 302}, {"k": "r", "x": 751, "y": 463, "id": 303}, {"k": "r", "x": 850, "y": 339, "id": 304}, {"k": "r", "x": 739, "y": 89, "id": 305}, {"k": "r", "x": 430, "y": 350, "id": 306}, {"k": "r", "x": 127, "y": 173, "id": 307}, {"k": "r", "x": 614, "y": 277, "id": 308}, {"k": "r", "x": 184, "y": 339, "id": 309}, {"k": "r", "x": 633, "y": 368, "id": 310}, {"k": "r", "x": 300, "y": 200, "id": 311}]}, "active": true}