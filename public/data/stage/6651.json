"magic_defense": 10, "attack_range": 200, "attack_speed": 70, "attack_wait": 80, "attack_interval": 251, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099824, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 197, "global_id": 196, "ranged": true, "spawn_sec": 110}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 4000, "attack": 500, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 210, "attack_speed": 70, "attack_wait": 80, "attack_interval": 206, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2104080, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 497, "global_id": 496, "ranged": true, "spawn_sec": 132}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 1000, "attack": 400, "base_hp": 1000, "base_attack": 400, "damage_type": "physical", "armor_defense": 150, "attack_speed": 20, "attack_wait": 10, "attack_interval": 86, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098592, "race_id": 2, "master_id": 148, "global_id": 147, "spawn_sec": 158}], "dialogue": [{"trigger": "start", "lines": [{"name": "カミラ", "text": "寒い日に食べると、\n焼きマシュマロがよりいっそう甘く感じますね。", "face": "u724"}, {"name": "ハクノカミ", "text": "うむ、甘くてとろけるようじゃ。はふはふ……。\nリノがおって本当に助かったのう……。", "face": "u458"}, {"name": "リノ", "text": "こんなに寒くちゃ風邪引いちゃうからね。\nサラマンダー、火力そのままね！", "face": "u350"}, {"name": "ハクノカミ", "text": "はぁ……わらわは模擬戦などしとうない。\nこのままぬくぬくしながら、\nましゅまろを食べている方が良いに決まっておる。", "face": "u458"}, {"name": "ハクノカミ", "text": "カミラもここにおれば良いぞ。\n無粋な輩は、わらわがぬくぬくしたまま\n蹴散らしてやるからのう。", "face": "u1458"}, {"name": "エリザ", "text": "――リュリュ、あちらへ行かなくていいの？\nここにいても寒いだけでしょう。", "face": "u198"}, {"name": "リュリュ", "text": "いえ、ここで良いんです。\nあっ、次は雪うさぎを作りましょう！", "face": "u203"}, {"name": "エリザ", "text": "……そう。あなたも少し、変わっているのね。\nいいわ、もう少し雪遊びを続けましょうか。", "face": "u198"}, {"name": "シャルロット", "text": "――何だか敵役の方々、\nくつろいでいる気がしますわ。", "face": "u556"}, {"name": "フィリス", "text": "あっちにはリノのサラマンダーがいるのか……。\n暖かそうだ……うらやましい……。", "face": "u40"}, {"name": "ケイティ", "text": "あの、ゴライアさん……？\nそろそろ模擬戦を開始しても良いですか？", "face": "u114"}, {"name": "ゴライア", "text": "……ハクノカミ様も、戦闘が始まりさえすれば、\nきっとやる気を出しテくださるハズダ。きっとナ……。", "face": "u385"}, {"name": "シャルロット", "text": "はぁ、私もぽかぽかぬくぬくしたいですわ……。\nこうなったら王子、私も最前線で戦って、\nリノをこの手に奪取してやりますわー！", "face": "u556"}, {"name": "アンナ", "text": "……あれ？　救出するのはリノさんではなく、\nカミラさんだったような……？", "face": "l60362c483024"}, {"name": "ケイティ", "text": "まぁ、やる気があるのは良いことでしょう。\nそれでは王子、模擬戦を開始します！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "シャルロット", "text": "大・勝・利！　ですわー！\nさぁリノ、サラマンダーの火力高めでお願いしますわ♪", "face": "u556"}, {"name": "ハクノカミ", "text": "こんな寒い日に元気なものじゃなぁ……。\nほれ、皆も一緒に暖を取るがよい。", "face": "u458"}, {"name": "リュリュ", "text": "マシュマロもおいしいです。\nあっ、よかったらエリザさんも一個どうぞ♪", "face": "u203"}, {"name": "エリザ", "text": "……あら、ありがとう。\nリュリュの誘いなら、乗ってあげようかしら。", "face": "u198"}, {"name": "リノ", "text": "ふふん、やっぱり寒い日は甘くて温かいものよね♪", "face": "u350"}, {"name": "カミラ", "text": "はぁ……温まります……。\n王子も一個、いかがですか？", "face": "u724"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ソーマ", "text": "はぁ……ぽかぽかです……。\nリノさんとサラマンダーさんがいて良かったぁ……。", "face": "u23"}, {"name": "フィリス", "text": "ほんとほんと……。\nよぉし、もっと頑張れそうな気がしてきたぞ！", "face": "u40"}, {"name": "ケイティ", "text": "それでは、身体が温まったら\n次の模擬戦に移りましょうか。", "face": "u114"}]}], "story_talk": true, "active": true}