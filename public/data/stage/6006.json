{"quest_id": 6006, "name": "ドゥーラの鍛錬", "description": "試合前の束の間の休息。\n大会会場を見て回る\n王子たちだが……。\n上級（★１獲得の目安：平均Lv10）", "event": "魔界武術大会", "event_category": "History", "mission_id": 920083, "map_no": 3947, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_count": 2, "hp": 1200, "attack": 300, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 80, "attack_speed": 60, "attack_wait": 50, "attack_interval": 221, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106320, "race_id": 8, "change_to": 1, "change_condition": 3, "master_id": 800, "global_id": 799, "to_condition": 3, "to_global_id": 800, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1200, "attack": 500, "base_hp": 1200, "base_attack": 500, "damage_type": "physical", "armor_defense": 130, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106336, "race_id": 8, "master_id": 801, "global_id": 800, "from_condition": 3}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106496, "race_id": 8, "change_to": 3, "change_condition": 3, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 387, "global_id": 386, "ranged": true, "to_condition": 3, "to_global_id": 387, "spawn_sec": 37}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 100, "attack_wait": 50, "attack_interval": 146, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106512, "race_id": 8, "special_effect_id": 234, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 388, "global_id": 387, "ranged": true, "from_condition": 3}, {"enemy_id": 5, "source": "local", "count": 8, "form_count": 2, "hp": 4000, "attack": 400, "base_hp": 4000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102224, "race_id": 8, "change_to": 5, "change_condition": 3, "master_id": 366, "global_id": 365, "to_condition": 3, "to_global_id": 366, "spawn_sec": 58}, {"enemy_id": 5, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4000, "attack": 600, "base_hp": 4000, "base_attack": 600, "damage_type": "physical", "armor_defense": 450, "attack_speed": 40, "attack_wait": 10, "attack_interval": 126, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102240, "race_id": 8, "master_id": 367, "global_id": 366, "from_condition": 3}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 1200, "attack": 280, "base_hp": 1200, "base_attack": 280, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 109, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097696, "race_id": 11, "master_id": 39, "global_id": 38, "spawn_sec": 98}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 40, "attack_wait": 40, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2108896, "race_id": 8, "change_to": 8, "change_condition": 3, "master_id": 30119, "global_id": 3738, "to_condition": 3, "to_global_id": 3739, "spawn_sec": 145}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 30, "attack_wait": 10, "attack_interval": 91, "move_speed": 1200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108928, "race_id": 8, "master_id": 30120, "global_id": 3739, "from_condition": 3}, {"enemy_id": 10, "source": "local", "count": 7, "form_count": 1, "hp": 1600, "attack": 400, "base_hp": 1600, "base_attack": 400, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5499999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097344, "race_id": 11, "master_id": 14, "spawn_sec": 151}], "dialogue": [{"trigger": "start", "lines": [{"name": "ドゥーラ", "text": "――ここが前回のチャンピオンが作らせた、\nジャングルを模した訓練設備だ。", "face": "u446"}, {"name": "ソーマ", "text": "……すごい。\nまるで地上のジャングルのようですね。", "face": "u23"}, {"name": "ドゥーラ", "text": "古くから続く伝統ある大会……。\nそれも、魔界じゃ数少ない大きな行事のひとつだ。\n優勝すればこれくらいの無茶も許されるってわけさ。", "face": "u446"}, {"name": "ドゥーラ", "text": "それに、優勝者の言葉を無下にしようものなら\n大会に泥を塗る事になるからな。アンタらが\n優勝すれば捕虜の解放だって造作無しだろうよ。", "face": "u446"}, {"name": "ケイティ", "text": "グレーターデーモンが捕虜を解放するのか\n不安でしたが、そういう事でしたら安心ですね。", "face": "u114"}, {"name": "ドゥーラ", "text": "まぁ、あくまでも優勝できたらの話だがな。", "face": "u446"}, {"name": "アンナ", "text": "大丈夫です！　今のところ王子は絶好調ですから。\nこのままいけば、絶対に優勝できるはずです！"}, {"name": "ドゥーラ", "text": "……おいおい。もしかしてオレの力を甘く見てないか？\n前回は60%程度しか出していなかったんだが……。\nいいだろう、なら今ここで80%の力を見せてやるよ！", "face": "u446"}, {"name": "アンナ", "text": "――えッ！？　\nな、なんでそうなるのですか！？", "face": "l56c326368b3a"}, {"name": "ドゥーラ", "text": "つべこべ言わずに戦いの準備をしろ！\nなぁに、前哨戦みたいなもんさ……行くぞ！", "face": "u446"}]}, {"trigger": "end", "lines": [{"name": "ドゥーラ", "text": "ふーっ、いい汗かいたぜ！\nやっぱり強いな、王子は。　", "face": "u446"}, {"name": "ソーマ", "text": "はうぅ……オーク族の方は、\nやはり闘いになると\n人が変わってしまうようですね……。", "face": "u23"}, {"name": "アイーダ", "text": "――……探したぞ、ドゥーラ。\nそろそろ私達の試合が始まるぞ。", "face": "u381"}, {"name": "ドゥーラ", "text": "……あっ！　すまねぇっ！　\nつい、昂っちまってよ。\n……すぐ行くから待っててくれ！　", "face": "u446"}, {"name": "ドゥーラ", "text": "というわけだ王子、次やるときは決勝だな。\nその時はオレの本気を見せてやるよ！　\nそれじゃあな……。", "face": "u446"}, {"name": "ソーマ", "text": "…………行ってしまわれました。\n見たところ、ドゥーラさんのチームには、\n弓の使い手の方もいらっしゃるようですね。", "face": "u23"}, {"name": "アンナ", "text": "王子、どうやらこのままいくと決勝では、\n本気のドゥーラさんと戦う事になりそうですね。", "face": "l56c326368b3a"}, {"name": "アンナ", "text": "（あれ？　でも待って下さい。さっきので80％\nという事は、ほぼ全力というわけですから……）"}, {"name": "アンナ", "text": "王子、これなら勝ち目はありそうですね！\n絶対にこの大会、優勝しましょう！！"}]}], "active": true}