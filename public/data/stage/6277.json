{"quest_id": 6277, "name": "封鎖されしピラミッド", "description": "遺跡より湧き出づる無数の亡者達。\n迫る魔物の脅威を振り払え！\n＜出撃時の初期ＨＰ減少：小＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["出撃時の初期ＨＰ減少：小"], "event": "大怪盗とピラミッドの秘宝", "event_category": "History", "mission_id": 920098, "map_no": 5252, "level": 90, "multiplier": 0.9, "charisma": 50, "capacity": 8, "modifiers": [{"kind": "term", "influence": 9, "params": [20], "expression": "!IsPlayerSupportUnit();", "expression_human": "it is not a borrowed support unit"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 10800, "attack": 260, "base_hp": 12000, "base_attack": 260, "damage_type": "physical", "armor_defense": 210, "magic_defense": 30, "attack_range": 100, "attack_speed": 70, "attack_wait": 30, "attack_interval": 93, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112048, "race_id": 12, "special_effect_id": 193, "missile_id": 45, "master_id": 30641, "global_id": 4260, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 13500, "attack": 675, "base_hp": 15000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 161, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098304, "special_effect_id": 195, "master_id": 30644, "global_id": 4263, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 15, "form_count": 1, "tags": ["アンデッド"], "hp": 3600, "attack": 270, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 8, "form_count": 1, "hp": 1080, "attack": 270, "base_hp": 1200, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 10, "attack_wait": 10, "attack_interval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098416, "race_id": 2, "master_id": 85, "global_id": 84, "spawn_sec": 5}, {"enemy_id": 5, "source": "local", "count": 4, "form_count": 1, "hp": 900, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_range": 170, "attack_speed": 90, "attack_wait": 25, "attack_interval": 131, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098432, "race_id": 2, "missile_id": 15, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 87, "global_id": 86, "ranged": true, "spawn_sec": 16}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 1620, "attack": 450, "base_hp": 1800, "base_attack": 500, "damage_type": "physical", "armor_defense": 180, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098368, "race_id": 2, "master_id": 88, "global_id": 87, "spawn_sec": 32}, {"enemy_id": 7, "source": "local", "count": 9, "form_count": 1, "tags": ["ステルス"], "hp": 1350, "attack": 180, "base_hp": 1500, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 60, "attack_wait": 30, "attack_interval": 173, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098144, "master_id": 91, "global_id": 90, "spawn_sec": 51}], "dialogue": [{"trigger": "start", "lines": [{"name": "サバル", "text": "さぁ、ピラミッドはこっちだよ……おおっと？", "face": "u536"}]}, {"trigger": "start", "lines": [{"name": "アンナ", "text": "あれは……魔物達がピラミッドの入り口を\nまるで封鎖するように……。", "face": "lbfab4fba6540"}, {"name": "サバル", "text": "呪われた宝石の欠片には、\nマミー達を操る力もあるみたいだったね。\n連中が用意した門番ってところか。", "face": "u536"}, {"name": "サバル", "text": "さて、あの厳重な警備。\n一体どうやって掻い潜ろうか……。", "face": "u536"}, {"name": "ケイティ", "text": "……皆さん、準備は良いですか。\n合図に併せて一斉に敵を鎮圧します。", "face": "u114"}, {"name": "兵士", "text": "はっ！　既に配備は完了しております！！\nいつでもご指示を頂ければと！", "face": "ldd0cb2bed291"}, {"name": "ケイティ", "text": "判りました、それでは……。", "face": "u114"}, {"name": "サバル", "text": "ちょ、ちょ、ちょっと待ってくれ。\n流石にあの警備、正面突破は無謀じゃないか。", "face": "u536"}, {"name": "ケイティ", "text": "ですが、既に敵が内部に侵入しているとなれば、\n悠長にしている時間はあまりないかと。", "face": "u114"}, {"name": "サバル", "text": "まったく、急がば回れって奴だ。焦ってる時こそ、\n落ち着いて活路を見出す事こそが盗みの――", "face": "u536"}, {"name": "兵士", "text": "――ほ、報告です！　\n魔物達に気付かれた模様！\nこちらに向かってきます！！", "face": "ldd0cb2bed291"}, {"name": "サバル", "text": "……遅かったか。", "face": "u536"}, {"name": "ケイティ", "text": "各員、戦闘の用意を！\n……見慣れない魔物もいるようですね。\n獣人のマミーでしょうか？", "face": "u114"}, {"name": "アンナ", "text": "あの獣人のマミーが持つ武器、\n広域への攻撃に秀でてるようにも見えます。\nどうかお気をつけください、王子。", "face": "lbfab4fba6540"}]}, {"trigger": "end", "lines": [{"name": "兵士", "text": "――ほ、報告です！　ピラミッド内部から、\n敵の増援が多数出現！\n先ほどの倍以上の数です！", "face": "ldd0cb2bed291"}, {"name": "モーティマ", "text": "ったく、次から次にキリがねーぞ！", "face": "u14"}, {"name": "ケイティ", "text": "くっ……正面突破は難しいですか……！", "face": "u114"}, {"name": "サバル", "text": "――皆、こっちだ！　急いで！！", "face": "u536"}, {"name": "アンナ", "text": "サバルさん、一体どこへ？", "face": "lbfab4fba6540"}, {"name": "サバル", "text": "ピラミッドの内部に通じる裏道を見つけた。\nそっち側のほうが、警備は手薄みたいだ！", "face": "u536"}, {"name": "アンナ", "text": "ありがとうございます、サバルさん！\n案内をお願いします！"}]}], "active": true}