ical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 90, "attack_wait": 30, "attack_interval": 201, "move_speed": 180.0, "gain_cost": 3, "dot_rate": 2.0999999046325684, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098304, "special_effect_id": 227, "master_id": 99, "global_id": 98, "spawn_sec": 110}, {"enemy_id": 9, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 600, "base_hp": 20000, "base_attack": 600, "damage_type": "magical", "armor_defense": 400, "attack_range": 200, "attack_speed": 90, "attack_wait": 60, "attack_interval": 181, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109984, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30239, "global_id": 3858, "ranged": true, "spawn_sec": 118}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "hp": 50000, "attack": 850, "base_hp": 50000, "base_attack": 850, "damage_type": "physical", "armor_defense": 300, "attack_range": 210, "attack_speed": 115, "attack_wait": 100, "attack_interval": 261, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2113072, "race_id": 16, "special_effect_id": 216, "change_to": 10, "change_condition": 1, "missile_id": 245, "missile": {"speed": 5.0}, "master_id": 30782, "global_id": 4401, "ranged": true, "variants": [{"hp": 50000, "attack": 2700, "base_hp": 50000, "base_attack": 2700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 120, "attack_wait": 120, "attack_interval": 441, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2113168, "race_id": 16, "master_id": 30783, "global_id": 4402}], "spawn_sec": 126}, {"enemy_id": 12, "source": "local", "count": 4, "form_count": 1, "hp": 2000, "attack": 600, "base_hp": 2000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_range": 180, "attack_speed": 70, "attack_wait": 20, "attack_interval": 95, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109872, "race_id": 16, "special_effect_id": 72, "missile_id": 198, "missile": {"speed": 12.0}, "master_id": 30205, "global_id": 3824, "ranged": true, "spawn_sec": 150}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108544, "race_id": 16, "special_effect_id": 54, "master_id": 30038, "global_id": 3657, "spawn_sec": 158}, {"enemy_id": 14, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 12000, "attack": 260, "base_hp": 12000, "base_attack": 260, "damage_type": "physical", "armor_defense": 210, "magic_defense": 30, "attack_range": 100, "attack_speed": 70, "attack_wait": 30, "attack_interval": 93, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2112048, "race_id": 12, "special_effect_id": 193, "missile_id": 45, "master_id": 30641, "global_id": 4260, "ranged": true, "spawn_sec": 162}], "dialogue": [{"trigger": "start", "lines": [{"name": "ヒューナ", "text": "ふぅ、アンデッドはあらかた片付いたかしら？", "face": "u627"}, {"name": "アンナ", "text": "まだ油断は出来ません。報告にあったよりも、\n敵の数が少なすぎる様な気がします。\nまだまだ気を抜かないでください！", "face": "l26f6d378e2bc"}, {"name": "ヒューナ", "text": "とはいえ周囲に敵の姿は……って、\nあれ、アサルじゃないかしら？", "face": "u627"}, {"name": "アサル", "text": "王子ー！　大変です！\n遠くから新手の敵が接近中です！", "face": "u172"}, {"name": "フーリ", "text": "あれは……もしかして……！", "face": "u174"}, {"name": "ケイティ", "text": "フーリさん、何か心当たりが？", "face": "u114"}, {"name": "フーリ", "text": "古代に栄えた亡国の民を名乗る者達が、\n砂漠周辺で蜂起したと聞いた覚えがあるんです。", "face": "u174"}, {"name": "アサル", "text": "それから、戦象の姿も確認出来ますね……。", "face": "u172"}, {"name": "ヒューナ", "text": "象って、あのぱおーんって鳴く？", "face": "u627"}, {"name": "フーリ", "text": "そうです、ぱおーんって鳴く象さんです……！！", "face": "u174"}, {"name": "ヒューナ", "text": "どうやら、まだまだ戦いは終わらないみたいね。\n王子、私は向こうの敵を相手するから、\nこっち側は任せたわ。頼りにしてるからね。", "face": "u627"}, {"name": "アンナ", "text": "王子、敵は魔物との混成部隊のようです。\n注意して対応してください！", "face": "l26f6d378e2bc"}]}, {"trigger": "end", "lines": [{"name": "ヒューナ", "text": "そっちも片付いたみたいね。", "face": "u627"}, {"name": "シャロン", "text": "さすがはクロスボウさんが言うところの、\n「世界で最も美しき力」ね♪", "face": "u283"}, {"name": "ヒューナ", "text": "……んっ、あれ……？", "face": "u627"}, {"name": "ヒューナ", "text": "確かに私のクロスボウは力を解放したけれど、\n王子たちへの報酬だったはずの、\n「世界で最も美しき力」って何だったのかしら……？", "face": "u627"}, {"name": "ケイティ", "text": "……それはたぶん、その、親心というか、\n親馬鹿めいた言葉だったのではないかと。", "face": "u114"}, {"name": "フーリ", "text": "ヒューナさんの仲間探しの為に、\nあんな大掛かりな試練を、\n用意しちゃう方ですからね、クロスボウさんは。", "face": "u174"}, {"name": "ヒューナ", "text": "ちょっと、どういうことよー！\n誰か説明してよぉ……！\n王子、あなたは何か知ってるの……！？", "face": "u627"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ヒューナ", "text": "えっ、えぇと……えぇっ！？\n報酬は、私が仲間に、なること……？", "face": "u627"}, {"name": "フーリ", "text": "相棒の射手を評して「世界で最も美しい」なんて、\nクロスボウさんはヒューナさんのこと、\nとーってもお気に入りみたいですよね♪", "face": "u174"}, {"name": "ヒューナ", "text": "うっ、うぅ、は、はずかし……。\nこういうの恥ずかしすぎるわ……。\n気付いてたなら、もっと早く教えてよぉ……！！", "face": "u627"}, {"name": "ヒューナ", "text": "（……でも、ありがとう、王子、皆。\nこれからもずーっと、よろしくね？）", "face": "u627"}]}], "active": true}