cal", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_range": 130, "attack_speed": 40, "attack_wait": 1, "attack_interval": 33, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103392, "race_id": 8, "missile_id": 113, "missile": {"speed": 10.0}, "master_id": 443, "global_id": 442, "ranged": true, "from_condition": 3}, {"enemy_id": 31, "source": "local", "count": 4, "form_index": 0, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103408, "race_id": 8, "change_to": 31, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 444, "global_id": 443, "ranged": true, "to_condition": 3, "to_global_id": 444, "route_behaviour": {"sets_flags": [[0, 1, 0]]}, "spawn_sec": 159}, {"enemy_id": 31, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "magical", "armor_defense": 150, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103424, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 445, "global_id": 444, "ranged": true, "from_condition": 3}], "popups": ["オークの勇者はHPが\n徐々に減少していきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "蘇ったオーク勇者", "text": "――おお、久方ぶりの物質界だ。\nここは白の帝国だな。\nははは、昔もこの辺りまで攻め込んだものよ！", "face": "lb2983dc719b8"}, {"name": "ハイオーク", "text": "おぉ、おぉ！\n先代、再びお会いできる日が来るとは……！！", "face": "l7bf980320ebd"}, {"name": "蘇ったオーク勇者", "text": "ワシだけではないぞ。\nもう一度戦えると聞いてな、\n居ても立っても居られぬ馬鹿を連れてきてやったわ。", "face": "lb2983dc719b8"}, {"name": "ハイオーク", "text": "歴代の勇者たちが……この地に……！\n勝てる、おぉぉ、勝てるぞ、この戦……！！", "face": "l7bf980320ebd"}, {"name": "蘇ったオーク勇者", "text": "――だがなぁ、呼び声に応えてしまったワシらも悪いが、\nあまり死者に頼るでないぞ、若いの。", "face": "lb2983dc719b8"}, {"name": "ハイオーク", "text": "はっ……なにゆえですか？\nこうして肩を並べて戦えるというのに！", "face": "l7bf980320ebd"}, {"name": "蘇ったオーク勇者", "text": "馬鹿者が、ワシらがいつまでも戦っていたら、\nお前たちの戦果を奪ってしまうだろうが！", "face": "lb2983dc719b8"}, {"name": "蘇ったオーク勇者", "text": "――だが、だからこそ、この戦はワシらのものよ。\n戦果を取られたくなければ、\n臆せずついてこい、今代のオークたちよ！！", "face": "lb2983dc719b8"}, {"name": "マレブランケ", "text": "――本当に死者を、それもオーク勇者を蘇らせるとは。\nハイドースの権能は底なしなのかい？", "face": "u1225a1"}, {"name": "トラム", "text": "如何に亜神と言えど、自由に蘇らせられるはずがない。\n無尽蔵に召喚できるなら、\nいまごろ物質界は死者で溢れているはずだもの。", "face": "u1110a1"}, {"name": "ヘカティエ", "text": "……えぇ、でも限界がどこにあるかは分からないわ。\nハイドース様が死者を蘇らせるところを見るの、\n今回が初めてだから……。", "face": "u1226a1"}, {"name": "マレブランケ", "text": "だが、限りがあると分かれば戦いようもある。\n手の内の分からない敵ではないのだから、\nこれまでどおり蹴散らしてやればいいのだ。", "face": "u1225a1"}, {"name": "トラム", "text": "そういうことよ。\nさぁ王子、剣を構えなさい。\nあなたの前に立ちふさがるのは――オークの伝説よ！！", "face": "u1110a1"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "あれだけ倒しても、まだ攻めてくるのか。\n先ほどまでとは士気が段違いだぞ！", "face": "u311"}, {"name": "アトナテス", "text": "当たり前だ、伝説の存在に焚き付けられたんだぞ。\nだからこそタチが悪いんだがな……。", "face": "u908"}, {"name": "ユージェン", "text": "…………？\nえぇと、どういうことだ……？", "face": "u906"}, {"name": "アトナテス", "text": "憧れの存在ってのは、毒にも薬にもなるってことだ。\nユージェン、お前も気をつけておけよ。", "face": "u908"}, {"name": "ユージェン", "text": "……ん、分かった。\nでも本当に気をつけるべきなのは武人としての\n伝承が残るアトナテスおじさまの――ん、何だ、この音？", "face": "u906"}, {"name": "アトナテス", "text": "これは……まずいな……。\n王子、気を抜くな――来るぞ！", "face": "u908"}, {"name": "ユージェン", "text": "――そんなバカな。\n皆、気を抜くな！　オーク勇者が立ち上がった！", "face": "u906"}, {"name": "蘇ったオーク勇者", "text": "――ハハッ、今の世を生きる若人たちに、\nこんな捨て身の攻撃をさせるわけにはいかねぇからなぁ。", "face": "lb2983dc719b8"}, {"name": "ヘカティエ", "text": "あれだけの攻撃を受けて、何故進めるの……。\nもう何度も倒れたはずだというのに。", "face": "u1226a1"}, {"name": "蘇ったオーク勇者", "text": "おお、ハイドース様の小間使いか。\nワシらの戦いぶり、どうかあの御方に伝えてくれよ。", "face": "lb2983dc719b8"}, {"name": "蘇ったオーク勇者", "text": "さぁ、若者の道を切り開くのは、\n死にゆく老兵の役割だ――まぁ、もう死んでるんだがなぁ！", "face": "lb2983dc719b8"}, {"name": "レオナ", "text": "なっ……まさか貴様、城門を破壊するつもりで……！？", "face": "u311"}, {"name": "蘇ったオーク勇者", "text": "見くびってもらっては困る。\n城門なんざワシらの敵じゃないぞ。\nここはひとつ、城壁に穴あけてやらァッ！！", "face": "lb2983dc719b8"}]}], "active": true}