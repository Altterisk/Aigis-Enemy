d": 55, "attack_wait": 10, "attack_interval": 172, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2097248, "race_id": 3, "master_id": 6, "spawn_sec": 154}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "魔神を復活させようだなんて……。", "face": "l473d5d4c04bd"}, {"name": "アンナ", "text": "もしそれが叶ってしまったら、\n王国にも被害がおよび、たくさんの犠牲者が\n出てしまいます。", "face": "l473d5d4c04bd"}, {"name": "アンナ", "text": "それにレイブンさんの幼馴染を\n魔神への供物にしようだなんて……。\nそんな酷いことはさせません。", "face": "l473d5d4c04bd"}, {"name": "アンナ", "text": "王子、なんとしても助けましょう！", "face": "l473d5d4c04bd"}, {"name": "レイブン", "text": "そう言っていただけて助かる……。\nありがとう……。", "face": "u265"}, {"name": "レイブン", "text": "この地下を奥へ進んでいくと、教団の集会所だ。\nそこに祈りを捧げるための祭壇がある。\n彼女はそこにいると見て間違いない。", "face": "u265"}, {"name": "アンナ", "text": "あそこに魔法陣が見受けられますが……。", "face": "l473d5d4c04bd"}, {"name": "レイブン", "text": "あの魔法陣は強力な魔物を呼び出すための\n召喚魔法で使うものだ。\n注意しておいた方が良いな。", "face": "u265"}, {"name": "レイブン", "text": "む、来るぞ！", "face": "u265"}]}, {"trigger": "end", "lines": [{"name": "レイブン", "text": "さすがにこれを一人で\n突破するのは難しかったな。\nありがとう。王子。", "face": "u265"}, {"name": "レイブン", "text": "祭壇はもう少し先だ。慎重に進もう。", "face": "u265"}]}], "map": {"image": "Map920047_3595", "w": 960, "h": 640, "spots": [{"k": "b", "x": 22, "y": 168}, {"k": "b", "x": 948, "y": 285}, {"k": "m", "x": 334, "y": 328, "id": 200}, {"k": "m", "x": 505, "y": 420, "id": 201}, {"k": "m", "x": 423, "y": 278, "id": 202}, {"k": "m", "x": 321, "y": 428, "id": 203}, {"k": "m", "x": 507, "y": 326, "id": 204}, {"k": "m", "x": 413, "y": 474, "id": 205}, {"k": "m", "x": 231, "y": 279, "id": 206}, {"k": "m", "x": 600, "y": 371, "id": 207}, {"k": "m", "x": 242, "y": 377, "id": 208}, {"k": "m", "x": 624, "y": 286, "id": 209}, {"k": "m", "x": 703, "y": 245, "id": 210}, {"k": "m", "x": 621, "y": 117, "id": 211}, {"k": "m", "x": 695, "y": 156, "id": 212}, {"k": "m", "x": 384, "y": 109, "id": 213}, {"k": "m", "x": 541, "y": 76, "id": 214}, {"k": "m", "x": 147, "y": 229, "id": 2