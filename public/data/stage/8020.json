form_count": 1, "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100624, "race_id": 18, "special_effect_id": 220, "master_id": 272, "global_id": 271, "spawn_sec": 180}, {"enemy_id": 13, "source": "local", "count": 7, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 350, "base_hp": 10000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 80, "attack_interval": 111, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103280, "special_effect_id": 227, "master_id": 425, "global_id": 424, "spawn_sec": 187}, {"enemy_id": 14, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 10000, "attack": 500, "base_hp": 10000, "base_attack": 500, "damage_type": "physical", "armor_defense": 250, "magic_defense": 30, "attack_speed": 90, "attack_wait": 10, "attack_interval": 161, "move_speed": 350.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098304, "special_effect_id": 227, "master_id": 90, "global_id": 89, "spawn_sec": 203}, {"enemy_id": 15, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 40000, "attack": 500, "base_hp": 40000, "base_attack": 500, "damage_type": "magical", "armor_defense": 120, "magic_defense": 50, "attack_range": 150, "attack_speed": 120, "attack_wait": 60, "attack_interval": 181, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2098464, "special_effect_id": 227, "missile_id": 14, "missile": {"speed": 6.0, "splash": 147}, "master_id": 97, "global_id": 96, "ranged": true, "spawn_sec": 220}, {"enemy_id": 16, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 5000, "attack": 800, "base_hp": 5000, "base_attack": 800, "damage_type": "physical", "armor_defense": 4000, "magic_defense": 30, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 2.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2113088, "race_id": 18, "special_effect_id": 220, "master_id": 30773, "global_id": 4392, "spawn_sec": 231}], "popups": ["ゼクメトがいる間\n全ての敵のHPが徐々に回復します。", "スコーピオン系から\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "battle", "at_sec": 5, "lines": [{"name": "ゼクメト", "text": "――バスティス、もういい。\n話は終わりだ。", "face": "l339abf731906"}, {"name": "バスティス", "text": "……ゼクメト？\nな、何をするつもりにゃ……？", "face": "u1892a1"}, {"name": "ゼクメト", "text": "負け猫根性が染み付いているのか、お前は。\n見苦しい……まるで命乞いのような語りだった……。", "face": "l339abf731906"}, {"name": "ゼクメト", "text": "諦めるな。\n我が父は命を燃やし、太陽を取り戻した。\n民のために、砂漠のために、我らは諦めてはならない。", "face": "l339abf731906"}, {"name": "ゼクメト", "text": "このゼクメトは、太陽神の娘は、\n永遠に幸福なる日々を民に与える。\n命を燃やし、この身を太陽に変えてでも！", "face": "l339abf731906"}, {"name": "バスティス", "text": "やめるにゃゼクメトぉ！！\n火の権能があっても……それは太陽の権能じゃないにゃ！\nあんたが死んじゃうにゃぁ！！", "face": "u1892a1"}, {"name": "ゼクメト", "text": "それでも構わない。\n我が炎は民と共に燃え続ける。\n太陽は決して消えないと、ここに民に誓う！", "face": "l339abf731906"}, {"name": "フローガ", "text": "ドラウプニルの腕輪から、膨大な魔力が\nゼクメトの身体に流れ込んでいます！\nこれは、グングニルに匹敵する輝きです！！", "face": "u878"}, {"name": "トラム", "text": "あれだけの魔力、彼女の器では耐えきれるはずがない。\nここで命を捧げてでも、\n王子、あなたを殺すつもりよ。", "face": "u1110a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "ゼクメト", "text": "神なる右目、我が父の力を！\n今、我が身を捧げ――", "face": "l339abf731906"}, {"name": "イコル", "text": "――ふざけるなよ、略奪者。\nならば、ここで燃え尽きて死ぬがいいッ！！", "face": "l9b32f94301f4"}, {"name": "徐華", "text": "お待たせじゃぁ！！\nイコル、ぶち当たってこーい！！", "face": "u1896a1"}, {"name": "バスティス", "text": "なっ……貴様らどこから――！？", "face": "u1892a1"}, {"name": "サナラ", "text": "えっ……徐華ちゃんが、\nイコルちゃんを――ぶん投げましたぁー！？", "face": "u921"}, {"name": "イコル", "text": "届いたッ！！", "face": "l9b32f94301f4"}, {"name": "イコル", "text": "聞け王子、ドラウプニルの契約を半分奪った。\nこれから黄金の魔力を打ち消していく。", "face": "l9b32f94301f4"}, {"name": "イコル", "text": "足場を作ってやる。\nこいつを、略奪者を殺せッ！！", "face": "l9b32f94301f4"}]}, {"trigger": "battle", "at_sec": 7, "lines": [{"name": "イコル", "text": "……あいつが、物質界に残した遺物。\nドラウプニルの輝き、か。", "face": "l9b32f94301f4"}, {"name": "イコル", "text": "亜神イコルを、正統後継者のひとりに入れていたな？\nこんなに簡単に契約を奪えるとは。", "face": "l9b32f94301f4"}, {"name": "イコル", "text": "王子、黄金の魔力を消し飛ばす！\nあとはお前の指揮に任せたぞ。", "face": "l9b32f94301f4"}]}, {"trigger": "end", "lines": [{"name": "ゼクメト", "text": "――殺せ、物質界の英雄。", "face": "l56a3fc59b2eb"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "イコル", "text": "どうした王子。そいつは敵だろう？\n亜神ディアスに与する戦神だぞ。", "face": "l9b32f94301f4"}, {"name": "ハリンヘイム", "text": "……イコル、そんなことも分からないのですか？\n彼女らは、亜神ディアスの配下などではありません。", "face": "u1854a1"}, {"name": "イコル", "text": "……ハリンヘイム。", "face": "l9b32f94301f4"}, {"name": "ハリンヘイム", "text": "民を守るために嘘をついていた。\nそれも、民も、神も、世界も騙す嘘を。\n太陽神の不在そのものを隠していた。", "face": "u1854a1"}, {"name": "ハリンヘイム", "text": "民のために、同胞のために命まで燃やした。\n彼女は立派な戦士にして、王です。", "face": "u1854a1"}, {"name": "イコル", "text": "……アスガルドらしい考え方、だな。", "face": "l9b32f94301f4"}, {"name": "イコル", "text": "だが、この眼は気に入らない。\nドラウプニルによって得たその神なる右目、\n「太陽神の眼」は封じさせてもらおう。", "face": "l9b32f94301f4"}, {"name": "ゼクメト", "text": "くっ……父の、力、が……。", "face": "l56a3fc59b2eb"}, {"name": "バスティス", "text": "ゼクメト、ぜくめとぉ……。\nお前っ、お前簡単に命を燃やすにゃぁ！\nばかっ、おおばかっ、死ねっ！　死んで詫びろにゃぁ！", "face": "u1892a1"}, {"name": "ゼクメト", "text": "い、痛いっ、やめろバスティス！\n怪我人に暴力はっ、死ぬっ、本当に死ぬッ！！", "face": "l56a3fc59b2eb"}, {"name": "イコル", "text": "……とんだ茶番だ。\n王子に関わると、何もかもを赦しかねない。", "face": "l9b32f94301f4"}, {"name": "ハリンヘイム", "text": "私は、赦すつもりはありませんが。", "face": "u1854a1"}, {"name": "イコル", "text": "……ああ、君に赦してもらおうとは、思っていない。\nだからここは退かせてもらおう。", "face": "l9b32f94301f4"}, {"name": "イコル", "text": "ドラウプニルの腕輪は、もらっていく。\n今の契約者はこの亜神イコルのようだからね。", "face": "l9b32f94301f4"}, {"name": "ハリンヘイム", "text": "イコル！　待ちなさい！！\n……くっ……もう気配が。", "face": "u1854a1"}, {"name": "バスティス", "text": "ゼクメトぉ！！\n死んだら幸せがっぽがっぽできないにゃよ！？\n死ねぇっ！　一回死んでわびてこいにゃぁ！！", "face": "u1892a1"}, {"name": "ゼクメト", "text": "ぐふっ……ぐぇっ、いたっ、ほんとにいたい……。", "face": "l56a3fc59b2eb"}, {"name": "徐華", "text": "……のう、まずはあやつら止めたほうがいいぞ？\nバスティスのやつ、\n泣きすぎてゼクメトの負傷具合が見えておらん。", "face": "u1896a1"}, {"name": "ヴィディア", "text": "そうだな。今なら話もできるだろう。\n王子殿、ここからはあなたの出番だ。", "face": "u1894a1"}]}], "map": {"image": "Map920201_4769", "w": 960, "h": 640, "spots": [{"k": "b", "x": 84, "y": 484}, {"k": "m", "x": 173, "y": 433, "id": 200}, {"k": "m", "x": 270, "y": 375, "id": 201}, {"k": "m", "x": 466, "y": 481, "id": 202}, {"k": "m", "x": 662, "y": 376, "id": 203}, {"k": "m", "x": 654, "y": 271, "id": 204}, {"k": "m", "x": 553, "y": 210, "id": 205}, {"k": "m", "x": 274, "y": 151, "id": 206}, {"k": "m", "x": 175, "y": 205, "id": 207}, {"k": "m", "x": 901, "y": 430, "id": 208}, {"k": "r", "x": 197, "y": 256, "id": 300}, {"k": "r", "x": 360, "y": 166, "id": 301}, {"k": "r", "x": 630, "y": 318, "id": 302}, {"k": "r", "x": 692, "y": 433, "id": 303}], "events": [{"t": 7.1, "when": "time", "ops": [{"op": "+fx", "name": "obj_00", "fx": "StageTowerPowerUp2", "x": 376, "y": 436}, {"op": "+fx", "name": "obj_01", "fx": "StageTowerPowerUp", "x": 376, "y": 480}, {"op": "+fx", "name": "obj_02", "fx": "StageTowerPowerUp2", "x": 469, "y": 419}, {"op": "+fx", "name": "obj_03", "fx": "StageTowerPowerUp", "x": 469, "y": 463}]}, {"t": 7.4, "when": "time", "ops": [{"op": "+s", "name": "locPlc_292", "id": 292, "k": "m", "x": 376, "y": 436}, {"op": "+s", "name": "locPlc_381", "id": 381, "k": "r", "x": 469, "y": 419}]}, {"t": 7.6, "when": "time", "ops": [{"op": "-fx", "name": "obj_00"}, {"op": "-fx", "name": "obj_01"}, {"op": "-fx", "name": "obj_02"}, {"op": "-fx", "name": "obj_03"}]}, {"t": 8.1, "when": "time", "ops": [{"op": "-s", "name": "locPlc_292"}, {"op": "-s", "name": "locPlc_381"}]}, {"t": 8.1, "when": "time", "ops": [{"op": "+fx", "name": "obj_04", "fx": "StageTowerPowerUp2", "x": 615, "y": 489}, {"op": "+f