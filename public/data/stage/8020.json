{"quest_id": 8020, "name": "ドラウプニルの輝き", "description": "ドラウプニルの腕輪の魔力を取り込んだ\n亜神ゼクメトが王子を消すため牙を剝く。\n熾烈な戦いを制し、勝利をつかみ取れ！\n神級（★１獲得の目安：平均Lv50）", "event": "偽りの太陽、虚像の黄金", "event_category": "History", "mission_id": 920201, "map_no": 4769, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 2, "tags": ["アーマー", "ブロック不可", "置物"], "fixture": true, "hp": 10, "base_hp": 10, "damage_type": "physical", "armor_defense": 3000, "magic_defense": 50, "attack_speed": 1, "attack_wait": 90, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "pattern_id": 2145728, "special_effect_id": 623, "change_to": 1, "change_condition": 2, "master_id": 36330, "global_id": 9947, "to_condition": 2, "to_global_id": 9948}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "ブロック不可", "置物"], "fixture": true, "hp": 120000, "attack": 4000, "base_hp": 120000, "base_attack": 4000, "damage_type": "magical", "armor_defense": 3000, "magic_defense": 50, "attack_range": 400, "attack_speed": 1, "attack_wait": 90, "attack_interval": 241, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "pattern_id": 2145744, "special_effect_id": 623, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 36331, "global_id": 9948, "ranged": true, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 3, "hp": 124000, "attack": 2400, "base_hp": 124000, "base_attack": 2400, "damage_type": "magical", "armor_defense": 650, "magic_defense": 10, "attack_range": 160, "attack_speed": 20, "attack_wait": 70, "attack_interval": 193, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2145840, "race_id": 19, "special_effect_id": 1438, "change_to": 3, "missile_id": 901, "missile": {"speed": 12.0}, "master_id": 36340, "global_id": 9957, "ranged": true, "to_global_id": 9958, "route_be