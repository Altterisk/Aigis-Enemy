c": 71}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 2, "hp": 14000, "attack": 450, "base_hp": 14000, "base_attack": 450, "damage_type": "physical", "armor_defense": 350, "magic_defense": 15, "attack_range": 160, "attack_wait": 10, "attack_interval": 79, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143120, "special_effect_id": 1286, "change_to": 1, "change_condition": 2, "missile_id": 45, "master_id": 35973, "global_id": 9590, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 82}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 2, "hp": 8800, "attack": 650, "base_hp": 8800, "base_attack": 650, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 48, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143104, "race_id": 16, "special_effect_id": 54, "change_to": 1, "change_condition": 2, "master_id": 35963, "global_id": 9580, "to_condition": 2, "to_global_id": 403, "commands": {"raw": "DoEnemy_ChangeBattleStyle(\"ENBSTL_NoAttack\" );"}, "route_behaviour": {"battle_styles": ["ENBSTL_Default"]}, "spawn_sec": 174}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 2, "hp": 1100, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103120, "race_id": 16, "change_to": 1, "change_condition": 2, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 418, "global_id": 417, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 232}, {"enemy_id": 7, "source": "local", "count": 7, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102528, "race_id": 16, "change_to": 1, "change_condition": 2, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 257, "global_id": 256, "ranged": true, "to_condition": 2, "to_global_id": 403, "route_behaviour": {"battle_styles": ["ENBSTL_Default"]}, "spawn_sec": 268}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 60, "attack_interval": 193, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143088, "race_id": 16, "special_effect_id": 818, "change_to": 1, "change_condition": 2, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 35961, "global_id": 9578, "ranged": true, "to_condition": 2, "to_global_id": 403, "commands": {"raw": "DoEnemy_ChangeBattleStyle(\"ENBSTL_NoAttack\");"}, "route_behaviour": {"battle_styles": ["ENBSTL_Default"]}, "spawn_sec": 290}], "popups": ["\n\n\n\n　　――王国領内、森", "サテラに変身した\nドッペルゲンガーの攻撃は、\n人間系の味方ユニットに対する\nダメージが10％アップします。\n\n\n\n　　　　　　(1/2)", "サテラに変身したドッペルゲンガーの\n攻撃を受けた味方ユニットは\n2秒間、防御力が減少します。\n\nこの効果は、状態異常に対する\nユニットの能力では\n軽減、無効化できません。\n　　　　　　(2/2)", "見当かなみに変身した\nドッペルゲンガーは、\n一定確率で\n物理攻撃を回避します。", "シーラに変身した\nドッペルゲンガーは、\n自身の攻撃力の値で\n自身を含む周囲の敵を回復します。"], "dialogue": [{"trigger": "start", "lines": [{"text": "――王国領内、森"}, {"name": "グリム", "text": "うわぁ、異界の門が思いっきり暴走してますねぇ。\nここにも勝手に門が開いちゃってます。\n狙ったものか、事故なのかはわからないですけど。", "face": "u942"}, {"name": "アンナ", "text": "放っておけば、王国中に門が出現してしまいます。\nひとつずつ調べて閉じていきましょう。"}, {"name": "ランス", "text": "おい、王子。\nなんで俺様の周りがむさい男ばかりなんだ。", "face": "u2897a1"}, {"name": "モーティマ", "text": "呪いのせいだろ。\n文句なら魔神に言え。", "face": "u2435a1"}, {"name": "サイラス", "text": "貴殿の安全のためだ。\n我々が壁になるゆえ、女性は近寄れん。", "face": "u13"}, {"name": "フドウ", "text": "カカカッ、煩悩を断つ修行と思えばよいわ！", "face": "u238"}, {"name": "ユリクセス", "text": "（ここまでの密度、修行というより刑罰に近いな……）", "face": "u2193a1"}, {"name": "ランス", "text": "ええい、ぐぬぬ……！\nおい、敵はまだか！　鬱憤をぶつける相手はどこだ！", "face": "u2897a1"}, {"name": "貴族セーレ", "text": "――クックック、そう焦るな。", "face": "l70921f716695"}, {"name": "モーティマ", "text": "出やがったな！", "face": "u2435a1"}, {"name": "貴族セーレ", "text": "我が眷属よ、あの男を殺せ。\n余興ついでに、そうだな、\n貴様のよく知る者の姿を真似させてみよう。", "face": "l70921f716695"}, {"name": "サテラ？", "text": "……フン、人間なんぞ二秒で肉塊だ。", "face": "u1760a1"}, {"name": "シィル？", "text": "ランス様ぁ、こっちですよぉ。", "face": "u2900a1"}, {"name": "かなみ？", "text": "ランスー、こっちだよー。", "face": "u1761a1"}, {"name": "ランス", "text": "ぬぐっ！？　サテラにシィルにかなみ……！\nいや待て、シィルは後ろにいたはずだぞ……？", "face": "u2897a1"}, {"name": "グリム", "text": "あれ、ドッペルゲンガーですねー。\nランスさんに縁のある女性に化けてるみたいです。", "face": "u942"}, {"name": "ユリクセス", "text": "女の姿で近づかれれば、呪いが発動する……。\nなんと嫌らしい手だ。", "face": "u2193a1"}, {"name": "ランス", "text": "なるほど。つまり――\n偽物なら、遠慮なくぶっ飛ばしていいのだな！", "face": "u2897a1"}, {"name": "サイラス", "text": "そういう問題か……？", "face": "u13"}, {"name": "ランス", "text": "鬱憤晴らしだー！！\n野郎ども、ついてこい！", "face": "u2897a1"}]}, {"trigger": "end", "lines": [{"name": "ランス", "text": "がははははっ！　俺様最強ー！", "face": "u2897a1"}, {"name": "モーティマ", "text": "……ったく、呪いがかかっててこれかよ。\n頼もしいというか何というか。", "face": "u2435a1"}, {"name": "グリム", "text": "異界の門、閉じましたー。\nでも、こういう門が王国中にあるんですよねぇ。", "face": "u942"}, {"name": "アンナ", "text": "王子、次は市街地の方で異変の報せが。\n大量の……ハニー、だそうです。"}, {"name": "ランス", "text": "ハニー？　あのハニワか。\nまさかまた、めがねめがね言うんじゃなかろうな。", "face": "u2897a1"}, {"name": "グリム", "text": "たぶん言いますねー。", "face": "u942"}]}], "active": true}