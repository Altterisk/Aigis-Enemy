{"quest_id": 4342, "name": "魔獣の棲む森", "description": "エクストラミッション\n多くの魔獣が棲む森にて襲いくる\n魔獣の群れを迎え撃て！\n神級（★１獲得の目安：平均Lv50）", "event": "闇司祭と邪教の祭壇", "event_category": "History", "mission_id": 920047, "map_no": 3598, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 10, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 400, "base_hp": 15000, "base_attack": 400, "damage_type": "magical", "armor_defense": 50, "attack_range": 210, "attack_speed": 50, "attack_wait": 50, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101792, "race_id": 12, "missile_id": 99, "missile": {"speed": 8.0}, "master_id": 222, "global_id": 221, "ranged": true}, {"enemy_id": 2, "source": "local", "count": 3, "form_count": 2, "hp": 12000, "attack": 500, "base_hp": 12000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 30, "attack_wait": 40, "attack_interval": 157, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099024, "race_id": 13, "special_effect_id": 220, "change_to": 2, "change_condition": 3, "master_id": 141, "global_id": 140, "to_condition": 3, "to_global_id": 141, "spawn_sec": 9}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099040, "race_id": 13, "master_id": 142, "global_id": 141, "from_condition": 3}, {"enemy_id": 4, "source": "local", "count": 21, "form_count": 1, "hp": 4000, "attack": 320, "base_hp": 4000, "base_attack": 320, "damage_type": "magical", "armor_defense": 100, "magic_defense": 40, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 151, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2101328, "race_id": 13, "missile_id": 90, "missile": {"speed": 8.0}, "master_id": 322, "global_id": 321, "ranged": true, "spawn_sec": 17}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 15000, "attack": 550, "base_hp": 15000, "base_attack": 550, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 180, "attack_speed": 70, "attack_wait": 20, "attack_interval": 111, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100672, "race_id": 13, "change_to": 5, "change_condition": 1, "missile_id": 4, "missile": {"speed": 4.0}, "master_id": 277, "global_id": 276, "ranged": true, "variants": [{"hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 50, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100688, "race_id": 13, "master_id": 278, "global_id": 277}], "spawn_sec": 64}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、ここが報告にあった\n魔獣が多く住む森です。\nすぐに調査を始めましょう。"}]}, {"trigger": "start", "lines": [{"name": "？？？", "text": "ちょっとちょっと！　\nあんたたちそこで何してんのよ！", "face": "u262"}, {"name": "アンナ", "text": "あ、あの私たちは……。"}, {"name": "？？？", "text": "あー！　さてはあんた達、\n最近流行ってるっていう\n魔獣狩りのハンター共ね！", "face": "u262"}, {"name": "？？？", "text": "まったく……。\nどれだけあたしの仲間が連れ去られたと\n思ってるのよ！　許さないんだからー！！", "face": "u262"}, {"name": "アンナ", "text": "王子、彼女はなにか勘違いをしてしまって\nいるようです……。\nここはひとまず戦ったほうがよさそうです。", "face": "l9d6eb88c2817"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "あの、落ち着きましたか？"}, {"name": "？？？", "text": "……？　あれれ？　\nもしかしてハンターじゃ、ない？", "face": "u262"}, {"name": "アンナ", "text": "はい、私たちはここ最近魔獣が多く住むという\nこの森を王子の命の下調査しに来たんです。"}, {"name": "？？？", "text": "なーんだ、そうだったの。\nごめんなさい、あたしったら\n勘違いしちゃったみたいね。", "face": "u262"}, {"name": "アンナ", "text": "ここの魔獣は民に害を与えないかどうか、\n調査してもよろしいですか？"}, {"name": "？？？", "text": "それなら大丈夫よ。\nここの魔獣たちはあたしの大事な友達なの。\n誰かれかまわず襲ったりしないわ。", "face": "u262"}, {"name": "？？？", "text": "お願い。\nあたしの大事な友達を信じて……。", "face": "u262"}, {"name": "アンナ", "text": "……そうですね。\n見たところここの魔獣はあなたに\n懐いているようですね。", "face": "l473d5d4c04bd"}, {"name": "アンナ", "text": "わかりました。あなたを信じます。\n王子も頷いていますし。"}, {"name": "？？？", "text": "ほんとに！？　ありがとうっ！", "face": "u262"}, {"name": "アンナ", "text": "時々ですが、視察もかねて\nまた会いに来ても良いでしょうか？"}, {"name": "スイル", "text": "うん、もちろん！\nあたしはスイルっていうの！\n遊びに来るのなら歓迎するわ！", "face": "u262"}, {"name": "アンナ", "text": "ふふっ。ではまたお会いしましょう。\n王子、もうここは大丈夫そうですし、\nそろそろ城に戻りましょうか。"}]}], "active": true}