{"quest_id": 6684, "name": "受け継がれる意志", "description": "父の意志を受け取り、ついにホムラが立ち\n上がる。大嶽丸を守る宝剣・小通連を\n破壊し、鬼たちの邪なる野望を打ち砕け！\n神級（★１獲得の目安：平均Lv50）", "event": "鬼神大嶽丸と黒紅の翼", "event_category": "History", "mission_id": 920121, "map_no": 3214, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 30000, "attack": 2500, "base_hp": 30000, "base_attack": 2500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 96, "move_speed": 250.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117296, "race_id": 4, "special_effect_id": 230, "change_to": 1, "change_condition": 2, "master_id": 31494, "global_id": 5113, "to_condition": 2, "to_global_id": 5112}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 30000, "attack": 1500, "base_hp": 30000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 300, "magic_defense": 60, "attack_speed": 1, "attack_wait": 15, "attack_interval": 96, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2117280, "race_id": 4, "master_id": 31493, "global_id": 5112, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 40000, "attack": 1200, "base_hp": 40000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 30, "attack_range": 60, "attack_speed": 100, "attack_wait": 30, "attack_interval": 126, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2117312, "special_effect_id": 346, "missile_id": 45, "master_id": 31495, "global_id": 5114, "ranged": true, "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 14, "form_count": 1, "tags": ["アンデッド"], "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "m