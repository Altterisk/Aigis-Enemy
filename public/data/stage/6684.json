le_id": 167, "master_id": 31468, "global_id": 5087, "ranged": true, "spawn_sec": 69}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 128}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 5500, "attack": 900, "base_hp": 5500, "base_attack": 900, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099344, "race_id": 4, "master_id": 103, "global_id": 102, "spawn_sec": 144}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 10000, "attack": 1250, "base_hp": 10000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 650, "magic_defense": 20, "attack_speed": 40, "attack_wait": 15, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099360, "race_id": 4, "master_id": 104, "global_id": 103, "spawn_sec": 158}], "popups": ["大嶽丸は小通連がいる間\nダメージを受けません。\n以下の条件を満たすと弱体化し\nダメージを与える事ができます。\n\n・小通連を倒す\n・小通連が拠点に到達する"], "dialogue": [{"trigger": "start", "lines": [{"name": "ホムラ", "text": "さぁ王子、反撃開始だよ――ッ！！", "face": "u739"}, {"name": "コノハ", "text": "ホムラの羽に神通力が集まっていく……！\nあやつめ、王子たちが集めた『天狗の羽』の力を借り、\n天狗としての力を取り戻しおった！", "face": "u440"}, {"name": "クラマ", "text": "だが、本来はホムラの神通力ではない力……。\nこんな無茶が利くのはそう長い事ではあるまい。\n王子、この僅かな好機、物にするぞ！", "face": "u572"}, {"name": "重水の四天王", "text": "くっ、たかが天狗が一人復活しただけで、\n大嶽丸様に勝てるかの如き口の利き方……。\n実に気に入りませんねぇ……。", "face": "l0820c5259203"}, {"name": "重水の四天王", "text": "まぁ良いでしょう。\nそこまで死にたいというのなら、\n大嶽丸様の最初の生贄になればよいのです。", "face": "l0820c5259203"}, {"name": "大嶽丸", "text": "…………重水の、俺はあの男を殺せば良いのか。", "face": "lc32ad3f5a76f"}, {"name": "重水の四天王", "text": "左様でございます、大嶽丸様。\n私はあの憎たらしい天狗共を相手しますゆえ、\nこちらの戦場はお任せいたしました。", "face": "l0820c5259203"}, {"name": "大嶽丸", "text": "……クク。\n久方ぶりの……戦士の気配……だ。", "face": "lc32ad3f5a76f"}]}, {"trigger": "start", "lines": [{"name": "ケイティ", "text": "封印の地から現れた刀……。\nあれが復活した宝刀の一振り、『小通連』ですか……。", "face": "u114"}, {"name": "フドウ", "text": "王子、お主も感じるであろう……！\nこの距離からもう、\nとてつもない妖気が漂って来ておる……！！", "face": "u238"}, {"name": "ホムラ", "text": "王子、伝承が正しければ、\n『小通連』がある限り大嶽丸は無敵らしいんだ。\n何とかして、先に『小通連』を破壊しないと……！", "face": "u739"}, {"name": "フドウ", "text": "うむ。だが、気を抜くでないぞ。\nあの宝剣、おそらく尋常の存在ではない。\n物理攻撃よりも、魔に類する攻撃の方が有効だろう。", "face": "u238"}, {"name": "コノハ", "text": "王子、そしてホムラよ、\n重水の四天王と周囲の雑兵は我らに任せよ！", "face": "u440"}, {"name": "ホムラ", "text": "わかった！　コノハ様、クラマ様、ご武運を！", "face": "u739"}, {"name": "ホムラ", "text": "さぁ、ここで鬼の野望を終わらせよう。\n皆が泣かなくて済むようにさ。\nそうだよね、正義の味方の王子さま？", "face": "u739"}, {"name": "王子", "text": "…………！！", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "フドウ", "text": "くっ……大嶽丸は膝をついたというのに、\n妖気が膨れ上がっていくぞ……！？", "face": "u238"}, {"name": "ホムラ", "text": "これは……！？\n破壊したハズの『小通連』が……！？", "face": "u739"}, {"name": "大嶽丸", "text": "クク……成る程、これが痛み……。\n久しく忘れていた……。", "face": "lc32ad3f5a76f"}, {"name": "アンナ", "text": "王子！　大嶽丸が立ち上がり、\n『小通連』も元の形に……！！", "face": "lfe3fe8d5cb21"}, {"name": "重水の四天王", "text": "――くっ、やはり目覚めたばかりでは分が悪いですねぇ。\n大嶽丸様！　今はまだ、御身が万全ではありません。\n今回はここまでにいたしましょう。", "face": "l0820c5259203"}, {"name": "大嶽丸", "text": "…………よかろう。\n実に……愉快な気分だ……。\n人間の、貴様の剣、覚えておくぞ……。", "face": "lc32ad3f5a76f"}, {"name": "王子", "text": "…………！", "face": "u1"}, {"name": "ホムラ", "text": "……何とか、勝てた、のかな。\n良かった……もう……へとへと……で……。", "face": "u739"}, {"name": "アリサ", "text": "ほ、ホムラさん！？\nもう、無理をするから！", "face": "u24"}, {"name": "コノハ", "text": "馬鹿者め、自分の物ではない神通力を\nあれだけ大量に受け入れたのだ。\n精も根も尽き果てようというものよ。", "face": "u440"}, {"name": "クラマ", "text": "しかし随分と幸せそうな顔をしておる。\nどれ、起こすのも忍びない、\n王子よ、背負って帰ってやってはどうかの？", "face": "u572"}, {"name": "アンナ", "text": "ひとまずは一段落、ですね。\nグレンさんも命に別状はないとのことでした。"}, {"name": "アンナ", "text": "しかし新たな脅威が復活してしまいました……。\n今後の方針を決めるためにも、\n一度私達も、拠点へ戻りましょう。", "face": "lfe3fe8d5cb21"}]}], "active": true}