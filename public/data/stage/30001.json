k_speed": 1, "attack_wait": 15, "attack_interval": 70, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2131328, "master_id": 23388}], "spawn_sec": 102}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 1, "hp": 900, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 150, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 52, "global_id": 51, "ranged": true, "spawn_sec": 109}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 4500, "attack": 1200, "base_hp": 9000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 200, "magic_defense": 90, "attack_range": 150, "attack_speed": 30, "attack_wait": 60, "attack_interval": 185, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2160512, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 23402, "ranged": true, "spawn_sec": 138}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "hp": 5000, "attack": 1600, "base_hp": 10000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 25, "attack_range": 180, "attack_speed": 1, "attack_wait": 45, "attack_interval": 153, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160480, "change_to": 11, "change_condition": 1, "missile_id": 1262, "missile": {"speed": 9.0}, "master_id": 23400, "ranged": true, "variants": [{"hp": 5000, "attack": 450, "base_hp": 10000, "base_attack": 900, "damage_type": "physical", "armor_defense": 500, "magic_defense": 25, "attack_speed": 1, "attack_wait": 15, "attack_interval": 70, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.7000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2160496, "master_id": 23401}], "spawn_sec": 156}], "dialogue": [{"trigger": "start", "lines": [{"name": "ユージェン", "text": "――幸いなことに、各階層では敵は発生しなかったな。"}, {"name": "ニミュエ", "text": "その代わり、現時点での最上階に\n全戦力が集結しているみたいですが……。", "face": "u1175a1"}, {"name": "パルセ", "text": "相当深刻な不具合が起きているようですね。", "face": "u2276a1"}, {"name": "シャディア", "text": "塔の守護者たちは、こちらと戦うつもりのようだな。", "face": "u713"}, {"name": "アンブローズ", "text": "自分たちが試練を与える者という認識だけは、\n混ざり合っても変わらなかったみたいですねぇ。"}, {"name": "ファリエ", "text": "仕事熱心なのは誇らしいことですが、\n塔の皆さんを助ける邪魔をされるのは困りますよ。", "face": "u2533a1"}, {"name": "ファリエ", "text": "うーん……同僚の顔を立てて、\nみんな退いたりしてくれませんかね？", "face": "u2533a1"}, {"name": "パルセ", "text": "……守護者たちは、別の部門の奴は知らないと、\nそう言っているようですね。", "face": "u2276a1"}, {"name": "ファリエ", "text": "くっ、分業が進みすぎた弊害ですか……！", "face": "u2533a1"}, {"name": "ニミュエ", "text": "私は二本ほど塔を設計していますが、\n製作者の言うことも聞けない感じですかー？", "face": "u1175a1"}, {"name": "パルセ", "text": "……守護者たちは、製作者相手だからこそ、\n全力で挑みたいと、そう言っているようです。", "face": "u2276a1"}, {"name": "アンブローズ", "text": "仕事に誇りを持ちすぎていますねぇ……。"}, {"name": "シャディア", "text": "要するに、戦闘は避けられないということですか。", "face": "u713"}, {"name": "ソラス", "text": "ええ、いつもどおり、敵に対処していくとしましょう。"}, {"name": "ファリエ", "text": "塔たちを元に戻すために、\n同僚のみんなには眠ってもらいますよー！！", "face": "u2533a1"}]}, {"trigger": "end", "lines": [{"name": "ソラス", "text": "――守護者たちは片付きましたね。"}, {"name": "ニミュエ", "text": "もう出てくる気配もありませんし、\n諸々の作業に集中できそうです。", "face": "u1175a1"}, {"name": "シャディア", "text": "解体……の前に調査をするんだったか。", "face": "u713"}, {"name": "ソラス", "text": "なんで一つになっちゃったのかとか、\nそもそも塔は今どういう状態なのかとか、\nちゃんと調べておく必要がありますからね。"}, {"name": "アンブローズ", "text": "手伝いは、もういらない感じですかぁ？"}, {"name": "ニミュエ", "text": "はい、ソラス様と私で事足りると思いますー。\nなのでアンブローズ様は帰ってもらって大丈夫ですよー。", "face": "u1175a1"}, {"name": "アンブローズ", "text": "そうですか……。"}, {"name": "アンブローズ", "text": "そう、ですかぁ……。"}, {"name": "ソラス", "text": "そんな目で私を見ないでくださいよ……。"}, {"name": "ユージェン", "text": "言いたいことがあるなら、\n本人にはっきり伝えるべきだと思いますが。"}, {"name": "アンブローズ", "text": "いやぁ、別に言いたいことなんて、ないですよぉ？"}, {"name": "ファリエ", "text": "なるほど！　アンブローズ様は、\nニミュエ様を手伝いたいと思っているものの、\n千年放置した負い目とかで気まずくなってるんですね！", "face": "u2533a1"}, {"name": "アンブローズ", "text": "ひんっ！？\nそんなはっきり言わないでくださいよぉ！？"}, {"name": "シャディア", "text": "とりあえず後の処理は、ソラス様とニミュエ様、\nそれからアンブローズ様にお任せすればいいか。", "face": "u713"}, {"name": "パルセ", "text": "ええ、彼女たちであれば、\n塔の解体は滞りなく進むはずです。", "face": "u2276a1"}, {"name": "アンナ", "text": "でしたら、私たちはもう戻りましょうか。"}, {"name": "アンナ", "text": "王子、此度の討伐お疲れ様でした！", "face": "lab0e64136ede"}]}], "active": true}