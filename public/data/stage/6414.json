290, "global_id": 289, "ranged": true, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 27, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 10}, {"enemy_id": 5, "source": "local", "count": 12, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 25}, {"enemy_id": 6, "source": "local", "count": 5, "form_count": 1, "tags": ["ステルス"], "hp": 12000, "attack": 1100, "base_hp": 12000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 110, "attack_wait": 30, "attack_interval": 219, "move_speed": 100.0, "gain_cost": 1, "dot_rate": 1.600000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099552, "race_id": 4, "master_id": 108, "global_id": 107, "spawn_sec": 37}, {"enemy_id": 7, "source": "local", "count": 6, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 70}], "dialogue": [{"trigger": "start", "lines": [{"name": "カズハ", "text": "シズカ様、本当に雷神の根城に向かわれるのですか？", "face": "u235"}, {"name": "シズカ", "text": "……仕方ないわ。\n誰かが伝えなければならないんだから。", "face": "u101"}, {"name": "サイゾウ", "text": "――むッ！\nシズカ様、いました！　雷神です！", "face": "u237"}, {"name": "雷神", "text": "フン……人間風情が何の用だ？\nこの雷神様の縄張りを踏み荒らしよって。", "face": "l9bc7f2309274"}, {"name": "シズカ", "text": "勘違いしないで。\n私たちはただ警告に来ただけよ。", "face": "u101"}, {"name": "雷神", "text": "……警告？", "face": "l9bc7f2309274"}, {"name": "シズカ", "text": "華の国の邪仙たちが、この東の国を侵略しようと\n本格的に準備を進めているの。", "face": "u101"}, {"name": "シズカ", "text": "もう間もなくこの国は\nヤツらの侵攻を受けて戦場になるわ。\nそうなった時に備えて、今から準備をしておいて。", "face": "u101"}, {"name": "雷神", "text": "グフフ……グハハッ、グハハハハッ！\nこのわしが人間ごときの指図を受けると思うたか！", "face": "l9bc7f2309274"}, {"name": "シズカ", "text": "くっ……話を聞いてなかったの？\n華の国の邪仙たちが総力を挙げて攻めてくるのよ？\n国内で争っている場合じゃないでしょう？", "face": "u101"}, {"name": "カゲロウ", "text": "そうだ。それにぬしは風神と共に\n妖怪総大将、シノの血判状に名を記したはず。", "face": "u139"}, {"name": "雷神", "text": "それがどうした？\n無闇に手出しをせぬとは誓ったが、\n貴様ら人間と馴れ合うつもりは毛頭ないわ。", "face": "l9bc7f2309274"}, {"name": "雷神", "text": "人間ごときが図に乗りおって……不愉快だ。\n貴様らの立場を思い知らせてくれる！", "face": "l9bc7f2309274"}]}, {"trigger": "end", "lines": [{"name": "雷神", "text": "チッ……目障りな羽虫どもが。", "face": "l9bc7f2309274"}, {"name": "雷神", "text": "だが、いくらうるさく飛び回ろうが\nこの雷神は貴様ら人間の指図は受けぬ！", "face": "l9bc7f2309274"}, {"name": "サイゾウ", "text": "ま、待たれよ――", "face": "u237"}, {"name": "シズカ", "text": "――サイゾウ、もういいわ。\nこれ以上はなにを言っても、\nお互いの間の溝を深めるだけだもの。", "face": "u101"}, {"name": "サイゾウ", "text": "しかし、このままでは……。", "face": "u237"}, {"name": "チズル", "text": "あぁ。この国の者たちが足並みを揃えられなければ、\n華の国の邪仙どもの侵攻を防ぐのは難しいだろうね。", "face": "u159"}, {"name": "コジュウロウ", "text": "とはいえ、妖どもと我らの間の溝は\nそう簡単に埋まるものではござらん。", "face": "u102"}, {"name": "イロハ", "text": "ええ……頭では理解できても\n心の中では整理しきれないものというのは、\nやはりあるものです。", "face": "u242"}, {"name": "シズカ", "text": "……同感ね。\nでも、今の私たちが為すべきことは\n目の前の脅威に立ち向かうことよ。", "face": "u101"}, {"name": "シズカ", "text": "古傷を眺めるのは後にして、\n今は未来のためにできることを\n少しずつでも実践していかないと。", "face": "u101"}, {"name": "シズカ", "text": "そのためにも、引き続き邪仙たちの脅威を\nできるだけ多くの同胞たちに伝えて\n協力を呼びかけていきましょう。", "face": "u101"}]}], "active": true}