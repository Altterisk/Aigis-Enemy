 "damage_type": "magical", "armor_defense": 700, "magic_defense": 40, "attack_range": 110, "attack_speed": 90, "attack_wait": 10, "attack_interval": 59, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105728, "special_effect_id": 222, "missile_id": 158, "missile": {"speed": 6.0, "splash": 93}, "master_id": 731, "global_id": 730, "ranged": true, "spawn_sec": 122}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 3500, "attack": 400, "base_hp": 3500, "base_attack": 400, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 200, "attack_speed": 90, "attack_wait": 60, "attack_interval": 183, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105712, "special_effect_id": 81, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 730, "global_id": 729, "ranged": true, "spawn_sec": 144}, {"enemy_id": 14, "source": "local", "count": 4, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 3500, "attack": 700, "base_hp": 3500, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101280, "master_id": 267, "global_id": 266, "spawn_sec": 144}], "dialogue": [{"trigger": "start", "lines": [{"name": "暗黒騎士デシウス", "text": "はぁ、ハァ……くそ、あやつら、\nなんてしつこいんだ……。\nこのままでは追いつかれてしまう……。", "face": "la8e17ee8dc36"}, {"name": "暗黒騎士の手下", "text": "――だ、団長ッ！　\n別部隊より、『例のモノ』を発見したとの報せ！\nここは我らに任せ、お急ぎ下さい！", "face": "l7fd7fe66ea49"}, {"name": "暗黒騎士デシウス", "text": "なんだとッ！！\nわ、分かった。すまないが、ここは任せる。", "face": "la8e17ee8dc36"}, {"name": "暗黒騎士デシウス", "text": "――っと、忘れるところだった。\nこれを貴様に授けよう。数ある英霊の中でも\n最後まで我輩が残しておいたとっておきだ。", "face": "la8e17ee8dc36"}, {"name": "暗黒騎士の手下", "text": "よろしいのですか？\nそのような大事な――はゥッ！！\nふぉぉおおッ……この強大な力は、まさか！？", "face": "l7fd7fe66ea49"}, {"name": "暗黒騎士デシウス", "text": "グフフフ……大事に使うのだぞ。\nでは我輩は行く。次に会うときは、\n最強の騎士となっていると誓おう。さらばだ。", "face": "la8e17ee8dc36"}, {"name": "暗黒騎士の手下", "text": "団長……どうか、良きご武運を……。", "face": "l7fd7fe66ea49"}, {"name": "レシア", "text": "待て、デシウス！\n王子、後を追うぞ！", "face": "u358"}]}, {"trigger": "battle", "at_sec": 142, "lines": [{"name": "暗黒騎士の手下", "text": "デシウス様は最強の騎士となる途次ゆえ、\n邪魔立ては無粋に存じます。\n押し通るというなら、私が止めて見せましょう。", "face": "l7fd7fe66ea49"}, {"name": "リオン", "text": "その構えは『影月七連矢』！？\nそういうこと……あんたも魂を取り込んだのね。", "face": "u1251"}, {"name": "リオン", "text": "いいわ……特別に私が眼を覚まさせてあげる。\n真贋の違い、その身に刻みなさい！", "face": "u1251"}]}, {"trigger": "end", "lines": [{"name": "暗黒騎士の手下", "text": "デシウス様……すみません……。\n私はどうやら、ここまでの……ようです……。\n求めた力を……どうかその手に……。", "face": "l7fd7fe66ea49"}, {"name": "リオン", "text": "『影月七連矢』……真の輝きをその胸に刻みなさい！", "face": "u1251"}, {"name": "リオン", "text": "……王子、急ぐわよ！\nデシウスは、そう遠くに行っていないはずだわ。\nこれ以上好き勝手なんかさせないんだから。", "face": "u1251"}, {"name": "レシア", "text": "ああ、リオンの言うとおりだ。\n今ならすぐに追いつくことができるだろう。\nおおよその位置も把握している。急ごう！", "face": "u358"}]}], "map": {"image": "Map920066_3690", "w": 960, "h": 640, "spots": [{"k": "b", "x": 653, "y": 15}, {"k": "m", "x": 208, "y": 473, "id": 200}, {"k": "m", "x": 328, "y": 462, "id": 201}, {"k": "m", "x": 453, "y": 454, "id": 202}, {"k": "m", "x": 582, "y": 483, "id": 203}, {"k": "m", "x": 84, "y": 460, "id": 204}, {"k": "m", "x": 85, "y": 246, "id": 205}, {"k": "m", "x": 191, "y": 289, "id": 206}, {"k": "m", "x": 300, "y": 334, "id": 207}, {"k": "m", "x": 371, "y": 268, "id": 208}, {"k": "m", "x": 362, "y": 174, "id": 209}, {"k": "m", "x": 274, "y": 113, "id": 210}, {"k": "m", "x": 484, "y": 104, "id": 211}, {"k": "m", "x": 546, "y": 192, "id": 212}, {"k": "m", "x": 625, "y": 259, "id": 213}, {"k": "m", "x": 730, "y": 307, "id": 214}, {"k": "m", "x": 850, "y": 336, "id": 215}, {"k": "m", "x": 846, "y": 142, "id": 216}, {"k": "m", "x": 732, "y": 109, "id": 217}, {"k": "r", "