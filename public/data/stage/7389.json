"armor_defense": 300, "magic_defense": 40, "attack_range": 300, "attack_speed": 200, "attack_wait": 80, "attack_interval": 281, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105504, "race_id": 6, "special_effect_id": 89, "change_to": 13, "change_condition": 1, "missile_id": 54, "missile": {"speed": 15.0}, "master_id": 33982, "global_id": 7599, "ranged": true, "variants": [{"hp": 20000, "attack": 1400, "base_hp": 20000, "base_attack": 1400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 40, "attack_speed": 50, "attack_wait": 10, "attack_interval": 151, "move_speed": 200.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2105552, "race_id": 6, "special_effect_id": 86, "master_id": 33983, "global_id": 7600}], "spawn_sec": 130}, {"enemy_id": 15, "source": "local", "count": 4, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107616, "race_id": 6, "change_to": 15, "master_id": 880, "global_id": 879, "route_behaviour": {"transforms": [{"wait": 50}]}, "spawn_sec": 197}], "popups": ["大天使長はHPが徐々に回復します。\nブロックされている間は\n回復効果が無くなります。\n\nまた、一定時間が\n経過することでも\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "大天使長", "text": "――くっ……たかがゴーレムごときに、\nここまで兵を削られるとは……。", "face": "l1508be233ba4"}, {"name": "大天使長", "text": "しかし、頭も、胴も、脚も失えば、\nもう立ち上がってくることもないでしょう。\nさぁ、禁書庫を開き、浄化の火を放つのです。", "face": "l1508be233ba4"}, {"name": "アナベラ", "text": "おっと、人類の叡智の蓄積を、\nそう乱暴に扱ってほしくないものだね。とはいえ……。", "face": "u1309a1"}, {"name": "アナベラ", "text": "――古代文明の遺産たるその禁書庫、\n簡単に破れるとは思ってほしくないけどね。", "face": "u1309a1"}, {"name": "大天使長", "text": "なるほど……千年戦争以前の建造物ですか。\nそれは破壊するにも骨が折れそうです。", "face": "l1508be233ba4"}, {"name": "大天使長", "text": "つまり、ここに我々が\nたどり着いたのは、罠だったということですか。", "face": "l1508be233ba4"}, {"name": "アナベラ", "text": "よく分かってるじゃないか。\nでもスーパーゴーレムがこんなに早く\n破壊されたのはちょっと想定外だね。", "face": "u1309a1"}, {"name": "アナベラ", "text": "王子、頼りっぱなしで悪いけど――", "face": "u1309a1"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "アナベラ", "text": "おっと……？\n随分とやる気みたいだ。\nそれじゃあ任せたよ、王子！", "face": "u1309a1"}, {"name": "トラム", "text": "（……王子、禁書庫の中を\n見たくて仕方ないって顔してないかしら？）", "face": "u1110a1"}, {"name": "アリシア", "text": "（おにいちゃ――王子は小さい頃から本の虫ですから。\nだからこそ、知識の大切さを\n誰より分かってるんじゃないでしょうか）", "face": "u372"}, {"name": "トラム", "text": "（……アリシアちゃん、後でそのあたり詳しく教えてね？\n私も執務中の王子のこと、色々教えてあげるから）", "face": "u1110a1"}, {"name": "アリシア", "text": "（ふふ、その交換条件なら承諾しましょう。\nもちろん、禁書庫を守り抜いてからですけどね！）", "face": "u372"}, {"name": "大天使長", "text": "――全軍、戦闘用意。\n天槍騎兵団も合流してくるはずです。\n無駄に命を散らさぬように戦いなさい。", "face": "l1508be233ba4"}]}, {"trigger": "battle", "at_sec": 71, "lines": [{"name": "天槍騎兵団長", "text": "くっ……先回りされたというのか？\n総員、このまま王国軍を挟撃するぞ！", "face": "l5858dfba3ad8"}, {"name": "バシラ", "text": "王子、山道から多数の騎兵が！\n天槍騎兵団です！！", "face": "u28"}]}, {"trigger": "end", "lines": [{"name": "大天使長", "text": "――完敗、ですか。\n各自編成を保ちつつ撤退を。", "face": "l1508be233ba4"}, {"name": "天槍騎兵団長", "text": "……スルーズ、人が再び\n古代の叡智を手にするというその事実が、\nどんな事態を引き起こすのか、覚えておくと良い。", "face": "l5858dfba3ad8"}, {"name": "フローガ", "text": "……多数の天界の門が開きました。\nどうやら、天使も天界兵も撤退したようです。", "face": "u878"}, {"name": "アイシャ", "text": "この里の構造に助けられたね。\n……賢者たちの底意地の悪さに、かもしれないけど。", "face": "u181"}, {"name": "アナベラ", "text": "それは褒め言葉と受け取っておこう。\nそれと……その……助かったよ、ありがとう。", "face": "u1309a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アナベラ", "text": "おっと、ろくに自己紹介もしてなかったよね。\nぼくはアナベラ、この里の村長みたいなものだ。", "face": "u1309a1"}, {"name": "アナベラ", "text": "正確には大賢者さまが長なんだけど……。\nあの人はふらっと禁書庫にこもっては、\n数週間は帰ってこなかったりするからね……。", "face": "u1309a1"}, {"name": "エルシャ", "text": "……禁書庫ってそんなに広いんですか？", "face": "u281"}, {"name": "アナベラ", "text": "そりゃもう。\n見た目は小さな遺跡だけど、\n内部は何階層にも及ぶ超巨大建造物だからね。", "face": "u1309a1"}, {"name": "アナベラ", "text": "地下何層まであるのか、正直ぼくらも知らないんだ。\nだからこそ、千年戦争以前の資料も\nいい状態でたくさん残されているよ。", "face": "u1309a1"}, {"name": "アナベラ", "text": "そういうわけで、ぼくが許可を出した以上、\n司書も村のみんなも、きみたちを止めることはない。\nよっぽど危険な禁書に触れない限りはね。", "face": "u1309a1"}, {"name": "アイシャ", "text": "……よし、それじゃあさっそく。", "face": "u181"}, {"name": "ウズメ", "text": "えぇ、ビフロストの資料を探しましょう。\nアナベラさん、禁書庫の鍵を開けてもらえますか？", "face": "u125"}, {"name": "アナベラ", "text": "ああ、よいしょっと……これで――", "face": "u1309a1"}, {"name": "ティール", "text": "……ん？　あれ？\n何か変な音がするような……。\nって、あっ、あっ、あぁぁぁぁッ！？", "face": "u615"}]}], "active": true}