{"quest_id": 7172, "name": "トラム、その心の内", "description": "神の楔を前に、王子たちに\n戦いを挑む銀腕の亜神トラム。\n彼女の表情はどこか悲しげで……。\n上級（★１獲得の目安：平均Lv10）", "event": "集うは神の聖域", "event_category": "History", "mission_id": 920152, "map_no": 5765, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 2, "tags": ["アーマー", "置物"], "fixture": true, "hp": 10, "attack": 300, "base_hp": 10, "base_attack": 300, "damage_type": "physical", "armor_defense": 2500, "magic_defense": 50, "attack_speed": 1, "attack_wait": 90, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125936, "special_effect_id": 623, "change_to": 1, "change_condition": 2, "master_id": 32940, "global_id": 6557, "to_condition": 2, "to_global_id": 6558, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "置物"], "fixture": true, "hp": 87000, "attack": 3500, "base_hp": 87000, "base_attack": 3500, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 50, "attack_range": 400, "attack_speed": 1, "attack_wait": 90, "attack_interval": 241, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2125952, "special_effect_id": 623, "missile_id": 505, "missile": {"speed": 10.0}, "master_id": 32941, "global_id": 6558, "ranged": true, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 42, "form_count": 1, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 1, "attack_wait": 90, "attack_interval": 236, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2125968, "race_id": 12, "special_effect_id": 622, "master_id": 32939, "global_id": 6556, "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 2, "ta