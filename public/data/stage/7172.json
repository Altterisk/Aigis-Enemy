d": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 628, "change_to": 11, "master_id": 32952, "global_id": 6569, "from_condition": 0, "to_condition": 0, "to_global_id": 6570}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 5, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "uncounted": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 629, "change_to": 12, "master_id": 32953, "global_id": 6570, "from_condition": 0, "to_condition": 0, "to_global_id": 6571}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 6, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "uncounted": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 630, "change_to": 13, "master_id": 32954, "global_id": 6571, "from_condition": 0, "to_condition": 0, "to_global_id": 6572}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 7, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "uncounted": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 631, "change_to": 14, "master_id": 32955, "global_id": 6572, "from_condition": 0, "to_condition": 0, "to_global_id": 6573}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 8, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "uncounted": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 632, "change_to": 15, "master_id": 32956, "global_id": 6573, "from_condition": 0, "to_condition": 0, "to_global_id": 6574}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 9, "form_count": 10, "tags": ["ステルス", "置物"], "fixture": true, "uncounted": true, "hp": 100000, "attack": 1, "base_hp": 100000, "base_attack": 1, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 1, "attack_wait": 1, "attack_interval": 62, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126000, "special_effect_id": 633, "master_id": 32957, "global_id": 6574, "from_condition": 0}], "popups": ["トラムは一定時間が経過するたびに\n攻撃、防御がアップします。\n※最大で３倍までアップ\n\nまた、トラムは倒されると\nその場で復活します。\n２回まで復活し、２回目の復活後、\nHPがアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "トラム", "text": "（――未来は変わらない。\n過去も、決して変わることはない）", "face": "u1110a1"}, {"name": "トラム", "text": "（同じ道を選べば、必ず同じ未来にたどり着く。\n私はきっと、間違った選択をし続けてきたんだ）", "face": "u1110a1"}, {"name": "トラム", "text": "（――どうして私は、ただひとこと、\nあの人に――英雄王となった彼に、\n『私を助けて』と言えなかったのだろう）", "face": "u1110a1"}, {"name": "サナラ", "text": "――王子ちゃん、このあたり、\n霊脈の流れが異常に濃くなっています。\n「神の楔」が近いみたいですよ。", "face": "u921"}, {"name": "トゥアン", "text": "トラムめ、まさか敵のふりをして、\n「神の楔」まで案内しようっていうのか……？", "face": "u1006a1"}, {"name": "アンブローズ", "text": "案内が目的なら、あたしたちに\n敵対してみせる理由がありませんよぅ。", "face": "u1088a1"}, {"name": "ソラス", "text": "……確かにこの状況で\n茶番をするような人ではないと思います。", "face": "u904"}, {"name": "ユージェン", "text": "昔、母さまが言っていました。\n銀腕は仲間に頼らず、それなのに\n命がけで手を貸してくれる困った人だったと。", "face": "u906"}, {"name": "アージェ", "text": "銀腕にはおかしなこだわりがありましたから。\n物質界から見たら、自分は天界の部外者だから、\nできるだけ干渉したくない、だとか。", "face": "u1090a1"}, {"name": "アトナテス", "text": "あれだけ楽しそうに共闘しておいてよく言うぜ。\n今回だってひとりで何か抱え込んで、\n誰にも頼れなくなってるんだろ、どうせ。", "face": "u908"}, {"name": "アトナテス", "text": "自分勝手な亜神サマが悩んでるなら、\n俺たちで助けに行かないとな、王子。", "face": "u908"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "トラム", "text": "――勝手に私の内面を想像しないで。\n物質界と天界では、事情が異なるのだから。", "face": "u1110a1"}, {"name": "トラム", "text": "さぁ、悪たる亜神の私を倒せば、\nこの先にある「神の楔」が手に入るわ。\n遠慮なくかかっていらっしゃい。", "face": "u1110a1"}, {"name": "アーニャ", "text": "悪たる亜神……？\n悪い人は、そんな悲しそうな顔しないと思いますけど。", "face": "u99"}, {"name": "トラム", "text": "……私の剣は、良い子に継いでもらえたようね。\nけれど、問答をするには時間が足りないの。\nゴルゴーンが来る前に終わらせないとね。", "face": "u1110a1"}, {"name": "トラム", "text": "――さぁ、あの人の、英雄王の子孫よ、\n「神の楔」を欲するならば、剣をとりなさい。", "face": "u1110a1"}, {"name": "ソラス", "text": "王子君、トラムは人でも魔物でもない「亜神」です。\nその能力のほとんどは、私も把握できていません。", "face": "u904"}, {"name": "ソラス", "text": "ただ、戦場にあり続けることで、\nその攻防がより苛烈になって行くのが\nトラムの普段の戦い方でした。十分注意するんですよ！", "face": "u904"}]}, {"trigger": "end", "lines": [{"name": "トラム", "text": "……私の負けね。\nさぁ私にトドメを刺して、\n「神の楔」を取りに行きなさい。", "face": "u1110a1"}, {"name": "アトナテス", "text": "ちっ……ふざけんなよトラム。\nそこまで手を抜いて何が負けだ！\n戦友にくらい、いい加減に事情を話せ！", "face": "u908"}, {"name": "ソラス", "text": "トラム、いったい何を企んでいるのですか。\n亜神ゴルゴーンに従う理由は？\nどうしてこんな、見せかけの戦いを――", "face": "u904"}, {"name": "トラム", "text": "――黙って、ソラス、アトナテス。\n私は選択を間違えたのよ。\n……だから、この命を使って、最後の選択をするの。", "face": "u1110a1"}, {"name": "アーニャ", "text": "えぇと、何を言っているか分からないですけど！\n選択とか、間違えたとか、\nそれが、あなたが死ぬ理由になるんですか……？", "face": "u99"}, {"name": "トラム", "text": "……えぇ。私は「契約」を結ばされたの。\nあの亜神たちを裏切ることは、絶対にできない。", "face": "u1110a1"}, {"name": "アーニャ", "text": "契約……？", "face": "u99"}, {"name": "トラム", "text": "「契約」を破れば、私の民は……。", "face": "u1110a1"}, {"name": "トラム", "text": "だから、残された選択肢は、\nあなたたちを全員殺すか、私が殺されるしか――", "face": "u1110a1"}, {"name": "？？？", "text": "――フシュシュ。\n未だ諦めテいなかっタのか、亜神トラム。", "face": "l7d1adc5b74dc"}, {"name": "？？？", "text": "「契約」の抜け道をさがしテ、\nあまつさえ物質界の塵芥に手を貸そうトはな。", "face": "l7d1adc5b74dc"}, {"name": "オーキュ", "text": "お、お、王子さまっ！\n気をつけてくださいな！　あれは――", "face": "u1101a1"}, {"name": "オーキュ", "text": "――あれは、亜神ゴルゴーンですわ！！", "face": "u1101a1"}]}], "map": {"image": "Map920152_5765", "w": 960, "h": 640, "spots": [{"k": "b", "x": 747, "y": 523}, {"k": "m", "x": 913, "y": 468, "id": 200}, {"k": "m", "x": 906, "y": 396, "id": 201}, {"k": "m", "x": 892, "y": 323, "id": 202}, {"k": "m", "x": 835, "y": 479, "id": 203}, {"k": "m", "x": 881, "y": 245, "id": 204}, {"k": "m", "x": 701, "y": 135, "id": 205}, {"k": "m", "x": 439, "y": 150, "id": 206}, {"k": "m", "x": 178, "y": 162, "id": 207}, {"k": "m", "x": 202, "y": 353, "id": 208}, {"k": "m", "x": 120, "y": 358, "id": 209}, {"k": "m", "x": 265, "y": 158, "id": 210}, {"k": "m", "x": 354, "y": 153, "id": 211}, {"k": "m", "x": 529, "y": 146, "id": 212}, {"k": "m", "x": 619, "y": 141, "id": 213}, {"k": "m", "x": 290, "y": 351, "id": 214}, {"k": "m", "x": 371, "y": 348, "id": 215}, {"k": "m", "x": 477, "y": 435, "id": 216}, {"k": "m", "x": 551, "y": 340, "id": 217}, {"k": "m", "x": 641, "y": 335, "id": 218}, {"k": "m", "x": 727, "y": 330, "id": 219}, {"k": "m", "x": 811, "y": 326, "id": 220}, {"k": "m", "x": 184, "y": 224, "id": 221}, {"k": "m", "x": 558, "y": 428, "id": 222}, {"k": "m", "x": 389, "y": 435, "id": 223}, {"k": "m", "x": 192, "y": 287, "id": 224}, {"k": "r", "x": 813, "y": 253, "id": 300}, {"k": "r", "x": 837, "y": 372, "id": 301}, {"k": "r", "x": 679, "y": 204, "id": 302}, {"k": "r", "x": 265, "y": 277, "id": 303}, {"k": "r", "x": 801, "y": 415, "id": 304}, {"k": "r", "x": 743, "y": 256, "id": 305}, {"k": "r", "x": 236, "y": 408, "id": 306}, {"k": "r", "x": 161, "y": 412, "id": 307}, {"k": "r", "x": 313, "y": 406, "id": 308}, {"k": "r", "x": 86, "y": 415, "id": 309}, {"k": "r", "x": 380, "y": 272, "id": 310}, {"k": "r", "x": 427, "y": 501, "id": 311}, {"k": "r", "x": 539, "y": 73, "id": 312}, {"k": "r", "x": 386, "y": 80, "id": 313}, {"k": "r", "x": 240, "y": 87, "id": 314}]}, "start_cost": 10, "active": true, "name_en": "Tram, Her Inner Heart", "description_en": "Before the God's Wedge, the Silver Arm's Demigod Tram challenges the Princes to battle. Her expression looks somewhat sorrowful... Advanced (★1 target: Avg Lv10)"}