, "hp": 3500, "attack": 240, "base_hp": 3500, "base_attack": 240, "damage_type": "magical", "armor_defense": 1500, "attack_range": 180, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127424, "special_effect_id": 510, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 33527, "global_id": 7144, "ranged": true, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 142}, {"enemy_id": 12, "source": "local", "count": 3, "form_count": 2, "tags": ["アーマー", "神聖騎士団"], "hp": 64000, "attack": 2100, "base_hp": 64000, "base_attack": 2100, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 240, "attack_speed": 1, "attack_wait": 1, "attack_interval": 43, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127584, "race_id": 19, "special_effect_id": 1837, "change_to": 12, "change_condition": 4, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 37969, "global_id": 11586, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 11587, "spawn_sec": 167}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団"], "hp": 64000, "attack": 1050, "base_hp": 64000, "base_attack": 1050, "damage_type": "magical", "armor_defense": 2000, "magic_defense": 40, "attack_range": 240, "attack_speed": 1, "attack_wait": 70, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127600, "race_id": 19, "special_effect_id": 1837, "change_to": 11, "change_condition": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 37970, "global_id": 11587, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 14, "source": "local", "count": 12, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4200, "attack": 380, "base_hp": 4200, "base_attack": 380, "damage_type": "magical", "armor_defense": 1500, "attack_range": 140, "attack_speed": 1, "attack_wait": 60, "attack_interval": 189, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127440, "special_effect_id": 510, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 33528, "global_id": 7145, "ranged": true, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 254}], "popups": ["？？？の影響により\n一部の神聖騎士団は\n攻撃と防御がアップします。\n\nこの効果はミッションの\n時間が経過するほど\n強力になります。", "ホワイトクルセイダーは倒されると、\nその場で復活します。\n\n復活後、ホワイトクルセイダーは\n強くなりますが、HPが徐々に減少し\nいずれ自滅します。", "神聖騎士団の千人隊長は、\n戦場にいる神聖騎士の総数に応じて\n攻撃力と防御力がアップします。\n\nまた、ニ種類の攻撃を\n連続して行います。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ギャレット", "text": "――ここが最終防衛線だ！\nもう下がれないぞ！", "face": "u9"}, {"name": "ジェリウス", "text": "来る……王子は必ず来てくれる。\n総員、諦めるな！", "face": "u83"}, {"name": "ロイ", "text": "……む？\n何でしょう、この異様な魔力の波動は……。", "face": "u11"}, {"name": "ヴァレリー", "text": "神獣……いや、もっと大きな……。\nこれは――皆、空だ！　向こうの空から！", "face": "u12"}, {"name": "モーティマ", "text": "へへっ、来やがったか！\nそれもあんなデカブツに乗って！", "face": "u14"}, {"name": "サイラス", "text": "あれが、要塞宮殿を目指す船、か。", "face": "u13"}, {"name": "パルセ", "text": "――総員戦闘配置！\n私も戦場に出ます。王子、攻撃命令はお任せしますね。"}, {"name": "アキレア", "text": "おいおい、まだ完全じゃないんだろ？　大丈夫か？", "face": "u1972a1"}, {"name": "パルセ", "text": "空戦は少々心配ですが、\n私個人が戦場に出る分には問題ありません。"}, {"name": "パルセ", "text": "それに……今は、一緒に戦いたい気分なのです。"}, {"name": "アキレア", "text": "気分、気分か……。\nなるほど、そいつぁいい。", "face": "u1972a1"}, {"name": "パルセ", "text": "えぇ、とてもいい気分です。\n自分でも驚くくらいに。"}, {"name": "クリッサ", "text": "もともと、神獣だったからかな。", "face": "u52"}, {"name": "パルセ", "text": "そうかもしれません。\nもう二度と、共に戦うことはできないと、\nそう思うと、とても悲しかったと記憶していますが――"}, {"name": "パルセ", "text": "――今は違います。\n私は……パルセは、一緒に戦うことができます。\n守りたいもののために、共に、戦場に立つことが。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アキレア", "text": "へへっ。お前、いいやつだな。\nよぉし、ドーンブリンガーの完成祝いだ。\n初陣を大勝利で飾ってやろうぜ。", "face": "u1972a1"}, {"name": "ユリクセス", "text": "王子、向こうにはこの前と同じ、\n「神」の気配の混じった兵がいる。\nいつもの神聖騎士団員だと思うな！", "face": "u2193a1"}]}, {"trigger": "end", "lines": [{"name": "アキレア", "text": "――ちっ、キリがねぇ！\nあの転移魔法どうにかならねぇのか！？", "face": "u1972a1"}, {"name": "フローガ", "text": "向こうには無尽蔵の魔力があります！\nせめて、要塞宮殿との接続を、\n一瞬でも断ち切ることができれば時間稼ぎが……。", "face": "u878"}, {"name": "パルセ", "text": "周辺空域の魔力を、大規模に乱せば良いのですね？"}, {"name": "フローガ", "text": "……できますか？", "face": "u878"}, {"name": "パルセ", "text": "初めてなので、不安ではありますが……。\nそれでも、ドーンブリンガーができると言っています。"}, {"name": "パルセ", "text": "王子、魔力砲を撃ちます。\nトリガーをお任せしたいのですが、よろしいですか？"}, {"name": "王子", "text": "…………？", "face": "u1"}, {"name": "パルセ", "text": "同意をいただいたと判断します。\n――磐船機関、圧縮開始。"}, {"name": "アマツ", "text": "いわふね、ぎゅんぎゅんだよー。", "face": "u2234a1"}, {"name": "フローガ", "text": "なっ、なっ、なんですこの魔力の乱れ方！？", "face": "u878"}, {"name": "パルセ", "text": "魔力砲弾、磐船内で正常加圧中。\n一角獣式魔力砲、\n拡散モードに設定、バレルオープン。"}, {"name": "パルセ", "text": "王子、発射命令を。"}, {"name": "王子", "text": "――放て。", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "フローガ", "text": "わー！　わー！　わー！？\nま、大気中の魔力がめちゃくちゃにぃ！？", "face": "u878"}, {"name": "ヴァレリー", "text": "なるほど、魔力砲を拡散させて、\n転移魔法を展開できなくしたのか。", "face": "u12"}, {"name": "パレス", "text": "これなら、しばらくは時間を稼げそうですね。\nただ、この魔力の乱れも一時的な効果しか……。", "face": "u129"}, {"name": "ユリクセス", "text": "ともあれ、一瞬でも息継ぎできるならありがたい。\nパルセ、この魔力の乱れはどれくらい保つ？", "face": "u2193a1"}, {"name": "パルセ", "text": "数時間から、数日程度が限界かと。"}, {"name": "ユリクセス", "text": "よし、その間に態勢を立て直すぞ。\n王子、反撃準備だ！", "face": "u2193a1"}]}], "active": true}