{"quest_id": 8389, "name": "暁をもたらす者", "description": "ドーンブリンガーで苦戦する王国軍の下へ\n駆けつけた一行は神聖騎士団と対峙する。\nパルセと協力し、敵の軍勢を退けよ！\n神級（★１獲得の目安：平均Lv50）", "event": "空へ", "event_category": "History", "mission_id": 920221, "map_no": 4955, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 17, "form_count": 2, "tags": ["アーマー", "神聖騎士団"], "hp": 9000, "attack": 1700, "base_hp": 9000, "base_attack": 1700, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 100, "attack_interval": 252, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2124336, "special_effect_id": 510, "change_to": 1, "change_condition": 2, "master_id": 32735, "global_id": 6353, "to_condition": 2, "to_global_id": 6354, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団", "アンデッド"], "hp": 100000, "attack": 1000, "base_hp": 100000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 10000, "magic_defense": 90, "attack_speed": 1, "attack_wait": 120, "attack_interval": 292, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124352, "special_effect_id": 562, "master_id": 32736, "global_id": 6354, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 38, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 70, "attack_wait": 10, "attack_interval": 167, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2122400, "race_id": 19, "special_effect_id": 1837, "master_id": 37968, "global_id": 11585, "comman