{"quest_id": 6583, "name": "疾駆する人馬", "description": "迷宮を進む一行は封印晶で暴走した\nケンタウロスに道を阻まれる。\n狂える射手を退け、祭壇を目指せ！\n極級（★１獲得の目安：平均Lv25）", "event": "降魔の復讐者", "event_category": "History", "mission_id": 920115, "map_no": 5483, "level": 100, "multiplier": 1.0, "charisma": 100, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 16, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 16}, {"enemy_id": 3, "source": "local", "count": 11, "form_count": 1, "tags": ["スライム"], "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097456, "master_id": 10, "spawn_sec": 40}, {"enemy_id": 4, "source": "local", "count": 3, "form_count": 1, "hp": 18000, "attack": 600, "base_hp": 18000, "base_attack": 600, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 48, "attack_interval": 157, "move_speed": 2300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112016, "race_id": 12, "special_effect_id": 317, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 31290, "global_id": 4909, "ranged": true, "spawn_sec": 48}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 15000, "attack": 250, "base_hp": 15000, "base_attack": 250, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 1, "attack_wait": 40, "attack_interval": 117, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2114784, "special_effect_id": 234, "missile_id": 279, "missile": {"speed": 12.0}, "master_id": 31059, "global_id": 4678, "ranged": true, "spawn_sec": 85}, {"enemy_id": 6, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 600, "base_hp": 3000, "base_attack": 600, "damage_type": "physical", "armor_defense": 220, "attack_speed": 70, "attack_wait": 30, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.75, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098688, "master_id": 169, "global_id": 168, "spawn_sec": 127}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 148}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "だいぶ迷宮の奥まで来ましたね。", "face": "l2fe133ccbf94"}, {"name": "ノワール", "text": "この通路、古文書に記述があったな……。\n確か、ここを先に進むと、\n儀式を行う祭壇にたどり着くらしい。", "face": "u679"}, {"name": "フィリス", "text": "よし、じゃあさっさと祭壇に向かおう。\n早くノワールを助けてあげたいし――", "face": "u40"}, {"name": "ラテリア", "text": "いや、待ってフィリス。\n通路の奥から聞こえてくる蹄の音……。\n聞き覚えがあるね、これはケンタウロスかな。", "face": "u532"}, {"name": "パレス", "text": "そーっとそーっと……。ちらっ。\nほ、本当です。\nケンタウロスが走り回ってます！", "face": "u129"}, {"name": "フィリス", "text": "でも何だか様子がおかしいぞ。\n規則的な走り方というか、\n同じ場所を走り回っているというか……。", "face": "u40"}, {"name": "ノワール", "text": "「封印晶」のせいで、\n暴走しているのかもしれないな……。", "face": "u679"}, {"name": "アンナ", "text": "簡単にはいかない、ということですね。\n王子、不用意に近付かないようご注意を！", "face": "l2fe133ccbf94"}]}, {"trigger": "end", "lines": [{"name": "ノワール", "text": "「封印晶」の欠片は奪ったぞ。\n結構な量が集まったが……。", "face": "u679"}, {"name": "バルバストラフ", "text": "ふむ、これだけあれば、\n儀式に必要な量にもぎりぎり達したかのう。", "face": "u63"}, {"name": "ノワール", "text": "本当か、魔術師！\nこれでこの魔物を抑え込むことが……！", "face": "u679"}, {"name": "バルバストラフ", "text": "そう急くでない。\nお主に取り付いておる魔物は強力じゃ。\n儀式も慎重に行わねばのう。", "face": "u63"}, {"name": "ノワール", "text": "む、むぅ……。\n……すまない。", "face": "u679"}, {"name": "サイラス", "text": "焦る気持ちは分からないでもない。\nだが、この男に任せておけば、\n君はきっと、その魔物から解放されることだろう。", "face": "u13"}, {"name": "バルバストラフ", "text": "ふぉっふぉ、サイラス、\n無関係なフリをするでない。\nお主も手伝うに決まっておろう。", "face": "u63"}, {"name": "ノワール", "text": "…………ありがとう。", "face": "u679"}, {"name": "バルバストラフ", "text": "ん、何か言ったかのう？", "face": "u63"}, {"name": "ノワール", "text": "……何でもない。早く先へ進もう。\n少しでも多くの「封印晶」の欠片を集めておきたい。", "face": "u679"}, {"name": "アンナ", "text": "この先が祭壇……。\n王子、何が待っているか分かりません。\n十分に警戒して進みましょう。", "face": "l2fe133ccbf94"}]}], "active": true}