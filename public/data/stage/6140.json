{"quest_id": 6140, "name": "風の訪れ", "description": "魔物出現の報告を受けた王子たち。\n討伐に向かった先で出会った者とは。\n\n初級（★１獲得の目安：平均Lv1 出撃5体）", "event": "風神の娘", "event_category": "History", "mission_id": 920091, "map_no": 3981, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 28, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 28}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 42}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 2, "hp": 6000, "attack": 250, "base_hp": 6000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 50, "attack_interval": 197, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110432, "race_id": 4, "change_to": 4, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 30326, "global_id": 3945, "to_global_id": 3939, "route_behaviour": {"transforms": [{"wait": 300}]}, "spawn_sec": 114}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 250, "base_hp": 6000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 300, "attack_speed": 60, "attack_wait": 50, "attack_interval": 137, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2110432, "race_id": 4, "missile_id": 208, "missile": {"speed": 5.0}, "master_id": 30320, "global_id": 3939, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "イロハ", "text": "魔物の報告があったのは、\nこの辺りの筈です……あれは！", "face": "u242"}, {"name": "魔物", "text": "――ギャギャーッ！", "face": "l3f82937b5fd4"}, {"name": "サイゾウ", "text": "どうやら早速現れたようですね。", "face": "u237"}, {"name": "アンナ", "text": "王子、戦闘のご準備をお願いします。", "face": "ld2ee29a25afe"}]}, {"trigger": "battle", "at_sec": 111, "lines": [{"name": "？？？", "text": "（あれが話に聞いてた王子……人間にしては、\n随分と強いみたいだけど……でも、\n全然本気じゃないみたい）", "face": "u493"}, {"name": "？？？", "text": "（少し、力を試させてもらうね）", "face": "u493"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "――……あなた達、\n本当にすっごく強いんだね。\n私なんかじゃ手も足もでない。", "face": "u493"}, {"name": "サイゾウ", "text": "殺意はなかったようだが、\n雲に乗り、風を吹き出す風袋。\nお主、もしや……。", "face": "u237"}, {"name": "フーコ", "text": "……うん、多分考えてる通り。\n私はフーコ……風神の娘だよ。", "face": "u493"}, {"name": "イロハ", "text": "……っ！", "face": "u242"}, {"name": "サイゾウ", "text": "……やはりっ！", "face": "u237"}, {"name": "アンナ", "text": "お、落ち着いてくださいお二人とも！", "face": "ld2ee29a25afe"}, {"name": "フーコ", "text": "……父様のしたことを思えば、\n斬られたってしょうがないと思ってる。\nでもお願い、その前に少し話を聞いて。", "face": "u493"}, {"name": "フーコ", "text": "このままじゃ父様……ううん、\n父様だけじゃない、東の国は\n大変な事になっちゃう。", "face": "u493"}, {"name": "ケイティ", "text": "東の国が……なにやら不穏な話のようですね。", "face": "u114"}, {"name": "アンナ", "text": "イロハさん、サイゾウさん、お二人の気持ちは分かります。\nですが、まずは彼女のお話を聞いてみませんか。\n国に纏わる事であれば、捨て置く訳には参りません。", "face": "ld2ee29a25afe"}, {"name": "イロハ", "text": "……わかり……ました。", "face": "u242"}, {"name": "アンナ", "text": "……一度、落ち着ける場所へと\n移動しましょうか。王子、お疲れ様です。"}]}], "active": true}