{"quest_id": 4762, "name": "王国への襲撃", "description": "神官戦士がデーモンを引き連れ\n王国を襲う。\n迫りくる襲撃を食い止めよ！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "帝国神官の帰還", "event_category": "History", "mission_id": 920079, "map_no": 3226, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 4, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2108224, "race_id": 16, "change_to": 2, "change_condition": 2, "master_id": 30014, "global_id": 3633, "spawn_sec": 2}, {"enemy_id": 5, "source": "local", "count": 13, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 6}, {"enemy_id": 6, "source": "local", "count": 8, "form_count": 1, "tags": ["ステルス"], "hp": 3000, "attack": 250, "base_hp": 3000, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "magic_defense": 70, "attack_speed": 60, "attack_wait": 20, "attack_interval": 153, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104096, "race_id": 3, "master_id": 498, "global_id": 497, "spawn_sec": 19}, {"enemy_id": 7, "source": "local", "count": 5, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 32}, {"enemy_id": 8, "source": "local", "count": 6, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 42}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 640, "attack": 180, "base_hp": 640, "base_attack": 180, "damage_type": "magical", "attack_range": 120, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098032, "race_id": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 69, "global_id": 68, "ranged": true, "spawn_sec": 68}], "dialogue": [{"trigger": "start", "lines": [{"name": "フィリス", "text": "王子、大変だ！\n領内にデーモンが現れたぞ！", "face": "u40"}, {"name": "ユリアン", "text": "デーモンだって！？\nおいおい、何の冗談だよ！\nこんなこと、今まで殆どなかったってのに……。", "face": "u7"}, {"name": "バルバストラフ", "text": "ふむ。デーモンの出現は、\n魔界の門が、ここ物質界のどこかで開いた証拠じゃ。\nすぐに対処せねば大変なことになるぞ。", "face": "u63"}, {"name": "ケイティ", "text": "待って下さい、デーモンの群の中に、\n人間の姿があります……！", "face": "u114"}, {"name": "ユリアン", "text": "あ、あれは……！\n間違いない、さっき俺たちに戦いを吹っ掛けてきた\n神官戦士じゃねえか！？", "face": "u7"}, {"name": "ルチア", "text": "ふふ。領内への突然の侵攻に、\n王子軍も対応が遅れているようだね。", "face": "u412"}, {"name": "ルチア", "text": "デーモン達よ、今こそ王子を倒す好機だ！\n進撃を開始せよ！", "face": "u412"}, {"name": "フィリス", "text": "し、信じられない……！\nデーモンが人間と共に王国を攻めてくるなんて……！？", "face": "u40"}, {"name": "ユリアン", "text": "くそ、よく分からねえが、\nこのままじゃ民の命が危ない……。", "face": "u7"}, {"name": "アンナ", "text": "王子、急ぎ応戦しましょう。", "face": "l4132eb27a3aa"}]}, {"trigger": "end", "lines": [{"name": "ルチア", "text": "くっ……。\n……王子軍がまさかここまで強いなんて……。", "face": "u412"}, {"name": "ルチア", "text": "作戦を変更する！\n「あの場所」まで王子軍をおびき寄せ、\nそこで決着をつける！", "face": "u412"}, {"name": "帝国兵", "text": "了解しました！　\n総員、ルチア様に続けッ！", "face": "u287"}, {"name": "アンナ", "text": "（ルチア……！？\nレオナさんが口にしていた名前と同じ……。\nやはり、行方不明の神官戦士の方なのでは……）", "face": "l4132eb27a3aa"}, {"name": "ユリアン", "text": "……ふぅ、この辺りのデーモンは全て片付いたようだな。\nだが、あいつは何者なんだ？　ルチアとか呼ばれてたが、\nどうしてデーモンと一緒に攻めてきたんだよ！？", "face": "u7"}, {"name": "ベルナール", "text": "落ち着け、ユリアン。\n結論を急いても意味はない。\nとにかく、今は彼女たちを追いかけよう。", "face": "u10"}, {"name": "バルバストラフ", "text": "そうじゃな。デーモンと共に逃げていったところを見るに、\n奴等の後をついていけば、\nこの世界に生じた魔界の門の場所も判明するであろう。", "face": "u63"}, {"name": "アンナ", "text": "急ぎましょう、王子！　それに「ルチア」という名前……\nレオナさんが言っていた方と同じ名前です。\n無関係とは思えません。", "face": "l4132eb27a3aa"}]}], "active": true}