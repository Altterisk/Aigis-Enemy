{"quest_id": 6438, "name": "薬の副作用", "description": "更なる新薬を試す王子軍の面々。\n実験は成功……かと思えたが。\n＜物理威力減少：極大＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["物理威力減少：極大"], "event": "アルケミスト・ドクトリン", "event_category": "History", "mission_id": 920107, "map_no": 5324, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 23, "params": [10]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 560, "base_hp": 6000, "base_attack": 560, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 260, "attack_speed": 70, "attack_wait": 60, "attack_interval": 251, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100528, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 251, "global_id": 250, "ranged": true, "spawn_sec": 22}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 8000, "attack": 450, "base_hp": 8000, "base_attack": 450, "damage_type": "magical", "armor_defense": 30, "magic_defense": 20, "attack_range": 140, "attack_speed": 70, "attack_wait": 20, "attack_interval": 111, "move_speed": 100.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100544, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 250, "global_id": 249, "ranged": true, "spawn_sec": 22}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 600, "base_hp": 15000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 74, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109456, "race_id": 16, "master_id": 30388, "global_id": 4007, "spawn_sec": 22}, {"enemy_id": 4, "source": "local", "count": 1, "form_coun