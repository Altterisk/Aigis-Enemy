, "armor_defense": 100, "attack_range": 380, "attack_speed": 40, "attack_wait": 30, "attack_interval": 91, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107280, "race_id": 16, "special_effect_id": 222, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30684, "global_id": 4303, "ranged": true, "spawn_sec": 83}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 1000, "attack": 200, "base_hp": 1000, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 120, "attack_speed": 70, "attack_wait": 60, "attack_interval": 191, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104048, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 490, "global_id": 489, "ranged": true, "spawn_sec": 88}, {"enemy_id": 14, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 720, "base_hp": 12000, "base_attack": 720, "damage_type": "physical", "armor_defense": 50, "attack_range": 220, "attack_speed": 30, "attack_wait": 10, "attack_interval": 51, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2113536, "race_id": 16, "special_effect_id": 257, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 30970, "global_id": 4589, "ranged": true, "spawn_sec": 113}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_range": 190, "attack_speed": 1, "attack_wait": 60, "attack_interval": 181, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2114304, "race_id": 16, "special_effect_id": 222, "missile_id": 68, "missile": {"speed": 2.0, "splash": 107}, "master_id": 30971, "global_id": 4590, "ranged": true, "spawn_sec": 118}], "popups": ["『薬の副作用』では\n味方ユニットの物理攻撃で\n与えるダメージが\n『90％』減少します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ネーニャ", "text": "先生、こっちは準備できまし――\n……って、あれ？　レーレン先生？", "face": "u610"}, {"name": "ジョヴァンニ", "text": "おいおい、どうしちまったんだよ先生？\nなんかいつもより顔が赤いぜ？", "face": "u611"}, {"name": "レーレン", "text": "はぁっ……はぁっ……。\nすまねえ……みんな、逃げてくれ……ッ！", "face": "u614"}, {"name": "メーリス", "text": "え？　逃げるって――", "face": "u609"}, {"name": "モーティマ", "text": "――うおおぉおおおおおおオオオオッ！！\n今ならどんな相手だってぶっ倒して見せるぜぇえッ！！", "face": "u14"}, {"name": "テティス", "text": "ハァッ、ハァッ……うぅ、バシラ……どこにいるの？", "face": "u37"}, {"name": "アンナ", "text": "――ッ！？\nさっき投薬を受けた方々に異変が！", "face": "l0a243861aec8"}, {"name": "レーレン", "text": "くッ……マズったぜ。\nさっきの薬を使って強化されたヤツら全員が、\n副作用で異常な興奮状態に陥っちまってるらしい。", "face": "u614"}, {"name": "レーレン", "text": "もちろん、あたしも含めて……だ。\nだから、頼む……みんな逃げてくれ……ッ！\nあたしらが……ぐぅッ……暴走しちまう、前に……ッ！", "face": "u614"}, {"name": "ネーニャ", "text": "――そんなのイヤ！\n先生たちが意思に反して暴れそうになってるのに、\n放ったまま逃げるなんて、できないよ！", "face": "u610"}, {"name": "ジョヴァンニ", "text": "悪ィな先生、出来が悪ぃ生徒たちでよぉ。\nだが、あんたの教え子はここで逃げるような\nヤワな教育は受けちゃいねぇんだよッ！", "face": "u611"}, {"name": "レーレン", "text": "み、みんな……っ。", "face": "u614"}, {"name": "レーレン", "text": "……すまねえッ！　\nあたしらは、そろそろ自制が効かなくなる……。\nだから……頼む。あたしらを止めてくれ……ッ！", "face": "u614"}, {"name": "メーリス", "text": "うん、任せて！\n授業で学んだ戦法をバッチリ活かしてみせるんだから！\n王子、指揮は任せたわよ！", "face": "u609"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "う……私は一体、何を……？", "face": "u114"}, {"name": "レーレン", "text": "……すまねえ、さっき渡した新薬のせいだ。\nあれの副作用で興奮して暴れてたあたしらを、\n王子たちと教え子たちが止めてくれたんだ。", "face": "u614"}, {"name": "レーレン", "text": "全部、あの薬を開発したあたしのせいだ……。", "face": "u614"}, {"name": "サイラス", "text": "……いや、未だ開発中と聞いていながら\n軽はずみに使用した我々の側にも問題はあった。\nその点については謝らせてくれ。", "face": "u1013"}, {"name": "モーティマ", "text": "わ……悪かったよ。", "face": "u14"}, {"name": "レーレン", "text": "……ありがとな、慰めてくれて。\nけど、どう足掻いたって\nあたしが生徒たちを襲っちまった事実は変わらねえ。", "face": "u614"}, {"name": "レーレン", "text": "教育者失格、ってやつだろうな。\n可愛い教え子たちと別れるのは辛いけど、\n講師就任の件は、辞退させてもらうぜ……。", "face": "u614"}, {"name": "ケイティ", "text": "……残念ですが、仕方ありませんね。\nでは、レーレン先生の採用は取り消しということで……。", "face": "u114"}, {"name": "ジョヴァンニ", "text": "――っざけんなよッ！　逃げんのかよ、先生！", "face": "u611"}, {"name": "レーレン", "text": "……え？", "face": "u614"}, {"name": "メーリス", "text": "ジョヴァンニの言う通りよ！\n私たち、まだまだ先生に教えてほしいことが\nいっぱいあるんだから！", "face": "u609"}, {"name": "ネーニャ", "text": "ケイティさん、お願い！\nレーレン先生の採用取り消しを取り消してぇっ！", "face": "u610"}, {"name": "ケイティ", "text": "…………残念ながら、レーレンさんの授業が\nたびたび安全性への配慮に欠けていたことは事実です。", "face": "u114"}, {"name": "ケイティ", "text": "……が、それは今後十分に留意して頂ければ良い話。\nこんなにも生徒に慕われており、研究者としても優秀な\n彼女は、これからの学園にとって必要な人材かと。", "face": "u114"}, {"name": "ケイティ", "text": "――と私個人は愚考しますが、いかがでしょう、王子？", "face": "u114"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "レーレン", "text": "王子、みんな……。\nこんなあたしを必要としてくれるってのか……？", "face": "u614"}, {"name": "レーレン", "text": "……へへ、ありがとな。\nそれじゃあ、新学期が始まったら世話になるぜ！", "face": "u614"}]}], "story_talk": true, "active": true}