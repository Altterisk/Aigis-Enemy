nterval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 6, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 1, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "physical", "attack_range": 100, "attack_speed": 40, "attack_wait": 40, "attack_interval": 121, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098928, "race_id": 9, "special_effect_id": 37, "missile_id": 64, "missile": {"speed": 3.0}, "master_id": 119, "global_id": 118, "ranged": true, "spawn_sec": 57}], "dialogue": [{"trigger": "start", "lines": [{"name": "メレディス", "text": "これでよし……。\n皆さん、お待たせしました。\n転送魔法陣をこれより起動させます！", "face": "u400"}, {"name": "ゴブリン", "text": "ギャギャ！　ニンゲン！\nモクヒョウ！　モドッテキタ！", "face": "l8b13693957b8"}, {"name": "バルバストラフ", "text": "むっ……。\n面倒なタイミングで\nゴブリンに見つかってしまったようじゃな。", "face": "u63"}, {"name": "サイラス", "text": "魔法都市の中にもゴブリンがいるのだろう？\n挟み撃ちされる前に、まずはこいつらを\n倒しておいた方が無難だな。", "face": "u13"}, {"name": "メレディス", "text": "そうですね。それに、転送魔法陣を起動した事で、\n都市の中から魔物に操られた\nゴーレムが出てくるかもしれません。", "face": "u400"}, {"name": "サイラス", "text": "ゴーレムか……。\nまったく、敵にまわるとこれほど\n厄介なものもないな。", "face": "u13"}, {"name": "バルバストラフ", "text": "愚痴をこぼす暇があったらお主も準備せい。\n……王子たちだけではちと厳しかろう。", "face": "u63"}, {"name": "アンナ", "text": "王子、敵がこちらへ向かってきます。\n慎重なご采配をお願い致します！", "face": "la84c39fa5a9d"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "敵を全部倒したみたいですね。\n王子、お疲れ様です。"}, {"name": "メレディス", "text": "あのゴーレムまで倒してしまうとは……。\nゴーレムを倒せるなんて、信じられない……。\nああどうしよう。その強さの秘密を研究したい……！", "face": "u400"}, {"name": "バルバストラフ", "text": "何をしておるメレディス！　\n惚けてないで転送魔法陣の使い方を教えてくれ。\nわしも転送魔法陣を使ってみたいのじゃ。", "face": "u63"}, {"name": "メレディス", "text": "バルバストラフさんは相変わらずの\n知的好奇心ですね。\n安心してください。そんなに慌てなくても私が――", "face": "u400"}, {"name": "メレディス", "text": "――って、\nちょっと貴方、何をしてるのですか！？\nまだ転送魔法陣に乗ってはダメですよ！！", "face": "u400"}, {"name": "モーティマ", "text": "ん？　何だよ、そんなに慌てて？\nもしかしてマズかったか？", "face": "u14"}, {"name": "モーティマ", "text": "……ん？　何だこれ……？\nお、おい！　俺の体が急に消え――うひぃッッ！！", "face": "u14"}, {"name": "アンナ", "text": "……モーティマさんが消えました。", "face": "l0d2c23b4a106"}, {"name": "バルバストラフ", "text": "わしが一番に入りたかったのにモーティマめ……。\nまあよい。わしらも後を追うとしよう。", "face": "u63"}, {"name": "アンナ", "text": "王子！　急いでモーティマさんを追いかけましょう！", "face": "la84c39fa5a9d"}]}], "active": true}