, "global_id": 6636, "ranged": true, "to_global_id": 6635, "route_behaviour": {"reroutes": ["Route=202", "Route=302", "Route=303", "Route=304", "Route=305", "Route=306", "Route=307", "Route=308", "Route=309", "Route=310", "Route=311", "Route=312", "Route=313", "Route=314", "Route=321", "Route=322", "Route=323", "Route=500", "Route=600", "Route=999"]}, "spawn_sec": 90}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械"], "hp": 22500, "attack": 550, "base_hp": 22500, "base_attack": 550, "damage_type": "physical", "armor_defense": 270, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126416, "special_effect_id": 659, "change_to": 3, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33018, "global_id": 6635, "ranged": true, "to_global_id": 6634}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["機械"], "hp": 22500, "attack": 550, "base_hp": 22500, "base_attack": 550, "damage_type": "physical", "armor_defense": 270, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 750.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126400, "special_effect_id": 657, "change_to": 2, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33017, "global_id": 6634, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 4, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 127}], "popups": ["フォーを倒すと\n以降、人形は生産されません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "フォー", "text": "なんだ、存外早い到着じゃないか……。\nもっと悲鳴を聞かせてくれると思ったんだけどねぇ。", "face": "lb0c511288c26"}, {"name": "フォー", "text": "ハハハ！　まぁいいさ！\n戦う気のある人間の最期っていうのも久々だ。\n無力に嘆くより、やはり抗った方が絵になるしね。", "face": "lb0c511288c26"}, {"name": "サンタヘイオス", "text": "フォー、あなたの企みもここまでです。\nクリスマスを破壊することは、\n私たちが決して許しません。", "face": "u1116a1"}, {"name": "サンタコーネリア", "text": "子どもの夢と未来を守るのがサンタの役目だ。\nお前はここで、私たちが止める。", "face": "u725"}, {"name": "フォー", "text": "……へぇ、子どもの夢と未来？\n俺も同意見だよサンタの淑女諸君。", "face": "lb0c511288c26"}, {"name": "フォー", "text": "夢と未来っていうのは大事だ……。\nそいつがないと、悲しみのどん底で、\n這い上がってやろうっていう決意が出てこない。", "face": "lb0c511288c26"}, {"name": "フォー", "text": "俺はそういう人間の強さが好きなんだ。\nだからこそ、夢と希望に溢れた輝く瞬間を！\n粉々に砕いて！　ドッカァンとやりたいのさ！！", "face": "lb0c511288c26"}, {"name": "サンタヘイオス", "text": "……コーネリア、いえ、サンタコーネリア。\nどうやら話は通じないようです。", "face": "u1116a1"}, {"name": "サンタコーネリア", "text": "ああ、サンタヘイオス。\nどうやら剣を抜くしかないらしい。", "face": "u725"}, {"name": "フォー", "text": "いいねぇ、強気なのは好みだ。\n――でも、俺の計画を邪魔した罰は受けてもらおうか。", "face": "lb0c511288c26"}, {"name": "サンタヘイオス", "text": "……コンベアが動き始めた？", "face": "u1116a1"}, {"name": "フォー", "text": "ハハハッ！　生産ラインを止める鍵は、\nこの俺の腹の中にあるぞ？", "face": "lb0c511288c26"}, {"name": "フォー", "text": "雪の国に人形が溢れかえる未来！\nそいつに抗いたいなら、\nほら、俺を殺してみな、王子ィ……！！", "face": "lb0c511288c26"}, {"name": "カノン", "text": "鍵を奪わない限り、\n生産ラインが止まらないってこと……？", "face": "u726"}, {"name": "アイリーン", "text": "……王子、汚れ仕事は私が。", "face": "u315"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "アイリーン", "text": "……承知しました。\n王子、あのフォーは人形よりも手練です。ご注意を。", "face": "u315"}, {"name": "サンタヘイオス", "text": "王子、フォーを倒し、\n生産ラインを止めましょう。\nクリスマスを守れるのは、私たちだけです！", "face": "u1116a1"}]}, {"trigger": "end", "lines": [{"name": "フォー", "text": "ハァ……なんだ、魔王を倒したってのは本当だったか。\nこんなに強いなら\nもう少しイイ玩具を用意するんだった。", "face": "lb0c511288c26"}, {"name": "フォー", "text": "だが楽しみが増えた！！\n強い人間が絶望に濡れた時、\nそれでも立ち上がるのかどうか！！", "face": "lb0c511288c26"}, {"name": "フォー", "text": "ああ、楽しみだ……。\n次はどんな遊びを――ギギッ、シテ、ヤロウ、カ――", "face": "lb0c511288c26"}, {"name": "サンタヘイオス", "text": "……このフォーも、人形だったようですね。", "face": "u1116a1"}, {"name": "サンタコーネリア", "text": "王子、生産ラインはすべて停止した。\nこれでフォー人形が作られることはないぞ。", "face": "u725"}, {"name": "サンタヘイオス", "text": "……クリスマスは、無事に守られましたね。", "face": "u1116a1"}, {"name": "サラサ", "text": "あらあら、全然無事じゃないわよ？\n遅れちゃったおもちゃの製造も急がないとだし、\nプレゼントの輸送だってしないといけないんだから！", "face": "u317"}, {"name": "サンタコーネリア", "text": "フッ……そうだな。\nサンタヘイオス、共に子どもたちの夢を紡ぎに行くぞ。", "face": "u725"}, {"name": "サンタヘイオス", "text": "ふふっ、ええ。\n未来を担う子どもたちのために！", "face": "u1116a1"}, {"name": "アンナ", "text": "それでは王子、私たちも王国へ戻りましょうか。\n此度の闇の組織征伐、お疲れさまでした！"}]}], "story_talk": true, "active": true}