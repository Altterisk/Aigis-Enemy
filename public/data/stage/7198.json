{"quest_id": 7198, "name": "絶望を呼ぶ道化", "description": "聖夜を血の海に染めんとする\n道化師フォーの野望を阻止し\n平和なクリスマスを取り戻せ！\n神級（★１獲得の目安：平均Lv50）", "event": "ホーリーナイト・マーダークラウン", "event_category": "History", "mission_id": 920153, "map_no": 5812, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 7, "form_count": 2, "tags": ["機械"], "hp": 9500, "attack": 400, "base_hp": 9500, "base_attack": 400, "damage_type": "physical", "armor_defense": 170, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126416, "special_effect_id": 659, "change_to": 1, "missile_id": 515, "missile": {"speed": 8.0, "splash": 67}, "master_id": 33021, "global_id": 6638, "ranged": true, "to_global_id": 6637, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 2}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械"], "hp": 9500, "attack": 400, "base_hp": 9500, "base_attack": 400, "damage_type": "physical", "armor_defense": 170, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126400, "special_effect_id": 657, "missile_id": 515, "missile": {"speed": 8.0, "splash": 67}, "master_id": 33020, "global_id": 6637, "ranged": true}, {"enemy_id": 3, "source": "local", "count": 7, "form_count": 2, "tags": ["機械"], "hp": 22500, "attack": 550, "base_hp": 22500, "base_attack": 550, "damage_type": "physical", "armor_defense": 270, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126416, "special_effect_id":