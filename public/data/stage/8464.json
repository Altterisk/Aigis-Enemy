": 1, "tags": ["変異"], "hp": 3300, "attack": 580, "base_hp": 3300, "base_attack": 580, "damage_type": "physical", "attack_range": 180, "attack_speed": 40, "attack_wait": 30, "attack_interval": 105, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2115744, "race_id": 9, "special_effect_id": 309, "change_to": 8, "change_condition": 1, "missile_id": 298, "missile": {"speed": 2.0}, "master_id": 31245, "global_id": 4864, "ranged": true, "variants": [{"tags": ["変異"], "hp": 3300, "attack": 580, "base_hp": 3300, "base_attack": 580, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2115760, "race_id": 9, "special_effect_id": 309, "master_id": 31244, "global_id": 4863}], "spawn_sec": 166}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "tags": ["スライム"], "hp": 8000, "attack": 350, "base_hp": 8000, "base_attack": 350, "damage_type": "magical", "armor_defense": 2200, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112576, "missile_id": 11, "master_id": 30696, "global_id": 4315, "ranged": true, "spawn_sec": 210}], "popups": ["人型のスライムから\n遠距離攻撃を受けると\n攻撃後の待ち時間が増加します。\n\nブロックされている間は、\n攻撃に遅延効果が無くなります。", "変異したゴブリンは\nHPが徐々に回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リッカ", "text": "……ほわぁ。", "face": "u152"}, {"name": "ティアル", "text": "……ほえぇ。", "face": "u505"}, {"name": "ウェンディ", "text": "この規模の上下水道が、\n都市全域の地下に張り巡らされている……。\nすごい都市ね、鋼の都は。", "face": "u401"}, {"name": "セブン", "text": "ん……王国の水道に似てないか？\n王城付近の地下水道そっくりだ。", "face": "u449"}, {"name": "アンナ", "text": "王国の上下水道技術は、\n鋼の都との技術協力で培われたものですから。"}, {"name": "アイゼルフ", "text": "代わりに鋼の都は、\n王国の魔法技術を教わったりしたそうで。", "face": "u2343a1"}, {"name": "セブン", "text": "へぇ……。\nなんだか懐かしいな、この風景。", "face": "u449"}, {"name": "ダルティエ", "text": "そういえば、水道管が盗まれる事件が\n多発していた頃があったとか――", "face": "u2066a1"}, {"name": "セブン", "text": "こ、こっち見んな！\nやってないからな！！", "face": "u449"}, {"name": "アイシャ", "text": "まぁまぁ、じゃれ合うのはそれくらいで。\n今は先を急ごう。\nそれに――嫌な気配もする。", "face": "u181"}, {"name": "ピーク", "text": "ここは古い区画ですから……。\nおそらく、魔物が入り込んでいるはずです。", "face": "u2344a1"}, {"name": "アイゼルフ", "text": "慎重に進みましょう。\n点検もほとんどされていないので、\n独自の成長を遂げた魔物もいるかもしれません！", "face": "u2343a1"}]}, {"trigger": "end", "lines": [{"name": "ピッキー", "text": "スライムが、人型をとってませんでした？", "face": "u671"}, {"name": "マキナ", "text": "前例がないわけではないけど……。\n鋼の都を巡るエネルギーラインから、\n何らかの影響を受けたのかもね。", "face": "u376"}, {"name": "マキナ", "text": "……後日あらためて研究しにこないと。", "face": "u376"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "マキナ", "text": "あ、悪用はしないぞ。\nうん。大丈夫大丈夫。", "face": "u376"}, {"name": "アンナ", "text": "研究はともかく、再訪の必要はありそうですね。\n変異した魔物の生き残りがいましたし、\n大規模な掃討作戦が必要かもしれません。"}, {"name": "アイシャ", "text": "それも、今回の事件を片付けてからだね。\n都市上層に出るのに、あとどれくらいかかる？", "face": "u181"}, {"name": "アイゼルフ", "text": "そろそろ地上へ出る通路です。\n王子様、お願いです。\n鋼の都のみんなを、助けてください！", "face": "u2343a1"}]}], "active": true}