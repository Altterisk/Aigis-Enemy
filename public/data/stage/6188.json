source": "local", "count": 1, "form_count": 2, "hp": 4000, "attack": 150, "base_hp": 4000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111152, "race_id": 9, "change_to": 9, "change_condition": 2, "master_id": 30442, "global_id": 4061, "to_condition": 2, "to_global_id": 4054, "spawn_sec": 134}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6300, "attack": 320, "base_hp": 6300, "base_attack": 320, "damage_type": "physical", "armor_defense": 40, "magic_defense": 10, "attack_speed": 1, "attack_wait": 12, "attack_interval": 42, "move_speed": 1500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111056, "race_id": 16, "special_effect_id": 54, "master_id": 30435, "global_id": 4054, "from_condition": 2}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103360, "race_id": 9, "master_id": 441, "global_id": 440, "spawn_sec": 138}], "dialogue": [{"trigger": "start", "lines": [{"name": "ぬらりひょん", "text": "お前がここに封印されていた魔物か。\nうーむ、想像と少し違うな……。\n何者だ名を名乗れ！", "face": "l6f94a454d720"}, {"name": "？？？", "text": "なんだ、このじいさん。\nオレの名前を知りたきゃ、\nまず、お前が名乗れよ。", "face": "u327"}, {"name": "ぬらりひょん", "text": "な、なんだと……！　よ、よかろう。\nわしは妖怪総大将ぬらりひょん様じゃ。\nさあ、頭が高いひかえおろう。", "face": "l625ab46cdc97"}, {"name": "？？？", "text": "妖怪の分際でえらそうに。\nよく聞け、オレの名は……ん？\nオレの名は……あれ、なんだっけ？", "face": "u327"}, {"name": "ぬらりひょん", "text": "自分の名前もわからぬのか！？\nまあ良い、封印を解いてやったのだ\nわが妖怪軍団に加わるのだ。", "face": "l6f94a454d720"}, {"name": "？？？", "text": "へー、オレの主になりたいっていうのか。\nいいだろう、オレよりも強かったら\n手下になってやるよ。", "face": "u327"}, {"name": "ぬらりひょん", "text": "ちょ、ちょっと待て！", "face": "l625ab46cdc97"}, {"name": "アンナ", "text": "そうです。ちょっとお待ちください。\nあなたは何者ですか。", "face": "lb17e96a90f21"}, {"name": "？？？", "text": "うるさいな。このじいさんをぶっ倒した後に\n相手してやるよ。\nさあ、じいさん、こっちに来い！", "face": "u327"}, {"name": "ぬらりひょん", "text": "ま、待てといっておるじゃろ！\nこら、わしを掴んだまま飛ぶなぁぁぁ……！", "face": "l625ab46cdc97"}, {"name": "兵士", "text": "王子、雲に乗った魔物がぬらりひょんと戦場を離脱！\nまた、魔物の群れがこちらに\n向かって来ています！", "face": "l691c92aa102a"}, {"name": "ケイティ", "text": "こんな時に！　王子、まずは魔物を倒しましょう。\n雲に乗った魔物も戻ってくるかもしれません。\n空飛ぶ敵も配慮に入れた采配をお願いします。", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "サヨ", "text": "戦いの後、王子を主と認めた空飛ぶ魔物……\n……いえ、魔物じゃなくて仙猿だったわね。\n封じられていた仙猿、ファーも仲間に加わる事になった。", "face": "u510"}, {"name": "サヨ", "text": "そう言えば、長い封印で名前も覚えていなかった彼女に\n『ファー』って名付けたのは王子だったっけ。", "face": "u510"}, {"name": "サヨ", "text": "あの時は、空を飛ぶファーに気を取られて、\n地上からあなたを尾行する\nわたしの変装に気づかなかったようね。", "face": "u510"}, {"name": "サヨ", "text": "ぬらりひょん……昔妖怪に変装して、\n奴の許に潜入した事もあったけど。あの人、\n妖怪に対しては結構優しい一面もあったのよね。", "face": "u510"}, {"name": "サヨ", "text": "中でも、自慢の娘に対しては甘々で……と、\nいけない。これはまた別の話だったわ！", "face": "u510"}, {"name": "サヨ", "text": "でも、この後も幾度となく戦う事になる妖怪達と、\n手を取り合い共に戦う道を開いた王子はスゴイと思う。\n……まだ英雄って認めたわけじゃないけれど。", "face": "u510"}, {"name": "サヨ", "text": "だって、結論を出すにはまだ早すぎるでしょ。\nあなたが辿ってきた道はまだまだ途中なんだから。", "face": "u510"}]}], "active": true}