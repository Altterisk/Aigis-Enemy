"tags": ["アンデッド"], "hp": 7000, "attack": 300, "base_hp": 7000, "base_attack": 300, "damage_type": "physical", "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099104, "special_effect_id": 233, "master_id": 161, "global_id": 160, "spawn_sec": 81}, {"enemy_id": 21, "source": "local", "count": 13, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 3000, "attack": 360, "base_hp": 3000, "base_attack": 360, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 10, "attack_interval": 131, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2111632, "race_id": 11, "special_effect_id": 233, "master_id": 30613, "global_id": 4232, "spawn_sec": 81}, {"enemy_id": 22, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "tags": ["アンデッド"], "hp": 800, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 90}], "popups": ["血の使い魔(ヴァンパイア公爵)の\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ヴァーニィ", "text": "ありえない……ありえるはずがない！\nなぜ……なぜ今になって……！！", "face": "l0af7672e8072"}, {"name": "ヴァーニィ", "text": "私を見捨て、血族を見捨て、\n人に憧れた愚かな始祖よ……なぜ今この時代に……っ！！", "face": "l0af7672e8072"}, {"name": "ヴァンパイア公爵", "text": "……我が主よ、どうか気をお鎮めください。\n城門の前まで、王国軍が迫っております。", "face": "lae731360ac43"}, {"name": "ヴァンパイア公爵", "text": "手勢を散らされた我々では、\n主様を守護し、逃げおおせることは難しいでしょう。", "face": "lae731360ac43"}, {"name": "ヴァンパイア公爵", "text": "――ゆえに、この身を捧げましょう。\n主様こそ、血族が誇り、輝ける魂に惑わされぬ、\n真なる夜の王たるべき方なれば。", "face": "lae731360ac43"}, {"name": "ヴァーニィ", "text": "……貴様、これより先の命に未練はないのか。", "face": "l0af7672e8072"}, {"name": "ヴァンパイア公爵", "text": "我が身が永久に、御身の力となれるなら、\nそれは永遠を生きるに等しい名誉でしょうとも。", "face": "lae731360ac43"}, {"name": "ヴァーニィ", "text": "……ふふ、この時代に至って、\nようやく私は良き臣下を得たのだな。", "face": "l0af7672e8072"}, {"name": "ヴァーニィ", "text": "これより、貴様を我が血の使い魔と化す。\nどうか魂まで焼かれてくれるなよ。\n……私の、初めての臣下よ。", "face": "l0af7672e8072"}, {"name": "ヴァンパイア公爵", "text": "――御意に。", "face": "lae731360ac43"}, {"name": "セフィーレ", "text": "追い詰めましたよ、ヴァーニィ。\nここがあなたの、最期の場所です。", "face": "u1332a1"}, {"name": "ヴァーニィ", "text": "……まだ、終わりではない。\nこの身には、守るべきものができてしまったからな。", "face": "l0af7672e8072"}, {"name": "セフィーレ", "text": "守るべき、もの……？", "face": "u1332a1"}, {"name": "ヴァーニィ", "text": "私を信じてくれる者、その誇りを預かった。\nなればもはや、諦めることはできまい。", "face": "l0af7672e8072"}, {"name": "ラキュア", "text": "なるほど……ヴァンパイア公爵を取り込んだか。\n公爵の全ての力を引き出してはいないようだが、\nそれでも――これだけの強き血の香りを漂わせるとは。", "face": "u344"}, {"name": "ヴァーニィ", "text": "――さぁ、行くぞ王子。\n貴様の血、存分に味わわせてもらおう。", "face": "l0af7672e8072"}, {"name": "王子", "text": "…………！！", "face": "u1"}]}, {"trigger": "end", "lines": [{"name": "ヴァーニィ", "text": "…………ここまで、か。", "face": "l0af7672e8072"}, {"name": "セブン", "text": "ヴァーニィの姿が消えて……どこに行きやがった！？", "face": "u1333a1"}, {"name": "エマ", "text": "公爵を名乗るあの者の力を取り込み、\nより強き血の力を行使したのでしょう。\nあれも高位の転移術のひとつかと。", "face": "u582"}, {"name": "セフィーレ", "text": "これで、一段落でしょうか……？", "face": "u1332a1"}, {"name": "アンナ", "text": "まだ散らばったアンデッドの対処が残ってはいますが、\nようやく、あの村を解放できましたね。"}, {"name": "王子", "text": "…………（くいくい）", "face": "u1"}, {"name": "ディエーラ", "text": "王子？　……ふふっ、えぇ、もちろんです。\n私の商会からも、\nあの村に冬の分の食料を提供しましょう。", "face": "u538"}, {"name": "トトノ", "text": "それから、ハロウィンのための食材もですね。\nあれだけ怖い思いをしたんです。\n村の皆さんにも、楽しいことが必要でしょう。", "face": "u316"}, {"name": "パリオス", "text": "やったぁ！　ハロウィンの続きだー！", "face": "u1334a1"}, {"name": "セブン", "text": "おいおい、空きっ腹に食うと腹壊すぞ？", "face": "u1333a1"}, {"name": "セフィーレ", "text": "……ふふっ、まずは片付けからですよ？\nそれと兵と村人に炊き出しもしてあげないと。", "face": "u1332a1"}, {"name": "セブン", "text": "…………やっぱ、お前なんか変わったよなぁ。", "face": "u1333a1"}, {"name": "セフィーレ", "text": "そうでしょうか？\n私は何も変わっていませんよ。\n――ただ、守りたいものができただけですから。", "face": "u1332a1"}]}, {"trigger": "end", "lines": [{"name": "村娘", "text": "（あの力は……何だったのでしょうか……？）", "face": "l77e6736f5115"}, {"name": "村娘", "text": "（身体の奥から……力が湧き上がってきて……。\n誰かが、助けてくれたかのような……）", "face": "l77e6736f5115"}, {"name": "村娘", "text": "（セフィーレさま、私は、いったい……？）", "face": "l77e6736f5115"}]}], "map": {"image": "Map920166_5980", "w": 960, "h": 640, "spots": [{"k": "b", "x": 948, "y": 487}, {"k": "m", "x": 432, "y": 336, "id": 200}, {"k": "m", "x": 518, "y": 344, "id": 201}, {"k": "m", "x": 525, "y": 507, "id": 202}, {"k": "m", "x": 614, "y": 507, "id": 203}, {"k": "m", "x": 360, "y": 492, "id": 204}, {"k": "m", "x": 680, "y": 369, "id": 205}, {"k": "m", "x": 743, "y": 410, "id": 206}, {"k": "m", "x": 480, "y": 279, "id": 207}, {"k": "m", "x": 462, "y": 211, "id": 208}, {"k": "m", "x": 508, "y": 155, "id": 209}, {"k": "m", "x": 280, "y": 473, "id": 210}, {"k": "m", "x": 142, "y": 435, "id": 211}, {"k": "m", "x": 694, "y": 499, "id": 212}, {"k": "m", "x": 852, "y": 483, "id": 213}, {"k": "m", "x": 671, "y": 159, "id": 214}, {"k": "m", "x": 743, "y": 278, "id": 215}, {"k": "m", "x": 857, "y": 296, "id": 216}, {"k": "m", "x": 774, "y": 342, "id": 217}, {"k": "m", "x": 336, "y": 313, "id": 218}, {"k": "m", "x": 639, "y": 96, "id": 219}, {"k": "m", "x": 772, "y": 472, "id": 220}, {"k": "m", "x": 443, "y": 503, "id": 221}, {"k": "m", "x": 212, "y": 451, "id": 222}, {"k": "m", "x": 603, "y": 353, "id": 223}, {"k": "m", "x": 570, "y": 121, "id": 224}, {"k": "m", "x": 705, "y": 220, "id": 225}, {"k": "r", "x": 821, "y": 405, "id": 300}, {"k": "r", "x": 541, "y": 202, "id": 301}, {"k": "r", "x": 419, "y": 273, "id": 302}, {"k": "r", "x": 419, "y": 452, "id": 303}, {"k": "r", "x": 490, "y": 433, "id": 304}, {"k": "r", "x": 608, "y": 298, "id": 305}, {"k": "r", "x": 710, "y": 317, "id": 306}, {"k": "r", "x": 372, "y": 399, "id": 307}, {"k": "r", "x": 657, "y": 421, "id": 308}]}, "start_cost": 10, "active": true}