{"quest_id": 7412, "name": "吸血鬼城の決戦", "description": "村人と共に包囲を脱し反撃に転じた一行は、\n追い詰めたヴァーニィの根城で決戦に挑む。\n＜時間経過でのコスト回復量が60％低下＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["時間経過でのコスト回復量が60％低下"], "event": "ハロウィン包囲戦線", "event_category": "History", "mission_id": 920166, "map_no": 5980, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 250, "gold": 1200, "drops": [{"card": 57, "c": 1}, {"card": 58, "c": 1}, {"card": 59, "c": 1}, {"card": 60}], "capacity": 8, "modifiers": [{"kind": "term", "influence": 30, "params": [40]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 10, "form_index": 0, "form_count": 2, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122560, "special_effect_id": 242, "change_to": 1, "master_id": 33657, "global_id": 7274, "to_condition": 0, "to_global_id": 7275, "route_behaviour": {"reroutes": ["Route=900", "Route=901", "Route=902", "Route=930", "Route=999"]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アンデッド", "ステルス"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2122560, "change_to": 2, "change_condition": 1, "master_id": 33658, "global_id": 7275, "from_condition": 0, "variants": [{"tags": ["アンデッド"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "physical", "armor_defense": 40, "attack_speed": 80, "attack_wait": 80, "attack_interval": 296, "move_speed": 2400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist"