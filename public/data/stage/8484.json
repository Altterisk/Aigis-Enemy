 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 49, "global_id": 48, "ranged": true, "spawn_sec": 64}, {"enemy_id": 9, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー"], "hp": 3000, "attack": 500, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 26, "global_id": 25, "spawn_sec": 75}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 1, "hp": 10000, "attack": 400, "base_hp": 10000, "base_attack": 400, "damage_type": "magical", "armor_defense": 40, "attack_range": 200, "attack_speed": 1, "attack_wait": 20, "attack_interval": 75, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131072, "race_id": 16, "missile_id": 614, "missile": {"speed": 4.0}, "master_id": 34132, "global_id": 7749, "ranged": true, "spawn_sec": 88}, {"enemy_id": 11, "source": "local", "count": 6, "form_count": 1, "hp": 19000, "attack": 900, "base_hp": 19000, "base_attack": 900, "damage_type": "physical", "armor_defense": 240, "attack_range": 360, "attack_speed": 1, "attack_wait": 90, "attack_interval": 223, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2131088, "race_id": 16, "missile_id": 615, "missile": {"speed": 6.0}, "master_id": 34134, "global_id": 7751, "ranged": true, "spawn_sec": 127}, {"enemy_id": 12, "source": "local", "count": 7, "form_count": 1, "tags": ["女性"], "hp": 1500, "attack": 250, "base_hp": 1500, "base_attack": 250, "damage_type": "magical", "armor_defense": 50, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097600, "race_id": 16, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 31680, "global_id": 5299, "ranged": true, "spawn_sec": 129}, {"enemy_id": 13, "source": "local", "count": 7, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 150, "attack_speed": 70, "attack_wait": 60, "attack_interval": 157, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 52, "global_id": 51, "ranged": true, "spawn_sec": 134}], "popups": ["冒険者は倒されると、\nその場で一度だけ復活します。\n\n復活後の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "プロエ", "text": "よく辿り着いた、長かった予選もこの試合で最後だ。", "face": "u1768a1"}, {"name": "冒険者", "text": "最終戦のカードは、まあ大方の予想通りだな。", "face": "ld12e12cfde46"}, {"name": "冒険者", "text": "世界最高峰の冒険者パーティ『虚空の花』、\nそのリーダーを務める隻眼のソードマスター。", "face": "ld12e12cfde46"}, {"name": "冒険者", "text": "依頼成功率は驚異の９８％を誇る凄腕だ。\n俺はあの人以上の冒険者を見たことがねぇ。", "face": "ld12e12cfde46"}, {"name": "ジュウベエ", "text": "剣士であれば必ず一度は耳にする生きる伝説。\nまさか斯様な場所で出会えるとは、僥倖ですな。", "face": "u699"}, {"name": "ジークリンデ", "text": "同感だな、いつか手合わせをしてみたいと思っていた。\nあんまりにも表に出てこないものだから少し諦めていたが、\nようやく巡ってきたこの縁を逃す手はない。", "face": "u429"}, {"name": "ジンレイ", "text": "ふーん、あの二人にそこまで言わせるほどの使い手かぁ。", "face": "u2065a1"}, {"name": "ミカ", "text": "強そうな人たちが強そうな雰囲気出してる！！", "face": "u1502a1"}, {"name": "ナシート", "text": "……凄い気迫だな、近寄り難いほどに。", "face": "u1610a1"}, {"name": "チェルシー", "text": "（ど、どうなっちゃうんだろう……！？）", "face": "u2369a1"}, {"name": "プロエ", "text": "それでは戦神コロッセウム・冒険者の部、\n予選最終試合を此処に執り行う。", "face": "u1768a1"}, {"name": "プロエ", "text": "両者構えて……始めッ！！", "face": "u1768a1"}]}, {"trigger": "end", "lines": [{"name": "プロエ", "text": "そこまで、両者剣を収めろッ！", "face": "u1768a1"}, {"name": "ジークリンデ", "text": "……ここまで、だな。", "face": "u429"}, {"name": "ジュウベエ", "text": "然り、これ以上は命のやり取りになりましょう。", "face": "u699"}, {"name": "ポーラ", "text": "（ソードマスターさんが無言で帰っていくのです……）", "face": "u253"}, {"name": "ジンレイ", "text": "ひゅー、剣筋はもちろん去り際まで格好良いねぇ。", "face": "u2065a1"}, {"name": "リーフ", "text": "うん、ボクもつい見入っちゃった。\nこれは負けていられないなぁ……。", "face": "u2368a1"}, {"name": "冒険者", "text": "まさか本当にあの三人を倒しちまうとは、\nやっぱりあんたらってとんでもねぇんだな。", "face": "ld12e12cfde46"}, {"name": "アイネ", "text": "伊達に世界は救っていない、というわけですね。", "face": "u2262a1"}, {"name": "アイネ", "text": "予選勝ち抜き、おめでとうございます。\n決勝戦の詳細は追って通知しますので、\nひとまずは身体を休めておいてください。", "face": "u2262a1"}, {"name": "ニーカ", "text": "ですって、チェルシーちゃん私たちも──", "face": "u2282a1"}, {"name": "チェルシー", "text": "………………。", "face": "u2369a1"}, {"name": "ニーカ", "text": "チェルシーちゃん？　おーい、チェルシーちゃーん？", "face": "u2282a1"}, {"name": "ミェール", "text": "……一人で帰っちゃいましたわね。", "face": "u1220a1"}, {"name": "ニーカ", "text": "チェルシーちゃん、どうしたんでしょうか……。", "face": "u2282a1"}, {"name": "チェルシー", "text": "（見えなかった、動けなかった、それは構わない。\n実力が足りないのなら努力して強くなれば良いから）", "face": "u2369a1"}, {"name": "チェルシー", "text": "（でも、私、さっき──）", "face": "u2369a1"}, {"name": "チェルシー", "text": "（戦おうとすら、しなかった……？）", "face": "u2369a1"}]}], "active": true}