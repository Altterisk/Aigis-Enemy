ck_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 10, "master_id": 30345, "global_id": 3964, "to_global_id": 3965, "spawn_sec": 172}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 9, "master_id": 30346, "global_id": 3965}, {"enemy_id": 12, "source": "local", "count": 5, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 171, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101136, "race_id": 7, "change_to": 8, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 658, "global_id": 657, "ranged": true, "to_global_id": 348, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 191}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 349, "global_id": 348, "ranged": true}, {"enemy_id": 13, "source": "local", "count": 4, "form_count": 2, "hp": 6000, "attack": 1500, "base_hp": 6000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106544, "race_id": 7, "change_to": 13, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 821, "global_id": 820, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 821, "spawn_sec": 236}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "from_condition": 4, "trigger_ticks": 1}], "popups": ["クラールフがいる間は\n悪天候『豪雨』が発生します。\n\n 　　悪天候：豪雨\n\n・敵味方の『射程』減少\n・一部の味方は影響を受けない\n　　　　　　(1/2)", "クラールフから攻撃を受けると、\n攻撃後の待ち時間が増加します。\n\n麻痺などの状態異常と同じく\n特定のユニットで軽減、\n無効化が可能です。\n\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――なるほど、あれが王国軍か。\n英雄王の系譜が、この時代にまで残っているとはな。\n先日浜辺に残した征伐部隊が敗走したのも頷ける。", "face": "lade25b839a20"}, {"name": "？？？", "text": "ガリウスの若造に、英雄王の末裔……。\n何れも母なる海に還ることの出来ぬ者どもだが、\nこれは少しばかり、愉快な状況になってきたものよ。", "face": "lade25b839a20"}, {"name": "マーマン", "text": "クラールフ様、あの岩場の向こうまで\n王国軍が接近しております。\n我らが同胞の仇、ここで討ち取りましょう！", "face": "l957f09d4fc8f"}, {"name": "クラールフ", "text": "ああ、母なる海の抱擁に拒まれし者どもに、\n水底の愛情というものを教えてやるがよい。", "face": "lade25b839a20"}, {"name": "クラールフ", "text": "さて、我はしばし姿を隠そう。\n王子なる者の軍勢が出揃うまで待ってやるのも、\n連中の精強さとあり方を知る上では重要だからな。", "face": "lade25b839a20"}, {"name": "マーマン", "text": "――はっ！\n我らが深海の王よ！", "face": "l957f09d4fc8f"}, {"name": "アンナ", "text": "――王子、魚人の出没報告があったのは、\nこのあたりの海岸です。", "face": "l3d5e7de36b33"}, {"name": "フェドラ", "text": "気味が悪いわねぇ。こういう日には、\n何か良くないことが起きるものだけれど……。", "face": "u45"}, {"name": "アンナ", "text": "念の為に近隣の漁村には、\n船を出さないようには伝えておきましたが……。", "face": "l39301b82e50e"}, {"name": "リーンベル", "text": "何にせよ、この辺りに出た魚人を倒さないと\n村人も漁には出られないだろう。\n王子、慎重な指揮を頼んだぞ。", "face": "u268"}]}, {"trigger": "battle", "at_sec": 66, "lines": [{"name": "クラールフ", "text": "――その剣技、まさしく英雄王の系譜。\n潮流、水底の音、母なる海の愛を知らぬ者よ、\nその実力は本物であるようだな。", "face": "lade25b839a20"}, {"name": "王子", "text": "…………！！", "face": "u1"}, {"name": "シャディア", "text": "……何？　その姿、その声……。\nまさか……クラールフ殿か……？", "face": "u713"}, {"name": "クラールフ", "text": "おお、誰かと思えば魔王の器の妹ではないか。\n久しいな、千年戦争以来か。", "face": "lade25b839a20"}, {"name": "フェドラ", "text": "あら？　シャディア、あの魔物を知っているの？", "face": "u45"}, {"name": "シャディア", "text": "……彼は魔物などではない。\n彼は千年戦争の折、物質界の側に立って魔王と戦った、\n深海に生きる者達の王、偉大なるクラールフ殿だ。", "face": "u713"}, {"name": "アンナ", "text": "魔王と戦った……！？\nならばどうして、漁村を襲ったりしたのでしょう……？", "face": "l39301b82e50e"}, {"name": "クラールフ", "text": "ははっ、シャディアよ、\nまだ我が人の味方をしたと吹聴しているのか。\n過去に何度も訂正してやったはずだが？", "face": "lade25b839a20"}, {"name": "シャディア", "text": "しかし、貴殿は確かにこの世界のため、\n眷属を引き連れて魔王軍と戦ってくれた。\nそれだけは揺るぎなき事実だろう。", "face": "u713"}, {"name": "クラールフ", "text": "あの時はまだ、この世界に\n守るべき価値があったというだけのこと。\nそして再び深海より目覚めた今、我は――", "face": "lade25b839a20"}, {"name": "クラールフ", "text": "――この世界を一度終わらせるか否か、\nそれを見極める段階に来たと判断したまでのことよ。", "face": "lade25b839a20"}, {"name": "フェドラ", "text": "シャディア、どうやら話は通じないみたいよ？\n今は魚人の群れを退ける方が先決じゃないかしら。", "face": "u45"}, {"name": "シャディア", "text": "……そうだな。\n王子、クラールフ殿は天候すら操る力を持つ。\n豪雨の中では遠隔攻撃を扱う者が不利となるだろう。", "face": "u713"}, {"name": "リーンベル", "text": "それにあの水による攻撃は厄介だな。\n身動きを封じる力があるようだ。\n王子、兵の配置には気をつけるようにな。", "face": "u268"}]}, {"trigger": "end", "lines": [{"name": "クラールフ", "text": "――成程、強い。\nかの英雄王には届かぬまでも、\n我が静かなる心を揺すぶるだけの力はあるとみえる。", "face": "lade25b839a20"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "シャディア", "text": "……ならばクラールフ殿、千年戦争と同じ様に、\n私達と共に戦ってもらえないだろうか……？", "face": "u713"}, {"name": "クラールフ", "text": "――いいや、まだ足りぬ。", "face": "lade25b839a20"}, {"name": "クラールフ", "text": "母なる海に還ることの出来ぬ、溺れる民を救うか否か。\nあるいは魔王に与し、世界を押し流すかどうか。\nその結論は、未だ出ておらぬのだよ。", "face": "lade25b839a20"}, {"name": "クラールフ", "text": "さぁ、我が眷属達よ。故に我は世界を巡ろう。\nこの物質界が未だ、\n守る価値があるかどうかを見極めよう。", "face": "lade25b839a20"}, {"name": "マーマン", "text": "――はっ、我らが深海の王よ！", "face": "l957f09d4fc8f"}, {"name": "アンナ", "text": "……クラールフの軍勢が、退いていきます。"}, {"name": "リーンベル", "text": "あの軍勢全てが魔王軍についたらと思うと、\n正直ぞっとするな……。", "face": "u268"}, {"name": "シャディア", "text": "……全てが上手く行くはずもない、か。\n千年戦争に縁のある者なら、\n手を貸してくれるかもしれないと思ったのだが。", "face": "u713"}, {"name": "シャディア", "text": "甘い考えは捨てたほうが良さそうだ。\n済まなかったな、王子。\nひとまず拠点に帰還するとしよう。", "face": "u713"}]}], "active": true}