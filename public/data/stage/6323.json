{"quest_id": 6323, "name": "魔を呼ぶ器", "description": "プシュケを依り代に、魔神を召喚せんと\n企む魔神崇拝の教団員。呼び出されし\n魔神の眷属を倒し、プシュケを救い出せ！\n神級（★１獲得の目安：平均Lv50）", "event": "夢現のダークプリースト", "event_category": "History", "mission_id": 920100, "map_no": 3260, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_count": 1, "hp": 1800, "attack": 300, "base_hp": 1800, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 141, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101568, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 314, "global_id": 313, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101536, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 316, "global_id": 315, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 1800, "attack": 200, "base_hp": 1800, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 101, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101552, "race_id": 16, "missile_id": 6, "master_id": 315, "global_id": 314, "ranged": true, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 13000, "attack": 500, "base_hp": 13000, "base_attack": 500, "damage_type": "physical", "armor_defense": 650, "magic_defense": 40, "attack_speed": 40, "attack_wait": 3, "attack_interval": 83, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2101200, "race_id": 3, "special_effect_id": 51, "master_id": 224, "global_id": 223, "spawn_sec": 9}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 6000, "base_hp": 6000, "damage_type": "physical", "armor_defense": 800, "magic_defense": 50, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101840, "race_id": 3, "special_effect_id": 55, "master_id": 434, "global_id": 433, "spawn_sec": 9}, {"enemy_id": 6, "source": "local", "count": 4, "form_count": 1, "hp": 3000, "attack": 5000, "base_hp": 3000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 40, "attack_wait": 30, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102128, "race_id": 3, "special_effect_id": 57, "master_id": 359, "global_id": 358, "spawn_sec": 9}, {"enemy_id": 7, "source": "local", "count": 1, "level": 90, "form_count": 1, "tags": ["アーマー"], "hp": 25000, "attack": 2800, "base_hp": 25000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 1500, "attack_range": 110, "attack_speed": 50, "attack_wait": 95, "attack_interval": 301, "move_speed": 250.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2111264, "special_effect_id": 232, "missile_id": 89, "master_id": 30523, "global_id": 4142, "ranged": true, "spawn_sec": 9}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 7000, "attack": 800, "base_hp": 7000, "base_attack": 800, "damage_type": "magical", "armor_defense": 1000, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111120, "master_id": 30468, "global_id": 4087, "spawn_sec": 224}], "popups": ["フールフールの配下は\nダメージを受けると\n攻撃したユニットへ反撃を行います。", "ベルゼビュートの配下の\n一定範囲内のユニットは攻撃力低下と\n継続ダメージを受けます。", "アモンの配下は\n一定範囲内のユニットに\n継続してダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "プシュケ", "text": "くっ……こんなところに連れてきて、\n私をどうするおつもりですか？", "face": "u558"}, {"name": "教団員", "text": "ふふ、知れたことだ。\n貴様の肉体を依り代に魔神を降臨させるのさ。", "face": "l76159e395e56"}, {"name": "教団員", "text": "魔神サブノック様自身に選ばれたほどの器である\n貴様の肉体を依り代にすれば、\n魔神復活の儀式の成功率は間違いなく高まるはず。", "face": "l76159e395e56"}, {"name": "プシュケ", "text": "そんな……嫌ですっ！\nまた魔神に取り付かれるなんて……！", "face": "u558"}, {"name": "教団員", "text": "ははは。なにを言う？\n魔神をその身に宿すのだ。これほどの名誉はあるまい？", "face": "l76159e395e56"}, {"name": "プシュケ", "text": "い、嫌……イヤぁああぁあぁッ！！！", "face": "u558"}, {"name": "アンナ", "text": "――そこまでです！\nいますぐさらったプシュケさんを解放しなさい！", "face": "lae227901722d"}, {"name": "教団員", "text": "チッ、もう嗅ぎつけてきたか。\nだが、我らの目的に必要な\nこの女を返すわけにはいかん。", "face": "l76159e395e56"}, {"name": "教団員", "text": "魔神そのものを顕現させる時間はないが、\nかわりに魔神の眷属たちを召喚して相手してやる！", "face": "l76159e395e56"}, {"name": "アンナ", "text": "くっ……来ます！\n王子、なんとしても敵を撃退し、\n彼らからプシュケさんを奪還しましょう！", "face": "lae227901722d"}]}, {"trigger": "end", "lines": [{"name": "教団員", "text": "ぐっ……このままでは全滅だ。\n依り代を失うのは痛手だが、撤退するしかあるまい。", "face": "l76159e395e56"}, {"name": "ソーマ", "text": "プシュケさん、大丈夫ですか？", "face": "u23"}, {"name": "プシュケ", "text": "え、ええ。大丈夫です……。\nすみません、またご迷惑をおかけしてしまって。", "face": "u558"}, {"name": "モーティマ", "text": "しっかし、なんでまた教団のヤツらに\n簡単にさらわれたりしたんだよ？\n姉ちゃん、戦える力があるんだろ？", "face": "u14"}, {"name": "プシュケ", "text": "はい……お恥ずかしい限りなのですが、\nお散歩をしていたら、つい眠くなってしまいまして。\nその時を彼らに狙われたみたいです……。", "face": "u558"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "プシュケ", "text": "……え？\n一緒に王国で暮らさないか、ですか？", "face": "u558"}, {"name": "プシュケ", "text": "え、ええと……お気持ちはとても嬉しいのですが、\n王子さまのようなやんごとなき御方のプロポーズを\n私の一存でお受けするわけには……。", "face": "u558"}, {"name": "ケイティ", "text": "……プシュケさん。王子は貴方がまた\n邪神を崇める教団に捕まってしまわないように\n王国に身を寄せてはどうかと提案しているのです。", "face": "u114"}, {"name": "ケイティ", "text": "失礼ですが、貴方にはその……少々うかつな\nところがおありのようにお見受けしますので。", "face": "u114"}, {"name": "プシュケ", "text": "まあ、プロポーズではなかったのですか？\nそれは残念……ですが、確かにいまのままでは\nまた教団の人たちに捕まってしまうかもしれませんね。", "face": "u558"}, {"name": "プシュケ", "text": "……わかりました。\nでは、今後はお世話になる代わりに、私の力を\n王子さまたちの戦いにぜひ役立たせてください。", "face": "u558"}, {"name": "アンナ", "text": "はい、是非ともお力をお貸しください。"}, {"name": "プシュケ", "text": "ありがとうございます……。\nこの身に宿るのは闇の力……ですが王子さまたちと\n一緒なら、この力で希望の光を灯せると信じていますわ。", "face": "u558"}]}], "active": true}