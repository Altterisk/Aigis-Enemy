k": 600, "base_hp": 6500, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 30, "attack_wait": 20, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130960, "race_id": 2, "master_id": 34093, "global_id": 7710}]}, {"enemy_id": 8, "source": "local", "count": 8, "form_index": 0, "form_count": 1, "hp": 4000, "attack": 700, "base_hp": 4000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098528, "race_id": 2, "master_id": 30576, "global_id": 4195, "spawn_sec": 78}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 6500, "attack": 400, "base_hp": 6500, "base_attack": 400, "damage_type": "magical", "armor_defense": 500, "magic_defense": 5, "attack_range": 270, "attack_speed": 1, "attack_wait": 30, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130944, "race_id": 2, "change_to": 6, "change_condition": 1, "missile_id": 608, "missile": {"speed": 6.0, "splash": 133}, "master_id": 34092, "global_id": 7709, "ranged": true, "variants": [{"hp": 6500, "attack": 600, "base_hp": 6500, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 5, "attack_speed": 30, "attack_wait": 20, "attack_interval": 115, "move_speed": 1400.0, "gain_cost": 2, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2130960, "race_id": 2, "master_id": 34093, "global_id": 7710}], "spawn_sec": 121}], "dialogue": [{"trigger": "start", "lines": [{"name": "クロコ", "text": "――黒き竜人の長ヨ、見事ナ散り様でアッタ。\n竜人勢力モ、順調に進行経路タル大穴ヲ増やしてイルか。", "face": "l9164578f1e0d"}, {"name": "クロコ", "text": "冥界の亜神、ハイドース……。\nアノ者が信用に足るトハ思えナイガ、\nさりとて、大長老ノ願いは真っ当に叶えたカ……。", "face": "l9164578f1e0d"}]}, {"trigger": "end", "lines": [{"name": "クロコ", "text": "――見事。\n鬼にしておくニハ、勿体ない実力ダ。", "face": "l9164578f1e0d"}, {"name": "サザンカ", "text": "うっさい黙れッ！\n鬼は最強なんだ！　思い知れクロコー！！", "face": "u1347a1"}, {"name": "マレブランケ", "text": "サザンカ！　下がれ！\nあぁもう、怪我してるんだから突っ込むな！", "face": "u1225a1"}, {"name": "ハルモニア", "text": "……クロコさま、\nもう、共に戦うことはできないのですか？", "face": "u941"}, {"name": "クロコ", "text": "……ソノ忠義には、礼を言おウ。\nダガ、お前の主ハ、モハヤ私ではないだろウ。", "face": "l9164578f1e0d"}, {"name": "クロコ", "text": "仕えるべき相手ヲ見誤るナ。\n王子ヨ、ハルモニアたちを任せタぞ。", "face": "l9164578f1e0d"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "クロコ", "text": "……ハルモニアよ、最後のはなむけだ。\n次の激突デハ、我が目的の一端ヲ見せテやろう。", "face": "l9164578f1e0d"}, {"name": "ルーテ", "text": "……冥界軍、退いていきます。\nおそらく、次の侵攻が最大のものになるかと……。", "face": "u529"}, {"name": "サザンカ", "text": "卑怯だぞ！　戻ってこいクロコー！！", "face": "u1347a1"}, {"name": "アウローラ", "text": "怪我人は安静にしてください。\n無理やり安静にしますよ？", "face": "u711"}, {"name": "サザンカ", "text": "ひっ……ご、ごめんなひゃい……。\nでも……絶対あいつ許さないから……！", "face": "u1347a1"}, {"name": "白の皇帝", "text": "……まさか、魔王軍幹部と相対するとはな。\n王子、お前も休んでおけ。\n次の戦いでは、あちらも全力で来るはずだ。", "face": "u418"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "ハリナ", "text": "強がらず休め馬鹿者。\nお前が立っていたら兵が休息をとれぬだろう。", "face": "u988"}, {"name": "ハリナ", "text": "――さて、どう出る冥界軍。\nこちらの備えは万全だぞ？", "face": "u988"}]}, {"trigger": "route", "enemy_ids": [2], "lines": [{"name": "クロコ", "text": "なれば、我ガ望みヲ叶える時マデ、\nその威、存分ニ利用させテもらうとしヨウ！", "face": "l9164578f1e0d"}, {"name": "ハルモニア", "text": "なっ……クロコさまっ！？\nどうしてここに……！？", "face": "u941"}, {"name": "クロコ", "text": "久しいナ、ハルモニア。\n王国に身ヲ寄せたと聞いテいたガ、達者でなによりダ。", "face": "l9164578f1e0d"}, {"name": "ハルモニア", "text": "えぇ、エスネアも元気で……。\nそ、それよりクロコさまがご無事で、本当に良かったです！\nこの地へは……もしや、私たちの援軍に……？", "face": "u941"}, {"name": "クロコ", "text": "――否、ダ。\nハルモニアよ、こちらへ付くナラバ好きにシロ。\nそうでないならば、この地の民ごと雷にて死ぬがヨイ。", "face": "l9164578f1e0d"}, {"name": "ハルモニア", "text": "はっ……えっ……？", "face": "u941"}, {"name": "サザンカ", "text": "――下がって！\nなにぼーっとしてるの！？", "face": "u1347a1"}, {"name": "ハルモニア", "text": "しかし……クロコさま！\nなぜ……何を目的に戦っているのですか！？", "face": "u941"}, {"name": "クロコ", "text": "目的……カ……。\nそれヲ知ってどうスル。\nコレヨリ、この地の生命は息絶えルというノニ。", "face": "l9164578f1e0d"}, {"name": "サザンカ", "text": "ハルモニア、しっかりして。\n――あぁ、もう！\nほら、全然会話する気ないの分かるでしょ！", "face": "u1347a1"}, {"name": "サザンカ", "text": "それよりあんた！　クロコだっけ？\nさっき、この街を滅ぼすって言ったよね！？", "face": "u1347a1"}, {"name": "クロコ", "text": "然り。\n冥界の亜神トノ契約ハ、冥界軍の戦力とナルことのみ。\nソノ手段については、何も縛られていないユエな。", "face": "l9164578f1e0d"}, {"name": "サザンカ", "text": "殺すなって言われてないから、殺すってこと……？\nふっざけるなッ！\n殺せるから殺すって、ばっかじゃないの！？", "face": "u1347a1"}, {"name": "クロコ", "text": "我が願いニハ、数多の生贄が必要ナノダ。\n真なる雷を、コノ身に宿すにはナ……。", "face": "l9164578f1e0d"}, {"name": "サザンカ", "text": "ああ、もう……。\nあったま来た……鬼を……怒らせたな……。", "face": "u1347a1"}, {"name": "マレブランケ", "text": "――戦う理由、\nどうやら見つかったようだね、我が友よ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "うん、国のためでも、種族のためでもない。\nあたしの金棒は、目の前で命を奪わせないためのものだ！", "face": "u1347a1"}, {"name": "マレブランケ", "text": "よろしい。――でも、視野を狭くしないようにね。\nクロコはサンダードレイクを率いている。\n空からの雷撃を甘く見ちゃいけないよ。", "face": "u1225a1"}, {"name": "サザンカ", "text": "何か言ったっ！？\n今っ、あたしっ、ちょっと止まれなくて！！", "face": "u1347a1"}, {"name": "マレブランケ", "text": "……やれやれ。\n王子、サザンカを見ておいてやってくれ。\nどうやら最前線に出るつもりらしいからね。", "face": "u1225a1"}]}], "active": true}