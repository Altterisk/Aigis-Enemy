st": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 17}, {"enemy_id": 5, "source": "local", "count": 13, "form_count": 1, "tags": ["アンデッド"], "hp": 2800, "attack": 750, "base_hp": 2800, "base_attack": 750, "damage_type": "physical", "armor_defense": 280, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102064, "master_id": 354, "global_id": 353, "spawn_sec": 61}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 900, "base_hp": 8000, "base_attack": 900, "damage_type": "physical", "armor_defense": 400, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102160, "master_id": 364, "global_id": 363, "spawn_sec": 111}], "popups": [" 　　　悪天候：闇夜\n\n・敵の『移動速度』上昇"], "dialogue": [{"trigger": "start", "lines": [{"name": "ソシエ", "text": "――こんな荒野に、ヴァンパイアの王国が……？", "face": "u1584a1"}, {"name": "シルヴィア", "text": "これは表層に過ぎませんわ。\nヴァンパイアの王国、その都のほとんどは、\n日光を避けて地下に築かれていますのよ。", "face": "u442"}, {"name": "ヒューナ", "text": "ただ、強行軍でここまで来たから、\n日が沈んでしまったのが不安要素ね……。", "face": "u627"}, {"name": "ヴィンセント", "text": "特に今夜は雲の多い『闇夜』。\nアンデッドや、その影響を受けた者が、\nより活発になっているはずだ。", "face": "u103"}, {"name": "ジュリア", "text": "――へぇ、それって、私みたいな存在のこと？", "face": "u1583a1"}, {"name": "ソシエ", "text": "ジュリア！　無事……うぅん、\nこのむせ返るような血の匂い……まさか……。", "face": "u1584a1"}, {"name": "シルヴィア", "text": "いえ、大丈夫。\n彼女は血を与えられただけで、\nまだヴァンパイアにはなっていませんわ。", "face": "u442"}, {"name": "シルヴィア", "text": "血を吸うだけならばただの獲物。\n血を与えるだけならばただの従僕。\n血を吸い、与え、初めてヴァンパイアとなるのです。", "face": "u442"}, {"name": "ソシエ", "text": "なら、いまだったらまだ間に合うってことだね。\nジュリア、絶対に助けるから。", "face": "u1584a1"}, {"name": "ウル", "text": "王子、アンデッドの群れも近づいて来てる！\n急いで戦闘準備を！", "face": "u1586a1"}]}, {"trigger": "end", "lines": [{"name": "ジュリア", "text": "……王子……？\n王子……ふふっ、王子……。", "face": "u1583a1"}, {"name": "ジュリア", "text": "貴方も……ヴァーニィ様の下僕にならない……？\n私ね、とても素敵な気分なの……ふふっ、あははっ。", "face": "u1583a1"}, {"name": "セブン", "text": "ジュリア！　待て！\n……ちっ、逃げ足が速すぎるぞ！", "face": "u1333a1"}, {"name": "ヴィンセント", "text": "夜はアンデッドの支配する時間だ。\nそう簡単にはいかないだろう。", "face": "u103"}, {"name": "エマ", "text": "血に酔っているだけの今なら、\nまだ彼女を救うことができます。", "face": "u582"}, {"name": "エマ", "text": "王子、急いでジュリアを追いましょう。\nヴァンパイアの王国の入り口も、\n彼女が向かった先にあるはずですから。", "face": "u582"}]}], "active": true}