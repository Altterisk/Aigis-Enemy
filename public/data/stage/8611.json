6936, "spawn_sec": 6}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["機械", "ステルス"], "hp": 90000, "attack": 1200, "base_hp": 90000, "base_attack": 1200, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 58, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2126688, "race_id": 16, "special_effect_id": 664, "master_id": 33319, "global_id": 6936, "from_condition": 2}, {"enemy_id": 8, "source": "local", "count": 12, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 8}, {"enemy_id": 9, "source": "local", "count": 12, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 28}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109072, "race_id": 16, "special_effect_id": 61, "change_to": 10, "master_id": 30127, "global_id": 3746, "to_global_id": 3747, "route_behaviour": {"transforms": [{"wait": 2500}]}, "spawn_sec": 157}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 300, "attack_speed": 90, "attack_wait": 120, "attack_interval": 331, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109088, "race_id": 16, "special_effect_id": 61, "change_to": 9, "missile_id": 26, "master_id": 30128, "global_id": 3747, "ranged": true}, {"enemy_id": 12, "source": "local", "count": 5, "form_count": 1, "tags": ["変異"], "hp": 28000, "attack": 800, "base_hp": 28000, "base_attack": 800, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 236, "move_speed": 1500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2129360, "race_id": 7, "special_effect_id": 68, "master_id": 34230, "global_id": 7847, "spawn_sec": 168}, {"enemy_id": 13, "source": "local", "count": 16, "form_count": 1, "tags": ["変異"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 236, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 0.8999999761581421, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2129360, "race_id": 7, "special_effect_id": 66, "master_id": 33821, "global_id": 7438, "spawn_sec": 170}, {"enemy_id": 14, "source": "local", "count": 23, "form_count": 1, "hp": 9000, "attack": 320, "base_hp": 9000, "base_attack": 320, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115152, "race_id": 16, "special_effect_id": 54, "master_id": 31143, "global_id": 4762, "spawn_sec": 213}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["機械", "置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 32000, "attack": 1050, "base_hp": 32000, "base_attack": 1050, "damage_type": "true", "armor_defense": 600, "attack_speed": 1, "attack_wait": 20, "attack_interval": 90, "move_speed": 2000.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "pattern_id": 2126672, "race_id": 16, "special_effect_id": 663, "master_id": 35055, "global_id": 8672, "spawn_sec": 318}], "popups": ["デーモンシェフがいる間、\n一定時間が経過するたびに\n人間、デーモン、オーク属性の\n味方ユニットの\n攻撃、防御がアップします。", "オルカレクスは配置時に\n敵からのダメージを\n合計3000まで防ぐ\nバリアを展開します。", "マスターローグは一定確率で\n物理攻撃を回避します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "セブン", "text": "――フォーを追ってアジトまで来てみれば、\nアンタもいたのかよ、シックス。", "face": "u449"}, {"name": "シックス", "text": "えぇ、互助は闇ギルドからの伝統ですからね。\nこうしてフォーの計画の手伝いをしてやっているんですよ。", "face": "lfb49452332be"}, {"name": "イコル", "text": "計画と呼べるほど緻密なものでもないだろうに。\nこんなのは、ただの杜撰な悪戯だ。", "face": "u2485a1"}, {"name": "シックス", "text": "裏切りと謀略の亜神にそう言われたら、\n何も言い返せませんね。", "face": "lfb49452332be"}, {"name": "シックス", "text": "はぁ……もう少し潰し合ってくれると思ったのですが。\nやはり、そう簡単には物事は進みませんね。", "face": "lfb49452332be"}, {"name": "ペルセナス", "text": "そりゃそうだよ。\n人もシャチもデーモンも、そんなに愚かじゃないんだから。", "face": "u2482a1"}, {"name": "フォー", "text": "だから鬱陶しいんだよ。\nない頭を必死に絞って、無駄に抵抗しやがる。\n俺はお前らの大爆死が見たいっていうのになァ！", "face": "l1ab687946a57"}, {"name": "フォー", "text": "だがまぁ、いいぜ？\nここでみんなまとめてぶっ潰してやれば、\nなんにも問題はないんだからなァ！！", "face": "l1ab687946a57"}, {"name": "イヴリール", "text": "随分安く見られたものだな。\nお前たちごときに潰されるとでも？", "face": "u2488a1"}, {"name": "フォー", "text": "ギャハハハハ！　偉ぶりやがって！\nそういうのって鼻につくんだよなァ！", "face": "l1ab687946a57"}, {"name": "シックス", "text": "さて、こちらも雪辱を果たすとしましょうか。\nいい加減、負けっぱなしは嫌ですからね。", "face": "lfb49452332be"}, {"name": "フォー", "text": "楽しみだねぇ、テメェらが地面に這いつくばるのがよォ！\nできるだけ愉快にみっともなく苦しんでくれよなァ！！", "face": "l1ab687946a57"}]}, {"trigger": "battle", "at_sec": 39, "lines": [{"name": "デーモンシェフ", "text": "――どうやら間に合ったようだ。", "face": "lacf600866f64"}, {"name": "オルカレクス", "text": "王国の強さは知っているからな。\n我々が来る前に終わっていたらどうしようかと思ったぞ。", "face": "ld7ef6a899527"}, {"name": "シックス", "text": "デーモンシェフにオルカレクス……。\nやはり来ましたか。", "face": "lfb49452332be"}, {"name": "クロノシア", "text": "どうしてここに……。\nもしかして、助けに来てくれたのですか？", "face": "u2484a1"}, {"name": "オルカレクス", "text": "キュキュ、勘違いするな。\n王国は我々の世界征服を阻むライバルだ。", "face": "ld7ef6a899527"}, {"name": "オルカレクス", "text": "そんな王国に助けられたままというのは、\nシャチとしての沽券にかかわるからな。", "face": "ld7ef6a899527"}, {"name": "デーモンシェフ", "text": "要するに借りを返しにきたというわけだ。\n王国にも、闇の組織にもな。", "face": "lacf600866f64"}, {"name": "フォー", "text": "ふざけんな！　お前たちは敵対し合ってたはずだろうが！？\nそれがなんで、仲良しごっこなんかしてるんだよォ！！", "face": "l1ab687946a57"}, {"name": "ペルセナス", "text": "だから言ったじゃない。\n人もシャチもデーモンも、そんなに愚かじゃないんだから！", "face": "u2482a1"}, {"name": "オルカレクス", "text": "そもそも何が闇の組織だ。\n悪の組織たるオルカ科学ラボの敵ではない！", "face": "ld7ef6a899527"}, {"name": "デーモンシェフ", "text": "さぁ、王国諸君。そしてオルカ科学ラボ諸君。\n共に、不埒なゲストをリゾートから追い払おうではないか。", "face": "lacf600866f64"}]}, {"trigger": "battle", "at_sec": 317, "lines": [{"name": "フォー", "text": "ああああああああああッ！？\nどいつもこいつもふざけやがってェエエエ！！", "face": "l1ab687946a57"}, {"name": "シックス", "text": "……潮時ですね。\nこれ以上の戦闘は不可能です。", "face": "lfb49452332be"}, {"name": "フォー", "text": "憎い、憎いなァァ！！\nこのまま終われるわけがないだろうがよォッ！！", "face": "l1ab687946a57"}, {"name": "シックス", "text": "感情的になってる場合ではないでしょう……！\n手伝ってください絡繰り忍者！　退却しますよ！", "face": "lfb49452332be"}, {"name": "絡繰り忍者", "text": "本当に困った雇い主でござるな。\n手間をかけさせた分、報酬は上乗せしてもらいたい。", "face": "lc445ed380e0d"}, {"name": "フォー", "text": "報酬だと……！\nお前がなんの役に立ったって言うんだァ！？", "face": "l1ab687946a57"}, {"name": "フォー", "text": "結局お前も頼りにならないクズだった！\nそんな奴に支払うものなんざあるわけないだろうがァ！", "face": "l1ab687946a57"}, {"name": "絡繰り忍者", "text": "……ほう、報酬の支払いを拒否すると。", "face": "lc445ed380e0d"}, {"name": "絡繰り忍者", "text": "であれば――報いを与えねばならぬな。", "face": "lc445ed380e0d"}]}, {"trigger": "end", "lines": [{"name": "サクヤ", "text": "うぅ……！　いったい、なにが起きて……！？", "face": "u2489a1"}, {"name": "コウメ", "text": "み、見てください！　船が、爆発炎上してますよ！？", "face": "u2490a1"}, {"name": "シックス", "text": "クソッ、だからこんな仕事、嫌だったんだ――", "face": "lfb49452332be"}, {"name": "シックス", "text": "こんなところで、死んで……たまる……か……", "face": "lfb49452332be"}, {"name": "フォー", "text": "ギャハハハハ！！\n死ぬっ！　死がやってくる！　ついにこの日が！！", "face": "l1ab687946a57"}, {"name": "フォー", "text": "来ないんだなァ！！！！　ギャーハハハハハ！！", "face": "l1ab687946a57"}]}], "active": true}