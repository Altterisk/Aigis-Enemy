{"quest_id": 8611, "name": "杜撰な悪戯", "description": "闇の組織のアジトに辿り着いた王子一行。\nそこにはフォーや絡繰り忍者に加えて、\nシックスまで待ち構えていて……。\n神級（★１獲得の目安：平均Lv50）", "event": "真夏のカオスリゾート", "event_category": "History", "mission_id": 920235, "map_no": 9379, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 60000, "attack": 800, "base_hp": 60000, "base_attack": 800, "damage_type": "physical", "armor_defense": 600, "magic_defense": 20, "attack_range": 200, "attack_speed": 1, "attack_wait": 37, "attack_interval": 169, "move_speed": 750.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2126336, "race_id": 16, "special_effect_id": 525, "missile_id": 513, "missile": {"speed": 8.0, "splash": 87}, "master_id": 33016, "global_id": 6633, "ranged": true, "commands": {"raw": "DoEnemy_RegistCommand(\"OnDestroy\", \"SetStageFlag(0, 1);\");", "sets_flags": [[0, 1]], "on_destroy": true}, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 60, "form_count": 3, "tags": ["機械"], "hp": 9500, "attack": 400, "base_hp": 9500, "base_attack": 400, "damage_type": "physical", "armor_defense": 170, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 300, "move_speed": 750.0, "gain_cost": 1, "dot_rate": 1.100000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2126400, "special_effect_id": 658, "change_to": 2, "missile_id": 515, "missile": {"speed": 8.0, "splash": 67}, "master_id": 33022, "global_id": 6639, "ranged": true, "to_global_id": 6638, "route_behaviour": {"reroutes": ["Route=999"]}, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["機械"], "hp": 9500, "attack": 400, "base_hp": 9500, "base_attack": 400, "damage_type": "physical", "armor_defense": 170, "magic_defense": 10, "attack_range": 120, "attack_speed": 1, "attack_wait": 107, "attack_interval": 30