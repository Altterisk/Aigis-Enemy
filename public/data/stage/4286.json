{"quest_id": 4286, "name": "奥義開眼", "description": "空飛ぶ魔物に対抗する奥義を\n会得したサンドラと共に敵を倒せ！\n＜毒：HPに継続ダメージ＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["毒：HPに継続ダメージ"], "event": "空を断つ必殺剣", "event_category": "History", "mission_id": 920042, "map_no": 3899, "level": 100, "multiplier": 1.0, "charisma": 50, "exp": 220, "gold": 1300, "drops": [{"card": 85, "c": 1}, {"card": 135, "c": 1}, {"item": 2003, "c": 2}, {"card": 1654, "c": 1}, {"item": 5002, "c": 2}], "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 5, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 64, "form_index": 0, "form_count": 1, "hp": 300, "attack": 150, "base_hp": 300, "base_attack": 150, "damage_type": "magical", "armor_defense": 150, "magic_defense": 60, "attack_range": 180, "attack_speed": 26, "attack_wait": 30, "attack_interval": 93, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098320, "special_effect_id": 229, "missile_id": 40, "missile": {"speed": 7.0}, "master_id": 79, "global_id": 78, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 900, "base_hp": 2000, "base_attack": 900, "damage_type": "physical", "armor_defense": 800, "magic_defense": 80, "attack_range": 112, "attack_speed": 50, "attack_wait": 50, "attack_interval": 156, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100240, "race_id": 3, "missile_id": 79, "missile": {"speed": 10.0}, "master_id": 234, "global_id": 233, "ranged": true, "spawn_sec": 135}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここで空飛ぶ魔物の姿が\n確認されたとのことですが……。", "face": "l56bb55a8b0e9"}, {"name": "サンドラ", "text": "王子……！", "face": "u248"}, {"name": "アンナ", "text": "サンドラさん！　ここで特訓を\nされていたんですね。", "face": "l56bb55a8b0e9"}, {"name": "サンドラ", "text": "ええ。ついに奥義である\n真空十字斬を会得したの。", "face": "u248"}, {"name": "アンナ", "text": "ではこれで空飛ぶ魔物に対抗できますね！", "face": "l56bb55a8b0e9"}, {"name": "兵士", "text": "報告！　魔物の姿を確認！", "face": "l60303f9a5488"}, {"name": "アンナ", "text": "王子、サンドラさん！　\n急ぎ戦闘の準備を！", "face": "l56bb55a8b0e9"}]}, {"trigger": "battle", "at_sec": 138, "lines": [{"name": "アリサ", "text": "あのデーモンが持っている武器は\n何度も発射ができるように改良されている\nようです。ご注意ください。", "face": "u24"}, {"name": "ソーマ", "text": "敵の射程範囲内に入るまえに\n対処しないといけませんね。", "face": "u23"}, {"name": "デーモン", "text": "ゲヘッ、ゲヘッ。対処できればいいがな。\nさぁ、どいつから打ち抜いてやろうか……！！", "face": "l27b48b695b23"}]}, {"trigger": "end", "lines": [{"name": "サンドラ", "text": "……。", "face": "u248"}, {"name": "アンナ", "text": "サンドラさん、\nどうかされましたか？", "face": "l56bb55a8b0e9"}, {"name": "サンドラ", "text": "あの黒いデーモン……。\nあいつが出てきたということは敵の本隊が\n動き出したということね。", "face": "u248"}, {"name": "サンドラ", "text": "それにまだ会得しただけで奥義を\n極めてはいない……。\nもっと使いこなして感覚を掴まないと……。", "face": "u248"}, {"name": "サンドラ", "text": "王子、アンナさん。\n私にもう少しだけ時間をちょうだい。", "face": "u248"}, {"name": "アンナ", "text": "わかりました。ご武運を……。", "face": "l56bb55a8b0e9"}]}], "map": {"image": "Map920042_3899", "w": 960, "h": 640, "spots": [{"k": "b", "x": 51, "y": 290}, {"k": "m", "x": 721, "y": 323, "id": 200}, {"k": "m", "x": 605, "y": 267, "id": 201}, {"k": "m", "x": 491, "y": 274, "id": 202}, {"k": "m", "x": 368, "y": 287, "id": 203}, {"k": "m", "x": 256, "y": 280, "id": 204}, {"k": "m", "x": 141, "y": 280, "id": 205}, {"k": "m", "x": 199, "y": 251, "id": 206}, {"k": "r", "x": 128, "y": 345, "id": 300}, {"k": "r", "x": 219, "y": 348, "id": 301}, {"k": "r", "x": 338, "y": 351, "id": 302}, {"k": "r", "x": 451, "y": 341, "id": 303}, {"k": "r", "x": 562, "y": 326, "id": 304}, {"k": "r", "x": 541, "y": 204, "id": 305}, {"k": "r", "x": 429, "y": 219, "id": 306}, {"k": "r", "x": 318, "y": 217, "id": 307}, {"k": "r", "x": 109, "y": 218, "id": 308}]}, "start_cost": 20, "active": true}