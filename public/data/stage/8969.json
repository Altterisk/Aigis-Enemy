{"quest_id": 8969, "name": "バカンス前の合同演習", "description": "海辺で王国と帝国による合同演習が開催。\n夏季休暇前の最後の模擬戦でアブグルント、\nヴィラヘルムと協力して勝利を掴め！\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "真夏のぷるぷるビーチ", "event_category": "Emergency", "mission_id": 200570, "map_no": 7443, "level": 100, "multiplier": 1.0, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 35000, "attack": 700, "base_hp": 35000, "base_attack": 700, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 160, "attack_speed": 1, "attack_wait": 20, "attack_interval": 77, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2171184, "race_id": 16, "special_effect_id": 528, "missile_id": 186, "missile": {"speed": 12.0}, "master_id": 40780, "ranged": true, "spawn_sec": 51}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 32000, "attack": 780, "base_hp": 32000, "base_attack": 780, "damage_type": "physical", "armor_defense": 280, "magic_defense": 10, "attack_range": 160, "attack_speed": 1, "attack_wait": 20, "attack_interval": 77, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2137728, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 35034, "global_id": 8651, "ranged": true, "spawn_sec": 51}, {"enemy_id": 3, "source": "local", "count": 16, "form_count": 1, "hp": 2500, "attack": 500, "base_hp": 2500, "base_attack": 500, "damage_type": "physical", "armor_defense": 70, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097488, "race_id": 16, "master_id": 46, "global_id": 45, "spawn_sec": 91}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 2, "hp": 14000, "attack": 500, "base_hp": 14000, "base_attack": 500, "damage_t