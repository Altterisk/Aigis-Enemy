35014, "global_id": 8631}, {"enemy_id": 8, "source": "local", "count": 12, "form_count": 1, "tags": ["アーマー"], "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 64, "global_id": 63, "spawn_sec": 158}, {"enemy_id": 9, "source": "local", "count": 6, "form_count": 1, "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 100, "attack_range": 180, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 49, "global_id": 48, "ranged": true, "spawn_sec": 163}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 500, "base_hp": 6500, "base_attack": 500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 30, "attack_speed": 70, "attack_wait": 30, "attack_interval": 196, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115168, "race_id": 16, "master_id": 31108, "global_id": 4727, "spawn_sec": 175}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 2, "hp": 8800, "attack": 900, "base_hp": 8800, "base_attack": 900, "damage_type": "physical", "armor_defense": 40, "magic_defense": 20, "attack_speed": 1, "attack_wait": 90, "attack_interval": 254, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138032, "race_id": 16, "special_effect_id": 86, "change_to": 11, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 37664, "global_id": 11281, "to_global_id": 11282, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 180}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8800, "attack": 2500, "base_hp": 8800, "base_attack": 2500, "damage_type": "physical", "armor_defense": 40, "magic_defense": 20, "attack_range": 260, "attack_speed": 1, "attack_wait": 90, "attack_interval": 253, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2137680, "race_id": 16, "special_effect_id": 993, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 37665, "global_id": 11282, "ranged": true}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 2, "hp": 12500, "attack": 300, "base_hp": 12500, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 221, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2138080, "race_id": 16, "special_effect_id": 86, "change_to": 13, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 40807, "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_NoAttack\");"}, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 195}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12500, "attack": 300, "base_hp": 12500, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "attack_range": 200, "attack_speed": 70, "attack_wait": 40, "attack_interval": 151, "move_speed": 350.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2119120, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 40808, "ranged": true}], "popups": ["\n\n\n\n　夏休み、帝国近辺の海辺にて――", "ヴィディアがいる間は\n全ての敵ユニットの\n攻防がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "（オーバーレイ）", "text": "夏休み、帝国近辺の海辺にて――"}, {"name": "ホルミース", "text": "夏季休暇を利用した、\n王国と帝国による合同演習ですか。", "face": "u2834a1"}, {"name": "ホルミース", "text": "合同演習にはそこまでそそられませんが……。\n水着姿の美女がこうも揃うと、さすがに圧巻ですねぇ。", "face": "u2834a1"}, {"name": "ホルミース", "text": "そしてなにより――", "face": "u2834a1"}, {"name": "帝国騎士", "text": "う、うわぁああああっ！？\n雷と風が襲いかかって来るぞーッ！？", "face": "lec0ed5f9a42a"}, {"name": "一般兵", "text": "ぎゃあぁあああああっ！？\nわけわかんない高火力のビームが飛び交ってるーッ！？", "face": "u65"}, {"name": "帝国騎士", "text": "あっちでは初代陛下と初代騎士団長と、\n王国軍初代副司令官が斬り合ってるぞーッ！！", "face": "lec0ed5f9a42a"}, {"name": "一般兵", "text": "すげぇ！　多少怪我しても癒し手が治してくれるぜ！\nこれならいくらでも模擬戦できるぜッ！！", "face": "u65"}, {"name": "ホルミース", "text": "これだけド派手だと、なんてことない合同演習も、\nとても華やかなものに感じられますね。", "face": "u2834a1"}, {"name": "太上老君", "text": "ド派手っていうより阿鼻叫喚じゃないかな？", "face": "u2838a1"}, {"name": "ハリンヘイム", "text": "あの……止めなくていいんですか？\n演習の規模ではないと思うんですが……。", "face": "u2839a1"}, {"name": "アブグルント", "text": "止める必要はないでしょう？\nだってみんな楽しそうだもの。（無関心）", "face": "u2840a1"}, {"name": "ホルミース", "text": "詩に書くことが増えるので、\n私もこのままで大丈夫だと思います。", "face": "u2834a1"}, {"name": "ハリンヘイム", "text": "り、倫理観……！！", "face": "u2839a1"}, {"name": "レミィ", "text": "おーい！　そこの人たちー！\nそんなところでお喋りしてる場合じゃないわよー！", "face": "u2837a1"}, {"name": "クーコ", "text": "模擬戦は今だけで、これが終わったら、\nあとは全日程バカンスだものね♪", "face": "u2837a1"}, {"name": "ヴィディア", "text": "ここで戦わなければ損ということだな。\nせっかくの機会だから、飛び込んでみてはどうだろうか？", "face": "u2841a1"}, {"name": "ホルミース", "text": "……とのことですので、一丁参加してみましょうか。", "face": "u2834a1"}, {"name": "イムラウ", "text": "あ、あんまり無茶はしないでねー！\nうっかり大怪我したら大変だからー！", "face": "u2842a1"}, {"name": "アブグルント", "text": "そうね……楽しい模擬戦で誰かが命を落したりしたら、\n優しい王子が心を痛めてしまうもの。", "face": "u2840a1"}, {"name": "アブグルント", "text": "……ひらめいたわ！", "face": "u2840a1"}, {"name": "ハリンヘイム", "text": "や、やめてください！\n本当に……本当にそういうのはやめてくださいね！？", "face": "u2839a1"}, {"name": "ダグマール", "text": "どうやらアブグルントたちも参戦するようですね。", "face": "u2843a1"}, {"name": "ダグマール", "text": "それでは――", "face": "u2843a1"}, {"name": "ダグマール", "text": "――帝国と王国による超火力的合同演習、続行です！！", "face": "u2843a1"}]}, {"trigger": "end", "lines": [{"name": "ヴィラヘルム", "text": "――とても充実した模擬戦でしたね。", "face": "u2835a1"}, {"name": "ヘイズル", "text": "名立たる強者が集まっていたからね。\nつい熱くなってしまったよ。", "face": "u2836a1"}, {"name": "ヴィディア", "text": "しかし、その分いい模擬戦になった。\n結果的に今回の合同演習は大成功だったと言えるだろう。", "face": "u2841a1"}, {"name": "ハリンヘイム", "text": "……そうですね！\n死傷者も出ませんでしたからね！", "face": "u2839a1"}, {"name": "イムラウ", "text": "本当にね！　すっごくひやひやしたよぉ！", "face": "u2842a1"}, {"name": "太上老君", "text": "常識人たちの心からの叫びが聞こえるね。", "face": "u2838a1"}, {"name": "イムラウ", "text": "なんか今回はみんな無茶しちゃいそうだから、\n早く海に行きたいなぁ……。", "face": "u2842a1"}, {"name": "一般兵", "text": "うおぉぉおおおおっ！\n次は海で模擬戦だァー！！", "face": "u65"}, {"name": "帝国騎士", "text": "夏といえば模擬戦だよなァーッ！！", "face": "lec0ed5f9a42a"}, {"name": "イムラウ", "text": "今回はこういう人たちばっかりだから、\n早く海での遊びに切り替えたいなぁ……！", "face": "u2842a1"}, {"name": "アブグルント", "text": "いつの間にか帝国の兵士たちも、\n王国の文化に染まってしまったわね。", "face": "u2840a1"}, {"name": "ヘイズル", "text": "今の帝国は変革期だ。\n良くも悪くも変わっていくということかもしれないね。", "face": "u2836a1"}, {"name": "ダグマール", "text": "いいですね、変化……。\nこの調子で白の帝国が、\n超火力主義国家になったりしないでしょうか。", "face": "u2843a1"}, {"name": "アブグルント", "text": "あー、いいわね、最高だと思うわ。（無感情）", "face": "u2840a1"}, {"name": "ヴィラヘルム", "text": "帝国がこの先どのように変わっていくのか。\nとても興味深くはあるけれど……。", "face": "u2835a1"}, {"name": "ヴィラヘルム", "text": "……せっかく海に来たのです。\n難しい話はやめて、みんなたくさん遊びましょうか♪", "face": "u2835a1"}, {"name": "ヘイズル", "text": "久しぶりの海でテンションが上がってるね。\nまぁ、それは私たちも同じだけど。", "face": "u2836a1"}, {"name": "レミィ", "text": "みんな遊ぶ準備はばっちりみたいね！\nそれじゃあ早速、泳ぎにいきましょ！", "face": "u2837a1"}, {"name": "クーコ", "text": "いっぱいはしゃいで、ひと夏の思い出を作ろうね♪", "face": "u2837a1"}]}]}