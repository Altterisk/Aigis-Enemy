 33566, "global_id": 7183, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 13, "source": "local", "count": 45, "form_index": 0, "form_count": 2, "hp": 2000, "attack": 450, "base_hp": 2000, "base_attack": 450, "damage_type": "physical", "armor_defense": 100, "attack_speed": 30, "attack_wait": 10, "attack_interval": 87, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2138560, "race_id": 13, "change_to": 13, "change_condition": 2, "master_id": 35092, "global_id": 8709, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 95}, {"enemy_id": 13, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2, "spawned_on_death_by": [13, 15]}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 0, "form_count": 2, "hp": 23000, "attack": 700, "base_hp": 23000, "base_attack": 700, "damage_type": "magical", "armor_defense": 200, "attack_range": 180, "attack_speed": 30, "attack_wait": 10, "attack_interval": 71, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2138576, "race_id": 13, "special_effect_id": 216, "change_to": 13, "change_condition": 2, "missile_id": 595, "missile": {"speed": 8.0}, "master_id": 35093, "global_id": 8710, "ranged": true, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 155}], "popups": ["亜神ハイドースは、\n戦場にいる黒炎の総数に応じて\n攻撃力と防御力がアップします。\n\nまた亜神ハイドースが\n攻撃を行うと戦場にいる\n黒炎は全て消滅します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ハイドース", "text": "――我が悲願、その最初の一手。\n憎きアダマスの首が、今や目前にある。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "亜神の身をもってしても、\nこの日を随分と待ちわびたぞ、女神アダマスよ。", "face": "le4066daa294e"}, {"name": "アダマス", "text": "……その傲慢さ、何も変わりませんね。", "face": "lddf7a687accd"}, {"name": "ハイドース", "text": "ようやく姿を見せたか……。\nいや、待て……なんだ、その姿は。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "アダマス！　貴様、肉体はどうした！\n何なのだ、その今にもかき消えそうな魔力は！！", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "我が復讐を……悲願を愚弄するつもりか……ッ！！", "face": "le4066daa294e"}, {"name": "アダマス", "text": "あなたの怒りは理解できます。\n私がそれだけのことをした、その事実も分かっています。", "face": "lddf7a687accd"}, {"name": "アダマス", "text": "けれど、この地は創造神が物質界の民に与えたもの。\n神々の争いで、奪い合うようなものではありません。", "face": "lddf7a687accd"}, {"name": "アダマス", "text": "ましてや、神のために数多の生贄を――", "face": "lddf7a687accd"}, {"name": "ハイドース", "text": "黙れアダマスッ！！\n力を失ったあの日、長き眠りより覚めた絶望の日、\nその片時たりとも貴様への恨みを忘れたことはない！", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "ここで、己が信徒と共に冥界の黒炎に焼かれるがいい！\n精神体の一欠片まで消え去れ、女神アダマス――ッ！！", "face": "le4066daa294e"}]}, {"trigger": "start", "lines": [{"name": "白の皇帝", "text": "――遅い。", "face": "u1418"}]}, {"trigger": "start", "lines": [{"name": "ハイドース", "text": "――ッ！\n貴様は……。\nなぜ生きている、その神器は何だ？", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "臣下が、まだ死ぬなとうるさくてな……。", "face": "u1418"}, {"name": "ハイドース", "text": "……そうか、神器ごと砕いたかと思っていたが、\n神器が貴様の身代わりとなっていたのか。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "そしてその、新たな神器。\n女神アダマス、己が肉体を魔力と化し、\n神器に注ぎ込んだのか！", "face": "le4066daa294e"}, {"name": "アダマス", "text": "私はただ、魔力を与えただけ。\n白の皇帝が命を繋いだのも――", "face": "lddf7a687accd"}, {"name": "アウローラ", "text": "…………ふぅ。", "face": "u711"}, {"name": "トゥーダ", "text": "…………間に合ったようですね。", "face": "u1554a1"}, {"name": "アダマス", "text": "神器を、人の手で新たに打ち直したのも――", "face": "lddf7a687accd"}, {"name": "グラティア", "text": "…………へっ。", "face": "u1551a1"}, {"name": "アダマス", "text": "ここで、あなたに立ちはだかる全ての力は、\n人が亜神に抗わんとする、\nその意志の果てに掴みとったものなのです。", "face": "lddf7a687accd"}, {"name": "ハイドース", "text": "よかろう……。\n失う悲しみならば、我もよく理解できる。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "その覚悟、その怒り、その悲しみ……。\n亜神として、受け止めてやろうではないか。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "詭弁は聞き飽きた。\n貴様の本心を引きずり出すには、\nどうやら、敗北を味わわせなければならんらしい。", "face": "u1418"}, {"name": "ハイドース", "text": "ほう……それが、お前の本当の顔か。\n皇帝ではない、戦士としての顔をしている。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "人の力とやら、見せてみよ。\n我が黒炎に抗ってみせるがいい！", "face": "le4066daa294e"}]}, {"trigger": "end", "lines": [{"name": "ハイドース", "text": "――亜神にその刃を届かせるか。\n見事だ、白の皇帝よ。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "……だが、浅かったようだな。\n次は、俺がお前を滅ぼす。覚えておけ。", "face": "u1418"}, {"name": "ハイドース", "text": "実に良い戦士だ。\n我が配下に出来ぬことを悔しく思う。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "此度の戦場、貴様の勝ちだ。\n死の淵より帰還するとは、\nそれほどまでに、この世界が大切か。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "……声が、聞こえただけだ。\n帰ってこいと、俺を呼ぶ声がな。", "face": "u1418"}, {"name": "ハイドース", "text": "……そう、か。\n声が聞こえたか……。", "face": "le4066daa294e"}, {"name": "ハイドース", "text": "…………。\nそれは確かに、命を繋ぐに値する理由だ。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "どうした、貴様にも覚えがあるような口ぶりだが。", "face": "u1418"}, {"name": "ハイドース", "text": "知りたくば、次こそ我が命を刈り取るがいい。\nさらばだ、白の皇帝。\n次に見えるその日を、楽しみにしているぞ。", "face": "le4066daa294e"}, {"name": "白の皇帝", "text": "…………貴様こそ、覚悟しておけ。\n人が神を殺しうることは、\nもはや、この物質界で証明されているのだからな。", "face": "u1418"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "ロミルダ", "text": "――ハイドースが黒炎をまとって……。\nいいえ、これは……！", "face": "u1555a1"}, {"name": "ロミルダ", "text": "陛下、ハイドースは戦場の黒炎を吸収してるんだ！\nめちゃくちゃな魔力をかき集めてるよ！", "face": "u1555a1"}, {"name": "レオナ", "text": "吸収される前に黒炎を散らせばいい話だ。\n亜神に後れを取るな！\n白の帝国、その実力を見せてやれ！", "face": "u311"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 24, "params": [12], "expression": "IsClassType(9, 94, 95, 96, 97, 99, 209, 1001, 1220, 1251, 1273, 1306, 1307, 1308, 1315, 1318, 1320, 1323) == 0;"}, {"kind": "term", "influence": 11, "params": [300]}], "enemies": [{"enemy_id": 1, "form_index": 0, "hp": 350000, "attack": 600, "damage_type": "true", "armor_defense": 5