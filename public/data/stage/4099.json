erval": 49, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098576, "race_id": 2, "master_id": 147, "global_id": 146, "spawn_sec": 81}], "dialogue": [{"trigger": "start", "lines": [{"name": "クローディア", "text": "この感じ、近くに竜の気配を感じます。\nそれにどうやらこちらに向かって\nきているようです。", "face": "u163"}, {"name": "アンナ", "text": "それはこちらとしては都合が良いですが、\n何をしにくるのでしょうか。"}, {"name": "クローディア", "text": "魔物の復活以後、船で往来する人も\n減っているでしょうから、たぶんお腹が\n空いているんじゃないかと。", "face": "u163"}, {"name": "アンナ", "text": "えーっと……。\nそれって、私たちを食べにくるってことですか。"}, {"name": "クローディア", "text": "気をつけてください。\nドラゴンの硬い鱗は生半可な刃を通しません。", "face": "u163"}, {"name": "クローディア", "text": "それに加えて魔法に対しても\n高い耐性を備えています。", "face": "u163"}, {"name": "アンナ", "text": "そんな……。", "face": "lad7adb13d892"}, {"name": "クローディア", "text": "この竜殺しの剣さえ使えれば\nいいのですが……。", "face": "u163"}]}, {"trigger": "battle", "at_sec": 48, "lines": [{"name": "クローディア", "text": "あれは水竜！\n水竜の泡のブレスに気をつけてください！", "face": "u163"}, {"name": "クローディア", "text": "一発の威力は低いですが\nまとまって飛んでくるのでとても危険です。", "face": "u163"}, {"name": "クローディア", "text": "ただ、水竜の鱗は他の竜よりも脆いはず。\n物理攻撃が比較的有効です。", "face": "u163"}]}], "map": {"image": "Map920022_3855", "w": 960, "h": 640, "spots": [{"k": "b", "x": 82, "y": 245}, {"k": "m", "x": 695, "y": 288, "id": 200}, {"k": "m", "x": 621, "y": 208, "id": 201}, {"k": "m", "x": 542, "y": 133, "id": 202}, {"k": "m", "x": 422, "y": 138, "id": 203}, {"k": "m", "x": 293, "y": 172, "id": 204}, {"k": "m", "x": 200, "y": 215, "id": 205}, {"k": "m", "x": 237, "y": 323, "id": 206}, {"k": "m", "x": 344, "y": 381, "id": 207}, {"k": "m", "x": 467, "y": 430, "id": 208}, {"k": "m", "x": 621, "y": 459, "id": 209}, {"k": "m", "x": 739, "y": 473, "id": 210}, {"k": "m", "x": 836, "y": 445, "id": 211}, {"k": "m", "x": 836, "y": 342, "id": 212}, {"k": "r", "x": 689, "y": 206, "id": 300}, {"k": "r", "x": 519, "y": 85, "id": 301}, {"k": "r", "x": 216, "y": 144, "id": 302}, {"k": "r", "x": 246, "y": 264, "id": 303}, {"k": "r", "