": 2, "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128624, "race_id": 21, "change_to": 11, "change_condition": 4, "master_id": 33702, "global_id": 7319, "to_condition": 4, "to_ticks": 3, "to_global_id": 7322, "spawn_sec": 162}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 700, "base_hp": 20000, "base_attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128640, "race_id": 21, "special_effect_id": 127, "master_id": 33705, "global_id": 7322, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 120000, "attack": 5000, "base_hp": 120000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 800, "attack_speed": 120, "attack_wait": 10, "attack_interval": 221, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.899999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2127520, "race_id": 10, "master_id": 36422, "global_id": 10039, "spawn_sec": 187}, {"enemy_id": 16, "source": "local", "count": 6, "form_count": 2, "hp": 12000, "attack": 1250, "base_hp": 12000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "attack_speed": 1, "attack_wait": 40, "attack_interval": 126, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159648, "race_id": 20, "change_to": 16, "change_condition": 4, "master_id": 38613, "global_id": 12230, "to_condition": 4, "to_ticks": 3, "to_global_id": 12233, "spawn_sec": 196}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "true", "armor_defense": 350, "magic_defense": 20, "attack_speed": 1, "attack_wait": 60, "attack_interval": 200, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2159664, "race_id": 20, "special_effect_id": 1540, "master_id": 38616, "global_id": 12233, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 20, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 18000, "attack": 900, "base_hp": 18000, "base_attack": 900, "damage_type": "physical", "armor_defense": 660, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2146176, "master_id": 36399, "global_id": 10016, "spawn_sec": 197}], "popups": ["冥界のゴーストは、\n倒されると黒炎に変化します。", "発光するマスに配置した\nユニットは射程が\n上昇します。", "各種冥界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "？？？", "text": "――全機関出力最大！\nどんどんぶん回せーッ！！", "face": "u2403a1"}, {"name": "グラティア", "text": "お、おい！\nそんな加速したら機体がもたねぇぞ！？", "face": "u1551a1"}, {"name": "クリスタ", "text": "計器振り切れてますわよ！\nいったいどれだけの速度が出てますの！？", "face": "u709"}, {"name": "？？？", "text": "帝国の危機なんだぞ！\n最新鋭機、今飛ばさなくていつ飛ばすんだ！", "face": "u2403a1"}, {"name": "？？？", "text": "この機体だって！\n王国のドーンブリンガーには負けたくないって\n最速を求める熱い魂が叫んでいるだろう！？", "face": "u2403a1"}, {"name": "ヘンドリカ", "text": "さすがは選抜飛行士！\nヴァルデくぅん！　この機体の真価を見せちゃいなー！", "face": "u1106a1"}, {"name": "グラティア", "text": "ヘンドリカぁ！！\n焚き付けてんじゃねぇぇッ！！", "face": "u1551a1"}, {"name": "ヴァルデ", "text": "うおぉぉぉッ！\n魔導エンジン全開！　オーバーレブなんて怖くない！", "face": "u2403a1"}, {"name": "クリスタ", "text": "エンジン壊れたら墜落しますのよー！？", "face": "u709"}, {"name": "レーゼル", "text": "――見えた。\n目視にて冥界の侵食地点を確認！", "face": "u371"}, {"name": "ヴァルデ", "text": "さすが猟兵目がいい！\nきみも飛空士にならないか！？", "face": "u2403a1"}, {"name": "レーゼル", "text": "遠慮する。\n信号弾を上げるぞ。\n帝国軍本隊に位置を知らせる！", "face": "u371"}, {"name": "ヴァルデ", "text": "さぁ来い、白の皇帝！\n帝国最速の翼が、敵の位置を捉えたぞ！！", "face": "u2403a1"}]}, {"trigger": "end", "lines": [{"name": "エルデ", "text": "――敵の勢いが止まらないでありますよ！？", "face": "u1346a1"}, {"name": "ティルト", "text": "ペルセフォネ戦以降、\n冥界に、これだけの戦力は存在しなかった……。\nいったいどこに隠していたんだ！", "face": "u1705a1"}, {"name": "白の皇帝", "text": "…………。", "face": "u418"}, {"name": "白の皇帝", "text": "レオナ、レオラ、打開策を立てろ。\n他国の軍師連中に借りを作っても構わん。\n有力な情報は片っ端から検討しろ。", "face": "u418"}, {"name": "レオナ", "text": "はっ。", "face": "u311"}, {"name": "レオラ", "text": "了解したわ♪", "face": "u464"}, {"name": "白の皇帝", "text": "イルマ、ルーテ、魔力通信網で王国に協力要請を。\n各地の冥界侵食の状況把握も任せる。\n連絡要員は好きなだけ使え。", "face": "u418"}, {"name": "イルマ", "text": "了解しました！", "face": "u1345a1"}, {"name": "ルーテ", "text": "了解。クラーラさん、一緒に来てください。\n伝令役が必要です。", "face": "u529"}, {"name": "クラーラ", "text": "は、はいぃ……！", "face": "u420"}, {"name": "白の皇帝", "text": "ディアナ、全軍の指揮を任せる。\n被害を最小限に抑えつつ、遅滞戦闘に努めろ。\n砲兵の弾薬も無制限で構わん。", "face": "u418"}, {"name": "ディアナ", "text": "……どれだけ保たせますか。", "face": "u624"}, {"name": "白の皇帝", "text": "どれだけでも、だ。\nハイドースが何を仕掛けてきたのか、\nそれが分からない以上、他に選択肢はない。", "face": "u418"}, {"name": "ディアナ", "text": "ふぅ、無理難題を。\n――騎士を中心に陽動部隊を編成する！\n誇りある者は剣を取れ！", "face": "u624"}, {"name": "白の皇帝", "text": "ようやく掴めたハイドースの手がかりだ。\nこのまま奴を追い詰める。", "face": "u418"}, {"name": "白の皇帝", "text": "これを窮地だと考えるな！\n人の力とは、諦めないその意志にある！", "face": "u418"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 12, "params": [200]}], "enemies": [{"enemy_id": 1, "hp": 3500, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2142464}, {"enemy_id": 1, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 2, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 3, "hp": 4500, "attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2159616}, {"enemy_id": 3, "form_index": 1, "hp": 4500, "attack": 700, "damage_type": "true", "armor_defense": 250, "magic_defense": 20, "pattern_id": 2159632}, {"enemy_id": 7, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 7, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 11, "hp": 20000, "attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128624}, {"enemy_id": 11, "form_index": 1, "hp": 20000, "attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128640}, {"enemy_id": 15, "hp": 120000, "attack": 5000, "damage_type": "physical", "armor_defense": 800, "pattern_id": 2127520}, {"enemy_id": 16, "hp": 12000, "attack": 1250, "damage_type": "physical", "armor_defense": 350, "magic_defense": 20, "pattern_id": 2159648}, {"enemy_id": 16, "form_index": 1, "hp": 12000, "attack": 1000, "damage_type": "true", "armor_defense": 350, "magic_defense": 20, "pattern_id": 2159664}, {"enemy_id": 20, "hp": 18000, "attack": 900, "damage_type": "physical", "armor_defense": 660, "pattern_id": 2146176}]}, "active": true}