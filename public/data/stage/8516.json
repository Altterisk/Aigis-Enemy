{"quest_id": 8516, "name": "第九陣 冥界からの侵食", "description": "突如として冥界が物質界への侵食を開始。\n襲い来る敵をヴァルデと協力して撃退せよ！\n＜広域戦闘：敵味方の射程減少＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["広域戦闘：敵味方の射程減少"], "event": "帝国九陣", "event_category": "Empire", "mission_id": 940009, "map_no": 9319, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 16, "form_count": 2, "tags": ["アンデッド"], "hp": 3500, "base_hp": 3500, "damage_type": "physical", "armor_defense": 100, "attack_speed": 1, "attack_interval": 50, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2142464, "special_effect_id": 1179, "change_to": 1, "change_condition": 2, "master_id": 35805, "global_id": 9422, "to_condition": 2, "to_global_id": 8712, "spawn_sec": 4}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "from_condition": 2}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "tags": ["黒炎"], "hp": 6500, "attack": 1, "base_hp": 6500, "base_attack": 1, "damage_type": "physical", "armor_defense": 20, "attack_speed": 1, "attack_wait": 10, "attack_interval": 86, "gain_cost": 1, "dot_rate": 1.2000000476837158, "pattern_id": 2138608, "special_effect_id": 1089, "master_id": 35095, "global_id": 8712, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 14, "form_count": 2, "hp": 4500, "attack": 950, "base_hp": 4500, "base_attack": 950, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 1, "attack