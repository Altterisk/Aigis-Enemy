agical", "armor_defense": 30, "attack_speed": 70, "attack_wait": 60, "attack_interval": 261, "move_speed": 700.0, "dot_rate": 1.399999976158142, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098224, "race_id": 9, "change_to": 9, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 535, "global_id": 534}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 250, "base_hp": 8000, "base_attack": 250, "damage_type": "magical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 79, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108384, "master_id": 30025, "global_id": 3644, "spawn_sec": 149}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 300, "base_hp": 15000, "base_attack": 300, "damage_type": "physical", "armor_defense": 100, "magic_defense": 25, "attack_range": 400, "attack_speed": 70, "attack_wait": 35, "attack_interval": 130, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2105472, "race_id": 6, "missile_id": 151, "missile": {"speed": 3.0}, "master_id": 30026, "global_id": 3645, "ranged": true, "spawn_sec": 169}, {"enemy_id": 14, "source": "local", "count": 5, "form_count": 1, "tags": ["帝国", "女性"], "hp": 2000, "attack": 500, "base_hp": 2000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_range": 40, "attack_speed": 80, "attack_wait": 30, "attack_interval": 91, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102496, "race_id": 16, "special_effect_id": 229, "missile_id": 45, "master_id": 335, "global_id": 334, "ranged": true, "spawn_sec": 183}], "popups": ["白の皇帝の攻撃は\n防御、魔法耐性を無視します。\nまた一定確率で攻撃を無効化、\n女神の加護：ダメージ軽減\nの影響を受けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴブリンクイーン", "text": "ウフフ……何て精神力なのかしら。\nここまでワタシの催眠術をはね除けた人間なんて\n過去に一人もいなかったわ。", "face": "l7bab13fc887b"}, {"name": "女王蟻", "text": "生物として雄であれば何者であろうと魅了する\n妾のフェロモンにも抗い続けるとは……ふふ。\n帝国の皇帝……其方が堕ちる時が楽しみよのぅ。", "face": "l5096b3cbafe4"}, {"name": "皇帝", "text": "黙れ……貴様らの様な愚物に、屈するものか……。", "face": "u418"}, {"name": "ゴブリン（サヨ）", "text": "（皇帝は精神力で耐えているみたいだけど……、\nどちらの洗脳も常人だと数秒と保たない魅了の力。\n休みなしで攻められれば絶対に限界は来るわ）", "face": "le2c5c8732e67"}, {"name": "ゴブリン（サヨ）", "text": "（一刻も早く、王子たちに来て貰わないと。\n……こうなったら、危険だけどやるしかなさそうね。\nいくわよ、変化の術！）", "face": "le2c5c8732e67"}, {"name": "インペリアルナイト（サヨ）", "text": "――こっちだ！　急いでくれ！", "face": "u422"}, {"name": "アンナ", "text": "案内ありがとうございます。この広い迷宮で、\n逃げ延びた方と遭遇できたのは幸運でした。\n……それにしても、酷い怪我ですね。"}, {"name": "ケイティ", "text": "その怪我で戦線で立つのは難しいでしょう。\n案内は安全な所までで大丈夫です、\n早く後方で治療を受けて下さい。", "face": "u114"}, {"name": "インペリアルナイト（サヨ）", "text": "あぁ、そうさせて貰えると助かる。\n……あとはこの道を真っすぐだ。\nどうか、皇帝を頼む！", "face": "u422"}, {"name": "皇帝", "text": "――ッ！！\nう………ぐ………あぁあ。い、意識……が……。\n――女王……サマ。クイーンサ……マ……。", "face": "u418"}, {"name": "ユリアン", "text": "お、おい……皇帝に寄り添ってる魔物達を見ろよ……。\nゴブリンクイーンだぞ……それに、女王蟻も……！\n２人がかりで皇帝を自分達の奴隷にしたってわけかよ。", "face": "u7"}, {"name": "アダマス", "text": "ケラウノス姉様……魔物の女王までも使うなんて……。\n王子、私の加護を受けた皇帝は強敵です。", "face": "l793821411b12"}, {"name": "アダマス", "text": "皇帝が持つ剣。アレはあらゆる護りを貫き、\n離れた相手さえ切り裂く我が神器です。\n戦う際は十分にお気をつけ下さい。", "face": "l793821411b12"}]}, {"trigger": "end", "lines": [{"name": "王子", "text": "……。", "face": "u1"}, {"name": "皇帝", "text": "――貴様は……英雄王の末裔の王子、か……。\nなるほど……。\n俺はとんだ醜態を見せてしまったという訳だな……。", "face": "u418"}, {"name": "アダマス", "text": "我が神器を受け継ぎし者よ。", "face": "l793821411b12"}, {"name": "皇帝", "text": "その姿は、アダマス様……なのか！？", "face": "u418"}, {"name": "アダマス", "text": "はい。如何にも私が女神アダマスです。\nこの迷宮に長らく囚われていましたが、\n精神体の身とはいえ、こうして復活を果たしました。", "face": "l793821411b12"}, {"name": "アダマス", "text": "ですが、状況は悪化しています。\n我が姉ケラウノスが活動を開始しました。\nそれと共に、魔王も復活の兆しを見せています。", "face": "l793821411b12"}, {"name": "皇帝", "text": "なん……だと……。", "face": "u418"}, {"name": "アダマス", "text": "地上界は絶望的といっても過言ではありません……。\n今や、アイギス姉さまも私も、\n力の大半を失ってしまいました……。", "face": "l793821411b12"}, {"name": "アダマス", "text": "わずかな望みがあるとすれば、\n二柱の神の加護を受けし者達。聡明な貴方ならば、\nもう全て理解しているのでしょう？", "face": "l793821411b12"}, {"name": "皇帝", "text": "……是非も無い。\n王子、どうやら貴様と協力せねばならぬようだな。", "face": "u418"}, {"name": "王子", "text": "……。（コクリ）", "face": "u1"}, {"name": "アンナ", "text": "ち、ちょっと、王子！\n国同士の大事な取り決めです！\n相槌だけじゃダメですよっ！", "face": "l09e714fb7b3c"}, {"name": "皇帝", "text": "……ふ。気にするな。俺もお喋りは好きじゃない。\n王子、貴様と俺は何もかもが違うが、\nそこだけは気が合うかもしれんな……。", "face": "u418"}]}], "active": true}