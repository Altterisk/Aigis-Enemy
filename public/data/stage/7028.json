_resist": 1000, "transform_resist": 1000, "pattern_id": 2102576, "race_id": 8, "change_to": 11, "change_condition": 3, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 379, "global_id": 378, "ranged": true, "to_condition": 3, "to_global_id": 379, "spawn_sec": 139}, {"enemy_id": 11, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 200, "base_hp": 2500, "base_attack": 200, "damage_type": "magical", "armor_defense": 150, "attack_range": 140, "attack_speed": 70, "attack_wait": 45, "attack_interval": 161, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102592, "race_id": 8, "special_effect_id": 232, "missile_id": 78, "missile": {"speed": 7.0}, "master_id": 380, "global_id": 379, "ranged": true, "from_condition": 3}, {"enemy_id": 13, "source": "local", "count": 1, "form_count": 1, "hp": 6500, "attack": 300, "base_hp": 6500, "base_attack": 300, "damage_type": "magical", "armor_defense": 120, "magic_defense": 20, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 177, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2115536, "special_effect_id": 61, "missile_id": 297, "missile": {"speed": 4.0, "splash": 80}, "master_id": 31220, "global_id": 4839, "ranged": true, "spawn_sec": 210}], "popups": ["オークシールダーは\n味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nブロックされている間、\n引き付けの効果を失います。\n　　　　　　(1/2)", "スキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。\n\n\n\n　　　　　　(2/2)", "毒蛇から受けたダメージは\n2倍になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "魔界アリの女王", "text": "――妾のフェロモンは甘かろう？\nくふ、くふふふ……精強なオークも形無しよなぁ。", "face": "lc4ff8a15531b"}, {"name": "オーク", "text": "ぐっ……うおぉぉぉっ！\n戦士の魂を汚すとは……卑怯な……！！", "face": "l29df62150588"}, {"name": "魔界アリの女王", "text": "所詮、男は妾の下僕よ。\n妾のもとへ憎き王国の者がたどり着かぬよう、\n歓喜に打ち震えながら戦うがよいぞ。", "face": "lc4ff8a15531b"}, {"name": "オーク", "text": "王子……よ……。\n来ては……ならん……ぞ……。", "face": "l29df62150588"}]}, {"trigger": "start", "lines": [{"name": "ソーマ", "text": "――この先は、\n確かオークさんの集落でしたよね。", "face": "u23"}, {"name": "レティシア", "text": "……オークの集落とも交流があるのですか？", "face": "u1001a1"}, {"name": "ソーマ", "text": "交流というか、\nそれぞれの文化を尊重しているというか……？", "face": "u23"}, {"name": "レアン", "text": "ふふ、戦闘好きのあいつらのことだ、\nここを通りたくば我らと腕試しをせよ、\nなんて言われたら、この状況では困ってしまうな。", "face": "u50"}, {"name": "オーク", "text": "…………。", "face": "l29df62150588"}, {"name": "ソーマ", "text": "わぁっ！？\nい、いきなり出てきたらびっくりしますよぉ！", "face": "u23"}, {"name": "オーク", "text": "……さま。", "face": "l29df62150588"}, {"name": "レアン", "text": "……ソーマ、下がれ。\nこいつ、様子がおかしいぞ。", "face": "u50"}, {"name": "オーク", "text": "……女王アリ様に、栄光あれ！\n我らの武技は！　全て女王アリ様のために！", "face": "l29df62150588"}, {"name": "レティシア", "text": "女王アリはここまで勢力を……。\n王子殿、お気をつけください！　敵が来ます！", "face": "u1001a1"}]}, {"trigger": "end", "lines": [{"name": "オーク", "text": "ぐっ……すま、ない……王子、よ……。\nこんな無様な姿を……見られる、とは……。", "face": "l29df62150588"}, {"name": "ソーマ", "text": "もう大丈夫ですよ。\n今対抗ポーションを持ってきますから！", "face": "u23"}, {"name": "レティシア", "text": "……オークが、人を襲ったことを謝るのですか。", "face": "u1001a1"}, {"name": "レアン", "text": "武人たることをよしとする連中だからな。\n激突することも多いが、\n決して会話が出来ないというわけでもないさ。", "face": "u50"}, {"name": "オーク", "text": "……うむ。\n望まぬ戦いを強いられることほど、\n我々の誇りを傷つけるものもない……。", "face": "l29df62150588"}, {"name": "オーク", "text": "くっ……だが、まだ身体が動かない……。\nこの先には……他の仲間たちが……いるというのに……。", "face": "l29df62150588"}, {"name": "レティシア", "text": "……オークの武人よ、\n私たちはこの先をまっすぐ抜ける予定です。", "face": "u1001a1"}, {"name": "レティシア", "text": "となれば、貴殿の仲間がいるという場所も、\nその道中ですから……ついでに……。", "face": "u1001a1"}, {"name": "レティシア", "text": "……ですよね、王子殿？", "face": "u1001a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "オーク", "text": "おぉ……恩に着る……。\n王子よ、そしていと強き女戦士よ……。\nどうか仲間達を助けてやってくれ……！", "face": "l29df62150588"}, {"name": "レティシア", "text": "……あくまでついでですから、感謝の言葉はいりません。\nさぁ王子殿、先を急ぎましょう！", "face": "u1001a1"}]}], "active": true}