{"quest_id": 7348, "name": "シャーク・オブ・ザ・デッド・R", "description": "事件の元凶である絡繰り忍者を追う一行。\n捜索のさなか、見覚えのある傷跡を持った\nメカゾンビシャークが襲いかかってくる。\n極級（★１獲得の目安：平均Lv25）", "event": "逆襲のメカゾンビシャーク", "event_category": "History", "mission_id": 920162, "map_no": 5876, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "tags": ["アンデッド", "機械"], "hp": 36000, "attack": 800, "base_hp": 36000, "base_attack": 800, "damage_type": "physical", "armor_defense": 550, "magic_defense": 5, "attack_range": 220, "attack_speed": 1, "attack_wait": 100, "attack_interval": 229, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129312, "race_id": 7, "special_effect_id": 814, "change_to": 1, "change_condition": 4, "missile_id": 26, "master_id": 33808, "global_id": 7425, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 7426, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アンデッド", "機械"], "hp": 36000, "attack": 1100, "base_hp": 36000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 550, "magic_defense": 5, "attack_range": 220, "attack_speed": 1, "attack_wait": 100, "attack_interval": 229, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129312, "race_id": 7, "special_effect_id": 814, "change_to": 2, "change_condition": 4, "missile_id": 26, "master_id": 33809, "global_id": 7426, "ranged": true, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 7427}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アンデッド", "機械"], "hp": 36000, "attack": 1650, "base_hp": 36000, "base_attack": 1650, "damage_type": "physical", "armor_defense": 550, "magic_defense": 5, "attack_range": 220, "attack_speed": 1, "attack_wait": 100, "attack_interval": 229, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 1.2999999523162842, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2129312, "race_id": 7, "special_effect_id": 814, "missile_id": 26, "master_id": 33810, "global_id": 7427, "ranged": true, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 4, "source": "local", "count": 36, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 80, "attack_speed": 150, "attack_wait": 60, "attack_interval": 171, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101136, "race_id": 7, "change_to": 4, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 658, "global_id": 657, "ranged": true, "to_global_id": 348, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 65}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 4200, "attack": 200, "base_hp": 4200, "base_attack": 200, "damage_type": "magical", "armor_defense": 120, "magic_defense": 15, "attack_range": 130, "attack_speed": 180, "attack_wait": 150, "attack_interval": 361, "move_speed": 250.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101920, "race_id": 7, "missile_id": 30, "missile": {"speed": 1.0}, "master_id": 349, "global_id": 348, "ranged": true}, {"enemy_id": 6, "source": "local", "count": 13, "form_count": 1, "tags": ["変異"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 500, "magic_defense": 10, "attack_speed": 60, "attack_wait": 60, "attack_interval": 236, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 0.8999999761581421, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2129360, "race_id": 7, "special_effect_id": 66, "master_id": 33821, "global_id": 7438, "spawn_sec": 99}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 2, "tags": ["狙う", "ブロック不可", "水面"], "hp": 10000, "base_hp": 10000, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_wait": 10, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2104960, "race_id": 7, "change_to": 7, "master_id": 30346, "global_id": 3965, "to_global_id": 3964, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 153}, {"enemy_id": 7, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 750, "base_hp": 10000, "base_attack": 750, "damage_type": "physical", "armor_defense": 500, "magic_defense": 20, "attack_speed": 90, "attack_wait": 10, "attack_interval": 171, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1500, "transform_resist": 1500, "pattern_id": 2101936, "race_id": 7, "change_to": 6, "master_id": 30345, "global_id": 3964}], "popups": ["大型のメカゾンビシャークは\n攻撃力500以下の\nあらゆる攻撃を受け付けません。\n\nまた大型のメカゾンビシャークから\n攻撃を受けると、\n即座に麻痺状態になります。\n　　　　　　(1/2)", "大型のメカゾンビシャークは\n攻撃を行うたびに、\n攻撃力がアップしていきます。\n\n２回目の攻撃後、\n攻撃力が最大になります。\n※３回目以降の攻撃力が最大\n　　　　　　(2/2)"], "dialogue": [{"trigger": "start", "lines": [{"name": "リーンベル", "text": "さて、海に出たは良いが……。\n絡繰り忍者はいったいどこにいるんだ？", "face": "u268"}, {"name": "アンナ", "text": "メカゾンビシャークの目撃情報から、\nおおよその海域は絞り込むことができています。\nただ細かい地点については調査が必要ですね……。"}, {"name": "フレイ", "text": "海上から海中の調査かぁ……。\nこれは簡単にはいかないかもね。", "face": "u1025a1"}, {"name": "クゥイル", "text": "内通者でもいれば楽なんですけどね。\nほら、たとえばゾンビシャークが道案内してくれたり……。", "face": "u1256a1"}, {"name": "ポーラ", "text": "クゥイルは変な物語の読みすぎです。\n――って、あっ、噂をすれば。", "face": "u519"}, {"name": "アレイダ", "text": "殿下、メカゾンビシャーク急速接近！\n先程よりも大きい個体です！", "face": "u1251a1"}, {"name": "アナトリア", "text": "待てよ……あの傷、見覚えがあるぞ……？", "face": "u1250a1"}, {"name": "ジークリンデ", "text": "ああ、間違いない。\nあの刀傷は私たちが刻んだものだ！", "face": "u1024a1"}, {"name": "イーリス", "text": "あの島から逃げ出したゾンビシャークが、\n絡繰り忍者に改造されたってことですか！？", "face": "u1261a1"}, {"name": "アナトリア", "text": "やっぱり一連の事件の黒幕はあいつか！\nとはいえ今は――", "face": "u1250a1"}, {"name": "ジークリンデ", "text": "――こいつの相手をしなければな。\nこの再戦、名付けるならば、そう、\nシャーク・オブ・ザ・デッド・リターンズかな。", "face": "u1024a1"}, {"name": "ポーラ", "text": "剣聖まで変な物語の影響を受けているです……。", "face": "u519"}, {"name": "イーリス", "text": "この前の事件以来、\n王国でもサメの物語が流行しちゃいましたからね……。\nとはいえ、今はサメ退治が最優先です！", "face": "u1261a1"}, {"name": "イーリス", "text": "王子、サメさんを解放するためにも、\n全力で指揮をお願いします！", "face": "u1261a1"}]}, {"trigger": "end", "lines": [{"name": "アナトリア", "text": "なんて生命力だ！\nメカゾンビシャーク、まだ動いているぞ！", "face": "u1250a1"}, {"name": "イーリス", "text": "で、でも様子がおかしいです。\nなんというのか、何かを訴えているかのような……。", "face": "u1261a1"}, {"name": "ツキコ", "text": "サメが、何かを伝えようとしている……？\nえっと……うん……助けを、求めてる、のかな……？", "face": "u1253a1"}, {"name": "イーリス", "text": "確かに、少し悲しそうな目に見えます……。\nゾンビにされて、改造されて……。\nうぅ、こんなのやっぱり許せないです！", "face": "u1261a1"}, {"name": "クゥイル", "text": "あっ……メカゾンビシャーク、海に戻っていきます。\nそれから円を描くように泳いで――", "face": "u1256a1"}, {"name": "イーリス", "text": "――私たちを、案内しようとしている……？\nて、提督！　あの子に付いていきましょう！", "face": "u1261a1"}, {"name": "リーンベル", "text": "サメの恩返し……いや、サメからの依頼、か。\n良いだろう、帆を上げろ！\n総員、あのサメを追うぞ！！", "face": "u268"}, {"name": "イーリス", "text": "王子、きっとこの先に、\n絡繰り忍者が待っているはずです。\nサメさんたちを、必ず解放してあげましょうね！", "face": "u1261a1"}]}], "active": true}