{"quest_id": 6269, "name": "第二回合同演習", "description": "白の帝国との合同演習開催。\n帝国の名だたる猛者を相手に\n王国の力を見せつけよ！\n神級（★１獲得の目安：平均Lv50）", "event": "帝国騎士と叛逆の戦火", "event_category": "History", "mission_id": 920097, "map_no": 5217, "level": 100, "multiplier": 1.0, "charisma": 75, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 50000, "attack": 1500, "base_hp": 50000, "base_attack": 1500, "damage_type": "true", "armor_defense": 1300, "magic_defense": 20, "attack_range": 190, "attack_speed": 1, "attack_wait": 30, "attack_interval": 96, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108352, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30500, "global_id": 4119, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 500, "base_hp": 13000, "base_attack": 500, "damage_type": "physical", "armor_defense": 400, "attack_speed": 40, "attack_wait": 40, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2102896, "race_id": 16, "master_id": 411, "global_id": 410, "spawn_sec": 3}, {"enemy_id": 3, "source": "local", "count": 44, "form_count": 1, "tags": ["帝国"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367, "spawn_sec": 5}, {"enemy_id": 4, "source": "local", "count": 1, "form_count": 1, "hp": 5500, "attack": 750, "base_hp": 5500, "base_attack": 750, "damage_type": "physical", "armor_defense": 300, "attack_speed": 1, "attack_wait": 15, "attack_interval": 72, "move_speed": 400.0, "gain_