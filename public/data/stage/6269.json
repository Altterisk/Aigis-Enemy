000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 10, "attack_speed": 1, "attack_wait": 15, "attack_interval": 64, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109184, "race_id": 16, "special_effect_id": 426, "master_id": 30163, "global_id": 3782, "spawn_sec": 216}, {"enemy_id": 33, "source": "local", "count": 1, "form_count": 1, "hp": 30000, "attack": 2400, "base_hp": 30000, "base_attack": 2400, "damage_type": "physical", "armor_defense": 550, "magic_defense": 10, "attack_range": 260, "attack_speed": 1, "attack_wait": 100, "attack_interval": 267, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109024, "race_id": 16, "special_effect_id": 129, "missile_id": 186, "missile": {"speed": 12.0}, "master_id": 30156, "global_id": 3775, "ranged": true, "spawn_sec": 251}, {"enemy_id": 34, "source": "local", "count": 1, "form_count": 1, "tags": ["女性"], "hp": 25000, "attack": 1000, "base_hp": 25000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 78, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2109168, "race_id": 4, "special_effect_id": 130, "master_id": 30162, "global_id": 3781, "spawn_sec": 251}, {"enemy_id": 35, "source": "local", "count": 2, "form_count": 1, "tags": ["帝国"], "hp": 11000, "attack": 400, "base_hp": 11000, "base_attack": 400, "damage_type": "physical", "armor_defense": 450, "magic_defense": 10, "attack_range": 140, "attack_speed": 1, "attack_wait": 25, "attack_interval": 81, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2108336, "race_id": 16, "special_effect_id": 222, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 30021, "global_id": 3640, "ranged": true, "spawn_sec": 260}, {"enemy_id": 36, "source": "local", "count": 2, "form_count": 1, "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "magical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 187, "missile": {"speed": 3.0}, "master_id": 911, "global_id": 910, "ranged": true, "spawn_sec": 274}, {"enemy_id": 37, "source": "local", "count": 4, "form_count": 1, "tags": ["帝国", "女性"], "hp": 2000, "attack": 500, "base_hp": 2000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 15, "attack_speed": 80, "attack_wait": 40, "attack_interval": 191, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102512, "race_id": 16, "master_id": 336, "global_id": 335, "spawn_sec": 277}], "popups": ["レオラ、レオナが\nいる間は、全ての敵ユニットの\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "――各員、配置が完了致しました！", "face": "l36e9a8a9e22a"}, {"name": "ケイティ", "text": "報告ご苦労様です。\n貴方も配置についてください。", "face": "u114"}, {"name": "兵士", "text": "はっ！", "face": "l36e9a8a9e22a"}, {"name": "ケイティ", "text": "こちらの準備は整ったようですね。\n……帝国の皆さん、そちらはどうですか？", "face": "u114"}, {"name": "メフィスト", "text": "あぁ……まさかアイギスの神器の力をこの目で、\nいや、この身で味わう事が出来る日がこようとは。\n非常に興味深い、探求し甲斐のある事象だ！　", "face": "u526"}, {"name": "アンジェリーネ", "text": "あの方が、もう一つの神器の担い手……成程。\nどことなく陛下と雰囲気が似てらっしゃいますわね。\n……ですが、果たしてその腕前はどうでしょうか。", "face": "u1430"}, {"name": "エルミラ", "text": "演習とは言え手は抜きません！\n全力でやらせて頂きますよ！！", "face": "u1427"}, {"name": "ジークリンデ", "text": "王子、この日を待ちわびていたぞ。\n貴様こそは全力を振るうに相応しい相手、\n我が剣の奥義、とくと見せてやろう！", "face": "u1429"}, {"name": "ヒース", "text": "以前の演習では良いデータを取らせてもらった、\n今回も期待しているぞ。……総員、黒の軍団に\n魔術付与した武器の装着を急げ！", "face": "u421"}, {"name": "アンナ", "text": "……皆さん、とってもやる気ですね。"}, {"name": "レオナ", "text": "あぁ……今日は演習初日、まずは\n軽い腕ならしのつもりだったのだがな。", "face": "u311"}, {"name": "レオナ", "text": "王国との演習と聞き、我先にと戦いを望む者が\n後を絶たん、それも帝国きっての猛者ばかり……\n……明日以降の演習に影響が出なければ良いのだが。", "face": "u311"}, {"name": "白の皇帝", "text": "……仕方がない。後日疲弊した奴らと\n全力で戦えないではつまらんからな。", "face": "u418"}, {"name": "レオナ", "text": "へ、陛下！？　本日の演習に陛下の御参加は\n予定されておりませんでしたが……もしや。", "face": "u311"}, {"name": "白の皇帝", "text": "…………許せ。", "face": "u418"}, {"name": "レオナ", "text": "はぁ、やはり……ですが、陛下であれば\nそう来るだろうとも思っておりました。布陣は既に、\n陛下を筆頭として問題ない陣形に展開済みです。", "face": "u311"}, {"name": "白の皇帝", "text": "……ふっ。話が早くて助かるな。\nさぁ構えろ王子、さっさと始めるぞ。", "face": "u418"}, {"name": "ケイティ", "text": "あちらも準備は宜しいようですね。\nそれではこれより、王国と帝国による\n『第二回合同軍事演習』開始致します！", "face": "u114"}]}, {"trigger": "end", "lines": [{"name": "レオナ", "text": "――そこまで！　\n本日の演習はここまでとする！", "face": "u311"}, {"name": "ケイティ", "text": "これ以上は明日以降の演習にも\n影響が出そうですね……賢明な判断かと。", "face": "u114"}, {"name": "クラーラ", "text": "はぁ……はぁ……つ、疲れましたぁ～。", "face": "u420"}, {"name": "ソーマ", "text": "そ、そうですね……。\n弓の引き過ぎで腕が張ってます……。", "face": "u23"}, {"name": "ケイティ", "text": "王子、お疲れ様でした。\n演習とは言え、帝国の名だたる猛者たちとの激戦。\n流石に両軍とも、疲労が見えますね。", "face": "u114"}, {"name": "ジークリンデ", "text": "これほど充実した戦いが出来る相手、\nそうそう出会えるものでは無い。\nさあ、まだまだ手合わせを願うぞ！", "face": "u1429"}, {"name": "モーティマ", "text": "へッ、こ、これくらいで、へこたれる程、\nモーティマ様は、貧弱じゃあねぇ！\n俺が相手してやるぜ！", "face": "u14"}, {"name": "ケイティ", "text": "モーティマさん、腕がブルブルしてますよ。\n無理はしない方が良いかと。", "face": "u114"}, {"name": "レオナ", "text": "……そうでない者たちも居るようだがな。\nだが、良い演習となった。陛下も満足そうだったしな。\n王子、明日以降の演習もよろしく頼む。", "face": "u311"}, {"name": "アンナ", "text": "色々ありましたけど、\n良い合同演習が行えそうですね。これを機に、\n帝国の皆さんとより交流を深めていきましょう。"}, {"name": "アンナ", "text": "明日からの演習に向けて、\nまずはごゆっくり休息をお取りください。\nこの度の戦いもお疲れ様でした、王子。"}]}], "active": true}