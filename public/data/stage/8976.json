{"quest_id": 8976, "name": "海洋のスライム化", "description": "暴走するスライム増産装置を破壊せよ！\n＜スライムの海：攻撃後の待ち時間が増加\n全てのダメージが減少、敵が巨大化＞\n神級（★１獲得の目安：平均覚醒Lv25）", "modifier_notes": ["スライムの海：攻撃後の待ち時間が増加\n全てのダメージが減少、敵が巨大化"], "event": "真夏のぷるぷるビーチ", "event_category": "Emergency", "mission_id": 200570, "map_no": 7450, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "modifiers": [{"kind": "term", "influence": 23, "params": [70]}, {"kind": "term", "influence": 22, "params": [70]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}, {"kind": "term", "influence": 15, "params": [175]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 3, "form_count": 1, "tags": ["機械"], "hp": 80000, "attack": 10, "base_hp": 80000, "base_attack": 10, "damage_type": "physical", "armor_defense": 350, "magic_defense": 5, "attack_speed": 120, "attack_wait": 45, "attack_interval": 243, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 0.8500000238418579, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2171312, "special_effect_id": 2465, "master_id": 40829, "commands": {"raw": "SetStageFlag(0, 1);", "sets_flags": [[0, 1]]}}, {"enemy_id": 2, "source": "local", "count": 1, "form_count": 1, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 500000, "attack": 10, "base_hp": 500000, "base_attack": 10, "damage_type": "physical", "armor_defense": 350, "magic_defense": 5, "attack_speed": 120, "attack_wait": 45, "attack_interval": 251, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2171296, "special_effect_id": 2466, "master_id": 40822, "route_behaviour": {"force_dead": true}}, {"enemy_id": 3, "source": "local", "count": 1, "form_count": 1, "tags": ["ステルス", "置物"], "fixture": true, "hp": 999999, "attack": 1, "base_hp": 999999, "base_attack": 1, "damage_type": "physical", "armor_defen