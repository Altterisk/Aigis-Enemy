tags": ["スライム"], "hp": 32000, "attack": 600, "base_hp": 32000, "base_attack": 600, "damage_type": "magical", "armor_defense": 2200, "attack_range": 30, "attack_speed": 1, "attack_wait": 10, "attack_interval": 69, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112576, "missile_id": 11, "master_id": 40827, "ranged": true, "spawn_sec": 226}, {"enemy_id": 12, "source": "local", "count": 4, "form_count": 1, "tags": ["スライム"], "hp": 9000, "attack": 380, "base_hp": 9000, "base_attack": 380, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158496, "change_to": 12, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 39889, "global_id": 13506, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 9000, "attack": 700, "base_hp": 9000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158512, "master_id": 39890, "global_id": 13507}], "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_StandMotion\");"}, "spawn_sec": 238}, {"enemy_id": 14, "source": "local", "count": 7, "form_count": 2, "hp": 8000, "attack": 1500, "base_hp": 8000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "attack_wait": 60, "attack_interval": 154, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2171200, "special_effect_id": 789, "change_to": 14, "change_condition": 4, "master_id": 40814, "to_condition": 4, "to_ticks": 1, "spawn_sec": 244}, {"enemy_id": 14, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルスII", "ブロック不可"], "hp": 8000, "attack": 10, "base_hp": 8000, "base_attack": 10, "damage_type": "physical", "armor_defense": 200, "attack_speed": 1, "attack_wait": 1, "attack_interval": 36, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2171200, "special_effect_id": 1069, "master_id": 40815, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 16, "source": "local", "count": 10, "form_count": 2, "hp": 14000, "attack": 2800, "base_hp": 14000, "base_attack": 2800, "damage_type": "physical", "armor_defense": 400, "attack_speed": 1, "attack_wait": 60, "attack_interval": 154, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2171328, "special_effect_id": 789, "change_to": 16, "change_condition": 4, "master_id": 40816, "to_condition": 4, "to_ticks": 1, "spawn_sec": 259}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["ステルスII", "ブロック不可"], "hp": 14000, "attack": 10, "base_hp": 14000, "base_attack": 10, "damage_type": "physical", "armor_defense": 400, "attack_speed": 1, "attack_wait": 1, "attack_interval": 36, "move_speed": 1600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2171328, "special_effect_id": 1069, "master_id": 40817, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 18, "source": "local", "count": 19, "form_count": 1, "tags": ["スライム"], "hp": 36000, "attack": 780, "base_hp": 36000, "base_attack": 780, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_range": 200, "attack_speed": 1, "attack_wait": 90, "attack_interval": 227, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158528, "change_to": 18, "change_condition": 1, "missile_id": 464, "missile": {"speed": 4.0, "on_hit": {"kind": "攻撃遅延", "duration_f": 140, "attack_interval_f": 140, "effect_name": "HitEffectSlow"}}, "master_id": 39891, "global_id": 13508, "ranged": true, "variants": [{"tags": ["スライム"], "hp": 36000, "attack": 1250, "base_hp": 36000, "base_attack": 1250, "damage_type": "physical", "armor_defense": 700, "magic_defense": 10, "attack_speed": 1, "attack_wait": 60, "attack_interval": 178, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2158544, "master_id": 39892, "global_id": 13509}], "commands": {"raw": "DoEnemy_Performance(\"ENBSTL_StandMotion\");"}, "spawn_sec": 264}], "popups": ["　　　【スライムの海】\n・敵が巨大化\n・味方の攻撃によるダメージが減少\n\n\n\n\n　　　　　　(1/2)", "・味方の攻撃後の待ち時間が増加\n・ユニット配置後、一定時間経過で\n　継続ダメージが発生\n\n※上記は深海の影響に対する\n　ユニット能力で\n　軽減、無効化が可能です。\n　　　　　　(2/2)", "暴走したスライム増産装置がある間\nスライム系の攻撃力と防御力、\n移動速度がアップします。\n\nまた暴走したスライム増産装置の\n一定範囲内のユニットは\n継続ダメージを受けます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "水着スライム", "text": "――た、助けて！　装置が暴走しちゃってる！！", "face": "l2f12797896ef"}, {"name": "レミィ", "text": "な、なんですって！？", "face": "u2837a1"}, {"name": "ダグマール", "text": "……おそらくは先程の戦闘の衝撃で、\n装置内部に異常が発生してしまったのでしょう。\nそのせいで制御不能に陥っているようです。", "face": "u2843a1"}, {"name": "アブグルント", "text": "そういえば貴方って技師だったわね。\n火力の話しかしないから忘れていたわ。", "face": "u2840a1"}, {"name": "ダグマール", "text": "恐縮です。それでローパー博士。\n制作者であるあなたに聞きますが、\n私の見立ては合っていますか？", "face": "u2843a1"}, {"name": "ローパー博士", "text": "ええ、その認識で問題ありませんよ。\n内部の機関……リミッターが壊れたようですね。", "face": "lca0a1294f2b4"}, {"name": "太上老君", "text": "そのリミッターとやらが壊れたらどうなるんだい？", "face": "u2838a1"}, {"name": "ローパー博士", "text": "スライム増産装置によるスライム化は、\n今までリミッターによる制限のおかげで、\n帝国近辺の海のみで留まっていました。", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "それが壊れてしまった以上、\nスライム化は際限なく進行し――", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "――物質界の海水すべてがスライムになるでしょうね。", "face": "lca0a1294f2b4"}, {"name": "ハリンヘイム", "text": "……はぁ！？", "face": "u2839a1"}, {"name": "ヘイズル", "text": "……このローパー、\n生かしておくには危険すぎるんじゃないか？", "face": "u2836a1"}, {"name": "ヴィディア", "text": "ローパー博士のことは王子殿と相談するとして、\nそれより今はスライム増産装置だ。", "face": "u2841a1"}, {"name": "ダグマール", "text": "破壊してしまえばすべての問題は解決するはずです。\nただ、一筋縄ではいかないようですね……！", "face": "u2843a1"}, {"name": "水着スライム", "text": "きゃああ！？　か、身体が勝手に動いて……！？", "face": "l2f12797896ef"}, {"name": "ダグマール", "text": "装置から異常な電磁波が放出されています！\nどうやらそれが周囲のスライムを操っているようです！", "face": "u2843a1"}, {"name": "ローパー博士", "text": "元々はスライム化した水を制御するための機能でしたが、\n暴走により外敵排除に使われているようですね。", "face": "lca0a1294f2b4"}, {"name": "水着スライム", "text": "た、助けて……！", "face": "l2f12797896ef"}, {"name": "クーコ", "text": "大丈夫だよ、すぐに助けるから。", "face": "u2837a1"}, {"name": "ヘイズル", "text": "どのみち装置は壊さないといけないんだ。\nついでに操られているスライムたちも解放してあげよう。", "face": "u2836a1"}, {"name": "ヴィラヘルム", "text": "では、行きますよ。\nすべてを解決して、みんなで夏休みを楽しみましょう。", "face": "u2835a1"}]}, {"trigger": "end", "lines": [{"name": "ハリンヘイム", "text": "スライムたちが大人しくなった……？", "face": "u2839a1"}, {"name": "ダグマール", "text": "装置が完全に停止したようです。\nこれでもう、彼女たちが操られることはありません。", "face": "u2843a1"}, {"name": "水着スライム", "text": "た、助かったぁ……。\nありがとうね、人間さんたち……。", "face": "l2f12797896ef"}, {"name": "イムラウ", "text": "どういたしまして。\nそれじゃあ、みんなで地上に帰ろっか。", "face": "u2842a1"}, {"name": "太上老君", "text": "海がスライムから海水に戻りはじめている。\n私たちはともかく、スライムの君は危ないんじゃないか？", "face": "u2838a1"}, {"name": "水着スライム", "text": "た、大変……！\nぼろぼろスライムになっちゃう……！", "face": "l2f12797896ef"}, {"name": "ヴィラヘルム", "text": "ふむ……ローパー博士に質問なのですが……。", "face": "u2835a1"}, {"name": "ヴィラヘルム", "text": "スライムでも海を泳げるようになる発明品などは、\n作っていたりしないのですか？", "face": "u2835a1"}, {"name": "水着スライム", "text": "え……？", "face": "l2f12797896ef"}, {"name": "ローパー博士", "text": "ははは、いくら私が天才博士だとしても、\nそんな都合よく発明品を持ってたりはしませんよ。", "face": "lca0a1294f2b4"}, {"name": "ローパー博士", "text": "なので一日お待ちを。\nすぐに作って、スライムのお嬢さんが\n海を楽しめるようにして差し上げましょう。", "face": "lca0a1294f2b4"}, {"name": "水着スライム", "text": "い、いいの……？\n私は悪いことをしたのに、こんなによくしてもらって……。", "face": "l2f12797896ef"}, {"name": "ヴィラヘルム", "text": "貴方の海で楽しみたいという願い自体は、\n悪いものではないと思いますから。", "face": "u2835a1"}, {"name": "ヴィラヘルム", "text": "それに、せっかくの夏休みなのです。", "face": "u2835a1"}, {"name": "ヴィラヘルム", "text": "――みんなで楽しく、はしゃぎたいじゃないですか♪", "face": "u2835a1"}]}, {"trigger": "end", "lines": [{"name": "レミィ", "text": "……あっ。", "face": "u2837a1"}, {"name": "クーコ", "text": "どうしたの、レミィ？　変な声出しちゃって。", "face": "u2837a1"}, {"name": "レミィ", "text": "なんか、装置の様子がおかしくない……？\nバチバチって帯電してるように見えるんだけど……！", "face": "u2837a1"}, {"name": "ダグマール", "text": "機械のこの反応……！　い、いけません！\n装置が爆発しそうになっています！", "face": "u2843a1"}, {"name": "ハリンヘイム", "text": "ば、爆発！？　なんでそんなことに……！？", "face": "u2839a1"}, {"name": "ローパー博士", "text": "どうやらおかしな壊れ方をしたようですね。\n回路がショートしてエネルギーが暴発寸前の状態です。", "face": "lca0a1294f2b4"}, {"name": "ヴィディア", "text": "……逃げるぞ！\nここまできて爆発に巻き込まれたくはない！", "face": "u2841a1"}, {"name": "ホルミース", "text": "ふふっ、どうやらひと夏の冒険は、\n熱い爆破オチで終わるようですね。", "face": "u2834a1"}, {"name": "ホルミース", "text": "吟遊詩人としてこのような終わり方はどうかと思いますが、\nしかして私は真実の歴史を語る者。\nこの爆発もしっかりと詩に残すとしましょう。", "face": "u2834a1"}, {"name": "ホルミース", "text": "スライムまみれの夏休み。\nこの出来事に題名をつけるならば、そう――", "face": "u2834a1"}, {"name": "ホルミース", "text": "――真夏のぷるぷるビーチ、爆破と共に終幕です！！", "face": "u2834a1"}]}]}