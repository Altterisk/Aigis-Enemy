"base_attack": 600, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 10, "attack_wait": 10, "attack_interval": 66, "move_speed": 600.0, "dot_rate": 0.800000011920929, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2154176, "special_effect_id": 753, "master_id": 37611, "global_id": 11228, "spawn_sec": 772}, {"enemy_id": 29, "source": "local", "count": 1, "form_count": 1, "tags": ["機械", "水棲"], "hp": 32000, "attack": 1100, "base_hp": 32000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 280, "attack_wait": 50, "attack_interval": 151, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2144512, "special_effect_id": 1376, "missile_id": 877, "missile": {"speed": 3.0, "splash": 80}, "master_id": 36204, "global_id": 9821, "ranged": true, "spawn_sec": 814}], "popups": ["　　　【深海の水圧(弱)】\n・味方の攻撃後待ち時間が少し増加\n・ユニット配置後、一定時間経過で\n　継続ダメージが発生\n\n※これらは、風水使いなどがもつ\n　地形効果を軽減する能力では\n　軽減できません。", "シャチのギルマンは\n攻撃力500以下の\nあらゆる攻撃を受け付けません。", "おもちゃなどの一部の敵は、\n攻撃力が一定値以下の\nあらゆる攻撃を受け付けません。\n\nまた、一部の敵は倒されると\n自身の周囲にダメージを与えます。\n　　　　　　(1/2)", "無効化される攻撃力の上限\n\nミニメカクラブウォーリア：200\nミニメカゴーレム：800\n\n\n\n　　　　　　(2/2)", "ミニメカマンボウのおもちゃは\n攻撃力500以下のあらゆる攻撃を\n受け付けません。\n\nまた、倒されると\n自身の周囲にダメージを与えます。", "王子、ナターリエが\nいる間は、全ての敵ユニットの\n攻撃と防御がアップします。", "エスネア、エフネは倒されると\nその場で復活します。\n\n２回まで復活し、\n復活するたびに強くなります。", "ムイルがいる間\n全ての敵のHPが徐々に回復します。", "エレオノーラがいる間\n全ての敵のHPが徐々に回復します。\nブロックされている間は、\n回復効果が無くなります。", "オルカレクスは\n攻撃力1000以下の\nあらゆる攻撃を受け付けません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "オルカレクス", "text": "──来たか、王国軍。", "face": "l3c57925aefa1"}, {"name": "メーア", "text": "来ましたとも！", "face": "u1038a1"}, {"name": "トゥアン", "text": "お前は帝国軍だろ。", "face": "u2189a1"}, {"name": "サナラ", "text": "……オルカレクス総統、どうしてこんな真似を？", "face": "u1830a1"}, {"name": "オルカレクス", "text": "久しいな、地上のミニメカバトラーサナラよ。\n悪いが、言葉で説明するのは少し難しいのだよ。", "face": "l3c57925aefa1"}, {"name": "トゥアン", "text": "なんだ、復讐じゃねぇのか？", "face": "u2189a1"}, {"name": "オルカレクス", "text": "復讐なんて言うと些か大仰だが……\n当たらずとも遠からずと言ったところか。", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "我がオルカ科学ラボの世界征服は、\n王国の打倒無くしてはありえないッ！", "face": "l3c57925aefa1"}, {"name": "ルイン", "text": "方法にもよるかと。", "face": "u2192a1"}, {"name": "ルイン", "text": "一概に世界征服と言いましても、\n武力的制覇、経済的支配、宗教的統一など。\nそのための最終的な勝利条件は複数存在します。", "face": "u2192a1"}, {"name": "ルイン", "text": "仮にオルカ科学ラボの目標を科学的優越に設定した場合、\n王国に対する武力的勝利は必ずしも条件には成り得ません。", "face": "u2192a1"}, {"name": "オルカレクス", "text": "キュケケ……確かにお前の言う通りだ、\n古代技術の結晶たる美しき自動人形よ。", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "だが、それでは駄目なのだ。\n王国を避けて、敗北からも目を逸らし、\nそれで成し遂げた世界征服に何の意味がある！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "お前たちとのミニメカバトルで負った傷は！　屈辱は！\n同じミニメカバトルでしか晴らすことはできないのだッ！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "我々はお前たちを倒し、次のステージへと進む！", "face": "l3c57925aefa1"}, {"name": "トゥアン", "text": "……お前たちの信念と覚悟は理解した。\nだけど、そいつは勝算あってのことなんだろうな。\n世界征服を狙うようなやつらに手加減はできねぇぜ？", "face": "u2189a1"}, {"name": "オルカレクス", "text": "ふふふ、聞いて驚け！　見て驚け！\nこれぞ我々が対王国用に開発した新兵器！\nその名も──『ミニメカキングダム』！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "顕現せよ！　おもちゃの王国よッ！", "face": "l3c57925aefa1"}, {"name": "キャリー", "text": "あっ、あれは──私たちのミニメカ！？", "face": "u646"}, {"name": "シャチのギルマン", "text": "我々は考えた！　どうすれば王国に勝てるのかを！\n悔しいが我々の力だけでは王国軍の力には及ばない！", "face": "leb78c1a18ecf"}, {"name": "オルカレクス", "text": "ならば、成ってしまえばいい。我々も、王国に！", "face": "l3c57925aefa1"}, {"name": "シャチのギルマン", "text": "そうして観察と研究、試行錯誤を重ねて完成したのが、\nお前たち王国軍を完璧にコピーしたこのミニメカである！", "face": "leb78c1a18ecf"}, {"name": "リーゼロッテ", "text": "ふむ、リゾートで感じた視線はお前たちだったか。", "face": "u1026a1"}, {"name": "王子", "text": "…………ッ！", "face": "u1"}, {"name": "オルカレクス", "text": "ふっ、驚きで声も出ぬようだな王子よ。", "face": "l3c57925aefa1"}, {"name": "ユッタ", "text": "いつもですよ？", "face": "u2186a1"}, {"name": "オルカレクス", "text": "ミニメカキングダムは王国軍と同等の力を持ちながら、\n恐怖と疲労を知らない物質界最強の軍隊として誕生した！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "もはやこれはミニメカバトルにあらず！\n世紀の大決戦、ミニメカウォーズである！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "レギュレーションは前回と同様に深海！\nルールはオーナーも参加OKの全力バトル！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "それではミニメカウォーズ……レディ──", "face": "l3c57925aefa1"}, {"name": "ルイン", "text": "──ミニメカ、ウォーズ。\nつまりは戦争なのですね？", "face": "u2192a1"}, {"name": "オルカレクス", "text": "キュケ？", "face": "l3c57925aefa1"}, {"name": "ルイン", "text": "観測範囲内にて戦争行動の発生を感知。\n当該個体オルカレクスを確認、危険度を測定──完了。\n戦闘規定に基づきギルマン絶滅プログラムを起動します。", "face": "u2192a1"}, {"name": "シャチのギルマン", "text": "総統……？　もしかして我々、地雷を踏みました？", "face": "leb78c1a18ecf"}, {"name": "ルイン", "text": "対象の抹殺を開始します。", "face": "u2192a1"}, {"name": "オルカレクス", "text": "キュケー！？", "face": "l3c57925aefa1"}]}, {"trigger": "end", "lines": [{"name": "ラーワル", "text": "ルイーン！　ストップ！　ストーップ！", "face": "u2181a1"}, {"name": "ルイン", "text": "何故止めるのです？", "face": "u2192a1"}, {"name": "ラーワル", "text": "ミニメカバトルで殺しはルール違反なんだってば！", "face": "u2181a1"}, {"name": "ルイン", "text": "……ルール、違反。承知しました。\nギルマン絶滅プログラムを中断、\n通常モードに移行します。", "face": "u2192a1"}, {"name": "シャチのギルマン", "text": "（ほっ……）", "face": "leb78c1a18ecf"}, {"name": "オルカレクス", "text": "何故だ！　何故勝てないのだ！？\n我々のミニメカに何が足りなかった！？", "face": "l3c57925aefa1"}, {"name": "ラーワル", "text": "そりゃあ、ルインモデルのミニメカは、\nそもそもの性能がルインに劣ってたし。", "face": "u2181a1"}, {"name": "ルイン", "text": "ぶい。", "face": "u2192a1"}, {"name": "オルカレクス", "text": "た、確かに我がオルカ科学ラボの技術力では、\nあの恐ろしい自動人形の性能美に及ばなかった。", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "しかし、その他のミニメカはどうだ！\n我々はお前たちを完璧に模倣したはず──", "face": "l3c57925aefa1"}, {"name": "トゥアン", "text": "シャチ公、一ついいことを教えてやるよ。", "face": "u2189a1"}, {"name": "トゥアン", "text": "──玩具は気合じゃ動かねぇ。", "face": "u2189a1"}, {"name": "ルイン", "text": "同意します。心の強さもまた、王国軍の武器の一つ。", "face": "u2192a1"}, {"name": "ルイン", "text": "どれだけスペックを真似たとしても、\n物言わぬ量産型にルインは負けません。", "face": "u2192a1"}, {"name": "トゥアン", "text": "根性が足りねぇんだよなぁ、根性がよ。\n文明にばっか頼ってっからそんな軟弱──", "face": "u2189a1"}, {"name": "オルカレクス", "text": "………………。", "face": "l3c57925aefa1"}, {"name": "シャチのギルマン", "text": "オ、オルカレクス総統……？", "face": "leb78c1a18ecf"}, {"name": "オルカレクス", "text": "こんのッ……体育会系共がァァァァッ！", "face": "l3c57925aefa1"}, {"name": "トゥアン", "text": "おおおっ！？", "face": "u2189a1"}, {"name": "オルカレクス", "text": "気合だ！？　心の強さだ！？　根性だ！？\nこれだから精神論を持ち出す輩は大嫌いなのだ！\nいつもお前たちのような存在が科学の発展を阻害する！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "勝敗の原因に精神力の優劣を持ち込むな！\nそのような曖昧で非科学的な思考は怠慢でしかない！\n基準は！？　定義は！？　その判定は誰がする！？", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "根拠は何だ！　エビデンスを出せ、エビデンスを！", "face": "l3c57925aefa1"}, {"name": "ラーワル", "text": "もー、トゥアンが適当なこと言うから怒っちゃったじゃん。", "face": "u2181a1"}, {"name": "トゥアン", "text": "地雷踏んじまったなぁ……。", "face": "u2189a1"}, {"name": "オルカレクス", "text": "我々科学の信徒は！\n決してオカルトにおもねることはしない！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "覚えていろ王国よ、我らが仇敵よ！\nオルカ科学ラボは絶対に帰ってくる！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "そして必ずやお前たちの意味の分からん、\n前時代的で野蛮な国民性を否定するだろう！", "face": "l3c57925aefa1"}, {"name": "オルカレクス", "text": "そのときまで首を洗って待っていろ！　キュケー！！", "face": "l3c57925aefa1"}, {"name": "シャチのギルマン", "text": "キュケケケケケ―！！", "face": "leb78c1a18ecf"}, {"name": "アスバール", "text": "……逃げちゃいましたね。", "face": "u2184a1"}, {"name": "エマ", "text": "王国は別に科学を否定してはいませんが……。", "face": "u2180a1"}, {"name": "サナラ", "text": "（普通のミニメカバトル、したかったなぁ……ぐすん）", "face": "u1830a1"}]}]}