{"quest_id": 7309, "name": "敵を射抜く白い花嫁", "description": "宝石箱に擬態したミミックたちが\n仕立て屋を襲撃。衣装合わせをしていた\nナナリーと協力し、敵を撃退せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "クイーンズ・ウェディング", "event_category": "History", "mission_id": 920160, "map_no": 5935, "level": 100, "multiplier": 1.0, "charisma": 25, "exp": 200, "gold": 800, "drops": [{"item": 5002, "c": 1}, {"card": 3, "c": 2}, {"item": 2001, "c": 1}, {"card": 1654, "c": 1}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 6, "form_index": 0, "form_count": 2, "hp": 1, "base_hp": 1, "damage_type": "physical", "armor_defense": 10, "magic_defense": 10, "attack_speed": 50, "attack_wait": 30, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128544, "change_to": 1, "change_condition": 2, "master_id": 33690, "global_id": 7307, "to_condition": 2, "to_global_id": 7308, "route_behaviour": {"transforms": [{}]}}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 370, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "attack_interval": 58, "move_speed": 4500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128560, "master_id": 33691, "global_id": 7308, "from_condition": 2}, {"enemy_id": 2, "source": "local", "count": 31, "form_index": 0, "form_count": 1, "hp": 2000, "attack": 150, "base_hp": 2000, "base_attack": 150, "damage_type": "physical", "armor_defense": 370, "magic_defense": 10, "attack_speed": 1, "attack_wait": 10, "attack_interval": 58, "move_speed": 4500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128560, "master_id": 33691, "global_id": 7308, "spawn_sec": 4}, {"enemy_id": 3, "source": "local", "count": 19, "form_index": 0, "form_count": 1, "hp": 640, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 18}], "dialogue": [{"trigger": "start", "lines": [{"name": "仕立て屋", "text": "サイズはぴったりのようですね。\nふふ、さすがはナナリーさん、とてもお似合いです！", "face": "lab693ae5c987"}, {"name": "ナナリー", "text": "そう……ですか？\nふふ、王子も喜んでくれるでしょうか……。", "face": "u1217a1"}, {"name": "仕立て屋", "text": "えぇ、えぇ！\nきっと王子殿下も見惚れること間違いなしです！\nあとは祝祭までに、宝石が間に合えば……。", "face": "lab693ae5c987"}, {"name": "ナナリー", "text": "……ん、仕立て屋さん、ちょっと隠れてください。\nお店の外には出ないように。", "face": "u1217a1"}, {"name": "仕立て屋", "text": "は、はい？　どうしたのですかナナリーさん？", "face": "lab693ae5c987"}, {"name": "ナナリー", "text": "敵の気配です。\nそれと……王子と、みんなの気配も。", "face": "u1217a1"}, {"name": "仕立て屋", "text": "（外の気配まで感じられるなんて、\nさすがは王国軍の精鋭、ナナリーさんだ……！）", "face": "lab693ae5c987"}, {"name": "シルセス", "text": "あっ、ナナリーさん！\n仕立て屋さんにいたんですね。\n気をつけてください、近くに敵がいます！", "face": "u451"}, {"name": "ナナリー", "text": "……うん、大丈夫、見えてます。\n王子、私も戦いますね。", "face": "u1217a1"}, {"name": "ナナリー", "text": "本陣の前で足止めしてくれたら、\nその敵は……私が射ちます。\n王子、一緒に頑張りましょう。", "face": "u1217a1"}]}, {"trigger": "end", "lines": [{"name": "仕立て屋", "text": "おぉ……まさかこの店が魔物に狙われるなんて……。\n王子殿下、皆さま、ありがとうございます！", "face": "lab693ae5c987"}, {"name": "ナナリー", "text": "うぅん、仕立て屋さんが無事で良かったです。\n……ドレスの完成、楽しみにしてますね。", "face": "u1217a1"}, {"name": "メリュジアナ", "text": "さて、仕立て屋まで狙われるとは……。\nやはり敵の狙いは宝石で間違い無いな。", "face": "u740"}, {"name": "シルセス", "text": "ミミックの設置場所を探すよりは、\n狙われそうな宝石を防衛する方が\n真犯人に近づけそうですね……。", "face": "u451"}, {"name": "メリュジアナ", "text": "……ふむ。\nではここはひとつ、私がひと肌脱ぐべきか。", "face": "u740"}, {"name": "ナナリー", "text": "……メリュジアナ？\n何か、いい案があるんですか？", "face": "u1217a1"}, {"name": "メリュジアナ", "text": "然り。私のドレスはすでに完成しているからな。\n奴らの狙う宝石もしっかり準備できている。", "face": "u740"}, {"name": "メリュジアナ", "text": "つまり、遅かれ早かれ、\n連中は私のドレスを狙ってくることだろう。", "face": "u740"}, {"name": "シルセス", "text": "なるほど、襲撃される対象が分かっていれば、\n確かに防衛もしやすいですね。", "face": "u451"}, {"name": "シルセス", "text": "けれど黒き竜人族の族長が、\n囮のような危険なまねをするのは……。", "face": "u451"}, {"name": "メリュジアナ", "text": "ふふ、囮ではないぞ。\n最初から狙われると分かっているのだ。\nむしろ騎士物語のヒロインのようではないか！", "face": "u740"}, {"name": "シルセス", "text": "ふふ、分かりました。\n王子、この作戦でよろしいですか？", "face": "u451"}]}], "map": {"image": "Map920160_5935", "w": 960, "h": 640, "spots": [{"k": "b", "x": 167, "y": 131}, {"k": "m", "x": 809, "y": 361, "id": 200}, {"k": "m", "x": 708, "y": 371, "id": 201}, {"k": "m", "x": 605, "y": 353, "id": 202}, {"k": "m", "x": 512, "y": 330, "id": 203}, {"k": "m", "x": 422, "y": 367, "id": 204}, {"k": "m", "x": 310, "y": 388, "id": 205}, {"k": "m", "x": 203, "y": 358, "id": 206}, {"k": "m", "x": 111, "y": 365, "id": 207}, {"k": "m", "x": 234, "y": 282, "id": 208}, {"k": "m", "x": 260, "y": 196, "id": 209}, {"k": "m", "x": 346, "y": 151, "id": 210}, {"k": "m", "x": 426, "y": 102, "id": 211}, {"k": "m", "x": 522, "y": 57, "id": 212}, {"k": "m", "x": 612, "y": 44, "id": 213}, {"k": "m", "x": 696, "y": 79, "id": 214}, {"k": "m", "x": 759, "y": 137, "id": 215}, {"k": "m", "x": 782, "y": 261, "id": 216}, {"k": "r", "x": 855, "y": 281, "id": 300}, {"k": "r", "x": 899, "y": 315, "id": 301}, {"k": "r", "x": 837, "y": 424, "id": 302}, {"k": "r", "x": 749, "y": 421, "id": 303}, {"k": "r", "x": 485, "y": 273, "id": 304}, {"k": "r", "x": 246, "y": 437, "id": 305}, {"k": "r", "x": 179, "y": 420, "id": 306}, {"k": "r", "x": 69, "y": 316, "id": 307}, {"k": "r", "x": 144, "y": 302, "id": 308}, {"k": "r", "x": 327, "y": 255, "id": 309}, {"k": "r", "x": 374, "y": 218, "id": 310}, {"k": "r", "x": 428, "y": 181, "id": 311}, {"k": "r", "x": 500, "y": 166, "id": 312}]}, "start_cost": 20, "active": true, "story_talk": true}