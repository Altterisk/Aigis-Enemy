{"quest_id": 6102, "name": "黒鎧の魔神", "description": "強大なる力を持つ\n黒鎧の魔神『キメリエス』\n振るわれる剛剣に打ち勝ち勝利を掴め！\n神級（★１獲得の目安：平均Lv50）", "event": "奪われたグリモワール", "event_category": "History", "mission_id": 920089, "map_no": 3969, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 10000, "base_hp": 10000, "damage_type": "true", "armor_defense": 100, "magic_defense": 30, "attack_speed": 1, "attack_wait": 1, "attack_interval": 82, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2110000, "race_id": 16, "special_effect_id": 156, "master_id": 30250, "global_id": 3869, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 2, "hp": 1800, "attack": 300, "base_hp": 1800, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 141, "move_speed": 900.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109840, "race_id": 16, "change_to": 2, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30242, "global_id": 3861, "ranged": true, "to_condition": 2, "to_global_id": 3862, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 1500, "base_hp": 10000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 50, "magic_defense": 50, "attack_speed": 30, "attack_wait": 40, "attack_interval": 222, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109856, "race_id": 16, "special_effect_id": 148, "master_id": 30243, "global_id": 3862, "from_condition": 2}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 2, "hp": 1800, "attack": 300, "base_hp": 1800, "base_attack": 300, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 120, "attack_speed": 50, "attack_wait": 50, "attack_interval": 141, "move_speed": 900.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109808, "race_id": 16, "change_to": 4, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 30240, "global_id": 3859, "ranged": true, "to_condition": 2, "to_global_id": 3860, "spawn_sec": 1}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 10000, "attack": 650, "base_hp": 10000, "base_attack": 650, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 300, "attack_speed": 70, "attack_wait": 110, "attack_interval": 332, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2109824, "race_id": 16, "special_effect_id": 147, "missile_id": 167, "master_id": 30241, "global_id": 3860, "ranged": true, "from_condition": 2}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 35000, "attack": 5000, "base_hp": 35000, "base_attack": 5000, "damage_type": "physical", "armor_defense": 2000, "magic_defense": 30, "attack_speed": 40, "attack_wait": 20, "attack_interval": 149, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "transform_resist": 1, "pattern_id": 2109952, "race_id": 3, "special_effect_id": 86, "master_id": 30255, "global_id": 3874, "spawn_sec": 2}, {"enemy_id": 7, "source": "local", "count": 27, "form_count": 1, "hp": 1800, "attack": 200, "base_hp": 1800, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 200, "attack_speed": 30, "attack_wait": 30, "attack_interval": 101, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101552, "race_id": 16, "missile_id": 6, "master_id": 315, "global_id": 314, "ranged": true, "spawn_sec": 5}, {"enemy_id": 8, "source": "local", "count": 7, "form_count": 1, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 50, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101536, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 316, "global_id": 315, "ranged": true, "spawn_sec": 81}, {"enemy_id": 9, "source": "local", "count": 7, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 84}], "dialogue": [{"trigger": "start", "lines": [{"name": "教団員", "text": "――さぁ、早くキメリエス様を呼び出すんだ！", "face": "l99e65735e27d"}, {"name": "ヴェルティ", "text": "……本当にどうなっても\n知らないんだからね。", "face": "u477"}, {"name": "ヴェルティ", "text": "さぁ現れなさい。魔神、キメリエス！", "face": "u477"}]}, {"trigger": "start", "lines": [{"name": "キメリエス", "text": "……我は深淵を統べし魔が一柱、\n魔神キメリエス。\n人間よ、我を呼び出したのは貴様等か。", "face": "lb99adf5d96fb"}, {"name": "ヴェルティ", "text": "えぇそう……よ……っ！\n（魔力がどんどん……もっていかれる。\nやっぱり準備なしじゃ流石にキツいわね……）", "face": "u477"}, {"name": "教団員", "text": "この神々しき御姿……\n紛れもなく本物の\n魔神キメリエス様！", "face": "l99e65735e27d"}, {"name": "キメリエス", "text": "人間よ、願いを言え。", "face": "lb99adf5d96fb"}, {"name": "教団員", "text": "おぉ……神よ、どうか\nこの世界に終末をもたらし、\n新たな世界を――", "face": "l99e65735e27d"}, {"name": "ヴェルティ", "text": "魔神キメリエス、貴方の持つ\n悪魔の知識を私に寄越しなさい。", "face": "u477"}, {"name": "教団員", "text": "お、おい！　なにを言っているのだ！！\n願いを横取りするんじゃない！", "face": "l99e65735e27d"}, {"name": "ヴェルティ", "text": "別に私、世界の終末なんてどうでもいいもの。\n貴方達に協力したのは、魔神を呼ぶために\n利用させてもらっただけ。", "face": "u477"}, {"name": "キメリエス", "text": "……良いだろう、その願い叶えてやる。\nだが悪魔の力を求めるのであれば、\n相応の対価を捧げよ。", "face": "lb99adf5d96fb"}, {"name": "ヴェルティ", "text": "……召喚に捧げた供物に加えて、\n私の寿命の半分を貴方にあげる。\nそれで充分でしょ。", "face": "u477"}, {"name": "キメリエス", "text": "良いだろう、契約は果たされた。\n受け取るが良い、我が英知を……！", "face": "lb99adf5d96fb"}, {"name": "ヴェルティ", "text": "凄いわ……知識が流れこんで来……っ！？\nぐっ……あ……\n……あぁっ………っ！！", "face": "u477"}, {"name": "キメリエス", "text": "契約通り、我が知識の\n継承が済み次第その寿命の半分を頂く。", "face": "lb99adf5d96fb"}, {"name": "キメリエス", "text": "だが召喚に捧げられた供物、\n貴様のその身体は先に\n頂いておくとしよう。", "face": "lb99adf5d96fb"}, {"name": "ヴェルティ", "text": "な、なんです……って……\n……うっ……ぐぅ……っ！！", "face": "u477"}, {"name": "アンナ", "text": "――追いつきましたよ、ヴェルティさん！\n大人しく書片を……あぁっ！", "face": "l546252706e34"}, {"name": "ヴェルティ", "text": "………………！", "face": "u477"}, {"name": "ドルチェ", "text": "どうやら少し遅かったようね……。", "face": "u359"}, {"name": "ケイティ", "text": "ヴェルティさんのあの様子……。\n魔神に操られてしまっているようです。\nこのままではヴェルティさんの身が……！", "face": "u114"}, {"name": "ドルチェ", "text": "あの召喚された魔神を倒して\n魔界に追い返すしかないわ。\n……そう、簡単な話よ。", "face": "u359"}, {"name": "ドルチェ", "text": "王子、行くわよ……！", "face": "u359"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "……ヴェルティさんは大丈夫でしょうか？", "face": "l546252706e34"}, {"name": "ヴェルティ", "text": "……ふぅ、ようやく体が動くようになったわ。\nさて、研究の続きに取り掛からなきゃ。", "face": "u477"}, {"name": "ケイティ", "text": "思ったより元気そうですね。", "face": "u114"}, {"name": "ドルチェ", "text": "待ちなさいヴェルティ。これ以上\nグリモワールの研究はさせないわ。", "face": "u359"}, {"name": "ヴェルティ", "text": "……人の顔に銃をつきつけるなんて物騒ね。\n私の邪魔をしないでちょうだい。", "face": "u477"}, {"name": "ケイティ", "text": "危うく命が奪われる所だったのですよ？\n研究を続ければ、いつ本当に命を落とすか。", "face": "u114"}, {"name": "ヴェルティ", "text": "……だから何？　別に、\n貴方達には関係ない事でしょう。", "face": "u477"}, {"name": "アンナ", "text": "……それほどまでに研究に拘るとは。\nもしかして、何か深刻な\n理由でもあるんでしょうか？", "face": "l546252706e34"}, {"name": "ヴェルティ", "text": "趣味よ。", "face": "u477"}, {"name": "アンナ", "text": "え？", "face": "l546252706e34"}, {"name": "ヴェルティ", "text": "だから趣味。魔術書だったり、\n悪魔の事が書かれた本だったり。\nそういうのを読むのが好きなだけ。悪い？", "face": "u477"}, {"name": "アンナ", "text": "あ、いえ、別に悪い訳では。\n……えっと、どうしましょう？", "face": "l29534605041c"}, {"name": "ドルチェ", "text": "趣味で魔神を召喚するような奴よ。\nとても野放しになんてできない。", "face": "u359"}, {"name": "アンナ", "text": "そうですね……ひとまずは共に来て頂き、\n彼女の今後を考えましょう。\n王子、此度はお疲れ様でした。"}]}], "active": true}