t": 30, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101536, "race_id": 16, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 316, "global_id": 315, "ranged": true}, {"enemy_id": 5, "source": "local", "count": 5, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 200, "magic_defense": 50, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107936, "race_id": 3, "master_id": 958, "global_id": 957, "spawn_sec": 4}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098272, "race_id": 3, "master_id": 82, "global_id": 81, "spawn_sec": 68}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 15000, "attack": 1000, "base_hp": 15000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 90, "attack_speed": 55, "attack_wait": 30, "attack_interval": 186, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098288, "race_id": 3, "master_id": 231, "global_id": 230, "spawn_sec": 121}], "dialogue": [{"trigger": "start", "lines": [{"name": "アイラ", "text": "き、きき、来ましたよ！　あの人たち！", "face": "u991"}, {"name": "教団員", "text": "大丈夫です。準備は整いました。\nさぁ、こちらの本を。今こそ魔神を召喚するのです！", "face": "led4b18954d7c"}, {"name": "アイラ", "text": "は、はい……！", "face": "u991"}, {"name": "サオシュ", "text": "魔神を召喚しても、魔界には帰れないと思います……。", "face": "u968"}, {"name": "ツグミ", "text": "むべなるかな。\nサオシュ殿が言うと説得力が違いますなぁ。", "face": "u981"}, {"name": "エリス", "text": "あなたはそいつらに騙されているの！\nお願いだから、話を聞いて！", "face": "u980"}, {"name": "アイラ", "text": "あ、あんなことを言っていますけど……！？", "face": "u991"}, {"name": "教団員", "text": "油断したあなたを捕まえていじめる腹積もりなのです。\n思い出してください。私が一度でも嘘を言いましたか？", "face": "led4b18954d7c"}, {"name": "教団員", "text": "いきなり魔神を召喚せず、準備を重ねてきたのも、\nすべてはあなたが確実に魔界へ帰れるようにするため。", "face": "led4b18954d7c"}, {"name": "アイラ", "text": "うぅぅぅ、何を信じたら良いのかわかりません！", "face": "u991"}, {"name": "アイラ", "text": "けど！　私は魔界へ帰りたいんです！\n邪魔を……しないでください！！", "face": "u991"}]}, {"trigger": "end", "lines": [{"name": "アイラ", "text": "ご……ごめんなさい……。\n私、力不足で、魔神を召喚できませんでした……。", "face": "u991"}, {"name": "教団員", "text": "……なぜだ？　手順は正しかったはず。\n段階的に強力な悪魔を召喚して、生贄として捧げた。\nそれなのに、なぜ応えないのだ？　なぜ、なぜ、なぜ！", "face": "led4b18954d7c"}, {"name": "サオシュ", "text": "魔界が遠すぎて、その本のやり方じゃダメ、みたいです。", "face": "u968"}, {"name": "エリス", "text": "大丈夫？　今、ケガを治すわ。\n手荒な真似をしてごめんなさい。お話、聞いてくれる？", "face": "u980"}, {"name": "アイラ", "text": "えっ？　あ、ありがとうございます……。\nこ、これも後でいじめるための下準備でしょうか！？", "face": "u991"}, {"name": "ツグミ", "text": "王子殿、王子殿。\n今こそあなたの出番ではありませぬか？", "face": "u981"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "アイラ", "text": "あ、なんだか大丈夫そう……？\nい、いじめませんか～？", "face": "u991"}, {"name": "王子", "text": "…………。（ふるふる）", "face": "u1"}, {"name": "アイラ", "text": "じゃ、じゃあ……お話くらいなら。", "face": "u991"}, {"name": "教団員", "text": "待ちなさい、行かせませんよ……。", "face": "led4b18954d7c"}, {"name": "アイラ", "text": "っ！？", "face": "u991"}, {"name": "教団員", "text": "もう一回、もう一回です。\n次は成功させるのです！　さぁ、召喚を！\nこっちへ来て！　召喚するのです！　さぁ！　さぁ！！", "face": "led4b18954d7c"}, {"name": "アイラ", "text": "痛っ！？　は、離してください！\nそんな、今の戦いでもう魔力は……いやああああ！！", "face": "u991"}, {"name": "アンナ", "text": "これ以上、力を使わせたら彼女が危険です！\n王子、すぐに追いかけましょう！", "face": "l0e89046f5f29"}]}], "active": true}