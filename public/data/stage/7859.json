l_id": 8712, "from_condition": 2}, {"enemy_id": 10, "source": "local", "count": 6, "form_count": 2, "hp": 20000, "attack": 350, "base_hp": 20000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 70, "attack_interval": 192, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128624, "race_id": 21, "change_to": 10, "change_condition": 4, "master_id": 33702, "global_id": 7319, "to_condition": 4, "to_ticks": 3, "to_global_id": 7322, "spawn_sec": 93}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 700, "base_hp": 20000, "base_attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "attack_speed": 1, "attack_wait": 100, "attack_interval": 282, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2128640, "race_id": 21, "special_effect_id": 127, "master_id": 33705, "global_id": 7322, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 14, "source": "local", "count": 4, "form_count": 1, "tags": ["アンデッド"], "hp": 35000, "attack": 1000, "base_hp": 35000, "base_attack": 1000, "damage_type": "physical", "attack_speed": 20, "attack_wait": 25, "attack_interval": 151, "move_speed": 600.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2111888, "race_id": 12, "special_effect_id": 233, "master_id": 30630, "global_id": 4249, "spawn_sec": 126}, {"enemy_id": 15, "source": "local", "count": 12, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 150, "base_hp": 2500, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "attack_range": 110, "attack_speed": 1, "attack_wait": 5, "attack_interval": 151, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127792, "race_id": 21, "change_to": 15, "change_condition": 4, "missile_id": 498, "missile": {"speed": 5.0}, "master_id": 33559, "global_id": 7176, "ranged": true, "to_condition": 4, "to_ticks": 3, "to_global_id": 7179, "spawn_sec": 160}, {"enemy_id": 15, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "attack_range": 400, "attack_speed": 1, "attack_wait": 5, "attack_interval": 161, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2127808, "race_id": 21, "special_effect_id": 222, "missile_id": 499, "missile": {"speed": 5.0}, "master_id": 33562, "global_id": 7179, "ranged": true, "from_condition": 4, "trigger_ticks": 3}, {"enemy_id": 19, "source": "local", "count": 3, "form_count": 1, "hp": 70000, "attack": 2500, "base_hp": 70000, "base_attack": 2500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 20, "attack_wait": 25, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2108064, "race_id": 12, "master_id": 972, "global_id": 971, "spawn_sec": 228}], "popups": ["各種冥界兵は、攻撃を複数回行うと\n攻撃性能が変化します。\n\n４回目以降の攻撃は防御、\n魔法耐性を無視し、\n攻撃無効化、女神の加護の\n影響を受けません。", "アンデッド系から\n攻撃を複数回受けると、\n麻痺状態になります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "レーヴ", "text": "ラビリス……？\n人の王でありながら、\n亜神となったというあのラビリスですか！？", "face": "u454"}, {"name": "ルイン", "text": "……記録不明。\nルインの記憶装置内には、該当する情報が存在しません。", "face": "u1180a1"}, {"name": "レーヴ", "text": "書物にはほとんど、その記録が残されていません。\nですがある地方の口伝によれば、\n女王ラビリスは、死した後に冥界の審判者となったと。", "face": "u454"}, {"name": "ラビリス", "text": "然り。\n我が名は冥界の審判者、亜神ラビリス。\n法と秩序、そして名誉の番人なり。", "face": "ld7c2bb5afc1d"}, {"name": "ラビリス", "text": "なぁティルト、ヘカティエ、\n法を破った罪は重いぜ……？", "face": "ld7c2bb5afc1d"}, {"name": "ヘカティエ", "text": "――法を破ったのは、どちらかしら。\nハイドース様……いえ、亜神ハイドースの侵攻は、\n本当に法に則ったものだと言える？", "face": "u1226a1"}, {"name": "ラビリス", "text": "……あぁ？　何が言いたい。", "face": "ld7c2bb5afc1d"}, {"name": "ヘカティエ", "text": "彼は言葉巧みに、穏やかに眠るべき死者の魂を惑わした。\n未だ死すべき運命にない定命の者を、\n欺騙と虚構の名誉のために戦場へと駆り立てた。", "face": "u1226a1"}, {"name": "ヘカティエ", "text": "――そこに、亜神にあってはならない、\n私怨が存在しないと本当に言い切れるのかしら。", "face": "u1226a1"}, {"name": "ラビリス", "text": "おいおい、ヘカティエ、勘違いしてねぇか？\nオレが守るべき法とは、冥界のそれだ。", "face": "ld7c2bb5afc1d"}, {"name": "ラビリス", "text": "冥界の管理者は、その領分を侵してはならない。\n冥界とは、秩序によって成り立たねばならない。\nそこに、死者の安寧は含まれていないんだぜ？", "face": "ld7c2bb5afc1d"}, {"name": "ヘカティエ", "text": "生命とは、想いを持つもの。\nその安寧なくして、死者の国を\n清浄に保つことができると思っているの？", "face": "u1226a1"}, {"name": "ラビリス", "text": "安寧ってのはな、法に従わせることで生まれるんだよ。\n魂の管理を投げ出した亜神ヘカティエ、\n我が領地にて不敬を働いた騎士ティルト！", "face": "ld7c2bb5afc1d"}, {"name": "ラビリス", "text": "そして生者でありながら、\n冥界へ踏み入る禁を犯せし物質界の者ども！！", "face": "ld7c2bb5afc1d"}, {"name": "ラビリス", "text": "――全員等しく、オレが裁いてやるよッ！！", "face": "ld7c2bb5afc1d"}]}, {"trigger": "battle", "at_sec": 57, "lines": [{"name": "ハイデマリー", "text": "あれは、ラビリスの幻影……？", "face": "u1704a1"}, {"name": "ゲオルグ", "text": "おいおい、突っ込んでくるぞ！\n本当にあれが亜神の戦い方かよ！", "face": "u424"}, {"name": "ヘカティエ", "text": "あれはあくまで幻影よ。\n体力さえ削りきれば、突撃も止まるわ。", "face": "u1226a1"}, {"name": "ハイデマリー", "text": "上等！　乙女の怒り、ぶちかましてやらなくちゃ！", "face": "u1704a1"}]}, {"trigger": "end", "lines": [{"name": "ラビリス", "text": "なかなかやるな、懐かしいぜこの感覚！\n物質界の匂いってやつだ！", "face": "ld7c2bb5afc1d"}, {"name": "ハイデマリー", "text": "法の守護者が聞いて呆れる！\n中身はただのバトルジャンキーじゃない！", "face": "u1704a1"}, {"name": "ラビリス", "text": "否定はしねぇよ！\n亜神ってのはなァ、そう簡単に己を変えられねぇんだ！", "face": "ld7c2bb5afc1d"}, {"name": "ラビリス", "text": "それより女ァ！　てめぇ気に入ったぜ。\nこのオレに口答えしておいて、\nのうのうと生き延びてんのはヘカティエ以来だ！", "face": "ld7c2bb5afc1d"}, {"name": "レオナ", "text": "……はぁ。\nこれでは戦場ではなく、子猫の喧嘩じゃないか。", "face": "u311"}, {"name": "レオラ", "text": "あら、大牛と子猫の間違いじゃない？", "face": "u464"}, {"name": "レオナ", "text": "それでよく渡り合っているものだ……。\nだが、おかげで亜神の注意を逸らせた。\n――偵察の騎兵が戻り次第撤退を始めるぞ。", "face": "u311"}, {"name": "ラビリス", "text": "さて、帝国兵ども、\nそろそろ幕引きってやつだ。\nオレを楽しませてくれた礼をしないとなァ。", "face": "ld7c2bb5afc1d"}, {"name": "ラビリス", "text": "全員まとめて冥界送り、\n死後は仲良くオレと喧嘩と行こうぜ？", "face": "ld7c2bb5afc1d"}]}], "hard": {"level": 100, "multiplier": 1.0, "modifiers": [{"kind": "term", "influence": 48, "params": [65]}, {"kind": "term", "influence": 19, "params": [65]}, {"kind": "term", "influence": 8, "params": [0, 10, 20]}, {"kind": "term", "influence": 29, "params": [0, 120, 10]}], "enemies": [{"enemy_id": 1, "hp": 2000, "attack": 300, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127760}, {"enemy_id": 1, "form_index": 1, "hp": 2000, "attack": 600, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2127776}, {"enemy_id": 5, "hp": 30000, "attack": 1100, "damage_type": "physical", "pattern_id": 2103568}, {"enemy_id": 6, "hp": 18000, "attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2142480}, {"enemy_id": 6, "form_index": 1, "hp": 18000, "attack": 1000, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "pattern_id": 2142496}, {"enemy_id": 8, "hp": 2000, "attack": 450, "damage_type": "physical", "armor_defense": 100, "pattern_id": 2138560}, {"enemy_id": 8, "form_index": 1, "hp": 6500, "attack": 1, "damage_type": "physical", "armor_defense": 20, "pattern_id": 2138608}, {"enemy_id": 10, "hp": 20000, "attack": 350, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128624}, {"enemy_id": 10, "form_index": 1, "hp": 20000, "attack": 700, "damage_type": "true", "armor_defense": 150, "magic_defense": 20, "pattern_id": 2128640}, {"enemy_id": 14, "hp": 35000, "attack": 1000, "damage_type": "physical", "pattern_id": 2111888}, {"enemy_id": 15, "hp": 2500, "attack": 150, "damage_type": "physical", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127792}, {"enemy_id": 15, "form_index": 1, "hp": 2500, "attack": 300, "damage_type": "true", "armor_defense": 300, "magic_defense": 5, "pattern_id": 2127808}, {"enemy_id": 19, "hp": 70000, "attack": 2500, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "pattern_id": 2108064}]}, "active": true}