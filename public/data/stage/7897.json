{"quest_id": 7897, "name": "操られた忍者", "description": "正体不明の軍勢は魔神セーレが操る\nドッペルゲンガーと忍者の少女だった。\n敵を倒し、精神支配された少女を解放せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "ランス１０００　交わる世界", "event_category": "Reproduce", "mission_id": 320390, "map_no": 5151, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 1, "hp": 14000, "attack": 450, "base_hp": 14000, "base_attack": 450, "damage_type": "true", "armor_defense": 100, "magic_defense": 20, "attack_speed": 1, "attack_wait": 5, "attack_interval": 28, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2143104, "race_id": 16, "special_effect_id": 103, "master_id": 35962, "global_id": 9579, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 17, "form_count": 2, "hp": 1500, "attack": 300, "base_hp": 1500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 131, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103104, "race_id": 16, "change_to": 2, "change_condition": 2, "master_id": 417, "global_id": 416, "to_condition": 2, "to_global_id": 403, "spawn_sec": 44}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1500, "attack": 100, "base_hp": 1500, "base_attack": 100, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2102912, "master_id": 404, "global_id": 403, "from_condition": 2, "spawned_on_death_by": [2, 4, 5, 6, 7]}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 2, "hp": 8800, "attack": 650, "base_hp": 8800, "base_attack": 650, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 1, "attack_wait": 15, "attack_interval": 48, "move_speed": 1500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143104, "race_id": 16, "special_effect_id": 54, "change_to": 2, "change_condition": 2, "master_id": 35963, "global_id": 9580, "to_condition": 2, "to_global_id": 403, "spawn_sec": 70}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 2, "hp": 900, "attack": 150, "base_hp": 900, "base_attack": 150, "damage_type": "magical", "armor_defense": 20, "magic_defense": 5, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102528, "race_id": 16, "change_to": 2, "change_condition": 2, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 257, "global_id": 256, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 75}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 2, "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 170, "attack_speed": 70, "attack_wait": 40, "attack_interval": 153, "move_speed": 600.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143072, "race_id": 16, "change_to": 2, "change_condition": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 35960, "global_id": 9577, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 103}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 2, "hp": 8000, "attack": 800, "base_hp": 8000, "base_attack": 800, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 240, "attack_speed": 1, "attack_wait": 60, "attack_interval": 193, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2143088, "race_id": 16, "special_effect_id": 818, "change_to": 2, "change_condition": 2, "missile_id": 560, "missile": {"speed": 6.0, "heal": true}, "master_id": 35961, "global_id": 9578, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 156}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 40, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143152, "race_id": 3, "special_effect_id": 1283, "change_to": 8, "master_id": 35964, "global_id": 9581, "to_global_id": 9621, "spawn_sec": 211}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["置物", "ステルスII", "ブロック不可"], "fixture": true, "hp": 200000, "base_hp": 200000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 25, "attack_speed": 1, "attack_wait": 1, "attack_interval": 40, "move_speed": 600.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2143312, "race_id": 16, "special_effect_id": 1160, "change_to": 9, "master_id": 36004, "global_id": 9621}], "popups": ["見当かなみと\n見当かなみに変身した\nドッペルゲンガーは、\n一定確率で\n物理攻撃を回避します。", "シーラに変身した\nドッペルゲンガーは、\n自身の攻撃力の値で\n自身を含む周囲の敵を回復します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "魔神セーレ", "text": "ガハハハッ！\nいいぞ、素晴らしい！\nこれが異世界の戦士たちの力か！", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "むぅ……しかし、思考が肉体に引っ張られるな……。\n魂をはじき出されてなおこれとは、\nこの男、いったいどれだけ個性が強いのだ……。", "face": "l56c324708564"}, {"name": "かなみ", "text": "うあー……身体がいうこときかないー。\nおなかすいたー、トイレいきたいー。", "face": "u1761a1"}, {"name": "魔神セーレ", "text": "……こやつもこやつで、\n精神支配されてなお軽口を叩くとは。", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "まぁよい、王国はもう目の前だ。\nこのまま英雄王の子孫を倒し、\n王国の猛者たちを我が操り人形としてやろう！", "face": "l56c324708564"}, {"name": "霊体ランス", "text": "がははははっ！\n見つけたぞ魔神なんとか！", "face": "la0f84dc30bec"}, {"name": "魔神セーレ", "text": "ほう……もう追いついたか。\nしかし霊体の身で何ができる？", "face": "l56c324708564"}, {"name": "志津香", "text": "こっちは生身だから。\nランスの身体で異世界に迷惑をかける前に、\nここで止めさせてもらうわ。", "face": "u1759a1"}, {"name": "魔神セーレ", "text": "ほう……そうまで気にかけるとは、\nもしや貴様、この男の恋人か？", "face": "l56c324708564"}, {"name": "志津香", "text": "……殺すわよ？", "face": "u1759a1"}, {"name": "魔神セーレ", "text": "ふむ、ではそちらの、\nピンクのふわふわか、金髪の娘が？", "face": "l56c324708564"}, {"name": "シィル", "text": "えっとぉ、それはぁ、あのぉ……（もじもじ）", "face": "u581"}, {"name": "シーラ", "text": "私達はランス様の奴隷ですが、\nシィルさんは限りなく恋人に近いような？", "face": "u1758a1"}, {"name": "霊体ランス", "text": "何を言っとるか！（ぽかっ）\nお前も否定せんか！（ぽかっ）", "face": "la0f84dc30bec"}, {"name": "シィル", "text": "ひんひんっ！？　痛くないけど変な感じですぅ……。", "face": "u581"}, {"name": "霊体ランス", "text": "お前の野望など知ったことか。\n魔神セーレ、俺様の身体を返してもらうぞ！", "face": "la0f84dc30bec"}, {"name": "魔神セーレ", "text": "そんな安い挑発に乗るものか。\nかなみよ、小奴らを蹴散らしておけ。\n私はこのまま王都を攻め落とす。", "face": "l56c324708564"}, {"name": "かなみ", "text": "えぇぇ……かしこまりたくないぃぃ……。\nあっ、でも身体が勝手に。あっ、あっ。", "face": "u1761a1"}, {"name": "シャルロット", "text": "あれは、どうみても精神支配ですわね。\n少しお待ちを。今すぐ助けてあげますわ！", "face": "u128"}]}, {"trigger": "battle", "at_sec": 211, "lines": [{"name": "霊体ランス", "text": "かなみ、忍者が敵に捕まって、\nその上精神支配されるのはどうなんだ。", "face": "la0f84dc30bec"}, {"name": "かなみ", "text": "うっ……だってそれは……そのぉ……。\nランスの顔してたから油断しちゃって……。", "face": "u1761a1"}, {"name": "霊体ランス", "text": "俺様の肉体が奪われた時、\nかなみも一緒にいただろーが！", "face": "la0f84dc30bec"}, {"name": "かなみ", "text": "ご、ごめんなさいー！", "face": "u1761a1"}]}, {"trigger": "end", "lines": [{"name": "魔神セーレ", "text": "ほう……あれだけの部隊を相手に善戦するとは。\nこれは捨て置くこともできない、か……。", "face": "l56c324708564"}, {"name": "霊体ランス", "text": "覗き見とは趣味が悪いぞ、変態魔神。", "face": "la0f84dc30bec"}, {"name": "魔神セーレ", "text": "誰が変態か！\nくっ……この男を相手にすると、\nこちらまで引っ張られてしまう……。", "face": "l56c324708564"}, {"name": "シャルロット", "text": "肉体と精神は密接につながっていますのよ？\n元の肉体の持ち主に引っ張られるのは当たり前ですわ。", "face": "u128"}, {"name": "魔神セーレ", "text": "まぁいい、それも王国を滅ぼせば終わりだ。\nこの最強の肉体に、最強の軍、\nそして異世界の戦士たちの肉体を手に入れ……。", "face": "l56c324708564"}, {"name": "魔神セーレ", "text": "我が栄光の時代を取り戻すのだ……！\nガハハハハッ！", "face": "l56c324708564"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "王子、このままでは王国の民が危険です。", "face": "lfe3fe8d5cb21"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "シーラ", "text": "私たちも手伝います。\nランス様の肉体も、王国の方々も、\n魔神セーレの好きなようにはさせません。", "face": "u1758a1"}, {"name": "アンナ", "text": "ありがとうございます、シーラ大統領閣下。\nそれでは、このまま王国へ向かいます！"}]}], "active": true}