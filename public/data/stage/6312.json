{"quest_id": 6312, "name": "神討つ英雄", "description": "かつては敵だった者達の協力の末、\n遂にケラウノスを追い詰めた王子たち。\n人を滅ぼさんとする神との雌雄を決せよ！\n上級（★１獲得の目安：平均Lv10）", "event": "神殺しの聖槍", "event_category": "History", "mission_id": 920185, "map_no": 5113, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 3, "hp": 60000, "attack": 1500, "base_hp": 60000, "base_attack": 1500, "damage_type": "magical", "armor_defense": 2500, "magic_defense": 80, "attack_range": 220, "attack_speed": 20, "attack_wait": 110, "attack_interval": 281, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2112896, "special_effect_id": 213, "change_to": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30758, "global_id": 4377, "ranged": true, "to_global_id": 4382, "route_behaviour": {"transforms": [{"wait": 405}]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 60000, "base_hp": 60000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 40, "attack_speed": 20, "attack_wait": 110, "attack_interval": 301, "move_speed": 400.0, "dot_rate": 1.5, "pattern_id": 2112960, "special_effect_id": 138, "change_to": 2, "master_id": 30763, "global_id": 4382, "to_global_id": 4378}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 60000, "attack": 40, "base_hp": 60000, "base_attack": 40, "damage_type": "magical", "attack_range": 220, "attack_speed": 20, "attack_wait": 110, "attack_interval": 281, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "pattern_id": 2112912, "special_effect_id": 138, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30759, "global_id": 4378, "ranged": true}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 20000, "attack": 300, "base_hp": 20000, "base_attack": 300, "damage_type": "magical", "armor_defense": 500, "magic_defense": 50, "attack_range": 180, "attack_speed