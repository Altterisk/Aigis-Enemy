, "armor_defense": 20, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105536, "race_id": 6, "change_to": 9, "master_id": 656, "global_id": 655, "to_global_id": 648, "route_behaviour": {"transforms": [{"wait": 90}]}, "spawn_sec": 104}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2500, "attack": 250, "base_hp": 2500, "base_attack": 250, "damage_type": "magical", "armor_defense": 20, "magic_defense": 10, "attack_range": 100, "attack_speed": 70, "attack_wait": 40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}, {"enemy_id": 11, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107584, "race_id": 6, "change_to": 11, "master_id": 873, "global_id": 872, "route_behaviour": {"transforms": [{"wait": 420}]}, "spawn_sec": 145}, {"enemy_id": 13, "source": "local", "count": 5, "form_count": 1, "tags": ["アーマー"], "hp": 4000, "attack": 350, "base_hp": 4000, "base_attack": 350, "damage_type": "magical", "armor_defense": 500, "attack_range": 200, "attack_speed": 80, "attack_wait": 70, "attack_interval": 221, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109328, "race_id": 6, "special_effect_id": 232, "change_to": 13, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 30177, "global_id": 3796, "ranged": true, "route_behaviour": {"transforms": [{"wait": 1800}]}, "spawn_sec": 170}, {"enemy_id": 6, "source": "local", "count": 15, "form_count": 1, "hp": 3000, "attack": 400, "base_hp": 3000, "base_attack": 400, "damage_type": "physical", "armor_defense": 500, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2107376, "race_id": 6, "master_id": 572, "global_id": 571, "spawn_sec": 224}, {"enemy_id": 12, "source": "local", "count": 10, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 60, "attack_interval": 216, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107568, "race_id": 6, "master_id": 872, "global_id": 871, "spawn_sec": 252}, {"enemy_id": 15, "source": "local", "count": 5, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 900, "attack_speed": 55, "attack_wait": 60, "attack_interval": 260, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2107600, "race_id": 6, "master_id": 879, "global_id": 878, "spawn_sec": 272}], "dialogue": [{"trigger": "start", "lines": [{"name": "ケラウノス", "text": "……ぐ、ウッ……うアアアァアアァアァッッッ！！！！", "face": "ld3e1ccb68393"}, {"name": "デシウス", "text": "やった！\n肉体からケラウノスの精神体が分離したぞ！", "face": "l07c2a5a929a8"}, {"name": "ケラウノス", "text": "愚かな……愚かな愚かな愚かな愚かな人間たちめ！\nこんな……こんな屈辱は初めてです……。\nいままで甘く見ていましたが、もう絶対に許しません！", "face": "ld3e1ccb68393"}, {"name": "ネフティ", "text": "そ、そんな……。\nピラミッドが崩落し始めるなんて……。\nなんという凄まじい力の波動なの！？", "face": "u551"}, {"name": "大天使長", "text": "……ケラウノス様、\n神獣スフィンクスの起動に成功いたしました。", "face": "l5af649853ad1"}, {"name": "ケラウノス", "text": "ご苦労様です。\nそれでは大天使長よ、\n女神ケラウノスの名によって命じます。", "face": "ld3e1ccb68393"}, {"name": "ケラウノス", "text": "スフィンクスと共に、地上の人間を滅ぼしなさい。\n一人も逃さず、一切の慈悲もかけず。\n焼き払うように徹底的に駆逐するのです。", "face": "ld3e1ccb68393"}, {"name": "大天使長", "text": "承知いたしました。\n全ては神の御心のままに……。", "face": "l5af649853ad1"}, {"name": "ソーマ", "text": "そ、そんなぁ……。\n嘘、ですよね？　ケラウノス様……。", "face": "u23"}, {"name": "ケラウノス", "text": "なにを案じる必要があるのです？\n地上の心配など不要ではありませんか。\n貴方がたは全員、ここで惨めに朽ち果てるのですから。", "face": "ld3e1ccb68393"}, {"name": "ケラウノス", "text": "己の無謀を、無能を、無力を呪いながら逝きなさい。\n卑小な人間たちが束になったところで、\n神の座を脅かすことなど、決してできはしません！", "face": "ld3e1ccb68393"}, {"name": "デシウス", "text": "――否！\n我輩たちには神殺しの聖槍、\nグングニルがあることを忘れたか！", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "王子！　ケラウノスの言うとおり、\n神であるヤツを滅ぼすことは不可能だ。\n……聖槍グングニルの力が発動するまではな！", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "そして、聖槍の力を発動させるには、\nそれを試みる者――つまり我輩の力を\n聖槍に十分に注ぎ込む必要がある。", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "無論、ケラウノスはそれまで待ってはくれんだろう。\nだから……頼む！　我輩が聖槍の力を発動させるまで、\nなんとかヤツらの攻勢に耐えてくれ！", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "聖槍の力が発動すれば、ケラウノスは弱体化する。\nそうなれば人間の力でも互角に戦えるはずだ。\n発動したら我輩が合図を送る。そうしたら――", "face": "l07c2a5a929a8"}, {"name": "皇帝", "text": "――ケラウノスを討て、王子！\nいまの貴様ならできるはずだ！", "face": "u418"}, {"name": "ケラウノス", "text": "その思い上がり、後悔させてあげましょう！\n行きなさい、天使たちよ！\n聖槍の力が発動する前に彼らを殲滅するのです！", "face": "ld3e1ccb68393"}]}, {"trigger": "battle", "at_sec": 57, "lines": [{"name": "デシウス", "text": "ハァッ、ハァッ……くっ、さすがに堪えるな。\nだが、残りはあと半分といったところか……。", "face": "l07c2a5a929a8"}, {"name": "デシウス", "text": "王子、あと一息だ！　\nなんとしても奴らの攻勢を堪えきってくれ！", "face": "l07c2a5a929a8"}]}, {"trigger": "battle", "at_sec": 122, "lines": [{"name": "デシウス", "text": "――ぐ……うぉおぉおおッ！！！\n来た！　ついに来た！　反撃の機は満ちた！！\n喰らえぇええッ！！　ケラウノスゥウウッッ！！！！", "face": "l07c2a5a929a8"}, {"name": "ケラウノス", "text": "ぐッ……が……ぁ……あああぁあああぁあッッ！！\n力が、抜けて……うぐぅッ！　こ、これが……、\n聖槍グングニルの……神殺しの力、ですか……ッ！", "face": "ld3e1ccb68393"}, {"name": "皇帝", "text": "いまだ！\n王子、ケラウノスを――", "face": "u418"}, {"name": "デシウス", "text": "討てえぇぇええええぇえええええッッッ！！！！", "face": "l07c2a5a929a8"}]}, {"trigger": "end", "lines": [{"name": "ケラウノス", "text": "ぐ、ふッ……そんな、馬鹿な……ッ。\nこの、私が……取るに足らぬ……人間如きに……。", "face": "ld3e1ccb68393"}, {"name": "アイギス", "text": "ケラウノス姉様……。", "face": "l3c4017ec21c4"}, {"name": "ケラウノス", "text": "お……愚かな、人間たちよ……。\nこの私を討ったこと……必ずや……、\n後悔することに、なる……でしょう……。", "face": "ld3e1ccb68393"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "デシウス", "text": "………………やったのか？\nついに……ついにやったのか？\n我輩は、ついに祖国の仇を…………っ！", "face": "l07c2a5a929a8"}, {"name": "ネフティ", "text": "（……邪悪な意志に染まった力では\n聖槍の力は発動しなかったはず。\nこう見えてデシウスの意志は純粋だったのですね）", "face": "u551"}, {"name": "？？？", "text": "…………う、うぅ……ん……。", "face": "ld3e1ccb68393"}, {"name": "アンナ", "text": "あ……お、王子！　\nケラウノス様に依り代とされていた\n少女が息を吹き返しましたッ！"}, {"name": "デシウス", "text": "なにっ！？　まだ生きているだと！？", "face": "l07c2a5a929a8"}, {"name": "アンナ", "text": "お、落ち着いてください！\nこの子はもうケラウノス様では――", "face": "l27c32c63c21e"}, {"name": "デシウス", "text": "……フン、わかっているとも。\nケラウノス亡き今、この小娘はただの抜け殻に過ぎん。\n……哀れな犠牲者だ。我輩と同じな。", "face": "l07c2a5a929a8"}, {"name": "皇帝", "text": "……ふっ。", "face": "u418"}, {"name": "フィリス", "text": "――うわわわわわッ！？\nな、なんだこの揺れは？　地震か！？", "face": "u40"}, {"name": "ネフティ", "text": "くっ……皆さん、申し訳ありません！　\nこのピラミッドは間もなく崩落します！\n脱出を急いでください！　さぁ、早くッ！", "face": "u551"}]}], "active": true}