ck_interval": 136, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114032, "race_id": 2, "special_effect_id": 144, "change_to": 12, "change_condition": 1, "missile_id": 85, "missile": {"slow": [99, 0]}, "master_id": 31784, "global_id": 5403, "ranged": true, "variants": [{"hp": 50000, "attack": 3000, "base_hp": 50000, "base_attack": 3000, "damage_type": "magical", "armor_defense": 500, "magic_defense": 40, "attack_speed": 100, "attack_wait": 20, "attack_interval": 203, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2114048, "race_id": 2, "special_effect_id": 130, "master_id": 31785, "global_id": 5404}], "spawn_sec": 92}, {"enemy_id": 14, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 1000, "base_hp": 6000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 100, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100144, "race_id": 10, "master_id": 219, "global_id": 218, "spawn_sec": 99}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "master_id": 273, "global_id": 272, "spawn_sec": 109}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "hp": 12000, "attack": 1500, "base_hp": 12000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 30, "attack_speed": 120, "attack_wait": 10, "attack_interval": 241, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100160, "race_id": 10, "special_effect_id": 130, "master_id": 31787, "global_id": 5406, "spawn_sec": 114}, {"enemy_id": 17, "source": "local", "count": 2, "form_count": 1, "hp": 1800, "attack": 350, "base_hp": 1800, "base_attack": 350, "damage_type": "magical", "armor_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 80, "attack_interval": 231, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098128, "race_id": 9, "missile_id": 6, "master_id": 73, "global_id": 72, "ranged": true, "spawn_sec": 143}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 1, "tags": ["エスネア＆エフネのファン"], "hp": 1800, "attack": 450, "base_hp": 1800, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 150, "attack_speed": 70, "attack_interval": 51, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098112, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 72, "global_id": 71, "ranged": true, "spawn_sec": 143}, {"enemy_id": 19, "source": "local", "count": 8, "form_count": 1, "tags": ["アーマー", "エスネア＆エフネのファン"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 500, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103632, "race_id": 9, "master_id": 460, "global_id": 459, "spawn_sec": 150}], "dialogue": [{"trigger": "start", "lines": [{"name": "ゴライア", "text": "――追い詰めたゼ、クロコォ！！", "face": "u385"}, {"name": "ベルナ", "text": "王子、た、大変大変！\n魔力糸が取られちゃってるよ！！", "face": "u46"}, {"name": "クロコ", "text": "……また名も知らぬ雑兵ドモカ。\nまったく、ヨク吠えるものダ……。", "face": "led8387489060"}, {"name": "クロコ", "text": "ダガ、これだけの多勢となるト、\nこちらの損耗も大きくなりかねナイ。\n――ナレバ、この糸を試すのも致し方ナシカ。", "face": "led8387489060"}, {"name": "クロコ", "text": "大人しく撤退シ、\nヤガテ世界が滅びる様ヲ静観スルならばヨシ。\nダガ、抗うというのナラ、ここで打ち砕いてヤロウ。", "face": "led8387489060"}, {"name": "ベルナ", "text": "誰が撤退するもんかっ！\n王子、そうだよね？", "face": "u46"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "ベルナ", "text": "よぉし……じゃあ私も気合い入れなきゃね。\n王子は魔王軍の相手、全力でお願いね！", "face": "u46"}, {"name": "クロコ", "text": "フフ、あくまで抗うカ。\n真ノ武人に、斯様ナ糸の力を振るうは不本意ダガ、\nコレモ全ては魔王ガリウス様のタメ……。", "face": "led8387489060"}, {"name": "クロコ", "text": "欠片ヒトツすら残さズ、\n我ガ雷槍にて滅びルがいい！！", "face": "led8387489060"}, {"name": "アンナ", "text": "王子、魔王軍が来ます！\nこの戦い、必ず勝ちましょう！！", "face": "l709026bf7534"}]}, {"trigger": "end", "lines": [{"name": "ゴライア", "text": "――今ダ、ベルナ！！\nオレが隙を作るゼ……ッ！！", "face": "u385"}, {"name": "ベルナ", "text": "――よぉし！\nそこだぁぁぁぁぁぁぁぁッ！！", "face": "u46"}, {"name": "クロコ", "text": "…………ナっ！？\n貴様ラどこカラ……！？", "face": "led8387489060"}, {"name": "ベルナ", "text": "あちゃー……魔力糸、半分しか盗めなかったか。\n私の腕もまだまだってコトかな……？", "face": "u46"}, {"name": "クロコ", "text": "王子達トノ戦いに気を取ラレ、\n魔力糸ヲ半分も持っていかれるトハ……。\n私もマダマダということか……。", "face": "led8387489060"}, {"name": "クロコ", "text": "取るに足らヌ雑兵と思っていたガ、\n認識ヲ改めねばならヌな……。\nゴライアとやら、お前の名前は記憶しておこウ……。", "face": "led8387489060"}, {"name": "ゴライア", "text": "……テメェに覚えられても、嬉しかねェよ。", "face": "u385"}, {"name": "クロコ", "text": "それから人間のムスメ……。\n武の道ならヌ、盗みで私を出し抜くとは見事ダ。", "face": "led8387489060"}, {"name": "クロコ", "text": "貴様ラに免じて、\n今日は退いてやるとシヨウ……。", "face": "led8387489060"}, {"name": "ベルナ", "text": "いーっだ！\n見事だって言うなら残り半分も置いてけー！", "face": "u46"}, {"name": "アンナ", "text": "……魔王軍、ゲートより撤退していきます。\n『祝福の魔力糸』を全て奪われる事態は、\n辛うじて防ぐことができましたね。"}, {"name": "サイラス", "text": "……ふむ、半分とはいえ盗めた事実は大きいぞ。\nこの糸は一定量が揃って初めて、\n強大な力を得るのかもしれない。", "face": "u13"}, {"name": "サイラス", "text": "糸の量が半分となったことで、\n大幅に弱体化しているようにも見える。", "face": "u13"}, {"name": "ベルナ", "text": "えーっとつまり……んん？\n魔王軍の企みを、ちゃんと妨害できたってこと？", "face": "u46"}, {"name": "シャディア", "text": "ああ、そのとおりだベルナ。\nお手柄だぞ？", "face": "u713"}, {"name": "ベルナ", "text": "えへ、えへへっ、お手柄？　お手柄？\nへっへーん、もっと褒めてもイイんだよ、王子？", "face": "u46"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "けれど、まだ安心はできません。\n外に持ち出された魔力糸の回収もありますからね。\nひとまず迷宮の外を目指しましょうか。"}]}], "active": true}