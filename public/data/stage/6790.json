{"quest_id": 6790, "name": "穿つ雷槍、護る糸", "description": "敵本隊に追いついた王子軍を竜将クロコの\n槍が迎える。魔力糸を手にし、一層\n手強さを増したクロコから糸を奪取せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "赤き盗賊の花嫁", "event_category": "History", "mission_id": 920129, "map_no": 3366, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 2, "form_count": 1, "hp": 6500, "attack": 430, "base_hp": 6500, "base_attack": 430, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_speed": 23, "attack_wait": 1, "attack_interval": 48, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098080, "race_id": 9, "special_effect_id": 130, "master_id": 31786, "global_id": 5405, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 300, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103360, "race_id": 9, "master_id": 441, "global_id": 440, "spawn_sec": 8}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 1, "hp": 1000, "attack": 150, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097632, "race_id": 9, "master_id": 35, "global_id": 34, "spawn_sec": 14}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 133, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 200