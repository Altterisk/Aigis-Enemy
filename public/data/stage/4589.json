ect_id": 229, "missile_id": 56, "missile": {"speed": 1.0, "splash": 80}, "master_id": 127, "global_id": 126, "ranged": true, "spawn_sec": 86}, {"enemy_id": 8, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "tags": ["ステルス"], "hp": 4000, "attack": 750, "base_hp": 4000, "base_attack": 750, "damage_type": "physical", "armor_defense": 100, "magic_defense": 20, "attack_speed": 47, "attack_wait": 15, "attack_interval": 110, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098832, "race_id": 16, "master_id": 124, "global_id": 123, "spawn_sec": 96}, {"enemy_id": 9, "source": "local", "count": 2, "form_index": 0, "form_count": 1, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "physical", "armor_defense": 250, "magic_defense": 10, "attack_range": 160, "attack_speed": 40, "attack_wait": 40, "attack_interval": 141, "move_speed": 500.0, "gain_cost": 3, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101872, "race_id": 16, "special_effect_id": 60, "missile_id": 101, "missile": {"speed": 2.0}, "master_id": 370, "global_id": 369, "ranged": true, "spawn_sec": 113}], "popups": ["鬼刃衆と特定の忍者は\n一定範囲内のユニットに\n継続してダメージを与えます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "鬼刃衆", "text": "今再び、われらは手に入れたのだ！", "face": "l5bc43a82c8cc"}, {"name": "忍者", "text": "も、もしやそれは！？", "face": "u147"}, {"name": "鬼刃衆", "text": "如何にも！\nこれこそは、魔神アモンの身体の一部！\nわれらに偉大なる力を授けてくれるものだ！", "face": "l5bc43a82c8cc"}, {"name": "忍者", "text": "おおっ！", "face": "u147"}, {"name": "鬼刃衆", "text": "これを煎じて飲めば、\n魔神アモンの力が手にはいるのだ！", "face": "l5bc43a82c8cc"}, {"name": "忍者", "text": "おおっ！！", "face": "u147"}, {"name": "鬼刃衆", "text": "『おおっ！！』ではないッ！\nうぬらも飲むのだ！", "face": "l5bc43a82c8cc"}, {"name": "忍者", "text": "ええ！？　拙者らもですか――ってちょっと！\n――うぶッ……ふご……ゴクリ、ゴクリ……。", "face": "u147"}, {"name": "鬼刃衆", "text": "われらが心を一つにすれば\n必ずや魔神の力を制御できるはずだ！\nそれではこちらも――ゴクリ、ゴクリ……。", "face": "l5bc43a82c8cc"}, {"name": "鬼刃衆", "text": "……うぉぉぉおおおッ！！！\n力が湧いてくるぞ！\nうぬらも感じるか、この燃えるような魔力を！", "face": "l5bc43a82c8cc"}, {"name": "忍者", "text": "……ぉぉぉおおおっ！　感じますッ！\n熱いほどの力が身体中を駆け巡ってます！\nこれなら王子にだって勝てま――アッヂぃ！？", "face": "u147"}, {"name": "忍者", "text": "ぐわあああっ！？\n身体から炎が溢れて……熱ッ、熱ぃぃいっ！！", "face": "u147"}, {"name": "鬼刃衆", "text": "き、気合いだッ！　気合いで、\n魔神の力を我が物とするのだぁぁッ！\nゆくぞぉ！", "face": "l5bc43a82c8cc"}]}, {"trigger": "end", "lines": [{"name": "鬼刃衆", "text": "む、無念……。\nつ、次こそは……。", "face": "l5bc43a82c8cc"}]}], "map": {"image": "Map920067_3698", "w": 960, "h": 640, "spots": [{"k": "b", "x": 931, "y": 228}, {"k": "b", "x": 927, "y": 424}, {"k": "b", "x": 561, "y": 529}, {"k": "m", "x": 744, "y": 372, "id": 200}, {"k": "m", "x": 632, "y": 337, "id": 201}, {"k": "m", "x": 544, "y": 166, "id": 202}, {"k": "m", "x": 310, "y": 400, "id": 203}, {"k": "m", "x": 176, "y": 410, "id": 204}, {"k": "m", "x": 417, "y": 403, "id": 205}, {"k": "m", "x": 823, "y": 198, "id": 206}, {"k": "m", "x": 714, "y": 177, "id": 207}, {"k": "m", "x": 320, "y": 167, "id": 208}, {"k": "m", "x": 328, "y": 88, "id": 209}, {"k": "m", "x": 516, "y": 406, "id": 210}, {"k": "m", "x": 517, "y": 89, "id": 211}, {"k": "m", "x": 416, "y": 313, "id": 212}, {"k": "m", "x": 311, "y": 313, "id": 213}, {"k": "m", "x": 546, "y": 475, "id": 214}, {"k": "m", "x": 513, "y": 313, "id": 215}, {"k": "m", "x": 216, "y": 168, "id": 216}, {"k": "m", "x": 114, "y": 169, "id": 217}, {"k": "m", "x": 683, "y": 258, "id": 218}, {"k": "m", "x": 846, "y": 407, "id": 219}, {"k": "r", "x": 637, "y": 421, "id": 300}, {"k": "r", "x": 378, "y": 447, "id": 301}, {"k": "r", "x": 383, "y": 264, "id": 302}, {"k": "r", "x": 631, "y": 229, "id": 303}, {"k": "r", "x": 757, "y": 234, "id": 304}, {"k": "r", "x": 724, "y": 309, "id": 305}, {"k": "r", "x": 255, "y": 222, "id": 306}, {"k": "r", "x": 110, "y": 450, "id": 307}, {"k": "r", "x": 230, "y": 366, "id": 308}, {"k": "r", "x": 263, "y": 114, "id": 309}, {"k": "r", "x": 387, "y": 114, "id": 310}, {"k": "r", "x": 