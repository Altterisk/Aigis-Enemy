{"quest_id": 4558, "name": "飛来する尖鋭弾", "description": "長射程から尖鋭弾を撃つ\n赤き鎧の砲撃手に注意せよ！\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "暗黒騎士団と英霊の守り手", "event_category": "History", "mission_id": 920066, "map_no": 3685, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 23, "form_count": 1, "hp": 640, "attack": 140, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "hp": 5000, "attack": 400, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 6}, {"enemy_id": 3, "source": "local", "count": 5, "form_count": 1, "tags": ["アーマー"], "hp": 720, "attack": 140, "base_hp": 720, "base_attack": 140, "damage_type": "physical", "armor_defense": 200, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2103216, "race_id": 9, "master_id": 262, "global_id": 261, "spawn_sec": 17}, {"enemy_id": 4, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 2800, "attack": 400, "base_hp": 2800, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "attack_speed": 58, "attack_wait": 10, "attack_interval": 127, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097264, "master_id": 7, "spawn_sec": 52}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 900, "attack": 200, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 57}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "tags": ["アーマー"], "hp": 1400, "attack": 150, "base_hp": 1400, "base_attack": 150, "damage_type": "physical", "armor_defense": 200, "attack_range": 150, "attack_speed": 90, "attack_wait": 60, "attack_interval": 181, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104592, "special_effect_id": 235, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 722, "global_id": 721, "ranged": true, "spawn_sec": 65}, {"enemy_id": 7, "source": "local", "count": 2, "form_count": 1, "hp": 640, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 70}, {"enemy_id": 8, "source": "local", "count": 1, "form_count": 1, "tags": ["アーマー"], "hp": 2000, "attack": 350, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 250, "attack_range": 510, "attack_speed": 70, "attack_wait": 90, "attack_interval": 261, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098480, "special_effect_id": 222, "missile_id": 155, "missile": {"speed": 4.0, "splash": 67}, "master_id": 723, "global_id": 722, "ranged": true, "spawn_sec": 106}], "dialogue": [{"trigger": "start", "lines": [{"name": "レシア", "text": "協力感謝する。\n奴らは、奪った英霊の魂を、\n自らの身に宿しているはず。", "face": "u358"}, {"name": "レシア", "text": "無力化すれば、\n魂が自然と離れ、取り戻す事が出来るだろう。", "face": "u358"}, {"name": "アンナ", "text": "一つ疑問に思ったのですが、\n英霊の魂を身に宿すと\n具体的にどうなるのでしょうか？", "face": "l8f152b1c44c6"}, {"name": "レシア", "text": "英霊がもつ特技、つまりは\n『スキル』を使えるようになるのだ。", "face": "u358"}, {"name": "パーシス", "text": "特訓や努力をせずとも強くなれるというわけか。\n浅はかな考えではあるが、卑怯者にとっては\nうまみのある話ではあるな。", "face": "u192"}, {"name": "レシア", "text": "そういうことだ。", "face": "u358"}, {"name": "兵士", "text": "伝令！！\n斥候部隊が前方に敵影を捉えた模様！\n注意してください！", "face": "l675e52aabc9c"}, {"name": "アンナ", "text": "英霊たちの魂を取り戻すためにも、\n何としてでも敵を倒しましょう！\n王子、戦いのご準備を！", "face": "l8f152b1c44c6"}]}, {"trigger": "battle", "at_sec": 106, "lines": [{"name": "兵士", "text": "――うわぁああッ！！", "face": "u64"}, {"name": "兵士", "text": "遠距離からの砲撃によって\n前線の陣形が崩されていきます！", "face": "u6"}, {"name": "メル", "text": "……あれは……尖鋭弾ッ！？？\n何であんな奴らがそんな技を使えるのよ？", "face": "u1199"}, {"name": "メル", "text": "これも英霊の魂のおかげってこと？\nふざけないでよ！　砲術学校で使用法を習って、\nやっとのことで使いこなせる様になったのに……。", "face": "u1199"}, {"name": "メル", "text": "みんな気をつけて！\nあのスキルは爆風の効果を抑えてる代わりに、\nすごく射程が長いからね！", "face": "u1199"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "敵のせん滅を確認。\n王子、お疲れさまでした。"}, {"name": "レシア", "text": "よし、これでまた少し、\n英霊の魂を取り返すことができたな。", "face": "u358"}, {"name": "パーシス", "text": "砲術の基礎も出来ていない者が、修行によって\n体得されるべき砲術の妙技を実践するとは……\n『吸魂の力』とはこうも恐ろしいものなのか。", "face": "u192"}, {"name": "メル", "text": "あたし、あいつら絶対に許さない！\n悔しいとかずるいとかそういうのもあるけど、\n何よりスキルに対して失礼よ！　", "face": "u1199"}, {"name": "レシア", "text": "それだけ貴方たちが自分の武技に\n誇りをもっているという証だ。", "face": "u358"}, {"name": "レシア", "text": "貴方達のその偽りなき武技のきらめきで、\n引き続き協力を頼む。", "face": "u358"}, {"name": "メル", "text": "まっかせなさい！\nこの羽に誓って、\n勝利をあなたに届けてあげようじゃない！", "face": "u1199"}, {"name": "レシア", "text": "ふふ、頼もしい限りだ。\nそれでは、英霊達の魂を救う為に、\n進軍再開といこう。", "face": "u358"}]}], "active": true}