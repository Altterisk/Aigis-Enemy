000, "attack": 450, "base_hp": 7000, "base_attack": 450, "damage_type": "physical", "armor_defense": 50, "attack_range": 30, "attack_speed": 35, "attack_wait": 50, "attack_interval": 136, "move_speed": 650.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105424, "special_effect_id": 240, "missile_id": 45, "master_id": 643, "global_id": 642, "ranged": true}, {"enemy_id": 9, "source": "local", "count": 15, "form_count": 1, "hp": 520, "attack": 10, "base_hp": 520, "base_attack": 10, "damage_type": "physical", "armor_defense": 7, "attack_speed": 50, "attack_wait": 10, "move_speed": 2000.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2099152, "race_id": 11, "master_id": 165, "global_id": 164, "spawn_sec": 111}, {"enemy_id": 10, "source": "local", "count": 3, "form_count": 1, "tags": ["アンデッド"], "hp": 20000, "attack": 400, "base_hp": 20000, "base_attack": 400, "damage_type": "physical", "attack_speed": 35, "attack_wait": 5, "attack_interval": 76, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099120, "special_effect_id": 233, "master_id": 158, "global_id": 157, "spawn_sec": 114}, {"enemy_id": 11, "source": "local", "count": 2, "form_count": 1, "tags": ["アンデッド"], "hp": 8000, "attack": 600, "base_hp": 8000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2112032, "race_id": 3, "special_effect_id": 233, "master_id": 30634, "global_id": 4253, "spawn_sec": 147}], "dialogue": [{"trigger": "start", "lines": [{"name": "公爵", "text": "国家に裏切られた気分はどうだ、\n王に『犬』と思われていた気分はどうだ、\n信じた者に、その誇りを穢された気分は！！", "face": "l590ec7e6c7d1"}, {"name": "サリス", "text": "違う……違います！！\n私を謀るつもりですね、公爵！\n我が王が、そんな事を言うはずはありません！！", "face": "u605"}, {"name": "公爵", "text": "全て事実だよ。\n高貴なる血の娘を捧げれば、\nそれ以上の命を刈り取らぬと約束したことも……。", "face": "l590ec7e6c7d1"}, {"name": "公爵", "text": "自分の命欲しさにお前を差し出したことも、\nその時の言葉も、そしてその馬鹿げた言葉ひとつで、\n国そのものが我が贄となったという事実も！！", "face": "l590ec7e6c7d1"}, {"name": "サリス", "text": "どうして……嘘……嘘です……そんな……。", "face": "u605"}, {"name": "公爵", "text": "お前の血は、『犬』にしては実に美味そうだ。\nここで手放すのは少々惜しい……。\nさぁ、今一度、冷たき安寧に眠るが良い……。", "face": "l590ec7e6c7d1"}, {"name": "アンナ", "text": "サリスさん……！！\n王子、公爵を倒し、彼女を助けましょう！！", "face": "l2b5e94c6edfc"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "公爵、その企みもここまでです！", "face": "u114"}, {"name": "公爵", "text": "ほう、増強した我が軍勢に抗うか。……まぁ良い。\n小さな国だったが、尖兵たる眷属も十分に得られた。", "face": "l590ec7e6c7d1"}, {"name": "公爵", "text": "――血液採取の永久機関、\nあまねく吸血種を救済する我が計画の成就、\nその道程をまた一歩進めることが出来たのだ。", "face": "l590ec7e6c7d1"}, {"name": "公爵", "text": "故に、此度の決着はひとまず預けるとしよう。\n次に会する機会を楽しみにしているぞ、王子。", "face": "l590ec7e6c7d1"}, {"name": "ケイティ", "text": "くっ……逃げられましたか……。", "face": "u114"}, {"name": "カゲロウ", "text": "王子、周囲一帯を見てきたが、生存者はおらぬようだ。\n抗った者は殺され、\n従った者とて物思わぬ眷属に、か。無残なものよ……。", "face": "u139"}, {"name": "ラキュア", "text": "公爵め、やはり形振り構わぬようになったか……。\n人とヴァンパイアが共存する道は必ずある。\nそしてそれは、断じて公爵の選ぶ道とは違うものだ。", "face": "u344"}, {"name": "ラキュア", "text": "予は公爵の後を追う。\nサリスなる娘のこと、この国のこと、\n王子、其方に任せたぞ。", "face": "u344"}, {"name": "サリス", "text": "……………。", "face": "u605"}, {"name": "サリス", "text": "……王子殿下、\nこの国の最後の騎士として、感謝の意を表します。", "face": "u605"}, {"name": "サリス", "text": "私はこれより、公爵により、\n眷属とされた民の魂を解放するための、\nそして公爵を討つための旅に出ようかと思います。", "face": "u605"}, {"name": "アンナ", "text": "……王子、ひとつ提案をよろしいでしょうか？\n我々も、サリスさんも、公爵の野望を阻止するという、\n共通の目的を持っているかと思います。"}, {"name": "アンナ", "text": "目的を同じくするのなら、彼女と、\n共闘関係を結ぶことが出来るのではないでしょうか？"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "サリス", "text": "……えっ？\n私を……仲間に？", "face": "u605"}, {"name": "亡国の兵士", "text": "はぁ、はぁ……追いついた……！\nサリス卿、そういう事ならば、\n公爵の追跡は我らにお任せください！", "face": "u64"}, {"name": "サリス", "text": "あ、あなた達は……！\n良かった……生きていたのですね……！！", "face": "u605"}, {"name": "サリス", "text": "そう……そうですね。\n我らの目的は、無為に散ることではなく、\n確実に滅びた祖国の仇を討つこと……。", "face": "u605"}, {"name": "サリス", "text": "王子殿下、ご提案、\nありがたく受けさせていただきます。\n共に公爵を討ち倒しましょう……！！", "face": "u605"}]}], "active": true}