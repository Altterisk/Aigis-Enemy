{"quest_id": 4485, "name": "魔神の影", "description": "魔神の呼び声がメトゥスを誘い、\nついに恐れていた事が起こる……。\n\n極級（★１獲得の目安：平均Lv25）", "event": "死霊術師と反魂の至宝", "event_category": "History", "mission_id": 920060, "map_no": 3658, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 19, "form_count": 1, "hp": 1500, "attack": 150, "base_hp": 1500, "base_attack": 150, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097648, "race_id": 9, "master_id": 36, "global_id": 35, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 12, "form_count": 1, "tags": ["ステルス"], "hp": 2500, "attack": 300, "base_hp": 2500, "base_attack": 300, "damage_type": "physical", "armor_defense": 20, "magic_defense": 50, "attack_speed": 16, "attack_wait": 10, "attack_interval": 77, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097856, "master_id": 152, "global_id": 151, "spawn_sec": 14}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 2, "hp": 9000, "attack": 900, "base_hp": 9000, "base_attack": 900, "damage_type": "physical", "armor_defense": 200, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097824, "special_effect_id": 222, "change_to": 3, "change_condition": 2, "master_id": 547, "global_id": 546, "to_condition": 2, "to_global_id": 547, "spawn_sec": 38}, {"enemy_id": 3, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 11000, "attack": 1100, "base_hp": 11000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 200, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 500.0, "dot_rate": 1.5, "assassin_re