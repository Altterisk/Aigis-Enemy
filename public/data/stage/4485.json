, "armor_defense": 250, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 50, "attack_interval": 165, "move_speed": 450.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2102000, "missile_id": 6, "master_id": 346, "global_id": 345, "ranged": true, "spawn_sec": 111}, {"enemy_id": 9, "source": "local", "count": 5, "form_count": 1, "tags": ["アンデッド"], "hp": 1000, "attack": 300, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 123}], "dialogue": [{"trigger": "start", "lines": [{"name": "メトゥス", "text": "退屈ねー。\n誰か死霊になりたいって人はいないの？", "face": "u329"}, {"name": "カリオペ", "text": "よくそう言ってるけど、人を不死者にするって\nそんなに手軽にできちゃうわけ？", "face": "u42"}, {"name": "メトゥス", "text": "手軽とは失礼ね。私だからこその芸当なのよ。\n……いいわ。実際に見せてあげましょう。\nそうね……そこのあなた、ちょっと来なさい。", "face": "u329"}, {"name": "ミーシャ", "text": "わ、わたしですか？", "face": "u19"}, {"name": "メトゥス", "text": "怪我してもアナタの自慢の回復力なら安心\nでしょ？　いいから早く来なさい。別に本当に\n死霊にするわけじゃないのだから。", "face": "u329"}, {"name": "ミーシャ", "text": "うぅ……自分の回復力が恨めしいです……。", "face": "u19"}, {"name": "メトゥス", "text": "まずはコこうして、首をヲ、く、首を……ッ？\nうそ、うそでしょ？　この私が――が、ぁッ！", "face": "u329"}, {"name": "ミーシャ", "text": "ひぅッ――いた、いたい、です……\nメトゥス……さん、はな、して……ッ！？", "face": "u19"}, {"name": "バルバストラフ", "text": "いかん！　\nメトゥスがビフロンスに操られておる！　\nミーシャを引き離すのじゃ！", "face": "u63"}, {"name": "兵士", "text": "伝令！　\n斥候が魔物の襲来を確認した模様！", "face": "lc0e4661faf65"}, {"name": "アンナ", "text": "こんな時に……。\n王子、とにかく迎え撃つしかないようです！", "face": "l4a3feac43ef3"}]}, {"trigger": "end", "lines": [{"name": "メトゥス", "text": "ハァ……ハァ……な、なんてこと……、\nこの私が……他者に操られる……だなんて……\n身体の震えが止まらない。これは、なに……？", "face": "u329"}, {"name": "リアナ", "text": "それが恐怖というものです。", "face": "u219"}, {"name": "メトゥス", "text": "恐怖……私が、ビフロンスを、恐れている？\nこわい……こわいの……ねえ、どうしたら……\n私、どうしたらいいの……？", "face": "u329"}, {"name": "バルバストラフ", "text": "ようやく事態の深刻さを理解したようじゃな。\n答えはもう決まっておるじゃろう？", "face": "u63"}, {"name": "メトゥス", "text": "……人間に、戻る……戻らないと……、\n私が、私でなくなってしまうわ……。\nでも……戻るなんて……。", "face": "u329"}, {"name": "アンナ", "text": "まだ、そのようなこと言っているのですか？！\nあなたのお父さまや助手のリッチさんはこの状況を\n避けようと努力をされていたのですよ！？", "face": "l4a3feac43ef3"}, {"name": "メトゥス", "text": "……怖いわ……こんな感情があるなんて。\n私、知らない……未知は……こわいの……。", "face": "u329"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "バルバストラフ", "text": "しばらくは抱きしめてやるのがよかろう。\n恐慌に陥ったメトゥスの意識を\nおぬしが繋ぎ止めておくのじゃ。", "face": "u63"}, {"name": "王子", "text": "……。", "face": "u1"}, {"name": "アンナ", "text": "メトゥスさん……。\nあまり時間はありませんが、\n少しの休憩後、進軍を再開しましょう。", "face": "l4a3feac43ef3"}]}], "active": true}