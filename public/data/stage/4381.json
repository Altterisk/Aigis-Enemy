{"quest_id": 4381, "name": "白の軍団", "description": "街を包囲した白き鎧の兵士たちの\n猛攻を退けろ！\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "帝国の天馬騎士", "event_category": "History", "mission_id": 920050, "map_no": 3118, "level": 95, "multiplier": 0.95, "charisma": 25, "exp": 180, "gold": 750, "drops": [{"card": 10, "c": 1}, {"card": 56, "c": 1}, {"card": 287, "c": 2}], "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 32, "level": 85, "form_index": 0, "form_count": 1, "tags": ["帝国"], "hp": 1900, "attack": 332, "base_hp": 2000, "base_attack": 350, "damage_type": "physical", "armor_defense": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 151, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2102256, "race_id": 16, "master_id": 368, "global_id": 367}, {"enemy_id": 2, "source": "local", "count": 6, "form_index": 0, "form_count": 1, "hp": 1045, "attack": 250, "base_hp": 1100, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 100, "attack_speed": 70, "attack_wait": 60, "attack_interval": 166, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097552, "race_id": 16, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 29, "global_id": 28, "ranged": true, "spawn_sec": 47}, {"enemy_id": 3, "source": "local", "count": 2, "level": 90, "form_index": 0, "form_count": 1, "tags": ["アーマー"], "hp": 2850, "attack": 475, "base_hp": 3000, "base_attack": 500, "damage_type": "physical", "armor_defense": 300, "attack_speed": 70, "attack_wait": 10, "attack_interval": 172, "move_speed": 450.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097504, "race_id": 16, "master_id": 26, "global_id": 25, "spawn_sec": 111}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "イザベルさん、先ほどの任務というものは\nどのようなものですか？", "face": "lf42ad8a82a7e"}, {"name": "アンナ", "text": "もしよろしければご協力致します。", "face": "lf42ad8a82a7e"}, {"name": "イザベル", "text": "残念ですが、部外者に任務の内容を\n話すことは軍則により禁じられております。", "face": "u286"}, {"name": "アンナ", "text": "も、申し訳ありません……。", "face": "le5e8986d621e"}, {"name": "イザベル", "text": "そのような顔をなさらないでください。", "face": "u286"}, {"name": "イザベル", "text": "実は私も任務の内容までは\n聞かされていないのです。", "face": "u286"}, {"name": "イザベル", "text": "極秘任務とだけ通達があり、\n現地に着くまでは誰にも知らされません。", "face": "u286"}, {"name": "イザベル", "text": "……名残惜しいですが、日が落ちるまでに\nはぐれた本隊を探さなくては。", "face": "u286"}, {"name": "アンナ", "text": "はい。任務の成功をお祈りしています。"}, {"name": "イザベル", "text": "それではまたお会い致しましょう。", "face": "u286"}, {"name": "アンナ", "text": "行ってしまいましたか……。\nそれにしても王子。\nまだ魔物と戦っている国があるなんて心強いですね。"}, {"name": "ベルナール", "text": "まさか白の帝国のものだったとは……。", "face": "u10"}, {"name": "アンナ", "text": "白の帝国をご存じなのですか？", "face": "lf42ad8a82a7e"}, {"name": "ベルナール", "text": "白の帝国とは、\n一言で言えば軍事国家みたいなものだ。\n戦いによって発展し、戦いの為に存在している。", "face": "u10"}, {"name": "ベルナール", "text": "戦いに慣れているからこそ生き残れたというのは\n皮肉な話ではあるが……。", "face": "u10"}, {"name": "兵士", "text": "報告！　前方に敵影！　こちらに接近しています。", "face": "l04f957c3f991"}, {"name": "ベルナール", "text": "やれやれ。せっかく鎧の手入れを\nしたばかりだというのに……。", "face": "u10"}]}, {"trigger": "start", "lines": [{"name": "兵士", "text": "王子！　敵は魔物ではなく人間の部隊です！", "face": "l04f957c3f991"}, {"name": "ベルナール", "text": "我々を魔物と見間違えているわけでは\nなさそうだな。", "face": "u10"}]}, {"trigger": "end", "lines": [{"name": "帝国軍師", "text": "この程度の戦力ではダメか。\n黒の軍団と天馬騎士団との合流を\n優先するほかないな。", "face": "u311"}, {"name": "帝国軍師", "text": "全軍、撤退だッ！！！", "face": "u311"}, {"name": "ベルナール", "text": "敵軍にいた白い鎧の兵士たち……。\n嫌な予感がするな。", "face": "u10"}]}], "map": {"image": "Map920050_3118", "w": 960, "h": 640, "spots": [{"k": "b", "x": 824, "y": 116}, {"k": "b", "x": 779, "y": 525}, {"k": "m", "x": 703, "y": 412, "id": 200}, {"k": "m", "x": 738, "y": 252, "id": 201}, {"k": "m", "x": 571, "y": 317, "id": 202}, {"k": "m", "x": 603, "y": 234, "id": 203}, {"k": "m", "x": 517, "y": 204, "id": 204}, {"k": "m", "x": 428, "y": 188, "id": 2