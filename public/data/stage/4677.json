{"quest_id": 4677, "name": "襲われた村", "description": "奮闘する足軽たちを守り\n村から妖怪を一掃せよ！\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "第二次妖怪大戦", "event_category": "History", "mission_id": 920073, "map_no": 3724, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 36, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 4, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 2, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 10}, {"enemy_id": 2, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 4, "source": "local", "count": 4, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 19}, {"enemy_id": 3, "source": "local", "count": 11, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 34}], "dialogue": [{"trigger": "start", "lines": [{"name": "足軽", "text": "いいが！　女子供は先に逃げんろ！\nしんがりは、オイラたちでしっかり支えんど！！", "face": "u141"}, {"name": "ヨジロウ", "text": "おまんら、気合入れんとやられっぞ。\n俺たちがやられたら終わりだかんな！", "face": "u236"}, {"name": "アンナ", "text": "王子！　村が妖怪に襲われています！\n加勢しましょう！", "face": "la8f1096e2701"}, {"name": "足軽", "text": "どなたか知らんが助かった！\n村に、まだ人が取り残されとるんじゃ！\n救助するまで、まだ下がるわけにはいがねえ。", "face": "u141"}, {"name": "ヨジロウ", "text": "見たところ、随分と腕の立つ方々とお見受けする！\nおまんらに妖怪共を任せてもいいが？", "face": "u236"}, {"name": "アンナ", "text": "お任せ下さい！\n王子、村の人を守りながら戦いましょう。", "face": "la8f1096e2701"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "村を襲っていた妖怪は\n全て退治できたみたいですね。", "face": "la8f1096e2701"}, {"name": "ヨジロウ", "text": "ありがとうございます。\n村のやつらも無事でした。\nなんとお礼ばしたらいいか……。", "face": "u236"}, {"name": "アンナ", "text": "いえいえ、礼には及びません。\nそれより、妖怪が何故この村を？", "face": "la8f1096e2701"}, {"name": "足軽", "text": "わがんねえ……妖怪が軍団で襲って来て、\nオイラたちは村人を逃がす事だけで\n精一杯だったんだ。", "face": "u141"}, {"name": "ヒエン", "text": "――話途中に御免。\nご報告にござる。ぬらりひょん率いる\n妖怪軍団が、都へ進軍しているとのこと。", "face": "u112"}, {"name": "ヒエン", "text": "別の報によれば都には酒呑童子がいるとのこと。\n合流すれば大事になるのは\n火を見るより明らかかと。", "face": "u112"}, {"name": "アンナ", "text": "ヒエンさん、偵察ありがとうございます。\n王子、急いで都へ向かいましょう。", "face": "la8f1096e2701"}]}], "active": true}