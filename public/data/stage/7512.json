 "local", "count": 2, "form_count": 2, "hp": 8000, "attack": 1100, "base_hp": 8000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_speed": 90, "attack_wait": 30, "attack_interval": 196, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104400, "race_id": 14, "change_to": 6, "master_id": 522, "global_id": 521, "to_global_id": 522, "route_behaviour": {"transforms": [{"wait": 500}]}, "spawn_sec": 92}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 8000, "attack": 400, "base_hp": 8000, "base_attack": 400, "damage_type": "physical", "armor_defense": 200, "magic_defense": 20, "attack_range": 200, "attack_speed": 90, "attack_wait": 5, "attack_interval": 55, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104416, "race_id": 14, "change_to": 5, "missile_id": 131, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 523, "global_id": 522, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "ソーマ", "text": "はあ……やっぱり温泉は気持ち良いですねぇ。", "face": "u1138a1"}, {"name": "レアン", "text": "ああ、さすがは有名な温泉街だ。\n温泉の数も種類も豊富で素晴らしいが……\nそれだけに一部が貸し切り中なのが惜しいな。", "face": "u978"}, {"name": "シュシュ", "text": "フィーヌさーん！　入らないんですかー！？", "face": "u979"}, {"name": "フィーヌ", "text": "ごくり……これが、温泉……。", "face": "u1415a1"}, {"name": "フィーヌ", "text": "そっ、それでは早速──熱っっっっづ！？", "face": "u1415a1"}, {"name": "シュシュ", "text": "わーっ！？　大丈夫ですかー！？", "face": "u979"}, {"name": "フィーヌ", "text": "ダメです！　煮魚になってしまいます！", "face": "u1415a1"}, {"name": "エマ", "text": "おや、少々温度が高かったようですね。\nフィーヌさん、あちらの湯に行ってみましょう。\n源泉から離れた場所は比較的入りやすいかと。", "face": "u1137a1"}, {"name": "フィーヌ", "text": "あ、ありがとうございますエマさ──ぎゃーっ！？", "face": "u1415a1"}, {"name": "カノン", "text": "こっ、今度は何事よ！？", "face": "u1417a1"}, {"name": "エマ", "text": "──っ、皆さん臨戦態勢を！　魔物が出現しました！", "face": "u1137a1"}, {"name": "フィーヌ", "text": "こここ、こっちに来ないでくださーーい！！", "face": "u1415a1"}, {"name": "サオシュ", "text": "あっ、あれはドラコリザード……！\nこんな場所にいるはずはないのに……！", "face": "u1139a1"}, {"name": "エマ", "text": "推理は後です、まずはフィーヌさんの救出を。\nドラコリザードは水上を走ることができますので、\n地形と間合いに気をつけながら戦ってください。", "face": "u1137a1"}]}, {"trigger": "end", "lines": [{"name": "フィーヌ", "text": "ぜーはーっ！　ぜーはーっ！\nなっ、なんだったんですか今の……！？", "face": "u1415a1"}, {"name": "エマ", "text": "現状では何とも言えませんが、\nあれだけの数です、まだ他に隠れているやも。\n今すぐ温泉街の宿泊客を避難させるべきです。", "face": "u1137a1"}, {"name": "ソーマ", "text": "他のお客さんが襲われたら大変ですもんね、\n私が番台さんに報告して避難誘導してきます！", "face": "u1138a1"}, {"name": "サオシュ", "text": "……あすもちゃんが言うには、\n外から連れて来るでもしない限り、\nドラコリザードがこの地域にいるはずがないと。", "face": "u1139a1"}, {"name": "カノン", "text": "つまり誰かのペットってこと？\n何の目的で温泉にあんな魔物を！", "face": "u1417a1"}, {"name": "エマ", "text": "さて……事故か事件か。\n一般人の安全を確保次第、\n本格的な調査を始めましょう。", "face": "u1137a1"}, {"name": "フィーヌ", "text": "うぅ……温泉に入りに来たはずが、\n何故こんな事態になったのでしょう……。", "face": "u1415a1"}]}], "active": true}