{"quest_id": 8476, "name": "黒いバレンタイン商戦", "description": "工場へやってきた一行は、チョコを餌に\n真っ黒な労働を強いる現場を発見する……。\nインテリデーモンを倒し従業員を解放せよ！\n神級（★１獲得の目安：平均Lv50）", "event": "不思議なカカオクッキング", "event_category": "History", "mission_id": 920226, "map_no": 9297, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "hp": 3500, "attack": 600, "base_hp": 3500, "base_attack": 600, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 1, "attack_wait": 40, "attack_interval": 122, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2137056, "special_effect_id": 54, "master_id": 34917, "global_id": 8534}, {"enemy_id": 2, "source": "local", "count": 2, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 500, "attack": 300, "base_hp": 500, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 136, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121616, "race_id": 16, "master_id": 32454, "global_id": 6073}, {"enemy_id": 3, "source": "local", "count": 3, "form_count": 1, "tags": ["アイドルリノのファン"], "hp": 700, "attack": 120, "base_hp": 700, "base_attack": 120, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 126, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121600, "race_id": 16, "master_id": 32453, "global_id": 6072}, {"enemy_id": 4, "source": "local", "count": 10, "form_count": 3, "tags": ["アイドルリノのファン"], "hp": 13000, "attack": 800, "base_hp": 13000, "base_attack": 800, "damage_type": "physical", "armor_defense": 250, "attack_speed": 40, "attack_wait": 30, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_res