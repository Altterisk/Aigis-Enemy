 9, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_speed": 50, "attack_wait": 30, "attack_interval": 145, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121424, "special_effect_id": 39, "change_to": 21, "missile_id": 6, "master_id": 32304, "global_id": 5923, "to_global_id": 5910, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 216}, {"enemy_id": 21, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["植物", "バレンタイン"], "hp": 3000, "attack": 200, "base_hp": 3000, "base_attack": 200, "damage_type": "magical", "armor_defense": 500, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2121280, "special_effect_id": 39, "change_to": 20, "missile_id": 6, "master_id": 32291, "global_id": 5910, "ranged": true}, {"enemy_id": 23, "source": "local", "count": 9, "form_count": 1, "tags": ["バレンタイン"], "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 350, "attack_speed": 15, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121376, "race_id": 3, "change_to": 23, "master_id": 32297, "global_id": 5916, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 253}, {"enemy_id": 25, "source": "local", "count": 11, "form_count": 1, "tags": ["バレンタイン"], "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 800, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2121392, "race_id": 3, "change_to": 25, "master_id": 32300, "global_id": 5919, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 258}, {"enemy_id": 27, "source": "local", "count": 1, "form_count": 1, "tags": ["植物"], "hp": 87000, "attack": 2050, "base_hp": 87000, "base_attack": 2050, "damage_type": "magical", "armor_defense": 350, "magic_defense": 10, "attack_speed": 1, "attack_wait": 50, "attack_interval": 148, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2158624, "change_to": 27, "master_id": 38500, "global_id": 12117, "route_behaviour": {"transforms": [{"wait": 10}]}, "spawn_sec": 278}], "popups": ["巨躯のオークはHPが\n50%以下になると咆哮を行います。\n咆哮後、移動速度が上昇します。", "小人は一定確率で\n物理攻撃を回避します。", "チョコレートの箱は、\n周囲の敵のHPを回復します。\n\n一定時間経過すると\n回復効果は無くなります。", "紫帽子の小人は\n一定確率で物理攻撃を\n回避します。", "チョコトレントは\n徐々に自身のHPを回復します。\n一定時間経過すると\n回復効果は無くなります。"], "dialogue": [{"trigger": "start", "lines": [{"name": "インテリデーモン", "text": "バレンタインの商機を逃がす手はない。\n従業員を安く雇い、チョコレート工場を常に稼働させ、\n原価の低いチョコを大量生産すれば……クククク。", "face": "l23d26dc3efba"}, {"name": "インテリデーモン", "text": "さぁ従業員たちよ、永遠に働き続けなさい！\n全てはデモシェフ商会のために！", "face": "l23d26dc3efba"}, {"name": "エレイン", "text": "――ちょっと！\nまた悪い商売の仕方をしてるの！？", "face": "u2365a1"}, {"name": "インテリデーモン", "text": "おや、貴方がたは王国の……。\nいったい何故、私が管理する工場にいるのですか？", "face": "l23d26dc3efba"}, {"name": "アデライド", "text": "カカオ豆の魔物を磨砕してもらおうと思ってな。\nデモシェフ商会の工場なら、\nそれができる設備があると踏んでいたのだが……。", "face": "u2362a1"}, {"name": "インテリデーモン", "text": "なぜカカオ豆の魔物を\n磨り潰す必要があるのかは分かりませんが、\n確かにここにはその設備があります。", "face": "l23d26dc3efba"}, {"name": "インテリデーモン", "text": "しかし、悪い商売の仕方と言われるのは心外ですね。\nここの従業員たちは皆、望んで働いているのですから。", "face": "l23d26dc3efba"}, {"name": "インテリデーモン", "text": "クククク……バレンタインになると、\nなぜか男たちはチョコを欲しがりますからね。\nゆえに、報酬にチョコをちらつかせればこの通り！", "face": "l23d26dc3efba"}, {"name": "村人", "text": "うぉぉぉ……！\n手作りチョコがもらえるんだ……！\n働かないと……働かないと……ッ。", "face": "lbb0c716bc35a"}, {"name": "オーク", "text": "よく分からないが、\nチョコを貰うことは漢の勲章なのだろう？\nならば戦士として労働という戦いに挑むのみ！", "face": "la1f0e69b8b63"}, {"name": "小人", "text": "チョコ！　チョコ！　ばんざーい！！", "face": "l62fba1017ac4"}, {"name": "インテリデーモン", "text": "給料をチョコ払いにすることで人件費を大幅に削減！\nこれぞ私の、完璧なバレンタイン商戦です！", "face": "l23d26dc3efba"}, {"name": "ノストラ", "text": "散々グレーゾーンを攻めてきた私が言うのもあれだけど、\nこれは完全にブラックね。", "face": "u2364a1"}, {"name": "マツリ", "text": "働かされている皆さんが可哀想ですし、\nインテリデーモンをとっちめて解放してあげましょう。", "face": "u2363a1"}, {"name": "インテリデーモン", "text": "現場監督である私を倒すと？\nしかし、労働者たちからは既に、\n長時間労働で正気を奪っています！", "face": "l23d26dc3efba"}, {"name": "インテリデーモン", "text": "さぁ、工場の労働者たちよ、立ち上がりなさい！\n王国軍に立ち向かい、働き続けるのです！", "face": "l23d26dc3efba"}]}, {"trigger": "battle", "at_sec": 283, "lines": [{"name": "カカオ豆の魔物", "text": "う、うわぁぁぁあッ！！\n磨り潰されようと思ったら、\n変なところに乗っちゃったよぉーーッ！！", "face": "le1ad1420c9f0"}, {"name": "ミア", "text": "た、大変です！\nカカオ豆さんがベルトコンベアに流されて、\nこっちに向かってきてます！", "face": "u2361a1"}, {"name": "エレイン", "text": "もうっ、迂闊なんだから！\nとりあえず止めてあげるわよ！", "face": "u2365a1"}]}, {"trigger": "end", "lines": [{"name": "インテリデーモン", "text": "くっ、過労で従業員がへとへとになっている……！\n休憩なしで長時間働かせたのが裏目に出るとは……！", "face": "l23d26dc3efba"}, {"name": "ミア", "text": "従業員さんたちが本当に可哀想ですよ……！", "face": "u2361a1"}, {"name": "アデライド", "text": "この件はデーモンシェフに報告し、\n二度とこのようなことが起きないよう、\nしっかり叱ってもらうとしよう。", "face": "u2362a1"}, {"name": "エレイン", "text": "それで、カカオ豆はどう？\n上手く磨り潰されたかしら。", "face": "u2365a1"}, {"name": "カカオ豆の魔物", "text": "うん、しっかりペーストになったよ！\n見た目はだいぶチョコレートだよこれ！", "face": "le1ad1420c9f0"}, {"name": "ノストラ", "text": "冷静に考えたら、\nなんで磨り潰されたのに生きてるのかしら……。", "face": "u2364a1"}, {"name": "アデライド", "text": "カカオ豆の魔物なんだ。\n調理されても死なないんだろう。", "face": "u2362a1"}, {"name": "ミア", "text": "さて、後は砂糖を加えて味を調えるだけですね。\nもう少しで、チョコレートの完成ですよっ。", "face": "u2361a1"}, {"name": "カカオ豆の魔物", "text": "そうだね。\nみんなに食べてもらうのが今から楽しみだなぁ……。", "face": "le1ad1420c9f0"}, {"name": "マツリ", "text": "……今更ですが、どうして貴方は、\n人々に食べられたがっているのですか？", "face": "u2363a1"}, {"name": "カカオ豆の魔物", "text": "うん？　それはね、みんなの笑顔がみたいからかな。\nほら、カカオ豆が人を喜ばせる方法って、\nやっぱり食べてもらうのが一番だと思うし！", "face": "le1ad1420c9f0"}, {"name": "カカオ豆の魔物", "text": "つまりは、愛だよ。\nほら、料理は愛情って言うし！", "face": "le1ad1420c9f0"}, {"name": "ミア", "text": "料理は愛情……。\nふふっ、そうですね。", "face": "u2361a1"}, {"name": "ミア", "text": "では私たちも愛情を込めて、\nチョコを作っていきましょうか。", "face": "u2361a1"}]}], "active": true}