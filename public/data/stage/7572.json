ain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100032, "race_id": 16, "missile_id": 17, "missile": {"speed": 5.0, "deflectable": true}, "master_id": 212, "global_id": 211, "ranged": true, "spawn_sec": 163}, {"enemy_id": 13, "source": "local", "count": 1, "level": 80, "form_count": 1, "tags": ["女性"], "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "magical", "armor_defense": 350, "magic_defense": 50, "attack_speed": 90, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2126720, "race_id": 16, "special_effect_id": 665, "master_id": 33071, "global_id": 6688, "spawn_sec": 167}, {"enemy_id": 14, "source": "local", "count": 3, "form_count": 1, "hp": 1000, "attack": 230, "base_hp": 1000, "base_attack": 230, "damage_type": "magical", "armor_defense": 120, "magic_defense": 5, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098624, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 150, "global_id": 149, "ranged": true, "spawn_sec": 227}, {"enemy_id": 15, "source": "local", "count": 1, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "magical", "armor_defense": 400, "attack_range": 160, "attack_speed": 60, "attack_wait": 60, "attack_interval": 181, "move_speed": 400.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098544, "race_id": 2, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 293, "global_id": 292, "ranged": true, "spawn_sec": 258}], "popups": ["大山嶺霊符が味方ユニットの\n射程範囲内にいる場合、\n遠距離攻撃を自身に引き付けます。\n\nスキルやアビリティなどで\n攻撃の優先順位が指定された\n敵がいる場合や一部の攻撃は\n引き付けの効果を受けません。", "タツミは、自身の攻撃力の値で\n自身を含む周囲の敵を回復します。\n\nブロックされている間は、\n回復行動を行わなくなります。", "ヨシノがいる間は、\n忍者、サムライ系の敵の攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "訳知り竜人", "text": "――おぉ、おぉ、なんと……！\nやはり先日の人気闘兵は夢ではなかったのか……！", "face": "l734e530db973"}, {"name": "竜人の若者", "text": "だぁぁっ！　うるせェ！\n今度はナンダってんだヨ。", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "あそこで観光しておられる、\n三人の美姫ヲご存知ないノカ……！", "face": "l734e530db973"}, {"name": "タツミ", "text": "ほぁぁ……これが竜人の家かぁ。\nなるほど、中は涼しいんじゃのう♪", "face": "u1404a1"}, {"name": "アキラ", "text": "あぁもう、ひとりで出歩くと迷子になるわよ？", "face": "u1069a1"}, {"name": "タツミ", "text": "ふふん、トモエじゃあるまいし、\nそうそう迷子にはならんならん♪", "face": "u1404a1"}, {"name": "ヨシノ", "text": "はぁぁ～、このお菓子いいなぁ……。\n東の国に輸入できないかな……。", "face": "u1104a1"}, {"name": "アキラ", "text": "こっちは思いっきり寛いでるわね……。", "face": "u1069a1"}, {"name": "ヨシノ", "text": "ふふ、国主代理として招かれている以上、\nしっかり歓待を楽しんでいるアピールは必須だよ？", "face": "u1104a1"}, {"name": "アキラ", "text": "……なるほど、そういう考えもあるわね。\n一応私も、東の国の代表扱いなわけだし――", "face": "u1069a1"}, {"name": "竜人の若者", "text": "――お、おい。\nあれマサカ、天才符術士のアキラジャねぇカ！？", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "ご存知ダッタカ！！\nヤハリあの美貌と優れた符術、\n世間知らずのオマエでも――", "face": "l734e530db973"}, {"name": "竜人の若者", "text": "ッテコトは……。\nあれは戦巫女タツミ、アッチは東の国のヨシノかァ！？", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "ン、ンン、いったいドウシタのですかな？\n突然テンション上がったりしテ。", "face": "l734e530db973"}, {"name": "竜人の若者", "text": "全員東の国の猛者じゃネェか！\nうぉぉ、こうしちゃいられネェ！！", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "…………あいつも変わりましたナァ。\nジゼル嬢が祝祭を開いてくれたオカゲで、\n村も、竜人も、外に視線を向けるヨウニ……。", "face": "l734e530db973"}, {"name": "竜人の若者", "text": "ヨシノぉー！　タツミぃー！　アキラぁー！！\n頼む、手合わせをしてくれェー！！", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "コラァァァァア！！　様をつけぬカァァァァァ！！", "face": "l734e530db973"}, {"name": "ヨシノ", "text": "あはは、いいっていいって。\n模擬戦も人気闘兵パレードのうち。\nさぁさ、竜人皆でかかってきなさい！", "face": "u1104a1"}, {"name": "タツミ", "text": "ん、なんじゃなんじゃ。\nもしかして模擬戦かのう！？", "face": "u1404a1"}, {"name": "アクラ", "text": "――ははは、見てください。\nパレード本番前から、\n元気に模擬戦をしているようですよ。", "face": "u1454a1"}, {"name": "鬼刃姫", "text": "……いや、いいことだけどマズイよ！\n非戦闘員が巻き込まれないように\n急いで警備体制を敷かなきゃ！", "face": "u435"}, {"name": "アクラ", "text": "おっとそうでした。\nそれでは、ゆるりと参りましょう。", "face": "u1454a1"}]}, {"trigger": "end", "lines": [{"name": "竜人の若者", "text": "……スゲェ、タツミ様、ヨシノ様、アキラ様か。\n信仰しちまいそうダゼ……。", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "フフン、それは信仰に似てはイルが、\nマッタク異なる感情なのデスゾ？", "face": "l734e530db973"}, {"name": "竜人の若者", "text": "アァン？　なんだってんダヨ。", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "それは！　ファンになってしまったというコト！！", "face": "l734e530db973"}, {"name": "竜人の若者", "text": "そ、ソウカ！　ウォォォッ！\n今日から俺はテメェらのファンダゼェ！！", "face": "lde256fd621cb"}, {"name": "訳知り竜人", "text": "テメェ呼びは禁止ですぞー！？", "face": "l734e530db973"}, {"name": "ヨシノ", "text": "おやおや、妙な縁でファンができちゃったね。\nタツミ、ちゃんと面倒見てあげるんだよ？", "face": "u1104a1"}, {"name": "タツミ", "text": "なんでじゃ！　こういうのはアキラの役割じゃろ！", "face": "u1404a1"}, {"name": "アキラ", "text": "えぇっ、私！？\nはぁ、仕方ないなぁ……。\nほら、三人で握手会とかしてあげよ。", "face": "u1069a1"}, {"name": "ヨシノ", "text": "あー、やっぱり巻き込まれるんだ、あー。", "face": "u1104a1"}, {"name": "タツミ", "text": "ちょわー！？　何でじゃー！？\n我関係ないじゃろー！？", "face": "u1404a1"}, {"name": "アキラ", "text": "はいはい、ファンサービスするわよー。\n私だけにまかせておこうとか、\nちょっと調子が良すぎるんじゃない？", "face": "u1069a1"}, {"name": "訳知り竜人", "text": "嗚呼……竜人の隠れ里に、春が来ましたゾォ……！", "face": "l734e530db973"}]}], "active": true}