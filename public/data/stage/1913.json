c": 118}, {"enemy_id": 14, "source": "local", "count": 14, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 15000, "attack": 800, "base_hp": 15000, "base_attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "attack_range": 250, "attack_speed": 1, "attack_wait": 50, "attack_interval": 166, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2124416, "race_id": 7, "special_effect_id": 220, "missile_id": 480, "missile": {"speed": 3.0}, "master_id": 32768, "global_id": 6386, "ranged": true, "spawn_sec": 138}, {"enemy_id": 15, "source": "local", "count": 17, "form_count": 1, "tags": ["ブロック不可", "狙う", "水中"], "hp": 5250, "attack": 750, "base_hp": 5250, "base_attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "attack_range": 60, "attack_speed": 1, "attack_wait": 20, "attack_interval": 97, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123792, "race_id": 7, "missile_id": 45, "master_id": 32765, "global_id": 6383, "ranged": true, "spawn_sec": 144}, {"enemy_id": 16, "source": "local", "count": 5, "form_count": 2, "hp": 6000, "attack": 1500, "base_hp": 6000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_range": 100, "attack_speed": 60, "attack_wait": 10, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 2, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106544, "race_id": 7, "change_to": 16, "change_condition": 4, "missile_id": 139, "missile": {"speed": 5.0}, "master_id": 821, "global_id": 820, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 821, "spawn_sec": 167}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 17, "source": "local", "count": 37, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "attack_speed": 60, "attack_wait": 10, "attack_interval": 141, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106528, "race_id": 7, "master_id": 822, "global_id": 821, "spawn_sec": 167}, {"enemy_id": 18, "source": "local", "count": 15, "form_count": 1, "hp": 45000, "attack": 1500, "base_hp": 45000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 6000, "magic_defense": 20, "attack_speed": 60, "attack_wait": 60, "attack_interval": 228, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2119360, "race_id": 7, "master_id": 33060, "global_id": 6677, "spawn_sec": 210}], "popups": ["怪物化したスカーは攻撃を行うたび、\n攻撃力がアップしていきます。\n\n３回目の攻撃後、\n攻撃力が最大になります。\n※４回目以降の攻撃力が最大"], "dialogue": [{"trigger": "start", "lines": [{"name": "リバン", "text": "――王子様、こちらですわ！\nこの先に、バハムトを封印した海溝神殿がありますの！", "face": "u1062a1"}, {"name": "レアン", "text": "か、海溝だって……？\nもっと深い場所へ向かうのか？", "face": "u50"}, {"name": "リバン", "text": "えぇ、バハムトが解き放たれないように、\nクラールフ様は最も深い海溝に\n封印のための神殿を築いたんですのよ。", "face": "u1062a1"}, {"name": "リーンベル", "text": "神獣バハムトか……。\nまさか本当に実在するとはな。\n船乗りたちの与太話だとばかり思っていたぞ。", "face": "u268"}, {"name": "ジョヴァンニ", "text": "与太話だって何かきっかけがあるもんだろ？\nまぁ、バハムトの正体は\nせいぜい巨大魚か何かだと思ってたけどよ。", "face": "u123"}, {"name": "デューオ", "text": "その正体が神獣――千年戦争で\n使われた、天界の兵器だったなんてね。\n海洋ロマンが突然台無しになっちゃったよ。", "face": "u594"}, {"name": "リーンベル", "text": "海にロマンを求めるとは、海賊らしいな。\n海軍を預かる者としては、\n眼下に神獣が眠っているなんて考えたくもないぞ。", "face": "u268"}, {"name": "デューオ", "text": "よく言うよ、枕元に海洋冒険小説置いてるくせに♪\nでも伝説とのご対面は御免だし、\nしっかり封印を守り抜かなきゃね。", "face": "u594"}, {"name": "ベアトリカ", "text": "ははっ、まったくそのとおりだ。\n――ん、どうしたアクアマリー。\n何か見えたのか？", "face": "u157"}, {"name": "アクアマリー", "text": "あっ……いえ、何だか水が\nざわついているような気がして……。", "face": "u659"}, {"name": "セノーテ", "text": "水が……？　ほ、ほんとですっ。\n水霊たちも騒がしくて――これは……。\n誰かが近くで戦っているみたいです！", "face": "u502"}, {"name": "？？？", "text": "くっ……目を覚ますのだ、スカー！\nシャークギルマンは最強だと言っていただろう！", "face": "u1122a1"}, {"name": "スカー", "text": "ぐっ……グァァアッ、止まれッ、\n止まりやがれェッ！！\nオレサマのッ、体を返しやがれェェェッ！！", "face": "lbef1b7dcbed7"}, {"name": "リバン", "text": "た、戦っているのは……。\n衛兵のオーベッドさんと、スカーさん！？", "face": "u1062a1"}, {"name": "オーベッド", "text": "その声……海巫女見習い殿か！\nそれに溺れる民の――いや、乾いた地の王子も！", "face": "u1122a1"}, {"name": "オーベッド", "text": "頼む、こいつを止めてくれ！\nギガエルによって操られているのだ！！", "face": "u1122a1"}, {"name": "リバン", "text": "お、王子様！　力をお貸しください！\nスカーさんは乱暴者ですけど、\n操られるなんて可哀想すぎますわ！", "face": "u1062a1"}]}, {"trigger": "end", "lines": [{"name": "スカー", "text": "クソッ……身体が動かねェ……！\nおい王子ィ！　オレサマをっ、殺せェ……！！\nこんな惨めな姿ッ、テメェに見せたくねェんだよォ！", "face": "lbef1b7dcbed7"}, {"name": "レーヴ", "text": "この魔力、ただの精神支配じゃないですね……。\nもしや、神や亜神が用いるという、\n「怪物化」なのでは……？", "face": "u454"}, {"name": "スカー", "text": "セーシンシハイとか、カイブツカとか知るかァ！！\n王子ッ、オレサマが自分を抑えている間にッ、早くッ！", "face": "lbef1b7dcbed7"}, {"name": "王子", "text": "…………（ふるふる）", "face": "u1"}, {"name": "スカー", "text": "テメェ！！　オレサマに\n慈悲でもかけてるつもりかァ！？", "face": "lbef1b7dcbed7"}, {"name": "スカー", "text": "チクショウ……もうだめだ……ッ！\nオレサマの……意識が……。", "face": "lbef1b7dcbed7"}, {"name": "オーベッド", "text": "スカー……必ずその支配、我らが解いてやろう。", "face": "u1122a1"}, {"name": "スカー", "text": "ケッ……クラールフのクソ野郎の衛兵が……。\nそんな大口叩いてんじゃねェよ……。", "face": "lbef1b7dcbed7"}, {"name": "スカー", "text": "…………。", "face": "lbef1b7dcbed7"}, {"name": "セノーテ", "text": "……スカーさんの気配が、急速に遠ざかっていきます。\nおそらく海溝神殿へ向かったのではないかと。", "face": "u502"}, {"name": "アンナ", "text": "王子、私たちも海溝の底へ急ぎましょう。\nバハムトの封印を守らなくてはなりません。"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}]}, {"trigger": "route", "lines": [{"name": "スカー", "text": "シャァァァァァック！！\nチクショウッ、すまねェ王子ィ！！\nオレサマのイカリがッ、止まらねェんだッ！！", "face": "lbef1b7dcbed7"}, {"name": "オーベッド", "text": "王子殿、スカーは攻撃を重ねる度に\nその力を増していく戦士だ！\n攻撃を受け続けないように気をつけろ！", "face": "u1122a1"}]}], "hard": {"level": 140, "multiplier": 1.4, "modifiers": [{"kind": "term", "influence": 13, "params": [50]}, {"kind": "term", "influence": 34, "params": [0, 10, 30], "ext": "攻撃待ち増加=45,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "hp": 56000, "attack": 1200, "damage_type": "physical", "armor_defense": 700, "magic_defense": 5, "pattern_id": 2124432}, {"enemy_id": 1, "form_index": 1, "hp": 56000, "attack": 1800, "damage_type": "physical", "armor_defense": 700, "magic_defense": 5, "pattern_id": 2124432}, {"enemy_id": 1, "form_index": 2, "hp": 56000, "attack": 2700, "damage_type": "physical", "armor_defense": 700, "magic_defense": 5, "pattern_id": 2124432}, {"enemy_id": 4, "hp": 350000, "attack": 6300, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "pattern_id": 2126448}, {"enemy_id": 4, "form_index": 1, "hp": 350000, "attack": 9450, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "pattern_id": 2126448}, {"enemy_id": 4, "form_index": 2, "hp": 350000, "attack": 14175, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "pattern_id": 2126448}, {"enemy_id": 4, "form_index": 3, "hp": 350000, "attack": 21262, "damage_type": "physical", "armor_defense": 5250, "magic_defense": 50, "pattern_id": 2126448}, {"enemy_id": 12, "hp": 8400, "attack": 700, "damage_type": "physical", "armor_defense": 100, "magic_defense": 30, "pattern_id": 2123616}, {"enemy_id": 13, "hp": 49000, "attack": 800, "damage_type": "magical", "armor_defense": 50, "magic_defense": 10, "pattern_id": 2124384}, {"enemy_id": 14, "hp": 21000, "attack": 800, "damage_type": "magical", "armor_defense": 300, "magic_defense": 50, "pattern_id": 2124416}, {"enemy_id": 15, "hp": 7350, "attack": 750, "damage_type": "physical", "armor_defense": 150, "magic_defense": 35, "pattern_id": 2123792}, {"enemy_id": 16, "hp": 8400, "attack": 1500, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106544}, {"enemy_id": 16, "form_index": 1, "hp": 8400, "attack": 840, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 17, "hp": 8400, "attack": 840, "damage_type": "physical", "armor_defense": 200, "magic_defense": 35, "pattern_id": 2106528}, {"enemy_id": 18, "hp": 63000, "attack": 2100, "damage_type": "physical", "armor_defense": 6000, "magic_defense": 20, "pattern_id": 2119360}]}, "active": true}