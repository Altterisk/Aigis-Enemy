50, "attack_speed": 50, "attack_wait": 30, "attack_interval": 165, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "master_id": 185, "global_id": 184, "spawn_sec": 87}, {"enemy_id": 5, "source": "local", "count": 2, "form_count": 1, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 184, "global_id": 183, "ranged": true, "spawn_sec": 88}, {"enemy_id": 6, "source": "local", "count": 1, "form_count": 2, "tags": ["精霊(氷)"], "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "magical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 33, "attack_interval": 110, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115552, "change_to": 6, "change_condition": 5, "master_id": 31223, "global_id": 4842, "to_condition": 5, "to_global_id": 4843, "spawn_sec": 178}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["精霊(氷)"], "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "magical", "armor_defense": 50, "attack_range": 330, "attack_speed": 1, "attack_wait": 33, "attack_interval": 109, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115552, "missile_id": 296, "missile": {"speed": 8.0}, "master_id": 31224, "global_id": 4843, "ranged": true, "from_condition": 5}], "popups": ["　　　悪天候：吹雪\n\n・敵の『移動速度』減少\n・敵味方の『射程』減少\n・一部の味方の性能上昇\n・一部の敵味方は影響を受けない\n・影響を受けない敵の『攻撃力』上昇", "アイスエレメンタルの\nHPを減らすと、\n遠距離攻撃をしてきます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "無事に魔物退治も終わりましたね。\n天候が崩れ『吹雪』になりそうです。\n早く下山しましょう。", "face": "l3c8adb38acab"}, {"name": "？？？", "text": "――だ……だめぇっ！", "face": "u667"}, {"name": "クルル", "text": "ん？　あの女の子どうしたんだろう？", "face": "u197"}, {"name": "？？？", "text": "そ、そっち行っちゃだめ！\nな……なんで言うこと聞いてくれないの？", "face": "u667"}, {"name": "クルル", "text": "女の子が止めようとしてるアレって、\n――アイスエレメンタル！？", "face": "u197"}, {"name": "アンナ", "text": "クルルさん、ご存じなのですか？", "face": "l3c8adb38acab"}, {"name": "クルル", "text": "一応、雪国出身だからね。\n自然に宿るエネルギーが異常に集まると、\nあんな風に具現化しちゃうの。", "face": "u197"}, {"name": "クルル", "text": "本来ならこっちから手を出さなきゃ、\n危険な存在ではないんだけど……。", "face": "u197"}, {"name": "？？？", "text": "お願い、言う事聞いて……きゃあッ！", "face": "u667"}, {"name": "アンナ", "text": "でも、このままでは彼女が……っ！\nクルルさん、何か対策はありませんか？", "face": "l3c8adb38acab"}, {"name": "クルル", "text": "どうやら、あのアイスエレメンタルは、\n暴走しちゃってるみたいね。\n自然の力は制御が難しいものだから……。", "face": "u197"}, {"name": "クルル", "text": "それに、暴走のせいか、\nアイスエレメンタルの動きが不安定みたい。\n足止め出来る人で早く取り押さえた方がいいかも。", "face": "u197"}, {"name": "アンナ", "text": "王子。クルルさんの助言通り、\nここは迅速かつ慎重に事を運びましょう！", "face": "l3c8adb38acab"}]}, {"trigger": "end", "lines": [{"name": "ユキヒメ", "text": "……ありがとう、助けてくれて。\n私の名前はユキヒメ。\nあの、迷惑かけて……ごめんなさい。", "face": "u667"}, {"name": "クルル", "text": "いいよ、気にしないで！\nそれにしても……なんでこんな雪山に一人でいたの？", "face": "u197"}, {"name": "クルル", "text": "ここ、村や人里から結構離れてるし、\n魔物ぐらいしかうろつかないのに。", "face": "u197"}, {"name": "ユキヒメ", "text": "……………………。", "face": "u667"}, {"name": "ユキヒメ", "text": "ごめんなさい。私、記憶がなくて……、\nなんでここにいるのかも、よく分かってないの。", "face": "u667"}, {"name": "ユキヒメ", "text": "あの……あなた達は……？", "face": "u667"}, {"name": "アンナ", "text": "私たちは王子と共に、魔物などの脅威から、\n人々を守るために戦っている者です。"}, {"name": "ユキヒメ", "text": "そうなんだ……どこかで、聞いた覚えが……。", "face": "u667"}, {"name": "ユキヒメ", "text": "――うぅん、今はそれより、\n他のアイスエレメンタル達を探さなきゃ……。", "face": "u667"}, {"name": "アンナ", "text": "お一人で大丈夫ですか……？"}, {"name": "ユキヒメ", "text": "うん……あの、このお礼、いつかちゃんと返すから。\nだから、また会えた時はよろしく……ね？", "face": "u667"}]}], "active": true}