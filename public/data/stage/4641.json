 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "master_id": 605, "global_id": 604, "from_condition": 5}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 3, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "change_to": 6, "master_id": 844, "global_id": 843, "to_global_id": 603, "route_behaviour": {"transforms": [{"wait": 30}]}, "spawn_sec": 154}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 220.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105152, "race_id": 14, "change_to": 7, "change_condition": 5, "master_id": 604, "global_id": 603, "to_condition": 5, "to_global_id": 604}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 10000, "attack": 700, "base_hp": 10000, "base_attack": 700, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 20, "attack_wait": 30, "attack_interval": 116, "move_speed": 2500.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105168, "race_id": 14, "master_id": 605, "global_id": 604, "from_condition": 5}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 3, "hp": 13000, "attack": 950, "base_hp": 13000, "base_attack": 950, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 179, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106624, "race_id": 16, "special_effect_id": 222, "change_to": 10, "master_id": 850, "global_id": 849, "to_global_id": 850, "route_behaviour": {"transforms": [{"wait": 1160}]}, "spawn_sec": 166}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 13000, "attack": 950, "base_hp": 13000, "base_attack": 950, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 179, "move_speed": 220.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2106608, "race_id": 16, "special_effect_id": 222, "change_to": 11, "change_condition": 5, "master_id": 851, "global_id": 850, "to_condition": 5, "to_global_id": 851}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 13000, "attack": 950, "base_hp": 13000, "base_attack": 950, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 70, "attack_wait": 40, "attack_interval": 179, "move_speed": 2500.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2106624, "race_id": 16, "special_effect_id": 222, "master_id": 852, "global_id": 851, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "メイリン", "text": "父様、メイリンいっぱい頑張ったよ！\n王子を倒す為の準備の時間は\nちゃんと稼げたよね？", "face": "u380"}, {"name": "妖虎仙", "text": "ふむ……良くやってくれたのう。\n最後の最後でわしに報いたな、メイリン。", "face": "l35e2fc1739a2"}, {"name": "妖虎仙", "text": "……機、いよいよ熟せり……。\n我が妖術の奥義……使うは今ぞッ！\nはぁぁぁアアアッッッ――！", "face": "l35e2fc1739a2"}, {"name": "屍解仙", "text": "ほぉ……考えたのぅ妖虎仙。\nまさか世上の妖気を集約させ己が気とするとはな。\n諸刃の秘術を使うという事は奴も必死という訳か。", "face": "lac467bfee065"}, {"name": "屍解仙", "text": "（カッカッカ……それで良い、邪仙郷の異端、\n妖虎仙。貴様には随分と手を焼かされたからのぅ。\n邪仙郷の為にも貴様はここで死ぬべきなのじゃ）", "face": "lac467bfee065"}, {"name": "屍解仙", "text": "（それに、もし妖虎仙が王子を倒したとて、\n我が助力の果と報じ、己が功とすればいいだけ。\n無論、共倒れとなれば言うことはないのじゃが……）", "face": "lac467bfee065"}, {"name": "メイリン", "text": "屍解仙……なんで笑ってるのさ！？\n父様にとってこれは大事な戦いなんだよ！", "face": "u380"}, {"name": "屍解仙", "text": "これは礼を失したのぅ……。\nなぁに、妖虎仙の力の強大さに感嘆したのじゃよ。\n……と、見よ虎姫。どうやら王子が来たようじゃぞ？", "face": "lac467bfee065"}, {"name": "アンナ", "text": "王子、ご覧下さい！\n妖虎仙の姿があります！\nどうやらここが本拠地のようですね……。", "face": "l2e51ace5ef66"}, {"name": "妖虎仙", "text": "待っておったぞ、王子。\n今日こそ貴様の命を貰い受けるとしよう。", "face": "l35e2fc1739a2"}, {"name": "メイリン", "text": "父様！　わたしも一緒に戦うからね！\nメイリンのほんとのほんとの本気を\n今こそ見せてあげるんだからーッ！！", "face": "u380"}, {"name": "アンナ", "text": "どちらからも、凄まじい気迫を感じます……。\n王子、ここで全ての決着をつけましょう。\n戦いのご準備をお願い致します！", "face": "l2e51ace5ef66"}]}, {"trigger": "end", "lines": [{"name": "妖虎仙", "text": "――ぐァッ……はぁ、はぁ……。\nこ、これでも勝てぬとは……王子め……。\nその覇気……真の英雄であったか……。", "face": "l35e2fc1739a2"}, {"name": "アンナ", "text": "妖虎仙が膝をついた……！？\n王子、トドメをさすのは今しかありません！", "face": "l2e51ace5ef66"}, {"name": "メイリン", "text": "……ま、待ってよ！\n父様にはもう戦う力なんて無いんだ……。\nお願いだから命までは取らないで！", "face": "u380"}, {"name": "マオ", "text": "勝手なことを……！　キョンシーを街に放ち、\n人々の安寧を踏みにじった妖虎仙を、\n私たちが許すと思っているのですか！？", "face": "u361"}, {"name": "メイリン", "text": "それは違うよ！\nキョンシーを操っているのは父様じゃない！\n街を襲ってボロボロにしたのは屍解仙だよ！", "face": "u380"}, {"name": "屍解仙", "text": "――カッカッカ……妖虎仙よ。\nしつけを誤ったのぅ。\n虎姫めが全てをばらしてしまいよったか。", "face": "lac467bfee065"}, {"name": "屍解仙", "text": "それにしても、まさか、\nぬしの最高の秘術でも敗れるとはのぅ。\nさて、この機を待っておったぞ……死ねぃッ――！！", "face": "lac467bfee065"}, {"name": "妖虎仙", "text": "……ぐ、うぅ……し、屍解仙め……。\nこれが貴様の……邪仙郷の奴らのねらい、か……。\nめ、メイリン……にげろ……おまえ、だけ、は……。", "face": "l35e2fc1739a2"}, {"name": "メイリン", "text": "父様……？　父様ぁぁ――ッ！！", "face": "u380"}, {"name": "屍解仙", "text": "カッカッカ……！\nこれで目の上のたんこぶだった妖虎仙も消えたし、\n邪仙郷の連中に良き報告でもしにいくかのぅ。", "face": "lac467bfee065"}, {"name": "メイリン", "text": "ま、待て屍解仙……！？　逃げるなー！\nくそ……どこに消えたのよ……どこに……。\n絶対に……絶対に父様の仇をとってやる！", "face": "u380"}, {"name": "ケイティ", "text": "…………ま、まさか、\n私達が街に来る前に出会っていた\nあのお爺さんが邪仙郷の一人だったなんて……。", "face": "u114"}, {"name": "マオ", "text": "街にキョンシーを放ち、あまつさえ、\n仲間である妖虎仙まで殺すなんて……、\n信じられません……。", "face": "u361"}, {"name": "アンナ", "text": "妖虎仙が殺された今、メイリンさんを\nこのまま放っておくことはできませんね……。\n彼女が落ち着くまで、私達で保護しましょう。", "face": "l2e51ace5ef66"}, {"name": "メイリン", "text": "…………父様。", "face": "u380"}]}], "active": true}