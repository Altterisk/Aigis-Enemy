transform_resist": 100, "pattern_id": 2124336, "special_effect_id": 510, "change_to": 10, "change_condition": 2, "master_id": 32735, "global_id": 6353, "to_condition": 2, "to_global_id": 6354, "spawn_sec": 182}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["アーマー", "神聖騎士団", "アンデッド"], "hp": 100000, "attack": 1000, "base_hp": 100000, "base_attack": 1000, "damage_type": "magical", "armor_defense": 10000, "magic_defense": 90, "attack_speed": 1, "attack_wait": 120, "attack_interval": 292, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2124352, "special_effect_id": 562, "master_id": 32736, "global_id": 6354, "from_condition": 2}, {"enemy_id": 12, "source": "local", "count": 1, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 620, "base_hp": 18000, "base_attack": 620, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126864, "race_id": 20, "change_to": 12, "master_id": 33340, "global_id": 6957, "to_global_id": 6958, "route_behaviour": {"transforms": [{}]}, "spawn_sec": 238}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 1860, "base_hp": 18000, "base_attack": 1860, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 103, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126880, "race_id": 20, "change_to": 13, "change_condition": 4, "master_id": 33341, "global_id": 6958, "to_condition": 4, "to_ticks": 1, "to_global_id": 6959}, {"enemy_id": 12, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "tags": ["アーマー"], "hp": 18000, "attack": 620, "base_hp": 18000, "base_attack": 620, "damage_type": "physical", "armor_defense": 620, "magic_defense": 20, "attack_speed": 70, "attack_wait": 10, "attack_interval": 119, "move_speed": 1700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2126864, "race_id": 20, "master_id": 33342, "global_id": 6959, "from_condition": 4, "trigger_ticks": 1}], "popups": ["白い鎧の神聖騎士は、\n戦場にいる神聖騎士の総数に応じて\n攻撃力と防御力がアップします。", "ドゥマルデがいる間\n全ての敵のHPが徐々に回復します。", "ホワイトクルセイダーは倒されると、\nその場で復活します。\n\n復活後、ホワイトクルセイダーは\n強くなりますが、HPが徐々に減少し\nいずれ自滅します。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ドゥマルデ", "text": "――なるほど、邪神アイギスの神殿破壊こそが、\n主の思し召しだというのですね？", "face": "u1266a1"}, {"name": "天槍騎兵長", "text": "そのとおりだ。\n主は汝らが聖なる行いに、とても喜んでおられる。", "face": "l2644ec5e215f"}, {"name": "ドゥマルデ", "text": "…………承知しました。\nしかし神殿内部には、邪神アイギスの神官に騙された、\n一般の信徒がいるやもしれません。", "face": "u1266a1"}, {"name": "ドゥマルデ", "text": "神殿破壊の前に、ほんのひとときで構いません。\n罪なき邪教の被害者たちを\n捜索する時間をいただけないでしょうか。", "face": "u1266a1"}, {"name": "スルーズ", "text": "そ、そうですよね。\n戦うべきは戦士の役割、市民に被害を出すわけには――", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "――異端審問官が何を言っている。\n邪教徒とは戦士のことを指すのか？\n邪神を信じる者は、全て浄化の対象である。", "face": "l2644ec5e215f"}, {"name": "ドゥマルデ", "text": "……なるほど、確かにそのとおり。\nではせめて、我らが主に祈りを捧げる時間を。", "face": "u1266a1"}, {"name": "天槍騎兵長", "text": "ちっ……良いだろう、好きに祈るがいい。", "face": "l2644ec5e215f"}, {"name": "ドゥマルデ", "text": "（……主の御使い、か。怪しいものだ。\nあるいは真に御使いだったとしても、\nこんな蛮行を許す者が我らの神だったというのか？）", "face": "u1266a1"}, {"name": "ドゥマルデ", "text": "（だが、敵も一枚岩ではないということか。\nスルーズなる娘は、まだ話が通じるかもしれん）", "face": "u1266a1"}, {"name": "天槍騎兵長", "text": "おい、いつまで祈っている！\n戦士ならば戦場でこそ信仰を示せ！", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "だ、だめです姉さま！\n祈りの時間は等しく与えられるべき。\nそれが異教の神に対してであってもです！", "face": "u1143a1"}, {"name": "ドゥマルデ", "text": "（……時間稼ぎを、手伝ってくれたのか？\n真意はわからないがありがたい。\n――軍馬の蹄の音が、そこまで迫っているからな）", "face": "u1266a1"}, {"name": "テティス", "text": "――神聖騎士団、及び天槍騎兵団を確認！\nアイギス神殿は無事みたいですよ！", "face": "u37"}, {"name": "スルーズ", "text": "ね、姉さま！　王国軍です！\n神殿より先に、王国軍に対処しましょう！", "face": "u1143a1"}, {"name": "天槍騎兵長", "text": "……信仰の拠り所を砕けば、\nより深い絶望を与えられるかと思ったが……。", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "まぁ良い、まだ作戦は残っている。\nここは連中の相手をしてやろうか。", "face": "l2644ec5e215f"}]}, {"trigger": "end", "lines": [{"name": "天槍騎兵長", "text": "これは……王国軍本隊か。\nようやく本気を出し始めたな。", "face": "l2644ec5e215f"}, {"name": "天槍騎兵長", "text": "スルーズ、最後の作戦を実行する。\n私は先に出立し、例の村を制圧しておく。\nお前は後続の天界兵と共に合流しろ。", "face": "l2644ec5e215f"}, {"name": "スルーズ", "text": "……はい、姉さま。", "face": "u1143a1"}, {"name": "ドゥマルデ", "text": "……やれやれ、助かった。\n礼を言うべきかね、スルーズお嬢さん。", "face": "u1266a1"}, {"name": "スルーズ", "text": "……あなたが時間稼ぎをしてくれたおかげです。\n姉さまは、本当はあんなことをする人ではないんです。\nだから、どうにかこの凶行を止めてあげないと……。", "face": "u1143a1"}, {"name": "ドゥマルデ", "text": "どこも悩みは同じだな。\nここから先、力になってやることはできないが――", "face": "u1266a1"}, {"name": "スルーズ", "text": "――いえ、ここまでのご助力感謝します。\nあなたに、神滅の槍担う、\n我らが父さまの加護があらんことを。", "face": "u1143a1"}, {"name": "ドゥマルデ", "text": "貴女に、雷担う我らが主の加護があらんことを。\n……今の神聖騎士団は、助けにはなれない。\nこの場で唯一、貴女に手を差し伸べられるのは――", "face": "u1266a1"}, {"name": "クリッサ", "text": "――私たちだけ。\nようやく話せたね、スルーズ。", "face": "u52"}, {"name": "スルーズ", "text": "……王国の、ワルキューレ。\nぐすっ……もう、私は、\nどうしたらいいのか分からなくて……っ！", "face": "u1143a1"}, {"name": "クリッサ", "text": "大丈夫、泣かないで。\nあなたたちを泣かせないために、追ってきたんだから。", "face": "u52"}, {"name": "テティス", "text": "可愛い女の子には、やっぱり笑顔が似合いますから。\nさぁ、一緒にお姉さんを止めに行きましょう？", "face": "u37"}, {"name": "スルーズ", "text": "一緒に……私が、姉さまを止める……？", "face": "u1143a1"}, {"name": "エミリア", "text": "操られた仲間と仲良しごっこをするのが戦乙女か？\n――違うはずだ。\n戦う力があるなら、彼女らを止めることもできるだろう。", "face": "u207"}, {"name": "クリッサ", "text": "……大丈夫。\n私たちを、信じて。", "face": "u52"}, {"name": "スルーズ", "text": "……はいっ！", "face": "u1143a1"}]}], "story_talk": true, "active": true}