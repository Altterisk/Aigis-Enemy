{"quest_id": 7233, "name": "幾ばくの祈り", "description": "神聖騎士団と天槍騎兵団から神殿を守れ！\n＜味方のエルフ、ドワーフの\n　攻撃力、防御力が70％ダウン＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["味方のエルフ、ドワーフの\n　攻撃力、防御力が70％ダウン"], "event": "戸惑いの戦乙女", "event_category": "History", "mission_id": 920155, "map_no": 5860, "level": 100, "multiplier": 1.0, "charisma": 65, "capacity": 8, "modifiers": [{"kind": "term", "influence": 14, "params": [30], "expression": "( IsRace(\"エルフ\")  || IsRace(\"ドワーフ\")) == 1;", "expression_human": "(its race is [[tag:エルフ]] or its race is [[tag:ドワーフ]])"}, {"kind": "term", "influence": 13, "params": [30], "expression": "( IsRace(\"エルフ\")  || IsRace(\"ドワーフ\")) == 1;", "expression_human": "(its race is [[tag:エルフ]] or its race is [[tag:ドワーフ]])"}], "enemies": [{"enemy_id": 1, "source": "local", "count": 25, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 4000, "attack": 300, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 1500, "attack_speed": 70, "attack_wait": 10, "attack_interval": 167, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2122400, "special_effect_id": 510, "master_id": 32496, "global_id": 6115, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 7, "form_count": 1, "tags": ["アーマー", "神聖騎士団"], "hp": 2500, "attack": 280, "base_hp": 2500, "base_attack": 280, "damage_type": "physical", "armor_defense": 700, "attack_range": 150, "attack_speed": 1, "attack_wait": 60, "attack_interval": 186, "move_speed": 450.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2123488, "special_effect_id": 510, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 32645, "global_id": 6263, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 10, "form_count": 3, "tags": ["アーマー"], "hp": 2800, "attack": 280, "base_hp": 2800, "base_attack": 280, "damage_type": "physical", "armor_defen