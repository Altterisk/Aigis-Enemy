attack_interval": 105, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2106112, "race_id": 3, "special_effect_id": 42, "master_id": 771, "global_id": 770, "spawn_sec": 65}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 30000, "attack": 400, "base_hp": 30000, "base_attack": 400, "damage_type": "magical", "armor_defense": 350, "magic_defense": 70, "attack_range": 200, "attack_speed": 50, "attack_wait": 60, "attack_interval": 186, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098384, "race_id": 3, "change_to": 5, "change_condition": 1, "missile_id": 14, "missile": {"speed": 6.0, "splash": 147}, "master_id": 451, "global_id": 450, "ranged": true, "variants": [{"hp": 30000, "attack": 2000, "base_hp": 30000, "base_attack": 2000, "damage_type": "physical", "armor_defense": 350, "magic_defense": 70, "attack_speed": 50, "attack_wait": 20, "attack_interval": 141, "move_speed": 150.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2098400, "race_id": 3, "master_id": 452, "global_id": 451}], "spawn_sec": 110}, {"enemy_id": 7, "source": "local", "count": 7, "form_count": 1, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 500, "magic_defense": 70, "attack_speed": 55, "attack_wait": 10, "attack_interval": 146, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2108304, "race_id": 3, "master_id": 30018, "global_id": 3637, "spawn_sec": 112}, {"enemy_id": 8, "source": "local", "count": 10, "form_count": 1, "hp": 6000, "attack": 500, "base_hp": 6000, "base_attack": 500, "damage_type": "physical", "armor_defense": 150, "magic_defense": 50, "attack_speed": 55, "attack_wait": 10, "attack_interval": 142, "move_speed": 300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105952, "race_id": 3, "special_effect_id": 42, "master_id": 761, "global_id": 760, "spawn_sec": 119}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 10000, "attack": 1000, "base_hp": 10000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 150, "magic_defense": 60, "attack_range": 150, "attack_speed": 55, "attack_wait": 35, "attack_interval": 141, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2100352, "race_id": 3, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 242, "global_id": 241, "ranged": true, "spawn_sec": 139}, {"enemy_id": 10, "source": "local", "count": 2, "form_count": 1, "hp": 6000, "attack": 700, "base_hp": 6000, "base_attack": 700, "damage_type": "physical", "armor_defense": 350, "magic_defense": 60, "attack_range": 112, "attack_speed": 50, "attack_wait": 30, "attack_interval": 136, "move_speed": 300.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2106176, "race_id": 3, "special_effect_id": 234, "missile_id": 162, "missile": {"speed": 10.0}, "master_id": 786, "global_id": 785, "ranged": true, "spawn_sec": 199}], "popups": ["\n\n\n　 ――帝国領、辺境都市。"], "dialogue": [{"trigger": "start", "lines": [{"name": "帝国一般兵", "text": "――総督！　報告します！\n既に市街に魔王軍が侵入、\n各戦線共に突破されつつあります！", "face": "u287"}, {"name": "総督", "text": "致し方ありません。\n民を避難させたこの館周辺だけは、\n何があっても死守せねばなりません。", "face": "u917"}, {"name": "総督", "text": "各戦線の兵を後退させなさい！\n援軍が……援軍が必ず来るはずです！", "face": "u917"}, {"name": "？？？", "text": "――あーあ、頑張っちゃってるねー。\nただの威力偵察のつもりだったのに、\n人間ってこんなによわよわなんだねー？", "face": "u997"}, {"name": "？？？", "text": "こら、戦士を侮辱してはいけません。\n物質界の破壊によって死にゆく者たちなれど、\nその武には敬意を払わねば。", "face": "u941"}, {"name": "？？？", "text": "むむ、お姉ちゃんは堅物なんだからぁ。\nあーあ、つまんなーい。クロちゃんも、\n偵察じゃなくて侵攻しちゃえばいいのにねー。", "face": "u997"}, {"name": "？？？", "text": "クロコ様と呼びなさい。\n私達の上官にあたる方ですよ。", "face": "u941"}, {"name": "？？？", "text": "今や魔王軍は軍備、士気共に完全。\nしかし戦には読むべき時流というものがあるのです。\n好機を逃さぬためには敵を知ることも重要です。", "face": "u941"}, {"name": "？？？", "text": "はーい。\n――んっ？　お姉ちゃん、向こうに何か見えない？", "face": "u997"}, {"name": "？？？", "text": "あれは……。\nまさか王国軍……？\nこんな帝国辺境まで、いつの間に……！？", "face": "u941"}, {"name": "白の皇帝", "text": "――王子、準備は良いな。", "face": "u418"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "アンナ", "text": "合同演習の最中だったのが功を奏しましたね。\n帝国の飛空艇で、ここまで来ることができました。"}, {"name": "レオナ", "text": "本来は我ら帝国だけで対処すべき事態だ。\n……巻き込んでしまってすまないな。", "face": "u311"}, {"name": "ケイティ", "text": "いえ、私達はこれより、\n魔王軍に対抗するために共に戦うのですから。\nこれはその前哨戦とも言えるでしょう。", "face": "u114"}, {"name": "アンナ", "text": "そのとおりです。\n王子、既に市街には魔物が侵入しています。\n慎重な指揮をお願いします！", "face": "l2e0a5b9d2133"}]}, {"trigger": "end", "lines": [{"name": "？？？", "text": "……帝国と王国、ここまで練度を高めていましたか。", "face": "u941"}, {"name": "？？？", "text": "ねぇねぇお姉ちゃん！\nあたしあの王子で遊びたい！\n戦ってきていい？　いい？　いいでしょー？", "face": "u997"}, {"name": "？？？", "text": "……駄目です。すぐに兵を撤退させます。\nこれはあくまで威力偵察、\n雑兵はともかく、あなたを失うわけにはいきません。", "face": "u941"}, {"name": "？？？", "text": "むぅぅぅぅっ！　けちけち！\nそんなんじゃクロちゃんみたいになっちゃうぞー！", "face": "u997"}, {"name": "？？？", "text": "あのお方のようになれるなら光栄です。\nさぁ、急ぎますよ。", "face": "u941"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "……魔王軍、撤退していきます。\n市街に潜んでいた魔物も、現在兵が掃討中です。", "face": "l2e0a5b9d2133"}, {"name": "総督", "text": "……皇帝陛下、そして王子殿下、\n街を守ってくださったこと、感謝いたします。", "face": "u917"}, {"name": "総督", "text": "ですが陛下、私の不徳により\n街に甚大な被害を出してしまいました……。", "face": "u917"}, {"name": "総督", "text": "責任は全て私にあります。\n何卒、何卒兵たちには――", "face": "u917"}, {"name": "帝国一般兵", "text": "い、いけません！　総督は自ら民を守るべく、\n最前線に立っておられました！\n皇帝陛下、何卒寛大なお慈悲を……！！", "face": "u287"}, {"name": "総督", "text": "ば、ばかものっ！\n咎を受けるのは私ひとりで十分です！", "face": "u917"}, {"name": "白の皇帝", "text": "……何を勘違いしている。\nお前は民を守るために戦った、それで十分だ。", "face": "u418"}, {"name": "総督", "text": "へ、陛下……っ！！", "face": "u917"}, {"name": "白の皇帝", "text": "だが、お前に実力が足らなかったのも事実だ。\n……今後も精進しろ。", "face": "u418"}, {"name": "アンナ", "text": "……どうやら、これで一段落のようですね。\n王子、此度の魔物討伐、お疲れさまでした！"}]}], "story_talk": true, "active": true}