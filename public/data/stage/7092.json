nse": 30, "attack_range": 200, "attack_speed": 1, "attack_wait": 15, "attack_interval": 61, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123440, "race_id": 3, "special_effect_id": 121, "change_to": 1, "change_condition": 2, "missile_id": 6, "master_id": 32675, "global_id": 6293, "ranged": true, "from_condition": 2, "to_condition": 2, "to_global_id": 403}, {"enemy_id": 16, "source": "local", "count": 5, "form_count": 2, "hp": 12000, "base_hp": 12000, "damage_type": "physical", "armor_defense": 120, "magic_defense": 10, "attack_speed": 70, "attack_wait": 10, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123632, "race_id": 16, "special_effect_id": 484, "change_to": 1, "change_condition": 2, "master_id": 32676, "global_id": 6294, "to_condition": 2, "to_global_id": 403, "spawn_sec": 138}, {"enemy_id": 17, "source": "local", "count": 5, "form_count": 2, "hp": 13000, "attack": 380, "base_hp": 13000, "base_attack": 380, "damage_type": "physical", "armor_defense": 130, "attack_range": 150, "attack_speed": 70, "attack_wait": 5, "attack_interval": 56, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2099264, "race_id": 16, "special_effect_id": 235, "change_to": 1, "change_condition": 2, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 30556, "global_id": 4175, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 193}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 2, "hp": 20000, "attack": 1500, "base_hp": 20000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 1000, "attack_range": 160, "attack_speed": 1, "attack_wait": 35, "attack_interval": 109, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123504, "race_id": 16, "special_effect_id": 264, "change_to": 1, "change_condition": 2, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 32669, "global_id": 6287, "ranged": true, "to_condition": 2, "to_global_id": 403, "spawn_sec": 215}], "popups": ["メフィストに変身した\nドッペルゲンガーは倒されると、\nその場で復活します。\n\n５回倒されるまで\n変身は解けません。", "ナターリエに変身した\nドッペルゲンガーがいる間は、\n全ての敵ユニットの\n攻撃と防御がアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ディアナ", "text": "……夜の波音は、どうしてこんなに寂しいのでしょう。", "face": "u1034a1"}, {"name": "ナターリエ", "text": "……潮騒が呼び声に似ているからでしょうか。\n静かに、囁くように、想い人を呼ぶように、と。", "face": "u1037a1"}, {"name": "ディアナ", "text": "ふふっ、誰かの詩ですか？\n貴女が恋のうたとは珍しい。", "face": "u1034a1"}, {"name": "ナターリエ", "text": "いえ、私の素直な感想です。\nきっと騎士団長様は、\n誰かのことを想っているのだろうと。", "face": "u1037a1"}, {"name": "ディアナ", "text": "……おや、それはお互い様では？\n抱えているものが大きいと、\n中々素直にはなれないものですよね。", "face": "u1034a1"}, {"name": "メーア", "text": "――むぅぅぅぅ。\n花火大会でもしようかと思ったんですけど、\n何やら難しい話をしてるみたいですねぇ。", "face": "u1038a1"}, {"name": "メフィスト", "text": "ふふふふふ、夏の夜、\n皆が寝静まった後に花火大会だと？\nそれはイケナイ刺激に満ちているな。", "face": "u1036a1"}, {"name": "メフィスト", "text": "だが、今は花火大会よりも、\n向こうに見えるもうひとりの私たちの方が\nちょっとした非常事態だったりしないかな？", "face": "u1036a1"}]}, {"trigger": "start", "lines": [{"name": "ドッペルゲンガー", "text": "ククッ……王子たちが寝静まった頃を見計らい、\nこうして変身して襲撃する……。", "face": "lb8698d028eb0"}, {"name": "ドッペルゲンガー", "text": "すると連中は混乱状態となり、\n勝利は確実なものとなるのだ……。", "face": "lb8698d028eb0"}, {"name": "ドッペルゲンガー", "text": "嗚呼……何と完璧な作戦――って、\n貴様ら！　何故起きているんだ！！", "face": "lb8698d028eb0"}, {"name": "メーア", "text": "何故もなにも！　こんなロマンティックな夜に\n早く寝ちゃうほうがもったいないじゃないですかー！", "face": "u1038a1"}, {"name": "ナターリエ", "text": "そのとおり。\n夜とは詩に想いを綴る時なれば。\nさて、皆さんを起こしてきますね。", "face": "u1037a1"}, {"name": "ドッペルゲンガー", "text": "クゥゥ……っ！！\nだが、今回は切り札があるのだ。\n大いなるフェネクスの似姿に、恐れおののけぇ……！！", "face": "lb8698d028eb0"}]}, {"trigger": "end", "lines": [{"name": "ドッペルゲンガー", "text": "どうして……勝てない……のだ……。\nくそっ、撤退だ、撤退するぞ！", "face": "lb8698d028eb0"}, {"name": "ディアナ", "text": "せっかくの夜を台無しにするとは、\n風情の分からない魔物ですね。", "face": "u1034a1"}, {"name": "ナターリエ", "text": "まったくです。\nきっと恋をしたことがないのでしょうね。", "face": "u1037a1"}, {"name": "メーア", "text": "でも！　おかげで皆起きてきましたよ？\nさぁ花火です！　花火大会しましょー！", "face": "u1038a1"}, {"name": "メーア", "text": "さぁさぁ、王子殿下もぉ♪", "face": "u1038a1"}, {"name": "王子", "text": "…………（こくこく）", "face": "u1"}, {"name": "アンナ", "text": "まったく、王子まで……。\nあまり夜ふかししないように\n気をつけてくださいね？", "face": "la6fe304e5a2a"}]}], "active": true}