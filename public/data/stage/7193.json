{"quest_id": 7193, "name": "雪上の聖竜騎士", "description": "闇の組織を追う最中、魔物たちも現れ……。\nティファと協力して敵を倒せ！\n＜特定のタイミングで吹雪が発生＞\n上級（★１獲得の目安：平均Lv10）", "modifier_notes": ["特定のタイミングで吹雪が発生"], "event": "ホーリーナイト・マーダークラウン", "event_category": "History", "mission_id": 920153, "map_no": 5807, "level": 100, "multiplier": 1.0, "charisma": 50, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 5, "form_count": 1, "hp": 1200, "attack": 250, "base_hp": 1200, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_speed": 50, "attack_wait": 30, "attack_interval": 165, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099664, "master_id": 185, "global_id": 184, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 5, "form_count": 1, "hp": 1200, "attack": 200, "base_hp": 1200, "base_attack": 200, "damage_type": "magical", "armor_defense": 20, "attack_range": 120, "attack_speed": 30, "attack_wait": 50, "attack_interval": 171, "move_speed": 500.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099648, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 184, "global_id": 183, "ranged": true, "spawn_sec": 1}, {"enemy_id": 3, "source": "local", "count": 6, "form_count": 1, "hp": 4500, "attack": 130, "base_hp": 4500, "base_attack": 130, "damage_type": "physical", "armor_defense": 150, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1100.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2103520, "race_id": 16, "master_id": 453, "global_id": 452, "spawn_sec": 2}, {"enemy_id": 4, "source": "local", "count": 9, "form_count": 1, "hp": 2000, "attack": 130, "base_hp": 2000, "base_attack": 130, "damage_type": "physical", "armor_defense": 100, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097536, "race_id": 16, "master_id": 28, "global_id": 27, "spawn_sec": 6}, {"enemy_id": 5, "source": "local", "count": 13, "form_count": 1, "hp": 1800, "attack": 370, "base_hp": 1800, "base_attack": 370, "damage_type": "physical", "armor_defense": 130, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 77, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2101264, "race_id": 11, "master_id": 228, "global_id": 227, "spawn_sec": 29}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 2, "tags": ["ステルス"], "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103728, "race_id": 16, "special_effect_id": 61, "change_to": 6, "master_id": 472, "global_id": 471, "to_global_id": 472, "route_behaviour": {"transforms": [{"wait": 800}]}, "spawn_sec": 44}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2109104, "race_id": 16, "special_effect_id": 61, "change_to": 5, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 473, "global_id": 472, "ranged": true}, {"enemy_id": 8, "source": "local", "count": 8, "form_count": 1, "hp": 3200, "attack": 220, "base_hp": 3200, "base_attack": 220, "damage_type": "physical", "armor_defense": 40, "attack_speed": 60, "attack_wait": 10, "attack_interval": 162, "move_speed": 550.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097168, "race_id": 16, "master_id": 1, "spawn_sec": 49}, {"enemy_id": 9, "source": "local", "count": 2, "form_count": 2, "hp": 6000, "attack": 600, "base_hp": 6000, "base_attack": 600, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_speed": 5, "attack_wait": 25, "attack_interval": 106, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103536, "race_id": 16, "special_effect_id": 61, "change_to": 9, "master_id": 454, "global_id": 453, "to_global_id": 454, "route_behaviour": {"transforms": [{"wait": 600}]}, "spawn_sec": 103}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 6000, "attack": 400, "base_hp": 6000, "base_attack": 400, "damage_type": "physical", "armor_defense": 300, "magic_defense": 10, "attack_range": 180, "attack_speed": 90, "attack_wait": 60, "attack_interval": 211, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103552, "race_id": 16, "special_effect_id": 61, "change_to": 8, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 455, "global_id": 454, "ranged": true}], "dialogue": [{"trigger": "start", "lines": [{"name": "ティファ", "text": "――クリスマス破壊計画、ですか。", "face": "u1115a1"}, {"name": "アイリーン", "text": "末端の構成員に知らされていたのは、\nサンタからの贈り物を全て奪い、\nクリスマスの祝祭を台なしにする計画だけでした。", "face": "u315"}, {"name": "ティファ", "text": "確かに子どもたちはがっかりするでしょうが……。\nそのためだけに、\nこんな大規模な事件を起こすものでしょうか。", "face": "u1115a1"}, {"name": "サンタヘイオス", "text": "……フォーという男が、話に聞いたとおりなら、\nその行動原理を理解しようとは\n思わないほうが良さそうです。", "face": "u1116a1"}, {"name": "ティファ", "text": "……そういうものですか？", "face": "u1115a1"}, {"name": "サンタヘイオス", "text": "えぇ、戦場ではそういう者を\n数多く見てきましたから。", "face": "u1116a1"}, {"name": "サンタヘイオス", "text": "今は子どもたちのため、\n闇の組織の活動拠点を押さえ、\nサンタからの贈り物の奪取に全力をつくしましょう！", "face": "u1116a1"}, {"name": "セブン", "text": "へへっ、そうだな。\nガキの楽しみくらい守ってやらないと。", "face": "u449"}, {"name": "サンタヘイオス", "text": "その意気です！\n――とはいえ、その前に肩慣らしが必要そうですが。", "face": "u1116a1"}, {"name": "サンタヘイオス", "text": "王子、周囲に先程のアサシンの気配があります。\nそれに、騒ぎを聞きつけた魔物の呼吸音も。", "face": "u1116a1"}, {"name": "セブン", "text": "さすがは騎士さま、気配にも敏感か。\n王子、この辺りは任せたよ。\nあっちの森はアタシたちがやる。", "face": "u449"}, {"name": "ティファ", "text": "それではこちらは私が。\n王子さま、指揮をお願いしますね！", "face": "u1115a1"}]}, {"trigger": "end", "lines": [{"name": "セブン", "text": "片付いた、かな。よし、先へ進もう。\n闇の組織の拠点のひとつが、この先にあるらしい。", "face": "u449"}, {"name": "ティファ", "text": "闇の組織……まだ王国でも全容が掴めていませんが、\nいったいどういう集団なのですか？", "face": "u1115a1"}, {"name": "セブン", "text": "目下調査中、ってところかな……。\nもともとはアタシのいた\n闇ギルドの後釜だけど――", "face": "u449"}, {"name": "アイリーン", "text": "――荒くれ者の互助組織だった闇ギルドに対し、\n闇の組織は幹部連中の強権による、\n組織だった犯罪組織と化したと言えますね。", "face": "u315"}, {"name": "セブン", "text": "元闇ギルドの構成メンバーも、\n今じゃ随分と肩身が狭そうだしね。", "face": "u449"}, {"name": "シプリア", "text": "ふふ、そういう意味じゃ、\n闇ギルドの後継組織は王国の方かもしれないな。", "face": "u565"}, {"name": "サンタヘイオス", "text": "確かに、正規軍だけでなく、\n周辺地域の荒くれ者まで\nまとめてしまっていますからね。", "face": "u1116a1"}, {"name": "モーティマ", "text": "あったりまえだろ？\n王子と言ったら\nこの辺の山賊の頭みてぇなモンなんだからな。", "face": "u14"}, {"name": "サンタヘイオス", "text": "王子で英雄で山賊の頭……。\n王子殿下らしいというか何というか……。", "face": "u1116a1"}, {"name": "アイリーン", "text": "さて、そろそろお静かに。\nもう拠点が見えてくるはずですよ。", "face": "u315"}]}], "story_talk": true, "active": true}