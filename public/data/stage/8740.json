200, "base_hp": 3000, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 60, "attack_speed": 10, "attack_wait": 35, "attack_interval": 91, "move_speed": 1800.0, "gain_cost": 1, "dot_rate": 1.2000000476837158, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2162320, "race_id": 11, "special_effect_id": 229, "missile_id": 8, "missile": {"speed": 6.0}, "master_id": 38997, "global_id": 12614, "ranged": true, "spawn_sec": 109}], "dialogue": [{"trigger": "start", "lines": [{"name": "アヴリック", "text": "――あの注目選手の戦い、再び！\n準決勝を戦うのは……こいつらだー！", "face": "u2443a1"}, {"name": "アヴリック", "text": "銀狼の里、次期族長候補！\n可愛い顔してあふれる魔力！　クルーナ！！", "face": "u2443a1"}, {"name": "クルーナ", "text": "全力でいくよー！！\n次期族長の実力、見せてあげるね！", "face": "u2613a1"}, {"name": "アヴリック", "text": "そして……おや？\n次の選手が遅れている様子……？", "face": "u2443a1"}, {"name": "マータン", "text": "あれ？　うちの族長、\nさっき旅から戻ってきたはず……？", "face": "u2524a1"}, {"name": "？？？", "text": "――ちょっとこれ借りるよ。", "face": "lb8f1b0b33ba3"}, {"name": "アヴリック", "text": "えっ、あっ、私の魔導マイクー！", "face": "u2443a1"}, {"name": "？？？", "text": "『あーあー。聞こえるかい？\n王子っ！　うちの可愛いファオルをたぶらかした男ッ！』", "face": "lb8f1b0b33ba3"}, {"name": "ファオル", "text": "えっ、えっ、な、何言ってるの族長ー！？", "face": "u2513a1"}, {"name": "？？？", "text": "『オレとクルーナに、\nお前の本当の実力ってやつを見せてもらう！』", "face": "lb8f1b0b33ba3"}, {"name": "クルーナ", "text": "みせてもらう！", "face": "u2613a1"}, {"name": "？？？", "text": "『その結果次第じゃ、ファオルは嫁にやらない！\nお前が雪枝の里に、婿に来いッ！！』", "face": "lb8f1b0b33ba3"}, {"name": "クルーナ", "text": "婿にこい！", "face": "u2613a1"}, {"name": "オヴィー", "text": "『よし、言いたいことは言った！\n我が名はオヴィー！　勇猛なるジャコウウシの血族！』", "face": "lb8f1b0b33ba3"}, {"name": "オヴィー", "text": "『『『行くぞ、野郎どもッッッッ！！』』』", "face": "lb8f1b0b33ba3"}, {"name": "アヴリック", "text": "耳がきーんってするぅぅぅぅぅっ！", "face": "u2443a1"}, {"name": "王子", "text": "…………（わくわく）", "face": "u1"}, {"name": "クルーナ", "text": "すごい、あの人怯えるどころかわくわくしてる！", "face": "u2613a1"}, {"name": "オヴィー", "text": "それくらいじゃないとな。\n三百年ぶりの雪原王だ、吹雪すら平らげる、\n無敵の戦士じゃないと務まらないよ。", "face": "lb8f1b0b33ba3"}, {"name": "クルーナ", "text": "……わたしも頑張る！", "face": "u2613a1"}, {"name": "オヴィー", "text": "ああ、銀狼の里、次期族長の実力を見せてやりな！", "face": "lb8f1b0b33ba3"}]}, {"trigger": "end", "lines": [{"name": "クルーナ", "text": "…………（きらきら）", "face": "u2613a1"}, {"name": "オヴィー", "text": "やれやれ、南の大地にも\nこんな戦士がいたとはねぇ。", "face": "lb8f1b0b33ba3"}, {"name": "クルーナ", "text": "ししょぉ……！", "face": "u2613a1"}, {"name": "オヴィー", "text": "ん、どうしたんだいクルーナ？", "face": "lb8f1b0b33ba3"}, {"name": "クルーナ", "text": "わたし、あの人に弟子入りする！", "face": "u2613a1"}, {"name": "オヴィー", "text": "あははっ！　そいつはいい。\n族長修行の仕上げは、南の大地の武者修行か！", "face": "lb8f1b0b33ba3"}, {"name": "オヴィー", "text": "そういうわけだ。\n雪枝の里と銀狼の里は、王子を雪原王と認めるよ！", "face": "lb8f1b0b33ba3"}, {"name": "セイウチの族長", "text": "……三百年前も、こんな感じだったのかねぇ。", "face": "lc67f09778af3"}, {"name": "ユキヒツジの族長", "text": "きっとそうだメー。\n狭間の雪原に迫る危機、雪原王と共に乗り越えるメー。", "face": "l4bb9b565c5f2"}, {"name": "クルーナ", "text": "あとは決勝戦だね！\n勝ち残っているのは王子と……。", "face": "u2613a1"}, {"name": "セイウチの族長", "text": "おぉ、谷向こうの戦士たちか！\nこれは派手な試合になりそうだぜ！", "face": "lc67f09778af3"}, {"name": "アヴリック", "text": "それではさっそく、決勝戦を――", "face": "u2443a1"}, {"name": "フィノーラ", "text": "――ん、待てアヴリック。\n向こうから何かが走って……。", "face": "u2441a1"}, {"name": "獣人の騎士？", "text": "――おい、おいおいおいおいッ！！\n誰かを忘れちゃいねェか！？\nクソ弱ぇゴミどもがよぉぉぉぉッ！！", "face": "leebe82e6609b"}]}], "active": true}