{"quest_id": 4130, "name": "魔人の宿命：魔人の少女", "description": "怪しげな夜に現れた謎の少女。\n王子達に襲いかかる\n理由とは……。", "event": "魔人の宿命", "event_category": "History", "mission_id": 920026, "map_no": 3032, "level": 95, "multiplier": 0.95, "charisma": 15, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 15, "form_count": 1, "hp": 950, "attack": 142, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 2}, {"enemy_id": 2, "source": "local", "count": 1, "level": 90, "form_count": 1, "hp": 7600, "attack": 180, "base_hp": 8000, "base_attack": 180, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_range": 150, "attack_speed": 70, "attack_wait": 10, "attack_interval": 66, "move_speed": 700.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2099248, "race_id": 16, "special_effect_id": 234, "missile_id": 46, "missile": {"speed": 12.0, "deflectable": true}, "master_id": 205, "global_id": 204, "ranged": true, "spawn_sec": 33}], "dialogue": [{"trigger": "start", "lines": [{"name": "兵士", "text": "報告！\n魔物がこちらに向かってきている模様です！", "face": "l1d875abbd067"}, {"name": "アンナ", "text": "王子、迎撃しましょう！", "face": "l6ea8dc6744c1"}]}, {"trigger": "battle", "at_sec": 36, "lines": [{"name": "フラン", "text": "あれが王子……。丁度いい。", "face": "u183"}, {"name": "アンナ", "text": "あなたは一体……。\nあなたは普通の人間のように見えます。", "face": "l6ea8dc6744c1"}, {"name": "フラン", "text": "人間？\n……私は人間じゃない……！\n魔物の血と人間の血が流れる魔人だ。", "face": "u183"}, {"name": "アンナ", "text": "人間じゃない……？　魔物の血……？！\nどういう事ですか？　なぜ私たちを……。", "face": "l6ea8dc6744c1"}, {"name": "フラン", "text": "これ以上は時間の無駄だ。", "face": "u183"}]}, {"trigger": "end", "lines": [{"name": "フラン", "text": "やはり簡単にはいかないか。\nここは一旦引かせてもらう。", "face": "u183"}, {"name": "アンナ", "t