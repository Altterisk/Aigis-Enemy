 "attack_interval": 146, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2103904, "race_id": 18, "change_to": 4, "missile_id": 7, "missile": {"speed": 6.0, "splash": 133}, "master_id": 484, "global_id": 483, "ranged": true, "to_condition": 0, "to_global_id": 624, "spawn_sec": 54}, {"enemy_id": 4, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 2400, "attack": 300, "base_hp": 4000, "base_attack": 500, "damage_type": "magical", "armor_defense": 900, "magic_defense": 30, "attack_speed": 10, "attack_wait": 50, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.100000023841858, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105216, "race_id": 18, "change_to": 3, "master_id": 625, "global_id": 624, "from_condition": 0}, {"enemy_id": 6, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 384, "attack": 200, "base_hp": 640, "base_attack": 200, "damage_type": "physical", "attack_range": 140, "attack_speed": 70, "attack_wait": 60, "attack_interval": 171, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2098016, "race_id": 9, "missile_id": 9, "missile": {"speed": 3.0, "deflectable": true}, "master_id": 68, "global_id": 67, "ranged": true, "spawn_sec": 63}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "その浮遊石の鉱脈というのはこの先でしょうか？", "face": "l9be3de2707a5"}, {"name": "グスタフ", "text": "そうじゃ。大地の妖精といわれる\nわしらドワーフでも浮遊石の鉱脈を\n探すのは骨が折れたわい。", "face": "u153"}, {"name": "アンナ", "text": "それにしても、浮遊石とは空に浮かぶ\n鉱石ですよね。\n何に使うのでしょうか。", "face": "l9be3de2707a5"}, {"name": "ドロシー", "text": "とある冒険家の依頼でね。\nなんでも空を飛ぶ船を……。", "face": "u132"}, {"name": "ドロシー", "text": "しっ！\n静かにしてください。", "face": "u132"}, {"name": "グスタフ", "text": "魔物たちの足音じゃ。\nん？　あの穴の底からも何かはい出てくるぞい。\n気を付けろ！", "face": "u153"}]}, {"trigger": "battle", "at_sec": 24, "lines": [{"name": "グスタフ", "text": "あの大アリは、魔界アリか。\nまだ生き残りがおったとはな……。", "face": "u153"}, {"name": "アンナ", "text": "魔界アリ？　あの大きなアリをご存じなのですか？", "face": "l9be3de2707a5"}, {"name": "ドロシー", "text": "魔界に生息するアリだよ。\n千年戦争のときに魔界からやってきたけど、\n今じゃほとんどが倒されたはず……。", "face": "u132"}, {"name": "グスタフ", "text": "地下深くに潜んでおったのじゃろう。\nもしくは魔界から再びやって来たかじゃ。", "face": "u153"}]}, {"trigger": "end", "lines": [{"name": "グスタフ", "text": "先ほどの魔界アリはおそらく偵察じゃ。\nこの奥に進めばこんなもんじゃないくらい\nおるじゃろうな。", "face": "u153"}, {"name": "ドロシー", "text": "いったん引き返すしかないね。\n依頼主の冒険家には悪いけど仕方ないかな。", "face": "u132"}]}], "map": {"image": "Map5412", "w": 960, "h": 640, "spots": [{"k": "b", "x": 23, "y": 357}, {"k": "b", "x": 931, "y": 348}, {"k": "m", "x": 148, "y": 309, "id": 200}, {"k": "m", "x": 145, "y": 403, "id": 201}, {"k": "m", "x": 251, "y": 399, "id": 202}, {"k": "m", "x": 798, "y": 317, "id": 203}, {"k": "m", "x": 812, "y": 413, "id": 204}, {"k": "m", "x": 358, "y": 400, "id": 205}, {"k": "m", "x": 337, "y": 312, "id": 206}, {"k": "m", "x": 705, "y": 324, "id": 207}, {"k": "m", "x": 499, "y": 231, "id": 208}, {"k": "m", "x": 596, "y": 239, "id": 209}, {"k": "m", "x": 404, "y": 229, "id": 210}, {"k": "m", "x": 615, "y": 313, "id": 211}, {"k": "m", "x": 591, "y": 403, "id": 212}, {"k": "m", "x": 556, "y": 178, "id": 213}, {"k": "r", "x": 140, "y": 495, "id": 300}, {"k": "r", "x": 459, "y": 468, "id": 301}, {"k": "r", "x": 584, "y": 483, "id": 302}, {"k": "r", "x": 740, "y": 258, "id": 303}, {"k": "r", "x": 234, "y": 224, "id": 304}, {"k": "r", "x": 333, "y": 223, "id": 305}, {"k": "r", "x": 443, "y": 183, "id": 306}, {"k": "r", "x": 698, "y": 521, "id": 307}, {"k": "r", "x": 143, "y": 226, "id": 308}, {"k": "r", "x": 829, "y": 490, "id": 309}, {"k": "r", "x": 455, "y": 116, "id": 310}, {"k": "r", "x": 317, "y": 489, "id": 311}]}, "active": true}