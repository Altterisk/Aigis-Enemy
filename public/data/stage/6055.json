40, "attack_interval": 121, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105456, "race_id": 6, "missile_id": 149, "missile": {"speed": 3.0}, "master_id": 649, "global_id": 648, "ranged": true}], "popups": ["ケラウノスは拠点には\n向かわず、しばらくすると\n戦場からいなくなります。\n\n倒さなくても★の評価には\n影響しません。"], "dialogue": [{"trigger": "start", "lines": [{"name": "ケラウノス", "text": "――愚かな人間達よ。少々遅かったようですね。", "face": "lca2b04fe9832"}, {"name": "アンナ", "text": "あれは……女神ケラウノス様！", "face": "lc26decf1e4cf"}, {"name": "サーベイン", "text": "ぐッ……なんという……事ヲ……。", "face": "u425"}, {"name": "レオナ", "text": "王子……すまない……我々がいながら\nみすみす龍玉を破壊されてしまうとは……。", "face": "u311"}, {"name": "アリサ", "text": "お二人とも酷い怪我を……待ってください、\nすぐに癒しの魔法をかけますので！", "face": "u24"}, {"name": "ケラウノス", "text": "全く、そのような少数の手勢で神を止めようなど、\n人間とは本当に度し難い程に愚物ですね。", "face": "lca2b04fe9832"}, {"name": "レオナ", "text": "…………だまれ……！", "face": "u311"}, {"name": "ケラウノス", "text": "余計な邪魔が入りましたが、\n古代龍を封印していた龍玉は既に破壊しました。\n目覚めた古代龍が物質界を滅ぼすのも時間の問題でしょう。", "face": "lca2b04fe9832"}, {"name": "ケラウノス", "text": "ここでの目的は果たしました。それでは……。", "face": "lca2b04fe9832"}, {"name": "ケイティ", "text": "待ちなさい！　ケラウノス！", "face": "u114"}, {"name": "ケラウノス", "text": "……アイギスが肩入れするだけあって本当に\n目障りな人間達ですね。どの道滅び行く運命だというのに、\nそうまでして死に急ぎたいのでしょうか。", "face": "lca2b04fe9832"}, {"name": "ケラウノス", "text": "我が僕たちよ、龍玉の欠片を用い\nその人間達を滅しなさい。私は天界へと戻ります。", "face": "lca2b04fe9832"}, {"name": "天使", "text": "仰せのままに……。", "face": "l09449edda563"}, {"name": "レオナ", "text": "……王子、済まない。この傷では\n加勢もままならん。我々は一足先に帝国へと戻り、\nこの事態を陛下へと報せるつもりだ……。", "face": "u311"}, {"name": "アンナ", "text": "判りました。道中どうかお気を付けください。\n王子、戦闘のご準備を！", "face": "lc26decf1e4cf"}]}, {"trigger": "end", "lines": [{"name": "ケイティ", "text": "――はぁっ！", "face": "u114"}, {"name": "ケイティ", "text": "今ので全ての敵を倒したようですが……。\nケラウノスはすでに去った後のようですね。", "face": "u114"}, {"name": "アンナ", "text": "……ケラウノス様の動向も気にはなりますが、\n今は目の前の事に集中したほうが良さそうです。", "face": "lc26decf1e4cf"}, {"name": "アンナ", "text": "王子、急ぎ拠点へ戻り、\nこの未曾有の危機に対し対策を練りましょう。", "face": "lc26decf1e4cf"}]}], "active": true}