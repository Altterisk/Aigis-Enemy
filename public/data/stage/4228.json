{"quest_id": 4228, "name": "静まり返った村", "description": "静まり返った不気味な村\n襲いくる魔物たちを倒せ！\n\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "ドルイドの巫女姫", "event_category": "History", "mission_id": 920037, "map_no": 3538, "level": 95, "multiplier": 0.95, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 12, "form_count": 1, "tags": ["植物"], "hp": 1235, "attack": 280, "base_hp": 1300, "base_attack": 280, "damage_type": "physical", "armor_defense": 100, "attack_range": 120, "attack_speed": 50, "attack_wait": 30, "attack_interval": 95, "move_speed": 1200.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098944, "special_effect_id": 39, "missile_id": 65, "missile": {"speed": 9.0}, "master_id": 131, "global_id": 130, "ranged": true, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 10, "form_count": 1, "hp": 608, "attack": 133, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 33}, {"enemy_id": 3, "source": "local", "count": 2, "form_count": 1, "hp": 855, "attack": 190, "base_hp": 900, "base_attack": 200, "damage_type": "physical", "armor_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 153, "move_speed": 700.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097360, "race_id": 9, "master_id": 16, "spawn_sec": 36}, {"enemy_id": 4, "source": "local", "count": 6, "form_count": 1, "hp": 950, "attack": 142, "base_hp": 1000, "base_attack": 150, "damage_type": "physical", "armor_defense": 20, "attack_speed": 16, "attack_wait": 10, "attack_interval": 53, "move_speed": 1300.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097184, "race_id": 11, "master_id": 2, "spawn_sec": 40}, {"enemy_id": 5, "source": "local", "count": 6, "form_count": 1, "hp": 608, "base_hp": 640, "damage_type": "physical", "armor_defense": 40, "attack_speed": 65, "attack_wait": 10, "move_speed": 650.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097216, "master_id": 4, "spawn_sec": 49}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 4750, "attack": 380, "base_hp": 5000, "base_attack": 400, "damage_type": "physical", "armor_defense": 50, "attack_speed": 70, "attack_wait": 10, "attack_interval": 156, "move_speed": 370.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097792, "master_id": 9, "spawn_sec": 70}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "ここは村、でしょうか。\nそれにしては人が一人も……。\nあたりに漂うこの雰囲気、嫌な感じがします。", "face": "lbf1c7222647d"}, {"name": "アンナ", "text": "なにかがうごめいているような……。\nとりあえずあたりを探索してみましょう。", "face": "lbf1c7222647d"}, {"name": "兵士", "text": "報告！　何者かがこちらを襲っている模様！", "face": "leae7fc43b0f3"}, {"name": "アンナ", "text": "だれもいないはずなのに……。\nまた先ほどの木の魔物でしょうか。", "face": "lbf1c7222647d"}, {"name": "アンナ", "text": "王子、お気を付けください！", "face": "lbf1c7222647d"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "なんとか魔物を村から追い払うことができましたね。"}, {"name": "妖精郷の民", "text": "あなたたちは……たすかりました……。", "face": "u119"}, {"name": "アンナ", "text": "あなたは妖精郷の方ですね。\n聞きたいことがあります。\n今、妖精郷では何が起こっているんですか？", "face": "lbf1c7222647d"}, {"name": "妖精郷の民", "text": "僕自身も何が起こっているのか……。\n噂に聞くドルイドの巫女姫なら何か\n知っているかもしれませんが……。", "face": "u119"}, {"name": "アンナ", "text": "ドルイドの巫女姫、ですか？", "face": "lbf1c7222647d"}, {"name": "妖精郷の民", "text": "この妖精郷の中心には神樹があります。\nそこに妖精郷の木々を司るドルイドの巫女姫が\n眠っているという話を聞いたことがあります。", "face": "u119"}, {"name": "妖精郷の民", "text": "森の木々に異変が起きたということは、\n巫女姫に何か異変があったのかもしれません。", "face": "u119"}, {"name": "アンナ", "text": "なるほど、そうなるとその方が危険ですね。\n王子、神樹に向かってみましょう！", "face": "lbf1c7222647d"}]}], "active": true}