dex": 1, "form_count": 2, "hp": 5000, "attack": 300, "base_hp": 5000, "base_attack": 300, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 220, "attack_speed": 70, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.7999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30404, "global_id": 4023, "ranged": true, "from_condition": 5}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 2, "tags": ["精霊(氷)"], "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "magical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 33, "attack_interval": 110, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115552, "change_to": 16, "change_condition": 5, "master_id": 31223, "global_id": 4842, "to_condition": 5, "to_global_id": 4843, "spawn_sec": 120}, {"enemy_id": 16, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["精霊(氷)"], "hp": 4500, "attack": 450, "base_hp": 4500, "base_attack": 450, "damage_type": "magical", "armor_defense": 50, "attack_range": 330, "attack_speed": 1, "attack_wait": 33, "attack_interval": 109, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115552, "missile_id": 296, "missile": {"speed": 8.0}, "master_id": 31224, "global_id": 4843, "ranged": true, "from_condition": 5}, {"enemy_id": 18, "source": "local", "count": 2, "form_count": 1, "tags": ["鳥", "水棲"], "hp": 5500, "base_hp": 5500, "damage_type": "physical", "armor_defense": 400, "attack_speed": 1, "move_speed": 1400.0, "gain_cost": 1, "dot_rate": 1.399999976158142, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2132416, "race_id": 11, "master_id": 34504, "global_id": 8121, "spawn_sec": 132}, {"enemy_id": 19, "source": "local", "count": 5, "form_count": 2, "tags": ["精霊(氷)"], "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "attack_speed": 1, "attack_wait": 33, "attack_interval": 110, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115552, "change_to": 19, "change_condition": 5, "master_id": 31221, "global_id": 4840, "to_condition": 5, "to_global_id": 4841, "spawn_sec": 140}, {"enemy_id": 19, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "tags": ["精霊(氷)"], "hp": 3000, "attack": 150, "base_hp": 3000, "base_attack": 150, "damage_type": "magical", "armor_defense": 50, "attack_range": 300, "attack_speed": 1, "attack_wait": 33, "attack_interval": 109, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2115552, "missile_id": 296, "missile": {"speed": 8.0}, "master_id": 31222, "global_id": 4841, "ranged": true, "from_condition": 5}], "dialogue": [{"trigger": "start", "lines": [{"name": "パルセ", "text": "――緊急事態発生！\n減速の後、進路変更！　目標、上空の要塞宮殿！", "face": "u2276a1"}, {"name": "アカツキ（ドーンブリンガー）", "text": "あいあいねーさま！\n緊急減速あーんど、進路変更ぅー！", "face": "u2578a1"}, {"name": "スウィーティア", "text": "きゃぁぁぁっ！？\nど、どどど、どうしたの！？\nいきなり揺れたんだけど！？", "face": "u2577a1"}, {"name": "ファリエ", "text": "緊急事態なんです！\n隕石がですね！　びゅーんとですね！？", "face": "u2533a1"}, {"name": "女王子", "text": "ファリエさんも落ち着いてください。\nいったい何が起きたんですか？\n現状を把握している方は――", "face": "u1737a1"}, {"name": "エフトラ", "text": "――説明しましょう。", "face": "u1468a1"}, {"name": "エフトラ", "text": "先ほど、要塞宮殿で調査を進めていたフローガさんより、\n巨大な魔力の塊が、地上へ向けて落下中であると\n緊急の連絡が入りました。", "face": "u1468a1"}, {"name": "スウィーティア", "text": "巨大な魔力のかたまり……？", "face": "u2577a1"}, {"name": "エフトラ", "text": "端的にいえば、要塞宮殿の魔力を帯びた\n巨大な小惑星が地上に向かって急速接近中です。\nぶつかると都市のひとつやふたつは……。", "face": "u1468a1"}, {"name": "スウィーティア", "text": "大変じゃない！？", "face": "u2577a1"}, {"name": "パルセ", "text": "なので、現在当艦は要塞宮殿に向けて急行中です。\nみなさま、最大戦速を発揮しますので、\n席に座って安全ベルトを――", "face": "u2276a1"}, {"name": "アカツキ", "text": "姉さまー！　大変です！\nこのままだと魔物の群れに突っ込みます！", "face": "u2578a1"}, {"name": "パルセ", "text": "……王子、どうしますか？", "face": "u2276a1"}, {"name": "王子", "text": "…………（こくり）", "face": "u1"}, {"name": "パルセ", "text": "了解しました。\n総員戦闘配置！　魔物を撃退しつつ宇宙を目指します！", "face": "u2276a1"}]}, {"trigger": "start", "lines": [{"name": "エィス", "text": "（わっ、見えてきました。\nあれが、えっちゃんの新しい仲間――）", "face": "u2885a1"}, {"name": "エィス", "text": "（……なんていうのか、取り込み中？\nまぁともあれ着地を。えーい）", "face": "u2885a1"}, {"name": "アカツキ", "text": "わっ、わっ、わー！？\n甲板に何かが着地しましたー！", "face": "u2578a1"}, {"name": "エィス", "text": "こんにちは、えっちゃんです。\nさっそくですが、お手伝いはいりますか？", "face": "u2885a1"}, {"name": "アンナ", "text": "……えぇと、あなたは？"}, {"name": "エィス", "text": "お話してる時間はなさそうだなぁって、\n正直えっちゃんは思います。", "face": "u2885a1"}, {"name": "エフトラ", "text": "隕石も接近中ですし、時間がありません。\n自己紹介はのちほどゆっくりお願いしましょう。", "face": "u1468a1"}, {"name": "エィス", "text": "うん。それじゃあ、えっちゃん頑張ります♪", "face": "u2885a1"}]}, {"trigger": "end", "lines": [{"name": "パルセ", "text": "――魔物の群れは突破しました。\n皆さん、お疲れ様です。", "face": "u2276a1"}, {"name": "アカツキ", "text": "このまま宇宙に出るから、\nみんな艦内に戻ってくださーい。", "face": "u2578a1"}, {"name": "エィス", "text": "――ふぅ、でびゅー戦だいしょーりです。", "face": "u2885a1"}, {"name": "王子", "text": "…………。", "face": "u1"}, {"name": "エィス", "text": "あっ、そうでした、自己紹介をしないと……。", "face": "u2885a1"}, {"name": "エィス", "text": "こほん。皆さんはじめまして。\nTerminal Of Worlds End Resistanceにより、\nこの世界に派遣された――", "face": "u2885a1"}, {"name": "ミネット", "text": "たーみなりゅ……？　おびゅ、れじででで？", "face": "u749"}, {"name": "エィス", "text": "たーみなる、おぶ、わーるどえんど、れじすたんす。\n皆さんがたわーちゃんと呼んでいる、\n小さくて可愛い姉の妹分です。", "face": "u2885a1"}, {"name": "ミネット", "text": "あぁ、たわーちゃんの！", "face": "u749"}, {"name": "エィス", "text": "個体名称はtypeA。\nエィス、またはえっちゃんと呼んでください。", "face": "u2885a1"}, {"name": "アンナ", "text": "……あなたが現れたということは、\nもしやまた、世界の危機が？"}, {"name": "エィス", "text": "あっ、いえいえ、\n事前連絡をしていない姉の不手際というかぁ……。", "face": "u2885a1"}, {"name": "エィス", "text": "ともあれ、もろもろ詳しくお話しましょー。", "face": "u2885a1"}]}], "active": true}