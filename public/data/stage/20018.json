{"quest_id": 20018, "name": "未知との遭遇？", "description": "緊急連絡を受けて天空の果てへと\n向かう王子一行。\nそこへ新たな仲間が合流して...?\n中級（★１獲得の目安：平均Lv1 出撃8体）", "event": "観測者はきゅーとな宇宙の少女", "event_category": "Emergency", "mission_id": 200578, "map_no": 7480, "level": 100, "multiplier": 1.0, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 11, "form_count": 2, "hp": 3000, "attack": 80, "base_hp": 3000, "base_attack": 80, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_speed": 1, "attack_wait": 33, "attack_interval": 128, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 70, "change_to": 1, "change_condition": 5, "master_id": 30399, "global_id": 4018, "to_condition": 5, "to_global_id": 4019, "spawn_sec": 6}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 3000, "attack": 80, "base_hp": 3000, "base_attack": 80, "damage_type": "magical", "armor_defense": 80, "magic_defense": 30, "attack_range": 200, "attack_speed": 1, "attack_wait": 33, "attack_interval": 127, "move_speed": 850.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2110960, "special_effect_id": 232, "missile_id": 214, "missile": {"speed": 4.0}, "master_id": 30400, "global_id": 4019, "ranged": true, "from_condition": 5}, {"enemy_id": 3, "source": "local", "count": 4, "form_count": 2, "hp": 2000, "attack": 100, "base_hp": 2000, "base_attack": 100, "damage_type": "magical", "armor_defense": 100, "magic_defense": 50, "attack_speed": 70, "attack_wait": 5, "attack_interval": 131, "move_speed": 1000.0, "gain_cost": 1, "dot_rate": 1.0, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2105808, "special_effect_id": 70, "change_to": 3, "change_condition": 5, "master_id": 778, "global_id": 777, "to_condition": 5, "to_global_id": 778, "spawn_sec": 35}, {"enemy_id": 3, "source": "local", "count": 1