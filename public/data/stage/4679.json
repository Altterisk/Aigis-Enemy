{"quest_id": 4679, "name": "妖怪総大将の本気", "description": "牛鬼を引き連れた\nぬらりひょんとの決戦に勝利せよ！\n＜毒：HPに継続ダメージ＞\n極級（★１獲得の目安：平均Lv25）", "modifier_notes": ["毒：HPに継続ダメージ"], "event": "第二次妖怪大戦", "event_category": "History", "mission_id": 920073, "map_no": 3726, "level": 100, "multiplier": 1.0, "charisma": 90, "capacity": 8, "modifiers": [{"kind": "term", "influence": 8, "params": [0, 5, 30]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 2, "hp": 18000, "attack": 1200, "base_hp": 18000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 350, "magic_defense": 50, "attack_range": 140, "attack_speed": 70, "attack_wait": 90, "attack_interval": 281, "move_speed": 500.0, "dot_rate": 1.600000023841858, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2107152, "race_id": 4, "special_effect_id": 534, "change_to": 1, "change_condition": 2, "missile_id": 27, "missile": {"speed": 10.0}, "master_id": 861, "global_id": 860, "ranged": true, "to_condition": 2, "to_global_id": 861, "route_behaviour": {"battle_styles": ["ENBSTL_Default", "ENBSTL_NoAttack"]}, "spawn_sec": 3}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 20000, "attack": 1100, "base_hp": 20000, "base_attack": 1100, "damage_type": "physical", "armor_defense": 400, "magic_defense": 50, "attack_speed": 60, "attack_wait": 10, "attack_interval": 131, "move_speed": 300.0, "gain_cost": 3, "dot_rate": 2.0, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2107168, "race_id": 4, "special_effect_id": 534, "master_id": 862, "global_id": 861, "from_condition": 2}, {"enemy_id": 3, "source": "local", "count": 2, "level": 80, "form_count": 1, "hp": 12000, "attack": 1000, "base_hp": 12000, "base_attack": 1000, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 10, "attack_speed": 65, "attack_wait": 10, "attack_interval": 164, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2100016, "race_id": 4, "master_id": 863, "global_id": 862, "spawn_sec": 3}, {"enemy_id": 4, "source": "local", "count": 37, "form_count": 1, "hp": 700, "attack": 150, "base_hp": 700, "base_attack": 150, "damage_type": "physical", "armor_defense": 50, "magic_defense": 15, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100288, "race_id": 4, "master_id": 237, "global_id": 236, "spawn_sec": 6}, {"enemy_id": 5, "source": "local", "count": 3, "form_count": 1, "hp": 3700, "attack": 630, "base_hp": 3700, "base_attack": 630, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 16, "attack_wait": 5, "attack_interval": 67, "move_speed": 3000.0, "gain_cost": 1, "dot_rate": 1.7000000476837158, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099536, "race_id": 4, "master_id": 105, "global_id": 104, "spawn_sec": 64}, {"enemy_id": 6, "source": "local", "count": 2, "form_count": 1, "hp": 1400, "attack": 460, "base_hp": 1400, "base_attack": 460, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 900.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099312, "race_id": 4, "master_id": 101, "global_id": 100, "spawn_sec": 68}, {"enemy_id": 7, "source": "local", "count": 4, "form_count": 1, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "spawn_sec": 89}, {"enemy_id": 8, "source": "local", "count": 2, "form_count": 2, "hp": 1000, "attack": 500, "base_hp": 1000, "base_attack": 500, "damage_type": "magical", "armor_defense": 50, "magic_defense": 20, "attack_range": 100, "attack_speed": 65, "attack_wait": 15, "attack_interval": 81, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100304, "race_id": 4, "change_to": 6, "change_condition": 4, "missile_id": 75, "missile": {"speed": 4.0}, "master_id": 238, "global_id": 237, "ranged": true, "to_condition": 4, "to_ticks": 1, "to_global_id": 238, "spawn_sec": 92}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 1000, "base_hp": 1000, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "move_speed": 800.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2100320, "race_id": 4, "master_id": 239, "global_id": 238, "from_condition": 4, "trigger_ticks": 1}, {"enemy_id": 9, "source": "local", "count": 4, "form_count": 1, "hp": 3000, "attack": 750, "base_hp": 3000, "base_attack": 750, "damage_type": "physical", "armor_defense": 250, "magic_defense": 20, "attack_speed": 60, "attack_wait": 15, "attack_interval": 141, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2099328, "race_id": 4, "master_id": 102, "global_id": 101, "spawn_sec": 120}], "dialogue": [{"trigger": "start", "lines": [{"name": "酒呑童子", "text": "ようやくお会いできましたな、ぬらりひょん殿。\n我ら鬼の一族、みな一日千秋の思いにて\nこの時を待ち望んでおりましたぞ。", "face": "lae08591e76c6"}, {"name": "ぬらりひょん", "text": "（ヒョッヒョッ。\n鬼の頭領たる酒呑童子が我が元へ下るとは\nこれほどまでに心地がいいものか。）", "face": "l1a8ed43acebc"}, {"name": "ぬらりひょん", "text": "悠長に構えてる暇はないぞ、酒呑童子よ。\n今からお前の宿敵「鬼切」の使い手と\n王子軍がここへ来るぞい。", "face": "l1a8ed43acebc"}, {"name": "酒呑童子", "text": "「鬼切」の使い手だと……ッ！？\n我ら鬼の一族をあのような場所に封じた、\n忌々しい輩が未だこの世に在るとは……！", "face": "lae08591e76c6"}, {"name": "ぬらりひょん", "text": "ヒョッヒョッ。解っておる解っておる。\n長年封印されておったからのぅ。\n思う存分、恨みを晴らすがいい。", "face": "l1a8ed43acebc"}, {"name": "ぬらりひょん", "text": "今回はわしが、おとりとなってやる。\nその代わりお主らは、奴らの裏を取れ。\n挟み撃ちにして壊滅させるのじゃ。", "face": "l1a8ed43acebc"}, {"name": "酒呑童子", "text": "……了解致した。\n鬼共！　出陣するぞ！\n（チッ、おいぼれが偉そうにしやがって……）", "face": "lae08591e76c6"}, {"name": "ぬらりひょん", "text": "頼んだぞ、酒呑童子よ。\n……と、早速来たようじゃぞ。", "face": "l1a8ed43acebc"}]}, {"trigger": "start", "lines": [{"name": "ヒバリ", "text": "……やけに静かね。\n都に妖怪が集まっているのは\n間違いないのに……。", "face": "u389"}, {"name": "ぬらりひょん", "text": "飛んで火にいる夏の虫……。\nまさに、お前たちのことだと思わんか？\nのう、王子と「鬼切」の童よ。", "face": "l1a8ed43acebc"}, {"name": "ぬらりひょん", "text": "覚悟しておけェ！！\n全員まとめて切り刻んでくれるわ！！\n出ろ！　妖怪共！　百鬼夜行じゃあああ！！", "face": "l1a8ed43acebc"}, {"name": "アンナ", "text": "王子！　妖怪が向かってきます！\n戦いの準備を！", "face": "lef0cef750e7e"}]}, {"trigger": "battle", "at_sec": 43, "lines": [{"name": "ぬらりひょん", "text": "ぐっ……鬼の奴らは何をしておるんじゃ？\nこれ以上はさすがのわしも……！", "face": "l97277730df3c"}, {"name": "四天王", "text": "どうした、ぬらりひょん？\nまだ助けがくるとでも思っておるのか？", "face": "l454ac6cd8138"}, {"name": "ぬらりひょん", "text": "――なッ、ど、どういうことじゃ！？", "face": "l97277730df3c"}, {"name": "四天王", "text": "オマエはここで死ぬんだよ、ぬらりひょん。\nそうすれば酒呑童子様が妖怪の頂点に君臨される。\nククク……最初からこうなる運命だったのよ。", "face": "l454ac6cd8138"}, {"name": "四天王", "text": "我ら四天王が復活を果たした今、\nお前はもう用済みなのじゃ！\nガーーッハッハッハッハ！", "face": "l454ac6cd8138"}, {"name": "ぬらりひょん", "text": "な……、裏切った……だと？\nおのれ……。", "face": "l97277730df3c"}, {"name": "ぬらりひょん", "text": "おのれェェェェェェェェェェェェェぇええ！！", "face": "l97277730df3c"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "妖怪を全部倒したようですね。", "face": "lef0cef750e7e"}, {"name": "ぬらりひょん", "text": "くちおしや……。くちおしや……。\n妖怪の総大将たるわしが……。\n鬼なんぞに……。裏切られるとは……。", "face": "l97277730df3c"}, {"name": "ヒエン", "text": "力を使い果たしたか。\nこれではもう助からぬ。\n年貢の納め時でござるな。", "face": "u112"}, {"name": "ぬらりひょん", "text": "人間ふぜいが……畜生……\n妖怪の……理想郷が……\nわしの夢も……ここで終わり……か……。", "face": "l97277730df3c"}, {"name": "ぬらりひょん", "text": "……。", "face": "l1a8ed43acebc"}, {"name": "ヒバリ", "text": "……息絶えたか。", "face": "u389"}, {"name": "ヒエン", "text": "酒呑童子の気配はもう、ここにはござらぬ。\n拙者は酒呑童子を追う。\n王子は、報せを待っていてくだされ。", "face": "u112"}, {"name": "アンナ", "text": "ヒエンさん、お任せします。\n王子、それでは一旦帰還して\n酒呑童子の対策を立てましょう。", "face": "lef0cef750e7e"}]}], "active": true}