": 2123760, "race_id": 7, "missile_id": 11, "master_id": 32691, "global_id": 6309, "ranged": true, "spawn_sec": 100}, {"enemy_id": 7, "source": "local", "count": 1, "form_count": 1, "hp": 13000, "attack": 1700, "base_hp": 13000, "base_attack": 1700, "damage_type": "physical", "armor_defense": 150, "magic_defense": 20, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2131696, "race_id": 16, "change_to": 7, "change_condition": 2, "master_id": 34196, "global_id": 7813, "spawn_sec": 129}, {"enemy_id": 10, "source": "local", "count": 1, "form_count": 2, "hp": 5000, "attack": 700, "base_hp": 5000, "base_attack": 700, "damage_type": "magical", "armor_defense": 600, "magic_defense": 30, "attack_range": 200, "attack_speed": 1, "attack_wait": 15, "attack_interval": 61, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2123440, "race_id": 3, "change_to": 10, "change_condition": 2, "missile_id": 6, "master_id": 33772, "global_id": 7389, "ranged": true, "to_condition": 2, "to_global_id": 7394, "spawn_sec": 132}, {"enemy_id": 10, "source": "local", "count": 1, "form_index": 1, "form_count": 2, "hp": 5000, "attack": 900, "base_hp": 5000, "base_attack": 900, "damage_type": "magical", "armor_defense": 800, "magic_defense": 30, "attack_range": 200, "attack_speed": 1, "attack_wait": 15, "attack_interval": 61, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2123440, "race_id": 3, "special_effect_id": 121, "missile_id": 6, "master_id": 33777, "global_id": 7394, "ranged": true, "from_condition": 2}, {"enemy_id": 16, "source": "local", "count": 1, "form_count": 1, "hp": 20000, "attack": 1500, "base_hp": 20000, "base_attack": 1500, "damage_type": "physical", "armor_defense": 1000, "attack_range": 160, "attack_speed": 1, "attack_wait": 35, "attack_interval": 109, "move_speed": 700.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2123504, "race_id": 16, "special_effect_id": 264, "missile_id": 22, "missile": {"speed": 10.0}, "master_id": 33771, "global_id": 7388, "ranged": true, "spawn_sec": 132}, {"enemy_id": 17, "source": "local", "count": 13, "form_count": 1, "hp": 2000, "attack": 200, "base_hp": 2000, "base_attack": 200, "damage_type": "physical", "armor_defense": 150, "magic_defense": 10, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2104640, "race_id": 16, "change_to": 17, "change_condition": 2, "master_id": 561, "global_id": 560, "spawn_sec": 171}, {"enemy_id": 19, "source": "local", "count": 3, "form_count": 1, "tags": ["水中"], "hp": 25000, "attack": 1600, "base_hp": 25000, "base_attack": 1600, "damage_type": "physical", "armor_defense": 1000, "magic_defense": 5, "attack_speed": 1, "attack_wait": 150, "attack_interval": 358, "move_speed": 500.0, "gain_cost": 2, "dot_rate": 1.2999999523162842, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123680, "race_id": 7, "master_id": 32684, "global_id": 6302, "spawn_sec": 183}, {"enemy_id": 20, "source": "local", "count": 6, "form_count": 1, "hp": 3000, "attack": 350, "base_hp": 3000, "base_attack": 350, "damage_type": "physical", "armor_defense": 200, "magic_defense": 10, "attack_speed": 20, "attack_wait": 10, "attack_interval": 81, "move_speed": 500.0, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2105328, "race_id": 16, "change_to": 20, "change_condition": 2, "master_id": 646, "global_id": 645, "spawn_sec": 207}], "popups": ["　　　【深海の水圧(弱)】\n・味方の攻撃後待ち時間が少し増加\n・ユニット配置後、一定時間経過で\n　継続ダメージが発生\n\n※これらは、風水使いなどがもつ\n　地形効果を軽減する能力では\n　軽減できません。", "スカーは攻撃を行うたびに、\n攻撃力がアップしていきます。\n\n３回目の攻撃後、\n攻撃力が最大になります。\n※４回目以降の攻撃力が最大", "メフィストは倒されると、\nその場で復活します。\n\n復活は5回まで行われます。"], "dialogue": [{"trigger": "start", "lines": [{"name": "リバン", "text": "はーい、皆様を海中にごあんなーい！", "face": "u1062a1"}, {"name": "リバン", "text": "ここはまだ浅瀬ですので影響は軽微ですが、\n水圧によるダメージと動きの鈍化にご注意を──", "face": "u1062a1"}, {"name": "リバン", "text": "──って、ええええええ！？", "face": "u1062a1"}, {"name": "ルチア", "text": "次の獲物は魚介類かと思ったら……\nなんだあれは……ぎ、ギルマンなのか？", "face": "u1395a1"}, {"name": "スカー", "text": "──シャァァァァァァック！！", "face": "u1396a1"}, {"name": "スカー", "text": "なんだァ……テメェらッ！！\nオレサマの食事の時間を邪魔しようって──", "face": "u1396a1"}, {"name": "スカー", "text": "オイオイオイオイ！　こりゃあなんの偶然だ！？\n王子じゃねェかッ！　こんなところで会えるとはよォ！！", "face": "u1396a1"}, {"name": "スカー", "text": "ゲハハハハッ！！　\nドラコレックスもアンモナイトクラーケンも\n大概喰い飽きてたんだ、ちょうど良かったぜェ！！", "face": "u1396a1"}, {"name": "スカー", "text": "この海になんの用かァ知らねェがッ！！\nオレサマの修行の成果を見せてやるぜェッ！！", "face": "u1396a1"}, {"name": "王子", "text": "…………っ！", "face": "u1"}, {"name": "キホル", "text": "え、これってもう始めちゃっていいのよね？", "face": "u1159a1"}, {"name": "エレット", "text": "いいんじゃない？　王子の喧嘩仲間みたいだし！", "face": "u217"}, {"name": "キホル", "text": "それじゃあ、最終ラウンド開始よー！\nみんな、私に美味しい食材を貢ぎなさい！", "face": "u1159a1"}]}, {"trigger": "battle", "at_sec": 135, "lines": [{"name": "ディアナ", "text": "これは好機ですね。\n王子があの魚人と戦っている間に、\n私たちは漁夫の利を得るとしましょう。", "face": "u1034a1"}, {"name": "ディアナ", "text": "共闘の条件は憶えていますね？\n最終結果で私たちが一位になった暁には、\n王子に『あーん』をする権利を私個人に与えると。", "face": "u1034a1"}, {"name": "ルチア", "text": "えー、はい。それで構いません、騎士団長。", "face": "u1395a1"}, {"name": "メフィスト", "text": "やれやれ、すっかりはしゃいでしまって。\n私たちはのんびりする予定だったのだがね。", "face": "u1036a1"}, {"name": "メーア", "text": "普段より元気がないですね魔神団長。\n友達が自分より仲の良い友達にべったりで、\n構ってもらえなくて寂しいって顔してますよ。", "face": "u1038a1"}, {"name": "メフィスト", "text": "ははは、メーア、ははは。\nようし、魔神団長命令を下そう。\nフカヒレを百枚集めるまで帰還禁止だ。", "face": "u1036a1"}, {"name": "メーア", "text": "ぎゃー！？　口は災いの元ー！？", "face": "u1038a1"}, {"name": "メフィスト", "text": "私としたことが図星を突かれるとはね。\nさて……八つ当たりをしに行くとしようか。", "face": "u1036a1"}]}, {"trigger": "end", "lines": [{"name": "タオパオ", "text": "はい、最終ラウンド終了ネ。\nいい子はみんな早く陸に上がるヨー、\n悪い子は激辛肉まん待ってるからナー。", "face": "u1054a1"}, {"name": "ルチア", "text": "……王子はすごいな、倒してしまったぞ。", "face": "u1395a1"}, {"name": "スカー", "text": "ゲハハハハハハハハッ！\nそうだッ！　王子はこうじゃねェとなァ！！\n壁は分厚くねェとぶち破り甲斐がねえからよォ！！", "face": "u1396a1"}, {"name": "スカー", "text": "負けだ負けだッ！　今日も完敗だぜッ！！\nだが、オレサマは絶対に諦めねェ……！！", "face": "u1396a1"}, {"name": "スカー", "text": "オレサマはもっと強くなる！\nテメェもさらに強くなりやがれ！\nオレサマ以外に負けるんじゃねェぞ！", "face": "u1396a1"}, {"name": "スカー", "text": "最強の名は預けとく！\nいつか獲りに行くからよォ！\nエラを洗って待ってんだなッ！！", "face": "u1396a1"}, {"name": "王子", "text": "…………(こくり)", "face": "u1"}, {"name": "スカー", "text": "……で、テメェらなんでここにいるんだ？", "face": "u1396a1"}, {"name": "ルチア", "text": "……あっ！　しまった！？\n戦いに魅入ってしまっていた！？", "face": "u1395a1"}, {"name": "オーガスタ", "text": "それでは集計結果を発表しまーす！\n今回、栄えある一位を獲得したチームは──", "face": "u960"}, {"name": "ユッタ", "text": "──ルチアさんチームでーす！！\nおめでとうございまーーーーす！！", "face": "u1228a1"}, {"name": "ルチア", "text": "…………え？", "face": "u1395a1"}]}, {"trigger": "route", "enemy_ids": [1], "lines": [{"name": "スカー", "text": "シャァァァァァァック！！\n信じてるぜ王子ィ！　テメェはまだまだァ！！\nこんなもんじゃないッてなァアアアアアアッ！！！", "face": "u1396a1"}, {"name": "スカー", "text": "アげていくぜェええええええええッ！！！", "face": "u1396a1"}, {"name": "ルチア", "text": "あのギルマン、一撃ごとに力が増している！\n凄まじいほどの破壊力だ、王子は平気なのか！？", "face": "u1395a1"}]}], "active": true}