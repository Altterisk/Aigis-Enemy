{"quest_id": 7476, "name": "脅威！　サメ男の急襲！！", "description": "邂逅遭遇！　スカーとの激闘が始まる！！\n＜深海(弱)：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ＞\n神級（★１獲得の目安：平均Lv50）", "modifier_notes": ["深海(弱)：攻撃後の待ち時間が増加\n　時間経過でＨＰに継続ダメージ"], "event": "グルメジャングルは夏のち鮫", "event_category": "History", "mission_id": 920169, "map_no": 5951, "level": 100, "multiplier": 1.0, "charisma": 150, "capacity": 8, "modifiers": [{"kind": "term", "influence": 34, "params": [0, 6, 30], "ext": "攻撃待ち増加=30,ダメージ開始待ち=1800"}, {"kind": "term", "influence": 35, "params": [100]}, {"kind": "term", "influence": 36, "params": [100]}], "enemies": [{"enemy_id": 1, "source": "local", "count": 1, "form_count": 4, "tags": ["水中"], "hp": 90000, "attack": 3000, "base_hp": 90000, "base_attack": 3000, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 15, "attack_speed": 1, "attack_wait": 85, "attack_interval": 238, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123600, "race_id": 7, "change_to": 1, "change_condition": 4, "master_id": 32678, "global_id": 6296, "to_condition": 4, "to_ticks": 1, "to_global_id": 6297, "route_behaviour": {"calls_event": [2104, 2105, 2106]}, "spawn_sec": 1}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 1, "form_count": 4, "tags": ["水中"], "hp": 90000, "attack": 4500, "base_hp": 90000, "base_attack": 4500, "damage_type": "physical", "armor_defense": 1500, "magic_defense": 15, "attack_speed": 1, "attack_wait": 85, "attack_interval": 238, "move_speed": 400.0, "dot_rate": 1.5, "assassin_resist": 100, "transform_resist": 100, "pattern_id": 2123600, "race_id": 7, "special_effect_id": 222, "change_to": 2, "change_condition": 4, "master_id": 32679, "global_id": 6297, "from_condition": 4, "trigger_ticks": 1, "to_condition": 4, "to_ticks": 1, "to_global_id": 6298}, {"enemy_id": 1, "source": "local", "count": 1, "form_index": 2, "form_count": 4, "tags": ["水中"], "hp": 90000, "attack": 6750, "base_hp": 90000, "base_attack": 6750, "damage_type": "physic