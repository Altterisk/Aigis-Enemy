ec": 82}, {"enemy_id": 8, "source": "local", "count": 1, "form_index": 0, "form_count": 1, "hp": 21000, "attack": 1400, "base_hp": 21000, "base_attack": 1400, "damage_type": "magical", "armor_defense": 240, "magic_defense": 10, "attack_range": 230, "attack_speed": 1, "attack_wait": 23, "attack_interval": 89, "move_speed": 900.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2127984, "race_id": 4, "special_effect_id": 92, "missile_id": 169, "missile": {"speed": 15.0}, "master_id": 33583, "global_id": 7200, "ranged": true, "spawn_sec": 96}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 0, "form_count": 3, "hp": 15000, "attack": 700, "base_hp": 15000, "base_attack": 700, "damage_type": "physical", "armor_defense": 100, "magic_defense": 10, "attack_speed": 240, "attack_interval": 291, "move_speed": 900.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2128016, "race_id": 3, "change_to": 9, "change_condition": 2, "master_id": 33603, "global_id": 7220, "to_condition": 2, "to_global_id": 7221, "spawn_sec": 150}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 1, "form_count": 3, "hp": 20000, "attack": 1200, "base_hp": 20000, "base_attack": 1200, "damage_type": "physical", "armor_defense": 400, "magic_defense": 20, "attack_speed": 120, "attack_interval": 171, "move_speed": 1200.0, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 1, "pattern_id": 2128016, "race_id": 3, "change_to": 10, "change_condition": 2, "master_id": 33604, "global_id": 7221, "from_condition": 2, "to_condition": 2, "to_global_id": 7222}, {"enemy_id": 9, "source": "local", "count": 1, "form_index": 2, "form_count": 3, "hp": 25000, "attack": 1800, "base_hp": 25000, "base_attack": 1800, "damage_type": "physical", "armor_defense": 800, "magic_defense": 30, "attack_interval": 51, "move_speed": 1800.0, "gain_cost": 3, "dot_rate": 1.5, "assassin_resist": 1, "transform_resist": 100, "pattern_id": 2128016, "race_id": 3, "special_effect_id": 222, "master_id": 33605, "global_id": 7222, "from_condition": 2}], "popups": ["グレンがいる間は、\n全ての敵ユニットの攻撃と防御が\nアップします。"], "dialogue": [{"trigger": "start", "lines": [{"name": "学生", "text": "なぁ聞いたか？\n新任教師と王子がタイマン張るらしいぜ。", "face": "lc5c688b8f12d"}, {"name": "海賊学生", "text": "マジで！？\n王子の戦いを目の前で見られるってのか！？", "face": "u144"}, {"name": "学生", "text": "新任教師も、あの大嶽丸とタイマン張った天狗らしいぞ！\nこんなの一生に一度見られるかどうかだ！", "face": "lc5c688b8f12d"}, {"name": "海賊学生", "text": "……世界を救うなんて平気でうたっちまう王子を見て、\nあんなオトコになりてェと思って、\n俺達この学園に入ることを決めたんだもんな……。", "face": "u144"}, {"name": "学生", "text": "ああ、オトコとオトコの戦いだ……。\nきっとこの喧嘩は、\n王国の黄金時代として永遠に語られるぞ！！", "face": "lc5c688b8f12d"}, {"name": "ホムラ", "text": "――で、どうして親父と王子が模擬戦……じゃなくて、\n喧嘩する流れになってるんだ？", "face": "u1185a1"}, {"name": "ライチ", "text": "この学園に入ってくる連中は、\n多かれ少なかれ、王子や王国軍に憧れてるから、かな。", "face": "u984"}, {"name": "ホムラ", "text": "そうか、王子に憧れていても、\n王子が戦ってる戦場には出られない学生も多い……。\nそういう連中に、本当のこの学園のヘッドの姿を……！", "face": "u1185a1"}, {"name": "グレン", "text": "そういうことだ、ホムラ。\n目指す高みがおぼろげだから、\nついつい道を踏み外しちまうんだよ。", "face": "u1186a1"}, {"name": "グレン", "text": "だから、この学園のヘッド――王子みずから、\n本当にカッコイイ生き様ってヤツを見せればいいのさ。", "face": "u1186a1"}, {"name": "グレン", "text": "ってわけだ、王子。\nついつい昔を思い出して俺も熱くなっちまってな。\nここはひとつ、本気の喧嘩を一発頼むぜ……ッ！！", "face": "u1186a1"}]}, {"trigger": "end", "lines": [{"name": "グレン", "text": "――グハッ……。\nさすがだぜ、王子……。\nお前こそ……王国の……学園のヘッドにふさわしい……。", "face": "u1186a1"}, {"name": "学生", "text": "おぉ、おぉぉぉぉぉおおッ！！\n王子っ！　うおおおおッ、王子ッ！！", "face": "lc5c688b8f12d"}, {"name": "ホムラ", "text": "……ケッ、かっこいいこと言っておいて、\nとんだ大根役者じゃねぇか。\nあんな棒読みセリフでよくバレないもんだ。", "face": "u1185a1"}, {"name": "エスネア", "text": "あれ？　でもホムラちゃん涙ぐんでない？", "face": "u1188a1"}, {"name": "ホムラ", "text": "バッ、バッカ！　別に感動なんてしてねぇよ！！", "face": "u1185a1"}, {"name": "ホムラ", "text": "でも……その……。\nちょっとだけ、親父カッコイイなって……思っただけで。", "face": "u1185a1"}, {"name": "クロエ", "text": "そういう言葉は、\n本人に言ってあげた方がいいんじゃない？", "face": "u784"}, {"name": "ホムラ", "text": "……言えるかよ、恥ずかしい。\nこういうのは、いつか酒でも飲みながらするものさ。", "face": "u1185a1"}, {"name": "ホムラ", "text": "あーあ、まったく。\n学生生活ってもっとこう、きゃぴきゃぴしてて！\nきゃるーんって感じだと思ってたのになぁ！", "face": "u1185a1"}, {"name": "ホムラ", "text": "――こういうのも、悪くないじゃねぇか。", "face": "u1185a1"}]}], "map": {"image": "Map920158_5921", "w": 960, "h": 640, "spots": [{"k": "b", "x": 952, "y": 216}, {"k": "b", "x": 954, "y": 473}, {"k": "m", "x": 805, "y": 496, "id": 201}, {"k": "m", "x": 798, "y": 363, "id": 202}, {"k": "m", "x": 717, "y": 370, "id": 203}, {"k": "m", "x": 637, "y": 369, "id": 204}, {"k": "m", "x": 565, "y": 360, "id": 205}, {"k": "m", "x": 614, "y": 235, "id": 206}, {"k": "m", "x": 701, "y": 235, "id": 207}, {"k": "m", "x": 795, "y": 235, "id": 208}, {"k": "m", "x": 797, "y": 301, "id": 210}, {"k": "m", "x": 723, "y": 496, "id": 211}, {"k": "m", "x": 719, "y": 433, "id": 212}, {"k": "m", "x": 640, "y": 501, "id": 213}, {"k": "m", "x": 563, "y": 285, "id": 214}, {"k": "m", "x": 496, "y": 287, "id": 215}, {"k": "m", "x": 133, "y": 326, "id": 216}, {"k": "m", "x": 564, "y": 500, "id": 217}, {"k": "m", "x": 495, "y": 362, "id": 218}, {"k": "m", "x": 299, "y": 418, "id": 219}, {"k": "m", "x": 125, "y": 249, "id": 220}, {"k": "m", "x": 141, "y": 404, "id": 221}, {"k": "m", "x": 217, "y": 405, "id": 222}, {"k": "m", "x": 205, "y": 243, "id": 223}, {"k": "m", "x": 277, "y": 242, "id": 224}, {"k": "m", "x": 424, "y": 242, "id": 225}, {"k": "m", "x": 352, "y": 241, "id": 226}, {"k": "m", "x": 119, "y": 463, "id": 227}, {"k": "m", "x": 383, "y": 419, "id": 228}, {"k": "m", "x": 468, "y": 419, "id": 229}, {"k": "m", "x": 471, "y": 497, "id": 230}, {"k": "r", "x": 349, "y": 114, "id": 300}, {"k": "r", "x": 511, "y": 183, "id": 301}, {"k": "r", "x": 376, "y": 309, "id": 302}, {"k": "r", "x": 190, "y": 161, "id": 303}, {"k": "r", "x": 720, "y": 283, "id": 304}, {"k": "r", "x": 566, "y": 419, "id": 305}, {"k": "r", "x": 771, "y": 151, "id": 306}, {"k": "r", "x": 870, "y": 273, "id": 307}, {"k": "r", "x": 802, "y": 412, "id": 308}, {"k": "r", "x": 641, "y": 287, "id": 309}, {"k": "r", "x": 115, "y": 160, "id": 310}, {"k": "r", "x"