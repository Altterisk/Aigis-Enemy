{"quest_id": 4062, "name": "亡者の兵士", "description": "地下洞窟に魔物が出現！\n洞窟から出る前に駆逐せよ！", "event": "熱砂の剣士", "event_category": "History", "mission_id": 920018, "map_no": 3825, "level": 90, "multiplier": 0.9, "charisma": 25, "capacity": 8, "enemies": [{"enemy_id": 1, "source": "local", "count": 9, "form_count": 1, "hp": 576, "attack": 126, "base_hp": 640, "base_attack": 140, "damage_type": "physical", "attack_speed": 40, "attack_wait": 10, "attack_interval": 101, "move_speed": 700.0, "gain_cost": 1, "dot_rate": 1.25, "assassin_resist": 2000, "transform_resist": 2000, "pattern_id": 2097200, "race_id": 9, "master_id": 3, "spawn_sec": 1}, {"enemy_id": 2, "source": "local", "count": 6, "form_count": 1, "tags": ["アンデッド"], "hp": 720, "attack": 250, "base_hp": 800, "base_attack": 250, "damage_type": "physical", "armor_defense": 50, "attack_range": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 111, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098656, "missile_id": 23, "missile": {"speed": 2.0, "deflectable": true}, "master_id": 167, "global_id": 166, "ranged": true, "spawn_sec": 12}, {"enemy_id": 3, "source": "local", "count": 12, "form_count": 1, "tags": ["アンデッド"], "hp": 900, "attack": 270, "base_hp": 1000, "base_attack": 300, "damage_type": "physical", "armor_defense": 120, "attack_speed": 70, "attack_wait": 30, "attack_interval": 161, "move_speed": 600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098672, "master_id": 168, "global_id": 167, "spawn_sec": 14}, {"enemy_id": 4, "source": "local", "count": 7, "form_count": 1, "tags": ["アンデッド"], "hp": 3600, "attack": 270, "base_hp": 4000, "base_attack": 300, "damage_type": "physical", "armor_defense": 50, "magic_defense": 20, "attack_speed": 60, "attack_wait": 10, "attack_interval": 121, "move_speed": 400.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2098336, "special_effect_id": 227, "master_id": 89, "global_id": 88, "spawn_sec": 23}, {"enemy_id": 5, "source": "local", "count": 1, "form_count": 1, "hp": 2250, "attack": 540, "base_hp": 2500, "base_attack": 600, "damage_type": "physical", "armor_defense": 200, "magic_defense": 5, "attack_speed": 70, "attack_wait": 10, "attack_interval": 160, "move_speed": 1600.0, "gain_cost": 1, "dot_rate": 1.5, "assassin_resist": 1000, "transform_resist": 1000, "pattern_id": 2097520, "race_id": 16, "master_id": 27, "global_id": 26, "spawn_sec": 36}], "dialogue": [{"trigger": "start", "lines": [{"name": "アンナ", "text": "王子、魔物を目撃したと報告があった\n洞窟はこちらです。", "face": "lc2f00ec74cd9"}, {"name": "アンナ", "text": "今、兵士たちが洞窟内部の\n調査をしている所です。", "face": "lc2f00ec74cd9"}, {"name": "兵士", "text": "報告します！　ただいま洞窟内の魔物たちが\n進軍を開始！\n骸の兵士とマミーが確認されています！", "face": "l37447c9d4b29"}, {"name": "アンナ", "text": "なぜ砂漠からきたマミーが\nこの洞窟に……？", "face": "lc2f00ec74cd9"}, {"name": "アンナ", "text": "王子、戦いの準備を！\nこの魔物たちを外に出すわけにはいきません！", "face": "lc2f00ec74cd9"}, {"name": "砂漠の戦士", "text": "ゆけ、呪われし兵士たちよ。\nこの国の王子を抹殺するのだ！", "face": "u175"}]}, {"trigger": "end", "lines": [{"name": "アンナ", "text": "どうやらこの洞窟内の敵は、\n全て倒したみたいですね。", "face": "lc2f00ec74cd9"}, {"name": "アンナ", "text": "しかし、洞窟内で砂漠の王国の兵士の姿を\n目撃したという報告もあります。", "face": "lc2f00ec74cd9"}, {"name": "アンナ", "text": "敵軍の中にマミーもいる事から、\n敵は恐らく砂漠の王国からの刺客でしょう……。", "face": "lc2f00ec74cd9"}, {"name": "兵士", "text": "伝令！　王城に多数の敵あり！\n至急、お戻りください！", "face": "l37447c9d4b29"}, {"name": "アンナ", "text": "王子、急ぎ王城に戻りましょう！", "face": "lc2f00ec74cd9"}, {"name": "砂漠の戦士", "text": "初戦は我らの負けか……。", "face": "u175"}, {"name": "砂漠の戦士", "text": "この国の王子は戦上手と聞くが……。\nその首、必ずや次の戦で……！", "face": "u175"}]}], "active": true}